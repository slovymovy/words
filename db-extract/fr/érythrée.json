                "senses": [
                    {
                        "sense_id": "68f4cb44-b6a5-301e-9041-c06cb3a6220f",
                        "entry_id": "1a71a2c9-5972-3b42-becb-7bf554e0d57c",
                        "glosses": [
                            "Pays de la Corne de l’Afrique, voisin du Soudan à l’ouest, de l’Éthiopie au sud, de Djibouti au sud-est, et de la mer Rouge à l’est. Sa capitale est Asmara."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "927e0c25-1663-452b-83df-60a09e931056",
                                "sense_id": "68f4cb44-b6a5-301e-9041-c06cb3a6220f",
                                "text": "L’Abyssinie ou Éthiopie est un Empire africain situé entre le Soudan, l’Afrique orientale anglaise, l’Érythrée et les Somalilands, français, anglais et italien. Son extension territoriale est supérieure à celle de la France […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "72297f9d-3222-32a8-9600-d03f70084060",
                        "entry_id": "1a71a2c9-5972-3b42-becb-7bf554e0d57c",
                        "glosses": [
                            "Autre nom de la péninsule turque de Karabouroun."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3c96cf5-812b-4484-a4ea-fec149a19292",
                        "source_entry_id": "1a71a2c9-5972-3b42-becb-7bf554e0d57c",
                        "target_lang_word": "Eritrea",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eritrea",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a530dd7-80aa-373b-a44a-6e1023a32c90",
                                        "entry_id": "6410da4d-95be-3f7a-9757-41c45d9ea573",
                                        "glosses": [
                                            "ein Land in Ostafrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "932702c0-e4a7-46eb-a743-d9f0e90b2b0b",
                                                "sense_id": "4a530dd7-80aa-373b-a44a-6e1023a32c90",
                                                "text": "Zwischen Eritrea und Äthiopien gibt es einen Konflikt um den Grenzverlauf."
                                            },
                                            {
                                                "example_id": "1a7321f2-69af-4c9b-99ff-ec97ef6e90ad",
                                                "sense_id": "4a530dd7-80aa-373b-a44a-6e1023a32c90",
                                                "text": "Eritrea war erst italienische, dann britische Kolonie."
                                            },
                                            {
                                                "example_id": "362d3339-f73c-4e7c-b01b-b1165a3db8d6",
                                                "sense_id": "4a530dd7-80aa-373b-a44a-6e1023a32c90",
                                                "text": "Asmara ist die Hauptstadt von Eritrea."
                                            },
                                            {
                                                "example_id": "ae155e7b-da22-4ba6-91b0-d3b761c018d8",
                                                "sense_id": "4a530dd7-80aa-373b-a44a-6e1023a32c90",
                                                "text": "„Mit den Italienern hat der neue Herrscher noch vor seiner Krönung mehrere Abkommen geschlossen, in denen er Rom unter anderem die Region Eritrea abgetreten hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
