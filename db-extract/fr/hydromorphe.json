                    {
                        "sense_id": "b6c22ffd-37a7-34f7-be22-c5fc110569c8",
                        "entry_id": "cac8a308-5f8d-374f-8f0d-8375b13b48f1",
                        "glosses": [
                            "Qualifie un sol soumis à un excès d’eau, temporaire ou permanent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09621bbb-2cdf-4b46-a96c-13421c9998be",
                                "sense_id": "b6c22ffd-37a7-34f7-be22-c5fc110569c8",
                                "text": "C’est au contraire l’excès inverse qui est notable puisque dans certains bas-fonds mal drainés aux sols hydromorphes du Tabasco, le climax est une prairie marécageuse et non la forêt comme le climat pourrait le laisser espérer."
                            },
                            {
                                "example_id": "2ef96160-b170-4c45-bbb7-9b9cdd9a4b88",
                                "sense_id": "b6c22ffd-37a7-34f7-be22-c5fc110569c8",
                                "text": "Les solums à caractères hydromorphes (au sens large) présentent des caractères attribuables à un excès d’eau."
                            }
                        ]
                    },
                    {
                        "sense_id": "83296424-8115-3efd-add1-3e9555aba19e",
                        "entry_id": "cac8a308-5f8d-374f-8f0d-8375b13b48f1",
                        "glosses": [
                            "Qualifie une plante montrant des adaptations morphologiques particulières liées à la présence d'eau. Cette plante est une hydrophyte."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "72ce6621-73df-3d18-85a8-bd55a2e7b9da",
                        "entry_id": "cac8a308-5f8d-374f-8f0d-8375b13b48f1",
                        "glosses": [
                            "Qualifie une station dont le sol est hydromorphe."
                        ],
                        "tags": [
                            "Phytosociologie"
                        ],
                        "examples": [
                            {
                                "example_id": "58bd7092-7a0b-4d19-a868-2dbf2ef9be3d",
                                "sense_id": "72ce6621-73df-3d18-85a8-bd55a2e7b9da",
                                "text": "Elle s’est déroulée du 14 mars au 9 juin 2016. Le site est localisé sur une barre prélittorale sableuse de 8 à 12 m d’altitude émergeant des savanes hydromorphes, en arrière de la frange côtière contenue entre les fleuves Kourou et Sinnamary."
                            },
                            {
                                "example_id": "b9cb4fdb-0fad-4507-81a6-ac461ac9e877",
                                "sense_id": "72ce6621-73df-3d18-85a8-bd55a2e7b9da",
                                "text": "Dans les chênaies hydromorphes, les habitats correspondants sont des chênaies pédonculées, cette espèce étant mieux adaptée que le chêne sessile à ces milieux (résistance du gland et du semis de chêne pédonculé à l’hypoxie, capacité de colonisation des milieux souvent ouverts)."
                            }
                        ]
                    }
