                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c05d5ff-58d2-461a-b1c5-2d945cf2cad9",
                                                "sense_id": "5ed68abd-a0d2-30fa-9247-19065a4c1321",
                                                "text": "Die Verteidigungsanlagen waren früher mit schwerem Geschütz bewehrt."
                                            }
                                        ],
