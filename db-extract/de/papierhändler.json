                                        "entry_id": "ca09c0e2-ea52-3d0f-995b-2874f97757f4",
                                        "glosses": [
                                            "Produits à base de papier ainsi que les produits assimilés à ces derniers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bf1c46e-3039-4a6d-8744-1bc49c375413",
                                                "sense_id": "53e93548-94a1-38d2-9648-46c9227b5c13",
                                                "text": "Les cahiers d’écoliers, gommes, et crayons, sont des produits papetiers."
