                                "target_senses": [
                                    {
                                        "sense_id": "b7bd7b80-7c0f-3175-a2c7-e0f7b5c7d64d",
                                        "entry_id": "f42234b2-c88b-3b4a-a8af-6d07889a1e9f",
                                        "glosses": [
                                            "jemand, der Angehöriger der religiösen Bewegung Scientology ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06e4fe7b-0c20-4635-9cc6-669548d09d1d",
                                                "sense_id": "b7bd7b80-7c0f-3175-a2c7-e0f7b5c7d64d",
                                                "text": "„Auditing – so nennen die Scientologen eine Art Selbstanalyse unter Anleitung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e7b8d49-b3f5-452f-9a17-c8277d4d6b4e",
                        "source_entry_id": "5de15dc4-d75b-3ad5-82b9-ba0546c3add0",
                        "source_sense_id": "d778cec7-4afb-3618-ace3-f960d5302b01",
                        "target_lang_word": "Scientologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scientologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "794d5d32-33cb-3f78-a5a0-c71f6a64581b",
                                        "entry_id": "76a85996-2257-3961-ad33-ca92a1c35f0d",
                                        "glosses": [
                                            "A follower of Scientology, whether belonging to the \\\"official\\\" Church of Scientology or being outside in the so-called Free Zone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eab9515-1c06-4da1-898f-c084dd730ddd",
                                                "sense_id": "794d5d32-33cb-3f78-a5a0-c71f6a64581b",
                                                "text": "I felt great and I got rid of some stuff that I didn't realize that I was dragging around. And I said, 'Whoa, I think I've become a Scientologist.' -- Isaac Hayes"
                                            },
                                            {
                                                "example_id": "f44e4980-143e-4076-b84e-9436f34409c4",
                                                "sense_id": "794d5d32-33cb-3f78-a5a0-c71f6a64581b",
                                                "text": "Tory Bezazian was a veteran Scientologist who loved going after church critics. Until she met the darkest detractor of all."
                                            },
                                            {
                                                "example_id": "66a838a4-88e2-4a98-82ed-93be589b7a36",
                                                "sense_id": "794d5d32-33cb-3f78-a5a0-c71f6a64581b",
                                                "text": "But what is it and where does it come from? Landmark Forum evolved from est (Erhard Seminar Training) an intense and controversial newage selfhelp group of the 1970s and '80s using a combination of Eastern philosophies developed by former scientologist Werner Erhard."
                                            },
                                            {
                                                "example_id": "3f1b45b2-e2d7-4801-99e2-b29c89fc4e59",
                                                "sense_id": "794d5d32-33cb-3f78-a5a0-c71f6a64581b",
                                                "text": "You can't drive past an accident, because as a Scientologist you are the only one who can help. -- Tom Cruise"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Scientologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a64b1340-fd29-30b4-92f1-2c39e129164e",
                                        "entry_id": "7458407e-3c98-3b62-abea-328a95d7fffb",
                                        "glosses": [
                                            "Of or relating to Scientology or Scientologists."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93fc43da-8362-4e80-852c-1f3a70ded365",
                                                "sense_id": "a64b1340-fd29-30b4-92f1-2c39e129164e",
                                                "text": "Neither of them had heard of Kelly or Kalki, but then neither of them had heard of Horace, Alexander Pope, [Blaise] Pascal, [Denis] Diderot, [Werner] Heisenberg’s law or entropy. Their lives were spent, successfully, repelling information. They were perfect “clears,” to use Scientologist jargon."
                                            },
                                            {
                                                "example_id": "729607c8-8059-4d9b-9c46-cf8679ff077a",
                                                "sense_id": "a64b1340-fd29-30b4-92f1-2c39e129164e",
                                                "text": "He [Robert de Grimston] graduated from a Scientology unit, and within fourteen weeks became a Scientologist “therapist.”"
                                            },
                                            {
                                                "example_id": "c1df2f5b-97ab-40bd-8ef1-bbaa1677a8e3",
                                                "sense_id": "a64b1340-fd29-30b4-92f1-2c39e129164e",
                                                "text": "They moved a group of dancers and Scientologist friends into the Row and created a pageant called U."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
