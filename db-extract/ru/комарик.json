                "senses": [
                    {
                        "sense_id": "fac69522-4c84-33da-bf0f-11bf341c363a",
                        "entry_id": "38c90d64-1661-3906-9e25-d00bd8045d88",
                        "glosses": [
                            "разг. то же, что комар"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19e9990f-c716-4df1-8378-982fd68360d2",
                                "sense_id": "fac69522-4c84-33da-bf0f-11bf341c363a",
                                "text": "Ночка тёмная, комарики кусаются."
                            }
                        ]
                    },
                    {
                        "sense_id": "efbc78da-805c-3f14-8914-d9d00d2a164a",
                        "entry_id": "38c90d64-1661-3906-9e25-d00bd8045d88",
                        "glosses": [
                            "разг. любое мелкое комаровидное насекомое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90af3933-6627-41dc-8120-817373779bdb",
                                "sense_id": "efbc78da-805c-3f14-8914-d9d00d2a164a",
                                "text": "Летают какие-то мелкие мушки, либо комарики."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3831582-6037-3240-a183-e6132f8d884e",
                        "entry_id": "38c90d64-1661-3906-9e25-d00bd8045d88",
                        "glosses": [
                            "зоол. то же, что галлица; мелкое комаровидное насекомое отряда двукрылых, личинки которого развиваются в тканях растений, вызывая образование галлов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3298daca-dee7-4d79-b0bf-dbba47b78460",
                                "sense_id": "d3831582-6037-3240-a183-e6132f8d884e",
                                "text": "Ржаной стеблевой комарик повреждает узлы кущения у многих культурных злаков."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38487eb5-0035-40a4-bc6a-e2fcdd22d5d2",
                        "source_entry_id": "38c90d64-1661-3906-9e25-d00bd8045d88",
