                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03a4c36f-7cdb-4711-85e5-0e8d3777080a",
                                "sense_id": "fac3da41-efae-3d23-9c4b-f21a3a7b860e",
                                "text": "De beving deed zich gisteravond voor en had een kracht van 6,1 op de schaal van Richter."
