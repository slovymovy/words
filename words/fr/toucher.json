{
    "word_family": [
        "touche",
        "retoucher",
        "retouche",
        "intouchable",
        "attouchement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1430664-397b-3f1e-96bf-2a652014e413",
                    "sense_definition": "Entrer en contact physique avec quelqu'un ou quelque chose, notamment avec la main.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "contact_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut jamais <w>toucher</w> cette prise avec les mains mouillées."
                        },
                        {
                            "text": "L'enfant curieux veut <w>toucher</w> à tous les objets de la maison."
                        }
                    ],
                    "common_phrases": [
                        "toucher du doigt",
                        "toucher du bois"
                    ]
                },
                {
                    "sense_id": "072461e2-9a32-3f7f-8a33-e4bcc7777b38",
                    "sense_definition": "Émouvoir quelqu'un en éveillant sa sensibilité, sa compassion ou sa gratitude.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Votre immense générosité me <w>touche</w> au plus profond de mon cœur."
                        },
                        {
                            "text": "Ce beau film a su <w>toucher</w> tous les spectateurs de la salle."
                        }
                    ],
                    "synonyms": [
                        "attendrir"
                    ],
                    "common_phrases": [
                        "toucher la corde sensible"
                    ]
                },
                {
                    "sense_id": "f6f4798b-0031-3a4b-928d-c98a1ee913d2",
                    "sense_definition": "Concerner ou avoir des répercussions directes sur quelqu'un ou quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "concerner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette crise économique commence à <w>toucher</w> de nombreuses familles modestes."
                        },
                        {
                            "text": "Les décisions prises par la direction ne <w>touchent</w> pas notre service."
                        }
                    ],
                    "synonyms": [
                        "affecter",
                        "regarder"
                    ]
                },
                {
                    "sense_id": "e8a1f009-eee2-324e-b210-86b36c5c5acb",
                    "sense_definition": "Recevoir ou encaisser une somme d'argent à laquelle on a droit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque employé va <w>toucher</w> une prime exceptionnelle en fin d'année."
                        },
                        {
                            "text": "Elle a enfin pu <w>toucher</w> le premier versement de sa pension."
                        }
                    ],
                    "synonyms": [
                        "encaisser",
                        "gagner"
                    ],
                    "common_phrases": [
                        "toucher un salaire"
                    ]
                },
                {
                    "sense_id": "0ad1dd9d-2599-36cb-94cb-9686a5a3f96b",
                    "sense_definition": "Être sur le point d'arriver à son terme ou d'atteindre son objectif.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "terme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après six mois de travaux acharnés, ce grand projet <w>touche</w> à sa fin."
                        },
                        {
                            "text": "L'équipe garde espoir car nous <w>touchons</w> presque au but fixé."
                        }
                    ],
                    "common_phrases": [
                        "toucher à sa fin",
                        "toucher au but"
                    ]
                },
                {
                    "sense_id": "a2e35f59-f360-3a93-a23b-54701d4ce4a4",
                    "sense_definition": "Être contigu, être situé directement à côté de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contiguite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La cour de notre immeuble <w>touche</w> directement le mur de l'école."
                        },
                        {
                            "text": "Leurs deux propriétés se <w>touchent</w> le long de cette clôture en bois."
                        }
                    ],
                    "synonyms": [
                        "jouxter",
                        "confiner"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "45e68ddb-b14e-34f9-a009-a0ce2865a5c3",
                    "sense_definition": "L'un des cinq sens, permettant d'éprouver la consistance, la texture ou la température des corps par contact cutané.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sens_tactile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>toucher</w> est un sens indispensable pour les personnes privées de la vue."
                        },
                        {
                            "text": "Cette laine est particulièrement agréable et douce au <w>toucher</w>."
                        }
                    ],
                    "common_phrases": [
                        "au toucher",
                        "sens du toucher"
                    ]
                },
                {
                    "sense_id": "39c9ddf9-f920-3652-b788-cfbf7be96a30",
                    "sense_definition": "Manière dont un instrumentiste frappe ou actionne les touches d'un instrument.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pianiste virtuose a séduit la salle grâce à un <w>toucher</w> exceptionnel."
                        },
                        {
                            "text": "Chaque musicien développe son propre <w>toucher</w> au fil de ses années d'apprentissage."
                        }
                    ]
                }
            ]
        }
    ]
}