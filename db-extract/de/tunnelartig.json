                ],
                "senses": [
                    {
                        "sense_id": "3755f036-34bf-3ed6-9161-cadf001d1890",
                        "entry_id": "b1ff2277-6ed0-3dca-bd8d-b8ade27ed114",
                        "glosses": [
                            "an einen Tunnel erinnernd, wie ein Tunnel aussehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ad11936-f59c-4a8a-ba33-17532bcd1487",
                                "sense_id": "3755f036-34bf-3ed6-9161-cadf001d1890",
                                "text": "„Man scheut sich, der finsteren tunnelartigen Brücke sein Vertrauen zu schenken, aber man kommt nicht um sie herum.“"
                            },
                            {
                                "example_id": "1abccce3-cd88-4403-9cb8-64847819723d",
                                "sense_id": "3755f036-34bf-3ed6-9161-cadf001d1890",
                                "text": "„Und er winkt diesen braven Bürger in die Richtung so eines tunnelartigen Metalldetektors wie auf dem Flughafen.“"
                            },
                            {
                                "example_id": "21965d04-779e-4185-a8fd-89d5585d74ad",
                                "sense_id": "3755f036-34bf-3ed6-9161-cadf001d1890",
                                "text": "„Er hatte sein kleines Rasenstück und den Gemüsegarten hinter dem Haus bekommen, doch Sartaj hegte den Verdacht, dass er die tunnelartigen Straßen in den Slums von Bombay manchmal vermisst hatte, diese Hütten, die Jahr für Jahr weiter vorwärts krochen, die mit jedem kleinen Anbau Terrain eroberten und sich darauf behaupteten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
