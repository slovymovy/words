                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "54112d23-3d69-4c11-aca8-ba4c613a1c11",
                        "entry_id": "dfc98851-174d-3f7f-9c95-ed74be381b02",
                        "tags": [
                            "plural"
