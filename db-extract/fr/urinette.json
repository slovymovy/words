                                            {
                                                "example_id": "2ed1ef75-466a-4290-bac4-f82f1069021f",
                                                "sense_id": "e0d17c5c-a6b4-3389-90f0-efbc0c0504e5",
                                                "text": "Onderneemster Yesenia de Winter heeft een heuse missie: een hippe plastuit lanceren waarmee vrouwen makkelijk staand kunnen plassen. Op de Halfvastenfeesten in Zeeland op 5 en 6 april gaat ze haar product promoten. Want plassen moet voor vrouwen op een festival een pretje zijn en geen ellende."
                                            },
                                            {
                                                "example_id": "2dfebc6e-8482-4826-ae8d-5cb1bc6afd47",
                                                "sense_id": "e0d17c5c-a6b4-3389-90f0-efbc0c0504e5",
                                                "text": "“Het is misschien tijdelijk, maar ik vond het te grappig”, zegt De Boer. Hij geeft aan dat hij nog geen vrouwen met plastuit naast zich gezien bij het urinoir. “Ik denk dat vrouwen overslaan.”"
                                            }
                                        ]
                                    }
