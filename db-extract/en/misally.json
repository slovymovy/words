                                            "archaic",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b2e82ff-6c5b-4518-a169-4ee83a1db38b",
                                                "sense_id": "46a5e835-462a-36b8-9363-428c92adcb8a",
                                                "text": "„Die zweite Tochter aus dieser Verbindung war 1775 mit dem Erbprinzen Friedrich Franz von Mecklenburg-Schwerin verheiratet worden. In Schweriner Hofkreisen hieß es danach, ›der Herzog habe sich mesalliiert, indem die Mutter der Herzogin nur eine Gräfin Reuß gewesen.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85a08f79-460a-3f8e-b802-33db1d9a9077",
                                        "entry_id": "964525f9-1487-3a84-87ca-e649eda06e0d",
                                        "glosses": [
                                            "sich auf eine unglückliche Verbindung oder Freundschaft zu/mit jemand/etwas nicht Gleichwertigem einlassen"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "661b866c-4c05-46d1-a2d7-8ee909ac6458",
                                                "sense_id": "85a08f79-460a-3f8e-b802-33db1d9a9077",
                                                "text": "„[…] das passiert auch dem klassisch alternativen Kreuzberg, das sich, ebenfalls ostwestübergreifend, mit Friedrichshain mesalliiert, ebenso dem alternativproletarischen, ausländerstarken Schöneberg, das dem bürgerlich-konservativen Tempelhof angehängt wird..“"
                                            }
                                        ],
