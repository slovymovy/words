                                    {
                                        "sense_id": "6e18a2e8-fc77-3964-b8ad-8cf691d64f5f",
                                        "entry_id": "c516f642-6d40-37a4-9d6c-172b0635ed93",
                                        "glosses": [
                                            "A European dynasty which reigns in Spain and formerly ruled the Kingdom of France."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "040c21f9-771d-38a1-8f4d-8ec40c63a724",
                                        "entry_id": "c516f642-6d40-37a4-9d6c-172b0635ed93",
                                        "glosses": [
                                            "A surname from French."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8e559f1-3f91-306d-ac31-506d33b0ccb1",
                                        "entry_id": "c516f642-6d40-37a4-9d6c-172b0635ed93",
                                        "glosses": [
                                            "A Bourbon Democrat."
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16afb0b5-4e29-4e03-b8aa-c37f55d760d7",
                                                "sense_id": "a8e559f1-3f91-306d-ac31-506d33b0ccb1",
                                                "text": "It was \"a fundamental impossibility\" for a black person to be a Bourbon, white-supremacist Democrat, but a black individual could very well become a \"progressive Democrat.\""
                                            },
                                            {
                                                "example_id": "c8d0bdbe-cf7e-42de-9c03-9c638192974c",
                                                "sense_id": "a8e559f1-3f91-306d-ac31-506d33b0ccb1",
                                                "text": "1992, West's Federal Supplement (first series), vol. 787, p. 1090.\nAs a practical matter, blacks had been denied a fair vote and a fair count even before the 1901 Constitution, because the Black Belt Bourbon white politicians used fraud and intimidation to manipulate the black vote to support conservative Democratic candidates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d5218ef-e9cb-3d75-8f67-591290d98461",
                                        "entry_id": "c516f642-6d40-37a4-9d6c-172b0635ed93",
                                        "glosses": [
                                            "A Bourbon Democrat.",
                                            "A white conservative, particularly in the context of opposition to equal rights for black people."
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9147eab7-5253-4924-9081-aadd5adb3cee",
                                                "sense_id": "2d5218ef-e9cb-3d75-8f67-591290d98461",
                                                "text": "For the Bourbon White elite and their allies, the intimidation of the Black laborers and farmers was necessary to prevent their political involvement and to maintain their subjugated location in the economy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab69109d-9ec2-3694-b5bf-3243509f2834",
                                        "entry_id": "c516f642-6d40-37a4-9d6c-172b0635ed93",
                                        "glosses": [
                                            "A county in Kentucky, see Bourbon County."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
