                                        "examples": []
                                    },
                                    {
                                        "sense_id": "691594b4-b88f-3be0-8e86-f276013a11dc",
                                        "entry_id": "8b25d1cd-fa3b-30f3-80bf-a5a8af40eccd",
                                        "glosses": [
