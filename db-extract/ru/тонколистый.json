                "senses": [
                    {
                        "sense_id": "495ea21e-2029-33fd-bdf0-1fba58ef81b5",
                        "entry_id": "1422a6a6-5c26-326c-aa65-c13fa56e2c39",
                        "glosses": [
                            "имеющий тонкие листья (о растении)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1068dd24-5a5c-4d94-a0b8-54da8f0f8409",
                                "sense_id": "495ea21e-2029-33fd-bdf0-1fba58ef81b5",
                                "text": "А вот и болото ― серебристо-зеркальные затоны с островками тонколистой осоки…"
                            }
                        ]
                    },
                    {
                        "sense_id": "307b1c90-2bfb-3115-97ef-eec787bc8e5b",
                        "entry_id": "1422a6a6-5c26-326c-aa65-c13fa56e2c39",
                        "glosses": [
                            "разг. имеющий тонкие листы (обычно о бумаге, книгах и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9298afa-28fb-45a6-add1-9caa8fc4033d",
                                "sense_id": "307b1c90-2bfb-3115-97ef-eec787bc8e5b",
                                "text": "Вадим смел с соседнего стола тонколистый попсовый журналец «Вот так!»"
                            }
                        ]
                    }
