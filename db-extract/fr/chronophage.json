                "senses": [
                    {
                        "sense_id": "7277670a-228e-3b7d-984d-4522652a430d",
                        "entry_id": "91c160b2-e4e9-3cf1-a477-6459619bab2b",
                        "glosses": [
                            "time-consuming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d385247-90f2-4fdb-b457-f1dfef69cf1b",
                                "sense_id": "7277670a-228e-3b7d-984d-4522652a430d",
                                "text": "Il y a globalement un a priori très négatif sur TikTok : futile, inapproprié et chronophage, on y trouve tout et rien.",
                                "translation": "On the whole, people have very negative preconceptions about TikTok: they think it's pointless, inappropriate and a waste of time, and that people will post anything and everything.",
                                "english": "On the whole, people have very negative preconceptions about TikTok: they think it's pointless, inappropriate and a waste of time, and that people will post anything and everything."
                            },
                            {
                                "example_id": "22f80b31-9dc4-475a-988e-5a8e1afe9e01",
                                "sense_id": "7277670a-228e-3b7d-984d-4522652a430d",
                                "text": "« Il faut dire que c’est un savoir-faire très chronophage, qui va à l’encontre de la productivité de notre époque », souligne Georges Papalexis qui s’est formé entre Paris et Anvers.",
                                "translation": "\"It must be said that it's a very time-consuming craft, which goes against modern ideals of productivity,\" points out Georges Papalexis, who trained in Paris and Antwerp.",
                                "english": "\"It must be said that it's a very time-consuming craft, which goes against modern ideals of productivity,\" points out Georges Papalexis, who trained in Paris and Antwerp."
                            },
                            {
                                "example_id": "7fa6d2a4-d810-4fb7-99d8-3e3d7ad6ce66",
                                "sense_id": "7277670a-228e-3b7d-984d-4522652a430d",
                                "text": "Pas simple toutefois de garder la flamme vive sur la durée. Bénévole et chronophage, l’activité n’est pas toujours compatible avec une vie professionnelle et familiale.",
                                "translation": "It is not always easy, however, to keep the flame alive in the long term. Voluntary and time-consuming, the hobby is not always compatible with professional and family life.",
                                "english": "It is not always easy, however, to keep the flame alive in the long term. Voluntary and time-consuming, the hobby is not always compatible with professional and family life."
                            }
                        ]
                    }
                ],
