                                    {
                                        "sense_id": "0ca06818-1fc1-3d6f-bfa5-6029362a4dc6",
                                        "entry_id": "04d63f43-1177-3793-8782-14473ca03b7f",
                                        "glosses": [
                                            "Synonym of hour hand (on a clock face)."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d869303-e05f-4729-ae0a-98e833483615",
                                                "sense_id": "0ca06818-1fc1-3d6f-bfa5-6029362a4dc6",
                                                "text": "When we get to the half-hour, the little hand will be halfway between the two numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "524b0d26-6f1e-3832-b38f-5f7d8cc4527b",
                                        "entry_id": "04d63f43-1177-3793-8782-14473ca03b7f",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see little, hand: for example, a small body part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cae8574-e47c-4fe1-8464-3955a9b42890",
                                                "sense_id": "524b0d26-6f1e-3832-b38f-5f7d8cc4527b",
                                                "text": "Her little hands were amazingly deft. One time we needed to retrieve a bobbin from behind the machine, and she was the one who managed to grab it!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
