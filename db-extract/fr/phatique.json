                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ee606eaf-c690-4ad7-a2df-878d156b0c29",
                        "source_entry_id": "2b52cd44-e5e1-3537-b157-e206b5f8b3c0",
                        "source_sense_id": "4835a6dd-13a9-3706-939a-8ff638df2be5",
                        "target_lang_word": "phatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9a1c6a9-5810-3992-8535-2b658a3ce285",
                                        "entry_id": "044c503c-7fff-3f06-9a24-406341352633",
                                        "glosses": [
                                            "Pertaining to words used to convey any kind of social relationship and whose meaning is otherwise either deemphasized or absent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6b53f14-b344-4ba5-80b8-c1b35131709a",
                                                "sense_id": "b9a1c6a9-5810-3992-8535-2b658a3ce285",
                                                "text": "Generally speaking, statements in WE are expected to be of a tautologous nature, thus fulfilling the essential phatic nature of speech."
                                            },
                                            {
                                                "example_id": "e7c6f1ff-786a-48cf-af04-963fe2277c87",
                                                "sense_id": "b9a1c6a9-5810-3992-8535-2b658a3ce285",
                                                "text": "Dispensing with phatic chitchat, he began straightaway to tell the story of his “people.”"
                                            },
                                            {
                                                "example_id": "c4f35c75-7078-425a-8061-37193918c1eb",
                                                "sense_id": "b9a1c6a9-5810-3992-8535-2b658a3ce285",
                                                "text": "You needn't be angry about the insincerity of shopkeepers' how-are-you greetings. Well-adjusted people understand that the question is phatic in the context and that that's usually no problem."
                                            },
                                            {
                                                "example_id": "468bae89-312b-4c12-882f-3098839df24e",
                                                "sense_id": "b9a1c6a9-5810-3992-8535-2b658a3ce285",
                                                "text": "Some dialects of a language may use a certain term or phrase in a phatic way, even if other dialects don't."
                                            }
                                        ]
                                    }
                                ]
                            },
