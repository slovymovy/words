                ],
                "senses": [
                    {
                        "sense_id": "a8cff318-3c1b-3cda-9b43-abd0d17eb617",
                        "entry_id": "ada9cb00-09c4-3e15-858a-72d1f2caace3",
                        "glosses": [
                            "Intensität der Farbe eines Gegenstands"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "515988af-e17a-4fb7-a8eb-b1e1525ea99b",
                                "sense_id": "a8cff318-3c1b-3cda-9b43-abd0d17eb617",
                                "text": "„Es war, als verliere ihr Federschmuck in der Gefangenschaft seine Leuchtkraft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cbfe6047-af8f-3fa7-9331-c28597e565e3",
                        "entry_id": "ada9cb00-09c4-3e15-858a-72d1f2caace3",
                        "glosses": [
                            "Stärke des ausgestrahlten Lichts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d999269f-2a02-4454-bd4f-ba0bc9b54917",
                                "sense_id": "cbfe6047-af8f-3fa7-9331-c28597e565e3",
                                "text": "Die Leuchtkraft von Beteigeuze nimmt zur Zeit ab."
                            },
                            {
                                "example_id": "615ae7ea-9faf-4b0b-a4bc-edc70b32e9bb",
                                "sense_id": "cbfe6047-af8f-3fa7-9331-c28597e565e3",
                                "text": "„Solche extremen Leuchtkräfte sind typisch für die sogenannten ultraleuchtstarken Infrarotgalaxien, die im Infrarotbereich hundert- bis tausendmal so hell leuchten wie unsere Milchstraße und die mehr als 90 Prozent ihrer Strahlungsleistung im Infrarotbereich abgeben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
