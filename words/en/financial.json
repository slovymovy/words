            "senses": [
                {
                    "sense_id": "93dbc51e-68eb-3364-a904-fbf690a0adeb",
                    "sense_definition": "Relating to money or how money is managed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "money_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is facing serious <w>financial</w> difficulties due to the economic downturn.",
                            "target_lang_translations": {
                                "ru": "Компания испытывает серьезные <w>финансовые</w> трудности из-за экономического спада.",
                                "zh": "由于经济低迷，该公司正面临严重的<w>财务</w>困难。"
                            }
                        },
                        {
                            "text": "She applied for <w>financial</w> aid to help pay for her university tuition.",
                            "target_lang_translations": {
                                "ru": "Она подала заявление на получение <w>финансовой</w> помощи, чтобы оплатить обучение в университете.",
                                "zh": "她申请了<w>经济</w>援助以支付大学学费。"
                            }
                        }
                    ],
                    "synonyms": [
                        "monetary",
                        "fiscal",
                        "economic",
                        "pecuniary",
                        "budgetary"
                    ],
                    "antonyms": [
                        "nonfinancial"
                    ],
                    "common_phrases": [
                        "financial aid",
                        "financial crisis",
                        "financial support",
                        "financial advisor",
                        "financial year"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к деньгам или управлению ими.",
                        "zh": "与金钱或金钱管理有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "финансовый",
                                "target_lang_sense_clarification": "денежный, относящийся к финансам"
                            },
                            {
                                "target_lang_word": "денежный",
                                "target_lang_sense_clarification": "связанный с деньгами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "金融",
                                "target_lang_sense_clarification": "指与货币流通、信贷、投资等相关的领域"
                            },
                            {
                                "target_lang_word": "财务",
                                "target_lang_sense_clarification": "指个人或组织的金钱管理和账目"
                            },
                            {
                                "target_lang_word": "财政",
                                "target_lang_sense_clarification": "指国家或政府的公共金钱管理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c2d56ec-41c5-3651-825d-696ef2715df9",
                    "sense_definition": "Having paid all necessary fees to a club or organization.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "membership_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jerry is a <w>financial</w> member of the club and is eligible to vote.",
                            "target_lang_translations": {
                                "ru": "Джерри — член клуба, <w>уплативший взносы</w>, и имеет право голоса.",
                                "zh": "杰瑞是该俱乐部的<w>已缴费</w>会员，有权投票。"
                            }
                        },
                        {
                            "text": "Only <w>financial</w> members are permitted to enter the private lounge area.",
                            "target_lang_translations": {
                                "ru": "Только члены клуба, <w>уплатившие взносы</w>, допускаются в частную зону отдыха.",
                                "zh": "只有<w>已缴费</w>会员才被允许进入私人休息区。"
                            }
                        }
                    ],
                    "synonyms": [
                        "paid-up"
                    ],
                    "antonyms": [
                        "unfinancial"
                    ],
                    "common_phrases": [
                        "financial member",
                        "financial status"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уплативший все необходимые взносы в клуб или организацию.",
                        "zh": "指已缴纳所有必要会费或费用的会员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уплативший взносы",
                                "target_lang_sense_clarification": "о члене организации, не имеющем задолженностей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "已缴费的",
                                "target_lang_sense_clarification": "指会员身份有效，无欠费"
                            }
                        ]
                    }
                }
            ]
        }
