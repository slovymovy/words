                    "frequency": "Middle",
                    "semantic_group_id": "strength_sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She started training in <w>powerlifting</w> to improve her overall strength and fitness.",
                            "target_lang_translations": {
                                "es": "Comenzó a entrenar en <w>levantamiento de potencia</w> para mejorar su fuerza y condición física general."
                            }
                        },
                        {
                            "text": "For the first several years of his career in <w>powerlifting</w>, he struggled with the bench press.",
                            "target_lang_translations": {
                                "es": "Durante los primeros años de su carrera en el <w>powerlifting</w>, tuvo dificultades con el press de banca."
                            }
