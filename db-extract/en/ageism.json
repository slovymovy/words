    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5e59fdfd-9211-3bf0-924f-072f8f096fbb",
                "word": "ageism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "07a872b8-0b2f-4089-8300-cbf998d7424c",
                        "entry_id": "5e59fdfd-9211-3bf0-924f-072f8f096fbb",
                        "tags": [
                            "plural"
                        ],
                        "form": "ageisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ecaea233-230c-3e5c-8774-d6829cc2d6b2",
                        "entry_id": "5e59fdfd-9211-3bf0-924f-072f8f096fbb",
                        "glosses": [
                            "The treating of a person or people, especially older people, differently from others based on assumptions, prejudices or/and stereotypes relating to their age."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d6bb0f25-e9ea-4706-8944-a68089029409",
                                "sense_id": "ecaea233-230c-3e5c-8774-d6829cc2d6b2",
                                "text": "But a half-hour into this third Democratic debate, many Democrats had to be wondering: Can he [Joe Biden] go three hours? It’s our own collective ageism."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43fea798-495f-4abd-83e7-0c65d53d1b96",
                        "source_entry_id": "5e59fdfd-9211-3bf0-924f-072f8f096fbb",
                        "source_sense_id": "ecaea233-230c-3e5c-8774-d6829cc2d6b2",
                        "source_sense_description": "the treating of a person or people differently from others based on assumptions or stereotypes relating to their age",
                        "target_lang_word": "leeftijdsdiscriminatie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leeftijdsdiscriminatie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6af7f443-c3af-3924-b5f0-c1c910a4b8f6",
                                        "entry_id": "353f619b-908b-3d65-8ad2-f9e546b21d72",
                                        "glosses": [
                                            "het ten onrechte onderscheid maken tussen mensen op basis van leeftijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef5b60b9-31a3-47b8-92b2-7ef8f8bb062f",
                                                "sense_id": "6af7f443-c3af-3924-b5f0-c1c910a4b8f6",
                                                "text": "Supermarktketen Albert Heijn is schuldig bevonden aan leeftijdsdiscriminatie. Voor vacatures wordt vaak specifiek om studenten of scholieren gevraagd, terwijl dat lang niet altijd is toegestaan."
                                            },
                                            {
                                                "example_id": "d6bf2523-8f3f-4925-abb5-427760283f5a",
                                                "sense_id": "6af7f443-c3af-3924-b5f0-c1c910a4b8f6",
                                                "text": "ING België besliste onlangs om tegen 2021 3.000 van de 9.000 banen te schrappen. Om veel gedwongen ontslagen te vermijden bood de bank zo’n 1.500 werknemers van meer dan 55 de mogelijkheid om het gros van hun loon te behouden zonder dat ze nog moeten werken. Peeters sprak van een ‘verkeerd signaal’ en vroeg zijn administratie te onderzoeken of er sprake is van leeftijdsdiscriminatie. Uit het onderzoek blijkt nu dat daar geen sprake van is. Het resultaat kan gevolgen hebben voor andere bedrijven, die ook zo’n vertrekregeling kunnen uitwerken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "765fe115-ca2c-4a46-9280-9211b442bfd5",
                        "source_entry_id": "5e59fdfd-9211-3bf0-924f-072f8f096fbb",
                        "source_sense_id": "ecaea233-230c-3e5c-8774-d6829cc2d6b2",
                        "source_sense_description": "the treating of a person or people differently from others based on assumptions or stereotypes relating to their age",
                        "target_lang_word": "âgisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "âgisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59096b63-87e6-35b9-8f53-06db6091b9b1",
                                        "entry_id": "58068799-fe63-3107-bdce-e9d0e4103dd9",
                                        "glosses": [
                                            "Discrimination basée sur l’âge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06b9e196-7766-46d5-806a-80a24ccbdbc7",
                                                "sense_id": "59096b63-87e6-35b9-8f53-06db6091b9b1",
                                                "text": "« On a décidé de se rebeller contre l’âgisme », déclare d’emblée Natacha Dzikowski. Un combat aussi mené par Caroline Ida Ours et Nicole Tonnelle."
                                            },
                                            {
                                                "example_id": "8bd254f2-6e15-4135-bcd0-d7a9e51bbf0e",
                                                "sense_id": "59096b63-87e6-35b9-8f53-06db6091b9b1",
                                                "text": "Pour l’écrivaine et psychanalyste Marie de Hennezel, les situations de maltraitance dans les Ehpad sont à mettre en corrélation avec l’âgisme de nos sociétés occidentales, où la vieillesse est présentée sous ses aspects négatifs."
                                            },
                                            {
                                                "example_id": "533f9db0-17a7-4970-83d4-9657f1d0b4e1",
                                                "sense_id": "59096b63-87e6-35b9-8f53-06db6091b9b1",
                                                "text": "Je m’oppose à l’adultisme et à l’âgisme, ces formes de domination qui considèrent les enfants comme des sous humains, avant leurs 18 ans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
