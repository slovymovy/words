            "senses": [
                {
                    "sense_id": "4eb20f00-7931-316f-aad6-38af16451b7e",
                    "sense_definition": "een fluitend of huilend geluid maken, vaak door de wind of een krachtige ademhaling",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Buiten <w>giert</w> de wind door de takken van de oude bomen.",
                            "target_lang_translations": {
                                "en": "Outside the wind <w>howls</w> through the branches of the old trees."
                            }
                        },
                        {
                            "text": "De koude wind <w>gierde</w> om het huis tijdens de storm.",
                            "target_lang_translations": {
                                "en": "The cold wind <w>whistled</w> around the house during the storm."
                            }
                        }
                    ],
                    "synonyms": [
                        "huilen",
                        "fluiten",
                        "loeien"
                    ],
                    "common_phrases": [
                        "gierende wind"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a whistling or howling sound, often caused by wind or powerful breathing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "howl",
                                "target_lang_sense_clarification": "of the wind"
                            },
                            {
                                "target_lang_word": "whistle",
                                "target_lang_sense_clarification": "of the wind"
                            },
                            {
                                "target_lang_word": "roar",
                                "target_lang_sense_clarification": "of the wind"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f99f7da-413b-3d6c-9fae-10c959b5cba0",
                    "sense_definition": "heel hard en onbeheerst lachen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lachen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>giert</w> van het lachen om die grappige film.",
                            "target_lang_translations": {
                                "en": "He is <w>roaring with laughter</w> at that funny movie."
                            }
                        },
                        {
                            "text": "We zaten de hele avond te <w>gieren</w> van de pret.",
                            "target_lang_translations": {
                                "en": "We were <w>howling</w> with fun all evening."
                            }
                        }
                    ],
                    "synonyms": [
                        "schateren",
                        "brullen"
                    ],
                    "common_phrases": [
                        "gieren van het lachen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in de uitdrukking 'gieren van het lachen'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To laugh very loudly and uncontrollably."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "roar with laughter",
                                "target_lang_sense_clarification": "to laugh uncontrollably"
                            },
                            {
                                "target_lang_word": "howl with laughter",
                                "target_lang_sense_clarification": "to laugh uncontrollably"
                            },
                            {
                                "target_lang_word": "be in stitches",
                                "target_lang_sense_clarification": "to laugh very hard"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9c89888-595f-31f7-acc2-49648c6f6eef",
                    "sense_definition": "zich zeer snel en krachtig door iets heen bewegen, vaak gezegd van emoties of stoffen in het lichaam",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik voelde de adrenaline door mijn lichaam <w>gieren</w> voor de wedstrijd.",
                            "target_lang_translations": {
                                "en": "I felt the adrenaline <w>surging</w> through my body before the match."
                            }
                        },
                        {
                            "text": "De zenuwen <w>gierden</w> door haar keel toen ze het podium opstapte.",
                            "target_lang_translations": {
                                "en": "Nerves were <w>racing</w> through her as she stepped onto the stage."
                            }
                        }
                    ],
                    "synonyms": [
                        "razen",
                        "stroomlijnen"
                    ],
                    "common_phrases": [
                        "adrenaline door het lichaam gieren"
                    ],
                    "target_lang_definitions": {
                        "en": "To move very quickly and powerfully through something, often said of emotions or substances in the body."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "surge",
                                "target_lang_sense_clarification": "of emotions or adrenaline"
                            },
                            {
                                "target_lang_word": "race",
                                "target_lang_sense_clarification": "of blood or adrenaline"
                            },
                            {
                                "target_lang_word": "course",
                                "target_lang_sense_clarification": "to flow rapidly through the body"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2a73eb7-9f87-33fb-a81b-6ed3fee6191f",
