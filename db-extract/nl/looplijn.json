                        "sense_id": "1fbc154f-a5df-32a8-b566-33fb223d0ed2",
                        "entry_id": "a0cc7786-ef60-3400-aab8-0a1ba11d75a9",
                        "glosses": [
                            "een denkbeeldige lijn waarover iemand zich lopend voortbeweegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9274c3e5-9a3c-444d-b198-e529adcd9e50",
                                "sense_id": "1fbc154f-a5df-32a8-b566-33fb223d0ed2",
                                "text": "\"Grappig om een vrouw over looplijnen te horen praten.\" Die woorden zullen Cam Newton nog lang achtervolgen."
                            }
                        ]
