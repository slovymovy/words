                        "translation_id": "153f2ff7-c166-4bde-8cff-b5ab49a08a93",
                        "source_entry_id": "846c2370-ce5c-3319-bfa1-2879b2ca276f",
                        "source_sense_description": "יהוה (tetragrammaton)",
                        "target_lang_word": "Jahwe",
                        "target_lang_code": "de",
