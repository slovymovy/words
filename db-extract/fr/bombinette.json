                ],
                "senses": [
                    {
                        "sense_id": "d137a0c8-0116-371e-a048-d973fd8ac57e",
                        "entry_id": "d97a3b67-5e64-373e-822f-f6f42f79999d",
                        "glosses": [
                            "Petite bombe, en particulier, et par dérision, la force de frappe nucléaire française."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f5c5df2e-45b9-4a0e-847f-74636cc26339",
                                "sense_id": "d137a0c8-0116-371e-a048-d973fd8ac57e",
                                "text": "C’est l’élu, celui qui tire la chevillette et la bombinette à neutrons badaboume sur la gueule à tout le monde."
                            },
                            {
                                "example_id": "d1d97ddd-2e48-4677-8157-bb328ecc6dcb",
                                "sense_id": "d137a0c8-0116-371e-a048-d973fd8ac57e",
                                "text": "François Mitterrand s’opposant de façon virulente à la bombinette, De Gaulle ne se refusa pas le plaisir de confier la supervision du projet à son frère, Jacques Mitterrand. Ainsi, « Ce que l’un critique, l’autre l’assurera », indiqua-t-il."
                            },
                            {
                                "example_id": "3ad154fa-06c2-42e5-8168-2b1ec1e6afee",
                                "sense_id": "d137a0c8-0116-371e-a048-d973fd8ac57e",
                                "text": "Logiciels espions, logiciels tueurs et autres bombinettes numériques sont livrés à peu de frais sur les sites de quelques corsaires de l’Internet."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec27e0a5-6143-333c-b2af-ffcc50a285dc",
                        "entry_id": "d97a3b67-5e64-373e-822f-f6f42f79999d",
                        "glosses": [
                            "Information qui fait l’effet d’une petite bombe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eac537d4-4c92-47cb-8046-c6477485ec22",
                                "sense_id": "ec27e0a5-6143-333c-b2af-ffcc50a285dc",
                                "text": "Quelques gestes techniques bien sentis, deux ou trois accélérations fulgurantes sur le côté gauche et un pénalty transformé et chaleureusement célébré, bras croisés et banane aux lèvres, voilà la copie de l’homme le plus scruté de la planète foot depuis la bombinette lâchée par Marca."
                            }
                        ]
                    }
