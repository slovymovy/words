                        "entry_id": "fda23ccc-afa6-32e5-8e7d-d1f7db343c37",
                        "glosses": [
                            "спорт. в гонках: точка траектории, ближайшая к внутреннему краю дороги"
                        ],
                        "tags": [],
                        "examples": []
                    },
