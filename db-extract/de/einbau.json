                "senses": [
                    {
                        "sense_id": "df8842e0-f17c-3ccc-abe6-71b4c7353e31",
                        "entry_id": "b0ba28b5-f19e-3cbe-8a42-72e7bcae0033",
                        "glosses": [
                            "der Vorgang des Einbauens"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5fe38013-b3a1-44ba-9716-f6b26b3ef7c0",
                                "sense_id": "df8842e0-f17c-3ccc-abe6-71b4c7353e31",
                                "text": "Der Einbau der Festplatte verlief reibungslos."
                            },
                            {
                                "example_id": "5abfbc45-eeb8-4b2a-8f12-9ea1061e5997",
                                "sense_id": "df8842e0-f17c-3ccc-abe6-71b4c7353e31",
                                "text": "Wir benötigen einen Spezialisten für den Einbau der Duschkabine."
                            },
                            {
                                "example_id": "4778e199-ae2f-4832-9358-7ac35144e11d",
                                "sense_id": "df8842e0-f17c-3ccc-abe6-71b4c7353e31",
                                "text": "Wir sollten mit dem Einbau der neuen Hilfefunktion nicht mehr länger warten."
                            },
                            {
                                "example_id": "aeffc3bd-20be-4daa-93fe-0b06e8ddfbe7",
                                "sense_id": "df8842e0-f17c-3ccc-abe6-71b4c7353e31",
                                "text": "„[…] der Einbau des Motors in die Räder verschafft den Entwicklern nicht nur mehr Freiheiten für die Gestaltung von Innenraum und Karosserie, auch die Fahreigenschaften werden revolutioniert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b68fc83c-508e-34ef-87a1-ffd6b3f070a0",
                        "entry_id": "b0ba28b5-f19e-3cbe-8a42-72e7bcae0033",
                        "glosses": [
                            "das eingebaute Element"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ed684db-21ab-4f93-93c5-b443bc497579",
                                "sense_id": "b68fc83c-508e-34ef-87a1-ffd6b3f070a0",
                                "text": "Der Nachmieter wünscht, dass alle Einbauten in meiner Wohnung entfernt werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
