                "translations": [
                    {
                        "translation_id": "4271535f-d60b-4739-9e7c-7dd02a7a6ad3",
                        "source_entry_id": "ed108979-da3e-3c1c-a3b2-4f1fde0380a2",
                        "source_sense_id": "aa42d462-95b5-3317-98e7-81bd0d522c5b",
                        "target_lang_word": "corporalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corporalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de0287ef-5f78-350c-bff3-31c5ecb765cd",
                                        "entry_id": "b71e570e-13d2-353d-a9f0-483872a7d999",
                                        "glosses": [
                                            "État corporel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b75f2cd-e6ba-47ee-9a7b-3594b0ed6a58",
                                                "sense_id": "de0287ef-5f78-350c-bff3-31c5ecb765cd",
                                                "text": "Déjà dans ses premiers écrits, Thomas nous dit que la notion de corporalité est susceptible d’une double considération."
                                            },
                                            {
                                                "example_id": "4bd80c2d-e956-4060-8914-52f4ec53b13d",
                                                "sense_id": "de0287ef-5f78-350c-bff3-31c5ecb765cd",
                                                "text": "À un moment donné, il fit valoir que certaines de ses hypothèses rappelaient en somme la théorie hylémorphique de saint Bonaventure, qui implique une certaine corporalité des âmes."
                                            },
                                            {
                                                "example_id": "a4c793ae-02ab-420f-8991-330ebbd95466",
                                                "sense_id": "de0287ef-5f78-350c-bff3-31c5ecb765cd",
                                                "text": "Les exercices psychocorporels ont pour but de vous faire vivre votre corporalité, d’élargir votre champ de conscience pour entrer dans une perception de plus en plus fine du corps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74be9a74-290c-4430-bae6-8002603afae4",
                        "source_entry_id": "ed108979-da3e-3c1c-a3b2-4f1fde0380a2",
                        "source_sense_id": "aa42d462-95b5-3317-98e7-81bd0d522c5b",
                        "target_lang_word": "corporalidad",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corporalidad",
