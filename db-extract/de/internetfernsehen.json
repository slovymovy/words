                    {
                        "sense_id": "6c6ddc18-df5a-380d-8d20-40986baf5729",
                        "entry_id": "f5ae8627-e9f8-3d86-861e-b5a39f4c0940",
                        "glosses": [
                            "Übertragung von Bild- und Tonsignale für das Fernsehprogramm über das Internet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "442aa85d-12df-4ba2-9150-8bcd48081f2c",
                                "sense_id": "6c6ddc18-df5a-380d-8d20-40986baf5729",
                                "text": "„Nun wurde der Maskenbewahrer im Internetfernsehen gebeten, seine Gegenstände zu zeigen.“"
                            },
                            {
                                "example_id": "4c48bf4c-b967-4ea5-938d-9e698f6f0820",
                                "sense_id": "6c6ddc18-df5a-380d-8d20-40986baf5729",
                                "text": "„Die Krankenzimmer waren ausschließlich Einzelsuiten mit Klimaanlage, Kamin, Jacuzzi und Internetfernsehen.“"
                            },
                            {
                                "example_id": "01f050d4-fff4-4809-b292-3d3cd94c834b",
                                "sense_id": "6c6ddc18-df5a-380d-8d20-40986baf5729",
                                "text": "„Für Hastings ist es selbstverständlich, dass das Internetfernsehen immer mehr wächst und das klassische, lineare Fernsehen in baldiger Zukunft verdrängen wird.“"
                            }
                        ],
