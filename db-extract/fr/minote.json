                        "examples": [
                            {
                                "example_id": "fdbff0e8-67d9-47be-9dc2-bbc5433dfd0c",
                                "sense_id": "1eeeeeec-aa43-37b8-b09e-15bba495ec5e",
                                "text": "Depuis trois mois, l’oncle de la minote, le frère du père, s’aprésente chaque semaine à la maison quand il n’y a pirsonne d’autre et il en profite."
                            },
                            {
                                "example_id": "c70ff0c0-2f34-48c9-b313-fd287947a072",
                                "sense_id": "1eeeeeec-aa43-37b8-b09e-15bba495ec5e",
                                "text": "Les garçons, ça vaut mieux que les filles, question endurance. Léon, il dit toujours ça. C’est pour ça qu’il préfère les minots. Les minotes, il trouve que ça sert à rien. C’est des bouches inutiles à nourrir."
                            }
                        ]
                    }
