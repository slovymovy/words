                                                "example_id": "a03f4422-2f9c-4a19-90c7-7fce3928cad6",
                                                "sense_id": "66272072-6304-341b-b3da-5e04dd223bf7",
                                                "text": "Istnieje kilka różnych kategorii klasyfikacji zapalenia płuc."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
