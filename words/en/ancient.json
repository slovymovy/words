{
    "word_family": [
        "anciently",
        "ancientness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "823440df-3e18-3fd8-ab72-edd578d2b634",
                    "sense_definition": "Belonging to a time long past in history, especially thousands of years ago; not modern.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "history_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We learned about <w>ancient</w> history and the Roman Empire in school today.",
                            "target_lang_translations": {
                                "ru": "Сегодня в школе мы изучали <w>древнюю</w> историю и Римскую империю.",
                                "tr": "Bugün okulda <w>antik</w> tarih ve Roma İmparatorluğu hakkında bilgi edindik.",
                                "zh": "今天在学校我们学习了<w>古代</w>史和罗马帝国。"
                            }
                        },
                        {
                            "text": "The museum contains pottery and tools from an <w>ancient</w> civilization.",
                            "target_lang_translations": {
                                "ru": "В музее хранятся керамика и инструменты <w>древней</w> цивилизации.",
                                "tr": "Müze, <w>antik</w> bir uygarlığa ait çömlekler ve aletler barındırıyor.",
                                "zh": "博物馆里收藏着来自<w>古代</w>文明的陶器和工具。"
                            }
                        }
                    ],
                    "synonyms": [
                        "old"
                    ],
                    "antonyms": [
                        "modern"
                    ],
                    "common_phrases": [
                        "ancient history",
                        "ancient world",
                        "ancient civilization",
                        "ancient times",
                        "ancient Greece"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к далекому прошлому, особенно к истории тысячи лет назад; не современный",
                        "tr": "Tarihte çok eskide kalmış bir döneme, özellikle binlerce yıl öncesine ait olan; modern olmayan.",
                        "zh": "属于历史上遥远的过去，特别是几千年前；非现代的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "древний",
                                "target_lang_sense_clarification": "относящийся к далекому прошлому"
                            },
                            {
                                "target_lang_word": "античный",
                                "target_lang_sense_clarification": "относящийся к истории Древней Греции и Рима"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "antik",
                                "target_lang_sense_clarification": "İlk Çağ veya Yunan/Roma uygarlıklarıyla ilgili"
                            },
                            {
                                "target_lang_word": "eski",
                                "target_lang_sense_clarification": "tarihi zamanlara ait"
                            },
                            {
                                "target_lang_word": "kadim",
                                "target_lang_sense_clarification": "çok eski zamanlardan beri var olan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "古代",
                                "target_lang_sense_clarification": "指遥远的过去"
                            },
                            {
                                "target_lang_word": "古老",
                                "target_lang_sense_clarification": "指年代久远"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96d6f974-23f6-3fde-a8c7-3418c15c6935",
                    "sense_definition": "Having existed for a very long time; extremely old.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "great_age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They walked through the <w>ancient</w> forest where the trees were huge.",
                            "target_lang_translations": {
                                "ru": "Они гуляли по <w>древнему</w> лесу, где деревья были огромными.",
                                "tr": "Ağaçların kocaman olduğu <w>kadim</w> bir ormanda yürüdüler.",
                                "zh": "他们走过那片树木高大的<w>古老</w>森林。"
                            }
                        },
                        {
                            "text": "The tourists took pictures of the <w>ancient</w> city walls.",
                            "target_lang_translations": {
                                "ru": "Туристы фотографировали <w>древние</w> городские стены.",
                                "tr": "Turistler <w>tarihi</w> şehir surlarının fotoğraflarını çekti.",
                                "zh": "游客们拍摄了<w>古老</w>的城墙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "old",
                        "aged",
                        "antique",
                        "historic"
                    ],
                    "antonyms": [
                        "modern"
                    ],
                    "common_phrases": [
                        "ancient forest",
                        "ancient city",
                        "ancient monument",
                        "ancient ruins"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий очень долгое время; чрезвычайно старый",
                        "tr": "Çok uzun süredir var olan; son derece eski.",
                        "zh": "存在了很长时间；极其古老。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "древний",
                                "target_lang_sense_clarification": "существующий много веков"
                            },
                            {
                                "target_lang_word": "старинный",
                                "target_lang_sense_clarification": "созданный в старину, имеющий историческую ценность"
                            },
                            {
                                "target_lang_word": "ветхий",
                                "target_lang_sense_clarification": "разрушающийся от старости"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "antik",
                                "target_lang_sense_clarification": "tarihi değeri olan çok eski yapı veya nesne"
                            },
                            {
                                "target_lang_word": "kadim",
                                "target_lang_sense_clarification": "çok eski, köklü"
                            },
                            {
                                "target_lang_word": "tarihi",
                                "target_lang_sense_clarification": "geçmişten günümüze ulaşmış"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "古老",
                                "target_lang_sense_clarification": "存在时间极长"
                            },
                            {
                                "target_lang_word": "陈旧",
                                "target_lang_sense_clarification": "因年代久远而显得老旧"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6661a9b9-6d0c-373a-af77-10a465ffd63e",
                    "sense_definition": "A person who lived in times long past, particularly in the classical periods of Greece and Rome.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "history_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We can still learn a lot about philosophy from the <w>ancients</w>.",
                            "target_lang_translations": {
                                "ru": "Мы все еще можем многому научиться в философии у <w>древних</w>.",
                                "tr": "Felsefe konusunda <w>eskilerden</w> hâlâ öğreneceğimiz çok şey var.",
                                "zh": "我们仍然可以从<w>古人</w>那里学到很多哲学知识。"
                            }
                        },
                        {
                            "text": "The <w>ancients</w> mapped the stars without the help of modern telescopes.",
                            "target_lang_translations": {
                                "ru": "<w>Древние</w> составили карту звезд без помощи современных телескопов.",
                                "tr": "<w>İlk çağ insanları</w> modern teleskopların yardımı olmadan yıldızların haritasını çıkardı.",
                                "zh": "<w>古人</w>在没有现代望远镜帮助的情况下绘制了星图。"
                            }
                        }
                    ],
                    "synonyms": [
                        "antique"
                    ],
                    "common_phrases": [
                        "the ancients"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, живший в далеком прошлом, особенно в классические периоды Греции и Рима",
                        "tr": "Çok eski çağlarda, özellikle Antik Yunan ve Roma döneminde yaşamış kişi.",
                        "zh": "生活在遥远过去的人，特别是希腊和罗马的古典时期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "древние",
                                "target_lang_sense_clarification": "люди античности"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ilk çağ insanları",
                                "target_lang_sense_clarification": "antik dönemde yaşamış olanlar"
                            },
                            {
                                "target_lang_word": "eskiler",
                                "target_lang_sense_clarification": "tarihin eski dönemlerinde yaşamış toplumlar/kişiler"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "古人",
                                "target_lang_sense_clarification": "古代的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9cfa438-0355-3e3d-b8fd-aca4787f1149",
                    "sense_definition": "A person who is very old.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "old_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The village <w>ancient</w> sat on the bench and watched the children play.",
                            "target_lang_translations": {
                                "ru": "Деревенский <w>старец</w> сидел на скамейке и наблюдал, как играют дети.",
                                "tr": "Köyün <w>ihtiyarı</w> bankta oturup çocukların oynamasını izledi.",
                                "zh": "村里的那位<w>长者</w>坐在长椅上看着孩子们玩耍。"
                            }
                        },
                        {
                            "text": "He felt like an <w>ancient</w> surrounded by so many energetic teenagers.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>стариком</w> в окружении стольких энергичных подростков.",
                                "tr": "Bu kadar enerjik gencin arasında kendini bir <w>yaşlı</w> gibi hissetti.",
                                "zh": "被这么多充满活力的青少年包围着，他觉得自己像个<w>老人</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "senior citizen",
                        "geriatric",
                        "oldster"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often humorous or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень старый человек",
                        "tr": "Çok yaşlı kimse.",
                        "zh": "非常年长的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старец",
                                "target_lang_sense_clarification": "почтительное название старого человека"
                            },
                            {
                                "target_lang_word": "старик",
                                "target_lang_sense_clarification": "пожилой мужчина"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yaşlı",
                                "target_lang_sense_clarification": "ileri yaştaki kimse"
                            },
                            {
                                "target_lang_word": "ihtiyar",
                                "target_lang_sense_clarification": "çok yaşlanmış insan (mizahtan veya edebiyattan kalan kullanım)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老人",
                                "target_lang_sense_clarification": "年纪很大的人"
                            },
                            {
                                "target_lang_word": "长者",
                                "target_lang_sense_clarification": "年长且受尊敬的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}