                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c2f49a92-6721-4484-b723-77925405c98c",
                        "entry_id": "0df69e2f-f42a-3da4-b25f-75e549680872",
                        "tags": [
