                                            {
                                                "example_id": "eb81a9a4-c61c-427d-a87e-70c1fb62dd20",
                                                "sense_id": "dbab48d0-c553-3260-9f93-3a28017bcc6a",
                                                "text": "Dieses Entrecote ist richtig saftig!"
                                            },
                                            {
                                                "example_id": "ec015dde-de18-4f03-a38f-9b3a0c625cdb",
                                                "sense_id": "dbab48d0-c553-3260-9f93-3a28017bcc6a",
                                                "text": "Die Kühe schliefen auf einer saftigen Wiese."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "16e9bee0-ee56-3150-862d-a65ce8e3bad2",
                                        "entry_id": "d6ecec97-0f21-3690-aab8-d56f20fc6392",
                                        "glosses": [
                                            "strahlend, farblich gesättigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "910f1f7e-207a-401d-8b3b-15be239440d2",
                                                "sense_id": "16e9bee0-ee56-3150-862d-a65ce8e3bad2",
                                                "text": "Die Kamera schießt Fotos in saftigen Farben."
                                            },
                                            {
                                                "example_id": "0b37bf94-d255-494b-bd99-bb9b4e9389d6",
                                                "sense_id": "16e9bee0-ee56-3150-862d-a65ce8e3bad2",
                                                "text": "Keine Lippenstiftfarbe läutet den Sommer wohl besser ein als ein saftiges Rot!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8dc6330f-826d-30b7-be60-9ad3279584ea",
                                        "entry_id": "d6ecec97-0f21-3690-aab8-d56f20fc6392",
                                        "glosses": [
                                            "(unangenehm) heftig"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71355a3d-17bf-4bc5-b7e4-a957f44ce559",
                                                "sense_id": "8dc6330f-826d-30b7-be60-9ad3279584ea",
                                                "text": "Als sie der Türsteher nicht reinlassen wollte, hat sie ihm saftig eine geschmiert."
                                            },
                                            {
                                                "example_id": "11718e21-6c5e-44c2-9277-755fa6b53127",
                                                "sense_id": "8dc6330f-826d-30b7-be60-9ad3279584ea",
                                                "text": "Der Polizist, der anwesend war, hat ihr sofort eine saftige Buße erteilt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "053e72ba-9763-4ee9-824b-b785cea3b34b",
                        "source_entry_id": "dadd5e57-2986-33b3-86c2-6ed460ff28b6",
                        "source_sense_id": "759a3b2e-e089-3d6c-8e48-3bc53962e0cd",
                        "source_sense_description": "vol met sap",
                        "target_lang_word": "juicy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "juicy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a544504-86b3-34f7-a3ac-a2a7fd768fd5",
                                        "entry_id": "a2fe3289-aeaa-3ac7-859f-e9bcc27b1a27",
                                        "glosses": [
                                            "Having lots of juice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38a4ab75-76a2-4121-885d-1009c3d460f0",
                                                "sense_id": "7a544504-86b3-34f7-a3ac-a2a7fd768fd5",
                                                "text": "a juicy peach"
                                            },
                                            {
                                                "example_id": "18a9a843-d2da-4edc-9c98-2df9f702de26",
                                                "sense_id": "7a544504-86b3-34f7-a3ac-a2a7fd768fd5",
                                                "text": "a juicy pot roast"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20b5a173-4815-3735-940f-a96e87ec4fac",
                                        "entry_id": "a2fe3289-aeaa-3ac7-859f-e9bcc27b1a27",
                                        "glosses": [
                                            "Exciting; titillating."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a4e4f9e-0eb2-45b7-9ee1-34d9477cf766",
                                                "sense_id": "20b5a173-4815-3735-940f-a96e87ec4fac",
                                                "text": "Near-synonyms: saucy, spicy"
                                            },
                                            {
                                                "example_id": "8c8e079c-37d4-403a-9d11-1dd3522ef607",
                                                "sense_id": "20b5a173-4815-3735-940f-a96e87ec4fac",
                                                "text": "I do not keep up with all the latest juicy rumors."
                                            },
                                            {
                                                "example_id": "5cf57c2a-96c2-4374-81cb-d8996b62143b",
                                                "sense_id": "20b5a173-4815-3735-940f-a96e87ec4fac",
                                                "text": "I like getting my teeth into a nice juicy problem."
                                            },
                                            {
                                                "example_id": "cbb040b3-cfd9-49f6-9186-aa6c45770af8",
                                                "sense_id": "20b5a173-4815-3735-940f-a96e87ec4fac",
                                                "text": "If you’re looking for juicier confessions – that is, admissions of the kinds of sins unearthed on detective shows or reality TV – then you’ll want to look elsewhere. My sinning life is rather uneventful."
                                            },
                                            {
                                                "example_id": "ec47afa0-0bce-43c8-ac6e-6f76453f22e2",
                                                "sense_id": "20b5a173-4815-3735-940f-a96e87ec4fac",
                                                "text": "Here are the five juiciest redactions from the Flynn sentencing document, with some context and a smidge of informed speculation about What It All Means."
                                            },
                                            {
                                                "example_id": "f3b433d0-7d5f-44fd-b228-20a3b18db10c",
                                                "sense_id": "20b5a173-4815-3735-940f-a96e87ec4fac",
                                                "text": "“Gossip” is about a lot more than just juicy tidbits and the columnists that peddle them, presenting a multifaceted look at gossip’s role in the newspaper/media ecosystem and at Rupert Murdoch’s enterprises in particular."
                                            },
                                            {
                                                "example_id": "abf9b43c-86f4-47b0-99ff-3c7b70b1bf96",
                                                "sense_id": "20b5a173-4815-3735-940f-a96e87ec4fac",
                                                "text": "The former vice-president’s characterizations of peers such as Pete Buttigieg (talented but too gay for the America to accept as her running mate), and Josh Shapiro (an egoist) are not particularly juicy, but have already caused bad blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20d5dadf-fa6b-37f6-99ae-d8c536770d5f",
                                        "entry_id": "a2fe3289-aeaa-3ac7-859f-e9bcc27b1a27",
                                        "glosses": [
                                            "Voluptuous, curvy, thick; sexy in those ways."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c909b7b-1712-325e-8262-9060657de141",
                                        "entry_id": "a2fe3289-aeaa-3ac7-859f-e9bcc27b1a27",
                                        "glosses": [
                                            "Strong; thus, also painful."
                                        ],
                                        "tags": [
                                            "uncommon",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aaebdc9-a4e6-4871-acab-b34c12c19688",
                                                "sense_id": "5c909b7b-1712-325e-8262-9060657de141",
                                                "text": "“Your head feels funny, doesn't it?”\n“It does rather,” I said, the bump I had given it had been a juicy one, and the temples were throbbing."
                                            },
                                            {
                                                "example_id": "95d1b198-78d8-48e2-b829-dd52f3254d2b",
                                                "sense_id": "5c909b7b-1712-325e-8262-9060657de141",
                                                "text": "Years ago, when striplings, he and I had done a stretch together at Malvern House, Bramley-on-Sea, the preparatory school conducted by that prince of stinkers, Aubrey Upjohn MA, and had frequently stood side by side in the Upjohn study awaiting the receipt of six of the juiciest from a cane of the type that biteth like a serpent and stingeth like an adder, as the fellow said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "254147d3-e5ab-4eec-b4b7-77fbbbcfd833",
                        "source_entry_id": "dadd5e57-2986-33b3-86c2-6ed460ff28b6",
                        "source_sense_id": "759a3b2e-e089-3d6c-8e48-3bc53962e0cd",
                        "source_sense_description": "vol met sap",
                        "target_lang_word": "juteux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "juteux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c194a363-1247-3e75-9668-83aa0ec6e532",
                                        "entry_id": "61902c63-76f0-30a3-931a-038cea573713",
                                        "glosses": [
                                            "Qui a beaucoup de jus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bb2e276-4afe-4d9e-b940-18eda1aab31a",
                                                "sense_id": "c194a363-1247-3e75-9668-83aa0ec6e532",
                                                "text": "Melon juteux."
                                            },
                                            {
                                                "example_id": "4846cabb-7e46-41ba-a26b-9f4f96c03026",
                                                "sense_id": "c194a363-1247-3e75-9668-83aa0ec6e532",
                                                "text": "Pêche juteuse."
                                            },
                                            {
                                                "example_id": "97fab5f4-620b-40c2-88eb-2fd5ef4583b7",
                                                "sense_id": "c194a363-1247-3e75-9668-83aa0ec6e532",
                                                "text": "Il semblait avoir deviné quelque succession à déguster […] aussi juteuse que le filet tremblant dans lequel l’amphitryon plongeait alors son couteau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87a29912-72e5-3ec2-ad3b-b98397327bef",
                                        "entry_id": "61902c63-76f0-30a3-931a-038cea573713",
                                        "glosses": [
                                            "Qui réjouit en mauvaise part."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3bd2e06-a4b5-4167-a845-d69e1956cd01",
                                                "sense_id": "87a29912-72e5-3ec2-ad3b-b98397327bef",
                                                "text": "Des révélations juteuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "029f7e0d-7e20-3413-b3cc-1e5d85bd60a9",
                                        "entry_id": "61902c63-76f0-30a3-931a-038cea573713",
                                        "glosses": [
                                            "Qui dénote une grande abondance, spécialement en argent. Qui est d'un grand profit/rapport."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0ce7755-1e37-4972-bdc5-4468bf6badb1",
                                                "sense_id": "029f7e0d-7e20-3413-b3cc-1e5d85bd60a9",
                                                "text": "Un placement juteux. Une affaire juteuse."
                                            },
                                            {
                                                "example_id": "8671d0d4-d6b4-4039-94ef-98596ecc5a6b",
                                                "sense_id": "029f7e0d-7e20-3413-b3cc-1e5d85bd60a9",
                                                "text": "J'ai signé un contrat juteux."
                                            },
                                            {
                                                "example_id": "6cac2a75-a37f-4d34-8e29-7f8affef681b",
                                                "sense_id": "029f7e0d-7e20-3413-b3cc-1e5d85bd60a9",
                                                "text": "Se disant convaincu que la syndicalisation de son usine ferait fuir vers d’autres États toutes les autres entreprises du secteur, le gouverneur républicain du Tennessee, Bill Haslam […] est allé jusqu’à menacer la compagnie allemande de lui retirer ses juteuses subventions."
                                            },
                                            {
                                                "example_id": "a39344fb-53d4-4c99-a775-9cd7378233d8",
                                                "sense_id": "029f7e0d-7e20-3413-b3cc-1e5d85bd60a9",
                                                "text": "L’idée : gonfler la part d’audience de sa maison, bien sûr, et avec elle ses juteuses recettes publicitaires."
                                            },
                                            {
                                                "example_id": "dfe754ae-245a-4582-8810-1117aff143cf",
                                                "sense_id": "029f7e0d-7e20-3413-b3cc-1e5d85bd60a9",
                                                "text": "Il m’a également demandé de retrouver des comptes bancaires aux îles Caïman[sic] ouverts par des représentants d’un cartel qui avaient acheté des concessions juteuses dans le Golfe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "juteux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c00774e-51fa-33bd-8162-20985e7cc015",
                                        "entry_id": "7579d791-519f-3a0b-bac8-723c8c247fda",
                                        "glosses": [
                                            "Adjudant."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d90c963f-9d3e-498c-b239-a3589c7fab89",
                                                "sense_id": "7c00774e-51fa-33bd-8162-20985e7cc015",
                                                "text": "Dès le deuxième litre, il entama les souvenirs du régiment ; il passa la revue de tous les camarades de chambrée et de tous les chefs, du colon au dernier des cabots, en passant par le capiston, le yeutenant, le juteux, le doublard et le piédeban […]"
                                            },
                                            {
                                                "example_id": "818ac50f-52f3-4602-ba16-671519cbca5b",
                                                "sense_id": "7c00774e-51fa-33bd-8162-20985e7cc015",
                                                "text": "Le juteux du ravitaillement, gardien des haines du régiment, pour l’instant le maître du monde."
                                            },
                                            {
                                                "example_id": "1bf59e76-37a4-4c41-9819-d73848187000",
                                                "sense_id": "7c00774e-51fa-33bd-8162-20985e7cc015",
                                                "text": "C’est moi, encore, qui entretiens ton fils, qui lui permets de faire le clown à son école, avec des zigotos de ton espèce, des juteux et des sous-offs pas capables de travailler de leurs deux mains comme tout le monde !"
                                            },
                                            {
                                                "example_id": "98b47f3a-dc96-413d-95a6-b5489aa49e8f",
                                                "sense_id": "7c00774e-51fa-33bd-8162-20985e7cc015",
                                                "text": "On troque l’affûtiau pour de l’uniforme, on plie sous la clique sergots et juteux, on voit comme partout le Commandement crâner seigneurial avec la badine du haut des dadas […]"
                                            },
                                            {
                                                "example_id": "6b93184d-62e5-4554-9bf2-e5980988884f",
                                                "sense_id": "7c00774e-51fa-33bd-8162-20985e7cc015",
                                                "text": "Ce fut, pêle-mêle, l’ingratitude des concitoyens plus enclins à débiner les chaussettes à clous qu'à les soutenir, les manies exaspérantes du margis Barguinoux et les sornettes lourdingues du juteux Pénardin, la promotion qui ne viendrait jamais, je ne sais quoi encore, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
