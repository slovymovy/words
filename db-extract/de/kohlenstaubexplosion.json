                "senses": [
                    {
                        "sense_id": "5dd62187-2a5f-3ed4-aa68-437263e7d6e5",
                        "entry_id": "28facea3-3512-324f-9b0e-d9271d5f0440",
                        "glosses": [
                            "plötzliche Verbrennung von in der Luft fein verteiltem Kohlenstaub"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4161cc4c-5260-47b4-9b0d-4d6c029bc2f8",
                                "sense_id": "5dd62187-2a5f-3ed4-aa68-437263e7d6e5",
                                "text": "„Insgesamt waren 221 Bergleute unter Tage, als es am Sonntagabend zur Kohlenstaubexplosion kam und das Ventilationssystem lahm gelegt wurde.“"
                            },
                            {
                                "example_id": "12e3c393-fe1c-4743-8927-246a61299c61",
                                "sense_id": "5dd62187-2a5f-3ed4-aa68-437263e7d6e5",
                                "text": "„Zum Zeitpunkt der Kohlenstaubexplosion am Sonntagabend arbeiteten 220 Bergleute in dem Bergwerk in Qitaihe mehr als 300 Kilometer östlich von Harbin.“"
                            },
                            {
                                "example_id": "bd136c7d-c047-4f72-a862-39827877a2b5",
                                "sense_id": "5dd62187-2a5f-3ed4-aa68-437263e7d6e5",
                                "text": "„Auf diese Schlagwetterexplosion folgte eine noch stärkere Kohlenstaubexplosion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
