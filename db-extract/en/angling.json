                                        "entry_id": "d01a8452-9412-3d48-a12d-775a366919eb",
                                        "glosses": [
                                            "Landschaft (Halbinsel) im Nordosten Schleswig-Holsteins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53ac5176-894a-4477-a49f-85648cba7055",
                                                "sense_id": "cba215ce-9657-3887-8907-53d9e18b529a",
                                                "text": "„Die Inschriften aus dem Thorsberger Moor in Angeln gehören in den zeitgleichen Horizont der Moorfunde von Jütland (Illerup) und Fünen (Vimose) und sind auf ca. 200 n. Chr. zu datieren.“"
                                            }
                                        ],
