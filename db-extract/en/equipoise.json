            {
                "entry_id": "c624f675-bbdc-37ce-9356-4af8a4b07726",
                "word": "equipoise",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9f94d383-e02c-4d3d-bb05-93133d9f64c4",
                        "entry_id": "c624f675-bbdc-37ce-9356-4af8a4b07726",
                        "tags": [
                            "plural"
                        ],
