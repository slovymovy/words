        "fr-extract.jsonl": [
            {
                "entry_id": "ce08d853-c503-3c16-857e-db8bd30473eb",
                "word": "massivement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "808e1c09-34f3-3c12-bcba-843d9de9f770",
                        "entry_id": "ce08d853-c503-3c16-857e-db8bd30473eb",
                        "glosses": [
                            "D’une manière massive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c831ae0d-0a90-4325-84cb-a9d4686227a8",
                                "sense_id": "808e1c09-34f3-3c12-bcba-843d9de9f770",
                                "text": "Cela est bâti massivement."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8f8888b-1a26-36a4-aadb-cfbbf321bf10",
                        "entry_id": "ce08d853-c503-3c16-857e-db8bd30473eb",
                        "glosses": [
                            "Comme une masse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50aef13f-ff2b-4e3c-b901-051303c5a33c",
                                "sense_id": "c8f8888b-1a26-36a4-aadb-cfbbf321bf10",
                                "text": "L'autre, sans se presser, lui plaçait crochets et directs […] et quand le rouquin l'atteignait d'une détente farouche, il encaissait le coup, massivement."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed733b40-6b96-3eb4-97fa-5f0049fed0be",
                        "entry_id": "ce08d853-c503-3c16-857e-db8bd30473eb",
                        "glosses": [
                            "En grand nombre."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1f83b4c1-dbbb-4f34-bfd2-ae1768ff3c28",
                                "sense_id": "ed733b40-6b96-3eb4-97fa-5f0049fed0be",
                                "text": "Pour l’essentiel, les Gâtineaux se situent dans la norme catholique en observant et respectant massivement les grands préceptes de l’Église de la Contre-Réforme."
                            },
                            {
                                "example_id": "7e4dfcd9-5d7b-4c32-8246-32d635392f6f",
                                "sense_id": "ed733b40-6b96-3eb4-97fa-5f0049fed0be",
                                "text": "Cette dénonciation et les images ont été relayées massivement sur les réseaux sociaux."
                            },
                            {
                                "example_id": "417fd79b-a1ff-4d45-b524-5e73c8926ce7",
                                "sense_id": "ed733b40-6b96-3eb4-97fa-5f0049fed0be",
                                "text": "Plus de pouvoir à l’Ouest?\n Ce changement risque de réduire \"massivement\" le poids du Québec dans une future course à la chefferie conservatrice, selon certains conservateurs québécois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12ddfd28-59da-4860-8e18-c507b8ec2a5e",
                        "source_entry_id": "ce08d853-c503-3c16-857e-db8bd30473eb",
                        "target_lang_word": "cumbersomely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cumbersomely",
