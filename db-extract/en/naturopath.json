                            },
                            {
                                "target_word": "naturopathe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a26af72e-6053-3e61-8a9a-bcbe1fd796cc",
                                        "entry_id": "9f88e868-338b-3769-b450-9ab3c06ea01a",
                                        "glosses": [
                                            "Personne pratiquant la naturopathie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b58b0cb-4251-4315-aa82-f33f600d57e6",
                                                "sense_id": "a26af72e-6053-3e61-8a9a-bcbe1fd796cc",
                                                "text": "C’est dommage, car il y a actuellement toutes sortes d’associations, de formations de naturopathe. Nous estimons qu’un ordre professionnel serait la meilleure façon d’encadrer la profession."
                                            },
                                            {
                                                "example_id": "7e536fb4-09a0-4bf4-8aab-02c6e9e96fea",
                                                "sense_id": "a26af72e-6053-3e61-8a9a-bcbe1fd796cc",
                                                "text": "Ses parents, adeptes de la communauté associative Joie et Loisirs créée en 1989 dans le département de l’Yonne, limitaient les apports alimentaires aux fruits, fromages, produits laitiers et à l’eau, à la demande de la fondatrice de la communauté, conseillère en assistance personnelle et naturopathe."
                                            },
                                            {
                                                "example_id": "f2c0cd55-2429-4779-8183-677cf3ecbc5f",
                                                "sense_id": "a26af72e-6053-3e61-8a9a-bcbe1fd796cc",
                                                "text": "La privation de l’alimentation est de plus en plus promue par des naturopathes ou coachs en développement personnel. Mais cette pratique peut s’avérer dangereuse et a déjà conduit à des décès."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
