                },
                {
                    "sense_id": "e160570b-6e16-3c0c-a8fc-88289738fe66",
                    "sense_definition": "Bohater utworu literackiego, zwłaszcza dramatu; postać sceniczna.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "literatura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na początku książki znajduje się spis wszystkich <w>osób</w> dramatu.",
                            "target_lang_translations": {
                                "ru": "В начале книги находится список всех действующих <w>лиц</w> драмы.",
                                "en": "At the beginning of the book, there is a list of all the <w>characters</w> of the play."
                            }
                        },
                        {
                            "text": "Aktor doskonale wcielił się w <w>osobę</w> głównego bohatera.",
                            "target_lang_translations": {
                                "ru": "Актер отлично вжился в <w>образ</w> главного героя.",
                                "en": "The actor perfectly embodied the <w>character</w> of the main protagonist."
                            }
                        }
