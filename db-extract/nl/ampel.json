                                                "sense_id": "d155e6f2-6439-31ef-96f8-2bebbe4d7f6a",
                                                "text": "…a line of wooden troughs supplies ample water for irrigation."
                                            },
                                            {
                                                "example_id": "2b9c3ead-3a82-481b-940a-43b6c7a3ec36",
                                                "sense_id": "d155e6f2-6439-31ef-96f8-2bebbe4d7f6a",
                                                "text": "…possesses an ample supply of water-power for industrial purposes."
                                            }
                                        ]
                                    },
