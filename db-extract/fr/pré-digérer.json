                        "glosses": [
                            "Préparer le travail de digestion de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74603040-509a-4890-ab1b-46c281a70e98",
                                "sense_id": "d963947d-a487-3ff4-8821-d1dd61dbf9a3",
                                "text": "Ils récoltent les aliments, les pré-digèrent puis les redistribuent par trophallaxie."
                            },
                            {
                                "example_id": "6fef5f14-824d-4fb0-9191-49d59ee7b169",
                                "sense_id": "d963947d-a487-3ff4-8821-d1dd61dbf9a3",
                                "text": "Dans cette cavité, elles déversent leurs sucs gastriques qui pré-digèrent la nourriture, la dégradent au point de ne laisser que ce qui est ingérable sans reste, ce qui est nécessaire et suffisant pour survivre à la dépense d’énergie."
                            }
                        ]
                    }
