                                        "examples": [
                                            {
                                                "example_id": "c7e91890-80f8-4557-9baa-1539d3b360a5",
                                                "sense_id": "0c34bda3-d1f4-3e63-a1c1-44cb16d5bfb8",
                                                "text": "„Wer länger arbeitet, erhält dafür aber auch einen höheren ZF. Achtung: Von 2012 an wird die Altersgrenze stufenweise angehoben. Wer 1947 geboren wurde, muss einen Monat länger arbeiten, wer 1948 geboren wurde, zwei Monate länger, und so weiter.“"
                                            },
                                            {
                                                "example_id": "979e7686-325c-4121-8677-f336505ca8f4",
                                                "sense_id": "0c34bda3-d1f4-3e63-a1c1-44cb16d5bfb8",
                                                "text": "Der Unterricht schreitet stufenweise fort."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "stufenweise",
