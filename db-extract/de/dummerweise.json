        "de-extract.jsonl": [
            {
                "entry_id": "456f57ee-c71b-37e0-b3ce-36669e9e9674",
                "word": "dummerweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "722416fa-0194-3787-a533-e55be63186e9",
                        "entry_id": "456f57ee-c71b-37e0-b3ce-36669e9e9674",
                        "glosses": [
                            "durch einen unglücklichen Umstand, Zufall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4aa6b96-736f-48b1-86b5-786b7ff60469",
                                "sense_id": "722416fa-0194-3787-a533-e55be63186e9",
                                "text": "Dummerweise ist der Stein zu genau dem Zeitpunkt, an dem er keinen Helm aufhatte, auf seine Kopf gefallen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4cf1dbcc-b9f1-3544-b891-dd5426505a0d",
                        "entry_id": "456f57ee-c71b-37e0-b3ce-36669e9e9674",
                        "glosses": [
                            "aus Dummheit, Leichtsinn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c88af01-bdd8-4a3b-94b1-f7a5939c94dc",
                                "sense_id": "4cf1dbcc-b9f1-3544-b891-dd5426505a0d",
                                "text": "Dummerweise vergisst er immer wieder sein Schulzeug zu Hause."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9360bde-941f-415d-a8d6-c7e31b186b39",
                        "source_entry_id": "456f57ee-c71b-37e0-b3ce-36669e9e9674",
                        "source_sense_id": "722416fa-0194-3787-a533-e55be63186e9",
                        "source_sense_description": "durch einen unglücklichen Umstand, Zufall",
                        "target_lang_word": "unfortunately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfortunately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bf31a51-c605-3352-82e9-c91eac358792",
                                        "entry_id": "521ce821-1ab0-307e-a1d8-c17328e7623a",
                                        "glosses": [
                                            "Happening through bad luck, or because of some unfortunate event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84ce75ac-8f87-4bf9-8669-432f4c70b841",
                                                "sense_id": "8bf31a51-c605-3352-82e9-c91eac358792",
                                                "text": "He unfortunately placed his hand on a loose brick."
                                            },
                                            {
                                                "example_id": "47ae135d-ce12-4834-bcee-d6163467ddc3",
                                                "sense_id": "8bf31a51-c605-3352-82e9-c91eac358792",
                                                "text": "There were an unfortunately large number of misprints."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d273657a-4e7b-30a5-bb08-848d17ec88b1",
                                        "entry_id": "521ce821-1ab0-307e-a1d8-c17328e7623a",
                                        "glosses": [
                                            "Used (as a parenthetical word, often a sentence adverb) to express disappointment, compassion, sorrow, regret, or grief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ba47605-dbd2-42dd-800e-e02ccae84587",
                                                "sense_id": "d273657a-4e7b-30a5-bb08-848d17ec88b1",
                                                "text": "The houses which burned down could have been saved. Unfortunately, the fire truck had broken down on the way."
                                            },
                                            {
                                                "example_id": "867e3970-a28e-46cf-bbb3-df76ad911b6f",
                                                "sense_id": "d273657a-4e7b-30a5-bb08-848d17ec88b1",
                                                "text": "Unfortunately, the uproar awoke Mr. Jones, who sprang out of bed, making sure that there was a fox in the yard."
                                            },
                                            {
                                                "example_id": "c73f7a54-4e8a-49f0-bdf3-31603aabaaf1",
                                                "sense_id": "d273657a-4e7b-30a5-bb08-848d17ec88b1",
                                                "text": "Unfortunately, even in the palmiest days of the old Cockermouth, Keswick & Penrith Railway Company, passengers were few and far between at Troutbeck, and since the advent of the motor bus road services they are rarer than ever, and never likely to increase."
                                            },
                                            {
                                                "example_id": "21c15e1c-0757-4f09-9a58-44cd513e358c",
                                                "sense_id": "d273657a-4e7b-30a5-bb08-848d17ec88b1",
                                                "text": "Informal techniques, if properly written, can be quite readable and comprehensible; unfortunately, it is easy to leave unsaid details that must be specified, or to misgeneralise and produce inconsistencies."
                                            },
                                            {
                                                "example_id": "8929fc68-45d5-4f44-9906-e05573808b17",
                                                "sense_id": "d273657a-4e7b-30a5-bb08-848d17ec88b1",
                                                "text": "The thing he unfortunately doesn't recognise is there is an 800-pound gorilla when it comes to major American motor sports. The 800-pound gorilla is Nascar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbab5f65-267b-4fce-b749-cd2a4a7da83c",
                        "source_entry_id": "456f57ee-c71b-37e0-b3ce-36669e9e9674",
                        "source_sense_id": "4cf1dbcc-b9f1-3544-b891-dd5426505a0d",
                        "source_sense_description": "aus Dummheit, Leichtsinn",
                        "target_lang_word": "foolishly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foolishly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0c3253a-11e4-3fea-b6a5-38968daafd89",
                                        "entry_id": "d03d8082-bf68-359c-aeb5-d8cea470cbe4",
                                        "glosses": [
                                            "In a foolish manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54204a58-e657-437f-9889-75f85fe2fd74",
                                                "sense_id": "d0c3253a-11e4-3fea-b6a5-38968daafd89",
                                                "text": "He dressed foolishly to entertain the children."
                                            },
                                            {
                                                "example_id": "318ddac9-000a-4de7-8850-186e20c70e58",
                                                "sense_id": "d0c3253a-11e4-3fea-b6a5-38968daafd89",
                                                "text": "I never wish to offend, but I am so foolishly shy, that I often seem negligent, when I am only kept back by my natural aukwardness."
                                            },
                                            {
                                                "example_id": "21e51553-8547-4cc9-bf5f-47640497c46d",
                                                "sense_id": "d0c3253a-11e4-3fea-b6a5-38968daafd89",
                                                "text": "“Nothing to speak of,” said Adam Woodcock, answering for the boy—“a foolish quarrel with me, which was more foolishly told over again to my honoured lady, cost the poor boy his place.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5918af54-4e47-32ec-ad7c-916ed81e336e",
                                        "entry_id": "d03d8082-bf68-359c-aeb5-d8cea470cbe4",
                                        "glosses": [
                                            "Without good judgment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c6ae2c0-6925-42e3-9b61-966c672840b3",
                                                "sense_id": "5918af54-4e47-32ec-ad7c-916ed81e336e",
                                                "text": "Foolishly, he had decided that, because a home was the best investment, two homes were even better."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
