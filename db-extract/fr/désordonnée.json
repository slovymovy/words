                        "glosses": [
                            "Femme qui n’est pas ordonnée, pas organisée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c23e3875-d622-444c-afa8-5a772a786534",
                                "sense_id": "1af5505e-949f-3107-9df8-abc42ca85fe8",
                                "text": "Eh bien, nous avons une désordonnée ! Mademoiselle Murano, vous êtes une grande désordonnée."
                            },
                            {
                                "example_id": "f7efffce-e279-4643-91db-5711337b93ea",
                                "sense_id": "1af5505e-949f-3107-9df8-abc42ca85fe8",
                                "text": "Je suis une désordonnée chronique : aidez-moi!"
                            }
                        ]
                    },
                    {
                        "sense_id": "0091e55e-a355-36b9-8479-cb04fd4798df",
                        "entry_id": "0df82286-f209-3d1a-8381-0a700607f017",
                        "glosses": [
                            "Femme qui manque d’ordre mental, spirituel."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e7cdd833-a30c-4c47-9e82-5aea3a097a6f",
                                "sense_id": "0091e55e-a355-36b9-8479-cb04fd4798df",
                                "text": "Considérer Jeanne, une personne si droite et si vertueuse, si parfaitement équilibrée, si entière, comme une détraquée, une désordonnée, victime de tares physiologiques ou de lésions cérébrales, cela échappe complètement à la conception que nous avons normalement de la maladie et de la santé."
                            }
                        ]
                    }
