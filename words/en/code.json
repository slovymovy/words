                                "target_lang_word": "加密",
                                "target_lang_sense_clarification": "为保密而转换"
                            },
                            {
                                "target_lang_word": "编码",
                                "target_lang_sense_clarification": "为传输而转换格式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00f1e811-f1d0-3484-9129-b1e08d211962",
                    "sense_definition": "To suffer a sudden medical emergency, such as cardiac arrest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient in room four <w>coded</w> suddenly, and the team rushed in to help.",
                            "target_lang_translations": {
                                "ru": "У пациента в четвертой палате внезапно <w>остановилось сердце</w>, и бригада врачей бросилась на помощь.",
                                "tr": "Dört numaralı odadaki hastanın aniden <w>kalbi durdu</w> ve ekip yardım etmek için içeri koştu.",
                                "zh": "四号病房的病人突然<w>心脏骤停</w>，医疗团队迅速赶去抢救。"
                            }
                        },
                        {
                            "text": "Nurses are trained to react instantly if a patient <w>codes</w>.",
                            "target_lang_translations": {
                                "ru": "Медсестры обучены реагировать мгновенно, если у пациента <w>происходит остановка сердца</w>.",
                                "tr": "Hemşireler, bir hastanın <w>kalbi durduğunda</w> anında müdahale edecek şekilde eğitilir.",
                                "zh": "护士们受过培训，一旦病人<w>心脏骤停</w>，她们会立即做出反应。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "medical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пережить внезапное критическое состояние, например, остановку сердца (медицинский жаргон).",
                        "tr": "Kalp durması gibi ani bir tıbbi acil durum yaşamak (tıbbi terim).",
                        "zh": "经历突发的医疗紧急情况，如心脏骤停（医学术语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переживать остановку сердца",
                                "target_lang_sense_clarification": "мед. жаргон: впадать в критическое состояние (to code)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kalbi durmak",
                                "target_lang_sense_clarification": "tıbbi acil durum yaşamak"
                            },
                            {
                                "target_lang_word": "kriz geçirmek",
                                "target_lang_sense_clarification": "ani tıbbi müdahale gerektiren durum"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "心脏骤停",
                                "target_lang_sense_clarification": "医学紧急状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
