                            {
                                "example_id": "691abfb7-757f-43fa-adfe-760432911f99",
                                "sense_id": "422f7641-c228-37eb-8ed6-30504d4cf641",
                                "text": "De sporter heeft een medisch attest voor het middel waarvan sporen werden aangetroffen bij de dopingcontrole."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc9a97cc-089f-45c1-976f-594ce4497d9b",
                        "source_entry_id": "43959ef7-c21d-3dc0-9e5c-3e559b18d599",
                        "source_sense_id": "422f7641-c228-37eb-8ed6-30504d4cf641",
                        "source_sense_description": "schriftelijk bewijs",
                        "target_lang_word": "Attest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Attest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc5efd01-f201-383f-8faa-b107b4b51d5c",
                                        "entry_id": "9bc0862e-95c8-36a1-8186-f52e9ac5b5fe",
                                        "glosses": [
                                            "eine ärztliche Bescheinigung oder ein Gesundheitszeugnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1e3d767-97be-4ec5-ae12-7fe6123cdd32",
                                                "sense_id": "fc5efd01-f201-383f-8faa-b107b4b51d5c",
                                                "text": "Wenn man krank ist, muss man dem Arbeitgeber ein Attest vorlegen."
                                            },
                                            {
                                                "example_id": "e0d87a95-5e8a-4ccb-8b41-26c47a795f53",
                                                "sense_id": "fc5efd01-f201-383f-8faa-b107b4b51d5c",
                                                "text": "„Bei ihm bekam ich nämlich Atteste, um die Schule zu schwänzen.“"
                                            },
                                            {
                                                "example_id": "60696690-6cfe-4ef9-93b0-24d3ac8b4044",
                                                "sense_id": "fc5efd01-f201-383f-8faa-b107b4b51d5c",
                                                "text": "„In einem Koffer hatte der Angeklagte auch noch ein Attest über seine Haftunfähigkeit, das ihm aber nichts genützt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5601db2c-3fe8-41f7-b49c-0e6be5924d55",
                        "source_entry_id": "43959ef7-c21d-3dc0-9e5c-3e559b18d599",
                        "source_sense_id": "422f7641-c228-37eb-8ed6-30504d4cf641",
                        "source_sense_description": "schriftelijk bewijs",
                        "target_lang_word": "Zeugnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeugnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5713e2ff-9431-34b0-af1a-85649b95d105",
                                        "entry_id": "9863c18f-3b68-3105-940b-aa973fce59c0",
                                        "glosses": [
                                            "Zeugenaussage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb0090f1-14b2-4f7d-8590-fc9318b2d493",
                                                "sense_id": "5713e2ff-9431-34b0-af1a-85649b95d105",
                                                "text": "Sie hat gestern ihr Zeugnis abgelegt und den Angeklagten damit entlastet."
                                            },
                                            {
                                                "example_id": "af6f3905-37c7-4475-831f-fb8a77a57c1c",
                                                "sense_id": "5713e2ff-9431-34b0-af1a-85649b95d105",
                                                "text": "„Ich müßte wirklich wahnsinnig sein, wenn ich da Glauben verlangen wollte, wo ich selbst das Zeugnis meiner eigenen Sinne verwerfen möchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dc17ecb9-ab21-32a6-b038-575752d1595b",
                                        "entry_id": "9863c18f-3b68-3105-940b-aa973fce59c0",
                                        "glosses": [
                                            "schriftliches Dokument, das eine Leistungsbewertung beurkundet, Nachweis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84662b63-16e7-4a91-a6c5-80e7c0bd90f2",
                                                "sense_id": "dc17ecb9-ab21-32a6-b038-575752d1595b",
                                                "text": "Ich habe heute die Prüfung bestanden und morgen bekomme ich das Zeugnis."
                                            },
                                            {
                                                "example_id": "8738ed2f-5f80-4a15-9f60-69d570d2c332",
                                                "sense_id": "dc17ecb9-ab21-32a6-b038-575752d1595b",
                                                "text": "„An meinem Zeugnis war das beste die Eins in Musik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dab4916a-9ab2-3f19-bf0a-d0feb44aa77e",
                                        "entry_id": "9863c18f-3b68-3105-940b-aa973fce59c0",
                                        "glosses": [
                                            "anschaulicher Beweis eines Sachverhalts, klar erkennbares Zeichen"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3950ca1-8329-49fb-8063-81dc3dd2b92d",
                                                "sense_id": "dab4916a-9ab2-3f19-bf0a-d0feb44aa77e",
                                                "text": "Dass er sich gestern zurückgehalten hat, war ein Zeugnis seines Vertrauens."
                                            },
                                            {
                                                "example_id": "84c36c03-94d6-4be7-9a24-7f08f4b47916",
                                                "sense_id": "dab4916a-9ab2-3f19-bf0a-d0feb44aa77e",
                                                "text": "„Seine Eintragungen im Logbuch entsprachen, was Rechtschreibung und die Zeichensetzung betraf, nicht den Regeln, doch das gilt für viele schriftliche Zeugnisse der damaligen Zeit.“"
                                            },
                                            {
                                                "example_id": "f9ea1ef5-242c-41e1-8753-fae348635a58",
                                                "sense_id": "dab4916a-9ab2-3f19-bf0a-d0feb44aa77e",
                                                "text": "„Seit Beginn der dreißiger Jahre war Louis Leakey im östlichen Afrika auf der Suche nach Zeugnissen der Existenz menschlicher Vorfahren; vor allem suchte er Steinwerkzeuge.“"
                                            },
                                            {
                                                "example_id": "b929bb32-406e-49ba-b671-3b8c1ae0c324",
                                                "sense_id": "dab4916a-9ab2-3f19-bf0a-d0feb44aa77e",
                                                "text": "„Das Buch [Anm.: über die jüdische Ärztin Lilly Jahn] wurde zu einem großen Erfolg – zu recht, denn es zählt neben dem Tagebuch der Anne Frank und den Aufzeichnungen Victor Klemperers zu den herausragenden Zeugnissen des Holocaust.“"
                                            },
                                            {
                                                "example_id": "c79b97a1-8082-4b8d-934e-effb1588ef0d",
                                                "sense_id": "dab4916a-9ab2-3f19-bf0a-d0feb44aa77e",
                                                "text": "„In den Sälen der sieben Stockwerke, die wie breite Höhlen in den Fels der Erde geschlagen waren, standen in hohen Reihen die Konvolute, Mappen, Bücher und Schriftrollen geordnet, in deren Zeugnissen die Vergangenheit sich als Gegenwart überlieferte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ac0b147c-12aa-3cc9-9b82-b0ce5c91d42e",
                                        "entry_id": "9863c18f-3b68-3105-940b-aa973fce59c0",
                                        "glosses": [
                                            "ein persönlicher Bekehrungsbericht, oder Bericht einer Gotteserfahrung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d55379df-42b8-4908-a3fb-21ec90e3a137",
                                                "sense_id": "ac0b147c-12aa-3cc9-9b82-b0ce5c91d42e",
                                                "text": "Zeugnisse in diesem Sinne können sowohl kurze Einschübe in Alltagsgesprächen sein als auch vortragsähnliche Erfahrungsberichte."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
