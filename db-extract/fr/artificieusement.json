                                "example_id": "acc75d4c-5bfd-43cf-93bb-4f8a922a2945",
                                "sense_id": "bd562f56-b145-387b-bf3b-aedf63c9e9da",
                                "text": "Pendant plusieurs mois, personne en France n’a pu connaître mes écrits que par des lambeaux de phrases artificieusement découpés, déformés par mes ennemis."
                            },
                            {
                                "example_id": "872b0adc-54c1-45ee-b650-b86f0f62a3cb",
                                "sense_id": "bd562f56-b145-387b-bf3b-aedf63c9e9da",
                                "text": "Il a exposé le fait très artificieusement."
                            }
                        ]
                    }
