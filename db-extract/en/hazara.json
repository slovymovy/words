                                        "sense_id": "9a3c5f37-2b50-357a-b627-25ce057fa1ef",
                                        "entry_id": "cb154f63-ae91-34ef-bb2f-d9aa73e55027",
                                        "glosses": [
                                            "Volk, das vor allem in und um Afghanistan lebt"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eea6f5e4-7bbd-411a-8145-4b89108d4c16",
                                                "sense_id": "9a3c5f37-2b50-357a-b627-25ce057fa1ef",
                                                "text": "„In Belutschistan zahlenmäßig relativ bedeutend ist die ethnische Minderheit der Hazaras.“"
                                            },
                                            {
                                                "example_id": "429fb47c-fef2-4c20-978c-22a34cd410a6",
                                                "sense_id": "9a3c5f37-2b50-357a-b627-25ce057fa1ef",
                                                "text": "„Denn Mahmud begnügte sich nicht mit der Herrschaft über Kandahar, sondern brach mit einer zusammengewürfelten Truppe aus Paschtunen, Hazaras und Belutschen auf, das Safawidenreich zu erobern.“"
                                            },
                                            {
                                                "example_id": "7f1d6a80-5fe3-4ee9-93ff-ecad061800db",
                                                "sense_id": "9a3c5f37-2b50-357a-b627-25ce057fa1ef",
                                                "text": "„Diese frühen Taliban weigerten sich kategorisch, am modernen Leben teilzunehmen. Sie hängten Fernsehgeräte und Computer an Bäume und gingen brutal gegen schiitische Muslime wie die Hazara vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
