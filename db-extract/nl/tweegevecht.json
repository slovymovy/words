        "nl-extract.jsonl": [
            {
                "entry_id": "831543cf-96fc-3438-886f-6a498fc1dd39",
                "word": "tweegevecht",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "10fc9214-a63e-4ecf-ae64-d64e8c1e1ad6",
                        "entry_id": "831543cf-96fc-3438-886f-6a498fc1dd39",
                        "tags": [
                            "plural"
                        ],
                        "form": "tweegevechten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55798684-9b89-3a5a-aa16-c2909db8b0cf",
                        "entry_id": "831543cf-96fc-3438-886f-6a498fc1dd39",
                        "glosses": [
                            "gevecht tussen twee personen of groepen, wedstrijd tussen twee personen of teams"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5371adae-bb9e-430f-90c2-30e88d910168",
                                "sense_id": "55798684-9b89-3a5a-aa16-c2909db8b0cf",
                                "text": "‘Zo’n crisette beheren en afsluiten is niet eenvoudig’, stelt een betrokkene voorzichtig. ‘Je weet nooit waar het eindigt.’ Eén ding is zeker: de tweegevechten doen er geen deugd aan. Inhoudelijk raakt de kloof geen millimeter gedicht, psychologisch wordt hij evenwel dieper telkens als belangrijke protagonisten elkaar publiekelijk in de haren vliegen."
                            },
                            {
                                "example_id": "3146846c-6594-4333-aa20-922650556a77",
                                "sense_id": "55798684-9b89-3a5a-aa16-c2909db8b0cf",
                                "text": "Het wereldkampioenschap in de Formule 1 ontaardt meer en meer in een tweegevecht. Na winst in Australië voor Sebastian Vettel en winst voor Lewis Hamilton in China, mocht Vettel in Bahrein wéér vieren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d598939-7113-4c51-af55-5879a3aaeb3c",
                        "source_entry_id": "831543cf-96fc-3438-886f-6a498fc1dd39",
                        "source_sense_id": "55798684-9b89-3a5a-aa16-c2909db8b0cf",
                        "source_sense_description": "eduel",
                        "target_lang_word": "duel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "duel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32c59d3b-5d68-3177-8250-7336bfbd50e8",
                                        "entry_id": "60d65154-df46-3e2c-9fa1-215c12fb41af",
                                        "glosses": [
                                            "Arranged, regular combat between two private persons, often over a matter of honor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "027934ac-fb20-4e25-9cef-fd59711dd130",
                                                "sense_id": "32c59d3b-5d68-3177-8250-7336bfbd50e8",
                                                "text": "I have often thought since, how different my fate might have been, had I not fallen in love with Nora at that early age; and had I not flung the wine in Quin’s face, and so brought on the duel."
                                            },
                                            {
                                                "example_id": "cf11bb53-e240-4f9b-bec0-5366801a2ad9",
                                                "sense_id": "32c59d3b-5d68-3177-8250-7336bfbd50e8",
                                                "text": "It has been 200 years, minus a few days, since Vice President Aaron Burr fatally shot Alexander Hamilton in a duel here. Weehawken and the duel have been tied together in an often-uncomfortable knot ever since."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12af2609-3a18-3b20-ac62-1dfaeb80867d",
                                        "entry_id": "60d65154-df46-3e2c-9fa1-215c12fb41af",
                                        "glosses": [
                                            "Historically, the wager of battle (judicial combat)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1dbd89ec-1c46-351e-85e2-b41df2c72ec3",
                                        "entry_id": "60d65154-df46-3e2c-9fa1-215c12fb41af",
                                        "glosses": [
                                            "Any battle or struggle between two contending persons, forces, groups, or ideas."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac26d2e5-5d21-4ee4-bfbd-48112d6e3dd5",
                                                "sense_id": "1dbd89ec-1c46-351e-85e2-b41df2c72ec3",
                                                "text": "a sniper duel"
                                            },
                                            {
                                                "example_id": "d01303a1-c020-4e09-a034-26d453a1f64a",
                                                "sense_id": "1dbd89ec-1c46-351e-85e2-b41df2c72ec3",
                                                "text": "But it leaves them with a few destroyers, the American destroyer force is falling back, and then you have the two cruiser lines with their respective battleships coming in for the big duel."
                                            },
                                            {
                                                "example_id": "4362ba4d-c1a1-41a6-ade2-5fcf532ba581",
                                                "sense_id": "1dbd89ec-1c46-351e-85e2-b41df2c72ec3",
                                                "text": "Apple comes out swinging in the duel of the data titans [title]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "duel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bb44d44-c768-3042-a76b-fb737a907e43",
                                        "entry_id": "330ba72b-1f7f-358e-b710-d78a4c9f5e5f",
                                        "glosses": [
                                            "To engage in a battle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4831529f-6f01-4437-b447-66eaa9b92159",
                                                "sense_id": "4bb44d44-c768-3042-a76b-fb737a907e43",
                                                "text": "The two dogs were duelling for the bone."
                                            },
                                            {
                                                "example_id": "3c622e13-be67-42db-ae1d-3ac1358a4a0d",
                                                "sense_id": "4bb44d44-c768-3042-a76b-fb737a907e43",
                                                "text": "The country’s fencing federation has officially recognised lightsaber duelling as a competitive sport, granting the weapon from George Lucas’s space saga the same status as the foil, epee and sabre, the traditional blades used at the Olympics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
