                    {
                        "form_id": "cf37c80a-84fc-404f-9762-75089e6712b8",
                        "entry_id": "25a5ccae-df2a-39d5-9288-80c0e10d836d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Knute"
                    },
                    {
                        "form_id": "fc8c3ada-b901-4d17-b882-edb576eff7cf",
                        "entry_id": "25a5ccae-df2a-39d5-9288-80c0e10d836d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Knuten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "316479c8-deef-3bd5-86e7-3227cab863b0",
                        "entry_id": "25a5ccae-df2a-39d5-9288-80c0e10d836d",
                        "glosses": [
                            "„Peitsche mit kurzem Griff und angehängten Lederriemen“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15e1f22e-ea03-40ac-abb9-edf8f55ef886",
                                "sense_id": "316479c8-deef-3bd5-86e7-3227cab863b0",
                                "text": "„Die berittenen Fahrer schlugen mit Knuten auf die Pferde.“"
                            },
                            {
                                "example_id": "b17dde93-5e7b-48b4-93f5-7fdf5a38962f",
                                "sense_id": "316479c8-deef-3bd5-86e7-3227cab863b0",
                                "text": "„Sie wurden im ostsibirischen Jakutsk öffentlich mit der Knute ausgepeitscht.“"
                            },
                            {
                                "example_id": "66ed2725-3563-4e5d-93f4-669292c15e62",
                                "sense_id": "316479c8-deef-3bd5-86e7-3227cab863b0",
                                "text": "„Die wässerigen Augen der Megären glotzten leer zur Kellerdecke, die Knuten hingen schlaff von den Hüften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ae36e223-d31f-306d-b102-2fb6780f82cf",
                        "entry_id": "25a5ccae-df2a-39d5-9288-80c0e10d836d",
                        "glosses": [
                            "willkürliche Herrschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8874ea7e-37b5-4f26-842b-96bac5db9e5b",
                                "sense_id": "ae36e223-d31f-306d-b102-2fb6780f82cf",
                                "text": "Sie standen alle unter der Knute ihres Chefs."
                            },
                            {
                                "example_id": "90613cba-372a-4f6f-b420-04c8462d6320",
                                "sense_id": "ae36e223-d31f-306d-b102-2fb6780f82cf",
                                "text": "„Unwillkürlich muss ich an meinen Nachbarn denken, der sich jeden Morgen wie ein geprügelter Hund ins Büro schleppt und ansonsten unter der Knute seiner Frau steht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "992fae25-4ee7-4e63-9936-9447c8d1fb3d",
                        "source_entry_id": "25a5ccae-df2a-39d5-9288-80c0e10d836d",
                        "source_sense_id": "316479c8-deef-3bd5-86e7-3227cab863b0",
                        "target_lang_word": "knout",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecdcdcc5-94d0-373d-ab8e-73b1a3e3b5c2",
                                        "entry_id": "02dd981d-be12-3f29-b641-882334eaa886",
                                        "glosses": [
                                            "A leather scourge (multi-tail whip), in the severe version known as 'great knout' with metal weights on each tongue, notoriously used in imperial Russia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44bc8b68-b28e-49b0-af61-2ffba1117ba4",
                                                "sense_id": "ecdcdcc5-94d0-373d-ab8e-73b1a3e3b5c2",
                                                "text": "In Moscow, a Court carbonadoes / His ignorant serfs with the knout; / […] / But Eton has crueller terrors / Than these,—in the Windsor Express."
                                            },
                                            {
                                                "example_id": "63d70668-2edf-44b3-b810-6ef469b10ac3",
                                                "sense_id": "ecdcdcc5-94d0-373d-ab8e-73b1a3e3b5c2",
                                                "text": "Torture in a public school is as much licensed as the knout in Russia."
                                            },
                                            {
                                                "example_id": "eaa34152-7262-43f3-8ead-b368cdcb5868",
                                                "sense_id": "ecdcdcc5-94d0-373d-ab8e-73b1a3e3b5c2",
                                                "text": "“I don't suppose a Russian convict under the knout is able to amuse the rest of his gang; and all our men-folk here are gilded convicts.”"
                                            },
                                            {
                                                "example_id": "af97152e-2dc2-4b85-b05a-980a956baf42",
                                                "sense_id": "ecdcdcc5-94d0-373d-ab8e-73b1a3e3b5c2",
                                                "text": "Spray and then slogging knouts of water hit the windows or lights like snarling disaffected at a mansion of the rich and frivolous."
                                            },
                                            {
                                                "example_id": "d0f4fe63-5588-41a7-bae8-9f9b40a82b99",
                                                "sense_id": "ecdcdcc5-94d0-373d-ab8e-73b1a3e3b5c2",
                                                "text": "The lieutenant gave him twenty strokes of the knout and stuck him in a cage for a few days till the snow was ankle deep."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "knout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "461a743b-d3c2-3ea3-b7ab-171cb205113e",
                                        "entry_id": "35766105-8dfa-3ee7-a0d2-1e80a249f5c9",
                                        "glosses": [
                                            "To flog or beat with a knout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0b5fef1-702d-4abf-ac62-11d79bffb0df",
                                                "sense_id": "461a743b-d3c2-3ea3-b7ab-171cb205113e",
                                                "text": "Different, isn’t it? It’s called kava, by the way. The Fijians make it by knouting some root or other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
