                        "glosses": [
                            "Celui qui dégraisse les habits, les étoffes."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1ce1e885-143c-4a9b-a81f-9afde61bebc7",
                                "sense_id": "f62052d0-0140-3188-af92-512ea55f15c4",
                                "text": "Porter un habit, une robe au dégraisseur."
                            },
                            {
                                "example_id": "46e6dbe9-cdcf-4219-9c4d-f3e05b1af4cf",
                                "sense_id": "f62052d0-0140-3188-af92-512ea55f15c4",
                                "text": "Par bonheur elle n’avait alors en face d’elle que des gens tranquilles, des bourgeois, un boulanger, un dégraisseur, des ébénistes."
                            },
                            {
                                "example_id": "8fe6f079-d44a-453e-9b0f-d6531fa64c81",
                                "sense_id": "f62052d0-0140-3188-af92-512ea55f15c4",
                                "text": "Elles étalaient de longs gants à huit boutons, achetés quinze sous chez le dégraisseur."
                            }
                        ]
                    }
