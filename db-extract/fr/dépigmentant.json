                    },
                    {
                        "sense_id": "04ef4ebe-771f-3ea3-bfd7-584dfdfa8fcc",
                        "entry_id": "7e85939c-85a4-3727-9714-1cf5a7031596",
                        "glosses": [
                            "Qui entraîne une dépigmentation.",
                            "Qualifie les produits utilisés pour éclaircir artificiellement la peau."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "b54a0cb9-9e1c-4088-b559-c2da9729f1dd",
                                "sense_id": "04ef4ebe-771f-3ea3-bfd7-584dfdfa8fcc",
                                "text": "Cette substance dépigmentante régule la mélanine, le pigment brun qui s’accumule dans les lentigos et les tâches de vieillesse."
                            },
                            {
                                "example_id": "bf711170-ea17-4ef6-ae3b-95547c9bdd0d",
                                "sense_id": "04ef4ebe-771f-3ea3-bfd7-584dfdfa8fcc",
                                "text": "Ces centaines d’activistes anonymes et indignées se mobilisent pour l’interdiction des produits dépigmentants. Sur leurs écriteaux, comme le relate le site d’actualités mauritanien Kassataya, on peut lire des slogans aussi fédérateurs que \"Non à la dépigmentation\"."
                            },
                            {
                                "example_id": "adc0bcf6-77a9-4548-b344-6a34a687af60",
                                "sense_id": "04ef4ebe-771f-3ea3-bfd7-584dfdfa8fcc",
                                "text": "Malgré les dangers liés à l’utilisation de produits dépigmentants, ces cosmétiques continuent de remporter un franc succès au Sénégal."
                            }
                        ]
                    }
