                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6ca351c-f48f-44e3-b90e-a91b06878d8f",
                        "source_entry_id": "445a7177-f316-3f79-adf4-442d9286749f",
                        "source_sense_id": "af8f68d8-f53b-3eeb-b8cf-f02466c9b599",
                        "target_lang_word": "Abrechnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abrechnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c404cf8-8b72-3734-83b7-b43fe985ec63",
                                        "entry_id": "055c0152-12bb-3cb8-add1-17829a3971a5",
                                        "glosses": [
                                            "Berechnung von Kosten, Aufwand, Verbräuchen, Mengen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60ce4f31-ebc5-482f-bdd5-9e7a43877ad9",
                                                "sense_id": "7c404cf8-8b72-3734-83b7-b43fe985ec63",
                                                "text": "Die Abrechnung war sehr genau, so dass man die Kosten nachvollziehen konnte."
                                            },
                                            {
                                                "example_id": "feff2d72-6768-4daf-8a99-cc0dba5ff73a",
                                                "sense_id": "7c404cf8-8b72-3734-83b7-b43fe985ec63",
                                                "text": "„Die Abrechnung [der Handygebühren] ist ganz einfach: Jede Gesprächsminute kostet 30 Kwanza, umgerechnet 30 Cent.“"
                                            },
                                            {
                                                "example_id": "6bb48ddb-88c7-4ec3-a66f-9976d34f510d",
                                                "sense_id": "7c404cf8-8b72-3734-83b7-b43fe985ec63",
                                                "text": "„Die Solaranlagen vermietet seine Firma \"Sunray Ventures\" langfristig. Abgerechnet wird nicht per Zähler, sondern mit einer monatlichen Grundgebühr. Denn komplizierte Abrechnungen und Verträge seien abschreckend, sagt Wessels.“"
                                            },
                                            {
                                                "example_id": "d64497e7-a585-4fa8-92e8-e620ab0be8d3",
                                                "sense_id": "7c404cf8-8b72-3734-83b7-b43fe985ec63",
                                                "text": "„Nun kommt die Abrechnung mit Karnej. Als er sein Geld bekommen hat, verlangt er das Trinkgeld.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb57e58d-b24e-3e18-9fcf-6cf030e28828",
                                        "entry_id": "055c0152-12bb-3cb8-add1-17829a3971a5",
                                        "glosses": [
                                            "Dokument, auf dem eine Berechnung von [1] dargelegt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20b94218-7cf3-4ccc-a307-56ccefa2fbdd",
                                                "sense_id": "bb57e58d-b24e-3e18-9fcf-6cf030e28828",
                                                "text": "Die Abrechnung schicke ich dir zu."
                                            },
                                            {
                                                "example_id": "6b38be9d-7675-47e1-af5c-8f3fbc6591aa",
                                                "sense_id": "bb57e58d-b24e-3e18-9fcf-6cf030e28828",
                                                "text": "„Es hatte sich so eingespielt, dass sie nach der Sonntagsmesse die Abrechnung mitbrachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "13821fc8-3526-37fa-ba12-b7511bf82e12",
                                        "entry_id": "055c0152-12bb-3cb8-add1-17829a3971a5",
                                        "glosses": [
                                            "Vergeltung für empfundenes Unrecht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fb4ed1d-e9e9-4737-b497-4216abab5c94",
                                                "sense_id": "13821fc8-3526-37fa-ba12-b7511bf82e12",
                                                "text": "Für uns war es eine gute Zeit, der Rohrstock blieb in der Ecke, aber oh weh, die Abrechnung folgte drei Tage später."
                                            },
                                            {
                                                "example_id": "a33143c1-441b-47f1-a803-a197dab63720",
                                                "sense_id": "13821fc8-3526-37fa-ba12-b7511bf82e12",
                                                "text": "„Eigentlich will der Mörder Juraj Gál exekutieren, einen ehemaligen Polizisten, es geht um Abrechnungen im Mafia-Milieu. Doch Gál ist nicht im Auto. Die Schüsse aus dem Maschinengewehr treffen seine Freundin Henrieta, 30, und seinen Sohn Richard, 9 - irrtümlich.“"
                                            },
                                            {
                                                "example_id": "c1b58244-da28-4d36-970b-cbc88608fd69",
                                                "sense_id": "13821fc8-3526-37fa-ba12-b7511bf82e12",
                                                "text": "„Es ist eine Anklage, eine Abrechnung mit Kolonialismus und Rassismus.“"
                                            },
                                            {
                                                "example_id": "0d22b8c5-4495-4c93-9e1e-d8dcda4df9a0",
                                                "sense_id": "13821fc8-3526-37fa-ba12-b7511bf82e12",
                                                "text": "„Inwieweit ist damit zu rechnen, dass die Parlamentswahl auch zu einer Abrechnung mit der Regierung von Präsidentin Park wird?“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4e24387-81fd-445f-84be-6fe280304ed4",
                        "source_entry_id": "445a7177-f316-3f79-adf4-442d9286749f",
                        "source_sense_id": "af8f68d8-f53b-3eeb-b8cf-f02466c9b599",
                        "target_lang_word": "Verrechnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verrechnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62b811e4-e931-3eea-82c9-25f83158c25d",
                                        "entry_id": "9ba5f21e-caeb-343e-bec4-46058ca3bc49",
                                        "glosses": [
                                            "Ausgleich gegenläufiger Forderungen; das Verrechnetwerden"
                                        ],
                                        "tags": [
                                            "Buchführung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb7f47f8-6c29-4a9d-aa45-2dbb16625030",
                                                "sense_id": "62b811e4-e931-3eea-82c9-25f83158c25d",
                                                "text": "„Berechnungen anhand der Wahl von 2009 (mit 24 Überhangmandaten für CDU und CSU) ergaben, dass durch einen solchen Ausgleich der Bundestag, je nach Modell, um einige Dutzend oder gar mehr als 200 Abgeordnete vergrößert würde. Allerdings brächte eine strikte Trennung der Landeslisten ein Problem vor allem für die kleineren Parteien: Reststimmen, die für die Vergabe eines Mandats in einem Land nicht mehr reichen, bisher aber dank der bundesweiten Verrechnung zu einem großen Teil mitzählten, würden unter den Tisch fallen. Das will Schwarz-Gelb, auf Drängen der FDP, nun vermeiden.“"
                                            },
                                            {
                                                "example_id": "0af3e969-5ca5-44e4-ad66-b8cdbe97eb80",
                                                "sense_id": "62b811e4-e931-3eea-82c9-25f83158c25d",
                                                "text": "„Diese Vermögenswerte wurden zum grössten Teil zu aktuellen Fair-Values bewertet, was nach Verrechnung der Verlustabsicherung der UBS zu einem Verlust von 890 Mio USD führte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
