                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a26605df-66a6-4b12-ba60-9b4bf8eef314",
                                "sense_id": "f0603763-5043-3000-8a73-1bd0ee734cdf",
                                "text": "Onsympathiek of innig geliefd en bewonderd, je zou hen het liefst met je grote handen tegen je aan drukken en willen toefluisteren dat het gauw, zodra het weer licht wordt of misschien ook dan nog niet, maar dat het in elk geval vroeg of laat allemaal goed zou komen."
                            },
                            {
                                "example_id": "c4abcc60-0558-4ba3-b6b4-8b6d857111d2",
                                "sense_id": "f0603763-5043-3000-8a73-1bd0ee734cdf",
                                "text": "Twee Parisiennes uit hogere kring met modieuze hoofddeksels die elkaar minzaam iets toefluisteren. Een scène uit het Parijs van alledag (en nacht!) zoals alleen Toulouse-Lautrec die kon optekenen."
                            }
                        ]
                    }
