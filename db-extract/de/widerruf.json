                "senses": [
                    {
                        "sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                        "entry_id": "600e2216-ebac-34b2-994d-2aa7f6ab9e1b",
                        "glosses": [
                            "Erklärung/Mitteilung, dass etwas ungültig sein soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef0653b5-8563-467a-b21e-1ee826331469",
                                "sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                                "text": "Da ich dem gesendeten Vertrag nicht zustimmen konnte, schrieb ich einen Widerruf."
                            },
                            {
                                "example_id": "a31f6c8f-61b8-498c-b0d7-59070aa4f75f",
                                "sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                                "text": "„Der Grund zu diesem Widerruf kann nur der folgende sein.“"
                            },
                            {
                                "example_id": "82b933b2-e98e-4c9f-afed-6b07bb10a871",
                                "sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                                "text": "„Die Order sei widerrufen worden, er aber habe noch vor dem Widerruf einen Fluchtversuch unternommen, daher die weitere Haft, die neuen Handschellen.“"
                            },
                            {
                                "example_id": "1a5cc452-3621-4aad-85f0-ab33c29c4fd9",
                                "sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                                "text": "„Nachdem Luther einen Widerruf seiner Lehre abgelehnt hatte, verfiel er der Reichsacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4862a6f9-69fb-4741-a21f-55a0240a740e",
                        "source_entry_id": "600e2216-ebac-34b2-994d-2aa7f6ab9e1b",
                        "source_sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                        "source_sense_description": "Erklärung/Mitteilung, dass etwas ungültig sein soll",
                        "target_lang_word": "revocation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revocation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a39ba834-bf3d-3359-a0e0-3a873b70f4d3",
                                        "entry_id": "895ad3d9-813a-33f0-9720-3fba45899919",
                                        "glosses": [
                                            "An act or instance of revoking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65ea0f69-9f26-4574-beeb-b7192249dcb1",
                                                "sense_id": "a39ba834-bf3d-3359-a0e0-3a873b70f4d3",
                                                "text": "[…] Due to the safety issues identified, ORR has revoked WCRCL's Exemption Certificate.[…] WCR-operated charter trains are unaffected by the revocation, which RAIL understands nominally runs until November, immediately after the 'Jacobite' season is due to end on October 27. The 'Jacobite' is treated separately because it is a timetabled service rather than a charter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec3c7474-7742-4fe1-87b8-112cff891f4e",
                        "source_entry_id": "600e2216-ebac-34b2-994d-2aa7f6ab9e1b",
                        "source_sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                        "source_sense_description": "Erklärung/Mitteilung, dass etwas ungültig sein soll",
                        "target_lang_word": "révocation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "révocation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb86ea2a-8824-3da6-8842-7e835f04c95d",
                                        "entry_id": "66e9b0f6-1982-344a-8343-faf0a98aeada",
                                        "glosses": [
                                            "Action de révoquer ; annulation, en parlant d'une chose ou d'un acte ; renvoi ou destitution, en parlant d'une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f43f51f2-65c4-4454-935b-0a5c91f94492",
                                                "sense_id": "fb86ea2a-8824-3da6-8842-7e835f04c95d",
                                                "text": "Les protestans avaient, au dix-septième siècle, un temple à Sanvic; […]. Lors de la révocation de l’édit de Nantes, la jeunesse catholique du Havre se porta en foule à Sanvic, et détruisit, en peu d’instans, cet édifice religieux dont on chercherait vainement aujourd'hui la place."
                                            },
                                            {
                                                "example_id": "6893ae04-3c14-4fe8-8b23-d47ca02ebeb0",
                                                "sense_id": "fb86ea2a-8824-3da6-8842-7e835f04c95d",
                                                "text": "Avant la révocation de l'Édit de Nantes, une idée domine chez tous les prédicateurs réformés : la défense de leur Église et de ses doctrines. Les réformés étaient menacés de plusieurs manières, et la lutte était pour eux une nécessité; […]."
                                            },
                                            {
                                                "example_id": "626dd451-a874-4bd5-9336-274bc09b6a1b",
                                                "sense_id": "fb86ea2a-8824-3da6-8842-7e835f04c95d",
                                                "text": "Tu ne connais pas l’inspecteur d’Académie. Il transmettra le rapport au recteur, et ça pourrait aller jusqu’à la révocation."
                                            },
                                            {
                                                "example_id": "045ca5e3-7947-494d-ae32-08f593b1f203",
                                                "sense_id": "fb86ea2a-8824-3da6-8842-7e835f04c95d",
                                                "text": "Harland, qui a fort bien connu Vavilov, condamne sans réserves les théories mitchouriniennes, taxe Lyssenko de charlatan et dénonce les odieuses manœuvres qui ont abouti à la révocation des principales figures de la génétique soviétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "612b0003-7575-3b56-b992-c15540e58a1d",
                                        "entry_id": "66e9b0f6-1982-344a-8343-faf0a98aeada",
                                        "glosses": [
                                            "Retour à un état antérieur (par exemple dans l’historique d’un système de gestion de versions, ou dans une base de données)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40c429e9-1272-4333-8f10-bbebe5bad2e7",
                        "source_entry_id": "600e2216-ebac-34b2-994d-2aa7f6ab9e1b",
                        "source_sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                        "source_sense_description": "Erklärung/Mitteilung, dass etwas ungültig sein soll",
                        "target_lang_word": "rétractation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rétractation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8920f8c-12f2-3ffc-a45b-4f261d7a9bd1",
                                        "entry_id": "e6b58868-ffdd-378e-b38b-f39aded235ba",
                                        "glosses": [
                                            "Acte par lequel on se rétracte, en retirant formellement ce que l'on avait avancé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1bffdaa-7db8-4452-8dd8-9d07a021b149",
                                                "sense_id": "b8920f8c-12f2-3ffc-a45b-4f261d7a9bd1",
                                                "text": "Rétractation publique, volontaire, forcée."
                                            },
                                            {
                                                "example_id": "8f850cd1-c1c9-4a9d-a331-8b86e981fed1",
                                                "sense_id": "b8920f8c-12f2-3ffc-a45b-4f261d7a9bd1",
                                                "text": "Il a fait sa rétractation."
                                            },
                                            {
                                                "example_id": "46cc391f-c2e5-42d7-96b1-26bb73daeaa7",
                                                "sense_id": "b8920f8c-12f2-3ffc-a45b-4f261d7a9bd1",
                                                "text": "Je l’ai obligé à une rétractation."
                                            },
                                            {
                                                "example_id": "967c4557-4fa1-43ab-b7cb-aa50ef8b1b3c",
                                                "sense_id": "b8920f8c-12f2-3ffc-a45b-4f261d7a9bd1",
                                                "text": "Il signa une rétractation de ses erreurs."
                                            },
                                            {
                                                "example_id": "9cf5ea59-0551-49d6-8ee0-fc3bca775a2e",
                                                "sense_id": "b8920f8c-12f2-3ffc-a45b-4f261d7a9bd1",
                                                "text": "Coup sur coup, deux des plus grandes revues médicales mondiales ont procédé à la rétractation d’articles ayant trait au Covid-19, fondés sur des données fournies par une société américaine, Surgisphere, et à l’origine, désormais, plus que douteuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4e22b6c-3d36-3f18-9833-1696e2bf5656",
                                        "entry_id": "e6b58868-ffdd-378e-b38b-f39aded235ba",
                                        "glosses": [
                                            "Annulation d’un contrat dans des conditions prévues par la loi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ac49ea2-acd1-4c0f-b07b-4cdef091dae7",
                                                "sense_id": "e4e22b6c-3d36-3f18-9833-1696e2bf5656",
                                                "text": "Vous disposez d’un droit de rétractation pendant 14 jours."
                                            },
                                            {
                                                "example_id": "91a0c4c2-a4d0-4dd8-b08c-058a5933d1f5",
                                                "sense_id": "e4e22b6c-3d36-3f18-9833-1696e2bf5656",
                                                "text": "Impossible d’annuler la vente : le délai de rétractation est dépassé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
