            "senses": [
                {
                    "sense_id": "e64f5520-f440-33fd-9d24-3510affe9e78",
                    "sense_definition": "Enlever les mauvaises herbes d'un terrain, d'une allée ou d'une plantation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "elimination_vegetale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>désherber</w> le potager avant de semer les carottes et les salades."
                        },
                        {
                            "text": "Le samedi matin, elle passe une heure à <w>désherber</w> les allées du jardin public."
                        }
                    ],
                    "synonyms": [
                        "sarcler"
                    ],
                    "antonyms": [
                        "enherber"
                    ],
                    "common_phrases": [
                        "désherber le jardin",
                        "désherber une allée"
                    ]
                },
                {
                    "sense_id": "cea044d0-5829-3c83-bb9d-267d28217626",
                    "sense_definition": "Détruire la végétation indésirable sur une parcelle agricole à l'aide d'un produit désherbant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "elimination_vegetale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'agriculteur a décidé de <w>désherber</w> son champ de maïs au début du printemps."
                        },
                        {
                            "text": "Il est parfois nécessaire de <w>désherber</w> une vigne pour éviter la concurrence entre les plantes."
                        }
                    ],
                    "common_phrases": [
                        "désherber une parcelle",
                        "désherber un champ"
                    ]
                },
                {
                    "sense_id": "d367789d-ede0-37a2-80de-1689f4206511",
                    "sense_definition": "Retirer des livres ou des documents obsolètes d'une bibliothèque pour libérer de la place.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les bibliothécaires prévoient de <w>désherber</w> les rayons scientifiques afin d'accueillir les nouveaux manuels."
                        },
                        {
                            "text": "Chaque été, l'équipe passe quelques jours à <w>désherber</w> les collections pour renouveler les ouvrages disponibles."
                        }
                    ],
                    "common_phrases": [
                        "désherber une bibliothèque",
                        "désherber les rayons"
                    ]
                }
            ]
