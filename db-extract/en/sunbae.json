                "senses": [
                    {
                        "sense_id": "db14a1dc-3147-31ea-896b-1aa0c47e3014",
                        "entry_id": "8252ee60-c878-3d89-be60-b56c5cd4c168",
                        "glosses": [
                            "An upperclassman or senior, in the context of Korea."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1b40ce0-5b85-4d1a-afe7-28318afe413a",
                                "sense_id": "db14a1dc-3147-31ea-896b-1aa0c47e3014",
                                "text": "When students start their freshmen year in college, they are taken care of by their sunbaes, who give them various advice about school."
                            },
                            {
                                "example_id": "8d7d849f-5abc-4565-adec-c08e7b4dbe91",
                                "sense_id": "db14a1dc-3147-31ea-896b-1aa0c47e3014",
                                "text": "On September 14-15 of this year, led by their sunbaes (upperclassmen), excited students wearing blue for Yonsei and red for Korea University converged upon Jamsil Sports Complex to support their athletic teams in the tradition-laden sports competition."
                            },
                            {
                                "example_id": "38f9b6c1-2553-4b32-9216-62a5729efd27",
                                "sense_id": "db14a1dc-3147-31ea-896b-1aa0c47e3014",
                                "text": "Minwoo was an active participant in Korean sporting clubs, hung out with Korean sunbaes [seniors] in his department and lived with Korean roommates in his dormitory."
                            },
                            {
                                "example_id": "29fff659-e095-45ee-802b-985f722aa2f8",
                                "sense_id": "db14a1dc-3147-31ea-896b-1aa0c47e3014",
                                "text": "How many people had told her these things? She’d lost count. Family. Friends. Colleagues. Seonbaes."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f04ba3e-6ede-34a3-97e6-d063d1c18fb7",
                        "entry_id": "8252ee60-c878-3d89-be60-b56c5cd4c168",
                        "glosses": [
                            "An older or more experienced idol, viewed as a veteran, mentor, or predecessor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b411f614-f0c0-405d-b30f-7dc360e07ed4",
                                "sense_id": "3f04ba3e-6ede-34a3-97e6-d063d1c18fb7",
                                "text": "While it did seem like TWICE was set on the fast track to stardom – after all, the JYP darlings were expected to follow in the footsteps of their 'Tell Me' sunbaes – their road to success was far from smooth-sailing."
                            },
                            {
                                "example_id": "22e6f71f-d65e-4e7d-93d5-745c02e2dc10",
                                "sense_id": "3f04ba3e-6ede-34a3-97e6-d063d1c18fb7",
                                "text": "Winner and iKon learned and grew by following their sunbaes' (seniors) footsteps."
                            },
                            {
                                "example_id": "f1a21928-47c4-4159-8dcd-b96e4c510545",
                                "sense_id": "3f04ba3e-6ede-34a3-97e6-d063d1c18fb7",
                                "text": "The members were decked out in classic 90s fashion which was very reminiscent of their sunbaes H.O.T."
                            }
                        ]
                    }
