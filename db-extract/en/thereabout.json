                                "target_senses": [
                                    {
                                        "sense_id": "2250b87d-0fc6-3fd6-bab7-ad5b696eeb02",
                                        "entry_id": "cecf1125-f6ff-3ab5-810f-63812816d554",
                                        "glosses": [
                                            "eromheen, in het rond, ongeveer, rondom"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55bcc3a1-594e-4b14-a8b7-0ec0e04b29a4",
                                                "sense_id": "2250b87d-0fc6-3fd6-bab7-ad5b696eeb02",
                                                "text": "Toen ze bij het kasteel kwamen liepen ze daaromheen om de poort te zoeken."
                                            },
                                            {
                                                "example_id": "fb627d50-bd14-4612-a233-9b8331c41ea7",
                                                "sense_id": "2250b87d-0fc6-3fd6-bab7-ad5b696eeb02",
                                                "text": "Wij bezochten Almelo en alle dorpen daaromheen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce13f6bc-9837-48cc-a864-b361a09eb61b",
                        "source_entry_id": "f768f02e-bfdf-35b6-a341-2491e438f1ca",
