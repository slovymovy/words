                                            {
                                                "example_id": "baa55a2a-54d6-44fe-95b9-d0fd3a543f86",
                                                "sense_id": "34d6bd4d-ee8c-3bd8-9e0d-64c684acd9f6",
                                                "text": "It's impossible to tell the story of flamenco without talking about Lorca, who found in it a source of inspiration in a lifelong political-cultural-sexual struggle against bourgeois philistinism."
                                            },
                                            {
                                                "example_id": "c89b9e15-385c-45c8-8917-83ccfc2bb4e7",
                                                "sense_id": "34d6bd4d-ee8c-3bd8-9e0d-64c684acd9f6",
                                                "text": "The increasing social interactions between the two nations through religion, court and commerce would expose differences in speech too and would soon deepen bourgeois Scots’ deteriorating perception of their own tongue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64856f2e-ff4e-3999-b750-1e5012930cf7",
                                        "entry_id": "cc3f01a8-1372-3dee-9505-4d4df143de7d",
