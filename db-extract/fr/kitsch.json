                                    },
                                    {
                                        "sense_id": "21034d29-fa3e-37de-a914-ee6dde6774d5",
                                        "entry_id": "0009f7c2-b7d2-3e32-b769-af5271c38cc2",
                                        "glosses": [
                                            "Gaudy or flashy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a05322d-14f5-4ca0-98fe-38ec6454c48e",
                                                "sense_id": "21034d29-fa3e-37de-a914-ee6dde6774d5",
                                                "text": "Steve Randle was seventeen, tall and lean, with thick greasy hair he kept combed in complicated swirls. He was tacky, smart, and Soda's best buddy since grade school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ac1a288-3cc9-3dcd-8b20-1eb579cd40ab",
