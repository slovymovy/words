{
    "word_family": [
        "kraai",
        "gekraai"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2485288-be18-33e3-bd91-ceab8a3940a4",
                    "sense_definition": "het maken van het kenmerkende geluid van een haan of bepaalde andere vogels",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vogelgeluiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De haan <w>kraaide</w> luid in de vroege ochtend om iedereen wakker te maken.",
                            "target_lang_translations": {
                                "en": "The rooster <w>crowed</w> loudly in the early morning to wake everyone up.",
                                "ru": "Петух громко <w>кукарекал</w> ранним утром, чтобы всех разбудить."
                            }
                        },
                        {
                            "text": "Zodra de zon opkomt, begint de haan op de boerderij te <w>kraaien</w>.",
                            "target_lang_translations": {
                                "en": "As soon as the sun rises, the rooster on the farm begins to <w>crow</w>.",
                                "ru": "Как только встает солнце, петух на ферме начинает <w>кукарекать</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de haan kraait"
                    ],
                    "target_lang_definitions": {
                        "en": "making the characteristic sound of a rooster or certain other birds",
                        "ru": "издавать характерный звук петуха или некоторых других птиц"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crow",
                                "target_lang_sense_clarification": "of a rooster"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "кукарекать",
                                "target_lang_sense_clarification": "о петухе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9367b67-04fa-32e3-9541-80022302e37a",
                    "sense_definition": "op een enthousiaste of triomfantelijke manier praten of roepen, vaak uit vreugde",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "menselijke_geluiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De baby lag vrolijk te <w>kraaien</w> van plezier in de box.",
                            "target_lang_translations": {
                                "en": "The baby lay there happily <w>crowing</w> with delight in the playpen.",
                                "ru": "Малыш весело <w>агукал</w> от удовольствия в манеже."
                            }
                        },
                        {
                            "text": "Hij <w>kraaide</w> van de pret toen hij hoorde dat hij de eerste prijs had gewonnen.",
                            "target_lang_translations": {
                                "en": "He <w>crowed</w> with joy when he heard that he had won the first prize.",
                                "ru": "Он <w>заливался</w> от восторга, когда услышал, что выиграл первый приз."
                            }
                        }
                    ],
                    "synonyms": [
                        "jubelen"
                    ],
                    "common_phrases": [
                        "kraaien van plezier",
                        "kraaien van de pret"
                    ],
                    "target_lang_definitions": {
                        "en": "talking or shouting in an enthusiastic or triumphant way, often out of joy",
                        "ru": "восторженно или торжествующе говорить или кричать, часто от радости"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crow",
                                "target_lang_sense_clarification": "to boast or make joyful sounds"
                            },
                            {
                                "target_lang_word": "gurgle",
                                "target_lang_sense_clarification": "of a baby making happy sounds"
                            },
                            {
                                "target_lang_word": "exult",
                                "target_lang_sense_clarification": "to show great joy or triumph"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "агукать",
                                "target_lang_sense_clarification": "о младенце"
                            },
                            {
                                "target_lang_word": "заливаться",
                                "target_lang_sense_clarification": "от смеха или радости"
                            },
                            {
                                "target_lang_word": "ликовать",
                                "target_lang_sense_clarification": "торжествовать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94dfde76-7da4-3e9c-aa55-ef46902dacc0",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>kraai</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vogels",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zitten drie zwarte <w>kraaien</w> op het hek in de achtertuin.",
                            "target_lang_translations": {
                                "en": "There are three black <w>crows</w> sitting on the fence in the backyard.",
                                "ru": "На заборе в саду за домом сидят три черные <w>вороны</w>."
                            }
                        },
                        {
                            "text": "In het park vliegen veel <w>kraaien</w> rond die op zoek zijn naar eten.",
                            "target_lang_translations": {
                                "en": "In the park, many <w>crows</w> are flying around looking for food.",
                                "ru": "В парке летает много <w>ворон</w> в поисках еды."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of the noun 'crow' (the bird)",
                        "ru": "множественное число существительного «ворона»"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crows",
                                "target_lang_sense_clarification": "plural of the bird"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вороны",
                                "target_lang_sense_clarification": "птицы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}