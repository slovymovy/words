                ],
                "translations": [
                    {
                        "translation_id": "147204fd-d324-4b12-b69b-a0a21ac15363",
                        "source_entry_id": "ca7fc570-89e1-3829-96e9-158da34dbd4c",
                        "source_sense_id": "a2375e35-a17c-30f8-a50c-fd231fcbcd58",
                        "target_lang_word": "revisionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revisionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c197e29d-dfcc-305d-b996-02aa2dcdb1d1",
                                        "entry_id": "f394df62-f366-3b78-8459-3f332a2a54b0",
                                        "glosses": [
                                            "Of or pertaining to revisionism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97a72069-7283-461b-af97-2320f9044143",
                                                "sense_id": "c197e29d-dfcc-305d-b996-02aa2dcdb1d1",
                                                "text": "Wang interjected: \"We are preparing large exhibitions of art done by workers, peasants and soldiers in cooperation with the art teachers and students. Among them is one popular work entitled 'Never Stop Struggling as Long as You Are Alive.' It is a painting depicting the story of our heroic soldiers fighting the Soviet revisionist troops when they invaded Chen Pao Island on our frontier. Yes,\" Wang said enthusiastically, \"a new upsurge in art is taking form.\""
                                            },
                                            {
                                                "example_id": "d1b736e6-aeed-4789-8f0d-35e6d3852876",
                                                "sense_id": "c197e29d-dfcc-305d-b996-02aa2dcdb1d1",
                                                "text": "[I]n the 575 days since [Oscar] Pistorius shot dead his girlfriend Reeva Steenkamp, there has been an unseemly scramble to construct revisionist histories, to identify evidence beneath that placid exterior of a pugnacious, hair-trigger personality."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "revisionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bca5eba4-82be-33b4-a143-06bfb6284fe5",
                                        "entry_id": "d86096e7-2404-3275-bc02-ee6b26d01fbf",
                                        "glosses": [
                                            "A proponent of revisionism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8daa349-b162-42c0-a32c-4b972251d57c",
                                                "sense_id": "bca5eba4-82be-33b4-a143-06bfb6284fe5",
                                                "text": "Later on, when he had loosened up considerably, he told an amusing story that he said took place during a Sino-Soviet border flare-up in 1969. \"We had a hot line between the Soviet Union and ourselves then,\" he said, \"but it had already become cold because the Kremlin never used it. At the time of the Chen Pao border incident, however, Kosygin picked it up and called us. When our operator answered, he said, 'This is Premier Kosygin. I would like to speak to Chairman Mao.' The operator, completely on his own, said, 'You are a revisionist, and therefore I will not connect you.' So Kosygin said, 'Well, if you will not try to reach the Chairman, will you please connect me with Prime Minister Chou.' But the operator gave the same unauthorized reply and broke the connection.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "680f3a1b-0859-4463-9db7-17b4fd4848be",
