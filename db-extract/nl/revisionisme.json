                    },
                    {
                        "translation_id": "aab0616a-4ab7-4373-882f-01c8c1a2a508",
                        "source_entry_id": "e122a8cb-561a-3dcb-aeb0-207490e325a4",
                        "source_sense_id": "4472d831-5005-3bcd-bff8-bdcd1ad5aff3",
                        "source_sense_description": "politieke stroming die herziening van bepaalde verdragen over het afstaan van gebieden wil",
                        "target_lang_word": "revanchism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revanchism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44367f60-f5cd-3d03-9967-3880f745200c",
                                        "entry_id": "c20697e3-3fc5-36d4-baeb-87e7450f8076",
                                        "glosses": [
                                            "The political policy of endeavouring to regain lost territory."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aa5399b-b6e8-459b-9e00-c3e05b36ced1",
                                                "sense_id": "44367f60-f5cd-3d03-9967-3880f745200c",
                                                "text": "Fleury had correctly grasped the wisdom of forestalling possible Austrian revanchisme over Lorraine, while France's biggest international problems emanated from England […]"
                                            },
                                            {
                                                "example_id": "a32a1d32-d9d5-46be-addd-cbf593ce3a9d",
                                                "sense_id": "44367f60-f5cd-3d03-9967-3880f745200c",
                                                "text": "The EU lobby may have cobbled together institutions for a united states of Europe, but it was a fool's errand, and one that could only play into the hands of German revanchism."
                                            },
                                            {
                                                "example_id": "8e9c969c-d2e8-4b94-9aac-cbf8fd4808ca",
                                                "sense_id": "44367f60-f5cd-3d03-9967-3880f745200c",
                                                "text": "But couple the tightening of Chinese authoritarianism with Russia's turn toward revanchism and dictatorship, and then add the rise of radical Islam, with its violent intolerance, and the grand victory of Western liberalism can seem hollow, its values under threat even within its own societies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30587a89-2a21-32d5-9fdc-d7a9a51a8658",
                                        "entry_id": "c20697e3-3fc5-36d4-baeb-87e7450f8076",
                                        "glosses": [
                                            "Metaphorical endeavouring to regain lost political or cultural territory."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f3ec8f9-c4e3-43ad-902a-f94c47100ed6",
                                                "sense_id": "30587a89-2a21-32d5-9fdc-d7a9a51a8658",
                                                "text": "But Trump, proud son of Queens, believes firmly that stirring up division is essential to his success, and he’s always looking for ways to promote right-wing revanchism and resentment. He’s particularly drawn to symbolic fights where he can take an angry stand against cultural change."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba11e3b6-a162-4fe9-9501-21d262929d0f",
                        "source_entry_id": "e122a8cb-561a-3dcb-aeb0-207490e325a4",
                        "source_sense_id": "4472d831-5005-3bcd-bff8-bdcd1ad5aff3",
                        "source_sense_description": "politieke stroming die herziening van bepaalde verdragen over het afstaan van gebieden wil",
                        "target_lang_word": "revanchisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revanchisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e4268ac-d5ce-3cd2-885c-a23a5dd04c34",
                                        "entry_id": "b39c8be2-60b6-314c-b435-3296df41c3db",
                                        "glosses": [
                                            "Esprit de revanche."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70ec09a9-5b3e-3179-9324-a533088615f5",
                                        "entry_id": "b39c8be2-60b6-314c-b435-3296df41c3db",
                                        "glosses": [
                                            "Esprit de revanche correspondant à un sentiment nationaliste entretenu dans l’opinion publique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5522dc1c-4e7d-4b7f-a0d5-e1405c2472ed",
                                                "sense_id": "70ec09a9-5b3e-3179-9324-a533088615f5",
                                                "text": "N’oubliez pas que j’essaye de déclencher une guerre. Quelle meilleure façon d’y parvenir que d’attiser les flammes du revanchisme ? — (Jesse Kellerman, Best-seller, traduit de l’anglais américain par Julie Sibony, Éditions du Masque, 2017, page 282)"
                                            },
                                            {
                                                "example_id": "4a1f5875-1312-47bf-bb62-9687dfd38a1f",
                                                "sense_id": "70ec09a9-5b3e-3179-9324-a533088615f5",
                                                "text": "Les sanctions n’arrêteront sans doute pas la guerre, elles n’entameront pas le pouvoir de Vladimir Poutine. Mais elles finiront par diminuer les moyens dont dispose le Kremlin pour entretenir le revanchisme belliqueux de son chef."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
