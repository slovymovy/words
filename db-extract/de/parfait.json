                "senses": [
                    {
                        "sense_id": "e59ccb8c-bca5-346c-a9d9-204e8b8c0a24",
                        "entry_id": "61b81e88-1e21-36ee-b489-ba3bc9808b40",
                        "glosses": [
                            "eine Art Speiseeis aus Eigelb, eventuell auch Eischnee, Sahne, Zucker und Aromen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3232d2f-64b0-42e6-9566-e00b47093ed1",
                                "sense_id": "e59ccb8c-bca5-346c-a9d9-204e8b8c0a24",
                                "text": "„Der kulinarische Ausflug in eines der besten Kudamm-Restaurants, wo das Team um Maitre Dirk Hoffmann charmant-freundlich mit perfektem Service glänzt, endet mit einem Parfait von der Blutorange mit Orangenhippenkrokant – eine fruchtig-kühle Köstlichkeit.“"
                            },
                            {
                                "example_id": "966585c7-9a00-479e-b42a-cfa9e9753d77",
                                "sense_id": "e59ccb8c-bca5-346c-a9d9-204e8b8c0a24",
                                "text": "„Eis war gestern, wer heute ‚sur table‘ überzeugen will muss schon ein luftiges Parfait liefern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5f1420c2-9062-3819-a6f0-47e8aaa0072e",
                        "entry_id": "61b81e88-1e21-36ee-b489-ba3bc9808b40",
                        "glosses": [
                            "kaltes, würziges Gericht aus gebundenem feingehackten oder feinpürierten Fleisch oder Seafood, das als zubereitete Masse in eine Form gefüllt, abgekühlt und aus der Form gestürzt serviert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37f20bc1-fb45-4e87-a425-abfbcaad1a69",
                                "sense_id": "5f1420c2-9062-3819-a6f0-47e8aaa0072e",
                                "text": "„Wer noch nicht weiß, wie eine Artischockensuppe Georgette oder ein Parfait von Hummerkrabben zubereitet wird, kann dieses Versäumnis sehr bald nachholen.“"
                            },
                            {
                                "example_id": "da142518-0bdb-4307-930f-b150a559beae",
                                "sense_id": "5f1420c2-9062-3819-a6f0-47e8aaa0072e",
                                "text": "„Wer kann schon bei Parfait von Gänsestopfleber mit Eisweingelee und Steinbuttessenz mit Safran widerstehen?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71a2443b-85f1-49fb-999d-ebde5de9a5bc",
