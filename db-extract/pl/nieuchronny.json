                "senses": [
                    {
                        "sense_id": "3fb2a827-db2f-37f4-b339-da5b5cf68bdc",
                        "entry_id": "de3af147-1176-3188-bf70-e618c35dee8d",
                        "glosses": [
                            "taki, przed którym nie da się uciec, uchronić; któremu nie da się zapobiec, powstrzymać"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c444637-6020-4101-8b79-d72cd2f41bfc",
                                "sense_id": "3fb2a827-db2f-37f4-b339-da5b5cf68bdc",
                                "text": "To przecież Armia Czerwona - mówiłem sobie - ratuje świat przed hitlerowskim barbarzyństwem, a mnie osobiście przed nieuchronną zagładą"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42ffee7d-1ed6-4243-b3b3-bb4205535188",
                        "source_entry_id": "de3af147-1176-3188-bf70-e618c35dee8d",
                        "source_sense_id": "3fb2a827-db2f-37f4-b339-da5b5cf68bdc",
                        "target_lang_word": "unavoidable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unavoidable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "491ad3e2-bd72-32a6-89e1-adec6bc1e993",
                                        "entry_id": "7dac441e-bae2-399a-b56a-2213c1fa90f9",
                                        "glosses": [
                                            "Impossible to avoid; bound to happen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a39545df-4357-4f14-bbd3-f0fffaaefc06",
                                                "sense_id": "491ad3e2-bd72-32a6-89e1-adec6bc1e993",
                                                "text": "an unavoidable urge"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84c78c10-f26b-3ce6-b36c-ff3a4d1d1f0d",
                                        "entry_id": "7dac441e-bae2-399a-b56a-2213c1fa90f9",
                                        "glosses": [
                                            "Not voidable; incapable of being made null or void."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "194d0cb5-cbd1-4beb-b463-d9a48030bd9d",
                                                "sense_id": "84c78c10-f26b-3ce6-b36c-ff3a4d1d1f0d",
                                                "text": "A confirmation is allied to a release, being a conveyance of an estate or right in esse whereby a voidable estate is made unavoidable"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unavoidable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c4f9d7a-f6dc-3677-88a0-37873e80b420",
                                        "entry_id": "b65fa26d-05e5-3e44-bd83-6d0287cd1d6a",
                                        "glosses": [
                                            "Something that cannot be avoided."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87939fee-d758-4fa1-97c0-e233602258df",
                                                "sense_id": "2c4f9d7a-f6dc-3677-88a0-37873e80b420",
                                                "text": "Forty years before, I had thought this odour one of the necessities of life — one of the unavoidables at least[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82e4f700-72e5-4876-b062-2546581a6c66",
                        "source_entry_id": "de3af147-1176-3188-bf70-e618c35dee8d",
                        "source_sense_id": "3fb2a827-db2f-37f4-b339-da5b5cf68bdc",
                        "target_lang_word": "неизбежный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неизбежный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7f050c54-5f11-3ebb-a748-9502d9d4cad1",
                                        "entry_id": "fb9f0739-bc70-3ef2-90ce-e7154db5b8a2",
                                        "glosses": [
                                            "такой, которого нельзя избегнуть, предотвратить; неминуемый, неотвратимый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fa3ced4-5a2e-48ae-9abf-8408609ac45f",
                                                "sense_id": "7f050c54-5f11-3ebb-a748-9502d9d4cad1",
                                                "text": "Пускай бежит… ему ли убежать от неизбежного наказания небес?"
                                            },
                                            {
                                                "example_id": "36db3083-cc60-46cb-8a74-9098002abf20",
                                                "sense_id": "7f050c54-5f11-3ebb-a748-9502d9d4cad1",
                                                "text": "Нет, меня любил один, — заговорила она опять, ломая руки, — но смерть всюду, всюду неизбежная смерть! Теперь моя очередь…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d703cc3d-9240-3beb-a04b-1dd5c956cb0a",
                                        "entry_id": "fb9f0739-bc70-3ef2-90ce-e7154db5b8a2",
                                        "glosses": [
                                            "разг. постоянный, обычный; являющийся характерной приметой чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaaeb764-15eb-4429-9bf3-767c28dc7116",
                                                "sense_id": "d703cc3d-9240-3beb-a04b-1dd5c956cb0a",
                                                "text": "На нём была ситцевая юбка, на плечах род рубашки, а поверх всего кусок красной бумажной ткани; на голове неизбежный платок, как у наших баб; ноги голые."
                                            },
                                            {
                                                "example_id": "d4fb9e4d-fd13-4952-ad88-dcc0cf5cdad2",
                                                "sense_id": "d703cc3d-9240-3beb-a04b-1dd5c956cb0a",
                                                "text": "В кабаке было тесно: присяжные, один по одному, выпивали, а закусывать выходили на волю; проскинские мужики заводили с ними разговоры неизбежным вопросом: «Чьи будете?»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
