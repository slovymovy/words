        "fr-extract.jsonl": [
            {
                "entry_id": "abd424c1-a023-367e-884d-cd7e3fb0b2d0",
                "word": "Bade",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6efabe68-bc68-3cd1-a797-5f49affe4fff",
                        "entry_id": "abd424c1-a023-367e-884d-cd7e3fb0b2d0",
                        "glosses": [
                            "Région du sud-ouest de l'Allemagne faisant partie du Land de Bade-Wurtemberg qui forme un couloir occupant une partie de la plaine du Rhin et de la Forêt-Noire."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "f918b544-58f7-4a9e-a0dd-1ace3a6ee20b",
                                "sense_id": "6efabe68-bc68-3cd1-a797-5f49affe4fff",
                                "text": "Le margraviat de Bade est divisé en deux parties, le haut & le bas margraviat ; il est borné au septentrion par le Palatinat & l’évêché de Spire ; à l’orient, par le duché de Wirtemberg & la principauté de Furstemberg ; au midi, par le Brisgaw ; à l’occident, par le Rhin."
                            },
                            {
                                "example_id": "31f1d9b5-3171-4d69-a0f9-4130a6cc023d",
                                "sense_id": "6efabe68-bc68-3cd1-a797-5f49affe4fff",
                                "text": "Plus que le pays de Bade, l’Alsace montre des friches ou de semi-abandons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbba9911-fd0f-4a25-aec7-90f13e91cb79",
                        "source_entry_id": "abd424c1-a023-367e-884d-cd7e3fb0b2d0",
                        "source_sense_id": "6efabe68-bc68-3cd1-a797-5f49affe4fff",
                        "target_lang_word": "Baden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "384a7f70-7821-3b86-a5e2-becec308a2a0",
                                        "entry_id": "89afaefc-db22-3260-b580-8bd988dcdbc7",
                                        "glosses": [
                                            "der Vorgang oder das Konzept einen Gegenstand oder eine Person in eine Flüssigkeit, Strahlung oder ein feinkörniges Material einzutauchen, ein Bad zu nehmen, zu baden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38122e2f-9a71-4ad0-969f-d328d22214f9",
                                                "sense_id": "384a7f70-7821-3b86-a5e2-becec308a2a0",
                                                "text": "An dieser Stelle ist das Baden verboten."
                                            },
                                            {
                                                "example_id": "7317d2d1-23e7-4f80-926b-e9d5e278d7a7",
                                                "sense_id": "384a7f70-7821-3b86-a5e2-becec308a2a0",
                                                "text": "„In den christlichen Ländern gewann dagegen die Lehrrichtung der Askese zunehmend an Bedeutung, die das Baden als Verweichlichung und Luxus ablehnte.“"
                                            },
                                            {
                                                "example_id": "d58c49b9-e1b1-48c3-a6e7-8ea7c2878ae3",
                                                "sense_id": "384a7f70-7821-3b86-a5e2-becec308a2a0",
                                                "text": "„Jede dialektische Theorie des Badens, Schwimmens, Planschens sowie Tauchens und Taufens beginnt kalt und klar mit Heraklits Grundsatz: »Man kann nicht zweimal in denselben Fluss steigen.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
