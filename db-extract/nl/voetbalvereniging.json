                "senses": [
                    {
                        "sense_id": "7437c5d9-b405-3b2f-a017-71949cf59d5b",
                        "entry_id": "e985bd6f-b2d6-3946-b091-57d9edca0175",
                        "glosses": [
                            "een sportclub waar men voetbal kan spelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00eebb9b-6ca5-43a5-8108-22bdfa6282ec",
                                "sense_id": "7437c5d9-b405-3b2f-a017-71949cf59d5b",
                                "text": "Het is feest in Baarlo vanavond. Het vrouwenvoetbal moet meer aandacht krijgen en daarom is Anouk Janssen samen met andere spelers uit haar elftal van voetbalvereniging Baarlo een initiatief gestart om de Nederlandse vrouwen en het vrouwenvoetbal in het algemeen te promoten."
                            },
                            {
                                "example_id": "6cc94673-361d-46a0-b9f2-d6b1b729c8c0",
                                "sense_id": "7437c5d9-b405-3b2f-a017-71949cf59d5b",
                                "text": "Toch waren er ook organisaties die de dag naar binnen verplaatsten. Zo werd er in gymzalen Twister gespeeld, in de kleedkamer van een voetbalvereniging geknikkerd en in de woonkamer gekleurd."
                            }
                        ]
                    }
