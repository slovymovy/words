                                "example_id": "d2d6f89b-2b2a-4cad-ba12-5e18d9514add",
                                "sense_id": "73c4b19b-06ea-3007-8825-9e619b5c38b2",
                                "text": "À la fin de la tournée elle va s'auto-décomposer."
