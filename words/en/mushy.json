{
    "word_family": [
        "mush"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3b3678f2-25b2-3b4e-a044-6e40a4c8a85c",
                    "sense_definition": "Having a soft, wet, or pasty consistency like mush.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "softness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not like eating <w>mushy</w> oatmeal for breakfast.",
                            "target_lang_translations": {
                                "it": "Non mi piace mangiare l'avena <w>molliccia</w> a colazione."
                            }
                        },
                        {
                            "text": "The vegetables became <w>mushy</w> after being boiled for too long.",
                            "target_lang_translations": {
                                "it": "Le verdure sono diventate <w>pappose</w> dopo essere state bollite troppo a lungo."
                            }
                        }
                    ],
                    "synonyms": [
                        "pasty",
                        "soft"
                    ],
                    "antonyms": [
                        "firm",
                        "hard"
                    ],
                    "common_phrases": [
                        "mushy food"
                    ],
                    "target_lang_definitions": {
                        "it": "Che ha una consistenza morbida, umida o pastosa, simile a una poltiglia."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "molliccio",
                                "target_lang_sense_clarification": "riferito a cibi o materiali che hanno perso consistenza"
                            },
                            {
                                "target_lang_word": "papposo",
                                "target_lang_sense_clarification": "riferito a cibi troppo cotti o dalla consistenza simile a una pappa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac469670-0208-3bdd-8b26-7710696f1597",
                    "sense_definition": "Lacking firmness or a crisp, defined feel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "softness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car brakes felt <w>mushy</w> when I pressed the pedal.",
                            "target_lang_translations": {
                                "it": "I freni dell'auto sembravano <w>spugnosi</w> quando ho premuto il pedale."
                            }
                        },
                        {
                            "text": "This computer mouse has a <w>mushy</w> button that is hard to click.",
                            "target_lang_translations": {
                                "it": "Questo mouse ha un tasto <w>poco reattivo</w> che è difficile da cliccare."
                            }
                        }
                    ],
                    "synonyms": [
                        "squishy",
                        "spongy"
                    ],
                    "antonyms": [
                        "responsive",
                        "crisp"
                    ],
                    "target_lang_definitions": {
                        "it": "Privo di fermezza o di una sensazione definita e reattiva al tatto."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "spugnoso",
                                "target_lang_sense_clarification": "che cede sotto pressione, non rigido"
                            },
                            {
                                "target_lang_word": "poco reattivo",
                                "target_lang_sense_clarification": "riferito a meccanismi che non offrono una risposta netta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb7b02ee-c6b7-3c66-bfd4-516d465c1088",
                    "sense_definition": "Excessively sentimental, romantic, or emotional in a way that is embarrassing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sentimentality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They exchanged <w>mushy</w> cards on their anniversary.",
                            "target_lang_translations": {
                                "it": "Si sono scambiati biglietti <w>sdolcinati</w> per il loro anniversario."
                            }
                        },
                        {
                            "text": "I prefer movies without all those <w>mushy</w> romantic scenes.",
                            "target_lang_translations": {
                                "it": "Preferisco i film senza tutte quelle scene romantiche <w>smielate</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sappy",
                        "sentimental",
                        "corny"
                    ],
                    "common_phrases": [
                        "mushy cards",
                        "mushy feelings"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in informal contexts to describe overly sentimental behavior."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Eccessivamente sentimentale, romantico o emotivo in modo imbarazzante."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sdolcinato",
                                "target_lang_sense_clarification": "eccessivamente sentimentale o romantico"
                            },
                            {
                                "target_lang_word": "smielato",
                                "target_lang_sense_clarification": "che trasuda un sentimentalismo stucchevole"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}