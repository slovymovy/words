        "nl-extract.jsonl": [
            {
                "entry_id": "25a6b47f-c19e-37c1-84bd-c4819f3ed094",
                "word": "skypen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "47d5b558-5214-3a08-b884-1ecc18565f35",
                        "entry_id": "25a6b47f-c19e-37c1-84bd-c4819f3ed094",
                        "glosses": [
                            "met elkaar praten via een videoverbinding over het internet met het computerprogramma Skype"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "778317f0-10bd-4b2a-ab7a-7d63539a9bfd",
                                "sense_id": "47d5b558-5214-3a08-b884-1ecc18565f35",
                                "text": ",,We skypen elke avond. Slaan bijna nooit over. Al missen we dan wel heel erg dat we elkaar geen knuffel kunnen geven.’’"
                            },
                            {
                                "example_id": "d9db8c71-db5c-4901-b917-88c12f4e1a11",
                                "sense_id": "47d5b558-5214-3a08-b884-1ecc18565f35",
                                "text": "Dan zorgen we dat we elkaar veel zien en daarnaast skypen we veel. En nu zijn we bijvoorbeeld weer twee maanden bij elkaar in Amsterdam. Dat is heel fijn.”"
                            },
                            {
                                "example_id": "ff0021e2-dde3-4392-bb8f-7ee800d0c083",
                                "sense_id": "47d5b558-5214-3a08-b884-1ecc18565f35",
                                "text": "Kinderen van vluchtelingengezinnen uit Hengelo komen in de zomervakantie trouw naar de bibliotheek. Ze skypen met een logopedist en doen taalspelletjes met hun ouders en vrijwilligers."
                            }
                        ]
                    }
                ],
