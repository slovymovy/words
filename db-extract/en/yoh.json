                                "example_id": "a3025a9c-76bb-40d9-867d-8c0dac3ffa50",
                                "sense_id": "1bb94a84-6583-3172-bf8f-6c0d0a8e9bcc",
                                "text": "The nurses looked at it with open eyes and open mouths. \"Yoh,\" said Sechelela. \"What is this?"
                            },
