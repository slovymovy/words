                                    },
                                    {
                                        "sense_id": "78273d50-9786-3c12-88fd-2d1270daf040",
                                        "entry_id": "c3389b59-3d91-3fb4-860d-d68f858c72eb",
                                        "glosses": [
                                            "The degree to which a metal or compound can withstand heat"
                                        ],
