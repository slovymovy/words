                        "début de l'automne",
                        "équinoxe d'automne"
                    ]
                },
                {
                    "sense_id": "52d95a2e-76ba-3016-ac34-8610382d687f",
                    "sense_definition": "Période de la vie humaine qui précède la vieillesse ; maturité finissante.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vieillesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrivé à l'<w>automne</w> de sa vie, il se consacra pleinement à l'écriture de ses mémoires."
                        },
                        {
                            "text": "L'<w>automne</w> d'une existence apporte souvent le calme et la sérénité après les passions de la jeunesse."
                        }
                    ],
                    "synonyms": [
                        "déclin"
                    ],
                    "antonyms": [
                        "printemps"
                    ],
                    "common_phrases": [
