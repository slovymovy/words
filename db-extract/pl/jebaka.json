        "pl-extract.jsonl": [
            {
                "entry_id": "6557d8b4-f285-3f29-95ef-814097bbe236",
                "word": "jebaka",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1a17d305-42ef-3682-b063-46a24bc41e24",
                        "entry_id": "6557d8b4-f285-3f29-95ef-814097bbe236",
                        "glosses": [
                            "mężczyzna odbywający dużo stosunków płciowych z wieloma kobietami"
                        ],
                        "tags": [
                            "colloquial",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "0baefdd1-48bf-40db-b12a-b3626d032124",
                                "sense_id": "1a17d305-42ef-3682-b063-46a24bc41e24",
                                "text": "Ale z niego jebaka, wydupczył już wszystkie laski w naszej firmie!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df2ebd4b-63e5-473e-92a5-22fc609b4849",
                        "source_entry_id": "6557d8b4-f285-3f29-95ef-814097bbe236",
                        "source_sense_id": "1a17d305-42ef-3682-b063-46a24bc41e24",
                        "target_lang_word": "блядун",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "блядун",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7e3f2756-2a18-31ce-9563-8e7f34bb8bea",
                                        "entry_id": "ffb317a1-5c75-34ae-8e0e-012adee84b2f",
                                        "glosses": [
                                            "вульг. мужчина, ведущий разгульнический, распутный образ жизни, имеющий беспорядочные половые связи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ae2c64d-1526-4e75-89e2-b9793aa37d18",
                                                "sense_id": "7e3f2756-2a18-31ce-9563-8e7f34bb8bea",
                                                "text": "Этот — мышиный жеребчик (он невероятно похудел, сузился, умалился), блядун, трепач, бесстыдный лгун, дешёвка в каждом слове и жесте."
                                            },
                                            {
                                                "example_id": "2da560c7-2d32-447d-afcb-369d89ea8278",
                                                "sense_id": "7e3f2756-2a18-31ce-9563-8e7f34bb8bea",
                                                "text": "— Терплю, терплю да и ухоньдехаю этого плясуна-блядуна."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b475c7ea-f942-46ce-8a44-0d103f6a2c4a",
                        "source_entry_id": "6557d8b4-f285-3f29-95ef-814097bbe236",
                        "source_sense_id": "1a17d305-42ef-3682-b063-46a24bc41e24",
                        "target_lang_word": "ебун",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ебун",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "94ac0805-70ff-3627-beea-c53122f22da7",
                                        "entry_id": "f1f12fba-8ffd-3de1-98ba-79462f4a72c1",
                                        "glosses": [
                                            "обсц. лицо мужского пола, сексуальный партнёр"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78fed91d-2e07-4a58-b17a-c4f7ab76c58c",
                                                "sense_id": "94ac0805-70ff-3627-beea-c53122f22da7",
                                                "text": "По деревне девки шли, — // Ебуна себе нашли! // За хорошим ебуном // Девки ходят табуном!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56bdf6b6-f17a-383a-9b14-a7767d80c624",
                                        "entry_id": "f1f12fba-8ffd-3de1-98ba-79462f4a72c1",
                                        "glosses": [
                                            "обсц., редк. то же, что блядун"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc609edd-b5b7-4776-95d5-f8d4aaaaadd8",
                                                "sense_id": "56bdf6b6-f17a-383a-9b14-a7767d80c624",
                                                "text": "Ох, пожалейте меня, // Да не ругайте меня! // В том что вороватый, — // Я не виноватый: // Шлюха — мать, отец — ебун, // Дед бездельник и шатун! // Братка за́ в’лосы дерёт, // Сестра секель продаёт!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2846181a-a94b-445c-be3b-30865474ad67",
                        "source_entry_id": "6557d8b4-f285-3f29-95ef-814097bbe236",
                        "source_sense_id": "1a17d305-42ef-3682-b063-46a24bc41e24",
                        "target_lang_word": "ёбарь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ёбарь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "46ebbb78-b7c2-3cc6-8eb7-e1e132d777f7",
                                        "entry_id": "72602e96-0d84-30da-820c-07dee333c5a2",
                                        "glosses": [
                                            "обсц. знаток, искусник в половом акте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee007c5f-0af0-4cb5-9b73-885898667f9f",
                                                "sense_id": "46ebbb78-b7c2-3cc6-8eb7-e1e132d777f7",
                                                "text": "Он уважал в себе ёбаря и был теоретиком этого дела — и практиком!"
                                            },
                                            {
                                                "example_id": "fab90451-3037-497c-8925-0d39262102d0",
                                                "sense_id": "46ebbb78-b7c2-3cc6-8eb7-e1e132d777f7",
                                                "text": "— Я счастлива! Он ёбарь каких я не встречала! Он меня носит на руках подмываться!"
                                            },
                                            {
                                                "example_id": "9e96e007-55fe-42db-b044-4f9272666a70",
                                                "sense_id": "46ebbb78-b7c2-3cc6-8eb7-e1e132d777f7",
                                                "text": "— Слушай, — она вдруг грустно и доверчиво оживилась, — а ты всё такой же потрясающий ёбарь?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aad5ae90-e266-3e77-80ce-211e5c056af5",
                                        "entry_id": "72602e96-0d84-30da-820c-07dee333c5a2",
                                        "glosses": [
                                            "обсц., сленг любовник; сексуальный партнёр; бойфренд"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "158f6dcf-0dc7-4d75-aed8-269d6186e41d",
                                                "sense_id": "aad5ae90-e266-3e77-80ce-211e5c056af5",
                                                "text": "Приходит заяц к слону. — Слониха дома? — Нет, а что передать? — Передай, что ёбарь заходил."
                                            },
                                            {
                                                "example_id": "56fb3f8c-b974-4c79-8a14-92f4af1bcd34",
                                                "sense_id": "aad5ae90-e266-3e77-80ce-211e5c056af5",
                                                "text": "Петухи поют, — // Проснулись! // Ебаря идут, — // Согнулись!"
                                            },
                                            {
                                                "example_id": "0e580637-312b-4201-9a5b-641ad8c02dac",
                                                "sense_id": "aad5ae90-e266-3e77-80ce-211e5c056af5",
                                                "text": "— Никогда и никто не найдёт мне издателя. Все находят для меня только ебаре́й. И половина этих ебаре́й на самом деле импотенты, это они комплексы так избывают, психоанализом занимаются сами с собой, пренатальные матрицы изживают, в задницу им хуй!"
                                            },
                                            {
                                                "example_id": "443c1c4f-19d9-43e9-904a-6826198a6ad4",
                                                "sense_id": "aad5ae90-e266-3e77-80ce-211e5c056af5",
                                                "text": "Карпекина — она сидит за одной партой с Клоком — кривит губы. — Вообще у неё счас ёбарь есть. Какой-то начальник с химзавода. ❬…❭ Иван, наверное, её мужик или ёбарь, и какой он — здоровый или нет, — я не знаю и на всякий случай съебываюсь через калитку."
                                            },
                                            {
                                                "example_id": "015e6984-f748-47f4-b536-4589012ed1a6",
                                                "sense_id": "aad5ae90-e266-3e77-80ce-211e5c056af5",
                                                "text": "— А ёбарю этому мы с Витькой всё равно башку оторвём."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62bbf217-2db6-4fca-9d1d-2fbde8637c0c",
                        "source_entry_id": "6557d8b4-f285-3f29-95ef-814097bbe236",
                        "source_sense_id": "1a17d305-42ef-3682-b063-46a24bc41e24",
                        "target_lang_word": "трахарь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": []
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "2dc692c0-b2e9-3003-be38-79f77c16ab6f",
                "word": "jebaka",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b3af3b25-fa54-37d6-8a27-69fc767504f6",
                        "entry_id": "2dc692c0-b2e9-3003-be38-79f77c16ab6f",
                        "glosses": [
                            "niegodziwa, zła kobieta, oszustka, lekkich obyczajów"
                        ],
                        "tags": [
                            "colloquial",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "11a3dfa8-e789-4bb5-814e-3999435bc08c",
                                "sense_id": "b3af3b25-fa54-37d6-8a27-69fc767504f6",
                                "text": "Czy zawsze byłaś taka, pierdolona jebaka?"
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7e41f5d-4467-46ea-8a3a-933642434ece",
                        "source_entry_id": "2dc692c0-b2e9-3003-be38-79f77c16ab6f",
                        "source_sense_id": "b3af3b25-fa54-37d6-8a27-69fc767504f6",
                        "target_lang_word": "шлюха",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шлюха",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "26ee750a-f514-30a2-a3ee-336a2a9a7f33",
                                        "entry_id": "df5df88a-a761-33e4-808c-e513d09ed030",
                                        "glosses": [
                                            "вульг., груб. то же, что проститутка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41996a58-bee9-4c28-b975-0c34502b6bbe",
                                                "sense_id": "26ee750a-f514-30a2-a3ee-336a2a9a7f33",
                                                "text": "В здешнем музее эротики — лучшем в мире, тут же на Строгете, неподалёку от богословского факультета — я разглядывал фотографии шлюх с клиентами-моряками, в чьей повадке почудилось что-то знакомое."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dc32eec-5620-35bc-8f38-e3a9f525ff3a",
                                        "entry_id": "df5df88a-a761-33e4-808c-e513d09ed030",
                                        "glosses": [
                                            "груб., презр. распущенная женщина"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcbdff35-af18-4f2e-8979-c7a4fab018a7",
                                                "sense_id": "5dc32eec-5620-35bc-8f38-e3a9f525ff3a",
                                                "text": "При Викторе Мироновиче состоял свой кучер, который в отсутствие барина пьянствовал и водил в конюшню разных «шлюх»."
                                            },
                                            {
                                                "example_id": "0be10214-092f-4d84-b9b3-6e1e3070a933",
                                                "sense_id": "5dc32eec-5620-35bc-8f38-e3a9f525ff3a",
                                                "text": "Мальвина — царица московских шлюх: золотая копна волос, золотые зубы и тело Венеры."
                                            },
                                            {
                                                "example_id": "819f0d92-a145-48f2-8297-d5efc2b842c3",
                                                "sense_id": "5dc32eec-5620-35bc-8f38-e3a9f525ff3a",
                                                "text": "Да научите жён сексу, дайте атрибуты, возможность следить за собой, и у мужей спадёт спрос на шлюх."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed389193-314b-3acb-9152-963001258118",
                                        "entry_id": "df5df88a-a761-33e4-808c-e513d09ed030",
                                        "glosses": [
                                            "перен., вульг., бран. то же, что женщина"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de6ecbc4-a558-4875-b642-3aa127ef7d61",
                                                "sense_id": "ed389193-314b-3acb-9152-963001258118",
                                                "text": "Уже полчаса жду в машине, пока жена да тёща спуститься изволят, а эти шлюхи где-то застряли!"
                                            },
                                            {
                                                "example_id": "c7d8c050-c8b7-4031-a70c-4f98ead1aa4f",
                                                "sense_id": "ed389193-314b-3acb-9152-963001258118",
                                                "text": "Целый день крик. — Ты, шлюха, опять самовар ставишь! — закричала какая-то женщина в кухне. 〈…〉 — Я лучинкой достану… — Ах ты шлюха! Ах, господи, нет у меня ног-то, а то я бы тебе задала!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "451b4aac-a5ff-3528-813e-62e2bbd23ed6",
                                        "entry_id": "df5df88a-a761-33e4-808c-e513d09ed030",
                                        "glosses": [
                                            "устар. неряшливая, неопрятная женщина"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "748e3fd6-3401-4a1a-a99a-615ca5fd9111",
                                                "sense_id": "451b4aac-a5ff-3528-813e-62e2bbd23ed6",
                                                "text": "Она числится одной из почётнейших барынь в городе, вывозит на вечера по три, по четыре, даже по пяти взрослых дочерей, и дочери эти пристраиваются одна за другой, по светскому понятию, довольно выгодно, хотя они, как говорится, ни с рожи, ни с кожи, все более или менее просты, чванны, собою очень посредственны, ходят в люди в блёстках, а дома шлюхами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4e0aa5c-f45c-45b1-ab15-64689e50671a",
                        "source_entry_id": "2dc692c0-b2e9-3003-be38-79f77c16ab6f",
                        "source_sense_id": "b3af3b25-fa54-37d6-8a27-69fc767504f6",
                        "target_lang_word": "прошмандовка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "прошмандовка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "530e432e-a34e-338b-a670-b8a51f3d43d8",
                                        "entry_id": "6762dba9-9a5a-31d5-9c03-55dca709b827",
                                        "glosses": [
                                            "бран. потаскуха, падшая женщина, проститутка, дешёвая уличная проститутка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50c59f21-1ca3-4c77-b4c4-a8b462fb59ca",
                                                "sense_id": "530e432e-a34e-338b-a670-b8a51f3d43d8",
                                                "text": "Ах ты, прошмандовка вокзальная!"
                                            },
                                            {
                                                "example_id": "34c0f5e1-b9b2-46f9-91b9-c7ac8f517b9f",
                                                "sense_id": "530e432e-a34e-338b-a670-b8a51f3d43d8",
                                                "text": "— Мне нужна жена, а не прошмандовка, — орал Куприн, топая ногами, — где ты носишься по ночам?"
                                            },
                                            {
                                                "example_id": "fb327907-3b27-44d5-b740-55ee9eb3a9a7",
                                                "sense_id": "530e432e-a34e-338b-a670-b8a51f3d43d8",
                                                "text": "А как весёлые воровайки и уличные прошмандовки колбасили буги-вуги в том же «Рисе», в «Без жалости» (1948) или «Мошенничестве» (1955)!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b122395-d5a8-382c-b088-d32ca97a5546",
                                        "entry_id": "6762dba9-9a5a-31d5-9c03-55dca709b827",
                                        "glosses": [
                                            "бран. пронырливая, хитрая, коварная женщина"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eea9ebd2-b7bc-38d7-92e3-af6765efd110",
                                        "entry_id": "6762dba9-9a5a-31d5-9c03-55dca709b827",
                                        "glosses": [
                                            "любая женщина, девушка"
                                        ],
                                        "tags": [
                                            "обычно в ирон.-шутл. значении"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97a92dde-5be5-465b-be49-4c02a619edca",
                                                "sense_id": "eea9ebd2-b7bc-38d7-92e3-af6765efd110",
                                                "text": "Итак, я стоял на крылечке у самого истока духовного обновления этой прошмандовки Марьи Гавриловны."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94e83d15-51ca-3e6e-a5dd-d277e96743c0",
                                        "entry_id": "6762dba9-9a5a-31d5-9c03-55dca709b827",
                                        "glosses": [
                                            "бран.,"
                                        ],
                                        "tags": [
                                            "также в отношении мужчины-гомосексуала — проститута"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fc573f4-6689-4074-a92b-5c2856921281",
                                                "sense_id": "94e83d15-51ca-3e6e-a5dd-d277e96743c0",
                                                "text": "— Кончай ты с этим Вадиком якшаться, тем более, что никакой он не Вадик, а Александр Борисович из администрайки, а вообще-то — \"Нинель\", прошмандовка привокзальная, натурально тебе говорю! — А ты-то откуда знаешь? — Откуда?! От верблюда, блин-компот! У моей Варюхи брат в ментовке работает, а ты спрашиваешь, откуда."
                                            }
                                        ]
                                    }
                                ]
                            }
