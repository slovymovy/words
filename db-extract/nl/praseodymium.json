                                    {
                                        "sense_id": "64b07962-b5da-3052-9007-a213f37b8dea",
                                        "entry_id": "293ceb38-5668-3584-a412-e0aacdb6253e",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 59, das zu den Lanthanoiden gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56034919-d77a-4e68-8556-8f21a757071d",
                                                "sense_id": "64b07962-b5da-3052-9007-a213f37b8dea",
                                                "text": "Praseodym ist ein weiches, silberweißes paramagnetisches Metall."
                                            },
                                            {
                                                "example_id": "663d61e2-b5d4-403c-9ea6-1f4a24b4ec67",
                                                "sense_id": "64b07962-b5da-3052-9007-a213f37b8dea",
                                                "text": "„Wegen seiner Luftempfindlichkeit sollte Praseodym unter Benzin oder in Kunststoff oder Glas versiegelt aufbewahrt werden.“"
                                            },
                                            {
                                                "example_id": "02e3e4b4-11c8-4d73-81c5-3f611c6e51e1",
                                                "sense_id": "64b07962-b5da-3052-9007-a213f37b8dea",
                                                "text": "„Allein von den für Permanentmagnete wichtigen und als knappe Ressource eingestuften Elementen Neodym und Praseodym könnten aus dem Fen Carbonatite Complex mindestens 1,5 Millionen Tonnen gefördert werden, so die vorläufige Abschätzung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ceff60de-ec67-4428-b312-701ee0471f23",
                        "source_entry_id": "f4ceb951-df83-3935-922a-9257282cae6b",
                        "source_sense_id": "39e66eae-50ac-3199-8c0d-e4ea437997b2",
