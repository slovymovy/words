                        ],
                        "examples": [
                            {
                                "example_id": "f1458802-05a7-4be5-aafb-13355d2b37e8",
                                "sense_id": "ec86b7e5-e1b4-3972-a74b-648efebf70c2",
                                "text": "Elles se font du bon sang, elles ricassent ensemble si fort qu’on ne sait plus à qui entendre !"
                            },
                            {
                                "example_id": "12c909b0-df22-493b-a4c9-3798848269dd",
                                "sense_id": "ec86b7e5-e1b4-3972-a74b-648efebf70c2",
                                "text": "Je la voyais ricasser, et j’avais beau me dire : « Mon pauvre ami, va-t’en, elle se gausse de toi », de la voir ricasser, je ricassais aussi. Que je devais donc avoir la face d’un abruti !…"
                            }
                        ]
                    }
