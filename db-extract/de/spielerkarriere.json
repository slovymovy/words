                "senses": [
                    {
                        "sense_id": "b6baa86d-fb6a-3bc3-81e2-bfae26d2d4df",
                        "entry_id": "b6619216-7a56-3d2c-9d9f-60247aafb981",
                        "glosses": [
                            "(erfolgreicher) beruflicher Werdegang, Laufbahn eines Profispielers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6019fa22-d413-40a9-875e-39e33f48ef64",
                                "sense_id": "b6baa86d-fb6a-3bc3-81e2-bfae26d2d4df",
                                "text": "„Wir wollen aber mithilfe von speziell für uns entwickelten Softwareprogrammen den Spielverlauf noch besser vorhersehen und antizipieren, bei der wissenschaftlichen Begleitung von Spielerkarrieren stecken wir nach meiner Einschätzung noch in den Kinderschuhen.“"
                            },
                            {
                                "example_id": "475335e1-d1ea-49c7-8812-85df43c392fe",
                                "sense_id": "b6baa86d-fb6a-3bc3-81e2-bfae26d2d4df",
                                "text": "„Eine Arbeit als Trainer hatte Klose häufiger als eine Option für die Zeit nach der aktiven Spielerkarriere genannt.“"
                            },
                            {
                                "example_id": "65e4bd9e-37e2-45c0-8816-c84cddd7e5d7",
                                "sense_id": "b6baa86d-fb6a-3bc3-81e2-bfae26d2d4df",
                                "text": "„Wie der Bundesligist mitteilte, habe man sich mit dem 32 Jahre alten Stürmer zudem auf eine weitere Zusammenarbeit nach der aktiven Spielerkarriere geeinigt.“"
                            },
                            {
                                "example_id": "7d4ac7f2-7a78-42bb-a6ba-63b96b487930",
                                "sense_id": "b6baa86d-fb6a-3bc3-81e2-bfae26d2d4df",
                                "text": "„Als Pep Guardiola 2006 mit 35 Jahren seine Spielerkarriere beendete, fuhr er mit einem Freund nach Argentinien in den Urlaub.“"
                            },
                            {
                                "example_id": "a8242711-5394-4f92-bf5a-286bf6639cf6",
                                "sense_id": "b6baa86d-fb6a-3bc3-81e2-bfae26d2d4df",
                                "text": "„Lehmann, der seine Spielerkarriere 2011 endgültig beendet hatte, verfügt seit der vergangenen Woche über einen Trainerschein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
