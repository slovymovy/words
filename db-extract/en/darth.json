                                "example_id": "860e0f06-81c7-44f0-9401-24ec93087b53",
                                "sense_id": "a43a0631-7506-3462-9a52-e6cc86b78d14",
                                "text": "[…] glaring malevolently across his desk at me in the manner that had earned him the nickname “Darth” among his elite cadre of audio penetration officers."
                            },
                            {
                                "example_id": "5b0872fe-f936-495f-a6f3-ec0f55a882db",
                                "sense_id": "a43a0631-7506-3462-9a52-e6cc86b78d14",
                                "text": "The evil Darth Leonard steals the formula and a young couple must get it back (real life Ward Leonard is a legendary recluse who has hiked the Appalachian Trail something like 20-30 times)."
                            },
                            {
                                "example_id": "e1c4816b-8967-4f6f-8689-73d1ad8238b3",
                                "sense_id": "a43a0631-7506-3462-9a52-e6cc86b78d14",
                                "text": "I’m sure Darth Hoodie has some other illegal way of messing with inexperienced quarterbacks on the road."
                            }
