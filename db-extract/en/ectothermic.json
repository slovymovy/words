                                    {
                                        "sense_id": "4cbea48f-1d66-3741-a26e-969da1e7ad5c",
                                        "entry_id": "436bb2c7-d1f9-3caf-be9a-f4b087ee33d6",
                                        "glosses": [
                                            "ohne Erregung/Gefühlsregung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7af3034f-be11-4ee1-aa8e-1949cd31451a",
                                                "sense_id": "4cbea48f-1d66-3741-a26e-969da1e7ad5c",
                                                "text": "„Ein kaltblütiger Signalgast hatte die Bomben aufgenommen, zwei empfingen sogar ein schwärzliches Licht von der Morgensonne.“"
                                            },
                                            {
                                                "example_id": "91f80e63-1284-421d-a2d6-513db874b7bb",
                                                "sense_id": "4cbea48f-1d66-3741-a26e-969da1e7ad5c",
                                                "text": "„Ich persönlich muß sagen, ich nehme solche Dinge keineswegs so kaltblütig hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6362b2be-b668-3986-b7fe-4e84c6e9c2cd",
                                        "entry_id": "436bb2c7-d1f9-3caf-be9a-f4b087ee33d6",
                                        "glosses": [
                                            "ohne Skrupel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41debd34-e75a-42a0-b8c6-510923d17cee",
                                                "sense_id": "6362b2be-b668-3986-b7fe-4e84c6e9c2cd",
                                                "text": "Wie sich herausstellte, war sein langjähriger Nachbar ein kaltblütiger Serienmörder."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "76bb78c4-6487-3fee-8f14-d0af32533478",
                                        "entry_id": "436bb2c7-d1f9-3caf-be9a-f4b087ee33d6",
                                        "glosses": [
                                            "die Körpertemperatur wechselnd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "548cfdbc-fc13-4651-b42c-e1507f8d31d7",
                                                "sense_id": "76bb78c4-6487-3fee-8f14-d0af32533478",
                                                "text": "„Reptilien, die nächsten lebenden Verwandten der Säugetiere, sind kaltblütig (Ektothermie).“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
