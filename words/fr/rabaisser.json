    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91bdd208-e62f-3478-ac62-cc35503ab92d",
                    "sense_definition": "Déprécier les mérites, les qualités ou la dignité d'une personne ; humilier.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "humiliation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il adore <w>rabaisser</w> ses collègues en public pour se sentir supérieur."
                        },
                        {
                            "text": "Ce professeur ne <w>rabaisse</w> jamais ses élèves lorsqu'ils commettent une erreur."
                        }
                    ],
                    "common_phrases": [
                        "rabaisser quelqu'un",
                        "rabaisser les autres"
                    ]
                },
                {
                    "sense_id": "6e45e872-70c0-3935-8c94-ede2f09cbf5d",
                    "sense_definition": "Placer un objet plus bas que sa hauteur actuelle ; descendre.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce tableau est accroché trop haut, il faut un peu le <w>rabaisser</w>."
                        },
                        {
                            "text": "Le menuisier a dû <w>rabaisser</w> l'étagère pour qu'elle s'ajuste au mur."
                        }
                    ],
                    "synonyms": [
                        "abaisser"
                    ],
                    "common_phrases": [
                        "rabaisser un tableau",
                        "rabaisser une étagère"
                    ]
                },
                {
                    "sense_id": "c0d8c554-9c39-398a-a1ea-a07ffb7b4a7e",
                    "sense_definition": "Se déconsidérer ou s'humilier soi-même, s'attribuer moins de valeur que ce que l'on mérite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humiliation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as beaucoup de talent, tu ne devrais pas te <w>rabaisser</w> ainsi."
                        },
                        {
                            "text": "Elle a tendance à se <w>rabaisser</w> dès qu'elle rencontre de nouvelles personnes."
                        }
                    ],
                    "common_phrases": [
                        "se rabaisser sans cesse",
                        "se rabaisser devant autrui"
                    ]
                },
                {
                    "sense_id": "5be13811-778b-3e4e-87a9-6240b2b2631b",
                    "sense_definition": "Déprécier une chose ou en estimer la valeur au-dessous de son prix réel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'acheteur critique chaque détail pour <w>rabaisser</w> le prix de la maison."
                        },
                        {
                            "text": "Le client <w>rabaisse</w> toujours la qualité des produits pour négocier."
                        }
                    ],
                    "common_phrases": [
                        "rabaisser la marchandise",
                        "rabaisser le prix"
                    ]
                },
                {
                    "sense_id": "75e8e909-0bc8-35da-9608-2361a6152e73",
                    "sense_definition": "Faire taire ou confondre une personne prétentieuse en réduisant son arrogance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son discours brillant a rapidement <w>rabaissé</w> le caquet de son rival."
                        },
                        {
                            "text": "Elle a su <w>rabaisser</w> le caquet de cet individu hautain lors du débat."
                        }
                    ],
                    "common_phrases": [
                        "rabaisser le caquet"
                    ],
                    "traits": [
