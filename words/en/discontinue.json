{
    "word_family": [
        "discontinuation",
        "discontinuity",
        "continuous",
        "continuity",
        "continue"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a0b950d-a3a3-3d04-8d7c-438a9904229f",
                    "sense_definition": "To stop producing, making, supplying, or offering a product, service, or activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stop_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manufacturer decided to <w>discontinue</w> the old model after the new version was released.",
                            "target_lang_translations": {
                                "ru": "Производитель решил <w>прекратить выпуск</w> старой модели после выхода новой версии."
                            }
                        },
                        {
                            "text": "They plan to <w>discontinue</w> production of this car next year due to low sales.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>прекратить</w> производство этого автомобиля в следующем году из-за низких продаж."
                            }
                        }
                    ],
                    "synonyms": [
                        "break off",
                        "terminate"
                    ],
                    "antonyms": [
                        "continue"
                    ],
                    "common_phrases": [
                        "discontinue production",
                        "discontinue a service",
                        "discontinue the product"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекратить производство, изготовление, поставку или предложение продукта, услуги или деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прекратить",
                                "target_lang_sense_clarification": "производство, выпуск или предоставление услуг"
                            },
                            {
                                "target_lang_word": "прекращать",
                                "target_lang_sense_clarification": "производство, выпуск или предоставление услуг"
                            },
                            {
                                "target_lang_word": "снять с производства",
                                "target_lang_sense_clarification": "о товаре или модели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abf52b12-b820-3485-bc78-fa20e50520dd",
                    "sense_definition": "To stop taking or administering a medication or medical treatment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_cessation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should not <w>discontinue</w> treatment without consulting your doctor first.",
                            "target_lang_translations": {
                                "ru": "Вам не следует <w>прекращать</w> лечение без предварительной консультации с врачом."
                            }
                        },
                        {
                            "text": "Patients who experience severe side effects may need to <w>discontinue</w> the medication immediately.",
                            "target_lang_translations": {
                                "ru": "Пациентам, у которых возникают серьезные побочные эффекты, может потребоваться немедленно <w>прекратить прием</w> препарата."
                            }
                        }
                    ],
                    "synonyms": [
                        "terminate"
                    ],
                    "antonyms": [
                        "continue"
                    ],
                    "common_phrases": [
                        "discontinue treatment",
                        "discontinue medication",
                        "discontinue use"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекратить прием или назначение лекарства или медицинского лечения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прекратить",
                                "target_lang_sense_clarification": "прием лекарства или лечение"
                            },
                            {
                                "target_lang_word": "прекращать",
                                "target_lang_sense_clarification": "прием лекарства или лечение"
                            },
                            {
                                "target_lang_word": "прервать",
                                "target_lang_sense_clarification": "курс лечения или терапии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}