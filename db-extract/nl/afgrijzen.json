                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d98a57a9-aed5-3783-b0c0-83ad4d4c376e",
                                        "entry_id": "343013bc-c35a-375e-b729-1e83efd0a06c",
                                        "glosses": [
                                            "Clipping of dreadlock."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "in-plural",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6be46781-c38c-40e4-a15a-32428571e187",
                                                "sense_id": "d98a57a9-aed5-3783-b0c0-83ad4d4c376e",
                                                "text": "Jesus Christ had dreads / So shake 'em / I ain't got none / But I'm planning on growing some."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69522ae7-40f5-3de2-a8cd-a1e63fd718d4",
                                        "entry_id": "343013bc-c35a-375e-b729-1e83efd0a06c",
