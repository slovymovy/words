                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98444742-2634-427c-b7d8-d292f2f8db5c",
                                "sense_id": "d4e017a7-141b-3c3d-b4b5-cbd41802b769",
                                "text": "„Durch den Eisenhandel wurde die Entstehung einer neuen Oberschicht begünstigt, die über Kontakte bis in den Mittelmeerraum verfügte.“"
                            },
                            {
                                "example_id": "e62b5aa4-911c-4c69-8b9d-addc103101f5",
                                "sense_id": "d4e017a7-141b-3c3d-b4b5-cbd41802b769",
                                "text": "„Bedingt durch den aufsteigenden Eisenhandel gewährte der römisch-deutsche König und spätere Kaiser Ferdinand I. am 24. Jänner 1541 dem Rat der Stadt Leoben das Privileg einen Bürgermeister zu wählen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
