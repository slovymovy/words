                        "tags": [],
                        "examples": [
                            {
                                "example_id": "084c998b-0a8f-4cb4-9580-b73581cdda28",
                                "sense_id": "4eddc395-cb60-3a8d-abdd-dd74d6ba261b",
                                "text": "\"Saudi-Arabië is verantwoordelijk voor de schade aan het ambassadegebouw en voor de mensen die gewond zijn geraakt\", zegt een woordvoerder van het Iraanse ministerie van Buitenlandse Zaken."
                            },
                            {
                                "example_id": "2e1f6a3a-24ad-45e0-b572-05ceeea226d3",
                                "sense_id": "4eddc395-cb60-3a8d-abdd-dd74d6ba261b",
                                "text": "Iraniërs hebben de Saudische ambassade in Teheran bestormd. Ze deden dat als vergelding voor het executeren, in Saudi-Arabië, van de prominente sjiitische geestelijke Nimr al-Nimr. Er werden brandbommen gegooid en betogers drongen het ambassadegebouw binnen, waar ze het interieur kort en klein sloegen."
                            }
                        ]
