                                        "sense_id": "6c1d776e-3fd7-31a1-b626-4e3a161ceb89",
                                        "entry_id": "c3d5aab1-c8f5-3c14-a702-ef0843f8e915",
                                        "glosses": [
                                            "een sojaboon die ontkiemt is en waaraan een stukje stengel is gegroeid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33066ce2-e6b2-49d4-8007-d960e0b5acf2",
                                                "sense_id": "6c1d776e-3fd7-31a1-b626-4e3a161ceb89",
                                                "text": "Voeg het limoensap toe en vervolgens beuken- zwammen en sojascheuten. Laat 2 minuutjes verder garen en voeg dan de overige ingrediënten, inclusief de mosselen toe. Werk af met koriander, munt, geroosterde zoute pinda's, chilivlokken en limoenrasp."
                                            },
                                            {
                                                "example_id": "ba94ac6d-b762-49bf-b863-29f0eff63650",
                                                "sense_id": "6c1d776e-3fd7-31a1-b626-4e3a161ceb89",
                                                "text": "Doe de olie in een pan of wok en roerbak de groenten (behalve de sojascheuten) een 5-tal minuten."
                                            }
                                        ]
                                    },
