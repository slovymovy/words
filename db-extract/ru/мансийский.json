                        "target_lang_word": "Mansi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mansi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a96fa3d1-785f-3652-a335-1fd9ec15edd2",
                                        "entry_id": "20a6f42e-6ef3-38f1-9758-647f8374f7f5",
                                        "glosses": [
                                            "A member of an ethnic group of people who live in Khanty-Mansi autonomous okrug."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6269f92-bf19-4aeb-9c5d-46be298798a3",
                                                "sense_id": "a96fa3d1-785f-3652-a335-1fd9ec15edd2",
                                                "text": "A small Mansi population has also lived up to the present day on the western slopes of the Ural mountains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Mansi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4580502-a1c5-3267-a2e0-7c802bbd3d8f",
                                        "entry_id": "b9bcc8b9-8d12-3dc9-9a0e-0a37bbde5631",
                                        "glosses": [
                                            "The Uralic language spoken by these people, now more often considered a group of closely related languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "250364be-f896-4ef6-884f-8672a5ea1b81",
                                                "sense_id": "e4580502-a1c5-3267-a2e0-7c802bbd3d8f",
                                                "text": "The languages of the other three branches – Mansi, Khanty and Samoyed – are or were spoken in Siberia, but the area of Tundra Nenets in the Samoyed branch extends to the west of the Ural mountains, and the area of Southern Mansi also originally covered parts of Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
