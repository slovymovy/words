                                    {
                                        "sense_id": "7c95b05a-ba29-3d7a-ba62-cfa66a7316d0",
                                        "entry_id": "a3492bf1-97f1-3a68-9665-b0e50249659c",
                                        "glosses": [
                                            "disegno decorativo incancellabile sulla pelle"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "554da664-50ff-4339-9166-e85f0e73657c",
                                                "sense_id": "7c95b05a-ba29-3d7a-ba62-cfa66a7316d0",
                                                "text": "storicamente alcuni popoli distinguevano i loro “appartenenti” attraverso l’identificazione del tatuaggio, anche secondo i vari “gruppi familiari”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f739c47-fd7f-42e0-aae8-60586b02c137",
                        "source_entry_id": "258abd5d-f0c9-3db9-8494-165c20a6db2a",
                        "source_sense_id": "8ec062f7-20d3-3a75-b7ee-55d6b97590ab",
                        "target_lang_word": "Tattoo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tattoo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1dc829cd-776c-3b29-829f-36a013cef505",
                                        "entry_id": "e4a8a84f-666c-3149-a9ec-05fd514e0f73",
                                        "glosses": [
                                            "mit Farbmitteln in die Haut eingestochenes Motiv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f52baf13-692c-4587-8c94-c482dacb0d3e",
                                                "sense_id": "1dc829cd-776c-3b29-829f-36a013cef505",
                                                "text": "Weil sie noch minderjährig ist und ihre Mutter ihr keine Erlaubnis erteilt, darf Petra sich kein Tattoo stechen lassen."
                                            },
                                            {
                                                "example_id": "641b4da1-c999-403f-aece-c25138396351",
                                                "sense_id": "1dc829cd-776c-3b29-829f-36a013cef505",
                                                "text": "„Nachdem meine Augen einen Moment an den Tattoos auf ihren Oberarmen hängen geblieben waren, erklärte ich, ich käme in Frieden, und bat sie, freundlicherweise leiser zu machen.“"
                                            },
                                            {
                                                "example_id": "08246a37-6ca6-426b-800f-a6805485deba",
                                                "sense_id": "1dc829cd-776c-3b29-829f-36a013cef505",
                                                "text": "„Seine breiten, baumstarken Arme waren mit dunkelgrünen Tattoos übersät, die wie wild wuchernder japanischer Knöterich bis zu seinen Schultern hinaufkletterten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67094949-f66c-46c1-81cb-c8025b81d281",
                        "source_entry_id": "258abd5d-f0c9-3db9-8494-165c20a6db2a",
                        "source_sense_id": "8ec062f7-20d3-3a75-b7ee-55d6b97590ab",
                        "target_lang_word": "Tätowierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tätowierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                        "entry_id": "bdd463d2-b13f-3f7d-b3a8-5d6191797c95",
                                        "glosses": [
                                            "mit Farbmitteln in die Haut eingestochenes Motiv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39658d7e-707a-475c-9a80-b90a104bdea4",
                                                "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                                "text": "Weil sie noch minderjährig ist und ihre Mutter ihr keine Erlaubnis erteilt, darf Petra sich keine Tätowierung stechen lassen."
                                            },
                                            {
                                                "example_id": "1c90e44e-b20a-4eb9-82ac-3707af10590d",
                                                "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                                "text": "Nach einigen Jahren gefiel Ursula ihre Tätowierung nicht mehr und wollte sie wieder entfernen lassen."
                                            },
                                            {
                                                "example_id": "79aba160-ff34-4b48-a8ad-7efc66967db5",
                                                "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                                "text": "Claus ist stolz auf die vielen Tätowierungen, die seinen Körper zieren."
                                            },
                                            {
                                                "example_id": "5128e768-2056-4526-a077-9501d3e4de1e",
                                                "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                                "text": "„Sie waren nur an den Armen und Oberschenkeln tätowiert, während die Männer am ganzen Körper Tätowierungen trugen.“"
                                            },
                                            {
                                                "example_id": "61f0c17f-0c9f-4f0e-bc04-b9fffcee32a3",
                                                "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                                "text": "„Ich flaniere zwischen schlaffen Penissen auf behaarten Schenkeln, Brüsten, die sich der Sonne präsentieren, von Tätowierungen umkränzten Pobacken und strassgepiercten Bauchnabeln.“"
                                            },
                                            {
                                                "example_id": "da698139-19fd-4189-928f-ea5eb76a3962",
                                                "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                                "text": "„Mir fällt die Tätowierung aus aneinandergereihten Kreuzen, die wie ein Vollbart ihr hübsches Gesicht umrandet, auf.“"
                                            },
                                            {
                                                "example_id": "ac05e9fb-920b-4b11-88b6-d95b63afc576",
                                                "sense_id": "5c7fdac4-81ef-3755-831d-c25138f48765",
                                                "text": "„Grenfeld brauchte weder auf die Tätowierungen noch auf die bösartig grinsenden Kerle zu sehen, um zu begreifen, dass er einen Fehler begangen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0a0530f-027b-4489-8f33-a86fbd73fe6c",
                        "source_entry_id": "258abd5d-f0c9-3db9-8494-165c20a6db2a",
                        "source_sense_id": "8ec062f7-20d3-3a75-b7ee-55d6b97590ab",
                        "target_lang_word": "tatuaż",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tatuaż",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "b6e66578-1400-3d18-8730-439cd1dce4a4",
                                        "entry_id": "4702de5c-4384-3203-a704-ea4623157d98",
                                        "glosses": [
                                            "trwały napis, wzór lub rysunek wykonany na ciele poprzez wprowadzenie barwnika w skórę"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de35b0dd-bba4-4324-a63b-a55de424ac3f",
                                                "sense_id": "b6e66578-1400-3d18-8730-439cd1dce4a4",
                                                "text": "Zrobił sobie tatuaż na lewym ramieniu."
                                            },
                                            {
                                                "example_id": "4d1166c8-5a77-4eb6-9806-7ab61e3a96b6",
                                                "sense_id": "b6e66578-1400-3d18-8730-439cd1dce4a4",
                                                "text": "Nie chcę mieć tatuażu."
                                            },
                                            {
                                                "example_id": "4984a06f-ef74-46cb-a268-f11944846d2b",
                                                "sense_id": "b6e66578-1400-3d18-8730-439cd1dce4a4",
                                                "text": "W tramwaju widziałem dziewczynę z tatuażem na plecach."
                                            },
                                            {
                                                "example_id": "db198dbd-efcc-4ed8-a050-aa6cf839a580",
                                                "sense_id": "b6e66578-1400-3d18-8730-439cd1dce4a4",
                                                "text": "W przypadku, kiedy policjant posiada widoczny tatuaż, przełożony może nie dopuścić go do pełnienia służby lub może odsunąć od jej pełnienia"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cce1ccec-270a-44db-959f-e5ada99f017a",
                        "source_entry_id": "258abd5d-f0c9-3db9-8494-165c20a6db2a",
                        "source_sense_id": "8ec062f7-20d3-3a75-b7ee-55d6b97590ab",
                        "target_lang_word": "tatouage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tatouage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bffd4166-f412-39ab-82bd-3e21897ee0bb",
                                        "entry_id": "3e1703f1-c977-3f53-b81c-316d203a426d",
                                        "glosses": [
                                            "Action de tatouer, décoration par l’insertion de substances colorées sous la peau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "396c33b5-84de-437b-81f5-30b4ec6d452e",
                                                "sense_id": "bffd4166-f412-39ab-82bd-3e21897ee0bb",
                                                "text": "D’ailleurs, le tatouage des Maoris, indépendamment de la considération dont il jouit, possède une incontestable utilité."
                                            },
                                            {
                                                "example_id": "16298023-9ddb-47ae-bd94-c12c76e4421c",
                                                "sense_id": "bffd4166-f412-39ab-82bd-3e21897ee0bb",
                                                "text": "Le tatouage, en effet, est une institution dans la marine américaine et des heures de service sont spécialement réservées à ce divertissement artistique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7afdd01a-8c1c-321a-a422-2924ee694302",
                                        "entry_id": "3e1703f1-c977-3f53-b81c-316d203a426d",
                                        "glosses": [
                                            "Dessin sur la peau qui résulte de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "243d3498-5420-47ad-a0e2-80aebde45a85",
                                                "sense_id": "7afdd01a-8c1c-321a-a422-2924ee694302",
                                                "text": "Cet an-là, y avait avec nous un type de Marseille, un jeune tout creux comme un mauvais radis, la peau sur l’os et un tatouage à la paume de la main où il y avait d’écrit “Merde”. Il tripotait le blé avec ça !"
                                            },
                                            {
                                                "example_id": "8db15a28-505b-4991-b387-d90123c82101",
                                                "sense_id": "7afdd01a-8c1c-321a-a422-2924ee694302",
                                                "text": "À Armenonville, à une table voisine de la nôtre, un sous-lieutenant de dragons enlace de son bras le buste de sa trop bruyante compagne et laisse voir ainsi au poignet un tatouage d’escarpe…"
                                            },
                                            {
                                                "example_id": "17356102-ea94-43dc-956f-3a89b4cb28d4",
                                                "sense_id": "7afdd01a-8c1c-321a-a422-2924ee694302",
                                                "text": "Passionnément désireux de me confondre avec le monde en rompant mes limites ou en l’incorporant – je rêvais de couvrir tout mon corps de tatouages astraux qui auraient illustré – de par leur présence même sur ma peau – cet essai de fusion du microcosme avec le macrocosme."
                                            },
                                            {
                                                "example_id": "f123f1b0-97e5-41e6-b0f6-9d9c15e20bff",
                                                "sense_id": "7afdd01a-8c1c-321a-a422-2924ee694302",
                                                "text": "Il s’agit du Portrait de Bronco McGinnis, cet homme qui se prétendit « l’Homme le plus tatoué du monde » et s’exhiba comme tel à l’Exposition Internationale de Chicago (après sa mort, en 1902, on apprit que c’était un Breton nommé Le Marech’ et que seuls les tatouages de sa poitrine étaient authentiques)."
                                            },
                                            {
                                                "example_id": "bf161eba-73c3-4de7-b1aa-c3fe5a211866",
                                                "sense_id": "7afdd01a-8c1c-321a-a422-2924ee694302",
                                                "text": "Que pensez-vous de l'éventuelle émergence d'un néopaganisme que l'on pourrait qualifier d’archéo-futuriste : soirée rave, musique techno, marquages physiques néotribaux comme les tatouages ou les piercings, etc. ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
