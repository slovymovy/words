                {
                    "sense_id": "9ed7eeaf-f30b-3a9d-932d-a03faf641cfb",
                    "sense_definition": "To search a ship for contraband goods.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inspection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The customs officers were ordered to <w>overhaul</w> the suspicious vessel for illegal cargo.",
