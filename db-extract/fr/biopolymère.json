                "forms": [
                    {
                        "form_id": "5006809e-5060-4378-9f6e-21e82d04c20b",
                        "entry_id": "a501f25b-f947-3489-8816-2805b74fd4ef",
                        "tags": [
                            "plural"
                        ],
                        "form": "biopolymères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "15187b98-e9ca-3c8b-ba72-5a38595025da",
                        "entry_id": "a501f25b-f947-3489-8816-2805b74fd4ef",
                        "glosses": [
                            "Toute macromolécule d'un être vivant qui résulte de la polymérisation de petites unités; un polymère présent dans un organisme vivant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1442d74f-3a4b-4453-90b3-c284af7f079c",
                                "sense_id": "15187b98-e9ca-3c8b-ba72-5a38595025da",
                                "text": "Les biopolymères sont des polymères, principalement des polysaccharides, produits par des micro-organismes."
                            },
                            {
                                "example_id": "28a9062a-b767-4790-a599-7e2b78969b23",
                                "sense_id": "15187b98-e9ca-3c8b-ba72-5a38595025da",
                                "text": "Le caoutchouc naturel est un biopolymère terpénique constitué de plusieurs milliers de molécules d’isoprène (molécules à 5 atomes de carbone), reliées par des liaisons cis-1,4. Il est issu essentiellement de l'hévéa."
                            },
                            {
                                "example_id": "edeb59b8-1b2c-4752-86ed-aba5dd331ee5",
                                "sense_id": "15187b98-e9ca-3c8b-ba72-5a38595025da",
                                "text": "[Le métabolisme phénolique] génère également les précurseurs de biopolymères, en particulier ceux de la lignine qui jouent un rôle fondamental dans la formation du système vasculaire."
                            }
                        ]
                    }
                ],
