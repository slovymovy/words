                "senses": [
                    {
                        "sense_id": "abaa6c9d-ce54-356b-a31b-df158b55b828",
                        "entry_id": "71dbee5d-0a00-3209-906d-b9988f3c5095",
                        "glosses": [
                            "Angehöriger des Adels, besonders in den ehemaligen italienischen Freistaaten"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "62115227-66e6-4a3b-89dd-9569a7b33913",
                                "sense_id": "abaa6c9d-ce54-356b-a31b-df158b55b828",
                                "text": "„Wir spielten in einem Kasino, das kein venetianischer Nobile zu besuchen wagte, weil einer der Bankhalter zum Hause des spanischen Gesandten, des Herzogs von Montalegro, gehörte. “"
                            },
                            {
                                "example_id": "fae21d63-3da8-47a2-8c5d-2aa897c1effe",
                                "sense_id": "abaa6c9d-ce54-356b-a31b-df158b55b828",
                                "text": "„Eine fatalere Proposition hätte unserm völlig von Geld entblößten Nobile nicht leicht gemacht werden können.“"
                            },
                            {
                                "example_id": "7282f9ab-7fc3-4daf-8dfb-b3ae81a3100c",
                                "sense_id": "abaa6c9d-ce54-356b-a31b-df158b55b828",
                                "text": "„Man hatte dem Niedergesunknen die Maske abgenommen, man erkannte den Sohn eines Nobile, er war tot.“"
                            },
                            {
                                "example_id": "6f8dfcc6-08c8-4530-8d74-928e765591a7",
                                "sense_id": "abaa6c9d-ce54-356b-a31b-df158b55b828",
                                "text": "„Ein Nobile besucht diesen Bau, um einem Freund die architektonischen Schönheiten zu erklären und bleibt plötzlich, infolge einer akustischen Wahrnehmung, wie versteinert stehen.“"
                            },
                            {
                                "example_id": "e84078b5-4646-487e-916b-c422bfd13d18",
                                "sense_id": "abaa6c9d-ce54-356b-a31b-df158b55b828",
                                "text": "„Aber der Baron blieb keineswegs bei seinem ihm zuwinkenden vornehmen Verwandten stehen, sondern ging einige Schritte weiter, bis er sich hinter dem neapolitanischen Nobile befand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
