                "senses": [
                    {
                        "sense_id": "db099086-cb3b-398a-8742-e5a0f36b4f7a",
                        "entry_id": "a0409b50-b706-310a-9dfa-02cd13639d13",
                        "glosses": [
                            "Schreibtisch aus Mahagoni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52dd1ea7-a380-4b90-bf4c-b85041760f10",
                                "sense_id": "db099086-cb3b-398a-8742-e5a0f36b4f7a",
                                "text": "„Dort verharrte er einen Moment lang, ehe er an einen billigen Mahagonischreibtisch trat und die oberste Schublade öffnete.“"
                            },
                            {
                                "example_id": "759d5216-2f3e-4708-86a2-43c73f017d44",
                                "sense_id": "db099086-cb3b-398a-8742-e5a0f36b4f7a",
                                "text": "„Hinter ihm befand sich ein Mahagonischreibtisch, der blutrot schimmerte von einem Jahrhundert des Handpolierens mit Bienenwachs.“"
                            },
                            {
                                "example_id": "c7be30c1-16ca-4e36-bdc5-9f634801d5c4",
                                "sense_id": "db099086-cb3b-398a-8742-e5a0f36b4f7a",
                                "text": "„Kitteredges riesiger Mahagonischreibtisch war so alt wie der Ozean und wurde von einem Modell des Schoners Haridan geziert, dem ganzen Stolz seines Besitzers.“"
                            },
                            {
                                "example_id": "a186cd4c-bdee-40cd-889e-e8e9f78d0cf3",
                                "sense_id": "db099086-cb3b-398a-8742-e5a0f36b4f7a",
                                "text": "„Sie gelangte in ein anderes Büro. Es enthielt einen großen Mahagonischreibtisch, einen etwas edleren Teppich und ein offenes Fenster, von dem aus man einen Blick in die Hauptkammer hatte.“"
                            },
                            {
                                "example_id": "0c1aab21-1595-49a9-9eea-8432b413b372",
                                "sense_id": "db099086-cb3b-398a-8742-e5a0f36b4f7a",
                                "text": "„Auf einem Regal links vom Mahagonischreibtisch standen Fachbücher, rechts befand sich ein zweites Regal mit Literatur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
