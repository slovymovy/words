                        "examples": [
                            {
                                "example_id": "3a0ba423-8d73-484a-bfab-d7542632a2c4",
                                "sense_id": "92bb34e5-4d4d-30ab-b1d3-43cda36116e6",
                                "text": "„Er war der Sohn und Erbe des AEG-Gründers Erich Rathenau, der in Frankreich die Patentrechte zur Elektrizitätsherstellung erworben hatte.“"
                            },
                            {
                                "example_id": "d235f89b-88fc-4927-8f74-e84877420653",
                                "sense_id": "92bb34e5-4d4d-30ab-b1d3-43cda36116e6",
                                "text": "„Sie hätten bei konsequenter Durchführung gerade einer Lähmung der Elektrizitätsherstellung den größten Erfolg haben können.“"
                            }
                        ],
