        "fr-extract.jsonl": [
            {
                "entry_id": "f412ee02-4e28-3da8-b80e-41f1a36eac1c",
                "word": "gésine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "04a0ff51-22ac-4ee5-bcc4-4df75ade15ea",
                        "entry_id": "f412ee02-4e28-3da8-b80e-41f1a36eac1c",
                        "tags": [
                            "plural"
                        ],
                        "form": "gésines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3836db24-d958-3b8b-b89f-fdc02d271393",
                        "entry_id": "f412ee02-4e28-3da8-b80e-41f1a36eac1c",
                        "glosses": [
                            "État d’une femme, ou de la femelle d’un mammifère, sur le point d’accoucher. → voir en gésine"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "58a94f0b-7ea7-4125-9deb-e6cee55f5eec",
                                "sense_id": "3836db24-d958-3b8b-b89f-fdc02d271393",
                                "text": "On me condamna à une amende considérable, aux frais de gésine, et à pourvoir à la subsistance et l’éducation d’un enfant…"
                            },
                            {
                                "example_id": "0549c894-79d1-40c5-bc63-7b8b2d87be0c",
                                "sense_id": "3836db24-d958-3b8b-b89f-fdc02d271393",
                                "text": "Et surtout, mon ami, ne touche pas aux dieux ! Il en bout, il en pleut, d’en haut, d’en bas, dessus nos nez, dessous nos pieds ; le monde en est gonflé, comme laie en gésine."
                            },
                            {
                                "example_id": "89e34b44-7dc2-43a2-b344-fa413ed57039",
                                "sense_id": "3836db24-d958-3b8b-b89f-fdc02d271393",
                                "text": "Les gamins effarés s'enfuirent à toutes jambes; et il se trouva subitement en face de la chienne en gésine qui s'efforçait de se lever."
                            },
                            {
                                "example_id": "50f28473-cb25-482b-a930-4d07f7c51517",
                                "sense_id": "3836db24-d958-3b8b-b89f-fdc02d271393",
                                "text": "Et devenue molle au travail, après tant de gésines et d’allaitements qui l’avaient accoutumée à une vie ruminante et passive, elle traînait par la maison, dure non moins que le père à cette Ursmarine qui leur restait de la couvée petit à petit dispersée en des hymens ou des métiers, au loin."
                            },
                            {
                                "example_id": "6e28e230-f1b9-4a66-8e7a-524c4e7d37c9",
                                "sense_id": "3836db24-d958-3b8b-b89f-fdc02d271393",
                                "text": "Martine, qu’avaient prise en route les douleurs de gésine, était restée à Dornecy, laissant Glodie à la grand-mère."
                            }
                        ]
                    }
                ],
