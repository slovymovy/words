{
    "word_family": [
        "marish"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ddac86a1-6a67-3983-b89b-2ca121c807f1",
                    "sense_definition": "An adult female horse.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>mare</w> was grazing peacefully in the green meadow.",
                            "target_lang_translations": {
                                "de": "Die alte <w>Stute</w> graste friedlich auf der grünen Wiese."
                            }
                        },
                        {
                            "text": "The farmer led the <w>mare</w> back to the stable after a long day.",
                            "target_lang_translations": {
                                "de": "Der Bauer führte die <w>Stute</w> nach einem langen Tag zurück in den Stall."
                            }
                        }
                    ],
                    "antonyms": [
                        "stallion"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein erwachsenes weibliches Pferd."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Stute",
                                "target_lang_sense_clarification": "erwachsenes weibliches Pferd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97e053de-a2e1-3844-b529-80751011f172",
                    "sense_definition": "A very difficult or frustrating experience.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trying to fix the broken computer was a total <w>mare</w>.",
                            "target_lang_translations": {
                                "de": "Zu versuchen, den kaputten Computer zu reparieren, war ein totaler <w>Albtraum</w>."
                            }
                        },
                        {
                            "text": "The flight delay turned our entire vacation into a complete <w>mare</w>.",
                            "target_lang_translations": {
                                "de": "Die Flugverspätung machte unseren ganzen Urlaub zu einem einzigen <w>Albtraum</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "nightmare",
                        "ordeal"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine sehr schwierige oder frustrierende Erfahrung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Albtraum",
                                "target_lang_sense_clarification": "umgangssprachlich: sehr unangenehme oder frustrierende Situation"
                            },
                            {
                                "target_lang_word": "Horror",
                                "target_lang_sense_clarification": "umgangssprachlich: sehr lästige, schreckliche Erfahrung"
                            },
                            {
                                "target_lang_word": "Katastrophe",
                                "target_lang_sense_clarification": "stark negative, mühsame Angelegenheit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "446eda1e-8bb3-3199-a44e-0b35338f72ed",
                    "sense_definition": "A foolish or annoying woman.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She acted like a total <w>mare</w> during the meeting today.",
                            "target_lang_translations": {
                                "de": "Sie hat sich heute in der Besprechung wie eine totale <w>Nervensäge</w> benommen."
                            }
                        },
                        {
                            "text": "Don't be such a <w>mare</w> and just listen to what I have to say.",
                            "target_lang_translations": {
                                "de": "Sei nicht so eine <w>Nervensäge</w> und hör einfach zu, was ich zu sagen habe."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often considered offensive or derogatory."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine törichte oder lästige Frau."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Nervensäge",
                                "target_lang_sense_clarification": "abwertend: nervige oder anstrengende Frau"
                            },
                            {
                                "target_lang_word": "blöde Kuh",
                                "target_lang_sense_clarification": "abwertend: dumme oder unangenehme Frau"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c4cff42-44c1-3071-8dca-e39b6982ee54",
                    "sense_definition": "A large dark plain on the surface of the Moon.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Astronomers studied the basaltic <w>mare</w> on the lunar surface.",
                            "target_lang_translations": {
                                "de": "Astronomen untersuchten das basaltische <w>Mare</w> auf der Mondoberfläche."
                            }
                        },
                        {
                            "text": "The telescope clearly showed the dark <w>mare</w> against the bright lunar highlands.",
                            "target_lang_translations": {
                                "de": "Das Teleskop zeigte deutlich das dunkle <w>Mare</w> vor dem hellen Mondhochland."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine große dunkle Ebene auf der Oberfläche des Mondes."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Mare",
                                "target_lang_sense_clarification": "astrogeologischer Fachbegriff für eine dunkle Ebene auf dem Mond"
                            },
                            {
                                "target_lang_word": "Mondmeer",
                                "target_lang_sense_clarification": "allgemeiner, erklärender Ausdruck"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ad2cc03-530a-3582-bd70-ca9bf6402293",
                    "sense_definition": "A large lake of liquid hydrocarbons found on Titan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists identified a large <w>mare</w> on the surface of Titan.",
                            "target_lang_translations": {
                                "de": "Wissenschaftler identifizierten ein großes <w>Mare</w> auf der Oberfläche des Titan."
                            }
                        },
                        {
                            "text": "The Kraken <w>mare</w> is one of the largest liquid bodies on the moon.",
                            "target_lang_translations": {
                                "de": "Das Kraken-<w>Mare</w> ist eines der größten Flüssigkeitsvorkommen auf dem Mond."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein großer See aus flüssigen Kohlenwasserstoffen auf Titan."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Mare",
                                "target_lang_sense_clarification": "planetologischer Fachbegriff auf Titan"
                            },
                            {
                                "target_lang_word": "Kohlenwasserstoffmeer",
                                "target_lang_sense_clarification": "erklärend: flüssiger Kohlenwasserstoffsee auf Titan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb6aab80-5047-30c6-852e-e56d4f1d8297",
                    "sense_definition": "An evil spirit believed to cause suffocation during sleep.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mythology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Folklore describes the <w>mare</w> as a spirit that sits on a sleeper's chest.",
                            "target_lang_translations": {
                                "de": "In der Folklore wird die <w>Mahr</w> als ein Geist beschrieben, der sich auf die Brust eines Schlafenden setzt."
                            }
                        },
                        {
                            "text": "Ancient stories warned of the <w>mare</w> causing bad dreams and breathing difficulties.",
                            "target_lang_translations": {
                                "de": "Alte Geschichten warnten vor der <w>Mahr</w>, die schlechte Träume und Atembeschwerden verursacht."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical folklore."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein böser Geist, von dem man glaubte, dass er im Schlaf Atemnot verursacht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Mahr",
                                "target_lang_sense_clarification": "historischer Volksglaube: nächtlicher Quälgeist"
                            },
                            {
                                "target_lang_word": "Nachtalb",
                                "target_lang_sense_clarification": "mythologischer Nachtgeist, der Schlafende bedrängt"
                            },
                            {
                                "target_lang_word": "Alb",
                                "target_lang_sense_clarification": "archaisch/mythologisch: drückender Nachtgeist"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bed2dc5-04b9-3b1f-bb1b-033e80890821",
                    "sense_definition": "An obsolete spelling of mayor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "government",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old document referred to the town <w>mare</w> in a legal decree.",
                            "target_lang_translations": {
                                "de": "Das alte Dokument bezeichnete den Stadt-<w>Bürgermeister</w> in einem Rechtsdekret mit einer veralteten Schreibweise."
                            }
                        },
                        {
                            "text": "In medieval texts, the title was sometimes written as <w>mare</w>.",
                            "target_lang_translations": {
                                "de": "In mittelalterlichen Texten wurde der Titel manchmal als <w>mare</w> geschrieben."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine veraltete Schreibweise von „mayor“."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Bürgermeister",
                                "target_lang_sense_clarification": "entspricht englisch mayor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d816c6e0-5a14-3759-9c49-fc92f11310ac",
                    "sense_definition": "An obsolete spelling of more.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archaic text requested <w>mare</w> grain for the winter season.",
                            "target_lang_translations": {
                                "de": "Der archaische Text verlangte <w>mehr</w> Getreide für den Winter."
                            }
                        },
                        {
                            "text": "He asked for <w>mare</w> wine in the old poem.",
                            "target_lang_translations": {
                                "de": "In dem alten Gedicht verlangte er <w>mehr</w> Wein."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine veraltete Schreibweise von „more“."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "mehr",
                                "target_lang_sense_clarification": "entspricht der heutigen Form"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3a4e4804-a514-3004-b471-46a1f9bf823d",
                    "sense_definition": "A diminutive of female names like Mary or Maria.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Her friends call her <w>Mare</w> instead of Mary.",
                            "target_lang_translations": {
                                "de": "Ihre Freunde nennen sie <w>Mare</w> statt Mary."
                            }
                        },
                        {
                            "text": "Everyone in the family knows <w>Mare</w> as a nickname for Marianne.",
                            "target_lang_translations": {
                                "de": "In der ganzen Familie kennt man <w>Mare</w> als Spitznamen für Marianne."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a nickname."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Kurzform weiblicher Namen wie Mary oder Maria."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Mare",
                                "target_lang_sense_clarification": "Spitzname oder Kurzform zu Mary, Maria oder ähnlichen Namen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
