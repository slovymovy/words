                "senses": [
                    {
                        "sense_id": "3b0fb510-8fe8-3db3-bcfa-14124e049bf1",
                        "entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                        "glosses": [
                            "A person who is absent from his or her employment, school, post, duty, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15ddff82-19f7-4b90-86d3-a077932238ab",
                                "sense_id": "3b0fb510-8fe8-3db3-bcfa-14124e049bf1",
                                "text": "At roll-call there were three absentees."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d69f53b-f861-334c-8b17-e6036df9004f",
                        "entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                        "glosses": [
                            "A person who is absent from his or her employment, school, post, duty, etc.",
                            "Designating a person absent in a particular capacity, sometimes implying that they are difficult to contact, unresponsive, avoiding their responsibilities, etc."
                        ],
                        "tags": [
                            "attributive"
                        ],
                        "examples": [
                            {
                                "example_id": "ebbfcb85-4eff-4c46-af6e-d6ecf4b93dd5",
                                "sense_id": "3d69f53b-f861-334c-8b17-e6036df9004f",
                                "text": "absentee father; absentee landlord; absentee freeholder"
                            }
                        ]
                    },
                    {
                        "sense_id": "d5165f93-b21f-36e4-ba0a-06597a7af6c5",
                        "entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                        "glosses": [
                            "A person who is absent from his or her employment, school, post, duty, etc.",
                            "A person who is absent from their residence and usual environment, and has not been seen or heard from for some period of time, so that it is unknown whether they are still alive, for the purpose of civil law dealing with the management of property etc. in such cases."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "64d5e421-920f-3502-b986-b3c641a343e8",
                        "entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                        "glosses": [
                            "Something that is not present where it might be expected."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1c06a25-54b5-43a4-b637-f69f2383775c",
                                "sense_id": "64d5e421-920f-3502-b986-b3c641a343e8",
                                "text": "The manufacturer's promised new model was a notable absentee at the car show."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b82a427-e587-31cc-901b-1de70b7aceff",
                        "entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                        "glosses": [
                            "Designating something whose owner, person responsible, etc. is absent."
                        ],
                        "tags": [
                            "attributive"
                        ],
                        "examples": [
                            {
                                "example_id": "5edeb435-9d6b-49de-b217-555957c67540",
                                "sense_id": "7b82a427-e587-31cc-901b-1de70b7aceff",
                                "text": "absentee ballot, absentee property"
                            },
                            {
                                "example_id": "87839d46-f410-4d70-9c0c-35c2042721ad",
                                "sense_id": "7b82a427-e587-31cc-901b-1de70b7aceff",
                                "text": "In Wyoming, a GOP state senator forwarded an FGA draft bill to Secretary of State Chuck Gray that would prohibit sending out unsolicited absentee ballot request forms."
                            }
                        ]
                    },
                    {
                        "sense_id": "06ecb6d1-3330-3466-b5b9-89c76faddb39",
                        "entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                        "glosses": [
                            "A landholder who lives in another district or country than the one in which his estate is situated."
                        ],
                        "tags": [
                            "British",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e4b2df2f-82fd-4494-b313-62b412b70492",
                                "sense_id": "06ecb6d1-3330-3466-b5b9-89c76faddb39",
                                "text": "My trustees are going to lend Earl Blessington sixty thousand pounds (at six per cent.) on a Dublin mortgage. Only think of my becoming an Irish absentee!"
                            }
                        ]
                    },
                    {
                        "sense_id": "144adf51-02e0-3c90-87a5-55896fe5665b",
                        "entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                        "glosses": [
                            "A voter who is not present at the time of voting; absentee voter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d44d20f-3f03-4211-a343-f4cd25f81f0b",
                                "sense_id": "144adf51-02e0-3c90-87a5-55896fe5665b",
                                "text": "In recent primaries, for example, nearly 4% of absentees were rejected in Philadelphia; 8% in Kentucky; and 20% in parts of New York City."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae298e44-ace7-4996-a856-6de4473a45a1",
                        "source_entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                        "source_sense_description": "person who is absent",
                        "target_lang_word": "afwezige",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afwezige",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b3103b9d-8f59-3387-997a-0907c74d122b",
                                        "entry_id": "c11fee09-83b2-3400-bdf3-c87614a2c378",
                                        "glosses": [
                                            "verbogen vorm van de stellende trap van afwezig"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f86c5c7a-e690-4cd4-8b54-7793c77b2a3d",
                                                "sense_id": "b3103b9d-8f59-3387-997a-0907c74d122b",
                                                "text": "'Olive kreeg een afwezige blik in haar ogen, terwijl ze zich begon terug te trekken uit de omgeving van haar zolder en dichter bij haar kunstzinnige visie kwam."
                                            },
                                            {
                                                "example_id": "90580bc9-d310-4526-9aa0-63e288e8e17e",
                                                "sense_id": "b3103b9d-8f59-3387-997a-0907c74d122b",
                                                "text": "In de ongemakkelijke stilte die er in de kamer hing, keken zij beiden met afwezige blik naar de rug van Jeroen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "afwezige",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "926f9e77-6352-3d50-b5c1-0c3ea258fbd8",
                                        "entry_id": "301e7f22-13f7-3437-81c2-b3c84237e9c8",
                                        "glosses": [
                                            "iemand die tegen de verwachting in iets niet bijwoont"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56908328-0a0d-42fa-afef-9325552781d8",
                                                "sense_id": "926f9e77-6352-3d50-b5c1-0c3ea258fbd8",
                                                "text": "Tengevolge van de griep waren er veel afwezigen."
                                            },
                                            {
                                                "example_id": "7ef763ac-a3bf-40cb-b453-563e29bcc683",
                                                "sense_id": "926f9e77-6352-3d50-b5c1-0c3ea258fbd8",
                                                "text": "We hadden onze plaatsen aan tafel ingenomen - sir Endelion en lady Menfrey, William Lister en ik, en verwachtten dat de afwezigen ieder ogenblik zouden komen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c37d4146-0804-4e9b-bcf2-23833cacdcaa",
                        "source_entry_id": "14e6b544-f6c5-3ca4-a50c-88a8e77d9a94",
                        "source_sense_description": "person who is absent",
                        "target_lang_word": "absent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a2214d1-7216-31d6-b461-90c27fefe554",
                                        "entry_id": "56272851-1e3d-3872-b184-beced163ae5a",
                                        "glosses": [
                                            "Qui n’est pas là où on l’attend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a79b84c4-f5e6-42cb-8a2c-f7826a5aa497",
                                                "sense_id": "9a2214d1-7216-31d6-b461-90c27fefe554",
                                                "text": "Notre hôte, absent au moment de notre arrivée, ne tarde pas à paraître et me fait l’accueil auquel je m’attendais de sa part."
                                            },
                                            {
                                                "example_id": "5e7f169a-7541-4724-849e-ae451ceb588b",
                                                "sense_id": "9a2214d1-7216-31d6-b461-90c27fefe554",
                                                "text": "Les négociants en ânes qui vivaient hors de chez eux à longueur de temps et étaient absents huit à neuf mois dans l’année ne pouvaient éviter d’avoir une maîtresse quelque part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e543b17-caea-3771-9675-d5f0a7efe1c5",
                                        "entry_id": "56272851-1e3d-3872-b184-beced163ae5a",
                                        "glosses": [
                                            "Qui manque ; qui fait défaut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cc64c36-dc37-4667-b12d-92055feaebf2",
                                                "sense_id": "8e543b17-caea-3771-9675-d5f0a7efe1c5",
                                                "text": "Dans les dépressions où leur puissance était grande, les prêles ont protégé les roches meubles sous-jacentes, tandis que l’érosion déblayait celles-ci là où cette couverture protectrice était absente ou moins épaisse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a04c38fa-7a81-34b6-8163-b01867caae2b",
                                        "entry_id": "56272851-1e3d-3872-b184-beced163ae5a",
                                        "glosses": [
                                            "Qui est distrait, inattentif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2e4b861-cc4a-4920-85cc-a3a6afe83c14",
                                                "sense_id": "a04c38fa-7a81-34b6-8163-b01867caae2b",
                                                "text": "Son esprit est quelquefois absent."
                                            },
                                            {
                                                "example_id": "c9e5f5d0-8133-4742-b09b-3e65eb5c5164",
                                                "sense_id": "a04c38fa-7a81-34b6-8163-b01867caae2b",
                                                "text": "Durant toute notre conversation il est resté comme absent."
                                            },
                                            {
                                                "example_id": "ed766ae1-25c3-48b7-a3c0-56072840b273",
                                                "sense_id": "a04c38fa-7a81-34b6-8163-b01867caae2b",
                                                "text": "Dans la journée, il fallait faire de grandes excursions, et répondre, sans jamais avoir l’air absent, aux attentions, aux plaisanteries aimables des gens qui nous recevaient."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "absent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b868b32-3df0-3b7c-9304-50ee8e69978a",
                                        "entry_id": "dd87f308-7ad5-3f71-8735-276b9d781fa9",
                                        "glosses": [
                                            "Personne qui n’est pas là, qui ne participe pas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa7423be-7e52-4317-93d7-fe10fa74e6f4",
                                                "sense_id": "7b868b32-3df0-3b7c-9304-50ee8e69978a",
                                                "text": "Ni Arsène André, ni Victor Mouria n'étaient à la grand’messe ; c’étaient à peu près les seuls absents et Amélie Bayet se réjouit en soi-même de n’être pas la femme d’un tel mécréant…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79de67ac-b4c5-3e54-94cd-9e4e34edcec9",
                                        "entry_id": "dd87f308-7ad5-3f71-8735-276b9d781fa9",
                                        "glosses": [
                                            "Personne non présente au jugement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68defee8-1327-48e6-88fe-e4fc8d4ffd0d",
                                                "sense_id": "79de67ac-b4c5-3e54-94cd-9e4e34edcec9",
                                                "text": "Les personnes présumées absentes."
                                            },
                                            {
                                                "example_id": "9c2ef3b1-8dfa-447b-8227-f3bc31b80233",
                                                "sense_id": "79de67ac-b4c5-3e54-94cd-9e4e34edcec9",
                                                "text": "Les biens que l’absent possédait au jour de sa disparition."
                                            },
                                            {
                                                "example_id": "866edf99-5a18-4362-94bb-44527b625b5f",
                                                "sense_id": "79de67ac-b4c5-3e54-94cd-9e4e34edcec9",
                                                "text": "Après le jugement de déclaration d'absence, toute personne qui aurait des droits à exercer contre l'absent ne pourra les exercer que contre ceux qui auront été envoyés en possession des biens, ou qui en auront l'administration légale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
