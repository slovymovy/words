        "fr-extract.jsonl": [
            {
                "entry_id": "0e60b12b-5f2e-3db2-b0da-eca8d799cc43",
                "word": "clepsydre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "45692bbc-4cb7-43ee-bd65-1f15f24ada5e",
                        "entry_id": "0e60b12b-5f2e-3db2-b0da-eca8d799cc43",
                        "tags": [
                            "plural"
                        ],
                        "form": "clepsydres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                        "entry_id": "0e60b12b-5f2e-3db2-b0da-eca8d799cc43",
                        "glosses": [
                            "Horloge qui indique la marche du temps par l’écoulement d’une certaine quantité d’eau."
                        ],
                        "tags": [
                            "Horlogerie"
                        ],
                        "examples": [
                            {
                                "example_id": "ec91ad78-a470-482a-95bd-d03dd963f4ed",
                                "sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                                "text": "Les anciens se servaient ordinairement de clepsydres pour mesurer le temps."
                            },
                            {
                                "example_id": "61c148b9-9ba0-448b-bb1c-646edcbd3e1e",
                                "sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                                "text": "Mais Daniel Soutif, directeur du développement culturel du Centre et commissaire de l’exposition, tenait au symbole : la clepsydre est l’un des plus anciens instruments de mesure du temps et elle réunit deux notions, « l’écoulement continu », celui de l’eau qu'elle contient, et sa graduation, « tentative de réduire ce flux au commensurable »."
                            },
                            {
                                "example_id": "400c5367-a443-49b7-abb0-0b8a8071de86",
                                "sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                                "text": "La clepsydre est l’un des plus anciens instruments découverts pour mesurer la durée du temps."
                            },
                            {
                                "example_id": "cbd1cbbc-10e5-4a80-a448-bb8f253715b7",
                                "sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                                "text": "En fait, avoir 40 ans, c’est vivre en permanence dans « Fort Boyard » : moi, j’ai l’impression qu’Olivier Minne ne cesse de me souffler dans l’oreille : « La clepsydre... la clepsydre... Sors ! Sors ! »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8de1f16c-504c-4e4a-a04f-af1e7c92dcea",
                        "source_entry_id": "0e60b12b-5f2e-3db2-b0da-eca8d799cc43",
                        "source_sense_id": "10357021-6a99-3179-9b44-69a92a0d7c72",
                        "target_lang_word": "Wasseruhr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasseruhr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47e2d633-337a-3f40-8c3b-cbf03ba40b08",
                                        "entry_id": "63fd4dc1-1c99-3de9-8ffb-8a0e750647eb",
                                        "glosses": [
                                            "Messinstrument für den Wasserverbrauch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61aafe4d-3408-4461-b5d2-e5f0ea695c62",
                                                "sense_id": "47e2d633-337a-3f40-8c3b-cbf03ba40b08",
                                                "text": "Heute wird die Wasseruhr abgelesen."
                                            },
                                            {
                                                "example_id": "f207bc22-a19c-464d-a178-75d9e3695d48",
                                                "sense_id": "47e2d633-337a-3f40-8c3b-cbf03ba40b08",
                                                "text": "Mit Hilfe der Wasseruhr ermittelt der Versorger den Verbrauch und kann danach eine Rechnung stellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "941f2307-a1e0-3655-b699-1c74cabb356f",
                                        "entry_id": "63fd4dc1-1c99-3de9-8ffb-8a0e750647eb",
                                        "glosses": [
                                            "Uhr, bei der der Abfluss von Wasser als Zeitmesser dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dadfd1e-2552-4561-8e84-ce2150ba773a",
                                                "sense_id": "941f2307-a1e0-3655-b699-1c74cabb356f",
                                                "text": "„Etwas später waren nur die dumpfen Töne der Wasseruhr vernehmbar.“"
                                            },
                                            {
                                                "example_id": "8e446278-eacf-472a-a87b-764a8f2b23eb",
                                                "sense_id": "941f2307-a1e0-3655-b699-1c74cabb356f",
                                                "text": "„Sie zeigte auf die neben dem Bett stehende Wasseruhr.“"
                                            },
                                            {
                                                "example_id": "2b110eff-93a9-4388-be88-f721372bf9f2",
                                                "sense_id": "941f2307-a1e0-3655-b699-1c74cabb356f",
                                                "text": "„Zur Stundenmessung dienen neben der nur nachts möglichen Sternobservation die Sonnenuhr und die Wasseruhr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00fa8b4c-8280-43e4-8be9-d41891cd22fa",
