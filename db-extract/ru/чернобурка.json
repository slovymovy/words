                                    {
                                        "sense_id": "92ca3d99-4899-3f0b-9244-abbba8f6b4de",
                                        "entry_id": "fa6e00b4-ebe1-3470-92c4-2038751970d3",
                                        "glosses": [
                                            "An attractive person who has graying hair."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b5326df-3029-4a4a-82c1-e2a9ef63602e",
                                                "sense_id": "92ca3d99-4899-3f0b-9244-abbba8f6b4de",
                                                "text": "My surprise visitor was Marcus, arriving early for the party. In tow he had a mean silver fox, a curator who was programming an encyclopedic exhibition of the anti-epoch to which Marcus and I belonged at a major museum."
                                            },
                                            {
                                                "example_id": "561d3319-e6f4-4000-b98a-4319288a3aee",
                                                "sense_id": "92ca3d99-4899-3f0b-9244-abbba8f6b4de",
                                                "text": "It’s more useful as a gender neutral term, saving the hassle of constant translation – Milf to Dilf, cougar to silver fox, mutton dressed up as lamb to beef dressed up as veal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a43280dd-da65-32a2-a6a5-88aa9fc7fe62",
                                        "entry_id": "fa6e00b4-ebe1-3470-92c4-2038751970d3",
