                "senses": [
                    {
                        "sense_id": "8762332f-c02d-3499-8bf9-e8e4f4df5049",
                        "entry_id": "608f1e57-35c4-3bb8-b5c1-5ff39814b2e3",
                        "glosses": [
                            "Zisternenanlage, die aus zwei gekoppelten Zisternen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46d4d58c-9dff-468f-bbbb-f121136854e7",
                                "sense_id": "8762332f-c02d-3499-8bf9-e8e4f4df5049",
                                "text": "„Ebenfalls aus maurischer Zeit dürfte die unterirdische Doppelzisterne Nun’s Well stammen.“"
                            },
                            {
                                "example_id": "f7c6154c-746f-4c7f-bc0e-dec498f81762",
                                "sense_id": "8762332f-c02d-3499-8bf9-e8e4f4df5049",
                                "text": "„Dieser Gang führte unter der Kastellmauer hindurch und folgte dann in gerader Linie ungefähr dem Verlauf der Umfassungsmauer, am nördlichen Eckturm vorbei und unter dem hier ebenfalls verlaufenden Abfluss des Kastellgrabens hindurch bis zur Schöpföffnung der südlichen Kammer der Doppelzisterne. Bei Angriffen oder Belagerungen konnte die Kastellbesatzung so auch weiterhin unbemerkt mit Wasser versorgt werden.“"
                            },
                            {
                                "example_id": "c34290d9-f150-4c0b-80db-be9d6bdd462a",
                                "sense_id": "8762332f-c02d-3499-8bf9-e8e4f4df5049",
                                "text": "„Das ebenfalls grosse Gebäude Pool House (Zisternenhaus), wahrscheinlich ein kombiniertes Privat- und Geschäftshaus mit einer Eingangshalle, einem Aufenthaltsraum und einem Innenhof schliesst sich an die grosse polygonale Doppelzisterne (Pool) mit seinen gemauerten Wänden und teils ins Wasser führenden Stufen an. In den beiden 700 resp. 800 m³ fassenden Becken wurde Regenwasser zur Versorgung der Stadt zurückgehalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
