                "senses": [
                    {
                        "sense_id": "a2d94c3e-1182-3c71-8a58-60be8f28dddd",
                        "entry_id": "19084a63-2b7a-3fdf-b0d3-f11cf4ab8ee8",
                        "glosses": [
                            "Wunsch, dessen Erfüllung jemandem besonders am Herzen liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f94348b4-1a63-403b-be3c-204bef5a121c",
                                "sense_id": "a2d94c3e-1182-3c71-8a58-60be8f28dddd",
                                "text": "Vielen Menschen ist vor allem die Erhaltung ihrer Gesundheit ein Herzenswunsch."
                            },
                            {
                                "example_id": "6d898d95-b2dd-4026-89f0-9a060adc2a23",
                                "sense_id": "a2d94c3e-1182-3c71-8a58-60be8f28dddd",
                                "text": "„Sie hatte es spontan als Herzenswunsch geäußert, und sie hat manch präzise Erinnerung an ihr Zuhause am Fichteplatz in Ponarth.“"
                            },
                            {
                                "example_id": "39221e6a-819d-41f3-918e-98ba2bb53357",
                                "sense_id": "a2d94c3e-1182-3c71-8a58-60be8f28dddd",
                                "text": "„Diese Sehnsucht ist verständlich, denn sie spiegelt einen echten Herzenswunsch wider.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
