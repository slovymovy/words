                        "glosses": [
                            "D’une manière pointilleuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d869b90-4f3e-4808-8390-317e854d0333",
                                "sense_id": "f23eb158-4379-31a8-a60a-9f8efec11f73",
                                "text": "Nous gardons notre rang pointilleusement, et voulons que les autres soient humbles et condescendants."
                            },
                            {
                                "example_id": "9d29dc56-2bed-4ea8-b7d6-526054c8eefd",
                                "sense_id": "f23eb158-4379-31a8-a60a-9f8efec11f73",
                                "text": "Nasser avait mis à notre disposition un avion de ligne, rempli d’officiels et de journalistes accompagnateurs se disposant à noter pointilleusement nos réactions et commentaires devant les horreurs qui étaient la raison de cette étape : les camps de réfugiés palestiniens."
                            }
                        ]
                    }
