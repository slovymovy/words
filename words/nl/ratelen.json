{
    "word_family": [
        "ratel",
        "ratelslang"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "be013f89-2e7a-332d-80b7-f1ad3d69cfe7",
                    "sense_definition": "een reeks van korte, harde, klapperende geluiden maken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude wielen van de kar <w>ratelden</w> luid over de keien in het centrum.",
                            "target_lang_translations": {
                                "fr": "Les vieilles roues de la charrette <w>grondaient</w> bruyamment sur les pavés du centre-ville."
                            }
                        },
                        {
                            "text": "De ramen <w>ratelen</w> hevig in hun kozijnen wanneer er een zware vrachtwagen voorbijrijdt.",
                            "target_lang_translations": {
                                "fr": "Les fenêtres <w>vibrent</w> fortement dans leurs châssis lorsqu'un poids lourd passe."
                            }
                        }
                    ],
                    "synonyms": [
                        "rammelen"
                    ],
                    "common_phrases": [
                        "over de keien ratelen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Produire une série de bruits secs, répétés et claquants."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "cliqueter",
                                "target_lang_sense_clarification": "bruit sec et métallique ou mécanique"
                            },
                            {
                                "target_lang_word": "gronder",
                                "target_lang_sense_clarification": "bruit lourd et vibrant comme des roues sur des pavés"
                            },
                            {
                                "target_lang_word": "trembler",
                                "target_lang_sense_clarification": "vibrer en faisant du bruit, comme des fenêtres"
                            },
                            {
                                "target_lang_word": "faire un bruit de crécelle",
                                "target_lang_sense_clarification": "sens propre de cliquetis répété"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b86353b-6b61-3fe8-9ff4-799903018947",
                    "sense_definition": "aan één stuk door en in een hoog tempo praten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het enthousiaste meisje <w>ratelde</w> maar door over haar nieuwe schoenen.",
                            "target_lang_translations": {
                                "fr": "La jeune fille enthousiaste n'arrêtait pas de <w>jacasser</w> au sujet de ses nouvelles chaussures."
                            }
                        },
                        {
                            "text": "Als hij zenuwachtig is, begint hij aan een stuk door te <w>ratelen</w>.",
                            "target_lang_translations": {
                                "fr": "Quand il est nerveux, il se met à <w>débiter des paroles sans interruption</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "maar door ratelen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Parler sans interruption et à un rythme rapide."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "débiter",
                                "target_lang_sense_clarification": "dire beaucoup de paroles à la suite à toute allure"
                            },
                            {
                                "target_lang_word": "jacasser",
                                "target_lang_sense_clarification": "parler sans cesse et rapidement"
                            },
                            {
                                "target_lang_word": "mouliner des paroles",
                                "target_lang_sense_clarification": "parler de manière ininterrompue"
                            },
                            {
                                "target_lang_word": "bavarder sans arrêt",
                                "target_lang_sense_clarification": "parler en continu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}