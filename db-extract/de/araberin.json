                "senses": [
                    {
                        "sense_id": "8c18b1cb-756c-3f9a-878c-ab00742925f1",
                        "entry_id": "f63f5b8b-e0fd-3cea-9502-eb1d1b80b3aa",
                        "glosses": [
                            "weibliches Mitglied unterschiedlicher semitischer Völker, die in Nordafrika, auf der Arabischen Halbinsel und im Nahen Osten angesiedelt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bae4c4cb-9b53-49b5-8ae8-9791b35aefa3",
                                "sense_id": "8c18b1cb-756c-3f9a-878c-ab00742925f1",
                                "text": "„Humor als Ausdruck von Wut und Trauer - dass sich in New York ausgerechnet eine Araberin, eine Palästinenserin, als erste daran wagt, auch das ist bezeichnend.“"
                            },
                            {
                                "example_id": "4a521846-0f64-46f2-9c78-e099278bbf92",
                                "sense_id": "8c18b1cb-756c-3f9a-878c-ab00742925f1",
                                "text": "Sind bei dir viele Araberinnen im Studiengang?"
                            },
                            {
                                "example_id": "89978a7f-5b52-4c14-b433-f6e91b0bd61c",
                                "sense_id": "8c18b1cb-756c-3f9a-878c-ab00742925f1",
                                "text": "„Die Strahlkraft des ägyptischen Panarabismus unter Gamal Abd al-Nasser und die Sympathie vieler Araberinnen und Araber für den Sozialismus stellten die Legitimität der Golfmonarchien zunehmend infrage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1508b05-8c82-47d1-938a-7e7bfaf49ef9",
                        "source_entry_id": "f63f5b8b-e0fd-3cea-9502-eb1d1b80b3aa",
                        "source_sense_id": "8c18b1cb-756c-3f9a-878c-ab00742925f1",
                        "source_sense_description": "weibliches Mitglied unterschiedlicher semitischer Völker",
                        "target_lang_word": "Arab",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cef02bb-3d28-3b6d-9870-9e79d9ea1e6a",
                                        "entry_id": "85cba2b5-2fe4-3c6b-bc75-c8574c65d419",
                                        "glosses": [
                                            "Of or pertaining to Arabs and their nations."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "841e42ad-2d55-42fd-bbcd-56d51d5017c7",
                                                "sense_id": "9cef02bb-3d28-3b6d-9870-9e79d9ea1e6a",
                                                "text": "The dispatches […] also exposed the blatant discrepancy between the west's professed values and actual foreign policies. Having lectured the Arab world about democracy for years, its collusion in suppressing freedom was undeniable as protesters were met by weaponry and tear gas made in the west, employed by a military trained by westerners."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Arab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af6b3d16-cb88-31de-b169-a060501038fc",
                                        "entry_id": "a1ab96d2-d9cd-3298-a805-37e305d5aa9e",
                                        "glosses": [
                                            "A Semitic person, whose forebears were from the Arabian Peninsula."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e7f8381-401b-33c9-8042-c99032f2298b",
                                        "entry_id": "a1ab96d2-d9cd-3298-a805-37e305d5aa9e",
                                        "glosses": [
                                            "An inhabitant of Arabia or the Arab world."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5ff49e9-c419-4d7f-a447-f1180d382642",
                                                "sense_id": "8e7f8381-401b-33c9-8042-c99032f2298b",
                                                "text": "This backlash also fails to take into account that Israel, for all its faults, is a multicultural society where almost half of graduating doctors today are Arabs or Druze."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3aed530-a584-3121-8ab3-77e543e164da",
                                        "entry_id": "a1ab96d2-d9cd-3298-a805-37e305d5aa9e",
                                        "glosses": [
                                            "A member of an Arabic-speaking community."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7611a7f-e749-3742-bad7-2787a72f5af8",
                                        "entry_id": "a1ab96d2-d9cd-3298-a805-37e305d5aa9e",
                                        "glosses": [
                                            "An Arabian horse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51e3a8c2-cb6c-43f4-af5b-c7f4a8bd6576",
                                                "sense_id": "a7611a7f-e749-3742-bad7-2787a72f5af8",
                                                "text": "Having taken a very early breakfast, I mounted about eight o'clock my grey Arab, and without anything occurring worthy of note, killed the first three boars in the space of an hour, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a9865ae-0641-345e-addb-8ad087e6ce3a",
                                        "entry_id": "a1ab96d2-d9cd-3298-a805-37e305d5aa9e",
                                        "glosses": [
                                            "A street Arab."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5d2522a-5183-4606-b582-c856b51980b7",
                                                "sense_id": "8a9865ae-0641-345e-addb-8ad087e6ce3a",
                                                "text": "a. 1892, Charles Spurgeon, a sermon\nYou Christian people often see the little gutter children — the poor little arabs in the street — and you feel much pity for them, as well you may."
                                            },
                                            {
                                                "example_id": "07de82a1-59fd-4ebe-9e75-35cc04a40e96",
                                                "sense_id": "8a9865ae-0641-345e-addb-8ad087e6ce3a",
                                                "text": "The other day I heard you complaining of the nuisance that small ragged street-boys are to you whenever you go out. […] You wished that some one would do something to clear away these little Arabs, as you are pleased to call them, so that a fine old English gentleman—as you are pleased to think yourself—might take his exercise in peace."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Arab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6f3fe5b-69a1-317e-bab9-2b6e34feab5f",
                                        "entry_id": "c431023b-5bd5-3cf2-8d69-b076c3f617ee",
                                        "glosses": [
                                            "A city in Marshall County, Alabama, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
