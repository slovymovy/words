                "senses": [
                    {
                        "sense_id": "46075b21-3672-3ac9-a908-e9a2e472c810",
                        "entry_id": "e2aeef10-4f5a-3311-a8cc-0e4598f9cad4",
                        "glosses": [
                            "joghurtähnliches, durch Fermentierung hergestelltes Nahrungsmittel aus Sojamilch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46d67626-8781-427e-8b32-0aefafcbcbba",
                                "sense_id": "46075b21-3672-3ac9-a908-e9a2e472c810",
                                "text": "„Sojaghurt wird wie ‚normaler‘ Joghurt mit Bakterienkulturen produziert und ist in zahlreichen Geschmacksrichtungen erhältlich.“"
                            },
                            {
                                "example_id": "104f87cb-568b-4e8d-9d4a-c036665c89cf",
                                "sense_id": "46075b21-3672-3ac9-a908-e9a2e472c810",
                                "text": "„Für Aufstriche, Dips, Saucen und Desserts, ist Sojaghurt ideal.“"
                            },
                            {
                                "example_id": "bf26b4b6-91d7-4f3a-a280-76973c489a55",
                                "sense_id": "46075b21-3672-3ac9-a908-e9a2e472c810",
                                "text": "„Zuerst verrührt ihr den Sojaghurt und den Quark mit den Chiasamen und dem Agavendicksaft und lasst alles ein wenig stocken.“"
                            },
                            {
                                "example_id": "0d110cc7-81e2-4c64-92bf-6cf44ed64c53",
                                "sense_id": "46075b21-3672-3ac9-a908-e9a2e472c810",
                                "text": "„Sojamilch und Sojaghurt sollten nicht länger als 24 Stunden geöffnet sein und das Obst keine Druckstellen aufweisen.“"
                            },
                            {
                                "example_id": "e7a63e25-3348-4576-8041-06f0ff726618",
                                "sense_id": "46075b21-3672-3ac9-a908-e9a2e472c810",
                                "text": "„Das dunkle Kakaopulver, die Süße der Banane und die Frische des Sojaghurts geben euch wieder neuen Schwung, Energie und ganz sicher auch ein paar Glückshormone mit auf den Weg.“"
                            },
                            {
                                "example_id": "80504ca4-30bb-4f9c-9fdf-8d2f9383806b",
                                "sense_id": "46075b21-3672-3ac9-a908-e9a2e472c810",
                                "text": "„Dabei handelt es sich zum einen um Hafer-, Kokos-Reis- und Mandeldrinks, weiterhin um vegane Kaffeegetränke auf Mandel- und Haferbasis sowie Sojaghurts in Natur und Fruchtvarianten.“"
                            },
                            {
                                "example_id": "5ecb4958-7482-46ee-93a8-5dec511df7c5",
                                "sense_id": "46075b21-3672-3ac9-a908-e9a2e472c810",
                                "text": "„Das Sojaghurt hat dann eine festere Konsistenz. “"
                            },
                            {
                                "example_id": "467237f9-0d3a-42bf-874b-cbe72f8e4141",
                                "sense_id": "46075b21-3672-3ac9-a908-e9a2e472c810",
                                "text": "„Doch mit dem anhaltenden VeganTrend [sic] haben die sogenannten Sojaghurts die Supermärkte erobert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
