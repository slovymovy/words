                "senses": [
                    {
                        "sense_id": "147c32ff-46c5-36a2-b702-c87f263156cf",
                        "entry_id": "6ad2c07e-07a1-3624-8243-761556b4c752",
                        "glosses": [
                            "nachweislich qualifizierte, fachkompetente oder beauftragte weibliche Person, die themenspezifisch und vertrauensvoll Rat suchende Personen berät"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d7036fa-4887-41b0-813d-2e81a42614bf",
                                "sense_id": "147c32ff-46c5-36a2-b702-c87f263156cf",
                                "text": "Hannah ist Spezialistin auf ihrem Fachgebiet und meine persönlicher Beraterin wenn es um die Rosen im Garten geht."
                            },
                            {
                                "example_id": "f38e7b4a-63a9-4f02-9eda-ddaeb1121829",
                                "sense_id": "147c32ff-46c5-36a2-b702-c87f263156cf",
                                "text": "Für eine externe Firmenberaterin muss es im Interesse der zu beratenden Unternehmerin so sein, dass vertrauliche Informationen zum Unternehmen nicht durch die Beraterin anderweitig verwertet werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
