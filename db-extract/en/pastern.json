                ],
                "senses": [
                    {
                        "sense_id": "1a0ce050-1b03-3770-9d70-8a30caef4896",
                        "entry_id": "d2279a85-d43b-320f-9d47-aebafdf317aa",
                        "glosses": [
                            "The part of a horse's leg between the fetlock joint and the hoof."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c44a9eb-4764-49a8-80d5-18d46c2de819",
                                "sense_id": "1a0ce050-1b03-3770-9d70-8a30caef4896",
                                "text": "It was quite impossible to ride over the deeply-ploughed field; the earth bore only where there was still a little ice, in the thawed furrows the horse's legs sank in above its pasterns."
                            },
                            {
                                "example_id": "d5df2287-2094-42b4-ab83-ea037571ca81",
                                "sense_id": "1a0ce050-1b03-3770-9d70-8a30caef4896",
                                "text": "Below me, somewhere in the horse-lines, stood Cockbird, picketed to a peg in the ground by a rope which was already giving him a sore pastern."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c59abee-cd3e-3bce-b356-5a83a6875402",
                        "entry_id": "d2279a85-d43b-320f-9d47-aebafdf317aa",
                        "glosses": [
                            "A shackle for horses while pasturing."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "14de5b46-1717-325a-b49b-9987c6dc6a4b",
                        "entry_id": "d2279a85-d43b-320f-9d47-aebafdf317aa",
                        "glosses": [
                            "A patten."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "527729b3-7869-4ea4-a05b-29497774600b",
                                "sense_id": "14de5b46-1717-325a-b49b-9987c6dc6a4b",
                                "text": "Upright he walks, on pasterns firm and straight;\nHis motions easy; prancing in his gait\nSo straight she walk'd, and on her pasterns high."
                            }
                        ]
                    }
                ],
