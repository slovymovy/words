                ],
                "senses": [
                    {
                        "sense_id": "9a926a83-249a-37e0-8108-eff5e78750aa",
                        "entry_id": "63c11991-bca7-313f-9015-f1ed4d7b99aa",
                        "glosses": [
                            "Synonym of man in the moon (“face perceived in the moon, or the character imagined for it”)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30605235-88c8-4228-a107-6af1623bb67d",
                                "sense_id": "9a926a83-249a-37e0-8108-eff5e78750aa",
                                "text": "Towser lifts his nose and howls / Toward the moonman, far and dim; / But the moonman only scowls, / For no dog can frighten him."
                            },
                            {
                                "example_id": "9b98db57-ab4d-45c7-a762-ab77a7de8fe9",
                                "sense_id": "9a926a83-249a-37e0-8108-eff5e78750aa",
                                "text": "I sat within a cedar grove alone / And watched the moonman walk across the hill"
                            }
                        ]
                    },
                    {
                        "sense_id": "5d4987fa-d22e-3f53-b2ea-7c1ee02f238a",
                        "entry_id": "63c11991-bca7-313f-9015-f1ed4d7b99aa",
                        "glosses": [
                            "Synonym of Lunarian (“inhabitant of the Moon”)."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4771829d-4e82-4bd4-a0be-582791b953cb",
                                "sense_id": "5d4987fa-d22e-3f53-b2ea-7c1ee02f238a",
                                "text": "In this manner did I discourse with the Moonmen while taking my repast; after which they told me, if I had no objection, that they intended taking me to Moontown, to introduce me to their king […]"
                            },
                            {
                                "example_id": "bafdf7e2-7968-4419-b0d2-5a937ab49d68",
                                "sense_id": "5d4987fa-d22e-3f53-b2ea-7c1ee02f238a",
                                "text": "On the floor the Moonman's body shivered again."
                            },
                            {
                                "example_id": "f7eaec38-3cea-4ddb-92e0-55086c845691",
                                "sense_id": "5d4987fa-d22e-3f53-b2ea-7c1ee02f238a",
                                "text": "As the first moonmen worked to set up their rudimentary base, supply ships would have to be sent periodically with additional provisions for more permanent materials for the eventual large lunar base. Meanwhile, the moonmen would continue to live in their pressurized domes. As supplies accumulated, construction of the permanent base would begin."
                            }
                        ]
                    }
