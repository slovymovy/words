        "nl-extract.jsonl": [
            {
                "entry_id": "d01f431b-fe30-352f-a3e5-6d7630d29178",
                "word": "shitzooi",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "523794b6-02b2-3901-b674-182aff148f36",
                        "entry_id": "d01f431b-fe30-352f-a3e5-6d7630d29178",
                        "glosses": [
                            "ellendige toestand"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "eed91a9c-b5a8-4e7f-9160-60b2fed347be",
                                "sense_id": "523794b6-02b2-3901-b674-182aff148f36",
                                "text": "We hebben nu al drie wedstrijden op rij verloren. Wat een shitzooi."
                            },
                            {
                                "example_id": "75f01033-831c-4950-a40d-0ba998d7c387",
                                "sense_id": "523794b6-02b2-3901-b674-182aff148f36",
                                "text": "„Mijn vader ligt in het ziekenhuis… Mijn broertje komt me zo halen”, zeg ik verbluft en daarna voel ik dat de tranen naar boven komen. Shitzooi…"
                            }
                        ]
                    },
                    {
                        "sense_id": "5716c3a8-f4d7-3b76-b50a-b5b8beab69b8",
                        "entry_id": "d01f431b-fe30-352f-a3e5-6d7630d29178",
                        "glosses": [
                            "waardeloze entiteit"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "9a44c7f7-a74b-4d36-aac9-eba3ff091f2a",
                                "sense_id": "5716c3a8-f4d7-3b76-b50a-b5b8beab69b8",
                                "text": "Deze shitzooi breng ik terug naar de winkel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4e467d1-1016-4cf8-b88a-e9f034450542",
                        "source_entry_id": "d01f431b-fe30-352f-a3e5-6d7630d29178",
                        "source_sense_id": "523794b6-02b2-3901-b674-182aff148f36",
                        "source_sense_description": "ellendige toestand",
                        "target_lang_word": "pile of shit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pile of shit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f29a412-58b2-3bb7-ab6a-67414a51811a",
                                        "entry_id": "c6fc6408-36d1-3b4f-ab8b-66660a804581",
                                        "glosses": [
                                            "Something that is not true, a mass of lies."
                                        ],
                                        "tags": [
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3def961f-c5c0-45f8-b88d-a7cd1c5897fa",
                                                "sense_id": "1f29a412-58b2-3bb7-ab6a-67414a51811a",
                                                "text": "They said it's all a vast conspiracy? What a pile of shit!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d23b6dc-9aa7-3573-9906-e6b5305df2d8",
                                        "entry_id": "c6fc6408-36d1-3b4f-ab8b-66660a804581",
                                        "glosses": [
                                            "Any worthless structure or device."
                                        ],
                                        "tags": [
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e59f2197-d554-4761-9fa3-cd6df79de0a5",
                                                "sense_id": "6d23b6dc-9aa7-3573-9906-e6b5305df2d8",
                                                "text": "Take this pile of shit back where you bought it and get your money back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7065b13a-32a8-3602-9ace-bf242c1eb5bf",
                                        "entry_id": "c6fc6408-36d1-3b4f-ab8b-66660a804581",
                                        "glosses": [
                                            "A totally worthless person."
                                        ],
                                        "tags": [
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "879299b5-407b-46b5-82bd-62f1344b5cad",
                                                "sense_id": "7065b13a-32a8-3602-9ace-bf242c1eb5bf",
                                                "text": "We know he claims it's legit, but we also know he's a pile of shit, so we'll proceed with caution."
                                            },
                                            {
                                                "example_id": "e32098dd-94cd-4471-ba02-1ad44bea47f1",
                                                "sense_id": "7065b13a-32a8-3602-9ace-bf242c1eb5bf",
                                                "text": "Guard: \"And I'll tell you another thing. I've got a wife and three kids. And you're all a pile of shit.\" Prisoner: \"I've got a wife and three kids.\" Guard: \"You've what?\""
                                            },
                                            {
                                                "example_id": "03ae0a9b-f9f2-4dde-adb3-98a6eae96e92",
                                                "sense_id": "7065b13a-32a8-3602-9ace-bf242c1eb5bf",
                                                "text": "How did he think he could attract a woman when his house was a pile of shit. Hell, he was a pile of shit."
                                            },
                                            {
                                                "example_id": "51de02de-4d97-4a33-a5c1-527325f2b743",
                                                "sense_id": "7065b13a-32a8-3602-9ace-bf242c1eb5bf",
                                                "text": "I told the civvie no, that I was a member of the Xeno Corps, and flashed my badge to prove it. That was when he asked if I could 'sense' what he was feeling, and I said no, because it's impossible to know how a pile of shit feels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82f61afc-adcc-4169-8951-3ee5f466db70",
                        "source_entry_id": "d01f431b-fe30-352f-a3e5-6d7630d29178",
