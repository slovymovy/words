                                        "entry_id": "34974be6-59ef-364c-924a-55ca4fd011fb",
                                        "glosses": [
                                            "ein rundes oder ovales Haushaltsgefäß aus Holz, Ton oder Metall"
                                        ],
                                        "tags": [
                                            "Erzgebirgisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d9b6156-265d-4ad4-a87f-70a5cd581cb1",
                                                "sense_id": "6d0c1a28-919a-374e-86d7-078ecd46098d",
                                                "text": "obersächsisch: Frieher ham mer de Milsch glei in Asch gegossen ohne se abzekochen.",
                                                "translation": "Früher haben wir die Milch gleich in den Asch gegossen ohne sie abzukochen."
                                            },
                                            {
                                                "example_id": "b6319468-97b6-49c1-8be1-c5df17d2989e",
                                                "sense_id": "6d0c1a28-919a-374e-86d7-078ecd46098d",
                                                "text": "erzgebirgisch: Nuch fuur ä poor goorn hom viele leit de Wäsch in än grußn Asch gewaschen.",
                                                "translation": "Noch vor ein paar Jahren haben viele Leute die Wäsche in einem großen Asch gewaschen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "41a7ee33-08d8-3d1c-b5ad-fbabd354a043",
                                        "entry_id": "34974be6-59ef-364c-924a-55ca4fd011fb",
                                        "glosses": [
                                            "ein Schiff oder Boot, vor allem zum Transport von Salz auf den Flüssen Salzach, Inn und Donau verwendet"
                                        ],
                                        "tags": [
                                            "Bavarian"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b736ec8-9b1c-4491-a359-1d0bd51b8b7a",
                                                "sense_id": "41a7ee33-08d8-3d1c-b5ad-fbabd354a043",
                                                "text": "„Ein Asch ist ein Schiff oder Boot, wie sie nach Schmeller besonders auf Salzach, Inn und Donau verwendet wurden, vor allem zum Transport von Salz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Asch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c05a70e5-f689-3004-93c3-846a84de193d",
                                        "entry_id": "710b882f-41f0-3174-83f8-3fc2ec605920",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23489f5f-4963-4e25-9371-06b5077cc853",
                                                "sense_id": "c05a70e5-f689-3004-93c3-846a84de193d",
                                                "text": "Herr Asch hat in seinem Leben noch nie eine Zigarette geraucht."
                                            },
                                            {
                                                "example_id": "8d1b03b7-ca10-485d-9f7d-262fb8a3f1ca",
                                                "sense_id": "c05a70e5-f689-3004-93c3-846a84de193d",
                                                "text": "Frau Asch ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "5ee2d6e0-9de7-48e9-b314-b4a2a8f565a4",
                                                "sense_id": "c05a70e5-f689-3004-93c3-846a84de193d",
                                                "text": "Herr Asch wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "320cf8f5-9b21-42d1-89d6-caf8ee1947b4",
                                                "sense_id": "c05a70e5-f689-3004-93c3-846a84de193d",
                                                "text": "Die Aschs fliegen heute nach Liverpool."
                                            },
                                            {
                                                "example_id": "868b7880-35e2-4fa9-b1bf-f10fbb87adf5",
                                                "sense_id": "c05a70e5-f689-3004-93c3-846a84de193d",
                                                "text": "Der Asch trägt nie die Pullover, die die Asch ihm strickt."
                                            },
                                            {
                                                "example_id": "f20c5ce2-5714-4675-8b80-edc6dfb81233",
                                                "sense_id": "c05a70e5-f689-3004-93c3-846a84de193d",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Asch kommt, geht der Herr Asch.“"
                                            },
                                            {
                                                "example_id": "a8b59012-0929-4ebc-8938-3bbbd7d56915",
                                                "sense_id": "c05a70e5-f689-3004-93c3-846a84de193d",
                                                "text": "Asch kommt und geht."
                                            },
                                            {
                                                "example_id": "2bda0b68-e0c6-4173-8377-6e25b656c14f",
                                                "sense_id": "c05a70e5-f689-3004-93c3-846a84de193d",
                                                "text": "Aschs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
