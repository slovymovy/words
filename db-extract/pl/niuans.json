                    },
                    {
                        "translation_id": "8eea221f-a775-401e-96ba-6087034028f2",
                        "source_entry_id": "dbdccdac-2ac7-3134-ab6a-f3cc389c2f86",
                        "source_sense_id": "e9035b27-068e-33d1-82d2-e4f4ec7bbebf",
                        "target_lang_word": "Nuance",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nuance",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9af1155-eb8a-3e1c-99e3-2783bad42c56",
                                        "entry_id": "19859039-7861-34d4-bc54-024f2e5211de",
                                        "glosses": [
                                            "feinster, kaum bemerkbarer Unterschied innerhalb eines Kontinuums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bc6a362-cc7b-4f7c-adef-5e871efe9bc3",
                                                "sense_id": "a9af1155-eb8a-3e1c-99e3-2783bad42c56",
                                                "text": "Ihr Kleid schillerte in verschiedenen Nuancen der Farbe Rot."
                                            },
                                            {
                                                "example_id": "9f66edf4-7758-44cc-bcff-1ea6da843192",
                                                "sense_id": "a9af1155-eb8a-3e1c-99e3-2783bad42c56",
                                                "text": "Das Licht dürfte noch eine Nuance heller sein."
                                            },
                                            {
                                                "example_id": "132ae331-f273-4f82-90c8-e71d6535cab8",
                                                "sense_id": "a9af1155-eb8a-3e1c-99e3-2783bad42c56",
                                                "text": "Wenn du seinen Vorträgen zuhörst, musst du mal genau auf die Nuancen achten."
                                            },
                                            {
                                                "example_id": "f6a67f5f-a2d0-4eca-a2b4-e3f0ac7d0798",
                                                "sense_id": "a9af1155-eb8a-3e1c-99e3-2783bad42c56",
                                                "text": "„Pierre wurde von Anna Pawlowna mit einer leichten Nuance von Betrübtheit empfangen, die sich offensichtlich auf den Verlust bezog, den der junge Mann unlängst erlitten hatte, auf den Tod des Grafen Besuchow – überhaupt fühlten alle sich verpflichtet, Pierre unaufhörlich zu versichern, dass er über das Ableben seines Vaters, den er doch kaum gekannt hatte, sehr betrübt sei.“"
                                            },
                                            {
                                                "example_id": "14575b1b-daee-40a5-94bc-958a97fc4586",
                                                "sense_id": "a9af1155-eb8a-3e1c-99e3-2783bad42c56",
                                                "text": "„Oft kommt es auf hauchzarte Nuancen der Ingredienzien an, oft sind die Ingredienzien halb so fein wie ihr Aroma.“"
                                            },
                                            {
                                                "example_id": "b50f0360-25b5-4677-a30f-01ede9a23c2d",
                                                "sense_id": "a9af1155-eb8a-3e1c-99e3-2783bad42c56",
                                                "text": "„Da nahmen sie die Komödie, die Schule der feinen Nuancen, vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
