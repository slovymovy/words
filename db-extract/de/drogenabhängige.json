                ],
                "senses": [
                    {
                        "sense_id": "7f52c07a-e91a-3ba4-8938-afbb280f5173",
                        "entry_id": "0f2f8fef-f6bb-3928-a3fa-916905995a98",
                        "glosses": [
                            "weibliche Person, die abhängig von Drogen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f7a97d-f98d-4c69-a3d4-cd0c19bf1bbc",
                                "sense_id": "7f52c07a-e91a-3ba4-8938-afbb280f5173",
                                "text": "„Sie…sie ist eine Drogenabhängige und in einer geschlossenen Entzugsklinik.“"
                            },
                            {
                                "example_id": "acff1e4b-c88b-4e10-b36e-7d50401a9fe4",
                                "sense_id": "7f52c07a-e91a-3ba4-8938-afbb280f5173",
                                "text": "„Würde sie in diesem Leid wiedermals auf den männlichen Seelenpartner zugehen, wäre das, als sei sie eine Drogenabhängige, welche ihren Schmerz durch weitere Drogen zu stillen versuche.“"
                            },
                            {
                                "example_id": "0d9734ba-b5d6-4057-bc9a-af94a0f6694f",
                                "sense_id": "7f52c07a-e91a-3ba4-8938-afbb280f5173",
                                "text": "„Auf dem Bahnhof eine junge Frau, zotteliges Haar, das Gesicht mit roter Farbe verschmiert, eine Drogenabhängige vermutlich, sie läuft, mit brüchiger Stimme singend, einen großen Stoffbären im Arm, die Hand aufhaltend durch die Menge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
