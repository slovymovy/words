                        "sense_id": "9c5ed805-5be6-388a-9a16-f0aba70d57f1",
                        "entry_id": "70a4df5a-ca63-3dab-838b-fede38324b0f",
                        "glosses": [
                            "The female reproductive structure of an ascomycete."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cb2f858-3e3e-405e-a6a4-dc69e536bd29",
                                "sense_id": "9c5ed805-5be6-388a-9a16-f0aba70d57f1",
                                "text": "The archicarp is bounded at the top by the trichogyne and at the base by a foot cell."
                            },
                            {
                                "example_id": "6924e5de-7a93-4c08-8f22-6823fd976d2f",
                                "sense_id": "9c5ed805-5be6-388a-9a16-f0aba70d57f1",
                                "text": "In Chaetomium spirale the cells of the mycelium contain each a single nucleus, the archicarp arises as a coiled branch and divides into four or more uninucleate cells."
                            },
                            {
                                "example_id": "818d1838-4521-4528-b8dd-19720e8c87a0",
                                "sense_id": "9c5ed805-5be6-388a-9a16-f0aba70d57f1",
                                "text": "The other branch (antheridium) grows up in close contact with the archicarp, and like it is shut off by a partition from its filament."
                            }
                        ]
                    }
                ],
