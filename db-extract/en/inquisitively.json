                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nieuwsgierig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "372feb63-7512-3591-9d7b-08d6aacd9599",
                                        "entry_id": "e96aaea4-dee4-3474-82fc-f67e336a2e5f",
                                        "glosses": [
                                            "verlangend om iets te weten of waar te nemen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe0b13d9-1872-44f8-933a-4f2f0877c657",
                                                "sense_id": "372feb63-7512-3591-9d7b-08d6aacd9599",
                                                "text": "Wat ben jij toch een nieuwsgierig mannetje..."
                                            },
                                            {
                                                "example_id": "f1ce501f-caba-46e5-a71a-71591ab2f858",
                                                "sense_id": "372feb63-7512-3591-9d7b-08d6aacd9599",
                                                "text": "Misschien zou ik er wel in durven maar wij Palettanen hebben niet zulk zwerversbloed. En wij zijn niet nieuwsgierig naar dingen die wij niet begrijpen. Bovendien, het schijnt in de Vallei der Dwaasheid niet pluis te zijn. Waarom zouden wij het onszelf moeilijk maken? Wij hebben hier altijd geleefd, wij hebben geen behoefte aan avonturen die niets dan narigheid opleveren.'"
                                            },
                                            {
                                                "example_id": "6c0b42b5-f590-4684-9287-25a5b213294d",
                                                "sense_id": "372feb63-7512-3591-9d7b-08d6aacd9599",
                                                "text": "Maar ze was oprecht nieuwsgierig - naar het weer en wat vochtigheid en hitte met boeken deden, met kleren, naar het eten dat mijn moeder klaarmaakte, de muziek waar we naar luisterden, de mensen die ik daar kende."
                                            },
                                            {
                                                "example_id": "d7ce16e3-c5c6-4a20-9370-eede1b865f13",
                                                "sense_id": "372feb63-7512-3591-9d7b-08d6aacd9599",
                                                "text": "Toen wist ik al dat hij nieuwsgierig was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
