                                "target_senses": [
                                    {
                                        "sense_id": "72ee08e7-1a75-344a-92c2-77f53197d8c9",
                                        "entry_id": "4b587b12-f3a6-3dae-aa0d-21d75097a6cb",
                                        "glosses": [
                                            "Deuxième ville d'Arabie saoudite et grand centre de commerce, située sur les bords de la mer Rouge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a08170d-54f2-4b1a-9048-efdd95d71ad6",
                                                "sense_id": "72ee08e7-1a75-344a-92c2-77f53197d8c9",
                                                "text": "Karim Benzema s’est engagé, mardi, pour trois saisons avec Al-Ittihad, un club de la ville de Djeddah, en Arabie saoudite, où il devrait toucher 100 millions d’euros par an."
                                            },
                                            {
                                                "example_id": "d6dfb69d-8d74-4fb8-a894-2dbef428804e",
                                                "sense_id": "72ee08e7-1a75-344a-92c2-77f53197d8c9",
                                                "text": "On peut désormais obtenir un e-visa en moins de 24h, et s’y rendre facilement grâce aux vols directs Paris-Riyad, Paris-Djeddah ou Marseille-Djeddah."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90027430-06fd-47f3-9b7d-4a77a5d1aa43",
                        "source_entry_id": "3221c819-63f7-3d1a-a6e5-c7f6ed7d40bc",
