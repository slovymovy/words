                    {
                        "sense_id": "75b3a8b1-f091-3bbd-a6f0-0ce2b22edc79",
                        "entry_id": "26954444-5d35-3450-8116-649977390c5c",
                        "glosses": [
                            "organische Säure, die oft in Harzen vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "347911ce-de9e-4c07-8692-1c6ff897eb78",
                                "sense_id": "75b3a8b1-f091-3bbd-a6f0-0ce2b22edc79",
                                "text": "Pyropimarinsäure entsteht nach LAURENT durch Destillation der Pimarinsäure im luftleeren Raum, und ist der einzige dabei auftretende Körper."
                            },
                            {
                                "example_id": "6a6ae476-7c66-4b34-a00c-5060de719e3d",
                                "sense_id": "75b3a8b1-f091-3bbd-a6f0-0ce2b22edc79",
                                "text": "Die von Laurent im Harze von Pinus maritima entdeckte Pimarinsäure welche eine ähnliche Zusammensetzung hat, wie die Sylvinsäure, scheint durch ihre weit leichtere Krystallisirbarkeit aus der alkoholischen Auflösung der Veränderung mehr als die Sylvinsäure zu widerstehen, und in dieser Hinsicht dem krystallisirten Harze aus dem Copaivabalsam zu gleichen."
                            },
                            {
                                "example_id": "9b01ab0d-c0a9-44d3-9427-279873d189c6",
                                "sense_id": "75b3a8b1-f091-3bbd-a6f0-0ce2b22edc79",
                                "text": "Bekanntlich sind es die wirksamen Bestandteile im Kolophonium, die Abietinsäure und die Pimarinsäure, die eine Lötung ermöglichen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
