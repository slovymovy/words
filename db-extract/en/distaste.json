                        "tags": [
                            "obsolete",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5df3a3af-d070-4b34-9adc-f1fa041488ff",
                                "sense_id": "4d49dc3c-4aa1-3c19-83fc-f1bbb2972736",
                                "text": "Prosperity is not without many fears and distastes; and adversity is not without comforts and hopes"
                            }
                        ]
                    },
                    {
                        "sense_id": "6a27ea48-e937-3a53-a460-62d431c0c1a4",
                        "entry_id": "1d3f177c-6232-3179-bdd5-9a6d712fd1a2",
                        "glosses": [
                            "Discomfort; uneasiness."
