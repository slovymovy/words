                "forms": [],
                "senses": [
                    {
                        "sense_id": "ce79c961-3f98-3461-a6c9-3571987fb0e8",
                        "entry_id": "410f4cb8-dd92-3835-96ce-fee4e248aece",
                        "glosses": [
                            "выражает просьбу подождать"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0336d539-81a5-3bc4-9f65-2db1bbc94dd0",
                        "entry_id": "410f4cb8-dd92-3835-96ce-fee4e248aece",
                        "glosses": [
                            "употребляется для выражения удивления, несогласия, а также при припоминании чего-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b848b794-75bb-4a34-ac74-ebd65409aec1",
                        "source_entry_id": "410f4cb8-dd92-3835-96ce-fee4e248aece",
                        "source_sense_description": "просьба подождать",
                        "target_lang_word": "wait a minute",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wait a minute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52560c76-a641-3428-a827-4fb8ecde0d42",
                                        "entry_id": "452185a4-8657-34c7-8c50-004b3bc48f04",
                                        "glosses": [
                                            "Used to indicate a new insight or dawning understanding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d895e7ee-940c-45eb-b9e0-9edce40cb900",
                                                "sense_id": "52560c76-a641-3428-a827-4fb8ecde0d42",
                                                "text": "BEN: (Suddenly remembers.) Wait a minute, Huckleberry Finn don't have no family."
                                            },
                                            {
                                                "example_id": "d89dc77b-29f9-496d-8e12-4b47a191fb99",
                                                "sense_id": "52560c76-a641-3428-a827-4fb8ecde0d42",
                                                "text": "Reader E questioned the plausibility of laundry hanging on a clothesline at night, and Reader C's forward momentum was stalled as he commented, “Wait a minute, wait a minute, wait a minute! She has a different basket...\""
                                            },
                                            {
                                                "example_id": "c3903706-1076-44f8-a113-2f29c3115a1f",
                                                "sense_id": "52560c76-a641-3428-a827-4fb8ecde0d42",
                                                "text": "Wait a minute. Was it in the cemetery?"
                                            },
                                            {
                                                "example_id": "6b2fcaeb-aa3c-4bad-8509-53789ce301a2",
                                                "sense_id": "52560c76-a641-3428-a827-4fb8ecde0d42",
                                                "text": "West ruffs the third diamond and the defenders cash their two clubs for down one. \"Wait a minute,\" you exclaim confidently. \"I know what to do. I have to draw trumps earlier!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "994e57f7-4dd2-3aec-890d-d13526628951",
                                        "entry_id": "452185a4-8657-34c7-8c50-004b3bc48f04",
                                        "glosses": [
                                            "Used to indicate disagreement or doubt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58201188-9fa4-4b65-a5db-4e61e026b05b",
                                                "sense_id": "994e57f7-4dd2-3aec-890d-d13526628951",
                                                "text": "“Wait a minute, wait a minute, wait ... a ... minute,” said Fred. “I don't mind a little cologne, but I am not going to put on eye shadow."
                                            },
                                            {
                                                "example_id": "77820411-5d5b-4df8-81b5-52b9807a4f10",
                                                "sense_id": "994e57f7-4dd2-3aec-890d-d13526628951",
                                                "text": "“Wait a minute. I'm not picking her apart. I'm just trying to be helpful. She needs a little guidance, that's all.”"
                                            },
                                            {
                                                "example_id": "89078bdb-e497-4539-b6fd-a0fc0909a897",
                                                "sense_id": "994e57f7-4dd2-3aec-890d-d13526628951",
                                                "text": "“Wait a minute, I don't know if I want to do this or not. You're talking about losing ten dollars; I could lose my life.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wait a minute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "feb3a970-74c3-30fd-99d1-24b3bd6a83d1",
                                        "entry_id": "4e51b646-dea0-359d-891f-c457fd857d23",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see wait, minute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c71e85d-759d-4d1e-9286-7104f388bd8c",
                                                "sense_id": "feb3a970-74c3-30fd-99d1-24b3bd6a83d1",
                                                "text": "They would not think twice about asking you to wait a minute while they take another picture, or ask another question of the guide."
                                            },
                                            {
                                                "example_id": "dd4cd340-3e2c-465f-b33b-708c4a59916e",
                                                "sense_id": "feb3a970-74c3-30fd-99d1-24b3bd6a83d1",
                                                "text": "I wait a minute—then I get an idea."
                                            },
                                            {
                                                "example_id": "e6cee8a8-42a5-4fe6-9943-c89637cc6a1e",
                                                "sense_id": "feb3a970-74c3-30fd-99d1-24b3bd6a83d1",
                                                "text": "You just wait a minute. Let them talk before you say anything."
                                            },
                                            {
                                                "example_id": "d9af7aa1-3fcd-4871-83be-5bac9c32db09",
                                                "sense_id": "feb3a970-74c3-30fd-99d1-24b3bd6a83d1",
                                                "text": "He asked my mom, “Ellen are you ready yet?” She said, “Wait a minute and I will be.”"
                                            },
                                            {
                                                "example_id": "8e3a3224-823b-4bb0-a734-284faa68005f",
                                                "sense_id": "feb3a970-74c3-30fd-99d1-24b3bd6a83d1",
                                                "text": "Laughing, he said, “That dress is in the closet too, she should show it to you. Wait a minute, son, I'll be right back.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
