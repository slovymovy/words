                                "sense_id": "ee2917ab-275d-3fca-97a5-c72f42c33ab3",
                                "text": "De rechten van minderjarige kinderen worden beschermd door specifieke wetten.",
                                "translation": "The rights of minor children are protected by specific laws.",
                                "english": "The rights of minor children are protected by specific laws."
                            },
                            {
                                "example_id": "4848dc27-71ce-4186-b8a5-e7d2afaedaad",
                                "sense_id": "ee2917ab-275d-3fca-97a5-c72f42c33ab3",
                                "text": "Kinderen onder de 18 jaar worden beschouwd als minderjarig volgens de wet.",
                                "translation": "Children under the age of 18 are considered underage according to the law.",
                                "english": "Children under the age of 18 are considered underage according to the law."
                            },
                            {
                                "example_id": "88f280de-e81e-487a-8ce5-0c99bcb4e4db",
                                "sense_id": "ee2917ab-275d-3fca-97a5-c72f42c33ab3",
                                "text": "De verdachte is nog minderjarig en zal voor de jeugdrechter verschijnen.",
                                "translation": "The suspect is still juvenile and will appear before the juvenile judge.",
                                "english": "The suspect is still juvenile and will appear before the juvenile judge."
                            }
                        ]
                    }
