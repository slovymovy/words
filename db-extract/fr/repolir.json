                ],
                "senses": [
                    {
                        "sense_id": "c9273da4-70d3-3f20-b844-481988f2f744",
                        "entry_id": "8b60e851-ca49-3858-b592-1b2db9ab85c1",
                        "glosses": [
                            "Polir de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59e2e15e-018f-40e6-be3f-b2ccc4324a6c",
                                "sense_id": "c9273da4-70d3-3f20-b844-481988f2f744",
                                "text": "Il faut plusieurs jours pour repolir le miroir d’un grand télescope."
                            },
                            {
                                "example_id": "4af25511-7af8-4f45-84ce-e0b0428e98bf",
                                "sense_id": "c9273da4-70d3-3f20-b844-481988f2f744",
                                "text": "Cette glace fondait un tantinet à midi mais regelait le soir, et, chaque matin, on commençait par la repolir avec amour."
                            },
                            {
                                "example_id": "deb58303-7443-4f72-b2c8-3ff19ef77ace",
                                "sense_id": "c9273da4-70d3-3f20-b844-481988f2f744",
                                "text": "Les crêtes se ciselèrent et s’amincirent. Des couloirs burinèrent profondément les faces, et les tourmentes polirent et repolirent les grandes dalles jusqu’à leur donner l’aspect du bronze."
                            },
                            {
                                "example_id": "e474d610-c95c-4db0-89ba-60ef4e56f198",
                                "sense_id": "c9273da4-70d3-3f20-b844-481988f2f744",
                                "text": "Repolir de l’argenterie, de l’acier."
                            }
                        ]
                    },
                    {
                        "sense_id": "4758919f-5b19-3443-8f02-62912ad73c26",
                        "entry_id": "8b60e851-ca49-3858-b592-1b2db9ab85c1",
                        "glosses": [
                            "Améliorer, en parlant de tout ouvrage, y compris ceux de l’esprit."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "87783917-3bfe-4f67-82df-eed9591079ec",
                                "sense_id": "4758919f-5b19-3443-8f02-62912ad73c26",
                                "text": "Vingt fois sur le métier remettez votre ouvrage\nPolissez-le sans cesse, et le repolissez."
                            }
                        ]
                    }
                ],
