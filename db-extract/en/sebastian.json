                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc7538bf-6dd8-4b1a-8b86-3bad3c1972a7",
                                                "sense_id": "b1d66f66-2d4c-3642-8605-a1934f9ff023",
                                                "text": "À peine des Lupeaulx savait-il qu’il existât un Sébastien de La Roche."
                                            },
                                            {
                                                "example_id": "0d6d6845-3043-424c-96a4-56c39caa759f",
                                                "sense_id": "b1d66f66-2d4c-3642-8605-a1934f9ff023",
                                                "text": "Je me suis inspiré de ma mère, qui a retrouvé son père biologique, explique Sébastien Marnier."
                                            },
                                            {
                                                "example_id": "07693334-9c60-4ea8-92da-c3bcad3b6505",
                                                "sense_id": "b1d66f66-2d4c-3642-8605-a1934f9ff023",
                                                "text": "Confirmant une information de nos confrères d’Actu Rennes, le procureur de la République adjoint Sébastien Farges nous indique que la décision ne leur « apparaît pas conforme à la matérialité des faits »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
