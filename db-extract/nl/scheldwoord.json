                            {
                                "target_word": "pejorative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d35b32df-1a65-38ac-a433-6b1da448f8be",
                                        "entry_id": "e2756a29-819f-3a22-bbbe-a4f60753ef52",
                                        "glosses": [
                                            "A disparaging, belittling, or derogatory word or expression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "185bfc1d-f6d5-4b37-a0e4-94b522bd2d2c",
                                                "sense_id": "d35b32df-1a65-38ac-a433-6b1da448f8be",
                                                "text": "“Get away from me, freak.” “Actually, my designation is Logic-y. I take issue with the pejorative when I am simply a product of your self-inflicted bifurcation.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67fe804c-2acc-4c2f-a281-dd7a556ac3a8",
                        "source_entry_id": "334447a4-abb2-323f-9f43-16dad4facf1c",
                        "source_sense_id": "78e586d8-05ed-3e1e-beb7-84c54e40b9b4",
                        "source_sense_description": "een term die bedoeld is om iets of iemand te beledigen",
                        "target_lang_word": "Schimpfwort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schimpfwort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23fb8c50-d35a-3743-b522-e5fe7153bb9b",
                                        "entry_id": "2ce28425-f4c9-3ac2-8ca3-683b1dfa097a",
                                        "glosses": [
                                            "ein abfälliges, herabwürdigendes und beleidigendes Wort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ff5ee3a-08c9-4918-9780-5245f57bbf18",
                                                "sense_id": "23fb8c50-d35a-3743-b522-e5fe7153bb9b",
                                                "text": "„Schimpfwörter sind Substantive, mit denen Personen anstatt mit ihren Namen oder Titel in abfälliger Weise angeredet oder benannt werden…“"
                                            },
                                            {
                                                "example_id": "ec1ea06d-e4b9-459a-a67f-981ab6c94335",
                                                "sense_id": "23fb8c50-d35a-3743-b522-e5fe7153bb9b",
                                                "text": "Benutze bitte nicht solche Schimpfworte!"
                                            },
                                            {
                                                "example_id": "250f192c-5c31-4bc9-9eb6-a8c640ba8540",
                                                "sense_id": "23fb8c50-d35a-3743-b522-e5fe7153bb9b",
                                                "text": "„Bevor wir uns einigen Schimpfwörtern zuwenden, befassen wir uns kurz mit der Bedeutungsgeschichte des Wortfeldes ‚schimpfen‘ selbst und versetzen uns zu diesem Zweck ins 17. Jahrhundert.“"
                                            },
                                            {
                                                "example_id": "a804152e-171c-4f5d-aa96-ca35bd2b27ce",
                                                "sense_id": "23fb8c50-d35a-3743-b522-e5fe7153bb9b",
                                                "text": "„Gefühlswert besitzen auch diejenigen Wörter, die als Schimpf- und Scheltwörter verwendet werden.“"
                                            },
                                            {
                                                "example_id": "b6e798ad-36d2-4680-8d0e-4b45a04bd92d",
                                                "sense_id": "23fb8c50-d35a-3743-b522-e5fe7153bb9b",
                                                "text": "„Eigentlich ist ja der Gebrauch von Schimpfwörtern heutzutage verpönt.“"
                                            },
                                            {
                                                "example_id": "48ebf0b1-acbc-483b-a038-685c776c3da0",
                                                "sense_id": "23fb8c50-d35a-3743-b522-e5fe7153bb9b",
                                                "text": "„Auf Menschen bezogen ist er ein allgemeines Schimpfwort, die Bezeichnung für gewalttätige junge Burschen, überspannte Typen, Faulpelze, Schlaumeier oder bösartige Weiber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b018067c-ab28-4bd8-8b40-161e82bfba82",
                        "source_entry_id": "334447a4-abb2-323f-9f43-16dad4facf1c",
                        "source_sense_id": "78e586d8-05ed-3e1e-beb7-84c54e40b9b4",
                        "source_sense_description": "een term die bedoeld is om iets of iemand te beledigen",
                        "target_lang_word": "injure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "injure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6e2eaba-fe1a-3d96-99c1-6b5f6dc0a6e9",
                                        "entry_id": "2fb2b8fa-1d02-3b86-8209-a6dff1e92088",
                                        "glosses": [
                                            "Insulte, outrage, ou de fait, ou de parole, ou par écrit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f37b18e-a874-4807-bc09-dfb3597b3e03",
                                                "sense_id": "a6e2eaba-fe1a-3d96-99c1-6b5f6dc0a6e9",
                                                "text": "Louer les princes des vertus qu’ils n’ont pas, c’est leur dire impunément des injures."
                                            },
                                            {
                                                "example_id": "18322f47-aee9-47d3-bf20-3b777fdbc087",
                                                "sense_id": "a6e2eaba-fe1a-3d96-99c1-6b5f6dc0a6e9",
                                                "text": "La veille du jour où il arrêta Eugène sur le cours Sauvaire, il avait publié, dans l’Indépendant, un article terrible sur les menées du clergé, en réponse à un entrefilet de Vuillet, qui accusait les républicains de vouloir démolir les églises. Vuillet était la bête noire d’Aristide. Il ne se passait pas de semaine sans que les deux journalistes échangeassent les plus grossières injures."
                                            },
                                            {
                                                "example_id": "22674844-0adf-4bba-abce-c5c692d96b05",
                                                "sense_id": "a6e2eaba-fe1a-3d96-99c1-6b5f6dc0a6e9",
                                                "text": "Il cracha une injure, s’élança et réempoigna la jeune femme qui, cette fois, se débattit en vain."
                                            },
                                            {
                                                "example_id": "e6ec1aa9-a935-4b9f-900d-edd13102bd90",
                                                "sense_id": "a6e2eaba-fe1a-3d96-99c1-6b5f6dc0a6e9",
                                                "text": "J'aurais voulu qu'ils se missent en colère, qu'ils me dissent des injures ou qu'ils me montrassent le poing, car c'était leur impassibilité qui me rendait fou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dfa53ac-ed95-3626-97d1-592eb3421823",
                                        "entry_id": "2fb2b8fa-1d02-3b86-8209-a6dff1e92088",
                                        "glosses": [
                                            "Parole offensante, outrageante."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f70f871d-b8e4-4bf5-9b3d-ff933ad4a362",
                                                "sense_id": "4dfa53ac-ed95-3626-97d1-592eb3421823",
                                                "text": "[…] les discussions avec les camarades se réglaient toujours à la manière antique, par des bordées d’injures qui précédaient le crêpage en règle des tignasses."
                                            },
                                            {
                                                "example_id": "e229b33b-3d17-45ac-a0e7-5ea8c96d3513",
                                                "sense_id": "4dfa53ac-ed95-3626-97d1-592eb3421823",
                                                "text": "Et elle me bombarde, d’une voix mauvaise, avec un accent crapuleux, d’une bordée d’injures grasses."
                                            },
                                            {
                                                "example_id": "db106d1c-821e-4f45-8d74-d1d46931f9ac",
                                                "sense_id": "4dfa53ac-ed95-3626-97d1-592eb3421823",
                                                "text": "Ainsi, lorsque l’injurieur (celui qui prononce l’injure) s'adresse à un injuriaire (celui à qui s'adresse l’injurieur) à propos d'un injurié (celui dont parle l’injure) : c'est l’injure référentielle, car l’injurié dans le discours est le référent, et l’injurieur ne s'adresse pas directement à lui mais à l’injuriaire. La relation est, schématiquement de type triangulaire.\nOu bien , lorsqu'un injurieur s'adresse à un injuriaire qui est en même temps l’injurié : c'est l’injure interpellative. La relation est ici duelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23627491-fe0b-336f-b77c-3a9120476b39",
                                        "entry_id": "2fb2b8fa-1d02-3b86-8209-a6dff1e92088",
                                        "glosses": [
                                            "Dégradation, la ruine, la perte de certaines choses par l’effet des intempéries, de la durée, de l’âge."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5b3922d-40f9-4a5b-a451-02b04c285242",
                                                "sense_id": "23627491-fe0b-336f-b77c-3a9120476b39",
                                                "text": "Ces monuments, ces édifices ont éprouvé, ont ressenti l’injure du temps."
                                            },
                                            {
                                                "example_id": "a9575f8b-d774-4633-876f-cd7e16a55073",
                                                "sense_id": "23627491-fe0b-336f-b77c-3a9120476b39",
                                                "text": "Cette statue est exposée aux injures de l’air, du temps."
                                            },
                                            {
                                                "example_id": "d901ade1-1b6f-48ac-aa57-59b230ec4840",
                                                "sense_id": "23627491-fe0b-336f-b77c-3a9120476b39",
                                                "text": "L’injure de l’âge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "206a1e14-ade9-47cd-8e3f-bec2a5165f1e",
                        "source_entry_id": "334447a4-abb2-323f-9f43-16dad4facf1c",
                        "source_sense_id": "78e586d8-05ed-3e1e-beb7-84c54e40b9b4",
                        "source_sense_description": "een term die bedoeld is om iets of iemand te beledigen",
                        "target_lang_word": "gros mot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gros mot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6a6eb7b-9a15-361b-afa9-04fa26293172",
                                        "entry_id": "6e3bc830-6f18-32b6-b552-0cf2b4dc7fb8",
                                        "glosses": [
                                            "Mot considéré comme vulgaire, grossier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5be70ad7-2a7b-4415-a0e3-6d217a331d93",
                                                "sense_id": "a6a6eb7b-9a15-361b-afa9-04fa26293172",
                                                "text": "La Finance et la Guerre ne se sont-elles pas dit les gros mots pour la vingtième fois ?"
                                            },
                                            {
                                                "example_id": "02cfbb2b-c28d-4d0d-800b-d7a4dec0c497",
                                                "sense_id": "a6a6eb7b-9a15-361b-afa9-04fa26293172",
                                                "text": "Il se bornait à des recommandations anodines et à des conseils mitigés : […] ; ne dites donc pas de gros mots devant les enfants, ils ont bien le temps de les apprendre tout seuls."
                                            },
                                            {
                                                "example_id": "2b76882a-9039-4fa6-940b-1ad6f64e334e",
                                                "sense_id": "a6a6eb7b-9a15-361b-afa9-04fa26293172",
                                                "text": "– Moi, avant de fixer la date de mes fiançailles avec Rose, je lui ai fait ma cour pendant plus de sept mois !\n– Sept mois et vingt et un jours ! » s’écria la tante Rose.\nPuis elle rougit brusquement et baissa les yeux, comme si elle avait dit un gros mot."
                                            },
                                            {
                                                "example_id": "8f746ef4-1575-4136-9681-2b00f7ed8788",
                                                "sense_id": "a6a6eb7b-9a15-361b-afa9-04fa26293172",
                                                "text": "Un jour, pendant que le curé nous préparait à notre communion privée, j’avais, comme ça, passé mon temps à débiter des gros mots : des chouettes, des gras, des excommunicateurs."
                                            },
                                            {
                                                "example_id": "89316ab0-496e-4c24-bbc1-f34a5cf41ea1",
                                                "sense_id": "a6a6eb7b-9a15-361b-afa9-04fa26293172",
                                                "text": "À votre âge, et quand on porte votre nom, madame, les gros mots ne peuvent être que des citations !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaf4c3eb-57bf-3df5-b5f4-32d5f7044982",
                                        "entry_id": "6e3bc830-6f18-32b6-b552-0cf2b4dc7fb8",
                                        "glosses": [
                                            "Mot tabou, que l’on ne veut pas ou plus prononcer."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c35ffaa-b160-477e-bc2b-cc4f662614af",
                                                "sense_id": "eaf4c3eb-57bf-3df5-b5f4-32d5f7044982",
                                                "text": "J’admets très bien que ruiné, dépouillé, raclé, jusqu’à l’os, et légalement désarmé contre les prêteurs et les rapaces, on se fasse justice soi-même. — Par l’assassinat ? — Voilà un gros mot. Disons par le meurtre."
                                            },
                                            {
                                                "example_id": "8346e12a-4061-4a2f-b38f-d9122fcafd82",
                                                "sense_id": "eaf4c3eb-57bf-3df5-b5f4-32d5f7044982",
                                                "text": "Les entreprises elles-mêmes cherchent des dérivatifs au management sclérosant en tentant de « libérer les énergies » ou de revivifier la « culture entrepreneuriale », synonyme d’initiative. Qu’est-il arrivé au management pour qu’il soit presque devenu pour certains un gros mot ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
