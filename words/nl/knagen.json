{
    "word_family": [
        "geknaag",
        "knaagdier",
        "afknagen",
        "opknagen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6d908c38-bdbf-3f1a-81cc-38382b1facf5",
                    "sense_definition": "met de tanden kleine stukjes van iets afbijten of aanvreten",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "eten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kleine muis bleef geduldig aan het harde stukje kaas <w>knagen</w>.",
                            "target_lang_translations": {
                                "en": "The little mouse patiently continued to <w>gnaw</w> on the hard piece of cheese."
                            }
                        },
                        {
                            "text": "Termieten <w>knagen</w> aan alles wat van hout gebouwd is in dit oude huis.",
                            "target_lang_translations": {
                                "en": "Termites <w>gnaw</w> on everything built of wood in this old house."
                            }
                        }
                    ],
                    "synonyms": [
                        "kluiven",
                        "peuzelen"
                    ],
                    "common_phrases": [
                        "aan een bot knagen",
                        "op een wortel knagen"
                    ],
                    "target_lang_definitions": {
                        "en": "To bite or nibble small pieces off something persistently with the teeth."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gnaw",
                                "target_lang_sense_clarification": "to bite persistently at something tough"
                            },
                            {
                                "target_lang_word": "nibble",
                                "target_lang_sense_clarification": "to take small bites of something"
                            },
                            {
                                "target_lang_word": "chew",
                                "target_lang_sense_clarification": "to bite and work in the mouth"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f4e41e5-532b-39d4-bea5-0b3c7415449a",
                    "sense_definition": "een aanhoudend pijnlijk of onrustig gevoel veroorzaken, vaak figuurlijk gebruikt voor emoties",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gevoel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schuldgevoel bleef de hele avond aan zijn geweten <w>knagen</w>.",
                            "target_lang_translations": {
                                "en": "The guilt continued to <w>gnaw</w> at his conscience all evening."
                            }
                        },
                        {
                            "text": "Zelfs na vele jaren bleef de onzekerheid over die beslissing aan haar <w>knagen</w>.",
                            "target_lang_translations": {
                                "en": "Even after many years, the uncertainty about that decision continued to <w>eat away</w> at her."
                            }
                        }
                    ],
                    "synonyms": [
                        "vreten",
                        "kwellen"
                    ],
                    "common_phrases": [
                        "aan het geweten knagen",
                        "een knagend gevoel"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause a persistent painful or restless feeling, often used figuratively for emotions like guilt or worry."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gnaw",
                                "target_lang_sense_clarification": "to cause persistent anxiety or worry"
                            },
                            {
                                "target_lang_word": "eat away at",
                                "target_lang_sense_clarification": "to slowly destroy or trouble someone's mind"
                            },
                            {
                                "target_lang_word": "nag",
                                "target_lang_sense_clarification": "to be a constant source of discomfort or anxiety"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}