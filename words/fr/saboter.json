                    "frequency": "Middle",
                    "semantic_group_id": "entrave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les opposants ont tenté de <w>saboter</w> les négociations de paix en répandant de fausses rumeurs."
                        },
                        {
                            "text": "Sa jalousie l'a poussé à <w>saboter</w> le travail de son collègue avant la réunion."
                        }
                    ],
                    "synonyms": [
