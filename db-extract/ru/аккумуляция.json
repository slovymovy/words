                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "013c8907-a6a0-3c2b-87fc-2045d0ffe118",
                                        "entry_id": "b04d716a-bdb8-3a47-89a2-61373bd6d583",
                                        "glosses": [
