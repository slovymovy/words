    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eb1cd599-74f0-3d85-950a-bba02dff03d7",
                    "sense_definition": "Déranger le cours normal ou le déroulement régulier d'une activité, d'un événement ou d'un service.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "derangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La grève des transports va <w>perturber</w> la circulation dans tout le centre-ville."
                        },
                        {
                            "text": "Cette manifestation imprévue a réussi à <w>perturber</w> le déroulement de la conférence."
                        }
                    ],
                    "synonyms": [
                        "bouleverser",
                        "déranger"
                    ],
                    "common_phrases": [
                        "perturber la circulation",
                        "perturber le trafic"
                    ]
                },
                {
                    "sense_id": "b1c2cdbe-6b8a-3aa7-ba7e-9d96a64b886f",
                    "sense_definition": "Troubler l'équilibre émotionnel, psychologique ou intellectuel d'une personne.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "trouble_psychologique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette mauvaise nouvelle risque de le <w>perturber</w> avant son examen important."
                        },
                        {
                            "text": "Le bruit constant dans la pièce a fini par <w>perturber</w> sa concentration."
                        }
                    ],
                    "synonyms": [
                        "bouleverser",
                        "déranger",
                        "déstabiliser",
                        "troubler"
                    ],
                    "common_phrases": [
                        "perturber les habitudes"
                    ]
                },
                {
                    "sense_id": "525d3ea8-716c-35f4-b272-f447798df784",
                    "sense_definition": "Dérégler le fonctionnement normal d'un mécanisme, d'un organisme ou d'un système.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dereglement_systeme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'exposition aux écrans tard le soir peut gravement <w>perturber</w> le sommeil."
                        },
                        {
                            "text": "Une panne soudaine a commencé à <w>perturber</w> le réseau informatique de l'hôpital."
                        }
                    ],
                    "synonyms": [
                        "dérégler"
                    ],
                    "common_phrases": [
