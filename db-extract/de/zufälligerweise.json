        "de-extract.jsonl": [
            {
                "entry_id": "afd817d8-1340-3c26-bc68-10eb5050a8cb",
                "word": "zufälligerweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8ce9cfce-5ffd-3aec-b3e3-f5e40859f4e1",
                        "entry_id": "afd817d8-1340-3c26-bc68-10eb5050a8cb",
                        "glosses": [
                            "durch Zufall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "430a9631-82f8-498d-b678-29eaad846e3e",
                                "sense_id": "8ce9cfce-5ffd-3aec-b3e3-f5e40859f4e1",
                                "text": "\"Ich habe eine Schulfreundin zufälligerweise im Supermarkt wiedergetroffen.\""
                            },
                            {
                                "example_id": "61c29e23-8145-43ce-a30a-a0a4484b5b84",
                                "sense_id": "8ce9cfce-5ffd-3aec-b3e3-f5e40859f4e1",
                                "text": "\"Ich bestelle zufälligerweise dieselben Bücher wie ein Terrorist und, zack, bin ich im Fadenkreuz der Geheimdienste. So landen harmlose Bürger auf der Liste von Terrorverdächtigen.\""
                            },
                            {
                                "example_id": "08f3db82-2fd2-45af-af82-c0ecb8d3d768",
                                "sense_id": "8ce9cfce-5ffd-3aec-b3e3-f5e40859f4e1",
                                "text": "Alle zwei Wochen ist er [der 26-jährige Maximilian Feldhake] in Dresden, um seine Gastfamilie zu besuchen – dann laufe er oft bei der Gegendemonstration mit, \"also wenn ich zufälligerweise sowieso gerade in Dresden bin.\""
                            },
                            {
                                "example_id": "8d3dd451-eacc-4db3-9d2a-e6c3f4f6eee8",
                                "sense_id": "8ce9cfce-5ffd-3aec-b3e3-f5e40859f4e1",
                                "text": "In der EU gibt es ausreichend Geld, um Grenzzäune zu errichten, aber nicht genug, um den Ländern zu helfen, die zufälligerweise auf der Flüchtlingsroute liegen und diese Hilfe dringend brauchen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12dd25d3-9328-43e1-a35f-ba0feef54c3b",
                        "source_entry_id": "afd817d8-1340-3c26-bc68-10eb5050a8cb",
                        "source_sense_id": "8ce9cfce-5ffd-3aec-b3e3-f5e40859f4e1",
                        "source_sense_description": "durch Zufall",
                        "target_lang_word": "accidentally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accidentally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95f70e60-e5fc-363f-9bef-95bee6365684",
                                        "entry_id": "56564c53-bc48-3eee-88c5-f3227804f822",
                                        "glosses": [
                                            "In an accidental manner; by chance, unexpectedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eb2e364-3619-410e-a956-2710d6881dd0",
                                                "sense_id": "95f70e60-e5fc-363f-9bef-95bee6365684",
                                                "text": "He discovered penicillin largely accidentally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "286befc9-3d60-3ccf-b703-bc73931ed4a9",
                                        "entry_id": "56564c53-bc48-3eee-88c5-f3227804f822",
                                        "glosses": [
                                            "Unintentionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "463b1f23-a913-4af8-85a3-cc2a14842eb0",
                                                "sense_id": "286befc9-3d60-3ccf-b703-bc73931ed4a9",
                                                "text": "He accidentally exposed the bacteria to mold spores."
                                            },
                                            {
                                                "example_id": "a2dae667-cc40-4d6f-95ad-40eeece0483b",
                                                "sense_id": "286befc9-3d60-3ccf-b703-bc73931ed4a9",
                                                "text": "As I arrived at the foot of the hill I overtook two ladies, whom I passed. As I did so, I brushed one of them accidently on the arm."
                                            },
                                            {
                                                "example_id": "0e549a77-c563-44a0-a3f2-5e21da031a33",
                                                "sense_id": "286befc9-3d60-3ccf-b703-bc73931ed4a9",
                                                "text": "Robins, of Torquay, had denied a single charge of causing unnecessary suffering to an animal. She claimed the microwave was accidentally turned on by one of the cats after the kitten got inside. But Knutton said the kitten was too small to even get onto the work surface."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
