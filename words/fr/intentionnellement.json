                },
                {
                    "sense_id": "318166c7-e2fc-3be0-81cb-59a34eb6852b",
                    "sense_definition": "Dans la seule pensée ou intention, sans réalisation concrète.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette faute n'a existé qu'<w>intentionnellement</w>, sans qu'aucun acte matériel ne soit accompli."
                        },
                        {
                            "text": "Le projet était condamnable <w>intentionnellement</w>, même s'il est resté au stade de simple idée."
