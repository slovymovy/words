            {
                "entry_id": "8f5bf42c-970a-38f9-8254-2c72e62899a5",
                "word": "transat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "639c0a81-dbf5-462f-801b-03e7ef6709fa",
                        "entry_id": "8f5bf42c-970a-38f9-8254-2c72e62899a5",
                        "tags": [
                            "plural"
                        ],
                        "form": "transats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9390005-aa78-3937-b97b-1e080bffbff9",
                        "entry_id": "8f5bf42c-970a-38f9-8254-2c72e62899a5",
                        "glosses": [
                            "Fauteuil pliant à siège en toile, qu’on trouvait sur les ponts des paquebots transatlantiques."
                        ],
                        "tags": [],
                        "note": "Il est d’usage de distinguer le transat et la chilienne",
                        "examples": [
                            {
                                "example_id": "a1c791b6-81d3-4352-a3e6-e9715eb096cf",
                                "sense_id": "f9390005-aa78-3937-b97b-1e080bffbff9",
                                "text": "Bellune avait disposé des transats et une table en bordure de la terrasse que cernait une rampe blanche à l'aspect de bastingage."
                            },
                            {
                                "example_id": "b28b8595-bbcc-462c-87af-2b069478d44d",
                                "sense_id": "f9390005-aa78-3937-b97b-1e080bffbff9",
                                "text": "Il y avait une piscine mais je n’avais pas emporté mon maillot de bain. Autour de la piscine, des gens s’ennuyaient sur des transats. Derrière, il y avait des tables et des chaises en bois blanc."
                            },
                            {
                                "example_id": "7818b71e-ef5d-46ef-90f7-9508f03ba293",
                                "sense_id": "f9390005-aa78-3937-b97b-1e080bffbff9",
                                "text": "Que peut-on déjà visiter ? Un « salon » qui remplace l’ancienne cale à poisson du chalutier construit en 1959. Et un « sun deck », le pont passerelle, tout en haut, a été aménagé avec quelques transats pour permettre aux visiteurs de prendre le soleil."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f965ecf-a67b-36e6-8d6c-623456673e13",
                        "entry_id": "8f5bf42c-970a-38f9-8254-2c72e62899a5",
                        "glosses": [
                            "Navire transatlantique."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "013c84ca-418d-40ee-b816-e4355d06a6aa",
                                "sense_id": "9f965ecf-a67b-36e6-8d6c-623456673e13",
                                "text": "Le quai des transats est plus avant dans le port…"
                            }
                        ]
                    },
                    {
                        "sense_id": "2a559475-ef54-3315-aa3d-441f683a0aee",
                        "entry_id": "8f5bf42c-970a-38f9-8254-2c72e62899a5",
                        "glosses": [
                            "Siège conçu pour les bébés."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dde45d99-a719-4447-ad4b-bbf0bc89882d",
                        "source_entry_id": "8f5bf42c-970a-38f9-8254-2c72e62899a5",
                        "source_sense_description": "Fauteuil pliant à siège en toile",
                        "target_lang_word": "Liegestuhl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liegestuhl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85471224-c07d-39de-bc4c-7e0395efa945",
                                        "entry_id": "dcbb5132-ad3e-3e6e-9f0f-e7d58e829a11",
                                        "glosses": [
                                            "zusammenklappbares Sitz- bzw. Liegemöbel, bei dem die Sitzfläche aus einem gespanntem Stoff besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "655e3a9f-faa3-478c-9606-20bd44cdf275",
                                                "sense_id": "85471224-c07d-39de-bc4c-7e0395efa945",
                                                "text": "Sie genoss den Sonnenuntergang in ihrem Liegestuhl."
                                            },
                                            {
                                                "example_id": "ff92957e-5636-4f34-b13a-70f20848d578",
                                                "sense_id": "85471224-c07d-39de-bc4c-7e0395efa945",
                                                "text": "„Die Szene, die Claire sich jetzt, auf dem mondbeschienenen Balkon, in einem Liegestuhl ausgestreckt, noch einmal vor Augen führte, erinnerte sie an Madame Tussauds Wachsfigurenkabinett.“."
                                            },
                                            {
                                                "example_id": "e540a85c-51b9-488c-9b4f-3d07c1486097",
                                                "sense_id": "85471224-c07d-39de-bc4c-7e0395efa945",
                                                "text": "„Bobby rückte seinen Liegestuhl ein wenig näher an Vals Stuhl heran, so dass sich ihre Beine berührten.“"
                                            },
                                            {
                                                "example_id": "4ae02688-03ff-43cb-aeb3-34a3b5ce3ae3",
                                                "sense_id": "85471224-c07d-39de-bc4c-7e0395efa945",
                                                "text": "„Wenn die Liegestühle einmal reserviert sind, legen sich Herbert und Ingeborg wieder ins Bett.“"
                                            },
                                            {
                                                "example_id": "571a3083-9d04-4a4a-9f85-6d1af6b2fddf",
                                                "sense_id": "85471224-c07d-39de-bc4c-7e0395efa945",
                                                "text": "„In der ersten Reihe der aufgereihten Liegestühle liegen drei Frauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ee5c0b7-a21e-418b-9dff-aea6bc831cda",
                        "source_entry_id": "8f5bf42c-970a-38f9-8254-2c72e62899a5",
