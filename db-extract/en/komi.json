                        "entry_id": "b2145689-e1d2-3a99-b8ec-2138f0a632a0",
                        "glosses": [
                            "A republic of Russia. Official name: Komi Republic."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4d137bfd-1edd-3b0f-b148-4f2131b0a0c3",
                        "entry_id": "b2145689-e1d2-3a99-b8ec-2138f0a632a0",
