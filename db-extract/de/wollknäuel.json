                ],
                "senses": [
                    {
                        "sense_id": "b725b977-a25e-3007-9746-6c1138c0c504",
                        "entry_id": "dfe1345b-b192-3612-b30a-4dc924fbbde6",
                        "glosses": [
                            "zu einer Art Kugel aufgewickeltes Wollgarn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbfa6ba8-e63f-49cf-b69b-9af0c7da1852",
                                "sense_id": "b725b977-a25e-3007-9746-6c1138c0c504",
                                "text": "»Er strickt. Er hatte ein großes Wollknäuel und zwei Nadeln und strickte.«"
                            },
                            {
                                "example_id": "636b984e-7fde-4cab-9468-d20122ebbd71",
                                "sense_id": "b725b977-a25e-3007-9746-6c1138c0c504",
                                "text": "Katzen spielen gerne mit Wollknäueln."
                            },
                            {
                                "example_id": "b5fc5db7-df61-4916-add0-7ceb851f97e9",
                                "sense_id": "b725b977-a25e-3007-9746-6c1138c0c504",
                                "text": "Teilnehmer werfen ein Wollknäuel herum und knüpfen so das symbolische \"Beziehungsnetz\"."
                            },
                            {
                                "example_id": "9dc2d25a-b17f-42e7-bbc2-8887d9d16108",
                                "sense_id": "b725b977-a25e-3007-9746-6c1138c0c504",
                                "text": "Die Kinder bekommen ein Wollknäuel, das sie entwirren müssen. Wer entwirrt sein Wollknäuel am schnellsten?"
                            },
                            {
                                "example_id": "596eff6e-46b1-48c1-9266-3c9e13ca6746",
                                "sense_id": "b725b977-a25e-3007-9746-6c1138c0c504",
                                "text": "Besonders hübsch ist die Deko-Schale aus Wolle als Aufbewahrung für Wollknäuel!"
                            },
                            {
                                "example_id": "dd10cdd0-74b4-46c2-bd04-205eeadd5008",
                                "sense_id": "b725b977-a25e-3007-9746-6c1138c0c504",
                                "text": "Etwa eine Wollkatze: im Bauch einer dicken weißen Porzellankatze kann man ein Wollknäuel aufbewahren und den Strickfaden durch ein kleines Loch am Hals der Katze ziehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
