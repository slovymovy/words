                "senses": [
                    {
                        "sense_id": "83135708-ba60-3132-8ba2-51168c3f6047",
                        "entry_id": "e60257ec-678e-3a63-be33-c4a05eb4a5d4",
                        "glosses": [
                            "oleista, wybuchowa ciecz o wzorze sumarycznym C₃H₅N₃O₉, używana głównie w produkcji dynamitu oraz jako lek rozszerzający naczynia krwionośne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30786026-2a2a-45d5-b261-036207028343",
                                "sense_id": "83135708-ba60-3132-8ba2-51168c3f6047",
                                "text": "Nitrogliceryna powoduje spadek ciśnienia tętniczego, nawet znaczny, gdy chory np. stoi."
                            },
                            {
                                "example_id": "9125e6f8-a552-41db-b82e-c5ef4d9c531b",
                                "sense_id": "83135708-ba60-3132-8ba2-51168c3f6047",
                                "text": "Z tego powodu produkcja nitrogliceryny należy do najniebezpieczniejszych procesów technologicznych w przemyśle chemicznym."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7566bb77-c471-4be1-b20b-404e76980785",
                        "source_entry_id": "e60257ec-678e-3a63-be33-c4a05eb4a5d4",
