                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86c04985-6130-3d21-8a37-89e0f5e9c5af",
                                        "entry_id": "c7a58ee4-3c40-376f-a66e-1fb05bbc2b98",
                                        "glosses": [
                                            "vyobrazení orlice (1) na erbu, znaku apod."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31a45473-0f13-40b3-8558-14a224a8ca70",
                                                "sense_id": "86c04985-6130-3d21-8a37-89e0f5e9c5af",
                                                "text": "Po panu Soběslavovi z Miletínka zbyl nám štít z r. 1459, na němž vedlé jeho znaku šachovaného v pravé polovici ještě černá orlice Žerotínů českých na stříbrném štítě a řebřík pánů z Choustníka se nalézají."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87033593-b5c5-434b-b53b-277b5dbd4948",
                        "source_entry_id": "9b0c2304-01e6-3363-b617-088ece18e716",
                        "source_sense_id": "37159d41-e398-38d7-b6ed-9441be629ce2",
                        "target_lang_word": "орлица",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "орлица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2b1dfb31-7534-3b32-a130-637e16598baf",
                                        "entry_id": "ac144917-83cf-3498-9344-e2e7d4bf61bf",
                                        "glosses": [
                                            "самка орла"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac50f4a9-f3b2-4ce9-b70e-3f0ae056a509",
                                                "sense_id": "2b1dfb31-7534-3b32-a130-637e16598baf",
                                                "text": "Боги казнили Прометея не только за похищение огня с неба, но и за вторую вину, едва ли не важнейшую: он придумал способ делать людей из глины. Печень его клевала ― орлица."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09d0073a-ab20-3363-af09-5f5064b49b7b",
                                        "entry_id": "ac144917-83cf-3498-9344-e2e7d4bf61bf",
                                        "glosses": [
                                            "перен."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2b3a215-0e5b-45f3-abac-3cd6dcbf5c75",
                                                "sense_id": "09d0073a-ab20-3363-af09-5f5064b49b7b",
                                                "text": "Не одно только сердце, не одно только чувство справедливости громко вопияли в Марине: гордость, эта орлица, которую стрелы клеветы не могут заставить упасть на землю, как бы смертельно они её ни поражали, и которая, раненная ими, всё возносится выше и выше, на недосягаемые снизу вершины, исцелиться или умереть в недоступной Тишине, ― гордость была в ней раздражена, и её голос говорил едва ли не громче самой любви."
                                            },
                                            {
                                                "example_id": "e38a0657-4d24-4dbc-a13c-1c1053950c83",
                                                "sense_id": "09d0073a-ab20-3363-af09-5f5064b49b7b",
                                                "text": "Она простонала: ― Я не орлица… Он ответил: ― Орлица. Она взяла его руки и долго целовала их, плача, но ничего больше не говоря; потом поднялась, окликнула детей, поманила их обратно к Самсону и ушла со своим погонщиком."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
