                "senses": [
                    {
                        "sense_id": "d64cde09-d6ec-3e00-967d-997d9b557bac",
                        "entry_id": "b7fe015f-9836-3d33-b75e-1eebd90b795a",
                        "glosses": [
                            "links oder rechts angrenzende (benachbarte) Loge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0fcb35d-e365-4a57-9ae0-a74b4a7f39cd",
                                "sense_id": "d64cde09-d6ec-3e00-967d-997d9b557bac",
                                "text": "„Eine Dame, die gerade die Nachbarloge betrat, betrachtete Natascha mit einem Blick weiblichen Neides.“"
                            },
                            {
                                "example_id": "1834f035-15d1-47de-846e-d1f2b4eb5bee",
                                "sense_id": "d64cde09-d6ec-3e00-967d-997d9b557bac",
                                "text": "„Über die Nachbarloge, an den versteinerten Mienen der dort sitzenden Damen und Herren vorbei, steigt sie auf das Geländer - ein Augenzeuge im Parterre vermerkt später anzüglich, dass man ihr Bein von unten sehen konnte - und nimmt in der leeren Loge Platz.“"
                            },
                            {
                                "example_id": "f0c58895-bc99-426a-8180-c3a3fbfd8d0d",
                                "sense_id": "d64cde09-d6ec-3e00-967d-997d9b557bac",
                                "text": "„Ponomarev sitzt allein, etwas distanziert von seiner Entourage, vor der leeren Nachbarloge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d7062ed9-c925-390c-a260-1f7c9732e859",
                        "entry_id": "b7fe015f-9836-3d33-b75e-1eebd90b795a",
                        "glosses": [
                            "in der Nähe einer Freimaurerloge befindliche andere Loge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72b174d4-7979-4918-ba6f-36ca2241aa54",
                                "sense_id": "d7062ed9-c925-390c-a260-1f7c9732e859",
                                "text": "„Elf Brüder werden ehrenvoll aus der Einbecker Loge entlassen, um die Wiedereinsetzung der Nachbarloge Otto zu den fünf Türmen in Northeim zu ermöglichen.“"
                            },
                            {
                                "example_id": "b5b700e6-b721-496c-afef-f2491d71e6ed",
                                "sense_id": "d7062ed9-c925-390c-a260-1f7c9732e859",
                                "text": "„Er setzte sich mit der Nachbarloge „Zur Bundeskette“ in Soest in Verbindung und konnte die dortigen Brüder zur Unterstützung motivieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
