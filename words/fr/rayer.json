    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af4c291f-0d81-3c93-a588-01da61642757",
                    "sense_definition": "Tracer un trait sur un mot ou une mention écrite pour l'annuler ou la supprimer.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ecriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>rayer</w> la mention inutile avant de signer ce document officiel."
                        },
                        {
                            "text": "Elle a <w>rayé</w> son nom de la liste des invités après leur dispute."
                        }
                    ],
                    "synonyms": [
                        "barrer",
                        "biffer",
                        "raturer"
                    ],
                    "common_phrases": [
                        "rayer de la liste",
                        "rayer une mention inutile"
                    ]
                },
                {
                    "sense_id": "de8dcdfe-54e9-33b3-ba0e-ea934f9898b0",
                    "sense_definition": "Marquer une surface de lignes ou y causer une éraflure superficielle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais bien attention avec tes clés pour ne pas <w>rayer</w> la carrosserie neuve."
                        },
                        {
                            "text": "Le chat a réussi à <w>rayer</w> la table en verre avec ses griffes."
                        }
                    ],
                    "common_phrases": [
                        "rayer la carrosserie",
                        "rayer le parquet"
                    ]
                },
                {
                    "sense_id": "49026a26-5505-3a28-ab1c-1c5ab66df8f0",
                    "sense_definition": "Supprimer définitivement ou faire disparaître une chose ou une personne d'un groupe ou d'un lieu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suppression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le terrible tremblement de terre a presque <w>rayé</w> ce petit village de la carte."
                        },
                        {
                            "text": "Le médecin a été définitivement <w>rayé</w> de l'ordre après cette grave erreur."
                        }
                    ],
                    "common_phrases": [
                        "rayer de la carte",
                        "rayer de ses pensées"
                    ]
                },
                {
                    "sense_id": "2b194379-6702-338b-aee4-0f43d23fcc0f",
                    "sense_definition": "Projeter des rais de lumière ; rayonner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès l'aube, le soleil commençait à <w>rayer</w> doucement sur les crêtes de la montagne."
                        },
                        {
                            "text": "Une faible lueur <w>rayait</w> à travers les volets entrouverts de la chambre."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Sens ancien, équivalent à rayonner"
                        }
                    ]
                }
            ]
        }
    ]
