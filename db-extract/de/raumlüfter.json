                "senses": [
                    {
                        "sense_id": "d0cb44e6-73a0-3e95-a286-48d931f5ca05",
                        "entry_id": "111b4868-03c5-3bf6-9183-ea53e20c39ba",
                        "glosses": [
                            "Ventilator zur Erzeugung eines Luftstroms zur Kühlung oder Entlüftung von Innenräumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "594d780b-8fba-4f66-af76-dd17d4470e02",
                                "sense_id": "d0cb44e6-73a0-3e95-a286-48d931f5ca05",
                                "text": "„In jedem Stall befindet sich ein Raumlüfter, der für eine gleichmäßige Ventilation im Raum sorgt.“"
                            },
                            {
                                "example_id": "ab23ebc0-91fb-4ad8-a5c6-bf15d8b46216",
                                "sense_id": "d0cb44e6-73a0-3e95-a286-48d931f5ca05",
                                "text": "„Eigentümer von Firmen, die Gesichtsmasken oder medizinisches Gerät wie etwa Raumlüfter herstellen, machen bei steigenden Preisen einen.“"
                            },
                            {
                                "example_id": "57bf2588-5f7a-4000-8c39-db9457d0d216",
                                "sense_id": "d0cb44e6-73a0-3e95-a286-48d931f5ca05",
                                "text": "„Aus diesem Grund sollten zusätzliche akustische Lärmquellen vermieden werden. Hierzu zählen insbesondere Raumlüfter und Geräteventilatoren, aber auch Nadeldrucker und Plotter.“"
                            },
                            {
                                "example_id": "634666a6-9aae-45c0-ba5f-74a73e082051",
                                "sense_id": "d0cb44e6-73a0-3e95-a286-48d931f5ca05",
                                "text": "„Auch in Vaterstetten werden zum kommenden Schuljahr neue Einrichtungsgegenstände in den Klassenzimmern stehen: mobile Raumlüfter.“"
                            },
                            {
                                "example_id": "66ed76cf-2f58-4ba1-824b-9752aea6774b",
                                "sense_id": "d0cb44e6-73a0-3e95-a286-48d931f5ca05",
                                "text": "„Eines dieser Unternehmen, Kai Plastics aus Lüdenscheid im Sauerland, übernimmt für Smart Air als Lohnfertiger die Montage der Raumlüfter.“"
                            },
                            {
                                "example_id": "07645483-3b7d-470e-b91e-6655d2d08994",
                                "sense_id": "d0cb44e6-73a0-3e95-a286-48d931f5ca05",
                                "text": "„Abschließend ist festzustellen, dass wir im Homeschooling fast genauso viel gelernt haben wie im Präsenzunterricht und man braucht auch nicht unbedingt Raumlüfter, die Fenster sind bei uns permanent offen, auch wenn es im Winter manchmal sehr kalt war.“"
                            }
                        ],
