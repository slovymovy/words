    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8b6186a2-f768-30a0-89d6-1a826b52ac87",
                    "sense_definition": "Barely sufficient or inadequate in amount, size, or extent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The survivors had to survive on <w>scanty</w> rations of food and water for nearly two weeks.",
                            "target_lang_translations": {
                                "ru": "Выжившим приходилось почти две недели держаться на <w>скудных</w> пайках еды и воды."
                            }
                        },
                        {
                            "text": "Due to <w>scanty</w> evidence, the police were unable to bring charges against the main suspect.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>недостаточных</w> улик полиция не смогла предъявить обвинения главному подозреваемому."
                            }
                        }
                    ],
                    "synonyms": [
                        "skimpy"
                    ],
                    "antonyms": [
                        "abundant",
                        "plentiful"
                    ],
                    "common_phrases": [
                        "scanty clothing",
                        "scanty evidence",
                        "scanty information",
                        "scanty resources"
                    ],
                    "target_lang_definitions": {
                        "ru": "Едва достаточный или недостаточный по объёму, размеру или степени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скудный",
                                "target_lang_sense_clarification": "о количестве, запасах или информации"
                            },
                            {
                                "target_lang_word": "недостаточный",
                                "target_lang_sense_clarification": "не покрывающий потребности"
                            },
                            {
                                "target_lang_word": "бедный",
                                "target_lang_sense_clarification": "небогатый содержанием или размером"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf7eab8c-0b5a-3bbe-99b8-42d5341da79f",
                    "sense_definition": "Extremely sparing, stingy, or reluctant to give or share.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He proved to be quite <w>scanty</w> with his praise, rarely complimenting even the best work.",
                            "target_lang_translations": {
                                "ru": "Он оказался весьма <w>скупым</w> на похвалу и редко хвалил даже самую лучшую работу."
                            }
                        },
                        {
                            "text": "The author was remarkably <w>scanty</w> of details when describing the central character's past.",
                            "target_lang_translations": {
                                "ru": "Автор был на удивление <w>скуп</w> на подробности, описывая прошлое главного героя."
                            }
                        }
                    ],
                    "antonyms": [
                        "generous"
                    ],
                    "common_phrases": [
                        "scanty of words"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to describe stinginess directly."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно бережливый, скупой или неохотно делящийся чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скупой",
                                "target_lang_sense_clarification": "на похвалу, слова или внимание"
                            },
                            {
                                "target_lang_word": "прижимистый",
                                "target_lang_sense_clarification": "неохотно проявляющий щедрость"
                            }
                        ]
                    }
                }
            ]
        }
    ]
