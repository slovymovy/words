                "senses": [
                    {
                        "sense_id": "9ed31ef6-5303-3d62-9347-ee1cefea9be0",
                        "entry_id": "cecddd36-8ec6-377f-8c66-0e347b83d777",
                        "glosses": [
                            "oparty na procesie osmozy; dotyczący osmozy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81aed01d-0e47-4e8b-a1ee-7a0813e565ec",
                                "sense_id": "9ed31ef6-5303-3d62-9347-ee1cefea9be0",
                                "text": "Regulują gospodarkę wodną organizmu - sód zatrzymuje wodę, zaś potas zwiększa jej wydalanie - poza tym wpływają one na równowagę kwasowo-zasadową i utrzymują właściwe ciśnienie osmotyczne"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3059039-6b0e-4307-842e-9af962f0c556",
                        "source_entry_id": "cecddd36-8ec6-377f-8c66-0e347b83d777",
                        "source_sense_id": "9ed31ef6-5303-3d62-9347-ee1cefea9be0",
                        "target_lang_word": "osmotic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "osmotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef225ff6-de48-3112-b96e-b18fe164373d",
                                        "entry_id": "2f001130-58d4-3e9a-a3a5-3b3c7d0ed06b",
                                        "glosses": [
                                            "Relating to, or powered by, osmosis."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c8d3b79-aa43-4c10-b3f7-70c481055ec3",
                                                "sense_id": "ef225ff6-de48-3112-b96e-b18fe164373d",
                                                "text": "We saw them waking, we heard them sleeping, we sensed them dreaming, we were permeated completely with the strange Gray Myth of the West and the weird dark Myth of the East when morning came. All my actions since then have been dictated automatically to my subconscious by this horrible osmotic experience."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
