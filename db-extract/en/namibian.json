                    {
                        "translation_id": "5a50961b-597e-41dc-902c-15035e765596",
                        "source_entry_id": "d536a253-b86b-3f9d-ae22-ff87aa437130",
                        "source_sense_id": "320a1d86-9a8b-39ea-ae91-c17e15916841",
                        "source_sense_description": "a person from Namibia or of Namibian descent",
                        "target_lang_word": "Namibier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Namibier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aebf50dc-4954-385d-8949-65bf2d35eda6",
                                        "entry_id": "76210e86-bce7-3c8c-81aa-239bcc5750cc",
                                        "glosses": [
                                            "Staatsbürger von Namibia"
                                        ],
                                        "tags": [
                                            "amtlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "466dd81c-c581-44b0-9e9a-22e8635e2723",
                                                "sense_id": "aebf50dc-4954-385d-8949-65bf2d35eda6",
                                                "text": "„Die deutsche Regierung sollte mit allen namibischen Einrichtungen und Instanzen einschließlich politischer Parteien und Gemeinschaften zusammenarbeiten, ‚um Versöhnung und die Wiederherstellung der Würde unter Namibiern zu gewährleisten‘.“"
                                            },
                                            {
                                                "example_id": "e5b5b2b1-9bf3-4af9-ae75-c763a309ce17",
                                                "sense_id": "aebf50dc-4954-385d-8949-65bf2d35eda6",
                                                "text": "„Dieser bezeichnete die Ermordung Zehntausender Namibier unter deutscher Kolonialherrschaft als ‚ersten Genozid des 20. Jahrhunderts‘ und die Überführung von Knochen zu Forschungszwecken als ‚rassistisch motivierte Verbrechen‘.“"
                                            },
                                            {
                                                "example_id": "a1a9b0ee-ecc5-4a7e-a87b-75769931ee4b",
                                                "sense_id": "aebf50dc-4954-385d-8949-65bf2d35eda6",
                                                "text": "„Die meisten Namibier sind Farmer, aber arme.“"
                                            },
                                            {
                                                "example_id": "bc244994-1847-491d-b353-9e9cb59b3da1",
                                                "sense_id": "aebf50dc-4954-385d-8949-65bf2d35eda6",
                                                "text": "„Andere weiße Namibier lenken von den historisch bedingten Ungerechtigkeiten ab, indem sie aktuelle Missstände in der namibischen Politik betonten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
