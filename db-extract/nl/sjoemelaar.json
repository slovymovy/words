                    },
                    {
                        "translation_id": "48668aaf-f3eb-4877-9968-0e9d9cb32c6a",
                        "source_entry_id": "8a0dbdc4-f3b9-3609-8142-65228f641854",
                        "source_sense_id": "3745101c-113a-3cf6-ba9e-6ffe19e88dc3",
                        "source_sense_description": "iemand die heimelijk bedriegt",
                        "target_lang_word": "fiddler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiddler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6f3f46a-d7a8-3bfe-8bb1-a736262bb7a9",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "One who plays the fiddle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "088e3799-82e4-315a-8c26-843eeb342b4c",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "One who fiddles; a cheat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3b6849e-7b62-4099-8f26-e4619a8eca54",
                                                "sense_id": "088e3799-82e4-315a-8c26-843eeb342b4c",
                                                "text": "We were the self-controlled, cautious, nifty merchants, decorous fiddlers of accounts, hoarders of wealth, excellent bribers, family and community creatures governed by manners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f20ba12-99e9-3afd-bcfe-7bec0fce3899",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "One who fiddles or tweaks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9f61b1b-f94c-4d06-96c9-dcb45ff5c6ff",
                                                "sense_id": "7f20ba12-99e9-3afd-bcfe-7bec0fce3899",
                                                "text": "The community of radio amateurs—trespassing fiddlers on the cutting edge of technological possibilities—prefigured the geek community that was to inhabit Silicon Valley 50 years later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16a97453-d8db-336f-b34e-c168cd038dc6",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "A burrowing crab of the genus Gelasimus, of many species. The male has one claw very much enlarged, and often holds it in a position similar to that in which a musician holds a fiddle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30529351-33fb-3a4b-8854-82ba111ea5ba",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "The common European sandpiper (Actitis hypoleucos); so called because it habitually wags its tail up and down resembling the back and forth movement of a fiddler."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a2437c0-6f3a-3e54-89c7-75e82ff5011a",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "A large species of cicada, Macrotristria angularis, of eastern Australia; cherry nose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f15b00a-aa16-333d-83d1-73c84b908306",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "A coin of little value: a sixpence or a farthing."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14cc7210-e78b-328f-b9eb-735e89668cc5",
                                        "entry_id": "be0ba445-8119-3183-8294-624a291db156",
                                        "glosses": [
                                            "The capstan-house on a steamer."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5921ef5-7642-48d3-b970-bb4e57f1d057",
                                                "sense_id": "14cc7210-e78b-328f-b9eb-735e89668cc5",
                                                "text": "Whereupon you shake hands with him […] and make room for him by your side in the \"Fiddler,\" when the pleasant time of night is come, and the stewardess is tucking up the ladies, and putting oranges and other goodies under their pillows, and the menfolk assemble in the capstan house to smoke their last cigar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "566e8573-cefc-4d33-a757-52a20b0f83c0",
                        "source_entry_id": "8a0dbdc4-f3b9-3609-8142-65228f641854",
                        "source_sense_id": "3745101c-113a-3cf6-ba9e-6ffe19e88dc3",
                        "source_sense_description": "iemand die heimelijk bedriegt",
                        "target_lang_word": "margoulin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "margoulin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "303f00aa-b4df-3917-a53e-4307e24b1589",
                                        "entry_id": "8382e083-8af4-38be-b865-72559d52bd13",
                                        "glosses": [
                                            "Petit détaillant, petit patron."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8a2bdee-e1f9-3809-81c6-871b6e68c1c1",
                                        "entry_id": "8382e083-8af4-38be-b865-72559d52bd13",
                                        "glosses": [
                                            "Marchand peu scrupuleux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90f936aa-0265-4e65-b3c8-342e02be34a6",
                                                "sense_id": "a8a2bdee-e1f9-3809-81c6-871b6e68c1c1",
                                                "text": "— Compliments ; il est donc cousu d’or, ce margoulin ?"
                                            },
                                            {
                                                "example_id": "1305d9ba-d665-4750-8a1d-7a14a059324e",
                                                "sense_id": "a8a2bdee-e1f9-3809-81c6-871b6e68c1c1",
                                                "text": "Auteur de sujets sur Barbara Hendricks ou Alain Tanner, il s’était signalé en 1996 avec Un marchand, des artistes et des collectionneurs, autre docu dans lequel toute la corporation - à commencer par le galeriste parisien Pierre Nahon - passait pour une bande de margoulins vénaux, cyniques et fats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "023ca0c9-8c23-341a-89e4-238ff2a6e926",
                                        "entry_id": "8382e083-8af4-38be-b865-72559d52bd13",
                                        "glosses": [
                                            "Petit trafiquant indélicat et sans envergure, individu de mauvaise foi."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81656c60-778e-3a3d-a5b9-a1f2abda72fc",
                                        "entry_id": "8382e083-8af4-38be-b865-72559d52bd13",
                                        "glosses": [
                                            "Individu incompétent et peu scrupuleux en affaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e2527c2-1f60-45fd-b6cf-5e949e386840",
                                                "sense_id": "81656c60-778e-3a3d-a5b9-a1f2abda72fc",
                                                "text": "Nous sommes des petits pauvres, je veux bien, mais pas des enfants de margoulins…"
                                            },
                                            {
                                                "example_id": "2808b09f-52cb-4b2b-a708-c4883cdd1b99",
                                                "sense_id": "81656c60-778e-3a3d-a5b9-a1f2abda72fc",
                                                "text": "Il vivait dans la hantise permanente d'un coup du sort - faillite bancaire, écroulement du marché immobilier, filouterie d'un margoulin - qui réduirait à néant la pelote qu'il avait patiemment amassée."
                                            },
                                            {
                                                "example_id": "491dbc06-8a74-4e49-a615-07d19de22001",
                                                "sense_id": "81656c60-778e-3a3d-a5b9-a1f2abda72fc",
                                                "text": "Et il n’ignorait pas que, dès que cette suppression serait connue, tous les margoulins de Paris et de New York prendraient position à la baisse sur ses titres : […]."
                                            },
                                            {
                                                "example_id": "4270e661-2efa-442e-915d-ac2f8f38cf79",
                                                "sense_id": "81656c60-778e-3a3d-a5b9-a1f2abda72fc",
                                                "text": "Notre quête de l'objet rare nous amène à regarder beaucoup (énormément... trop ?) de films, dont finalement peu méritent vraiment le qualificatif de \"nanar\". Un qualificatif qu'on ne considère pas comme un sceau infâmant mais bien comme un label de prestige, au contraire des tonnes de navets infâmes et soporifiques qu'on se coltine à longueur d'année dans notre exploration assidue des bas-fonds filmiques, des ruelles mal famées des vidéo-clubs, des arrières-cours interlopes de mini-studios de margoulins sitôt créés sitôt disparus et, de plus en plus, des fonds de catalogues affligeants des chaînes de streaming et de VOD."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f68ff945-49bd-4e7a-a26b-688367246c40",
                        "source_entry_id": "8a0dbdc4-f3b9-3609-8142-65228f641854",
                        "source_sense_id": "3745101c-113a-3cf6-ba9e-6ffe19e88dc3",
                        "source_sense_description": "iemand die heimelijk bedriegt",
                        "target_lang_word": "fricoteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fricoteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ef78e45-9022-30b9-bd70-f4bc36f0f90c",
                                        "entry_id": "5d4ab288-b7d2-3a2a-88cd-0e15d8956989",
                                        "glosses": [
                                            "Qui fricote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf245fa-0528-4c93-ae8e-404e15ac398e",
                                                "sense_id": "2ef78e45-9022-30b9-bd70-f4bc36f0f90c",
                                                "text": "Quelques officiers, tarés ou « fricoteurs », trouvent fort intéressant de puiser dans les fonds secrets de deux ou trois grandes puissances en passant aux divers services de renseignements auxquels ils sont affiliés des pièces …."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fricoteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87987a22-5c72-3e81-8a92-d50e0c0ebf68",
                                        "entry_id": "bf326d4a-4c23-3e72-aa9e-dbd5ddaf9ae2",
                                        "glosses": [
                                            "Personne vivant d'affaires plus ou moins louches."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e828002-44d0-4a4e-aec0-955f01a0ee1d",
                                                "sense_id": "87987a22-5c72-3e81-8a92-d50e0c0ebf68",
                                                "text": "Et saisissez bien ceci !… dit Fourchon, les fricoteurs des autres communes ne seront pas reçus."
                                            },
                                            {
                                                "example_id": "e65288e5-2501-4013-a4dd-5800fd8a54d7",
                                                "sense_id": "87987a22-5c72-3e81-8a92-d50e0c0ebf68",
                                                "text": "Le visage d’Honoré s’empourpra de colère. Salaud de vétérinaire. Le nom de Dieu de fricoteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d61f863f-2f69-386a-83d3-b401984f1a8b",
                                        "entry_id": "bf326d4a-4c23-3e72-aa9e-dbd5ddaf9ae2",
                                        "glosses": [
                                            "Personne qui aime à entretenir des relations intimes avec d'autres."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbad430c-bece-4d26-a906-8ce0cbcd1037",
                                                "sense_id": "d61f863f-2f69-386a-83d3-b401984f1a8b",
                                                "text": "Une fricoteuse de première, elle aussi. Toujours fourrée avec les Arabes ou à se frotter des tangos contre les ritals de la Petite Sicile sous le palmier du Chalet Goulettois, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aeb349d-ac5d-3c0c-a247-90cb8ee0c136",
                                        "entry_id": "bf326d4a-4c23-3e72-aa9e-dbd5ddaf9ae2",
                                        "glosses": [
                                            "Celui ou celle qui aime à faire bonne chère."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "356fa8f7-6a2f-4541-a584-9b1c9d5ec290",
                                                "sense_id": "2aeb349d-ac5d-3c0c-a247-90cb8ee0c136",
                                                "text": "Né dans les Halles, rue de la Cossonnerie, fils de hasard d’une marchande au petit tas, engagé « pour des sous », comme il disait, après avoir fait tous les métiers, il était le fricoteur, le nez tourné continuellement à la friandise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36f852ba-f469-3bc9-8019-5043a791db21",
                                        "entry_id": "bf326d4a-4c23-3e72-aa9e-dbd5ddaf9ae2",
                                        "glosses": [
                                            "Celui ou celle qui aime à cuisiner."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74439588-09ab-4a17-8fda-cd0adc15a98b",
                                                "sense_id": "36f852ba-f469-3bc9-8019-5043a791db21",
                                                "text": "Le maître-d'école fit même un joli discours en réponse à cette santé, et chacun fit honneur aux mets appétissants préparés par madame Montépel, qui avait la réputation d'être la meilleure « fricoteuse » des environs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
