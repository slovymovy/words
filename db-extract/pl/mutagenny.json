                "translations": [
                    {
                        "translation_id": "fa605682-ce50-47a1-a34c-c2c1dd3fb003",
                        "source_entry_id": "8da41991-f305-326a-8a46-d68af6d80429",
                        "source_sense_id": "3958d261-1389-36ad-8ced-a8973e6a0028",
                        "target_lang_word": "mutagenic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutagenic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12fb5d00-6ae1-30ed-aafe-df78580b64e0",
                                        "entry_id": "8c1d39e0-3b7c-3399-af0f-af15427fd399",
                                        "glosses": [
                                            "Capable of causing mutation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8346d01-5989-46b4-b2cb-d6e5918c41fe",
                                                "sense_id": "12fb5d00-6ae1-30ed-aafe-df78580b64e0",
                                                "text": "Would it help to say that we misunderestimated the effects of Frankenfood and mutagenic smog, to speculate that amid all our infornography and anticipointment, some crisitunity slumbered unnoticed in a roadside motel?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59d6fc4c-bf79-3278-8ac7-f4872da6003c",
                                        "entry_id": "8c1d39e0-3b7c-3399-af0f-af15427fd399",
                                        "glosses": [
                                            "Relating to mutagenesis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e2e919d-b1fd-45ff-9682-c0d71d6be432",
                                                "sense_id": "59d6fc4c-bf79-3278-8ac7-f4872da6003c",
                                                "text": "For the antimutagenicity evaluation, the same doses of CPN employed in the mutagenic evaluation were co-treated with their respective positive controls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d68cce2-5dfd-4bc8-9eef-78e34619a9e7",
                        "source_entry_id": "8da41991-f305-326a-8a46-d68af6d80429",
                        "source_sense_id": "3958d261-1389-36ad-8ced-a8973e6a0028",
                        "target_lang_word": "mutagène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutagène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09bfefe0-b9da-3cbc-9bf4-a7e5f2811fd9",
                                        "entry_id": "241250c5-0407-3a37-aeb3-4d4255c2f006",
                                        "glosses": [
                                            "Qualifie un agent susceptible de provoquer des mutations de l’ADN (étape initiale de la cancérogenèse) à condition que cette mutation porte sur des gènes impliqués dans le processus de cancérogenèse."
                                        ],
                                        "tags": [
                                            "Toxicologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1c00d91-ad22-460b-b4e9-a3ee0bf8a53a",
                                                "sense_id": "09bfefe0-b9da-3cbc-9bf4-a7e5f2811fd9",
                                                "text": "La classification des mélanges comme cancérigènes, mutagènes ou toxiques pour la reproduction doit être calculée sur la base des informations disponibles relatives aux substances présentes dans le mélange."
                                            },
                                            {
                                                "example_id": "f2172756-e01d-44c1-ac03-5a85a48de479",
                                                "sense_id": "09bfefe0-b9da-3cbc-9bf4-a7e5f2811fd9",
                                                "text": "Non seulement 92 % des Martiniquais et 95 % des Guadeloupéens sont, comme l’a révélé, en février, une étude de santé publique, contaminés par le très redoutable chlordécone, pesticide dont ont été arrosées les bananeraies pendant une vingtaine d’années, de 1972 à 1990, alors qu’on savait qu’il est mutagène et ultra-persistant dans l’environnement…"
                                            },
                                            {
                                                "example_id": "3247077f-d7c9-43b8-b0e0-5bc265cc3d6a",
                                                "sense_id": "09bfefe0-b9da-3cbc-9bf4-a7e5f2811fd9",
                                                "text": "Les MOAH sont très préoccupants. Ils sont soupçonnés d'être cancérogènes et mutagènes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mutagène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "159d652e-7a71-3691-9c02-6fff470bb77f",
                                        "entry_id": "ba0d8434-a59d-3c6f-b345-564a1cd067fd",
                                        "glosses": [
                                            "agent chimique ou physique capable de provoquer une modification du matériel génétique."
                                        ],
                                        "tags": [
                                            "Toxicologie"
                                        ],
                                        "examples": []
                                    }
                                ]
