                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antyfaszystowski",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "29b9c475-2ffb-31e7-821f-185cfe9e2c63",
                                        "entry_id": "f1c7d3d5-dd3a-3dea-bb32-b081fef8a876",
                                        "glosses": [
                                            "nastawiony na walkę z faszyzmem, zwalczający faszystów"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bb8b954-ecda-4f74-bd33-649900ee56d9",
                                                "sense_id": "29b9c475-2ffb-31e7-821f-185cfe9e2c63",
                                                "text": "W młodości Seweryn naprawiał świat wypisując na murach antyfaszystowskie hasła."
                                            }
