                "senses": [
                    {
                        "sense_id": "4fbc29f3-f357-3e29-90c4-f4fdb969da88",
                        "entry_id": "7f70aff6-dc00-33d4-b4bf-63b8262fe47a",
                        "glosses": [
                            "Urkunde, mit welcher der Sieger eines Wettkampfs ausgezeichnet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1228c42a-7116-463c-b9d9-024f7850fa16",
                                "sense_id": "4fbc29f3-f357-3e29-90c4-f4fdb969da88",
                                "text": "„Ab einer bestimmten Mindestpunktzahl gibt es eine Siegerurkunde.“"
                            },
                            {
                                "example_id": "87cacfc8-13e1-4a56-aeab-f44f6199b671",
                                "sense_id": "4fbc29f3-f357-3e29-90c4-f4fdb969da88",
                                "text": "„Ich wurde zutiefst gedemütigt, weil ich im Gegensatz zu meinen Kameraden niemals eine Siegerurkunde bekommen habe.“"
                            },
                            {
                                "example_id": "59e67a08-6284-458d-bd64-174c05e0014f",
                                "sense_id": "4fbc29f3-f357-3e29-90c4-f4fdb969da88",
                                "text": "„Und auch für die Vielseitigkeitswettbewerbe gibt es eine Wertung, sogar mit festgelegten Quoten: Die besten 20 Prozent bekommen eine Ehrenurkunde; die folgenden 50 Prozent eine Siegerurkunde; dem letzten Drittel wird die Teilnahme bescheinigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
