                    {
                        "translation_id": "254f940c-c16a-486b-98d9-0b8747166828",
                        "source_entry_id": "268c547a-2db2-3ebf-a786-fffed76af83a",
                        "source_sense_id": "94276845-7b12-3a57-bdbc-a4ded2991248",
                        "target_lang_word": "Ausgrabung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausgrabung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7fceed3-6aa6-3138-b1c5-f12a602f104a",
                                        "entry_id": "fd5ebb36-4b91-3933-87fa-3a25961fd4b1",
                                        "glosses": [
                                            "die Stelle, an der Ruinen oder Fossilien freigelegt wurden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "656b16a1-42b2-472b-a41f-979d0a7847f3",
                                                "sense_id": "b7fceed3-6aa6-3138-b1c5-f12a602f104a",
                                                "text": "Morgen geht es zur Besichtigung der Ausgrabungen im Norden der Insel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e8a2f1f-9241-3e15-b326-9ea30ff69007",
                                        "entry_id": "fd5ebb36-4b91-3933-87fa-3a25961fd4b1",
                                        "glosses": [
                                            "das Freilegen von Vorgeschichtlichem (zum Beispiel Ruinen oder Siedlungen) oder Fossilien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d593070-dfcb-48cb-810e-55f1d733c795",
                                                "sense_id": "1e8a2f1f-9241-3e15-b326-9ea30ff69007",
                                                "text": "„Wo schriftliche Überlieferungen fehlen, helfen uns die Archäologen mit ihren Ausgrabungen weiter.“"
                                            },
                                            {
                                                "example_id": "b7c5ef0c-06b8-404d-83fa-63f93a41a62c",
                                                "sense_id": "1e8a2f1f-9241-3e15-b326-9ea30ff69007",
                                                "text": "Im Sommer wird Marlies an einer Ausgrabung in Polen teilnehmen."
                                            },
                                            {
                                                "example_id": "ca69a966-ffa9-4935-88ba-66a5be2eecb3",
                                                "sense_id": "1e8a2f1f-9241-3e15-b326-9ea30ff69007",
                                                "text": "Es ist noch unklar, wie das Institut die geplanten Ausgrabungen in Trier finanzieren will."
                                            },
                                            {
                                                "example_id": "e31a290c-fc56-4715-bf79-15d42f307105",
                                                "sense_id": "1e8a2f1f-9241-3e15-b326-9ea30ff69007",
                                                "text": "„Meyer leitet die Ausgrabungen am Harzhorn, wo im Jahr 233 Germanen und Römer erbittert gegeneinander wüteten.“"
                                            },
                                            {
                                                "example_id": "a131a446-88c8-4e51-a42e-c75d1b29aa74",
                                                "sense_id": "1e8a2f1f-9241-3e15-b326-9ea30ff69007",
                                                "text": "„Archäologen entdeckten den Ort 1966 auf Luftbildaufnahmen, Ausgrabungen erbrachten Gräben mit 150 und 180 m Länge, die einen rechteckigen Bezirk abgrenzen.“"
                                            },
                                            {
                                                "example_id": "1a7f00a0-a64d-44df-8b7f-4172c7fdf51e",
                                                "sense_id": "1e8a2f1f-9241-3e15-b326-9ea30ff69007",
                                                "text": "„Bei Ausgrabungen in Manching stießen Archäologen auf das winzige Knöchelchen eines Fisches.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
