                        "sense_id": "f7b4f20a-0a6b-3014-a389-9e9768fe67f7",
                        "entry_id": "5cb25359-c4b2-3934-8411-67d927da3de8",
                        "glosses": [
                            "Très froid, gelé."
                        ],
                        "tags": [
                            "poetic",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4bf967c8-58fa-49c5-8c51-0904bab4a9f6",
                                "sense_id": "f7b4f20a-0a6b-3014-a389-9e9768fe67f7",
                                "text": "Soit aux abords de l’Hélicon plein d’ombre,\n Soit sur le Pinde ou le gélide Hémus,\n Monts où jadis on vit les bois émus\n Suivre Orphée, au doux nombre"
                            },
                            {
                                "example_id": "ba416b28-a7cb-4e2f-bbeb-9e5cbaed03a4",
                                "sense_id": "f7b4f20a-0a6b-3014-a389-9e9768fe67f7",
                                "text": "Dans ces déserts rocailleux cernés par les murailles des infranchissables montagnes, se pressent, sans demeures, sans abris d’aucune espèce, sous les longs fouets excoriants et gélides des bises, des multitudes d’êtres semblables à ce que j’étais…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8934706-50da-43c4-bef9-e372f8723e3f",
                        "source_entry_id": "5cb25359-c4b2-3934-8411-67d927da3de8",
                        "source_sense_id": "f7b4f20a-0a6b-3014-a389-9e9768fe67f7",
                        "target_lang_word": "gelid",
                        "target_lang_code": "en",
