                                "sense_id": "810aba55-263c-329a-acb2-8c08af7504a6",
                                "text": "De meeste paardenstaarten zijn lage gewassen."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e878a09-0bf1-31b0-aee8-1f49cb784e85",
                        "entry_id": "d70a5440-30da-3fa9-b917-fa96f5e5aff4",
                        "glosses": [
                            "haardracht waarbij het haar op het achterhoofd in een bundel wordt samengebonden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c44849f-9abc-4482-ba63-6bd4520d5bdf",
                                "sense_id": "8e878a09-0bf1-31b0-aee8-1f49cb784e85",
                                "text": "Met een elastiekje bond ze haar haar in een paardenstaart."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b4d1edb-bf88-3180-93e8-9cb0c33f6e4e",
                        "entry_id": "d70a5440-30da-3fa9-b917-fa96f5e5aff4",
