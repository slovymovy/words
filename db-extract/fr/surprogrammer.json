                "senses": [
                    {
                        "sense_id": "08e572c3-1069-3e6c-9e35-8ac29b39da74",
                        "entry_id": "50383864-579d-3b53-9552-5a478bb11e2c",
                        "glosses": [
                            "Programmer plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4548093-b52b-4acd-9ea2-6e8922c241b9",
                                "sense_id": "08e572c3-1069-3e6c-9e35-8ac29b39da74",
                                "text": "Il « charge » excessivement leurs motifs d'apparition/escamotage, au risque de surprogrammer leurs déviances"
                            },
                            {
                                "example_id": "4d3526af-b18e-4b61-bde9-54ed8e01e60f",
                                "sense_id": "08e572c3-1069-3e6c-9e35-8ac29b39da74",
                                "text": "L'objectif, dans l'avenir, devrait être de maintenir l'équilibre des genres et de ne pas céder à la tentation de surprogrammer les genres qui réussissent si bien à la chaîne (les variétés, notamment)."
                            },
                            {
                                "example_id": "f0a7466e-dc69-420b-aa2f-c0177cbec33a",
                                "sense_id": "08e572c3-1069-3e6c-9e35-8ac29b39da74",
                                "text": "Tu as été surprogrammé par Blue."
                            }
                        ]
                    }
