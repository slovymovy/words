                                "sense_id": "5b0f8ac4-b4d1-3cf8-96c4-54285e9f33db",
                                "text": "Zounds! here they are. Morrice! Prance!"
                            },
                            {
                                "example_id": "b787b212-64fb-4564-b85f-b40d93cbec5a",
                                "sense_id": "5b0f8ac4-b4d1-3cf8-96c4-54285e9f33db",
                                "text": "Up with you, on your pins. There: now then, Morrice!"
