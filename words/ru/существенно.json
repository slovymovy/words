                {
                    "sense_id": "3eb9c0a0-d917-33d8-b6e7-25d8d2ad80fc",
                    "sense_definition": "В значительной степени, очень сильно или заметно.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В совокупности эти поправки должны <w>существенно</w> упростить возврат денег населению.",
                            "target_lang_translations": {
                                "en": "Taken together, these amendments should <w>substantially</w> simplify the refund process for the population.",
                                "de": "Insgesamt sollten diese Änderungen die Rückerstattung des Geldes an die Bevölkerung <w>erheblich</w> vereinfachen."
                            }
                        },
                        {
                            "text": "Цены на продукты питания <w>существенно</w> выросли за последний год.",
                            "target_lang_translations": {
                                "en": "Food prices have risen <w>significantly</w> over the last year.",
                                "de": "Die Lebensmittelpreise sind im letzten Jahr <w>deutlich</w> gestiegen."
                            }
                        }
                    ],
                    "synonyms": [
                        "значительно",
                        "заметно",
                        "намного"
                    ],
                    "antonyms": [
                        "незначительно",
                        "мало"
                    ],
                    "common_phrases": [
                        "существенно отличается",
                        "существенно повлиять",
                        "существенно выше",
                        "существенно изменить"
                    ],
                    "target_lang_definitions": {
                        "en": "To a significant degree, very strongly, or noticeably.",
                        "de": "In erheblichem Maße, sehr stark oder spürbar."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "significantly",
                                "target_lang_sense_clarification": "in a sufficiently great or important way"
                            },
                            {
                                "target_lang_word": "substantially",
                                "target_lang_sense_clarification": "to a great or significant extent"
                            },
                            {
                                "target_lang_word": "considerably",
                                "target_lang_sense_clarification": "by a notably large amount or to a notably large extent"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erheblich",
                                "target_lang_sense_clarification": "in sehr großem oder bedeutendem Maße"
                            },
                            {
                                "target_lang_word": "wesentlich",
                                "target_lang_sense_clarification": "sehr stark, grundlegend"
                            },
                            {
                                "target_lang_word": "deutlich",
                                "target_lang_sense_clarification": "spürbar oder wahrnehmbar"
                            },
                            {
                                "target_lang_word": "bedeutend",
                                "target_lang_sense_clarification": "in hohem Maße"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ad2f1b5-1b6a-3955-9ea2-b21668e492e5",
                    "sense_definition": "Имеет большое значение; важно (используется как сказуемое).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для исследователей было очень <w>существенно</w>, что препарат не влияет на иммунную систему.",
                            "target_lang_translations": {
                                "en": "It was very <w>important</w> for the researchers that the drug does not affect the immune system.",
                                "de": "Für die Forscher war es sehr <w>wichtig</w>, dass das Medikament das Immunsystem nicht beeinflusst."
                            }
                        },
                        {
                            "text": "Нам <w>существенно</w> знать ваше мнение по этому вопросу.",
                            "target_lang_translations": {
                                "en": "It is <w>essential</w> for us to know your opinion on this matter.",
                                "de": "Es ist für uns <w>wesentlich</w>, Ihre Meinung zu dieser Frage zu kennen."
                            }
                        }
                    ],
                    "synonyms": [
                        "важно",
                        "значимо",
                        "немаловажно"
                    ],
                    "antonyms": [
                        "несущественно",
                        "неважно"
                    ],
                    "common_phrases": [
                        "это существенно",
                        "не существенно",
                        "очень существенно"
                    ],
                    "target_lang_definitions": {
                        "en": "It is of great importance or essential (used as a predicate).",
                        "de": "Ist von großer Bedeutung; wichtig (als Prädikat verwendet)."
                    },
                    "translations": {
                        "en": [
                            {
