                                            {
                                                "example_id": "d1d40149-37f3-4c3c-bd70-4887ce20c4c1",
                                                "sense_id": "d56a8bc8-5b32-3efd-aa45-09102b779279",
                                                "text": "En cas de remboursement, les organismes de Sécurité Sociale et d’Allocations Familiales sont en droit de demander le reversement des prestations servies à l’assuré."
                                            },
                                            {
                                                "example_id": "367ea15f-a53e-4fdc-b31e-f4cb4b6fdc7d",
                                                "sense_id": "d56a8bc8-5b32-3efd-aa45-09102b779279",
                                                "text": "Plus en aval, se pose aussi le problème du contrôle du reversement des sommes aux collectivités locales. Ce problème est de plus en récurrent dans les différents pays africains, renforçant encore plus les contraintes de la décentralisation."
                                            }
