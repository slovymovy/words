                                "es": "Ella está <w>sonriendo</w> a la cámara para la foto."
                            }
                        },
                        {
                            "text": "Why are you <w>smiling</w> so much today?",
                            "target_lang_translations": {
                                "ru": "Почему ты так много <w>улыбаешься</w> сегодня?",
                                "zh": "你今天为什么一直<w>微笑</w>？",
                                "nl": "Waarom ben je vandaag zo veel aan het <w>glimlachen</w>?",
                                "pl": "Dlaczego dzisiaj tak dużo <w>się uśmiechasz</w>?",
                                "de": "Warum <w>lächelst</w> du heute so viel?",
                                "fr": "Pourquoi <w>souris</w>-tu autant aujourd'hui ?",
                                "it": "Perché stai <w>sorridendo</w> così tanto oggi?",
                                "cs": "Proč se dnes tak <w>usmíváš</w>?",
                                "tr": "Bugün neden bu kadar çok <w>gülümseyip</w> duruyorsun?",
                                "es": "¿Por qué estás <w>sonriendo</w> tanto hoy?"
                            }
                        }
                    ],
