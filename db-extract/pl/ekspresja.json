                    },
                    {
                        "sense_id": "75d043b6-ff64-3f80-a657-0c7691047555",
                        "entry_id": "dbcbe0a5-f163-3cdc-8a10-2ee7e06df912",
                        "glosses": [
                            "wyrażenie, w postaci transkryptu RNA lub produktu polipeptydowego, informacji genetycznej zawartej w genomie"
