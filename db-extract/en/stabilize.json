                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39e882f6-d44b-46a4-962b-7d256e6e38a3",
                                                "sense_id": "3f44689b-89d6-368b-ace4-13d4c74aa264",
                                                "text": "Drugi ratownik przecisnął się obok Brodziaka i w chwili, gdy końcówka noszy znalazła się przy drzwiach, zwolnił jakiś zaczep i podobny stelaż z kółkami opadł na dół, stabilizując wózek"
                                            }
