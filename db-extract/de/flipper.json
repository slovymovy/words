                                "example_id": "4ca41f48-f50e-41fa-9df7-2fddc696e0dd",
                                "sense_id": "ce9bef73-e6fc-3f74-a068-f3dbdc94822b",
                                "text": "Der Delfin hat eine Verletzung am linken Flipper."
