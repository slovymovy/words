                        "entry_id": "8cf29399-43af-3e30-b4e9-4ca651fdcb97",
                        "glosses": [
                            "genootschap van mannen die zich voor een bepaald doel verenigd hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4af53ae7-5e7d-4ffe-ac3e-f8cf07d36e7a",
                                "sense_id": "5199bccc-1506-38a5-b3c4-89b3e897b6d7",
                                "text": "Voor het eerst deed hij mee aan de internationale titelstrijd van La Confrérie des Chevaliers du Goute-Andouille."
                            },
                            {
                                "example_id": "11d3bc4c-a011-4033-98c4-e9574b0a5b3c",
                                "sense_id": "5199bccc-1506-38a5-b3c4-89b3e897b6d7",
                                "text": "Erkenning kwam drie jaar later toen de wijnen van Landgoed Overst met het kwaliteitskeurmerk van de Confrérie des Chevaliers du Vin Limbourgeois werden onderscheiden."
                            },
                            {
                                "example_id": "5b970991-4074-4a4b-ab56-640296126000",
                                "sense_id": "5199bccc-1506-38a5-b3c4-89b3e897b6d7",
                                "text": "Rond 1500 was de kathedraal een ontmoetingsplek voor broederschappen die hun geloof beleden met zang en rituelen, onder namen als de fraterniteit van de Heilige Besnijdenis, of de confrérie van het Heilig Sacrament."
                            }
                        ]
