                ],
                "senses": [
                    {
                        "sense_id": "9b057879-cfc2-3f1a-a2cb-7ecc38e8cac9",
                        "entry_id": "fe9bd565-ef51-395d-afb3-f2eb718359cb",
                        "glosses": [
                            "ползя, забираться куда-либо, внутрь чего-либо, взбираться на что-либо ползком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95dfc87e-1bd5-40bd-867b-b85830d1e5ff",
                                "sense_id": "9b057879-cfc2-3f1a-a2cb-7ecc38e8cac9",
                                "text": "Антоша смотрит, как мухи вползают в дырочку, и смотрит долго-долго…"
                            }
                        ]
                    },
                    {
                        "sense_id": "b346de6b-fd35-3332-80a5-212678fe8e83",
                        "entry_id": "fe9bd565-ef51-395d-afb3-f2eb718359cb",
                        "glosses": [
                            "перен., разг. медленно проникать куда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46590d20-6dcc-4d7a-9a40-f528eb1f6044",
                                "sense_id": "b346de6b-fd35-3332-80a5-212678fe8e83",
                                "text": "Страх вползает в его душу."
                            },
                            {
                                "example_id": "265144ff-78b7-4f0e-891c-e80ee76ad76d",
                                "sense_id": "b346de6b-fd35-3332-80a5-212678fe8e83",
                                "text": "Когда же дул ветер с болот, сырой смрад вползал в Вавилон."
                            },
                            {
                                "example_id": "ed607585-5fb5-4ab3-bdb3-a29a63b0786f",
                                "sense_id": "b346de6b-fd35-3332-80a5-212678fe8e83",
                                "text": "Ранний зимний вечер уже вползал в комнату, и уже берегли свечи."
                            }
                        ]
                    },
                    {
                        "sense_id": "b539a9aa-1a9d-364e-8dfc-37e30aee1c37",
                        "entry_id": "fe9bd565-ef51-395d-afb3-f2eb718359cb",
                        "glosses": [
                            "перен., разг. с трудом подниматься куда-либо или на что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b728efc1-6dd1-4c79-abac-ecef66e1fec1",
                                "sense_id": "b539a9aa-1a9d-364e-8dfc-37e30aee1c37",
                                "text": "Но пушка подавалась туго. Она лениво вползала вверх, как стопудовая черепаха."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
