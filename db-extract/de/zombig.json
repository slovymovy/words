                "senses": [
                    {
                        "sense_id": "33bd9542-9995-32bd-9022-c7e034056470",
                        "entry_id": "662cd411-c6a2-3e52-8e3b-c1bb0cd2712a",
                        "glosses": [
                            "großartig, hervorragend"
                        ],
                        "tags": [
                            "Jugendsprache",
                            "Slang"
                        ],
                        "examples": [
                            {
                                "example_id": "980abab2-e02e-4374-b252-14a5b3d99d33",
                                "sense_id": "33bd9542-9995-32bd-9022-c7e034056470",
                                "text": "In seinem Buch Deutsch für Kenner: Die neue Stilkunde schreibt Wolf Schneider: „Was sie schlecht finden, ist ätzend oder schrill, was sie loben wollen, ist fetzig, zombig und galaktisch.“"
                            },
                            {
                                "example_id": "9d2f09b9-58ad-44be-9c11-c5a71bb7126e",
                                "sense_id": "33bd9542-9995-32bd-9022-c7e034056470",
                                "text": "»Bist eine echt zombige Tante! Galaktisch!« Sein Hundeblick blieb an Rositas drallen Kurven kleben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
