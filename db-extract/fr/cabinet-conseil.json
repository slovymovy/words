                    {
                        "sense_id": "f3afd366-349c-325d-a464-3ca958b171f3",
                        "entry_id": "41c58988-7bea-3bc4-a971-f3ff4e51a5dd",
                        "glosses": [
                            "Entreprise spécialisée dans le conseil auprès d’autres entreprises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b595d78c-4c62-4058-bfd8-4e1287b2a489",
                                "sense_id": "f3afd366-349c-325d-a464-3ca958b171f3",
                                "text": "Avant d’ouvrir mon cabinet-conseil, j’ai travaillé pendant deux années sur ce projet, explique Sophie Laborde-Balen."
                            },
                            {
                                "example_id": "025c1c93-fcaf-4c3d-975c-7712c7fc6752",
                                "sense_id": "f3afd366-349c-325d-a464-3ca958b171f3",
                                "text": "Les prestations des cabinets-conseil couvrent l’ensemble des domaines de la gestion des ressources humaines : bilans d’évaluation du personnel, audit social et organisationnel, gestion du changement, outplacement, formation, coaching."
                            },
                            {
                                "example_id": "0857d17b-a836-4f61-b9ef-865ac368425d",
                                "sense_id": "f3afd366-349c-325d-a464-3ca958b171f3",
                                "text": "« L'indépendance des cabinets-conseil doit être, en effet, clairement établie vis-à-vis des banques, la déontologie imposant la dissociation des activités de conseil et de prêteur »."
                            }
                        ]
                    }
