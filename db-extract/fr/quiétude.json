        "fr-extract.jsonl": [
            {
                "entry_id": "6fe916d1-0bf0-3aad-a552-4228d38cb243",
                "word": "quiétude",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cc89d0fd-19b2-4335-879a-17e9bd78afd8",
                        "entry_id": "6fe916d1-0bf0-3aad-a552-4228d38cb243",
                        "tags": [
                            "plural"
                        ],
                        "form": "quiétudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "271e8425-ca45-3c16-a9dc-7c8fdfd8817a",
                        "entry_id": "6fe916d1-0bf0-3aad-a552-4228d38cb243",
                        "glosses": [
                            "Tranquillité ; repos."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "228aa0df-9d27-4b95-bcf4-a83d7fbc9d61",
                                "sense_id": "271e8425-ca45-3c16-a9dc-7c8fdfd8817a",
                                "text": "Les jours s’écoulaient, paisibles, en une grande quiétude, sans aventures et sans accidents."
                            },
                            {
                                "example_id": "8dbbc08b-a9b7-46a0-a4f2-ec1ee7db8302",
                                "sense_id": "271e8425-ca45-3c16-a9dc-7c8fdfd8817a",
                                "text": "[…]; des grappes de consommateurs pleins de quiétude, goûtaient aux tables des terrasses toute l’exquisité de l’heure apéritive."
                            },
                            {
                                "example_id": "e3b19b46-9853-4210-9569-d02716f9c084",
                                "sense_id": "271e8425-ca45-3c16-a9dc-7c8fdfd8817a",
                                "text": "Zaheira, sans écouter les supplications de son amie d’enfance, décida de regagner au plus vite sa quiétude de la campagne."
                            },
                            {
                                "example_id": "0003b593-0e7d-45f5-99da-22cfee1b544a",
                                "sense_id": "271e8425-ca45-3c16-a9dc-7c8fdfd8817a",
                                "text": "[…] qu'avant les grandes bandes blanches qui permettent de traverser les rues en toute quiétude ou de se faire écraser dans son droit, il y avait de jolis clous argentés qui délimitaient les passages pour piétons."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2be9d48-859c-3a23-9c60-33a70442a61a",
                        "entry_id": "6fe916d1-0bf0-3aad-a552-4228d38cb243",
                        "glosses": [
                            "Pratique du quiétisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f54739c4-7b43-46d4-a3ee-ee78027bf9cb",
                                "sense_id": "a2be9d48-859c-3a23-9c60-33a70442a61a",
                                "text": "[…], s’il diffère des quiétistes absolus qu’il affecte de condamner, c’est moins pour le fonds de la doctrine que pour le degré où il admet cette doctrine. Il croit faire beaucoup en disant que l’état de quiétude où l’âme perd l’activité, n’est pas un état perpétuellement passif, mais passif habituellement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a417cd60-a6d6-4b97-8fb1-26235be9cf99",
                        "source_entry_id": "6fe916d1-0bf0-3aad-a552-4228d38cb243",
                        "target_lang_word": "Stille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d9b12e8-0202-3424-a09a-17b65a9e9f1e",
                                        "entry_id": "dce68685-64c8-3513-aba8-4235a0961c6e",
                                        "glosses": [
                                            "die Abwesenheit von akustischen Signalen wie Lärm, Musik, Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aace6b3-8525-4325-8a62-8ea7722a52f0",
                                                "sense_id": "4d9b12e8-0202-3424-a09a-17b65a9e9f1e",
                                                "text": "Was für eine Stille das ist, wenn die Spülmaschine plötzlich fertig ist!"
                                            },
                                            {
                                                "example_id": "6ba483ca-8aca-4097-ba5a-caa9a17ccfca",
                                                "sense_id": "4d9b12e8-0202-3424-a09a-17b65a9e9f1e",
                                                "text": "„Ich lausche ihr, der Stille in dem Zimmer, die mich schwach macht.“"
                                            },
                                            {
                                                "example_id": "484ea3a6-b542-4e32-8adb-ec1fe7db7afd",
                                                "sense_id": "4d9b12e8-0202-3424-a09a-17b65a9e9f1e",
                                                "text": "„Die Leserin in ihr zog die Stille und Feinsinnigkeit von A. Monnier vor.“"
                                            },
                                            {
                                                "example_id": "29c64bfe-7de1-4ddb-8d90-78ebb02f492e",
                                                "sense_id": "4d9b12e8-0202-3424-a09a-17b65a9e9f1e",
                                                "text": "„In der Stille hallte das Knarren der Schuhe wider – es war nicht viel los an diesem Samstagmorgen spät im November.“"
                                            },
                                            {
                                                "example_id": "0448ebac-9e63-4c99-8fbf-21a1c4d1a2ca",
                                                "sense_id": "4d9b12e8-0202-3424-a09a-17b65a9e9f1e",
                                                "text": "„Manchmal ging Ari nachts spazieren, im Sommer wie im Winter, und fühlte sich wie in eine Zauberwelt versetzt, wenn das Dorf in diese friedliche Stille getaucht war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1fe35a31-d6dc-3560-9aa4-9d63fb841958",
                                        "entry_id": "dce68685-64c8-3513-aba8-4235a0961c6e",
                                        "glosses": [
                                            "die Abwesenheit von Bewegung, Zustand des Stillseins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ba7f498-2be3-4e85-9d97-593af9e491a7",
                                                "sense_id": "1fe35a31-d6dc-3560-9aa4-9d63fb841958",
                                                "text": "Der Frosch verharrt in Stille. Kommen wir näher, springt er schnell weg."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Stille",
                                "target_lang_code": "de",
                                "target_senses": [
