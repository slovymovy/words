                        "sense_id": "1a01e732-e35b-3776-89cf-6508a0c8d7d9",
                        "entry_id": "220a6049-d965-33d1-89b1-1814d10dd2d4",
                        "glosses": [
                            "ein in Ostfriesland (Deutschland) geborener oder dort auf Dauer lebender Mensch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97581fc8-7c35-480b-8ffb-7c9e6b602227",
                                "sense_id": "1a01e732-e35b-3776-89cf-6508a0c8d7d9",
                                "text": "„Was den Ostfriesen im Witz vorgeworfen wird, ist zivilisatorische Rückständigkeit, Dummheit und Unsauberkeit.“"
                            },
                            {
                                "example_id": "2dc8a8fa-c8b8-4477-a683-0ec24f83e70d",
                                "sense_id": "1a01e732-e35b-3776-89cf-6508a0c8d7d9",
                                "text": "„Ein Ostfriese will eine Hühnerfarm aufbauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
