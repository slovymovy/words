                "translations": [
                    {
                        "translation_id": "585f1abe-a982-42e2-885a-a0cb8beb870f",
                        "source_entry_id": "ba83b5ec-7c09-3f06-bd3f-09bea92522e1",
                        "source_sense_id": "1ba5d883-4321-3b11-8399-32c2d8472926",
                        "source_sense_description": "von Mitgefühl zeugend; Mitgefühls-, aus Mitgefühl",
                        "target_lang_word": "Mitgefühl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitgefühl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bea05d9-b6a4-3077-90f0-58d22b72c4ac",
                                        "entry_id": "3394060b-c4a9-309a-ab4c-b821dce7dfc0",
                                        "glosses": [
                                            "Teilnahme am Leid anderer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91a68294-f697-4a82-bc35-e976e4af405a",
                                                "sense_id": "2bea05d9-b6a4-3077-90f0-58d22b72c4ac",
                                                "text": "„Wer wirkliches Mitgefühl hat, leistet tätige Hilfe oder versucht, durch besondere Rücksicht oder ein gutes Wort den Schmerz zu lindern.“"
                                            },
                                            {
                                                "example_id": "fcbfc498-3ead-4b04-a0ac-f1f83d90b9de",
                                                "sense_id": "2bea05d9-b6a4-3077-90f0-58d22b72c4ac",
                                                "text": "„Wenn wir glauben, uns zu persönlichem Erscheinen entschließen zu können, dann seien wir uns darüber klar, daß unsere Aufgabe nicht so sehr darin liegt, unser Mitgefühl zum Ausdruck zu bringen, als vielmehr im Trost und in der Aufrichtung.“"
                                            },
                                            {
                                                "example_id": "19e71f4c-7a0b-4a49-a686-614b2c08d256",
                                                "sense_id": "2bea05d9-b6a4-3077-90f0-58d22b72c4ac",
                                                "text": "„Wer zu Beginn bei seinem Anblick nur Mitgefühl und Rührung verspürt hatte, der war nun von nackter Begehrlichkeit erfüllt, wer zunächst bewundert und begehrt hatte, den trieb es zur Ekstase.“"
                                            },
                                            {
                                                "example_id": "e117949c-d6d9-4b20-a4e8-09023dbe2f2b",
                                                "sense_id": "2bea05d9-b6a4-3077-90f0-58d22b72c4ac",
                                                "text": "„Ihr Verhalten verriet weder Mitleid noch Mitgefühl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
