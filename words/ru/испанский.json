                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Spaans",
                                "target_lang_sense_clarification": "aanduiding van oorsprong van producten of goederen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65c61dbb-804d-3795-8761-2591ba2e3bd3",
                    "sense_definition": "Испанский язык (субстантивированное прилагательное).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "лингвистика",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он переводит с <w>испанского</w> на русский.",
                            "target_lang_translations": {
                                "nl": "Hij vertaalt vanuit het <w>Spaans</w> naar het Russisch."
                            }
                        },
                        {
                            "text": "Мой друг отлично владеет <w>испанским</w>.",
                            "target_lang_translations": {
