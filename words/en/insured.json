{
    "word_family": [
        "insure",
        "insurance",
        "insurer",
        "insuree",
        "insurable",
        "insurability"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "707ab0bd-5ed2-3fc3-8853-45d87fb1bb0b",
                    "sense_definition": "Covered by an insurance policy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>insured</w> vehicle was repaired at no extra cost.",
                            "target_lang_translations": {
                                "ru": "<w>Застрахованный</w> автомобиль был отремонтирован без дополнительных затрат.",
                                "zh": "那辆<w>已投保的</w>车辆在维修时没有产生额外费用。",
                                "es": "El vehículo <w>asegurado</w> fue reparado sin costo adicional."
                            }
                        },
                        {
                            "text": "It is important to have an <w>insured</w> value for your jewelry.",
                            "target_lang_translations": {
                                "ru": "Важно определить <w>страховую</w> стоимость для ваших ювелирных изделий.",
                                "zh": "为你的珠宝设定一个<w>投保</w>价值很重要。",
                                "es": "Es importante tener un valor <w>asegurado</w> para sus joyas."
                            }
                        }
                    ],
                    "antonyms": [
                        "uninsured"
                    ],
                    "common_phrases": [
                        "fully insured",
                        "insured value",
                        "insured person"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый страховым полисом; имеющий страховку.",
                        "zh": "指受到保险单保障的。",
                        "es": "Que cuenta con una póliza de seguro o cobertura."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застрахованный",
                                "target_lang_sense_clarification": "покрытый страховкой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "已投保的",
                                "target_lang_sense_clarification": "指财产或物品已购买保险"
                            },
                            {
                                "target_lang_word": "受保的",
                                "target_lang_sense_clarification": "指处于保险覆盖范围内的"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "asegurado",
                                "target_lang_sense_clarification": "que tiene cobertura de seguro"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8bb17ad7-aaa2-361a-9e6b-87d099364c07",
                    "sense_definition": "Simple past and past participle of <w>insure</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>insured</w> our luggage before the trip.",
                            "target_lang_translations": {
                                "ru": "Мы <w>застраховали</w> наш багаж перед поездкой.",
                                "zh": "我们在旅行前为行李<w>投保</w>了。",
                                "es": "Nosotros <w>aseguramos</w> nuestro equipaje antes del viaje."
                            }
                        },
                        {
                            "text": "She <w>insured</w> her car against theft and damage.",
                            "target_lang_translations": {
                                "ru": "Она <w>застраховала</w> свою машину от угона и повреждений.",
                                "zh": "她为自己的车<w>投保</w>了防盗和防损险。",
                                "es": "Ella <w>aseguró</w> su coche contra robo y daños."
                            }
                        }
                    ],
                    "common_phrases": [
                        "insured against",
                        "insured for"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «страховать».",
                        "zh": "动词 insure 的过去式和过去分词，意为购买保险或为……投保。",
                        "es": "Pasado simple y participio pasado del verbo asegurar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застраховал",
                                "target_lang_sense_clarification": "глагол в прошедшем времени"
                            },
                            {
                                "target_lang_word": "застрахованный",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投保",
                                "target_lang_sense_clarification": "为某物购买保险"
                            },
                            {
                                "target_lang_word": "为……投保",
                                "target_lang_sense_clarification": "对特定对象进行保险覆盖"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "aseguró",
                                "target_lang_sense_clarification": "verbo en pasado"
                            },
                            {
                                "target_lang_word": "asegurado",
                                "target_lang_sense_clarification": "participio"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "44f4b84c-1128-355e-886a-adba33a65e2c",
                    "sense_definition": "The person or persons whose interests are protected by an insurance policy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>insured</w> must file the claim within thirty days.",
                            "target_lang_translations": {
                                "ru": "<w>Застрахованное лицо</w> должно подать заявление в течение тридцати дней.",
                                "zh": "<w>被保险人</w>必须在三十天内提出索赔。",
                                "es": "El <w>asegurado</w> debe presentar la reclamación en un plazo de treinta días."
                            }
                        },
                        {
                            "text": "Any damage caused by the <w>insured</w> is covered.",
                            "target_lang_translations": {
                                "ru": "Любой ущерб, причиненный <w>застрахованным</w>, покрывается.",
                                "zh": "由<w>被保险人</w>造成的任何损失都在承保范围内。",
                                "es": "Cualquier daño causado por el <w>asegurado</w> está cubierto."
                            }
                        }
                    ],
                    "synonyms": [
                        "insuree",
                        "insurant"
                    ],
                    "common_phrases": [
                        "named insured",
                        "additional insured"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо или лица, чьи интересы защищены страховым полисом.",
                        "zh": "指保险合同中受保障的个人或群体。",
                        "es": "La persona o personas cuyos intereses están protegidos por una póliza de seguro."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застрахованное лицо",
                                "target_lang_sense_clarification": "официальный термин"
                            },
                            {
                                "target_lang_word": "застрахованный",
                                "target_lang_sense_clarification": "субстантивированное прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "被保险人",
                                "target_lang_sense_clarification": "保险合同中的法律术语"
                            },
                            {
                                "target_lang_word": "受保人",
                                "target_lang_sense_clarification": "指享受保险保障的人"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "asegurado",
                                "target_lang_sense_clarification": "persona protegida por el seguro"
                            },
                            {
                                "target_lang_word": "tomador del seguro",
                                "target_lang_sense_clarification": "término legal para quien contrata el seguro"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}