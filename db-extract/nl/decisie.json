                                        "entry_id": "3e2720f8-5d31-3350-b9bc-67546c699e68",
                                        "glosses": [
                                            "A choice or judgement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3b131f4-a52a-450d-b9cd-37e271496237",
                                                "sense_id": "88a0e303-7bb9-3320-9598-6deb65ca2e13",
                                                "text": "It is the decision of the court that movies are protected as free speech."
                                            },
                                            {
                                                "example_id": "5ae22cf8-46e9-4d0c-ac99-b8484cd3d21a",
                                                "sense_id": "88a0e303-7bb9-3320-9598-6deb65ca2e13",
                                                "text": "His life has always been filled with big decisions."
                                            },
                                            {
                                                "example_id": "08807696-8667-41f3-ab04-bc0a3aeec550",
                                                "sense_id": "88a0e303-7bb9-3320-9598-6deb65ca2e13",
                                                "text": "It's a tough decision, but I'll take vanilla."
                                            },
                                            {
                                                "example_id": "80aa94fd-f5a0-4358-b6f1-71d1ed87cd02",
                                                "sense_id": "88a0e303-7bb9-3320-9598-6deb65ca2e13",
                                                "text": "I told him about my decision to leave forever."
                                            },
                                            {
                                                "example_id": "0d5bbd8e-9aa9-4ecb-97ce-d4a2a4ed965f",
                                                "sense_id": "88a0e303-7bb9-3320-9598-6deb65ca2e13",
                                                "text": "The US supreme court has ruled unanimously that natural human genes cannot be patented, a decision that scientists and civil rights campaigners said removed a major barrier to patient care and medical innovation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06b97490-7ed0-3af5-aab9-fe6c46cdd5d3",
                                        "entry_id": "3e2720f8-5d31-3350-b9bc-67546c699e68",
                                        "glosses": [
                                            "Firmness of conviction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2179d8a-1b7a-4de9-ab59-ef7510214f4e",
                                                "sense_id": "06b97490-7ed0-3af5-aab9-fe6c46cdd5d3",
                                                "text": "After agonizing deliberations, they finally proceeded with decision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "007f6e73-60ad-346d-81ec-969e562c26cd",
                                        "entry_id": "3e2720f8-5d31-3350-b9bc-67546c699e68",
                                        "glosses": [
                                            "A result arrived at by the judges when there is no clear winner at the end of the contest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94e7897c-a241-4dd0-a184-60077e142231",
                                                "sense_id": "007f6e73-60ad-346d-81ec-969e562c26cd",
                                                "text": "He has won twice by knockout, once by decision."
                                            }
