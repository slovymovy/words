                        "tags": [
                            "plural"
                        ],
                        "form": "desmans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "42095d44-cf48-3e85-87fe-ea33492f5c65",
                        "entry_id": "55779a49-f33f-30cf-9d63-07c9c675e56c",
                        "glosses": [
                            "Espèce de mammifère insectivore, voisin de la taupe, à museau ou trompe mobile, à queue longue, écailleuse, aplatie, vivant le long des rivières, et bon nageurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fd7f58b-99a8-41d1-8769-686ec64e826e",
                                "sense_id": "42095d44-cf48-3e85-87fe-ea33492f5c65",
                                "text": "Le desman de la Sibérie était connu plus d’un demi-siècle avant celui des Pyrénées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c375d2e1-12c6-46db-b0cd-643e140a7387",
                        "source_entry_id": "55779a49-f33f-30cf-9d63-07c9c675e56c",
                        "source_sense_id": "42095d44-cf48-3e85-87fe-ea33492f5c65",
                        "target_lang_word": "Desman",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Desman",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eacd4534-5cb5-3130-be12-b0b63f4c5423",
                                        "entry_id": "19534d30-f0d3-3ddb-8a72-a1fb169d1683",
                                        "glosses": [
                                            "maulwurfsartiger, im Wasser lebender Insektenfresser; an der Wolga, im Ural und den Pyrenäen verbreitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24e75636-7c27-49ce-bf5a-1c9b548ebefd",
                                                "sense_id": "eacd4534-5cb5-3130-be12-b0b63f4c5423",
                                                "text": "Die Desmane leben heute noch in den Pyrenäen und in Rußland; früher waren sie erheblich weiter verbreitet."
                                            },
                                            {
                                                "example_id": "060d96af-0658-4dfc-8d0c-3c3153cfdfbf",
                                                "sense_id": "eacd4534-5cb5-3130-be12-b0b63f4c5423",
                                                "text": "Sieh, ein Desman! Genauer gesagt, ein Wychochul!"
                                            },
                                            {
                                                "example_id": "493541d2-33e2-40dc-ae1f-39ea6a9cb49e",
                                                "sense_id": "eacd4534-5cb5-3130-be12-b0b63f4c5423",
                                                "text": "Der Desman hat an jedem Fuß fünf mit Schwimmhäuten verbundene Zehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13aaf289-33cc-4dd5-9ca0-3696760b3c6f",
                        "source_entry_id": "55779a49-f33f-30cf-9d63-07c9c675e56c",
                        "source_sense_id": "42095d44-cf48-3e85-87fe-ea33492f5c65",
                        "target_lang_word": "desman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae2a415f-5c16-38aa-9ca8-ea8ca2134878",
                                        "entry_id": "01c03ef1-6eb9-3800-9b48-65db2ad17f92",
                                        "glosses": [
                                            "Either of two species, Desmana moschata or Galemys pyrenaicus, of aquatic or semiaquatic insectivore of the mole family, Talpidae, found in Europe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a32d0e4-f48c-476e-9595-5b116dcc31bf",
                                                "sense_id": "ae2a415f-5c16-38aa-9ca8-ea8ca2134878",
                                                "text": "Unlike the Russian desman, the Pyrenean species lives along fast-flowing mountain streams."
                                            },
                                            {
                                                "example_id": "94cead33-e32e-4689-b97f-4fcd9a9cedf2",
                                                "sense_id": "ae2a415f-5c16-38aa-9ca8-ea8ca2134878",
                                                "text": "Restricted to the Old World, desmans have a diet consisting of aquatic invertebrates and fish."
                                            },
                                            {
                                                "example_id": "ba294c0c-de3c-4db0-af7f-2940c2747887",
                                                "sense_id": "ae2a415f-5c16-38aa-9ca8-ea8ca2134878",
                                                "text": "With the aid of its Eimer's organs, the desman was able to detect engraved lines only one-fifteenth of a millimeter (0.067 mm, or 0.002 inches) in depth and width. There are two extant species of desmans: the Pyrenean desman (Galemys pyrenaicus), weighing about 65 g (2.3 oz) (fig 2.10), and the larger Russian desman (Desmana moschata), weighing 500 g (17.6 oz)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
