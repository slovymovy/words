                        "sense_id": "f2c3c048-0c5d-3234-b8a9-7906542d7cf6",
                        "entry_id": "7f4ab8eb-170b-356d-8e24-caf4f7ddfcf8",
                        "glosses": [
                            "związany z kompozycją, dotyczący kompozycji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33c7ac80-3af4-42d9-8b06-845fc707a5b5",
                                "sense_id": "f2c3c048-0c5d-3234-b8a9-7906542d7cf6",
                                "text": "W pejzażach z ziemi olkuskiej stosowała różne metody kompozycyjne: bliskiego kadru, szerokiej perspektywy lub spojrzenia z podniesionego punktu obserwacji"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfe6faf5-ebc2-4398-a948-f8b4c9ecd002",
                        "source_entry_id": "7f4ab8eb-170b-356d-8e24-caf4f7ddfcf8",
                        "source_sense_id": "f2c3c048-0c5d-3234-b8a9-7906542d7cf6",
                        "target_lang_word": "compositional",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compositional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5909c8a-8041-3e5d-9e6a-8d1dc93b8e89",
                                        "entry_id": "4016a918-8638-38ae-a2b0-19ab93ae5b64",
                                        "glosses": [
                                            "Of or pertaining to composition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98639552-7679-43c4-b7fe-44c3003f1633",
                                                "sense_id": "f5909c8a-8041-3e5d-9e6a-8d1dc93b8e89",
                                                "text": "The compositional aspects of this work are less than ideal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5e9d4b2-1451-3181-8c0a-da2b102bc505",
                                        "entry_id": "4016a918-8638-38ae-a2b0-19ab93ae5b64",
                                        "glosses": [
                                            "Being the sum of its parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af9558c9-f0f4-4456-a321-f31f334de8f2",
                                                "sense_id": "f5e9d4b2-1451-3181-8c0a-da2b102bc505",
                                                "text": "The phrase \"sum of its parts\" is entirely compositional."
                                            },
                                            {
                                                "example_id": "7f05b3e8-7320-4dcd-b924-c6c4ee784f26",
                                                "sense_id": "f5e9d4b2-1451-3181-8c0a-da2b102bc505",
                                                "text": "A wet súit meaning a suit that is wet is a compositional phrase; a wét suit meaning a garment worn by skin divers is a compound."
                                            },
                                            {
                                                "example_id": "71d9739c-79c8-4708-8dfc-ec302b10a92b",
                                                "sense_id": "f5e9d4b2-1451-3181-8c0a-da2b102bc505",
                                                "text": "We have already noted that compounds tend to have meanings that are not entirely compositional and would therefore need to be listed."
                                            },
                                            {
                                                "example_id": "58c047bf-0cb3-4930-877e-d19062e2fa70",
                                                "sense_id": "f5e9d4b2-1451-3181-8c0a-da2b102bc505",
                                                "text": "Sentence meaning is compositional because, to a large extent, it depends on a combination of the meanings of sentence constituents, which implies the concept of semantic structure."
                                            },
                                            {
                                                "example_id": "9bd2648d-26a0-45d0-a46e-4b5984623546",
                                                "sense_id": "f5e9d4b2-1451-3181-8c0a-da2b102bc505",
                                                "text": "To cite a textbook example, white house and White House are both written with internal spaces, but the first is argued to be a phrase because it is semantically compositional and has phrase-final stress, while the latter is argued to be a word because it has noncompositional semantics and compound-initial stress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9b589db-aa65-465b-88a5-0fb4c4398cc1",
                        "source_entry_id": "7f4ab8eb-170b-356d-8e24-caf4f7ddfcf8",
                        "source_sense_id": "f2c3c048-0c5d-3234-b8a9-7906542d7cf6",
