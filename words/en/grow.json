{
    "word_family": [
        "growth",
        "grower",
        "outgrow",
        "regrow",
        "overgrow",
        "upgrown",
        "grown-up"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c70822e9-4775-3f84-afda-a7a339fdfab4",
                    "sense_definition": "To become larger in size, amount, or degree.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children <w>grow</w> very quickly during their first few years of life.",
                            "target_lang_translations": {
                                "ru": "Дети <w>растут</w> очень быстро в первые несколько лет жизни."
                            }
                        },
                        {
                            "text": "The company expects to <w>grow</w> rapidly in the coming year.",
                            "target_lang_translations": {
                                "ru": "Компания ожидает стремительно <w>вырасти</w> в следующем году."
                            }
                        }
                    ],
                    "antonyms": [
                        "shrink"
                    ],
                    "common_phrases": [
                        "grow quickly",
                        "grow rapidly",
                        "continue to grow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличиваться в размере, количестве или степени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расти",
                                "target_lang_sense_clarification": "увеличиваться в размерах или количестве"
                            },
                            {
                                "target_lang_word": "вырастать",
                                "target_lang_sense_clarification": "становиться больше"
                            },
                            {
                                "target_lang_word": "увеличиваться",
                                "target_lang_sense_clarification": "о количестве или объеме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4eeb487d-d306-3904-8fa0-8bc993ff1fdc",
                    "sense_definition": "To exist or thrive in a particular place or environment, especially of plants.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Apples now <w>grow</w> all over the world in various climates.",
                            "target_lang_translations": {
                                "ru": "Яблоки сейчас <w>растут</w> по всему миру в самых разных климатических условиях."
                            }
                        },
                        {
                            "text": "Wild flowers <w>grow</w> wild along the side of the road.",
                            "target_lang_translations": {
                                "ru": "По обочинам дорог <w>растут</w> дикие цветы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grow wild",
                        "grow in gardens",
                        "grow everywhere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существовать или процветать в определенном месте или среде (особенно о растениях)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расти",
                                "target_lang_sense_clarification": "о растениях в определенной среде"
                            },
                            {
                                "target_lang_word": "произрастать",
                                "target_lang_sense_clarification": "книжное, о флоре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07dfb2cc-8532-34ad-9f50-628ef82ace12",
                    "sense_definition": "To cultivate plants or to allow something like hair or a beard to become longer.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cultivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>grows</w> peppers and squash each summer in his small garden.",
                            "target_lang_translations": {
                                "ru": "Каждое лето он <w>выращивает</w> перец и кабачки в своем маленьком саду."
                            }
                        },
                        {
                            "text": "He decided to <w>grow</w> a beard over the winter break.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>отрастить</w> бороду за время зимних каникул."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grow a beard",
                        "grow vegetables",
                        "grow your hair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выращивать растения или позволять волосам или бороде становиться длиннее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выращивать",
                                "target_lang_sense_clarification": "овощи, цветы или кристаллы"
                            },
                            {
                                "target_lang_word": "отращивать",
                                "target_lang_sense_clarification": "волосы или бороду"
                            },
                            {
                                "target_lang_word": "растить",
                                "target_lang_sense_clarification": "ухаживать, обеспечивая рост"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa7a7e66-7ca2-3653-81e9-f9253f4cb451",
                    "sense_definition": "To develop physically, mentally, or emotionally toward maturity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As I <w>grew</w> throughout adolescence, I came to appreciate many things about human nature.",
                            "target_lang_translations": {
                                "ru": "По мере того как я <w>взрослел</w> в подростковом возрасте, я начал ценить многие вещи в человеческой природе."
                            }
                        },
                        {
                            "text": "The experience helped her <w>grow</w> as a person and a professional.",
                            "target_lang_translations": {
                                "ru": "Этот опыт помог ей <w>вырасти</w> как личности и как профессионалу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grow as a person",
                        "grow in confidence",
                        "grow through experience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Развиваться физически, умственно или эмоционально по направлению к зрелости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расти",
                                "target_lang_sense_clarification": "развиваться как личность"
                            },
                            {
                                "target_lang_word": "взрослеть",
                                "target_lang_sense_clarification": "становиться старше и мудрее"
                            },
                            {
                                "target_lang_word": "развиваться",
                                "target_lang_sense_clarification": "совершенствоваться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "447d18b8-4fc9-34dc-bb8c-9eb38dd1d5ca",
                    "sense_definition": "To gradually become or assume a specific quality or condition.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rooms began to <w>grow</w> dim as the sun started to set.",
                            "target_lang_translations": {
                                "ru": "В комнатах начало <w>темнеть</w>, когда солнце стало садиться."
                            }
                        },
                        {
                            "text": "The two neighbors <w>grew</w> fond of each other over the years.",
                            "target_lang_translations": {
                                "ru": "За эти годы двое соседей <w>прониклись</w> симпатией друг к другу."
                            }
                        }
                    ],
                    "synonyms": [
                        "become#Verb",
                        "get",
                        "wax",
                        "turn",
                        "go"
                    ],
                    "common_phrases": [
                        "grow dim",
                        "grow fond of",
                        "grow tired of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно становиться каким-либо или приобретать определенное качество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "становиться",
                                "target_lang_sense_clarification": "приобретать качество"
                            },
                            {
                                "target_lang_word": "делаться",
                                "target_lang_sense_clarification": "о постепенном изменении состояния"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6417b116-de45-330f-a0e2-ca8b07d3c934",
                    "sense_definition": "To begin to exist or appear by sprouting or emerging.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emergence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New leaf buds <w>grew</w> on the trees with the advance of spring.",
                            "target_lang_translations": {
                                "ru": "С приходом весны на деревьях <w>выросли</w> новые почки."
                            }
                        },
                        {
                            "text": "A long tail began to <w>grow</w> from the creature's backside.",
                            "target_lang_translations": {
                                "ru": "У существа сзади начал <w>расти</w> длинный хвост."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grow from",
                        "begin to grow",
                        "buds grow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать существовать или появляться путем прорастания или возникновения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырастать",
                                "target_lang_sense_clarification": "появляться, прорастать"
                            },
                            {
                                "target_lang_word": "появляться",
                                "target_lang_sense_clarification": "начинать быть видимым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56da8f43-a83e-3aad-926e-846fc3f767cf",
                    "sense_definition": "To become attached or fixed to something by natural growth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attachment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vines <w>grew</w> to the old stone wall over many decades.",
                            "target_lang_translations": {
                                "ru": "За многие десятилетия лозы <w>приросли</w> к старой каменной стене."
                            }
                        },
                        {
                            "text": "Our knees shall kneel till to the ground they <w>grow</w>.",
                            "target_lang_translations": {
                                "ru": "Мы будем стоять на коленях, пока они не <w>прирастут</w> к земле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grow to the ground"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in poetic or older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикрепляться или фиксироваться к чему-либо в процессе естественного роста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прирастать",
                                "target_lang_sense_clarification": "становиться единым целым"
                            },
                            {
                                "target_lang_word": "врастать",
                                "target_lang_sense_clarification": "врастать внутрь или в поверхность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "24b0a326-9bfc-3a9a-8c7f-63e51f707f83",
                    "sense_definition": "An English surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the philanthropist Mr. <w>Grow</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа мистера <w>Гроу</w>."
                            }
                        },
                        {
                            "text": "She introduced me to her colleague, Sarah <w>Grow</w>.",
                            "target_lang_translations": {
                                "ru": "Она познакомила меня со своей коллегой, Сарой <w>Гроу</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гроу",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}