                "senses": [
                    {
                        "sense_id": "f2c2514f-8663-3468-9111-3887595fbc5c",
                        "entry_id": "c5037cb8-125c-3915-9327-67f6b549d707",
                        "glosses": [
                            "messerartiges Bauteil am Pflug, das vor der Schar sitzt und dazu dient, den Boden aufzureißen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "475c8002-8ef0-4a6e-bb16-44cc5d79b1cb",
                                "sense_id": "f2c2514f-8663-3468-9111-3887595fbc5c",
                                "text": "„Das Schälsech, Schälmesser endlich, welches von England in neuester Zeit auch nach Deutschland übersiedelt, besteht aus dem Schaft des gewöhnlichen Seches, welches unten ein kleines Streichbret mit Schar oder auch nur das einfache Ruchadloeisen trägt. Die Befestigung ist die des gewöhnlichen Seches und steht dieser kleine Borpflug circa 1 Fuß vor dem Seche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65293c01-0cfa-4f33-b920-a448de94dec2",
                        "source_entry_id": "c5037cb8-125c-3915-9327-67f6b549d707",
                        "source_sense_id": "f2c2514f-8663-3468-9111-3887595fbc5c",
                        "source_sense_description": "messerartiges Bauteil am Pflug, das vor der Schar sitzt und dazu dient, den Boden aufzureißen",
                        "target_lang_word": "coulter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coulter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2736d9ab-8c54-3918-8ed2-1f54d18ae54b",
                                        "entry_id": "626fd117-e41a-333e-b46f-d789d8116cc4",
                                        "glosses": [
                                            "A cutter, consisting of a blade in either knife form or disk form, attached to the ploughbeam of a plough to cut the sward, in front of the ploughshare and mouldboard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbda3584-da49-473b-a3bd-eca6e7bb8d8b",
                                                "sense_id": "2736d9ab-8c54-3918-8ed2-1f54d18ae54b",
                                                "text": "Holonyms: plough, plow < implement"
                                            },
                                            {
                                                "example_id": "47e5327b-d276-4ca1-8d1b-9a96a700ecb0",
                                                "sense_id": "2736d9ab-8c54-3918-8ed2-1f54d18ae54b",
                                                "text": "I lately left a furrow, one or twayne, / Unplough'd, the which my coulter hath not cleft […]."
                                            },
                                            {
                                                "example_id": "da97ff39-82cb-4429-b0e7-90d226c84d12",
                                                "sense_id": "2736d9ab-8c54-3918-8ed2-1f54d18ae54b",
                                                "text": "What is it but a servitude like that impos'd by the Philistims, not to be allow'd the sharpning of our own axes and coulters, but we must repair from all quarters to twenty licencing forges."
                                            },
                                            {
                                                "example_id": "60038a9b-bcda-4dee-aace-5d1a2d8a1ae8",
                                                "sense_id": "2736d9ab-8c54-3918-8ed2-1f54d18ae54b",
                                                "text": "With colters bright the rushy sward bisect, / And in new veins the gushing rills direct […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d343d8c-50a5-3d86-ba89-8274b73eddab",
                                        "entry_id": "626fd117-e41a-333e-b46f-d789d8116cc4",
                                        "glosses": [
                                            "The part of a seed drill that makes the furrow for the seed."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "103b9c0a-b2d7-43e3-bb50-b6e9c56e01ca",
                        "source_entry_id": "c5037cb8-125c-3915-9327-67f6b549d707",
                        "source_sense_id": "f2c2514f-8663-3468-9111-3887595fbc5c",
                        "source_sense_description": "messerartiges Bauteil am Pflug, das vor der Schar sitzt und dazu dient, den Boden aufzureißen",
                        "target_lang_word": "coutre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coutre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a271d891-b532-3418-b42b-8e129dd36033",
                                        "entry_id": "a6b69a5c-3f77-3af8-9a58-47f91be4adc9",
                                        "glosses": [
                                            "Fer tranchant qui fait partie de la charrue et qui sert à fendre la terre quand on laboure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1be64b29-94b4-4be8-8a08-11bd165ac42f",
                                                "sense_id": "a271d891-b532-3418-b42b-8e129dd36033",
                                                "text": "L’on ne s’y servait pas déjà de mauvais coutres, comme en certaines parties de la France, et la houe suffisait au peu de labours qui s’y faisaient."
                                            },
                                            {
                                                "example_id": "77bf5888-c30a-46a4-85b5-09f98e9ba837",
                                                "sense_id": "a271d891-b532-3418-b42b-8e129dd36033",
                                                "text": "Ce soc est fort petit, et le coutre qui ne fait qu’écorcher la terre, pour ainsi dire ; à mesure que les sillons sont tirés, les laboureurs rompent les mottes avec de grosses maillottes de bois."
                                            },
                                            {
                                                "example_id": "c8a5a78e-091f-46d6-b3de-64024664f195",
                                                "sense_id": "a271d891-b532-3418-b42b-8e129dd36033",
                                                "text": "Le coutre de la charrue, en creusant le sillon, ne ferait-il pas envoler des bandes de staffii ou de striges ?…"
                                            },
                                            {
                                                "example_id": "fac71e49-f676-4cf7-9933-9f71b272af43",
                                                "sense_id": "a271d891-b532-3418-b42b-8e129dd36033",
                                                "text": "Il n’en finissait plus dans sa longueur, cet homme-là, avec une fourrure de poils noirs sur sa figure, et, dessous, on devinait un gros menton en avant comme un coutre d’araire, et puis deux yeux qui luisaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a19a46d-9f96-3e20-a63a-08eb590d3e88",
                                        "entry_id": "a6b69a5c-3f77-3af8-9a58-47f91be4adc9",
                                        "glosses": [
                                            "Hache qui sert à refendre les échalas ; merlin à fendre le bois de chauffage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a87a2082-81bf-387d-90a2-18ac2cbac84e",
                                        "entry_id": "a6b69a5c-3f77-3af8-9a58-47f91be4adc9",
                                        "glosses": [
                                            "Par analogie de forme avec la pièce de charrue, ardoise coupée en biais sur la longueur et la largeur."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
