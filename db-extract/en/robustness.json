                "word": "robustness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e169cf30-dd85-479c-8a47-0ef64d084233",
                        "entry_id": "62260745-dd86-3b46-a46a-373b36b7e8e2",
                        "tags": [
