                "senses": [
                    {
                        "sense_id": "1008385d-7b9d-348f-afc7-4396b1b1ace4",
                        "entry_id": "cb431004-a999-3fa0-b0f0-95e1a2fc8131",
                        "glosses": [
                            "Descendre (ce qu’on avait gravi)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf59cbec-58c5-4013-a1c4-1010030533d2",
                                "sense_id": "1008385d-7b9d-348f-afc7-4396b1b1ace4",
                                "text": "Après la représentation, un public délicieusement ému avait dégravi les illustres marches de Charles Garnier."
                            },
                            {
                                "example_id": "0b13cda9-1698-451d-ad99-88e06bbd65a8",
                                "sense_id": "1008385d-7b9d-348f-afc7-4396b1b1ace4",
                                "text": "Je venais à peine de dégravir les marches du perron, qu’une grosse Mercedes grise s’arrêta au bord du trottoir."
                            },
                            {
                                "example_id": "4977a6bd-08d2-42eb-a2f1-2da580e8ed03",
                                "sense_id": "1008385d-7b9d-348f-afc7-4396b1b1ace4",
                                "text": "Alexandre-Benoît se présente de dos pour dégravir les trois marches."
                            }
                        ]
                    }
                ],
