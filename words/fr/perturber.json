                {
                    "sense_id": "b1c2cdbe-6b8a-3aa7-ba7e-9d96a64b886f",
                    "sense_definition": "Troubler l'équilibre émotionnel, psychologique ou intellectuel d'une personne.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "trouble_psychologique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette mauvaise nouvelle risque de le <w>perturber</w> avant son examen important.",
                            "target_lang_translations": {
                                "en": "This bad news could <w>upset</w> him before his important exam.",
                                "ru": "Это плохое известие может <w>расстроить</w> его перед важным экзаменом.",
                                "de": "Diese schlechte Nachricht könnte ihn vor seiner wichtigen Prüfung <w>verunsichern</w>.",
                                "es": "Esta mala noticia lo podría <w>trastornar</w> antes de su importante examen.",
                                "zh": "这个坏消息可能会在他重要的考试前<w>困扰</w>他。"
                            }
                        },
                        {
                            "text": "Le bruit constant dans la pièce a fini par <w>perturber</w> sa concentration.",
                            "target_lang_translations": {
                                "en": "The constant noise in the room eventually <w>disturbed</w> his concentration.",
                                "ru": "Постоянный шум в комнате в конце концов <w>нарушил</w> его сосредоточенность.",
                                "de": "Der ständige Lärm im Zimmer hat seine Konzentration schließlich <w>gestört</w>.",
                                "es": "El ruido constante de la habitación acabó por <w>perturbar</w> su concentración.",
                                "zh": "房间里持续不断的噪音最终<w>干扰</w>了他的注意力。"
                            }
                        }
