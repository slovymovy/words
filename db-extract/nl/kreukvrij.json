                        "sense_id": "11f403c9-58a6-3183-b247-48f6453ef66a",
                        "entry_id": "2e7b3811-5e91-310a-afab-414da2ea1848",
                        "glosses": [
                            "alsof het nog helemaal nieuw en ongbruikt is"
                        ],
