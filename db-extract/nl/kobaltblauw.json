                                        "sense_id": "4f671f0a-8ea2-30d4-9f42-1a27f9c1519a",
                                        "entry_id": "0a730133-7deb-3ab7-96f9-0d97ca5d62a3",
                                        "glosses": [
                                            "in einer Farbe, die in einem intensiven, leuchtenden Blau ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6a71740-b7ad-4204-8c17-9d245e477ad2",
                                                "sense_id": "4f671f0a-8ea2-30d4-9f42-1a27f9c1519a",
                                                "text": "„Ihre kobaltblaue Jacke bildete einen scharfen Kontrast zu ihrem rotgoldenen Haar.“"
                                            },
                                            {
                                                "example_id": "e99bcb09-a37e-49d1-9c63-0d0e67b717a1",
                                                "sense_id": "4f671f0a-8ea2-30d4-9f42-1a27f9c1519a",
                                                "text": "„Er war schmächtig, hatte schiefe Zähne, aber leuchtend kobaltblaue Augen, mit denen er seine Umgebung aufmerksam musterte.“"
                                            },
                                            {
                                                "example_id": "f4eb8742-a9b5-4ca0-b198-04d09baeda4b",
                                                "sense_id": "4f671f0a-8ea2-30d4-9f42-1a27f9c1519a",
                                                "text": "„Ich wollte ihr sagen, dass sie verwirrt war und Unsinn redete, denn natürlich war unsere Pflanze eine kobaltblaue Orchidee gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
