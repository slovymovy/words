                    },
                    {
                        "translation_id": "6e5f18fc-6ad3-4a36-b484-38bb97c6accf",
                        "source_entry_id": "71fd671d-e027-373d-bd9d-4659f0da84b9",
                        "source_sense_id": "d9dcae7f-5571-3e8c-b333-3dce35221a94",
                        "source_sense_description": "Ergebnis, das durch Einsatz von geistiger/körperlicher Tätigkeit erreicht werden soll",
                        "target_lang_word": "objectif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "objectif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93e1c99a-3b33-3e70-88af-064f62340e05",
                                        "entry_id": "7528d4b5-9b97-3bb7-b17e-3214b8a9f63c",
                                        "glosses": [
                                            "Qui concerne l’objet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2565aece-f51f-3464-a6ba-5717df69145b",
                                        "entry_id": "7528d4b5-9b97-3bb7-b17e-3214b8a9f63c",
                                        "glosses": [
                                            "Qui a rapport, qui répond à un objet, qui représente un objet tel qu’il est en réalité, sans aucune déformation de notre esprit, de nos interprétations personnelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78223cf4-16f7-4bc9-85f7-3953f1fabfda",
                                                "sense_id": "2565aece-f51f-3464-a6ba-5717df69145b",
                                                "text": "Le point de vue objectif. (Conception non Kantienne, voir chose en soi)."
                                            },
                                            {
                                                "example_id": "aa06d559-f2b2-4ba7-9d99-f98d8a7f5d68",
                                                "sense_id": "2565aece-f51f-3464-a6ba-5717df69145b",
                                                "text": "Un récit objectif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c61db83-1e23-3e40-885b-361d5af910a4",
                                        "entry_id": "7528d4b5-9b97-3bb7-b17e-3214b8a9f63c",
                                        "glosses": [
                                            "Qui relève de la réalité et non de l'interprétation."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0896822-0260-4fdf-893b-274105375bcf",
                                                "sense_id": "2c61db83-1e23-3e40-885b-361d5af910a4",
                                                "text": "C’est une œuvre purement pittoresque, objective, comme diraient les Allemands."
                                            },
                                            {
                                                "example_id": "d1fe7951-abe2-4d81-abec-bc0edb8f1f4d",
                                                "sense_id": "2c61db83-1e23-3e40-885b-361d5af910a4",
                                                "text": "Le changement des conditions objectives de la lutte, qui imposait la nécessité de passer de la grève à l’insurrection, fut ressenti par le prolétariat bien avant que par ses dirigeants."
                                            },
                                            {
                                                "example_id": "96079874-2726-4c55-b460-04883fa50da4",
                                                "sense_id": "2c61db83-1e23-3e40-885b-361d5af910a4",
                                                "text": "Cette panoplie de données objectives et quantifiées permet de dépasser largement l’approche intuitive, pifométrique et incertaine qui reste la plus souvent celle de la psychologie historique."
                                            },
                                            {
                                                "example_id": "49869cb7-5503-44f3-88ea-09bf626a204a",
                                                "sense_id": "2c61db83-1e23-3e40-885b-361d5af910a4",
                                                "text": "Cette île narcissique qui a plus d'une raison objective de se proclamer « de Beauté » a de tout temps entretenu avec les « autres » des rapports compliqués."
                                            },
                                            {
                                                "example_id": "93a65057-46fa-44fe-9d57-650fb1f6b3f0",
                                                "sense_id": "2c61db83-1e23-3e40-885b-361d5af910a4",
                                                "text": "En outre, le malheur des huguenots était un fait objectif, alors que « les persécutions bourboniennes » semblent n'avoir existé que dans l'imagination des catholiques radicaux."
                                            },
                                            {
                                                "example_id": "d5518385-4f5e-43ac-ae37-8a5b3027fcd9",
                                                "sense_id": "2c61db83-1e23-3e40-885b-361d5af910a4",
                                                "text": "Et le Mexicain, ç’a été une épée, un cador ; moi je suis objectif, on parlera encore de lui dans cent ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "764be2a0-3901-3336-9b73-ef5b5c5b307a",
                                        "entry_id": "7528d4b5-9b97-3bb7-b17e-3214b8a9f63c",
                                        "glosses": [
                                            "Destiné à être tourné du côté de l’objet qu’on veut voir ; à la différence d’« oculaire », destiné à être placé du côté de l’œil."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd0f630e-79a3-49ba-9580-f5ed8856ad4b",
                                                "sense_id": "764be2a0-3901-3336-9b73-ef5b5c5b307a",
                                                "text": "Verre objectif."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "objectif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffef5786-715c-3416-809d-4fddcedc3a92",
                                        "entry_id": "b4846ade-146e-3761-b2cb-6b96983ea25d",
                                        "glosses": [
                                            "Tout ce qui est en dehors du sujet pensant et observant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2935f5a-fc70-3966-9363-66b8deb29edb",
                                        "entry_id": "b4846ade-146e-3761-b2cb-6b96983ea25d",
                                        "glosses": [
                                            "Verre ou lentille placé du côté de l’objet qu’on veut voir ; à la différence de l’oculaire, destiné à être placé du côté de l’œil."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "730ac416-fbd7-4888-ab7e-2f38cc78ed72",
                                                "sense_id": "b2935f5a-fc70-3966-9363-66b8deb29edb",
                                                "text": "Le diamètre a été mesuré à l’aide d’un microscope muni d'un micromètre oculaire qui avait été comparé préalablement à un micromètre étalon placé dans l'objectif."
                                            },
                                            {
                                                "example_id": "dc0256e8-7db2-47ba-af87-c4d659c3cb2d",
                                                "sense_id": "b2935f5a-fc70-3966-9363-66b8deb29edb",
                                                "text": "Il faut remarquer que la netteté de l’épreuve dépend aussi des corrections d’aplanétisme et d’astigmatisme de l’objectif qui sont souvent limitées à l'ordre de grandeur angulaire qui vient d'être indiqué."
                                            },
                                            {
                                                "example_id": "3618e2fc-d05e-4dc1-8ec1-a139e9dcf25c",
                                                "sense_id": "b2935f5a-fc70-3966-9363-66b8deb29edb",
                                                "text": "À cause de la diffraction, on ne peut pas diaphragmer notablement un objectif formant ses images sur un petit capteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46e06550-39c8-3201-82cf-dce195c11608",
                                        "entry_id": "b4846ade-146e-3761-b2cb-6b96983ea25d",
                                        "glosses": [
                                            "But que l’on cherche à atteindre, le point où l’on se propose d’arriver, ce que l'on vise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ecec837-c6ce-4461-bc03-934f4eb45591",
                                                "sense_id": "46e06550-39c8-3201-82cf-dce195c11608",
                                                "text": "Les efforts se déploient surtout dans le domaine caritatif et s'accompagnent d'une recatholicisation en profondeur des pauvres secourus, l'objectif étant d'aller au peuple pour rétablir la suprématie de l'Église catholique sur la société civile."
                                            },
                                            {
                                                "example_id": "07124663-34bc-4c2a-9fca-33077b0207e3",
                                                "sense_id": "46e06550-39c8-3201-82cf-dce195c11608",
                                                "text": "Il ne faut pas commencer une activité physique en se fixant des objectifs inatteignables."
                                            },
                                            {
                                                "example_id": "9a6d4ee1-edb3-4b7a-915b-61d794208bb0",
                                                "sense_id": "46e06550-39c8-3201-82cf-dce195c11608",
                                                "text": "Dévoiler la Joconde ? C'est l’objectif lascif d'une équipe scientifique, associée au Louvre pour percer le mystère du sfumato, qui a fait la célébrité de Léonard de Vinci."
                                            },
                                            {
                                                "example_id": "1bb3880c-e4a3-4bd7-be75-de6f3f1b3f1b",
                                                "sense_id": "46e06550-39c8-3201-82cf-dce195c11608",
                                                "text": "Des élus, des sous-préfets, des chefs de services civils et militaires de l’État mais aussi des chefs d’entreprise, des acteurs de la vie associative, des bénévoles du SNU (Service national universel), tous rassemblés autour d’un objectif commun : zéro mort sur les routes d’Eure-et-Loir dans les six prochains mois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a82c7ff-84cf-35e8-b0bf-4831179994da",
                                        "entry_id": "b4846ade-146e-3761-b2cb-6b96983ea25d",
                                        "glosses": [
                                            "Appareil photographique."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "256e373f-4f2f-4ee1-8b9a-40bc1c3766bd",
                        "source_entry_id": "71fd671d-e027-373d-bd9d-4659f0da84b9",
                        "source_sense_id": "d9dcae7f-5571-3e8c-b333-3dce35221a94",
                        "source_sense_description": "Ergebnis, das durch Einsatz von geistiger/körperlicher Tätigkeit erreicht werden soll",
                        "target_lang_word": "but",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "but",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bcf78a7-2a94-336c-8fc3-5c4a5a821f86",
                                        "entry_id": "9d5b3908-29f7-3d44-9f5b-494dc1bb77fb",
                                        "glosses": [
                                            "Objectif, cible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d398908-2c68-4f9f-890b-b39a1e5ee175",
                                                "sense_id": "2bcf78a7-2a94-336c-8fc3-5c4a5a821f86",
                                                "text": "Pour atteindre ce but tous les moyens ne sont pas indifférents ; il y a des lois à observer et une marche rationnelle à suivre."
                                            },
                                            {
                                                "example_id": "1bba8be9-7624-42f2-b8bb-054d398cdc46",
                                                "sense_id": "2bcf78a7-2a94-336c-8fc3-5c4a5a821f86",
                                                "text": "Il alla jusqu'à se demander si ce n'était pas le domino blanc qui avait exécuté ce tour de passe-passe. Dans quel but ?"
                                            },
                                            {
                                                "example_id": "2ae2baef-53e4-4e46-9797-b4a550a9671e",
                                                "sense_id": "2bcf78a7-2a94-336c-8fc3-5c4a5a821f86",
                                                "text": "Parce que l’astronomie parvenait à calculer les tables de la lune, on a cru que le but de toute science était de prévoir avec exactitude l’avenir."
                                            },
                                            {
                                                "example_id": "420d8249-8cc5-4d7b-9cda-0494e0f44fd7",
                                                "sense_id": "2bcf78a7-2a94-336c-8fc3-5c4a5a821f86",
                                                "text": "L’avenir est à ceux qui savent le prédire. Se réformer, c’est se conformer à l’évolution irrésistible et lente des sociétés en marche vers le but inconnu."
                                            },
                                            {
                                                "example_id": "8debe4b5-45fa-4069-aa70-1150959a1757",
                                                "sense_id": "2bcf78a7-2a94-336c-8fc3-5c4a5a821f86",
                                                "text": "Chaque individu poursuivait la fortune, sans crainte pour l’avenir, sans jalousie du voisin. Tous arriveraient au but ensemble. Quel était ce but ? Où s’arrêterait-on ? Que ferait-on ensuite ? On ne se posait pas ces problèmes."
                                            },
                                            {
                                                "example_id": "7fd95ae7-fdf3-4258-900e-7279e2b5918a",
                                                "sense_id": "2bcf78a7-2a94-336c-8fc3-5c4a5a821f86",
                                                "text": "Note : Le complément de nom peut être un infinitif :",
                                                "translation": "La vérité, c’est de comprendre\nQue le but de vivre est humain. — (Robert de Montesquiou, Les Perles rouges & Les Paroles diaprées, Les Paroles diaprées, Pour l’exemplaire de Mᵐᵉ Edmond Adam ; Richard imprimeur-éditeur, Paris, 1910, page 103)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a497bd03-a9a8-3664-96dc-36c784c85236",
                                        "entry_id": "9d5b3908-29f7-3d44-9f5b-494dc1bb77fb",
                                        "glosses": [
                                            "Cage dans laquelle on doit mettre la balle pour marquer."
                                        ],
                                        "tags": [
                                            "Au football et différents autres sports"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f69c5f3-eea2-4722-b2a3-0655ab356950",
                                                "sense_id": "a497bd03-a9a8-3664-96dc-36c784c85236",
                                                "text": "M. Garrido siffle deux coups francs l’un après l’autre, le premier pour une faute de Neeskens, le second pour une main de Van de Korput à une vingtaine de mètres sur la droite du but de Van Breukelen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa49eaea-1a72-3c7c-9675-0279090f1dc5",
                                        "entry_id": "9d5b3908-29f7-3d44-9f5b-494dc1bb77fb",
                                        "glosses": [
                                            "Point marqué en envoyant la balle dans la cible."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44303395-0114-430e-b5a4-dc8f0664ddfd",
                                                "sense_id": "fa49eaea-1a72-3c7c-9675-0279090f1dc5",
                                                "text": "Il a marqué un but (devenant synonyme d’avoir atteint la cible visée, dans le jargon des jeux sportifs collectifs)."
                                            },
                                            {
                                                "example_id": "aa5a32af-6af9-4946-8b0a-1260ca4df724",
                                                "sense_id": "fa49eaea-1a72-3c7c-9675-0279090f1dc5",
                                                "text": "Mbappé est devenu le plus jeune joueur à atteindre un total de cinq buts en Ligue des champions, à 18 ans et 4 mois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cca77eb4-5e4d-3daa-a612-e6b89f4ac98d",
                                        "entry_id": "9d5b3908-29f7-3d44-9f5b-494dc1bb77fb",
                                        "glosses": [
                                            "Point que l’on vise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75b0e741-a1af-462e-b4b2-0a5fc79d17db",
                                                "sense_id": "cca77eb4-5e4d-3daa-a612-e6b89f4ac98d",
                                                "text": "Cependant, au milieu de la chaussée, des nègres se poursuivaient à coup de boules de neige et parfois, une de ces boules, manquant son but, s'écrasait contre une devanture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "743146e2-ad50-34e9-8449-ce8615d0b841",
                                        "entry_id": "9d5b3908-29f7-3d44-9f5b-494dc1bb77fb",
                                        "glosses": [
                                            "Petite boule servant de cible dans différents jeux de boules, lancée en début de mène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c967be6-57a4-4aa6-bf0d-31bc5d9fdd9c",
                                                "sense_id": "743146e2-ad50-34e9-8449-ce8615d0b841",
                                                "text": "L'homme modeste fait rouler sa boule terre à terre vers le but ; celui que domine la manie de briller lance la sienne en lui faisant décrire une parabole semblable à celle que décrit une bombe; le grand art consiste, dans ce cas, à lui imprimer, en même temps qu’une force d’impulsion, une puissance de rotation contraire qui l’empêche de rouler trop loin du but."
                                            },
                                            {
                                                "example_id": "e6801e99-7bf8-4383-9256-6d7c03a603db",
                                                "sense_id": "743146e2-ad50-34e9-8449-ce8615d0b841",
                                                "text": "Les buts sont en bois, ou en matière synthétique portant le label du fabricant."
                                            },
                                            {
                                                "example_id": "4b07aa4e-e56a-4f19-8a82-e81ed9c04045",
                                                "sense_id": "743146e2-ad50-34e9-8449-ce8615d0b841",
                                                "text": "Le but (également appelé « petit », « bouchon » ou « cochonnet ») : sphère de bois de laquelle les joueurs essaient de se rapprocher. Le but est traditionnellement en buis ou de couleur fluo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "929f678d-2d1b-366e-9a1b-41a4c21855bd",
                                        "entry_id": "9d5b3908-29f7-3d44-9f5b-494dc1bb77fb",
                                        "glosses": [
                                            "Base, espace matérialisé au sol par une plaque carrée, soit à la fin du tour de l’espace de jeu, soit à chacun de ses angles (espace à contourner de forme carrée)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fb206a8-f5bb-3c78-981a-4b97a0162167",
                                        "entry_id": "9d5b3908-29f7-3d44-9f5b-494dc1bb77fb",
                                        "glosses": [
                                            "Abandon d’une ascension avant d’avoir atteint la destination prévue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d280a47-7530-40a2-9fa7-c9119cfc2804",
                                                "sense_id": "3fb206a8-f5bb-3c78-981a-4b97a0162167",
                                                "text": "La dernière fois nous avions pris un but météo avec Steph et Sophie, pas question de prendre un but cette fois ci."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "but",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bbf8b7ef-8552-3e36-814e-e02c29ac5fc6",
                                        "entry_id": "2fe2bb78-d36c-3f8a-bc46-a4dedaeebf00",
                                        "glosses": [
                                            "Troisième personne du singulier du passé simple de boire."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bffe164d-f6ee-486e-9ea4-bb6ee2427212",
                                                "sense_id": "bbf8b7ef-8552-3e36-814e-e02c29ac5fc6",
                                                "text": "Il but une gorgée d’eau, puis jaugea des yeux le reste du volume du vase afin d’évaluer le chemin qui lui restait encore à parcourir dans ce monde apocalypsé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
