                {
                    "sense_id": "6a55b09d-1512-329a-bdbc-287a24b7a81b",
                    "sense_definition": "Prendre conscience de quelque chose, se rendre compte d'un fait.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En arrivant à la gare, elle s'<w>aperçoit</w> qu'elle a oublié son billet.",
                            "target_lang_translations": {
                                "en": "On arriving at the station, she <w>realizes</w> she has forgotten her ticket.",
                                "ru": "Приехав на вокзал, она <w>понимает</w>, что забыла билет.",
                                "nl": "Bij aankomst op het station <w>beseft</w> ze dat ze haar kaartje is vergeten.",
                                "de": "Als sie am Bahnhof ankommt, <w>merkt</w> sie, dass sie ihre Fahrkarte vergessen hat.",
                                "pl": "Po przyjeździe na dworzec <w>uświadamia sobie</w>, że zapomniała o bilecie.",
                                "it": "Arrivata alla stazione, <w>si accorge</w> di aver dimenticato il biglietto.",
                                "cs": "Když dorazí na nádraží, <w>uvědomí si</w>, že zapomněla lístek.",
                                "tr": "İstasyona varınca biletini unuttuğunun <w>farkına varıyor</w>.",
                                "es": "Al llegar a la estación, <w>se da cuenta</w> de que ha olvidado el billete.",
                                "zh": "一到车站，她就<w>意识到</w>自己忘带车票了。"
                            }
                        },
                        {
                            "text": "Le professeur s'est vite <w>aperçu</w> de la difficulté de cet exercice pour les élèves.",
                            "target_lang_translations": {
                                "en": "The teacher quickly <w>realized</w> how difficult this exercise was for the students.",
                                "ru": "Учитель быстро <w>понял</w>, насколько трудным было это упражнение для учеников.",
                                "nl": "De leraar <w>besefte</w> snel hoe moeilijk deze oefening voor de leerlingen was.",
                                "de": "Der Lehrer <w>bemerkte</w> schnell, wie schwierig diese Übung für die Schüler war.",
                                "pl": "Nauczyciel szybko <w>zauważył</w>, jak trudne jest to ćwiczenie dla uczniów.",
                                "it": "Il professore <w>si è accorto</w> subito di quanto fosse difficile questo esercizio per gli studenti.",
                                "cs": "Učitel rychle <w>si uvědomil</w>, jak obtížné je toto cvičení pro žáky.",
                                "tr": "Öğretmen, bu alıştırmanın öğrenciler için ne kadar zor olduğunu hemen <w>fark etti</w>.",
                                "es": "El profesor <w>se dio cuenta</w> enseguida de lo difícil que era este ejercicio para los alumnos.",
                                "zh": "老师很快就<w>发现</w>这道练习对学生来说有多难。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To become aware of something, especially by realizing a fact or situation.",
                        "ru": "Осознать что-либо, понять факт или положение дел.",
