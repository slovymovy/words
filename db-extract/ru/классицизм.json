                    {
                        "form_id": "4479b752-2255-4d1a-a790-573d29bb1639",
                        "entry_id": "ca1dac10-8578-30b3-97d5-9bf588ac1be2",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "классици́змах"
