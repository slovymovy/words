                            {
                                "example_id": "a566405e-decb-4a31-ba97-becf5a0e6fdb",
                                "sense_id": "ba23a597-264a-3e19-85af-023b60ea04e6",
                                "text": "На́ше о́бщество сороковы́х годо́в (и́ли, лу́чше сказа́ть, мы́слящая его́ часть), составля́ющее и доны́не гла́вный континге́нт чита́ющей пу́блики, не могло́ похвали́ться осо́бенною я́сностью свои́х стремле́ний.",
                                "translation": "Mikhail Saltykov-Shchedrin",
                                "english": "Mikhail Saltykov-Shchedrin"
                            }
                        ]
                    }
                ],
