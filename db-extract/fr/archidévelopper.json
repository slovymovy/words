                "senses": [
                    {
                        "sense_id": "994f7bce-b1f1-3e94-bc96-e623b8eb9906",
                        "entry_id": "dfe34ba8-aa61-30b9-8421-48680f0dc76f",
                        "glosses": [
                            "Développer de façon extrêmement importante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf4238b-e255-4550-94ce-8bc7c69606b8",
                                "sense_id": "994f7bce-b1f1-3e94-bc96-e623b8eb9906",
                                "text": "On ne s’est pas servi de tout ce qui avait plu dans la première saison pour l’archidévelopper."
                            },
                            {
                                "example_id": "ce2f1518-4a64-4a67-927a-8d0233965d3c",
                                "sense_id": "994f7bce-b1f1-3e94-bc96-e623b8eb9906",
                                "text": "On est ici dans l’urban fantasy légère. Pas d’univers archidéveloppé (même s’il y a de très belles trouvailles, j’y reviendrai) ou de profondes réflexions, mais un livre résolument porté sur l’action et l’humour, un mélange plus que plaisant et parfait pour ceux qui souhaitent s’initier au genre."
                            }
                        ]
                    }
