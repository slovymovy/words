                    {
                        "sense_id": "c1acd55f-1b53-3276-8170-1ddf82d70106",
                        "entry_id": "1cb6d9bb-f5ff-3a87-b729-d7b4fd934bb1",
                        "glosses": [
                            "Surnom populaire donné à la 2 CV de Citroën."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb941bc8-26d2-4d48-ada7-c8a1f16e680a",
                                "sense_id": "c1acd55f-1b53-3276-8170-1ddf82d70106",
                                "text": "Il m’a encouragé pour les exams, initié au cinéma, m’a abonné au Monde, offert une deuch pour mes vingt et un ans."
                            },
                            {
                                "example_id": "3f53c8ed-8474-4df3-af79-681a0c097bf1",
                                "sense_id": "c1acd55f-1b53-3276-8170-1ddf82d70106",
                                "text": "La Simca 1000 avait remplacé la Dauphine, les deuchs étaient les compagnes des couples d’étudiants et des vacanciers fauchés."
                            },
                            {
                                "example_id": "27564cf0-6ec7-4fa2-96b0-8b862eb5c12e",
                                "sense_id": "c1acd55f-1b53-3276-8170-1ddf82d70106",
                                "text": "Pour un gars chez qui tout est deuch du bouton de sonnette au pommeau de douche, il n’y a que les morceaux de sucre qui ne sont pas estampillés Citroën."
                            }
                        ]
                    }
