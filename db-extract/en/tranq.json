                        "sense_id": "6edf502f-e1ce-3831-a1b0-fba02d410b2d",
                        "entry_id": "2badecf9-0a26-3227-95a9-c2ffa05e234e",
                        "glosses": [
                            "To use the drug called tranq."
                        ],
