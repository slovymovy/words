                            {
                                "target_lang_word": "безудержный",
                                "target_lang_sense_clarification": "о росте, эмоциях"
                            },
                            {
                                "target_lang_word": "буйный",
                                "target_lang_sense_clarification": "о растительности"
                            },
                            {
                                "target_lang_word": "неконтролируемый",
                                "target_lang_sense_clarification": "о росте, распространении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6854de88-8699-35e3-b664-d6aa3998ec61",
                    "sense_definition": "Rearing up on the hind legs, especially with one foreleg raised, as depicted in heraldry.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "heraldry_posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The royal family's coat of arms features a golden lion <w>rampant</w> against a blue background.",
                            "target_lang_translations": {
                                "ru": "На гербе королевской семьи изображен золотой <w>восстающий</w> лев на синем фоне."
                            }
                        },
                        {
                            "text": "He wore a signet ring engraved with a dragon <w>rampant</w> holding a sword.",
