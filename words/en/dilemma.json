{
    "word_family": [
        "dilemmatic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "31bb0354-187d-3ff1-a150-5e29445028b7",
                    "sense_definition": "A situation in which a difficult choice must be made between two or more alternatives, especially when they are equally undesirable.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "choice_difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She faced a terrible <w>dilemma</w> when she had to choose between her career and her family.",
                            "target_lang_translations": {
                                "ru": "Она столкнулась с ужасной <w>дилеммой</w>, когда ей пришлось выбирать между карьерой и семьей.",
                                "zh": "当必须在事业和家庭之间做出选择时，她面临着可怕的<w>两难境地</w>。"
                            }
                        },
                        {
                            "text": "The government is in a <w>dilemma</w> over how to reduce the deficit without raising taxes.",
                            "target_lang_translations": {
                                "ru": "Правительство стоит перед <w>дилеммой</w>: как сократить дефицит, не повышая налоги.",
                                "zh": "政府在如何在不增税的情况下减少赤字的问题上陷入了<w>困境</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quandary",
                        "predicament",
                        "Catch-22",
                        "no-win situation"
                    ],
                    "common_phrases": [
                        "face a dilemma",
                        "moral dilemma",
                        "ethical dilemma",
                        "resolve a dilemma"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация, в которой необходимо сделать трудный выбор между двумя или более альтернативами, особенно когда они одинаково нежелательны.",
                        "zh": "必须在两个或多个选项之间做出艰难抉择的境地，尤指这些选项同样令人难以接受。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дилемма",
                                "target_lang_sense_clarification": "трудный выбор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "两难境地",
                                "target_lang_sense_clarification": "进退两难的处境"
                            },
                            {
                                "target_lang_word": "困境",
                                "target_lang_sense_clarification": "难以抉择的处境"
                            },
                            {
                                "target_lang_word": "进退维谷",
                                "target_lang_sense_clarification": "书面语，左右为难的窘境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b450bb4-99c4-3b41-b213-4ed64c04dbe2",
                    "sense_definition": "Any difficult circumstance, problem, or situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "general_difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We found ourselves in a bit of a <w>dilemma</w> after missing the last train home.",
                            "target_lang_translations": {
                                "ru": "Мы оказались в некотором <w>затруднительном положении</w>, опоздав на последнюю электричку домой.",
                                "zh": "错过了回家的最后一班火车后，我们发现自己陷入了一点<w>窘境</w>。"
                            }
                        },
                        {
                            "text": "The manager explained the financial <w>dilemma</w> that the company was trying to solve.",
                            "target_lang_translations": {
                                "ru": "Менеджер объяснил финансовую <w>проблему</w>, которую пыталась решить компания.",
                                "zh": "经理说明了公司正试图解决的财务<w>难题</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "problem",
                        "difficulty",
                        "plight",
                        "trouble",
                        "jam",
                        "fix"
                    ],
                    "common_phrases": [
                        "in a dilemma",
                        "serious dilemma"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое сложное обстоятельство, проблема или ситуация.",
                        "zh": "任何困难的处境、问题或窘况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затруднительное положение",
                                "target_lang_sense_clarification": "сложная ситуация"
                            },
                            {
                                "target_lang_word": "проблема",
                                "target_lang_sense_clarification": "трудность"
                            },
                            {
                                "target_lang_word": "дилемма",
                                "target_lang_sense_clarification": "перен. затруднение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "窘境",
                                "target_lang_sense_clarification": "尴尬或棘手的处境"
                            },
                            {
                                "target_lang_word": "难题",
                                "target_lang_sense_clarification": "难以解决的问题"
                            },
                            {
                                "target_lang_word": "困境",
                                "target_lang_sense_clarification": "困难的局势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5a1409d-fbe8-3d00-b953-4098be596b1d",
                    "sense_definition": "A specific type of logical argument or syllogism containing two conditional premises and a disjunctive premise.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "logic_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher presented a complex <w>dilemma</w> to challenge the students' reasoning skills.",
                            "target_lang_translations": {
                                "ru": "Философ представил сложную <w>дилемму</w>, чтобы проверить навыки рассуждения студентов.",
                                "zh": "哲学家提出了一个复杂的<w>二难推理</w>，以考验学生的推理能力。"
                            }
                        },
                        {
                            "text": "In formal logic, a constructive <w>dilemma</w> leads to a valid conclusion based on the premises.",
                            "target_lang_translations": {
                                "ru": "В формальной логике конструктивная <w>дилемма</w> ведет к обоснованному выводу, основанному на посылках.",
                                "zh": "在形式逻辑中，构成式<w>二难推理</w>能根据前提推导出有效结论。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "constructive dilemma",
                        "destructive dilemma"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особый тип логического умозаключения или силлогизма, содержащий две условные посылки и одну разделительную.",
                        "zh": "（逻辑学）包含两个假言前提和一个选言前提的特定形式的三段论或论证。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дилемма",
                                "target_lang_sense_clarification": "логический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "二难推理",
                                "target_lang_sense_clarification": "逻辑学名词，二难推论"
                            },
                            {
                                "target_lang_word": "假言选言推理",
                                "target_lang_sense_clarification": "逻辑学专业术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}