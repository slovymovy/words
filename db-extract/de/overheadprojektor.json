                        "entry_id": "33572fb3-e776-3d9f-8d56-f7fb946beee7",
                        "glosses": [
                            "Gerät, das Bild und/oder Text auf einer Folie mithilfe eines Spiegels auch bei Tageslicht auf eine Fläche projiziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a58e77c-ad8a-4ccf-995b-a56c9f56f626",
                                "sense_id": "22fb5c66-c3e4-3f27-8e15-06b77bbb5fab",
                                "text": "„Doch viele Lehrer in Deutschland nutzen immer noch den Overheadprojektor, weil sie zu geringe digitale Kenntnisse haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
