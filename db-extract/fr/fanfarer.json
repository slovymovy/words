                ],
                "senses": [
                    {
                        "sense_id": "cda16043-b841-3e07-95d2-b8f77ae3dac1",
                        "entry_id": "0aa6ae6b-9a8e-3804-8977-7939ca9db194",
                        "glosses": [
                            "Célébrer par des fanfares."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdeb3ad4-eac1-4286-b1e3-66593a8d2d06",
                                "sense_id": "cda16043-b841-3e07-95d2-b8f77ae3dac1",
                                "text": "Ne faisant que s’entre-regarder, faire fanfarer leurs trompettes, et bruire leurs tambours."
                            },
                            {
                                "example_id": "0f54f4da-6c55-45db-9708-4c92451d427a",
                                "sense_id": "cda16043-b841-3e07-95d2-b8f77ae3dac1",
                                "text": "Puis chanteront en chœur leurs poëtes élus,\nQui, tourmentant à froid leur nullité notoire,\nViennent, après un air, fanfarer la victoire."
                            },
                            {
                                "example_id": "28d8fcb7-5bd4-4b4c-95f0-73bf1583e61b",
                                "sense_id": "cda16043-b841-3e07-95d2-b8f77ae3dac1",
                                "text": "Fanfarez toujours, fanfarez encor,\nCe monstre livide, aux grandes oreilles,\nAu nez tout honteux de se montrer nu,\nFanfarez en chœur le grand Gaudéru !"
                            }
                        ]
                    }
                ],
