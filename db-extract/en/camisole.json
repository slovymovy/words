                        "target_lang_word": "kamizool",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kamizool",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "593157da-9843-3e3d-90ad-d42c55a3802f",
                                        "entry_id": "beab5ed1-5c7f-3fad-af35-018b74edebdd",
                                        "glosses": [
                                            "vest, vooral voor mannen, traditioneel met lange mouwen en diepe zakken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d3cef93-9326-457c-b38d-3f6c7d313566",
                                                "sense_id": "593157da-9843-3e3d-90ad-d42c55a3802f",
                                                "text": "Binnen is een enorm dikke vent in een blauw kamizool aan het vertellen hoe z’n vorige hond onder de pijnstillers is bezweken."
                                            },
                                            {
                                                "example_id": "1da5f522-5b44-4dbc-9933-31915f55be3c",
                                                "sense_id": "593157da-9843-3e3d-90ad-d42c55a3802f",
                                                "text": "Ik ontdeed me van vest en hemd en ook Leekens ritste zijn traingingspak open. In een mum van tijd stonden we tegenover elkaar; ons bovenlichaam enkel gekleed in een sjofel kamizool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ad0e292-dc04-3b39-b31d-fefd6f7c047b",
                                        "entry_id": "beab5ed1-5c7f-3fad-af35-018b74edebdd",
                                        "glosses": [
                                            "soortgelijk kledingstuk voor vrouwen, borstrok"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3475e501-534f-45aa-a65d-83192dbce62d",
                        "source_entry_id": "49dc6ca3-3acd-33c3-9249-52c6a6b90cb5",
                        "source_sense_description": "undergarment",
                        "target_lang_word": "Leibchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leibchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84687a7a-9cb7-3e8b-a58f-b628766e4a99",
                                        "entry_id": "1633830c-79e2-3916-8882-60d52c881cef",
                                        "glosses": [
                                            "Bezeichnung für verschiedene ärmellose Kleidungsstücke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "774381df-6f2c-450e-81c7-0831775e1224",
                                                "sense_id": "84687a7a-9cb7-3e8b-a58f-b628766e4a99",
                                                "text": "Noch in der ersten Hälfte des zwanzigsten Jahrhunderts gehörte das Leibchen mit Strumpfhalter zur Kinderkleidung dazu."
                                            },
                                            {
                                                "example_id": "c2f798c3-aa2c-4cfe-9af7-7bce52f97f5d",
                                                "sense_id": "84687a7a-9cb7-3e8b-a58f-b628766e4a99",
                                                "text": "Die Auswechselspieler tragen blaue Leibchen über dem Trikot."
                                            },
                                            {
                                                "example_id": "9ddb69b1-c0d8-4654-b4df-cc8c8090aba7",
                                                "sense_id": "84687a7a-9cb7-3e8b-a58f-b628766e4a99",
                                                "text": "„Ich erinnere mich noch genau an das scheußliche Leibchen, das sie ihm überstreifte.“"
                                            },
                                            {
                                                "example_id": "a581e66d-a352-4c9d-9b0a-428626dac241",
                                                "sense_id": "84687a7a-9cb7-3e8b-a58f-b628766e4a99",
                                                "text": "„Ihr tiefausgeschnittenes Leibchen hatte mich durch die Spitzen ihres Umhangs die Knospen der Brüste sehen lassen; nur einen Augenblick lang hatte ich hingeschaut, und erschreckt wagte ich es nicht ein zweites Mal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75eaba63-5b0e-4092-bba0-12b291ff20d0",
                        "source_entry_id": "49dc6ca3-3acd-33c3-9249-52c6a6b90cb5",
                        "source_sense_description": "undergarment",
                        "target_lang_word": "Mieder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mieder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4cd683b-0341-3514-a855-64105b25eed6",
                                        "entry_id": "713b6284-7b38-3cb6-8525-c4d23336d637",
                                        "glosses": [
                                            "figurformendes Kleidungsstück, das am Oberkörper getragen wird; teilweise fester Bestandteil des Kleides"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f57eed1-cc69-4959-ac31-a4ed9b7e005f",
                                                "sense_id": "b4cd683b-0341-3514-a855-64105b25eed6",
                                                "text": "Das Mieder ist vor allem in der Trachtenmode verbreitet."
                                            },
                                            {
                                                "example_id": "d5f5a62c-d69f-43a1-87e5-22e41984b95b",
                                                "sense_id": "b4cd683b-0341-3514-a855-64105b25eed6",
                                                "text": "„Zufrieden mit diesem Vorspiel, ließ der Verleger den Motor seiner Limousine an, die linke Hand im Mieder des Schätzchens.“"
                                            },
                                            {
                                                "example_id": "9d1007c2-a4b8-4407-b643-9f936d36285e",
                                                "sense_id": "b4cd683b-0341-3514-a855-64105b25eed6",
                                                "text": "„Stattdessen gerät er spürbar in Erregung, wenn auf Zelluloid ein Mieder eng geschnürt wird oder ein Unterrock aus Taft raschelt.“"
                                            },
                                            {
                                                "example_id": "5f5c4b37-60f7-439c-8c60-d04374895d8f",
                                                "sense_id": "b4cd683b-0341-3514-a855-64105b25eed6",
                                                "text": "„Die Gräfin sollte in einem Samtkleid von dunkelroter Farbe erscheinen, und die beiden Mädchen in weissem Kreppflor über rosaseidenen Kleidern, Rosen am Mieder und die Haare à la grecque frisiert.“"
                                            },
                                            {
                                                "example_id": "308c34d1-f240-4a67-9b62-2a886970c6c4",
                                                "sense_id": "b4cd683b-0341-3514-a855-64105b25eed6",
                                                "text": "„C. C. trug nur ein kurzes Mieder aus Taft und einen Rock aus dem gleichen Stoff; das war alles, was sie anhatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bf8304b-7a22-4fe7-919f-0b8fcab9ee4e",
