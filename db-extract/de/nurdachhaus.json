                        "entry_id": "6d0cddf8-7f39-3082-b0d6-cf9d9f223231",
                        "glosses": [
                            "Haus, bei dem die Dachflächen weit hinunter reichen und die Dachtraufe knapp über dem Erdboden liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4cb6b46-6e53-4bad-8d4c-6773611d13aa",
                                "sense_id": "8a89a3cc-38bc-3f2c-9175-c44c64670ecf",
                                "text": "„Bei dem Gebäude handelt es sich um ein einstöckiges Nurdachhaus aus den Siebzigern, und das Dach ist so steil, dass man beim Herunterrutschen die Schallmauer durchbrechen würde.“"
                            }
                        ],
