                "senses": [
                    {
                        "sense_id": "993e8f24-deb5-358a-a518-a14be54a2499",
                        "entry_id": "2d6f5a1b-16f2-31fd-8518-d243e83f8ce8",
                        "glosses": [
                            "weibliche Person, die als Angestellte in einem Hotel arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d25e51d5-5f49-4863-bfb1-e3b14c64a958",
                                "sense_id": "993e8f24-deb5-358a-a518-a14be54a2499",
                                "text": "„Es handelt sich um den Leichnam einer Fremden, offenbar eine honduranische Hotelangestellte, der es rücksichtsloserweise beliebte, in meinem hübschen Bettchen Selbstmord zu begehen und inmitten meiner importierten Steiff-Teddybären und limitierten Gund-Giraffen zu verwesen, wahrscheinlich mit einem Bauchvoll Xanax aus dem Vorrat meiner Mutter, und jetzt sickern ihre ekligen honduranischen Körperflüssigkeiten in meine handgenähte Hästens-Matratze und ruinieren meine ultraexklusive Porthault-Bettwäsche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
