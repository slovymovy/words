{
    "word_family": [
        "eradication",
        "eradicable",
        "eradicative",
        "eradicator",
        "ineradicable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a419110d-441f-3c00-a7e9-ab04163f9b73",
                    "sense_definition": "To destroy completely; to reduce to nothing radically; to put an end to.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Smallpox was globally <w>eradicated</w> in 1980 after a successful vaccination campaign.",
                            "target_lang_translations": {
                                "ru": "Оспа была глобально <w>искоренена</w> в 1980 году после успешной кампании по вакцинации.",
                                "nl": "Pokken werden wereldwijd <w>uitgeroeid</w> in 1980 na een succesvolle vaccinatiecampagne."
                            }
                        },
                        {
                            "text": "The government is launching a new initiative to <w>eradicate</w> poverty in rural areas.",
                            "target_lang_translations": {
                                "ru": "Правительство запускает новую инициативу, чтобы <w>искоренить</w> бедность в сельских районах.",
                                "nl": "De regering lanceert een nieuw initiatief om armoede in plattelandsgebieden te <w>uitbannen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "eliminate",
                        "exterminate",
                        "wipe out",
                        "obliterate",
                        "stamp out"
                    ],
                    "antonyms": [
                        "foster",
                        "protect",
                        "encourage"
                    ],
                    "common_phrases": [
                        "eradicate poverty",
                        "eradicate disease",
                        "completely eradicate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью уничтожить, искоренить или положить конец чему-либо.",
                        "nl": "Volledig vernietigen, uitroeien of een definitief einde maken aan iets ongewenst (zoals ziekten of problemen)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искоренить",
                                "target_lang_sense_clarification": "полностью устранить проблему или явление"
                            },
                            {
                                "target_lang_word": "ликвидировать",
                                "target_lang_sense_clarification": "прекратить существование чего-либо"
                            },
                            {
                                "target_lang_word": "уничтожить",
                                "target_lang_sense_clarification": "разрушить до основания"
                            },
                            {
                                "target_lang_word": "истребить",
                                "target_lang_sense_clarification": "полностью извести"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "uitroeien",
                                "target_lang_sense_clarification": "volledig laten verdwijnen van een ziekte of plaag"
                            },
                            {
                                "target_lang_word": "uitbannen",
                                "target_lang_sense_clarification": "definitief verwijderen of elimineren van een maatschappelijk probleem"
                            },
                            {
                                "target_lang_word": "met wortel en al uitroeien",
                                "target_lang_sense_clarification": "radicaal en grondig vernietigen"
                            },
                            {
                                "target_lang_word": "elimineren",
                                "target_lang_sense_clarification": "geheel uitschakelen of opheffen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "084ae4af-0eb3-3256-bdf8-cc6ac9c1beb1",
                    "sense_definition": "To pull up by the roots.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener had to <w>eradicate</w> the invasive weeds before they choked the flowers.",
                            "target_lang_translations": {
                                "ru": "Садовнику пришлось <w>выкорчевать</w> инвазивные сорняки, прежде чем они задушили цветы.",
                                "nl": "De tuinman moest het invasieve onkruid <w>ontwortelen</w> voordat het de bloemen verstikte."
                            }
                        },
                        {
                            "text": "It is difficult to <w>eradicate</w> plants that have deep, spreading root systems.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>вырывать с корнем</w> растения с глубокой, разветвленной корневой системой.",
                                "nl": "Het is moeilijk om planten met diepe, wijdverspreide wortelstelsels te <w>ontwortelen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "uproot",
                        "root out",
                        "extirpate"
                    ],
                    "antonyms": [
                        "radicate"
                    ],
                    "common_phrases": [
                        "eradicate weeds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вырвать с корнем.",
                        "nl": "Met wortel en al uit de grond trekken of verwijderen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выкорчевать",
                                "target_lang_sense_clarification": "вытащить из земли с корнями"
                            },
                            {
                                "target_lang_word": "вырывать с корнем",
                                "target_lang_sense_clarification": "физически удалять растение"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ontwortelen",
                                "target_lang_sense_clarification": "uit de grond losrukken van planten of bomen"
                            },
                            {
                                "target_lang_word": "uittrekken",
                                "target_lang_sense_clarification": "onkruid met de wortels uit de aarde trekken"
                            },
                            {
                                "target_lang_word": "wieden",
                                "target_lang_sense_clarification": "verwijderen van ongewenste planten uit de grond"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53516bd7-7834-340c-8191-73115aa939e4",
                    "sense_definition": "Past participle of <w>eradicate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The disease was <w>eradicated</w> many years ago.",
                            "target_lang_translations": {
                                "ru": "Болезнь была <w>ликвидирована</w> много лет назад.",
                                "nl": "De ziekte werd vele jaren geleden <w>uitgeroeid</w>."
                            }
                        },
                        {
                            "text": "Once the problem is <w>eradicated</w>, we can move on to the next phase.",
                            "target_lang_translations": {
                                "ru": "Как только проблема будет <w>устранена</w>, мы сможем перейти к следующему этапу.",
                                "nl": "Zodra het probleem is <w>uitgebannen</w>, kunnen we overgaan naar de volgende fase."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола eradicate; искорененный или уничтоженный.",
                        "nl": "Voltooid deelwoord van eradicate; uitgeroeid of geheel geëlimineerd."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искоренен",
                                "target_lang_sense_clarification": "о проблеме или болезни"
                            },
                            {
                                "target_lang_word": "ликвидирован",
                                "target_lang_sense_clarification": "о прекращении существования"
                            },
                            {
                                "target_lang_word": "уничтожен",
                                "target_lang_sense_clarification": "о полном разрушении"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "uitgeroeid",
                                "target_lang_sense_clarification": "voltooid deelwoord; van ziekten of plagen"
                            },
                            {
                                "target_lang_word": "uitgebannen",
                                "target_lang_sense_clarification": "voltooid deelwoord; van maatschappelijke kwaden of problemen"
                            },
                            {
                                "target_lang_word": "geëlimineerd",
                                "target_lang_sense_clarification": "voltooid deelwoord; volledig weggewerkt"
                            }
                        ]
                    }
                }
            ]
        }
