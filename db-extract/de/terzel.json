                ],
                "senses": [
                    {
                        "sense_id": "f9dcfb6b-7575-31cf-8aa4-f72882d87e61",
                        "entry_id": "fef98113-5659-379d-962c-0dec3d87041c",
                        "glosses": [
                            "männlicher Taggreifvogel, außer bei Sperber, Sakerfalke, Lannerfalke und Gerfalke"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "833e9535-84c7-4ee1-9bd7-9b0d5d06aaca",
                                "sense_id": "f9dcfb6b-7575-31cf-8aa4-f72882d87e61",
                                "text": "„Der Fürst liebte diesen Falken ganz besonders, ein Terzel aus fünfter Mauser und ein Geschenk des Scheykhs von Bahrein, der vor zwei Jahren eine wertvolle Stute dafür getauscht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4129bfab-efbf-41a3-9904-d5ea1ae1abd8",
                        "source_entry_id": "fef98113-5659-379d-962c-0dec3d87041c",
                        "source_sense_id": "f9dcfb6b-7575-31cf-8aa4-f72882d87e61",
                        "source_sense_description": "Jägersprache: männlicher Taggreifvogel, außer bei Sperber, Sakerfalke, Lannerfalke und Gerfalke",
                        "target_lang_word": "tiercel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tiercel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16ba78c7-e14d-30d7-9520-4d0bcaec139b",
                                        "entry_id": "2864673d-39c0-3ab8-a561-8033ce73d69f",
                                        "glosses": [
                                            "A male hawk or falcon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3605919c-3dd1-41b7-bc09-a8fb3fc9b6bd",
                                                "sense_id": "16ba78c7-e14d-30d7-9520-4d0bcaec139b",
                                                "text": "In this wise, the glossy bright-eyed kestrel, whom tiercels’ training could not reclaim, shook off silver bells, and velvet hood, and broidered jesses; and fled away—to consort, henceforward for evermore, with gleds, and hawks, and such birds of prey as make their nests deep in Bohemian forests, or in the desolate places of the Wilderness that girdles the frontier of the reputable world."
                                            },
                                            {
                                                "example_id": "2db85fc9-9d7f-44ca-9ff3-1399700088fa",
                                                "sense_id": "16ba78c7-e14d-30d7-9520-4d0bcaec139b",
                                                "text": "He is a tiercel, lean and long and supple-winged, the first of the year."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97c1b4cf-dfec-4e28-a46b-6c829362af52",
                        "source_entry_id": "fef98113-5659-379d-962c-0dec3d87041c",
                        "source_sense_id": "f9dcfb6b-7575-31cf-8aa4-f72882d87e61",
                        "source_sense_description": "Jägersprache: männlicher Taggreifvogel, außer bei Sperber, Sakerfalke, Lannerfalke und Gerfalke",
                        "target_lang_word": "tiercelet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tiercelet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34b8f1ed-5c8a-3081-87f8-6ae5fd8bb6c5",
                                        "entry_id": "debfe96a-215d-39b2-892b-eb4aa7fbcdde",
                                        "glosses": [
                                            "Oiseau de proie mâle, ainsi nommé parce qu’il est d’un tiers plus petit que la femelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb5d23df-fa1a-4066-84cf-9aa4ba067d55",
                                                "sense_id": "34b8f1ed-5c8a-3081-87f8-6ae5fd8bb6c5",
                                                "text": "Un tiercelet de faucon, d’épervier."
                                            },
                                            {
                                                "example_id": "3dbbbc46-5a46-43a0-a1c9-9cdaa722b104",
                                                "sense_id": "34b8f1ed-5c8a-3081-87f8-6ae5fd8bb6c5",
                                                "text": "La fauconnerie, peut-être, dépassait la meute ; le bon seigneur, à force d’argent, s’était procuré des tiercelets du Caucase, des sacres de Babylone, des gerfauts d’Allemagne, et des faucons pèlerins, capturés sur les falaises, au bord des mers froides, en de lointains pays."
                                            },
                                            {
                                                "example_id": "bf063720-d46f-4ef1-b18c-8702ce6b4556",
                                                "sense_id": "34b8f1ed-5c8a-3081-87f8-6ae5fd8bb6c5",
                                                "text": "Ils m’aperçurent et fondirent sur moi comme deux tiercelets, avec des rires, des balles blanches et rouges, une étourderie apprêtée et bavarde…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc8e3b46-33cb-3b08-982e-2bb6642f477a",
                                        "entry_id": "debfe96a-215d-39b2-892b-eb4aa7fbcdde",
                                        "glosses": [
                                            "Faucon mâle."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49d687bd-9d6d-47b2-b8d3-8b81aa4f94bd",
                                                "sense_id": "cc8e3b46-33cb-3b08-982e-2bb6642f477a",
                                                "text": "Le tiercelet peut peser jusqu’à 650 g, la forme peut atteindre le kilo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
