                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2f8cf1f-cb9d-42f1-bae4-79bf0171db35",
                                "sense_id": "abf787da-9fad-3820-848e-ffaad30e04f3",
                                "text": "It was tender and delicious, with a kind of porky taste you didn't often get from supermarket meats."
                            }
