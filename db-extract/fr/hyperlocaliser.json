                ],
                "senses": [
                    {
                        "sense_id": "5947b3fb-00d2-3474-ac15-9f4e72024f25",
                        "entry_id": "c41c488e-3116-31df-836b-a7f471ba26dc",
                        "glosses": [
                            "Localiser de façon très précise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6419e51d-18db-4eb0-b954-e1de12841e95",
                                "sense_id": "5947b3fb-00d2-3474-ac15-9f4e72024f25",
                                "text": "Et quand Chateaubriand va à Jérusalem (Itinéraire de Paris à Jérusalem...), il hyperlocalise non seulement les lieux des évangiles, mais aussi les lieux de toute bataille narrée par Le Tasse, qui lui paraît écrite, dit-il, au coin d'un rempart, « sur un bouclier » !"
                            }
                        ]
                    },
                    {
                        "sense_id": "90a52ce7-8c6f-3ea7-9b9c-3bf392ca10ae",
                        "entry_id": "c41c488e-3116-31df-836b-a7f471ba26dc",
                        "glosses": [
                            "Donner un caractère hyperlocal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2abae36b-6071-4e27-809f-86337c6a8d65",
                                "sense_id": "90a52ce7-8c6f-3ea7-9b9c-3bf392ca10ae",
                                "text": "« L'objectif est d'hyperlocaliser nos jeux, afin de les rendre parfaitement adaptés et accessibles au public du pays ciblé \", explique Franck Tetzlaff, cofondateur et patron de Kobojo."
                            },
                            {
                                "example_id": "d765856b-106b-451e-8875-4917d16434fd",
                                "sense_id": "90a52ce7-8c6f-3ea7-9b9c-3bf392ca10ae",
                                "text": "« C'est un objectif que je m'étais assigné dès le départ : ne pas hyperlocaliser le propos."
                            }
                        ]
                    }
                ],
