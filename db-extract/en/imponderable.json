                                        ],
                                        "tags": [
                                            "bezogen auf die Reaktionen aufgrund eines sprunghaften Denkens und Empfindens"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b946485a-822c-448c-86ef-fcadc7eaf44a",
                                                "sense_id": "db0c0480-6fc3-3612-9119-70f40920776c",
                                                "text": "Wenn Paul viel Alkohol trinkt, wird er zu einer unberechenbaren Gefahr für seine Mitmenschen."
