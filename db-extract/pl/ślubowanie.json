                        "translation_id": "2c8c2a8d-6e06-4f77-ad5e-03495189d2a2",
                        "source_entry_id": "f7727732-ccf1-329d-8131-031492c5da9e",
                        "source_sense_id": "c73cf42c-df64-3971-bb15-e17462c9be11",
                        "target_lang_word": "Gelübde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gelübde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef4ddbb6-fa8e-3782-bfdb-c5c61a1dfa95",
                                        "entry_id": "b1853f96-bbcd-3fd0-88d2-5d2f20fdbeda",
                                        "glosses": [
                                            "Versprechen, meist gegenüber Gott"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c7fe7a1-7bba-4855-b6da-7f0a8baaae0a",
                                                "sense_id": "ef4ddbb6-fa8e-3782-bfdb-c5c61a1dfa95",
                                                "text": "Sie befolgen ihre Gelübde mit großer Disziplin."
                                            },
                                            {
                                                "example_id": "6c0a938e-ce47-496e-82e8-8c20a04217bb",
                                                "sense_id": "ef4ddbb6-fa8e-3782-bfdb-c5c61a1dfa95",
                                                "text": "Die Mönche legen das Gelübde der Armut ab."
                                            },
                                            {
                                                "example_id": "6a6d0c36-add4-4c4a-aeef-4f5a5d1d0c72",
                                                "sense_id": "ef4ddbb6-fa8e-3782-bfdb-c5c61a1dfa95",
                                                "text": "Nach der Rettung legte sie das stille Gelübde ab, nie wieder ein Flugzeug zu betreten."
                                            },
                                            {
                                                "example_id": "2c7d8ee5-1257-418f-ba49-5a175802fc07",
                                                "sense_id": "ef4ddbb6-fa8e-3782-bfdb-c5c61a1dfa95",
                                                "text": "„Am Schluß bedankte sie sich bei allen, die ihr geholfen hatten, ihr Gelübde zu erfüllen, und verließ das Bethaus.“"
                                            },
                                            {
                                                "example_id": "04dfd362-a357-49f3-8ff7-42c404f39e40",
                                                "sense_id": "ef4ddbb6-fa8e-3782-bfdb-c5c61a1dfa95",
                                                "text": "„Götterstatuen und Inschriften verraten uns, dass man in den Umgangstempeln ebenfalls Gelübde darbrachte.“"
                                            },
                                            {
                                                "example_id": "ac1d6c49-8ef2-4f75-a09c-0135b2820347",
                                                "sense_id": "ef4ddbb6-fa8e-3782-bfdb-c5c61a1dfa95",
                                                "text": "„Lillian hatte viele Gelübde in der Zwischenzeit getan, von denen sie glauben wollte, daß sie sie halten würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
