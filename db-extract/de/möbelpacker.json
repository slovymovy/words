                "senses": [
                    {
                        "sense_id": "1a537975-8ddb-3a6b-b8a7-fb01f22ef90e",
                        "entry_id": "af3ba8d8-e537-3fa6-8ee7-7cb6fe97c964",
                        "glosses": [
                            "eine Person, die bei einer Spedition damit beschäftigt ist, Möbel und anderes Umzugsgut einzupacken und beim Umzug zu transportieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a9caf83-85e3-4c3c-9db3-3e85729f006a",
                                "sense_id": "1a537975-8ddb-3a6b-b8a7-fb01f22ef90e",
                                "text": "„Die Möbelpacker schleppten ein Mordstrumm von gebrauchtem Klavier durch die Garage und die Waschküche in den Hobbyraum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce29b439-daf4-4a8c-8658-aec3444ba20f",
                        "source_entry_id": "af3ba8d8-e537-3fa6-8ee7-7cb6fe97c964",
                        "source_sense_id": "1a537975-8ddb-3a6b-b8a7-fb01f22ef90e",
                        "target_lang_word": "déménageur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déménageur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fcdbae8e-647c-3b53-b6dc-be5211a4c255",
                                        "entry_id": "6ab1ff97-7d09-320f-a91c-4d79eedd2fbb",
                                        "glosses": [
                                            "Celui qui fait métier d’opérer des déménagements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e9bd891-52ec-4ac4-8194-bf4d257a6c38",
                                                "sense_id": "fcdbae8e-647c-3b53-b6dc-be5211a4c255",
                                                "text": "Lucienne. — Tenez, enlevez votre gilet, vous avez l’air du déménageur comme cela."
                                            },
                                            {
                                                "example_id": "2901cec5-fe20-4a64-ad93-7d4101944184",
                                                "sense_id": "fcdbae8e-647c-3b53-b6dc-be5211a4c255",
                                                "text": "Ils avaient l’air de remuer ces objets sans raison, pour se donner l’illusion de la vie, tels des déménageurs somnambules."
                                            },
                                            {
                                                "example_id": "d5e3b805-b8a3-4124-a460-6f96116d77be",
                                                "sense_id": "fcdbae8e-647c-3b53-b6dc-be5211a4c255",
                                                "text": "La bonne fortune lui avait souri en la personne d’un déménageur dont l’entreprise se situait près de son logis."
                                            },
                                            {
                                                "example_id": "c221b0b5-ebcb-4e3f-ab30-f974f14fa169",
                                                "sense_id": "fcdbae8e-647c-3b53-b6dc-be5211a4c255",
                                                "text": "Les rares consommateurs entraient en coup de vent, buvaient un canon sur le pouce, filaient ventre à terre. Un groupe de déménageurs vint bruyamment siffler quelques pots puis disparut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66a185bf-c815-362c-a632-6f53c99985cc",
                                        "entry_id": "6ab1ff97-7d09-320f-a91c-4d79eedd2fbb",
                                        "glosses": [
                                            "Personne hyperactive, qui chamboule tout."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bf70093-4f2f-4fff-b7ab-e583e4bf66d2",
                                                "sense_id": "66a185bf-c815-362c-a632-6f53c99985cc",
                                                "text": "On a bousculé ces Sud-Africains réputés être des déménageurs, on est bien entré dans ce match et on s’est donné les moyens de le gagner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
