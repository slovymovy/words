                "senses": [
                    {
                        "sense_id": "cf0ec194-d0a8-3a49-a643-9b06ed06e720",
                        "entry_id": "3c6499ba-3b05-3f9e-b116-a635973b3e38",
                        "glosses": [
                            "vereerder van een goddelijk wezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b02d7b8-6e8b-48fe-85b9-df6bd71485a6",
                                "sense_id": "cf0ec194-d0a8-3a49-a643-9b06ed06e720",
                                "text": "In het oude Egypte waren veel aanbidders van Zonnegod"
                            }
                        ]
                    },
                    {
                        "sense_id": "1f6d59a2-eef4-3297-acdd-e0f1fb17f77d",
                        "entry_id": "3c6499ba-3b05-3f9e-b116-a635973b3e38",
                        "glosses": [
                            "verliefd persoon, die een ander het hof maakt"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "308d33b3-370b-4671-bb8f-9b15617fb757",
                                "sense_id": "1f6d59a2-eef4-3297-acdd-e0f1fb17f77d",
                                "text": "De jonge, mooie, rijke, vriendelijke, intelligente vrouw heeft vele aanbidders."
                            }
                        ]
                    },
                    {
                        "sense_id": "49c38778-8de0-3929-b5bf-c5ba92151f36",
                        "entry_id": "3c6499ba-3b05-3f9e-b116-a635973b3e38",
                        "glosses": [
                            "stille aanbidder: een verliefd iemand die zijn liefde niet durft te uiten, een heimelijke aanbidder"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a0307191-853d-3dd4-9fa0-5a11e5fad630",
                        "entry_id": "3c6499ba-3b05-3f9e-b116-a635973b3e38",
                        "glosses": [
                            "persoon die een vrouw liefheeft maar er niet mee getrouwd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfca163d-ef65-4011-a645-22960fca225b",
                                "sense_id": "a0307191-853d-3dd4-9fa0-5a11e5fad630",
                                "text": "De verlegen jongen was een stille aanbidder van het knappe meisje."
                            },
                            {
                                "example_id": "fcca73fd-1560-4cbe-afbe-c71d83eeda1c",
                                "sense_id": "a0307191-853d-3dd4-9fa0-5a11e5fad630",
                                "text": "Wat hij het meest vreesde was niet een bekentenis over een geheime minnaar, maar de totale afwezigheid van welke minnaar of aanbidder dan ook."
                            },
                            {
                                "example_id": "cc0f5167-8c02-47ad-ad06-0e5d54a6ccd7",
                                "sense_id": "a0307191-853d-3dd4-9fa0-5a11e5fad630",
                                "text": "Ze heeft je blijkbaar weer opgenomen in de kring van haar aanbidders."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5dc3038-64c6-48f2-9612-873560703db9",
                        "source_entry_id": "3c6499ba-3b05-3f9e-b116-a635973b3e38",
                        "source_sense_id": "cf0ec194-d0a8-3a49-a643-9b06ed06e720",
                        "source_sense_description": "vereerder van een goddelijk wezen",
                        "target_lang_word": "Anbeter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anbeter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e9698ba-a6d5-3ae3-9990-fbe087d4cb00",
                                        "entry_id": "f4a44898-6071-374a-8b4e-1b64cada1872",
                                        "glosses": [
                                            "Person, die eine Sache, eine Person oder ein göttliches Wesen anbetet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "248c0454-f562-40fd-83db-eb8ffde1ad0c",
                                                "sense_id": "6e9698ba-a6d5-3ae3-9990-fbe087d4cb00",
                                                "text": "„Gehen wir voran mit Christus und leben wir unser Leben als wirkliche Anbeter Gottes. Amen.“"
                                            },
                                            {
                                                "example_id": "baff0706-59a1-4b8e-ab3e-97d47b4ece28",
                                                "sense_id": "6e9698ba-a6d5-3ae3-9990-fbe087d4cb00",
                                                "text": "„Sie sind die Anbeter der Äußerlichkeiten, die den Juden vergangener Tage ähnlich geworden sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cfbf8ca6-8e47-31e8-a937-fc450cb478e4",
                                        "entry_id": "f4a44898-6071-374a-8b4e-1b64cada1872",
                                        "glosses": [
                                            "Person, die einen Star oder eine andere Person des öffentlichen Leben hoch verehrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48de8af1-3b2c-4e74-8397-badb26091a12",
                                                "sense_id": "cfbf8ca6-8e47-31e8-a937-fc450cb478e4",
                                                "text": "„Ein Star mag seine Fans bezirzen, der Diva liegen Anbeter zu Füssen.“"
                                            },
                                            {
                                                "example_id": "52e88157-0a86-4c0f-b3ce-686eb1fe9160",
                                                "sense_id": "cfbf8ca6-8e47-31e8-a937-fc450cb478e4",
                                                "text": "„Einer der Leute sagte, dass der Stein bei der letzten Ziehung richtig lag, als er einigen seiner Anbeter die 12 verriet, die dann tatsächlich gewann.“"
                                            },
                                            {
                                                "example_id": "0e31fff1-9471-471c-a9bb-c48d3407711f",
                                                "sense_id": "cfbf8ca6-8e47-31e8-a937-fc450cb478e4",
                                                "text": "„Julie wartete schon seit langem auf einen Antrag ihres melancholischen Anbeters und war bereit, ihn anzunehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86ebec18-66f6-4131-94ec-be0be5add0e7",
                        "source_entry_id": "3c6499ba-3b05-3f9e-b116-a635973b3e38",
                        "source_sense_id": "cf0ec194-d0a8-3a49-a643-9b06ed06e720",
                        "source_sense_description": "vereerder van een goddelijk wezen",
                        "target_lang_word": "worshipper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "worshipper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5323995b-861a-3ace-85a9-834715f65654",
                                        "entry_id": "c48dbc76-8e74-35c6-9f53-369eaaabd767",
                                        "glosses": [
                                            "A person who worships, especially at a place of assembly for religious services."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec27be60-a66e-4dd1-8775-85bcc558f6d8",
                                                "sense_id": "5323995b-861a-3ace-85a9-834715f65654",
                                                "text": "The temple was filled with worshippers."
                                            },
                                            {
                                                "example_id": "1271803b-7ea8-489d-8e34-a929d12b3f2c",
                                                "sense_id": "5323995b-861a-3ace-85a9-834715f65654",
                                                "text": "Sadly, the ever-eager Reverend Judith had not been able to conjure up many worshippers, even though it was Father’s Day. There was just one old dear sitting halfway back, her faulty hearing aid letting off a high-pitched whistle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "525106f1-053d-4a34-bf1e-b558ab10379b",
                        "source_entry_id": "3c6499ba-3b05-3f9e-b116-a635973b3e38",
