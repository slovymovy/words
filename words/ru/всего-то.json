{
    "word_family": [
        "всего",
        "все"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "aaa593ce-827e-3463-9776-cac8f0d3dee4",
                    "sense_definition": "Используется для подчёркивания очень малого, незначительного количества или размера чего-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity_limitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У меня в кошельке <w>всего-то</w> сто рублей осталось до зарплаты.",
                            "target_lang_translations": {
                                "en": "I have <w>only</w> one hundred rubles left in my wallet until payday."
                            }
                        },
                        {
                            "text": "Мы проехали <w>всего-то</w> пять километров, а машина уже сломалась.",
                            "target_lang_translations": {
                                "en": "We had driven <w>just</w> five kilometers, and the car already broke down."
                            }
                        }
                    ],
                    "synonyms": [
                        "всего",
                        "всего лишь",
                        "всего-навсего",
                        "всего только",
                        "лишь",
                        "только"
                    ],
                    "common_phrases": [
                        "всего-то ничего",
                        "всего-то раз"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to emphasize a very small or insignificant amount or size of something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "only",
                                "target_lang_sense_clarification": "General term for a small quantity."
                            },
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "Emphasizes the smallness or insignificance of the amount."
                            },
                            {
                                "target_lang_word": "a mere",
                                "target_lang_sense_clarification": "Used to emphasize that an amount is surprisingly small."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c99ae333-61f4-3721-8d48-77550da380f6",
                    "sense_definition": "Восклицание, выражающее удивление по поводу незначительного количества или размера чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quantity_limitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты купил <w>всего-то</w> один хлеб на всю неделю?",
                            "target_lang_translations": {
                                "en": "You bought <w>only</w> one loaf of bread for the whole week?"
                            }
                        },
                        {
                            "text": "Они ждали гостей целый час, а пришло <w>всего-то</w> два человека.",
                            "target_lang_translations": {
                                "en": "They waited for guests for a whole hour, and <w>just</w> two people showed up."
                            }
                        }
                    ],
                    "synonyms": [
                        "всего",
                        "всего лишь",
                        "всего-навсего"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An exclamation expressing surprise at the smallness or insignificance of an amount or size."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "only",
                                "target_lang_sense_clarification": "Used in an exclamatory way to highlight a surprisingly low number."
                            },
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "Used to express disbelief or surprise at a small quantity."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}