                        "examples": [
                            {
                                "example_id": "c8dda8a3-5878-4c33-b3b6-b0d67ccfd8b2",
                                "sense_id": "b6ffe9b6-751d-3515-b067-df93d5cd8498",
                                "text": "„Er blickte zum Fenster hinaus auf die davor liegende Straße, das trübe Winterlicht der Straßenlaternen.“"
                            },
                            {
                                "example_id": "f6b21b09-ef0b-413f-9088-e68f8224fef9",
                                "sense_id": "b6ffe9b6-751d-3515-b067-df93d5cd8498",
                                "text": "„Jedes Jahr starb ein Teil von dir, wenn die Blätter von den Bäumen fielen und ihre Zweige kahl in den Wind und das kalte Winterlicht ragten.“"
                            }
                        ],
