                                "target_word": "lyrique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e292b9e-8ae8-3f0c-9cc4-196944ac42d7",
                                        "entry_id": "78b8d83d-bd34-3340-ba41-088774880689",
                                        "glosses": [
                                            "Auteur lyrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47c63d32-5986-49b6-9ec1-31ea483c5a75",
                                                "sense_id": "4e292b9e-8ae8-3f0c-9cc4-196944ac42d7",
                                                "text": "C’est là, c’est dans l’île de Lesbos que les premiers lyriques ont chanté leurs premiers vers dans une langue européenne."
