                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cee99bb-fdf0-4b9b-8521-4d310be87d9c",
                                                "sense_id": "34d6bd4d-ee8c-3bd8-9e0d-64c684acd9f6",
                                                "text": "bourgeois opinion"
