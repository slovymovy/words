                    "sense_id": "bf30878c-2f5d-300b-8a4b-b5045c2f731b",
                    "sense_definition": "Meervoud van <w>bal</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "objecten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen spelen buiten met verschillende <w>ballen</w> in de tuin.",
                            "target_lang_translations": {
                                "ru": "Дети играют в саду с разными <w>мячами</w>.",
                                "en": "The children are playing outside in the garden with various <w>balls</w>."
                            }
                        },
                        {
                            "text": "In de mand liggen drie rode <w>ballen</w> voor de hond.",
                            "target_lang_translations": {
                                "ru": "В корзине лежат три красных <w>мячика</w> для собаки.",
                                "en": "There are three red <w>balls</w> for the dog in the basket."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова bal (мяч, шар).",
                        "en": "Plural form of the word 'bal' (ball)."
                    },
