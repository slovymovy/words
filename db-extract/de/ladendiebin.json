                "senses": [
                    {
                        "sense_id": "33e87773-d5e8-3034-bc1e-3ad8eff23646",
                        "entry_id": "5597c7e5-5be0-38ee-b6e6-088276b5f55f",
                        "glosses": [
                            "weibliche Person, die in einem Laden Gegenstände mit der Absicht wegnimmt, sich diese widerrechtlich zuzueignen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb957faf-8c05-4e47-a402-09ff44b34da4",
                                "sense_id": "33e87773-d5e8-3034-bc1e-3ad8eff23646",
                                "text": "Eine Ladendiebin hat im Supermarkt vier Eier gestohlen."
                            },
                            {
                                "example_id": "b94a24de-ab3a-41c3-80d8-72b4f33587f7",
                                "sense_id": "33e87773-d5e8-3034-bc1e-3ad8eff23646",
                                "text": "Als sie von einem Kaufhausdetektiv auf frischer Tat erwischt wurde, ist eine Ladendiebin am Montag im Bezirk Mödling rabiat geworden."
                            },
                            {
                                "example_id": "adcdaacc-81a6-4b4e-9be8-5143bce4d2d8",
                                "sense_id": "33e87773-d5e8-3034-bc1e-3ad8eff23646",
                                "text": "„In meinen Trainingsanzug, den ich ständig trage, haben wir Taschen aus Wachstuch eingenäht, damit ich mich in Glowitz als Ladendiebin betätigen kann, zum Beispiel an der Schmalztonne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "652a913d-344e-4f89-a76d-491699309eec",
                        "source_entry_id": "5597c7e5-5be0-38ee-b6e6-088276b5f55f",
                        "source_sense_id": "33e87773-d5e8-3034-bc1e-3ad8eff23646",
                        "target_lang_word": "shoplifter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shoplifter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffebacf0-88b6-3cbc-a07b-898e95ea75ec",
                                        "entry_id": "cb4580d5-8aee-3293-aa97-b85c687b489d",
                                        "glosses": [
                                            "A person who shoplifts, one who steals from shops."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ccefbf7-eea9-4e21-aa26-33e55c24b901",
                                                "sense_id": "ffebacf0-88b6-3cbc-a07b-898e95ea75ec",
                                                "text": "Shoplifters will be prosecuted."
                                            },
                                            {
                                                "example_id": "37aa25d6-123f-4b5c-9a5c-4e4365a3515d",
                                                "sense_id": "ffebacf0-88b6-3cbc-a07b-898e95ea75ec",
                                                "text": "The shoplifters are much less to be dreaded than the sneak, as they do not carry off cash, rarely any very valuable property […]"
                                            },
                                            {
                                                "example_id": "eaba9b81-d605-4e74-b7a2-e79fe313623e",
                                                "sense_id": "ffebacf0-88b6-3cbc-a07b-898e95ea75ec",
                                                "text": "Like their friends the \"draggers,\" the \"hoisters\" or shoplifters are having a thin time these days, […]"
                                            },
                                            {
                                                "example_id": "94f051b1-e513-447d-84a0-cbe805cef85b",
                                                "sense_id": "ffebacf0-88b6-3cbc-a07b-898e95ea75ec",
                                                "text": "[…] just as the unchastised teenage shoplifter, mistaking society’s indulgence for applause, will evolve into a bloodthirsty hired killer, it is inevitable that the author of “The Pencil” will one day morph into the author of “The Toothpick.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
