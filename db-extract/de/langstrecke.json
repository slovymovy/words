                    {
                        "sense_id": "9b833f31-4988-3e57-8814-710efa49e7f2",
                        "entry_id": "0e14d95f-63bd-345e-9a4f-1df447b5ed45",
                        "glosses": [
                            "Long-courrier, activité de transport maritime ou aérien sur de longues distances."
                        ],
