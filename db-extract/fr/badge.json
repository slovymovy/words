                        "glosses": [
                            "Insigne généralement rond fixé sur un vêtement ; macaron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d78d84b8-bee9-429a-9b1c-84d10f307edf",
                                "sense_id": "9ef5c78a-80f4-3917-9428-24ed70403c37",
                                "text": "Des affiches de mai 68 aux murals républicains de Belfast, des caricatures anti-tsaristes de la révolution russe de 1905 au drapeau arc-en-ciel des militants pacifistes, des placards « ouvriers » de Jules Grandjouan au badge « Touche pas à mon pote » de SOS racisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "8206a1e8-6298-3b28-b794-6fe6f2561f58",
                        "entry_id": "bfae19fd-0f0f-3230-b3f3-18988f8e9fec",
                        "glosses": [
                            "Porte-nom, carte rigide détachable, parfois magnétique, destinée à prouver son identité ou à avoir accès à certains lieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11bd8f20-1971-4b14-bfc6-c23144328544",
                                "sense_id": "8206a1e8-6298-3b28-b794-6fe6f2561f58",
                                "text": "Avec une porte normale, l’intrus n’a qu’à attendre qu’un salarié se présente et utilise son badge pour ouvrir l’accès."
                            }
                        ]
                    },
                    {
                        "sense_id": "2466a512-1ec9-3352-ba71-15126456ff19",
                        "entry_id": "bfae19fd-0f0f-3230-b3f3-18988f8e9fec",
