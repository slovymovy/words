                    },
                    {
                        "sense_id": "95d9f905-8488-3bde-817a-9f1d3d02522e",
                        "entry_id": "af5efc66-4eb7-3453-a5cf-8786b93c9641",
                        "glosses": [
                            "Déambulateur, appareil qui aide les personnes âgées à marcher, en leur servant de support."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "c9d7a846-7829-4a89-8925-5c716c246fce",
                                "sense_id": "95d9f905-8488-3bde-817a-9f1d3d02522e",
                                "text": "Un homme de 61 ans aurait été battu à mort avec sa propre marchette dans la buanderie de sa résidence pour aînés vendredi dernier après qu’un conflit ait éclaté avec un septuagénaire, en lien avec son usage de la machine à laver."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e47a25c-dcd8-3879-b7ac-a200c37557c0",
                        "entry_id": "af5efc66-4eb7-3453-a5cf-8786b93c9641",
                        "glosses": [
                            "Youpala"
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "09e9f522-7af9-4d98-810e-46d5df1f92bd",
                                "sense_id": "5e47a25c-dcd8-3879-b7ac-a200c37557c0",
                                "text": "Avec sa marchette, ma fille s'engouffre dans l'escalier. Je cours, j'arrive presque à temps pour l'attraper, mais la marchette bascule, vole, ne touche pas une seule marche."
                            }
                        ]
                    },
                    {
                        "sense_id": "05687c4b-88d9-3780-86e7-d0fb220bdc97",
                        "entry_id": "af5efc66-4eb7-3453-a5cf-8786b93c9641",
                        "glosses": [
                            "Bande antidérapante ou anti usure fixée sur le nez de la marche d'un escalier. Il peut s'agir de moquette collée, de barre métallique, de bande émerisée, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ca23462-2952-4191-9207-d699e0005c53",
                                "sense_id": "05687c4b-88d9-3780-86e7-d0fb220bdc97",
                                "text": "On se contente quelquefois de ne poser la thibaude que sur le nez et le giron des marches ; mais cette marchette peut glisser et se déplacer."
                            }
                        ]
                    }
