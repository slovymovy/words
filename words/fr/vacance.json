    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "96e07e81-17b7-38a3-8796-a05c9de52c6d",
                    "sense_definition": "Période d'interruption des cours dans les établissements scolaires ou universitaires.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "repos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves attendent avec impatience les grandes <w>vacances</w> d'été."
                        },
                        {
                            "text": "Nous aimons partir à la mer pendant les <w>vacances</w> scolaires."
                        }
                    ],
                    "synonyms": [
                        "congé"
                    ],
                    "common_phrases": [
                        "grandes vacances",
                        "partir en vacances"
                    ]
                },
                {
                    "sense_id": "aa7caa59-f56a-3339-b67d-394f3f893ec6",
                    "sense_definition": "Période légale de repos accordée aux salariés et aux employés.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "repos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les employés ont droit à cinq semaines de <w>vacances</w> par an."
                        },
                        {
                            "text": "Il a décidé de prendre des <w>vacances</w> pour se reposer."
                        }
                    ],
                    "synonyms": [
                        "congé",
                        "repos"
                    ],
                    "common_phrases": [
                        "prendre des vacances",
                        "jours de vacances"
                    ]
                },
                {
                    "sense_id": "64b20cb2-8274-36d6-944c-d38166b2bf84",
                    "sense_definition": "Interruption temporaire que l'on s'accorde dans ses activités ou occupations habituelles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "repos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs mois de travail intensif, elle s'accorde enfin quelques <w>vacances</w>."
                        },
                        {
                            "text": "Cet auteur a pris des <w>vacances</w> loin de l'écriture de son roman."
                        }
                    ],
                    "synonyms": [
                        "repos"
                    ],
                    "common_phrases": [
                        "s'accorder des vacances"
                    ]
                },
                {
                    "sense_id": "6a76929e-0355-33de-b9e6-9fb263dd9918",
                    "sense_definition": "État d'un poste, d'une charge ou d'une fonction temporairement dépourvus de titulaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inoccupation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La démission inattendue du ministre a laissé une <w>vacance</w> temporaire à la tête du ministère."
                        },
                        {
                            "text": "La direction cherche un remplaçant pour combler la <w>vacance</w> de ce poste."
                        }
                    ],
                    "common_phrases": [
                        "vacance du pouvoir",
                        "vacance de poste"
                    ]
                },
                {
                    "sense_id": "fcff241d-a034-3833-b4ba-424af67f22d1",
                    "sense_definition": "Situation juridique d'une succession qui n'est réclamée par aucun héritier légitime.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inoccupation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a constaté la <w>vacance</w> de la succession faute d'héritiers connus."
                        },
                        {
                            "text": "En cas de <w>vacance</w> prolongée, les biens du défunt reviennent à l'État."
                        }
                    ],
                    "common_phrases": [
                        "vacance d'une succession"
                    ]
                }
            ]
        }
    ]
