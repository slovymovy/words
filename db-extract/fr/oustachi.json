                        "entry_id": "fec7d9c9-ec98-30ec-8e1a-2e70d7385e87",
                        "glosses": [
                            "Milicien fascisant croate, au pouvoir en Croatie entre 1941 et 1945."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75f15f42-2f36-49c8-875e-fa8545e2034a",
                                "sense_id": "bab62975-e2b8-3c9b-ad4f-d779de6c6aba",
                                "text": "Le troisième cliché figure un oustachi brandissant un couteau qui dégouline de sang."
                            },
                            {
                                "example_id": "ef64810b-31cb-41dd-9485-c2da1453cd92",
                                "sense_id": "bab62975-e2b8-3c9b-ad4f-d779de6c6aba",
                                "text": "Au printemps 1941, après l'invasion de la Yougoslavie par les troupes hitlériennes, les oustachis reçoivent des nazis le gouvernement d'un nouveau territoire : l'État indépendant croate qui rejoint officiellement l'Axe Rome-Berlin-Tokyo le 15 juin 1941."
                            }
                        ]
                    }
