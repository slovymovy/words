                                                "example_id": "8d47d291-2984-4c20-9477-7bcda0332851",
                                                "sense_id": "9f244553-040d-30aa-b3f2-b1f1e8620d12",
                                                "text": "Het politieke bewustzijn van radicale jongeren is groter dan van andere jongeren."
                                            }
