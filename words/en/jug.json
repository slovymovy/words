{
    "word_family": [
        "jugful",
        "jugged",
        "jugging"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "56ef8297-3e0c-346b-a4c0-b8bd0c083b73",
                    "sense_definition": "A serving vessel or container, typically circular in cross-section and higher than it is wide, with a small mouth or spout and a handle.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "containers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She poured some fresh milk from the <w>jug</w> into her coffee.",
                            "target_lang_translations": {
                                "ru": "Она налила немного свежего молока из <w>кувшина</w> в кофе."
                            }
                        },
                        {
                            "text": "Please put a <w>water</w> <w>jug</w> on the table for the guests.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, поставь <w>кувшин</w> для воды на стол для гостей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "water jug",
                        "milk jug",
                        "glass jug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосуд для подачи или хранения жидкостей, обычно округлый, высокий, с узким горлышком или носиком и ручкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кувшин",
                                "target_lang_sense_clarification": "универсальный сосуд с ручкой"
                            },
                            {
                                "target_lang_word": "графин",
                                "target_lang_sense_clarification": "стеклянный сосуд для воды или вина"
                            },
                            {
                                "target_lang_word": "жбан",
                                "target_lang_sense_clarification": "сосуд с крышкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ab6070e-5f5c-35b0-a1d6-29ef909c4765",
                    "sense_definition": "The amount that a jug can hold.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "measurements",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We drank a whole <w>jug</w> of orange juice during breakfast.",
                            "target_lang_translations": {
                                "ru": "За завтраком мы выпили целый <w>кувшин</w> апельсинового сока."
                            }
                        },
                        {
                            "text": "He bought a <w>jug</w> of cider from the local farm.",
                            "target_lang_translations": {
                                "ru": "Он купил <w>кувшин</w> сидра на местной ферме."
                            }
                        }
                    ],
                    "common_phrases": [
                        "full jug",
                        "jug of juice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество жидкости, которое вмещает в себя один кувшин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кувшин",
                                "target_lang_sense_clarification": "мера объема"
                            },
                            {
                                "target_lang_word": "целый кувшин",
                                "target_lang_sense_clarification": "полный объем сосуда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "737a9e4a-a9c9-3e0c-9a6f-cd7acb9808ab",
                    "sense_definition": "A traditional dimpled glass with a handle, used for serving a pint of beer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "containers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bartender served the ale in a heavy glass <w>jug</w>.",
                            "target_lang_translations": {
                                "ru": "Бармен подал эль в тяжелой стеклянной <w>кружке</w>."
                            }
                        },
                        {
                            "text": "He prefers drinking his beer from a <w>beer</w> <w>jug</w> rather than a straight glass.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает пить пиво из пивной <w>кружки</w>, а не из прямого стакана."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beer jug"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British pub culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционная пивная кружка из толстого стекла с характерными углублениями и ручкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пивная кружка",
                                "target_lang_sense_clarification": "традиционная, с ручкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f342b969-6de0-3146-b3ac-2d9f2b35327c",
                    "sense_definition": "A period of detention used as a punishment for students after school.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher gave him a week of <w>jug</w> for skipping class.",
                            "target_lang_translations": {
                                "ru": "Учитель назначил ему неделю <w>оставления после уроков</w> за прогул занятий."
                            }
                        },
                        {
                            "text": "He had to sit in the <w>jug</w> room and write lines for an hour.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось сидеть в <w>комнате для наказанных</w> и целый час писать строчки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "after-school jug"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Specifically used in some private or Catholic schools"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Школьное наказание в виде оставления после уроков (используется в некоторых частных школах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставление после уроков",
                                "target_lang_sense_clarification": "вид школьного наказания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4589ebc2-05b2-3701-aa0e-b0edcf1e3cb0",
                    "sense_definition": "A slang term for a jail or prison.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent six months in the <w>jug</w> for a crime he didn't commit.",
                            "target_lang_translations": {
                                "ru": "Он провел полгода в <w>кутузке</w> за преступление, которого не совершал."
                            }
                        },
                        {
                            "text": "You don't want to end up in <w>jug</w> for something so stupid.",
                            "target_lang_translations": {
                                "ru": "Ты же не хочешь загреметь в <w>тюрягу</w> из-за такой глупости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the jug"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal term for prison"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название тюрьмы или места заключения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кутузка",
                                "target_lang_sense_clarification": "разговорное, тюрьма"
                            },
                            {
                                "target_lang_word": "тюряга",
                                "target_lang_sense_clarification": "грубый сленг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "662d55b2-6b45-3bcc-bf7a-18568ebec16a",
                    "sense_definition": "A vulgar slang term referring to a woman's breasts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "body_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magazine was full of pictures of women showing off their <w>jugs</w>.",
                            "target_lang_translations": {
                                "ru": "Журнал был полон фотографий женщин, выставляющих напоказ свои <w>буфера</w>."
                            }
                        },
                        {
                            "text": "He made a rude comment about her <w>jugs</w> and got slapped.",
                            "target_lang_translations": {
                                "ru": "Он отпустил грубый комментарий о её <w>груди</w> и получил пощечину."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вульгарное сленговое обозначение женской груди."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буфера",
                                "target_lang_sense_clarification": "вульгарный сленг"
                            },
                            {
                                "target_lang_word": "бидоны",
                                "target_lang_sense_clarification": "грубое просторечие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdf62ca9-204f-3d91-9ef0-f70b4d632f0b",
                    "sense_definition": "A small mixed breed of dog created by crossing a Jack Russell terrier and a pug.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>jug</w> is a popular crossbreed known for being energetic and friendly.",
                            "target_lang_translations": {
                                "ru": "<w>Джаг</w> — популярный метис, известный своей энергичностью и дружелюбием."
                            }
                        },
                        {
                            "text": "She decided to adopt a <w>jug</w> puppy because it was the perfect size for her apartment.",
                            "target_lang_translations": {
                                "ru": "Она решила взять щенка <w>джага</w>, потому что он идеально подходил по размеру для её квартиры."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jug dog"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порода собак, помесь джек-рассел-терьера и мопса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джаг",
                                "target_lang_sense_clarification": "название метиса"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "18c393ae-fe37-3f19-9bd9-25a23b67555a",
                    "sense_definition": "To stew meat, especially game, in an earthenware vessel or jug.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef decided to <w>jug</w> the hare according to a traditional recipe.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар решил <w>потушить</w> зайца в горшочке по традиционному рецепту."
                            }
                        },
                        {
                            "text": "We enjoyed a meal of <w>jugged</w> meat during our trip to the countryside.",
                            "target_lang_translations": {
                                "ru": "Во время поездки за город мы наслаждались мясом, <w>тушенным в горшочке</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jugged hare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тушить мясо (особенно дичь) в глиняном сосуде или кувшине."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тушить в горшочке",
                                "target_lang_sense_clarification": "способ приготовления дичи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "018c5634-385b-3e1e-90d5-08dba4a29120",
                    "sense_definition": "To put someone into jail or prison.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police managed to <w>jug</w> the thief after a long chase.",
                            "target_lang_translations": {
                                "ru": "Полиции удалось <w>упечь</w> вора за решетку после долгой погони."
                            }
                        },
                        {
                            "text": "They will <w>jug</w> him for at least five years for that robbery.",
                            "target_lang_translations": {
                                "ru": "Его <w>посадят</w> минимум на пять лет за то ограбление."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Посадить кого-либо в тюрьму (сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засадить",
                                "target_lang_sense_clarification": "в тюрьму, разг."
                            },
                            {
                                "target_lang_word": "упечь",
                                "target_lang_sense_clarification": "за решетку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a41aac07-6683-35eb-a81b-57c55bc6d3fe",
                    "sense_definition": "To issue a detention to a student as a form of school punishment.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The principal decided to <w>jug</w> the students who were caught smoking.",
                            "target_lang_translations": {
                                "ru": "Директор решил <w>оставить после уроков</w> учеников, пойманных за курением."
                            }
                        },
                        {
                            "text": "He got <w>jugged</w> for faking his mother's signature on the report card.",
                            "target_lang_translations": {
                                "ru": "Его <w>оставили после уроков</w> за подделку подписи матери в табеле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "get jugged"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Educational context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наказывать ученика, оставляя его после уроков (школьный сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставить после уроков",
                                "target_lang_sense_clarification": "в качестве наказания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fad16d85-883c-385b-8ac7-ae1e7a5565bc",
                    "sense_definition": "To make a sound like 'jug', characteristic of certain birds like the nightingale.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the quiet of the night, we could hear the nightingale <w>jug</w> from the trees.",
                            "target_lang_translations": {
                                "ru": "В ночной тишине мы слышали, как соловей <w>щелкает</w> на деревьях."
                            }
                        },
                        {
                            "text": "The bird began to <w>jug-jug</w> as the sun started to set.",
                            "target_lang_translations": {
                                "ru": "Птица начала <w>издавать трели</w>, когда солнце начало садиться."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Onomatopoeic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать звуки, напоминающие «джаг-джаг» (характерно для соловья)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щелкать",
                                "target_lang_sense_clarification": "о пении соловья"
                            },
                            {
                                "target_lang_word": "издавать трели",
                                "target_lang_sense_clarification": "о птицах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}