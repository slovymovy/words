                                "ru": "Внушительные башни замка <w>возвышаются</w> посреди тумана.",
                                "nl": "De imposante torens van het kasteel <w>verrijzen</w> midden in de mist.",
                                "de": "Die imposanten Türme des Schlosses <w>ragen</w> mitten im Nebel <w>auf</w>.",
                                "pl": "Imponujące wieże zamku <w>wznoszą się</w> pośród mgły.",
                                "it": "Le imponenti torri del castello si <w>ergono</w> in mezzo alla nebbia.",
                                "cs": "Impozantní věže hradu <w>se</w> <w>tyčí</w> uprostřed mlhy.",
                                "tr": "Kalenin heybetli kuleleri sisin ortasında <w>yükseliyor</w>.",
                                "es": "Las imponentes torres del castillo <w>se</w> <w>alzan</w> en medio de la niebla.",
                                "zh": "城堡雄伟的塔楼在薄雾中<w>耸立</w>。"
                            }
                        },
                        {
                            "text": "De hautes falaises rocheuses <w>surgissaient</w> de la mer démontée.",
                            "target_lang_translations": {
                                "en": "Tall rocky cliffs <w>rose</w> out of the raging sea.",
                                "ru": "Высокие скалистые утёсы <w>поднимались</w> из разбушевавшегося моря.",
                                "nl": "Hoge rotskliffen <w>verrezen</w> uit de onstuimige zee.",
                                "de": "Hohe Felsklippen <w>ragten</w> aus dem aufgewühlten Meer <w>auf</w>.",
                                "pl": "Wysokie skaliste klify <w>wznosiły się</w> z wzburzonego morza.",
                                "it": "Alte scogliere rocciose <w>sorgevano</w> dal mare in tempesta.",
                                "cs": "Vysoké skalnaté útesy <w>vystupovaly</w> z rozbouřeného moře.",
                                "tr": "Yüksek kayalık uçurumlar çalkantılı denizden <w>yükseliyordu</w>.",
                                "es": "Altos acantilados rocosos <w>se</w> <w>alzaban</w> del mar embravecido.",
                                "zh": "高高的岩崖从波涛汹涌的大海中<w>矗立</w>起来。"
                            }
                        }
                    ],
                    "synonyms": [
