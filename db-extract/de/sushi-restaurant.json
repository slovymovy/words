                            {
                                "example_id": "3dbd54c8-c112-4866-8944-2ed3abe5f32b",
                                "sense_id": "b30a4c4a-2268-3519-b278-2ad0fcd752f5",
                                "text": "„Mit Amos Gahls Hinweis im Hinterkopf - ›unter der Erde, bei erwartbaren anderen Umständen‹ - schweifte der Blick der Brüder über all die Geschäfte, ein altes Krankenhaus aus roten Backsteinen, einen klassischen Imbiss, mehrere Bodegas, ein Sushi-Restaurant, das Shaw tunlichst meiden würde, heruntergekommene Gewerbebauten und Autowerkstätten.“"
                            }
                        ],
