                        "sense_id": "3af528ef-2cb3-3051-bc68-19000df11a38",
                        "entry_id": "8e1a2ae6-daaf-38fd-b22a-4d81d04a6d74",
                        "glosses": [
                            "Capture d’écran, copie d’écran (image fixe)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd83ee2a-5047-4bad-8377-de339afb175e",
                                "sense_id": "3af528ef-2cb3-3051-bc68-19000df11a38",
                                "text": "Ich kann Ihre Erklärungen über die Probleme Ihres Bearbeitungszentrums nicht verstehen: Können Sie mir ein Bildschirmfoto der Steuerungssoftware bitte schicken?",
                                "translation": "Je ne comprends pas vos explications sur les problèmes de votre centre d’usinage : pouvez-vous s’il vous plaît m’envoyer une capture d’écran du logiciel de commande ?"
                            }
                        ]
                    }
