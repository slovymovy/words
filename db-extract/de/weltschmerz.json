                    {
                        "sense_id": "abb68292-1850-3c9a-a482-47d7a54a4246",
                        "entry_id": "463bf187-6dfc-3631-b9a2-3b0785b0575f",
                        "glosses": [
                            "Weltschmerz, world-weariness (profound depression regarding the human condition or the state of the world)"
                        ],
                        "tags": [
                            "masculine",
                            "no-plural",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "a6251c7d-e7f3-46a2-b989-2c6874688229",
                                "sense_id": "abb68292-1850-3c9a-a482-47d7a54a4246",
                                "text": "Mein Weltschmerz entspringt aus dem Vergleich zwischen dem Guten, das der Mensch wirken kann, und dem Bösen, das er zu wirken pflegt.",
                                "translation": "My weltschmerz originates from a comparison between the good that man can do, and the evil that he is in the habit of doing.",
                                "english": "My weltschmerz originates from a comparison between the good that man can do, and the evil that he is in the habit of doing."
                            },
                            {
                                "example_id": "f0c92166-2733-4f39-b066-522d6baa7111",
                                "sense_id": "abb68292-1850-3c9a-a482-47d7a54a4246",
                                "text": "Es wäre übrigens möglich gewesen, daß ein gewisser grausamer Weltschmerz in Diotimas Herz gar nicht nach einem Dementi verlangte.",
                                "translation": "The Man Without Qualities",
                                "english": "The Man Without Qualities"
                            },
                            {
                                "example_id": "79a13f5c-903d-4654-9e65-cb8af0246d1f",
                                "sense_id": "abb68292-1850-3c9a-a482-47d7a54a4246",
                                "text": "Kriege, Inflation, Klimakatastrophe: Viele Menschen leiden unter den globalen Dauerkrisen. Der Neurowissenschaftler Tobias Esch sagt, wie wir den Weltschmerz überwinden können."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebb1b7f6-c005-32ce-89d7-fd20dc694e68",
                        "entry_id": "463bf187-6dfc-3631-b9a2-3b0785b0575f",
                        "glosses": [
                            "causeless sadness, undue self-pity"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous",
                            "masculine",
                            "no-plural",
                            "often",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "6ac0d893-7b26-4e0c-a621-289d8bd4ee49",
                                "sense_id": "ebb1b7f6-c005-32ce-89d7-fd20dc694e68",
                                "text": "Jetzt mal Schluss mit dem Weltschmerz!",
                                "translation": "Now stop pitying yourself!",
                                "english": "Now stop pitying yourself!"
                            }
                        ]
                    }
                ],
