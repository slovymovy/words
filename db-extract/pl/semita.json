                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Semit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8e5db3c-4a1d-323c-a5bd-4667ddb62e4d",
                                        "entry_id": "beaee75c-1df3-33e3-ad69-c68dc4037683",
                                        "glosses": [
                                            "Angehöriger der sprachlich und anthropologisch verwandten Gruppe semitischer Völker in Nordafrika und Vorderasien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd62d11a-ebee-410f-86d2-64ad6a205bbb",
                                                "sense_id": "f8e5db3c-4a1d-323c-a5bd-4667ddb62e4d",
                                                "text": "„Ich aber habe solch ein Verbrechen nie begangen, und ich will Ihnen auch sagen, warum: weil ich selbst ein Semit bin.“"
                                            },
                                            {
                                                "example_id": "ca415fee-8b14-4c28-9bc5-f43ebcaa0116",
                                                "sense_id": "f8e5db3c-4a1d-323c-a5bd-4667ddb62e4d",
                                                "text": "„Es sind diese Semiten, die fortan all jene Reiche beherrschen, die nacheinander am Horn von Afrika erblühen und niedergehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2203d22c-933f-4a9f-8e76-1118ab0a56a9",
                        "source_entry_id": "dc518498-f8bd-34f6-a399-7696c8d724f3",
