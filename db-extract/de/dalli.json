                        ],
                        "examples": [
                            {
                                "example_id": "4f7d0e75-6780-491b-84eb-5f4ed7f3077c",
                                "sense_id": "238b6e2d-238b-328d-8003-398694488836",
                                "text": "Jetzt ab ins Bett, aber dalli!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2c1c369-c4d8-4a3a-a03d-4de57f94db51",
                        "source_entry_id": "651ab0c9-a1a4-30a0-9772-01ae91edb855",
                        "source_sense_id": "238b6e2d-238b-328d-8003-398694488836",
                        "source_sense_description": "umgangssprachlich: schnell",
                        "target_lang_word": "quickly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quickly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c691aa24-7e91-32a6-b444-d39381f6d1ef",
                                        "entry_id": "f3961116-097f-3e04-a150-a2ccec102a55",
                                        "glosses": [
                                            "Rapidly; with speed; fast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b52c08b9-e4cb-4940-9c0a-35c4ad749edd",
                                                "sense_id": "c691aa24-7e91-32a6-b444-d39381f6d1ef",
                                                "text": "Luckily, the error was quickly corrected."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c32b780-5bed-31d9-bfec-f92808dac6d4",
                                        "entry_id": "f3961116-097f-3e04-a150-a2ccec102a55",
                                        "glosses": [
                                            "Very soon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49781661-9ed8-4b50-a3df-96e9af377b24",
                                                "sense_id": "8c32b780-5bed-31d9-bfec-f92808dac6d4",
                                                "text": "If we go this way, we'll get there quickly."
                                            },
                                            {
                                                "example_id": "ec0c7da4-29a3-412e-b1a6-d952c194da30",
                                                "sense_id": "8c32b780-5bed-31d9-bfec-f92808dac6d4",
                                                "text": "Another Karadeniz cross led to Cudicini's first save of the night, with the Spurs keeper making up for a weak punch by brilliantly pushing away Christian Noboa's snap-shot.\nTwo more top-class stops followed quickly afterwards, first from Natcho's rasping shot which was heading into the top corner, and then to deny Ryazantsev at his near post."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c260e96-bdbc-4a0e-8c27-978beee0b932",
                        "source_entry_id": "651ab0c9-a1a4-30a0-9772-01ae91edb855",
                        "source_sense_id": "238b6e2d-238b-328d-8003-398694488836",
                        "source_sense_description": "umgangssprachlich: schnell",
                        "target_lang_word": "fissa",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fissa",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "230a1e2f-e0b6-3b79-a494-b672079993ee",
                                        "entry_id": "a2f60626-06c2-34e7-acf1-4391cfb178e2",
                                        "glosses": [
                                            "Rapidement ; vite."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ca6d075-2753-4302-844b-5793afc31143",
                                                "sense_id": "230a1e2f-e0b6-3b79-a494-b672079993ee",
                                                "text": "Allez ! Demi-tour, vaurien ! Et fissa !"
                                            },
                                            {
                                                "example_id": "5e9ad0e4-3ad3-43b9-8e61-85cce2ed0032",
                                                "sense_id": "230a1e2f-e0b6-3b79-a494-b672079993ee",
                                                "text": "J’y vais fissa, fissa."
                                            },
                                            {
                                                "example_id": "ef8673ea-a01d-477c-8c1a-82f5ba3635b4",
                                                "sense_id": "230a1e2f-e0b6-3b79-a494-b672079993ee",
                                                "text": "Tes copains flics vont trouver le cadavre de Lucien, dit Gab, tu crois pas qu’ils risquent de rappliquer fissa au Domaine ?"
                                            },
                                            {
                                                "example_id": "237eca7a-266c-477e-9548-32f42f919647",
                                                "sense_id": "230a1e2f-e0b6-3b79-a494-b672079993ee",
                                                "text": "À presque 65 ans, il en avait vu d’autres et le petit wesh à casquette qui le braquait avec son flingue d’alarme allait s’en rendre compte fissa."
                                            },
                                            {
                                                "example_id": "6ee0a645-eeba-4d66-a2af-08ab64665f89",
                                                "sense_id": "230a1e2f-e0b6-3b79-a494-b672079993ee",
                                                "text": "En contrebas du hameau, une voix féminine a retenti : “Plume !” Obéissant à l’appel de sa propriétaire, la chienne est repartie fissa. Mais nous avions un nom."
                                            },
                                            {
                                                "example_id": "eaefa360-2c54-4bc0-a415-cca26fe81548",
                                                "sense_id": "230a1e2f-e0b6-3b79-a494-b672079993ee",
                                                "text": "Sur la pelouse de Rennes, plutôt patraque ces temps-ci, et encore davantage quand Guéla Doué a gâché sa première titularisation en L1 par un retour fissa aux vestiaires, l’OL a donc fini par pousser un grand ouf de soulagement. Après un dernier coup de chaud circonscrit par Anthony Lopes dans le temps additionnel ; sur une frappe d’Amine Gouiri, ancien camarade de vestiaire"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af13de83-05dd-4c06-b8e3-50ba94bacb60",
                        "source_entry_id": "651ab0c9-a1a4-30a0-9772-01ae91edb855",
                        "source_sense_id": "238b6e2d-238b-328d-8003-398694488836",
                        "source_sense_description": "umgangssprachlich: schnell",
                        "target_lang_word": "vite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fb870f0-2565-3fdd-8aba-7d3e8996f9f4",
                                        "entry_id": "e78e9715-8bcb-3521-89c0-18360c22b600",
                                        "glosses": [
                                            "Rapide, qui se meut avec célérité, avec promptitude ; se dit surtout dans le sport, sinon plutôt des animaux et des choses dont le mouvement est rapide."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee97df2f-24df-4d66-9eb4-dbac5cafabb9",
                                                "sense_id": "4fb870f0-2565-3fdd-8aba-7d3e8996f9f4",
                                                "text": "Cheval vite comme le vent."
                                            },
                                            {
                                                "example_id": "c4801fee-dd03-4b5b-a23e-95242b6448aa",
                                                "sense_id": "4fb870f0-2565-3fdd-8aba-7d3e8996f9f4",
                                                "text": "Il a le pouls fort vite."
                                            },
                                            {
                                                "example_id": "7bf7553f-c098-4369-b990-4e9afd0a472b",
                                                "sense_id": "4fb870f0-2565-3fdd-8aba-7d3e8996f9f4",
                                                "text": "« — Eh bien, ils ne sont pas vites !\n« — À cette heure-ci, dit un autre, on n’est jamais vite. C’est comme dans la chanson de Mallarmé, vous savez bien : « Le Monsieur qui montait n’est pas redescendu… »"
                                            },
                                            {
                                                "example_id": "867c621f-1179-4858-8ad9-3900ace90245",
                                                "sense_id": "4fb870f0-2565-3fdd-8aba-7d3e8996f9f4",
                                                "text": "Cet Américain n’était pas l’homme le plus vite du monde."
                                            },
                                            {
                                                "example_id": "65321705-b0bd-435c-bdfe-b2b214498ced",
                                                "sense_id": "4fb870f0-2565-3fdd-8aba-7d3e8996f9f4",
                                                "text": "Il y a pour moi une drogue dans la chasteté. Son effet : les mouvements vites."
                                            },
                                            {
                                                "example_id": "1456b27c-a803-4307-ac51-7b0f1877ae14",
                                                "sense_id": "4fb870f0-2565-3fdd-8aba-7d3e8996f9f4",
                                                "text": "Prince est un bon petit cheval, doux, patient et assez vite."
                                            },
                                            {
                                                "example_id": "7f3b919c-ce93-4b35-9b87-efacd5ddcd8d",
                                                "sense_id": "4fb870f0-2565-3fdd-8aba-7d3e8996f9f4",
                                                "text": "Je me souviens de Jacqueline Auriol, la femme “la plus vite du monde”."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "700a74b7-c877-30f5-aaa0-09fdf2a2374b",
                                        "entry_id": "9b3ab08b-8db5-3405-abde-d40f6592935e",
                                        "glosses": [
                                            "Rapidement, avec vitesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac20aec1-cb03-4790-9a4b-f6a5e8db4495",
                                                "sense_id": "700a74b7-c877-30f5-aaa0-09fdf2a2374b",
                                                "text": "Courez vite."
                                            },
                                            {
                                                "example_id": "b9f9b202-89a9-489e-a9a4-a3d2d4bb8bbb",
                                                "sense_id": "700a74b7-c877-30f5-aaa0-09fdf2a2374b",
                                                "text": "Allez vite."
                                            },
                                            {
                                                "example_id": "edde4f3d-52dd-4032-86c8-e8c1c319cc76",
                                                "sense_id": "700a74b7-c877-30f5-aaa0-09fdf2a2374b",
                                                "text": "Ne parlez pas si vite."
                                            },
                                            {
                                                "example_id": "8026b73b-8f33-43da-b1f6-7f34d1f647d0",
                                                "sense_id": "700a74b7-c877-30f5-aaa0-09fdf2a2374b",
                                                "text": "Il a très vite fini."
                                            },
                                            {
                                                "example_id": "771ec34f-fd53-4b1c-ad07-c061183824f7",
                                                "sense_id": "700a74b7-c877-30f5-aaa0-09fdf2a2374b",
                                                "text": "Aller vite dans une affaire, Agir inconsidérément et avec précipitation, ne pas agir avec la circonspection et avec les précautions nécessaires."
                                            },
                                            {
                                                "example_id": "79cff783-9a3c-44d1-8c5f-c4920bc28c32",
                                                "sense_id": "700a74b7-c877-30f5-aaa0-09fdf2a2374b",
                                                "text": "C’est votre faute : vous êtes allés un peu vite dans cette affaire."
                                            },
                                            {
                                                "example_id": "e009c3bc-4bcf-4c7c-8d57-bcb94d411f56",
                                                "sense_id": "700a74b7-c877-30f5-aaa0-09fdf2a2374b",
                                                "text": "Ils sont vite allés chercher du secours."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b85ab35d-ff2b-3bfb-98f2-ffcf19624e44",
                                        "entry_id": "380b6f32-2f2a-3cc3-97e3-29134297b773",
                                        "glosses": [
                                            "Injonction pressante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ef50219-9899-466a-92ab-7461b0aeee46",
                                                "sense_id": "b85ab35d-ff2b-3bfb-98f2-ffcf19624e44",
                                                "text": "Mais vite, vite, rentrons à Paris. […] Vite ! vite ! à Paris, chez moi ! ordonna Mme Destol en s’installant dans sa voiture […]"
                                            },
                                            {
                                                "example_id": "43090593-ec08-4261-ba86-1c29761a5ca6",
                                                "sense_id": "b85ab35d-ff2b-3bfb-98f2-ffcf19624e44",
                                                "text": "Vite, un médecin ! ordonna Duret."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b6d6388-bdfc-4d76-8cb8-4f9566583137",
