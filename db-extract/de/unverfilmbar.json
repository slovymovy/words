                "senses": [
                    {
                        "sense_id": "b7f2461e-c9c1-39f0-af75-d0a2d82e4225",
                        "entry_id": "59426fbf-1f06-390d-9435-940d88154c0a",
                        "glosses": [
                            "nicht verfilmbar, unmöglich als Film zu adaptieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7060d6e9-21b2-437e-af37-e6367aba0cb1",
                                "sense_id": "b7f2461e-c9c1-39f0-af75-d0a2d82e4225",
                                "text": "„Aber er interessierte sich nur für die dümmsten Projekte - unverfilmbare Bücher, Remakes alter Flops, Drehbücher von Autoren, mit denen er Bier trinken ging ... Es funktionierte nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08244f0f-dfe3-4096-942b-938bd43c8ba5",
