        "fr-extract.jsonl": [
            {
                "entry_id": "7b251731-37f5-33fd-8420-c2a5251c695e",
                "word": "rotonde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d370c55d-0b2c-4339-92d1-63ab1454cc8e",
                        "entry_id": "7b251731-37f5-33fd-8420-c2a5251c695e",
                        "tags": [
                            "plural"
                        ],
                        "form": "rotondes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "217ee770-0f0e-34e4-8891-6a630af6911e",
                        "entry_id": "7b251731-37f5-33fd-8420-c2a5251c695e",
                        "glosses": [
                            "Édifice de forme circulaire à l’extérieur comme à l’intérieur, et surmonté d’une coupole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7f2951f-825b-48ef-826f-12c75f3a5642",
                                "sense_id": "217ee770-0f0e-34e4-8891-6a630af6911e",
                                "text": "Un petit escalier en fonte grimpe en tournant dans l’intérieur de la Bavaria. J’eus la fantaisie de monter jusqu’en haut et de m’asseoir un moment dans la tête du colosse, un petit salon en rotonde éclairé par deux fenêtres qui sont les yeux."
                            },
                            {
                                "example_id": "185056f5-e22a-4f2d-b885-3032ebd670d8",
                                "sense_id": "217ee770-0f0e-34e4-8891-6a630af6911e",
                                "text": "Vous ne l’ignorez pas, presque toutes nos cathédrales sont cruciformes ; dans la primitive Eglise, il est vrai, vous trouverez un certain nombre de sanctuaires bâtis en rotonde et coiffés d’un dôme ; […]."
                            },
                            {
                                "example_id": "a4bf2c34-536d-49b7-a3aa-4869614d9243",
                                "sense_id": "217ee770-0f0e-34e4-8891-6a630af6911e",
                                "text": "À cinq heures, invariablement, Meyer arrivait à son journal, contigu à son appartement, et s’occupait avec son secrétaire de rédaction, Foucher, Mazereau ou un autre, puis recevait les visiteurs et visiteuses dans son cabinet en rotonde, « éminemment parisien », dont les fenêtres donnent sur le boulevard."
                            },
                            {
                                "example_id": "61b15acd-6951-4f92-95f1-c7a79c8e806a",
                                "sense_id": "217ee770-0f0e-34e4-8891-6a630af6911e",
                                "text": "À Baby (Seine-et-Marne), il a été encore construit en 1743, […], un mausolée en forme de rotonde au chevet de l’église paroissiale pour abriter le tombeau d’Alexis-Jean Durand de Lagny."
                            },
                            {
                                "example_id": "d5b5ac58-c361-48f7-b70e-52da2827b076",
                                "sense_id": "217ee770-0f0e-34e4-8891-6a630af6911e",
                                "text": "On passa à table, dans une petite salle à manger en rotonde, aux boiseries blondes et aux sièges de vieux cuir olive."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f9bbca8-9273-3f6d-b863-0975c7e99f9a",
                        "entry_id": "7b251731-37f5-33fd-8420-c2a5251c695e",
                        "glosses": [
                            "Édifice de forme circulaire ou demi-circulaire, dans lequel on gare les locomotives sur des voies disposées en éventail."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "39d5438e-2417-3ed3-9f06-3f0d411d788a",
                        "entry_id": "7b251731-37f5-33fd-8420-c2a5251c695e",
                        "glosses": [
                            "Compartiment arrière de certaines diligences."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8d8170bc-f6a0-4765-bbc9-c79ed8bb4058",
                                "sense_id": "39d5438e-2417-3ed3-9f06-3f0d411d788a",
                                "text": "Par cette matinée glaciale d’octobre, où tombait un mélange de pluie et de neige fondue, les deux enfants, faute de places dans l’intérieur et la rotonde, durent se blottir sous la bâche, derrière le conducteur."
                            }
                        ]
                    },
                    {
                        "sense_id": "68e48716-0352-3d29-902a-adf1207a328a",
                        "entry_id": "7b251731-37f5-33fd-8420-c2a5251c695e",
                        "glosses": [
                            "Sorte de collet parfois empesé que portaient les ecclésiastiques ou les militaires."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "eb02ab95-63c9-49c0-8bd6-9acd6637ad05",
                                "sense_id": "68e48716-0352-3d29-902a-adf1207a328a",
                                "text": "Luy qui me croit se met promptement en armes, prenant deux œufs a une fruitiere qu’il luy jette a la face, et luy en gaste sa digne rotonde qui estoit redressée comme la queuë d’un Paon."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8b18991-1096-3e22-a246-ecb33e5fd1f3",
                        "entry_id": "7b251731-37f5-33fd-8420-c2a5251c695e",
                        "glosses": [
                            "Châle."
                        ],
                        "tags": [
                            "broadly",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8d61f354-5b60-4d15-829e-398cf3dc0cff",
                                "sense_id": "d8b18991-1096-3e22-a246-ecb33e5fd1f3",
                                "text": "Sur les deux longues tables de chêne, à gauche et à droite du salon, traînait un fouillis de manteaux, de pelisses, de rotondes, des vêtements de toutes les tailles et de toutes les étoffes."
                            },
                            {
                                "example_id": "ef937df5-d7f6-4c66-bc05-e77cd1099dc7",
                                "sense_id": "d8b18991-1096-3e22-a246-ecb33e5fd1f3",
                                "text": "La mère avait sur son mari l’avantage de le dominer d’un certain nombre de centimètres — une grande femme sèche et maigre, type échalas, […], toute son importante personne enveloppée d’une rotonde en laine brune, fourrée de petit-gris."
                            },
                            {
                                "example_id": "cbae270c-222e-4116-9609-407e4db14f71",
                                "sense_id": "d8b18991-1096-3e22-a246-ecb33e5fd1f3",
                                "text": "— Dans quelques instants, vous nous aiderez à envelopper nos rotondes et nos palatines…\nCes demoiselles Davernis appellent ainsi leurs grands collets d’hiver et leurs fourrures."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e14ddd19-0e10-49b0-b982-c01d1340bc4d",
                        "source_entry_id": "7b251731-37f5-33fd-8420-c2a5251c695e",
                        "source_sense_description": "architecture",
                        "target_lang_word": "Rotunde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rotunde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "565ba1ae-e6b7-318b-bded-38a2f3cb6e8e",
                                        "entry_id": "efbe212d-665b-32d7-ba74-2429b69810fb",
                                        "glosses": [
                                            "rund ausgeführtes Bauwerk/Bauwerkteil oder Garten-/Parkteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8873d9a9-e4bf-4ee6-9f76-8bd687de3f89",
                                                "sense_id": "565ba1ae-e6b7-318b-bded-38a2f3cb6e8e",
                                                "text": "„Die große Rotunde im „Palast der Republik“ in Léopoldville, der Hauptstadt des neuen Staates am Ufer des Kongo-Flusses, hat sich gefüllt.“"
                                            },
                                            {
                                                "example_id": "6ff731fb-06f3-49ab-8724-e379aa83f2d6",
                                                "sense_id": "565ba1ae-e6b7-318b-bded-38a2f3cb6e8e",
                                                "text": "„Mit tief ins Gesicht gezogenen Hüten betraten wir die schöne Rotunde, in der sich die Leute drängten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e237a944-b785-326e-934b-ace89a9f5992",
                                        "entry_id": "efbe212d-665b-32d7-ba74-2429b69810fb",
                                        "glosses": [
                                            "rundes Toilettenhäuschen"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17a313ba-afcf-46bb-91a9-6e19e8545671",
                                                "sense_id": "e237a944-b785-326e-934b-ace89a9f5992",
                                                "text": "„Für andere Geschäfte bediente er sich der Rotunde, die ihm auf dem Wege vom Mittagessen zur Werkstatt am nächsten lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2955e003-98c9-4bac-ab72-adc7543a364a",
                        "source_entry_id": "7b251731-37f5-33fd-8420-c2a5251c695e",
                        "source_sense_description": "architecture",
                        "target_lang_word": "rotunda",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rotunda",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1202ee4f-c20c-350a-a716-e74a982fecb2",
                                        "entry_id": "25cd4e6c-f885-3ef3-b122-301db1523001",
                                        "glosses": [
                                            "A round building, usually small, often with a dome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f14a109f-145c-4961-ae53-f49d709840ec",
                                                "sense_id": "1202ee4f-c20c-350a-a716-e74a982fecb2",
                                                "text": "The rotunda begun but never completed by Abbot Wulfric (1047–59) at St Augustine’s Abbey as a link between the church of St Mary and that of St Peter and St Paul is an unusual and ambitious example of mid-eleventh-century English architecture which partly survives (fig. 4.6, top). […] Many of these rotundae are known to have had a special funerary function (as was the case at Canterbury)."
                                            },
                                            {
                                                "example_id": "9e78b562-b6e9-4148-800f-87b9f49e0917",
                                                "sense_id": "1202ee4f-c20c-350a-a716-e74a982fecb2",
                                                "text": "The purely Greek character of the temple is revealed in the fact that there is no portico aligning the structure; Roman tholoi and rotundae are usually distinguished by a portico."
                                            },
                                            {
                                                "example_id": "0155ff2a-f971-46b6-816e-77706dbc1fe9",
                                                "sense_id": "1202ee4f-c20c-350a-a716-e74a982fecb2",
                                                "text": "Access to the shafts is gained via a brick entrance rotunda below a glass dome. The walls of these rotundae are built over the outer edge of caissons which hold the shafts; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b5bfef4-48a7-3918-9993-947ef2139c08",
                                        "entry_id": "25cd4e6c-f885-3ef3-b122-301db1523001",
                                        "glosses": [
                                            "A Gothic typeface used in early printed books in Northern Italy, based on a rounded script developed in the 13th cent.; the manuscript hand on which this typeface was based."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9c438ee-efdf-3165-9a19-375e4ee5b539",
