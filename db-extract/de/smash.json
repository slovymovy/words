                "translations": [
                    {
                        "translation_id": "27cd2dac-a4d9-493c-8fe7-19844de828bf",
                        "source_entry_id": "42755e5b-4c77-3c46-a893-c0988371eae1",
                        "source_sense_id": "1e4d432e-abce-3b8f-b55f-2a985cffd433",
                        "target_lang_word": "smash",
