                            {
                                "example_id": "0a56713f-1889-4cee-83ee-dc57343ae9f1",
                                "sense_id": "96bd45bd-f908-37c2-a4cf-bbe8b1c1d4d1",
                                "text": "Het nieuwe Filmmuseum in Amsterdam opent donderdag zijn deuren voor publiek. Het nieuwe onderkomen van het EYE Film Instituut Nederland ligt aan de noordoever van het IJ tegenover het Centraal Station."
                            },
                            {
                                "example_id": "a62be2db-3ab9-4999-b1d3-2d680de02bd9",
                                "sense_id": "96bd45bd-f908-37c2-a4cf-bbe8b1c1d4d1",
                                "text": "19.00 uur: Begin van de koningsvaart. Bij filminstituut EYE aan de noordoever van het IJ gaan koning Willem-Alexander en Máxima aan boord. Tijdens de vaartocht over het IJ zijn er optredens van artiesten en kan het publiek het koningspaar toezwaaien. Het paar wordt begeleid door een botenparade."
                            }
