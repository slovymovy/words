                        ],
                        "examples": [
                            {
                                "example_id": "aa3f6f96-055d-4a46-888d-80059d64ed94",
                                "sense_id": "ee16f243-2d7d-35ed-a3b4-d01fabd2b485",
                                "text": "De zaak wordt geleid door een nep-kolonel die in de Amerikaanse vlag gehuld gaat en op Old Granddad-whiskey en sigaren leeft; verder zijn er intellectuele chimpansees, trieste, Christusachtige clowns - mensenkinderen, hoererend met de lol - en een ‘sterke man’ die in alles, behalve zijn fysiek, een slappeling blijkt te zijn. In een circus is geen plaats voor subtiliteiten."
                            }
                        ]
                    }
