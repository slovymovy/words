                    {
                        "translation_id": "fae82a32-a81f-447c-897e-c58987e836e2",
                        "source_entry_id": "0422b31d-ddc8-3004-b47f-31025a13ba2e",
                        "target_lang_word": "onbuigzaam",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onbuigzaam",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a13bc892-116a-349c-a8fc-3d82b51a432a",
                                        "entry_id": "a2388e8a-a45b-3daa-ba4a-b49d2a7df3aa",
                                        "glosses": [
                                            "van een voorwerp dat het te hard en te stijf is om te kunnen buigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d19f9c7d-d6cd-4446-9a07-63d31c3357bf",
                                                "sense_id": "a13bc892-116a-349c-a8fc-3d82b51a432a",
                                                "text": "De Amsterdamse new-wavelegende Mecano entte de naam op die van de constructiebouwdozen Meccano, met de onbuigzame metalen onderdelen die de inspiratie vormen voor het werk van zanger en beeldend kunstenaar Dirk Polak. Om copyrightredenen werd uit de bandnaam een c weggelaten; tegenwoordig opereert de band in gewijzigde bezetting als Mecano Unlimited. Gebleven is Polaks plechtstatige zang over versteend modernisme en de mens als machine. De muziek vloeit wat soepeler dan de industrieel knarsende Tinguelymachine van weleer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc2e5115-2b46-31b1-8796-cf33f637b01b",
                                        "entry_id": "a2388e8a-a45b-3daa-ba4a-b49d2a7df3aa",
                                        "glosses": [
                                            "van een persoon dat deze zijn mening niet makkelijk veranderd"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a4f5017-0693-4b09-95b8-74b0115c595c",
                                                "sense_id": "bc2e5115-2b46-31b1-8796-cf33f637b01b",
                                                "text": "Ze is slim en spuwt de hardgekookte dialogen uit met een mix van humor en passie, onbuigzaam en koppig, maar ook breekbaar zonder een spat vals sentiment. Het helpt uiteraard wanneer je droomrollen aange­boden krijgt, maar toch bevestigt McDormand nu misschien wel ­definitief wat veel fans al langer fluisteren: dat ze de beste Amerikaanse actrice van haar generatie is."
                                            },
                                            {
                                                "example_id": "e2069091-5d96-4ec2-b7a6-3bd70e71e604",
                                                "sense_id": "bc2e5115-2b46-31b1-8796-cf33f637b01b",
                                                "text": "Wat volgt is een prachtige dialoog tussen de enthousiaste verslaggeefster en de onbuigzame oma. Het filmpje van Flossie is al bijna anderhalf miljoen keer bekeken en mag daarme met recht een internethit worden genoemd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e61aaf1-0bd2-3d89-8f6a-5598c1beee4a",
                                        "entry_id": "a2388e8a-a45b-3daa-ba4a-b49d2a7df3aa",
                                        "glosses": [
                                            "van een persoon dat deze kan doorzetten"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
