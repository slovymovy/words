                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spóźniony chłopak szybko <w>zasuwa</w> w stronę przystanku autobusowego.",
                            "target_lang_translations": {
