                "senses": [
                    {
                        "sense_id": "dd727926-0c3e-39ff-aee1-347efaccbf38",
                        "entry_id": "1911ba66-c3d4-329c-9f88-09f7f12a217f",
                        "glosses": [
                            "wiedza powiązana z jakąś dziedziną, nie zawsze oczywista, a często ukryta przed początkującymi"
                        ],
                        "tags": [],
