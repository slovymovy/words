        "nl-extract.jsonl": [
            {
                "entry_id": "9acb0eda-e20e-3586-9463-854c4d2a4ff5",
                "word": "doorlekken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d33772f3-4758-3024-9587-25959203d9bd",
                        "entry_id": "9acb0eda-e20e-3586-9463-854c4d2a4ff5",
                        "glosses": [
                            "geleidelijk dwars door het omhullend oppervlak heen stromen"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "07b230a9-a3ba-4106-81d5-c88bc581f7e1",
                                "sense_id": "d33772f3-4758-3024-9587-25959203d9bd",
                                "text": "De huidige gerecyclede kartonnen verpakkingen laten \"in sommige gevallen\" kleine hoeveelheden minerale olie doorlekken naar de inhoud van de verpakking."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c714a1e-63bf-31d6-878e-3b8a43c8abc2",
                        "entry_id": "9acb0eda-e20e-3586-9463-854c4d2a4ff5",
                        "glosses": [
                            "zo hevig menstrueren dat dit ondanks het maandverband zichtbaar wordt"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "f2652062-6534-43e9-a2ef-e6947652823c",
                                "sense_id": "0c714a1e-63bf-31d6-878e-3b8a43c8abc2",
                                "text": "Ondervraagden zeggen tijdens hun werk onder meer last te hebben van pijn, vermoeidheid en concentratieproblemen. Ook ervaart een derde ongemakkelijke situaties door opvliegers, stemmingswisselingen of doorlekken."
                            }
                        ]
                    },
                    {
                        "sense_id": "48599e65-3e22-3197-b088-1d049a242c36",
                        "entry_id": "9acb0eda-e20e-3586-9463-854c4d2a4ff5",
                        "glosses": [
                            "doorgaan met het in de openbaarheid brengen van geheime informatie"
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "136bde88-cdf1-4b9c-bfdc-3ba56a1f9ac0",
                                "sense_id": "48599e65-3e22-3197-b088-1d049a242c36",
                                "text": "Wat volgt is een beerput aan afluisterschandalen die z'n weerga niet kent. Snowden vlucht intussen van Hongkong naar Rusland. Na een hoop politiek gedoe krijgt hij daar uiteindelijk tijdelijk asiel. Vanuit een geheime locatie in Moskou blijft Snowden vrolijk doorlekken."
                            },
                            {
                                "example_id": "e6355629-aedd-4165-8691-62c99737a660",
                                "sense_id": "48599e65-3e22-3197-b088-1d049a242c36",
                                "text": "Daar komt bij dat Gülen-volgers in Nederland vrezen dat agenten van Turkse komaf informatie doorlekken. \"Je weet maar nooit, hoor je in de wandelgangen\", legt Erdal uit. \"In gesprekken met de politie en hogere rangen werd mij echter verzekerd dat iedereen anoniem aangifte kan doen.\""
                            }
                        ]
                    }
                ],
