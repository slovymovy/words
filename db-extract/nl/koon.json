                            {
                                "target_word": "cheek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec8b1510-e809-38ca-8be3-c0744efbc586",
                                        "entry_id": "3785f6ab-4b10-3310-8136-2a08a76f1e21",
                                        "glosses": [
                                            "To be impudent towards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2deea52e-e1a6-430d-9a6a-cf77e4d7acbe",
                                                "sense_id": "ec8b1510-e809-38ca-8be3-c0744efbc586",
                                                "text": "Don't cheek me, you little rascal!"
                                            },
                                            {
                                                "example_id": "71cd1695-d17a-4e02-8530-1406227d7670",
                                                "sense_id": "ec8b1510-e809-38ca-8be3-c0744efbc586",
                                                "text": "We did not like him much because he kissed us and was preachy when we cheeked pretty Tallie, who did not rule over us as Dede did […]"
                                            },
                                            {
                                                "example_id": "6739fa20-81d5-4e73-932e-4ae6a4cc8a9f",
                                                "sense_id": "ec8b1510-e809-38ca-8be3-c0744efbc586",
                                                "text": "We cheeked him over the fence until he chased us off, and then we went down to the Walton Road and cheeked the carters, keeping on the other side of the hedge so."
                                            },
                                            {
                                                "example_id": "a4d6a504-ceb8-47fd-91b5-7539f95a2629",
                                                "sense_id": "ec8b1510-e809-38ca-8be3-c0744efbc586",
                                                "text": "'Well, I do live next door,' I said, in no way antagonistically, and yet I immediately felt as if I had cheeked the headmistress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16dfbaa8-6c88-3ac7-9ac7-afceb5d6dd1c",
                                        "entry_id": "3785f6ab-4b10-3310-8136-2a08a76f1e21",
                                        "glosses": [
                                            "To pull a horse's head back toward the saddle using the cheek strap of the bridle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f586200a-60fa-4669-a462-9c890e6713ca",
                                                "sense_id": "16dfbaa8-6c88-3ac7-9ac7-afceb5d6dd1c",
                                                "text": "Such horses might need to be \"cheeked\" for a while."
                                            },
                                            {
                                                "example_id": "e93e9873-2daf-4a14-9612-15aa080c6fdb",
                                                "sense_id": "16dfbaa8-6c88-3ac7-9ac7-afceb5d6dd1c",
                                                "text": "Thurman caught the bridle headstall and cheeked the horse's head near his left knee when he swung aboard."
                                            },
                                            {
                                                "example_id": "a906d204-39b2-422f-9d57-b10b2638887b",
                                                "sense_id": "16dfbaa8-6c88-3ac7-9ac7-afceb5d6dd1c",
                                                "text": "He cheeked the horse and stepped into the saddle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dca7c29-8edc-364e-8103-0b368a0a4747",
                                        "entry_id": "3785f6ab-4b10-3310-8136-2a08a76f1e21",
                                        "glosses": [
                                            "To put or keep something in one’s cheek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "090ae74a-a309-4bc4-98d9-5fcc121dbb1d",
                                                "sense_id": "4dca7c29-8edc-364e-8103-0b368a0a4747",
                                                "text": "The squirrel cheeked some nuts before heading back to its nest."
                                            }
                                        ]
                                    }
                                ]
