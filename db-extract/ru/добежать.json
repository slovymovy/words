                                        "glosses": [
                                            "biegnąc, osiągnąć jakiś cel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70d8f1ac-9ac9-4282-ace9-d6a551334f3b",
                                                "sense_id": "da463688-e07f-30fd-8d7e-24a3cb2a4b8d",
                                                "text": "Dobiegła do rozsuwanych bezszelestnie drzwi wieżowca."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "addf753e-010b-38da-8b02-35eb83bd3669",
