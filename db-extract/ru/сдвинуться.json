                    {
                        "sense_id": "97880135-24a6-3c28-be56-6075bee6c029",
                        "entry_id": "31e774ba-e15d-3c19-bc7d-4792b5bdd365",
                        "glosses": [
                            "to move forward, to get going, to improve"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82a08ed4-9dcf-4110-a500-5b55d74d62c8",
                                "sense_id": "97880135-24a6-3c28-be56-6075bee6c029",
                                "text": "сдви́нуться с ме́ста (мёртвой то́чки) (о де́ле, тре́бующем реше́ний, де́йствий)",
                                "translation": "to begin to move forward (get going; improve)",
                                "english": "to begin to move forward (get going; improve)"
                            },
                            {
                                "example_id": "f5f6a9c5-5cf7-43cd-afb1-3cad0bea5397",
                                "sense_id": "97880135-24a6-3c28-be56-6075bee6c029",
                                "text": "вопро́с не сдви́нулся с ме́ста",
                                "translation": "no headway has been made in the matter",
                                "english": "no headway has been made in the matter"
                            },
                            {
                                "example_id": "6d2c2c07-55b8-4073-b311-e91e42a56383",
                                "sense_id": "97880135-24a6-3c28-be56-6075bee6c029",
                                "text": "де́ло сдви́нулось с ме́ста",
                                "translation": "things began to move",
                                "english": "things began to move"
                            }
                        ]
