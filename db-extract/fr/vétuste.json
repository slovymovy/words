                                        "entry_id": "96d27086-23c4-34a4-a9e0-ed1d137561f1",
                                        "glosses": [
                                            "gesundheitlich nicht auf der Höhe, unpässlich"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19e4ac4b-c2b4-4329-8be3-2fc150b59754",
                                                "sense_id": "f45facd7-c84a-3e89-9af0-831d3bd11419",
                                                "text": "Nach der Typhusinfektion war er noch wochenlang marode."
                                            },
                                            {
                                                "example_id": "1243ad1f-b90f-4065-b096-446e2aafbf49",
                                                "sense_id": "f45facd7-c84a-3e89-9af0-831d3bd11419",
                                                "text": "Nach diesen Gewaltmärschen war die Truppe so marode, dass sie nicht mehr einsatzfähig war."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e51e800-d61d-3ce3-a601-2e887f6f0d4a",
                                        "entry_id": "96d27086-23c4-34a4-a9e0-ed1d137561f1",
                                        "glosses": [
                                            "in einem schlechten, erbärmlichen Zustand seiend"
                                        ],
                                        "tags": [],
                                        "examples": [
