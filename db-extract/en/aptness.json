                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "90031121-6519-4926-9791-d6389fabc70b",
                                "sense_id": "4ee571ca-0da1-3b30-b9ac-687a9a8dd7cd",
                                "text": "the aptness of men to follow example"
                            }
                        ]
                    },
                    {
                        "sense_id": "8b6fda8f-603b-3515-96ed-07efe84ee02c",
                        "entry_id": "afe95c57-e882-3f0a-9268-3287674f53c8",
                        "glosses": [
                            "Speed or readiness in learning; docility."
                        ],
                        "tags": [
