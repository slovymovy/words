                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fourche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52680499-915f-3cc4-8208-a1cb1c63d0a7",
                                        "entry_id": "f39ac51a-fffa-30a0-ba62-48406c2427ca",
                                        "glosses": [
                                            "Instrument qui consiste en un long manche de bois terminé par deux ou trois branches ou pointes de bois, de fer, qui vont en s’écartant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efcb1410-af92-4d2e-bb6e-5ac951bbe27b",
                                                "sense_id": "52680499-915f-3cc4-8208-a1cb1c63d0a7",
                                                "text": "On se sert à cet effet d’un instrument en forme de fourche à dents verticales de 1m50 de long et 15 pouces d'écartement et que l'on appelle crampon."
                                            },
                                            {
                                                "example_id": "bdbc4f15-686e-4f51-b50f-76512f532a3f",
                                                "sense_id": "52680499-915f-3cc4-8208-a1cb1c63d0a7",
                                                "text": "Près de la porte, contre le mur, une fourche se dressait, une de ces fourches d’acier aux longues dents puissantes et fines qui se plantent dans les gerbes de blé comme des canines de chat dans un ventre de souris."
                                            },
                                            {
                                                "example_id": "5b5d12ae-169b-4956-acb2-d51132e664f2",
                                                "sense_id": "52680499-915f-3cc4-8208-a1cb1c63d0a7",
                                                "text": "Le colonel se pencha en avant pour retirer une longue fourche métallique des flammes ; un marshmallow légèrement grillé était empalé dessus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae076dc5-3b57-3014-bdba-a44b88cb0a04",
                                        "entry_id": "f39ac51a-fffa-30a0-ba62-48406c2427ca",
                                        "glosses": [
                                            "Tout ce qui a la forme ou rappelle la forme de cet instrument."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f37d4681-120b-3313-8ed6-7edd118beeb0",
                                        "entry_id": "f39ac51a-fffa-30a0-ba62-48406c2427ca",
                                        "glosses": [
                                            "Chose qui se divise en deux ou trois par l’extrémité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a95d80-0116-4d55-bdde-c191a4b161c1",
                                                "sense_id": "f37d4681-120b-3313-8ed6-7edd118beeb0",
                                                "text": "Un chemin qui fait la fourche."
                                            },
                                            {
                                                "example_id": "badf78dc-6983-4a3c-967b-9d3aa36778f0",
                                                "sense_id": "f37d4681-120b-3313-8ed6-7edd118beeb0",
                                                "text": "Le vieil homme leva une main avec deux doigts en fourche pour conjurer le sort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05be6f64-60b5-3412-bcc2-e46a2dfb0035",
                                        "entry_id": "f39ac51a-fffa-30a0-ba62-48406c2427ca",
                                        "glosses": [
                                            "Division, en particulier prématurée, du tronc en plusieurs branches."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8babaf71-47b0-4901-b49c-79103294fb1a",
                                                "sense_id": "05be6f64-60b5-3412-bcc2-e46a2dfb0035",
                                                "text": "Il faut faire abstraction de ce qui pourrait être considéré comme un défaut au niveau de la surbille et du houppier (sauf cas de fourche à risque élevé de casse avec entre-écorce)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2e56ec7-2a4f-3789-a6e5-dfff9109e89b",
                                        "entry_id": "f39ac51a-fffa-30a0-ba62-48406c2427ca",
                                        "glosses": [
                                            "Pièce constituée par deux barres d’acier creux entre lesquelles tourne la roue d’une bicyclette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "850ec994-93d2-40a7-986d-8f5700282f80",
                                                "sense_id": "e2e56ec7-2a4f-3789-a6e5-dfff9109e89b",
                                                "text": "Sur les VTT, les premières fourches à suspension apparurent vers 1989."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36a08175-f572-3245-99b5-5bb86cfaba47",
                                        "entry_id": "f39ac51a-fffa-30a0-ba62-48406c2427ca",
                                        "glosses": [
                                            "Tige qui relie un tramway à un fil électrique placé en l’air."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5c26443-748f-383b-8dbc-c8a16fb78506",
                                        "entry_id": "f39ac51a-fffa-30a0-ba62-48406c2427ca",
                                        "glosses": [
                                            "Heure libre entre deux heures de cours."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30a63ae9-ce9f-4865-bbec-92faee1f8795",
                                                "sense_id": "e5c26443-748f-383b-8dbc-c8a16fb78506",
                                                "text": "Pendant votre heure de fourche, vous irez à l’étude faire vos devoirs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8fa1398-19b5-3fc7-b25e-c480cbaed809",
                                        "entry_id": "f39ac51a-fffa-30a0-ba62-48406c2427ca",
                                        "glosses": [
                                            "Couture qui sépare les jambes d’un pantalon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42f2e2c8-3c25-48a9-9b3c-13cc85b5d369",
                                                "sense_id": "b8fa1398-19b5-3fc7-b25e-c480cbaed809",
                                                "text": "Puis, il se troua, à la fourche, et, peu à peu, les trous s’agrandissant, laissèrent passer des blancheurs suspectes de chemise, et s’ouvrirent sur des coins de chair d’une cruelle inconvenance."
                                            }
                                        ]
                                    },
