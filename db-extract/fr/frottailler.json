                        "glosses": [
                            "Frotter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "429d9477-8b14-4a18-91c5-8800c66ff395",
                                "sense_id": "785de2b9-6007-356b-85a6-a5739450a020",
                                "text": "Enfin, le voilà dans ses armures et fanfreluches complètes de prêtre-guerrier qui frottaille de petites crécelles de bois sec."
                            },
                            {
                                "example_id": "41732366-e341-45ce-b9bb-8dd34a48e77f",
                                "sense_id": "785de2b9-6007-356b-85a6-a5739450a020",
                                "text": "Mais à force de frottailler à jet continu il est devenu pratiquement immunisé…"
                            },
                            {
                                "example_id": "c13a0fcb-d89d-40c7-b39b-b8640d4a0c79",
                                "sense_id": "785de2b9-6007-356b-85a6-a5739450a020",
                                "text": "Soyons justes : les fermiers n’étaient pas les seuls à se frottailler aux cotillons des petites bonnes."
                            }
                        ]
                    }
