                                    },
                                    {
                                        "sense_id": "21086351-f0cc-3fb7-a732-6fc6d3614c69",
                                        "entry_id": "1aa80f13-85fd-3e9c-8802-31da99a19324",
                                        "glosses": [
                                            "Variante orthographique de différencier."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0287ac81-4db2-40eb-805d-ffa27e3ede64",
                                                "sense_id": "21086351-f0cc-3fb7-a732-6fc6d3614c69",
                                                "text": "« Il n’y a pas de mécanisme pour différentier le sperme ami et ennemi », confie à NBC Amy Rosenman."
                                            },
                                            {
                                                "example_id": "38ae8ff8-87dc-44fc-8315-7559717d8e20",
                                                "sense_id": "21086351-f0cc-3fb7-a732-6fc6d3614c69",
                                                "text": "Réussir l’exécution de leur stratégie s’avère donc être, plus que jamais, un enjeu majeur pour les entreprises, afin qu’elles continuent à créer de la valeur économique et sociétale, maîtriser leurs risques et se différentier de leurs concurrents."
                                            }
