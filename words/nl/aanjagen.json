            "senses": [
                {
                    "sense_id": "7968c85b-71fe-31fb-a9ec-7f01dbb63d9e",
                    "sense_definition": "Iemand angst of schrik bezorgen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotie-opwekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het vooruitzicht om helemaal alleen in dat grote, donkere bos te slapen <w>joeg</w> mij angst <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "The prospect of sleeping all alone in that big, dark forest <w>frightened</w> me."
                            }
                        },
                        {
                            "text": "De harde donder en de bliksem <w>joegen</w> de jonge kinderen veel angst <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "The loud thunder and lightning <w>scared</w> the young children a lot."
                            }
                        }
                    ],
                    "synonyms": [
                        "beangstigen",
                        "schrik aanjagen"
                    ],
                    "antonyms": [
                        "geruststellen"
                    ],
                    "common_phrases": [
                        "angst aanjagen",
                        "schrik aanjagen"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause someone fear or fright."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "frighten",
                                "target_lang_sense_clarification": "to make someone afraid"
                            },
                            {
                                "target_lang_word": "scare",
                                "target_lang_sense_clarification": "to cause fear in someone"
                            },
                            {
                                "target_lang_word": "terrify",
                                "target_lang_sense_clarification": "to fill with severe fear"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "620c992a-dd97-3232-93ed-0fd932446ac6",
                    "sense_definition": "Aansporen tot grotere spoed of activiteit; stimuleren of opjutten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stimuleren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben meer uitgeput van het <w>aanjagen</w> van de groep dan van het beklimmen van die laatste heuvel.",
                            "target_lang_translations": {
                                "en": "I am more exhausted from <w>driving</w> the group than from climbing that last hill."
                            }
                        },
                        {
                            "text": "De manager probeert de verkoopcijfers flink <w>aan</w> te <w>jagen</w> met een nieuwe campagne.",
                            "target_lang_translations": {
                                "en": "The manager is trying to significantly <w>boost</w> sales figures with a new campaign."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanmoedigen",
                        "opjutten",
                        "stimuleren",
                        "prikkelen"
                    ],
                    "antonyms": [
                        "afremmen",
                        "vertragen"
                    ],
                    "common_phrases": [
                        "de economie aanjagen",
                        "een proces aanjagen"
                    ],
                    "target_lang_definitions": {
                        "en": "To urge to greater speed or activity; to stimulate, boost, or spur on."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "boost",
                                "target_lang_sense_clarification": "to stimulate or increase activity"
                            },
                            {
                                "target_lang_word": "spur on",
                                "target_lang_sense_clarification": "to encourage or urge to move faster"
                            },
                            {
                                "target_lang_word": "drive",
                                "target_lang_sense_clarification": "to push or motivate a process or group"
                            },
                            {
                                "target_lang_word": "stimulate",
                                "target_lang_sense_clarification": "to encourage development or activity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fab164b-2ab3-31ec-8c23-60698f6f4865",
                    "sense_definition": "Een vuur harder doen branden door er lucht of brandstof aan toe te voeren.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door extra hout op de haard te leggen, <w>joeg</w> hij het vuur flink <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "By putting extra wood on the hearth, he <w>stoked</w> the fire considerably."
                            }
                        },
                        {
                            "text": "De harde wind hielp mee om de vlammen in de droge bossen snel <w>aan</w> te <w>jagen</w>.",
                            "target_lang_translations": {
                                "en": "The strong wind helped to quickly <w>fan</w> the flames in the dry forests."
                            }
