                                        "glosses": [
                                            "zugleich hörbar und sichtbar; zugleich akustisch und optisch wirksam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae5298e8-1dea-4bda-b44f-8b4fa261d7e2",
                                                "sense_id": "74e7935e-15d9-3a71-97e7-03502a2ddda8",
                                                "text": "Nach Butzkamm konnten jedoch die Vertreter audiovisueller Methoden den Anspruch nicht einlösen, mithilfe der Bilder die Basistexte einsprachig angemessen zu semantisieren."
                                            },
                                            {
                                                "example_id": "aca9613b-03ba-4ebb-ac0a-9080e2385f54",
                                                "sense_id": "74e7935e-15d9-3a71-97e7-03502a2ddda8",
                                                "text": "Ein Vergleich von audiolingualer und audiovisueller Methode bezüglich ihrer methodischen Verfahrensweisen lässt deutliche Parallelen erkennen."
                                            },
                                            {
                                                "example_id": "dfa67f2f-585b-457b-88b9-753d5231d325",
                                                "sense_id": "74e7935e-15d9-3a71-97e7-03502a2ddda8",
                                                "text": "Als audiovisuelle Medien (AV-Medien) werden synchrone technische Kommunikationsmittel bezeichnet, die die visuellen und auditiven Sinne des Menschen durch Ton und Bild bedienen."
                                            },
                                            {
                                                "example_id": "c3fc7935-e76b-4ca6-8cbf-68aadd4f981b",
                                                "sense_id": "74e7935e-15d9-3a71-97e7-03502a2ddda8",
                                                "text": "Der Studiengang Audiovisuelle Medien geht zurück auf den 1979 gegründeten Studiengang Medientechnik."
                                            },
                                            {
                                                "example_id": "09dcdd89-d4ac-438d-8158-a8962748490c",
                                                "sense_id": "74e7935e-15d9-3a71-97e7-03502a2ddda8",
                                                "text": "Trotz des immer größer werdenden Angebotes an audiovisuellen Materialien gibt es immer noch viele Lehrende, die in ihrem Unterricht kaum Filme einsetzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
