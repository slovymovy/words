                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "121751ce-8130-441a-be7c-5a0984b52898",
                                                "sense_id": "f4e9acfe-5125-3f6a-b120-32d80766d553",
