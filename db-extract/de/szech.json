                "senses": [
                    {
                        "sense_id": "99e30abb-0636-3f14-82ec-3fafb574c377",
                        "entry_id": "66a44571-9646-3154-84d7-5c276d2d27d6",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8fddf4a-5a29-4b27-8e8c-2ea454f74545",
                                "sense_id": "99e30abb-0636-3f14-82ec-3fafb574c377",
                                "text": "Frau Szech ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "08c7fbc9-958c-4073-bedf-20ee6ca54024",
                                "sense_id": "99e30abb-0636-3f14-82ec-3fafb574c377",
                                "text": "Herr Szech wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a00fdd60-20f7-4de5-8e74-b44a91bb0b3d",
                                "sense_id": "99e30abb-0636-3f14-82ec-3fafb574c377",
                                "text": "Die Szechs kommen heute aus dem Sauerland."
                            },
                            {
                                "example_id": "fb632d82-fec0-4a8b-996d-dfde56b0159f",
                                "sense_id": "99e30abb-0636-3f14-82ec-3fafb574c377",
                                "text": "Der Szech trägt nie die Schals, die die Szech ihm strickt."
                            },
                            {
                                "example_id": "5bb5d43c-ca32-48ec-b639-b0a2021ace6d",
                                "sense_id": "99e30abb-0636-3f14-82ec-3fafb574c377",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Szech kommt, geht der Herr Szech.“"
                            },
                            {
                                "example_id": "32193deb-4361-408d-ad5e-1f39144e3a56",
                                "sense_id": "99e30abb-0636-3f14-82ec-3fafb574c377",
                                "text": "Szech kommt und geht."
                            },
                            {
                                "example_id": "68f4deda-c1c4-46f3-a4c8-832c852311f1",
                                "sense_id": "99e30abb-0636-3f14-82ec-3fafb574c377",
                                "text": "Szechs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
