        "fr-extract.jsonl": [
            {
                "entry_id": "838fc89b-0df6-311d-84ec-e7c4a0cf9d4c",
                "word": "voilette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1c68f972-d061-4d6e-8afb-88ba8f5948a1",
                        "entry_id": "838fc89b-0df6-311d-84ec-e7c4a0cf9d4c",
                        "tags": [
                            "plural"
                        ],
                        "form": "voilettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca267331-1749-328e-b69a-0017437fc91a",
                        "entry_id": "838fc89b-0df6-311d-84ec-e7c4a0cf9d4c",
                        "glosses": [
                            "Petit voile que les femmes portent sur le visage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df139b15-df0d-48e7-9ae9-e52c9b17fbb8",
                                "sense_id": "ca267331-1749-328e-b69a-0017437fc91a",
                                "text": "C’était Satin, avec un chapeau et une voilette, prenant des airs de dame en visite. Une jolie roulure ! murmura Prullière."
                            },
                            {
                                "example_id": "27631407-7ca3-4e02-b138-c2479f271335",
                                "sense_id": "ca267331-1749-328e-b69a-0017437fc91a",
                                "text": "Dechartre, attaché à madame Marmet, écoutait avec patience des anecdotes où des académiciens dînaient chez des femmes élégantes ; et il entrait dans les soucis de cette dame, très préoccupée depuis plusieurs jours d’acheter une voilette de tulle. Elle n’en trouvait pas à son goût dans les magasins de Florence, et elle regrettait la rue du Bac."
                            },
                            {
                                "example_id": "fde7f35e-d568-4675-9bee-4b15a45f00b7",
                                "sense_id": "ca267331-1749-328e-b69a-0017437fc91a",
                                "text": "La porte s’entrebâilla. Le profil de Madame Rostand s’y encadra, un profil d’une pureté classique, un profil où souriaient discrètement, sous la minceur tendue de la voilette, la fraîcheur d’un bouche entr’ouverte sur une très jolie denture et le feu de deux beaux yeux brûlants et clairs."
                            },
                            {
                                "example_id": "ebf167e1-36b6-4b52-859c-052cce6fd8c2",
                                "sense_id": "ca267331-1749-328e-b69a-0017437fc91a",
                                "text": "Le loup avec voilette en dentelle doublée constitue la touche finale du déguisement."
                            },
                            {
                                "example_id": "a41ab726-952b-4247-a785-2aca18c5ab8d",
                                "sense_id": "ca267331-1749-328e-b69a-0017437fc91a",
                                "text": "Les jeunes gens, les jeunes filles surtout, une petite voilette sur le visage, s’adonnaient à la danse sans relâche, avec grâce et frénésie à la fois, au son de la ghaïta […] si répandue en Afrique du Nord."
                            }
                        ]
                    },
                    {
                        "sense_id": "78d63401-3667-3722-8c48-119a756eca39",
                        "entry_id": "838fc89b-0df6-311d-84ec-e7c4a0cf9d4c",
                        "glosses": [
                            "Obstacle qui altère la vue ou la vision."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fb8309a7-4f4b-401d-b6b7-8f3462c6617f",
                                "sense_id": "78d63401-3667-3722-8c48-119a756eca39",
                                "text": "Le moindre effort me mettait en moiteur, m’amenait aux lèvres un cœur amer, me faisait devant les yeux une voilette dansante."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fb6c0cb-220a-3c49-9419-07ee194c8fd3",
                        "entry_id": "838fc89b-0df6-311d-84ec-e7c4a0cf9d4c",
                        "glosses": [
                            "Nom donné par les pêcheurs à Sialis lutaria, insecte utilisé pour la pêche à la mouche."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "735207b7-d320-4977-b059-aa43d1fdac9c",
                        "source_entry_id": "838fc89b-0df6-311d-84ec-e7c4a0cf9d4c",
