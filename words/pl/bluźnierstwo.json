                    "sense_definition": "naruszenie, zbezczeszczenie lub okazanie braku szacunku wobec powszechnie szanowanych wartości, idei lub norm",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaforyczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dla wielu miłośników literatury klasycznej ta współczesna adaptacja była jawnym <w>bluźnierstwem</w>.",
                            "target_lang_translations": {
                                "ru": "Для многих любителей классической литературы эта современная адаптация была явным <w>кощунством</w>."
                            }
                        },
                        {
                            "text": "Zniszczenie wiekowego lasu uznano za moralne <w>bluźnierstwo</w> wobec przyszłych pokoleń.",
                            "target_lang_translations": {
                                "ru": "Уничтожение векового леса сочли моральным <w>кощунством</w> по отношению к будущим поколениям."
                            }
                        }
                    ],
                    "synonyms": [
