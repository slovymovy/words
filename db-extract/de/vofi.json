                        "examples": [
                            {
                                "example_id": "71d5cf7c-f373-47d4-92db-8077a3b49046",
                                "sense_id": "15562025-590c-39f0-a348-e64dd5a73109",
                                "text": "Die Grundeigenschaften des tabellarisch aufgebauten VOFI sind Transparenz und Ausbaufähigkeit."
                            },
                            {
                                "example_id": "17b2cf64-5c4f-4167-9eab-1114783fc0b3",
                                "sense_id": "15562025-590c-39f0-a348-e64dd5a73109",
                                "text": "Daraufhin wurde zunächst der VOFI für die Opportunität unter Berücksichtigung von Steuern erarbeitet (vgl. Abb.55–1), um die Zinsen für die Kapitalwertformel zu bestimmen."
                            },
                            {
                                "example_id": "d01cfcb6-ea2b-457e-b221-137b0ef393af",
                                "sense_id": "15562025-590c-39f0-a348-e64dd5a73109",
                                "text": "Hierzu wurden die theoretischen Grundlagen des Investitionscontrollinginstruments VOFI für den Einsatz als Investitionsrechnung dargestellt."
                            }
                        ],
