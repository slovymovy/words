                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3b5e1ff-b5c8-490e-88fb-9c1935a6953f",
                        "source_entry_id": "a7510d62-527b-37bc-a309-80ff1443e473",
                        "source_sense_id": "eb896977-7799-3211-8c99-30c5280c2435",
                        "target_lang_word": "gridlock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gridlock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a355b608-87dd-3559-bd1e-1bcf17c10e33",
                                        "entry_id": "03d06746-499d-3d75-a774-ea825f31706c",
                                        "glosses": [
                                            "A condition of total, interlocking traffic congestion on the streets or highways of a crowded city, in which no one can move because everyone is in someone else's way."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4bf8bbf6-ed59-3e99-a8c1-3857715e1350",
                                        "entry_id": "03d06746-499d-3d75-a774-ea825f31706c",
                                        "glosses": [
                                            "On a smaller scale, the situation in which cars enter a signal-controlled intersection too late during the green light cycle, and are unable to clear the intersection (due to congestion in the next block) when the light turns red, thus blocking the cross traffic when it's their turn to go. Repeated at enough intersections, this phenomenon can lead to citywide gridlock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f063488d-1ba9-35b7-9f4c-b916de0a53ba",
                                        "entry_id": "03d06746-499d-3d75-a774-ea825f31706c",
                                        "glosses": [
                                            "Any paralysis of a complex system due to severe congestion, conflict, or deadlock."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1bdbf9d-914d-4480-87e4-d44d3fb79346",
                                                "sense_id": "f063488d-1ba9-35b7-9f4c-b916de0a53ba",
                                                "text": "But no party appeared on track to secure an absolute majority, leaving one of Europe’s largest countries headed for gridlock or political instability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8a25dec-6a00-3842-8b21-729715ffa942",
                                        "entry_id": "03d06746-499d-3d75-a774-ea825f31706c",
                                        "glosses": [
                                            "Deliberate misspelling of girlcock or girldick."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "deliberate",
                                            "misspelling",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdd5d966-45e7-42e2-829d-a2467f5413a5",
                                                "sense_id": "f8a25dec-6a00-3842-8b21-729715ffa942",
                                                "text": "God, ngl, some gridlock sounds real good right about now (iykyk)"
                                            },
                                            {
                                                "example_id": "a5829031-e93a-4060-b0b4-466afe49adc0",
                                                "sense_id": "f8a25dec-6a00-3842-8b21-729715ffa942",
                                                "text": "Why are we still here? Just to suffer? Every night, I can feel my gridlock... And my girldick... even my shenis... The body I've lost... the comrades I've lost... won't stop hurting... It's like they're all still there."
                                            },
                                            {
                                                "example_id": "665a40b0-e58b-4500-8f20-c28598b700d2",
                                                "sense_id": "f8a25dec-6a00-3842-8b21-729715ffa942",
                                                "text": "pros of dating me : im cute and nice and i have an integra, my gridlock is perfectly sized ¶ cons of dating me: i WILL leave all my misc car parts, video game accessories, milsurp equipment, and cute girl clothes in your room. this is non-negotionable. this is where it goes now."
                                            },
                                            {
                                                "example_id": "12e6e9a8-03d5-41de-8712-b496e19b0035",
                                                "sense_id": "f8a25dec-6a00-3842-8b21-729715ffa942",
                                                "text": "Making my girlfriend print out a cute pic of my gridlock so she doesn’t forget what it looks like while she’s away from me."
                                            },
                                            {
                                                "example_id": "58fe57bf-3aba-45b0-8f76-a1bf39a63192",
                                                "sense_id": "f8a25dec-6a00-3842-8b21-729715ffa942",
                                                "text": "Tattoo on my gridlock that says twink death"
                                            },
