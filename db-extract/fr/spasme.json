        "fr-extract.jsonl": [
            {
                "entry_id": "33eb970f-bde6-3c22-8c21-8ed7a2ee7394",
                "word": "spasme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c822a842-d7ed-4eb7-9210-ae2d5dc1566f",
                        "entry_id": "33eb970f-bde6-3c22-8c21-8ed7a2ee7394",
                        "tags": [
                            "plural"
                        ],
                        "form": "spasmes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e565519d-09e2-35ad-8171-fa57ea385241",
                        "entry_id": "33eb970f-bde6-3c22-8c21-8ed7a2ee7394",
                        "glosses": [
                            "Contraction involontaire, mouvement convulsif de certains muscles lisses ou striés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02395c17-15df-48cf-b6f8-25ac68babc7b",
                                "sense_id": "e565519d-09e2-35ad-8171-fa57ea385241",
                                "text": "En lisant cette lettre, d’Artagnan sentait son cœur se dilater et s’étreindre de ce doux spasme qui torture et caresse le cœur des amants."
                            },
                            {
                                "example_id": "c0fb512b-214c-40d5-8ad9-a5749dc66091",
                                "sense_id": "e565519d-09e2-35ad-8171-fa57ea385241",
                                "text": "Le spasme la raidit, la tint frémissante… Puis la tête retomba et je serrai le petit corps tout faible contre moi."
                            },
                            {
                                "example_id": "c412c840-af83-41cf-8118-740409039cba",
                                "sense_id": "e565519d-09e2-35ad-8171-fa57ea385241",
                                "text": "Les maladies du système nerveux central sont susceptibles de provoquer l’apparition de spasmes, souvent déclenchés, comme dans le cas du tétanos, par des stimulations nerveuses brutales telles qu’un bruit soudain de forte intensité."
                            },
                            {
                                "example_id": "cd8b25f6-5615-4715-8ce3-485b20904c42",
                                "sense_id": "e565519d-09e2-35ad-8171-fa57ea385241",
                                "text": "Ah ! comme la neige a neigé !\nMa vitre est un jardin de givre.\nAh ! comme la neige a neigé !\nQu’est-ce que le spasme de vivre\nÀ la douleur que j’ai, que j’ai."
                            },
                            {
                                "example_id": "eda5fec8-b58c-4f0e-a07c-14acce39705f",
                                "sense_id": "e565519d-09e2-35ad-8171-fa57ea385241",
                                "text": "Spasme gastrique. Spasme musculaire. Spasme tonique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec628885-6cd3-4915-b29f-e5bc072b0bdb",
                        "source_entry_id": "33eb970f-bde6-3c22-8c21-8ed7a2ee7394",
                        "source_sense_id": "e565519d-09e2-35ad-8171-fa57ea385241",
                        "target_lang_word": "Krampf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krampf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad12d28-5ab7-31b3-95d5-f454de8f984f",
                                        "entry_id": "875641da-1c1c-3fa9-9fbd-d6f968e1180a",
                                        "glosses": [
                                            "ungewollte starke Muskelanspannung, die mit sehr großen Schmerzen verbunden sein kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "212a599e-1dbf-4c77-90ab-43d72e6ed6b9",
                                                "sense_id": "8ad12d28-5ab7-31b3-95d5-f454de8f984f",
                                                "text": "Bei einem Krampf hilft manchmal Massieren."
                                            },
                                            {
                                                "example_id": "6f9ec9e1-4ec3-4769-baf4-9e62bbc8a9d2",
                                                "sense_id": "8ad12d28-5ab7-31b3-95d5-f454de8f984f",
                                                "text": "„Ich glaubte, sie geheilt zu haben; doch am nächsten Tage befielen die Krämpfe ihr Gehirn.“"
                                            },
                                            {
                                                "example_id": "d043a3b2-a316-4c8d-ab47-e3c72d139d21",
                                                "sense_id": "8ad12d28-5ab7-31b3-95d5-f454de8f984f",
                                                "text": "„Ravic konnte sehen, wie die Wellen der Krämpfe durch sie gingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "912a9d14-e8c0-3050-878f-81ad65f406ff",
                                        "entry_id": "875641da-1c1c-3fa9-9fbd-d6f968e1180a",
                                        "glosses": [
                                            "erfolglose oder unverhältnismäßige Bemühung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "912084f1-8d56-448e-bbae-d4a7f30e4f03",
                                                "sense_id": "912a9d14-e8c0-3050-878f-81ad65f406ff",
                                                "text": "Das Spiel war ein einziger Krampf."
                                            },
                                            {
                                                "example_id": "1dd2d1ff-b1b8-4cf3-8124-810a5e7602ae",
                                                "sense_id": "912a9d14-e8c0-3050-878f-81ad65f406ff",
                                                "text": "„So ein Krampf passiert doch täglich.“"
                                            },
                                            {
                                                "example_id": "8ef69415-d43e-4b25-a194-15a870ff1f03",
                                                "sense_id": "912a9d14-e8c0-3050-878f-81ad65f406ff",
                                                "text": "„ERG [Ethik, Religionen, Gesellschaft]: Der grosse Krampf mit einem Schulfach."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e91bac23-b7d5-3910-b823-253d913ca76e",
                                        "entry_id": "875641da-1c1c-3fa9-9fbd-d6f968e1180a",
                                        "glosses": [
                                            "harte Arbeit, mühselige Anstrengung"
                                        ],
                                        "tags": [
                                            "Swiss Standard German",
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02255754-21fc-45f1-a5ba-b4390bb333a8",
                                                "sense_id": "e91bac23-b7d5-3910-b823-253d913ca76e",
                                                "text": "„Mit Krampf zum Sieg – GC gewinnt in Thun 2:0.“"
                                            },
                                            {
                                                "example_id": "a347c762-d437-4198-a922-fbceae154999",
                                                "sense_id": "e91bac23-b7d5-3910-b823-253d913ca76e",
                                                "text": "„Jeder Match, jedes Training war ein Krampf.“"
                                            },
                                            {
                                                "example_id": "dd445916-9018-48da-bd94-ebdeeb25f2c9",
                                                "sense_id": "e91bac23-b7d5-3910-b823-253d913ca76e",
                                                "text": "„Das Bschütte [= Ausführen von Gülle] ist ein Krampf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
