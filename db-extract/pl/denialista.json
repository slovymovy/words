                "senses": [
                    {
                        "sense_id": "ef472663-9346-3e8f-a1a5-b81684c4b2e4",
                        "entry_id": "c1605e69-5a1e-3b91-b713-6254bc1cf65e",
                        "glosses": [
                            "osoba, która odrzuca określone ustalenia naukowe, zaprzecza faktom, hołduje zaklinaniu rzeczywistości"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "b1e24454-1c06-4fd3-a8f4-7a0444e03975",
                                "sense_id": "ef472663-9346-3e8f-a1a5-b81684c4b2e4",
                                "text": "Dookoła pełno jest wciąż klimatycznych denialistów, apologetów przemysłowej produkcji mięsa i rabunkowej deforestacji, a wybory w Polsce wygrywają ci, którzy przyrodę mają za nic"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cb0df93-fc0c-4280-8a1c-068117a12d1e",
                        "source_entry_id": "c1605e69-5a1e-3b91-b713-6254bc1cf65e",
                        "source_sense_id": "ef472663-9346-3e8f-a1a5-b81684c4b2e4",
                        "target_lang_word": "denialist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "denialist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6dcd968-6c66-3ece-9df6-ec241f189084",
                                        "entry_id": "d84bb47f-ffff-3eeb-9d19-90ab6d5b7ef7",
                                        "glosses": [
                                            "One who denies an assertion in a controversial debate."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c00658c4-dece-421c-b485-0a88954bf867",
                                                "sense_id": "e6dcd968-6c66-3ece-9df6-ec241f189084",
                                                "text": "The whole point of the TAC and other Aids activists is that the country can never deal with its Aids problem while the president is an Aids denialist, and while the government keeps putting back the timetable for providing ARVs."
                                            },
                                            {
                                                "example_id": "0b569e8f-927a-4e9c-82ea-05d221aa365a",
                                                "sense_id": "e6dcd968-6c66-3ece-9df6-ec241f189084",
                                                "text": "The Advertising Standards Authority (ASA) has found in favour of the Treatment Action Campaign, which complained to it about an advertisement that was placed by a controversial German Aids denialist and which said, among other things, that anti-retrovirals were poisonous."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "denialist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "396b50bd-3d1c-3ba6-bafa-b7553bb1a661",
                                        "entry_id": "60271a2a-6137-341c-bf9d-5c133cefc68b",
                                        "glosses": [
                                            "Relating to denial in a controversial debate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7efd40a-0002-411c-8d6a-a40232b098d1",
                        "source_entry_id": "c1605e69-5a1e-3b91-b713-6254bc1cf65e",
