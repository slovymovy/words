                "senses": [
                    {
                        "sense_id": "cef6b93b-cd77-3d1f-ac04-50d3fb0f5d68",
                        "entry_id": "32e6b9ba-2863-3744-9897-e8b70242595e",
                        "glosses": [
                            "Étanche du point de vue sonore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07a74af2-bdb2-4b83-819c-18b7d381828e",
                                "sense_id": "cef6b93b-cd77-3d1f-ac04-50d3fb0f5d68",
                                "text": "Et Jacques-Yves Mortaux, le roi des shampooings décapants et des analgésiques de choc, des crânes pelliculés, voire chauves, et des estomacs ulcérés, écoute le silence de son bureau insonorisé de la place Vendôme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62d7feb5-80f0-4d1b-b3f7-0b6de03a23d8",
                        "source_entry_id": "32e6b9ba-2863-3744-9897-e8b70242595e",
                        "source_sense_id": "cef6b93b-cd77-3d1f-ac04-50d3fb0f5d68",
                        "target_lang_word": "soundproof",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soundproof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32ad126e-00f2-33d8-9cf3-084f4dd08746",
                                        "entry_id": "5b19f6ad-e622-3f0b-9ee4-65598508f726",
                                        "glosses": [
                                            "Not allowing sound through."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c7942bb-ac71-4b30-a36b-1c39941381e0",
                                                "sense_id": "32ad126e-00f2-33d8-9cf3-084f4dd08746",
                                                "text": "The contestant was placed in a soundproof booth so he could not receive help from the audience."
                                            },
                                            {
                                                "example_id": "c9bbc1d0-c690-49fe-b7a4-0afbfe0b4250",
                                                "sense_id": "32ad126e-00f2-33d8-9cf3-084f4dd08746",
                                                "text": "The electrical activity of the subject's cerebral cortex was recorded in a state of relative rest, after a 5 min adaptation of the subject to a dark soundproof chamber. The biopotentials were recorded from the electroencephaloscope screen […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "soundproof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7eb29e2d-a5be-394e-a825-7ac3f03ca9ae",
                                        "entry_id": "73e478b3-e125-35a9-acd5-ce7cc84c6c6a",
                                        "glosses": [
                                            "To make resistant to transmitting sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67744e03-6c4e-4d64-be17-892f9180bb5d",
                                                "sense_id": "7eb29e2d-a5be-394e-a825-7ac3f03ca9ae",
                                                "text": "We soundproofed the room so we couldn't hear the road noises; unfortunately we couldn't hear the fire alarm either."
                                            },
                                            {
                                                "example_id": "6aafe72a-d90d-4834-9f09-800a3eb3d5a6",
                                                "sense_id": "7eb29e2d-a5be-394e-a825-7ac3f03ca9ae",
                                                "text": "It almost goes without saying that the train is fully soundproofed, with double-glazed windows and highly efficient air-conditioning by the British firm of J. Stone."
                                            },
                                            {
                                                "example_id": "b4db9853-27f4-4d4c-9883-bf9d150526aa",
                                                "sense_id": "7eb29e2d-a5be-394e-a825-7ac3f03ca9ae",
                                                "text": "Soundproofing a room may be as simple as sealing gaps around a door, or it may require rebuilding an entire wall or lowering a ceiling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
