                            {
                                "example_id": "1d261fd6-dff2-4b42-8826-a874236eea7c",
                                "sense_id": "4f95635e-ffc1-38cd-b19c-04a1fddf3004",
                                "text": "Nigdy nie myślałem o życiu anachorety."
                            }
