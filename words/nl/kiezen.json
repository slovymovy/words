                                "de": "Man hat sich bewusst für einen recht vorsichtigen Ansatz <w>entschieden</w>."
                            }
                        },
                        {
                            "text": "Veel mensen <w>kiezen</w> voor een gezonde levensstijl.",
                            "target_lang_translations": {
                                "en": "Many people <w>choose</w> a healthy lifestyle.",
                                "de": "Viele Menschen <w>entscheiden sich</w> für einen gesunden Lebensstil."
                            }
                        }
