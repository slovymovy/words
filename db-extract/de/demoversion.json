                                "example_id": "aae1d514-2bbf-4a1a-8842-ac12d1dba9e8",
                                "sense_id": "18d56909-7c84-38b8-890f-1e4fcf02b6cb",
                                "text": "„Von beiden Produkten gibt es auch eine Demoversion zum Download.“"
                            },
                            {
                                "example_id": "f3a9969f-7b03-4da6-872a-8ef78275210b",
                                "sense_id": "18d56909-7c84-38b8-890f-1e4fcf02b6cb",
                                "text": "„Viele bekannte Hersteller bieten zeitlich beschränkte Demoversionen ihrer Software an.“"
                            }
