                        "target_lang_word": "Postskript",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Postskript",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66d3f2c6-7445-379f-bdea-177d5913014f",
                                        "entry_id": "efeb86c6-7f75-3b34-8696-2e836fe594c7",
                                        "glosses": [
                                            "angefügte Ergänzung bei einem Text als Ergänzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07244b53-e997-4796-a1c5-c700b633921f",
                                                "sense_id": "66d3f2c6-7445-379f-bdea-177d5913014f",
                                                "text": "„Man kann den »Agathon« auch in der letzten, scheinbar abgeschlossenen, aber dann doch im Postskript wieder geöffneten Gestalt als eine Suchbewegung lesen, die nicht an ein befriedigendes Ende kommt, sondern einfach aufhört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd031e56-30e9-4b71-bb4c-c894a1cb36c7",
                        "source_entry_id": "ee4bc814-f93c-3957-8c9a-ecc022a8365a",
                        "source_sense_id": "3b24869e-63d5-3510-b279-37185d41225a",
                        "source_sense_description": "das Postskript, die Nachschrift",
                        "target_lang_word": "Nachschrift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachschrift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "639d77ea-21fe-35e8-a52e-08a04fc16103",
                                        "entry_id": "c46dc907-a885-397f-9588-96a17af7b018",
                                        "glosses": [
                                            "etwas, was nachträglich oft zusammenfassend geschrieben wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b49c3b1a-bc7f-4ef2-a42f-c010d63212d6",
                                                "sense_id": "639d77ea-21fe-35e8-a52e-08a04fc16103",
                                                "text": "„Nach der Rückkehr verfaßt Peter Handke eine Nachschrift seines einwöchigen Aufenthalts in der Enklave.“"
                                            },
                                            {
                                                "example_id": "ca079d2e-1768-4967-9cbb-67afac83b477",
                                                "sense_id": "639d77ea-21fe-35e8-a52e-08a04fc16103",
                                                "text": "„Die Homilienreihe zum Philipperbrief aus den Jahren 1817/18 wird erstmals in Form zeitgenössischer Nachschriften von Ludwig Jonas erschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc3f06fe-8461-3eb6-9070-e427db67971a",
                                        "entry_id": "c46dc907-a885-397f-9588-96a17af7b018",
                                        "glosses": [
                                            "Handlung, bei der etwas nachträglich oft zusammenfassend geschrieben wird"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ccc653d0-5c64-3d7e-ae05-f2a05e64739e",
                                        "entry_id": "c46dc907-a885-397f-9588-96a17af7b018",
                                        "glosses": [
                                            "angefügte Ergänzung bei einem Text als Ergänzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfd615b6-c24b-4ba3-9018-063b6dd37daa",
                                                "sense_id": "ccc653d0-5c64-3d7e-ae05-f2a05e64739e",
                                                "text": "„Eine Nachschrift an der Seite des Briefes enthielt anch die ‚kleine Neuigkeit,‘ […] daß ihr Mann kürzlich zum Hofgerichtsrath ernannt und in den Adelstand erhoben worden war.“"
                                            },
                                            {
                                                "example_id": "73d56d4b-0295-46be-9124-5dd7c191a95e",
                                                "sense_id": "ccc653d0-5c64-3d7e-ae05-f2a05e64739e",
                                                "text": "„Schon am April 1813 bedauert Joseph aus Breslau in einer Nachschrift zum Brief seines Freundes Philipp Veit an dessen Mutter Dorothea Schlegel in Wien, wo Wilhelm von Eichendorff zurückgeblieben ist.“"
                                            },
                                            {
                                                "example_id": "bdca7539-78a6-46b2-9eca-6a08a4ea5dc1",
                                                "sense_id": "ccc653d0-5c64-3d7e-ae05-f2a05e64739e",
                                                "text": "„In einer Nachschrift, die länger als der Brief selbst war, war hinzugefügt, daß er durch eine Krisis gegangen sei; diese Krisis aber liege jetzt hinter ihm, und er hoffe sagen zu dürfen, ein Grund, an ihm oder seinem Rechtsgefühle zu zweifeln, werde nicht wiederkehren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e585d651-15fb-46a7-9732-28f600b39cd9",
                        "source_entry_id": "ee4bc814-f93c-3957-8c9a-ecc022a8365a",
