                "senses": [
                    {
                        "sense_id": "8d304b04-4caa-3305-b7e5-697265a5b365",
                        "entry_id": "6a45de66-836e-372e-a7db-9180f4533ff8",
                        "glosses": [
                            "Beschreibung der Darstellung und Anordnung von Daten innerhalb einer Datei"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "db5d5fe1-385f-4b26-b03d-51207b800db3",
                                "sense_id": "8d304b04-4caa-3305-b7e5-697265a5b365",
                                "text": "„Majdak und Noisternig entwickelten nun das Dateiformat \"SOFA\" (Spatially oriented format for acoustics).“"
                            },
                            {
                                "example_id": "3c02ee72-97e4-477f-8031-ee9e59869a6f",
                                "sense_id": "8d304b04-4caa-3305-b7e5-697265a5b365",
                                "text": "„Eine Lösung, die viele Nutzer nicht zufriedenstellen dürfte: Das Dateiformat wird häufig in Firmen eingesetzt, die Textdateien mit einfacher Formatierung mit Kunden beziehungsweise Partnern austauschen, die in unterschiedlichen Rechner- und Softeware-Umgebungen arbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
