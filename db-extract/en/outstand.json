                "senses": [
                    {
                        "sense_id": "5ae8943a-b404-3292-8049-54c49d85147a",
                        "entry_id": "1896ec8f-2f83-34eb-af12-f848e98e6ac2",
                        "glosses": [
                            "To resist effectually; withstand; sustain without yielding."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a9ba65c9-d1f3-49a2-9f0d-716e9296caaf",
                                "sense_id": "5ae8943a-b404-3292-8049-54c49d85147a",
                                "text": "Like Solomon's fool, he outstands all reproof."
                            },
                            {
                                "example_id": "32f58ddc-d6f0-4b3b-9376-c7fefe26be87",
                                "sense_id": "5ae8943a-b404-3292-8049-54c49d85147a",
                                "text": "[T]he Elephas primigenius [woolly mammoth] and some of its associates which were able to outstand the inclemency of that severe period, wandered back over their ancient territory, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "023cdda3-a5a0-39fb-a07d-24cf457c17a6",
                        "entry_id": "1896ec8f-2f83-34eb-af12-f848e98e6ac2",
                        "glosses": [
                            "To surpass in standing; stand or remain beyond; outstay."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "51da119f-a520-42b0-9146-9d7e1cabd40e",
                                "sense_id": "023cdda3-a5a0-39fb-a07d-24cf457c17a6",
                                "text": "I have outstood my time, which is material / To the tender of our present."
                            },
                            {
                                "example_id": "30ddd437-39ea-4e8f-9781-c3650272790f",
                                "sense_id": "023cdda3-a5a0-39fb-a07d-24cf457c17a6",
                                "text": "This difficulty […] does not arise from, nor is it peculiar to, revealed religion. It is a difficulty which outstands all systems; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c23b6115-9b38-381d-80bb-19861c631e6a",
                        "entry_id": "1896ec8f-2f83-34eb-af12-f848e98e6ac2",
                        "glosses": [
                            "To project outward from the main body; stand out prominently; be prominent."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5cf8aceb-ffad-4941-a4a9-cce602ced406",
                                "sense_id": "c23b6115-9b38-381d-80bb-19861c631e6a",
                                "text": "A lever connected to the cam outstands from the throat block, […]"
                            },
                            {
                                "example_id": "e0c9175b-c0ad-412f-96cc-809e84172491",
                                "sense_id": "c23b6115-9b38-381d-80bb-19861c631e6a",
                                "text": "The frog simply outstands from its surroundings due to its dark purplish vibrant color."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ea900b0-3422-3e99-b4d7-c0b5c2212e39",
                        "entry_id": "1896ec8f-2f83-34eb-af12-f848e98e6ac2",
                        "glosses": [
                            "To stand out to sea."
                        ],
                        "tags": [
                            "archaic",
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4fb9f750-0a2e-3b88-9c53-789561c81334",
                        "entry_id": "1896ec8f-2f83-34eb-af12-f848e98e6ac2",
                        "glosses": [
                            "To remain over; remain untouched, unimpaired, unsettled, uncollected, unpaid, or otherwise undetermined."
                        ],
                        "tags": [
                            "archaic",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9e5b875b-3c34-4434-891b-dd40d31d4c21",
                                "sense_id": "4fb9f750-0a2e-3b88-9c53-789561c81334",
                                "text": "The Judge gave a judgment against the whole boat's crew, I being one of the men, for $30,000. Of course, we did not feel like paying it. I did not; it was none of my fault, but I happened to belong to the same boat, and it outstands there now."
                            }
                        ]
                    }
