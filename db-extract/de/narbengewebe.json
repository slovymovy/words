                ],
                "senses": [
                    {
                        "sense_id": "a28bd982-bfe8-325a-adfb-7634f6c7ade3",
                        "entry_id": "22bcfdb1-694a-33c8-bcb1-ca6b5e773439",
                        "glosses": [
                            "Gewebe einer Narbe, als Folge von Narbenbildung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f1e7123-446b-4440-9223-9a5ca329ba1e",
                                "sense_id": "a28bd982-bfe8-325a-adfb-7634f6c7ade3",
                                "text": "„Seine Nase war mindestens zweimal gebrochen und unter den Augen hatte sich eine Menge Narbengewebe gebildet.“"
                            },
                            {
                                "example_id": "38cc015d-96bf-46ae-ab7c-a2a31438e760",
                                "sense_id": "a28bd982-bfe8-325a-adfb-7634f6c7ade3",
                                "text": "„Seine breite Stirn war eine einzige Masse aus grauem, striemigem Narbengewebe und sein linkes Auge, das, auf dem er blind war, war milchig grau und ohne jede Farbe.“"
                            },
                            {
                                "example_id": "9a72eeaf-0bd0-451a-b341-36c5d0120ef0",
                                "sense_id": "a28bd982-bfe8-325a-adfb-7634f6c7ade3",
                                "text": "„Die Haut um die Augen bestand aus grausigem Narbengewebe, obwohl der Unfall, das Feuer, das Omar El-Khayabs Sehfähigkeit für immer zerstört hatte, vor über 60 Jahren gebrannt hatte.“"
                            },
                            {
                                "example_id": "d5f661ab-d462-4987-bc90-0c8bc05253ad",
                                "sense_id": "a28bd982-bfe8-325a-adfb-7634f6c7ade3",
                                "text": "„Neuronen werden durch hirntotes Narbengewebe ersetzt.“"
                            },
                            {
                                "example_id": "64ebc818-ba1e-44b5-b83a-d0b508eb4025",
                                "sense_id": "a28bd982-bfe8-325a-adfb-7634f6c7ade3",
                                "text": "„Nur ein Schatten, ein Umriss, eine Sekunde lang, sogar weniger, in der er das Gesicht des Mannes sah, bevor es wieder verschwand. Der große Russe, der Bär, dessen linkes Ohr zu dickem Narbengewebe verformt war, als sei ein Stück davon abgebissen worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
