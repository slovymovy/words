                                            {
                                                "example_id": "d04ddae6-1c5c-4b92-af02-55f876cfc7d1",
                                                "sense_id": "bc7fbdcc-14b3-393a-bc56-6716b1204b5d",
                                                "text": "La serviette hygiénique conserve au teint sa fraîcheur, efface les rides, donne du velouté a la peau, parfume et la rend antiseptique; préserve du hile, de l'acné, des dartres, rugosités, boutons et éruptions dé toute sortes, et est indispensable à toute personne qui voyage."
                                            },
                                            {
                                                "example_id": "23e55cf1-419d-417f-ad41-8308c66b2f5c",
                                                "sense_id": "bc7fbdcc-14b3-393a-bc56-6716b1204b5d",
                                                "text": "N’employez, pour les soins du visage, que la « serviette hygiénique » approuvée par les autorités médicales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
