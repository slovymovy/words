                        "examples": [
                            {
                                "example_id": "b000760b-6193-40af-bb27-d44b6c57d316",
                                "sense_id": "7c54c813-fc3d-365e-9e2c-0cfe7b895e97",
                                "text": "„In der späteren Kolonialzeit wurden im Zentrum Mexikos, das nun Hauptstadt der spanischen Kolonialprovinz ‹Nueva España› war, neue öffentliche Gebäude wie der Regierungspalast, die Kathedrale, der Bischofspalast, Klöster der Franziskaner, Dominikaner, Augustiner und anderer Orden, Parroquial-Kirchen, die Universität, die Münze und die Residenzen reicher Kolonial-Spanier auf den Ruinen vorspanischer Gebäude errichtet.“"
                            }
                        ],
