                        "target_lang_word": "ceviche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceviche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2454390-4979-3f48-b80e-cd2a85e18341",
                                        "entry_id": "de8e7536-8c3e-3e56-a094-53d8fd5fd43f",
                                        "glosses": [
                                            "Marinade de poissons, de jus de citron vert et d’oignons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85941d5d-a569-43d8-a2a7-72a66171b081",
                                                "sense_id": "d2454390-4979-3f48-b80e-cd2a85e18341",
                                                "text": "Le ceviche, plat national du Pérou, est l’une des valeurs fondamentales du patrimoine de cette nation."
                                            },
                                            {
                                                "example_id": "ec6dc992-8633-42d3-87a6-20448ceda014",
                                                "sense_id": "d2454390-4979-3f48-b80e-cd2a85e18341",
                                                "text": "L’ex-Top Chef, qui a ouvert l’an dernier Bazurto, un restaurant colombien à Paris (6ᵉ), et vient de sortir Recuerdame (éd. First), aime servir à table des empanadas, un ceviche ou encore des plats à base de triguisar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "795a70e5-a28b-4e75-abce-21fc961203bc",
                        "source_entry_id": "3d1ce072-5e4c-36a1-a31f-e80bca0b5526",
                        "source_sense_id": "ce6541e1-d21f-3ee7-8c54-6ec61d1e0915",
                        "source_sense_description": "raw seafood cured by marination in an acidic medium",
                        "target_lang_word": "Ceviche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ceviche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "606cb357-3e84-3807-b45f-8fe32bd1b1de",
                                        "entry_id": "675be0ef-cda2-3080-9b52-37b4a17e0aa3",
                                        "glosses": [
                                            "(ursprünglich aus Peru stammendes und dort als Nationalgericht geltendes) Gericht aus rohem und in kleine Stücke geschnittenem Fisch – oder Meeresfrüchten –, der in einer Marinade aus Zitronen oder Limetten, Zwiebeln, Salz und Knoblauch zubereitet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48bed39b-408a-4dc1-9e4b-3c03e53fec9a",
                                                "sense_id": "606cb357-3e84-3807-b45f-8fe32bd1b1de",
                                                "text": "„‚Ceviches‘, rohe nur mit der Säure von Zitrusfrüchten gegarte Meerestiere, sind das Atout der Küche.“"
                                            },
                                            {
                                                "example_id": "19b2a3bf-ce72-472c-986d-6c825a4674e3",
                                                "sense_id": "606cb357-3e84-3807-b45f-8fe32bd1b1de",
                                                "text": "„Und unweit der Verbotenen Stadt hat er gerade ein südamerikanisches Restaurant aufgemacht, das wegen seines extravaganten Interieurs und seiner köstlichen Ceviches bereits jetzt in aller Munde ist.“"
                                            },
                                            {
                                                "example_id": "3482c1c1-4ded-47b4-9952-fc7484659806",
                                                "sense_id": "606cb357-3e84-3807-b45f-8fe32bd1b1de",
                                                "text": "„Das Ceviche mit Salz und Pfeffer würzen, in den gesäuberten Muschelschalen anrichten und servieren.“"
                                            },
                                            {
                                                "example_id": "6f6737a9-1320-4726-a8fb-33f2bd1e1e50",
                                                "sense_id": "606cb357-3e84-3807-b45f-8fe32bd1b1de",
                                                "text": "„Die aus Peru stammende Ceviche ist ein Renner in der internationalen Fischküche geworden!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
