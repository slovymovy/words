                "senses": [
                    {
                        "sense_id": "754d8a5d-a76f-3712-871a-26f1060632a5",
                        "entry_id": "4e47bf45-9363-352a-b4f0-c4d463cd5103",
                        "glosses": [
                            "A weight consisting of a cast iron ball with a single handle for gripping the weight during exercise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e5a871b-1f88-4c1c-babc-d67fc00284b5",
                                "sense_id": "754d8a5d-a76f-3712-871a-26f1060632a5",
                                "text": "Also called kettlebell sport, this is a Russian national sport in which the girya (kettlebell) is used either in single or double form to accumulate as many repetitions as possible in 10 minutes in order to compare one lifter with the next in a sporting framework."
                            },
                            {
                                "example_id": "17e9fab5-6d4d-48a4-a340-293003bbe03f",
                                "sense_id": "754d8a5d-a76f-3712-871a-26f1060632a5",
                                "text": "The rows of kettlebells, spotted with various colors of spray paint, fit in with the spartan surroundings. The kettlebell is intimidating in its simplicity: a ball with a handle, like a Biblical weapon or a giant bull’s testicle."
                            }
                        ]
                    }
                ],
                "translations": [
