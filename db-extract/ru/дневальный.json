                        "glosses": [
                            "воен. лицо суточного наряда, назначаемое из числа солдат (матросов) или сержантов в помощь дежурному для поддержания порядка и чистоты, для охраны оружия и имущества в подразделении, медицинском пункте, парке и т. п."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
