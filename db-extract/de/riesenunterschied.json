                            {
                                "example_id": "ae1e9a66-1d6c-48fb-a0c8-6e816715681a",
                                "sense_id": "be9ee1f8-7dcd-36c8-91b8-1567eb32a222",
                                "text": "„›Das macht einen Riesenunterschied.‹“"
                            },
                            {
                                "example_id": "0b8d8404-b68f-4f36-8eb3-4f66631e5047",
                                "sense_id": "be9ee1f8-7dcd-36c8-91b8-1567eb32a222",
                                "text": "„Es sind schrille und einhämmernde Stimmen, die mitunter von anderen Stimmen zum Schweigen gebracht werden, die sich anmaßend erheben und behaupten, Alkohol tue zwar nicht gut, aber nur, wenn man es übertreibt, wenn der Bierkrug vom Samstagabend zur Gewohnheit wird, und es gebe einen Riesenunterschied zum Kokain.“"
                            }
                        ],
