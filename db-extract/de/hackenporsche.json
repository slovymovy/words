                ],
                "senses": [
                    {
                        "sense_id": "0764e602-790f-397a-849b-168a0f3776a6",
                        "entry_id": "2b0132b9-39cc-3936-99af-67b231ed21aa",
                        "glosses": [
                            "zweirädriger Einkaufswagen, der an einem meist ausziehbaren Griff gezogen wird und meist dazu dient, Einkäufe vom Markt oder Supermarkt nach Hause zu transportieren"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "3834ed07-3a09-4302-a5aa-0fbb49a26c1a",
                                "sense_id": "0764e602-790f-397a-849b-168a0f3776a6",
                                "text": "„Könnten Sie bitte ihren Hackenporsche beiseitenehmen, dann kann ich mit meinem Einkaufswagen weiterfahren. Vielen Dank.“"
                            },
                            {
                                "example_id": "43a75870-7c81-49d6-ba36-f2534c227acb",
                                "sense_id": "0764e602-790f-397a-849b-168a0f3776a6",
                                "text": "Rentner besorgen sich gerne einen Hackenporsche zum Einkaufen."
                            },
                            {
                                "example_id": "0cf59801-0864-4715-b634-d6b1b2d35bcd",
                                "sense_id": "0764e602-790f-397a-849b-168a0f3776a6",
                                "text": "Vor ein paar Jahren habe ich mir einen sogenannten Hackenporsche zugelegt […]. Ein super Teil, denn egal wie viele Flaschen, Dosen oder sonstige schweren Lebensmittel ich auch einkaufe, ich ziehe den Hackenporsche hinter mir her und er hat ganz viel Stauraum. Es war ein schöner Sommertag und ich mache mich mit dem Hackenporsche auf den Weg, um einkaufen zu gehen. […]"
                            },
                            {
                                "example_id": "7ea509ba-9aa1-473c-9f10-b967456985af",
                                "sense_id": "0764e602-790f-397a-849b-168a0f3776a6",
                                "text": "Als ich vor meiner Haustür ankomme, steht davor eine ältere Frau mit einem Hackenporsche. So nannte meine Oma die Einkaufstaschen auf Rollen. Sie selbst wollte nie einen haben, war immer zu stolz dazu."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84191080-ec82-43ad-b05f-2c12e25c4001",
                        "source_entry_id": "2b0132b9-39cc-3936-99af-67b231ed21aa",
                        "source_sense_id": "0764e602-790f-397a-849b-168a0f3776a6",
                        "source_sense_description": "zweirädriger Einkaufswagen, der an einem meist ausziehbaren Griff gezogen wird",
                        "target_lang_word": "shopping trolley",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shopping trolley",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5dbaa5fb-c280-3f46-a639-7f7fff1315ea",
                                        "entry_id": "947bb625-3b92-358c-a77f-cc6d619af733",
                                        "glosses": [
                                            "A shopping cart."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7cd7f2f-ba17-45e4-a5e3-3748d22aee28",
                                                "sense_id": "5dbaa5fb-c280-3f46-a639-7f7fff1315ea",
                                                "text": "2007, Scott Moeller, Chris Brady, Intelligent M&A: Navigating the Mergers and Acquisitions Minefield, John Wiley, UK, 2011, unnumbered page,\nAs Wal-Mart builds up its knowledge of what goes into your shopping trolley, it can aid the positioning of goods as well as the pricing of complementary goods."
                                            },
                                            {
                                                "example_id": "6b1ba89b-6be5-4021-999b-688537b43bf3",
                                                "sense_id": "5dbaa5fb-c280-3f46-a639-7f7fff1315ea",
                                                "text": "Children are often placed in shopping trolleys; in the designated seats as well as in the trolley itself.\nA fall from a shopping trolley is a regular occurrence, possibly due to diminished attention of the parents while shopping."
                                            },
                                            {
                                                "example_id": "3aee7e03-1647-4e3c-8c7b-3f68b9d58cb8",
                                                "sense_id": "5dbaa5fb-c280-3f46-a639-7f7fff1315ea",
                                                "text": "Which payment system and shopping trolley software is right for you?[…]When you go to the supermarket or other retail outlet, you pick goodies off the shelves and put them in a shopping trolley."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
