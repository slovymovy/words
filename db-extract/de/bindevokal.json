                ],
                "senses": [
                    {
                        "sense_id": "baf08923-4be4-37a2-803f-6b60c7bf4fab",
                        "entry_id": "67b9df32-1989-33fa-9f94-965573729cfc",
                        "glosses": [
                            "anderer Ausdruck für Fugenelement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9eec24e-6830-4309-83b5-78510c926d99",
                                "sense_id": "baf08923-4be4-37a2-803f-6b60c7bf4fab",
                                "text": "In dem Begriff \"Bindevokal\" kommt als Fugenelement ein Bindevokal \"-e-\" vor: \"Bind-e-vokal\"."
                            },
                            {
                                "example_id": "ab98dc3a-78a3-4445-8773-02fd0af83441",
                                "sense_id": "baf08923-4be4-37a2-803f-6b60c7bf4fab",
                                "text": "„Ein Unterschied besteht nur in bezug auf die Verwendung des Bindevokals -e-, etwa in Lesebuch gegen Strickzeug usw.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7514cbf8-f2a7-3f74-966d-d41c64cb9ba7",
                        "entry_id": "67b9df32-1989-33fa-9f94-965573729cfc",
                        "glosses": [
                            "anderer Ausdruck für Kennlaut, Stammvokal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cccc0f49-8dba-4b8c-a707-5fde5db068ba",
                                "sense_id": "7514cbf8-f2a7-3f74-966d-d41c64cb9ba7",
                                "text": "Das althochdeutsche Wort \"tag\" (= der \"Tag\") gehört zur a-Deklination, da sein Bindevokal (= Kennlaut) im Germanischen ein [a] war, das im Althochdeutschen noch in der Endung von Nominativ und Akkusativ Plural in der Form \"taga\" (= die Tage) erhalten ist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e8a1c309-07bf-3729-9135-af50e9306e26",
                        "entry_id": "67b9df32-1989-33fa-9f94-965573729cfc",
                        "glosses": [
                            "anderer Ausdruck für Themavokal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f67c1cf2-0e60-4aa1-812e-175917f0d54c",
                                "sense_id": "e8a1c309-07bf-3729-9135-af50e9306e26",
                                "text": "Ein Bindevokal ist ein vokalisches Element, das an Verbwurzeln antritt und so den Wortstamm bildet. In dem indogermanischen Wort \"bher-e-ti\" (er trägt) ist \"-e-\" als Bindevokal an die Wurzel gehängt; die Flexionsendung wird erst an den durch Bindevokal erweiterten Stamm angehängt."
                            },
                            {
                                "example_id": "40c819a4-82f5-400b-93f0-ebf099b8f67c",
                                "sense_id": "e8a1c309-07bf-3729-9135-af50e9306e26",
                                "text": "„Der Typus mit germanischem Bindevokal ist durch lautgesetzliche Entwicklung und durch analogische Vorgänge aufgespalten.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
