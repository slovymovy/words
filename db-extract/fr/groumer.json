                        "examples": [
                            {
                                "example_id": "c5b5b989-9163-4227-9719-ccb2a16438b6",
                                "sense_id": "f11fbbb3-8768-3bbf-bb3e-3aa809c2f90a",
                                "text": "[…], la coque gémit, grinça, affirmant tout en groumant qu’elle était solide et saurait résister."
                            },
                            {
                                "example_id": "214401c6-6574-4412-a492-6d7f5ea34059",
                                "sense_id": "f11fbbb3-8768-3bbf-bb3e-3aa809c2f90a",
                                "text": "Je l’entendais déboucler sa lourde, le Théo, en groumant, à ce qu’il me semblait."
                            },
                            {
                                "example_id": "c97622b7-09bd-488f-a24e-c84ca4193848",
                                "sense_id": "f11fbbb3-8768-3bbf-bb3e-3aa809c2f90a",
                                "text": "Il groumait, cousin Pierre."
                            }
                        ]
