                        "glosses": [
                            "iemand die een gevecht niet uit de weg gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e3f345a-5e51-4b1d-8930-69e14f9df223",
                                "sense_id": "7a596aba-7532-3806-9b7c-b1b056ffb9f5",
