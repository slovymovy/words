                        "glosses": [
                            "Partisan de la doctrine et politique de Kemal Atatürk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b79fc17-0a6c-4e63-b40f-75dd35504499",
                                "sense_id": "4ee49b14-b7bf-324c-a8af-db4a9b70c985",
                                "text": "Cette synthèse tient du miracle avec des ataturkistes qui côtoient des militants d’extrême-gauche."
                            },
                            {
                                "example_id": "9b2c926b-0803-447e-a3d2-1e5541d25c73",
                                "sense_id": "4ee49b14-b7bf-324c-a8af-db4a9b70c985",
                                "text": "Il est reproché à M. Halil Ibrahim Celik, membre du Parti de la prospérité (islamiste) réélu en mars dernier, d’avoir déclaré à la presse qu’il n’était « ni ataturkiste, ni laique mais musulman »."
                            }
                        ]
                    }
