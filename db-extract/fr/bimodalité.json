                        "glosses": [
                            "Fait d’associer deux modes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f8aa1b6-69ff-4b24-a02d-fcc4e6f3c23a",
                                "sense_id": "306f53a6-8454-3262-b1fe-fce99b931584",
                                "text": "La bimodalité (majeur - mineur), mais aussi la bipolarité (ré et fa#) sont bien entendu l’enjeu de cette pièce. Elles sont au centre du projet compositionnel et ce, dès le début du texte."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cb89022-86dc-3a0f-847c-9c1f2bb5b536",
                        "entry_id": "5e87903c-1578-38f2-adba-2f45b32d0b8c",
                        "glosses": [
                            "Fait d’être bimodal (en parlant d’une distribution)."
                        ],
                        "tags": [
                            "Probabilités"
                        ],
                        "examples": [
                            {
                                "example_id": "643fd5ab-f850-4016-843e-3594067f1e8b",
                                "sense_id": "9cb89022-86dc-3a0f-847c-9c1f2bb5b536",
                                "text": "La bimodalité d’une distribution dans un échantillon est souvent une indication forte du fait que la distribution de la variable dans la population n’est pas normale."
                            }
                        ]
                    }
                ],
