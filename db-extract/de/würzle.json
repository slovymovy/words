                "senses": [
                    {
                        "sense_id": "7b8169ec-e7be-3480-b06a-0a9616877fa2",
                        "entry_id": "6bf4cd6b-aab2-390f-b373-5f10b4093ee4",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1997cc9-f093-4813-8386-166cbcba0a9e",
                                "sense_id": "7b8169ec-e7be-3480-b06a-0a9616877fa2",
                                "text": "Frau Würzle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "64ae1db6-697a-43aa-811a-3baa9684e468",
                                "sense_id": "7b8169ec-e7be-3480-b06a-0a9616877fa2",
                                "text": "Herr Würzle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4b62b2f9-e626-4937-af73-48dd9706d7e8",
                                "sense_id": "7b8169ec-e7be-3480-b06a-0a9616877fa2",
                                "text": "Die Würzles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "dc341732-80af-4d47-9d4d-a372b5231791",
                                "sense_id": "7b8169ec-e7be-3480-b06a-0a9616877fa2",
                                "text": "Der Würzle trägt nie die Pullover, die die Würzle ihm strickt."
                            },
                            {
                                "example_id": "665b2e84-8ef9-434a-92a3-624c4b315855",
                                "sense_id": "7b8169ec-e7be-3480-b06a-0a9616877fa2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Würzle kommt, geht der Herr Würzle.“"
                            },
                            {
                                "example_id": "af6ee1a5-7b0a-467d-90f8-9854fdf0de18",
                                "sense_id": "7b8169ec-e7be-3480-b06a-0a9616877fa2",
                                "text": "Würzle kommt und geht."
                            },
                            {
                                "example_id": "8724bfb1-6e73-4f5f-81e8-282e716fde3e",
                                "sense_id": "7b8169ec-e7be-3480-b06a-0a9616877fa2",
                                "text": "Würzles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
