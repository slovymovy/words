                ],
                "senses": [
                    {
                        "sense_id": "966b1953-5eef-3f89-9da4-c014bd58bc19",
                        "entry_id": "04a1ad99-a6e1-34ce-84be-6c3dce364b66",
                        "glosses": [
                            "iemand met wie men wedijvert voor het bereiken van een bepaald doel"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "5872aa0a-d575-4df9-899a-3b0d2c7544f6",
                                "sense_id": "966b1953-5eef-3f89-9da4-c014bd58bc19",
                                "text": "Van oudsher zijn de voetbalclubs elkaars grote rivalen."
                            },
                            {
                                "example_id": "7239f4a6-a1b5-4fe4-89d3-0ca24170c7fd",
                                "sense_id": "966b1953-5eef-3f89-9da4-c014bd58bc19",
                                "text": "Gevaarlijke rivalen voor Waylon. Niet dat deze windkracht 8-ballade nou zo verheffend is, maar Roemenië overleefde alle halve finales waaraan het ooit deelnam. Tactisch verdeelde stemkracht waarschijnlijk, die zelfs een act vol gemaskerde etalagepoppen naar de eindstrijd helpt."
                            },
                            {
                                "example_id": "8047673d-525a-4082-abb6-14af61eb9446",
                                "sense_id": "966b1953-5eef-3f89-9da4-c014bd58bc19",
                                "text": "Nu Erdogans belangrijkste rivaal achter de tralies is gezet, helt het land echter gevaarlijk over naar autocratie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0462f51d-9f8d-4902-acbc-ecae45858844",
                        "source_entry_id": "04a1ad99-a6e1-34ce-84be-6c3dce364b66",
                        "source_sense_id": "966b1953-5eef-3f89-9da4-c014bd58bc19",
                        "source_sense_description": "iemand met wie men wedijvert voor het bereiken van een bepaald doel",
                        "target_lang_word": "rival",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rival",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1835233-f27e-3df1-a008-9c4202e34b8e",
                                        "entry_id": "e2f18c84-d4ae-3ca9-96a3-855435e1ec2b",
                                        "glosses": [
                                            "A competitor (person, team, company, etc.) with the same goal as another, or striving to attain the same thing. Defeating a rival may be a primary or necessary goal of a competitor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4415a4d4-cdd2-4371-aa26-7e36bb3f9943",
                                                "sense_id": "a1835233-f27e-3df1-a008-9c4202e34b8e",
                                                "text": "Chris is my biggest rival in the 400-metre race."
                                            },
                                            {
                                                "example_id": "0ed25a17-784c-4afe-9922-f03ec124ed18",
                                                "sense_id": "a1835233-f27e-3df1-a008-9c4202e34b8e",
                                                "text": "Every day is like survival / You're my lover, not my rival"
                                            },
                                            {
                                                "example_id": "ec3eed7d-c5ea-4dc2-b9ac-9a426db7a44a",
                                                "sense_id": "a1835233-f27e-3df1-a008-9c4202e34b8e",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about […], or offering services that let you[…] \"share the things you love with the world\" and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "694c054a-2854-3bb9-b1c3-16535fc745dd",
                                        "entry_id": "e2f18c84-d4ae-3ca9-96a3-855435e1ec2b",
                                        "glosses": [
                                            "Someone or something with similar claims of quality or distinction as another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e9047ae-4d80-4894-8398-36ac95d7eb6d",
                                                "sense_id": "694c054a-2854-3bb9-b1c3-16535fc745dd",
                                                "text": "As a social historian, he has no rival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a997d8a4-04c2-348a-a6c7-798f848d4f05",
                                        "entry_id": "e2f18c84-d4ae-3ca9-96a3-855435e1ec2b",
                                        "glosses": [
                                            "One having a common right or privilege with another; a partner."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1d0bd42-04b8-441c-ab05-75419d76d0d0",
                                                "sense_id": "a997d8a4-04c2-348a-a6c7-798f848d4f05",
                                                "text": "If you do meet Horatio and Marcellus, / The rivals of my watch, bid them make haste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rival",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9518145d-37fd-319e-bdfc-8bfde5a67ef7",
                                        "entry_id": "cbc9dc63-4a4e-38fb-8e2b-4246f15ca80f",
                                        "glosses": [
                                            "Having the same pretensions or claims; standing in competition for superiority."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55eed860-976d-455d-b83b-11620784a127",
                                                "sense_id": "9518145d-37fd-319e-bdfc-8bfde5a67ef7",
                                                "text": "rival lovers"
                                            },
                                            {
                                                "example_id": "83fcb4c1-c1a8-464e-8d0c-c24a9fba45ee",
                                                "sense_id": "9518145d-37fd-319e-bdfc-8bfde5a67ef7",
                                                "text": "rival claims or pretensions"
                                            },
                                            {
                                                "example_id": "d1d745ed-8400-46d9-b822-c3f13d0c7e91",
                                                "sense_id": "9518145d-37fd-319e-bdfc-8bfde5a67ef7",
                                                "text": "The strenuous conflicts and alternate victories of two rival confederacies of statesmen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rival",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43f62a0f-f419-3753-9535-31929c2d3253",
                                        "entry_id": "bd9292f0-fcd3-3f69-a461-4982d2206f55",
                                        "glosses": [
                                            "To oppose or compete with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faacb704-391a-4241-9460-3ef1425f20cf",
                                                "sense_id": "43f62a0f-f419-3753-9535-31929c2d3253",
                                                "text": "to rival somebody in love"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bf60591-0198-3db0-9fe9-7f2f3d4aee0a",
                                        "entry_id": "bd9292f0-fcd3-3f69-a461-4982d2206f55",
                                        "glosses": [
                                            "To be equal to, or match, or to surpass another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71306051-38e5-4824-9888-fc90289e3b98",
                                                "sense_id": "3bf60591-0198-3db0-9fe9-7f2f3d4aee0a",
                                                "text": "But the Waverley is still the best-placed station of any British city, and gives the arriving stranger a first impression rivalled in Europe only by the exclusively watery station approach at Venice."
                                            },
                                            {
                                                "example_id": "66d42cce-153a-4f85-85a4-a478399a989c",
                                                "sense_id": "3bf60591-0198-3db0-9fe9-7f2f3d4aee0a",
                                                "text": "The original family who had begun to build a palace to rival Nonesuch had died out before they had put up little more than the gateway, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53a9eed2-52a5-3a69-bcf5-842e1b608095",
                                        "entry_id": "bd9292f0-fcd3-3f69-a461-4982d2206f55",
                                        "glosses": [
                                            "To strive to equal or excel; to emulate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0856a70f-953c-4248-b100-9e78ba9fcfbc",
                                                "sense_id": "53a9eed2-52a5-3a69-bcf5-842e1b608095",
                                                "text": "to rival thunder in its rapid course"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
