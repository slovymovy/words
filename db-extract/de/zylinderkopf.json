                    },
                    {
                        "translation_id": "de372558-9d9e-4101-9916-b24748b66e3f",
                        "source_entry_id": "0e32d61f-b34a-33ff-8f62-b7522230329a",
                        "source_sense_id": "b3b0138f-211c-31d4-9871-8cd3dd94c0b1",
                        "source_sense_description": "Technik: oberster Teil eines Hohlkörpers, in dem sich ein Kolben bewegt (eines Zylinders)",
                        "target_lang_word": "culasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "culasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd8aec79-c8d4-340c-86d4-9f4a9b22a215",
                                        "entry_id": "b1931646-ba21-3a4f-ab87-dbdf45c2fc31",
                                        "glosses": [
                                            "Partie de derrière d’une arme à feu, canon, fusil, revolver, etc."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da6bbdc5-da37-4f55-8e74-8b609fb9cc43",
                                                "sense_id": "dd8aec79-c8d4-340c-86d4-9f4a9b22a215",
                                                "text": "Cette arme était une longue et lourde carabine qui avait sans doute appartenu à quelque contrebandier ; à l’épaisseur de la crosse et à la culasse puissante du canon, on reconnaissait un ancien fusil à pierre qu’un armurier du pays avait transformé en fusil à piston."
                                            },
                                            {
                                                "example_id": "7f819683-26b7-42ec-be93-964b8891cf46",
                                                "sense_id": "dd8aec79-c8d4-340c-86d4-9f4a9b22a215",
                                                "text": "Tous ceux qui n’avaient pas de bidons, de troisième cartouchière, de vis de culasse, en découvrent soudain un choix près d’eux […]."
                                            },
                                            {
                                                "example_id": "4d7a0589-6268-46de-9cb2-695048a65fdd",
                                                "sense_id": "dd8aec79-c8d4-340c-86d4-9f4a9b22a215",
                                                "text": "Je tapai deux fois violemment sur la culasse avec la paume de ma main pour montrer que l’arme était bien réelle et que c’était bibi qui la tenait."
                                            },
                                            {
                                                "example_id": "e7431d9a-fc29-4c0e-9072-0e21122c40d8",
                                                "sense_id": "dd8aec79-c8d4-340c-86d4-9f4a9b22a215",
                                                "text": "M. Besseghir avait été dénoncé par Marcel Le Hir, qui avait affirmé à la police avoir remarqué, près d’une voiture dans un parking de l’aéroport Roissy-Charles de Gaulle, un homme manipulant la culasse d’une arme."
                                            },
                                            {
                                                "example_id": "3fd5cfc4-b432-4092-97e7-dd528fc9aa4d",
                                                "sense_id": "dd8aec79-c8d4-340c-86d4-9f4a9b22a215",
                                                "text": "Le capitaine badin jusqu’au bout de sa badine passa son doigt ganté de chevreau blanc sur la culasse luisante de graisse de son pistolet-mitrailleur démonté et le considéra souillé en demandant d’un ton où l’insolence le disputait à la perplexité : « C’est ça que vous appelez un pistolet-mitrailleur propre ? »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d82e98c-7523-3a5f-a4a9-1fe3d6f1dc21",
                                        "entry_id": "b1931646-ba21-3a4f-ab87-dbdf45c2fc31",
                                        "glosses": [
                                            "Partie arrière d’une pièce de métal."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d14d64a-2de6-4679-801b-0db94266198b",
                                                "sense_id": "2d82e98c-7523-3a5f-a4a9-1fe3d6f1dc21",
                                                "text": "La culasse d’un cylindre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bacfb732-521c-3d78-9924-6a2649456087",
                                        "entry_id": "b1931646-ba21-3a4f-ab87-dbdf45c2fc31",
                                        "glosses": [
                                            "Partie de la racine d’un arbre qui vient après le collet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe834485-e1f2-3c9f-b0ab-2baf5c23062f",
                                        "entry_id": "b1931646-ba21-3a4f-ab87-dbdf45c2fc31",
                                        "glosses": [
                                            "Dessous d’un brillant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9f993ea-c571-44e4-b335-b1e7058ea11f",
                                                "sense_id": "fe834485-e1f2-3c9f-b0ab-2baf5c23062f",
                                                "text": "[…] une ingénieuse pendulette de table avec réveil à culasse en pierre, qui date de 1770."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64491165-7ef7-3e42-aee8-f2fa1584aab3",
                                        "entry_id": "b1931646-ba21-3a4f-ab87-dbdf45c2fc31",
                                        "glosses": [
                                            "Partie amovible d'un moteur assurant l'étanchéité d'un ou plusieurs de ses cylindres."
                                        ],
