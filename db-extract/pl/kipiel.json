                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bfbcbcd-12be-47c3-a8a7-49ad979fd29b",
                        "source_entry_id": "64728a3a-d701-354f-ab88-1fcb703d1b90",
                        "source_sense_id": "ffae0eeb-fa82-34fc-b425-886e9bd24e4c",
                        "target_lang_word": "Brandung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brandung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a2876d3-deb0-33c5-a944-5e9b313768c2",
                                        "entry_id": "7e586e5e-7c5d-32dc-afda-7f0d5c8cedf7",
                                        "glosses": [
                                            "zusammenschlagende Wellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2b2e02c-f7ed-402d-86ae-8f3eb75c972f",
                                                "sense_id": "3a2876d3-deb0-33c5-a944-5e9b313768c2",
                                                "text": "Das Baden in der Brandung ist heute herrlich."
                                            },
                                            {
                                                "example_id": "34031cad-8607-463e-a1ab-d20a7d6f9852",
                                                "sense_id": "3a2876d3-deb0-33c5-a944-5e9b313768c2",
                                                "text": "Du kannst heute nicht surfen gehen, die Brandung ist viel zu stark!"
                                            },
                                            {
                                                "example_id": "8a33234d-8dcc-4cea-a803-3dc893d372bd",
                                                "sense_id": "3a2876d3-deb0-33c5-a944-5e9b313768c2",
                                                "text": "„Die Brandung rauschte.“"
                                            },
                                            {
                                                "example_id": "7e89247b-8b26-43f7-b4e2-5d7219463eeb",
                                                "sense_id": "3a2876d3-deb0-33c5-a944-5e9b313768c2",
                                                "text": "„Doch Obock stellte sich bald als schlechte Wahl heraus, denn trotz der Korallenriffe, die den Hafen umgeben, war dieser schlecht gegen die schwere Brandung gesichert, die der Indische Ozean bei Unwettern in den Golf von Aden schiebt.“"
                                            },
                                            {
                                                "example_id": "f51c008d-a144-4049-98c8-aec68a19b674",
                                                "sense_id": "3a2876d3-deb0-33c5-a944-5e9b313768c2",
                                                "text": "„Beim dritten Versuch kam das Boot durch die Brandung, und es gelang uns, das Schiff zu erreichen.“"
                                            },
                                            {
                                                "example_id": "565f24c3-fb32-44d6-8f50-1d5efeb630db",
                                                "sense_id": "3a2876d3-deb0-33c5-a944-5e9b313768c2",
                                                "text": "„Jeder Laut, der von dort hätte herkommen können, wurde übertönt vom Wind und vom Lärm der Wellen, die sich in der Brandung überschlugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
