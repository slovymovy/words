                        "entry_id": "f8ba5b9d-335f-346e-a858-3c7a74d6ea1c",
                        "glosses": [
                            "weibliches Mitglied einer Mannschaft, das im Bedarfsfall bei einem Spiel erst zu einem späteren Zeitpunkt eingesetzt wird"
                        ],
                        "tags": [
                            "Mannschaftssport"
                        ],
                        "examples": [
