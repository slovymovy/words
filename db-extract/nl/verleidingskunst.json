                            {
                                "example_id": "e81dec62-0ba2-4f43-a0f9-d502f2a94230",
                                "sense_id": "f2333dd3-44e9-3f29-b00f-c179c4248c77",
                                "text": "In plaats daarvan zet Addie ook haar glas aan zijn begerige mond, giet de roestrode inhoud tussen zijn lippen en probeert het gebaar te laten doorgaan voor verleidingskunst in plaats van dwang."
                            },
                            {
                                "example_id": "d9bf2b7d-4414-4cf3-8efa-63aa783d91a7",
                                "sense_id": "f2333dd3-44e9-3f29-b00f-c179c4248c77",
                                "text": "Toen kwam het hem voor alsof de drie standbeelden hun verleidingskunsten richtten op eenzelfde man, en die man was hij."
                            }
                        ]
                    }
