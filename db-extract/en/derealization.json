                                        "entry_id": "bb383851-6c96-3a18-9d2f-ba2001de9092",
                                        "glosses": [
                                            "zaburzenie psychiczne polegające na poczuciu obcości świata zewnętrznego i odbieraniu go jako zmienionego lub nierzeczywistego"
                                        ],
                                        "tags": [
                                            "psychology"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb083915-b005-443b-a6cb-27a074982595",
                                                "sense_id": "57502a3b-b671-3527-b0be-5c9e3e1ca740",
                                                "text": "Powiedział, że jedną z reakcji na stres jest niewiara w prawdziwość wydarzeń, derealizacja"
                                            },
                                            {
                                                "example_id": "391845a1-55c7-400c-8023-4cb39fea44f8",
                                                "sense_id": "57502a3b-b671-3527-b0be-5c9e3e1ca740",
                                                "text": "Psychiatria współczesna zna dwa — ściśle ze sobą złączone — typy zaburzeń psychicznych: depersonalizację i derealizację"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3baf9a2-8710-4662-aa3b-e51f2b4e2c98",
                        "source_entry_id": "c0f6ac80-faaa-3d48-a64d-d3ff2abdb709",
