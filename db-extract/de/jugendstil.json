                        ]
                    },
                    {
                        "translation_id": "26e3a584-856f-4e60-aa31-72df49dae476",
                        "source_entry_id": "e73c6ec6-e6ed-3ea0-bac1-3990214c5686",
                        "source_sense_id": "e93054c3-bb9b-32ca-ad29-fe4b97b9f0d1",
                        "target_lang_word": "Art nouveau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Art nouveau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f84af43-7f6b-3257-a152-ae8a6517b28c",
                                        "entry_id": "925a9b1d-7e43-3e49-a315-0ea770e1338b",
                                        "glosses": [
                                            "Mouvement artistique de la fin du xixᵉ et du début du xxᵉ siècle, concernant la peinture, l’architecture et les arts décoratifs, caractérisé par l’esthétique des lignes courbes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "730d4624-af7f-4df8-bd50-296f085c3fbf",
                                                "sense_id": "0f84af43-7f6b-3257-a152-ae8a6517b28c",
                                                "text": "[…] ; nous étions partout la troupe de choc et l’avant-garde de l’Art nouveau sous toutes ses formes, simplement parce qu’il voulait changer le monde pour nous, dont c’était enfin le tour de vivre notre vie. Car, nous le sentions, nostra res agitur. Mais autre chose encore nous intéressait et nous fascinait démesurément dans l’Art nouveau : c’était un art quasi exclusivement fait par des gens jeunes."
                                            },
                                            {
                                                "example_id": "25692925-eb50-4c48-8b8b-90e2198d00b9",
                                                "sense_id": "0f84af43-7f6b-3257-a152-ae8a6517b28c",
                                                "text": "Un escalier en fer à cheval qui mène à une terrasse ouverte sur un immense salon Art nouveau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
