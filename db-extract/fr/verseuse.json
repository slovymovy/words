                        "entry_id": "22f66d52-233a-3726-8fc9-3e120e068205",
                        "glosses": [
                            "Celle qui verse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e26bf7d-ba91-4c68-a2ec-9adff4507087",
                                "sense_id": "64a4007c-18ec-3d5f-93d8-865deaebf7e0",
                                "text": "La verseuse s’installe à la table du client qu’elle vient de servir, boit en sa compagnie, et s’efforce de le faire consommer."
                            }
                        ]
                    },
                    {
                        "sense_id": "4818a3e9-0e2a-39cb-857a-f7c74744c59b",
                        "entry_id": "22f66d52-233a-3726-8fc9-3e120e068205",
                        "glosses": [
                            "Récipient muni d’un bec verseur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c48183a1-bf3e-4482-a7d6-f7020c74e427",
                                "sense_id": "4818a3e9-0e2a-39cb-857a-f7c74744c59b",
                                "text": "Elle prit en la secouant une cafetière sur le coin du feu, remplit une verseuse de café, attrapa un sucrier couvert de mouches qui traînait sur la table."
                            },
                            {
                                "example_id": "9cc1627c-305e-4e01-91a3-582bd12f2564",
                                "sense_id": "4818a3e9-0e2a-39cb-857a-f7c74744c59b",
                                "text": "La verseuse de Fironi est une pièce d’orfèvrerie massive, dont le bec a la forme d’une sirène."
                            }
                        ]
                    },
                    {
                        "sense_id": "c55fd1da-0326-36cc-a77c-3d3b62908dd1",
                        "entry_id": "22f66d52-233a-3726-8fc9-3e120e068205",
                        "glosses": [
                            "Récipient en verre pyrex destiné à recevoir le café qui coule d’une cafetière électrique."
