{
    "word_family": [
        "distortion",
        "distorted",
        "distortive",
        "distorter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f96c3a97-1b62-3c2e-976f-6facb9861ced",
                    "sense_definition": "To give a false or misleading account of something or to pervert the truth.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "misrepresentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In their articles, journalists sometimes <w>distort</w> the truth to make a story more sensational.",
                            "target_lang_translations": {
                                "ru": "В своих статьях журналисты иногда <w>искажают</w> правду, чтобы сделать историю более сенсационной."
                            }
                        },
                        {
                            "text": "It is unfair to <w>distort</w> the facts just to win a political argument during the debate.",
                            "target_lang_translations": {
                                "ru": "Несправедливо <w>искажать</w> факты только ради победы в политическом споре во время дебатов."
                            }
                        }
                    ],
                    "antonyms": [
                        "clarify",
                        "represent"
                    ],
                    "common_phrases": [
                        "distort the truth",
                        "distort the facts",
                        "distort the meaning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представлять информацию в ложном или неверном виде, искажать истину."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искажать",
                                "target_lang_sense_clarification": "представлять в неправильном виде"
                            },
                            {
                                "target_lang_word": "извращать",
                                "target_lang_sense_clarification": "ложно истолковывать факты или смысл"
                            },
                            {
                                "target_lang_word": "перевирать",
                                "target_lang_sense_clarification": "намеренно искажать слова или факты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8aac84a-447f-3eb3-acf8-c3865eb1e5b2",
                    "sense_definition": "To pull or twist out of shape; to make something misshapen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heat from the fire began to <w>distort</w> the plastic frame of the television.",
                            "target_lang_translations": {
                                "ru": "Жар от огня начал <w>деформировать</w> пластиковый корпус телевизора."
                            }
                        },
                        {
                            "text": "Heavy usage can <w>distort</w> the image on an old computer monitor over time.",
                            "target_lang_translations": {
                                "ru": "При интенсивном использовании изображение на старом компьютерном мониторе со временем может <w>искажаться</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "deform"
                    ],
                    "antonyms": [
                        "straighten"
                    ],
                    "common_phrases": [
                        "distort the image",
                        "distort the shape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять физическую форму чего-либо, делая её неестественной или неправильной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искажать",
                                "target_lang_sense_clarification": "менять форму или изображение"
                            },
                            {
                                "target_lang_word": "деформировать",
                                "target_lang_sense_clarification": "изменять физическую структуру"
                            },
                            {
                                "target_lang_word": "искривлять",
                                "target_lang_sense_clarification": "делать кривым или изогнутым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d23c717f-1311-3599-a528-1ab2e25c8d8a",
                    "sense_definition": "To become misshapen or twisted out of its natural state.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The metal beams may <w>distort</w> under the extreme pressure of the collapsing roof.",
                            "target_lang_translations": {
                                "ru": "Металлические балки могут <w>деформироваться</w> под экстремальным давлением рушащейся крыши."
                            }
                        },
                        {
                            "text": "If the wood gets too wet, it will likely <w>distort</w> as it dries out in the sun.",
                            "target_lang_translations": {
                                "ru": "Если дерево слишком сильно намокнет, оно, скорее всего, <w>искривится</w>, когда высохнет на солнце."
                            }
                        }
                    ],
                    "synonyms": [
                        "deform"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать неправильную форму или искривляться под воздействием внешних факторов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деформироваться",
                                "target_lang_sense_clarification": "изменять свою форму"
                            },
                            {
                                "target_lang_word": "искривляться",
                                "target_lang_sense_clarification": "становиться кривым"
                            },
                            {
                                "target_lang_word": "коробиться",
                                "target_lang_sense_clarification": "о дереве или материале при высыхании"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c285611b-db06-377a-aafd-effcb6729aef",
                    "sense_definition": "Being in a state of being <w>distorted</w> or misshapen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her face was ugly and her mouth <w>distort</w> with a look of pure agony.",
                            "target_lang_translations": {
                                "ru": "Ее лицо было некрасивым, а рот — <w>искаженным</w> выражением чистой агонии."
                            }
                        },
                        {
                            "text": "The old statue appeared <w>distort</w> after centuries of erosion by the wind.",
                            "target_lang_translations": {
                                "ru": "Старая статуя казалась <w>искаженной</w> после столетий эрозии ветром."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adjective in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в искаженном или деформированном состоянии (устаревшее использование)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искажённый",
                                "target_lang_sense_clarification": "имеющий неестественный вид"
                            },
                            {
                                "target_lang_word": "искривлённый",
                                "target_lang_sense_clarification": "потерявший правильную форму"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
