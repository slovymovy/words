                "senses": [
                    {
                        "sense_id": "ba424a6e-1b40-3f86-ac63-f322043e6ca2",
                        "entry_id": "73062a78-b47a-34d9-a7ca-1054cbad0505",
                        "glosses": [
                            "eine farbentragende, meist sehr alte Studentenverbindung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be26f867-743b-4ece-ab26-f52f395256fc",
                                "sense_id": "ba424a6e-1b40-3f86-ac63-f322043e6ca2",
                                "text": "„Die Burschenschaften entstanden nach den Befreiungskriegen gegen Napoleon.“"
                            },
                            {
                                "example_id": "80d1d8b2-4888-4978-b4c6-25a361153e5b",
                                "sense_id": "ba424a6e-1b40-3f86-ac63-f322043e6ca2",
                                "text": "„Im Gegensatz zu den Burschenschaften verfolgen die studentischen Corps keinerlei politische Ziele oder Gesinnungen.“"
                            },
                            {
                                "example_id": "4428a0f8-c8ff-4974-9254-60c1ef8c119b",
                                "sense_id": "ba424a6e-1b40-3f86-ac63-f322043e6ca2",
                                "text": "„Friedrich Nietzsche, Mitglied in der Burschenschaft »Franconia«, kam 1864 und 1865 als Student der Evangelischen Theologie und der Philosophie zum Bahnhof Rolandseck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
