                        "entry_id": "e38ee9f8-b09d-3c2d-96f4-79a9c116fa1e",
                        "glosses": [
                            "Variante de pneumatique, relatif au pneuma, le souffle vital."
                        ],
                        "tags": [
                            "Ancient",
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "227f1ee3-b1bf-42d8-8c32-655a94ea15df",
                                "sense_id": "4444e48b-fa5c-3036-b583-68584717f662",
                                "text": "L'école pneumaticienne remonte à Athénée d'Athalie, qui pratiquait la médecine à Rome, vers le commencement du premier siècle et avait admis la doctrine du pneuma."
                            }
                        ]
                    },
                    {
                        "sense_id": "97e34eb2-44e6-3678-8ca4-33859487f520",
                        "entry_id": "e38ee9f8-b09d-3c2d-96f4-79a9c116fa1e",
                        "glosses": [
                            "Relatif aux personnes ou aux entreprises fabriquant des pneus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaa09a50-e352-41f6-aad7-3cb492229311",
                                "sense_id": "97e34eb2-44e6-3678-8ca4-33859487f520",
                                "text": "Par ailleurs, si les entreprises pneumaticiennes sont pour la plupart autonomes, elles n'en subissent pas moins un sort parallèle à celui du secteur automobile."
                            }
                        ]
                    }
                ],
