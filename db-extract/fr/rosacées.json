            {
                "entry_id": "fe2d3ae5-e763-3a80-8a5b-5f84cc4b70ef",
                "word": "Rosacées",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cfe1b6de-c14e-4c78-8a71-40fd4e5e47bb",
                        "entry_id": "fe2d3ae5-e763-3a80-8a5b-5f84cc4b70ef",
