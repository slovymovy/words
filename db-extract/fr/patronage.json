                                        "glosses": [
                                            "The aid or support provided by a sponsor; backing or patronage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f86a683-314e-4c6c-8511-4a68deb4ca5b",
                                                "sense_id": "7f807815-d38c-3ab6-bbfa-bc7b368dc38b",
                                                "text": "The company provided sponsorship to the research team."
                                            },
                                            {
                                                "example_id": "f93e36da-4cb8-438c-b201-8c8ff71d633d",
                                                "sense_id": "7f807815-d38c-3ab6-bbfa-bc7b368dc38b",
                                                "text": "The university awarded five sponsorships to the five most qualified applicants."
                                            }
                                        ]
