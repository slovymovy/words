                                            {
                                                "example_id": "c9f2616f-e970-4fda-84d0-79fa0630e7b6",
                                                "sense_id": "5729d6d9-cd11-38dc-bcf9-4ffc8f4822ea",
                                                "text": "Auf der Fensterbank vertrocknen die Alpenveilchen."
                                            },
                                            {
                                                "example_id": "079f1a53-b1ed-458c-995b-b1e96d37ddb3",
                                                "sense_id": "5729d6d9-cd11-38dc-bcf9-4ffc8f4822ea",
                                                "text": "„Auf sonnenexponierten, besonders geneigten Flächen beginnen die Blätter nach drei bis vier Wochen Trockenheit vom Stengelgrund her zu vertrocknen.“"
                                            },
                                            {
                                                "example_id": "73882faf-d019-4e94-9210-1a308be4556f",
                                                "sense_id": "5729d6d9-cd11-38dc-bcf9-4ffc8f4822ea",
                                                "text": "„Und jetzt trink endlich was, ehe du noch vertrocknest!“"
                                            },
                                            {
                                                "example_id": "18ad15d6-8745-457c-8bfc-6b5ec78fa917",
                                                "sense_id": "5729d6d9-cd11-38dc-bcf9-4ffc8f4822ea",
                                                "text": "„Der Bosporus wird immer schmaler und läuft Gefahr, sich zu einem Fluß zu verengen und endlich ganz zu vertrocknen.“"
                                            },
                                            {
                                                "example_id": "945ebda8-a1fe-4551-9184-398bf5992b30",
                                                "sense_id": "5729d6d9-cd11-38dc-bcf9-4ffc8f4822ea",
                                                "text": "„Wie Heu vertrocknet ist mein Herz.“"
                                            }
                                        ],
