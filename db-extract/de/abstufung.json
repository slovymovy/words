                                        "examples": [
                                            {
                                                "example_id": "78e182d2-dae8-496f-b727-82190cc439b7",
                                                "sense_id": "61982b81-d387-3d2e-9c25-0ee3571c6b9f",
                                                "text": "A decade ago, the British department-store chain John Lewis built itself a long warehouse, painted in gradations of sky blue."
                                            }
