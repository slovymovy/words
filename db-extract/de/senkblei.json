                "senses": [
                    {
                        "sense_id": "3f4ca092-3d8e-3ff5-8e2f-c78a9d080e76",
                        "entry_id": "02937667-6e1e-37c6-9097-09b48bda16f8",
                        "glosses": [
                            "Gerät, mit dem der senkrechte Verlauf einer Kante gemessen und geprüft wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7747e2f3-7fcb-4d94-b316-3cdd98d3ef9d",
                                "sense_id": "3f4ca092-3d8e-3ff5-8e2f-c78a9d080e76",
                                "text": "„Tinius selbst kennt den Spruch für die Rückverwandlung nicht und muß ihn nicht kennen, weil er wie Senkblei auf dem fruchtbaren Grund der Geschichten ausharrt.“"
                            },
                            {
                                "example_id": "f4753b79-abb1-4430-ae82-23dff79bfedc",
                                "sense_id": "3f4ca092-3d8e-3ff5-8e2f-c78a9d080e76",
                                "text": "„In der Antike wurde als Setzwaage ein gleichschenkliges Dreieck verwendet, in das ein Lot (Senkblei) aufgehängt wurde. Das Senkblei zeigt auf die Mitte der Grundseite des Dreiecks, wenn diese in der Waage ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
