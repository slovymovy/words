                "senses": [
                    {
                        "sense_id": "5799e949-e407-3082-8572-fa59798965be",
                        "entry_id": "784f57a2-d88f-3a2e-88d7-baedde0aac0d",
                        "glosses": [
                            "Juristin, die als Rechtsanwältin zugelassen ist, aber überwiegend oder nur für ein Unternehmen, eine Bank, einen Verband oder Ähnliches im Rahmen eines Dienstvertrages tätig wird"
                        ],
                        "tags": [
                            "in Deutschland"
                        ],
                        "examples": [
                            {
                                "example_id": "7d6819c8-1429-4281-acc1-9bb344ba0bf3",
                                "sense_id": "5799e949-e407-3082-8572-fa59798965be",
                                "text": "„Es kommt hinzu, dass auch die Bezeichnung „Rechtsanwältin und Syndikusrechtsanwältin“ nicht eindeutig darauf hinweist, dass die Unterzeichnende nur in ihrer Funktion als Rechtsanwältin und nicht als Syndika tätig sein wollte.“"
                            },
                            {
                                "example_id": "cde4f757-0c24-476c-8728-4a4b94a1847d",
                                "sense_id": "5799e949-e407-3082-8572-fa59798965be",
                                "text": "„Dort trete ich dann als Arbeitgebervertreterin, als Syndika, auf und nicht als Rechtsanwältin, weshalb ich dort auch keine Robe trage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
