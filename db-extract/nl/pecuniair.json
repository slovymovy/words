                                        "entry_id": "3efd1202-509f-34b8-a8c9-de3dd2d5ad4f",
                                        "glosses": [
                                            "Of, or relating to, money; monetary, financial."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eee333f-c4c2-4a85-872f-fb58faaf4a94",
                                                "sense_id": "00a4565e-2d27-3bb1-b41c-cb24f6caf764",
                                                "text": "Perhaps the reader will suppose after this that the doctor had some pecuniary interest of his own in arranging the squire's loans; or, at any rate, he will think that the squire must have thought so."
                                            },
                                            {
                                                "example_id": "932da834-6cae-400d-ae72-112ce292d7b7",
                                                "sense_id": "00a4565e-2d27-3bb1-b41c-cb24f6caf764",
                                                "text": "The views of philosophers, with few exceptions, have coincided with the pecuniary interests of their class."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dcb5db5-a254-4da3-b157-10c7d782264a",
