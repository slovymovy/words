            {
                "entry_id": "503d502a-6d2a-3789-bcf0-0677b625004a",
                "word": "cognac",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5dd7a353-7d4e-4c49-bf3a-caec07bc6d72",
                        "entry_id": "503d502a-6d2a-3789-bcf0-0677b625004a",
                        "tags": [
                            "plural"
                        ],
                        "form": "cognacs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "225522ef-9e3d-33d5-8f07-dd1e64190cc1",
                        "entry_id": "503d502a-6d2a-3789-bcf0-0677b625004a",
                        "glosses": [
                            "A brandy distilled from white wine in the region around Cognac in France."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f49dfe20-d183-460d-942d-539c7217af0d",
                                "sense_id": "225522ef-9e3d-33d5-8f07-dd1e64190cc1",
                                "text": "Major manufacturers add a small proportion of caramel to color their cognacs."
                            },
                            {
                                "example_id": "ffb5dbbe-9b15-4e53-80d5-bd7532453288",
                                "sense_id": "225522ef-9e3d-33d5-8f07-dd1e64190cc1",
                                "text": "Cognac, with the addition of a little paprika and the yolk of an egg, is considered an effective aphrodisiac aid."
                            },
                            {
                                "example_id": "c226d187-adfe-4d32-8c3f-0213e760852f",
                                "sense_id": "225522ef-9e3d-33d5-8f07-dd1e64190cc1",
                                "text": "We’d have a script meeting for the next day’s shooting that lasted until two in the morning, and he’d be up again at six for a breakfast meeting. I survived on cognac. I have no idea how he did it."
                            },
                            {
                                "example_id": "c42fb648-2602-4afc-9645-0cb69de2cb71",
                                "sense_id": "225522ef-9e3d-33d5-8f07-dd1e64190cc1",
                                "text": "David Mason, Beverage and Bar Manager at St. Regis, describes the complex aromas and layered palate of the cognac thus: “It’s kind of autumn flavors. Really nutty, almondy – kind of fig, plum, dried fruits. But it finishes off really smoothly but with a little bit of tobacco leaf.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51427cfa-0715-4126-8217-b2fcac544370",
                        "source_entry_id": "503d502a-6d2a-3789-bcf0-0677b625004a",
                        "source_sense_id": "225522ef-9e3d-33d5-8f07-dd1e64190cc1",
                        "source_sense_description": "type of brandy",
                        "target_lang_word": "koňak",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "koňak",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "bd3577b6-4c3e-3942-83eb-206f55006661",
                                        "entry_id": "18ee2f17-2f17-345b-9afa-010d374c3a53",
                                        "glosses": [
                                            "alkoholický nápoj vyráběný destilací vína"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d52c28a-3079-4cbd-b581-b5257b73df42",
                                                "sense_id": "bd3577b6-4c3e-3942-83eb-206f55006661",
                                                "text": "O množství vypitého alkoholu [obžalovaný řidič] vypověděl, že měl několik malých piv a společně se zemřelou ženou vypili šestnáct panáků koňaku."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eff27e36-3186-4690-9973-677f5e397007",
                        "source_entry_id": "503d502a-6d2a-3789-bcf0-0677b625004a",
                        "source_sense_id": "225522ef-9e3d-33d5-8f07-dd1e64190cc1",
                        "source_sense_description": "type of brandy",
                        "target_lang_word": "cognac",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cognac",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1792fdef-5d95-342c-80b6-2d4ee11f889f",
                                        "entry_id": "2578f223-991d-3fa0-b0cf-272ef525e29d",
                                        "glosses": [
                                            "Franse brandewijn die in en rond Cognac uit wijn gestookt wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51886feb-1ef8-4fcb-bd60-21463ec0d43c",
                                                "sense_id": "1792fdef-5d95-342c-80b6-2d4ee11f889f",
                                                "text": "Achter haar ogenschijnlijke vrolijkheid, haar sigaret en haar glas cognac school een diep doorleefd besef van de existentiële tragiek."
                                            },
                                            {
                                                "example_id": "1fbf1424-8589-4b8d-949f-9d026de83f60",
                                                "sense_id": "1792fdef-5d95-342c-80b6-2d4ee11f889f",
                                                "text": "En wat kon hij daar in godsnaam op antwoorden? Ze had een grote fles cognac in huis. En wat maakte het uit, het was nog vroeg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58cafb7e-f8b4-42d7-bf5b-b3be0d629253",
                        "source_entry_id": "503d502a-6d2a-3789-bcf0-0677b625004a",
                        "source_sense_id": "225522ef-9e3d-33d5-8f07-dd1e64190cc1",
                        "source_sense_description": "type of brandy",
                        "target_lang_word": "cognac",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cognac",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                        "entry_id": "e7c415d7-6dbc-3403-b21b-cd3a105a33f4",
                                        "glosses": [
                                            "Eau-de-vie qui a son centre de production dans la région de Cognac, en France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7b45add-1698-4420-9416-b6c63938735a",
                                                "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                                "text": "Alors il chercha l’oubli tour à tour dans le cidre normand, le poiré manceau, l’hydromel gaulois, le cognac français, le genièvre hollandais, le gin anglais, le wiskey écossais, le kirsch germain."
                                            },
                                            {
                                                "example_id": "074cf231-ec1b-4345-9287-4b3316c1a8ed",
                                                "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                                "text": "Oui… reprit Jacques, un duel… au cognac… Tu prétends qu’il y a autant de danger à se mettre devant une bouteille d’eau-de-vie que devant la gueule d’un pistolet… Prenons chacun une bouteille pleine, l’on verra qui de nous deux reculera."
                                            },
                                            {
                                                "example_id": "5555307c-ce9c-4b5b-bfc1-ef6064f0f7cf",
                                                "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                                "text": "COGNAC. Très funeste. – Excellent dans plusieurs maladies. – Un bon verre de cognac ne fait jamais de mal. Pris à jeun, tue le ver de l’estomac."
                                            },
                                            {
                                                "example_id": "cc7ee09a-b348-463a-aef5-57c9b4262da6",
                                                "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                                "text": "Les gourmands et curieux se sont pressés pour déguster pineaux, cognacs et les préparations proposées."
                                            },
                                            {
                                                "example_id": "2ac1005f-9b8c-423c-ab81-aac087345fb9",
                                                "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                                "text": "Tout en parlant ainsi, il a versé deux petits verres de cognac du service à liqueurs laissé au premier acte."
                                            },
                                            {
                                                "example_id": "cfe8f533-1818-46bc-974e-d9658bfa8ba4",
                                                "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                                "text": "Et monsieur Quesnay sortait de la poche de sa robe de chambre à carreaux verts une bouteille de vieux cognac, et un verre : « Faudra pas le dire à Germaine ! », qu’il me recommandait… Et je buvais la goutte !… Ah ! le bon cognac !… Ah ! le bon homme !…"
                                            },
                                            {
                                                "example_id": "6bb07025-8997-4ab7-834d-fd91a7d72ece",
                                                "sense_id": "c89be6ce-bc19-34df-9951-86a654aae05a",
                                                "text": "Ils aiment bien vivre après avoir bien travaillé ; un verre de vin ou de cognac ne leur fait pas peur, et ils se paient assez souvent le café, le pousse-café et le reste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a53d2e99-19e4-4537-ba92-571b26dbe0bb",
                        "source_entry_id": "503d502a-6d2a-3789-bcf0-0677b625004a",
                        "source_sense_id": "225522ef-9e3d-33d5-8f07-dd1e64190cc1",
                        "source_sense_description": "type of brandy",
                        "target_lang_word": "Kognak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kognak",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e51c4f5-a3e9-3fd7-8294-e6012130b703",
                                        "entry_id": "930627fa-5950-346c-8ddc-985472941f7f",
                                        "glosses": [
                                            "ein aus Wein destilliertes alkoholisches Getränk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d4cfc0a-070e-40e6-bf47-8b565a5e6eeb",
                                                "sense_id": "2e51c4f5-a3e9-3fd7-8294-e6012130b703",
                                                "text": "Frankreich ist für seine außerordentlichen Kognaks bekannt."
                                            },
                                            {
                                                "example_id": "2ce996e9-8890-4114-bfa4-89bd114e30aa",
                                                "sense_id": "2e51c4f5-a3e9-3fd7-8294-e6012130b703",
                                                "text": "„Er forderte zunächst mit Donnerstimme Kognak und schritt dann, da Bordeaux nicht aufzutreiben war, sogleich zur höchsten Stufe vor.“"
                                            },
                                            {
                                                "example_id": "d2494c25-4c72-463f-8a74-78dd6d88e4e8",
                                                "sense_id": "2e51c4f5-a3e9-3fd7-8294-e6012130b703",
                                                "text": "„Ich brachte es fertig, keinen Kognak mehr zu trinken, ging ins Wohnzimmer und schlug das Telefonbuch auf.“"
                                            },
                                            {
                                                "example_id": "f384bbd9-b033-466b-86f2-c06ebafdb89d",
                                                "sense_id": "2e51c4f5-a3e9-3fd7-8294-e6012130b703",
                                                "text": "„Die Konsulin, konfrontiert mit diesem tragischen Sachverhalt, stürzte einen doppelten costaricanischen Kognak todesmutig in die schöne Kehle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
