                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vigesimal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f15d9cce-13d2-3d7f-8f78-dbad6a1d8c04",
                                        "entry_id": "6e42932d-4448-3813-9f96-8e5c69b17960",
                                        "glosses": [
                                            "auf die Zahl zwanzig als Basis bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfe305c0-d39e-4bb4-a5ef-669008926f23",
                                                "sense_id": "f15d9cce-13d2-3d7f-8f78-dbad6a1d8c04",
                                                "text": "„So zählten die Azteken Mexikos und die Maya Yukatans nach dem vigesimalen Zahlensystem und hatten dementsprechend eigene Wörter für 20, 20 × 20 = 400 und 20 × 20 × 20 = 8000.“"
                                            },
                                            {
                                                "example_id": "97443f23-e8e1-4a6e-87e7-ac1728402d1c",
                                                "sense_id": "f15d9cce-13d2-3d7f-8f78-dbad6a1d8c04",
                                                "text": "„Wie läßt sich dann aber das Auftreten der quinären und vigesimalen Systeme erklären?“"
                                            },
                                            {
                                                "example_id": "6047aa90-db69-4663-9885-fe51cf9c028e",
                                                "sense_id": "f15d9cce-13d2-3d7f-8f78-dbad6a1d8c04",
                                                "text": "„Das heutige standard-französische Zahlwortsystem, bei dem sich vigesimale Zahlwörter nur für die hohen Vielfachen der Basiszahl(en) bis 99 finden, geht auf das 17. Jh. zurück.“"
                                            },
                                            {
                                                "example_id": "ef73724a-b67f-4fc3-bc64-7dc745e91d11",
                                                "sense_id": "f15d9cce-13d2-3d7f-8f78-dbad6a1d8c04",
                                                "text": "„Eine strengere Durchführung eines dieser intermediären Systeme, nach Art, wie sich das vigesimale in einigen Sprachen Amerika's in 20 × 20 = 400, 20 × 400 = 8000 fortsetzt, kenne ich nicht.“"
                                            },
                                            {
                                                "example_id": "28d483eb-7a55-4eca-9698-d7b9a4157901",
                                                "sense_id": "f15d9cce-13d2-3d7f-8f78-dbad6a1d8c04",
                                                "text": "„Dies gilt etwa für das Baskische, dessen Zahlenordnung bis 99 vigesimal, ab 100 aber dezimal strukturiert ist: […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
