                "translations": [
                    {
                        "translation_id": "1814d08a-d7e7-490a-9658-5fa3d5461dbe",
                        "source_entry_id": "935f9466-cd24-3288-bc05-3610365ed29e",
                        "source_sense_id": "40c1d5b8-0043-3e8d-87b5-a684d7a3825f",
                        "source_sense_description": "weibliche Person, die an einer Akademie oder Hochschule studiert",
                        "target_lang_word": "Studentin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Studentin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68e27511-dda5-36b7-982b-9e4638bd8e37",
                                        "entry_id": "5356e601-bb7a-3f0d-a9b2-3a1d936312ea",
                                        "glosses": [
                                            "weibliche Person, die an einer Fachhochschule, Hochschule oder Universität eine Ausbildung absolviert/studiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dceb1fdc-077a-4eb0-ba68-ea9bb86d632a",
                                                "sense_id": "68e27511-dda5-36b7-982b-9e4638bd8e37",
                                                "text": "Die meisten Studentinnen sind sehr fleißig und zielstrebig."
                                            },
                                            {
                                                "example_id": "08c01554-dee8-4f6b-a84b-c71c768458fa",
                                                "sense_id": "68e27511-dda5-36b7-982b-9e4638bd8e37",
                                                "text": "„Mir gefielen auch die Studentinnen, die in den meisten Fällen Töchter von Kapitalisten und nicht aus Überzeugung, sondern aus Langeweile Marxisten waren.“"
                                            },
                                            {
                                                "example_id": "1514acc3-90a0-4331-8a81-9c45488e2a79",
                                                "sense_id": "68e27511-dda5-36b7-982b-9e4638bd8e37",
                                                "text": "„Die Studentin glaubt, die Spuren des Hungerns bei beiden Großmüttern zu kennen.“"
                                            },
                                            {
                                                "example_id": "31b0a0c4-072a-4868-a3f9-738ea59fb2e2",
                                                "sense_id": "68e27511-dda5-36b7-982b-9e4638bd8e37",
                                                "text": "„Die Namen dieser beiden Studentinnen würde sie gern erfahren, doch Anrath bleibt bei den Fakten.“"
                                            },
                                            {
                                                "example_id": "8c6e92b5-82c4-4ff8-9471-5d98540af015",
                                                "sense_id": "68e27511-dda5-36b7-982b-9e4638bd8e37",
                                                "text": "„Sie ist nicht wie die anderen Studentinnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
