                "senses": [
                    {
                        "sense_id": "055d00b0-21c6-3541-bb42-1e3bf79a8fa9",
                        "entry_id": "f15a7148-8a6c-35d8-9ab7-420c4b5eb2bb",
                        "glosses": [
                            "Flug, mit dem überprüft wird, ob bei einem Luftfahrzeug tatsächlich alles so funktioniert, wie es funktionieren soll"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "f4399fbf-ed22-43af-b72f-f2bc4bb4cf2a",
                                "sense_id": "055d00b0-21c6-3541-bb42-1e3bf79a8fa9",
                                "text": "„Im eigentlichen Vergabevorgang wurde mit keinem der angebotenen Bieterflugzeuge ein Erprobungsflug durchgeführt.“"
                            },
                            {
                                "example_id": "583030b0-6d39-4621-b856-01df7050a744",
                                "sense_id": "055d00b0-21c6-3541-bb42-1e3bf79a8fa9",
                                "text": "„Der Erprobungsflug sei ein Beleg dafür, dass die Vereinigten Staaten den Ausstieg aus dem INF-Abrüstungsvertrag von langer Hand geplant hätten, erklärte Kremlsprecher Dmitri Peskow der Agentur Interfax zufolge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
