                        "form": "den Verweigerer"
                    },
                    {
                        "form_id": "ad493e18-69f1-4b3f-97e8-6ce33b1f9075",
                        "entry_id": "9058d3a9-43ff-3bc1-824e-290926b625fd",
                        "tags": [
                            "accusative",
