                    "sense_id": "33a30b3a-d909-311e-8a9c-a44d6444e9f5",
                    "sense_definition": "Disappearing from sight, existence, or notice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disappearing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist documented the <w>vanishing</w> species of the rainforest before they were lost forever.",
                            "target_lang_translations": {
                                "ru": "Ученый задокументировал <w>исчезающие</w> виды тропического леса, прежде чем они будут потеряны навсегда."
                            }
                        },
                        {
                            "text": "She caught a brief glimpse of a <w>vanishing</w> figure in the thick fog.",
                            "target_lang_translations": {
                                "ru": "Она мельком заметила <w>исчезающую</w> в густом тумане фигуру."
                            }
                        }
