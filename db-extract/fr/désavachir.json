                "senses": [
                    {
                        "sense_id": "734d0838-bba2-3a88-98df-aa0f6115a8ce",
                        "entry_id": "72f13071-7d9c-365a-967d-8dc449be0587",
                        "glosses": [
                            "Faire perdre son caractère avachi à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "460b45e0-c8cb-4b00-96b0-09d5940f663e",
                                "sense_id": "734d0838-bba2-3a88-98df-aa0f6115a8ce",
                                "text": "Et si sa vocation s’accompagne d’un espoir ou d’un vœu, c’est de celui d’être tonique et de désavachir, quitte à les houspiller un peu, ses pitoyables contemporains."
                            },
                            {
                                "example_id": "d03dcb29-f5e3-4e7c-9759-27271270fbc2",
                                "sense_id": "734d0838-bba2-3a88-98df-aa0f6115a8ce",
                                "text": "Les yeux flamboyèrent, le corps se désavachit et se redressa soudain comme poussé par un ressort : — Je suis dans MA maison de famille !"
                            }
                        ]
                    }
                ],
