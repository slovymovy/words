{
    "word_family": [
        "grover"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47c16d30-07ce-3af5-b1fe-6420ef438a2a",
                    "sense_definition": "A small group of trees, especially one with little or no undergrowth.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "woodland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to have our picnic in a shady <w>grove</w> of oak trees near the river.",
                            "target_lang_translations": {
                                "ru": "Мы решили устроить пикник в тенистой дубовой <w>роще</w> у реки."
                            }
                        },
                        {
                            "text": "The path led us through a quiet <w>grove</w> where the sunlight filtered through the leaves.",
                            "target_lang_translations": {
                                "ru": "Тропинка вела нас через тихий <w>лесок</w>, где солнечный свет пробивался сквозь листву."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quiet grove",
                        "shady grove",
                        "olive grove"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая группа деревьев, обычно без густого подлеска."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роща",
                                "target_lang_sense_clarification": "небольшой лиственный лес"
                            },
                            {
                                "target_lang_word": "лесок",
                                "target_lang_sense_clarification": "маленький лес"
                            },
                            {
                                "target_lang_word": "гай",
                                "target_lang_sense_clarification": "небольшая роща (региональное)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e25d03a0-be2e-376f-a019-b09f01a31c8c",
                    "sense_definition": "A small orchard or group of trees planted for fruit or nut production.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "woodland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer spent the entire morning working in the orange <w>grove</w> to prepare for the harvest.",
                            "target_lang_translations": {
                                "ru": "Фермер провел все утро, работая в апельсиновой <w>роще</w>, готовясь к сбору урожая."
                            }
                        },
                        {
                            "text": "Walking through the <w>grove</w> of lemon trees, the air smelled incredibly fresh and sweet.",
                            "target_lang_translations": {
                                "ru": "Когда мы шли через лимонный <w>сад</w>, воздух казался невероятно свежим и сладким."
                            }
                        }
                    ],
                    "common_phrases": [
                        "orange grove",
                        "citrus grove",
                        "fruit grove"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой сад или группа деревьев, посаженных для выращивания фруктов или орехов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роща",
                                "target_lang_sense_clarification": "например, оливковая или цитрусовая"
                            },
                            {
                                "target_lang_word": "сад",
                                "target_lang_sense_clarification": "плодовые насаждения"
                            },
                            {
                                "target_lang_word": "плантация",
                                "target_lang_sense_clarification": "крупные посадки определенных культур"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5af1c61-ae24-36ba-8029-e09b9c689255",
                    "sense_definition": "A group of trees considered sacred or used as a place of worship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "worship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient rituals were often performed within a sacred <w>grove</w> hidden deep in the forest.",
                            "target_lang_translations": {
                                "ru": "Древние ритуалы часто проводились в священной <w>роще</w>, скрытой глубоко в лесу."
                            }
                        },
                        {
                            "text": "The druids gathered in the <w>grove</w> to celebrate the changing of the seasons.",
                            "target_lang_translations": {
                                "ru": "Друиды собрались в <w>роще</w>, чтобы отпраздновать смену времен года."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sacred grove"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "often associated with historical or mythological contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа деревьев, считающаяся священной или используемая как место поклонения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "священная роща",
                                "target_lang_sense_clarification": "место религиозных обрядов"
                            },
                            {
                                "target_lang_word": "роща",
                                "target_lang_sense_clarification": "в мифологическом контексте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "05f0d97f-137b-35bd-865b-586047ac8182",
                    "sense_definition": "To cut, plough, or gouge lines or channels into a surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter needed to <w>grove</w> the wooden planks so they would fit together perfectly.",
                            "target_lang_translations": {
                                "ru": "Плотнику нужно было <w>прорезать пазы</w> в деревянных досках, чтобы они идеально подходили друг к другу."
                            }
                        },
                        {
                            "text": "The floor was carefully <w>groved</w> and tongued to ensure a smooth and stable finish.",
                            "target_lang_translations": {
                                "ru": "Пол был тщательно <w>соединен в паз</w> и гребень, чтобы обеспечить гладкое и устойчивое покрытие."
                            }
                        }
                    ],
                    "synonyms": [
                        "groove"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вырезать, прорезать или выдалбливать линии или пазы на поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать пазы",
                                "target_lang_sense_clarification": "в столярном деле"
                            },
                            {
                                "target_lang_word": "прорезать желобки",
                                "target_lang_sense_clarification": "создавать углубления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdb61397-26e9-382e-98f1-827b13b21cab",
                    "sense_definition": "To plant or cultivate trees so that they form a small wood or orchard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cultivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The landscape architect decided to <w>grove</w> the trees together in the center of the park.",
                            "target_lang_translations": {
                                "ru": "Ландшафтный архитектор решил <w>высадить</w> деревья группой в центре парка."
                            }
                        },
                        {
                            "text": "In this region, the natural vegetation tends to <w>grove</w> around the water sources.",
                            "target_lang_translations": {
                                "ru": "В этом регионе естественная растительность имеет тенденцию <w>группироваться</w> вокруг источников воды."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высаживать или выращивать деревья так, чтобы они образовывали небольшую рощу или сад."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высаживать рощей",
                                "target_lang_sense_clarification": "группировать деревья"
                            },
                            {
                                "target_lang_word": "насаждать",
                                "target_lang_sense_clarification": "создавать лесные посадки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "20c3bf82-7019-380e-8b62-f7ac55fb8625",
                    "sense_definition": "A common English surname, originally referring to someone who lived near a <w>grove</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Grove</w> has been teaching history at the local high school for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Гроув</w> преподает историю в местной средней школе уже более двадцати лет."
                            }
                        },
                        {
                            "text": "The famous dictionary of music was originally edited by Sir George <w>Grove</w>.",
                            "target_lang_translations": {
                                "ru": "Знаменитый музыкальный словарь изначально редактировался сэром Джорджем <w>Гроувом</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная английская фамилия, изначально относившаяся к человеку, жившему рядом с рощей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гроув",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4062877f-56d1-3cea-a519-73abcefeb401",
                    "sense_definition": "A large village and civil parish in the Vale of White Horse district, Oxfordshire, England.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "villages",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Many people who work in nearby Wantage choose to live in the village of <w>Grove</w>.",
                            "target_lang_translations": {
                                "ru": "Многие люди, работающие в соседнем Уонтидже, предпочитают жить в деревне <w>Гроув</w>."
                            }
                        },
                        {
                            "text": "The local community in <w>Grove</w> organized a large festival to celebrate the summer.",
                            "target_lang_translations": {
                                "ru": "Местная община в <w>Гроуве</w> организовала большой фестиваль, чтобы отпраздновать лето."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United Kingdom"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная деревня и община в районе Вейл-оф-Уайт-Хорс, Оксфордшир, Англия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гроув",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}