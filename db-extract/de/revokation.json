                ],
                "senses": [
                    {
                        "sense_id": "441c723c-a6de-36db-9c47-99e7cee2ea9b",
                        "entry_id": "15fabd76-b233-3c45-8de7-d7fe9c7720fa",
                        "glosses": [
                            "Rücknahme eines im Geschäftsleben erteilten Auftrags"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "a7dc7b03-0130-42db-9494-8f87874b5e6e",
                                "sense_id": "441c723c-a6de-36db-9c47-99e7cee2ea9b",
                                "text": "„Auch das englische Recht nimmt an, daß eine Revokation einer Offerte erst mit dem Momente wirksam wird, wo sie an den Adressaten gelangt, und daß mithin dieser Moment darüber entscheidet, ob die Revokation rechtzeitig erfolgt ist.“"
                            },
                            {
                                "example_id": "998362bc-13ed-4cbc-a41b-319a086ca609",
                                "sense_id": "441c723c-a6de-36db-9c47-99e7cee2ea9b",
                                "text": "„Die förmliche Revokation eines Testamentes aber geschah von jeher nur durch Errichtung eines neuen Testamentes.“ (1840)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "63e4a751-86fd-34e6-b6e0-06ea37522627",
                        "entry_id": "15fabd76-b233-3c45-8de7-d7fe9c7720fa",
                        "glosses": [
                            "Widerruf einer Behauptung oder Entscheidung, Zurückberufung oder das Abberufungsschreiben"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "67ba67ca-ef0c-4ea9-902e-73a15f458c54",
                                "sense_id": "63e4a751-86fd-34e6-b6e0-06ea37522627",
                                "text": "„Zwar erfolgte noch 1682 im Languedoc seitens sogar des Intendanten Daguesseau und der reformierten Pfarrer Lacoste und Du- bourdieu ein Unionsversuch, ja selbst noch 1685, im Jahr der Revokation des Edikts von Nantes.“"
                            },
                            {
                                "example_id": "42c6c0ef-0218-4096-96a9-f25dbadd0567",
                                "sense_id": "63e4a751-86fd-34e6-b6e0-06ea37522627",
                                "text": "„Man bezeigte ihn, daß er sich ohne Revokation auf die Sakramente in der Todesstunde, und auf ein ehrliches Begräbniß keine Hoffnung machen dürfe.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
