                "senses": [
                    {
                        "sense_id": "bb8bcb5a-d7b2-35c1-a933-0526587d17ed",
                        "entry_id": "84de2f93-6ef3-3b2e-a615-1ab3c553d4ef",
                        "glosses": [
                            "ein kronenartiger mit Eiern ausgeschmückter Frühlingsschmuck, der sich in Regionen des Rheinlandes erhalten hat und oft neben dem Maibaum aufgehängt wird oder als Kirmeskrone Verwendung findet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee30a7f-fa00-4fe5-aac3-2f03eda6ecd1",
                                "sense_id": "bb8bcb5a-d7b2-35c1-a933-0526587d17ed",
                                "text": "„Die Eierkrone ist ein rheinischer Frühjahrsbrauch, bei dem ausgeblasene Eier in Form einer Krone auf eine Schnur aufgezogen werden. In manchen Ortschaften werden bis zu 3000 Eier in einer Eierkrone verarbeitet.“"
                            },
                            {
                                "example_id": "a8a96f92-05f1-4417-8e72-1a0478731102",
                                "sense_id": "bb8bcb5a-d7b2-35c1-a933-0526587d17ed",
                                "text": "„Die Einwohnerschaft gibt durch das Abliefern der Eierschalen der Kirmesgesellschaft „Rheinische Jugend“ alljährlich den Auftrag, das Wahrzeichen (= die Eierkrone, Anm. d. Verf.) herzustellen.“"
                            },
                            {
                                "example_id": "8e6ef931-962a-43a2-b185-e0073d84ee08",
                                "sense_id": "bb8bcb5a-d7b2-35c1-a933-0526587d17ed",
                                "text": "Die Jugend hat für die Eierkrone lange ausgeblasene Eier in allen Haushalten des Dorfes gesammelt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
