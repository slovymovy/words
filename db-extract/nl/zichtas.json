                "translations": [
                    {
                        "translation_id": "503552c1-7784-4cc1-82e3-8c67f1e09020",
                        "source_entry_id": "74d0129c-a132-3e21-9b3d-7c59bde20e1c",
                        "source_sense_id": "37cca32c-28bc-3260-a49b-4059140be882",
                        "source_sense_description": "het vanaf een bepaald standpunt langs een lijn geboden vrije uitzicht naar een karakteristiek punt",
                        "target_lang_word": "Sichtachse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sichtachse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8dc05b14-1154-3bf0-b0a3-304be41424bf",
                                        "entry_id": "4432e97c-f07d-3ecf-9726-22dabbd5b88d",
                                        "glosses": [
                                            "(meist freier, unverstellter) Blick in Sichtrichtung einer Fläche/eines Raumes"
                                        ],
                                        "tags": [
                                            "Städtebau",
                                            "Gartenarchitektur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6327bc85-ff24-4f74-b6c0-a08cded1482f",
                                                "sense_id": "8dc05b14-1154-3bf0-b0a3-304be41424bf",
                                                "text": "„Die Konstellation der Häuser untereinander ist so gewählt, dass sich Sichtachsen ergeben, die völlig verschiedene Perspektiven freigeben.“"
                                            },
                                            {
                                                "example_id": "bb60f4ca-c6a3-42d9-90dd-89a662a0b306",
                                                "sense_id": "8dc05b14-1154-3bf0-b0a3-304be41424bf",
                                                "text": "„Demnach wird aktuell darüber diskutiert, ob der von Hertha geplante Bau [Anmerkung: eines Fußballstadions] die Sichtachse zum Sportforum im Olympiapark versperrt.“"
                                            },
                                            {
                                                "example_id": "82d8e695-246b-462f-aa74-ee848218b32e",
                                                "sense_id": "8dc05b14-1154-3bf0-b0a3-304be41424bf",
                                                "text": "„Für die langgestreckte Halle […] konnte sich kaum jemand begeistern. Zumal offensichtlich war, dass der langgestreckte Bau Sichtachsen versperren […] würde.“"
                                            },
                                            {
                                                "example_id": "a825320e-1116-474e-a1e5-2b1edfe43fe9",
                                                "sense_id": "8dc05b14-1154-3bf0-b0a3-304be41424bf",
                                                "text": "„Zum 50. Jahrestag steht nun erst einmal der Container ein paar Häuser weiter auf dem Gärtnerplatz – und stört die Sichtachse im Szeneviertel.“"
                                            },
                                            {
                                                "example_id": "02c3d263-d383-496c-a5f2-62b34c98ace5",
                                                "sense_id": "8dc05b14-1154-3bf0-b0a3-304be41424bf",
                                                "text": "„Ursprünglich bildete die Porschestraße eine Sichtachse vom Klieversberg bis zum Schloss Wolfsburg, so war es vom Stadtplaner Peter Koller geplant. Durch die Pavillons und mittlerweile auch die Autostadt ist diese Sichtachse versperrt.“"
                                            },
                                            {
                                                "example_id": "1e75116d-dcda-43de-a604-99ab1aa4a2b0",
                                                "sense_id": "8dc05b14-1154-3bf0-b0a3-304be41424bf",
                                                "text": "„Wahrzeichen [Anmerkung: der Pariser Satellitenstadt La Défense] ist der Grande Arche de la Defense, der in einer Sichtachse mit dem Arc de Triomphe, Champs Elysees und dem einstigen Königspalast (dem Louvre) liegt.“"
                                            },
                                            {
                                                "example_id": "004589ba-e04d-4ab1-8448-4115b40c82e8",
                                                "sense_id": "8dc05b14-1154-3bf0-b0a3-304be41424bf",
                                                "text": "„Das Ziel dieses Heckengartens war es, die Sichtachsen zu betonen […].“"
                                            },
                                            {
                                                "example_id": "00d27250-ddff-4c49-831e-4d8fa40cb6f3",
                                                "sense_id": "8dc05b14-1154-3bf0-b0a3-304be41424bf",
                                                "text": "„Der Garten sagt einiges aus über seinen Besitzer, sei es durch die Art der Bepflanzung, die Umsetzung der Themen, oder ob Sichtachsen berücksichtigt oder eben ignoriert werden.“"
                                            },
                                            {
                                                "example_id": "243f2c8d-886f-4d46-a35d-33e668f615c5",
                                                "sense_id": "8dc05b14-1154-3bf0-b0a3-304be41424bf",
                                                "text": "„Auf der Insel [Anmerkung: der Pfaueninsel/Berlin] wohnt seit 40 Jahren der ehemalige Gartendirektor der Schlösserstiftung Professor Michael Seiler. Er mag den Begriff Sichtachse, wie er sich eingebürgert hat, überhaupt nicht. Umgeben von schönen Landschaftsbildern sieht er beim Blick in die Ferne einfach keine Achsen, sondern Kunstwerke: »Mein Vorschlag ist 'Gesichtslinie', das ist die original Wortwahl von Peter Joseph Lenné, weil eine Sichtachse, wenn man sich also mit Stadtplanern streitet, was freigehalten werden muss, dann sagen die, 'die Achse funktioniert, sie sehen doch gerade die Kugel und das Kreuz'. Aber Lenné wollte ein Bild sehen.«“"
                                            },
                                            {
                                                "example_id": "9b7a6aae-4297-41ee-a8ed-b23a30874127",
                                                "sense_id": "8dc05b14-1154-3bf0-b0a3-304be41424bf",
                                                "text": "„Ältester Bau ist Schloss Sanssouci – errichtet als Sommerschloss und Rückzugsort von Friedrich dem Großen. Ein Grundprinzip des Gartens sind die ausgeklügelten Sichtachsen: Der Blick wird auf architektonische Schmuckstücke in der Natur gelenkt.“"
                                            },
                                            {
                                                "example_id": "4a119f9d-be34-4746-8cef-1df2945707cf",
                                                "sense_id": "8dc05b14-1154-3bf0-b0a3-304be41424bf",
                                                "text": "„Im Innenbereich hat Weber die Geschossebenen durch Lufträume und Galerien verknüpft sowie horizontale Sichtachsen geschaffen.“"
                                            },
                                            {
                                                "example_id": "866e165d-3a92-4371-b0d3-e8f012168b8a",
                                                "sense_id": "8dc05b14-1154-3bf0-b0a3-304be41424bf",
                                                "text": "„Ihm und seiner deutschen Frau Anja Pascolo war es dabei wichtig, die ursprünglichen und typischen Bauelemente freizulegen. So haben sie die alten Steinböden, Mauerstrukturen sowie Holzbalken erhalten. Gleichzeitig haben sie neue Sichtachsen und Lichtquellen geschaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
