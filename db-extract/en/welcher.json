                                    {
                                        "sense_id": "091da3fb-d8f3-304a-9457-17904b9fb7a3",
                                        "entry_id": "efe3d07d-8fc6-3dfc-8d3b-cf40ef391fab",
                                        "glosses": [
                                            "jemand, der lügt, täuscht, blufft oder betrügt"
                                        ],
