                                                "sense_id": "c4a9706e-8581-32d3-a8f6-22c31099fbd3",
                                                "text": "Many DJs prefer vinyl to CDs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc70a44a-f7b2-3d1d-85b4-3f06d6887ef6",
                                        "entry_id": "4238cee6-a473-3dc3-bdc5-2a5c9b141a00",
                                        "glosses": [
                                            "A phonograph record."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a0344e7-f98c-4d42-9710-0275429895ed",
                                                "sense_id": "dc70a44a-f7b2-3d1d-85b4-3f06d6887ef6",
                                                "text": "This is a tangible example of the net's natural flow toward improved environmental outcomes. Although some people lament the loss of flipping through CDs, or eight-tracks, or vinyls, there is a clear upside to dematerialization."
                                            }
                                        ]
                                    }
                                ]
                            },
