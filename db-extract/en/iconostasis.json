                "senses": [
                    {
                        "sense_id": "3de160b2-0048-3f07-9ba4-fac2151867c9",
                        "entry_id": "cd3e0d59-a722-3c36-826b-91012c83df47",
                        "glosses": [
                            "A wall of icons between the sanctuary and the nave in an Eastern Orthodox church."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9559e6e6-61b5-438a-bf40-ca187a7a4878",
                                "sense_id": "3de160b2-0048-3f07-9ba4-fac2151867c9",
                                "text": "The altar was hidden behind an Iconostasis. The church was looked after by an old sacristan who lived in a cottage on the shore of the lake."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f4ba2f0-6226-45fe-b29b-640f9e9c93b0",
                        "source_entry_id": "cd3e0d59-a722-3c36-826b-91012c83df47",
                        "source_sense_id": "3de160b2-0048-3f07-9ba4-fac2151867c9",
                        "source_sense_description": "a wall of icons",
                        "target_lang_word": "ikonostas",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fe7cbd34-2f12-4b95-88fa-485c7a425fab",
                        "source_entry_id": "cd3e0d59-a722-3c36-826b-91012c83df47",
                        "source_sense_id": "3de160b2-0048-3f07-9ba4-fac2151867c9",
                        "source_sense_description": "a wall of icons",
                        "target_lang_word": "iconostase",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iconostase",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a7496adc-9375-3449-89da-8c33bc89a210",
                                        "entry_id": "43aabace-e763-30ef-851d-865a612b0347",
                                        "glosses": [
                                            "een iconenwand die het altaar van het schip scheidt in de Russisch-orthodoxe kerk"
                                        ],
                                        "tags": [
                                            "schilderkunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cab1261-fd70-4d1b-bb42-22cbdbc1c225",
                                                "sense_id": "a7496adc-9375-3449-89da-8c33bc89a210",
                                                "text": "Van de kerkgezangen van het acht man sterke koor word ik bijna religieus, zo mooi klinkt de muziek uit het houten huisje naast de iconostase."
                                            },
                                            {
                                                "example_id": "48929b73-0105-4f25-82b5-1a5aa2b84082",
                                                "sense_id": "a7496adc-9375-3449-89da-8c33bc89a210",
                                                "text": "Een typisch Russisch element in de kerk is de iconostase, een iconenwand die het altaar van het schip scheidt. De altaarruimte geldt als het heiligste gedeelte van de kerk, dat alleen de priester mag betreden. Door een dichte wand van iconen te maken, voorkwamen de geestelijken dat de kerkgangers zelfs maar naar het altaar konden kijken. In de iconostase zitten deuren. Deze zogeheten koningsdeuren staan slechts open tijdens de liturgie. Alleen dan mag de gelovige even een blik op de eeuwigheid werpen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd8517d6-b836-43c7-a0fe-f1b6deb75f32",
                        "source_entry_id": "cd3e0d59-a722-3c36-826b-91012c83df47",
                        "source_sense_id": "3de160b2-0048-3f07-9ba4-fac2151867c9",
                        "source_sense_description": "a wall of icons",
                        "target_lang_word": "iconostase",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iconostase",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42506235-948e-3e3e-ab44-06d05e19d918",
                                        "entry_id": "294380d8-3ece-34ae-929c-98541c45ff43",
                                        "glosses": [
                                            "Grande cloison qui, dans les églises orthodoxes, sépare le sanctuaire et l’autel où se tient le clergé célébrant la liturgie de la nef et où l’on expose les images de Jésus-Christ, de la Vierge, des quatre évangélistes et de quelques saints."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36056e82-7eaa-4612-b8ba-18b65a7f8044",
                                                "sense_id": "42506235-948e-3e3e-ab44-06d05e19d918",
                                                "text": "« Les canons architecturaux sont très forts dans la religion orthodoxe. Nous nous y sommes pliés pour l'orientation de l'église, les ornementations de l'iconostase ainsi que les cinq bulbes »."
                                            },
                                            {
                                                "example_id": "769fa89b-e094-48f1-8353-d9d38498992f",
                                                "sense_id": "42506235-948e-3e3e-ab44-06d05e19d918",
                                                "text": "Les images des iconostases sont des peintures rehaussées d’or ou d’argent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e90c62e5-2ccd-4a63-bfce-536070f83d58",
