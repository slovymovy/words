                    {
                        "sense_id": "71304416-016f-3391-8379-eb307f1ef385",
                        "entry_id": "70d68724-2345-316d-bd35-d7bd73fa8b0c",
                        "glosses": [
                            "lijst met eisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae0a86e6-cd58-425f-9747-11b707026aa1",
                                "sense_id": "71304416-016f-3391-8379-eb307f1ef385",
                                "text": "Dat de wijk bijzonder is, wisten ze in Hengelo al. Het Oversticht heeft de wijk Klein Driene langs de architectonische maatlat gelegd. De welstandsorganisatie hoopt dat het straks net zo mooi wordt als vijftig jaar geleden, toen er zelfs ansichtkaarten waren van Klein Driene."
                            },
                            {
                                "example_id": "1e8d08c5-2537-4c57-9dc8-0ecd920a25a3",
                                "sense_id": "71304416-016f-3391-8379-eb307f1ef385",
                                "text": "De stal, voor 160 melkkoeien, voldoet aan de Maatlat Duurzame Veehouderij."
                            },
                            {
                                "example_id": "fc91bc51-7c85-4da1-b66b-3f9c984f5632",
                                "sense_id": "71304416-016f-3391-8379-eb307f1ef385",
                                "text": "Het voorstel is dat alle veehouders die nog willen uitbreiden vanaf september moeten voldoen aan extra eisen die nog moeten worden opgesteld in een zogenoemde maatlat."
                            }
                        ]
                    }
