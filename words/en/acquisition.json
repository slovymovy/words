                    "sense_definition": "The process of sampling signals that measure real-world physical conditions and converting them into digital values.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer configured the system for high-speed data <w>acquisition</w>.",
                            "target_lang_translations": {
                                "ru": "Инженер настроил систему для высокоскоростного <w>сбора</w> данных.",
                                "de": "Der Ingenieur konfigurierte das System für die Hochgeschwindigkeits-Daten<w>erfassung</w>."
                            }
