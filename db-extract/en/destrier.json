                        "entry_id": "ef2be163-be6c-36dc-bafd-2dc7ddf35232",
                        "glosses": [
                            "A large warhorse, especially of a medieval knight."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c1c6d484-5c21-4899-8eba-d353990e25e0",
                                "sense_id": "5e4bfd52-fa26-3fd5-9019-412f9ed050e2",
                                "text": "I am resolved to share or avert the danger; which, that I may the better do, I would crave of thee the use of some palfrey whose pace may be softer than that of my destrier."
                            },
                            {
                                "example_id": "5367bf98-f843-4d1d-b7b0-cd54edc923a9",
                                "sense_id": "5e4bfd52-fa26-3fd5-9019-412f9ed050e2",
                                "text": "Dark and the Desert and Destriers me ken, And the Glaive and the Joust, and Paper and Pen."
                            }
                        ]
                    },
