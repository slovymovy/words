{
    "word_family": [
        "ease",
        "easiness",
        "uneasiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d5483690-7883-3e4c-ba66-fcade2b5cada",
                    "sense_definition": "Feeling worried, anxious, or restless due to uncertainty or fear.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anxiety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have been <w>uneasy</w> about the upcoming exam because I have not studied enough.",
                            "target_lang_translations": {
                                "cs": "Jsem kvůli nadcházející zkoušce <w>nesvůj</w>, protože jsem se dostatečně neučil."
                            }
                        },
                        {
                            "text": "The strange silence in the house made her feel <w>uneasy</w> and <w>anxious</w>.",
                            "target_lang_translations": {
                                "cs": "Kvůli podivnému tichu v domě se cítila <w>nesvá</w> a úzkostná."
                            }
                        }
                    ],
                    "synonyms": [
                        "anxious",
                        "worried",
                        "restless",
                        "nervous"
                    ],
                    "common_phrases": [
                        "feel uneasy"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pocit obav, úzkosti nebo neklidu způsobený nejistotou nebo strachem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "znepokojený",
                                "target_lang_sense_clarification": "vyjadřuje stav obav z určité situace"
                            },
                            {
                                "target_lang_word": "nesvůj",
                                "target_lang_sense_clarification": "pocit vnitřního neklidu a nepohody"
                            },
                            {
                                "target_lang_word": "úzkostný",
                                "target_lang_sense_clarification": "silnější pocit strachu a napětí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a2d06f5-aafd-3c76-819f-88d4b7197aa8",
                    "sense_definition": "Lacking natural grace or comfort in social situations; feeling awkward or constrained.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "awkwardness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt <w>uneasy</w> and <w>awkward</w> while trying to make conversation with his boss.",
                            "target_lang_translations": {
                                "cs": "Cítil se <w>nesvůj</w> a rozpačitý, když se snažil konverzovat se svým šéfem."
                            }
                        },
                        {
                            "text": "The <w>uneasy</w> silence between the two friends lasted for several minutes.",
                            "target_lang_translations": {
                                "cs": "<w>Tísnivé</w> ticho mezi oběma přáteli trvalo několik minut."
                            }
                        }
                    ],
                    "synonyms": [
                        "awkward",
                        "stiff"
                    ],
                    "common_phrases": [
                        "uneasy silence"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nedostatek přirozené lehkosti nebo pohodlí v sociálních situacích; pocit trapnosti nebo omezení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nesvůj",
                                "target_lang_sense_clarification": "pocit trapnosti nebo nepohodlí v přítomnosti druhých"
                            },
                            {
                                "target_lang_word": "rozpačitý",
                                "target_lang_sense_clarification": "pocit nejistoty a studu v sociální interakci"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54224de2-e703-3af0-b932-9be21fe5860d",
                    "sense_definition": "Causing a feeling of discomfort, worry, or lack of stability.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anxiety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician faced an <w>uneasy</w> situation after the scandal was revealed.",
                            "target_lang_translations": {
                                "cs": "Politik čelil <w>napjaté</w> situaci poté, co byl skandál odhalen."
                            }
                        },
                        {
                            "text": "There is an <w>uneasy</w> feeling that something bad might happen soon.",
                            "target_lang_translations": {
                                "cs": "Mám <w>tísnivý</w> pocit, že se brzy může stát něco špatného."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uneasy feeling",
                        "uneasy situation"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vyvolávající pocit nepohodlí, obav nebo nedostatek stability."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "napjatý",
                                "target_lang_sense_clarification": "o situaci, která není stabilní nebo klidná"
                            },
                            {
                                "target_lang_word": "tísnivý",
                                "target_lang_sense_clarification": "o atmosféře nebo pocitu, který vyvolává úzkost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cdd13b9-5957-32b6-8377-6c23b9608e25",
                    "sense_definition": "Difficult to perform or achieve; not easy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team faced an <w>uneasy</w> task of rebuilding the bridge during the storm.",
                            "target_lang_translations": {
                                "cs": "Tým čelil <w>náročnému</w> úkolu znovu postavit most během bouře."
                            }
                        },
                        {
                            "text": "It was an <w>uneasy</w> climb up the steep and slippery mountain path.",
                            "target_lang_translations": {
                                "cs": "Byl to <w>obtížný</w> výstup po strmé a kluzké horské cestě."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Obtížné provést nebo dosáhnout; nelehké."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "obtížný",
                                "target_lang_sense_clarification": "vyžadující velké úsilí"
                            },
                            {
                                "target_lang_word": "náročný",
                                "target_lang_sense_clarification": "vyžadující hodně sil nebo schopností"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}