{
    "word_family": [
        "slur"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6648d1ef-f95c-338c-a6c2-0fc071e704fa",
                    "sense_definition": "The act of speaking unclearly so that sounds run together.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor noticed a slight <w>slurring</w> of his speech after the accident.",
                            "target_lang_translations": {
                                "cs": "Lékař si po nehodě všiml mírné <w>huhlavosti</w> v jeho řeči."
                            }
                        },
                        {
                            "text": "Alcohol consumption often leads to the <w>slurring</w> of words during conversation.",
                            "target_lang_translations": {
                                "cs": "Konzumace alkoholu často vede k <w>zkomolené výslovnosti</w> během konverzace."
                            }
                        }
                    ],
                    "synonyms": [
                        "mumbling"
                    ],
                    "common_phrases": [
                        "slurring of speech"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsob mluvy, při kterém jsou slova nebo hlásky nesrozumitelně spojovány dohromady."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "huhlavost",
                                "target_lang_sense_clarification": "nesrozumitelná, nejasná výslovnost"
                            },
                            {
                                "target_lang_word": "zkomolená výslovnost",
                                "target_lang_sense_clarification": "řeč, kde se hlásky slévají"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "092a8e84-8828-3829-9031-c3215040bd52",
                    "sense_definition": "A curved line used in musical notation to indicate that notes should be played smoothly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer added <w>slurring</w> to the violin part to ensure a legato performance.",
                            "target_lang_translations": {
                                "cs": "Skladatel přidal do partu pro housle <w>ligatury</w>, aby zajistil plynulé legato."
                            }
                        },
                        {
                            "text": "The sheet music contains many <w>slurring</w> marks that guide the pianist's phrasing.",
                            "target_lang_translations": {
                                "cs": "Notový zápis obsahuje mnoho <w>značek pro legato</w>, které vedou frázování klavíristy."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Oblouček v notovém zápisu označující legato, tedy plynulé spojení tónů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "legato",
                                "target_lang_sense_clarification": "hudební termín pro vázaný přednes"
                            },
                            {
                                "target_lang_word": "ligatura",
                                "target_lang_sense_clarification": "značka pro spojení not"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dbe9eb81-8413-31a8-85c1-bc8d54cbcb83",
                    "sense_definition": "The present participle and gerund of <w>slur</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>slurring</w> his words because he was extremely tired.",
                            "target_lang_translations": {
                                "cs": "Protože byl extrémně unavený, <w>huhlal</w> slova."
                            }
                        },
                        {
                            "text": "The singer is <w>slurring</w> the notes together to create a smooth effect.",
                            "target_lang_translations": {
                                "cs": "Zpěvák <w>spojuje</w> tóny dohromady, aby vytvořil plynulý efekt."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Činnost, při které mluvčí artikuluje nejasně nebo hudebník spojuje tóny."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "huhlat",
                                "target_lang_sense_clarification": "mluvit nesrozumitelně"
                            },
                            {
                                "target_lang_word": "spojovat",
                                "target_lang_sense_clarification": "v hudbě vázat tóny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}