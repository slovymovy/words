                ],
                "senses": [
                    {
                        "sense_id": "83754a1b-27f4-3756-ae2f-85624c764711",
                        "entry_id": "f812c6cc-7bcb-314b-898f-8b91e3554053",
                        "glosses": [
                            "unbewusst falsch gesetzter Buchstabe"
                        ],
                        "tags": [
                            "Typografie"
                        ],
                        "examples": [
                            {
                                "example_id": "57c6e88c-1fcf-45d5-b045-9b32b994934c",
                                "sense_id": "83754a1b-27f4-3756-ae2f-85624c764711",
                                "text": "„Die digitale Kommunikation zeigt allerdings auch einen Anstieg der Rechtschreibfehler, bedingt auch durch flüchtiges Tippen und eine Fehlertoleranz. So sehen 41 Prozent der Befragten kein Problem bei schlechter Grammatik und sogenannten ‚Typos‘, vor allem bei informellem Kontakt via SMS oder WhatsApp.“"
                            },
                            {
                                "example_id": "d55f0f77-d687-4d46-abd6-c6f7cff6d615",
                                "sense_id": "83754a1b-27f4-3756-ae2f-85624c764711",
                                "text": "„Wenn die iCloud Anmeldung nicht funktioniert, solltet ihr nicht verzagen. Möglicherweise gibt es eine ganz einfache Erklärung dafür, etwa ein Typo in Mail-Adresse oder Passwort der Apple-ID.“"
                            },
                            {
                                "example_id": "73850beb-6cab-40a0-ac36-c764cd9e60e8",
                                "sense_id": "83754a1b-27f4-3756-ae2f-85624c764711",
                                "text": "„Daher rührt auch die Bezeichnung Typo für Tippfehler, die sich auf einen versetzten oder falschen Buchstaben bezieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91f51483-c891-4d72-a2b0-2bf4718a92a6",
                        "source_entry_id": "f812c6cc-7bcb-314b-898f-8b91e3554053",
                        "source_sense_id": "83754a1b-27f4-3756-ae2f-85624c764711",
                        "source_sense_description": "unbewusst falsch gesetzter Buchstabe",
                        "target_lang_word": "typo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "typo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20bf5db7-00e7-3599-b9f8-01744b727d8c",
                                        "entry_id": "8e5bcd19-673c-3646-9c39-e012d5b53ba7",
                                        "glosses": [
                                            "A typographical error."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f5228c2-d932-429e-a8a5-867d3b4a93e6",
                                                "sense_id": "20bf5db7-00e7-3599-b9f8-01744b727d8c",
                                                "text": "Near-synonyms: misprint; slip of the pen, lapsus calami, lapsus plumæ"
                                            },
                                            {
                                                "example_id": "1ab7bfa0-8f3a-4d71-af20-aaeecb02dfe2",
                                                "sense_id": "20bf5db7-00e7-3599-b9f8-01744b727d8c",
                                                "text": "Sorry, I meant to say “buy a SODA”—“sofa” was a typo."
                                            },
                                            {
                                                "example_id": "6f2f57f2-3bd3-4eb4-aeb1-c88aedf9cfc1",
                                                "sense_id": "20bf5db7-00e7-3599-b9f8-01744b727d8c",
                                                "text": "His 14 singles titles still look like a typo even for those like me who have watched him build that probably unbreakable record, red brick by red brick."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "typo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8379c7a-9f3f-38ea-8d14-deb555726ee8",
                                        "entry_id": "09dec757-0aef-35bd-80af-a142f19f65c1",
                                        "glosses": [
                                            "To make a typographical error."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f0aaf2b-9b69-44bb-977c-8821c94c5bbe",
                                                "sense_id": "c8379c7a-9f3f-38ea-8d14-deb555726ee8",
                                                "text": "Tell your mother that that essay I wrote for THE WRITER, that mentions you, is now in print in the Aw-Ghost issue. But they typoed Elfquest, so now it reads Elquist. I see I had typoed it myself, leaving out the “f” but they worsened it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "typo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d611a649-c6df-3a15-8f2e-26a3b1da44ac",
                                        "entry_id": "c27bec04-ed8e-3e42-b743-7766674f0fb4",
                                        "glosses": [
                                            "A compositor; a typographer."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57ca2204-cf25-4b14-92d4-2cf254f27283",
                                                "sense_id": "d611a649-c6df-3a15-8f2e-26a3b1da44ac",
                                                "text": "On the highest, rear seat was James Williams, of Cloverdale, Missouri, and his Bride.\nCapitalise it, friend typo—that last word—word of words in the epiphany of life and love."
                                            },
                                            {
                                                "example_id": "27aaf9a3-4d82-403a-8b08-08f9590ce386",
                                                "sense_id": "d611a649-c6df-3a15-8f2e-26a3b1da44ac",
                                                "text": "“Ever since I was twelve,” she said, “I have worked in a printing office where a celebrated London morning journal is put in type and goes to press. […] I am attached to a man in our office, to whom I shall be married some day. […] I am nineteen now, and have carried on with my ‘typo’ for nearly three years now."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "typo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b74882a5-af69-37af-8615-3f85453e67da",
                                        "entry_id": "a9e102b7-bd5b-3300-b40f-3a1001eaf24b",
                                        "glosses": [
                                            "Alternative form of taipo."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
