                ],
                "senses": [
                    {
                        "sense_id": "c5ead2d9-da8a-3048-bd14-28d8ba7e49a9",
                        "entry_id": "5688a50a-20bf-3505-8240-5dda6349cd9b",
                        "glosses": [
                            "(Région d’Apt) Pastèque à chair blanche, Citrullus amarus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bd8d240-f80b-43de-8ddb-7fe4fc87842c",
                                "sense_id": "c5ead2d9-da8a-3048-bd14-28d8ba7e49a9",
                                "text": "Citre, Cougourdo verdo, Pasteco verdo, s.f. espèce de pastèque ou faux melon d’Amérique qui ressemble au melon vert comestible ou melon d’eau. Celui-ci est plus allongé, tandis que le citre (cucurbita citrullus) est tout à fait sphérique, d’un vert plus foncé et tâcheté de bandes d’un vert plus clair. La pulpe de ce melon que l’on confit au moût ou au sucre avant sa complète mâturité est ferme et d’un blanc verdâtre."
                            },
                            {
                                "example_id": "6ed1d2d4-22ff-40f1-9026-bbd3116e859c",
                                "sense_id": "c5ead2d9-da8a-3048-bd14-28d8ba7e49a9",
                                "text": "Dans le sud de la France, la citre ou méréville est appréciée pour les confitures."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
