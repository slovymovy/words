                                "target_senses": [
                                    {
                                        "sense_id": "e891690f-ba26-3f51-9933-b8c555169bcb",
                                        "entry_id": "694f6495-019e-3547-aa74-d69d799e3ad8",
                                        "glosses": [
                                            "истор. европейское название острова Тайвань"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59a9fa0b-5043-4c3e-9d08-d210119c2a65",
                                                "sense_id": "e891690f-ba26-3f51-9933-b8c555169bcb",
                                                "text": "По своему геологическому строению остров Формоза во многом сходен с островной Японией, и точно так же не может похвалиться какими-либо исключительными горными богатствами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
