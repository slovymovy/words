                "translations": [
                    {
                        "translation_id": "bc3e861f-8372-4bb1-93d4-376624d23a10",
                        "source_entry_id": "9a375c78-3c6d-32a7-878b-a40aeab5424b",
                        "source_sense_id": "43a9065e-c136-3565-947c-5b35130242d7",
                        "source_sense_description": "veraltet: verbinden, vereinigen, vereinen",
                        "target_lang_word": "verbinden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbinden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e8ed06e-0eb1-3d0f-b5c3-0c2075db56f3",
                                        "entry_id": "3b537ec6-be36-3a4d-bda3-2c0e228cfb1b",
                                        "glosses": [
                                            "mit einer Binde abdecken, mit einem Verband versorgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b21f15f4-36ce-49e4-b2d8-3e3ec6179ddb",
                                                "sense_id": "1e8ed06e-0eb1-3d0f-b5c3-0c2075db56f3",
                                                "text": "Bitte hilf mir mal, mein Bein zu verbinden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1724f7ee-29de-3039-98a9-02e082b42567",
                                        "entry_id": "3b537ec6-be36-3a4d-bda3-2c0e228cfb1b",
                                        "glosses": [
                                            "zu einem Gefüge vereinen oder in eine enge Beziehung bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0d696b9-432d-455b-a198-a55e08134a7d",
                                                "sense_id": "1724f7ee-29de-3039-98a9-02e082b42567",
                                                "text": "Der Drucker muss noch mit dem Rechner verbunden werden."
                                            },
                                            {
                                                "example_id": "1da0b1aa-8f17-494b-817f-86eddecd8a73",
                                                "sense_id": "1724f7ee-29de-3039-98a9-02e082b42567",
                                                "text": "Ich glaube, ihre gemeinsamen Erinnerungen verbinden die beiden."
                                            },
                                            {
                                                "example_id": "f7be1f1e-9b94-4329-8a15-96bafb16fb90",
                                                "sense_id": "1724f7ee-29de-3039-98a9-02e082b42567",
                                                "text": "„Und so soll auch der Mensch die wilden Elemente, die in seiner eigenen dunklen Brust nach der alten Willkür lauern und an ihren Ketten reißen und beißen, mit göttlichem Sinne besprechen und zu einem schönen, lichten Leben die Ehre, Tugend und Gottseligkeit in Eintracht verbinden und formieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "235de912-4edb-31dd-8c6a-6c369d6806e4",
                                        "entry_id": "3b537ec6-be36-3a4d-bda3-2c0e228cfb1b",
                                        "glosses": [
                                            "sich vereinen (für Dinge oder Personen), eine Beziehung eingehen, eine chemische Verbindung eingehen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fcb4b47-522c-46e1-9ad3-6d2274ad0bb6",
                                                "sense_id": "235de912-4edb-31dd-8c6a-6c369d6806e4",
                                                "text": "Der Fürst verband sich mit dem französischen König."
                                            },
                                            {
                                                "example_id": "91dc9b90-084d-47ac-af00-d993619496ca",
                                                "sense_id": "235de912-4edb-31dd-8c6a-6c369d6806e4",
                                                "text": "Die Aldehyde verbinden sich mit Alkylchloriden."
                                            },
                                            {
                                                "example_id": "26721d60-351e-4453-b268-f699f51971cf",
                                                "sense_id": "235de912-4edb-31dd-8c6a-6c369d6806e4",
                                                "text": "„Siehe mit welcher Gier Quecksilbertropfen in einander über fliessen, Wasserstoff mit Sauerstoff sich vereinigt oder andere chemische Liebespaare unter fürterlicher Hitzeentwicklung und mit Gebrause und Feuerschein sich verbinden!“"
                                            },
                                            {
                                                "example_id": "7adb3fda-995b-4b24-b3d5-f359bfd6c8cd",
                                                "sense_id": "235de912-4edb-31dd-8c6a-6c369d6806e4",
                                                "text": "Die Ankopplung [des Forschungslabors] \"Columbus\" war ganz schön kompliziert: Mit Hilfe eines riesigen Roboterarms wurde das Labor an seinen Platz gehoben und dann von Astronauten mit der ISS verbunden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b79bc6a8-13a3-303e-b336-5030be9c5d9e",
                                        "entry_id": "3b537ec6-be36-3a4d-bda3-2c0e228cfb1b",
                                        "glosses": [
                                            "einen Anrufer am Telefon zu einem Gesprächspartner weiterleiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d23441c-6992-49b4-b5d7-39732803f4a2",
                                                "sense_id": "b79bc6a8-13a3-303e-b336-5030be9c5d9e",
                                                "text": "Können Sie mich bitte mit Frau Maier verbinden?"
                                            },
                                            {
                                                "example_id": "c0079be5-0877-42e3-96b4-ebefdfa6cacf",
                                                "sense_id": "b79bc6a8-13a3-303e-b336-5030be9c5d9e",
                                                "text": "Falsch verbunden!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2d681d9-d27e-445c-ba62-b13fc3c4c851",
                        "source_entry_id": "9a375c78-3c6d-32a7-878b-a40aeab5424b",
