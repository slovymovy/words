                        "examples": [
                            {
                                "example_id": "a81b4a38-18d7-4c2f-8079-92b981ea02fb",
                                "sense_id": "47e8ce9d-be3d-35c7-a29e-abc622d31c2a",
                                "text": "„Die Piraten erweckten mit ihren Turbanen und den mit Gewehrmagazinen behängten Oberkörpern einen durchaus bedrohlichen Eindruck.“"
                            },
                            {
                                "example_id": "ecd82d6f-91d6-4ced-90e2-d150c19994ec",
                                "sense_id": "47e8ce9d-be3d-35c7-a29e-abc622d31c2a",
                                "text": "„Manche der Männer hatten lange Trenchcoats, andere fast nackte Oberkörper, abgesehen von ihren Armeewesten, die mit Gewehrmagazinen vollgestopft waren.“"
                            }
                        ],
