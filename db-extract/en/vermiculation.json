                                        "entry_id": "16c2eb45-abc8-385e-964f-0de85c05b8b2",
                                        "glosses": [
                                            "Motif d’ornement des pierres de parement imitant l’aspect sinueux de galeries de ver."
                                        ],
                                        "tags": [
                                            "Ornement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7406aafd-0333-4e6a-9a5d-594513c856d0",
                                                "sense_id": "3daedffb-4573-35cf-bf9f-99535b8c187d",
                                                "text": "Pas de fameuses vermiculures empruntées à l’art baroque… Je ne suis pas sûr que tout le monde soit sensible à cet art prodromique !"
                                            }
                                        ]
