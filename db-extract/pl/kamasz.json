                    },
                    {
                        "translation_id": "960d2f33-a2f8-43f5-8119-19891e6dd386",
                        "source_entry_id": "92ac6893-d893-3239-af9c-ab182fcbfd78",
                        "source_sense_id": "befdac47-6024-3e6f-9fae-b66fb14e325b",
                        "target_lang_word": "chukka",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fec46073-f8d0-4989-83d3-4b1885d67c66",
                        "source_entry_id": "92ac6893-d893-3239-af9c-ab182fcbfd78",
                        "source_sense_id": "befdac47-6024-3e6f-9fae-b66fb14e325b",
                        "target_lang_word": "Boot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Boot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f20f9fc-b88d-332b-a3dd-338ce7e71db3",
                                        "entry_id": "1de8ed86-d06f-3790-afbc-41075d663764",
                                        "glosses": [
                                            "kleines Wasserfahrzeug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55a467bf-2e12-454c-95f1-b7e29f54fb18",
                                                "sense_id": "9f20f9fc-b88d-332b-a3dd-338ce7e71db3",
                                                "text": "Wir können mit dem Boot über den Fluss setzen."
                                            },
                                            {
                                                "example_id": "efe97228-cb8e-4907-aef5-f57ee3af4ac9",
                                                "sense_id": "9f20f9fc-b88d-332b-a3dd-338ce7e71db3",
                                                "text": "„Der versierte Kajakfahrer wird eins mit seinem Boot und kann sich in dieser neuen Einheit den Strömungen, Wirbeln und Kaskaden des Wildwassers stellen.“"
                                            },
                                            {
                                                "example_id": "5a6b27be-69f5-4cab-9734-918ccb7455ce",
                                                "sense_id": "9f20f9fc-b88d-332b-a3dd-338ce7e71db3",
                                                "text": "„Er rutschte auf seinem Boot aus und stürzte ins eiskalte Meer.“"
                                            },
                                            {
                                                "example_id": "3e6a0308-e077-4d3d-b079-0efad4d7c45c",
                                                "sense_id": "9f20f9fc-b88d-332b-a3dd-338ce7e71db3",
                                                "text": "„Er stand jetzt im Heck und brachte das Boot zum Schaukeln.“"
                                            },
                                            {
                                                "example_id": "7542474f-e386-4689-85a9-406a4ef6b874",
                                                "sense_id": "9f20f9fc-b88d-332b-a3dd-338ce7e71db3",
                                                "text": "„Joan hatte das Boot längst gesehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1832775c-37c0-3c1b-9be8-798b114fd075",
                                        "entry_id": "1de8ed86-d06f-3790-afbc-41075d663764",
                                        "glosses": [
                                            "seegehende Einheit einer bestimmten Größenordnung bei der Marine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9598a25f-1283-4128-a285-973a34e0818f",
                                                "sense_id": "1832775c-37c0-3c1b-9be8-798b114fd075",
                                                "text": "„Auf Schiffen hat der Kommandant die Disziplinargewalt eines Bataillonskommandeurs, der Erste Offizier die eines Kompaniechefs. Auf Booten hat der Kommandant die Disziplinargewalt eines Kompaniechefs, sein Vertreter hat keine Disziplinargewalt.“"
                                            },
                                            {
                                                "example_id": "600aa7a2-12e7-4914-8376-28c29cf32b3f",
                                                "sense_id": "1832775c-37c0-3c1b-9be8-798b114fd075",
                                                "text": "„Man hatte auf den Booten einen offenen Respekt vor dem Minensuchen, zumal es bekannt war, daß gerade Fischdampfer wegen ihres Tiefganges wenig geeignet dafür waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Boot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca6ccff9-a897-317e-9dad-ed6d49ac20c0",
                                        "entry_id": "a54108d7-2e2a-3fab-b3f6-a7aae6297881",
                                        "glosses": [
                                            "über die Knöchel reichender Lederstiefel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64628b5a-3f7b-471b-9eb9-932de8d0d447",
                                                "sense_id": "ca6ccff9-a897-317e-9dad-ed6d49ac20c0",
                                                "text": "Du solltest dir noch die Boots anziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Boot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72bd4c58-80b0-3b37-a138-36cf8538c86d",
                                        "entry_id": "a6547e09-5810-35d6-949d-282705e2eb47",
                                        "glosses": [
                                            "ein Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1d6a480-d376-4627-9886-46c5fe215ce8",
                                                "sense_id": "72bd4c58-80b0-3b37-a138-36cf8538c86d",
                                                "text": "„Jaap Boot (eigentlich: Jan Jacobus Boot; * 1. März 1903 in Wormerveer; † 14. Juni 1986 in Dordrecht) war ein niederländischer Leichtathlet.“"
                                            },
                                            {
                                                "example_id": "dee62f94-243e-4717-b860-a3f414839bff",
                                                "sense_id": "72bd4c58-80b0-3b37-a138-36cf8538c86d",
                                                "text": "Frau Boot ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "741a38ea-337e-426c-8348-92808027dda4",
                                                "sense_id": "72bd4c58-80b0-3b37-a138-36cf8538c86d",
                                                "text": "Herr Boot wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "c1604485-076b-439d-b296-387e5b5bceb0",
                                                "sense_id": "72bd4c58-80b0-3b37-a138-36cf8538c86d",
                                                "text": "Die Boots kommen heute aus dem Erzgebirge."
                                            },
                                            {
                                                "example_id": "650fd464-f8b1-4866-9640-1405f5b96184",
                                                "sense_id": "72bd4c58-80b0-3b37-a138-36cf8538c86d",
                                                "text": "Der Boot trägt nie die Schals, die die Boot ihm strickt."
                                            },
                                            {
                                                "example_id": "4f6670b8-c86d-4c72-9cf1-d90b7b316491",
                                                "sense_id": "72bd4c58-80b0-3b37-a138-36cf8538c86d",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Boot kommt, geht der Herr Boot.“"
                                            },
                                            {
                                                "example_id": "2523a85b-0395-40e7-bc6b-4e952d81a967",
                                                "sense_id": "72bd4c58-80b0-3b37-a138-36cf8538c86d",
                                                "text": "Boot kommt und geht."
                                            },
                                            {
                                                "example_id": "c55e0e5d-3320-4dbd-9c2b-54681d57fb61",
                                                "sense_id": "72bd4c58-80b0-3b37-a138-36cf8538c86d",
                                                "text": "Boots kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "f8cf9a06-78e1-4f46-9d22-3c7bf0e13617",
                                                "sense_id": "72bd4c58-80b0-3b37-a138-36cf8538c86d",
                                                "text": "An verregneten Herbsttagen ist Familie Boots liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "ede2e5a4-12ce-4ab8-8c50-a650e34be677",
                                                "sense_id": "72bd4c58-80b0-3b37-a138-36cf8538c86d",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Boot das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
