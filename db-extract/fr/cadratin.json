                                            {
                                                "example_id": "80cb87cf-8241-4493-b435-a6d9f4f91217",
                                                "sense_id": "9f9fab29-79cf-3f15-9617-d52fc934b727",
                                                "text": "Sneeuw is wit, doordat alle ijskristallen op elkaar zijn gestapeld, over elkaar heen gegooid en neer zijn gedwarreld."
                                            },
                                            {
                                                "example_id": "05515ce5-d86d-4575-9dbc-0c938a805d64",
                                                "sense_id": "9f9fab29-79cf-3f15-9617-d52fc934b727",
                                                "text": "De zwart verkoolde buitenkant omhulde zacht, wit vlees."
                                            },
