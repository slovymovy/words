                            {
                                "example_id": "334b1313-e994-431f-9b2c-b9667289cc77",
                                "sense_id": "98b49b79-c137-3402-9662-2720661eb22a",
                                "text": "even in its urban heart, Eugene is more treed than paved."
                            },
                            {
                                "example_id": "91c39bbb-2ec7-40e0-af13-d6307d1dff1a",
                                "sense_id": "98b49b79-c137-3402-9662-2720661eb22a",
                                "text": "This lends support for the view, propounded to me by landowners in east central Alberta, that the region is now more treed than when it was homesteaded."
                            },
                            {
                                "example_id": "ef7f7113-260e-4126-bfc3-5562096118e1",
                                "sense_id": "98b49b79-c137-3402-9662-2720661eb22a",
                                "text": "Crete is now more wooded (and vastly more treed) than at any time for at least seven hundred years."
                            }
                        ]
