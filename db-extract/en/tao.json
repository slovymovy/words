                        "entry_id": "848b6744-3c44-3907-ba5b-d42a430777b1",
                        "glosses": [
                            "Alternative letter-case form of Tao: the way of nature or way to live one's life."
                        ],
                        "tags": [
                            "Chinese",
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e03f39e3-7a2b-49cc-8b68-7732f72fe658",
                                "sense_id": "2cea9bf0-5e99-36f2-a1c9-5f24f7d5f955",
                                "text": "The tao of Lao Tzu was a cosmic tao, inner and unwritten, a tao of Nature, while the tao of Confucius was moral and written."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
