                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0082655e-b189-4090-b655-28960fce2ff0",
                                "sense_id": "5d50d860-9b28-3341-899c-fe3e7b46932b",
                                "text": "L'autre elle m'fait golri c'est tous des cheums avec des vieilles têtes, on dirait ils ont été ratés dans le ventre de leur mère."
                            },
                            {
                                "example_id": "0a2afb85-694a-44ae-861d-412eb5730577",
                                "sense_id": "5d50d860-9b28-3341-899c-fe3e7b46932b",
                                "text": "— C'est portenawaque, votre histoire de bi! arrête de m’faire golri ! Pour ouam, y'a pas d’timinik : ou t’aimes zober les teuches ou tu kiffes le zboub."
                            },
                            {
                                "example_id": "6899abed-e506-4b69-bc3b-76e4972a9bc9",
                                "sense_id": "5d50d860-9b28-3341-899c-fe3e7b46932b",
                                "text": "– Vazi, pourquoi un truc te fait golri ? lui demanda-t-il.\n– Pourquoi ?\n– Ouais.\n– C'est drôle, c'est tout. Ou c'est pas drôle."
                            }
                        ]
                    }
