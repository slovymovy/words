        "fr-extract.jsonl": [
            {
                "entry_id": "1c394cff-c0b7-384f-ad5d-cc9fb8c21e45",
                "word": "lassi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "425bc8b4-8f9a-4a95-9524-639ede25295d",
                        "entry_id": "1c394cff-c0b7-384f-ad5d-cc9fb8c21e45",
                        "tags": [
