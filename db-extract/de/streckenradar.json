                ],
                "senses": [
                    {
                        "sense_id": "4ee5ac50-0080-353b-987a-075b5c126ef6",
                        "entry_id": "e0755464-28b9-327e-b595-7cd98250a05b",
                        "glosses": [
                            "Anlage, welche die Geschwindigkeit von Fahrzeugen auf Straßen über eine längere Strecke (beispielsweise drei Kilometer) messen und Übertretungen der Durchschnittsgeschwindigkeit festhalten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60c86e34-45c3-406e-92db-8a068fd5df9f",
                                "sense_id": "4ee5ac50-0080-353b-987a-075b5c126ef6",
                                "text": "„Nach vierwöchiger Testphase wird das bundesweit erste Streckenradar bei Hannover offiziell in Betrieb genommen.“"
                            },
                            {
                                "example_id": "60ced535-f799-4a6f-8544-24cee5e5e701",
                                "sense_id": "4ee5ac50-0080-353b-987a-075b5c126ef6",
                                "text": "In Österreich werden Streckenradare schon jahrelang eingesetzt."
                            },
                            {
                                "example_id": "7e26afbd-6d64-47ed-a29d-67da2590d7ea",
                                "sense_id": "4ee5ac50-0080-353b-987a-075b5c126ef6",
                                "text": "\"Vier Wochen lang war das Streckenradar, das auch als \"Section Control\" bezeichnet wird, bereits getestet worden. Die nun beginnende Erprobungsphase soll bis 2020 dauern.\""
                            },
                            {
                                "example_id": "d1ea9475-de59-4313-b8d0-2cf80847b492",
                                "sense_id": "4ee5ac50-0080-353b-987a-075b5c126ef6",
                                "text": "„Auf der B6 bei Laatzen (Region Hannover) hat die Erprobungsphase des bundesweit ersten Streckenradars begonnen.“"
                            },
                            {
                                "example_id": "de754c38-18b0-4d84-a21e-3f5dc5a53d4f",
                                "sense_id": "4ee5ac50-0080-353b-987a-075b5c126ef6",
                                "text": "„An der Bundesstraße 6 südlich von Hannover werden nun Streckenradare, auch Abstandsradare genannt, eingesetzt.“"
                            },
                            {
                                "example_id": "390b56e3-5a6b-4050-8ef9-a83b5b57eb16",
                                "sense_id": "4ee5ac50-0080-353b-987a-075b5c126ef6",
                                "text": "„An der B6 bei Hannover müssen zu schnelle Autofahrer, die vom Streckenradar erfasst werden, nun mit einem Strafzettel rechnen.“"
                            },
                            {
                                "example_id": "cefa34c9-a711-4094-86d2-bf05f0c2beae",
                                "sense_id": "4ee5ac50-0080-353b-987a-075b5c126ef6",
                                "text": "„Das bundesweit erste Streckenradar zur Kontrolle des Tempolimits auf einem längeren Straßenabschnitt ist am Mittwoch bei Hannover in Betrieb gegangen. Überwacht wird ein 2,2 Kilometer langer Abschnitt der Bundesstraße 6 bei Laatzen, den 15.500 Autos täglich passieren und auf dem es in der Vergangenheit schwere Unfälle gab.“"
                            },
                            {
                                "example_id": "591f6a86-7677-449b-a04b-0f8d404ed6e5",
                                "sense_id": "4ee5ac50-0080-353b-987a-075b5c126ef6",
                                "text": "„Nach erfolgreicher technischer Erprobung geht das erste Streckenradar bei Hannover in den Alltagsbetrieb. Ab Montag drohen Strafzettel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
