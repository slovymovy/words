                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students stood <w>stiffly</w> during the national anthem.",
                            "target_lang_translations": {
                                "zh": "奏国歌时，学生们<w>僵硬地</w>站着。"
                            }
                        },
                        {
                            "text": "She replied <w>stiffly</w> to his question because she was still angry.",
                            "target_lang_translations": {
                                "zh": "因为还在生气，她<w>冷淡地</w>回答了他的问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rigidly",
                        "formally",
                        "coldly"
                    ],
                    "antonyms": [
                        "loosely",
                        "informally",
                        "warmly"
                    ],
                    "common_phrases": [
                        "stand stiffly",
                        "reply stiffly",
                        "behave stiffly"
                    ],
                    "target_lang_definitions": {
                        "zh": "以僵硬、拘谨或缺乏自然和友好的方式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "僵硬地",
