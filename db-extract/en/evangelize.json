                    },
                    {
                        "sense_id": "34e68d76-01b2-387f-a99a-66c2c7ffdb19",
                        "entry_id": "632e1613-847b-355c-ae02-b7a92037b620",
                        "glosses": [
                            "To preach any ideology to those who have not yet been converted to it."
                        ],
                        "tags": [],
                        "examples": [
                            {
