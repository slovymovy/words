                                        "glosses": [
                                            "Personne qui fabrique ou qui vend des instruments d’optique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47554a70-d4e8-402b-ab6b-c472bafb9476",
                                                "sense_id": "2b080de4-d50c-31fd-bcb7-70635067b634",
                                                "text": "L’opticien demeure un professionnel guidant le client et le conseillant."
                                            },
                                            {
                                                "example_id": "48cf68b2-b70e-432f-8413-c949c3675f0c",
                                                "sense_id": "2b080de4-d50c-31fd-bcb7-70635067b634",
                                                "text": "Les opticiens se sont acharnés pendant plus de 60 ans à corriger ces multiples aberrations avec plus ou moins de bonheur ; mais c'est seulement vers 1890, époque où apparurent les premiers anastigmats, qu'ils purent présenter une solution satisfaisante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38f1749b-c3cd-4c1d-b55e-5b45164257e6",
                        "source_entry_id": "520ca472-8bab-38e6-87cd-e32ecd27ba4b",
