{
    "word_family": [
        "słuch",
        "słuchać",
        "usłyszeć",
        "słyszalny",
        "słuchacz",
        "słuchawka"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb0dbba4-36e8-3e35-b2c3-79b18162b6d0",
                    "sense_definition": "odbierać dźwięk za pomocą zmysłu słuchu",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "percepcja-sluchowa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy ty <w>słyszysz</w>, co do ciebie mówię?",
                            "target_lang_translations": {
                                "ru": "Ты <w>слышишь</w>, что я тебе говорю?",
                                "en": "Do you <w>hear</w> what I am saying to you?"
                            }
                        },
                        {
                            "text": "Nagle zacząłem <w>słyszeć</w> dziwne dźwięki dochodzące z piwnicy.",
                            "target_lang_translations": {
                                "ru": "Вдруг я начал <w>слышать</w> странные звуки, доносящиеся из подвала.",
                                "en": "Suddenly I started to <w>hear</w> strange sounds coming from the basement."
                            }
                        }
                    ],
                    "common_phrases": [
                        "słyszeć dziwne dźwięki",
                        "słyszeć głos"
                    ],
                    "target_lang_definitions": {
                        "ru": "воспринимать звук с помощью слуха",
                        "en": "To perceive sound with the sense of hearing"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слышать",
                                "target_lang_sense_clarification": "воспринимать звуки"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "hear",
                                "target_lang_sense_clarification": "perceive sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb350e69-2796-32d9-895f-a9a3ac4a0fca",
                    "sense_definition": "dowiadywać się o czymś, otrzymywać jakieś wiadomości",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "informacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy <w>słyszałeś</w> o tym nowym filmie, który grają w kinach?",
                            "target_lang_translations": {
                                "ru": "Ты <w>слышал</w> о новом фильме, который сейчас идет в кинотеатрах?",
                                "en": "Have you <w>heard</w> about that new movie playing in theaters?"
                            }
                        },
                        {
                            "text": "Często <w>słyszę</w> o jego sukcesach w pracy.",
                            "target_lang_translations": {
                                "ru": "Я часто <w>слышу</w> о его успехах на работе.",
                                "en": "I often <w>hear</w> about his successes at work."
                            }
                        }
                    ],
                    "synonyms": [
                        "dowiadywać się"
                    ],
                    "common_phrases": [
                        "słyszeć o czymś"
                    ],
                    "target_lang_definitions": {
                        "ru": "узнавать о чем-либо, получать какие-либо известия",
                        "en": "To find out about something, to receive news or information"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слышать",
                                "target_lang_sense_clarification": "получать информацию, узнавать по слухам"
                            },
                            {
                                "target_lang_word": "слыхать",
                                "target_lang_sense_clarification": "разговорное, о новостях"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "hear",
                                "target_lang_sense_clarification": "receive information or news"
                            },
                            {
                                "target_lang_word": "hear about",
                                "target_lang_sense_clarification": "be informed of something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b1e2d87-ef9c-3781-873c-d9ce9c037abe",
                    "sense_definition": "mieć zdolność odbierania dźwięków, nie być głuchym",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "percepcja-sluchowa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój dziadek ma już osiemdziesiąt lat, ale wciąż bardzo dobrze <w>słyszy</w>.",
                            "target_lang_translations": {
                                "ru": "Моему дедушке уже восемьдесят лет, но он все еще очень хорошо <w>слышит</w>.",
                                "en": "My grandfather is already eighty years old, but he still <w>hears</w> very well."
                            }
                        },
                        {
                            "text": "Lekarz zapytał pacjenta, czy ten <w>słyszy</w> na lewe ucho.",
                            "target_lang_translations": {
                                "ru": "Врач спросил пациента, <w>слышит</w> ли тот левым ухом.",
                                "en": "The doctor asked the patient if he could <w>hear</w> with his left ear."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dobrze słyszeć"
                    ],
                    "target_lang_definitions": {
                        "ru": "обладать способностью воспринимать звуки, не быть глухим",
                        "en": "To have the ability to perceive sounds, not to be deaf"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слышать",
                                "target_lang_sense_clarification": "иметь слух"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "hear",
                                "target_lang_sense_clarification": "have the faculty of hearing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d99decf4-3c81-395c-a275-77ae3a6330a5",
                    "sense_definition": "słyszeć się nawzajem (w odniesieniu do dwóch lub więcej osób)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "percepcja-sluchowa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Połączenie telefoniczne było tak złe, że ledwo się <w>słyszeliśmy</w>.",
                            "target_lang_translations": {
                                "ru": "Телефонная связь была настолько плохой, что мы едва <w>слышали друг друга</w>.",
                                "en": "The phone connection was so bad that we could barely <w>hear</w> each other."
                            }
                        },
                        {
                            "text": "Mów głośniej, bo w tym hałasie w ogóle się nie <w>słyszymy</w>.",
                            "target_lang_translations": {
                                "ru": "Говори громче, потому что в этом шуме мы вообще друг друга не <w>слышим</w>.",
                                "en": "Speak louder, because in this noise we can't <w>hear</w> each other at all."
                            }
                        }
                    ],
                    "common_phrases": [
                        "słyszeć się nawzajem"
                    ],
                    "target_lang_definitions": {
                        "ru": "слышать друг друга (о двух или более людях)",
                        "en": "To hear each other (referring to two or more people)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слышать друг друга",
                                "target_lang_sense_clarification": "взаимно воспринимать голоса"
                            },
                            {
                                "target_lang_word": "слышаться",
                                "target_lang_sense_clarification": "о взаимной слышимости"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "hear each other",
                                "target_lang_sense_clarification": "mutually perceive each other's voices"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}