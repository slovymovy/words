                "senses": [
                    {
                        "sense_id": "cbba3d3a-c58e-339c-aeb9-fa33be6f9fd8",
                        "entry_id": "00710eff-55be-3d25-9c16-98177a93558c",
                        "glosses": [
                            "A bird's coo, especially that of a dove."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce8c6a08-fa34-4854-a8dd-ef902afec657",
                                "sense_id": "cbba3d3a-c58e-339c-aeb9-fa33be6f9fd8",
                                "text": "[A]nd no sound falls on my ears, except the distant roar of a passing train, the song of linnets, and croodle of turtle-dove and cushat."
                            },
                            {
                                "example_id": "cf7e716b-28e4-406e-92ec-5458158c6217",
                                "sense_id": "cbba3d3a-c58e-339c-aeb9-fa33be6f9fd8",
                                "text": "[A] third-storey apartment under the eaves loud with the croodles and canoodling of amorous pigeons."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
