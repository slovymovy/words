                "senses": [
                    {
                        "sense_id": "7c2c02c9-76a8-378c-b139-b0eaf6f326f7",
                        "entry_id": "f57080c3-e1e5-3a40-bb73-0afd11b9223c",
                        "glosses": [
                            "Malfaitrice vagabonde et armée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5c91975-b013-4ab9-864e-730348419bd9",
                                "sense_id": "7c2c02c9-76a8-378c-b139-b0eaf6f326f7",
                                "text": "Ah ! la bandite ! L’aigrefine ! La canailloute ! Si je l’attrape, patron, je l’écrabouille comme un mégot sous mon pied !"
                            },
                            {
                                "example_id": "99d0d8bf-3533-4b36-96d8-8d6b8c398589",
                                "sense_id": "7c2c02c9-76a8-378c-b139-b0eaf6f326f7",
                                "text": "T’t’a l’heure, elle voraçait avec tellement tant de fougue, qu’elle a failli me décasquer le guerrier, la bandite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c23b386-506f-4d2f-aa76-4772e2486e05",
                        "source_entry_id": "f57080c3-e1e5-3a40-bb73-0afd11b9223c",
                        "source_sense_id": "7c2c02c9-76a8-378c-b139-b0eaf6f326f7",
