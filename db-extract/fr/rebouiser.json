                "senses": [
                    {
                        "sense_id": "735424ea-9ec3-3357-9622-07f8130b377d",
                        "entry_id": "e4dc7ad3-f8a6-3e2d-a9a4-b9b136bfd633",
                        "glosses": [
                            "Redonner du lustre à (un chapeau, en particulier)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7de1b1f3-8f00-4e4e-8ebc-2f0705540b61",
                                "sense_id": "735424ea-9ec3-3357-9622-07f8130b377d",
                                "text": "Tiens, c’est passé ! fais venir l’habilleux ; qu’on me rebouise mes pelures, et puis tu me paieras un autre bracelet, pas vrai, chéri."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdc55332-1e4b-3fc5-90d6-dded41642794",
                        "entry_id": "e4dc7ad3-f8a6-3e2d-a9a4-b9b136bfd633",
                        "glosses": [
                            "Passer une semelle au bouis ou buis."
                        ],
                        "tags": [
                            "Cordonnerie"
                        ],
                        "examples": [
                            {
                                "example_id": "d5622e10-97e4-49c4-9ae2-d83f86622906",
                                "sense_id": "bdc55332-1e4b-3fc5-90d6-dded41642794",
                                "text": "Les vieux seuls s’en tiennent à la tradition, et, s’ils posent une demi-semelle, ils la rebouisent"
                            }
                        ]
                    },
                    {
                        "sense_id": "ccb6eb4d-ab0c-3a79-bef9-5a6148498443",
                        "entry_id": "e4dc7ad3-f8a6-3e2d-a9a4-b9b136bfd633",
                        "glosses": [
                            "Reluquer, regarder."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "bdcb7c49-51ff-4dee-bec2-f9868baf75d2",
                                "sense_id": "ccb6eb4d-ab0c-3a79-bef9-5a6148498443",
                                "text": "On en rembroquerait, des choses ! Dom Bougre en personne n’en a jamais tant rebouisé."
                            }
                        ]
                    }
                ],
