                "senses": [
                    {
                        "sense_id": "0ecacabd-3d75-3154-9dc5-a4069a35293b",
                        "entry_id": "fc60d24a-7b87-3b85-b0b2-ad3495ee4e54",
                        "glosses": [
                            "Ensemble des insectes cultivés pour l’alimentation humaine (et animale)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cc1eb2d-4952-4107-9e7a-b470b965f8bd",
                                "sense_id": "0ecacabd-3d75-3154-9dc5-a4069a35293b",
                                "text": "\"Nous avons besoin de sources de protéines alternatives, et les insectes en sont une\", estime Paul Vantomme […] Les espèces les plus productives pourraient donc devenir une sorte de « mini-bétail »."
                            },
                            {
                                "example_id": "0578c6be-352a-4cdb-9e35-3b4bd29b1e58",
                                "sense_id": "0ecacabd-3d75-3154-9dc5-a4069a35293b",
                                "text": "La FAO et l'ONU envisagent l’élevage d’insectes pour nourrir hommes et animaux. Car ce « minibétail » a de réels atouts […]."
                            },
                            {
                                "example_id": "55e435db-c0f9-43d4-9746-387a52878a94",
                                "sense_id": "0ecacabd-3d75-3154-9dc5-a4069a35293b",
                                "text": "Malgré les appréhensions, ce « mini-bétail » présente de nombreuses vertus. En plus d’être très nutritifs – les insectes ont une teneur élevée en protéines, matières grasses et minéraux – , ils ont un besoin moindre en ressources […]."
                            }
                        ]
                    }
                ],
