                "senses": [
                    {
                        "sense_id": "1ff28d87-9cc7-3456-b094-772d02dc9839",
                        "entry_id": "581439fa-0ab8-3125-ae31-9f75a67380a6",
                        "glosses": [
                            "vooral van een weg dat er geen stenen of asfalt toplaag is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3f55521-c791-4bc6-9ef3-5d36220bef30",
                                "sense_id": "1ff28d87-9cc7-3456-b094-772d02dc9839",
                                "text": "Het is moeilijk om te fietsen op deze onverharde weg."
                            },
                            {
                                "example_id": "6ee9fd5f-3d6e-40be-acff-f5ae7039cfc5",
                                "sense_id": "1ff28d87-9cc7-3456-b094-772d02dc9839",
                                "text": "Het is buiten de kwelzucht van de parcoursbouwers gerekend. Hier lag de afgelopen drie keer de eindstreep, maar verderop hebben ze een onverhard pad laten aanleggen. Nog wat verder omhoog, heren!"
                            },
                            {
                                "example_id": "b25780f2-2c18-4be1-91c4-248901ce79a6",
                                "sense_id": "1ff28d87-9cc7-3456-b094-772d02dc9839",
                                "text": "Het was al donker toen ik een onverharde weg passeerde waar een aantal eenpersoonstenten in de berm stonden."
                            }
                        ]
                    }
