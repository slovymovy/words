                "senses": [
                    {
                        "sense_id": "4913d9ba-ce6f-3b0f-b18c-e386fbd2195f",
                        "entry_id": "95153502-0062-3511-91d0-e3b197e48a0c",
                        "glosses": [
                            "gekünsteltes Benehmen, Verhalten"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "a72b0e66-b3c3-4554-9195-b06448eb2d23",
                                "sense_id": "4913d9ba-ce6f-3b0f-b18c-e386fbd2195f",
                                "text": "Er hatte ihr Getue satt und ging."
                            },
                            {
                                "example_id": "08238162-c148-4bf0-a5b6-6edcbc064e47",
                                "sense_id": "4913d9ba-ce6f-3b0f-b18c-e386fbd2195f",
                                "text": "Die Elektrizität tut all dies mit weniger Aufwand und Getue, weniger Nebenwirkungen als jede andere Energiequelle."
                            },
                            {
                                "example_id": "12bd390b-ad06-4915-b429-d393e3965d75",
                                "sense_id": "4913d9ba-ce6f-3b0f-b18c-e386fbd2195f",
                                "text": "„Er war vielmehr durchaus sehr beeindruckt von dem ganzen Getue um Männlichkeit und Härte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
