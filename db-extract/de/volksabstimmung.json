                "senses": [
                    {
                        "sense_id": "ae42308b-db6a-36e7-b650-5af05fa06bce",
                        "entry_id": "46a9839d-4207-3fd9-b024-3b28ba9c8225",
                        "glosses": [
                            "Référendum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "608942a0-16d1-4beb-83ea-12709def07da",
                                "sense_id": "ae42308b-db6a-36e7-b650-5af05fa06bce",
                                "text": "eine Volksabstimmung abhalten — organiser un référendum"
                            },
                            {
                                "example_id": "55db55ee-81f6-4ff4-a222-351b7f87f466",
                                "sense_id": "ae42308b-db6a-36e7-b650-5af05fa06bce",
                                "text": "Die Grünen rechnen mit weit höheren Baukosten für Stuttgart 21 und wollen das Vorhaben mit einer Volksabstimmung zu Fall bringen.",
                                "translation": "Les Verts s’attendent à des coûts élevés pour la construction du Stuttgart 21 et veulent condamner le projet lors d’un référendum."
                            },
                            {
                                "example_id": "fc8a0413-9bd2-42eb-a255-f5bae2a73a52",
                                "sense_id": "ae42308b-db6a-36e7-b650-5af05fa06bce",
                                "text": "Bei einer ersten Volksabstimmung 2014 hatte sich eine Mehrheit der Schotten für den Verbleib in der Union mit Großbritannien ausgesprochen.",
                                "translation": "Lors d’un premier référendum en 2014, une majorité d'Écossais s’était prononcée en faveur du maintien dans l'union avec la Grande-Bretagne."
                            }
                        ]
                    }
