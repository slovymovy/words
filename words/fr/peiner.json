    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4788e4d4-709d-315f-a73f-b0259782e9c0",
                    "sense_definition": "Causer du chagrin, faire de la peine ou attrister quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son départ précipité a beaucoup <w>peiné</w> tous ses collègues de bureau."
                        },
                        {
                            "text": "Cela me <w>peine</w> de constater que tu traverses une épreuve aussi difficile."
                        }
                    ],
                    "synonyms": [
                        "chagriner"
                    ]
                },
                {
                    "sense_id": "7206d323-5848-3548-9881-632ef290474d",
                    "sense_definition": "Avoir de la difficulté ou éprouver un empêchement à accomplir une action.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue marche en montagne, l'enfant <w>peine</w> à garder les yeux ouverts."
                        },
                        {
                            "text": "Les négociateurs <w>peinent</w> à trouver un accord satisfaisant pour tout le monde."
                        }
                    ],
                    "common_phrases": [
                        "peiner à trouver",
                        "peiner à croire"
                    ]
                },
                {
                    "sense_id": "bb3cc6a8-d00e-34b3-88f5-1c507a2c1e7a",
                    "sense_definition": "Fournir des efforts soutenus et épuisants dans un travail pénible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers agricoles ont <w>peiné</w> toute la journée sous une chaleur accablante."
                        },
                        {
                            "text": "Il a longtemps <w>peiné</w> sur ce projet complexe avant d'obtenir des résultats."
                        }
                    ],
                    "common_phrases": [
                        "peiner à la tâche"
                    ]
                },
                {
                    "sense_id": "77fd00b4-35d8-3164-ab6a-66474063ec1b",
                    "sense_definition": "Subir une contrainte mécanique excessive sous une charge trop lourde.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux moteur du tracteur <w>peine</w> dès que la montée devient trop raide."
                        },
                        {
                            "text": "Cette poutre maîtresse <w>peine</w> visiblement sous la masse imposante du toit restauré."
                        }
                    ]
                }
            ]
        }
    ]
}