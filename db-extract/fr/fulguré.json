                "senses": [
                    {
                        "sense_id": "3a4305a6-5729-3972-96d3-cbea020667dc",
                        "entry_id": "a79fee9f-4a3b-392a-a415-bd2377f5aa38",
                        "glosses": [
                            "Celui qui a survécu à un foudroiement."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "a8d2b8a2-9f34-4bb9-8ffc-3fbed2ec08e3",
                                "sense_id": "3a4305a6-5729-3972-96d3-cbea020667dc",
                                "text": "Chez le fulguré, au contraire, on conçoit qu'après quelques minutes les battements du cœur puissent reparaître et renvoyer du sang artériel aux centres nerveux engourdis on conçoit que, dans de telles conditions, ceux-ci puissent sortir de leur torpeur et revenir à l'activité."
                            },
                            {
                                "example_id": "553b4273-352b-41be-ae55-c6e89e97ce7a",
                                "sense_id": "3a4305a6-5729-3972-96d3-cbea020667dc",
                                "text": "On dirait que les fulgurés ont été pour eux, comme pour le public ignorant et superstitieux, des réprouvés, frappés justement par la colère divine, en punition de leurs péchés apparents ou cachés, […]."
                            }
                        ]
                    }
