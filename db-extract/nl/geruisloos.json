                        "glosses": [
                            "zonder geluid te maken, geluidloos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c5cd538-a09f-4b3e-a016-496a9500af89",
                                "sense_id": "b45bf546-74cd-3cc4-82b7-7b42eafe981c",
                                "text": "Zo stil mogelijk ging ik rechtop in mijn slaapzak zitten en probeerde mijn overvolle blaas geruisloos te legen."
                            }
                        ]
                    },
                    {
                        "sense_id": "dcca926f-aaa2-30aa-8beb-457b25d79ccc",
                        "entry_id": "e1f29950-e89f-3a4e-ab13-a58afdfb5edb",
                        "glosses": [
                            "zonder veel aandacht te trekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2284caba-0d27-4d45-8393-9c1ab819b351",
                                "sense_id": "dcca926f-aaa2-30aa-8beb-457b25d79ccc",
                                "text": "de maffia bleek in staat zijn tegenstanders op geruisloze te laten verdwijnen"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01ff91cd-d632-4931-872a-21d2a1b5bf8c",
                        "source_entry_id": "e1f29950-e89f-3a4e-ab13-a58afdfb5edb",
                        "target_lang_word": "noiseless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noiseless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24c58ced-7424-303d-a66f-6dfbf5cb5c03",
                                        "entry_id": "6a2e9659-704e-35ba-b1fc-6576c9857edb",
                                        "glosses": [
                                            "Producing no noise; without noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6165c3d-21b1-423c-b36b-a58a859b25d6",
                                                "sense_id": "24c58ced-7424-303d-a66f-6dfbf5cb5c03",
                                                "text": "The movements of the cat were noiseless as it approached the mousehole."
                                            },
                                            {
                                                "example_id": "0d1e8301-ce1e-4323-8559-adedd4167889",
                                                "sense_id": "24c58ced-7424-303d-a66f-6dfbf5cb5c03",
                                                "text": "For by the hearth the children sit\n⁠Cold in that atmosphere of Death,\n⁠And scarce endure to draw the breath,\nOr like to noiseless phantoms flit:\nBut open converse is there none, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47a74073-a385-32a9-9d5d-be68c2755c38",
                                        "entry_id": "6a2e9659-704e-35ba-b1fc-6576c9857edb",
                                        "glosses": [
                                            "Containing no noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1fb7c27-2bba-4071-bfd5-6f5d3b889afb",
                                                "sense_id": "47a74073-a385-32a9-9d5d-be68c2755c38",
                                                "text": "The core idea of the Nostega paradign is basically camouflaging messages by embedding them in a form of noiseless data by employing either altered authenticated data or legitimate untraceable data, as shown in Section 1.3."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
