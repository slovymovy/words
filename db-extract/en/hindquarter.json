                    {
                        "translation_id": "62d2a3ca-af11-4446-bbaa-098050500d7e",
                        "source_entry_id": "614eea02-b5d8-348b-beb0-bd5978ea99e9",
                        "source_sense_description": "human behind",
                        "target_lang_word": "achterwerk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achterwerk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3c1a38e3-a61a-3b40-a811-20a762987dd1",
                                        "entry_id": "3139c7ae-3230-39d3-9b28-2e5477ee8e2f",
                                        "glosses": [
                                            "achterste deel"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7247c99f-ab90-348e-903d-ed98bb3efb23",
                                        "entry_id": "3139c7ae-3230-39d3-9b28-2e5477ee8e2f",
                                        "glosses": [
                                            "zitvlak, achterste, billen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "037f8d06-94f0-415f-bb73-e77fc2696ee4",
                                                "sense_id": "7247c99f-ab90-348e-903d-ed98bb3efb23",
                                                "text": "Ik viel op mijn achterwerk"
                                            },
                                            {
                                                "example_id": "0d60f131-28e8-4604-aef4-8b4ea55ce698",
                                                "sense_id": "7247c99f-ab90-348e-903d-ed98bb3efb23",
                                                "text": "Er stond dus geen ramp aan te komen, en dus konden de stormtroepers en dergelijke figuren hun achterwerk afvegen met hun bovenarmbanden, vrouwen mishandelen en in het algemeen irritant zijn, maar meer ook niet."
                                            },
                                            {
                                                "example_id": "61a5eda9-c6ae-4d5c-9ae6-3cbbc2cf042d",
                                                "sense_id": "7247c99f-ab90-348e-903d-ed98bb3efb23",
                                                "text": "Ze zet haar handen in haar zij en drukt haar buik naar voren, waardoor haar achterwerk en haar rug één stuk worden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "350d5150-3fce-3e00-a5d3-4858a2c18504",
                                        "entry_id": "3139c7ae-3230-39d3-9b28-2e5477ee8e2f",
                                        "glosses": [
                                            "het houtsnijwerk dat de achtersteven van een schip sierde"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0eeb963c-42fa-47cf-bcca-4f9f3ba2d611",
                        "source_entry_id": "614eea02-b5d8-348b-beb0-bd5978ea99e9",
                        "source_sense_description": "human behind",
                        "target_lang_word": "achterste",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achterste",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "790b2971-cec6-36b7-8423-c06faec8f917",
                                        "entry_id": "e7a35f70-7d18-35ae-b6a9-9fc55b18acc0",
                                        "glosses": [
                                            "zitvlak, bips"
                                        ],
                                        "tags": [
                                            "neuter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b6d6849-6840-432b-8e1e-a8477580686c",
                                                "sense_id": "790b2971-cec6-36b7-8423-c06faec8f917",
                                                "text": "Hij viel wat ongelukkig op zijn achterste."
                                            },
                                            {
                                                "example_id": "84dfb1ca-2e18-438c-aefa-2075da5fc3d2",
                                                "sense_id": "790b2971-cec6-36b7-8423-c06faec8f917",
                                                "text": "Dan liep hij naar de wc om zijn blaas te legen, of naar de koelkast om een blikje te pakken, een boer te laten, zijn achterste van de stoel te tillen en de jeukende plek te krabben."
                                            },
                                            {
                                                "example_id": "ca79f0e1-a1af-498f-a7bc-34165108323c",
                                                "sense_id": "790b2971-cec6-36b7-8423-c06faec8f917",
                                                "text": "Ik liep als het ware met een rasp in mijn achterste (chafing noemen ze dat in Amerika) wat verschrikkelijk veel pijn deed, het was alsof ik in brand stond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f87d9b5b-99b1-3d3a-8d61-ca990248db2a",
                                        "entry_id": "e7a35f70-7d18-35ae-b6a9-9fc55b18acc0",
                                        "glosses": [
                                            "wie of wat het laatst in een rij is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2837c470-1730-4b9f-95bf-335fc591cce7",
                                                "sense_id": "f87d9b5b-99b1-3d3a-8d61-ca990248db2a",
                                                "text": "De achtersten werden het ergste getroffen door de aanval van de achtervolgers."
                                            }
                                        ]
                                    }
                                ]
                            },
