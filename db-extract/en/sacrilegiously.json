                                            {
                                                "example_id": "7bcc0bbb-0342-435e-8369-e1fcbcb08114",
                                                "sense_id": "c359b335-7cf9-3957-b055-96f762cd76b7",
                                                "text": "Il [Pasquier] dit que Childéric, roi de France, s’étant réfugié vers le roi de Thuringe, devint amoureux de sa femme, laquelle, dit-il, il ravit, et, l’amenant en France, l’épousa sacrilégement, violant le droit d’hospitalité, et que de ce mariage naquit Clovis."
                                            },
                                            {
                                                "example_id": "31581c79-ac59-478b-95fb-68fa1411e2b8",
                                                "sense_id": "c359b335-7cf9-3957-b055-96f762cd76b7",
                                                "text": "Le pape Jean ne douta pas que Photius ne fût intrus et sacrilégement ordonné."
                                            }
                                        ]
                                    }
                                ]
