{
    "word_family": [
        "курсовой",
        "сокурсник",
        "однокурсник",
        "первокурсник",
        "курсант"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "705b1f1e-be91-37bf-a665-f51f560000d5",
                    "sense_definition": "Год или ступень обучения в высшем или среднем специальном учебном заведении.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "education_year",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой старший брат учится на третьем <курсе> университета.",
                            "target_lang_translations": {
                                "en": "My older brother is in his third <year> of university.",
                                "zh": "我哥哥在大学读大三，也就是第三<w>年级</w>。"
                            }
                        },
                        {
                            "text": "Студенты первого <курса> должны получить читательские билеты.",
                            "target_lang_translations": {
                                "en": "First-<year> students must get their library cards.",
                                "zh": "大一<w>年级</w>的学生必须领取借书证。"
                            }
                        }
                    ],
                    "synonyms": [
                        "год"
                    ],
                    "common_phrases": [
                        "на первом курсе",
                        "студент второго курса",
                        "староста курса"
                    ],
                    "target_lang_definitions": {
                        "en": "A year or level of study in a higher or secondary specialized educational institution.",
                        "zh": "在高等或中等专业教育机构中学习的年份或阶段。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "year",
                                "target_lang_sense_clarification": "academic level"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "年级",
                                "target_lang_sense_clarification": "学术阶段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1795d2af-9c73-368d-ad32-591657cef164",
                    "sense_definition": "Цена денежной единицы одной страны, выраженная в денежных единицах другой страны или в ценных бумагах.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из-за кризиса <курс> доллара резко вырос.",
                            "target_lang_translations": {
                                "en": "Due to the crisis, the dollar <rate> rose sharply.",
                                "zh": "由于危机，美元<w>汇率</w>急剧上升。"
                            }
                        },
                        {
                            "text": "Мы внимательно следим за обменным <курсом> валют.",
                            "target_lang_translations": {
                                "en": "We are closely watching the currency exchange <rate>.",
                                "zh": "我们正在密切关注货币的<w>汇率</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "котировка",
                        "стоимость"
                    ],
                    "common_phrases": [
                        "обменный курс",
                        "курс валют",
                        "курс доллара",
                        "по курсу"
                    ],
                    "target_lang_definitions": {
                        "en": "The price of one country's currency expressed in the currency of another country or in securities.",
                        "zh": "一国货币单位以另一国货币单位或证券表示的价格。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rate",
                                "target_lang_sense_clarification": "financial value"
                            },
                            {
                                "target_lang_word": "exchange rate",
                                "target_lang_sense_clarification": "currency value"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "汇率",
                                "target_lang_sense_clarification": "货币兑换比率"
                            },
                            {
                                "target_lang_word": "价格",
                                "target_lang_sense_clarification": "金融价值"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d19a812a-1c14-3b56-af8f-6e866b60dba9",
                    "sense_definition": "Серия уроков, лекций или занятий по определённому предмету; законченный цикл обучения.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "education_training",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я записалась на вечерние <курсы> английского языка.",
                            "target_lang_translations": {
                                "en": "I signed up for evening English <courses>.",
                                "zh": "我报名参加了英语夜间<w>课程</w>。"
                            }
                        },
                        {
                            "text": "Профессор читает интересный <курс> лекций по истории.",
                            "target_lang_translations": {
                                "en": "The professor is giving an interesting <course> of lectures on history.",
                                "zh": "教授正在讲授一门有趣的关于历史的<w>课程</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "цикл",
                        "программа",
                        "предмет"
                    ],
                    "common_phrases": [
                        "курс лекций",
                        "подготовительные курсы",
                        "курсы повышения квалификации"
                    ],
                    "target_lang_definitions": {
                        "en": "A series of lessons, lectures, or classes on a specific subject; a completed cycle of study.",
                        "zh": "关于特定学科的一系列课程、讲座或教学活动；完整的学习周期。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "course",
                                "target_lang_sense_clarification": "education program"
                            },
                            {
                                "target_lang_word": "class",
                                "target_lang_sense_clarification": "series of lessons"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "课程",
                                "target_lang_sense_clarification": "教育项目"
                            },
                            {
                                "target_lang_word": "班",
                                "target_lang_sense_clarification": "系列教学活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c932a339-160b-398e-a427-3849b9d64621",
                    "sense_definition": "Состояние осведомлённости о чём-либо (используется в устойчивых выражениях).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "idiom_awareness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты вообще в <курсе>, что завтра у нас выходной?",
                            "target_lang_translations": {
                                "en": "Are you even <aware> that we have a day off tomorrow?",
                                "zh": "你到底<w>知道</w>明天我们放假吗？"
                            }
                        },
                        {
                            "text": "Пожалуйста, держи меня в <курсе> всех изменений.",
                            "target_lang_translations": {
                                "en": "Please keep me <informed> of all changes.",
                                "zh": "请让我随时<w>了解</w>所有的变动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "быть в курсе",
                        "держать в курсе",
                        "ввести в курс дела"
                    ],
                    "target_lang_definitions": {
                        "en": "A state of being informed about something (used in set phrases).",
                        "zh": "对某事物的知晓状态（用于固定搭配）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "aware",
                                "target_lang_sense_clarification": "in the phrase 'be aware'"
                            },
                            {
                                "target_lang_word": "informed",
                                "target_lang_sense_clarification": "kept up to date"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "知道",
                                "target_lang_sense_clarification": "了解情况"
                            },
                            {
                                "target_lang_word": "了解",
                                "target_lang_sense_clarification": "掌握信息"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02d263dd-bf15-3d11-a72f-e63c9b27758e",
                    "sense_definition": "Направление движения судна, самолёта или иного транспортного средства.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Капитан приказал взять <курс> на север.",
                            "target_lang_translations": {
                                "en": "The captain ordered to set a <course> for the north.",
                                "zh": "船长下令将<w>航向</w>定为北方。"
                            }
                        },
                        {
                            "text": "Самолёт отклонился от заданного <курса> из-за сильного ветра.",
                            "target_lang_translations": {
                                "en": "The plane deviated from the set <course> due to strong wind.",
                                "zh": "由于强风，飞机偏离了预定的<w>航向</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "направление",
                        "маршрут",
                        "путь"
                    ],
                    "common_phrases": [
                        "взять курс",
                        "сбиться с курса",
                        "менять курс"
                    ],
                    "target_lang_definitions": {
                        "en": "The direction of movement of a ship, aircraft, or other vehicle.",
                        "zh": "船舶、飞机或其他交通工具的移动方向。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "course",
                                "target_lang_sense_clarification": "navigation"
                            },
                            {
                                "target_lang_word": "heading",
                                "target_lang_sense_clarification": "direction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "航向",
                                "target_lang_sense_clarification": "导航方向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac5b58da-56cb-33e5-a997-7e777c764de8",
                    "sense_definition": "Законченный цикл лечебных процедур или приёма лекарств.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач назначил пациенту полный <курс> антибиотиков.",
                            "target_lang_translations": {
                                "en": "The doctor prescribed the patient a full <course> of antibiotics.",
                                "zh": "医生给病人开了完整的抗生素<w>疗程</w>。"
                            }
                        },
                        {
                            "text": "После операции необходимо пройти <курс> реабилитации.",
                            "target_lang_translations": {
                                "en": "After the surgery, it is necessary to undergo a rehabilitation <course>.",
                                "zh": "手术后必须进行一个<w>疗程</w>的康复训练。"
                            }
                        }
                    ],
                    "synonyms": [
                        "цикл"
                    ],
                    "common_phrases": [
                        "курс лечения",
                        "пройти курс",
                        "курс массажа"
                    ],
                    "target_lang_definitions": {
                        "en": "A completed cycle of medical treatments or medication intake.",
                        "zh": "完整的医疗程序或药物服用周期。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "course",
                                "target_lang_sense_clarification": "treatment cycle"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "疗程",
                                "target_lang_sense_clarification": "治疗周期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fe930f1-675a-3169-bd7e-d49f1bc47d86",
                    "sense_definition": "Основное направление политической или общественной деятельности.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "direction_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Правительство продолжает <курс> на модернизацию экономики.",
                            "target_lang_translations": {
                                "en": "The government continues the <course> toward economic modernization.",
                                "zh": "政府继续坚持经济现代化的<w>方针</w>。"
                            }
                        },
                        {
                            "text": "Новый президент изменил внешнеполитический <курс> страны.",
                            "target_lang_translations": {
                                "en": "The new president changed the country's foreign policy <course>.",
                                "zh": "新总统改变了该国的外交<w>路线</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "политика",
                        "линия",
                        "стратегия"
                    ],
                    "common_phrases": [
                        "политический курс",
                        "курс реформ",
                        "курс на сближение"
                    ],
                    "target_lang_definitions": {
                        "en": "The main direction of political or social activity.",
                        "zh": "政治或社会活动的主要方向。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "course",
                                "target_lang_sense_clarification": "strategy"
                            },
                            {
                                "target_lang_word": "policy",
                                "target_lang_sense_clarification": "political line"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "方针",
                                "target_lang_sense_clarification": "政治策略"
                            },
                            {
                                "target_lang_word": "路线",
                                "target_lang_sense_clarification": "政策方向"
                            }
                        ]
                    }
                }
            ]
        }
