                "senses": [
                    {
                        "sense_id": "ded2e17e-7768-3cb0-9492-a2a4b9a7371c",
                        "entry_id": "c9348ed1-1d45-3670-b33e-2852f3ba5feb",
                        "glosses": [
                            "ein Gerät, das aus Obst oder Gemüse den Fruchtsaft presst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "430e2f22-4f6a-41c5-801e-f24394b235ca",
                                "sense_id": "ded2e17e-7768-3cb0-9492-a2a4b9a7371c",
                                "text": "Der Entsafter presst den Fruchtsaft aus den Früchten."
                            },
                            {
                                "example_id": "6aa07e72-ba9a-4044-92ff-3779b76fb364",
                                "sense_id": "ded2e17e-7768-3cb0-9492-a2a4b9a7371c",
                                "text": "„Der alte Mann drückt noch einmal nach, so fest, dass sich eine vertikal verlaufende Ader auf seiner Stirn abzeichnet, dann öffnet er den Entsafter, und meine Mutter und ich starren auf die zerquetschte Frucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
