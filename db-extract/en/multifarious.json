                "senses": [
                    {
                        "sense_id": "5e2c1e69-b9e5-3575-8455-3021e28e3da4",
                        "entry_id": "61465c22-72a8-3853-b935-7ebc20081241",
                        "glosses": [
                            "Having great diversity or variety; of various kinds; made up of many differing parts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d56ba4f-9326-407c-8643-474cf2512921",
                                "sense_id": "5e2c1e69-b9e5-3575-8455-3021e28e3da4",
                                "text": "Nothing could well resemble less a typical English street than […] the multifarious awnings, banners, and streamers, the extraordinary number of omnibuses, horsecars, and other democratic vehicles, […]"
                            },
                            {
                                "example_id": "55f3de1a-fe8d-4c62-91e6-36d6d3bd3297",
                                "sense_id": "5e2c1e69-b9e5-3575-8455-3021e28e3da4",
                                "text": "Now, it is our regretful task to record his death on November 19 after a brief illness, and to include in a short article on page 29 some notes on his multifarious activities."
                            },
                            {
                                "example_id": "79664e5c-1983-412e-bf21-ca603ab6b558",
                                "sense_id": "5e2c1e69-b9e5-3575-8455-3021e28e3da4",
                                "text": "It is divided into parts that are too small and multifarious."
                            }
                        ]
                    },
                    {
                        "sense_id": "0be39be3-fe2a-34b4-84f0-c738c6bdd6f9",
                        "entry_id": "61465c22-72a8-3853-b935-7ebc20081241",
                        "glosses": [
                            "In which a party or a cause of action has been improperly or wrongfully joined together in the same suit, as in a misjoinder, perhaps as a result of a joinder of unrelated, distinct, independent parties or matters."
                        ],
                        "tags": [
                            "of lawsuits"
                        ],
                        "examples": []
                    }
