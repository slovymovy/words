                    {
                        "translation_id": "c48d6219-fedd-466a-8c95-1f255167e140",
                        "source_entry_id": "e505103e-fb31-3931-9aa8-f874bfc6fec1",
                        "source_sense_id": "e5948dea-e8a9-3e07-8d07-8e74f5cb4721",
                        "source_sense_description": "one who meddles or interferes",
                        "target_lang_word": "fouineur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fouineur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b9d14a6-fff6-3785-b629-72a13898e8ee",
                                        "entry_id": "ae133717-2dbd-3432-9093-f7bff965e577",
                                        "glosses": [
                                            "Qui fouine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6ef8156-c42e-4c8f-854b-6e243fc1e8ee",
                                                "sense_id": "3b9d14a6-fff6-3785-b629-72a13898e8ee",
                                                "text": "Il désigna un banian haut comme une cathédrale, non loin du village, dont les énormes racines s’insinuaient dans le sol, pareilles aux doigts fouineurs d’un géant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fouineur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a55b97d6-83de-35c2-ab72-0db9f4114a41",
                                        "entry_id": "cb37f8e1-f84f-3bea-a61f-37a335a644c0",
                                        "glosses": [
                                            "Personne indiscrète, mêle-tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e34ff91-1c05-474f-921e-544e216835be",
                                                "sense_id": "a55b97d6-83de-35c2-ab72-0db9f4114a41",
                                                "text": "Inlassable fouineur, quand il s’agit de trouver des petits coins dans les morceaux de Thelonius, qu’il va chatouiller du bout de son anche."
                                            },
                                            {
                                                "example_id": "ecf8be6f-dd5f-42a1-a89d-071d27cb332d",
                                                "sense_id": "a55b97d6-83de-35c2-ab72-0db9f4114a41",
                                                "text": "Z'avez de la chance, les fouineurs. Vous allez pouvoir entrer dans le sacro-saint des saints."
                                            },
                                            {
                                                "example_id": "36e7c60f-d357-4f7d-bab8-c72663372f28",
                                                "sense_id": "a55b97d6-83de-35c2-ab72-0db9f4114a41",
                                                "text": "J’aime ça ! Je suis un fouineur. J’adore l’enquête et rendre service aux gens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dae21fc2-a218-3f0a-b7ef-53d5d373645a",
                                        "entry_id": "cb37f8e1-f84f-3bea-a61f-37a335a644c0",
                                        "glosses": [
                                            "synonyme de hacker, personne passionnée d’informatique qui, par jeu, curiosité, défi personnel ou par souci de notoriété, sonde, au hasard plutôt qu’à l’aide de manuels techniques, les possibilités matérielles et logicielles des systèmes informatiques afin de pouvoir éventuellement s’y immiscer."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca272a50-7830-48c8-abd0-6b7c72aceca9",
                                                "sense_id": "dae21fc2-a218-3f0a-b7ef-53d5d373645a",
                                                "text": "Ce que vous ne savez peut-être pas, c’est que les normes sur la vie privée varient en voyage; votre propriété intellectuelle pourrait être exposée à un fouineur informatique."
                                            },
                                            {
                                                "example_id": "ab43c153-53ed-4f03-8eaa-02fad2acfb2c",
                                                "sense_id": "dae21fc2-a218-3f0a-b7ef-53d5d373645a",
                                                "text": "Dans l’ensemble, les citoyens ne craignent pas d’être victimes d’abus liés au dossier électronique du patient; les avantages qu’un fouineur pourrait tirer d’informations médicales sont à peine imaginables."
                                            },
                                            {
                                                "example_id": "e4f2f31a-3b99-4c5e-b7c2-e203138557b7",
                                                "sense_id": "dae21fc2-a218-3f0a-b7ef-53d5d373645a",
                                                "text": "N’ouvrez pas un courriel dont vous ne connaissez pas l’expéditeur : personne n’est à l’abri d’un arrosage !\nAvez-vous déjà été la proie d’un fouineur ou la victime d’un hameçonnage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
