                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5567d05f-14fa-4087-a110-3b52579c2545",
                        "source_entry_id": "c935117d-9f53-30cd-8ede-f1a3b1425802",
                        "source_sense_id": "a3e370ee-f31a-3221-8746-f9e2e2cc739c",
                        "target_lang_word": "Pektorale",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pektorale",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14bd368a-b50e-3826-9a8c-ca9b4c28e1c9",
                                        "entry_id": "692a7fda-cfd4-3a86-9eb0-e7f12b443476",
                                        "glosses": [
                                            "eine häufig reich verzierte Spange am Chormantel, die das Gewand zusammenhält"
                                        ],
                                        "tags": [
                                            "ursprünglich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb50b7b7-242b-412b-835b-c87cea13588b",
                                                "sense_id": "14bd368a-b50e-3826-9a8c-ca9b4c28e1c9",
                                                "text": "„Schließlich hatten sie es auf das goldene Pektorale abgesehen, das fest mit der Brust Tutanchamuns verklebt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3ecb154e-dc02-3953-bb69-1d4c7f3f9cb0",
                                        "entry_id": "692a7fda-cfd4-3a86-9eb0-e7f12b443476",
                                        "glosses": [
                                            "Brustschmuck eines Bischofs in Form eines Kreuzes oder eines Brustschildes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14dd71f7-a4bb-444d-8b72-8b6e3859bf82",
                                                "sense_id": "3ecb154e-dc02-3953-bb69-1d4c7f3f9cb0",
                                                "text": "„Das Brustkreuz (Pektorale) wird an einer Schnur oder einer Kette um den Hals getragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pektorale",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf73be53-2b94-3086-b923-8937639a5feb",
                                        "entry_id": "ca8192e2-5311-3c3d-ad32-a6a36572b624",
                                        "glosses": [
                                            "Brustflosse von Fischen und anderen Wirbeltieren (Wale, Seekühe)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df604000-ca4a-4aae-b8ac-a32bbd3f25f1",
                                                "sense_id": "bf73be53-2b94-3086-b923-8937639a5feb",
                                                "text": "„Die Pektorale steht an Länge der Höhe der Dorsale nach, der Stachel derselben ist gleichfalls dünn, am Innenrande zart gezähnt […]“"
                                            },
                                            {
                                                "example_id": "7a162aa9-329a-43cd-9a9f-14e9320375c5",
                                                "sense_id": "bf73be53-2b94-3086-b923-8937639a5feb",
                                                "text": "„Die Pektoralen reichen vollständig bis an die Ventralen, letztere nicht bis an die Analgrube; […].“"
                                            },
                                            {
                                                "example_id": "f5b0069c-a03e-4520-91f5-791ec3789d59",
                                                "sense_id": "bf73be53-2b94-3086-b923-8937639a5feb",
                                                "text": "„Die starke Entwicklung der paarigen Flossen zeigt an, dass bei der Erzeugung dieses Bastardes eine Blicca Björkna var. laskyr mit betheiligt gewesen. […] Die Pektoralen erreichen fast die Ventralen, letztere nicht ganz den After. Die Ventralen und die Anale waren sehr schön roth, wie an einem an diesen Flossen schwach gefärbten Rothauge.“"
                                            },
                                            {
                                                "example_id": "25012867-f0c8-417d-9885-9cccb4bad9e8",
                                                "sense_id": "bf73be53-2b94-3086-b923-8937639a5feb",
                                                "text": "Die Pektorale ist kaum kürzer als die Ventrale."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
