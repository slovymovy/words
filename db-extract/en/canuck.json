                "senses": [
                    {
                        "sense_id": "b8a37da2-9508-3bdc-9fc8-d5d8ca3c18dc",
                        "entry_id": "681dc560-9271-3455-a53f-ca0e1772c361",
                        "glosses": [
                            "Of, belonging to, or relating to Canada, its culture, or people; Canadian."
                        ],
                        "tags": [
                            "derogatory",
                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "31e73c31-953b-4f50-a8c1-86f58597dda6",
                                "sense_id": "b8a37da2-9508-3bdc-9fc8-d5d8ca3c18dc",
                                "text": "\"I want none of your d—— peasoup excuses, or promises,\" and, calling upon the hostler, a fat-blooded Englishman, he ordered him to stable the horse immediately, and keep a sharp \"look out\" to that Canuck Frenchman."
                            },
                            {
                                "example_id": "448b0584-1cae-4ca6-baf7-f642e771a7ce",
                                "sense_id": "b8a37da2-9508-3bdc-9fc8-d5d8ca3c18dc",
                                "text": "It is well known that Canada, by the adoption of a protective tariff, shut out many of our American articles from the Canuck markets."
                            },
                            {
                                "example_id": "2a2a1613-a8c4-4b05-ab91-743da7051e17",
                                "sense_id": "b8a37da2-9508-3bdc-9fc8-d5d8ca3c18dc",
                                "text": "Well, what do you think of the Canuck elections?"
                            },
                            {
                                "example_id": "eb010f89-5ff5-4752-b436-36dee8388aad",
                                "sense_id": "b8a37da2-9508-3bdc-9fc8-d5d8ca3c18dc",
                                "text": "Any trend by the big brother to the south to tell Canadians how to run their affairs can raise Canuck dander very quickly."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b1d263a-f3cc-3060-91a2-50073cc37513",
