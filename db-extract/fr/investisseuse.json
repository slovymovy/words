                    },
                    {
                        "form_id": "97163655-5176-4c80-a567-4762ffc6d44f",
                        "entry_id": "bb43d4d9-2d2d-3351-8bca-ec92daa88a75",
                        "tags": [
                            "masculine"
                        ],
                        "form": "investisseur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "585da884-2201-301b-9914-852f6d20eb3d",
                        "entry_id": "bb43d4d9-2d2d-3351-8bca-ec92daa88a75",
                        "glosses": [
                            "Femme ou personne morale (société, organisme, collectivité, etc.) qui investit des capitaux dans un secteur économique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d2a7ae4-d33f-4551-9180-6f22d07dd88a",
                                "sense_id": "585da884-2201-301b-9914-852f6d20eb3d",
                                "text": "Face à l’impossibilité de mener à bien son projet, Marie Ekeland jette l’éponge et préfère retourner à son occupation première d’investisseuse."
                            },
                            {
                                "example_id": "dc7ecbbb-d3af-4de6-854e-e45e2070fc62",
                                "sense_id": "585da884-2201-301b-9914-852f6d20eb3d",
                                "text": "Elle était devenue l’une des idéatrices (et des investisseuses) de la nouvelle mouture lancée en 2011, qui avait permis à Hosts d’étendre ses activités dans toutes les grandes villes du monde."
                            },
                            {
                                "example_id": "31ef3035-ce5a-4b4e-aa40-377e2f594ff3",
                                "sense_id": "585da884-2201-301b-9914-852f6d20eb3d",
                                "text": "Tout comme les compétences scientifiques sont plus souvent remises en cause chez les femmes, analyse Natacha Brami, investisseuse chez Sistafund, un fonds d’investissement pour des start-up fondées par des femmes entrepreneuses et des équipes paritaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d64c92e-0f91-4b3c-b0bd-7521d9d3cf2d",
                        "source_entry_id": "bb43d4d9-2d2d-3351-8bca-ec92daa88a75",
                        "source_sense_id": "585da884-2201-301b-9914-852f6d20eb3d",
