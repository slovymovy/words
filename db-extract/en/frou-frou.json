                ],
                "senses": [
                    {
                        "sense_id": "6ed9297a-8bc9-3e83-860c-53da0eb0dba1",
                        "entry_id": "426f9f5f-4e95-3bf5-9057-4b7c74d3fc40",
                        "glosses": [
                            "To move with the sound of rustling dresses."
                        ],
                        "tags": [
                            "intransitive",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "2cc9097f-dc8a-4118-967c-16be9b1cd7c3",
                                "sense_id": "6ed9297a-8bc9-3e83-860c-53da0eb0dba1",
                                "text": "“Oh, you funny girl! You look so surprised. Confess, now, there's nothing you can hide from me,” and ruffling my hair as she passed she frou-froued out of the room."
                            },
                            {
                                "example_id": "7921bce5-2199-4363-940e-fc930f81c4bd",
                                "sense_id": "6ed9297a-8bc9-3e83-860c-53da0eb0dba1",
                                "text": "[…]frou-frouing femininities[…]"
                            }
                        ]
                    }
                ],
