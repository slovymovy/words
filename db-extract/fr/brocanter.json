                    }
                ],
                "senses": [
                    {
                        "sense_id": "2bd81fac-f044-361a-93cf-0aeefd797bc5",
                        "entry_id": "07c27230-b51c-3cc2-8812-87dcfc08fb89",
                        "glosses": [
                            "Acheter, revendre ou troquer des marchandises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a21fd850-f731-4739-8702-56718e095244",
                                "sense_id": "2bd81fac-f044-361a-93cf-0aeefd797bc5",
                                "text": "Je brocante, j’achète des magots et des Titiens."
                            },
                            {
                                "example_id": "19162160-1cb0-44e3-871e-df35617e2993",
                                "sense_id": "2bd81fac-f044-361a-93cf-0aeefd797bc5",
                                "text": "Ah ! çà, ne voilà-t-il pas que le bonhomme, depuis qu’il a vu les poinçons, prétend les brocanter lui-même ?"
                            },
                            {
                                "example_id": "6d34e6f9-063e-492b-8e6d-d8dc21128069",
                                "sense_id": "2bd81fac-f044-361a-93cf-0aeefd797bc5",
                                "text": "Tout ce monde achète, vend, brocante."
                            },
                            {
                                "example_id": "63e5a1fc-57c1-4c28-9eb4-511e9f2d6b47",
                                "sense_id": "2bd81fac-f044-361a-93cf-0aeefd797bc5",
                                "text": "Élie Magus, à force d'acheter des diamants et de les revendre, de brocanter les tableaux et les dentelles, les hautes curiosités et les émaux, les fines sculptures et les vieilles orfèvreries, jouissait d'une immense fortune inconnue, acquise dans ce commerce, devenu si considérable."
                            },
                            {
                                "example_id": "2a64cef2-4033-46c3-ad47-d720736d3caf",
                                "sense_id": "2bd81fac-f044-361a-93cf-0aeefd797bc5",
                                "text": "— Si j’ai l’avantage sur vous d’avoir brocanté des tableaux, vous avez brocanté assez de chevaux de courses pour en remontrer au plus fin."
                            },
                            {
                                "example_id": "9211f058-3595-4a85-bc77-bfab7aaa9067",
                                "sense_id": "2bd81fac-f044-361a-93cf-0aeefd797bc5",
                                "text": "C’est pour redevenir un grand propriétaire toscan qu’il avait brocanté des tableaux, vendu en contrebande les plafonds fameux de son palais, plu à de vieilles femmes et finalement recherché la main de Miss Bell, qu’il savait très habile à gagner de l’argent et très entendue à tenir une maison."
                            },
                            {
                                "example_id": "b82cd606-1f61-489c-aea1-69d35dc8bba8",
                                "sense_id": "2bd81fac-f044-361a-93cf-0aeefd797bc5",
                                "text": "C’est un homme qui ne fait que brocanter."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7c4a4b3-afb2-3d41-b0ed-313218240367",
                        "entry_id": "07c27230-b51c-3cc2-8812-87dcfc08fb89",
                        "glosses": [
                            "Faire le commerce des marchands de tableaux, bronzes, médailles, bijoux, porcelaines, etc."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
