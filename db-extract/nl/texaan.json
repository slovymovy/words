                            {
                                "example_id": "338dc68b-6abe-42e2-b1b8-68d0f9621dcf",
                                "sense_id": "544a7c17-08bb-3be7-a7c9-c7bc3f082e9a",
                                "text": "Ik ging erbij zitten en hij stelde zich voor als Scrambler, een Texaan met een wilde bos dreadlocks die wat noedels uit een pindakaaspot zat te eten."
                            }
                        ]
