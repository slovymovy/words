                ],
                "senses": [
                    {
                        "sense_id": "6eacedeb-4aa1-36fe-9057-8af8f787e061",
                        "entry_id": "b0927662-cd43-3256-b36c-010835abe941",
                        "glosses": [
                            "Läufer, der sich auf lange Strecken spezialisiert, Läufer, der über große Ausdauer verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13a5cee9-0112-4cbf-af23-6c5b8265403a",
                                "sense_id": "6eacedeb-4aa1-36fe-9057-8af8f787e061",
                                "text": "„Bei der siebten Nachkriegsmeisterschaft wurde der 30-km-Langlauf als neue Disziplin in das Programm aufgenommen, sodass vor der ersten Austragung des Wettkampfes diskutiert wurde, ob die Kurzdistanzler oder die Dauerläufer dominieren würden.“"
                            },
                            {
                                "example_id": "accb909d-e17a-49a4-a97c-51a423cf955c",
                                "sense_id": "6eacedeb-4aa1-36fe-9057-8af8f787e061",
                                "text": "„Zwischen Job, Familie und 95 Konzerten in diesem Jahr nimmt sich der ambitionierte Dauerläufer und Triathlet wöchentlich bis zu 17 Stunden Zeit zum Lauftraining – meist irgendwo auf der Welt, aber besonders gern in Berlin.“"
                            },
                            {
                                "example_id": "a35786df-0ee6-48b0-8afb-eacf57ac69cd",
                                "sense_id": "6eacedeb-4aa1-36fe-9057-8af8f787e061",
                                "text": "„Ob in Tokio oder im New Yorker Central Park – weltweit hat sich Weinsheimer, begeisterter Dauerläufer, seine Pfade für das tägliche Jogging ausgesucht.“"
                            },
                            {
                                "example_id": "0a61ef5f-5c9d-4a2a-a88e-22f2b58eeac2",
                                "sense_id": "6eacedeb-4aa1-36fe-9057-8af8f787e061",
                                "text": "„Ich habe immer gesagt, daß ich kein Dauerläufer bin, sonst könnte ich ja beim Marathon starten.“"
                            },
                            {
                                "example_id": "8935f4f4-3323-4335-bfa9-1292fb87cfac",
                                "sense_id": "6eacedeb-4aa1-36fe-9057-8af8f787e061",
                                "text": "„1994 rannten in Berlin nur etwa 16000 Dauerläufer um die Wette.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "183333ae-3812-3270-8ef1-1747719e02ea",
                        "entry_id": "b0927662-cd43-3256-b36c-010835abe941",
                        "glosses": [
                            "Person, die ausdauernd ist; Person, die sich nicht schnell erschöpft; Person, die über längere Zeit hinweg gute Leistungen erbringt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "55e808a2-628d-4eea-8542-3e4c9d9d3119",
                                "sense_id": "183333ae-3812-3270-8ef1-1747719e02ea",
                                "text": "„Ab seinem ersten Lizenzspielerjahr 1981/82 gehörte der leichtfüßige Dauerläufer der Stammbesetzung der Eintracht an.“"
                            },
                            {
                                "example_id": "03fb5045-6705-4fd6-9292-1ca32f0eb794",
                                "sense_id": "183333ae-3812-3270-8ef1-1747719e02ea",
                                "text": "„Er war ein verbissener Zweikämpfer, Dauerbrenner und Dauerläufer, aber auch ein spielerisch guter Mann.‚“"
                            },
                            {
                                "example_id": "4426e82b-f221-4e1c-a228-179f793d00cf",
                                "sense_id": "183333ae-3812-3270-8ef1-1747719e02ea",
                                "text": "„Das Offensivtalent – er war ein technisch gut ausgebildeter Dauerläufer mit Spielmacherqualitäten – wurde zur Saison 1966/67 – wie auch Horst Köppel – aus der Jugendabteilung in den Lizenzspielerkader des VfB übernommen.“"
                            },
                            {
                                "example_id": "87401b34-d10b-48c6-a9cb-82e3062a49c9",
                                "sense_id": "183333ae-3812-3270-8ef1-1747719e02ea",
                                "text": "„In Halbzeit eins gab es technische Raffinessen zu bewundern, etwa als Sebastian Deisler den Ball stoppte und elegant weiterleitete oder als ein Dauerläufer namens Marcelinho das Arbeitsgerät mit seinem linken Fuß liebkoste.“"
                            },
                            {
                                "example_id": "c761661e-8ac1-42b2-bbce-b8dd057ab4fd",
                                "sense_id": "183333ae-3812-3270-8ef1-1747719e02ea",
                                "text": "„Mühelos schaltete der Dauerläufer von einem Gang in den nächsten, mit quietschenden Schuhsohlen kratzte er die Kurve, und Sampras kam immer zu spät.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "9beb93eb-44fa-30c9-9fba-27a3689fbeda",
                        "entry_id": "b0927662-cd43-3256-b36c-010835abe941",
                        "glosses": [
                            "Produkt, das über einen langen Zeitraum hinweg kontinuierlich gut funktioniert oder leistungsfähig, erfolgreich bleibt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "8190cf2a-4432-480b-8d0c-14269aba4c88",
                                "sense_id": "9beb93eb-44fa-30c9-9fba-27a3689fbeda",
                                "text": "„So mögen insbesondere DOS/VSE-Benutzer nicht mehr so recht daran glauben, daß sie auf das richtige Betriebssystem-Pferd gesetzt haben, obwohl der Marktführer nach außen weiterhin an DOS als ‚Dauerläufer‘ festhält.“"
                            },
                            {
                                "example_id": "a4b9ad37-271d-418b-a67c-2669e85f3482",
                                "sense_id": "9beb93eb-44fa-30c9-9fba-27a3689fbeda",
                                "text": "„Kein Rollin-Rollout VSAM, ISAM-ADD, Dauerläufer mit sequentiellem Lesen behindern nicht mehr die Datenerfassung.“"
                            },
                            {
                                "example_id": "d043c09c-7c0b-43de-896c-4a2569018d20",
                                "sense_id": "9beb93eb-44fa-30c9-9fba-27a3689fbeda",
                                "text": "„Asus Expertbook B9: Leichtgewichtiger Dauerläufer Mit dem Expertbook B9 hat Asus ein 14-Zoll-Notebook auf den Markt gebracht, das weniger als ein Kilogramm wiegt und dessen Akku hält und hält und hält – im Test bis zu 20 Stunden.“"
                            },
                            {
                                "example_id": "b12a67d7-0f61-4c56-9529-9bb3726472ed",
                                "sense_id": "9beb93eb-44fa-30c9-9fba-27a3689fbeda",
                                "text": "„Gaming-Headset von JBL JBL Quantum 360P im Test: Preiswerter Dauerläufer“"
                            },
                            {
                                "example_id": "5cdded64-e00b-4452-a5a7-8d8dfa7a106e",
                                "sense_id": "9beb93eb-44fa-30c9-9fba-27a3689fbeda",
                                "text": "„Wenn euch eine lange Laufzeit wichtig ist, wird vor allem das iPhone 15 Plus eure Kragenweite sein, denn dank einer größeren Batterie ist das Gerät ein kleiner großer Dauerläufer.“"
                            },
                            {
                                "example_id": "fcd869e3-cf00-40c0-840c-af073d8c3a10",
                                "sense_id": "9beb93eb-44fa-30c9-9fba-27a3689fbeda",
                                "text": "„Der Kühlschrank ist der Dauerläufer der Küche.“"
                            },
                            {
                                "example_id": "ce094a6f-5697-427f-94df-1ab1c575e55d",
                                "sense_id": "9beb93eb-44fa-30c9-9fba-27a3689fbeda",
                                "text": "„Aber die 50 Millionen Kopien von ‚Thriller‘, dem meistverkauften Album der Musikgeschichte, wurden auch nicht an einem Tag verkauft – seine Platten waren immer Dauerläufer.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
