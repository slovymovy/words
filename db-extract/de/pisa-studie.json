                ],
                "senses": [
                    {
                        "sense_id": "c5b36b48-30c2-3e24-ae7f-8cab38297c76",
                        "entry_id": "f128eef3-5fb8-3d23-be3f-9c0a7d5c447c",
                        "glosses": [
                            "wissenschaftlicher Vergleich der Schulleistungen von Fünfzehnjährigen in verschiedenen Ländern (durchgeführt von der OECD)"
                        ],
                        "tags": [
                            "Bildung"
                        ],
                        "examples": [
                            {
                                "example_id": "eed35573-9d3f-487d-9d72-159cfb22cf07",
                                "sense_id": "c5b36b48-30c2-3e24-ae7f-8cab38297c76",
                                "text": "„Die PISA–Studie (Programme for International Student Assessment) wurde von der OECD in Auftrag gegeben.“"
                            },
                            {
                                "example_id": "62248188-96da-4e31-9104-4fa38a5aff4d",
                                "sense_id": "c5b36b48-30c2-3e24-ae7f-8cab38297c76",
                                "text": "„Die neue weltweite PISA-Studie liegt vor. “"
                            },
                            {
                                "example_id": "acdba0ff-4582-40f5-a305-ed9a6828f2af",
                                "sense_id": "c5b36b48-30c2-3e24-ae7f-8cab38297c76",
                                "text": "„Deutsche Schüler sind in Mathe und im Lesen so schlecht wie nie zuvor – so lautet das Ergebnis der neuesten PISA-Studie.'“"
                            },
                            {
                                "example_id": "caffb077-5d88-40cd-a6b2-6f9f8033b443",
                                "sense_id": "c5b36b48-30c2-3e24-ae7f-8cab38297c76",
                                "text": "„Auch im Lesen und in Naturwissenschaften gab es deutlich weniger Punkte als bei der vorherigen PISA-Studie.“"
                            },
                            {
                                "example_id": "311fe58c-2b96-4b1b-8253-9f0be5ba71ea",
                                "sense_id": "c5b36b48-30c2-3e24-ae7f-8cab38297c76",
                                "text": "„Als Reaktion auf die jüngsten Ergebnisse der PISA-Studie baut Bayerns Kultusministerin Anna Stolz den Stundenplan in der Grundschule um: Künftig soll es in Bayern pro Woche mehr Unterricht in Deutsch geben und teils auch in Mathe.“"
                            },
                            {
                                "example_id": "f07b46bd-8dbd-49e2-b6b4-732fe77dab88",
                                "sense_id": "c5b36b48-30c2-3e24-ae7f-8cab38297c76",
                                "text": "„»Es wäre schön, wenn die Kultusministerkonferenz sich auf ein einheitliches Handeln einigen könnten - so wie das nach der ersten PISA-Studie geschehen ist.«“"
                            },
                            {
                                "example_id": "2fc0ab60-9281-49df-95da-7c1eb08ba4a5",
                                "sense_id": "c5b36b48-30c2-3e24-ae7f-8cab38297c76",
                                "text": "[Schlagzeile:] „PISA-Studie: Was macht Estland so erfolgreich?“"
                            },
                            {
                                "example_id": "df89c929-eed0-4228-a655-4c03cc8ed741",
                                "sense_id": "c5b36b48-30c2-3e24-ae7f-8cab38297c76",
                                "text": "„Im Rahmen der PISA-Studie im Jahr 2018 gehörte zu den Tests für die Jugendlichen auch die Aufgabe, Passagen in einem Text als Fakten oder Meinungen zu identifizieren. Besonders gut schnitten damals Jugendliche in den USA, Großbritannien, der Türkei und den Niederlanden ab.“"
                            },
                            {
                                "example_id": "0d957697-62f1-4152-8cee-5c183f9e5158",
                                "sense_id": "c5b36b48-30c2-3e24-ae7f-8cab38297c76",
                                "text": "„Andere Kritiker werfen der OECD als Initiatorin der PISA-Studie vor, ausschließlich an der Nützlichkeit orientiert zu testen.“"
                            },
                            {
                                "example_id": "f4ae5aeb-5f19-447c-99b1-362cf8be821b",
                                "sense_id": "c5b36b48-30c2-3e24-ae7f-8cab38297c76",
                                "text": "„Die heimischen Ergebnisse der ersten PISA-Studie nach der Coronavirus-Pandemie haben sich im Vergleich zu früheren Erhebungen der OECD verschlechtert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
