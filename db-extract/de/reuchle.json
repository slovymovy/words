                ],
                "senses": [
                    {
                        "sense_id": "3db86861-ac62-334f-aded-319b6522d8f0",
                        "entry_id": "e5177c8d-84be-3da8-b161-53e1e92616c8",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46ea1fe-c36f-4259-a18d-52e36aef98f2",
                                "sense_id": "3db86861-ac62-334f-aded-319b6522d8f0",
                                "text": "Frau Reuchle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "882169b8-82d3-4463-846c-fba3f94f3a18",
                                "sense_id": "3db86861-ac62-334f-aded-319b6522d8f0",
                                "text": "Herr Reuchle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2f6a3654-dd75-439b-ac44-84d865e09196",
                                "sense_id": "3db86861-ac62-334f-aded-319b6522d8f0",
                                "text": "Die Reuchles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "abf8d48e-d179-42f9-83c4-7215da860d08",
                                "sense_id": "3db86861-ac62-334f-aded-319b6522d8f0",
                                "text": "Der Reuchle trägt nie die Schals, die die Reuchle ihm strickt."
                            },
                            {
                                "example_id": "e15e4af6-723e-426a-8ceb-f9cacfed1b96",
                                "sense_id": "3db86861-ac62-334f-aded-319b6522d8f0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Reuchle kommt, geht der Herr Reuchle.“"
                            },
                            {
                                "example_id": "78a44e69-044c-47e2-a33a-9286efb9398a",
                                "sense_id": "3db86861-ac62-334f-aded-319b6522d8f0",
                                "text": "Reuchle kommt und geht."
                            },
                            {
                                "example_id": "d8da18b3-1495-4900-82ac-4bc7520a1766",
                                "sense_id": "3db86861-ac62-334f-aded-319b6522d8f0",
                                "text": "Reuchles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
