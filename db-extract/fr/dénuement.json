                                            {
                                                "example_id": "37c7e4b8-8333-4492-8322-d23b7a70cc9c",
                                                "sense_id": "aefd9ac6-f026-38e9-95f7-ed4a936e88a8",
                                                "text": "„Währenddem hatte sich der alte Miko etwas befremdet in der dunkeln, von zwei Talglichtern kümmerlich erhellten Stube umgesehen, deren Ärmlichkeit ihm aufzufallen schien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
