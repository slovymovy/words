                                                "example_id": "b15e0f96-972b-4d57-8273-2adef6add036",
                                                "sense_id": "916a063b-5e68-3199-be02-c5ba7bfb098e",
                                                "text": "Enter your user name and password."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1628eea5-4164-3eeb-924c-72127e57ba45",
                                        "entry_id": "a2461044-a26f-3ca7-a1b3-fb7410ef3381",
                                        "glosses": [
                                            "To record (something) in an account, ledger, etc."
                                        ],
                                        "tags": [
