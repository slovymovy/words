                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11344cff-6054-4136-9db8-855d9d0a5305",
                                                "sense_id": "7cdcf176-cf92-313c-8b5d-5a2332d6ec0d",
                                                "text": "Cultivating it on a regular basis improves our attitude towards writing and makes us more resilient. But in order to make it work we have to 'unadapt' to the habituation that familiarity can bring, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf5c184a-59cc-3334-a35b-4cbe95e3b385",
                                        "entry_id": "77fd2145-5402-31e1-ae90-4ed7a4a562b8",
                                        "glosses": [
                                            "The process of becoming accustomed to an internal or external stimulus, such as a noxious smell or loud noise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1345f80e-c5dd-4bd6-838d-cb9384707e0b",
                                                "sense_id": "bf5c184a-59cc-3334-a35b-4cbe95e3b385",
                                                "text": "Habituation and dishabituation allow for experience-dependent tuning of these reflexes and the mechanisms underlying these forms of behavioral plasticity involve changes in transmitter release from the sensory to motor neuron synapses through homosynaptic depression and the serotonin-mediated recovery from depression, respectively."
                                            }
                                        ]
