                        ],
                        "form": "die Biergärten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96a4bb74-8659-3cec-884b-012c84727367",
                        "entry_id": "ee45130e-004d-3f88-af07-246088681982",
                        "glosses": [
                            "Örtlichkeit im Außenbereich einer Wirtschaft oder eines Restaurants (oft auch parkartig gestaltet), wo man Bier trinken kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34394526-e7f5-4c2f-bbaf-cb67bc90e155",
                                "sense_id": "96a4bb74-8659-3cec-884b-012c84727367",
                                "text": "„Der Biergarten ist ab 18 Uhr geöffnet.“"
                            },
                            {
                                "example_id": "c5407747-7b0f-4c62-be71-096bb08a3fbc",
                                "sense_id": "96a4bb74-8659-3cec-884b-012c84727367",
                                "text": "München ist für seine schönen Biergärten bekannt."
                            },
                            {
                                "example_id": "8ba072dd-71e5-413a-9fb7-14b549bd9ce6",
                                "sense_id": "96a4bb74-8659-3cec-884b-012c84727367",
                                "text": "„Wenn es warm ist in Deutschland, zieht es die Menschen in die Biergärten. Was braucht man mehr als ein kühles Getränk unter Schatten spendenden Kastanien, dazu noch eine Brezel oder eine Bratwurst.“"
                            },
                            {
                                "example_id": "8612139b-afb8-4d6d-911e-646e9f713463",
                                "sense_id": "96a4bb74-8659-3cec-884b-012c84727367",
                                "text": "„Jetzt saß er in seinem Biergarten, doch es war nicht mehr wie vorher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
