                        "examples": [
                            {
                                "example_id": "16d251b2-f5e0-42b6-887e-96013d9cf62b",
                                "sense_id": "c61322f8-930c-3cff-8c02-76cfef2b2a3f",
                                "text": "De woordvoerster ontweek de aanvallende vraag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85b8806c-2feb-4f83-8477-c13cbc86b409",
                        "source_entry_id": "dd1feffe-8003-32ce-b59d-82185f3d1aae",
                        "source_sense_id": "c61322f8-930c-3cff-8c02-76cfef2b2a3f",
                        "source_sense_description": "een vrouwelijk persoon die namens anderen spreekt",
                        "target_lang_word": "Sprecherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprecherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b645b627-009a-3e6c-b06c-c704a6131af6",
                                        "entry_id": "600d4578-e02b-3a3e-b66a-bdbd6d43fd3d",
                                        "glosses": [
                                            "weibliche Person, die spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bd56422-96f4-45c4-9f61-a5745b54b42c",
                                                "sense_id": "b645b627-009a-3e6c-b06c-c704a6131af6",
                                                "text": "Es war ein guter Vortrag. Allerdings hätte die Sprecherin etwas lauter reden können."
                                            },
                                            {
                                                "example_id": "9dd2ff35-d1f2-4fdf-8920-e20161d5b754",
                                                "sense_id": "b645b627-009a-3e6c-b06c-c704a6131af6",
                                                "text": "„Die Sprecherin scheint auf einen kulturellen Antagonismus zu referieren: Allen Gesprächsteilnehmerinnen ist klar, wer solche Verbote ausspricht, wer der Kontrahent ist.“"
                                            },
                                            {
                                                "example_id": "e80b6417-ff55-45db-bb2f-61734e6179b8",
                                                "sense_id": "b645b627-009a-3e6c-b06c-c704a6131af6",
                                                "text": "„Es gibt zahlreiche weitere Demonstrationsbeispiele, die uns gute Einblicke in die Unsicherheiten von Sprecherinnen und Sprechern vermitteln.“"
                                            },
                                            {
                                                "example_id": "c460651e-5126-4315-9cf8-e96297e8ab3d",
                                                "sense_id": "b645b627-009a-3e6c-b06c-c704a6131af6",
                                                "text": "„Schach sah verwundert auf die Sprecherin.“"
                                            },
                                            {
                                                "example_id": "8b0eb2d4-2f5b-4f3f-a6b8-a0640a023b92",
                                                "sense_id": "b645b627-009a-3e6c-b06c-c704a6131af6",
                                                "text": "„Die Alte grinste die Sprecherin mit einem zweifelhaften Blicke an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e731033c-f1be-319e-a405-0dbc57df54d1",
                                        "entry_id": "600d4578-e02b-3a3e-b66a-bdbd6d43fd3d",
                                        "glosses": [
                                            "weibliche Person, die beauftragt ist, für andere zu sprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "009835b1-beb8-4a52-8020-a318dbc42f97",
                                                "sense_id": "e731033c-f1be-319e-a405-0dbc57df54d1",
                                                "text": "Gudrun Kopp, die energiepolitische Sprecherin der Liberalen, will vor allem neue Speichermethoden für Wind- und Solarstrom erforschen lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "eef225f7-af69-36e1-8044-e72873d8b894",
                                        "entry_id": "600d4578-e02b-3a3e-b66a-bdbd6d43fd3d",
                                        "glosses": [
                                            "Ansagerin, Programmsprecherin"
                                        ],
                                        "tags": [
                                            "bei Rundfunk oder Fernsehen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3731c7e2-694d-414c-8e18-5a5a64e3694d",
                                                "sense_id": "eef225f7-af69-36e1-8044-e72873d8b894",
                                                "text": "Meine Mutter hat einige Zeit als Sprecherin beim ARD gearbeitet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "54f97131-5d52-3330-a787-62f04c74791c",
                                        "entry_id": "600d4578-e02b-3a3e-b66a-bdbd6d43fd3d",
                                        "glosses": [
                                            "weibliche Person, die eine bestimmte Sprache spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a6fad5d-55e6-421a-8e91-a959f56cb23b",
                                                "sense_id": "54f97131-5d52-3330-a787-62f04c74791c",
                                                "text": "„So ist grundsätzlich die Rolle der Sprache für die Identität ihrer Sprecherinnen und Sprecher kaum zu überschätzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
