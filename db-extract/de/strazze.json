                    {
                        "sense_id": "e33a2443-efb8-3bea-8436-467a8b836051",
                        "entry_id": "dfc2b346-e713-3123-afca-e45205e4e86d",
                        "glosses": [
                            "Geschäftsbuch, in dem täglich Geschäftsvorfälle festgehalten werden, bevor sie endgültig in den Büchern der Buchhaltung gebucht werden"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "d75f09e3-91d7-4154-a04e-7ba77877339f",
                                "sense_id": "e33a2443-efb8-3bea-8436-467a8b836051",
                                "text": "„Es würde zu weitläufig, und ebenfalls nichts als eine ekelhafte Wiederholung seyn, wenn ich alle Geschäfte, die in der Strazze notirt sind, so einzeln, wie diese beiden, zergliedern wollte, da man in dem Memorial selbst jeden Vorfall deutlich notirt und erklärt finden wird.“ (1817)"
                            }
                        ],
                        "sense_index_json": "\"1\""
