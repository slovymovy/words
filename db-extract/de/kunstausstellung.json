                "senses": [
                    {
                        "sense_id": "7603de51-a089-392a-89b8-bc3a95c91cf1",
                        "entry_id": "90d4776a-15c5-3cba-a9fb-fea5caf9cd3f",
                        "glosses": [
                            "öffentliche Präsentation von Kunstwerken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52d0a7fa-a665-4248-8962-789109cd6da1",
                                "sense_id": "7603de51-a089-392a-89b8-bc3a95c91cf1",
                                "text": "„Aber seine Beurteilung von Konzerten und Kunstausstellungen, die in meinen Augen völlig neben der Sache lagen, waren nicht weniger rasiermesserscharf geworden; er stellte seine übliche Häme zur Schau und schmähte wie gewöhnlich, und auch seine Beobachtungsgabe schien sich nicht verändert zu haben.“"
                            },
                            {
                                "example_id": "7fc1f572-af0c-4a05-b806-e393a126c18f",
                                "sense_id": "7603de51-a089-392a-89b8-bc3a95c91cf1",
                                "text": "„Wir sind heute Abend für eine Kunstausstellung verabredet.“"
                            },
                            {
                                "example_id": "f5435ac4-3ea6-4abe-97f8-064349ffd947",
                                "sense_id": "7603de51-a089-392a-89b8-bc3a95c91cf1",
                                "text": "„›Ich habe ihm erzählt, wir wären uns auf dieser Kunstausstellung in Stanley Roses Bookshop begegnet.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
