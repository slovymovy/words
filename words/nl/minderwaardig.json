                {
                    "sense_id": "b0e88424-a88e-3657-8f23-71ef842b2b31",
                    "sense_definition": "in maatschappelijk of persoonlijk opzicht als minder belangrijk of ondergeschikt beschouwd",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de opmerkingen van zijn baas voelde hij zich plotseling heel <w>minderwaardig</w>.",
                            "target_lang_translations": {
                                "fr": "À cause des remarques de son patron, il s'est soudainement senti très <w>inférieur</w>."
                            }
                        },
                        {
                            "text": "Niemand mag worden behandeld alsof die een <w>minderwaardig</w> persoon is.",
                            "target_lang_translations": {
                                "fr": "Personne ne devrait être traité comme s'il était une personne <w>inférieure</w>."
                            }
