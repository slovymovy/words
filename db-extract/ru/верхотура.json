                ],
                "senses": [
                    {
                        "sense_id": "76287ca4-527a-3da1-bed9-d51c0a041b74",
                        "entry_id": "b5ac4175-8b67-334e-b8f6-1eb6aedaaf9c",
                        "glosses": [
                            "прост. верхняя, высоко расположенная часть чего-либо (часто о верхних этажах дома)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf987754-e34c-496b-a375-004f855fd2ab",
                                "sense_id": "76287ca4-527a-3da1-bed9-d51c0a041b74",
                                "text": "На телеге наше добро, мы с Талей сидим на верхотуре, мама с папкой идут пешком."
                            },
                            {
                                "example_id": "0dca0916-b053-486d-b0f4-c2bfe8e5dd78",
                                "sense_id": "76287ca4-527a-3da1-bed9-d51c0a041b74",
                                "text": "Они играючи взбирались на самую верхотуру и, весело улыбаясь, сигали вниз, резво раскачиваясь на страховке."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cb7c57c-edad-440e-a8df-450bd622f2ea",
                        "source_entry_id": "b5ac4175-8b67-334e-b8f6-1eb6aedaaf9c",
                        "source_sense_id": "76287ca4-527a-3da1-bed9-d51c0a041b74",
                        "target_lang_word": "attic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c830d765-a0e1-357a-8432-0e5d085f0ad6",
                                        "entry_id": "3c40d324-d1c2-380c-8c2f-17913c4889aa",
                                        "glosses": [
                                            "The space, often unfinished and with sloped walls, directly below the roof in the uppermost part of a house or other building, generally used for storage or habitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f07a096-7dd4-4f69-9b17-beba1a3ba290",
                                                "sense_id": "c830d765-a0e1-357a-8432-0e5d085f0ad6",
                                                "text": "We went up to the attic to look for the boxes containing our childhood keepsakes."
                                            },
                                            {
                                                "example_id": "562aa7cc-fe10-4c4d-9416-b4fae5d063fa",
                                                "sense_id": "c830d765-a0e1-357a-8432-0e5d085f0ad6",
                                                "text": "In my Wonderland, I'm back on my Alice\nBack in my palace, I'm fly like Aladdin\nServing my fans all my dope, 'cause they addicts\nHaters mad 'cause I'm on top like an attic\nAnd if it's beef then we're shooting sporadic\nGame is like Disney, my words are like magic"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cdda21d-95bc-3b47-bf0b-5f06f3288e61",
                                        "entry_id": "3c40d324-d1c2-380c-8c2f-17913c4889aa",
                                        "glosses": [
                                            "A person's head or brain."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e13a86f-ca29-4670-9197-289ef4f0fa96",
                                                "sense_id": "9cdda21d-95bc-3b47-bf0b-5f06f3288e61",
                                                "text": "[…] was a diminutive, forked-radish sort of a young man, very fashionably attired, or, as he would say, kiddily togg'd; and, though it was scarcely noon, he was rather queer in the attic; that is to say, not exactly sober."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1972623-eac7-45c0-8a71-94912abf06dc",
                        "source_entry_id": "b5ac4175-8b67-334e-b8f6-1eb6aedaaf9c",
                        "source_sense_id": "76287ca4-527a-3da1-bed9-d51c0a041b74",
                        "target_lang_word": "penthouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penthouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24811c31-7d5e-3605-b767-4c0888ccf90b",
                                        "entry_id": "53703889-add9-39cc-8a2b-cd465c9f7309",
                                        "glosses": [
                                            "A structure or annexe (especially one with a sloping roof) extending from the side of a building, sometimes as protection from the weather."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0304c1d-6f13-4535-b200-77f61aad99c6",
                                                "sense_id": "24811c31-7d5e-3605-b767-4c0888ccf90b",
                                                "text": "At length, recommending himself to God, he let go one end of his cord, and suffered himself to fall down upon an old shed or penthouse, which, with the weight of his body, fell in with great noise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e434fa3f-687b-35c4-849b-47ebb2325c31",
                                        "entry_id": "53703889-add9-39cc-8a2b-cd465c9f7309",
                                        "glosses": [
                                            "Something forming a shelter or canopy over something; an awning, shelter, etc."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31a09ef4-0fa7-4623-bdc6-e2c8f6d9ae54",
                                                "sense_id": "e434fa3f-687b-35c4-849b-47ebb2325c31",
                                                "text": "The proboscis […] is doubled up by means of the joint, and in that position lies secure under a scaly penthouse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2abbc87c-4523-3dbc-be8a-5293a99ef466",
                                        "entry_id": "53703889-add9-39cc-8a2b-cd465c9f7309",
                                        "glosses": [
                                            "Any of the sloping roofs at the side of a real tennis court."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca91b8d1-42cd-4cb8-a298-8abc83bb8e98",
                                                "sense_id": "2abbc87c-4523-3dbc-be8a-5293a99ef466",
                                                "text": "2005, Tony Collins (ed.), Encyclopaedia of Traditional British Rural Sports, Routledge, page 262,\nAn odd derivative of real tennis lasted until the latter part of the eighteenth century at Rattray in Perthshire. It was played in the churchyard by two pairs of men, and the method for starting the play was to throw the ball onto the church roof, using it like the sloping penthouse of the tennis court."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5405273f-6e37-3f4a-91cc-a9a7d93eb291",
                                        "entry_id": "53703889-add9-39cc-8a2b-cd465c9f7309",
                                        "glosses": [
                                            "An apartment or suite found on an upper floor, or floors, of a tall building, especially one that is expensive or luxurious with panoramic views."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f65bfb5-6b4d-451f-ae51-efdf3d2f30a9",
                                                "sense_id": "5405273f-6e37-3f4a-91cc-a9a7d93eb291",
                                                "text": "Night of January 16th is the story of a woman on trial for pushing her wealthy boss-lover from a Manhattan penthouse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "penthouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ca984c4-33d2-3d18-b8ef-376df0d61726",
                                        "entry_id": "24d28ec5-b740-385c-819b-0454eb817663",
                                        "glosses": [
                                            "To provide with a penthouse, shelter by means of a shed sloping from a wall, or anything similar."
                                        ],
