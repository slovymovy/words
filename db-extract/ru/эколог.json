                    },
                    {
                        "sense_id": "95ce586e-680f-376a-b31f-a8995a08f224",
                        "entry_id": "0b50c754-f842-374d-85e9-22f77c65ee9e",
                        "glosses": [
                            "учёный в области экологии"
                        ],
                        "tags": [],
