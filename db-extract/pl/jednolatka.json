                                ]
                            },
                            {
                                "target_word": "одногодка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "50500194-3fc6-3a94-9f5f-ce7e0a48e4ca",
                                        "entry_id": "d1e61fd9-9f30-34df-9896-ea3e56918ee3",
                                        "glosses": [
                                            "разг. та, кто одних лет с кем-либо; ровесница"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90f48e34-261f-4614-af00-af690f71cfd6",
                                                "sense_id": "50500194-3fc6-3a94-9f5f-ce7e0a48e4ca",
                                                "text": "Я привезла одиннадцатилетнюю дочь в Семхоз и познакомила её с Лялей, её одногодкой."
                                            },
                                            {
                                                "example_id": "032c10d5-04d4-45be-b9bb-24b5cb7e461e",
                                                "sense_id": "50500194-3fc6-3a94-9f5f-ce7e0a48e4ca",
                                                "text": "Липка ― маленькая дворняжка, моя одногодка, умница-разумница, подружившаяся с поповскими курами, которые живут в сарае у пожарной каланчи за нашим забором."
                                            },
                                            {
                                                "example_id": "44e6c420-ae72-4d11-b366-e76193d4c398",
                                                "sense_id": "50500194-3fc6-3a94-9f5f-ce7e0a48e4ca",
                                                "text": "Надя уже́ давно себе призналась, что выглядит намного лучше Ирины. А ведь они одногодки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4e3933c-7303-312b-aede-64f62832f25a",
                                        "entry_id": "d1e61fd9-9f30-34df-9896-ea3e56918ee3",
                                        "glosses": [
                                            "разг. животное или растение в возрасте одного года"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e823fc68-7cb0-4463-b866-7f0d8697d44c",
                        "source_entry_id": "41fa007b-069c-35a2-ac2b-5e66f1cff0af",
                        "source_sense_id": "f6f96574-c667-3a69-9fc9-e3aa94d883ed",
                        "target_lang_word": "однолетка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "однолетка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "865cd263-f469-3988-94b5-d1226e0648b8",
                                        "entry_id": "299e5bb7-d233-3fe8-a2d6-bf1892b14ea5",
                                        "glosses": [
                                            "разг. тот или та, кто одних лет с кем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59c4614f-c399-4122-8b87-9c59d0befa16",
                                                "sense_id": "865cd263-f469-3988-94b5-d1226e0648b8",
                                                "text": "В то лето я каждый вечер проезжал мимо золотой от заката избы́, на чёрном пороге которой всегда в это время стояла Поленька, однолетка моя́, дочка кучера."
                                            },
                                            {
                                                "example_id": "fbff54b0-225e-4cb3-826d-86bd0ae88b01",
                                                "sense_id": "865cd263-f469-3988-94b5-d1226e0648b8",
                                                "text": "Я считаю всерьёз, что мой однолетка и кореш оказался моим Сухомлинским, Янушем Корчаком, Макаренко ― кем угодно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "824a6f96-97b4-30f8-ac3c-514ae79b7ea1",
                                        "entry_id": "299e5bb7-d233-3fe8-a2d6-bf1892b14ea5",
                                        "glosses": [
                                            "разг. животное или растение в возрасте одного года"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "002866fb-b69d-469c-94bc-2372617806b9",
                                                "sense_id": "824a6f96-97b4-30f8-ac3c-514ae79b7ea1",
                                                "text": "Пото́м, много позже, .. Клава начала понимать, что так он необидно показывает ей, какими прочными нитями связан со своей семьёй, и как росла и крепла в нём (не цветок-однолетка, а дерево с мощной корневой системой) ответственность за близких."
                                            }
                                        ]
                                    }
                                ]
                            },
