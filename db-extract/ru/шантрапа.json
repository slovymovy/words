        "de-extract.jsonl": [
            {
                "entry_id": "f4352838-296c-3d1f-8847-ed05c79796e2",
                "word": "шантрапа",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [
                    {
                        "form_id": "28f803e3-b0aa-48b4-baa5-29c0e43b3fa2",
                        "entry_id": "f4352838-296c-3d1f-8847-ed05c79796e2",
                        "tags": [
                            "transcription"
                        ],
                        "form": "šantrapa"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b038d4c8-eef8-3951-ae50-1359c38fc052",
                        "entry_id": "f4352838-296c-3d1f-8847-ed05c79796e2",
                        "glosses": [
                            "der Pöbel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f959aca-6065-4609-84bd-5ce1ca68d38f",
                                "sense_id": "b038d4c8-eef8-3951-ae50-1359c38fc052",
                                "text": "Я признаю себя сторонником пролетариата, который вы называете шантрапой.",
                                "translation": "Ich bekenne mich selbstverständlich zu dem von Ihnen als Pöbel bezeichneten Proletariat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e188035-7202-46fc-beac-96ec9859c9fb",
                        "source_entry_id": "f4352838-296c-3d1f-8847-ed05c79796e2",
                        "source_sense_id": "b038d4c8-eef8-3951-ae50-1359c38fc052",
                        "source_sense_description": "der Pöbel",
                        "target_lang_word": "Pöbel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pöbel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef12a412-6027-3beb-93dc-39981f50b694",
                                        "entry_id": "f6fc3e7a-4162-397d-867d-2971e3677715",
                                        "glosses": [
                                            "unterste Gesellschaftsschicht"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa819901-0559-43f9-8e83-e3c73588a230",
                                                "sense_id": "ef12a412-6027-3beb-93dc-39981f50b694",
                                                "text": "Soll doch der Pöbel sehen, wo er bleibt."
                                            },
                                            {
                                                "example_id": "8052dedb-5895-4969-969c-1971f5bde977",
                                                "sense_id": "ef12a412-6027-3beb-93dc-39981f50b694",
                                                "text": "„Sie verachtet den Pöbel vor ihrem Zaun.“"
                                            },
                                            {
                                                "example_id": "a4491053-0aa1-4021-a45e-114c02039f64",
                                                "sense_id": "ef12a412-6027-3beb-93dc-39981f50b694",
                                                "text": "„Die Sympathien und das Geschrei des Pöbels, der Armen, der Masse waren hilfreich auf dem Weg zur Macht, aber selten der entscheidende Faktor, es sei denn, der Pöbel war gut bewaffnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7f4ddc27-b510-362a-a2a4-4706d8642740",
                                        "entry_id": "f6fc3e7a-4162-397d-867d-2971e3677715",
                                        "glosses": [
                                            "randalierende, unkontrollierbare Menschenmenge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bec2c735-7374-47e7-9310-dcae0550b7e1",
                                                "sense_id": "7f4ddc27-b510-362a-a2a4-4706d8642740",
                                                "text": "„Die Sympathien und das Geschrei des Pöbels, der Armen, der Masse waren hilfreich auf dem Weg zur Macht, aber selten der entscheidende Faktor, es sei denn, der Pöbel war gut bewaffnet.“"
                                            },
                                            {
                                                "example_id": "afa4b45b-6556-4251-84de-891adefdfe8f",
                                                "sense_id": "7f4ddc27-b510-362a-a2a4-4706d8642740",
                                                "text": "Der Pöbel machte die Straßen unsicher, und wir hatten große Schwierigkeiten, aus der Stadt heraus zu kommen."
                                            },
                                            {
                                                "example_id": "5e98e1a6-eb86-47fd-8872-148e13956bba",
                                                "sense_id": "7f4ddc27-b510-362a-a2a4-4706d8642740",
                                                "text": "„Der simulierte Pöbel wich in simulierter Furcht zurück.“"
                                            },
                                            {
                                                "example_id": "831f5b87-8449-45b6-97c7-03daa812da67",
                                                "sense_id": "7f4ddc27-b510-362a-a2a4-4706d8642740",
                                                "text": "„Ihn traf der Hass des Pöbels, und gegen solch massive Gefühle gab es keinen Schutz.“"
                                            },
                                            {
                                                "example_id": "1821141d-169a-4b8e-a2d7-02c1b38e053a",
                                                "sense_id": "7f4ddc27-b510-362a-a2a4-4706d8642740",
                                                "text": "„Er wurde Gesandter in Persien, wo er im Alter von fünfunddreißig Jahren vom Pöbel ermordet wurde, seine Witwe aber überlebte ihn achtundzwanzig Jahre und wies alle Freier ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a03afda4-4c08-4c0d-84a4-50a1821f2198",
                        "source_entry_id": "f4352838-296c-3d1f-8847-ed05c79796e2",
                        "source_sense_id": "b038d4c8-eef8-3951-ae50-1359c38fc052",
                        "source_sense_description": "der Pöbel",
                        "target_lang_word": "riffraff",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "riffraff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87ff2d61-0e19-3a5a-aa14-8c2d9d4132b7",
                                        "entry_id": "50624232-73f1-3b60-83a1-aebbc4f956e7",
                                        "glosses": [
                                            "The rabble; crowds; people of a low, disreputable or undesirable class or position."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bf387b5-ff59-4709-b6a4-fcdc7c3807e6",
                                                "sense_id": "87ff2d61-0e19-3a5a-aa14-8c2d9d4132b7",
                                                "text": "They started charging a modest fee in an effort to keep the riffraff out."
                                            },
                                            {
                                                "example_id": "da04f7d9-0a07-4c30-9a48-d7f9d9bd697a",
                                                "sense_id": "87ff2d61-0e19-3a5a-aa14-8c2d9d4132b7",
                                                "text": "Mom: [Walks away with King Pridemoor.] / King Knight: 'MOM, WAIT! ..... MOM!! *SIGH* WELL, FINALLY, THE RIFF-RAFF... AND MY MOM, ARE GONE.'"
