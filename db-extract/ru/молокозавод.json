                                        ],
                                        "examples": [
                                            {
                                                "example_id": "795151e5-8a01-4524-9fff-9b4456af8992",
                                                "sense_id": "d16162cd-3282-378a-9d07-f8e9cd82f9ba",
                                                "text": "Her dairies as Wallop had called them were on display, or at least as much of them as she and Ruth could not contrive to cover."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bd74c2f-7172-3b08-9f81-58e3548608e1",
                                        "entry_id": "66ee2547-97cc-36c4-9170-3d7ee4e36346",
                                        "glosses": [
                                            "(also dairy products or dairy produce) Products produced from milk."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efb4d39d-62e3-4458-bd11-b721d9f8dce9",
                                                "sense_id": "8bd74c2f-7172-3b08-9f81-58e3548608e1",
                                                "text": "My routine changed in February because I stopped alcohol, caffeine and dairy. Normally, I would have drunk a strong beer before I went to bed and made an espresso in the morning. It’s boring now but healthier."
                                            }
                                        ]
                                    }
