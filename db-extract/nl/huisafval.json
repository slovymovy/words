                        "glosses": [
                            "huishoudelijk afval; afval dat ontstaat door het voeren van een huishouding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35bfaa68-2ff4-45d7-a6f5-b80dfab58a1a",
                                "sense_id": "fbc5ed66-edb1-3dd1-98ce-27ef0b588c91",
                                "text": "Op het terrein waar de brand in de loods woedde, kunnen burgers en bedrijven hun afval kwijt. In de loods waar het vuur ontstond, lag vooral huisafval. De brand was om 15.00 uur onder controle."
                            },
                            {
                                "example_id": "9bc798c1-278c-47c3-be48-9e43cfaf1d30",
                                "sense_id": "fbc5ed66-edb1-3dd1-98ce-27ef0b588c91",
                                "text": "De containers zouden volgens de papieren metaalschroot, grond en huisafval bevatten, maar bij controle in januari vond de douane onder meer elektronicaschroot, asfalt, zand en plastic. Bovendien kwam er uit sommige containers een onbekende witte vloeistof. Bij verder onderzoek werden ook giftige zware metalen en zwavelzuur gevonden."
                            }
                        ]
                    }
