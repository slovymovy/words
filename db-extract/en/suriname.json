                                            {
                                                "example_id": "374d3920-5709-4639-b7c1-3fd14829034e",
                                                "sense_id": "215df4d5-a775-3bd8-8319-3c936456aa20",
                                                "text": "Die suiker is ruim een week geleden uit Suriname aangekomen, maar Frans en Agnes weten nog steeds niet wat je ermee gaat doen."
                                            },
                                            {
                                                "example_id": "ba5dfe46-9279-4e0c-a5ee-26dc1598c041",
                                                "sense_id": "215df4d5-a775-3bd8-8319-3c936456aa20",
                                                "text": "Bent u in Suriname geweest?' Agnes lacht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "105cc70b-cf8f-4925-b284-6fd00e3c10e2",
                        "source_entry_id": "912e5aee-0fae-3704-b3e2-5b352af43516",
