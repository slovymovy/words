                "senses": [
                    {
                        "sense_id": "b19583b8-8c20-39b2-9f60-e26e1aa3c8df",
                        "entry_id": "a29208ae-30f8-34d4-b672-1dbe3fd0e1fa",
                        "glosses": [
                            "прост. прийти в состояние одурения, отупения или бешенства, ярости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2086ecde-6a5e-4268-a175-23946c5f8659",
                                "sense_id": "b19583b8-8c20-39b2-9f60-e26e1aa3c8df",
                                "text": "— Ему лечиться надо. — Вздор. Очертенел от работы просто. Отдохнуть ему надо."
                            }
                        ]
                    },
                    {
                        "sense_id": "c302fd8d-1531-367d-88a3-502906abe0eb",
                        "entry_id": "a29208ae-30f8-34d4-b672-1dbe3fd0e1fa",
                        "glosses": [
                            "прост. надоесть, опротиветь; осточертеть, очертеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2414a8b8-f9ea-4f30-bb8c-8b5bf50f29e9",
                                "sense_id": "c302fd8d-1531-367d-88a3-502906abe0eb",
                                "text": "Я тебе вот что хотел сказать, Машенька: очертенела мне вся эта чепуха."
                            }
                        ]
                    }
