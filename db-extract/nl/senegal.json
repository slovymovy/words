                                        "sense_id": "b9062cf5-0702-3708-8dac-d5133aa73571",
                                        "entry_id": "0375a36f-11d8-37e1-98ee-5f42507f9e69",
                                        "glosses": [
                                            "Río de África Occidental, que nace en Guinea y desemboca en Senegal₁."
                                        ],
                                        "tags": [
