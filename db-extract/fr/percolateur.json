        "fr-extract.jsonl": [
            {
                "entry_id": "1e7f1144-4f45-38e8-a39c-c85ab52d10d6",
                "word": "percolateur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dc164042-1277-4736-b899-85bb6938c666",
                        "entry_id": "1e7f1144-4f45-38e8-a39c-c85ab52d10d6",
                        "tags": [
                            "plural"
                        ],
                        "form": "percolateurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d36d7d4e-dae6-36dd-aa52-0d3355eb49ca",
                        "entry_id": "1e7f1144-4f45-38e8-a39c-c85ab52d10d6",
                        "glosses": [
                            "Appareil servant à la lixiviation de diverses substances, généralement des végétaux."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c3484a1c-bb6b-38d7-9627-c5879760027d",
                        "entry_id": "1e7f1144-4f45-38e8-a39c-c85ab52d10d6",
                        "glosses": [
                            "Grand récipient muni d’une poignée, sur lequel est monté un filtre qui permet de préparer du café selon le processus de lixiviation, de l’eau très chaude à travers le café moulu, et utilisé pour une consommation de café en grande quantité."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "9ffe752a-15da-438b-9509-8697b1d789d3",
                                "sense_id": "c3484a1c-bb6b-38d7-9627-c5879760027d",
                                "text": "Je vis, sur le comptoir de la salle éteinte, une discrète flamme de gaz brûler sous le percolateur […]."
                            },
                            {
                                "example_id": "c4d732a0-44c4-44cb-af48-0db6638a9035",
                                "sense_id": "c3484a1c-bb6b-38d7-9627-c5879760027d",
                                "text": "Un bon café, Blake veut dire un vraiment bon, est un miracle né de la collaboration intime d’un excellent grain, ici un Nicaragua fraîchement torréfié, à la mouture fine, d’une eau filtrée et adoucie et d’un percolateur, dans ce cas précis un Cimbali, nettoyé chaque jour."
                            },
                            {
                                "example_id": "5a244f65-215f-45e8-ad3a-f431d43dd05b",
                                "sense_id": "c3484a1c-bb6b-38d7-9627-c5879760027d",
                                "text": "À la Grilladerie d’Aliénor ce matin du 9 août 2023, Patrice Hery enchaîne les allers-retours entre le percolateur et la terrasse, où les habitués sont au café, plongés dans la lecture du journal, quand d’autres parlent des vacances passées ou à venir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ce60807-db97-4f99-9ea4-0b09865ffcd7",
                        "source_entry_id": "1e7f1144-4f45-38e8-a39c-c85ab52d10d6",
                        "target_lang_word": "percolator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "percolator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d46ab76f-1d83-3836-a8b5-b293bb548d84",
                                        "entry_id": "75328dee-149f-378e-b795-9e9c4ec24d35",
                                        "glosses": [
                                            "A device used to brew coffee by passing boiling water through coffee grounds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30b03b3e-2a04-4d70-8786-9f4b4131f2c0",
                                                "sense_id": "d46ab76f-1d83-3836-a8b5-b293bb548d84",
                                                "text": "She heard the percolator bell ring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5d0e66f-1acc-315d-a271-5caba594954c",
                                        "entry_id": "75328dee-149f-378e-b795-9e9c4ec24d35",
                                        "glosses": [
                                            "A pharmaceutical apparatus for producing an extract from a drug by percolation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
