{
    "word_family": [
        "discernment",
        "discerning",
        "discernible"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4cb6921c-ff44-3e94-88ba-7ef756236504",
                    "sense_definition": "To detect something using the senses, especially by looking with the eyes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was difficult to <w>discern</w> the ship through the thick morning fog.",
                            "target_lang_translations": {
                                "tr": "Yoğun sabah sisinin içinde gemiyi <w>seçmek</w> zordu."
                            }
                        },
                        {
                            "text": "I could barely <w>discern</w> a faint light in the distance.",
                            "target_lang_translations": {
                                "tr": "Uzaktaki soluk ışığı zar zor <w>fark edebildim</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "see",
                        "spot",
                        "spy"
                    ],
                    "common_phrases": [
                        "discern a shape",
                        "discern a figure"
                    ],
                    "target_lang_definitions": {
                        "tr": "Duyuları kullanarak, özellikle gözle bakarak bir şeyi fark etmek veya görmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "fark etmek",
                                "target_lang_sense_clarification": "Bir şeyi görme veya algılama eylemi."
                            },
                            {
                                "target_lang_word": "seçmek",
                                "target_lang_sense_clarification": "Belirsiz bir şeyi gözle ayırt etmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a84c83a-6547-3d27-ab6c-f8bdb1727847",
                    "sense_definition": "To perceive, recognize, or understand something with the mind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective tried to <w>discern</w> the truth behind the confusing story.",
                            "target_lang_translations": {
                                "tr": "Dedektif, kafa karıştırıcı hikayenin ardındaki gerçeği <w>anlamaya</w> çalıştı."
                            }
                        },
                        {
                            "text": "It is hard to <w>discern</w> any clear pattern in these complex data sets.",
                            "target_lang_translations": {
                                "tr": "Bu karmaşık veri setlerinde net bir örüntü <w>kavramak</w> zordur."
                            }
                        }
                    ],
                    "synonyms": [
                        "see",
                        "ken"
                    ],
                    "common_phrases": [
                        "discern the truth",
                        "discern a pattern"
                    ],
                    "target_lang_definitions": {
                        "tr": "Zihin yoluyla bir şeyi algılamak, tanımak veya anlamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "anlamak",
                                "target_lang_sense_clarification": "Bir durumun veya gerçeğin özünü kavramak."
                            },
                            {
                                "target_lang_word": "kavramak",
                                "target_lang_sense_clarification": "Karmaşık bir durumu zihinsel olarak çözmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e97b1e7b-bc8f-3906-90b0-e320a94de78b",
                    "sense_definition": "To distinguish or differentiate between two or more things.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "differentiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child was finally able to <w>discern</w> between right and wrong.",
                            "target_lang_translations": {
                                "tr": "Çocuk sonunda doğru ile yanlışı <w>ayırt edebildi</w>."
                            }
                        },
                        {
                            "text": "Experts can <w>discern</w> subtle differences in the quality of the wine.",
                            "target_lang_translations": {
                                "tr": "Uzmanlar, şarabın kalitesindeki ince farkları <w>ayırt edebilirler</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "distinguish",
                        "discriminate",
                        "tell apart"
                    ],
                    "common_phrases": [
                        "discern between",
                        "discern right from wrong"
                    ],
                    "target_lang_definitions": {
                        "tr": "İki veya daha fazla şey arasında ayrım yapmak veya farklılıkları belirlemek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ayırt etmek",
                                "target_lang_sense_clarification": "İki şey arasındaki farkı belirlemek."
                            },
                            {
                                "target_lang_word": "ayrım yapmak",
                                "target_lang_sense_clarification": "Farklılıkları ortaya koymak."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}