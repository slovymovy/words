                                    {
                                        "sense_id": "73d3e62f-5ca2-358c-a818-bfefc6d808b3",
                                        "entry_id": "9131c1d4-c880-367c-b4af-9bbd59c24456",
                                        "glosses": [
                                            "Zweig der Zoologie, der sich wissenschaftlich mit den Vögeln beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35fd5907-6de5-4aa8-be85-9c5dd36575d9",
                                                "sense_id": "73d3e62f-5ca2-358c-a818-bfefc6d808b3",
                                                "text": "„Alfred Brehm sei ein Volksaufklärer gewesen, der Kenntnisse aus der Biologie verständlich vermittelt habe, erklärt Brehm-Kenner Dietrich von Knorre. Vater Christian Ludwig Brehm (1787-1864) gelte bis heute als einer der wichtigsten Altmeister der Vogelkunde. Er legte eine Sammlung von Vogelpräparaten an, die bei seinem Tod rund 9000 Stück umfasste.“"
                                            },
                                            {
                                                "example_id": "9041f037-790e-47d5-90e8-8693825ec1e6",
                                                "sense_id": "73d3e62f-5ca2-358c-a818-bfefc6d808b3",
                                                "text": "„In Friedrichs Bibliothek befanden sich arabische Texte zur Vogelkunde, die er übersetzen ließ und ausgiebig studierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ace2a90-8f5a-4926-a662-cb2fa45b9557",
                        "source_entry_id": "782da415-2cbd-3419-83ed-c0ee8e287e11",
                        "source_sense_id": "664d5b09-3f52-390f-8be4-e72ca1bcd120",
