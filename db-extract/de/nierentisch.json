                    {
                        "sense_id": "918d3a8b-82b3-3a48-b2bc-f4c4cca3a455",
                        "entry_id": "9525384a-8a78-3247-952f-a7c36c6c8309",
                        "glosses": [
                            "niedriger Tisch, mit annähernd nierenförmiger Tischplatte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a09ae1e5-3524-4d01-b80c-991f31ec33e5",
                                "sense_id": "918d3a8b-82b3-3a48-b2bc-f4c4cca3a455",
                                "text": "„Haartolle, Nierentisch und andere Fifties-Devotionalien beherrschten am Sonntag beim \"Fest der Freiheit\" den Wiener Rathausplatz.“"
                            },
                            {
                                "example_id": "2aef4e2e-f5fd-4548-9c38-3134a4ef36de",
                                "sense_id": "918d3a8b-82b3-3a48-b2bc-f4c4cca3a455",
                                "text": "„Die Leichtigkeit des Wohnens und besonders der Nierentisch waren in diesem Sinne Teil des Neuanfangs, der von der Last der Vergangenheit befreien sollte.“"
                            }
                        ],
