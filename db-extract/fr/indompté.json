                    },
                    {
                        "form_id": "7693e498-f359-4e12-858a-709d24a23e53",
                        "entry_id": "fb7e9918-9403-3f24-8780-01a756566f3e",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "indomptées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b00e1dc-7f20-379e-b398-632f87b9d174",
                        "entry_id": "fb7e9918-9403-3f24-8780-01a756566f3e",
                        "glosses": [
                            "Qui n’est pas dompté ; qui n’a pu encore être dompté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c619430d-0e0c-4aa1-829d-e3aca2019034",
                                "sense_id": "4b00e1dc-7f20-379e-b398-632f87b9d174",
                                "text": "C’était un enfant sans raison, qui, parfois, galopait au moindre caprice, ainsi qu’un animal indompté."
                            },
                            {
                                "example_id": "854f04dc-1956-4101-81c9-f541770441f8",
                                "sense_id": "4b00e1dc-7f20-379e-b398-632f87b9d174",
                                "text": "Mon fils, dit l’homme, tu es venu chez moi en tant que jouvenceau bon à prendre, et tu en es sorti — grâce soit rendue à Dieu ! — tel un bel étalon indompté."
                            }
                        ]
                    },
                    {
                        "sense_id": "90376bdd-6565-30c4-b31b-f36a2ee07722",
                        "entry_id": "fb7e9918-9403-3f24-8780-01a756566f3e",
                        "glosses": [
                            "Qui ne peut être contenu, réprimé, asservi."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7b445d8e-aa06-4d8c-9f4f-18334bd56052",
                                "sense_id": "90376bdd-6565-30c4-b31b-f36a2ee07722",
                                "text": "C’est un courage indompté."
                            },
                            {
                                "example_id": "129c7aa4-5dc1-44d6-9c49-9d009af30eb3",
                                "sense_id": "90376bdd-6565-30c4-b31b-f36a2ee07722",
                                "text": "Un orgueil indompté."
                            },
                            {
                                "example_id": "8c93d16d-dd20-43b5-a8ea-21d6ec58879a",
                                "sense_id": "90376bdd-6565-30c4-b31b-f36a2ee07722",
                                "text": "Non plus géant, semblable aux Esprits, fier et libre,\nEt toujours indompté, sinon victorieux ;\nMais servile, rampant, rusé, lâche, envieux,\nChair glacée où plus rien ne fermente et ne vibre,\nL’homme pullulera de nouveau sous les cieux."
                            },
                            {
                                "example_id": "e3ad1d56-4eca-4803-9a13-613b60a7e086",
                                "sense_id": "90376bdd-6565-30c4-b31b-f36a2ee07722",
                                "text": "Aussi, quand sous le nombre ils fléchirent, avec\nQuelle rage les bons bourgeois de la milice\nTuèrent les blessés indomptés à l’œil sec!"
                            },
                            {
                                "example_id": "49114a56-729c-4c44-b392-52461bab370d",
                                "sense_id": "90376bdd-6565-30c4-b31b-f36a2ee07722",
                                "text": "La collection Les Plis offre un regard inédit, intime et iconoclaste sur la biographie et le monde­ intérieur de quelques-uns des plus grands penseurs, artistes, femmes et hommes politiques de tous les temps : l’unique étiquette que ces classiques indomptés supportent est le timbre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d95fc3f0-ed38-4fe4-990a-2ea7151183ab",
                        "source_entry_id": "fb7e9918-9403-3f24-8780-01a756566f3e",
                        "target_lang_word": "untamed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "untamed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed024c73-6cb3-39be-bbf1-127f7f1367ce",
                                        "entry_id": "8b10cd85-f76f-3fbb-9998-12c8dd06e78e",
                                        "glosses": [
                                            "Wild, uncontrolled, especially of animals not domesticated or trained to human contact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f2d917b-f72a-49a4-b69f-c6e0afe0cfd8",
                                                "sense_id": "ed024c73-6cb3-39be-bbf1-127f7f1367ce",
                                                "text": "The mustang is an untamed horse that roams where it wants, with little interest in humans."
                                            },
                                            {
                                                "example_id": "a31ce45d-cf5e-4791-bd23-0134b8a6a4a5",
                                                "sense_id": "ed024c73-6cb3-39be-bbf1-127f7f1367ce",
                                                "text": "Kjelsås (six miles) marks the end of the suburbs, and the line immediately plunges into Nordmarka. This vast untamed area of forest and mountain (much of it over 2,000 ft. above sea level), interspersed with innumerable lakes, large and small, is known as Oslo's playground."
                                            },
                                            {
                                                "example_id": "e84d24a7-4570-4970-adc6-4dc8eb721474",
                                                "sense_id": "ed024c73-6cb3-39be-bbf1-127f7f1367ce",
                                                "text": "John Wesley Powell ... the one-armed Civil War veteran led nine men in four wooden dories down the untamed and uncharted Colorado River and into the equally untamed and uncharted Grand Canyon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
