                        "examples": [
                            {
                                "example_id": "ab4ebcd8-710a-4f79-be97-111e55eb9b6c",
                                "sense_id": "7374bcc5-d555-3b02-9e92-1faa023de3d4",
                                "text": "Cette mission, financée grâce à l’instauration d’une nouvelle taxe perçue sur la vente des produits phytopharmaceutiques, permet d’abord de répondre aux critiques relatives aux carences du suivi post-homologation."
                            },
                            {
                                "example_id": "fa11b63f-47ac-4b40-bbac-37bab985b5b3",
                                "sense_id": "7374bcc5-d555-3b02-9e92-1faa023de3d4",
                                "text": "Les 55 000 à 70 000 tonnes de produits phytopharmaceutiques vendues chaque année en France auraient des conséquences majeures sur la contamination des sols et des cours d’eau, sur le déclin des invertébrés, des amphibiens et des oiseaux."
                            }
                        ]
                    }
