                        "examples": [
                            {
                                "example_id": "dd301d99-ba99-482e-b137-eee5463dd09e",
                                "sense_id": "2fd43242-d0a4-3b89-8202-416188d34b90",
                                "text": "„Messen sich drehender Werkstücke und Herausziehen der Prüfkörper aus angestellten Schieblehren zerstören die Meßflächen der Schieblehren.“"
                            },
                            {
                                "example_id": "2e301f05-1634-4b6f-8870-db926e86436e",
                                "sense_id": "2fd43242-d0a4-3b89-8202-416188d34b90",
                                "text": "„Das Video stellt acht Apps vor, die das iPhone als Messband, Waage, Wasserwaage, Schieblehre und Lärmmesser nutzbar machen.“"
                            }
                        ],
