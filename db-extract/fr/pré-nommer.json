                        "entry_id": "ad80b984-668e-3f02-b9e2-ccf72c99508c",
                        "glosses": [
                            "Donner un premier nom à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5216463b-c4bc-46ba-ab0d-2a264a70c9f6",
                                "sense_id": "bc831af2-cbe0-310e-8280-c2fd07aa8632",
                                "text": "La voix ne fait plus, ne peut plus faire, que pré-nommer les choses, et — nous le savons aujourd'hui mieux que naguère — c'est cela l'opération poétique par excellence."
                            }
                        ]
