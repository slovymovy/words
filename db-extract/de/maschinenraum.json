                "senses": [
                    {
                        "sense_id": "9dffcc51-9145-3f0d-84e9-36cc37942c5c",
                        "entry_id": "132857aa-5116-33d9-b2d7-721316ea7733",
                        "glosses": [
                            "Raum, in dem sich Maschinen/Motoren befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4497f4f7-9033-45c3-a696-ef292257a5bb",
                                "sense_id": "9dffcc51-9145-3f0d-84e9-36cc37942c5c",
                                "text": "„Schließlich klatschte Priese mehrmals in die Hände, worauf sich der ganze Trupp in disziplinierter Folgsamkeit wieder hinab in den Maschinenraum begab.“"
                            },
                            {
                                "example_id": "56e80071-6ab9-46b9-8c7c-28a37fd09e5b",
                                "sense_id": "9dffcc51-9145-3f0d-84e9-36cc37942c5c",
                                "text": "„Der letzte Torpedo traf mittschiffs den Maschinenraum.“"
                            },
                            {
                                "example_id": "7fa67af2-edad-4407-af45-777acbd0beda",
                                "sense_id": "9dffcc51-9145-3f0d-84e9-36cc37942c5c",
                                "text": "„Der Morgen kommt auf, es brummt aus dem Maschinenraum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
