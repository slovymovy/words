                "senses": [
                    {
                        "sense_id": "3df34840-bcb5-3f6f-8e17-2ad4099e2574",
                        "entry_id": "af231ccf-20b1-39f1-926b-4172f4d63f0a",
                        "glosses": [
                            "(Plural: Spathen, Spathae) scheidenartige Blatthülle des Blütenstandes - eine besondere Form von Hochblättern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "597f132c-7089-41bf-9b58-82d87002217b",
                                "sense_id": "3df34840-bcb5-3f6f-8e17-2ad4099e2574",
                                "text": "Die Spatha ist besonders auffällig bei Aronstabgewächsen und Palmen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f99e20b0-921a-341b-b282-400157f61c50",
                        "entry_id": "af231ccf-20b1-39f1-926b-4172f4d63f0a",
                        "glosses": [
                            "(Plural: Spathen) zweischneidiges Langschwert mit gerader Klinge"
                        ],
                        "tags": [
                            "Waffenkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "bbb84783-5b35-428a-864a-83af3681628e",
                                "sense_id": "f99e20b0-921a-341b-b282-400157f61c50",
                                "text": "Die Kavallerie der Germanen verwendeten als Schwert vorwiegend die Spatha."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18f75ecd-c9fe-402f-b70b-7180663fc9db",
                        "source_entry_id": "af231ccf-20b1-39f1-926b-4172f4d63f0a",
