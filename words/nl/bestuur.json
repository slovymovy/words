                            },
                            {
                                "target_lang_word": "governance",
                                "target_lang_sense_clarification": "period of administration"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "правление",
                                "target_lang_sense_clarification": "период пребывания у власти"
