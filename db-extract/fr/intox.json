                                "target_senses": [
                                    {
                                        "sense_id": "1531a3e6-a98d-3ce8-8f05-ce938a463dd4",
                                        "entry_id": "96af5afa-d054-356f-9461-c66ca56f5ac0",
                                        "glosses": [
                                            "False information intentionally disseminated to deliberately confuse or mislead; intentional misinformation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e6a9656-650c-3b58-a98b-a7aeb4df5370",
                                        "entry_id": "96af5afa-d054-356f-9461-c66ca56f5ac0",
                                        "glosses": [
                                            "Fabricated or deliberately manipulated content; intentionally created conspiracy theories or rumors."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aed5d3b-7037-4a8c-b63d-3f9c956c71ae",
                                                "sense_id": "9e6a9656-650c-3b58-a98b-a7aeb4df5370",
                                                "text": "Moreover, Trump’s use of obvious disinformation — the amateurish video he showed Ramaphosa, and his accompanying statements about the “over a thousand” killings of white farmers — to try and make his case has uprooted whatever U.S. credibility had survived over the last several months."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disinformation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6851d015-998a-3e93-8685-cc6fdabaac01",
                                        "entry_id": "e1a116b1-2fe8-375a-8626-9da28dd3fa81",
                                        "glosses": [
                                            "To use disinformation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a779ffc6-1211-4f06-99ea-4fd53931f726",
                                                "sense_id": "6851d015-998a-3e93-8685-cc6fdabaac01",
                                                "text": "A country cannot disinformation its way out of fallen soldiers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fb2b716-e61d-46a6-9e46-55589b14e3db",
                        "source_entry_id": "abf95790-a7ee-384e-85c7-b9c6e2988359",
                        "source_sense_description": "matraquage",
                        "target_lang_word": "propaganda",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "propaganda",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0933bf54-58ae-3b69-93a6-9c9c6acd816e",
                                        "entry_id": "d84aeaab-2f1a-3d97-94e2-ed2559188a67",
                                        "glosses": [
                                            "Agitation, publicity, public communication aimed at influencing an audience and furthering an agenda."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be9ef222-96e8-45b8-be73-7f6ca2aa3ff2",
                                                "sense_id": "0933bf54-58ae-3b69-93a6-9c9c6acd816e",
                                                "text": "Despite being biased and often untrue, propaganda material can be useful in OSINT analysis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "398412b6-7efc-3fcb-ad48-264c9903b507",
                                        "entry_id": "d84aeaab-2f1a-3d97-94e2-ed2559188a67",
                                        "glosses": [
                                            "Agitation, publicity, public communication aimed at influencing an audience and furthering an agenda.",
                                            "The propagation of the faith by the Catholic Church by means of missionary work etc."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3a0858b-215f-3ef3-bed3-1bc34b6f0ab9",
                                        "entry_id": "d84aeaab-2f1a-3d97-94e2-ed2559188a67",
                                        "glosses": [
                                            "Such communication specifically when it is biased, misleading, and/or provoking mainly emotional responses."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7af90a27-64f7-480b-bafe-9939b9a0319b",
                                                "sense_id": "f3a0858b-215f-3ef3-bed3-1bc34b6f0ab9",
                                                "text": "They established a government propaganda commission, called the Creel Commission, which succeeded, within six months, in turning a pacifist population into a hysterical, war-mongering population which wanted to destroy everything German, tear the Germans limb from limb, go to war and save the world."
                                            },
                                            {
                                                "example_id": "dcd81668-5dc7-4d43-8374-c05805fa0309",
                                                "sense_id": "f3a0858b-215f-3ef3-bed3-1bc34b6f0ab9",
                                                "text": "In this metropolis that had a prewar population of almost a million, but where the city center now feels like an Orwellian ghost town of propaganda posters and armed patrols, perhaps no one feels more alone than those who still harbor pro-Ukrainian sentiments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
