                        "entry_id": "e1beb680-2d2c-3431-8b10-d31c1a7b6601",
                        "glosses": [
                            "Resembling or befitting a church or a worship service."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ef08087-b903-4e99-b13b-9f157dc3aead",
                                "sense_id": "dafece08-5db0-3bf3-b2c4-a5c7c83473ac",
                                "text": "The new part, containing the schoolroom and dormitory, was lit by mullioned and latticed windows, which gave it a church-like aspect […]"
                            },
                            {
                                "example_id": "e97726ca-ec6e-4e3c-b57c-1873d10da90c",
                                "sense_id": "dafece08-5db0-3bf3-b2c4-a5c7c83473ac",
                                "text": "The court was filled. Some people even stood behind the churchlike benches in the rear."
                            },
                            {
                                "example_id": "f4eba75c-a41b-456b-a286-00fd6f667e62",
                                "sense_id": "dafece08-5db0-3bf3-b2c4-a5c7c83473ac",
                                "text": "There are churchlike or synagoguelike chapels and leaders who deliver Sunday sermons, perform pastoral duties, and conduct \"services,\" though without prayer to a deity."
                            },
                            {
                                "example_id": "fdb84eff-44d4-4564-af90-1578d4951479",
                                "sense_id": "dafece08-5db0-3bf3-b2c4-a5c7c83473ac",
                                "text": "This is […] a break with the practice at American diamond stores, where shopping for engagement rings is a solemnized and somewhat stressfully churchlike experience of awe and trembling before the altar of massive debt."
                            }
                        ]
                    }
