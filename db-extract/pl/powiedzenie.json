                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "saying",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6809872e-935a-3fe9-a83b-fa1293f13bce",
                                        "entry_id": "79b6494e-dce9-363f-ba27-a8493ee6eda7",
                                        "glosses": [
                                            "A proverb or maxim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "115324ea-176d-40e1-93a6-fd5329f0d791",
                                                "sense_id": "6809872e-935a-3fe9-a83b-fa1293f13bce",
                                                "text": "There is a Chinese saying: \"One who does not know how to smile has no business to be in business.\" How much truer is this of people engaged in the business of diplomacy!"
                                            },
                                            {
                                                "example_id": "c0ed66a3-f568-4b94-a14b-fb8acde67392",
                                                "sense_id": "6809872e-935a-3fe9-a83b-fa1293f13bce",
                                                "text": "Garrus: Fist knows you're coming. We'll have a better chance if we all work together.\nWrex: My people have a saying: Seek the enemy of your enemy, and you will find a friend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28595bc8-8098-3211-bce8-cccd3efc9768",
                                        "entry_id": "79b6494e-dce9-363f-ba27-a8493ee6eda7",
                                        "glosses": [
                                            "That which is said; an utterance."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe75758f-f2ac-4f20-b4b5-dd6a70da7b4d",
                                                "sense_id": "28595bc8-8098-3211-bce8-cccd3efc9768",
                                                "text": "And I'll be sworn you would believe my saying,\nHowe'er you lean to th' nayward."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "saying",
