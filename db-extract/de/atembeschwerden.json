                "senses": [
                    {
                        "sense_id": "d3cf7901-13a7-3657-a6d2-3d8fbce6ce58",
                        "entry_id": "999d18ce-6e40-3ed3-9c15-0dbcbe138dfd",
                        "glosses": [
                            "Beschwerden oder Symptome, bei denen die freie Atmung aus unterschiedlichsten Gründen (starke ungewohnte körperliche Belastung, Erkältung, Reizung der Atemwege durch Schadstoffe oder Zigarettenrauch) eingeschränkt ist oder der Betroffene das Gefühl hat, nicht genug Luft zu bekommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d495e170-9a1b-4d0b-9acd-93333f25966f",
                                "sense_id": "d3cf7901-13a7-3657-a6d2-3d8fbce6ce58",
                                "text": "\"Atembeschwerden mit dem Gefühl, nicht genug Luft zu bekommen.\""
                            },
                            {
                                "example_id": "8340144a-692e-4982-89b2-99caf237aff7",
                                "sense_id": "d3cf7901-13a7-3657-a6d2-3d8fbce6ce58",
                                "text": "„Ich lag auf dem Sofa, hatte Atembeschwerden und befürchtete schon das Schlimmste.“"
                            },
                            {
                                "example_id": "92fb55f8-7916-43f8-9acf-5dcfa5d8482b",
                                "sense_id": "d3cf7901-13a7-3657-a6d2-3d8fbce6ce58",
                                "text": "„Er war mager und bitter, viel jünger, als er aussah, und vom vielen Zgarettenrauchen hatte er Atembeschwerden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
