{
    "word_family": [
        "mérite",
        "méritant",
        "méritoire",
        "démériter",
        "démérite",
        "méritoirement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a03516a-2a9f-3b08-a96e-e9d7dd1a609e",
                    "sense_definition": "Être digne d'un avantage, d'un succès ou d'une récompense en raison de ses actes, de son travail ou de ses qualités.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "recompense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après tous ces efforts intenses, les élèves <w>méritent</w> une belle récompense."
                        },
                        {
                            "text": "Ce jeune athlète s'entraîne chaque jour et il <w>mérite</w> de gagner la compétition."
                        }
                    ],
                    "common_phrases": [
                        "mériter une récompense",
                        "mériter le respect",
                        "mériter de gagner"
                    ]
                },
                {
                    "sense_id": "cef96105-66c2-3eaa-8667-ff7e85ccc85f",
                    "sense_definition": "En parlant d'une chose, justifier de l'intérêt, un examen attentif ou une démarche spécifique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "valeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette proposition inattendue est intéressante et elle <w>mérite</w> réflexion avant d'agir."
                        },
                        {
                            "text": "Le nouveau roman de cet écrivain <w>mérite</w> l'attention de tous les critiques."
                        }
                    ],
                    "synonyms": [
                        "valoir",
                        "justifier"
                    ],
                    "common_phrases": [
                        "mériter réflexion",
                        "mériter l'attention"
                    ]
                },
                {
                    "sense_id": "b52fcbdb-1d40-3683-9f01-0622690f98bf",
                    "sense_definition": "Encourir légitimement un désagrément, une sanction ou un blâme à cause de sa mauvaise conduite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "punition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour avoir menti à ses parents, l'enfant <w>mérite</w> une punition exemplaire."
                        },
                        {
                            "text": "Le conducteur imprudent qui a causé l'accident <w>méritait</w> une lourde sanction."
                        }
                    ],
                    "synonyms": [
                        "encourir",
                        "s'attirer"
                    ],
                    "common_phrases": [
                        "mériter une punition",
                        "mériter un blâme"
                    ]
                },
                {
                    "sense_id": "be2d17b2-378c-3141-b7c3-2e672d6aa278",
                    "sense_definition": "Acquérir des droits particuliers à la reconnaissance et à la considération publique pour des services rendus.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reconnaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce savant a consacré toute sa vie à la recherche et a bien <w>mérité</w> de la patrie."
                        },
                        {
                            "text": "Le conseil municipal a affirmé que cet enseignant avait bien <w>mérité</w> de sa commune."
                        }
                    ],
                    "common_phrases": [
                        "bien mériter de la patrie"
                    ]
                }
            ]
        }
    ]
}