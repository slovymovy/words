                ],
                "senses": [
                    {
                        "sense_id": "d8bb145d-2e36-36db-addd-5a344796c35b",
                        "entry_id": "086dded4-494a-38e2-8842-167fddc009b5",
                        "glosses": [
                            "Vorgabe, nach der Abgaben an den Staat zu zahlen und andere Regeln der Steuergesetze zu befolgen sind (beispielsweise Steuererklärungen einzureichen)"
                        ],
                        "tags": [
                            "Steuerrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "4ecf035a-de27-414b-a969-698f26355eca",
                                "sense_id": "d8bb145d-2e36-36db-addd-5a344796c35b",
                                "text": "Wer in Deutschland ein Gewerbe betreibt, unterliegt hier der Steuerpflicht."
                            },
                            {
                                "example_id": "11b5b0db-9834-41ad-821f-f0a9bc53c852",
                                "sense_id": "d8bb145d-2e36-36db-addd-5a344796c35b",
                                "text": "Niedrige Einkommen sind von der Steuerpflicht befreit."
                            },
                            {
                                "example_id": "11906985-47b4-4a20-b9f4-900e8ff0e27a",
                                "sense_id": "d8bb145d-2e36-36db-addd-5a344796c35b",
                                "text": "Ich habe meine Steuerpflichten immer korrekt erfüllt."
                            },
                            {
                                "example_id": "f73c6581-6012-4676-ab7c-b67fe0f985dc",
                                "sense_id": "d8bb145d-2e36-36db-addd-5a344796c35b",
                                "text": "„Die größten Städte waren Köln, Augsburg und Nürnberg mit jeweils zwischen 40000 und 50000 Einwohnern, nicht zu verwechseln mit der sehr viel geringeren Zahl an Männern mit Bürgerrecht, das an Hausbesitz und Steuerpflicht geknüpft war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
