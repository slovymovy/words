                ],
                "senses": [
                    {
                        "sense_id": "fa0e5e6c-733d-3cde-9216-c952969be345",
                        "entry_id": "ed72c4ec-7b68-37bd-9695-0f2cea3d1952",
                        "glosses": [
                            "To remove wrinkles from."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c58a4b77-93ac-4d1c-915b-d9ce8b307873",
                                "sense_id": "fa0e5e6c-733d-3cde-9216-c952969be345",
                                "text": "He and she sat side by side like two wax people while the waiter stretched across to unwrinkle the tablecloth and straighten the knives."
                            },
                            {
                                "example_id": "f9163cb4-b482-4da0-a59d-f0d3e682fcd7",
                                "sense_id": "fa0e5e6c-733d-3cde-9216-c952969be345",
                                "text": "The job was done before Silver could unwrinkle the grimace on his face."
                            }
                        ]
                    },
                    {
                        "sense_id": "68ba59be-c17b-3020-91e2-6e5361c7354e",
                        "entry_id": "ed72c4ec-7b68-37bd-9695-0f2cea3d1952",
                        "glosses": [
                            "To stop being wrinkly; to become flat or smooth."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d0ab5103-7382-4a4e-a75b-323881d42ad3",
                                "sense_id": "68ba59be-c17b-3020-91e2-6e5361c7354e",
                                "text": "His head protruded out of his torn collar much as the head of the tortoise protrudes from its shell, the throat unwrinkling, the eyes like beads, or pips of jet."
                            },
                            {
                                "example_id": "19199ca2-4b3b-4e99-b4bf-f857f631ce6b",
                                "sense_id": "68ba59be-c17b-3020-91e2-6e5361c7354e",
                                "text": "In a rain barrel, water\nunwrinkles to glass;\na lime tree’s daughter\nthere studies her face."
                            },
                            {
                                "example_id": "3a5f367c-7d4b-4903-9b95-0b539a349c9b",
                                "sense_id": "68ba59be-c17b-3020-91e2-6e5361c7354e",
                                "text": "Emma went through the closet and removed the black gabardine jacket she had hung up to unwrinkle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acc731e8-791c-46d9-a0ec-b1c8635b6101",
                        "source_entry_id": "ed72c4ec-7b68-37bd-9695-0f2cea3d1952",
                        "source_sense_description": "to remove wrinkles from",
                        "target_lang_word": "glätten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glätten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e28e854-b02b-327f-a31c-c7071b61e0b4",
                                        "entry_id": "e6057bde-ea17-368c-8f6a-5eef44fcaa13",
                                        "glosses": [
                                            "Unebenheit verringern, etwas glatter machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62be4cfd-512c-4750-b6d1-35ee4f998715",
                                                "sense_id": "7e28e854-b02b-327f-a31c-c7071b61e0b4",
                                                "text": "Nach dem Orkan glättete sich die See schnell wieder."
                                            },
                                            {
                                                "example_id": "d2d692c5-6d7e-4f5c-b96d-d21a8209c88d",
                                                "sense_id": "7e28e854-b02b-327f-a31c-c7071b61e0b4",
                                                "text": "„Diese Creme soll meine Hautfalten glätten. Ich hoffe, sie wirkt!“"
                                            },
                                            {
                                                "example_id": "e974e715-e740-4d4c-8fac-057a2c62a2d5",
                                                "sense_id": "7e28e854-b02b-327f-a31c-c7071b61e0b4",
                                                "text": "Wir müssen die Oberfläche glätten, um eine bessere Wirkung zu erzielen."
                                            },
                                            {
                                                "example_id": "3fe72284-b8b0-4550-8041-8fc66c76cf6c",
                                                "sense_id": "7e28e854-b02b-327f-a31c-c7071b61e0b4",
                                                "text": "Ich breitete die zerknitterte Alufolie vorsichtig vor mir aus und strich mit der Hand drüber, um sie zu glätten."
                                            },
                                            {
                                                "example_id": "d55c96b8-4c75-4c2c-810c-6a5c18f9732a",
                                                "sense_id": "7e28e854-b02b-327f-a31c-c7071b61e0b4",
                                                "text": "Eine gute Definition von \"bügeln\" ist \"Stoff glätten mit Hilfe von Hitze und Dampf\"."
                                            },
                                            {
                                                "example_id": "08ad7283-73fa-4b76-b9ce-d799d69fc601",
                                                "sense_id": "7e28e854-b02b-327f-a31c-c7071b61e0b4",
                                                "text": "Mit einem Peeling werden abgestorbene Hautschüppchen entfernt, die Haut wird geglättet und sieht frischer aus. Danach erscheinen große Poren feiner."
                                            },
                                            {
                                                "example_id": "d68f940d-c34e-4bf1-93b1-fcdbd8546e41",
                                                "sense_id": "7e28e854-b02b-327f-a31c-c7071b61e0b4",
                                                "text": "Bis heute bleichen sich tausende afrikanische Frauen die Haut und glätten ihre Haare, um dem westlichen Schönheitsideal zu entsprechen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ee9fe06-0fe9-3bb0-9c8f-6cb75ef2e130",
                                        "entry_id": "e6057bde-ea17-368c-8f6a-5eef44fcaa13",
                                        "glosses": [
                                            "eine noch nicht perfekte Arbeit überarbeiten"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "569648c3-de93-4b27-a570-20158cc32d92",
                                                "sense_id": "7ee9fe06-0fe9-3bb0-9c8f-6cb75ef2e130",
                                                "text": "Davor soll es eine letzte Verhandlungsrunde geben, um noch einige wenige strittige Punkte oder Formulierungen zu glätten."
                                            },
                                            {
                                                "example_id": "3487b195-3127-4a1f-8c37-00ea54b72a45",
                                                "sense_id": "7ee9fe06-0fe9-3bb0-9c8f-6cb75ef2e130",
                                                "text": "In der AfD gibt es einen deutlich marktradikal, wirtschaftsliberal orientierten Flügel, der klassische Forderungen, wie zum Beispiel die Abschaffung des Arbeitslosengeldes, ins Programm geschrieben hat. Jetzt stellen wir fest, der aktuelle Entwurf ist geglättet worden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "769b4247-db79-31e5-894f-ca56fc19da6a",
                                        "entry_id": "e6057bde-ea17-368c-8f6a-5eef44fcaa13",
                                        "glosses": [
                                            "jemandes Zorn oder Erregung vermindern"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aac03edf-0dc7-48ca-9ac2-f80b4056b1d1",
                                                "sense_id": "769b4247-db79-31e5-894f-ca56fc19da6a",
                                                "text": "Der Politiker [aus der Ukrainie, Wolodymyr Hroisman,] gilt als jemand, der Konflikte glätten und Kompromisse aushandeln kann."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
