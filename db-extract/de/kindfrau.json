                                "target_senses": [
                                    {
                                        "sense_id": "ed1facbe-8c85-38e2-9b5f-fb85445ce1c5",
                                        "entry_id": "1d671dba-6725-366a-bf77-6b7c4682198d",
                                        "glosses": [
                                            "A child's nurse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17a6722e-c032-4263-a1ac-5f5975a48afb",
                                                "sense_id": "ed1facbe-8c85-38e2-9b5f-fb85445ce1c5",
                                                "text": "Nanny Broome was looking up at the outer wall. Just under the ceiling there were three lunette windows, heavily barred and blacked out in the normal way by centuries of grime. Their bases were on a level with the pavement outside, a narrow way which was several feet lower than the road behind the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d800a96a-5b42-31d1-a3ee-bac5aaaf915e",
                                        "entry_id": "1d671dba-6725-366a-bf77-6b7c4682198d",
                                        "glosses": [
                                            "A grandmother."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef24633a-8647-382e-8c6f-1a7c96dc2eb0",
                                        "entry_id": "1d671dba-6725-366a-bf77-6b7c4682198d",
                                        "glosses": [
                                            "A godmother."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bffdf760-86b3-3cff-bb9f-268e33155f87",
                                        "entry_id": "1d671dba-6725-366a-bf77-6b7c4682198d",
                                        "glosses": [
                                            "A female goat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62bd591f-2731-4c42-8022-a9ccb5a517e8",
                                                "sense_id": "bffdf760-86b3-3cff-bb9f-268e33155f87",
                                                "text": "Breeding is a consuming goal, and the ascendance of the sex drive is nearly as apparent in the behavior of a mountain goat billy. So given over is he to following and defending a succession of nannies as he searches for one in heat (estrus), he loses interest in food altogether; […]"
                                            },
                                            {
                                                "example_id": "180f85b6-5af6-44f9-a531-64c1308e88c4",
                                                "sense_id": "bffdf760-86b3-3cff-bb9f-268e33155f87",
                                                "text": "Nannies and billies look very similar, both having dangerously sharp, curved black horns."
                                            },
                                            {
                                                "example_id": "db5af42b-6090-40a8-b7fa-0e3e61ea01da",
                                                "sense_id": "bffdf760-86b3-3cff-bb9f-268e33155f87",
                                                "text": "A farmer friend keeps a video camera in the barn so she can turn on her goat cam and observe her animals at any time of the day or night. A baby monitor picks up the sounds of a nanny when she goes into labor—if the nanny is one who changes the usual pitch of her voice or nervously bleats during kidding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b7301c6-1ab7-328d-9b65-c3531393e62b",
                                        "entry_id": "1d671dba-6725-366a-bf77-6b7c4682198d",
                                        "glosses": [
                                            "Synonym of sylvester (“device for pulling out pit props”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nanny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82c8c326-9c61-36d6-a61c-ff0b1ffac308",
                                        "entry_id": "a9e3e118-f13f-3b25-80d8-4c811141b634",
                                        "glosses": [
                                            "To serve as a nanny."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "077cbb7e-3d1e-37ca-86b3-cc34973d1c78",
                                        "entry_id": "a9e3e118-f13f-3b25-80d8-4c811141b634",
                                        "glosses": [
                                            "To treat like a nanny's charges; to coddle."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6849c3a5-27a9-4513-904e-3b96e4c2974b",
                                                "sense_id": "077cbb7e-3d1e-37ca-86b3-cc34973d1c78",
                                                "text": "In real life, says a Democratic campaign aide, members of Congress are too nannied by staff to stride about hatching plots, one-on-one."
                                            },
                                            {
                                                "example_id": "379e9d60-c44d-4a06-848c-8a34b7650a43",
                                                "sense_id": "077cbb7e-3d1e-37ca-86b3-cc34973d1c78",
                                                "text": "All politicians seem worried. After 40-plus years of being nannied by the EU they are now faced with having to stand on their own two feet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5515ab70-1d75-4b34-8adf-b11a23510427",
                        "source_entry_id": "98abc8bf-d3af-339b-a8d2-216734eb743b",
                        "source_sense_id": "f4723fc1-e038-342e-8791-0b9e9d5ba001",
                        "source_sense_description": "Hebamme",
                        "target_lang_word": "midwife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "midwife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbe68813-3ede-3dd5-adf2-45518dc14547",
                                        "entry_id": "c419f3f3-7b11-367b-a204-0b5fde3f7883",
                                        "glosses": [
                                            "A person, usually a woman, who is trained to assist women in childbirth, but who is not a physician."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863d336e-7b59-4004-b05b-d1fcf7f606de",
                                                "sense_id": "dbe68813-3ede-3dd5-adf2-45518dc14547",
                                                "text": "A hundred years ago, a midwife would bring the baby into the world - going to a hospital to deliver a baby was either impossible or unheard of."
                                            },
                                            {
                                                "example_id": "bfacc520-1e96-4cf6-bfc7-eb5d265f2eb1",
                                                "sense_id": "dbe68813-3ede-3dd5-adf2-45518dc14547",
                                                "text": "The senior midwife confirmed that […] occasionally a multigravid woman could feel little more than slight abdominal discomfort."
                                            },
                                            {
                                                "example_id": "9b234ca0-39d2-405c-84de-89a96fc3c85c",
                                                "sense_id": "dbe68813-3ede-3dd5-adf2-45518dc14547",
                                                "text": "Despite Richard's efforts to midwive his own narrative of legitimacy, the source of this legendary one cannot be controlled because it has moved from the mouths of nurses, midwives and gossips into the public domain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d729c07-deae-3520-9c80-9d07cdfe4681",
                                        "entry_id": "c419f3f3-7b11-367b-a204-0b5fde3f7883",
                                        "glosses": [
                                            "Someone who assists in bringing about some result or project."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
