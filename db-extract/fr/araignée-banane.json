                        "glosses": [
                            "Nom ambigu pouvant désigner diverses espèces d’araignées fréquentant habituellement les bananeraies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e5039d3-ce29-4bb8-a448-a568a489b949",
                                "sense_id": "8863c6c0-62e9-3770-9b43-802699b67b9e",
                                "text": "Avec ses quinze centimètres, ses pattes velues et son venin mortel, l’araignée-banane ne semble pas être la meilleure amie de l’homme."
                            },
                            {
                                "example_id": "e6e99537-3e19-4619-b033-85c1fa0bbde0",
                                "sense_id": "8863c6c0-62e9-3770-9b43-802699b67b9e",
                                "text": "Les araignées-bananes, par exemple, peuvent se nourrir de petits insectes et autres arthropodes, ce qui peut perturber l’écosystème local."
                            }
                        ]
                    }
