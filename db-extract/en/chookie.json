                "senses": [
                    {
                        "sense_id": "abdb0591-10a7-33f9-8c2e-bf447b26e6ee",
                        "entry_id": "486c6330-f4b4-3a0c-a24f-de03ce3253af",
                        "glosses": [
                            "A cheesecake cookie dessert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c6387e3-a739-41ed-adc7-95a55a063c6b",
                                "sense_id": "abdb0591-10a7-33f9-8c2e-bf447b26e6ee",
                                "text": "And as I looked up in my rear view mirror to look at my two precious darling little divas, I heard a quiet whimpering voice say, \"Mommy...Can I have a Chookie?\""
                            },
                            {
                                "example_id": "32afb83c-d757-43c9-9359-3195eda5ae42",
                                "sense_id": "abdb0591-10a7-33f9-8c2e-bf447b26e6ee",
                                "text": "Janet also described their chookie -- think of s’mores, but with cheesecake."
                            },
                            {
                                "example_id": "97277a02-0e8b-4bb8-8ad4-2bdf634f8fe9",
                                "sense_id": "abdb0591-10a7-33f9-8c2e-bf447b26e6ee",
                                "text": "Airport Chookie Chake A Delicious Twist on a Classic Cookie. This delicious recipe is perfect for those times when you're craving something sweet and spicy. airport chookie chake will hit the spot every time."
                            },
                            {
                                "example_id": "e1c05e97-a624-47f9-97a0-9b6afdb496e6",
                                "sense_id": "abdb0591-10a7-33f9-8c2e-bf447b26e6ee",
                                "text": "The proprietors of a bakery realize they “can do anything”—like, add a “chookie” (cheesecake cookie) to their menu—in the latest from GoDaddy."
                            },
                            {
                                "example_id": "c625d3b2-c8e5-4900-956e-4db8235b2992",
                                "sense_id": "abdb0591-10a7-33f9-8c2e-bf447b26e6ee",
                                "text": "For an authentic Chookie, use Maddalena's CheeseCake: Let Chookie Cookie cool for at least 20 minutes after removing from oven."
                            },
                            {
                                "example_id": "e52709f6-9dc3-4f26-9c19-bd88b50b954e",
                                "sense_id": "abdb0591-10a7-33f9-8c2e-bf447b26e6ee",
                                "text": "Each truck has a distinct cuisine, teaching you how to make everything from Surf N Turf Burger Sliders to Chookie desserts (which is a cheesecake sandwiched between two chocolate chip cookies)."
                            }
                        ]
                    }
