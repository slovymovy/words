                    },
                    {
                        "sense_id": "f13d9e12-dacb-38ca-997c-c17ca7ade5fd",
                        "entry_id": "0edfb207-b721-3ca8-903f-47cbdc39efed",
                        "glosses": [
                            "разг. деньги, «зелень» (о долларах), «капуста»"
                        ],
                        "tags": [],
                        "examples": [
