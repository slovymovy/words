                        "glosses": [
                            "A microcomputer on a single chip, used to control some device such as an automobile engine or a toy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0110d90-7098-418b-bb5e-795493091490",
                                "sense_id": "ec5bb69b-8e68-35db-acb2-f08a824eb403",
                                "text": "The microcontroller is a mini computer which can be programmed to perform different tasks, including monitoring things and making things happen. It is pre-programmed for use with the games projects. See project 17 for how to select games on it."
                            }
                        ]
