                ],
                "senses": [
                    {
                        "sense_id": "4096cc03-686e-38b2-bf01-59ed8fce28ad",
                        "entry_id": "a40efef9-a246-3df1-9b83-a0cfe60be158",
                        "glosses": [
                            "Maßnahmen, die die sozialen und wirtschaftlichen Verhältnisse der Bevölkerung verbessern sollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b502e724-0e79-48a7-8666-91735b7ea201",
                                "sense_id": "4096cc03-686e-38b2-bf01-59ed8fce28ad",
                                "text": "„Träger der Sozialpolitik sind vornehmlich der Staat, daneben Unternehmen, Gewerkschaften, NGOs und die Kirchen.“"
                            },
                            {
                                "example_id": "60696ac8-6124-4e4e-889d-75ba794384eb",
                                "sense_id": "4096cc03-686e-38b2-bf01-59ed8fce28ad",
                                "text": "„Nur wer die „Wirklichkeit der Armut“ nicht selbst erlebt habe, könne sagen, dass es bei Sozialpolitik nicht um Geld, sondern um Botschaften gehe.“"
                            },
                            {
                                "example_id": "762e669c-3aaf-4445-a3b4-13fe8a856c72",
                                "sense_id": "4096cc03-686e-38b2-bf01-59ed8fce28ad",
                                "text": "„Die zukünftige Sozialpolitik muss die Vererbung von Armut durchbrechen. …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
