                    {
                        "translation_id": "5341bd23-78ed-4f29-af81-2bbcb1b05f4c",
                        "source_entry_id": "be45b6a7-0236-37d3-88fa-e9866eb5d8cc",
                        "source_sense_id": "c912024f-671a-3964-ba48-444c4dfd6acf",
