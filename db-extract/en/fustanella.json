                        "glosses": [
                            "A form of skirt or kilt traditionally worn by men in Albania, Greece and other parts of the Balkans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "113ed4a6-2a5b-4778-b86d-3b8c38c87b40",
                                "sense_id": "d2543342-7e71-3145-b871-1a8dc5d52b7a",
                                "text": "The doctor had always wanted a set of fustanella and had never been able to afford it."
                            }
                        ]
                    }
                ],
