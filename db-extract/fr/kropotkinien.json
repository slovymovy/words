                        "glosses": [
                            "Militant anarchiste dont le mode d'action s'inspire des doctrines de lutte de Kropotkine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4e6a1b4-2c4c-450a-9d33-34e731ab716e",
                                "sense_id": "31b5d31a-57af-3975-a437-de7cb920185a",
                                "text": "Un kropotkinien impénitent, mon Louis Lecoin, a manifesté sa rude et magnifique activité surtout dans ses affrontements syndicalistes et pacifistes."
                            },
                            {
                                "example_id": "f57f0304-8737-4a18-a05b-9d96edf69e7e",
                                "sense_id": "31b5d31a-57af-3975-a437-de7cb920185a",
                                "text": "Les différences entre kropotkiniens, bakouniens ou autres importent moins que l’option entre l’anarcho-syndicalisme et la propagande « classique », d'une part, et la « propagande par le fait », d'autre part."
                            }
                        ]
                    }
