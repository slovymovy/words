                                "target_senses": [
                                    {
                                        "sense_id": "e1ebe6ba-98dd-3cb7-b43b-1b561bfce7dc",
                                        "entry_id": "02e0d708-8c0a-3f63-b315-82004c6339ab",
                                        "glosses": [
                                            "een prijs die ter bemoediging wordt uitgereikt aan deelnemers van een wedstrijd die niet hebben gewonnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2758f2fd-43d2-4571-bf44-69d2e04a9dbc",
                                                "sense_id": "e1ebe6ba-98dd-3cb7-b43b-1b561bfce7dc",
                                                "text": "Ik verlaat de galerie met een troostprijs: een ballon met de woorden „All I won was this lousy balloon.” Toch een conceptueel kunstwerk rijker. Of is het alleen maar een ballon?"
                                            }
                                        ]
                                    }
