                        "glosses": [
                            "gebeurtenis die van geen enkel belang is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf79e2ef-49c3-4616-adba-33147ce34e40",
                                "sense_id": "05684cb2-3d59-3c3e-a49b-24ec314cb794",
                                "text": "„Beleggers die beleggen in Nederlandse staatsobligaties vinden de downgrade van S&P een non-event. Uit de koersen was vandaag dan ook niet op te maken dat er wat was gebeurd. De andere twee grote kredietbeoordelaars, Moody’s en Fitch, hebben nog steeds de hoogste beoordeling voor Nederland. Dit betekent dat grote institutionele beleggers nog steeds bij Nederland terecht kunnen voor het invullen van het gedeelte ‘AAA-obligaties’ van hun portefeuilles."
                            },
                            {
                                "example_id": "640222b1-5b37-4eba-a09d-a080099e6233",
                                "sense_id": "05684cb2-3d59-3c3e-a49b-24ec314cb794",
                                "text": "Van Huet vond het „Privé-geroddel” en noemde het „een non-event”. „Ik ben er niet door van mijn barkruk gevallen”, aldus de getuige."
                            }
                        ]
                    }
