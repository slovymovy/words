                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fred hated going down to the <w>social</w> to sign on for his benefits.",
                            "target_lang_translations": {
                                "ru": "Фред ненавидел ходить в <w>соцобеспе́чение</w>, чтобы оформлять пособие.",
                                "zh": "弗雷德讨厌去<w>社会福利机构</w>申请救济金。"
                            }
                        },
                        {
                            "text": "She relies on the <w>social</w> to help pay her rent while she looks for work.",
                            "target_lang_translations": {
                                "ru": "Она полагается на <w>соцобеспе́чение</w>, чтобы оплачивать аренду, пока ищет работу.",
                                "zh": "她在找工作期间依靠<w>社会福利机构</w>来支付房租。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the social"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "short for social security"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Государственные службы социального обеспечения или офис, управляющий ими.",
                        "zh": "政府福利服务或管理这些服务的机构。"
                    },
                    "translations": {
                        "ru": [
