                "senses": [
                    {
                        "sense_id": "95998513-5ccb-3ce5-8e0a-405515d171b6",
                        "entry_id": "9afa4989-01ad-3a75-a22f-d67391cd0ad9",
                        "glosses": [
                            "Lüftungsgitter, durch das gezielt Außenluft angesaugt oder Fortluft ausgeblasen wird"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "9a7c2a86-efa8-4ca7-8ef0-7c00786809a9",
                                "sense_id": "95998513-5ccb-3ce5-8e0a-405515d171b6",
                                "text": "„Wetterschutzgitter eignen sich für Außenluft und für Fortluft lufttechnischer Anlagen.“"
                            },
                            {
                                "example_id": "9f134ced-4a6d-4f96-b35e-ed8e0effb185",
                                "sense_id": "95998513-5ccb-3ce5-8e0a-405515d171b6",
                                "text": "„Wetterschutzgitter verhindern das Eindringen von Niederschlagswasser in Ansaug- oder Ausblasöffnungen von Gebäudefassaden als Komponente lufttechnischer Anlagen oder bei der natürlichen Belüftung von Gebäudekomplexen. Das Wetterschutzgitter besteht aus speziell geformten regenabweisenden, waagerecht angeordneten Lamellen, welche in einem umlaufenden Rahmen befestigt sind.“"
                            },
                            {
                                "example_id": "a33f596b-5830-4eb9-ac5a-f7a24646d8c3",
                                "sense_id": "95998513-5ccb-3ce5-8e0a-405515d171b6",
                                "text": "„Wetterschutzgitter bieten guten Schutz vor direkt eindringendem Regen und dem Eindringen von Laub und Vögeln in die Außen- und Fortluftöffnungen lufttechnischer Anlagen. Kombinationen aus Wetterschutzgittern und Jalousieklappen oder Rückschlagklappen haben eine doppelte Funktion.“"
                            },
                            {
                                "example_id": "39afe44d-09ff-485d-8557-592f9ec948ed",
                                "sense_id": "95998513-5ccb-3ce5-8e0a-405515d171b6",
                                "text": "„Wetterschutzgitter bieten einen guten Schutz gegen direkteinwirkenden Regen und das Eindringen von Laub und Vögel in Ansaug- und Abluftöffnungen von lufttechnischen Anlagen.“"
                            },
                            {
                                "example_id": "9c8091bf-d20f-4a08-83d9-87c8d0fe86cb",
                                "sense_id": "95998513-5ccb-3ce5-8e0a-405515d171b6",
                                "text": "„H1 ist ein Wetterschutzgitter aus Aluminium geeignet für Außenluft und Fortluft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
