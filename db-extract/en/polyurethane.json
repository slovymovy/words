                        "sense_id": "45ec43cd-1e51-3f9a-8bf0-f241d489a59f",
                        "entry_id": "0679441f-705a-3abf-a5f4-6ff143470df8",
                        "glosses": [
                            "Any of various polymeric resins containing urethane links; used in many industrial and domestic applications."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d8db414-f0e5-4f32-a35b-73b82d46b89d",
                                "sense_id": "45ec43cd-1e51-3f9a-8bf0-f241d489a59f",
                                "text": "Firefighters were hampered by toxic fumes from polyurethane mattresses and overstuffed furniture."
                            }
                        ]
                    }
                ],
