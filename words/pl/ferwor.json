                    "sense_definition": "stan silnego podniecenia, zapału lub emocjonalnego zaangażowania w jakąś czynność",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W <w>ferworze</w> walki zapomniał o wszystkich swoich wcześniejszych postanowieniach.",
                            "target_lang_translations": {
                                "ru": "В <w>пылу</w> борьбы он забыл обо всех своих прежних решениях."
                            }
                        },
                        {
                            "text": "Dyskutowali w wielkim <w>ferworze</w>, nie słuchając argumentów drugiej strony.",
                            "target_lang_translations": {
                                "ru": "Они спорили с большим <w>жаром</w>, не слушая аргументов другой стороны."
