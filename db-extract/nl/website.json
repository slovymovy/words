                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4399e02-e7dd-402f-854b-23fd8f00d370",
                                "sense_id": "852090cf-df12-3864-9a6b-b75fd7b5f630",
                                "text": "Zij bezochten gisteren de website van dat bedrijf.",
                                "translation": "Sie gingen gestern auf die Website des Betriebes."
