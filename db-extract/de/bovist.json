                "senses": [
                    {
                        "sense_id": "28e0a0c7-0e03-3ac6-b57e-61f364ddc383",
                        "entry_id": "69c89f1c-c429-3a1f-98ad-e964950de1b7",
                        "glosses": [
                            "ein kugel- oder birnenförmiger Pilz, der nach seiner Reife aufplatzt und seine Sporen ins Freie entlässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f74fcbb9-e683-4f93-80f6-189c75bf9c9e",
                                "sense_id": "28e0a0c7-0e03-3ac6-b57e-61f364ddc383",
                                "text": "Viele Boviste haben eine wattige Konsistenz und schmecken fade, andere gelten sogar als giftig."
                            },
                            {
                                "example_id": "99fae217-85da-4639-ba28-b8f89e13c708",
                                "sense_id": "28e0a0c7-0e03-3ac6-b57e-61f364ddc383",
                                "text": "Der Bovist ist in der Jugend – solange das Fleisch noch weich ist – als Salat essbar."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
