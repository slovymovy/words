                ],
                "senses": [
                    {
                        "sense_id": "4ffd7d1d-220a-35d8-9e5e-ed7c90c6e003",
                        "entry_id": "82ab4d79-868a-38f7-98d8-354daef994da",
                        "glosses": [
                            "niet opmerken of anders waarnemen dan het is"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3f92c0fb-a021-4fbf-b124-27ef837ca6f2",
                                "sense_id": "4ffd7d1d-220a-35d8-9e5e-ed7c90c6e003",
                                "text": "Maar ze ging nu tegen de dertig. Zij was niet gewoon haar tekortkomingen te miszien — dat bracht maar teleurstelling — en zij rekende dat het dan tijd ging worden, een andere positie in te nemen. Zij wilde getrouwd zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "62fc4b84-24a4-3a22-aaaf-b243c36ba99b",
                        "entry_id": "82ab4d79-868a-38f7-98d8-354daef994da",
                        "glosses": [
                            "waarnemen als een ongunstige eigenschap"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "13e693ed-2d57-4925-a309-9b8a00ddd582",
                                "sense_id": "62fc4b84-24a4-3a22-aaaf-b243c36ba99b",
                                "text": "⧖ Hadden ze nu nog iets kunnen miszien aan den Generaal, dat er groeven kwamen in zijn gezicht, dat hij grijs werd of 't met hun kleedsel of hun aankoop bij bakker of beenhouwer niet meer was zooals vroeger, 't ware toch één voldoening geweest. Doch ook daarvan was geen sprake."
                            }
                        ]
                    },
                    {
                        "sense_id": "5aa15267-ae28-35ba-a5ff-3d17bb8edabb",
                        "entry_id": "82ab4d79-868a-38f7-98d8-354daef994da",
                        "glosses": [
                            "niet goed waarnemen"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "3d5204a4-e234-4787-a52e-11bc8556039d",
                                "sense_id": "5aa15267-ae28-35ba-a5ff-3d17bb8edabb",
                                "text": "⧖ Wellicht (…) heeft de kopiist van het Brugsche handschrift zich hier, evenals blijkbaar op verschillende andere plaatsen, eenvoudig eenige strepen „miszien”."
                            }
                        ]
                    }
