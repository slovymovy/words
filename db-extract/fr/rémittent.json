                    {
                        "sense_id": "65787b95-a9f2-3960-a1dc-a7c2c9a9f553",
                        "entry_id": "5fd6deaa-e3b4-3c87-a708-7ba3165735fd",
                        "glosses": [
                            "Qui éprouve une rémission, qui se remet d’une maladie."
                        ],
                        "tags": [],
