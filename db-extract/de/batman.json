                "senses": [
                    {
                        "sense_id": "590e077f-ee94-3ca0-95c8-c24650865b51",
                        "entry_id": "90a38241-d295-3738-bc25-b7962f0a6563",
                        "glosses": [
                            "Comicfigur, die in einem fledermausähnlichen Anzug Verbrechen bekämpft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a992f40-f154-4723-88b7-dde32bdb146f",
                                "sense_id": "590e077f-ee94-3ca0-95c8-c24650865b51",
                                "text": "„Seit Batmans Zeiten hat sich in der Verbrechensbekämpfung eine Menge geändert: Heutzutage dreht sich alles nur noch um die Anwälte, manchmal auch ums Recht.“"
                            },
                            {
                                "example_id": "c3983773-6a31-4ef3-843a-407e902e08cb",
                                "sense_id": "590e077f-ee94-3ca0-95c8-c24650865b51",
                                "text": "„Im Wohnzimmer des großen Hauses, wo er zusammen mit dem trauernden Besitzer saß, sah der Dienststellenleiter von Groenpunt die drei ankommen: Vorneweg ging die korpulente kleine Mbali, deren Riesenhandtasche von ihrer Schulter baumelte, dann folgte der größere Vaughn Cupido in einem langen schwarzen Mantel, durch den er ein wenig wie Batman aussah, und dann Bennie Griessel, von der Größe her genau zwischen der Zulu und dem Farbigen.“"
                            },
                            {
                                "example_id": "22acdc29-fda7-482d-b656-472917cb5def",
                                "sense_id": "590e077f-ee94-3ca0-95c8-c24650865b51",
                                "text": "„Meine neue Ausrüstung entsprach zwar nicht der Grundausstattung der Army Rangers, aber sie hätte Batman stolz gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
