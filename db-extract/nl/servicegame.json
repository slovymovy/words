                        "examples": [
                            {
                                "example_id": "c862ee2d-933f-4c50-8e2e-765f0deaa11a",
                                "sense_id": "3279e2a9-a9f4-380a-bc65-ddf482922352",
                                "text": "De 29-jarige Duitser, die in de eerste ronde al had afgerekend met de als twintigste geplaatste Canadees Denis Shapovalov, leek op 6-6 in de vijfde set tegen een fatale break aan te lopen, maar brak onmiddellijk terug en wist op 10-9 opnieuw de servicegame van Coric te winnen: 4-6, 6-1, 4-6, 7-6 (1), 11-9."
                            },
                            {
                                "example_id": "b1a812d6-e7fb-42f4-91c7-12f9d9a11bef",
                                "sense_id": "3279e2a9-a9f4-380a-bc65-ddf482922352",
                                "text": "De als negende geplaatste Svitolina oogde ook in het vervolg wat mat. Halverwege de tweede set lukte het de Oekraïense om haar tegenstander een servicegame af te snoepen."
                            }
                        ]
                    }
