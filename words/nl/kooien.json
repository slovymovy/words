                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "chasser au canardeau",
                                "target_lang_sense_clarification": "capturer des canards dans une canardière"
                            },
                            {
                                "target_lang_word": "exploiter une canardière",
                                "target_lang_sense_clarification": "attraper des canards sauvages"
                            }
                        ]
                    }
                }
            ]
        }
