                        "entry_id": "a4c8e76a-d71a-3940-afba-cd2c4dcb361e",
                        "glosses": [
                            "Qui est en faveur des États-Unis d’Amérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcf20802-8d1d-4e5c-8540-f0e307a2a475",
                                "sense_id": "b93461bf-28f0-3ec0-9aae-cebc4cf057e1",
                                "text": "Pour contrer l'influence soviétique en Europe, les États-Unis ont constitué, à la fin de la Seconde Guerre mondiale, un réseau d'élites proaméricaines."
                            },
                            {
                                "example_id": "cfdfeb80-a6fe-49bf-8168-e541fa0d7ccf",
                                "sense_id": "b93461bf-28f0-3ec0-9aae-cebc4cf057e1",
                                "text": "Les élections libres et la démocratie sont le moyen le plus sûr de compromettre les régimes totalitaires proaméricains du Proche-Orient."
                            }
                        ]
                    }
                ],
