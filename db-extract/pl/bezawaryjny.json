                    {
                        "translation_id": "b3d0b2a7-2291-43dd-af1e-eac04dccf6d8",
                        "source_entry_id": "f41747ce-1134-3e53-8cd2-c75fb5af0c52",
                        "source_sense_id": "02d6b7ac-8fb5-3c14-a0a5-995528c30529",
                        "target_lang_word": "reibungslos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reibungslos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc196948-dd84-336b-8fb0-ed3bc50b3509",
                                        "entry_id": "9acf4fa3-7433-3e4c-a4f4-eb6083972fcb",
                                        "glosses": [
                                            "störungsfrei, ohne Schwierigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91af8cdd-66b2-4dc3-b504-71232d3fe6e4",
                                                "sense_id": "bc196948-dd84-336b-8fb0-ed3bc50b3509",
                                                "text": "Die Verhandlungen verliefen reibungslos; schon nach wenigen Stunden präsentierten die parteien gutgelaunt ihren Kompromiss."
                                            },
                                            {
                                                "example_id": "a0538383-6cc3-4f3f-9498-eadfc578733c",
                                                "sense_id": "bc196948-dd84-336b-8fb0-ed3bc50b3509",
                                                "text": "Um einen reibungslosen Betrieb zu gewährleisten sind alle Mitarbeiter zu einer pünktlichen Arbeitsweise gehalten."
                                            },
                                            {
                                                "example_id": "3b8d7f64-1360-4529-a9d3-56df1e55045b",
                                                "sense_id": "bc196948-dd84-336b-8fb0-ed3bc50b3509",
                                                "text": "„Freilich, in Straußens Kalkül, so heißt es, wäre Carstens stets nur ein Bewerber oder Regierungschef, von dem sich der spätere Übergang zu einem Kandidaten oder Kanzler Strauß am reibungslosesten vollziehen ließe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
