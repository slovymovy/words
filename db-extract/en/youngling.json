            {
                "entry_id": "54a80de7-7a00-391d-b537-50f864a2045b",
                "word": "youngling",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ada69013-696a-4089-8085-edb191b38b16",
                        "entry_id": "54a80de7-7a00-391d-b537-50f864a2045b",
                        "tags": [
                            "plural"
                        ],
                        "form": "younglings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f85ee597-1e84-3e1e-92b5-8649aa9391b3",
                        "entry_id": "54a80de7-7a00-391d-b537-50f864a2045b",
                        "glosses": [
                            "A young person, animal, or plant; chit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1e6bbf3-585a-4d85-a8b6-ca115fd1f457",
                                "sense_id": "f85ee597-1e84-3e1e-92b5-8649aa9391b3",
                                "text": "More dear […] than younglings to their dam."
                            },
                            {
                                "example_id": "a947b8f0-73b9-4271-9bda-b9623b1633da",
                                "sense_id": "f85ee597-1e84-3e1e-92b5-8649aa9391b3",
                                "text": "He will not be so willing, I think, to join with you, as with us younglings."
                            },
                            {
                                "example_id": "8b73e8bf-3760-478e-95e1-fd4483404c6f",
                                "sense_id": "f85ee597-1e84-3e1e-92b5-8649aa9391b3",
                                "text": "No eagle-child have I seen being taught to fly by its parents. That is why younglings will not open their wings until driven by hunger."
                            },
                            {
                                "example_id": "6775059e-c82d-484b-afe1-81fb496fefdc",
                                "sense_id": "f85ee597-1e84-3e1e-92b5-8649aa9391b3",
                                "text": "2005 May 19, George Lucas, “Star Wars: Episode III ”, “Revenge of the Sith”, Lucasfilm\nObi-Wan Kenobi: I have seen a security hologram of him...killing younglings."
                            }
                        ]
                    }
                ],
