                {
                    "sense_id": "b441f35e-5e15-3926-b8b3-ca3cb0f5c712",
                    "sense_definition": "The past participle of <w>get</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "morphology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have <w>got</w> a new car in the garage.",
                            "target_lang_translations": {
                                "ru": "У меня в гараже <w>есть</w> новая машина.",
                                "fr": "J'<w>ai</w> une nouvelle voiture dans le garage."
                            }
                        },
                        {
                            "text": "Have you <w>got</w> any idea where they went?",
                            "target_lang_translations": {
                                "ru": "У тебя <w>есть</w> какие-нибудь идеи, куда они пошли?",
                                "fr": "<w>As</w>-tu une idée d'où ils sont allés ?"
                            }
