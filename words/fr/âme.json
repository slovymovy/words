                    "frequency": "High",
                    "semantic_group_id": "spiritualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certaines religions enseignent que l'<w>âme</w> survit après la mort du corps physique."
                        },
                        {
                            "text": "Le prêtre priait pour le repos de l'<w>âme</w> du défunt lors de la cérémonie."
                        }
                    ],
                    "synonyms": [
                        "esprit"
                    ],
                    "antonyms": [
                        "corps"
                    ],
                    "common_phrases": [
                        "rendre l'âme",
                        "âme en peine"
                    ]
                },
                {
                    "sense_id": "4b6b40a4-fab6-36e9-a311-f26c3ed55b69",
                    "sense_definition": "Siège de la sensibilité, des émotions, de la pensée et de la conscience morale.",
