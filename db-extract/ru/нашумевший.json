                                                "text": "Young Dutch keeper Tim Krul saw his value rocket up with a sensational display."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ec807aa-b7e5-4648-a6bd-5ae6752d41e7",
                        "source_entry_id": "bb62a941-a373-3a0b-a38a-9ab73e4bbf23",
                        "source_sense_id": "53ec68e5-b329-3ea8-a2f9-96c57d92066d",
                        "target_lang_word": "noisy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noisy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77d8f1b9-874f-319a-b762-f1271eafd4a3",
                                        "entry_id": "fcf05cd7-e945-302d-87e3-8832ba8e1f55",
                                        "glosses": [
                                            "Making a noise, especially a loud unpleasant sound"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90472896-3bd0-4ff2-92e8-ca5e201cce2b",
                                                "sense_id": "77d8f1b9-874f-319a-b762-f1271eafd4a3",
                                                "text": "the noisy crowd."
                                            },
                                            {
                                                "example_id": "6225a339-eb63-48d8-9733-59590f01ca2a",
                                                "sense_id": "77d8f1b9-874f-319a-b762-f1271eafd4a3",
                                                "text": "For obvious reasons the percussion is normally arranged along the back of the platform, whether centrally or to one side, and sometimes also in two tiers, the heavy, noisier instruments behind, and the pitched, agile instruments such as vibraphone, marimba, etc. in front. An outstanding exception, however, exists in Roberto Gerhard's Epithalamion where the composer expressly desired that the all-important kitchen department be spread out in front of the strings and hence nearest the audience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "057a6cbe-f79d-34c7-b272-e0209464f39c",
                                        "entry_id": "fcf05cd7-e945-302d-87e3-8832ba8e1f55",
                                        "glosses": [
                                            "Full of noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cd673a9-c9b0-4f01-98ec-2c310b01be75",
                                                "sense_id": "057a6cbe-f79d-34c7-b272-e0209464f39c",
                                                "text": "a noisy bar"
                                            },
                                            {
                                                "example_id": "9e28cad3-e0d1-4674-bdba-2eb42ce5572d",
                                                "sense_id": "057a6cbe-f79d-34c7-b272-e0209464f39c",
                                                "text": "This market is the noisiest and swarmiest centre of noisy and swarming Florence, and I always like to pass through it on that account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3709d33b-1e1b-3a7f-9087-d0dbdc210ac7",
                                        "entry_id": "fcf05cd7-e945-302d-87e3-8832ba8e1f55",
                                        "glosses": [
                                            "Unpleasant-looking and causing unwanted attention"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c5d5a09-0a94-46d3-9270-afb05570ae41",
                                                "sense_id": "3709d33b-1e1b-3a7f-9087-d0dbdc210ac7",
                                                "text": "noisy clothes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f105ebd4-bf82-3ca5-bda4-470f7d9d0e78",
                                        "entry_id": "fcf05cd7-e945-302d-87e3-8832ba8e1f55",
                                        "glosses": [
                                            "Accompanied by or introducing random fluctuations that obscure the real signal or data"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e78183c2-9ab3-4696-bf08-de505874e425",
                                                "sense_id": "f105ebd4-bf82-3ca5-bda4-470f7d9d0e78",
                                                "text": "Looked at more carefully, and over a longer time period, the relationship between the economy and the incumbent’s performance is positive, but noisy. “The incumbent wins when the economy is good” is a useful, weak prior, but not an iron law, and one that historically has had many exceptions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a8ae244-4e69-4555-8d1f-f2ad21bf440e",
                        "source_entry_id": "bb62a941-a373-3a0b-a38a-9ab73e4bbf23",
                        "source_sense_id": "53ec68e5-b329-3ea8-a2f9-96c57d92066d",
                        "target_lang_word": "sensationnel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sensationnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65016041-8f87-3c74-a924-81fc024e0df0",
                                        "entry_id": "0b5212b5-678a-36b1-ad5b-007e5c5e74d6",
                                        "glosses": [
                                            "Qui fait sensation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4f195da-6b90-4790-b12d-a85070731c53",
                                                "sense_id": "65016041-8f87-3c74-a924-81fc024e0df0",
                                                "text": "N’empêche que quelques-unes des phrases les plus sensationnelles de ce livre me sont venues ainsi, dans des cafés ou dans des promenoirs, pendant que je flânais ou bavardais, en regardant, quelquefois sans les voir, des visages de femmes pénétrants et fatigués."
                                            },
                                            {
                                                "example_id": "d6d9c290-7bcb-435c-a3f0-5256c4692ea0",
                                                "sense_id": "65016041-8f87-3c74-a924-81fc024e0df0",
                                                "text": "La nature humaine n'est point stationnaire et, chaque jour, elle apporte un contingent nouveau de découvertes plus ou moins sensationnelles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sensationnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77edc557-2dc7-3192-a9d8-b6b18e939ec7",
                                        "entry_id": "3fa00b75-5470-3b20-8284-4e0c23aa31af",
                                        "glosses": [
                                            "Ce qui fait sensation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6952d005-7ffe-4cf0-a332-a1584ec66a89",
                                                "sense_id": "77edc557-2dc7-3192-a9d8-b6b18e939ec7",
                                                "text": "Ils peuvent se réjouir, tous ces journalistes qui annoncent de fausses nouvelles. […]. Ils font la course au sensationnel et pissent de la ligne pour remplir du papier. C'est tout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38eb2475-6751-4cda-9f40-4598c9883927",
                        "source_entry_id": "bb62a941-a373-3a0b-a38a-9ab73e4bbf23",
                        "source_sense_id": "53ec68e5-b329-3ea8-a2f9-96c57d92066d",
                        "target_lang_word": "retentissant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retentissant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa6d84a9-e50a-35bd-892e-73cf3e13066e",
                                        "entry_id": "35a76c57-d2ef-354f-9c13-7f8be77e0c2a",
                                        "glosses": [
                                            "Qui retentit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "243333f0-63cc-4d17-b30c-198869ea99bc",
                                                "sense_id": "fa6d84a9-e50a-35bd-892e-73cf3e13066e",
                                                "text": "Il sollicita le garçon d’un timbre retentissant, en cognant bruyamment ses vastes pattes."
                                            },
                                            {
                                                "example_id": "34fba3b7-e55c-4150-9033-dff54653dcfc",
                                                "sense_id": "fa6d84a9-e50a-35bd-892e-73cf3e13066e",
                                                "text": "Cédric était plongé dans ses rêveries, quand il en fut tout à coup tiré par le son retentissant' d’un cor, […]."
                                            },
                                            {
                                                "example_id": "7d57d2fe-131e-4a00-a352-8a294e5d092a",
                                                "sense_id": "fa6d84a9-e50a-35bd-892e-73cf3e13066e",
                                                "text": "Par notre Dieu Kô ! s’écria le bushman d’une voix retentissante, vous seriez homme à attendre que le Gariep ne précipite plus ses eaux retentissantes dans cet abîme !"
                                            },
                                            {
                                                "example_id": "de1106b6-c80d-42a3-afa4-c0228e45a4b4",
                                                "sense_id": "fa6d84a9-e50a-35bd-892e-73cf3e13066e",
                                                "text": "La fête se termina par des réjouissances bruyantes : musique, sonneries de clairons, roulements de tambours, fantasias échevelées, décharges retentissantes d’artillerie et de mousqueterie, — une orgie de couleurs, de mouvement et de bruit."
                                            },
                                            {
                                                "example_id": "ac24975a-7a81-4812-93a4-59037d66b263",
                                                "sense_id": "fa6d84a9-e50a-35bd-892e-73cf3e13066e",
                                                "text": "Après plusieurs essais écrits dans la même veine, il sort en 1996 à compte d’auteur un retentissant pamphlet, Les Mythes fondateurs de la politique israélienne, qui lui vaut le soutien de l'abbé Pierre, un ami de longue date, et un procès pour injure raciale et négation de crime contre l’humanité […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retentissant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a607927-fda9-35ad-8af0-1d7c09920103",
                                        "entry_id": "bb651e75-7b3c-3d19-a5f2-80571b0d5de7",
                                        "glosses": [
                                            "Participe présent de retentir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
