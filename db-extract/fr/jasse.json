                "senses": [
                    {
                        "sense_id": "14d24545-8d7a-3ecf-b928-74b794f21a36",
                        "entry_id": "7cd74de7-ed85-39e2-99a8-0a95473dd59d",
                        "glosses": [
                            "Sorte de parc dans lequel les moutons de transhumance passaient la nuit."
                        ],
                        "tags": [
                            "Élevage",
                            "Montagnes du sud de la France"
                        ],
                        "examples": [
                            {
                                "example_id": "02312558-ced1-4a92-ba23-2ad96ecd9cb2",
                                "sense_id": "14d24545-8d7a-3ecf-b928-74b794f21a36",
                                "text": "Les brebis y passaient les mois d'été et les bergers les menaient, le soir, dans des endroits réservés appelés jasses « jassia » où elles se rassemblaient pour la nuit."
                            },
                            {
                                "example_id": "b9695889-1039-4d70-97fc-d2a83182758e",
                                "sense_id": "14d24545-8d7a-3ecf-b928-74b794f21a36",
                                "text": "Rappelons l'action du troupeau chargeant de produits azotés les « jasses ». Une végétation d’Orties, d’Épinard sauvage, d’Oseille des Alpes occupe ces emplacements dans les régions montagneuses où on ne parque pas le bétail."
                            }
                        ]
                    },
                    {
                        "sense_id": "384638f3-f023-381d-9fb3-9116e9200cf1",
                        "entry_id": "7cd74de7-ed85-39e2-99a8-0a95473dd59d",
                        "glosses": [
                            "Hangar largement ouvert qui sert d'abris au bétail contre les intempéries et les fortes chaleurs."
                        ],
                        "tags": [],
                        "examples": []
                    }
