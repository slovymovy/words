                "translations": [
                    {
                        "translation_id": "d5cb94e0-8976-491a-b762-9eb7ad0f3864",
                        "source_entry_id": "a3740112-8758-3bbe-b68b-4f312ab53ced",
                        "source_sense_id": "fd6066e5-75db-3d01-acf8-e5a41418ec65",
                        "target_lang_word": "dating",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99c807f6-ce11-337e-8057-d524c5476b46",
                                        "entry_id": "7197ebd7-f46d-33f7-ad5f-5020c2d0bd2c",
                                        "glosses": [
                                            "present participle and gerund of date"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c062acf-80ce-326c-9cf6-e046ffafee9a",
                                        "entry_id": "19dff995-9ec6-384a-8877-8033af8f5384",
                                        "glosses": [
                                            "A form of romantic courtship typically between two individuals with the aim of assessing the other's suitability as a partner in an intimate relationship or as a spouse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "436f92d3-b1c7-4cf5-a3f8-431e10bb855c",
                                                "sense_id": "2c062acf-80ce-326c-9cf6-e046ffafee9a",
                                                "text": "Janet was surprised at how much casual dating had changed since she was last single."
                                            },
                                            {
                                                "example_id": "33a59cf3-25dd-45d8-94c4-1fadf5d972f2",
                                                "sense_id": "2c062acf-80ce-326c-9cf6-e046ffafee9a",
                                                "text": "We met on a popular dating app."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad1e4046-20cb-3245-8849-ae22dd08e6bc",
                                        "entry_id": "19dff995-9ec6-384a-8877-8033af8f5384",
                                        "glosses": [
                                            "An estimation of the age of an artifact, biological vestige, linguistic usage, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1fac36d-95e3-45fe-8947-09ca3f852bcb",
                                                "sense_id": "ad1e4046-20cb-3245-8849-ae22dd08e6bc",
                                                "text": "The results almost always used to illustrate this are the datings of human bones from the Sct. Drotten Church in Lund."
                                            },
                                            {
                                                "example_id": "a0b37ea2-2f63-47ca-b909-267844e8549a",
                                                "sense_id": "ad1e4046-20cb-3245-8849-ae22dd08e6bc",
                                                "text": "1922 (July), A. E. Douglass, \"Some aspects of the use of the annual rings of trees in climatic study\". The Scientific Monthly 15(1): 5-21.\nA comparison in seven sequoias between very careful counting and accurate dating in 2,000 years shows an average counting error of 35 years, which is only 1.7 per cent."
                                            },
                                            {
                                                "example_id": "fad739f9-b306-44f3-8746-6edfd10064ad",
                                                "sense_id": "ad1e4046-20cb-3245-8849-ae22dd08e6bc",
                                                "text": "Finally, with the exception of the rug in the paintings of Willem Duyster, the datings of both groups approximately agree;"
                                            },
                                            {
                                                "example_id": "316e3041-b412-43a9-9eb3-ea283b1d81a2",
                                                "sense_id": "ad1e4046-20cb-3245-8849-ae22dd08e6bc",
                                                "text": "Different dendrochronological datings have different veracity. The veracity of a dendrochronological dating depends on the certainty of the collations on the dendrochronological scale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c7950ac-5a00-3094-b43b-86ccf3491266",
                                        "entry_id": "19dff995-9ec6-384a-8877-8033af8f5384",
                                        "glosses": [
                                            "The setting of a date on which an event or transaction is to take place or take effect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da987117-4eff-4f81-a3a8-cbef18b4eafd",
                                                "sense_id": "9c7950ac-5a00-3094-b43b-86ccf3491266",
                                                "text": "But C.O.D. datings are relatively rare. They are so disliked by buyers that they are used by sellers only when the latter are quite uncertain of a buyer's ability and willingness to pay."
                                            },
                                            {
                                                "example_id": "2ee0fa38-eb61-4ffa-bea6-932bed324ee0",
                                                "sense_id": "9c7950ac-5a00-3094-b43b-86ccf3491266",
                                                "text": "Pressure from unemployment for retrenchment is evident for the \"early\" as well as \"best\" datings of retrenchment. However, when retrenchment datings lean toward earlier years, unemployment is not the preeminent factor among the various accelerators and decelerators of retrenchment that it is for the more balanced \"best\" datings of Table 7.2 (or that it is, as we shall see, for the \"late\" datings)."
                                            },
                                            {
                                                "example_id": "06829192-a847-430f-8bcc-8900652762a6",
                                                "sense_id": "9c7950ac-5a00-3094-b43b-86ccf3491266",
                                                "text": "Seasonal datings are special credit terms that are sometimes offered to retailers when sales are highly concentrated in one or more periods during the year."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d5d59eb-e47a-4cff-9ffb-35cb65fe4dec",
                        "source_entry_id": "a3740112-8758-3bbe-b68b-4f312ab53ced",
                        "source_sense_id": "fd6066e5-75db-3d01-acf8-e5a41418ec65",
                        "target_lang_word": "datation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "datation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "138bfc9a-bd86-3b4b-8e4d-a5dfbea313b5",
                                        "entry_id": "fdc35d4d-e1fb-37c2-a1c0-e4c81f8d085f",
                                        "glosses": [
                                            "Action de dater, estimation d’une date par des moyens scientifiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f10d60b-c6bb-4ac3-b144-f32215a153b4",
                                                "sense_id": "138bfc9a-bd86-3b4b-8e4d-a5dfbea313b5",
                                                "text": "Comme la céramique évolue au gré des modes, elle constitue un excellent indice de datation."
                                            },
                                            {
                                                "example_id": "2da5021f-7763-4c51-967d-dafa7e913ee6",
                                                "sense_id": "138bfc9a-bd86-3b4b-8e4d-a5dfbea313b5",
                                                "text": "Maxime Aubert, spécialiste de la datation, a identifié un dépôt de calcite qui s’est formé au-dessus de la fresque, puis a utilisé une méthode de datation par uranium pour affirmer que le dépôt était vieux de 45 500 ans."
                                            },
                                            {
                                                "example_id": "829cacb4-154d-41ff-ba39-3467818b4fe5",
                                                "sense_id": "138bfc9a-bd86-3b4b-8e4d-a5dfbea313b5",
                                                "text": "Nous proposons alors une approche chronologique en nous appuyant sur une nouvelle datation et sur la corrélation avec les stades des Alpes orientales."
                                            },
                                            {
                                                "example_id": "220bab3d-4666-4b67-8863-beb77d7e55cc",
                                                "sense_id": "138bfc9a-bd86-3b4b-8e4d-a5dfbea313b5",
                                                "text": "La datation au carbone 14, effectuée en 1988 par trois prestigieux laboratoires de Suisse, du Royaume-Uni et d’Arizona, est a priori sans appel : le saint suaire date de moins de huit cents ans et n’a donc pu envelopper le corps du Christ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92986048-a2d6-4355-8d9e-7f16d6c999e1",
                        "source_entry_id": "a3740112-8758-3bbe-b68b-4f312ab53ced",
                        "source_sense_id": "fd6066e5-75db-3d01-acf8-e5a41418ec65",
                        "target_lang_word": "датировка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "датировка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fe2633f1-b5d2-391f-bf0d-501e21da5fa9",
                                        "entry_id": "96450b71-7c8b-30ff-924b-da5bda63e9d8",
                                        "glosses": [
                                            "действие по значению гл. датировать; определение дат каких-либо событий, определение возраста произведений искусства и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32582fc9-02bd-452c-b595-813597be64af",
                                                "sense_id": "fe2633f1-b5d2-391f-bf0d-501e21da5fa9",
                                                "text": "Напомним, что радиоуглеродный метод — это способ определения возраста органического вещества, в котором используется распад радиоактивного изотопа углерода C-14. В археологии это один из важнейших методов датировки."
                                            },
                                            {
                                                "example_id": "2c227efb-4749-4e5d-994b-f987e0f24cdb",
                                                "sense_id": "fe2633f1-b5d2-391f-bf0d-501e21da5fa9",
                                                "text": "В свою очередь датировка как темпоральная организация истории означает, что при ответе на вопрос о каком-либо событии мы прежде всего называем время, когда оно произошло, тем самым фиксируя его темпоральную позицию в исторической реальности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "691b8d63-f040-307f-865e-8f4bf8b68670",
                                        "entry_id": "96450b71-7c8b-30ff-924b-da5bda63e9d8",
                                        "glosses": [
                                            "результат такого действия; дата, ассоциированная с каким-либо событием; возраст, приписанный какому-либо объекту"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59d46a40-69cf-40b2-9b6c-a194ba4e679f",
                                                "sense_id": "691b8d63-f040-307f-865e-8f4bf8b68670",
                                                "text": "Происторическая археология подтверждает гомеровское описание этих районов, и датировка почти совпадает: от 2000 до 1500 года до нашей эры."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
