                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "célèbre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c56a9dc0-41cc-366d-afab-65dc7bb9964a",
                                        "entry_id": "73487af8-4037-3dc9-8575-5989fcd7f918",
                                        "glosses": [
                                            "Qui est très connu par une population et ses médias."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b978e282-81d8-45c8-be03-f41c5179297a",
                                                "sense_id": "c56a9dc0-41cc-366d-afab-65dc7bb9964a",
                                                "text": "Qui n'a même reconnu un vestige des anciens cultes païens dans ces libations faites à des fontaines sacrées que leurs propriétés curatives ont rendues célèbres ?"
                                            },
                                            {
                                                "example_id": "f89480c6-0320-4f8a-8963-b826d630578d",
                                                "sense_id": "c56a9dc0-41cc-366d-afab-65dc7bb9964a",
                                                "text": "Le système de Buffon sera surtout repris par le plus grand hippiatre de l'époque, le fondateur de la science vétérinaire, l’écuyer le plus célèbre de son temps : Claude Bourgelat."
                                            },
                                            {
                                                "example_id": "01aaa4a3-c8b2-4209-b608-38cfff3f617a",
                                                "sense_id": "c56a9dc0-41cc-366d-afab-65dc7bb9964a",
                                                "text": "Des bataillons de VRP lancés dans tout le pays à l'assaut des bars-tabacs, des tabacs-presse, des civettes repérables de loin grâce à leur célèbre carotte rouge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01d42bd2-c402-35b2-bb55-a856fbf1c1c2",
                                        "entry_id": "73487af8-4037-3dc9-8575-5989fcd7f918",
                                        "glosses": [
                                            "Qui est fameux ou renommé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7857be91-3543-429d-b8f9-c6f9626960a9",
                                                "sense_id": "01d42bd2-c402-35b2-bb55-a856fbf1c1c2",
                                                "text": "Tantôt avec les lassets, tantôt à l’aide de la bourraque, il faisait une petite récolte de ces belles crevettes roses (quand elles sont cuites) et qu’on appelle le bouquet; muni de l’attirail que j’ai décrit plus haut, il se livrait à une guerre acharnée contre toute la légion des crabes, pouparts, claquarts et craparagdis, sans compter les célèbres pieuvres, dont il avait un talent particulier pour découvrir les trous sous les rochers, et qui, si horribles qu’elles soient, n’en constituent pas moins une boîte très prisée des tendeurs de cordes, et qu’ils achètent fort bien."
                                            },
                                            {
                                                "example_id": "86d231fc-0e1f-4127-b68e-64335a4c8302",
                                                "sense_id": "01d42bd2-c402-35b2-bb55-a856fbf1c1c2",
                                                "text": "Un auteur célèbre."
                                            },
                                            {
                                                "example_id": "2d82f593-a199-4f5e-89d5-4b9f5e0f5395",
                                                "sense_id": "01d42bd2-c402-35b2-bb55-a856fbf1c1c2",
                                                "text": "Un lieu célèbre."
                                            },
                                            {
                                                "example_id": "1ad0c520-2cbc-46d6-8bee-4249c6eade72",
                                                "sense_id": "01d42bd2-c402-35b2-bb55-a856fbf1c1c2",
                                                "text": "Une action célèbre."
                                            },
                                            {
                                                "example_id": "c2240d98-1a88-4b01-9441-8607bfaceff5",
                                                "sense_id": "01d42bd2-c402-35b2-bb55-a856fbf1c1c2",
                                                "text": "Causes célèbres."
                                            },
                                            {
                                                "example_id": "8074b1dc-b002-4090-8231-c14a0b44fd26",
                                                "sense_id": "01d42bd2-c402-35b2-bb55-a856fbf1c1c2",
                                                "text": "Un homme célèbre par ses vertus."
                                            },
                                            {
                                                "example_id": "567af2a2-95b2-45c7-9a85-a3f1f0620944",
                                                "sense_id": "01d42bd2-c402-35b2-bb55-a856fbf1c1c2",
                                                "text": "Il est célèbre pour avoir fait telle action."
                                            },
                                            {
                                                "example_id": "9c2e4c95-04a1-4dfa-9def-57602957269d",
                                                "sense_id": "01d42bd2-c402-35b2-bb55-a856fbf1c1c2",
                                                "text": "Se rendre célèbre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "célèbre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b63fee10-f6fd-3e88-b613-ad7457988092",
                                        "entry_id": "595b14b8-d438-3238-9ef8-c3dee8437903",
