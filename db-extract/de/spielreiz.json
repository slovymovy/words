                ],
                "senses": [
                    {
                        "sense_id": "dd1a29bb-ef8c-3611-ad94-3c1e762bf43f",
                        "entry_id": "9a347f99-7648-3828-bd7f-2f9832d81d2f",
                        "glosses": [
                            "Aufforderungscharakter eines Spiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "041352b0-bde3-4c3b-872f-da2e3f82ac01",
                                "sense_id": "dd1a29bb-ef8c-3611-ad94-3c1e762bf43f",
                                "text": "„Der Spielreiz entsteht aus den spannenden und überraschenden Möglichkeiten der Koalitionsbildung unter den Spielern, wie bei anderen Gesellschaftsspielen auch.“"
                            },
                            {
                                "example_id": "52afed3c-0811-4ad7-95c6-f82b696669ff",
                                "sense_id": "dd1a29bb-ef8c-3611-ad94-3c1e762bf43f",
                                "text": "„Friedensspiele gewinnen ihren Spielreiz nicht aus dem Gegeneinander, sondern aus dem Miteinander.“"
                            },
                            {
                                "example_id": "b8abc042-b285-4069-b5b4-bdc226f0fb02",
                                "sense_id": "dd1a29bb-ef8c-3611-ad94-3c1e762bf43f",
                                "text": "„Was also macht angesichts so restlos, bis auf den Nullpunkt aufgeklärter Verhältnisse den Spielreiz aus?“"
                            },
                            {
                                "example_id": "ab8decbc-4736-4cca-8d05-fa5c51e8ced1",
                                "sense_id": "dd1a29bb-ef8c-3611-ad94-3c1e762bf43f",
                                "text": "„Der Normal- und Banalbürger Wörle hat in aller Öffentlichkeit, in einer Berliner U-Bahn, einen ihm völlig gleichgültigen, ja unbekannten Menschen umgebracht, aus nichts als Langeweile, wegen des Spielreizes.“"
                            },
                            {
                                "example_id": "c528e029-0ee1-47f7-ae3f-877334e7b361",
                                "sense_id": "dd1a29bb-ef8c-3611-ad94-3c1e762bf43f",
                                "text": "„Wenn alles möglich ist, ist nichts mehr nötig, hat alles nur noch Spielreiz mit einem Hauch von Zynismus und Melancholie, ähnlich den fabelhaften Kühlergrills unserer Industrie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
