                        ],
                        "form": "das Vorwerk"
                    },
                    {
                        "form_id": "782987af-ce0e-4314-971a-bc40af2a2aef",
                        "entry_id": "e618c32b-d146-3553-8e91-23179c3bc532",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Vorwerke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8cbb60ad-7e99-3baf-b7fb-e3076749e7c0",
                        "entry_id": "e618c32b-d146-3553-8e91-23179c3bc532",
                        "glosses": [
                            "einer Burg vorgelagerte Befestigungsanlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb581e71-8844-44df-a0f9-9baed2aad2c4",
                                "sense_id": "8cbb60ad-7e99-3baf-b7fb-e3076749e7c0",
                                "text": "„Er verlegte die Wohngebäude von der Burg auf das im Thale zu Hafekeuhaufen liegende Vorwerk.“"
                            },
                            {
                                "example_id": "bea451f2-58a4-4db8-9cdd-7ba8ae7e2ed2",
                                "sense_id": "8cbb60ad-7e99-3baf-b7fb-e3076749e7c0",
                                "text": "„Jede Ordensburg hatte zwei Theile: die Vorburg (gewöhnlich das Vorburge genannt), wo die Ställe, Vorrathshäuser, Schmieden und dergl. standen und das Ganze, gleichfalls befestigt, der eigentlichen Burg als schützendes Vorwerk diente.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f75e78d7-1cad-3668-92b3-ac2545123e3e",
                        "entry_id": "e618c32b-d146-3553-8e91-23179c3bc532",
                        "glosses": [
                            "landwirtschaftlicher Betrieb ohne eigene, wirtschaftliche Hofstelle oder ein räumlich abgesonderter Zweigbetrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac1bcf9f-c7fa-431f-9bcd-60b0a460de07",
                                "sense_id": "f75e78d7-1cad-3668-92b3-ac2545123e3e",
                                "text": "„Die meisten lagen an der nicht gepflasterten Hauptstraße zwischen Gutshof und Vorwerk.“"
                            },
                            {
                                "example_id": "e375a4a7-4108-4b77-9308-950928a97f93",
                                "sense_id": "f75e78d7-1cad-3668-92b3-ac2545123e3e",
                                "text": "„Wahrscheinlich seit etwa 1270 befand sich etwa dort, wo heute der Cainsdorfer Bahnhof steht, ein Vorwerk, das heißt ein Gutshof des Rittergutes Planitz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5eaa74e2-4312-4143-8328-fd5bdf6dadf0",
                        "source_entry_id": "e618c32b-d146-3553-8e91-23179c3bc532",
                        "source_sense_id": "8cbb60ad-7e99-3baf-b7fb-e3076749e7c0",
                        "target_lang_word": "ouvrage avancé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouvrage avancé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5eb5af9c-ab89-3ef9-bf97-c3cac7b07e95",
                                        "entry_id": "5e16cf10-af49-3eaf-8d54-eb41044ccecc",
                                        "glosses": [
                                            "Ouvrage fortifié qui n’est pas contigu au corps de la place forte mais placé à l’avant des fortifications principales et contribuant à la couvrir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76e05167-073b-4636-a987-a66249009e61",
                                                "sense_id": "5eb5af9c-ab89-3ef9-bf97-c3cac7b07e95",
                                                "text": "… , non seulement la jeune fille voyait ce qui se passait au-delà des limites de la forteresse, mais encore elle dominait les ouvrages avancés, contre lesquels il était probable que les assiégeants dirigeraient leurs premiers efforts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
