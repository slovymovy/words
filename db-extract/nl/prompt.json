                "translations": [
                    {
                        "translation_id": "5f6f4b93-72a0-4da5-b996-b89c808fc4b1",
                        "source_entry_id": "215876a5-272c-3e8e-b8b3-b36ba2749579",
                        "target_lang_word": "immediate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immediate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4e77a6b-6199-3dab-b866-b129780bcb8c",
                                        "entry_id": "b1f1d3b9-659c-331c-9242-99ce65def560",
                                        "glosses": [
                                            "Happening right away, instantly, with no delay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7579664-237f-43d3-9929-54076b3b5d95",
                                                "sense_id": "a4e77a6b-6199-3dab-b866-b129780bcb8c",
                                                "text": "Computer users these days expect immediate results when they click on a link."
                                            },
                                            {
                                                "example_id": "d9a58fce-f2ea-458f-86c6-34bc5e826e02",
                                                "sense_id": "a4e77a6b-6199-3dab-b866-b129780bcb8c",
                                                "text": "Assemble we immediate council."
                                            },
                                            {
                                                "example_id": "6e729475-86ed-45a8-9af1-9dc0e7adca40",
                                                "sense_id": "a4e77a6b-6199-3dab-b866-b129780bcb8c",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0920cd8f-27ea-375b-9e7d-15dbd534dfa3",
                                        "entry_id": "b1f1d3b9-659c-331c-9242-99ce65def560",
                                        "glosses": [
                                            "Very close; direct or adjacent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59f09537-b004-49b7-ae01-59afe640aa7a",
                                                "sense_id": "0920cd8f-27ea-375b-9e7d-15dbd534dfa3",
                                                "text": "immediate family; immediate vicinity"
                                            },
                                            {
                                                "example_id": "138f6f4a-baac-4548-83ae-ed01e2d5b4e8",
                                                "sense_id": "0920cd8f-27ea-375b-9e7d-15dbd534dfa3",
                                                "text": "You are the most immediate to our throne,"
                                            },
                                            {
                                                "example_id": "2db3cb35-2c82-4698-af4a-2b05862b8f61",
                                                "sense_id": "0920cd8f-27ea-375b-9e7d-15dbd534dfa3",
                                                "text": "So long as he concerns himself with immediate issues he is rewarded with influence, material success, and popularity with those who up to a point share his general outlook."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8347bdc6-0226-3d0a-9657-73fa5a6940cd",
                                        "entry_id": "b1f1d3b9-659c-331c-9242-99ce65def560",
                                        "glosses": [
                                            "Manifestly true; requiring no argument."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0af98119-4cbd-38e4-9b80-c6db15dceb40",
                                        "entry_id": "b1f1d3b9-659c-331c-9242-99ce65def560",
                                        "glosses": [
                                            "Embedded as part of the instruction itself, rather than stored elsewhere (such as a register or memory location)."
                                        ],
                                        "tags": [
                                            "of an instruction operand"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5de9214b-69de-39ba-9189-c9f6319a9ad4",
                                        "entry_id": "b1f1d3b9-659c-331c-9242-99ce65def560",
                                        "glosses": [
                                            "Used to denote that a transmission is urgent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6ea70d0-527a-4ade-82b7-d8945a588cc3",
                                                "sense_id": "5de9214b-69de-39ba-9189-c9f6319a9ad4",
                                                "text": "Bravo Three, this Bravo Six. Immediate! We are coming under fire from the north from an unknown enemy, over!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec7cae93-38b3-3577-bf52-487626152a0e",
                                        "entry_id": "b1f1d3b9-659c-331c-9242-99ce65def560",
                                        "glosses": [
                                            "An artillery fire mission modifier for two types of fire mission to denote an immediate need for fire: Immediate smoke, all guns involved must reload smoke and fire. Immediate suppression, all guns involved fire the rounds currently loaded and then switch to high explosive with impact fused (unless fuses are specified)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b78709a-821e-4606-940e-c26b649a9f42",
                                                "sense_id": "ec7cae93-38b3-3577-bf52-487626152a0e",
                                                "text": "Hotel Two-Niner, this is Bravo Six. Immediate suppression at grid November-Kilo four-five-three two-one-five. Danger Close. I authenticate Golf Echo, over."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a285309-96c8-418a-9b4a-cc6e6bc662f9",
                        "source_entry_id": "215876a5-272c-3e8e-b8b3-b36ba2749579",
