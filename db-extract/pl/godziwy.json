                    },
                    {
                        "translation_id": "a77c6554-e0b5-4ec2-8f81-e92feadeeabc",
                        "source_entry_id": "19b05be7-9443-3eb2-9755-69e4440638a6",
                        "source_sense_id": "ec5dbd69-8ecf-3b02-95ab-89060b8f3f22",
                        "target_lang_word": "wholesome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wholesome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13a70d6b-0a30-3749-85c4-9347e711f317",
                                        "entry_id": "c63b1b6d-1f86-3785-b648-c71be9532886",
                                        "glosses": [
                                            "Promoting good physical health and well-being."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad4b2dd6-f99e-4e5a-a5a9-5ccd6bf5b6a4",
                                                "sense_id": "13a70d6b-0a30-3749-85c4-9347e711f317",
                                                "text": "I prethee go, and get me ſome repaſt,\n I care not what, ſo it be holſome foode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b4df3d1-2a2f-3181-bc7b-1e86cb0ef74a",
                                        "entry_id": "c63b1b6d-1f86-3785-b648-c71be9532886",
                                        "glosses": [
                                            "Promoting moral and mental well-being."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fed5fcd-753d-480b-be3a-171213a91b8d",
                                                "sense_id": "1b4df3d1-2a2f-3181-bc7b-1e86cb0ef74a",
                                                "text": "Though hard, my friends, yet wholesome are the truths, taught in affliction's school, whence the pure soul rises refined, and soars above the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a92c0a4-0b12-3d81-9b2a-b193de050723",
                                        "entry_id": "c63b1b6d-1f86-3785-b648-c71be9532886",
                                        "glosses": [
                                            "Favorable to morals, religion or prosperity; sensible; conducive to good; salutary; promoting virtue or being virtuous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f54c5954-cbf9-4da5-800c-076512f913a4",
                                                "sense_id": "0a92c0a4-0b12-3d81-9b2a-b193de050723",
                                                "text": "A wholeſome tongue is a tree of life: but peruerſneſſe therein is a breach in the ſpirit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69bb5319-6c6d-376c-9301-3d794cf43c00",
                                        "entry_id": "c63b1b6d-1f86-3785-b648-c71be9532886",
                                        "glosses": [
                                            "Marked by wholeness; sound and healthy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fc112d5-49ec-3401-93a6-573cc3068cac",
                                        "entry_id": "c63b1b6d-1f86-3785-b648-c71be9532886",
                                        "glosses": [
                                            "Decent; innocuous; sweet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abc1ba81-7dc6-4383-a6c7-4f3ae6590832",
                                                "sense_id": "5fc112d5-49ec-3401-93a6-573cc3068cac",
                                                "text": "Sometimes white Lyllies did their Leaves afford,\n With wholſom Polly-flow'rs, to mend his homely Board: […]"
                                            },
                                            {
                                                "example_id": "ac9a9b38-e29d-4795-8285-e9ffbb97d14a",
                                                "sense_id": "5fc112d5-49ec-3401-93a6-573cc3068cac",
                                                "text": "The more solicitous of the two was Nurse Cramer, a shapely, pretty, sexless girl with a wholesome unattractive face."
                                            },
                                            {
                                                "example_id": "044fe56e-1bba-4799-ac48-d47dcd1b90d1",
                                                "sense_id": "5fc112d5-49ec-3401-93a6-573cc3068cac",
                                                "text": "There's something tragic, but almost pure\n Think I could love you, but I'm not sure\n There's something wholesome, there's something sweet\n Tucked in your eyes that I'd love to meet"
                                            },
                                            {
                                                "example_id": "e0e89e41-b725-48ce-9249-c382abb2efc6",
                                                "sense_id": "5fc112d5-49ec-3401-93a6-573cc3068cac",
                                                "text": "Around the same time, “wholesome” memes of cute doggos and puppers rejuvenated social media feeds that seemed daily filled with fresh horrors."
                                            },
                                            {
                                                "example_id": "1b718c1c-e5bd-45bc-b76a-987537af819e",
                                                "sense_id": "5fc112d5-49ec-3401-93a6-573cc3068cac",
                                                "text": "The comment section on a recent post making fun of a “cute” and “wholesome” Doomer Girl meme is mixed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
