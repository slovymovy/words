                    "frequency": "Low",
                    "semantic_group_id": "genealogie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le titre de marquis a été transmis aux membres de la branche <w>aînée</w>."
                        },
                        {
                            "text": "Cette illustre lignée <w>aînée</w> conserve les terres et le château ancestral."
