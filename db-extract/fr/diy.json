                    }
                ]
            },
            {
                "entry_id": "87590492-10f9-3d8d-a833-35b68173702c",
                "word": "DIY",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "78f90f1e-065a-3fcf-9ff4-2998ae141fec",
                        "entry_id": "87590492-10f9-3d8d-a833-35b68173702c",
                        "glosses": [
                            "Confection par soi-même d’objets pratiques ou décoratifs de la vie courante."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "b55088b6-df9d-4559-b03c-30368e12be07",
                                "sense_id": "78f90f1e-065a-3fcf-9ff4-2998ae141fec",
                                "text": "La création n’est pas réservée au solitaire, elle peut être partagée en famille. D’autant plus lorsque le DIY permet de développer la créativité, l’apprentissage des erreurs, la solidarité dans le partage des tâches chez les enfants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a049a157-8527-44fc-b2a1-11549c2e3425",
                        "source_entry_id": "87590492-10f9-3d8d-a833-35b68173702c",
                        "source_sense_id": "78f90f1e-065a-3fcf-9ff4-2998ae141fec",
                        "target_lang_word": "DIY",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "DIY",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2845f651-a58d-36cc-bbac-236df7d383bb",
                                        "entry_id": "0690055c-19a8-37bb-9599-2f32c28f001e",
                                        "glosses": [
                                            "Do-it-yourself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdc25a54-1550-44ad-beeb-d401c1d0d342",
                                                "sense_id": "2845f651-a58d-36cc-bbac-236df7d383bb",
                                                "text": "Do you know where I could find a DIY pipe repair kit?"
                                            },
                                            {
                                                "example_id": "5517abcb-e8b2-4241-a4f0-3b8dbf8d1d0b",
                                                "sense_id": "2845f651-a58d-36cc-bbac-236df7d383bb",
                                                "text": "The product knowledge of salespeople is very high, which enables them to serve the demanding customer groups such as professional painters and builders, in addition to the usual DIY consumers."
                                            },
                                            {
                                                "example_id": "ff372f63-64b5-4333-a076-410cc655b3da",
                                                "sense_id": "2845f651-a58d-36cc-bbac-236df7d383bb",
                                                "text": "That is more DIY, more punk, anyway."
                                            },
                                            {
                                                "example_id": "92704706-c746-44aa-b8e1-76af4f673eaa",
                                                "sense_id": "2845f651-a58d-36cc-bbac-236df7d383bb",
                                                "text": "A temple abbot who used a DIY guillotine to behead himself in hope of attaining enlightenment might have misinterpreted some things along the way, Thailand’s religious authorities said yesterday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "DIY",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfcbe163-fad3-3a3c-b87f-6c1e0299ee70",
                                        "entry_id": "8420be9e-46c8-3048-9ace-8c8ef4790519",
                                        "glosses": [
                                            "Initialism of do it yourself."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f16dcdf-4ceb-40b9-8607-06ca9e5d5d8b",
                                                "sense_id": "cfcbe163-fad3-3a3c-b87f-6c1e0299ee70",
                                                "text": "According to market research, many men list DIY as one of their main hobbies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "DIY",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d8f7499-a79a-355e-a556-260e59f4e54a",
                                        "entry_id": "fe771218-4205-3558-b855-4ed287a6ad82",
                                        "glosses": [
                                            "To perform oneself a task usually relegated to an expert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "127013c7-db33-42b0-98a6-eca7b40967ff",
                                                "sense_id": "2d8f7499-a79a-355e-a556-260e59f4e54a",
                                                "text": "2007 [publication date], Maggie Bullock, \"Home Improvement\", Elle, January 2008 ed., page 108,\nHuber was a physicist. Even top Estée Lauder chemists who took over for Huber in 1995 found that... any attempt to cheat on his original formula produced disappointing results, which demands the question: If they couldn't DIY, can you?"
                                            },
                                            {
                                                "example_id": "00985495-f0c5-4f4b-897f-0755cd8c4dea",
                                                "sense_id": "2d8f7499-a79a-355e-a556-260e59f4e54a",
                                                "text": "Ukrainian civilians have been DIY-ing hedgehogs, welding two bars or beams at an angle to make a cross and then adding a third to ensure it holds its shape even if it's knocked over."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
