                ],
                "translations": [
                    {
                        "translation_id": "3defd066-d61c-484d-970d-7057e68a9c83",
                        "source_entry_id": "4f6827cb-9c81-36b4-928f-e27a4d1353ec",
                        "source_sense_id": "b5ebc192-a2ad-3d5a-b55d-3c7e73502a61",
                        "source_sense_description": "niets anders dan, niets minder dan",
                        "target_lang_word": "plainly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plainly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "843c51bd-e45e-3de7-9e81-17bf9394c3d0",
                                        "entry_id": "e4adbbf6-8f86-3187-a3cb-743b404b4697",
                                        "glosses": [
                                            "In a plain manner; simply; basically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c94f750-8fa7-4427-a4de-e01b945d2d08",
                                                "sense_id": "843c51bd-e45e-3de7-9e81-17bf9394c3d0",
                                                "text": "She decorated the room plainly but neatly."
                                            },
                                            {
                                                "example_id": "a2522760-5d67-4dff-821a-9551efd86e30",
                                                "sense_id": "843c51bd-e45e-3de7-9e81-17bf9394c3d0",
                                                "text": "'Tell me plainly what you think of my daughter's little companion.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                                        "entry_id": "e4adbbf6-8f86-3187-a3cb-743b404b4697",
                                        "glosses": [
                                            "Obviously; clearly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1060563-3455-4aeb-8fec-0099957aa51f",
                                                "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                                                "text": "You will see that ours is plainly the better method."
                                            },
                                            {
                                                "example_id": "84af7e50-d76c-436e-9827-75c6f2d77b1c",
                                                "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                                                "text": "The stories did not seem to me to touch life. They were plainly intended to have a bracing moral effect, and perhaps had this result for the people at whom they were aimed. They left me with the impression of a well-delivered stereopticon lecture, with characters about as life-like as the shadows on the screen, and whisking on and off, at the mercy of the operator."
                                            },
                                            {
                                                "example_id": "405ed914-8d92-40b0-97ec-1a9b888153fe",
                                                "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                                                "text": "Plainly he was prepared to bark out an interminable succession of charges against the Wanderer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a4793eb-e487-4ecf-a735-f8a60cf6d33f",
                        "source_entry_id": "4f6827cb-9c81-36b4-928f-e27a4d1353ec",
                        "source_sense_id": "b5ebc192-a2ad-3d5a-b55d-3c7e73502a61",
                        "source_sense_description": "niets anders dan, niets minder dan",
                        "target_lang_word": "simply",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simply",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d47a07a-ad66-3934-90dd-1b9f73795e4a",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "In a simple way or state; considered in or by itself; without addition; alone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b66f9c70-a612-388b-bf5e-9152a8accd68",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "Plainly; without art or subtlety"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6239f6ba-01b4-3d8b-a5e8-60eb17e413e7",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "Foolishly; stupidly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "454d6451-9736-47ee-8ab1-11a1dd0f16a8",
                                                "sense_id": "6239f6ba-01b4-3d8b-a5e8-60eb17e413e7",
                                                "text": "Mrs. Thorold had told her sons that a young lady was visiting at the house, whose history she had given them in short hand, describing her as a dependent on the late Mrs. Willoughby, whom her son had very simply intended to marry at Alvestone […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f21e9594-f93f-34fe-8037-bba7a97eff1c",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "Merely; solely."
                                        ],
                                        "tags": [
                                            "focus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfd31c40-ee5f-45ef-9d10-293011cade0f",
                                                "sense_id": "f21e9594-f93f-34fe-8037-bba7a97eff1c",
                                                "text": "I was simply asking a question."
                                            },
                                            {
                                                "example_id": "3cd986d7-c28f-422e-8cc3-199fa000c23f",
                                                "sense_id": "f21e9594-f93f-34fe-8037-bba7a97eff1c",
                                                "text": "A “moving platform” scheme[…]is more technologically ambitious than maglev trains even though it relies on conventional rails.[…]This set-up solves several problems […]. Stopping high-speed trains wastes energy and time, so why not simply slow them down enough for a moving platform to pull alongside?"
                                            },
                                            {
                                                "example_id": "5340c159-097f-40d5-b230-737c3eb94215",
                                                "sense_id": "f21e9594-f93f-34fe-8037-bba7a97eff1c",
                                                "text": "Rather than scanning a boarding pass or handing over a passport, you simply stare into a camera and you’re verified."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea90e5ba-1156-3ff1-9e79-34b5f130a638",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "absolutely, positively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d513240-f09e-41a1-876c-467b420ad4ed",
                                                "sense_id": "ea90e5ba-1156-3ff1-9e79-34b5f130a638",
                                                "text": "That was a simply wonderful dessert."
                                            },
                                            {
                                                "example_id": "2f3747f7-c95a-4ac2-9b0f-57c0eeb5ab57",
                                                "sense_id": "ea90e5ba-1156-3ff1-9e79-34b5f130a638",
                                                "text": "What about the way you love me? / And the way you squeeze me? / Simply beautiful"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a62f13d8-c8e9-3a75-86a4-b896b73ab361",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "Frankly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3b4fdc9-320f-49d4-be2a-7e06164b600c",
                                                "sense_id": "a62f13d8-c8e9-3a75-86a4-b896b73ab361",
                                                "text": "Simply, he just fired you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48660b40-e24c-4d50-bc28-7107bdebc750",
                        "source_entry_id": "4f6827cb-9c81-36b4-928f-e27a4d1353ec",
                        "source_sense_id": "b5ebc192-a2ad-3d5a-b55d-3c7e73502a61",
                        "source_sense_description": "niets anders dan, niets minder dan",
                        "target_lang_word": "einfach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einfach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3613b29e-7519-3260-890d-f2bec51b4cd5",
                                        "entry_id": "d309a0e8-e9ca-37d6-b249-fcdf4ad76ad7",
                                        "glosses": [
                                            "nicht schwierig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79ecd371-3aaf-40c9-a3d1-9c5dba20cb57",
                                                "sense_id": "3613b29e-7519-3260-890d-f2bec51b4cd5",
                                                "text": "Die Klassenarbeit in Französisch war sehr einfach."
                                            },
                                            {
                                                "example_id": "d1e22de8-7cfd-40c6-a46c-b76ce16acf65",
                                                "sense_id": "3613b29e-7519-3260-890d-f2bec51b4cd5",
                                                "text": "Die vermeintlich einfachen Antworten: Sie greifen überall dort, wo Menschen ohnehin eine gewisse Distanz zur politischen Klasse pflegen, wo Unsicherheit zu Feindseligkeit und Abwehr führt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c20b708f-3940-350b-af79-e20dc307c6a5",
                                        "entry_id": "d309a0e8-e9ca-37d6-b249-fcdf4ad76ad7",
                                        "glosses": [
                                            "nicht wiederholt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99292246-e3fb-427f-9038-94cb998a4b89",
                                                "sense_id": "c20b708f-3940-350b-af79-e20dc307c6a5",
                                                "text": "Er buchte eine einfache Fahrt nach Berlin."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7cc41ad8-4e55-3c3f-a4df-3aa8095c7f31",
                                        "entry_id": "d309a0e8-e9ca-37d6-b249-fcdf4ad76ad7",
                                        "glosses": [
                                            "nicht aufwändig, luxuriös"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c5a40b1-ce74-4541-a935-695fc0d16ed9",
                                                "sense_id": "7cc41ad8-4e55-3c3f-a4df-3aa8095c7f31",
                                                "text": "Die Familie führte ein einfaches Leben."
                                            },
                                            {
                                                "example_id": "cd760e25-ef3b-40d5-b5e9-420e8df6c1f5",
                                                "sense_id": "7cc41ad8-4e55-3c3f-a4df-3aa8095c7f31",
                                                "text": "Wir werden in einem einfachen Hotel übernachten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "bebed749-401b-3e60-ba62-ff3690ee3e31",
                                        "entry_id": "d309a0e8-e9ca-37d6-b249-fcdf4ad76ad7",
                                        "glosses": [
                                            "nicht besonders; gewöhnlich; unwichtig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "409badbb-1b6d-462f-969f-40c5f3687ff2",
                                                "sense_id": "bebed749-401b-3e60-ba62-ff3690ee3e31",
                                                "text": "Er ist ein einfacher Soldat."
                                            },
                                            {
                                                "example_id": "9091339c-e6d5-47bc-9542-12ae56de4b92",
                                                "sense_id": "bebed749-401b-3e60-ba62-ff3690ee3e31",
                                                "text": "Großmutter war eine bescheidene und einfache Hausfrau."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b334e0f5-3d41-3915-8c41-dce286f21c7e",
                                        "entry_id": "d309a0e8-e9ca-37d6-b249-fcdf4ad76ad7",
                                        "glosses": [
                                            "ohne nichttriviale Normalteiler"
                                        ],
                                        "tags": [
                                            "über Gruppen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8f69c6a-f6c9-4f70-900c-94a260296910",
                                                "sense_id": "b334e0f5-3d41-3915-8c41-dce286f21c7e",
                                                "text": "Die einfache mathematische Gruppe enthält nur das Identitätselement."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "8d273fbf-78c3-3357-b107-49451090250d",
                                        "entry_id": "d309a0e8-e9ca-37d6-b249-fcdf4ad76ad7",
                                        "glosses": [
                                            "verstärkt und betont eine Aussage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd692b8c-87d9-411a-a11e-508efd829c89",
                                                "sense_id": "8d273fbf-78c3-3357-b107-49451090250d",
                                                "text": "„Ich kann ihn einfach nicht leiden!“"
                                            },
                                            {
                                                "example_id": "09570c45-9e4c-44fb-b301-a66b883c0865",
                                                "sense_id": "8d273fbf-78c3-3357-b107-49451090250d",
                                                "text": "Mach doch bitte einfach mal."
                                            },
                                            {
                                                "example_id": "ca8c3a00-53e3-4196-926a-f6d0ca03d6be",
                                                "sense_id": "8d273fbf-78c3-3357-b107-49451090250d",
                                                "text": "Mach doch bitte einfach die Tür zu."
                                            },
                                            {
                                                "example_id": "b550fbf9-5f10-4091-bc82-881456975989",
                                                "sense_id": "8d273fbf-78c3-3357-b107-49451090250d",
                                                "text": "Wenn etwas zur Hälfte aus Kohlehydraten und zu einem Drittel aus Fett besteht, dann können wir einfach nicht mehr aufhören mit dem Essen. Das gilt für Kartoffelchips oder Schokolade – und natürlich auch für Marzipan."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    }
