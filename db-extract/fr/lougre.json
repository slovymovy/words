                                        "glosses": [
                                            "That which lugs in either literal or figurative senses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6721a925-f7ac-4669-a3f8-a1a7d798e566",
                                                "sense_id": "c9a1ca46-b3c4-3ca8-9baa-a8b6eb27454d",
                                                "text": "The horse was a lugger – lugging into the rail all the time. I had to fight hard to keep him running straight"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e42337d2-c465-3322-9299-f904a89b3ed6",
                                        "entry_id": "1c50da06-c1b7-3693-82c7-52ed08815479",
                                        "glosses": [
                                            "One who lugs, especially one whose job entails pulling or moving heavy objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1aa1293-a44e-4a13-a3d4-6074388f52bd",
                                                "sense_id": "e42337d2-c465-3322-9299-f904a89b3ed6",
                                                "text": "Robert Taillon, a lugger at Rapid, testified that in December 1997, Carlos Diaz and Michel Labrosse began to train Rene Delage as a lugger for the large transformers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6202638c-ffbf-3cc2-87c0-8020d6aa3dee",
                                        "entry_id": "1c50da06-c1b7-3693-82c7-52ed08815479",
                                        "glosses": [
                                            "A conman."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "US",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a549e363-59de-37fc-8756-f705a4f66b9f",
                                        "entry_id": "1c50da06-c1b7-3693-82c7-52ed08815479",
                                        "glosses": [
                                            "A person hired by a gambling establishment to locate potential customers and bring them in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21ab53cd-70d6-4d67-be38-a7e0162d3381",
                                                "sense_id": "a549e363-59de-37fc-8756-f705a4f66b9f",
                                                "text": "An estimated 50 luggers were employed to bring gamblers to Reading."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lugger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "244daa5b-aaac-3cec-bebb-13462e24c349",
                                        "entry_id": "a977021f-43b9-36d1-81cb-e465c4613a1b",
                                        "glosses": [
                                            "A small vessel having two or three masts, and a running bowsprit, and carrying lugsails."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd2d735b-692c-48b6-9471-8ffbac401af5",
                                                "sense_id": "244daa5b-aaac-3cec-bebb-13462e24c349",
                                                "text": "pearling lugger"
                                            },
                                            {
                                                "example_id": "80b63019-1620-4784-856a-e4bea1a710fc",
                                                "sense_id": "244daa5b-aaac-3cec-bebb-13462e24c349",
                                                "text": "A good many persons of the pension had gone over to the Cheniere Caminada in Beaudelet's lugger to hear mass."
                                            }
