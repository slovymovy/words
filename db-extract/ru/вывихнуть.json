                "translations": [
                    {
                        "translation_id": "a3b3d531-8355-43e7-b0aa-0fe771fb3a0e",
                        "source_entry_id": "f9ff21f7-5a44-351a-9d89-aefa89352b95",
                        "source_sense_id": "eca3eb73-4e29-3d3b-9b52-fa8a843b79a2",
                        "target_lang_word": "verdrehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verdrehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35a6ba8b-5361-39c1-a6d8-43791a6b3a72",
                                        "entry_id": "b7089140-61c9-31fb-9d09-bbc2efb71902",
                                        "glosses": [
                                            "die Ausrichtung von etwas ändern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b94af3e-1301-4ada-9c7b-db3845d1b686",
                                                "sense_id": "35a6ba8b-5361-39c1-a6d8-43791a6b3a72",
                                                "text": "„Plötzlich muss Müller absteigen, die Schulter hatte sich etwas verdreht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "827ae707-bfb5-3e55-92d1-58f5e863d92b",
                                        "entry_id": "b7089140-61c9-31fb-9d09-bbc2efb71902",
                                        "glosses": [
                                            "die Aussage von etwas verfälschen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50f4c995-ee55-49db-a9b7-5c690f7bcae9",
                                                "sense_id": "827ae707-bfb5-3e55-92d1-58f5e863d92b",
                                                "text": "„US-Präsident Donald Trump verbiegt wahllos wichtige Fakten und verdreht die Realität.“"
                                            },
                                            {
                                                "example_id": "96bc58ac-b0d4-4e31-879f-1cee27aa35b1",
                                                "sense_id": "827ae707-bfb5-3e55-92d1-58f5e863d92b",
                                                "text": "„Sondern vor allem, weil das Gedächtnis Fakten und Erlebnisse verdreht, falsch zusammenmontiert, um wesentliche Aspekte beraubt oder ausschmückt.“"
                                            },
                                            {
                                                "example_id": "dc1c2498-2b6b-4857-b77b-9dbddb245171",
                                                "sense_id": "827ae707-bfb5-3e55-92d1-58f5e863d92b",
                                                "text": "„Der Volkssänger Edmund Guschelbauer schrieb den Liedtext um und veränderte den Begriffsinhalt des Drahrers: aus dem Werkelmann, der sein Werkel ‚draht‘, wurde der leichtsinnige Wiener, der die Nacht zum Tag verdreht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "491b81ad-c50e-3a39-856e-adbdc12ec74e",
                                        "entry_id": "b7089140-61c9-31fb-9d09-bbc2efb71902",
                                        "glosses": [
                                            "Filmmaterial verbrauchen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b3b1592-d41c-4dea-8baf-d4d9b827638a",
                                                "sense_id": "491b81ad-c50e-3a39-856e-adbdc12ec74e",
                                                "text": "„Bei recht schlechtem Licht habe ich dann vier 30-m-Rollen Film verdreht und diverse Fotos belichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a06076f-3dcd-4240-93ef-4536644842b4",
                        "source_entry_id": "f9ff21f7-5a44-351a-9d89-aefa89352b95",
                        "source_sense_id": "eca3eb73-4e29-3d3b-9b52-fa8a843b79a2",
