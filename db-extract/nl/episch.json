                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bcf3546-1bf3-3e87-a1cf-f3c167ea44d8",
                                        "entry_id": "63a03803-fdd4-3f59-ae7e-15e199b95601",
                                        "glosses": [
                                            "Qui raconte une épopée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de4d276f-3e5f-4d77-808d-297872f55a62",
                                                "sense_id": "1bcf3546-1bf3-3e87-a1cf-f3c167ea44d8",
                                                "text": "Poète épique."
                                            },
                                            {
                                                "example_id": "6c42aafd-4902-421f-b66b-0ca32a46194c",
                                                "sense_id": "1bcf3546-1bf3-3e87-a1cf-f3c167ea44d8",
                                                "text": "Le poème épique raconte, le poème dramatique représente."
                                            },
                                            {
                                                "example_id": "4db6abc9-2260-4d2b-9fb7-555e2750fd39",
                                                "sense_id": "1bcf3546-1bf3-3e87-a1cf-f3c167ea44d8",
                                                "text": "L’Iliade, la Chanson de Roland, la Jérusalem délivrée sont des poèmes épiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ad8e5f6-9409-306d-b438-6d1aa0276cd2",
                                        "entry_id": "63a03803-fdd4-3f59-ae7e-15e199b95601",
                                        "glosses": [
                                            "Qui est propre à l’épopée ou qui s’y applique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6baa510e-27f0-48e9-b1e1-6c7a72728dbb",
                                                "sense_id": "5ad8e5f6-9409-306d-b438-6d1aa0276cd2",
                                                "text": "Le genre épique."
                                            },
                                            {
                                                "example_id": "fb6c872d-8d7c-4aa6-ac07-ac4f1a19045e",
                                                "sense_id": "5ad8e5f6-9409-306d-b438-6d1aa0276cd2",
                                                "text": "Donner la forme épique à un récit."
                                            },
                                            {
                                                "example_id": "f26aca4b-43fa-4755-b554-ac3f9f957252",
                                                "sense_id": "5ad8e5f6-9409-306d-b438-6d1aa0276cd2",
                                                "text": "Des vers épiques."
                                            },
                                            {
                                                "example_id": "4c72065b-d70b-4429-b870-13ee4aeed1e9",
                                                "sense_id": "5ad8e5f6-9409-306d-b438-6d1aa0276cd2",
                                                "text": "Il prend le ton épique lorsqu’il devrait être simple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a0f8fa9-c876-3c30-9ff9-aef69e5abb96",
                                        "entry_id": "63a03803-fdd4-3f59-ae7e-15e199b95601",
