                    {
                        "sense_id": "e7131c7c-47af-3339-941c-4c1e546d11ee",
                        "entry_id": "a8f511fa-4910-35da-ac7b-53050149c3d8",
                        "glosses": [
                            "Alternative form of FedEx."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "723b315d-0725-44d3-9de3-ce3c540ca422",
                                "sense_id": "e7131c7c-47af-3339-941c-4c1e546d11ee",
                                "text": "I fedexed a copy of the papers to my comrade sister in New York City."
                            },
                            {
                                "example_id": "3d2b9809-6bd7-4570-aa97-f5c2480ac0aa",
                                "sense_id": "e7131c7c-47af-3339-941c-4c1e546d11ee",
                                "text": "She fedexed the full story, credit card reports and details of mistreatment to the CEO of TJ Maxx."
                            },
                            {
                                "example_id": "14ba3e85-fa4d-4693-81de-3e939fba0135",
                                "sense_id": "e7131c7c-47af-3339-941c-4c1e546d11ee",
                                "text": "“I truly enjoyed this book,” wrote one Amazon.com reviewer, “and one can only hope that conservative readers will finally loosen up their minds a bit and see the bible as not something fedexed by God to a lucky few, but as an evolving adventure of the human spirit in search of its own cosmic place."
                            }
                        ]
                    }
