                "senses": [
                    {
                        "sense_id": "adac278d-81b2-3880-b21f-dbb2e89351c0",
                        "entry_id": "404b2982-1bfd-3cf7-8eca-521094eed07e",
                        "glosses": [
                            "künstlich geschaffenes Becken oder großer Raum zur kurzfristigen Rückhaltung von größeren Mengen an Regenwasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4efdc1b-8289-4f34-b147-9fdf2544d538",
                                "sense_id": "adac278d-81b2-3880-b21f-dbb2e89351c0",
                                "text": "„Die Funktion eines Regenrückhaltebeckens ist immer das kontrollierte Abfließen von großen, temporär gestauten Wassermengen zu ermöglichen.“"
                            },
                            {
                                "example_id": "297a68b0-9e36-4294-9437-77598c856b61",
                                "sense_id": "adac278d-81b2-3880-b21f-dbb2e89351c0",
                                "text": "„Das 175.000 Kubikmeter fassende Regenrückhaltebecken Gimmingen hat die Aufgabe, die Stadtteile Gimmigen und Heppingen vor Überflutungen durch den Leimersdorfer Bach und den Bengener Bach zu schützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
