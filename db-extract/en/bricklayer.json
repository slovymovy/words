                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f0abf5b-4dfc-4250-b2c3-68f7c4fc775f",
                                                "sense_id": "6967f5eb-ee0a-3d75-8cbb-5ca3cd3ee94b",
                                                "text": "Maurer haben eine körperlich anstrengende Arbeit."
                                            },
                                            {
                                                "example_id": "9bcc8a50-599c-494d-b8a2-c09f54779451",
                                                "sense_id": "6967f5eb-ee0a-3d75-8cbb-5ca3cd3ee94b",
                                                "text": "„Ludwig Bertini schien seine Aufgabe als Maurer, Maler, Installateur und Dachdecker sehr ernst zu nehmen.“"
                                            },
                                            {
                                                "example_id": "7d382695-32da-42ed-ba76-056b74766fe3",
                                                "sense_id": "6967f5eb-ee0a-3d75-8cbb-5ca3cd3ee94b",
                                                "text": "„Am schärfsten nahm der patrouillierende Witz das Handwerk der Maurer aufs Korn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Maurer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de81470c-04ed-3d72-b23c-48e16e622b7f",
                                        "entry_id": "109dc239-c97a-3ddb-8910-02f0cb60919d",
                                        "glosses": [
                                            "Mann, der in der liechtensteinischen Gemeinde Mauren lebt oder dort geboren ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5929e18-80d7-4864-979c-22ec802f1958",
                                                "sense_id": "de81470c-04ed-3d72-b23c-48e16e622b7f",
                                                "text": "„Die Fronpflicht der Maurer ist festgelegt mit einem Tageswerk pro Jahr, mit Jagd- und Fuhrdiensten bei Bedarf und der jährlichen Lieferung eines Fuders Mist für den herrschaftlichen Weinberg. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Maurer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf1bd513-afb4-3d25-9bc2-06a82d7377ed",
                                        "entry_id": "25cc361f-53b8-3411-8122-1ef016c2aad4",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec6c05e6-07c7-4365-bea1-bd7031e731c3",
                                                "sense_id": "cf1bd513-afb4-3d25-9bc2-06a82d7377ed",
                                                "text": "Die Maurers haben abgesagt; sie sind leider verhindert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Maurer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be7925ac-1653-3931-a480-51c5217c433c",
                                        "entry_id": "a5a9b7d9-8956-3130-b456-1c96b9278aef",
                                        "glosses": [
                                            "für Mauren charakteristisch, aus Mauren stammend, zu Mauren gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72955929-4e05-43a5-82b2-99db7402d567",
                                                "sense_id": "be7925ac-1653-3931-a480-51c5217c433c",
                                                "text": "„Das neue Maurer Vereinshaus wird am 4. Juli feierlich eröffnet.“"
                                            },
                                            {
                                                "example_id": "fe4096bd-7171-4f84-a38b-cd1a4bfc45a3",
                                                "sense_id": "be7925ac-1653-3931-a480-51c5217c433c",
                                                "text": "„Bei der Präsentation des Werks wies Adolf Marxer-Kronthaler, Vizepräsident des Ahnenforschungsvereins, auf das ungeheure Mass an Arbeit hin, das in dieser geschichtlichen Aufarbeitung der Maurer Familien liege.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
