            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5dff91ee-16c3-378f-8ab9-fa8090dbddce",
                    "sense_definition": "Niet helemaal goed, gebrekkig of met fouten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imperfect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gemeente hanteert bij het inhuren van personeel een <w>onvolkomen</w> en warrig beleid.",
                            "target_lang_translations": {
                                "de": "Die Gemeinde verfolgt bei der Einstellung von Personal eine <w>mangelhafte</w> und verworrene Politik.",
                                "en": "The municipality uses a <w>flawed</w> and confusing policy when hiring staff."
                            }
                        },
                        {
                            "text": "Zijn kennis van de Franse taal is helaas nogal <w>onvolkomen</w>.",
                            "target_lang_translations": {
                                "de": "Seine Kenntnisse der französischen Sprache sind leider ziemlich <w>unvollkommen</w>.",
                                "en": "His knowledge of the French language is unfortunately rather <w>imperfect</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gebrekkig",
                        "onvolmaakt",
                        "ondeugdelijk"
                    ],
                    "antonyms": [
                        "perfect",
                        "volmaakt",
                        "deugdelijk"
                    ],
                    "common_phrases": [
                        "onvolkomen beleid",
                        "onvolkomen kennis"
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht ganz gut, mangelhaft oder fehlerhaft.",
                        "en": "Not entirely good, flawed, or containing errors."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "unvollkommen",
