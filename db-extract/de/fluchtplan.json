                ],
                "senses": [
                    {
                        "sense_id": "435bfc81-797e-3488-8343-72bee0f60177",
                        "entry_id": "cd29bd95-3b75-3817-b713-1139dc913722",
                        "glosses": [
                            "Plan, der den Ablauf einer geplanten Flucht beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d304870-cf0b-4135-bcee-bb0c9645f8f7",
                                "sense_id": "435bfc81-797e-3488-8343-72bee0f60177",
                                "text": "„Sie dokumentiert Franks Fluchtpläne und lässt erahnen, wie die Psychologie des Verrats funktioniert, von der heimeligen Häkeldeckchenwelt bis zur totalitär verordneten Gemeinschaftswärme.“"
                            },
                            {
                                "example_id": "b92555a0-f9ab-4f79-9a88-9cd521f789c9",
                                "sense_id": "435bfc81-797e-3488-8343-72bee0f60177",
                                "text": "„Soweit ich mich erinnern kann, muss dieser Wunsch nach Veränderung fast ein Jahr angedauert haben und wurde ständig durch die Ankunft und Abfahrt von Schiffen direkt vor meinen Augen angestachelt, bevor ich mich daranmachte, einen ernsthaften Fluchtplan auszuhecken.“"
                            },
                            {
                                "example_id": "9b1924b5-9aaf-403d-bf12-b2b5765adb83",
                                "sense_id": "435bfc81-797e-3488-8343-72bee0f60177",
                                "text": "„Du beginnst, an einem Fluchtplan zu tüfteln.“"
                            },
                            {
                                "example_id": "79575e4c-2e2c-42ba-9fcd-175bb5a73a7a",
                                "sense_id": "435bfc81-797e-3488-8343-72bee0f60177",
                                "text": "„Ich war weniger darauf aus, mich dieser gelehrten Lektüre hinzugeben, als die Gelegenheit zu ergreifen, einen Briefwechsel mit irgend jemandem einzufädeln, der mir bei einem Fluchtplan helfen konnte, den ich bereits im Kopf entworfen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
