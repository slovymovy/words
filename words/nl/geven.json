            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0e826254-2489-33f6-8c0f-80b499b8ea93",
                    "sense_definition": "iets aan iemand overhandigen of in bezit stellen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "overdracht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>gaf</w> hem een nieuw boek voor zijn verjaardag.",
                            "target_lang_translations": {
                                "en": "I <w>gave</w> him a new book for his birthday.",
                                "ru": "Я <w>подарил</w> ему новую книгу на день рождения."
                            }
                        },
                        {
                            "text": "Zou je mij het zout even kunnen <w>geven</w>?",
                            "target_lang_translations": {
                                "en": "Could you <w>pass</w> me the salt for a moment?",
                                "ru": "Не мог бы ты <w>передать</w> мне соль?"
                            }
                        }
                    ],
                    "synonyms": [
                        "schenken",
                        "doneren",
                        "aanreiken"
                    ],
                    "antonyms": [
                        "nemen",
                        "krijgen"
                    ],
                    "common_phrases": [
                        "een cadeau geven",
                        "het goede voorbeeld geven",
                        "de hand geven"
                    ],
                    "target_lang_definitions": {
                        "en": "to hand something over to someone or put it in their possession",
                        "ru": "передавать что-либо кому-либо или предоставлять во владение"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "give",
                                "target_lang_sense_clarification": "to transfer possession"
                            },
                            {
                                "target_lang_word": "hand",
                                "target_lang_sense_clarification": "to pass something physically"
                            },
                            {
                                "target_lang_word": "present",
                                "target_lang_sense_clarification": "to give formally or as a gift"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "давать",
                                "target_lang_sense_clarification": "передавать в распоряжение"
                            },
                            {
                                "target_lang_word": "дарить",
                                "target_lang_sense_clarification": "давать в качестве подарка"
                            },
                            {
                                "target_lang_word": "подавать",
                                "target_lang_sense_clarification": "протягивать, вручать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86a4d62f-f7a5-3e13-8598-08908b4dd270",
                    "sense_definition": "belangstelling of zorg tonen voor iets of iemand",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>geeft</w> veel om zijn kinderen en hun toekomst.",
                            "target_lang_translations": {
                                "en": "He <w>cares</w> a lot about his children and their future.",
                                "ru": "Он очень <w>любит</w> своих детей и заботится об их будущем."
                            }
                        },
                        {
                            "text": "Het lijkt alsof zij helemaal niets <w>geven</w> om politieke integriteit.",
                            "target_lang_translations": {
                                "en": "It seems as if they don't <w>care</w> about political integrity at all.",
                                "ru": "Кажется, будто их совершенно не <w>волнует</w> политическая честность."
                            }
                        }
                    ],
                    "common_phrases": [
                        "om iemand geven",
                        "om iets geven"
                    ],
                    "target_lang_definitions": {
                        "en": "to show interest or care for something or someone",
                        "ru": "проявлять интерес или заботу о ком-либо или чем-либо"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "care",
                                "target_lang_sense_clarification": "to feel concern or interest"
                            },
                            {
                                "target_lang_word": "give a damn",
                                "target_lang_sense_clarification": "to care at all (often used in negative)"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "любить",
                                "target_lang_sense_clarification": "дорожить кем-то"
                            },
                            {
                                "target_lang_word": "заботиться",
                                "target_lang_sense_clarification": "проявлять интерес и внимание"
                            },
                            {
                                "target_lang_word": "быть небезразличным",
                                "target_lang_sense_clarification": "испытывать привязанность или интерес"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18cdf2bf-aab9-39e4-a63c-7c456e48f883",
                    "sense_definition": "een negatief effect hebben of erg zijn",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "effect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>geeft</w> niet dat je te laat bent voor de afspraak.",
                            "target_lang_translations": {
                                "en": "It doesn't <w>matter</w> that you are late for the appointment.",
                                "ru": "Ничего <w>страшного</w>, что ты опоздал на встречу."
                            }
                        },
                        {
                            "text": "<w>Geeft</w> dat? Nee, dat maakt helemaal niets uit.",
                            "target_lang_translations": {
                                "en": "Does that <w>matter</w>? No, it doesn't make any difference at all.",
                                "ru": "Это <w>важно</w>? Нет, это не имеет никакого значения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dat geeft niet"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in de ontkennende vorm 'geeft niet'."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to have a negative effect or be a problem",
                        "ru": "иметь негативный эффект или иметь значение (обычно в отрицании)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "matter",
                                "target_lang_sense_clarification": "to be of importance or concern"
                            },
                            {
                                "target_lang_word": "mind",
                                "target_lang_sense_clarification": "to be bothered by something"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "иметь значение",
                                "target_lang_sense_clarification": "быть важным"
                            },
                            {
                                "target_lang_word": "быть страшным",
                                "target_lang_sense_clarification": "в значении «ничего страшного»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c30c099-eed4-308c-8fd7-6cde72552389",
                    "sense_definition": "iets opleveren, veroorzaken of verschaffen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resultaat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze nieuwe informatie <w>gaf</w> ons voldoende vertrouwen om door te gaan.",
                            "target_lang_translations": {
                                "en": "This new information <w>gave</w> us enough confidence to continue.",
                                "ru": "Эта новая информация <w>внушила</w> нам достаточно уверенности, чтобы продолжить."
                            }
                        },
                        {
                            "text": "De overwinning <w>gaf</w> de spelers een autonoom gevoel van trots.",
                            "target_lang_translations": {
                                "en": "The victory <w>gave</w> the players an autonomous sense of pride.",
                                "ru": "Победа <w>дала</w> игрокам чувство гордости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "voldoende informatie geven",
                        "een gevoel geven"
                    ],
                    "target_lang_definitions": {
                        "en": "to yield, cause, or provide something as a result",
                        "ru": "приносить результат, вызывать или обеспечивать что-либо"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "give",
