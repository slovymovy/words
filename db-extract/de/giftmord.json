                "senses": [
                    {
                        "sense_id": "9c378b60-4f24-3a84-b995-a12fbbb90957",
                        "entry_id": "661dd800-e714-3735-a7f7-c359fb066705",
                        "glosses": [
                            "vorsätzliche Tötung einer Person durch die Anwendung einer giftigen Substanz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2cc1547-a808-407d-9feb-6574e8a3adf9",
                                "sense_id": "9c378b60-4f24-3a84-b995-a12fbbb90957",
                                "text": "„Im Prozess um den Giftmord an Kim Jong Nam hat ein Gutachter eine der beiden Angeklagten stark belastet.“"
                            },
                            {
                                "example_id": "f08cc9f5-60ef-4a01-b957-6f42252cbcd1",
                                "sense_id": "9c378b60-4f24-3a84-b995-a12fbbb90957",
                                "text": "„Der sechzigjährige Präsident ist nur noch ein Skelett, behaart wie ein Satyr, Anbeter von Schmutz und Exkrementen, Liebhaber des Giftmordes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
