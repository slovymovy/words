                        "glosses": [
                            "Not melodious."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "226fd47f-e32e-4adb-a9c1-b19f93154dd9",
                                "sense_id": "2fb35566-f327-3cc2-9d0c-953d1daeea3f",
                                "text": "Prussian Trenck […] jargons and jangles in an unmelodious manner."
                            },
                            {
                                "example_id": "218c1856-6588-42db-a9cd-826e486fe64a",
                                "sense_id": "2fb35566-f327-3cc2-9d0c-953d1daeea3f",
                                "text": "Here we have brought our three gifts and mingled them with yours: a gift of story and song—soft, stirring melody in an ill–harmonized and unmelodious land; the gift of sweat and brawn to beat back the wilderness, conquer the soil, and lay the foundations of this vast economic empire two hundred years earlier than your weak hands could have done it; the third, a gift of the Spirit."
                            },
                            {
                                "example_id": "389e01d4-cd01-41e2-af37-cbec117feb7e",
                                "sense_id": "2fb35566-f327-3cc2-9d0c-953d1daeea3f",
                                "text": "Watt listened for a time, for the voice was far from unmelodious."
                            }
                        ]
                    }
