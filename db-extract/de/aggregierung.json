                "senses": [
                    {
                        "sense_id": "dcde2909-3c43-3859-a78e-2368f86d6137",
                        "entry_id": "6b4735dc-2e18-3c10-81cc-5a9cd77a9a3f",
                        "glosses": [
                            "im Datawarehousing die Verdichtung und Konsolidierung großer Datenmengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "565327de-057c-4d4c-a92b-195210c2534d",
                                "sense_id": "dcde2909-3c43-3859-a78e-2368f86d6137",
                                "text": "Bei der Aggregierung wird eine neue Monatstabelle angelegt, die die aggregierten Tagesdaten enthält."
                            },
                            {
                                "example_id": "3b50bc53-262f-4dab-aef4-46ed4dc062e3",
                                "sense_id": "dcde2909-3c43-3859-a78e-2368f86d6137",
                                "text": "„Die Gründe für den Einsatz Aggregierung sind zum einen die häufige Nutzung von Monatsdaten und zum anderen, wenn sich die Zeilenanzahl in der Monatstabelle, gegenüber der Zeilenanzahl in der Tagestabelle stark verringert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a64a98b3-3005-30af-be44-675150c43248",
                        "entry_id": "6b4735dc-2e18-3c10-81cc-5a9cd77a9a3f",
                        "glosses": [
                            "in der objektorientierten Softwaretechnologie eine besondere Art der Assoziation zwischen zwei Objekten: »A ist Teil von B, aber B existiert auch ohne A«"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee0caae6-ed29-473a-8a28-ee7e2c536e66",
                                "sense_id": "a64a98b3-3005-30af-be44-675150c43248",
                                "text": "Hier möchten wir eine Aggregierung von Einzelobjekten zu einem Gesamtobjekt zusammenfassen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d1e5615c-b248-3121-8e35-23c62efa9211",
                        "entry_id": "6b4735dc-2e18-3c10-81cc-5a9cd77a9a3f",
                        "glosses": [
                            "materielles Zusammenlagern von Komponenten, die ein Aggregat bilden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b34696f2-1f3b-4b24-849a-e6085d16e7eb",
                                "sense_id": "d1e5615c-b248-3121-8e35-23c62efa9211",
                                "text": "Wir wollen einen Initiator einsetzen, um eine Aggregierung von Additiv und Initiator entstehen zu lassen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "e9367daa-90a3-3658-97bc-711ba75fd902",
                        "entry_id": "6b4735dc-2e18-3c10-81cc-5a9cd77a9a3f",
                        "glosses": [
                            "Verbände von Lebewesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a1db5b9-45fe-4932-95a4-32c77484331b",
                                "sense_id": "e9367daa-90a3-3658-97bc-711ba75fd902",
                                "text": "„Nebst der erfolgreich demonstrierten Aggregierung von freiem und kommerziell angebotenem Fachwissen erweckte die Kombination mit einer institutionsübergreifenden kollaborativen Plattform das meiste Interesse.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "4e70df91-6227-3eae-a227-cc04fb12cc72",
                        "entry_id": "6b4735dc-2e18-3c10-81cc-5a9cd77a9a3f",
                        "glosses": [
                            "Verbände von Lebewesen",
                            "(a) Zellen, die sich zu einem Aggregat verbinden, also dabei ihre volle Individualität nicht aufgeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf4a6f13-c19a-4715-90b3-f6f88556e485",
                                "sense_id": "4e70df91-6227-3eae-a227-cc04fb12cc72",
                                "text": "„Nebst der erfolgreich demonstrierten Aggregierung von freiem und kommerziell angebotenem Fachwissen erweckte die Kombination mit einer institutionsübergreifenden kollaborativen Plattform das meiste Interesse.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "573f85b2-a9a3-3684-8a91-4e224c7f0968",
                        "entry_id": "6b4735dc-2e18-3c10-81cc-5a9cd77a9a3f",
                        "glosses": [
