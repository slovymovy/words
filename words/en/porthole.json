                    "frequency": "Middle",
                    "semantic_group_id": "ship_openings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked out of the cabin <w>porthole</w> and watched the waves crash against the side of the cruise ship."
                        },
                        {
                            "text": "Make sure you securely close the <w>porthole</w> before the storm arrives."
                        }
                    ],
                    "synonyms": [
                        "bullseye",
                        "scuttle"
                    ],
                    "common_phrases": [
