{
    "word_family": [
        "échappatoire",
        "échappement",
        "échappée"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bf3c2656-3965-3637-b76a-602b6cccb4f9",
                    "sense_definition": "Éviter un danger, une contrainte ou une situation pénible en se soustrayant à son emprise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fuite_evitement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le suspect a réussi à <w>échapper</w> à la police en se cachant dans la foule."
                        },
                        {
                            "text": "Grâce à son casque de protection, le cycliste a pu <w>échapper</w> au pire."
                        }
                    ],
                    "common_phrases": [
                        "échapper au contrôle",
                        "échapper au danger",
                        "échapper à la vigilance"
                    ]
                },
                {
                    "sense_id": "7a37c269-ef50-3594-9d5d-7089647daf11",
                    "sense_definition": "Ne pas être remarqué, perçu ou compris par quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce détail crucial semblait <w>échapper</w> à tous les observateurs présents."
                        },
                        {
                            "text": "Rien ne pouvait <w>échapper</w> à son regard attentif durant la réunion."
                        }
                    ],
                    "common_phrases": [
                        "échapper à l'attention",
                        "rien ne lui échappe"
                    ]
                },
                {
                    "sense_id": "4ed02828-971b-307a-af6b-ede8f1f1bca5",
                    "sense_definition": "Sortir de la mémoire de quelqu'un de façon temporaire ou définitive.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je reconnais bien ce visage mais son nom m'<w>échappe</w> pour l'instant."
                        },
                        {
                            "text": "Le titre exact de ce roman m'<w>échappait</w> complètement hier soir."
                        }
                    ],
                    "common_phrases": [
                        "son nom m'échappe"
                    ]
                },
                {
                    "sense_id": "2796f521-05a5-3e3e-af16-ef43435baf4a",
                    "sense_definition": "Éviter de justesse un grand péril ou une sanction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fuite_evitement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous l'avons <w>échappé</w> belle en évitant cet obstacle sur la route."
                        },
                        {
                            "text": "Tu l'as <w>échappé</w> belle après avoir failli rater ton vol ce matin."
                        }
                    ],
                    "common_phrases": [
                        "l'échapper belle"
                    ]
                },
                {
                    "sense_id": "5991cd55-d414-3b8b-8a26-3c4dfe8a2410",
                    "sense_definition": "Être proféré, produit ou commis involontairement, par maladresse ou inadvertance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un cri de surprise lui <w>échappa</w> dès qu'il entendit la mauvaise nouvelle."
                        },
                        {
                            "text": "Cette information confidentielle lui a <w>échappé</w> lors de la discussion."
                        }
                    ],
                    "common_phrases": [
                        "laisser échapper un mot"
                    ]
                },
                {
                    "sense_id": "f29e6a4e-88ab-372a-b249-9c2dee2cf061",
                    "sense_definition": "Lâcher ou faire tomber involontairement un objet tenu en main.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En rangeant la vaisselle, il a <w>échappé</w> une assiette sur le sol."
                        },
                        {
                            "text": "Elle a malencontreusement <w>échappé</w> son téléphone en descendant du bus."
                        }
                    ],
                    "synonyms": [
                        "laisser tomber"
                    ],
                    "common_phrases": [
                        "échapper un objet"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Principalement utilisé au Québec"
                        }
                    ]
                },
                {
                    "sense_id": "ac864283-7d8e-30ed-985b-8fb752043843",
                    "sense_definition": "Neutraliser la fonction syntaxique d'un caractère spécial au moyen d'un symbole d'échappement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut penser à <w>échapper</w> les guillemets dans la requête informatique."
                        },
                        {
                            "text": "Le programmeur <w>échappe</w> ce symbole pour éviter une erreur d'interprétation."
                        }
                    ],
                    "common_phrases": [
                        "échapper les caractères",
                        "échapper un caractère"
                    ]
                }
            ]
        }
    ]
}