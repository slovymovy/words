                                        "entry_id": "b61dc26e-e479-3589-a399-79623f68e1e4",
                                        "glosses": [
                                            "Of or relating to an early videotape format with four magnetic record/reproduce heads mounted on a headwheel spinning transversely across the tape."
                                        ],
