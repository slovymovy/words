                                    }
                                ]
                            },
                            {
                                "target_word": "breath",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e97a8d6c-a11d-3568-b963-89c2b265244b",
                                        "entry_id": "b4aa5b9c-5c1c-3836-a1ab-06ccf5a187ee",
                                        "glosses": [
                                            "Misspelling of breathe."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misspelling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a1c0a09-78b7-4a34-8474-8ecc7cb5fe38",
                                                "sense_id": "e97a8d6c-a11d-3568-b963-89c2b265244b",
                                                "text": "In the polar regions one finds dark cold waters with few places to breath."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
