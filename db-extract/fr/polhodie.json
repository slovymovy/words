                                        "entry_id": "f2b3a172-7b7f-34ec-9922-090be6da63c4",
                                        "glosses": [
                                            "The wobble of a spinning body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7482f37e-358c-41b7-9d0c-d81678a0a784",
                                                "sense_id": "dc2566c5-ab23-395e-90a8-62f6447e7d20",
                                                "text": "Since the polhodes are the intersection of the surface of the ellipsoid with a cone, Eq. (3), whose apex is at the center of the ellipsoid, and since the cone has two nappes, there are two curves on the ellipsoid for each value of d."
                                            }
                                        ]
