                    "sense_definition": "krzyczeć głośno, wydzierać się lub hałasować",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "krzyk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sąsiad znowu <w>pyskuje</w> na całe podwórko od samego rana.",
