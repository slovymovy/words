                "senses": [
                    {
                        "sense_id": "24757c9a-720d-3b39-aa26-e5c397fd0e11",
                        "entry_id": "ddb32617-4d3a-32ad-8a1d-3b164a504a5e",
                        "glosses": [
                            "ein großgeschriebener Buchstabe"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "a553facf-8685-41a7-a986-32fb3ff23d12",
                                "sense_id": "24757c9a-720d-3b39-aa26-e5c397fd0e11",
                                "text": "\"Verwenden Sie die korrekte Schriftsprache, ausschließlich Kleinbuchstaben können als Geringschätzung, Versalien als aggressiv gewertet werden.\""
                            },
                            {
                                "example_id": "e098eb36-5ffa-4cb1-8a3d-540d6357d3f7",
                                "sense_id": "24757c9a-720d-3b39-aa26-e5c397fd0e11",
                                "text": "„Sie ist ihm so teuer, daß es ihm offenbar sündhaft erschiene, ihre Worte bei öffentlichen Aufschriften anders als in Buchstaben von mindestens einem Viertel Meter Höhe malen zu lassen, – und alles in Versalien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3b0376dc-4d0d-38c5-884e-a9fe0ecc6f8d",
                        "entry_id": "ddb32617-4d3a-32ad-8a1d-3b164a504a5e",
                        "glosses": [
                            "ein großer Buchstabe am Anfang eines Verses"
                        ],
                        "tags": [
                            "Schriftlinguistik",
                            "ursprünglich"
                        ],
                        "examples": [
                            {
                                "example_id": "94ddf6fe-d265-451d-b2aa-01e81220a5fe",
                                "sense_id": "3b0376dc-4d0d-38c5-884e-a9fe0ecc6f8d",
                                "text": "Die Paläographie bezeichnet eine Majuskel am Beginn einer Verszeile als Versal."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07e7efbb-41e5-4b33-9d7d-16962afab452",
                        "source_entry_id": "ddb32617-4d3a-32ad-8a1d-3b164a504a5e",
