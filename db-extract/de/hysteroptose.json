                "senses": [
                    {
                        "sense_id": "51a46f96-4950-397c-b063-9b52169932ae",
                        "entry_id": "d46ca88c-fb6d-34cd-8027-0ed17733a5bc",
                        "glosses": [
                            "Abwärtsbewegung/Absenkung der Gebärmutter"
                        ],
                        "tags": [
                            "geringer Grad der Hysteroptose"
                        ],
                        "examples": [
                            {
                                "example_id": "32ca7737-7108-4afb-9109-f6abc146eb6d",
                                "sense_id": "51a46f96-4950-397c-b063-9b52169932ae",
                                "text": "Die Hysteroptose ist die nach unten stattfindende Verlagerung dieses Organs und sie kann vollständig und unvollständig sein."
                            },
                            {
                                "example_id": "8ea9f7d8-f838-4c82-b504-eb4a7014a7d1",
                                "sense_id": "51a46f96-4950-397c-b063-9b52169932ae",
                                "text": "„Er sieht in der Retroversio-flexio das Vorstadium des Prolapses und bezeichnet den ausgedehnten Vorfall als das zweite Stadium der Hysteroptose.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "55314e73-9d3e-3677-814c-77584e47cbe1",
                        "entry_id": "d46ca88c-fb6d-34cd-8027-0ed17733a5bc",
                        "glosses": [
                            "so weite Absenkung der Gebärmutter, dass sie sich in die Scheide stülpt und aus ihr heraustritt"
                        ],
                        "tags": [
                            "Endzustand der Hysteroptose"
                        ],
                        "examples": [
                            {
                                "example_id": "f0f948e1-b65e-4213-8b5e-bbdac1cbf9ed",
                                "sense_id": "55314e73-9d3e-3677-814c-77584e47cbe1",
                                "text": "„Er sieht in der Retroversio-flexio das Vorstadium des Prolapses und bezeichnet den ausgedehnten Vorfall als das zweite Stadium der Hysteroptose.“"
                            },
                            {
                                "example_id": "14cb41d5-28c3-4b3a-aa35-b5542924ed2a",
                                "sense_id": "55314e73-9d3e-3677-814c-77584e47cbe1",
                                "text": "„Wie gesagt, ist der Uterusprolaps, das Heraustreten des ganzen oder häufiger nur des unteren Teiles des Uterus aus den äußeren Genitalien, meistenteils das Kulminationsstadium, der Endzustand der Retroversio-flexio, des geringeren Grades der Hysteroptose.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
