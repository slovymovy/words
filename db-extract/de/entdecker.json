                                "target_senses": [
                                    {
                                        "sense_id": "1d853617-3dfc-3cad-b390-961ae3913b8f",
                                        "entry_id": "3442273f-ada9-30ab-be2a-c3b88924ff8c",
                                        "glosses": [
                                            "Celui qui a découvert une chose en question."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfd94be0-dd8f-4a41-9ebf-8ae727b12069",
                                                "sense_id": "1d853617-3dfc-3cad-b390-961ae3913b8f",
                                                "text": "[…], et il est probable, en effet, que le premier découvreur du pôle n’aura atteint ce point qu’à la suite d’une martre ou d’un renard argenté !"
                                            },
                                            {
                                                "example_id": "dfd68841-bf56-4581-8d55-5a924c557cc0",
                                                "sense_id": "1d853617-3dfc-3cad-b390-961ae3913b8f",
                                                "text": "A juste titre, on a donné à ce Sund le nom de son découvreur : William Scoresby junior […]."
