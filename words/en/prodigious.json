            "senses": [
                {
                    "sense_id": "04ef5928-875a-3bbc-94a7-ebb4b7b8eb70",
                    "sense_definition": "Very large in size, quantity, or extent.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported a <w>prodigious</w> increase in profits this year.",
