                "senses": [
                    {
                        "sense_id": "587b4cf2-684e-3a21-ac73-14f198d415bb",
                        "entry_id": "7fec5ff4-5a98-303c-b719-74ae7e187ee2",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dbf0110-97b3-4f48-a569-7dd132416125",
                                "sense_id": "587b4cf2-684e-3a21-ac73-14f198d415bb",
                                "text": "Frau Spörle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "02d21285-9cb8-47ab-a640-bb0980810d55",
                                "sense_id": "587b4cf2-684e-3a21-ac73-14f198d415bb",
                                "text": "Herr Spörle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "430da9c4-5d81-438e-9864-f82aaed6b814",
                                "sense_id": "587b4cf2-684e-3a21-ac73-14f198d415bb",
                                "text": "Die Spörles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "59d9d4d8-0972-4dbe-ac55-736aa3b0ba10",
                                "sense_id": "587b4cf2-684e-3a21-ac73-14f198d415bb",
                                "text": "Der Spörle trägt nie die Schals, die die Spörle ihm strickt."
                            },
                            {
                                "example_id": "29e8f14d-c1f6-4c4e-b65d-f5b886cafd6d",
                                "sense_id": "587b4cf2-684e-3a21-ac73-14f198d415bb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Spörle kommt, geht der Herr Spörle.“"
                            },
                            {
                                "example_id": "aa7c97aa-93ee-421a-bf2f-01f542707420",
                                "sense_id": "587b4cf2-684e-3a21-ac73-14f198d415bb",
                                "text": "Spörle kommt und geht."
                            },
                            {
                                "example_id": "75e739d5-62eb-411b-9f35-0447aeedb040",
                                "sense_id": "587b4cf2-684e-3a21-ac73-14f198d415bb",
                                "text": "Spörles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
