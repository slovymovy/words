                "senses": [
                    {
                        "sense_id": "99ab7af6-900d-3179-a266-88ae2a058e78",
                        "entry_id": "3fe273ef-fe9d-3347-83df-bc4bb5dedce2",
                        "glosses": [
                            "der Patriot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0388a1e-33af-44db-8980-0771401aec41",
                                "sense_id": "99ab7af6-900d-3179-a266-88ae2a058e78",
                                "text": "Я истинный патриот России!",
                                "translation": "Ich bin ein richtiger Patriot Russlands."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "352aa434-bb5e-4c77-a1ce-7940a12df657",
                        "source_entry_id": "3fe273ef-fe9d-3347-83df-bc4bb5dedce2",
                        "source_sense_id": "99ab7af6-900d-3179-a266-88ae2a058e78",
                        "source_sense_description": "der Patriot",
                        "target_lang_word": "Patriot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Patriot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9639395-f31f-3534-b849-36aef718c48c",
                                        "entry_id": "ee5bf01e-822a-33e1-ae8a-db1e96e84d25",
                                        "glosses": [
                                            "eine Person, welche ihr Heimatland liebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb7a8dc1-a12b-4230-8b7c-1170c0aab1bf",
                                                "sense_id": "b9639395-f31f-3534-b849-36aef718c48c",
                                                "text": "„Dann sagt er in ziemlich ernstem Ton: ‚Ich liebe Schweden, ich bin ein richtiger Patriot.‘“"
                                            },
                                            {
                                                "example_id": "75bba92a-d15d-4eb0-bdc6-d5eb58e6340b",
                                                "sense_id": "b9639395-f31f-3534-b849-36aef718c48c",
                                                "text": "„Die Behauptung, er sei ein deutscher Patriot, traf Schefold wie ein Schlag.“"
                                            },
                                            {
                                                "example_id": "8365539f-865f-4023-98e0-09a0d51d45cf",
                                                "sense_id": "b9639395-f31f-3534-b849-36aef718c48c",
                                                "text": "„Er muss ein Patriot gewesen sein, denn er nutzte die Gelegenheit für seinen eigenen, privaten Widerstandskampf.“"
                                            },
                                            {
                                                "example_id": "4adf9645-78bf-4eb0-83a3-4731dcdca21b",
                                                "sense_id": "b9639395-f31f-3534-b849-36aef718c48c",
                                                "text": "„Er war, wie viele Juden im Deutschland Wilhelms II., ein glühender Patriot gewesen, als Antisemitismus noch als vulgär angesehen wurde und Juden in die Aristokratie aufsteigen konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
