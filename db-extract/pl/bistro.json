                        "target_lang_word": "Bistro",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bistro",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20ccd7ab-9d2f-3df2-ac42-77dadc944bcf",
                                        "entry_id": "2edfc85d-f467-3d55-bf40-b89ce04ead49",
                                        "glosses": [
                                            "kleines, meist einfach gehaltenes Lokal, in dem man Getränke und kleine Mahlzeiten bekommen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "563185e9-a565-4a49-9a91-61acfba455dc",
                                                "sense_id": "20ccd7ab-9d2f-3df2-ac42-77dadc944bcf",
                                                "text": "„In dem Bistro war alles ungewohnt und anders als sonst, denn es war eben französisch.“"
                                            },
                                            {
                                                "example_id": "b4b32b33-875e-421f-9d21-779f6f14de89",
                                                "sense_id": "20ccd7ab-9d2f-3df2-ac42-77dadc944bcf",
                                                "text": "„Offen war nur das Bistro neben dem dekorativen, nicht mehr benützten Eingangstor.“"
                                            },
                                            {
                                                "example_id": "09922415-c988-43cd-b618-8287e95fc69a",
                                                "sense_id": "20ccd7ab-9d2f-3df2-ac42-77dadc944bcf",
                                                "text": "„Keine zwanzig Minuten später sitzen wir vor einem Bistro und trinken starken Kaffee, blicken auf den Platz vor der Kirche.“"
                                            },
                                            {
                                                "example_id": "963b3216-cbf8-4ea5-9bd1-4cd53e96cd14",
                                                "sense_id": "20ccd7ab-9d2f-3df2-ac42-77dadc944bcf",
                                                "text": "„Er trat in ein Bistro und setzte sich an einen Marmortisch am Fenster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
