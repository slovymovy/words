                    "sense_id": "b2f4ddfe-d7b6-31fc-84b8-d5c0317abfe7",
                    "sense_definition": "osoba, która ratuje kogoś przed niebezpieczeństwem, zgubą lub trudną sytuacją",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dla zagubionych w górach turystów ratownik okazał się prawdziwym <w>zbawicielem</w>.",
                            "target_lang_translations": {
                                "en": "For the tourists lost in the mountains, the rescuer turned out to be a real <w>savior</w>."
                            }
                        },
                        {
                            "text": "Przyjaciel przyszedł z pomocą w ostatniej chwili i stał się moim <w>zbawicielem</w>.",
                            "target_lang_translations": {
                                "en": "A friend came to help at the last moment and became my <w>savior</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zbawca"
                    ],
                    "common_phrases": [
                        "prawdziwy zbawiciel",
                        "okazać się zbawicielem"
                    ],
                    "target_lang_definitions": {
                        "en": "a person who rescues someone from danger, ruin, or a difficult situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "savior",
                                "target_lang_sense_clarification": "person who rescues someone from danger or hardship (US)"
                            },
                            {
                                "target_lang_word": "saviour",
                                "target_lang_sense_clarification": "person who rescues someone from danger or hardship (UK)"
                            },
                            {
                                "target_lang_word": "rescuer",
                                "target_lang_sense_clarification": "person who saves someone from harm or distress"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e5a488fc-613a-320a-882a-7a6f97883a63",
                    "sense_definition": "w chrześcijaństwie: tytuł Jezusa Chrystusa jako tego, który odkupił ludzkość z grzechu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "Wierni zgromadzili się w świątyni, aby dziękować <w>Zbawicielowi</w> za łaskę.",
                            "target_lang_translations": {
                                "en": "The faithful gathered in the temple to thank the <w>Savior</w> for grace."
                            }
                        },
                        {
                            "text": "Wielu chrześcijan uważa Jezusa za jedynego <w>Zbawiciela</w> całego świata.",
                            "target_lang_translations": {
                                "en": "Many Christians consider Jesus to be the only <w>Savior</w> of the whole world."
                            }
                        }
                    ],
                    "synonyms": [
                        "Odkupiciel",
                        "Zbawca",
                        "Mesjasz",
                        "Chrystus",
                        "Jezus Chrystus",
                        "Pan Jezus"
                    ],
                    "common_phrases": [
                        "kościół Zbawiciela",
                        "narodzenie Zbawiciela"
                    ],
                    "target_lang_definitions": {
                        "en": "in Christianity: a title of Jesus Christ as the one who redeemed humanity from sin"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Savior",
                                "target_lang_sense_clarification": "Jesus Christ (US)"
                            },
