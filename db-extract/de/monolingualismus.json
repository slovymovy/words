                    {
                        "sense_id": "7e33cc22-7736-3357-a9b7-b61a13a70393",
                        "entry_id": "e5707ad2-424e-345a-a187-7579a582bee3",
                        "glosses": [
                            "Einsprachigkeit (einzelner Personen oder Personengruppen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "734a7cff-dacb-498a-a6f2-a82dce0b72a8",
                                "sense_id": "7e33cc22-7736-3357-a9b7-b61a13a70393",
                                "text": "Monolingualismus ist eine gesellschaftliche Tendenz in vielen Ländern."
                            },
                            {
                                "example_id": "ea86d288-c974-4dab-a6b9-f55dd7985c2c",
                                "sense_id": "7e33cc22-7736-3357-a9b7-b61a13a70393",
                                "text": "„Am nächsten Tag setzte der Direktor des Instituts für Deutsche Sprache, Ludwig M. Eichinger (Institut für Deutsche Sprache, Mannheim), mit seinem Vortrag zu »Deutsch als Wissenschaftssprache« die Tagung fort, wobei er nachhaltig betonte, dass ein simpler Monolingualismus nicht als ein funktionales Lösungsmodell erscheinen kann und darf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
