                            {
                                "example_id": "94f1b365-8a1b-4542-9e84-84a468930175",
                                "sense_id": "8f19517c-dc98-346d-af08-fb7c8e474075",
                                "text": "Sergiusz mówi, że zaprosił uroczą dziewczynę na kawę."
