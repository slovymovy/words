        "fr-extract.jsonl": [
            {
                "entry_id": "a6825178-72da-39ae-86d6-145029f90bfc",
                "word": "furtivement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                        "entry_id": "a6825178-72da-39ae-86d6-145029f90bfc",
                        "glosses": [
                            "D’une manière furtive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "692eb8d8-62bb-4d8d-b927-78f9f7e14852",
                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                "text": "La nouvelle d’une révolution en Macédoine lui fit prendre la résolution de sortir furtivement de Thèbes."
                            },
                            {
                                "example_id": "b7565387-46af-4624-aa75-7ca238963e33",
                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                "text": "Elles voudraient jouir furtivement du plaisir de vous aimer et d’être aimées sans que vous y prissiez garde."
                            },
                            {
                                "example_id": "041cf9b5-a879-4430-9878-1966e27dbd65",
                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                "text": "Anicet jette furtivement un poignard à ses pieds."
                            },
                            {
                                "example_id": "72ef434e-a18c-4248-a346-d65d4e37d790",
                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                "text": "Un coup d’œil caressant furtivement jeté."
                            },
                            {
                                "example_id": "3b202553-6f99-49a6-b585-c0d483eb27ed",
                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                "text": "Elle se savait belle et, lorsqu'elle était seule, il lui arrivait de tirer furtivement de sa poche un petit miroir pour s'y contempler."
                            },
                            {
                                "example_id": "83e0f385-4c0a-468a-aa7d-1e7ae28e0d9c",
                                "sense_id": "5818b91d-300a-3731-bf7f-405451382386",
                                "text": "Une petite pluie froide faisait furtivement briller la couverture d'un appentis et tinter sur le zinc, à de rares intervalles, de pesantes gouttes d'eau qui s'échappaient d'une chanlatte percée."
                            }
                        ]
                    },
                    {
                        "sense_id": "194bac91-05d8-387a-8854-9f45fc9ec72a",
                        "entry_id": "a6825178-72da-39ae-86d6-145029f90bfc",
                        "glosses": [
                            "D’une manière à échapper à la vigilance des radars des ennemis."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "a0268fd8-fccc-47a2-a094-61fc1c88a5f9",
                                "sense_id": "194bac91-05d8-387a-8854-9f45fc9ec72a",
                                "text": "Les éclaireurs volant furtivement ont pu photographier les installations nucléaires illicites."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04b40b95-c294-4768-a25f-0dabc3919dd5",
                        "source_entry_id": "a6825178-72da-39ae-86d6-145029f90bfc",
                        "target_lang_word": "unmerklich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unmerklich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "587b0740-cd63-3372-8956-0527aa9e546b",
                                        "entry_id": "0cef7038-e899-3a6a-a64b-9a2b5d03f07c",
                                        "glosses": [
                                            "nur schwer zu bemerken/zu spüren/wahrzunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1901c603-0e66-4b75-85bd-989bb368e5f0",
                                                "sense_id": "587b0740-cd63-3372-8956-0527aa9e546b",
                                                "text": "„Loveth Ekumabor wippt auf ihrem Stuhl fast unmerklich hin und her.“"
                                            },
                                            {
                                                "example_id": "56b9d97a-2e1a-4866-ac71-7ff7c79967ca",
                                                "sense_id": "587b0740-cd63-3372-8956-0527aa9e546b",
                                                "text": "[Der Dirigent] „Teodor Currentzis bewegt sachte, fast unmerklich die Hände.“"
                                            },
                                            {
                                                "example_id": "8288ff5a-e5c2-4326-ba0d-7da6a2470f1a",
                                                "sense_id": "587b0740-cd63-3372-8956-0527aa9e546b",
                                                "text": "„Während er halb singend, halb sprechend eine Sure aus dem Koran vorträgt, hält er die Augen geschlossen, wiegt fast unmerklich den Körper vor und zurück.“"
                                            },
                                            {
                                                "example_id": "67dbdb97-fa62-407d-9896-17f6b9b9ac24",
                                                "sense_id": "587b0740-cd63-3372-8956-0527aa9e546b",
                                                "text": "„Er beobachtete, dass das Pferd erst zu klopfen anfing, wenn sein Besitzer auf dessen Huf blickte. Es hörte wieder auf, wenn dieser seinen Kopf unmerklich hob und nach oben sah.“"
                                            },
                                            {
                                                "example_id": "4546e6b7-3393-4d98-95c2-d601388aab69",
                                                "sense_id": "587b0740-cd63-3372-8956-0527aa9e546b",
                                                "text": "„Während die Meeresspiegel fast unmerklich um etwa 3,4 Millimeter pro Jahr steigen, sind andere Klimakatastrophen weit aufälliger.“"
                                            },
                                            {
                                                "example_id": "71d23628-cbb3-445b-b9ea-b598e7870e95",
                                                "sense_id": "587b0740-cd63-3372-8956-0527aa9e546b",
                                                "text": "[In Sven Regeners Roman \"Herr Lehmann\" schildert dieser] „den Zusammenbruch der DDR als überraschendes, weil lange Zeit unmerkliches Ereignis, das dann, als es offenbar wurde, umso erschütternder war.“"
                                            },
                                            {
                                                "example_id": "95ab07f4-3bac-4ded-8d78-7db1de5530d2",
                                                "sense_id": "587b0740-cd63-3372-8956-0527aa9e546b",
                                                "text": "„Das Paar erzählt wie sich die Erschöpfungsdepression fast unmerklich über zehn Jahre im Familienleben breitmachen konnte.“"
                                            },
                                            {
                                                "example_id": "01191913-a552-4f50-b905-44ea155c2fa0",
                                                "sense_id": "587b0740-cd63-3372-8956-0527aa9e546b",
                                                "text": "[Malerei/Tempera:] „Bei Eitempera erfolgt der Farbauftrag durch „Stricheln“ und in mehreren Schichten. Das ist zeit- und arbeitsaufwendig, sanfte unmerkliche Farbübergänge sind schwer zu erzielen.“"
                                            },
                                            {
                                                "example_id": "c57062c7-5856-4324-9753-eda9958662a3",
                                                "sense_id": "587b0740-cd63-3372-8956-0527aa9e546b",
                                                "text": "[Einsamkeit trifft] „gerade viele ältere Menschen. »Sie schleicht sich unmerklich ins Leben ein und kann krank machen.«“"
                                            },
                                            {
                                                "example_id": "5ee3adb9-db3a-4a25-b537-9c382e2c3529",
                                                "sense_id": "587b0740-cd63-3372-8956-0527aa9e546b",
                                                "text": "[Quecksilberdämpfe:] „Sogar wenn man eine schleichende und daher nahezu unmerkliche Verschlechterung des eigenen allgemeinen Gesundheitszustands annimmt, kann eine versehentliche Selbstvergiftung aufgrund der hohen Sachkenntnis, die er als Arzt besaß, nicht vermutet werden und ist nahezu auszuschließen.“"
                                            },
                                            {
                                                "example_id": "258286e6-221e-4815-914c-a7e414f1a8ec",
                                                "sense_id": "587b0740-cd63-3372-8956-0527aa9e546b",
                                                "text": "„Die auffälligste Hochebene Osttimors ist das Fuiloro-Plateau in der Gemeinde Lautém. Richtung Süden fällt es, aufgrund seiner großen Fläche unmerklich, von einer Höhe von 700 m auf 500 m ab.“"
                                            },
                                            {
                                                "example_id": "345891ec-178d-4b64-a519-5e56e0fa2cab",
                                                "sense_id": "587b0740-cd63-3372-8956-0527aa9e546b",
                                                "text": "„Nun erlebt seine Figur Frank Bascombe die Folgen des Hurrikan Sandy. In «Frank» geht es vor allem um die leisen, fast unmerklichen Folgen der Katastrophe. Auch diese Folgen wiegen schwer.“"
                                            },
                                            {
                                                "example_id": "bceadafb-ab90-4efc-b2db-2b87b2ddce22",
                                                "sense_id": "587b0740-cd63-3372-8956-0527aa9e546b",
                                                "text": "[Wintersonnenwende:] „Aber auch, wenn dieser Tag extrem kurz ist und die darauffolgende Nacht sehr lang: Nur einen Tag danach werden die Tage schon wieder länger. Zunächst unmerklich - so richtig auffallen wird es dir aber nach den Weihnachtsferien: Dann ist es beim Aufstehen frühmorgens vor der Schule schon ein wenig heller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffdfb603-c37e-4bab-ae29-e53997b58e47",
