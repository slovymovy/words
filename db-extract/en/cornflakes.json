                        ]
                    },
                    {
                        "translation_id": "a6762343-92e5-422b-a650-dade534b41bd",
                        "source_entry_id": "9038416f-5345-3bf6-9c8d-d43d7e6fae77",
                        "source_sense_id": "a9ee9484-f3fd-3dab-94a3-50db17a6b982",
                        "source_sense_description": "breakfast cereal",
                        "target_lang_word": "хло́пья",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хло́пья",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f1a0f3dc-3d30-366a-b0c9-1e0d2cf1189c",
                                        "entry_id": "1e9f527c-b400-33cd-a543-321ee59b400e",
                                        "glosses": [
                                            "пушистые маленькие комочки, клочки чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1df6c96e-f4a6-4faa-bde6-30a2a894c0c1",
                                                "sense_id": "f1a0f3dc-3d30-366a-b0c9-1e0d2cf1189c",
                                                "text": "Чёрный дым и хлопья пепла повалили отовсюду…"
                                            },
                                            {
                                                "example_id": "419fa9da-0223-4c3b-8a7a-7668a97b14b1",
                                                "sense_id": "f1a0f3dc-3d30-366a-b0c9-1e0d2cf1189c",
                                                "text": "Только холодно будто бы Мите, в начале ноября, и снег валит крупными мокрыми хлопьями, а падая на землю, тотчас тает."
                                            },
                                            {
                                                "example_id": "5ff48b7e-edad-403a-87d2-979e1f80e194",
                                                "sense_id": "f1a0f3dc-3d30-366a-b0c9-1e0d2cf1189c",
                                                "text": "Если взглянуть вверх на эти потёмки, то весь чёрный фон был усыпан белыми движущимися точками: это шёл снег. Хлопья его, попав в свет, лениво кружились в воздухе, как пух, и ещё ленивее падали на землю."
                                            },
                                            {
                                                "example_id": "39556109-f59d-4a5e-a245-d45b74f7bf15",
                                                "sense_id": "f1a0f3dc-3d30-366a-b0c9-1e0d2cf1189c",
                                                "text": "Он пристально смотрел, как хлопья тихо пролетают мимо окна и ложатся на землю, покрывая пышной ватой следы людей."
                                            },
                                            {
                                                "example_id": "f440ab53-39ad-4235-8844-f970477b49e6",
                                                "sense_id": "f1a0f3dc-3d30-366a-b0c9-1e0d2cf1189c",
                                                "text": "Из-под ремней уздечки, из-под потника, с удил ― белая, хлопьями, пена…"
                                            },
                                            {
                                                "example_id": "583d436e-3743-44b6-b8fd-9c26dbc622eb",
                                                "sense_id": "f1a0f3dc-3d30-366a-b0c9-1e0d2cf1189c",
                                                "text": "Кукла важная, тряпичная, плотно набитая хлопьями из старого отцовского пальто…"
                                            },
                                            {
                                                "example_id": "ebd07e38-474f-4b88-8495-b5298c6ecd4f",
                                                "sense_id": "f1a0f3dc-3d30-366a-b0c9-1e0d2cf1189c",
                                                "text": "По горе, изрытой оврагами, белыми хлопьями рассыпались овечки."
                                            },
                                            {
                                                "example_id": "3a499ded-8edd-491d-a8d6-2d9581740395",
                                                "sense_id": "f1a0f3dc-3d30-366a-b0c9-1e0d2cf1189c",
                                                "text": "Гололобый солдат совал в рану хлопья ваты и отшвыривал их прочь, набухавшие и черневшие от крови."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2becf73-ce78-3e74-99c8-55c66a21b590",
                                        "entry_id": "1e9f527c-b400-33cd-a543-321ee59b400e",
                                        "glosses": [
                                            "хим. макроскопические частицы, образующиеся в жидкости в результате флокуляции и, как правило, отделяемые под действием силы тяжести или флотации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68b54327-bf03-4e4e-b8b7-3b66a2d68889",
                                                "sense_id": "d2becf73-ce78-3e74-99c8-55c66a21b590",
                                                "text": "Соль эта кристаллизовалась в мелких тонких малоблестящих белых иголочках, соединённых в хлопья."
                                            },
                                            {
                                                "example_id": "f4da3d87-4257-4f1d-999b-a0830f0804fe",
                                                "sense_id": "d2becf73-ce78-3e74-99c8-55c66a21b590",
                                                "text": "В воду добавляют сернокислый алюминий (в практике водоснабжения его так и называют коагулянтом). Он диссоциирует, катионы алюминия гидролизуются и образуют малорастворимую гидроокись алюминия. Её частицы быстро слипаются не только между собой, но и с частицами гумуса и других взвешенных веществ. Образуются крупные хлопья, которые, оседая, захватывают и увлекают с собой тончайшую взвесь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4b3e578-3e0c-3c8d-844d-1c1e59f8616d",
                                        "entry_id": "1e9f527c-b400-33cd-a543-321ee59b400e",
                                        "glosses": [
                                            "крупа, приготовленная расплющиванием, дроблением зёрен"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18e09651-ea63-443b-8cda-d20915cb4078",
                                                "sense_id": "a4b3e578-3e0c-3c8d-844d-1c1e59f8616d",
                                                "text": "На завтрак ему полагалась горсть кукурузных хлопьев с молоком."
                                            },
                                            {
                                                "example_id": "665b9de6-09f7-4b7f-a665-e886192fc3f4",
                                                "sense_id": "a4b3e578-3e0c-3c8d-844d-1c1e59f8616d",
                                                "text": "Покупай овсяные хлопья, а не «Геркулес», хотя он и овсянку, а не хлопья хорошо ест."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33e6f62c-36e8-3738-80a6-414c217c55e5",
                                        "entry_id": "1e9f527c-b400-33cd-a543-321ee59b400e",
                                        "glosses": [
                                            "крупные клочья чего-либо, производящие впечатления чего-либо мягкого и пушистого"
                                        ],
                                        "tags": [
                                            "о клубах дыма, тумана, облаков и т. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76862f2b-0ad5-4780-bf69-b9c5484adb53",
                                                "sense_id": "33e6f62c-36e8-3738-80a6-414c217c55e5",
                                                "text": "Ночное небо над городом было чёрное, и по небу таинственно неслись огромные белые хлопья облаков, как гигантские белые птицы."
                                            },
                                            {
                                                "example_id": "3fbe9c88-92e2-48e1-bb5a-fa5bfcee71d4",
                                                "sense_id": "33e6f62c-36e8-3738-80a6-414c217c55e5",
                                                "text": "Мелко изорванные облака тихо плыли по небу, между сизыми хлопьями катилась луна, золотя их мохнатые края."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92915466-1673-4e8e-981b-1c0cb7a081f5",
                        "source_entry_id": "9038416f-5345-3bf6-9c8d-d43d7e6fae77",
