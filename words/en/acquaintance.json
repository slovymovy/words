{
    "word_family": [
        "acquaint",
        "acquaintanceship",
        "unacquainted"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "08abc13d-b8c9-303c-bb0d-5c04ea76efda",
                    "sense_definition": "A person whom one knows slightly, but who is not a close friend.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is not a close friend, just a casual <w>acquaintance</w> from my yoga class.",
                            "target_lang_translations": {
                                "ru": "Она мне не близкая подруга, просто случайная <w>знакомая</w> по занятиям йогой."
                            }
                        },
                        {
                            "text": "He ran into an old <w>acquaintance</w> at the supermarket yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера в супермаркете он случайно встретил старого <w>знакомого</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "casual acquaintance",
                        "old acquaintance",
                        "mutual acquaintance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, которого знаешь не очень хорошо, не близкий друг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знакомый",
                                "target_lang_sense_clarification": "мужской род"
                            },
                            {
                                "target_lang_word": "знакомая",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fca0d120-0062-3830-9c53-3ff305d83612",
                    "sense_definition": "Knowledge or experience of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new manager has little <w>acquaintance</w> with our software systems.",
                            "target_lang_translations": {
                                "ru": "Новый менеджер плохо <w>знаком</w> с нашими программными системами."
                            }
                        },
                        {
                            "text": "My first-hand <w>acquaintance</w> with the culture helped me write the book.",
                            "target_lang_translations": {
                                "ru": "Моё непосредственное <w>знакомство</w> с этой культурой помогло мне написать книгу."
                            }
                        }
                    ],
                    "synonyms": [
                        "knowledge",
                        "familiarity"
                    ],
                    "common_phrases": [
                        "first-hand acquaintance",
                        "have some acquaintance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знание или опыт в какой-либо области, ознакомленность с чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знакомство",
                                "target_lang_sense_clarification": "с предметом, системой или областью знаний"
                            },
                            {
                                "target_lang_word": "ознакомление",
                                "target_lang_sense_clarification": "процесс получения знаний о чём-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee2d6858-d40d-3eee-b4af-adb577d7584d",
                    "sense_definition": "The state of being acquainted with someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our brief <w>acquaintance</w> began during a business trip last summer.",
                            "target_lang_translations": {
                                "ru": "Наше короткое <w>знакомство</w> началось во время командировки прошлым летом."
                            }
                        },
                        {
                            "text": "I made his <w>acquaintance</w> at the conference last week.",
                            "target_lang_translations": {
                                "ru": "Я свёл с ним <w>знакомство</w> на конференции на прошлой неделе."
                            }
                        }
                    ],
                    "synonyms": [
                        "familiarity"
                    ],
                    "common_phrases": [
                        "make someone's acquaintance",
                        "upon further acquaintance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отношения между людьми, знающими друг друга; сам факт или процесс завязывания таких отношений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знакомство",
                                "target_lang_sense_clarification": "отношения или факт установления связи между людьми"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd9e461d-0c7c-3a30-8c27-f563cbd47303",
                    "sense_definition": "A circle of people with whom one is acquainted.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a wide circle of <w>acquaintance</w> in the publishing industry.",
                            "target_lang_translations": {
                                "ru": "У неё широкий круг <w>знакомств</w> в издательском деле."
                            }
                        },
                        {
                            "text": "Most of his <w>acquaintance</w> attended the gallery opening.",
                            "target_lang_translations": {
                                "ru": "Большинство его <w>знакомых</w> присутствовали на открытии галереи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "circle of acquaintance",
                        "wide acquaintance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Круг людей, с которыми человек знаком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знакомые",
                                "target_lang_sense_clarification": "круг общения, люди, которых человек знает"
                            },
                            {
                                "target_lang_word": "круг знакомств",
                                "target_lang_sense_clarification": "совокупность всех знакомых людей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}