                                        "glosses": [
                                            "Maladie caractérisée par la forte présence dans les tissus d'une matière appelée substance amyloïde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7ba170d-327e-4674-b385-552a63d772ef",
                                                "sense_id": "21050d8f-bc71-359a-ae49-905b657049a4",
                                                "text": "Les amyloses sont un ensemble de maladies rares provoquées par l'accumulation de dépôts de protéines insolubles dans les tissus."
                                            },
                                            {
                                                "example_id": "182a2df8-77c9-450f-aaf1-d03a97006800",
                                                "sense_id": "21050d8f-bc71-359a-ae49-905b657049a4",
                                                "text": "Lorsqu'il s'agit d'une amylose plus diffuse, les fibrilles amyloïdes sont constituées de transthyrétine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
