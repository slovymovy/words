                                "target_senses": [
                                    {
                                        "sense_id": "b4792f10-d00d-3940-954a-0f02de9ab144",
                                        "entry_id": "bacbacb4-3b77-36c2-b0a7-b9ce10ea36dc",
                                        "glosses": [
                                            "To reject with contempt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8de7fd9-400c-4ff8-a5bd-fd6603cfde9c",
                                                "sense_id": "b4792f10-d00d-3940-954a-0f02de9ab144",
                                                "text": "to scout an idea or an apology"
                                            },
                                            {
                                                "example_id": "318c80db-cfa0-4cb8-b46d-4c9a26c943b9",
                                                "sense_id": "b4792f10-d00d-3940-954a-0f02de9ab144",
                                                "text": "Flout 'em and scout 'em; and scout 'em and flout 'em: / Thought is free."
                                            },
                                            {
                                                "example_id": "71c9e6c8-c8ad-4314-9c1b-6c2b22d75d92",
                                                "sense_id": "b4792f10-d00d-3940-954a-0f02de9ab144",
                                                "text": "I don't think I had any definite idea where Dora came from, or in what degree she was related to a higher order of beings; but I am quite sure I should have scouted the notion of her being simply human, like any other young lady, with indignation and contempt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f717771a-d96b-352d-bff4-00d387f11da8",
                                        "entry_id": "bacbacb4-3b77-36c2-b0a7-b9ce10ea36dc",
                                        "glosses": [
                                            "To reject the ideas or beliefs of (a person)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "404157cf-7a37-4b83-a7b4-5c70953d3872",
                                                "sense_id": "f717771a-d96b-352d-bff4-00d387f11da8",
                                                "text": "Two months ago I should have scouted as mad or drunk the man who had dared tell me the like."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0714579e-0dc9-31df-b086-299409de041c",
                                        "entry_id": "bacbacb4-3b77-36c2-b0a7-b9ce10ea36dc",
                                        "glosses": [
                                            "To scoff."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "774c22f3-cc8f-49a4-902a-2e64748494fa",
                                                "sense_id": "0714579e-0dc9-31df-b086-299409de041c",
                                                "text": "So ignorant are most landsmen of some of the plainest and most palpable wonders of the world, that without some hints touching the plain facts, historical and otherwise, of the fishery, they might scout at Moby Dick as a monstrous fable, or still worse and more detestable, a hideous and intolerable allegory."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67eaa18b-37ec-3545-9568-db784e57c3e9",
                                        "entry_id": "c95599d3-7f54-3ef4-ade7-35d4864c0852",
                                        "glosses": [
                                            "A person sent out to gain and bring in tidings; especially, one employed in war to gain information about the enemy and ground."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25875b23-a291-3dcf-820d-0de11c470d3d",
                                        "entry_id": "c95599d3-7f54-3ef4-ade7-35d4864c0852",
                                        "glosses": [
                                            "An act of scouting or reconnoitering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "226a8d79-36b7-4007-b295-78100d9dc033",
                                                "sense_id": "25875b23-a291-3dcf-820d-0de11c470d3d",
                                                "text": "while the rat is on the scout"
                                            },
                                            {
                                                "example_id": "885b8ba0-574e-40e7-93b4-dff96d4a5914",
                                                "sense_id": "25875b23-a291-3dcf-820d-0de11c470d3d",
                                                "text": "May 6, 1883 […] This camp, the finest on this scout, has not so much running water as some of the others; […] May 7, 1883 […] Colonel Aguerre was going today or tomorrow with four hundred regular troops for a scout in the Sierra Madre […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2038acf6-be3c-37cd-b7df-709059d1376d",
                                        "entry_id": "c95599d3-7f54-3ef4-ade7-35d4864c0852",
                                        "glosses": [
                                            "A member of any number of youth organizations belonging to the international scout movement, such as the Boy Scouts of America or Girl Scouts of the United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9caeefa-7f9d-34cc-91b0-2a9bee6d1e80",
                                        "entry_id": "c95599d3-7f54-3ef4-ade7-35d4864c0852",
                                        "glosses": [
                                            "A person who assesses or recruits others; especially, one who identifies promising talent on behalf of a sports team."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d8ed9b3-17fa-43ee-b48d-7925769d27df",
                                                "sense_id": "e9caeefa-7f9d-34cc-91b0-2a9bee6d1e80",
                                                "text": "We have met twice this year and, during our first interview, Mata spoke evocatively when remembering how, having joined Real Oviedo aged 10 in 1998, he was given a previously unimaginable opportunity. Mata sat in a car park in 2003, when he was 14, and watched his father talking to a Real Madrid scout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d168c55-46b9-3e63-96a9-aef63b58b308",
                                        "entry_id": "c95599d3-7f54-3ef4-ade7-35d4864c0852",
                                        "glosses": [
                                            "A person employed to monitor rivals' activities in the petroleum industry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c670caf-3ebe-3320-92f5-ce06358ebc2e",
                                        "entry_id": "c95599d3-7f54-3ef4-ade7-35d4864c0852",
                                        "glosses": [
                                            "A housekeeper or domestic cleaner, generally female, employed by one of the constituent colleges of Oxford University to clean rooms; generally equivalent to a modern bedder at Cambridge University."
                                        ],
                                        "tags": [
                                            "modern"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46a52b49-705b-3a2a-820a-8888e6e0ea8d",
                                        "entry_id": "c95599d3-7f54-3ef4-ade7-35d4864c0852",
                                        "glosses": [
                                            "A domestic servant, generally male, who would attend (usually several) students in a variety of ways, including cleaning; generally equivalent to a gyp at Cambridge University or a skip at Trinity College, Dublin."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86a599f2-a1d1-4eb5-984e-b7558d6c90d5",
                                                "sense_id": "46a52b49-705b-3a2a-820a-8888e6e0ea8d",
                                                "text": "He has also been good enough to recommend to me many tradesmen who are ready to supply these articles in any quantities; each of whom has been here already a dozen times, cap in hand, and vowing that it is quite immaterial when I pay—which is very kind of them; but, with the highest respect for friend Perkins (my scout) and his obliging friends, I shall make some enquiries before \"letting in\" with any of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f301ec3-9b0e-30cb-acd1-59eb5c4a8724",
                                        "entry_id": "c95599d3-7f54-3ef4-ade7-35d4864c0852",
                                        "glosses": [
                                            "A fielder in a game for practice."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40991e01-e4a8-3bfc-96e5-e328244b601b",
                                        "entry_id": "c95599d3-7f54-3ef4-ade7-35d4864c0852",
                                        "glosses": [
                                            "A fighter aircraft."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abead625-474a-32fd-b9db-7c720c2bbf80",
                                        "entry_id": "c95599d3-7f54-3ef4-ade7-35d4864c0852",
                                        "glosses": [
                                            "A preliminary image that allows the technician to make adjustments before the actual diagnostic images."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fb3124e-ddfe-440b-99e3-796e508ada59",
                                                "sense_id": "abead625-474a-32fd-b9db-7c720c2bbf80",
                                                "text": "A scout topogram is initially performed during continuous table motion, generating an anatomic overview image similar to a conventional radiograph at the locked projection."
                                            },
                                            {
                                                "example_id": "e42ef242-4ba4-40da-bc8c-cb10bbf05233",
                                                "sense_id": "abead625-474a-32fd-b9db-7c720c2bbf80",
                                                "text": "It consisted of injecting an iodinated contrast agent while a breast was compressed in one projection after a scout film, taking several sequential films, and subtracting them from the scout film."
                                            },
                                            {
                                                "example_id": "563329b6-3a16-4256-8462-8728d03c130a",
                                                "sense_id": "abead625-474a-32fd-b9db-7c720c2bbf80",
                                                "text": "Because of this FOV limitation, several institutions use a weight cutoff or a scout radiograph lateral diameter cutoff, though the exact cutoff threshold varies from institution to institution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ff3b0ef-6d26-3d70-90f6-96489ea7c387",
                                        "entry_id": "c95599d3-7f54-3ef4-ade7-35d4864c0852",
                                        "glosses": [
                                            "A term of address for a man or boy."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20f25385-d49f-47b8-ac00-ec1bfba91ca2",
                                                "sense_id": "1ff3b0ef-6d26-3d70-90f6-96489ea7c387",
                                                "text": "\"Listen, old scout,\" Mr. Osborn said solemnly, \"you think New York is heartless, but that's not what it is.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
