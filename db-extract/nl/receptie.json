                        "source_entry_id": "3b6622d3-d212-3d91-9767-751bf5927210",
                        "source_sense_id": "05412720-e2cc-38b3-b884-de31d65b16ce",
                        "source_sense_description": "een plaats waar iemand binnenkomende gasten of klanten ontvangt",
                        "target_lang_word": "réception",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réception",
