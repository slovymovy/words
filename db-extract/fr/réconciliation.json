                ],
                "translations": [
                    {
                        "translation_id": "bbdbe028-5269-4ca4-aa6a-09b3fad773e9",
                        "source_entry_id": "87527ee8-6137-3584-9eb3-0cdcd3286219",
                        "target_lang_word": "Versöhnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versöhnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e12fe8cc-d89b-3abf-90d4-b1766631b5bf",
                                        "entry_id": "3d526b6b-ab3b-327f-aa15-78e588dca14a",
                                        "glosses": [
                                            "Wendung zwischen Personen zu einer mehrseitigen, positiven und dauerhaften Grundhaltung des gegenseitigen Vertrauens, der Bereitschaft zueinander zu stehen und/oder miteinander die Zukunft zu gestalten, die sich zuvor Verletzungen bzw. Schäden antaten und infolge ablehnend oder feindlich zueinander standen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5baeb35-db01-4458-ab38-dd2cea8de307",
                                                "sense_id": "e12fe8cc-d89b-3abf-90d4-b1766631b5bf",
                                                "text": "Der Versuch, zu einer Versöhnung zu kommen, scheiterte kläglich."
                                            },
                                            {
                                                "example_id": "f431c0eb-5b21-449d-bf9f-75569ecd1272",
                                                "sense_id": "e12fe8cc-d89b-3abf-90d4-b1766631b5bf",
                                                "text": "„Für die Sufis war der Gedanke einer Versöhnung des Islam mit dem Hinduismus nichts Neues.“"
                                            },
                                            {
                                                "example_id": "a2f15cc8-dbbd-41a8-9dc6-3ea6bce0082e",
                                                "sense_id": "e12fe8cc-d89b-3abf-90d4-b1766631b5bf",
                                                "text": "„In diesem Hange nach Versöhnung stand er aber nicht allein da, sondern begegnete sich darin mit Frau von Carayon.“"
                                            },
                                            {
                                                "example_id": "c9fa114c-4618-49f5-9e1d-1464bf74f05d",
                                                "sense_id": "e12fe8cc-d89b-3abf-90d4-b1766631b5bf",
                                                "text": "„Sie rieten mir alle eine rasche Versöhnung an.“"
                                            },
                                            {
                                                "example_id": "6a0e1174-cb7e-4bec-9121-0abdeaf9fb87",
                                                "sense_id": "e12fe8cc-d89b-3abf-90d4-b1766631b5bf",
                                                "text": "„Die nächste Sorge der Marquise war nun, ihre Mutter zu einer Versöhnung mit dem Schwiegersohn zu bestimmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "680e7a15-268e-307a-95a6-292baf3f05fa",
                                        "entry_id": "3d526b6b-ab3b-327f-aa15-78e588dca14a",
                                        "glosses": [
                                            "Vermittlung, die am Ende der Dialektik die Widersprüche in einer Synthese aufhebt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "319a49c0-5228-3bc8-afd7-3f7f547b4915",
                                        "entry_id": "3d526b6b-ab3b-327f-aa15-78e588dca14a",
                                        "glosses": [
                                            "[1] als Bestandteil der Vergangenheits- und/oder Konfliktbewältigung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ec1d954-4488-4c15-99cc-ad6358d916de",
                        "source_entry_id": "87527ee8-6137-3584-9eb3-0cdcd3286219",
