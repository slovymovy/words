                "senses": [
                    {
                        "sense_id": "383bb259-e24c-3f6d-8c82-b2ace713894c",
                        "entry_id": "c2e57d18-ebd2-351b-b83f-707afcac0020",
                        "glosses": [
                            "ein meterhoher Kreuzblütler mit goldgelben Doldenrispen aus Süd- und Osteuropa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f06d91d6-d7fb-45e9-a28b-e1faa0625f39",
                                "sense_id": "383bb259-e24c-3f6d-8c82-b2ace713894c",
                                "text": "„Der Waid wurde früher in Deutschland wegen seiner Blätter, mit denen man Grün- und Blaufärbungen herstellen kann, angebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "462e8ae7-e447-4ec1-bb80-fe6acdddf0b3",
                        "source_entry_id": "c2e57d18-ebd2-351b-b83f-707afcac0020",
                        "source_sense_id": "383bb259-e24c-3f6d-8c82-b2ace713894c",
                        "source_sense_description": "Botanik: ein meterhoher Kreuzblütler mit goldgelben Doldenrispen aus Süd- und Osteuropa",
                        "target_lang_word": "woad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "woad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8315899-3755-3f67-806a-3cc6437be07f",
                                        "entry_id": "705e8ae4-fd9a-37d2-bebc-d8ea10c0ffce",
                                        "glosses": [
                                            "The plant Isatis tinctoria."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dc7b752-17f9-49ff-90cc-17b22ead1bd4",
                                                "sense_id": "b8315899-3755-3f67-806a-3cc6437be07f",
                                                "text": "Woad is one of those plants which yield the deep blue colouring matter so greatly valued in the arts — Indigo."
                                            },
                                            {
                                                "example_id": "24d299e3-94d6-4172-b5d2-87047de2760a",
                                                "sense_id": "b8315899-3755-3f67-806a-3cc6437be07f",
                                                "text": "Woad was then placed on the regular shopping list of alternative crops."
                                            },
                                            {
                                                "example_id": "b8aa4dbd-c39c-4e3f-867d-c09a565ddcdd",
                                                "sense_id": "b8315899-3755-3f67-806a-3cc6437be07f",
                                                "text": "The cultivation of woad had taken hold in southern England during the early 1580s, but this dispute provides the earliest evidence of its cultivation in the fields around Tewkesbury."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbcbfcd9-531b-30d3-9b30-06ac25f6a926",
                                        "entry_id": "705e8ae4-fd9a-37d2-bebc-d8ea10c0ffce",
                                        "glosses": [
                                            "The blue vat dye made from the leaves of the plant through partial drying and fermentation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "253df8af-4b99-45a7-a0ce-b3c218b014be",
                                                "sense_id": "dbcbfcd9-531b-30d3-9b30-06ac25f6a926",
                                                "text": "To prevent this, it was enacted, that no wines of Gaſcony and Guienne, or woads of Tholouſe, should be imported into England, except in ships belonging to the King, or some of his ſubjects; and that all ſuch wines and woads imported in foreign bottoms ſhould be forfeited."
                                            },
                                            {
                                                "example_id": "b5b62ed9-2361-4369-86fa-7e186837a586",
                                                "sense_id": "dbcbfcd9-531b-30d3-9b30-06ac25f6a926",
                                                "text": "But in the middle of the sixteenth century indigo was introduced from the East Indies: and in the seventeenth century its use became extended, and supplanted that of woad."
                                            },
                                            {
                                                "example_id": "f4d429a9-cfcb-41fc-b5fa-d2271bbb6d8e",
                                                "sense_id": "dbcbfcd9-531b-30d3-9b30-06ac25f6a926",
                                                "text": "Huge quanitities of alum and woad were disembarked each year at Southampton."
                                            },
                                            {
                                                "example_id": "fdba90e1-796c-4a63-beb2-d0451e38c4ae",
                                                "sense_id": "dbcbfcd9-531b-30d3-9b30-06ac25f6a926",
                                                "text": "For example, woad, a blue dye obtained from the plant Isatis tinctoria, was used throughout the Mediterannean and Europe and is often identified as indigo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "woad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a646fea-197d-33ba-b906-17517fa7cccb",
                                        "entry_id": "6bc3a2ac-fce5-3f44-aa5a-c3e990a26786",
                                        "glosses": [
                                            "To plant or cultivate woad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30a9500b-0ce1-49b3-8730-9c300b25cb5a",
                                                "sense_id": "4a646fea-197d-33ba-b906-17517fa7cccb",
                                                "text": "Now as the tenants after woading, pay the ſame rent as before, one cannot wonder at landlords making use of such an easy method to raise money: but it is the tenants that quarrel most at it; they assert the land to be 7 sg. an acre the worse for it; here then lies the enquiry."
                                            },
                                            {
                                                "example_id": "b588ce2d-9753-4dd4-adad-162dc5986298",
                                                "sense_id": "4a646fea-197d-33ba-b906-17517fa7cccb",
                                                "text": "Such land was usually woaded for two, three or four years and then corned,[…]."
                                            },
                                            {
                                                "example_id": "dfb79423-122c-40fc-87b5-2da3ddce4884",
                                                "sense_id": "4a646fea-197d-33ba-b906-17517fa7cccb",
                                                "text": "He planted woad on it, and engaged a person from the north to manage it; and the produce was so abundant as to afford immense profit. I believe he only woaded two years, and then let it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bbecaa1-2d21-30a0-b178-bd10d04e7503",
                                        "entry_id": "6bc3a2ac-fce5-3f44-aa5a-c3e990a26786",
                                        "glosses": [
                                            "To dye with woad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b47b27f0-adf0-483a-b79b-efa6eb280619",
                                                "sense_id": "8bbecaa1-2d21-30a0-b178-bd10d04e7503",
                                                "text": "All woollen goods truly mathered, ſhall be marked with a red roſe, and a blue roſe, and all ſuch truly woaded throughout, with a blue roſe only; and if any perſon shall affix any ſuch mark falsely, he ſhall forfeit, for every piece ſo marked 4l. (ſee under)."
                                            },
                                            {
                                                "example_id": "da9483e0-ef78-4431-a451-3788ea94cf83",
                                                "sense_id": "8bbecaa1-2d21-30a0-b178-bd10d04e7503",
                                                "text": "Againſt a dyer for woading his cloth only to the third ſtall (whereas the custom of dyers was to woad it to the fourth ſtall) and then marking it with the company's seal as if it had been woaded to the fourth ſtall; he was found guilty of woading it only to the third ſtall, and not of ſetting ſuch mark to it, for which reaſon the court was of opinion no judgement ought to be againſt the defendant."
                                            },
                                            {
                                                "example_id": "ca74a012-8ad9-49e1-8b9d-7446103e28b8",
                                                "sense_id": "8bbecaa1-2d21-30a0-b178-bd10d04e7503",
                                                "text": "This wool, when scowered, weighed 50 lbs.; when woaded blue, and picked, 48 lbs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
