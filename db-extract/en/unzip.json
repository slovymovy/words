                                        "entry_id": "e7b9bae4-5d3e-3ab2-af04-06324c436a01",
                                        "glosses": [
                                            "Rendre à un fichier sa structure initiale, entretemps réduite par compression pour en optimiser le stockage ou la transmission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd982ad1-4c0e-4c41-99c7-8fff59df7837",
                                                "sense_id": "60d05da3-0daf-34f3-bdb2-e92d79ea0c78",
                                                "text": "Vous venez de recevoir un document zippé, il vous suffit de double-cliquer sur celui-ci pour en extraire les fichiers : le progiciel décompresse automatiquement vos fichiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28111ea5-e132-3ae6-9e1d-de4583acaafe",
                                        "entry_id": "e7b9bae4-5d3e-3ab2-af04-06324c436a01",
                                        "glosses": [
                                            "Se relaxer."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c634940d-a021-44af-be5d-7de986df821e",
                                                "sense_id": "28111ea5-e132-3ae6-9e1d-de4583acaafe",
                                                "text": "J’ai besoin de décompresser après cette semaine de travail intense."
                                            },
                                            {
                                                "example_id": "f33419ca-0dbe-48c2-9d77-6b605c0f6fc1",
                                                "sense_id": "28111ea5-e132-3ae6-9e1d-de4583acaafe",
                                                "text": "Quand sa respiration se fut ralentie, il s’appuya contre le tronc et apprécia de décompresser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
