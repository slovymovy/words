                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4009e7c9-9335-424e-8726-5e1adfdec932",
                                "sense_id": "3426e26d-06d0-366d-b4ad-592b9447486a",
                                "text": "Po tej gruntownej przebudowie i modernizacji, łańcucki zespół pałacowo-parkowy stał się jedną z najbardziej luksusowych rezydencji w Europie kontynentalnej"
                            },
                            {
                                "example_id": "52742ba4-62b8-4bfa-acc7-6b11c2736ccb",
                                "sense_id": "3426e26d-06d0-366d-b4ad-592b9447486a",
                                "text": "Został zapamiętany jako awanturnik i sławny warchoł, nazwany „Diabłem Łańcuckim”"
                            }
                        ],
