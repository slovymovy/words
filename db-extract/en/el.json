                                "target_senses": [
                                    {
                                        "sense_id": "2be6674d-0307-3a81-840a-37862af9037a",
                                        "entry_id": "f0a746f3-2ec5-3619-95e2-f73754a281ea",
                                        "glosses": [
                                            "Pronom clitique de la troisième personne du singulier féminin sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "716cd709-4eec-4e2b-b3b5-13b908b18f11",
                                                "sense_id": "2be6674d-0307-3a81-840a-37862af9037a",
                                                "text": "Elle était demeurée longtemps debout devant ces hautes coques dont les hublots laissaient voir l’intérieur des cabines éclairées."
                                            },
                                            {
                                                "example_id": "7d72cbb7-6fbd-4798-a7a1-01c01bfdc452",
                                                "sense_id": "2be6674d-0307-3a81-840a-37862af9037a",
                                                "text": "Rosebud se cherche toujours. Elle ne sait pas exactement ce qu’elle veut, mais elle sait très bien ce qu’elle refuse : retourner à Aix et devenir la parfaite épouse d’un pinardier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "elle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16b35b74-465e-3f5e-9e28-627bdc6cfc0d",
                                        "entry_id": "6c5d3878-e486-31d3-a06f-eb29fbd74d68",
                                        "glosses": [
                                            "Pronom tonique de la troisième personne du singulier féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8c0c4c9-a66c-4ec2-9700-7b5dcadfd71a",
                                                "sense_id": "16b35b74-465e-3f5e-9e28-627bdc6cfc0d",
                                                "text": "Une prise de becs dénoterait entre Thomas et elle une intimité qu’elle ne tient pas à faire réexister face à cet homme."
                                            },
                                            {
                                                "example_id": "61c4dc9e-1872-40a9-9ce2-935fec21acf0",
                                                "sense_id": "16b35b74-465e-3f5e-9e28-627bdc6cfc0d",
                                                "text": "Quand il pousse la porte du Café du Pont, à Vrigne-aux-Bois, la tante est derrière le comptoir. Le café est à elle. C’est elle qui a fait dire qu’il n’avait qu’à venir."
                                            },
                                            {
                                                "example_id": "bfff6054-6c53-472e-8051-2c932dba902a",
                                                "sense_id": "16b35b74-465e-3f5e-9e28-627bdc6cfc0d",
                                                "text": "Se diriger vers elle."
                                            },
                                            {
                                                "example_id": "a4f64200-f299-4d0b-84df-ddb056f93b35",
                                                "sense_id": "16b35b74-465e-3f5e-9e28-627bdc6cfc0d",
                                                "text": "Elle, elle aurait osé dire cela !"
                                            },
                                            {
                                                "example_id": "d20bb189-dc23-4b1f-949d-8c62a4b65266",
                                                "sense_id": "16b35b74-465e-3f5e-9e28-627bdc6cfc0d",
                                                "text": "Je le lui dirai à elle."
                                            },
                                            {
                                                "example_id": "da1e145d-a71b-4fc6-8b04-c11a4740b84f",
                                                "sense_id": "16b35b74-465e-3f5e-9e28-627bdc6cfc0d",
                                                "text": "Je veux la voir, elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52044b31-200c-3004-87a5-4e625ce8588f",
                                        "entry_id": "6c5d3878-e486-31d3-a06f-eb29fbd74d68",
                                        "glosses": [
                                            "Quant à elle, par contre."
                                        ],
                                        "tags": [
                                            "Après un sujet féminin singulier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc86149d-402e-46c6-96bc-5e62ba7a4144",
                                                "sense_id": "52044b31-200c-3004-87a5-4e625ce8588f",
                                                "text": "L’Angleterre, elle, a, au début, fait bon accueil à cette proposition : puis nous avons vu peu à peu apparaître dans l’opinion publique anglaise une certaine gêne qui s explique si on écoute la réponse du Japon. Le Japon, lui, a été tout de suite d’une extrême nervosité. Nous avons su presque immédiatement que M. le Président Hara, chef du gouvernement japonais, no s’y rendrait pas lui-même, puis, dans les déclarations du Japon, les réticences se sont multipliées."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "elle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11c76c34-b59f-3360-9ab0-67c7925b8eab",
                                        "entry_id": "33e53803-a156-3197-8ef9-193c87c81ff9",
                                        "glosses": [
                                            "Lettre latine L, l."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "895f2002-1fb7-429c-a426-0dd925e6469b",
                                                "sense_id": "11c76c34-b59f-3360-9ab0-67c7925b8eab",
                                                "text": "Avec un elle et pas un emme. Parce que la mangouste-mayonnaise ça n'existe pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
