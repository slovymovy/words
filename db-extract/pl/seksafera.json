                    },
                    {
                        "translation_id": "bf22ab4b-c5c1-4325-95a6-c267f1574693",
                        "source_entry_id": "f56d76ff-a84d-3d13-a987-c097761c7437",
                        "source_sense_id": "466a4685-1c9f-3452-81e8-1115b09d4bf8",
                        "target_lang_word": "scandal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scandal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bed92e40-b3d7-3e8b-b015-54de65637566",
                                        "entry_id": "282e517e-2987-3f75-8c65-2606e348ea30",
                                        "glosses": [
                                            "An incident or event that disgraces or damages the reputation of the persons or organization involved."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "274ba692-01de-4470-b257-ba39a53d74de",
                                                "sense_id": "bed92e40-b3d7-3e8b-b015-54de65637566",
                                                "text": "Their affair was reported as a scandal by most tabloids."
                                            },
                                            {
                                                "example_id": "8cf00712-04b3-435b-bc2a-6b33c5e56577",
                                                "sense_id": "bed92e40-b3d7-3e8b-b015-54de65637566",
                                                "text": "O, what a scandal is it to our crown,\nThat two such noble peers as ye should jar!"
                                            },
                                            {
                                                "example_id": "845c00c4-2b7b-4728-ba42-4f81acb6c7a4",
                                                "sense_id": "bed92e40-b3d7-3e8b-b015-54de65637566",
                                                "text": "It would not be fair to record the adventures of Father Brown, without admitting that he was once involved in a grave scandal."
                                            },
                                            {
                                                "example_id": "7ca07f09-7446-4272-8381-acb838acf817",
                                                "sense_id": "bed92e40-b3d7-3e8b-b015-54de65637566",
                                                "text": "Well, yes, a couple of leaks are all very well, but it takes more than that... A big scandal perhaps. A political scandal. Or a scandal about something people really understand: Sex... or money."
                                            },
                                            {
                                                "example_id": "64c1dcd4-05f4-4803-b1e0-0db7dd91ad3d",
                                                "sense_id": "bed92e40-b3d7-3e8b-b015-54de65637566",
                                                "text": "But electric vehicles and the batteries that made them run became ensnared in corporate scandals, fraud, and monopolistic corruption that shook the confidence of the nation and inspired automotive upstarts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b20a9f3e-5e22-3ca1-9f62-884ddb9d49ce",
                                        "entry_id": "282e517e-2987-3f75-8c65-2606e348ea30",
                                        "glosses": [
                                            "Damage to one's reputation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30874845-4468-4ac5-aaf6-3a0e7a0b5426",
                                                "sense_id": "b20a9f3e-5e22-3ca1-9f62-884ddb9d49ce",
                                                "text": "The incident brought considerable scandal to his family."
                                            },
                                            {
                                                "example_id": "f157e648-d86d-48e6-b9cb-f5c3cfe1b53b",
                                                "sense_id": "b20a9f3e-5e22-3ca1-9f62-884ddb9d49ce",
                                                "text": "Such a scandal as the prosecution of a brother for forgery—with a verdict of guilty—is a most truly horrible, deplorable, fatal thing. It takes the respectability out of a family perhaps at a critical moment, when the family is just assuming the robes of respectability:[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53ebebfd-b32e-3d0a-8d00-b14970f096db",
                                        "entry_id": "282e517e-2987-3f75-8c65-2606e348ea30",
                                        "glosses": [
                                            "Widespread moral outrage, indignation, as over an offence to decency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09724c20-3fa7-4e60-ae88-791046a1bfad",
                                                "sense_id": "53ebebfd-b32e-3d0a-8d00-b14970f096db",
                                                "text": "When their behaviour was made public it caused a great scandal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f74f151b-7c8d-31c2-8df1-b544f2f7c7a1",
                                        "entry_id": "282e517e-2987-3f75-8c65-2606e348ea30",
                                        "glosses": [
                                            "A word or deed, lacking in rectitude in some manner, which is an occasion of the spiritual ruin of another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e9833eb-9300-3364-9f95-e79dd5cf0bdd",
                                        "entry_id": "282e517e-2987-3f75-8c65-2606e348ea30",
                                        "glosses": [
                                            "Defamatory talk; gossip, slander."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "003be142-8906-4127-a914-00fcda7ab9ce",
                                                "sense_id": "9e9833eb-9300-3364-9f95-e79dd5cf0bdd",
                                                "text": "According to village scandal, they weren't even married."
                                            },
                                            {
                                                "example_id": "b763f554-49e1-4c30-bf31-3e3dda321383",
                                                "sense_id": "9e9833eb-9300-3364-9f95-e79dd5cf0bdd",
                                                "text": "Scandal at Barchester affirmed that had it not been for the beauty of his daughter, Mr. Harding would have remained a minor canon; but here probably Scandal lied, as she so often does; for even as a minor canon no one had been more popular among his reverend brethren in the close, than Mr. Harding; and Scandal, before she had reprobated Mr. Harding for being made precentor by his friend the bishop, had loudly blamed the bishop for having so long omitted to do something for his friend Mr. Harding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "163c547f-4c1c-36aa-9459-c3e2dbabaa97",
                                        "entry_id": "282e517e-2987-3f75-8c65-2606e348ea30",
                                        "glosses": [
                                            "amateur or homemade pornography; (informal) commotion."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "scandal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8f613fb-0435-34e6-93ac-fe2812f9ff83",
                                        "entry_id": "1a8ac212-a629-3bc9-bc83-0daa529a9600",
                                        "glosses": [
                                            "To defame; to slander."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd3c7214-31bd-4f7f-9384-f918ed9babb8",
                                                "sense_id": "e8f613fb-0435-34e6-93ac-fe2812f9ff83",
                                                "text": "I do fawn on men and hug them hard\n And after scandal them."
