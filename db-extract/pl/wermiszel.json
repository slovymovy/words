                                "target_senses": [
                                    {
                                        "sense_id": "5f12591a-7acf-3215-b8dd-bdcb6b31bb39",
                                        "entry_id": "70e25dfe-f68a-3c2b-b941-426e78892388",
                                        "glosses": [
                                            "Sorte de pâte passée à la filière, mince et longue, que l’on met dans le potage, ou qui sert à confectionner des plats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceff644d-1cd0-43de-8ef2-5f83108c2b6f",
                                                "sense_id": "5f12591a-7acf-3215-b8dd-bdcb6b31bb39",
                                                "text": "Quand il déjeunait avec nous\nIl dévorait d’un coup\nSa soup’ au vermicelle"
                                            }
                                        ]
