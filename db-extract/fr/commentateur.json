                    {
                        "translation_id": "4d7ec43d-1fc3-4c4e-9c88-1ff659db103f",
                        "source_entry_id": "8ef955c4-15fb-3f58-853d-157a7df91183",
                        "source_sense_id": "a3b4c0db-73ad-3008-a77a-49400122ea2b",
