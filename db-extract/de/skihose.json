                "senses": [
                    {
                        "sense_id": "e8ae2c0e-ec0a-3f6d-bfcd-e447905a1406",
                        "entry_id": "d5c29fe1-cbd4-3187-b0de-5e0f8b520343",
                        "glosses": [
                            "Hose, die beim Skilaufen getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c84a20a2-ef9b-45b3-93d2-9579c7552f91",
                                "sense_id": "e8ae2c0e-ec0a-3f6d-bfcd-e447905a1406",
                                "text": "„Da man mich vom vorsätzlichen Verderben nicht abbringen kann, bekomme ich immerhin Handfestes: eine Windbluse und eine Skihose aus Vorkriegszeiten, festes Schuhwerk, einen Rucksack samt nahrhafter Füllung.“"
                            },
                            {
                                "example_id": "d964ad24-2abb-40da-b9ea-d137f8469ea2",
                                "sense_id": "e8ae2c0e-ec0a-3f6d-bfcd-e447905a1406",
                                "text": "„Das bestätigte sich, als Ari die Lobby des Hotels betrat, wo sich die Leute tummelten, teils schon in Skihosen, bereit für die Piste, teils noch beim Einchecken mit kompletter Skiausrüstung im Schlepptau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
