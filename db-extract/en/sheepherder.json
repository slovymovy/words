                        "target_lang_word": "schaapsherder",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schaapsherder",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2a6dd559-f245-3e1f-a174-ff3ef04d1ae0",
                                        "entry_id": "f739152f-700a-3a2f-8e61-c48fa7302c97",
                                        "glosses": [
                                            "hoeder van schapen"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59cb9d5e-8875-4c72-8e99-44aa44e41c09",
                                                "sense_id": "2a6dd559-f245-3e1f-a174-ff3ef04d1ae0",
                                                "text": "Catrinus Homan is een schaapsherder in Friesland en Drenthe. De realiteit van zijn beroep ligt ver af van de bucolische idylle die de meeste mensen koesteren over het herdersbestaan. Hij ligt niet met een grasspriet in de mond van het leven te genieten, maar werkt hard om de natuur en zijn kudde gezond te houden. De rust van de hei staat in schril contrast met het drukke leven van de herder. Ach, hoe schoon nog de wereld, die Fries-Drentse hei. Met een likje stress."
                                            },
                                            {
                                                "example_id": "50ec6fca-470d-49d9-ab9b-fb0c64ef8811",
                                                "sense_id": "2a6dd559-f245-3e1f-a174-ff3ef04d1ae0",
                                                "text": "Schaapsherder Jelle Kootstra heeft vandaag een bom uit de Tweede Wereldoorlog gevonden in Havelte. \"Ik dacht eerst dat het een oude melkbus was\", vertelt hij. De EOD is ter plaatste [sic!] gekomen en maakte de bom onschadelijk. De N353 tussen Frederiksoord en Havelte werd hiervoor enige tijd afgesloten. Inmiddels is de weg weer vrijgegeven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e7e8a0d-fa37-451c-9dd7-9c858d470a30",
                        "source_entry_id": "7d2ee189-adbe-36de-befe-0bb3bc58489b",
                        "source_sense_id": "d92c1b2b-42d5-3861-a9c3-7187381d0fd1",
                        "source_sense_description": "person herding sheep",
                        "target_lang_word": "Schafhirt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schafhirt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7b5f39e-12a4-37b7-b4e8-f278f51a4824",
                                        "entry_id": "73d96205-0d33-3430-bd76-ca7768e7c597",
                                        "glosses": [
                                            "Person, die eine Schafherde hütet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f004d565-ab06-4fb5-a642-bb1a98c8a07f",
                                                "sense_id": "b7b5f39e-12a4-37b7-b4e8-f278f51a4824",
                                                "text": "„Abel ist Schafhirt und Kain Ackerbauer. Da entsteht schon Neid untereinander. Jeder denkt, sein Beruf sei wichtiger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcc1edde-41cc-49c3-b79d-44d5349d7fad",
                        "source_entry_id": "7d2ee189-adbe-36de-befe-0bb3bc58489b",
                        "source_sense_id": "d92c1b2b-42d5-3861-a9c3-7187381d0fd1",
                        "source_sense_description": "person herding sheep",
                        "target_lang_word": "Schafhirte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schafhirte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58535dd5-cee7-382b-a139-7de441297c60",
                                        "entry_id": "60d9de4e-e005-3707-a98e-9b42e8711971",
                                        "glosses": [
                                            "Person, die eine Schafherde hütet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70bcfa23-9c1e-4382-97de-4efe24dc0ec3",
                                                "sense_id": "58535dd5-cee7-382b-a139-7de441297c60",
                                                "text": "„So kann man etwa ein Schäferstündchen im Altmühltal buchen - eine Tageswanderung, begleitet von Schafhirten und ihren Herden.“"
                                            },
                                            {
                                                "example_id": "e1470075-05f8-4ee3-b209-31478b90966b",
                                                "sense_id": "58535dd5-cee7-382b-a139-7de441297c60",
                                                "text": "„Da fange ich an, den Schafhirten herabzusetzen und mich über seine Mütze lustig zu machen.“"
                                            },
                                            {
                                                "example_id": "964f241e-6206-4214-9167-d980b18b08a9",
                                                "sense_id": "58535dd5-cee7-382b-a139-7de441297c60",
                                                "text": "„Er mußte diesem verdammten Schafhirten einmal die Leviten lesen.“"
                                            },
                                            {
                                                "example_id": "74375354-4f52-4710-8b8f-c3c4a859400d",
                                                "sense_id": "58535dd5-cee7-382b-a139-7de441297c60",
                                                "text": "„Der Schafhirte sagte, heute sei noch keiner vom Südland hier gewesen, und erst am späten Abend würden Gäste aus jener Richtung erwartet.“"
                                            },
                                            {
                                                "example_id": "c6aa87a4-b194-4ce0-9594-d9e7c922fe76",
                                                "sense_id": "58535dd5-cee7-382b-a139-7de441297c60",
                                                "text": "„Hin und wieder trieben auch Schafhirten, die in ihren langen, wallenden Umhängen aussahen, als wären sie soeben aus einer Zeitkapsel gefallen, in aller Seelenruhe ihre blökende Herde über die Schnellstraße.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8d8cf83-322d-4ae3-9904-b8b9a0beb4ed",
                        "source_entry_id": "7d2ee189-adbe-36de-befe-0bb3bc58489b",
                        "source_sense_id": "d92c1b2b-42d5-3861-a9c3-7187381d0fd1",
                        "source_sense_description": "person herding sheep",
                        "target_lang_word": "Schafhirtin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schafhirtin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74ba8b6c-b716-3b47-b5ae-ccf4eed696bc",
                                        "entry_id": "4fd83a85-415d-37d6-ba6f-683aef21016b",
                                        "glosses": [
                                            "Frau, die eine Schafherde hütet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6661965-399e-47d1-94fe-6cac1faabbd1",
                                                "sense_id": "74ba8b6c-b716-3b47-b5ae-ccf4eed696bc",
                                                "text": "„Was ist es nur, das uns Bewohner der industrialisierten Welt in Filme über weinende Kamele und mongolische Schafhirtinnen zieht?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
