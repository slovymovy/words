                "senses": [
                    {
                        "sense_id": "5b712940-7cdb-3fbe-95f3-85ddf48386ca",
                        "entry_id": "a040f708-4c39-3329-a227-2b6866ce15a9",
                        "glosses": [
                            "Fahrzeug, das bei einer Flucht verwendet wird; das von einem Flüchtigen gefahren wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af4d287f-27ce-435e-b159-829a4b37c55f",
                                "sense_id": "5b712940-7cdb-3fbe-95f3-85ddf48386ca",
                                "text": "„Der im NSU-Prozess Mitangeklagte Ralf Wohlleben soll das mutmaßliche Fluchtfahrzeug von Beate Zschäpe, Uwe Mundlos und Uwe Böhnhardt mit zurückgeholt haben.“"
                            },
                            {
                                "example_id": "61d612f9-91c3-450a-93af-9a90f28e9961",
                                "sense_id": "5b712940-7cdb-3fbe-95f3-85ddf48386ca",
                                "text": "„Gefunden wurde mittlerweile ein Fluchtfahrzeug, ein Citroen C-Crosser mit dem Kennzeichen KO-723 DG.“"
                            },
                            {
                                "example_id": "bfa9638f-127f-4fa9-a12d-039405f93187",
                                "sense_id": "5b712940-7cdb-3fbe-95f3-85ddf48386ca",
                                "text": "„Und draußen warteten die Männer im Fluchtfahrzeug.“"
                            }
                        ],
