                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "34d5c39c-858d-4469-ae11-9a10466bb043",
                                "sense_id": "56835406-e0b0-3c24-a685-e759f7c57de4",
                                "text": "Aus der elementaren Theologie der Abecedarier, Vocabulisten und Grammatisten […] sei nun eine Theologie der Rhetorik geworden […]"
                            },
                            {
                                "example_id": "dc8f8646-6716-4597-a5d4-a53c730d3de5",
                                "sense_id": "56835406-e0b0-3c24-a685-e759f7c57de4",
                                "text": "[…]; denn „aus der noch halb kindischen Theologie der Buchstaben und Worte vor 40 bis 50 Jahren, aus der elementaren Theologie der Abecedarier, Vocabulisten uud Grammatisten jener Zeit ist eine Theologie der Rhetorik erwachsen, sich selbst und Andere täuschend, gleich jener, aber mit weit grösserer Kunst täuschend;[…]"
                            }
                        ]
                    },
