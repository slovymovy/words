                "senses": [
                    {
                        "sense_id": "c558e6ff-eca4-3548-9b1b-0cf8898ce5dc",
                        "entry_id": "8e9736fe-9226-3d57-934f-ca32209fc0e6",
                        "glosses": [
                            "durch einen Fleischwolf gedrehtes, rohes Fleisch, gewolftes Fleisch"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "3a12af68-e70a-4cec-8ae7-c6b75962f2c8",
                                "sense_id": "c558e6ff-eca4-3548-9b1b-0cf8898ce5dc",
                                "text": "„Falscher Hase“ ist ein Braten aus Hackfleisch."
                            },
                            {
                                "example_id": "c654c914-e511-47c8-a6aa-299c7cd5778d",
                                "sense_id": "c558e6ff-eca4-3548-9b1b-0cf8898ce5dc",
                                "text": "„Er fand plötzlich, daß Böhle-Schniller wahrhaftig recht gehabt hatte mit seinem Rat, das orange-blaue Band niederzulegen. Was hatte er in einer Korporation von Metzgergesellen zu suchen? War es etwa sein Ideal, zeitlebens mit einem Gesicht herumzulaufen, das wie Hackfleisch aussah?“"
                            },
                            {
                                "example_id": "3756fe01-fd7a-45e5-bc7d-ddc1e47e4731",
                                "sense_id": "c558e6ff-eca4-3548-9b1b-0cf8898ce5dc",
                                "text": "„Nehmen wir an, jemand möchte sich abends eine Bulette braten und holt das Hackfleisch aus dem Kühlschrank, das er am Vormittag gekauft hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
