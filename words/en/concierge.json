{
    "word_family": [
        "conciergerie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b6074980-0b1d-3572-85eb-57f25158f03b",
                    "sense_definition": "A staff member in a hotel who assists guests with services like booking tours or making restaurant reservations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "service_staff",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>concierge</w> helped us book tickets for the evening theater performance.",
                            "target_lang_translations": {
                                "zh": "<w>礼宾员</w>帮我们预订了晚上剧院演出的票。"
                            }
                        },
                        {
                            "text": "Ask the <w>concierge</w> for recommendations on the best local restaurants nearby.",
                            "target_lang_translations": {
                                "zh": "向<w>礼宾员</w>咨询一下附近最好的当地餐厅。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hotel concierge"
                    ],
                    "target_lang_definitions": {
                        "zh": "酒店中协助客人预订旅游、餐厅等服务的员工。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "礼宾员",
                                "target_lang_sense_clarification": "酒店内专门负责为客人提供咨询和预订服务的专业人员。"
                            },
                            {
                                "target_lang_word": "礼宾部",
                                "target_lang_sense_clarification": "指代酒店内提供礼宾服务的部门。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd088b28-bb77-3516-af26-b068e26da5b7",
                    "sense_definition": "A person employed to look after a building and assist its residents or visitors.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "service_staff",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The building <w>concierge</w> accepted the package while the resident was at work.",
                            "target_lang_translations": {
                                "zh": "住户上班时，<w>大楼管理员</w>代收了包裹。"
                            }
                        },
                        {
                            "text": "Our <w>concierge</w> ensures the lobby remains clean and secure for all tenants.",
                            "target_lang_translations": {
                                "zh": "我们的<w>大楼管理员</w>确保大堂为所有住户保持整洁和安全。"
                            }
                        }
                    ],
                    "synonyms": [
                        "caretaker",
                        "custodian",
                        "porter"
                    ],
                    "common_phrases": [
                        "building concierge"
                    ],
                    "target_lang_definitions": {
                        "zh": "受雇照看建筑物并为住户或访客提供协助的人员。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大楼管理员",
                                "target_lang_sense_clarification": "负责公寓或办公楼日常管理和安保的人员。"
                            },
                            {
                                "target_lang_word": "门卫",
                                "target_lang_sense_clarification": "负责看守大门并处理进出事务的人员。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc6abcab-daa4-3012-8a0f-8d1e11545e06",
                    "sense_definition": "A specialized nurse who provides guidance and support to patients undergoing fertility treatments.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical_staff",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fertility <w>concierge</w> explained the medication schedule to the couple.",
                            "target_lang_translations": {
                                "zh": "<w>生育咨询师</w>向这对夫妇解释了用药时间表。"
                            }
                        },
                        {
                            "text": "Patients often rely on their <w>concierge</w> to navigate the complex treatment process.",
                            "target_lang_translations": {
                                "zh": "患者通常依靠<w>生育咨询师</w>来应对复杂的治疗过程。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "为接受生育治疗的患者提供指导和支持的专业护理人员。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "生育咨询师",
                                "target_lang_sense_clarification": "专门为生育治疗患者提供全程指导和协调的专业人员。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5227846f-e535-3c3d-993c-1b5d06f86720",
                    "sense_definition": "The office or residence of a concierge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The keys were left at the <w>concierge</w> for the new tenant to collect.",
                            "target_lang_translations": {
                                "zh": "钥匙留在了<w>礼宾台</w>，供新租户领取。"
                            }
                        },
                        {
                            "text": "Visitors must register their arrival at the <w>concierge</w> before entering the building.",
                            "target_lang_translations": {
                                "zh": "访客进入大楼前必须在<w>礼宾台</w>登记。"
                            }
                        }
                    ],
                    "synonyms": [],
                    "target_lang_definitions": {
                        "zh": "礼宾员的工作处所或办公室。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "礼宾台",
                                "target_lang_sense_clarification": "酒店或大楼内礼宾员办公的柜台区域。"
                            },
                            {
                                "target_lang_word": "门卫室",
                                "target_lang_sense_clarification": "建筑物入口处供管理员办公或休息的房间。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}