                                        "examples": [
                                            {
                                                "example_id": "428ebe34-3826-49b9-8b1e-670d02eb0517",
                                                "sense_id": "ed3c4f56-274a-3cf2-9e68-202d88faf585",
                                                "text": "Les morceaux les plus estimés du bœuf sont le gîte à la noix, la tranche, la culotte, mais surtout le filet et le contrefilet."
                                            },
                                            {
                                                "example_id": "eef73b15-6668-47cd-afe3-cf97d045b745",
                                                "sense_id": "ed3c4f56-274a-3cf2-9e68-202d88faf585",
                                                "text": "L’aloyau comprend le filet, le faux-filet ou contrefilet et le roomsteck."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
