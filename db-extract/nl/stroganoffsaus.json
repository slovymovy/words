                        "sense_id": "36896751-6af3-375d-bec2-82a2fbd098d6",
                        "entry_id": "db4c17d3-471b-307d-a0d6-c2267b32f830",
                        "glosses": [
                            "oorspronkelijk Russische saus bestaande uit ui, champignons, meel, bouillon, smetana (soort zure room) en mosterd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "484ea0bb-97f8-40f2-9690-148154b4b3d0",
                                "sense_id": "36896751-6af3-375d-bec2-82a2fbd098d6",
                                "text": "Daar stond in het onderste rek het halve flesje vodka dat Zwanet eens in de zoveel maanden gebruikte om voor haar ouders, wanneer die te gast waren, de stroganoffsaus of de Russische wijnsoep op smaak te brengen."
                            },
                            {
                                "example_id": "bdf08b36-06ca-4e7d-b20a-8145c76b7983",
                                "sense_id": "36896751-6af3-375d-bec2-82a2fbd098d6",
                                "text": "Na drie gangen is de verzadiging ingetreden, maar het belletje gaat en de schotel inclusief brandende vuurpijl arriveert. Spiezen met biefstuk met ui en paprika, varkensmedaillons met spek en een varkenspoot van de grill liggen te pronken naast de stroganoffsaus."
                            }
                        ]
                    }
                ],
