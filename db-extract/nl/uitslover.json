                                        "entry_id": "e5d1a501-fc53-3165-9318-f81da9cb4fb0",
                                        "glosses": [
                                            "jemand, der mit übermäßig viel Fleiß, Zielstrebigkeit und Ehrgeiz auf die eigene Laufbahn, vor allem in der Schule, aber auch in Ausbildung, Studium und Beruf, hinarbeitet"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab0174ae-85b3-47b5-ab5b-cd221b50680c",
                                                "sense_id": "4660e8f2-3e92-3f3c-af22-d1981b62c08e",
                                                "text": "Der Junge hat extrem gute Noten, ist aber auch ein echter Streber."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "934690cf-e62f-376e-ad39-659fdf1d47bd",
