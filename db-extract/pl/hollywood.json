                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30aa0200-f42b-40bf-9757-a138c589a178",
                                "sense_id": "0ce473bb-ce1c-3845-a9da-6cf5590acadf",
                                "text": "W 1910 roku Los Angeles objęło zasięgiem Hollywood, zaś na terenie samego miasta działało co najmniej dziesięć wytwórni filmowych"
                            },
                            {
                                "example_id": "2d67bcb0-f4a8-46ca-9878-6671fa1058ac",
                                "sense_id": "0ce473bb-ce1c-3845-a9da-6cf5590acadf",
                                "text": "Historia produkcji filmu przypomina opowiastkę gangsterską z lat 20. i rzuca nieco światła na stosunki między Hollywoodem a resztą świata"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
