                    {
                        "sense_id": "5c41b752-596f-3bca-a039-71fe292c5280",
                        "entry_id": "93ff5ee7-b429-37c8-b30b-c0bb60c25097",
                        "glosses": [
                            "Stadt im Kreis Ostholstein, Schleswig-Holstein, Deutschland"
