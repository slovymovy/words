                ],
                "senses": [
                    {
                        "sense_id": "d60cbdb4-02ee-32d1-8b4f-e872fb5df0ab",
                        "entry_id": "1063d340-e892-3279-ab8d-32f13e08a3fe",
                        "glosses": [
                            "(о звуке) издать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bee45730-81c4-4b71-8597-6359afaca831",
                                "sense_id": "d60cbdb4-02ee-32d1-8b4f-e872fb5df0ab",
                                "text": "Они испустили какой-то странный крик, взмахнули великолепными, большими крыльями и полетели с холодных лугов в тёплые края, за синее море."
                            }
                        ]
                    },
                    {
                        "sense_id": "1aac3b59-5338-3d69-b7a6-8410714f7180",
                        "entry_id": "1063d340-e892-3279-ab8d-32f13e08a3fe",
                        "glosses": [
                            "книжн. распространить, выделить из себя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e99a0a7-3451-49c3-ad3f-3ecf978aa503",
                                "sense_id": "1aac3b59-5338-3d69-b7a6-8410714f7180",
                                "text": "Зинзивей испустил вздох, как бы соболезнуя о несчастном, после чего разбил яйцо на угловатой голове своей и смиренно принялся лущить скорлупу."
                            }
                        ]
                    }
                ],
