                "senses": [
                    {
                        "sense_id": "a697c5fa-f0e0-3d5a-9c26-5a54e37b4380",
                        "entry_id": "381fc6b1-24bc-3e0e-8267-1591f75a08a0",
                        "glosses": [
                            "Faire un petit bruit ressemblant au bruit d’une scie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e83b143d-18fb-4206-b064-10fd2a0ee01d",
                                "sense_id": "a697c5fa-f0e0-3d5a-9c26-5a54e37b4380",
                                "text": "Il fait une chaleur du diable, et j’entends toujours c’te bestiole qui zizille dans les arbres."
                            },
                            {
                                "example_id": "745f0f6b-257f-4d93-b3c3-a08b9c2ec27a",
                                "sense_id": "a697c5fa-f0e0-3d5a-9c26-5a54e37b4380",
                                "text": "Je reviens sur mes pas, traverse les mêmes rues que la veille qui s'ouvrent, palpitantes. La foule, essaim zizillant, respire."
                            }
                        ]
                    }
                ],
