                        "glosses": [
                            "Surnom populaire donné à la 2 CV de Citroën."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a09a85f-4956-4baa-b9f1-2b6aac9610af",
                                "sense_id": "b50b820d-0197-321e-9884-0a55971e0366",
                                "text": "Il a vendu cinq livres de poche, il a donc gagné deux euros qu’il touchera dans un an s’il les touche, il peut parfaitement payer trente euros de super à la deux-pattes."
                            }
                        ]
                    }
                ],
