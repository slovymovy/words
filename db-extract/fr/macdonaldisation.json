                                        "entry_id": "701c7c10-c05f-30da-af2a-00eb46ba5c67",
                                        "glosses": [
                                            "The process by which institutions in society become standardized and focused on efficiency and predictability."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8efa4b1d-ff87-4253-8877-b13b37a97e75",
                                                "sense_id": "5b531737-be2d-37e2-8d14-c658600564e8",
                                                "text": "Almost all social institutions (for example, education, sports, politics, and religion) were adapting McDonald's principles to their operations. And McDonaldization was spreading around the world—fast-food croissanteries in Paris (of all places), Kentucky Fried Chicken in Beijing, McDonald’s in Beijing and Moscow."
                                            }
                                        ]
                                    }
                                ]
                            }
