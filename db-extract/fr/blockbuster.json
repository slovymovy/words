                ],
                "senses": [
                    {
                        "sense_id": "ecf1a8c3-6500-372b-9c33-0de46092750d",
                        "entry_id": "a21d70e5-9a66-38e1-82f9-7426bafbed3d",
                        "glosses": [
                            "Carton, gros titre, succès commercial."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "6bf630fc-07eb-4c4c-afad-dc4a8f64cf7f",
                                "sense_id": "ecf1a8c3-6500-372b-9c33-0de46092750d",
                                "text": "Giulia est un véritable moulin à paroles : elle revient de quinze jours aux États-Unis, a tourné dans un blockbuster avec incendies et explosions."
                            },
                            {
                                "example_id": "d263dd2e-3f2d-4dbc-9db0-29a1de5a873a",
                                "sense_id": "ecf1a8c3-6500-372b-9c33-0de46092750d",
                                "text": "Les blockbusters de la rentrée littéraire au chevet de l’édition"
                            },
                            {
                                "example_id": "59650e93-1c65-49d4-9a34-4f96ad1174e1",
                                "sense_id": "ecf1a8c3-6500-372b-9c33-0de46092750d",
                                "text": "Séries Mania met aussi en avant, hors compétition, la saison 3 de HPI, Les Bracelets rouges, nouvelle génération, avec une nouvelle bande d’ados hospitalisés, Jusqu’ici tout va bien, la première série de l’humoriste Nawell Madani, et Abysses, blockbuster catastrophe écologiste, porté par Cécile de France."
                            }
                        ]
                    },
                    {
                        "sense_id": "40eb5ff0-e93b-352b-8b8a-b39b2aed5ed1",
                        "entry_id": "a21d70e5-9a66-38e1-82f9-7426bafbed3d",
                        "glosses": [
                            "Médicament dont la vente réalise plus d’un milliard de dollars de chiffre d’affaires."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "46d0864e-e785-4369-b733-704c75fd09a0",
                                "sense_id": "40eb5ff0-e93b-352b-8b8a-b39b2aed5ed1",
                                "text": "Les critères d’évaluation secondaires ont également été atteints, précise l’entreprise. De quoi ouvrir la voie à une prochaine commercialisation de ce médicament, dont les analystes estiment qu’il a le potentiel de devenir un « blockbuster », c’est-à-dire un médicament dépassant plus d’un milliard de dollars (plus de 850 millions d’euros) de chiffre d’affaires annuel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be4d7162-8987-4ae6-9ab5-746e522d5406",
                        "source_entry_id": "a21d70e5-9a66-38e1-82f9-7426bafbed3d",
                        "target_lang_word": "Blockbuster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blockbuster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "638c67aa-ca5b-3641-aef8-9eed569bd00d",
                                        "entry_id": "783daa11-b22e-356f-bb8b-d4f6266f6ea5",
                                        "glosses": [
                                            "besonders einträgliches Produkt (Album, Buch, Film, Medikament…)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79b5fbc0-bec4-4a63-8c27-fc5f3816bd47",
                                                "sense_id": "638c67aa-ca5b-3641-aef8-9eed569bd00d",
                                                "text": "„Die Arzneiunternehmen plagt zudem ein ganz grundsätzliches Leiden: Ihre Entwicklungs-Pipelines sind bedrohlich leer, neue Blockbuster kaum in Sicht - während zugleich viele der derzeitigen Kassenschlager in den nächsten Jahren ihren Patentschutz verlieren und somit billige Nachahmerpräparate auf den Markt drängen werden.“"
                                            },
                                            {
                                                "example_id": "ad6a68a1-7e93-4d26-bdc2-2c1d878803f8",
                                                "sense_id": "638c67aa-ca5b-3641-aef8-9eed569bd00d",
                                                "text": "„Zu unsicher erscheint ihnen offenbar, dass sich mit Spielen für 3-D-Brillen in den nächsten Jahren jene Millionen verdienen lassen, die die Entwicklung eines Blockbusters üblicherweise verschlingt.“"
                                            },
                                            {
                                                "example_id": "e2784e4e-74de-4ced-bcae-51646e507253",
                                                "sense_id": "638c67aa-ca5b-3641-aef8-9eed569bd00d",
                                                "text": "„Die Amerikaner standen Schlange, um dort ihre Blockbuster zu produzieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3ba38be6-be8f-3520-89d2-a866f87ca374",
                                        "entry_id": "783daa11-b22e-356f-bb8b-d4f6266f6ea5",
                                        "glosses": [
                                            "besonders zerstörerische Bombe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08c83116-9325-4e06-8c3f-9989db50f8db",
                                                "sense_id": "3ba38be6-be8f-3520-89d2-a866f87ca374",
                                                "text": "„Es handelt sich bei dem Sprengkörper um einen so genannten Blockbuster mit 1300 Kilo Sprengstoff, der ganze Wohnblöcke zerstören sollte. Zuletzt war ein Blockbuster vor einem Jahr im Hamburger Hafen gefunden und entschärft worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72abf60b-4c2b-43da-aa65-442842187442",
                        "source_entry_id": "a21d70e5-9a66-38e1-82f9-7426bafbed3d",
                        "target_lang_word": "Verkaufsschlager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verkaufsschlager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "923e9279-3446-3ee2-9216-ee82e8dd9c81",
                                        "entry_id": "b4279a59-8565-3bb1-b9b8-a2145cbcc188",
                                        "glosses": [
                                            "Ware, die sich sehr gut verkaufen lässt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a142142-9032-4762-98a9-585b94ed3508",
                                                "sense_id": "923e9279-3446-3ee2-9216-ee82e8dd9c81",
                                                "text": "Früher waren Aldi-Computer in Deutschland Verkaufsschlager, für die die Kunden Schlange standen."
                                            },
                                            {
                                                "example_id": "e38906db-afd0-4f44-a0a9-44c807efe045",
                                                "sense_id": "923e9279-3446-3ee2-9216-ee82e8dd9c81",
                                                "text": "[2020:] In den letzten Jahren waren iPhones ein weltweiter Verkaufsschlager."
                                            },
                                            {
                                                "example_id": "673ae04c-d4f7-43d0-a14c-c0f8530a1468",
                                                "sense_id": "923e9279-3446-3ee2-9216-ee82e8dd9c81",
                                                "text": "Ein 365-Euro-Ticket für den ÖPNV nach dem Vorbild von Wien könnte ein deutschlandweiter Verkaufsschlager sein."
                                            },
                                            {
                                                "example_id": "ee282b00-71c7-435d-8905-f41794698c00",
                                                "sense_id": "923e9279-3446-3ee2-9216-ee82e8dd9c81",
                                                "text": "„Ein Linux-basierter Rechner wurde in Malaysia zum Verkaufsschlager.“"
                                            },
                                            {
                                                "example_id": "1cb0a320-b507-473a-b002-88aa8b13ec5a",
                                                "sense_id": "923e9279-3446-3ee2-9216-ee82e8dd9c81",
                                                "text": "„Der grüne Miniaturbildschirm konnte pro Zeile maximal 52 Zeichen anzeigen, also kaum mehr als ein modernes Handy. […] Trotz dieser Einschränkungen wurden der Osborne1 sowie sein Nachfolgermodell zum Verkaufsschlager.“"
                                            },
                                            {
                                                "example_id": "9164d531-a94c-427e-a330-f92e2130746c",
                                                "sense_id": "923e9279-3446-3ee2-9216-ee82e8dd9c81",
                                                "text": "„Ebenfalls unter den Top Ten der Verkaufsschlager ist momentan das Actionspiel Star Wars Battlefront […].“"
                                            },
                                            {
                                                "example_id": "1273481d-1bb5-4e56-be73-af69a2284468",
                                                "sense_id": "923e9279-3446-3ee2-9216-ee82e8dd9c81",
                                                "text": "„Im Beethoven Jubiläumsjahr waren Igor Levits Einspielungen aller Klaviersonaten von Ludwig van Beethoven ein Verkaufsschlager.“"
                                            },
                                            {
                                                "example_id": "7318d0ae-24fb-487b-bfac-3f8bb553c5c3",
                                                "sense_id": "923e9279-3446-3ee2-9216-ee82e8dd9c81",
                                                "text": "„In den USA wurde das Buch zum Verkaufsschlager, spätestens als US-Talkerin Oprah Winfrey den Roman im Fernsehen empfohlen hatte.“"
                                            },
                                            {
                                                "example_id": "c2d635e9-151e-4d01-9379-fe4abb6f5c54",
                                                "sense_id": "923e9279-3446-3ee2-9216-ee82e8dd9c81",
                                                "text": "„Während das klassische Seifenstück in den 1970er-Jahren ein Verkaufsschlager war, sind heute Flüssigseifen eine ernstzunehmende Konkurrenz.“"
                                            },
                                            {
                                                "example_id": "63adb1de-efca-4e11-b25c-9d1021ea26b8",
                                                "sense_id": "923e9279-3446-3ee2-9216-ee82e8dd9c81",
                                                "text": "„Verkaufsschlager 787 – Die 787 ist seit 2011 im Passagierbetrieb. Die Maschine ist aufgrund ihrer Größe und Treibstoffeffizienz bei Fluggesellschaften als Langstreckenjet beliebt und ein Verkaufsschlager.“"
                                            },
                                            {
                                                "example_id": "44b59124-bb3b-4b99-ad4a-29783a0e6da2",
                                                "sense_id": "923e9279-3446-3ee2-9216-ee82e8dd9c81",
                                                "text": "„Schon das erste Modell von 1946 hatte das charakteristische \"Hinterteil\" einer Wespe: die \"Vespa\" ist geboren. Innerhalb weniger Jahre entwickelte sie sich zum Riesen-Verkaufsschlager, nicht zuletzt bei den Damen.“"
                                            },
                                            {
                                                "example_id": "af07bfa1-89ab-4619-a975-9d2668d02d5c",
                                                "sense_id": "923e9279-3446-3ee2-9216-ee82e8dd9c81",
                                                "text": "„E-Book-Reader waren ohnehin nie ein Verkaufsschlager und der Markt sank von 26,4 Mio. Stück weltweit 2011 auf 18,2 Mio. Stück im Jahr 2012.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f88fbbe-5428-4bd5-95de-2d057e25f39e",
