    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "89eae3b0-e7a4-326a-91fa-8bb62b012cad",
                "word": "suffragette",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7e10f105-8d3e-43d1-be0a-6b724d84aea8",
                        "entry_id": "89eae3b0-e7a4-326a-91fa-8bb62b012cad",
                        "tags": [
                            "plural"
                        ],
                        "form": "suffragettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4bb3106-c750-3739-a42a-473497b4f47b",
                        "entry_id": "89eae3b0-e7a4-326a-91fa-8bb62b012cad",
                        "glosses": [
                            "A female supporter, often militant, of women's right to vote in the early 20th century, especially in Great Britain."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f3308d5a-4598-4331-98c2-e396ca968d34",
                                "sense_id": "c4bb3106-c750-3739-a42a-473497b4f47b",
                                "text": "Perhaps no single location resonates for women’s rights campaigners today as much as Holloway, the first female-only prison, where militant suffragettes were incarcerated, went on hunger strike and were savagely force-fed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a5168c3-5d9d-4a2f-8ea4-b29619ed35a7",
                        "source_entry_id": "89eae3b0-e7a4-326a-91fa-8bb62b012cad",
                        "source_sense_id": "c4bb3106-c750-3739-a42a-473497b4f47b",
                        "source_sense_description": "female supporter of women's right to vote",
                        "target_lang_word": "sufražetka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sufražetka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "738eae15-7889-3891-aa19-740ec98cce7a",
                                        "entry_id": "e6c63cdb-9ee7-391f-b9f3-0afca05b85e6",
                                        "glosses": [
                                            "bojovnice za ženská práva"
                                        ],
                                        "tags": [
                                            "dříve"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "970ae993-7295-4bd7-80ee-421c58794a94",
                                                "sense_id": "738eae15-7889-3891-aa19-740ec98cce7a",
                                                "text": "Přes všechno úsilí si až do první světové války sufražetky volební právo nevybojovaly. Stejně jako jejich předchůdkyně."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f21d0f77-a817-4446-a633-345b8a59a5d3",
                        "source_entry_id": "89eae3b0-e7a4-326a-91fa-8bb62b012cad",
                        "source_sense_id": "c4bb3106-c750-3739-a42a-473497b4f47b",
                        "source_sense_description": "female supporter of women's right to vote",
                        "target_lang_word": "suffragette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suffragette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6835d23-0733-37d4-af65-03700095b9b1",
                                        "entry_id": "04efa7b5-4947-3aa2-baf5-e32b664b0da3",
                                        "glosses": [
                                            "Femme qui militait pour obtenir le droit de voter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bef4ecbc-791e-480d-9842-e118d3a8481a",
                                                "sense_id": "d6835d23-0733-37d4-af65-03700095b9b1",
                                                "text": "Bien entendu, je n’entends pas parler, en ces termes flatteurs, des « suffragettes » ni des « sottes pécores » qui rêvent de prendre une part active au « suffrage universel », cet attrape-nigaud sublime grâce auquel un gouvernement français « pince-sans-rire » est arrivé à faire croire aux Français qu’ils se gouvernent eux-mêmes ; je parle ici aux femmes de bon sens, à l’esprit éclairé et scientifique, qui pressentent qu’elles ont une grande et mystérieuse mission à remplir."
                                            },
                                            {
                                                "example_id": "eb9c31ac-ad9b-4208-b51a-dea8d84d013b",
                                                "sense_id": "d6835d23-0733-37d4-af65-03700095b9b1",
                                                "text": "Or, ce n’est pas seulement dans ce bulletin-là, mais deux fois encore que George Sand se prononça dans la presse contre les réclamations féminines, hors de propos, lorsque les droits de l’homme ne sont pas encore conquis, et en particulier contre le point pour lequel, de nos jours, les suffragettes anglaises combattirent avec une énergie extravagante : contre la participation des femmes aux élections et à la députation."
                                            },
                                            {
                                                "example_id": "e72e2958-11a5-4509-924f-73b493aa99a2",
                                                "sense_id": "d6835d23-0733-37d4-af65-03700095b9b1",
                                                "text": "A l’époque où le suffragettes ont essayé d’investir la Chambre des communes , où elles ont cassé les vitres des bureaux gouvernementaux et des magasins principaux de Londres […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b469729b-a08f-3150-9509-0d66e9910aa8",
                                        "entry_id": "04efa7b5-4947-3aa2-baf5-e32b664b0da3",
                                        "glosses": [
                                            "Féministe, femme qui milite pour l’admission des femmes dans une institution ou un ordre qui lui est jusqu’alors fermé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d75aa1eb-f9b1-4d34-8cec-291821e1619b",
                                                "sense_id": "b469729b-a08f-3150-9509-0d66e9910aa8",
                                                "text": "Que penseraient-elles de moi, ces dames du « tout-ou-rien », suffragettes intransigeantes de l’amour ?"
                                            },
                                            {
                                                "example_id": "f92d0b27-a6db-42b9-b605-4d374da09861",
                                                "sense_id": "b469729b-a08f-3150-9509-0d66e9910aa8",
                                                "text": "— Je crois qu’elle met de l’argent de côté pour suivre une formation professionnelle.\n— Elle ferait pourtant une bonne épouse…\nSur cette parole qui aurait indigné une suffragette, elle retomba de nouveau dans les bras de Morphée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64e4d9b2-f141-4319-bbf1-afcbee93b97a",
                        "source_entry_id": "89eae3b0-e7a4-326a-91fa-8bb62b012cad",
                        "source_sense_id": "c4bb3106-c750-3739-a42a-473497b4f47b",
                        "source_sense_description": "female supporter of women's right to vote",
                        "target_lang_word": "Suffragette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Suffragette",
