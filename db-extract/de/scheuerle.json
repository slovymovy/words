                ],
                "senses": [
                    {
                        "sense_id": "76ac0826-9e98-3b67-87e4-70f90c538052",
                        "entry_id": "6355659e-914d-378c-b173-0e652cb06249",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c012d469-395d-48f6-b560-1ea98791a120",
                                "sense_id": "76ac0826-9e98-3b67-87e4-70f90c538052",
                                "text": "Frau Scheuerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "06a5cd19-9cef-41ed-a668-b800a9100e64",
                                "sense_id": "76ac0826-9e98-3b67-87e4-70f90c538052",
                                "text": "Herr Scheuerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "33ed76a4-1960-42f2-9269-55aab05954fe",
                                "sense_id": "76ac0826-9e98-3b67-87e4-70f90c538052",
                                "text": "Die Scheuerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "cde3669f-c4c6-4341-83d6-7ddff8ea694c",
                                "sense_id": "76ac0826-9e98-3b67-87e4-70f90c538052",
                                "text": "Der Scheuerle trägt nie die Pullover, die die Scheuerle ihm strickt."
                            },
                            {
                                "example_id": "28e9804a-25cb-4936-a105-a6ed89676086",
                                "sense_id": "76ac0826-9e98-3b67-87e4-70f90c538052",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Scheuerle kommt, geht der Herr Scheuerle.“"
                            },
                            {
                                "example_id": "d76e5ac5-d7af-4978-9d12-75ed8b5a2326",
                                "sense_id": "76ac0826-9e98-3b67-87e4-70f90c538052",
                                "text": "Scheuerle kommt und geht."
                            },
                            {
                                "example_id": "49f7970c-d780-4d3b-ad4f-a01073360213",
                                "sense_id": "76ac0826-9e98-3b67-87e4-70f90c538052",
                                "text": "Scheuerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
