                "word": "Mesolithic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "266f930d-6e9f-3f26-a1d5-3f5fce3fe101",
                        "entry_id": "085fbc87-8f68-33bd-a4a0-c464cf153399",
                        "glosses": [
                            "Of or referring to the Middle Stone Age (also the Mesolithic period or the Mesolithic age), a prehistoric period that lasted between 10000 and 3000 BC."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "583b9343-83c4-413c-87ec-a0ca5d1085c8",
                        "source_entry_id": "085fbc87-8f68-33bd-a4a0-c464cf153399",
                        "source_sense_id": "266f930d-6e9f-3f26-a1d5-3f5fce3fe101",
