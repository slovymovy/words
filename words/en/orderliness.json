{
    "word_family": [
        "order",
        "orderly",
        "disorder",
        "disorderly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "682c5487-69a2-39d9-be0d-52ea89906fd9",
                    "sense_definition": "The state of being arranged in a regular, neat, and systematic way.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>orderliness</w> of her desk helped her focus on her work throughout the day.",
                            "target_lang_translations": {
                                "ru": "<w>Упорядоченность</w> её рабочего стола помогала ей концентрироваться на работе в течение дня."
                            }
                        },
                        {
                            "text": "The librarian took great pride in the <w>orderliness</w> of the bookshelves in the library.",
                            "target_lang_translations": {
                                "ru": "Библиотекарь очень гордилась <w>аккуратностью</w> книжных полок в библиотеке."
                            }
                        }
                    ],
                    "synonyms": [
                        "neatness",
                        "tidiness",
                        "organization"
                    ],
                    "antonyms": [
                        "disorder",
                        "messiness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, при котором всё расположено в правильном, аккуратном и систематическом порядке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упорядоченность",
                                "target_lang_sense_clarification": "состояние организованности и системности"
                            },
                            {
                                "target_lang_word": "аккуратность",
                                "target_lang_sense_clarification": "качество соблюдения порядка и чистоты"
                            },
                            {
                                "target_lang_word": "организованность",
                                "target_lang_sense_clarification": "наличие четкой структуры и порядка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d74b45da-41cb-37a9-ade6-58d5cb1c2f8c",
                    "sense_definition": "The quality of behaving in a calm, controlled, and disciplined manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher praised the students for their <w>orderliness</w> while they were leaving the classroom.",
                            "target_lang_translations": {
                                "ru": "Учитель похвалил учеников за их <w>дисциплинированность</w> при выходе из класса."
                            }
                        },
                        {
                            "text": "The crowd maintained a sense of <w>orderliness</w> as they waited patiently for the gates to open.",
                            "target_lang_translations": {
                                "ru": "Толпа сохраняла <w>порядок</w>, терпеливо ожидая открытия ворот."
                            }
                        }
                    ],
                    "synonyms": [
                        "discipline",
                        "composure",
                        "control"
                    ],
                    "antonyms": [
                        "chaos",
                        "unruliness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество поведения, характеризующееся спокойствием, сдержанностью и дисциплинированностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дисциплинированность",
                                "target_lang_sense_clarification": "соблюдение правил и порядка в поведении"
                            },
                            {
                                "target_lang_word": "выдержанность",
                                "target_lang_sense_clarification": "способность сохранять спокойствие и контроль"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}