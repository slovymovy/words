                        "source_sense_id": "e74854c0-fba7-3181-93d7-516d544ec75e",
                        "target_lang_word": "Anlegeapparat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7b344dfa-090c-456c-92f9-e76f036b26c7",
                        "source_entry_id": "403f2b89-f7cd-3fee-a1c8-e2cd0897723b",
                        "source_sense_id": "e74854c0-fba7-3181-93d7-516d544ec75e",
                        "target_lang_word": "Anleger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anleger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a6f1aea-8e00-3d2c-9492-c8c42c2c31c2",
                                        "entry_id": "fe9c568b-645c-3b42-b98e-bfb732047729",
                                        "glosses": [
                                            "Person, die Geld anlegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "879ca168-fad0-4322-a14d-ddb74c2a84d0",
                                                "sense_id": "7a6f1aea-8e00-3d2c-9492-c8c42c2c31c2",
                                                "text": "„Häufig suchen auch die Anwälte reicher Anleger seinen Rat, wenn sie Ärger mit der Steuer befürchten.“"
                                            },
                                            {
                                                "example_id": "f246887b-a039-451b-8893-a494bdec93a8",
                                                "sense_id": "7a6f1aea-8e00-3d2c-9492-c8c42c2c31c2",
                                                "text": "„Die Anleger hatten Geld in sogenannte Bermuda-Versicherungen gesteckt, spezielle »Lebensversicherungen«, mit denen sich Schwarzgeld angeblich risikolos reinwaschen ließ.“"
                                            },
                                            {
                                                "example_id": "f6d1cd40-c19e-44be-8ada-2932281aee9f",
                                                "sense_id": "7a6f1aea-8e00-3d2c-9492-c8c42c2c31c2",
                                                "text": "„Grace suchte die Anleger zu den Modellen, dafür telefonierte sie, reiste, dafür vergaß sie Familie, Ferien, die Liebe auch, sagt sie, sie arbeitete 15 Jahre lang an der Wall Street, und der Lohn waren mindestens 300000 Dollar pro Jahr und oft mehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35b5ba47-09a7-3cd2-a784-bb44fe1d66a5",
                                        "entry_id": "fe9c568b-645c-3b42-b98e-bfb732047729",
                                        "glosses": [
                                            "jemand, der beruflich Papier in eine Druckpresse einführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cee4b72-2c8a-4115-903b-b4fbda84b72b",
                                                "sense_id": "35b5ba47-09a7-3cd2-a784-bb44fe1d66a5",
                                                "text": "Der Anleger hat für einen Moment nicht aufgepasst und dann geschah das Unglück."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a77675e5-bce0-32f4-8c0f-c3ced25c2a23",
                                        "entry_id": "fe9c568b-645c-3b42-b98e-bfb732047729",
                                        "glosses": [
                                            "Apparat zum automatischen Anlegen von Druckbögen bei Schnellpressen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "769f054c-aa13-446c-a7e2-344b33febd5d",
                                                "sense_id": "a77675e5-bce0-32f4-8c0f-c3ced25c2a23",
                                                "text": "„Vor Beginn des Druckprozesses muss zunächst ein Stapel Papier in den Anleger der Maschine eingefahren werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d9d146de-819b-3707-8a8e-4507863e6e89",
                                        "entry_id": "fe9c568b-645c-3b42-b98e-bfb732047729",
                                        "glosses": [
                                            "Stelle am Ufer zum Anlegen von Booten und Schiffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96b0ab19-3911-45f0-a406-a3e8c97123fb",
                                                "sense_id": "d9d146de-819b-3707-8a8e-4507863e6e89",
                                                "text": "Bei Hochwasser steht der Anleger unter Wasser."
                                            },
                                            {
                                                "example_id": "2ed017a4-9f79-4262-99d5-dc642c31963f",
                                                "sense_id": "d9d146de-819b-3707-8a8e-4507863e6e89",
                                                "text": "„Größere Ortschaften mit Molen und Anlegern gab es nur wenige.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
