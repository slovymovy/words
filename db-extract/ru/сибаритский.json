                "translations": [
                    {
                        "translation_id": "7be0158e-65a8-4c51-9f21-72b970a97b8e",
                        "source_entry_id": "18eacb30-6aeb-33eb-b37f-18639ed2823a",
                        "source_sense_id": "684aa3c7-e1ed-30ed-b11a-5ecba5190cc6",
                        "target_lang_word": "sybaritisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sybaritisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b63b17d-3f2b-3d69-8eda-88dccd54154f",
                                        "entry_id": "f588ef32-b907-330c-a29f-6c1e656cd8d3",
                                        "glosses": [
                                            "die Stadt Sybaris oder deren Einwohner betreffend"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e013530b-e628-4837-9838-fb65ec43c402",
                                                "sense_id": "7b63b17d-3f2b-3d69-8eda-88dccd54154f",
                                                "text": "„Ein Besucher aus der Renaissance, der unvermittelt auf uns gestoßen wäre, hätte sehr wohl annehmen können, daß wir einem Bild entstiegen waren, welches das gewaltsame Ende des räudigen Gefolges eines sybaritischen Dogen darstellte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "811f5a1a-5d28-3578-a634-2ff492233fc1",
                                        "entry_id": "f588ef32-b907-330c-a29f-6c1e656cd8d3",
                                        "glosses": [
                                            "genusssüchtig, schwelgerisch, verweichlicht"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "876b16b6-7143-49af-a656-98a4b837b725",
                                                "sense_id": "811f5a1a-5d28-3578-a634-2ff492233fc1",
                                                "text": "„Seine großartige Physiognomie, eben noch von gotischem Schmerz beseelt, erblühte üppig und heiter; sogar ein sybaritisches Grübchen zeigte sich auf einmal in seiner Wange. 'Die Stunde ist hie -' Und ließ sich die Karte geben . . .“"
                                            },
                                            {
                                                "example_id": "63479d50-9349-43b2-90ee-edd5d76508f7",
                                                "sense_id": "811f5a1a-5d28-3578-a634-2ff492233fc1",
                                                "text": "\"Die sybaritische Wonne eines Taxis verschmähte er und unterzog sich mit Selbstverständlichkeit der qualvollen Aufgabe, in einer fremden Stadt mit fremder Sprache per Tram fremde Sehenswürdigkeiten zu erreichen, deren Name die Eingeborenen kaum kannten.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
