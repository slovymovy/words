                        "glosses": [
                            "Radiographier en utilisant des rayons gamma."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d97c92aa-088a-4f35-b92f-2ddd41d83011",
                                "sense_id": "723da8d2-8571-305e-bda7-f343e954fa15",
                                "text": "Ces appareils permettent aussi le fonctionnement panoramique: la source radioactive est déplacée plus ou moins dans un tube de guidage, et peut gammagraphier des soudures circulaires dans des canalisations."
                            },
                            {
                                "example_id": "e5926992-b07a-49e4-aa45-062216f84d9c",
                                "sense_id": "723da8d2-8571-305e-bda7-f343e954fa15",
                                "text": "Cet isotope a été utilisé pour gammagraphier les soudures aux collerettes (frettes) des culottes et tuyaux droits, dont l’épaisseur dépasse 25 mm."
                            }
                        ]
                    }
