                "senses": [
                    {
                        "sense_id": "1e200ad7-940f-380c-906b-44edbf7c60b6",
                        "entry_id": "70479e7b-11be-3540-bbe8-3d0eb87d905d",
                        "glosses": [
                            "Zelle des adaptiven Immunsystems, die an der Immunreaktion mitwirkt, indem sie auf körperfremde Antigene reagiert"
                        ],
                        "tags": [
                            "Immunologie"
                        ],
                        "examples": [
                            {
                                "example_id": "9e2f6a1b-3e04-40c7-82e0-ada3a0a6168a",
                                "sense_id": "1e200ad7-940f-380c-906b-44edbf7c60b6",
                                "text": "„Auf dem Weg zur reifen T-Zelle, kommt es zur Expression von Oberflächenmolekülen wie dem Corezeptor CD3 und den typischen T-Zell-Molekülen CD4 oder CD8. T-Helferzellen zeichnen sich durch das Vorhandensein von CD4-Molekülen aus, T-Killerzellen durch das von CD8-Molekülen.“"
                            },
                            {
                                "example_id": "1f2b5869-dd3a-4d6e-afb6-a50b119d16c6",
                                "sense_id": "1e200ad7-940f-380c-906b-44edbf7c60b6",
                                "text": "„Dabei reagiert die T-Zelle direkt auf ein fremdes Antigen. Das können von Viren befallene Zellen sein oder auch Tumorzellen, in jedem Fall Zellen oder Eindringlinge, die als Feind identifiziert werden.“"
                            },
                            {
                                "example_id": "84a69424-5be0-44ad-81a6-606c8548b630",
                                "sense_id": "1e200ad7-940f-380c-906b-44edbf7c60b6",
                                "text": "„T-Zellen können den Krebs effektiv bekämpfen, sind aber nicht besonders gut darin, Tumorzellen zu erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
