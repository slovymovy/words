                "senses": [
                    {
                        "sense_id": "13ba4b8d-54f3-3325-9571-711291a266cf",
                        "entry_id": "95d37d0d-f26f-34ed-af9f-655fd02d8288",
                        "glosses": [
                            "Lehrerin, die für eine ihr zugewiesene Schulklasse (meist über mehrere Jahre) verantwortlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2fbc223-3420-43a3-b996-0585b583ec57",
                                "sense_id": "13ba4b8d-54f3-3325-9571-711291a266cf",
                                "text": "„Aktuell ist sie Klassenlehrerin einer Inklusionsklasse.“"
                            },
                            {
                                "example_id": "2b830fd1-3576-4b51-b055-02eb0575a1dd",
                                "sense_id": "13ba4b8d-54f3-3325-9571-711291a266cf",
                                "text": "„Erst als sich ihm wenige Tage später die Klassenlehrerin der 4a vorstellte und ebenfalls nach seiner Mutter fragte, begann er ernsthaft nachzudenken.“"
                            },
                            {
                                "example_id": "40336788-e62e-44f1-887e-8c5b362943b9",
                                "sense_id": "13ba4b8d-54f3-3325-9571-711291a266cf",
                                "text": "„Während ich mir die Hände wusch und in den Spiegel schaute, erinnerte ich mich daran, wie die Klassenlehrerin damals an meinem Tisch vorbeigegangen und ich unruhig auf dem Stuhl hin und her gerutscht war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
