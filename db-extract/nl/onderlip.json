                                        "entry_id": "3884c9bf-dbc2-3af7-96e0-457ee9fd9a7d",
                                        "glosses": [
                                            "The lower lip."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4c262a5-c856-4fa6-bf58-cbd6b36fbf89",
                                                "sense_id": "6e58d7a4-76b2-374e-984a-26d86aa54dd0",
                                                "text": "He bit his under-lip as though he were somewhat unwilling, but arose."
                                            },
                                            {
                                                "example_id": "be8142e2-a81a-48e1-9c31-9425536cae73",
                                                "sense_id": "6e58d7a4-76b2-374e-984a-26d86aa54dd0",
                                                "text": "His eyes were closed, his mouth opened. His breathing, irregular for three, then four, then five breaths, returned to its normal, soundless rhythm. Stubbled overlip and wet underlip moved about some final, silent word: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc5e9db6-0678-4c01-bb30-cd83bbf6bd7b",
                        "source_entry_id": "89eff3a7-e3ea-35fb-939e-5ce52a135038",
