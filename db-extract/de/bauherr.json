                    {
                        "form_id": "1063c438-ddd6-45fa-a2a2-6fbd4b19b7e5",
                        "entry_id": "fa00ac2c-3e07-3bf6-ad29-feed9d8522d3",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Bauherren"
                    },
                    {
                        "form_id": "18d94999-f790-4e81-afab-3cbcedda3ebc",
                        "entry_id": "fa00ac2c-3e07-3bf6-ad29-feed9d8522d3",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bauherren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1551c057-f931-3a26-9865-4c803f654a24",
                        "entry_id": "fa00ac2c-3e07-3bf6-ad29-feed9d8522d3",
                        "glosses": [
                            "Person oder Instanz, die ein Bauvorhaben in Auftrag gegeben hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a1e54f8-5136-42ff-9932-18cc9d27a543",
                                "sense_id": "1551c057-f931-3a26-9865-4c803f654a24",
                                "text": "„Die BaustellV richtet sich in erster Linie an den Bauherren als Veranlasser des Bauvorhabens.“"
                            },
                            {
                                "example_id": "a04513ef-48ac-49b0-ad73-38e986759401",
                                "sense_id": "1551c057-f931-3a26-9865-4c803f654a24",
                                "text": "„Beim Bauantrag etc. ist \"Bauherr\", wer den Antrag als solcher unterschreibt. “"
                            },
                            {
                                "example_id": "ec715293-0e37-4dff-8869-10027e33ca70",
                                "sense_id": "1551c057-f931-3a26-9865-4c803f654a24",
                                "text": "„Bauherr ist, wer auf seine Verantwortung eine bauliche Maßnahme vorbereitet/ausführt oder vorbereiten/ausführen lässt.“"
                            },
                            {
                                "example_id": "ca0d9349-9e58-447e-8a30-c56b5b9f11ee",
                                "sense_id": "1551c057-f931-3a26-9865-4c803f654a24",
                                "text": "„Unerfahrene Bauherren fallen im Laufe ihres Bauprojektes leicht auf Versuchungen und Irrwege herein.“"
                            },
                            {
                                "example_id": "61f60641-6368-440e-8e33-6a3d530de394",
                                "sense_id": "1551c057-f931-3a26-9865-4c803f654a24",
                                "text": "„Für die Sicherheit auf der Baustelle ist stets der Bauherr verantwortlich, selbst wenn Fremdfirmen das Eigenheim errichten. Der Bauherr haftet für Schäden, die im Zusammenhang mit dem Bau entstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e67beb19-3020-4f14-b6c0-b0070ff14894",
                        "source_entry_id": "fa00ac2c-3e07-3bf6-ad29-feed9d8522d3",
                        "source_sense_id": "1551c057-f931-3a26-9865-4c803f654a24",
