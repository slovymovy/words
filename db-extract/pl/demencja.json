                ],
                "senses": [
                    {
                        "sense_id": "433b2e12-a1d7-3373-93d3-402823e88a49",
                        "entry_id": "718c4251-2638-3e96-968e-0568d52ad787",
                        "glosses": [
                            "utrata zdolności umysłowych organizmu spowodowana chorobą lub starzeniem się"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "379152e6-cb22-40e4-abd1-6a7bc3addac6",
                                "sense_id": "433b2e12-a1d7-3373-93d3-402823e88a49",
                                "text": "Sąd Najwyższy uznał, że generał cierpi na demencję starczą i w związku z tym nie może być sądzony."
                            },
                            {
                                "example_id": "138f70d2-0bc0-4ba7-bdf7-80a7a851709c",
                                "sense_id": "433b2e12-a1d7-3373-93d3-402823e88a49",
                                "text": "Większość trójpierścieniowych leków antydepresyjnych ma silne działanie antycholinergiczne, dlatego ich ordynowanie ludziom starszym cierpiącym także z powodu demencji okazuje się mało użyteczne, a wręcz szkodliwe …"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be209f55-2a12-49ac-bf3f-e8d34617b0bd",
                        "source_entry_id": "718c4251-2638-3e96-968e-0568d52ad787",
                        "source_sense_id": "433b2e12-a1d7-3373-93d3-402823e88a49",
                        "target_lang_word": "dementia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dementia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "076a5735-11b4-3409-8ded-8455a63c0d4b",
                                        "entry_id": "25ad1da9-36b9-3b10-b29c-258226ebbda3",
                                        "glosses": [
                                            "A progressive decline in cognitive function due to damage or disease in the brain beyond what might be expected from normal aging. Areas particularly affected include memory, attention, judgement, language and problem solving."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd0140ad-2205-444f-be1b-69971a80b744",
                                                "sense_id": "076a5735-11b4-3409-8ded-8455a63c0d4b",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems— […]. Such a slow-release device containing angiogenic factors could be placed on the pia mater covering the cerebral cortex and tested in persons with senile dementia in long term studies."
                                            },
                                            {
                                                "example_id": "2788fef5-b4e9-479c-9e1d-921287e3d61a",
                                                "sense_id": "076a5735-11b4-3409-8ded-8455a63c0d4b",
                                                "text": "In recent years some clinical trials involving potential dementia drugs have had disappointing setbacks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7473f8e-1737-36d3-b03f-0f33753e0846",
                                        "entry_id": "25ad1da9-36b9-3b10-b29c-258226ebbda3",
                                        "glosses": [
                                            "Madness or insanity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
