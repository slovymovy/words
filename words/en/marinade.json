{
    "word_family": [
        "marinate",
        "marination"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cf261707-02e4-365c-b5c8-65521eeeab2e",
                    "sense_definition": "A seasoned, often acidic liquid mixture used to soak food to add flavor and prepare it for cooking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I like to use a lemon <w>marinade</w> with chicken.",
                            "target_lang_translations": {
                                "pl": "Lubię używać cytrynowej <w>marynaty</w> do kurczaka."
                            }
                        },
                        {
                            "text": "The chef prepared a spicy <w>marinade</w> for the steak.",
                            "target_lang_translations": {
                                "pl": "Szef kuchni przygotował pikantną <w>marynatę</w> do steka."
                            }
                        }
                    ],
                    "synonyms": [
                        "sauce",
                        "brine"
                    ],
                    "common_phrases": [
                        "tasty marinade",
                        "soak in marinade"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mieszanina przypraw i płynów (często kwaśnych), w której moczy się żywność, aby nadać jej smak i przygotować do obróbki termicznej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "marynata",
                                "target_lang_sense_clarification": "podstawowe określenie na płynną mieszankę przypraw do mięs i warzyw"
                            },
                            {
                                "target_lang_word": "bejca",
                                "target_lang_sense_clarification": "potoczne określenie na zaprawę do marynowania mięs"
                            },
                            {
                                "target_lang_word": "zalewa",
                                "target_lang_sense_clarification": "roztwór używany głównie do konserwowania produktów spożywczych"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c2b979ba-ee41-3fbc-8c33-ef12b1b5b13c",
                    "sense_definition": "To soak food in a seasoned liquid to add flavor.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>marinade</w> the meat for several hours before grilling.",
                            "target_lang_translations": {
                                "pl": "Powinieneś <w>marynować</w> mięso przez kilka godzin przed grillowaniem."
                            }
                        },
                        {
                            "text": "It is best to <w>marinade</w> the fish in the refrigerator.",
                            "target_lang_translations": {
                                "pl": "Najlepiej <w>marynować</w> rybę w lodówce."
                            }
                        }
                    ],
                    "synonyms": [
                        "marinate",
                        "soak",
                        "steep"
                    ],
                    "common_phrases": [
                        "marinade overnight",
                        "marinade the meat"
                    ],
                    "target_lang_definitions": {
                        "pl": "Moczenie żywności w przyprawionej cieczy w celu nadania jej smaku."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "marynować",
                                "target_lang_sense_clarification": "czasownik oznaczający proces moczenia w marynacie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}