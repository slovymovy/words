                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Материк, <w>открытый</w> в семнадцатом веке, был назван Австралией.",
                            "target_lang_translations": {
