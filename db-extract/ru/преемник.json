                "senses": [
                    {
                        "sense_id": "26b52cf8-528f-326e-b979-3af7d66b8499",
                        "entry_id": "6992501d-e9b4-3fc2-b52f-8988cc05f045",
                        "glosses": [
                            "книжн. лицо, получившее или приобретшее от кого-нибудь преемственно какие-нибудь права, какое-нибудь общественное положение, какие-нибудь общественные обязанности"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b2af81b3-83ad-353b-9cd1-fab578fee299",
                        "entry_id": "6992501d-e9b4-3fc2-b52f-8988cc05f045",
                        "glosses": [
                            "книжн. лицо, вступившее на смену кому-нибудь на какое-нибудь место, должность (по отношению к своему предшественнику)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b3c3d1b-d3e9-4030-b67c-bbffcbf16933",
                                "sense_id": "b2af81b3-83ad-353b-9cd1-fab578fee299",
                                "text": "Рекомендовать себе преемника."
                            },
                            {
                                "example_id": "536d6f19-6428-4f29-9a5f-983a1d6b7b59",
                                "sense_id": "b2af81b3-83ad-353b-9cd1-fab578fee299",
                                "text": "Назначить кого-нибудь своим преемником."
                            }
                        ]
                    },
                    {
                        "sense_id": "0513cac8-8b48-3484-9418-0b91d5b383f5",
                        "entry_id": "6992501d-e9b4-3fc2-b52f-8988cc05f045",
                        "glosses": [
                            "книжн. продолжатель чьей-нибудь деятельности, чьих-нибудь традиций"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a31e8ea-68e1-4dd8-bdfa-add435f0ebcd",
                                "sense_id": "0513cac8-8b48-3484-9418-0b91d5b383f5",
                                "text": "Максим Горький — гениальный преемник великих писателей-реалистов 19 века."
                            }
                        ]
                    }
