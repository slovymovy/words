                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86fdb532-640b-4092-81a5-981b0145d30b",
                                "sense_id": "9a00a1d6-8a01-311f-a387-928cea082cd6",
                                "text": "Il paraît certain que les filtres Dumont ajouteront aux services récens qu’ils ont rendus à cette industrie, l’avantage d’éviter l’emploi du sang, et par suite la présence dans les sirops d’une matière organique de plus, étrangère au sucre et caramélisable."
                            },
                            {
                                "example_id": "92f2dcad-191f-48b4-a78a-2f3722a7a974",
                                "sense_id": "9a00a1d6-8a01-311f-a387-928cea082cd6",
                                "text": "Bien que cette assertion soit exacte, car je me suis convaincu de la réalité du fait par plusieurs essais, on ne doit pas nier pourtant l’action du sucre caramélisable dans cette coloration."
                            },
                            {
                                "example_id": "e75edd7a-ee9c-4ea2-853c-fc6e4b2fac35",
                                "sense_id": "9a00a1d6-8a01-311f-a387-928cea082cd6",
                                "text": "Parce qu’en cuisson, le sucre caramélisable peut être cancérigène si la canne est trop cuite."
                            }
                        ]
                    }
