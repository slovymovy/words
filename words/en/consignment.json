                        "new consignment"
                    ]
                },
                {
                    "sense_id": "9b788b43-1b45-329e-9290-628f78abcf2d",
                    "sense_definition": "The practice of selling personal items through a shop that keeps a percentage of the profit while the owner retains ownership until the item is sold.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "retail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to sell her vintage wedding dress on <w>consignment</w> at the local boutique."
                        },
                        {
                            "text": "The store only accepts high-quality designer clothing for <w>consignment</w> sales."
                        }
                    ],
                    "common_phrases": [
