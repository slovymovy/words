                            "superlative"
                        ],
                        "form": "most gleaming"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8e450a86-1d56-387d-bf93-24ba818313b9",
                        "entry_id": "1305533e-b313-3995-b64c-d8755cf53ba8",
                        "glosses": [
                            "Having a bright sheen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bb80b25-8f91-474f-a345-d5e3345c011d",
                                "sense_id": "8e450a86-1d56-387d-bf93-24ba818313b9",
                                "text": "The knight rode into battle with a gleaming sword."
                            },
                            {
                                "example_id": "13314d14-e823-45c1-8f04-6731fb50266a",
                                "sense_id": "8e450a86-1d56-387d-bf93-24ba818313b9",
                                "text": "The city skyline looked beautiful under the gleaming lights."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ce4bf31-1489-4d5c-a5e8-c168a06189d8",
                        "source_entry_id": "1305533e-b313-3995-b64c-d8755cf53ba8",
                        "source_sense_id": "8e450a86-1d56-387d-bf93-24ba818313b9",
                        "source_sense_description": "having a bright sheen",
                        "target_lang_word": "brillant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brillant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e0417bc-da7f-33c9-b947-399bcbc0cab9",
                                        "entry_id": "5e955dda-e167-301d-a5fb-e9b640686cbe",
                                        "glosses": [
                                            "Qui brille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdf6d9e8-776f-4142-a618-7b5ccb94cf67",
                                                "sense_id": "2e0417bc-da7f-33c9-b947-399bcbc0cab9",
                                                "text": "Le lendemain nous sommes déjà loin de Thorshavn, mais les hautes montagnes des Féroë se profilent encore à l’horizon, avec leur brillante auréole neigeuse."
                                            },
                                            {
                                                "example_id": "56c30c34-d90b-4bf1-8714-85922762ec7b",
                                                "sense_id": "2e0417bc-da7f-33c9-b947-399bcbc0cab9",
                                                "text": "Cette partie, appelée passementerie d’or et d’argent, comprenait les épaulettes, les dragonnes, les aiguillettes, enfin cette immense quantité de choses brillantes qui scintillaient sur les riches uniformes de l’armée française et sur les habits civils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05e0d922-5298-3fe3-bb02-70a56b5cf787",
                                        "entry_id": "5e955dda-e167-301d-a5fb-e9b640686cbe",
                                        "glosses": [
                                            "Ce qui frappe vivement et agréablement les regards par le luxe, la pompe, la magnificence."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4edc1219-a532-4c6c-bec0-3598f247ca69",
                                                "sense_id": "05e0d922-5298-3fe3-bb02-70a56b5cf787",
                                                "text": "Une parure brillante. Un spectacle brillant. Un bal brillant. Une fête brillante."
                                            },
                                            {
                                                "example_id": "712f433f-f7aa-4c1d-84f8-a5599f6b67bd",
                                                "sense_id": "05e0d922-5298-3fe3-bb02-70a56b5cf787",
                                                "text": "Une brillante escorte. Le général était entouré d’un brillant état-major."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1d3d2c8-bcbf-3599-a91a-0453ec63415e",
                                        "entry_id": "5e955dda-e167-301d-a5fb-e9b640686cbe",
                                        "glosses": [
                                            "Qualifie ce qui est très remarquable dans son genre ou qui frappe et saisit vivement l’esprit, l’imagination."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27000daf-a599-4917-a1e1-fcdd7652365a",
                                                "sense_id": "f1d3d2c8-bcbf-3599-a91a-0453ec63415e",
                                                "text": "On les savait très drôles et ultraconvaincants sur scène, on a également découvert les Français de Naïve New Beaters brillants songwriters, maîtres dans l’art de composer des tubes — Wallace est un disque bluffant et fourmillant d’influences, entre groove pop et phrasé hip-hop."
                                            },
                                            {
                                                "example_id": "026193bd-478b-4c97-a68b-ee2f88efc52c",
                                                "sense_id": "f1d3d2c8-bcbf-3599-a91a-0453ec63415e",
                                                "text": "À peine se fut-on quitté, que le chevalier de Beauvoisis courut aux informations : elles ne furent pas brillantes."
                                            },
                                            {
                                                "example_id": "ccad2889-509f-4ce1-a978-42d88d85d9ca",
                                                "sense_id": "f1d3d2c8-bcbf-3599-a91a-0453ec63415e",
                                                "text": "Pour le dire sans ambages, une personne brillante fait plus souvent des choses stupides qu'une personne stupide ne fait de choses intelligentes (Reeder & Brewer, 1979)."
                                            },
                                            {
                                                "example_id": "53f7df44-4c34-48ac-b001-ca9cfbc97764",
                                                "sense_id": "f1d3d2c8-bcbf-3599-a91a-0453ec63415e",
                                                "text": "Issu de la bourgeoisie intellectuelle parisienne, Jurgensen est un élève brillant : double lauréat du concours général en latin et en grec, admis à Henri-IV, il entre rue d'Ulm dès sa première tentative en 1937."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85213791-67cd-3f25-9d76-63b9653ac252",
                                        "entry_id": "5e955dda-e167-301d-a5fb-e9b640686cbe",
                                        "glosses": [
                                            "En parlant d'un cheval dans une course, impétueux, allant, qui a l'encolure relevée, qui tire, qui va plus vite que ne le voudrait son cavalier."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "brillant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c4e8586-20ec-364d-843b-3995937e1528",
                                        "entry_id": "42647f53-7c71-36d9-bf01-200957ef0845",
                                        "glosses": [
                                            "Éclat ; lustre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "255c8b49-c9cf-403d-9493-41c8a9d8e689",
                                                "sense_id": "4c4e8586-20ec-364d-843b-3995937e1528",
                                                "text": "Cet apprêt et le brillant qu'on a donné au drap ne seraient pas durables : ce drap se tacherait et se retirerait lorsqu'il viendrait à être mouillé, si on ne le décatissait pas en le faisant passer dans une vapeur humide et sans pression."
                                            },
                                            {
                                                "example_id": "78314ce7-a478-4c2d-83aa-a3ed3968b7bb",
                                                "sense_id": "4c4e8586-20ec-364d-843b-3995937e1528",
                                                "text": "Le brillant d’une pierre précieuse. Ce diamant a plus de brillant que l’autre."
                                            },
                                            {
                                                "example_id": "0271c4e7-1350-4c14-ab62-08af5ab4abcc",
                                                "sense_id": "4c4e8586-20ec-364d-843b-3995937e1528",
                                                "text": "Il y a du brillant dans ce poème."
                                            },
                                            {
                                                "example_id": "a98e7b4b-fcd4-4952-a516-cd2edbb214fe",
                                                "sense_id": "4c4e8586-20ec-364d-843b-3995937e1528",
                                                "text": "Cet homme a plus de brillant que de solide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f659ee0-9822-38e0-9436-69295cc09dcc",
                                        "entry_id": "42647f53-7c71-36d9-bf01-200957ef0845",
                                        "glosses": [
                                            "Diamant taillé à facettes par-dessus et par-dessous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb34998e-65ce-4dca-b680-e2f7e669ec69",
                                                "sense_id": "1f659ee0-9822-38e0-9436-69295cc09dcc",
                                                "text": "Il lui mit aux oreilles deux brillants, qu’il venait de courir acheter, en se rappelant que l’anniversaire de sa naissance tombait ce jour-là."
                                            },
                                            {
                                                "example_id": "2d71bdb8-7e85-488b-a449-4a86a0348043",
                                                "sense_id": "1f659ee0-9822-38e0-9436-69295cc09dcc",
                                                "text": "Rien qu’aux deux fenêtres de leur salon, cent bougies seront allumées, autour de deux reliquaires de bronze en forme de sarcophage. A droite, il y aura en plus un immense crucifix en ébène, avec le Christ en ivoire, et les bouts de croix en argent massif ; et à gauche une statue de la Sainte Vierge en vermeil avec, sur le pied, une rose en brillants."
                                            },
                                            {
                                                "example_id": "611a9588-1693-4cdb-9b3d-c241f9e436cb",
                                                "sense_id": "1f659ee0-9822-38e0-9436-69295cc09dcc",
                                                "text": "Cependant, il se tortillait sur la banquette et, de sa lourde main ornée d'une chevalière et d'un assez joli brillant, promenait le cul de son verre sur le marbre de la table, […]."
                                            },
                                            {
                                                "example_id": "f2928756-3045-48c9-947e-f6fcf0ce5551",
                                                "sense_id": "1f659ee0-9822-38e0-9436-69295cc09dcc",
                                                "text": "Elle décida de vendre une paire de boucles d’oreilles faite de deux beaux brillants taillés en forme de cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "233d72b3-ebfb-36d2-847a-42ef06710097",
                                        "entry_id": "42647f53-7c71-36d9-bf01-200957ef0845",
                                        "glosses": [
                                            "Genre comprenant neuf espèces de petits oiseaux de la famille des trochilidés (e.g. colibris) à plumage très iridescent, vert et ou bleu métallique, à la forme élancée, et habitant les sous-bois des forêts tropicales et subtropicales de l'Amérique latine, de la varzea aux forêts montagneuses des Andes (genre Heliodoxa)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "brillant",
