                        "entry_id": "0f1e0bdc-8a5c-3d58-a90d-8fe798b3275d",
                        "glosses": [
                            "wydzielone pomieszczenie przeznaczone do palenia papierosów, tytoniu (obok miejsc, w których nie wolno palić)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b004f69b-f188-4308-b14f-83cdc8b60002",
                                "sense_id": "ef020aa7-6516-3625-acd6-b6d8416353cc",
                                "text": "Wydaje mi się, że nauczycielki spędzają prawie całe przerwy w palarni."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2ebabb90-276b-35ee-804f-ab3cccfabcdd",
                        "entry_id": "0f1e0bdc-8a5c-3d58-a90d-8fe798b3275d",
                        "glosses": [
                            "miejsce, w którym robi się/wytwarza coś dzięki procesowi palenia"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2a3c1f8-9c61-4a5a-9a0e-43c03adb435f",
                        "source_entry_id": "0f1e0bdc-8a5c-3d58-a90d-8fe798b3275d",
                        "source_sense_id": "ef020aa7-6516-3625-acd6-b6d8416353cc",
                        "target_lang_word": "roasting-room",
