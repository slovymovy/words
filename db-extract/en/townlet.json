                                    },
                                    {
                                        "sense_id": "2758c9e0-b098-398c-bb11-d3416f2fc846",
                                        "entry_id": "635177e7-a54d-38c3-aed7-d75abcee0779",
                                        "glosses": [
                                            "małe miasto"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "779da85b-eba8-46f1-875c-ccb537105a58",
                                                "sense_id": "2758c9e0-b098-398c-bb11-d3416f2fc846",
                                                "text": "W małych miasteczkach i wsiach, stanowiących zdrowe jądro społeczne, ludzie są prości, uczciwi, rzadko Niemcy, najczęściej rodowici Amerykanie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "f37624fe-7ad7-3148-ad38-550fab7435df",
                                        "entry_id": "635177e7-a54d-38c3-aed7-d75abcee0779",
                                        "glosses": [
                                            "prawno-administracyjna jednostka osadnicza o charakterze przejściowym między miastem a wsią"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd62694b-254a-40e1-aeab-d39013e8682c",
                        "source_entry_id": "5cda1c8b-e032-31c9-b9d7-51c3f8ec3e8e",
                        "source_sense_id": "db54526a-54eb-3687-9a3c-448b476ad4a4",
                        "source_sense_description": "small town",
                        "target_lang_word": "городо́к",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "городо́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fe398bee-027d-3d92-b71a-8f3c4834b5c1",
                                        "entry_id": "c3fd8dd4-62e9-3a6d-9baa-669574f6cc4a",
                                        "glosses": [
                                            "уменьш. к город; небольшой город"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "769bd6bf-dbef-428b-acf9-034c2d5c47ac",
                                                "sense_id": "fe398bee-027d-3d92-b71a-8f3c4834b5c1",
                                                "text": "Ах, Самара-городок, // Беспокойная я, // Беспокойная я, // Успокой ты меня!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7473472c-5153-34b0-9958-57b2666f5d3f",
                                        "entry_id": "c3fd8dd4-62e9-3a6d-9baa-669574f6cc4a",
                                        "glosses": [
                                            "комплекс отдельно расположенных зданий, сооружений общего назначения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "997f56b9-48c6-44dd-9607-7604ad12a1a6",
                                                "sense_id": "7473472c-5153-34b0-9958-57b2666f5d3f",
                                                "text": "Студенческий городок университета в Петродворце находится на расстоянии нескольких сот метров от учебных корпусов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb8ab394-e957-3100-bebb-6f4ba21b82a8",
                                        "entry_id": "c3fd8dd4-62e9-3a6d-9baa-669574f6cc4a",
                                        "glosses": [
                                            "спорт. небольшой деревянный столбик для игры в городки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94b5f8c2-3fa4-4b74-818d-65e030f19518",
                                                "sense_id": "bb8ab394-e957-3100-bebb-6f4ba21b82a8",
                                                "text": "В этом случае бита игроку не возвращается, а возвратившийся в «город» выбитый городок убирают."
                                            },
                                            {
                                                "example_id": "81676bca-bc0a-48f3-b821-ffad55ada55d",
                                                "sense_id": "bb8ab394-e957-3100-bebb-6f4ba21b82a8",
                                                "text": "— Ура! — закричала она после пятого броска, когда два городка от пушки были выбиты."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2fcee6f-68ce-4005-ad9a-967e130d97a4",
                        "source_entry_id": "5cda1c8b-e032-31c9-b9d7-51c3f8ec3e8e",
                        "source_sense_id": "db54526a-54eb-3687-9a3c-448b476ad4a4",
                        "source_sense_description": "small town",
                        "target_lang_word": "посёлок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "посёлок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9e34dd88-d949-3c6b-b3c0-eb4ddbf81a30",
                                        "entry_id": "3937df6e-bc6f-39f0-9eb8-9b8a66bd2f93",
                                        "glosses": [
                                            "сравнительно небольшой населённый пункт с простой административной и хозяйственной структурой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58b5a812-4940-4a63-a15b-a5173b0720cc",
                                                "sense_id": "9e34dd88-d949-3c6b-b3c0-eb4ddbf81a30",
                                                "text": "Это был посёлок за городом, на голом, без деревца, без кустика, низком месте."
                                            },
                                            {
                                                "example_id": "42766ebf-c2b1-43b9-8565-e2dd75c1b362",
                                                "sense_id": "9e34dd88-d949-3c6b-b3c0-eb4ddbf81a30",
                                                "text": "В полутора верстах от шоссейного поворота <..> расположился маленький посёлок, состоящий из нескольких постоялых дворов."
                                            },
                                            {
                                                "example_id": "47bb0ff5-edd6-49f9-b63d-0fee89c5080b",
                                                "sense_id": "9e34dd88-d949-3c6b-b3c0-eb4ddbf81a30",
                                                "text": "На посёлке лыжному отряду отвели не палатку, вроде той, в которой мы жили, а единственное в посёлке рубленое здание — баню."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8e1779b-2b2c-4455-8dfe-0b6f8a44a6d3",
                        "source_entry_id": "5cda1c8b-e032-31c9-b9d7-51c3f8ec3e8e",
                        "source_sense_id": "db54526a-54eb-3687-9a3c-448b476ad4a4",
                        "source_sense_description": "small town",
                        "target_lang_word": "месте́чко",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "месте́чко",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "72fa7f8a-f067-3dc7-a69f-f779c0774ca5",
                                        "entry_id": "ed3672e3-162f-325e-8e19-95286f009d02",
                                        "glosses": [
                                            "уменьш.-ласк. к место"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67769c9f-039d-4005-8536-7c77d4060893",
                                                "sense_id": "72fa7f8a-f067-3dc7-a69f-f779c0774ca5",
                                                "text": "Я сидел на низенькой скамеечке под широким, кустом бузины; я любил это местечко: оттуда было видно окно Зинаидиной комнаты."
                                            },
                                            {
                                                "example_id": "40f36fc2-40ac-4727-901b-c35259004763",
                                                "sense_id": "72fa7f8a-f067-3dc7-a69f-f779c0774ca5",
                                                "text": "Как только он скрывался в дверь, я обнимала Катю, с которою мы стояли у фортепияно, и начинала целовать её в любимое моё местечко, в пухлую шею под подбородок; как только он возвращался, я делала как будто серьезное лицо и насилу удерживалась от смеха."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "месте́чко",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d6c676a8-96e4-39af-a1a1-f3d32d327801",
                                        "entry_id": "21ddab64-b2fc-3c6d-94ff-edbfc3f737a7",
                                        "glosses": [
                                            "истор. небольшое селение, посёлок (обычно в Речи Посполитой, Украине, Белоруссии и в пограничных с ними областях)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4942f17-6cf6-43f0-b436-4cecf7811b59",
                                                "sense_id": "d6c676a8-96e4-39af-a1a1-f3d32d327801",
                                                "text": "Ежели по близости следования отрядов находиться будут в местечках и открытых городах военные и провиантские запасы, таковые истреблять."
                                            },
                                            {
                                                "example_id": "a3b8abe2-f2bf-436c-b933-7d05760014cf",
                                                "sense_id": "d6c676a8-96e4-39af-a1a1-f3d32d327801",
                                                "text": "Киселин — местечко, имеющее до 100 дворов, Владимерского повета, лежит на болоте."
                                            },
                                            {
                                                "example_id": "8d9d9343-8b20-4a5d-b5c2-6206a29e579f",
                                                "sense_id": "d6c676a8-96e4-39af-a1a1-f3d32d327801",
                                                "text": "А Тарас гулял по всей Польше с своим полком, выжег восемнадцать местечек, близь сорока костелов и уже доходил до Кракова."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6fc833a-cf03-4629-83e0-5094968bef29",
                        "source_entry_id": "5cda1c8b-e032-31c9-b9d7-51c3f8ec3e8e",
                        "source_sense_id": "db54526a-54eb-3687-9a3c-448b476ad4a4",
                        "source_sense_description": "small town",
                        "target_lang_word": "городи́шко",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "городи́шко",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "127e2454-7da9-3298-96e1-6b57c78be343",
                                        "entry_id": "88d9ddec-29c2-3e7b-b42b-ba1675e70ef8",
                                        "glosses": [
                                            "пренебр. небольшой город."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19345a9e-ae24-447c-8f9a-846f8e9f2807",
                                                "sense_id": "127e2454-7da9-3298-96e1-6b57c78be343",
                                                "text": "Тамань - самый скверный городишко из всех приморских городов России."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
