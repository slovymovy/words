{
    "word_family": [
        "agree",
        "disagree",
        "agreement",
        "agreeable",
        "disagreeable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9432c4c-0873-3952-9117-89dfe6b37a9d",
                    "sense_definition": "An argument or debate between people with different views.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "conflict_instance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had a bit of a <w>disagreement</w> about what color to paint the bedroom.",
                            "target_lang_translations": {
                                "ru": "У них вышло небольшое <w>разногласие</w> насчет того, в какой цвет покрасить спальню.",
                                "zh": "关于卧室该刷什么颜色，他们产生了一点<w>分歧</w>。",
                                "es": "Tuvieron un pequeño <w>desacuerdo</w> sobre de qué color pintar el dormitorio."
                            }
                        },
                        {
                            "text": "We need to settle this <w>disagreement</w> calmly before we can move forward with the project.",
                            "target_lang_translations": {
                                "ru": "Нам нужно спокойно уладить это <w>разногласие</w>, прежде чем мы сможем продолжить работу над проектом.",
                                "zh": "在推进项目之前，我们需要冷静地解决这个<w>争论</w>。",
                                "es": "Necesitamos resolver este <w>desacuerdo</w> con calma antes de poder avanzar con el proyecto."
                            }
                        }
                    ],
                    "synonyms": [
                        "argument",
                        "dispute",
                        "quarrel",
                        "conflict"
                    ],
                    "antonyms": [
                        "agreement",
                        "accord"
                    ],
                    "common_phrases": [
                        "have a disagreement",
                        "settle a disagreement",
                        "minor disagreement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спор или дискуссия между людьми с разными взглядами.",
                        "zh": "人与人之间因观点不同而产生的争论或辩论。",
                        "es": "Una discusión o debate entre personas con diferentes puntos de vista."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разногласие",
                                "target_lang_sense_clarification": "спор, расхождение во мнениях"
                            },
                            {
                                "target_lang_word": "спор",
                                "target_lang_sense_clarification": "словесное состязание, конфликт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "争论",
                                "target_lang_sense_clarification": "指因意见不合而进行的辩论或争吵"
                            },
                            {
                                "target_lang_word": "分歧",
                                "target_lang_sense_clarification": "指在观点或立场上的不一致"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "desacuerdo",
                                "target_lang_sense_clarification": "discrepancia en ideas o falta de acuerdo"
                            },
                            {
                                "target_lang_word": "desavenencia",
                                "target_lang_sense_clarification": "discordia o falta de entendimiento entre personas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12ba2aa5-80d9-3742-adf5-8fdc506665fb",
                    "sense_definition": "A condition of not agreeing, holding different opinions, or failing to correspond.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "state_of_differing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two sides were in <w>disagreement</w> regarding the final terms of the contract.",
                            "target_lang_translations": {
                                "ru": "Между двумя сторонами возникло <w>разногласие</w> относительно окончательных условий контракта.",
                                "zh": "双方在合同的最终条款上存在<w>不一致</w>。",
                                "es": "Las dos partes estaban en <w>desacuerdo</w> respecto a los términos finales del contrato."
                            }
                        },
                        {
                            "text": "There is considerable <w>disagreement</w> among experts on how to solve this problem.",
                            "target_lang_translations": {
                                "ru": "Среди экспертов существует значительное <w>несогласие</w> по поводу того, как решить эту проблему.",
                                "zh": "专家们对于如何解决这个问题存在相当大的<w>异议</w>。",
                                "es": "Existe un <w>desacuerdo</w> considerable entre los expertos sobre cómo resolver este problema."
                            }
                        }
                    ],
                    "synonyms": [
                        "dissent",
                        "variance",
                        "difference"
                    ],
                    "antonyms": [
                        "agreement",
                        "consensus",
                        "harmony"
                    ],
                    "common_phrases": [
                        "in disagreement",
                        "express disagreement",
                        "strong disagreement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние отсутствия согласия, наличие разных мнений или несоответствие.",
                        "zh": "指意见不一致、持有不同看法或事物之间不相符的状态。",
                        "es": "Estado de falta de acuerdo, tener opiniones diferentes o falta de correspondencia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несогласие",
                                "target_lang_sense_clarification": "отсутствие согласия, отказ"
                            },
                            {
                                "target_lang_word": "разногласие",
                                "target_lang_sense_clarification": "отсутствие единства во мнениях"
                            },
                            {
                                "target_lang_word": "несоответствие",
                                "target_lang_sense_clarification": "отсутствие совпадения, противоречие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不一致",
                                "target_lang_sense_clarification": "指状态或意见上的不吻合"
                            },
                            {
                                "target_lang_word": "异议",
                                "target_lang_sense_clarification": "指对某事持有的不同意见"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "desacuerdo",
                                "target_lang_sense_clarification": "falta de conformidad o discrepancia"
                            },
                            {
                                "target_lang_word": "desencuentro",
                                "target_lang_sense_clarification": "falta de coincidencia o entendimiento"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}