{
    "word_family": [
        "invert",
        "inversion",
        "inverted"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "52ceb969-f832-3560-9765-4438870f4af6",
                    "sense_definition": "A device or mechanism that reverses the position, order, or direction of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanical <w>inverter</w> changed the direction of the rotating shaft.",
                            "target_lang_translations": {
                                "zh": "这个机械<w>反向器</w>改变了旋转轴的方向。"
                            }
                        },
                        {
                            "text": "Engineers designed a specialized <w>inverter</w> to flip the orientation of the heavy metal plates.",
                            "target_lang_translations": {
                                "zh": "工程师设计了一种专门的<w>倒置器</w>来翻转重型金属板的方向。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reverser"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种改变某物位置、顺序或方向的装置或机构。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "反向器",
                                "target_lang_sense_clarification": "用于改变机械运动方向或顺序的装置。"
                            },
                            {
                                "target_lang_word": "倒置器",
                                "target_lang_sense_clarification": "用于将物体翻转或改变其朝向的设备。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66ef675e-1fb7-371d-a5e0-9919d964a25e",
                    "sense_definition": "An electrical device that converts direct current into alternating current.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We installed a power <w>inverter</w> in the van to charge our laptops while camping.",
                            "target_lang_translations": {
                                "zh": "我们在货车里安装了一个电源<w>逆变器</w>，以便露营时给笔记本电脑充电。"
                            }
                        },
                        {
                            "text": "The solar panel system requires a high-quality <w>inverter</w> to supply electricity to the house.",
                            "target_lang_translations": {
                                "zh": "太阳能电池板系统需要一个高质量的<w>逆变器</w>来为房屋供电。"
                            }
                        }
                    ],
                    "synonyms": [
                        "power-inverter"
                    ],
                    "common_phrases": [
                        "power inverter"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种将直流电转换为交流电的电气设备。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "逆变器",
                                "target_lang_sense_clarification": "电力电子设备，用于直流转交流。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}