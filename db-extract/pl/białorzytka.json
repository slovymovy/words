                    {
                        "translation_id": "ffb876ff-6eae-4c65-bf98-5bc2988546b5",
                        "source_entry_id": "c26659cd-09e3-3da8-be48-767535e6c341",
                        "source_sense_id": "3c9b3950-b2be-3872-bfe6-a366f926425d",
