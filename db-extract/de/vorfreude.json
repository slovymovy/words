                        ],
                        "form": "die Vorfreude"
                    },
                    {
                        "form_id": "2f958762-fe1e-427d-91a7-6895a932faab",
                        "entry_id": "839ea9bb-0c7e-3284-9cd0-b96102edd30f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Vorfreuden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c83a4e5-f72e-3233-802c-0053520477cd",
                        "entry_id": "839ea9bb-0c7e-3284-9cd0-b96102edd30f",
                        "glosses": [
                            "heitere Stimmung in Erwartung eines positiven Ereignisses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "727918e3-4b56-46f8-8af8-0a6b60b54aa7",
                                "sense_id": "9c83a4e5-f72e-3233-802c-0053520477cd",
                                "text": "„Dazu machte die Vorfreude der Frau auf die Bezahlung sie dann doch wieder so glücklich, daß wir es dabei beließen, und sie ging hinaus aus dem Haus zu ihrer Schwester.“"
                            },
                            {
                                "example_id": "7ce1be33-d505-4ad8-a91b-0336675d3eb6",
                                "sense_id": "9c83a4e5-f72e-3233-802c-0053520477cd",
                                "text": "Die Vorfreude auf den Urlaub war groß."
                            },
                            {
                                "example_id": "76d54fbd-41bf-484d-8d58-b34737a86119",
                                "sense_id": "9c83a4e5-f72e-3233-802c-0053520477cd",
                                "text": "„Als bald darauf die Schule wieder begann, blieben die Schuhe jedoch erst mal im Schrank stehen und ich machte mich voller Vorfreude auf den Weg.“"
                            },
                            {
                                "example_id": "4b076ca9-338c-48c4-9487-fc2ae7e1f982",
                                "sense_id": "9c83a4e5-f72e-3233-802c-0053520477cd",
                                "text": "„Doch die Vorfreude trieb mich weiter vorwärts.“"
                            },
                            {
                                "example_id": "88fa29cf-daa0-4025-8d28-eed489251e40",
                                "sense_id": "9c83a4e5-f72e-3233-802c-0053520477cd",
                                "text": "„Vielleicht war es Ausdruck von Angst oder Vorfreude, vielleicht zeigte es aber auch nur, wie aufgeregt wir alle waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edee0410-f2f7-450f-a0d4-0f830545c51c",
                        "source_entry_id": "839ea9bb-0c7e-3284-9cd0-b96102edd30f",
                        "source_sense_id": "9c83a4e5-f72e-3233-802c-0053520477cd",
                        "source_sense_description": "heitere Stimmung in Erwartung eines positiven Ereignisses",
                        "target_lang_word": "anticipation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anticipation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c76d335d-a577-3f85-8eca-6e392c6cd0ba",
                                        "entry_id": "fd487f7a-cf42-3f1c-a0e1-d9ba0302c740",
                                        "glosses": [
                                            "The act of anticipating, taking up, placing, or considering something beforehand, or before the proper time in natural order."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "582db5ec-ec16-488a-8b03-d66907b076cf",
                                                "sense_id": "c76d335d-a577-3f85-8eca-6e392c6cd0ba",
                                                "text": "Often the anticipation of a shot is worse than the pain of the stick."
                                            },
                                            {
                                                "example_id": "214b9e46-d007-4360-b287-f5a6550a3e19",
                                                "sense_id": "c76d335d-a577-3f85-8eca-6e392c6cd0ba",
                                                "text": "So shall my anticipation prevent your discovery, and your secrecy to the king and queen moult no feather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7915bf5a-e95c-35fd-b3e8-1d903e1ca6a4",
                                        "entry_id": "fd487f7a-cf42-3f1c-a0e1-d9ba0302c740",
                                        "glosses": [
                                            "The eagerness associated with waiting for something to occur."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbac29ec-01e6-4ce1-854d-de9d946f618e",
                                                "sense_id": "7915bf5a-e95c-35fd-b3e8-1d903e1ca6a4",
                                                "text": "He waited with great anticipation for Christmas to arrive."
                                            },
                                            {
                                                "example_id": "53937500-9811-43cf-bb4d-ddaf762efe5c",
                                                "sense_id": "7915bf5a-e95c-35fd-b3e8-1d903e1ca6a4",
                                                "text": "He waited in anticipation of the arrival of Christmas."
                                            },
                                            {
                                                "example_id": "3c94557b-93d5-46f0-8006-f37d9cd365e3",
                                                "sense_id": "7915bf5a-e95c-35fd-b3e8-1d903e1ca6a4",
                                                "text": "November 20, 1836, Samuel Thodey, The Honour Attached to Eminent Piety and Usefulness\nanticipation of that final hour which he had long contemplated as near at hand"
                                            },
                                            {
                                                "example_id": "43358eb9-558a-4669-adf0-6a39f8d34a0c",
                                                "sense_id": "7915bf5a-e95c-35fd-b3e8-1d903e1ca6a4",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again;[…]. Now she had come to look upon the matter in its true proportions, and her anticipation of a possible chance of teaching him a lesson was a pleasure to behold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "567045f9-88d8-349a-a5ba-fdea7aeef37d",
                                        "entry_id": "fd487f7a-cf42-3f1c-a0e1-d9ba0302c740",
                                        "glosses": [
                                            "Prepayment of a debt, generally in order to pay less interest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f81b37ab-d899-37cd-bdf2-7b89d6121a0f",
                                        "entry_id": "fd487f7a-cf42-3f1c-a0e1-d9ba0302c740",
                                        "glosses": [
                                            "Prolepsis."
                                        ],
