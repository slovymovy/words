{
    "word_family": [
        "prolongation",
        "prolonged"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bcd43daf-8337-3877-99de-e21f93f0c25f",
                    "sense_definition": "To lengthen in time; to extend the duration of",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extend_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Taking this medication can <w>prolong</w> life and improve the overall quality of living for patients.",
                            "target_lang_translations": {
                                "ru": "Прием этого лекарства может <w>продлить</w> жизнь и улучшить общее качество жизни пациентов."
                            }
                        },
                        {
                            "text": "We do not want to <w>prolong</w> the meeting unnecessarily, so let us make a quick decision.",
                            "target_lang_translations": {
                                "ru": "Мы не хотим излишне <w>затягивать</w> встречу, поэтому давайте примем быстрое решение."
                            }
                        }
                    ],
                    "synonyms": [
                        "draw out"
                    ],
                    "common_phrases": [
                        "prolong the meeting",
                        "prolong life"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличивать срок действия, делать более длительным во времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продлевать",
                                "target_lang_sense_clarification": "делать более длительным во времени"
                            },
                            {
                                "target_lang_word": "продлить",
                                "target_lang_sense_clarification": "сделать более длительным во времени (сов. вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f84cb48f-8cf4-39b8-a8f8-3ea2c1413e90",
                    "sense_definition": "To put off to a distant time; to postpone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "postpone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government shouldn't <w>prolong</w> deciding on this issue any further.",
                            "target_lang_translations": {
                                "ru": "Правительству не следует больше <w>откладывать</w> решение по этому вопросу."
                            }
                        },
                        {
                            "text": "They chose to <w>prolong</w> the final decision until more data became available next month.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>отложить</w> окончательное решение до тех пор, пока в следующем месяце не появится больше данных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prolong the decision"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переносить на более поздний срок; откладывать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откладывать",
                                "target_lang_sense_clarification": "переносить на более поздний срок"
                            },
                            {
                                "target_lang_word": "отложить",
                                "target_lang_sense_clarification": "перенести на более поздний срок (сов. вид)"
                            },
                            {
                                "target_lang_word": "затягивать",
                                "target_lang_sense_clarification": "медлить с принятием решения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9d617dd-e985-3eea-923b-541714dd162f",
                    "sense_definition": "To extend in space or length.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "extend_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect decided to <w>prolong</w> the veranda to provide more shade for the house.",
                            "target_lang_translations": {
                                "ru": "Архитектор решил <w>продлить</w> веранду, чтобы обеспечить больше тени для дома."
                            }
                        },
                        {
                            "text": "If you <w>prolong</w> the line on the map, you will see it intersects with the main highway.",
                            "target_lang_translations": {
                                "ru": "Если вы <w>продолжите</w> линию на карте, то увидите, что она пересекается с главным шоссе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prolong the line"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличивать в длину, продлевать в пространстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продлевать",
                                "target_lang_sense_clarification": "делать длиннее в пространстве"
                            },
                            {
                                "target_lang_word": "продлить",
                                "target_lang_sense_clarification": "сделать длиннее в пространстве (сов. вид)"
                            },
                            {
                                "target_lang_word": "продолжать",
                                "target_lang_sense_clarification": "вести линию дальше"
                            },
                            {
                                "target_lang_word": "продолжить",
                                "target_lang_sense_clarification": "провести линию дальше (сов. вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e643579d-8033-3d22-9844-3b473b9a7e41",
                    "sense_definition": "To become longer; lengthen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "extend_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the shadows <w>prolong</w> in the late afternoon, the temperature begins to drop quickly.",
                            "target_lang_translations": {
                                "ru": "По мере того как ближе к вечеру тени <w>удлиняются</w>, температура начинает быстро падать."
                            }
                        },
                        {
                            "text": "The notes of the organ seemed to <w>prolong</w> through the empty halls of the cathedral.",
                            "target_lang_translations": {
                                "ru": "Звуки органа, казалось, <w>растягивались</w> по пустым залам собора."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться длиннее, удлиняться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удлиняться",
                                "target_lang_sense_clarification": "становиться длиннее"
                            },
                            {
                                "target_lang_word": "продлеваться",
                                "target_lang_sense_clarification": "длиться дольше, затягиваться"
                            },
                            {
                                "target_lang_word": "растягиваться",
                                "target_lang_sense_clarification": "о звуках или тенях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}