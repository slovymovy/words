                        "form": "рачи́тельна"
                    },
                    {
                        "form_id": "3fac165e-8a2a-421e-8459-914998fc454a",
                        "entry_id": "8859aed6-6241-3835-8c42-4964d07158ac",
                        "tags": [
                            "plural",
