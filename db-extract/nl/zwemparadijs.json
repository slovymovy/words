                        "examples": [
                            {
                                "example_id": "e9450670-694a-4de0-bab6-cd0b09c3fef7",
                                "sense_id": "16015cfa-dfd9-3771-9ec5-7a8093ef44fa",
                                "text": "Vaak hebben alleen dichtbevolkte gebieden een zwemparadijs."
                            },
                            {
                                "example_id": "1fd87369-112b-4f2e-9e23-7f337ebce7e4",
                                "sense_id": "16015cfa-dfd9-3771-9ec5-7a8093ef44fa",
                                "text": "Maar na een bezoek aan het warenhuis of de keukendesignwinkel, de makelaar of het zwemparadijs moeten we maar al te vaak stilletjes toegeven dat ons alweer een wezenlijke genotsbeleving door de vingers is geglipt en dat we, alles welbeschouwd, misschien wel in de stemming zijn om een potje te janken."
                            }
                        ]
