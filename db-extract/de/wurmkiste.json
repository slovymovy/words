                ],
                "senses": [
                    {
                        "sense_id": "071f5730-e89e-36e8-ad5a-7d2dec12e188",
                        "entry_id": "84a37912-3c86-3e47-9345-8aa44abc68c4",
                        "glosses": [
                            "Behälter (meist aus Holz), der der Gewinnung von Kompost aus Küchenabfällen eines Haushalts mit Hilfe von Kompostwürmern (sowie Pilzen und Bakterien) dient"
                        ],
                        "tags": [
                            "Gärtnern"
                        ],
                        "examples": [
                            {
                                "example_id": "37c042f1-c0e9-42ce-bd1d-185aa2b469b2",
                                "sense_id": "071f5730-e89e-36e8-ad5a-7d2dec12e188",
                                "text": "„Im Gegensatz zum Komposthaufen lassen sich Wurmkisten im Garten, auf dem Balkon oder im Keller aufstellen.“"
                            },
                            {
                                "example_id": "0869c96a-7221-4ee4-b6f7-882f25f39b72",
                                "sense_id": "071f5730-e89e-36e8-ad5a-7d2dec12e188",
                                "text": "„Wurmkisten gibt es zwar auch fertig zu kaufen, aber Selberbauen macht nicht nur mehr Spaß, es ist auch preiswerter.“"
                            },
                            {
                                "example_id": "7242a426-5da2-4ef4-8b90-a70ec8476608",
                                "sense_id": "071f5730-e89e-36e8-ad5a-7d2dec12e188",
                                "text": "„Der \"Eisenia fetida\" oder auch \"Eisenia Foetida\" bzw. früher \"Dendrobaena\" genannte Mistwurm wird am häufigsten in Wurmkisten gehalten.“"
                            },
                            {
                                "example_id": "2c9a2c16-2a69-4dd2-8fbb-8a55d2febf1a",
                                "sense_id": "071f5730-e89e-36e8-ad5a-7d2dec12e188",
                                "text": "„Es wimmelt und wuselt in der Wurmkiste von Brigitte Goss. Viele Tausend Würmer machen sich über das frisch eingeworfene Grün her, zersetzen es und schaffen dabei einen hervorragenden Pflanzendünger.“"
                            },
                            {
                                "example_id": "16df9b7f-39e4-4172-bbca-75d0ca987e60",
                                "sense_id": "071f5730-e89e-36e8-ad5a-7d2dec12e188",
                                "text": "„Wer keinen Platz für einen Komposthaufen hat, kann sich mit einer Wurmkiste […] weiterhelfen.“"
                            },
                            {
                                "example_id": "1b93a921-f430-4de4-ad62-4685dd2b17e9",
                                "sense_id": "071f5730-e89e-36e8-ad5a-7d2dec12e188",
                                "text": "„Auch Balkon- und Stadtgärtner mit wenig Platz können Küchenabfälle kompostieren. In einer Wurmkiste verwandeln diese sich in feinsten Humus.“"
                            },
                            {
                                "example_id": "3279ed28-0a3b-4427-99a2-da8f948b605b",
                                "sense_id": "071f5730-e89e-36e8-ad5a-7d2dec12e188",
                                "text": "„Die Grundidee der Wurmkiste ist einfach: Küchenabfälle werden von Würmern gefressen und ausgeschieden - das ergibt wunderbaren Wurmhumus.“"
                            },
                            {
                                "example_id": "a429e83e-decd-4fe8-8ab9-4db50c2aa456",
                                "sense_id": "071f5730-e89e-36e8-ad5a-7d2dec12e188",
                                "text": "Wurmkisten sollten idealerweise draußen im Schatten stehen. Allerdings dürfen die Würmer im Winter nicht erfrieren. Daher sollte die Wurmkiste bei unter 5 Grad Celsius vor Kälte geschützt werden. Stellen Sie sie dafür z.B. in eine Garage oder den Keller. Wurmkisten sollten nicht in Wohnräumen gelagert werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
