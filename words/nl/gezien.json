                    "sense_id": "a1fcc375-25e3-366e-a3fc-db7ddcb5f699",
                    "sense_definition": "voltooid deelwoord van <w>zien</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb die film gisteren met mijn vrienden in de bioscoop <w>gezien</w>.",
                            "target_lang_translations": {
                                "en": "I <w>seen</w> that movie with my friends at the cinema yesterday.",
                                "ru": "Я <w>видел</w> этот фильм вчера с друзьями в кинотеатре.",
                                "it": "Ieri ho <w>visto</w> quel film al cinema con i miei amici."
                            }
                        },
                        {
                            "text": "Waarom had ik geen donder gehoord of bliksem <w>gezien</w> tijdens mijn tocht omhoog?",
                            "target_lang_translations": {
                                "en": "Why had I heard no thunder or <w>seen</w> any lightning during my trek up?",
                                "ru": "Почему я не слышал грома и не <w>видел</w> молнии во время моего восхождения?",
                                "it": "Perché non avevo sentito tuoni né <w>visto</w> fulmini durante la mia salita?"
                            }
                        }
                    ],
                    "antonyms": [
                        "ongezien"
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of the verb 'to see'",
                        "ru": "причастие прошедшего времени от глагола 'видеть'",
                        "it": "participio passato del verbo 'vedere'"
