                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ded65bce-02ae-4ded-85e4-e8b40abe8b25",
                                "sense_id": "c9e35221-f8cd-3c97-a193-8ef563b97408",
                                "text": "Однажды я все-таки почему-то нацепил галстук и пришел в нем на лекцию."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4638e94-bd3d-4146-ac3b-948285b6599c",
                        "source_entry_id": "48d4ec4a-1ff8-3cd5-9e5a-96bcaa901e92",
                        "source_sense_description": "цепляя, навесить на что-либо, закрепить на чём-либо",
                        "target_lang_word": "fasten",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fasten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b608215c-c770-3f6e-b476-4c8ffc184910",
                                        "entry_id": "686b39b9-2167-380a-80c1-434b07803a0f",
                                        "glosses": [
                                            "To attach or connect in a secure manner."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eb0ab0b-fcb3-4994-866b-27ef48afd828",
                                                "sense_id": "b608215c-c770-3f6e-b476-4c8ffc184910",
                                                "text": "The sailor fastened the boat to the dock with a half-hitch."
                                            },
                                            {
                                                "example_id": "021939a3-f180-4d86-8424-467593551f52",
                                                "sense_id": "b608215c-c770-3f6e-b476-4c8ffc184910",
                                                "text": "Fasten your seat belts!"
                                            },
                                            {
                                                "example_id": "0c1de8bb-5a21-403b-9040-c4a78d0ba819",
                                                "sense_id": "b608215c-c770-3f6e-b476-4c8ffc184910",
                                                "text": "Can you fasten these boards together with some nails?"
                                            },
                                            {
                                                "example_id": "f0ae6528-4fe0-4931-a57c-046a23ac9e26",
                                                "sense_id": "b608215c-c770-3f6e-b476-4c8ffc184910",
                                                "text": "The words Whig and Tory have been pressed to the service of many successions of parties, with very different ideas fastened to them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cfa23f7-28de-3149-9250-763cd4d1f3ff",
                                        "entry_id": "686b39b9-2167-380a-80c1-434b07803a0f",
                                        "glosses": [
                                            "To cause to take close effect; to make to tell; to land."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c88cfc5f-cc09-4cb7-994f-355a5d4f80c6",
                                                "sense_id": "7cfa23f7-28de-3149-9250-763cd4d1f3ff",
                                                "text": "to fasten a blow"
                                            },
                                            {
                                                "example_id": "33803c86-a8d6-4670-bf91-d797c0e50a70",
                                                "sense_id": "7cfa23f7-28de-3149-9250-763cd4d1f3ff",
                                                "text": "if I can fasten but one cup upon him"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ebacffa-f365-4ca6-aefc-71d89155c2f0",
                        "source_entry_id": "48d4ec4a-1ff8-3cd5-9e5a-96bcaa901e92",
                        "source_sense_description": "цепляя, навесить на что-либо, закрепить на чём-либо",
