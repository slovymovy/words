                        "entry_id": "363ea188-6493-3ec4-b5d2-95ffbc66807b",
                        "glosses": [
                            "een systeem dat in geval van nood in werking treedt, een systeem dat het werk overneemt als het reguliere systeem uitvalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b4ddfbb-2a27-4ee4-b87d-2106bee821d6",
                                "sense_id": "ed57bf75-cec6-3c91-8901-7ec28db5aa23",
                                "text": "Opnieuw komt Schiphol niet ongeschonden een meivakantie door. De luchthaven heeft zijn noodsystemen niet op orde; niet voor het eerst."
                            },
                            {
                                "example_id": "0073108c-e92d-40a7-bd21-0d1ea2e404db",
                                "sense_id": "ed57bf75-cec6-3c91-8901-7ec28db5aa23",
                                "text": "Terwijl er een test werd uitgevoerd op de noodgeneratoren, is overspanning ontstaan', aldus Dehaene. 'Die heeft zowel de operationele systemen als het noodsysteem onklaar gemaakt.'"
                            },
                            {
                                "example_id": "ef493de0-d7bf-4343-80a2-bbe41be11be9",
                                "sense_id": "ed57bf75-cec6-3c91-8901-7ec28db5aa23",
                                "text": "Tevens is de auto voorzien van speciale luchtventilatie bij een gasaanval en de Superb heeft een noodsysteem om te ontsnappen, waarover de makers verder niets willen zeggen."
                            }
                        ]
                    }
