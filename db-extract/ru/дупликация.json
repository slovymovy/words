                    {
                        "translation_id": "89966013-a8ae-4424-a627-d5a222922c92",
                        "source_entry_id": "e515322e-55dd-3f28-9ba4-debfd451305d",
                        "target_lang_word": "Duplikation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Duplikation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e171ada3-cd64-30ad-b897-302e7e744a13",
                                        "entry_id": "ab93569f-0908-34ca-afba-9a60d764955b",
                                        "glosses": [
                                            "Vorgang, etwas doppelt zu machen"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "379d2576-d7ce-4e36-bb96-d51c2b287b3d",
                                                "sense_id": "e171ada3-cd64-30ad-b897-302e7e744a13",
                                                "text": "„Als Subsystem der Gesellschaft kann die Wirtschaft erst dadurch entstehen, daß auf den ersten Schritt der Entparadoxierung des Knappheitsproblems durch das Eigentum ein zweiter folgt: Die Duplikation des Eigentums durch das Geld.“"
                                            },
                                            {
                                                "example_id": "450b4e39-327b-446b-b467-f58c0aeb16ea",
                                                "sense_id": "e171ada3-cd64-30ad-b897-302e7e744a13",
                                                "text": "„Beim Cost of Carry-Ansatz ist die Grundidee […] die Duplikation des Zahlungsstroms des Forward-Kontraktes, wobei aber die durch einen Kauf der zugrunde liegenden Anleihe und einer Mittelaufnahme entstehenden Halte- und Zinskosten berücksichtigt werden.“"
                                            },
                                            {
                                                "example_id": "db2435a1-bb7a-4402-8f2c-d99cfd73f0e1",
                                                "sense_id": "e171ada3-cd64-30ad-b897-302e7e744a13",
                                                "text": "„Betrachtet man die anderen Hauptfiguren Sir William und Mellefont unter dem Aspekt der Doppelbesetzung, so konstatiert man auch bei jenen eine Duplikation der mythischen Personen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dec43421-1a0e-31fd-a18e-3d72df58bcf7",
                                        "entry_id": "ab93569f-0908-34ca-afba-9a60d764955b",
                                        "glosses": [
                                            "Verdoppelung eines Abschnitts eines Chromosoms"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04e468d8-7bf0-4f58-b44e-ac0a27c83a93",
                                                "sense_id": "dec43421-1a0e-31fd-a18e-3d72df58bcf7",
                                                "text": "„Durch den Prozeß der Duplikation und Divergenz haben sich 1183 Gene neu gebildet, und 33 sind durch Mutation zu nichtfunktionalen Pseudogenen untergegangen.“"
                                            },
                                            {
                                                "example_id": "b4ed7386-9bb2-4a44-ad9c-3126c660ba5a",
                                                "sense_id": "dec43421-1a0e-31fd-a18e-3d72df58bcf7",
                                                "text": "„Nach einer Duplikation des gesamten Genoms liegen alle Gene als verdoppelte Kopien vor.“"
                                            },
                                            {
                                                "example_id": "6186e364-ff80-441e-98a0-7889683c77ce",
                                                "sense_id": "dec43421-1a0e-31fd-a18e-3d72df58bcf7",
                                                "text": "„Nach der Trennung der Chromatiden resultieren vier Chromosomen: zwei normale, eines mit einer Duplikation, eines mit einer Deletion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32fc1d94-8ce3-4849-a0f0-1bdd7abb639a",
                        "source_entry_id": "e515322e-55dd-3f28-9ba4-debfd451305d",
