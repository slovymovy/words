                ],
                "senses": [
                    {
                        "sense_id": "a5af9413-11b7-3e6f-b132-6eeefa7fa486",
                        "entry_id": "0b4bf59e-120b-3e79-a2c4-d94aba4a5f3f",
                        "glosses": [
                            "mit den Augen einsehbarer Bereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2388d2d4-9d99-4572-bfb4-7f38413980ca",
                                "sense_id": "a5af9413-11b7-3e6f-b132-6eeefa7fa486",
                                "text": "„Plötzlich erschien ein Auto von rechts in meinem Sichtfeld.“"
                            },
                            {
                                "example_id": "4eeb9d93-0624-4fd8-8208-838cc613872b",
                                "sense_id": "a5af9413-11b7-3e6f-b132-6eeefa7fa486",
                                "text": "„Als ich meinen Blick hebe, wirft mir die Frau ein verräterisches Lächeln zu und verschwindet dann aus meinem Sichtfeld […].“"
                            },
                            {
                                "example_id": "fb276542-8be0-4d83-aa8b-ac4b924ad8ce",
                                "sense_id": "a5af9413-11b7-3e6f-b132-6eeefa7fa486",
                                "text": "„Karl klebt fast von innen an der Windschutzscheibe und reibt immer wieder mit der Hand einzelne beschlagene Stellen aus dem Sichtfeld.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7e9a5931-f337-3a93-9e9b-659e9103889e",
                        "entry_id": "0b4bf59e-120b-3e79-a2c4-d94aba4a5f3f",
                        "glosses": [
                            "von einem Okular oder einer Kamera erfasstes Bild"
                        ],
                        "tags": [
                            "Optik"
                        ],
                        "examples": [
                            {
                                "example_id": "456d70dc-51e6-47ff-87c2-d9237101c2a5",
                                "sense_id": "7e9a5931-f337-3a93-9e9b-659e9103889e",
                                "text": "„Das Sichtfeld der Kamera kann mit Scheinwerfern ausgeleuchtet werden.“"
                            },
                            {
                                "example_id": "0e771649-1499-4762-9415-84c7e2be4811",
                                "sense_id": "7e9a5931-f337-3a93-9e9b-659e9103889e",
                                "text": "„Das sind viele Wale; sie füllen mein komplettes Sichtfeld im Fernglas, von links nach rechts und dann noch ein Stück weiter, sogar auf diese Entfernung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
