                                    {
                                        "sense_id": "ce30efcd-c803-3470-b416-666b981c9f91",
                                        "entry_id": "3d0d2cdd-a340-362a-8add-e7f5b3779887",
                                        "glosses": [
                                            "A reproduction of a single article from a journal or similar publication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "839b35e2-94b8-4047-a3d1-d5a856df91e6",
                                                "sense_id": "ce30efcd-c803-3470-b416-666b981c9f91",
                                                "text": "I got a lot of requests for offprints of my paper on cold fusion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "offprint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53d9cfdd-0c81-3d41-b494-c7c3c2dd897c",
                                        "entry_id": "6f5bcc14-2e1b-3c38-9c7e-13a5e4585b42",
                                        "glosses": [
                                            "To reprint as an excerpt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "981da50f-f74b-4820-8421-46ba83c573a4",
                                                "sense_id": "53d9cfdd-0c81-3d41-b494-c7c3c2dd897c",
                                                "text": "Articles from some magazines are offprinted from other magazines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58ef73e1-a5e6-430c-a9f6-1bbf564006be",
                        "source_entry_id": "8a2f9257-db73-3fcd-8c6e-3312b48d9bea",
                        "source_sense_id": "9b22893d-0ea4-33e7-81d0-20ea86525f7b",
                        "target_lang_word": "tiré à part",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tiré à part",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8faae2b9-a894-3f7a-9f59-c7cf4d9798e4",
                                        "entry_id": "6ffb6dac-34b8-3838-a754-cb73e3ed6bc3",
                                        "glosses": [
                                            "Tirage supplémentaire d'une partie d'un ouvrage, un chapitre ou un article, réalisé hors du tirage normal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e83131b5-72f1-4f5e-b759-4782d1d08e30",
                                                "sense_id": "8faae2b9-a894-3f7a-9f59-c7cf4d9798e4",
                                                "text": "Les tirés à part sont disponibles à la librairie."
                                            },
                                            {
                                                "example_id": "cbb1f3db-2487-4d77-8f36-44d23ae1499f",
                                                "sense_id": "8faae2b9-a894-3f7a-9f59-c7cf4d9798e4",
                                                "text": "La bibliothèque de la via Panisperna était abonnée à la prestigieuse revue qui publia Ida Noddack. Fermi en avait certainement reçu un tiré à part et avait dû le commenter avec ses collègues."
                                            },
                                            {
                                                "example_id": "54c34d16-7ba4-417c-8d4b-557c01001914",
                                                "sense_id": "8faae2b9-a894-3f7a-9f59-c7cf4d9798e4",
                                                "text": "Comme le père Goriot, je parcourus les rues de Paris d’un pas de serf à la recherche de vieux numéros de La NRF et tous autres fascicules, catalogues d’exposition, tirés à part, éditions originales épuisées, bref, toutes brochures, articles, et autres documents où je pourrais retrouver la signature et la prose magique de mon nouveau héros."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7c1d61c-0686-4dfa-9f40-2706c41b8960",
                        "source_entry_id": "8a2f9257-db73-3fcd-8c6e-3312b48d9bea",
                        "source_sense_id": "9b22893d-0ea4-33e7-81d0-20ea86525f7b",
                        "target_lang_word": "separata",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "separata",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "dcb9ddc1-6ea5-3267-8bb1-3cdb2ab9f4e0",
                                        "entry_id": "93d34650-13ae-3936-aeea-2365d45322e8",
                                        "glosses": [
                                            "Impresión por separado de capítulos de revistas, libros u otras publicaciones. Normalmente conserva la numeración de la obra original, y se entrega al autor."
                                        ],
                                        "tags": [
                                            "publicaciones"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37ea31aa-753c-4cf5-813e-a049495bd8b6",
                                                "sense_id": "dcb9ddc1-6ea5-3267-8bb1-3cdb2ab9f4e0",
                                                "text": "A mediados del siglo pasado, la Revista de Biología Tropical daba entre 25 y 50 separatas gratuitas a quienes publicaban en ella. En 1988 subió al número de separatas gratuitas a 75 con dos objetivos: facilitar la distribución del conocimiento publicado por la revista y disminuir al mínimo los pedidos de separatas adicionales pagadas, ya que su producción es costosa y nunca se cobraba realmente su costo total. Aún así, autores de instituciones como Smithsonian, que distribuyen de oficio 250 separatas de sus trabajos a una lista pre-establecida de especialistas según el campo del artículo, continuaron pagando la impresión de separatas adicionales de Biología Tropical todos estos años. La publicación y distribución de separatas en papel tiene varias desventajas. La elaboración del papel tiene un impacto ambiental negativo (es famoso el caso del Lago Baikal, dañado por las fábricas de papel cercanas) y su distribución se hace con combustibles fósiles. Además, las separatas en papel tardan semanas o meses en llegar por correo. En cambio, las separatas en formato electrónico pueden enviarse en segundos a cualquier lugar del planeta a un costo ínfimo. Por esta razón, hicimos una encuesta entre nuestros(as) autores(as) (Monge-Nájera et al. 2003), quienes prefirieron que se les siga entregando separatas electrónicas."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "separata",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "5960efc7-2e5e-325a-88c1-ec8f6095dfd2",
                                        "entry_id": "4d434d6b-b4e6-3294-830f-e29e937d7bb2",
                                        "glosses": [
                                            "Persona que aboga por el separatismo."
                                        ],
                                        "tags": [
                                            "Spain",
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c4674b8-db8d-45e2-b040-5b2007d5c78b",
                                                "sense_id": "5960efc7-2e5e-325a-88c1-ec8f6095dfd2",
                                                "text": "No hay autonomistas ni separatistas en el sentido autoproclamado. Los unos quieren hacer negocios con un criterio de la libertad propio de los piratas. Y los otros desean acabar con Leviatán. Los separatas burgueses siempre han utilizado a los separatas proletarios."
                                            },
                                            {
                                                "example_id": "10c2980f-e1ce-4310-a0db-ab9ef21032bc",
                                                "sense_id": "5960efc7-2e5e-325a-88c1-ec8f6095dfd2",
                                                "text": "Y eso ya es un argumento de peso, porque si con la independencia los separatas se llevan puesta a Karmele y la recluyen en TV3, entonces lo que se llama el resto de España igual ya empieza a mirar el proceso con otros ojos."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a0a361d-56bf-428f-8d7b-2e9dd29f1a53",
                        "source_entry_id": "8a2f9257-db73-3fcd-8c6e-3312b48d9bea",
                        "source_sense_id": "9b22893d-0ea4-33e7-81d0-20ea86525f7b",
