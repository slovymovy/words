                            }
                        },
                        {
                            "text": "Zullen we <opstappen> voordat het begint te regenen?",
                            "target_lang_translations": {
                                "en": "Shall we <w>leave</w> before it starts raining?",
                                "ru": "Может, <пойдем> до того, как начнется дождь?",
                                "pl": "Może <w>pójdziemy</w>, zanim zacznie padać?",
                                "de": "Wollen wir <w>aufbrechen</w>, bevor es anfängt zu regnen?",
                                "fr": "Et si on <w>partait</w> avant qu'il ne commence à pleuvoir ?",
                                "it": "Vogliamo <w>andarcene</w> prima che inizi a piovere?",
                                "cs": "Měli bychom <w>odejít</w> dřív, než začne pršet?",
                                "tr": "Yağmur başlamadan önce <w>gidelim</w> mi?",
                                "es": "¿Nos <w>vamos</w> antes de que empiece a llover?"
                            }
