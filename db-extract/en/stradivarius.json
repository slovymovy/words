                                "target_senses": [
                                    {
                                        "sense_id": "6a8f5fec-7ff6-32b2-bf94-71e87db25134",
                                        "entry_id": "d55baa93-6fee-301d-aa1f-3bd85195478e",
                                        "glosses": [
                                            "housle vyrobené italským houslařem Stradivarim"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dc8daaa-c468-4ee4-aa37-cecdc7cd08e2",
                                                "sense_id": "6a8f5fec-7ff6-32b2-bf94-71e87db25134",
                                                "text": "Kubelíkovu brilantní techniku, křišťálově čistou intonaci, lehkost svítivých tónů, oduševnělou citovou hru a neopakovatelný melancholický stříbrný tón jeho slavných stradivárek Emperor z roku 1715 slyšelo kolem pěti miliónů posluchačů."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "461d708e-a53c-439e-826c-84e70f663a01",
                        "source_entry_id": "77e0a1ad-8796-3769-b579-3aa9a841e196",
                        "source_sense_description": "stringed instrument built by members of the Stradivari family",
                        "target_lang_word": "stradivarius",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stradivarius",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "368d8e42-9f85-34bd-bbb4-57dbef2d68dd",
                                        "entry_id": "8dc1ea24-5e6b-3dd6-b561-22babe4bdf67",
                                        "glosses": [
                                            "Instrument à cordes frottées (le plus souvent un violon) fabriqué par Antonio Stradivari (ou un membre de sa famille)."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23099463-a973-414c-a048-2cb577c2e6ef",
                                                "sense_id": "368d8e42-9f85-34bd-bbb4-57dbef2d68dd",
                                                "text": "Entre-temps, le stradivarius s'est imposé comme une référence."
                                            },
                                            {
                                                "example_id": "70a885c1-9d77-4b68-9ff4-22dc8df04568",
                                                "sense_id": "368d8e42-9f85-34bd-bbb4-57dbef2d68dd",
                                                "text": "Depuis septembre 2021, Anastasia Kobekina joue avec un stradivarius prêté par une fondation suisse, Habisreutinger, sise à Saint-Gall. Un violoncelle de 1698, le « De Kermadec Bläss », à qui son propriétaire a donné le nom de son chien préféré, un bouvier d’Appenzell russel terrier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6124c685-0855-333f-9418-8638ac0cb2e7",
                                        "entry_id": "8dc1ea24-5e6b-3dd6-b561-22babe4bdf67",
                                        "glosses": [
                                            "Symbole de l'excellence."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f51b1089-5141-44b0-a22f-8c0646db0f48",
                                                "sense_id": "6124c685-0855-333f-9418-8638ac0cb2e7",
                                                "text": "Ce verre ovoïde en cristal est le stradivarius de la dégustation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04c9fe30-fbe8-43f0-9431-79c14c3d655d",
                        "source_entry_id": "77e0a1ad-8796-3769-b579-3aa9a841e196",
                        "source_sense_description": "stringed instrument built by members of the Stradivari family",
                        "target_lang_word": "Stradivari",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stradivari",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44ca49ef-f208-3bab-892e-7d62a593d967",
                                        "entry_id": "fbb33b76-03e4-32bf-b174-0dce2fb30c3f",
                                        "glosses": [
                                            "eine von dem Geigenbauer Antonio Stradivari in seiner Werkstatt in Cremona hergestellte Geige"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47ff3ba0-5c1a-41ac-b067-c031d4d0b0e2",
                                                "sense_id": "44ca49ef-f208-3bab-892e-7d62a593d967",
                                                "text": "„Einerseits streichelt der Geiger die Stradivari mit seinem Bogen, entlockt ihr im Pianissimo feinste Tonteilchen im hauchdünnsten Format und reißt andererseits mit seiner linken \"Tatze\" im Stakkato aus dem Griffbrett bunte \"Klangkonfettis\" und streut sie, ohne mit der Wimper zu zucken, in das erstaunte Auditorium, ein \"Teufelsgeiger\" eben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Stradivari",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "234736e3-31e0-387e-a780-1cfc80a28118",
                                        "entry_id": "edac2bcd-01df-3cd7-a049-6e64a7d8ff45",
                                        "glosses": [
                                            "Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
