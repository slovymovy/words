                    {
                        "sense_id": "b2a2d87c-d42a-3ae0-9430-6249bdb397ce",
                        "entry_id": "48343b0a-3782-3866-9dba-66d33a059848",
                        "glosses": [
                            "A white crystalline bitter alkaloid, chemical formula C₂₉H₄₀N₂O₄, extracted from ipecacuanha root, and formerly used in the treatment of amebic infections and as an emetic in aversion therapy."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8612bf06-e0a0-4741-92ed-0cd8ec1af5a7",
                                "sense_id": "b2a2d87c-d42a-3ae0-9430-6249bdb397ce",
                                "text": "During a 10-year period the sanitarium treated 2,323 patients (93% were men) by the emetine method."
                            },
                            {
                                "example_id": "63c31faf-2db6-4134-805c-d08701ebe6d3",
                                "sense_id": "b2a2d87c-d42a-3ae0-9430-6249bdb397ce",
                                "text": "Magendie performed experiments on emetics and the nature of vomiting, and showed that the emetic properties of ipecacuanha were due to a substance he named emetine."
                            },
                            {
                                "example_id": "b74d61e0-1dec-43ea-b6fd-c03db2d2c996",
                                "sense_id": "b2a2d87c-d42a-3ae0-9430-6249bdb397ce",
                                "text": "After a 3-hour incubation with ALLN [acetylleucyl-leucyl-norleucinal], cells were incubated with emetine in the presence (closed symbols) or absence (open symbols) of ALLN (10 µg/ml)."
                            }
                        ]
                    }
                ],
