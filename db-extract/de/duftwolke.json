                "senses": [
                    {
                        "sense_id": "c3520d93-69d0-3658-8e89-6c83497133b3",
                        "entry_id": "e88ecc3c-37d2-344b-81c0-4b45e0e58f17",
                        "glosses": [
                            "Bereich, in dem ein intensiver Geruch wahrnehmbar ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48d1412f-7eea-4c28-975d-235bb331bb34",
                                "sense_id": "c3520d93-69d0-3658-8e89-6c83497133b3",
                                "text": "„Drei angetrunkene Rekruten gingen durch den Wagen und ließen eine Duftwolke aus Bier und Tabak zurück.“"
                            },
                            {
                                "example_id": "5c07c6a2-17a0-4feb-afea-06a050322985",
                                "sense_id": "c3520d93-69d0-3658-8e89-6c83497133b3",
                                "text": "„Was dieses Unternehmen seit fast 130 Jahren produziert, verrät einem schon die Nase, wenn man im fränkischen Bamberg aus dem Zug steigt: Eine malzige Duftwolke zieht von der bahnhofsnahen Fabrik herüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
