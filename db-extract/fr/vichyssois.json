                    {
                        "sense_id": "181f1b9f-f9a4-3f2f-a17a-584c3fbca366",
                        "entry_id": "1147bcb0-aa1c-366d-b04f-94901a64c43a",
                        "glosses": [
                            "Relatif à la ville de Vichy ou à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71040d01-2576-4694-afd0-0a7d78b225e1",
                                "sense_id": "181f1b9f-f9a4-3f2f-a17a-584c3fbca366",
                                "text": "Le vignoble vichyssois, apparu vers le XIᵉ siècle, s’est maintenu à un niveau honorable jusqu’au milieu du XXᵉ siècle."
                            }
                        ]
                    },
                    {
                        "sense_id": "197eb4be-07f0-3ca4-80fd-2c5d601a805b",
                        "entry_id": "1147bcb0-aa1c-366d-b04f-94901a64c43a",
                        "glosses": [
                            "Relatif au régime de Vichy, gouvernement français réfugié à Vichy durant l’occupation allemande (juillet 1940-août 1944). → voir pétainiste et vichyste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0993b1f-a570-4f47-9717-c309430d1779",
                                "sense_id": "197eb4be-07f0-3ca4-80fd-2c5d601a805b",
                                "text": "Dans la Résistance intérieure, les éléments ex-vichyssois, les champions de l’électoralisme, les réactionnaires n’avaient qu’une minime influence. Dans l’appareil « gaulliste », au contraire, les hommes de la droite, et même d’anciens cagoulards, avaient des places éminentes."
                            }
                        ]
                    }
