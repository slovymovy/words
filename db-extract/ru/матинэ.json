                "senses": [
                    {
                        "sense_id": "d85acfc2-0bc7-37e8-b27c-b6217ee121a5",
                        "entry_id": "2ff48ed1-b6ed-3582-a848-7fa912fdb28c",
                        "glosses": [
                            "утренник, утреннее собрание, утреннее театральное представление"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a51c3a6c-78a6-4052-afbd-cf929080e559",
                                "sense_id": "d85acfc2-0bc7-37e8-b27c-b6217ee121a5",
                                "text": "Вчера был вместе с Митькой на матинэ Большого театра ― шел «Кавказский пленник»."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1c70f20-b1ad-3147-8939-89e23aa49ed8",
                        "entry_id": "2ff48ed1-b6ed-3582-a848-7fa912fdb28c",
                        "glosses": [
                            "истор. утренний женский костюм, утреннее платье, пеньюар"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45f84223-2da5-41fd-af10-1742ae402ab1",
                                "sense_id": "a1c70f20-b1ad-3147-8939-89e23aa49ed8",
                                "text": "Ее костюм был что-то среднее между матинэ и маскарадной фантазией."
                            },
                            {
                                "example_id": "89df04a3-741e-4bb1-bffa-58dd879e266f",
                                "sense_id": "a1c70f20-b1ad-3147-8939-89e23aa49ed8",
                                "text": "Что сделали вы? Или это по-дружески, Вы в кружеве вьюжитесь, мой друг в матинэ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4c9f06c-7fc0-42d5-aca2-365daaaf6ddd",
                        "source_entry_id": "2ff48ed1-b6ed-3582-a848-7fa912fdb28c",
                        "target_lang_word": "morning gown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morning gown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4f59952-7cbe-3aca-a9f3-8c25351ab12f",
                                        "entry_id": "5414d34e-8a7f-31e3-98ab-e50d9c88bc2d",
                                        "glosses": [
                                            "A dressing gown."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e107bdd7-5581-4b1d-be04-ab8e67aecfc3",
                                                "sense_id": "f4f59952-7cbe-3aca-a9f3-8c25351ab12f",
                                                "text": "He therefore crept out of bed, tho' not without great repugnance, and wrapping himself in his morning-gown, was supported down stairs, rubbing his eye, yawning fearfully, and grumbling all the way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d2a43ee-363e-4938-b61c-88830fe7cf65",
                        "source_entry_id": "2ff48ed1-b6ed-3582-a848-7fa912fdb28c",
                        "target_lang_word": "Matinée",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Matinée",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ca3acc7-9ad6-3beb-ab7d-952c1c471a7d",
                                        "entry_id": "8d2c43ea-d72f-3c4a-a860-b6f854b4c0aa",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16dd9e6b-6111-41f1-a85c-a64c35e7aa14",
                                                "sense_id": "4ca3acc7-9ad6-3beb-ab7d-952c1c471a7d",
                                                "text": "„Ihr Engagement jedenfalls hatte zur Folge gehabt, daß er sie in seinem Urlaub sehr wenig sah: sechs Abende in der Woche Vorstellung und obendrein zweimal Matinée, da blieb kaum Zeit für ihn übrig,…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f061065-8c85-4f5e-bf2d-418f7f2bd52b",
                        "source_entry_id": "2ff48ed1-b6ed-3582-a848-7fa912fdb28c",
                        "target_lang_word": "matinée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matinée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fabd6213-4ef7-33e4-8325-88f277dbb568",
                                        "entry_id": "de1ba53f-cccc-3238-af04-5367f0339ca5",
                                        "glosses": [
                                            "Partie du matin qui s’écoule depuis le point du jour jusqu’à midi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8677987-7475-447e-bc4a-627ef2fb9a08",
                                                "sense_id": "fabd6213-4ef7-33e4-8325-88f277dbb568",
                                                "text": "Les deux travailleurs essuyèrent leurs visages trempés, […], puis se parlèrent et se comportèrent comme des hommes qui se congratulent d’une matinée bien employée."
                                            },
                                            {
                                                "example_id": "36f4c23e-2edb-4673-9fb4-3d8d1eecbb09",
                                                "sense_id": "fabd6213-4ef7-33e4-8325-88f277dbb568",
                                                "text": "Le baromètre a baissé terriblement pendant la nuit et la matinée. Je m’attends à du gros temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88c9e0fc-d2f4-3312-9927-76e629a7bf26",
                                        "entry_id": "de1ba53f-cccc-3238-af04-5367f0339ca5",
                                        "glosses": [
                                            "Représentation, spectacle qui a lieu l’après-midi, par opposition à la soirée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f7c5d9a-6a58-4b13-9973-a066630359bb",
                                                "sense_id": "88c9e0fc-d2f4-3312-9927-76e629a7bf26",
                                                "text": "Je continuais à regarder le journal, mais bien que ce ne fût que pour me donner une contenance et me faire gagner du temps, tout en ne faisant que semblant de lire, je comprenais tout de même le sens des mots qui étaient sous mes yeux, et ceux-ci me frappaient : « Au programme de la matinée que nous avons annoncée et qui sera donnée cet après-midi dans la salle des fêtes du Trocadéro, il faut ajouter le nom de Mlle Léa qui a accepté d'y paraître dans Les Fourberies de Nérine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b79871b4-d79c-3c90-a3d6-9b45f105e3c2",
                                        "entry_id": "de1ba53f-cccc-3238-af04-5367f0339ca5",
                                        "glosses": [
                                            "Vêtement d’intérieur porté le matin par les femmes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6296fa04-b23c-490a-bda9-a69ea43efb80",
                                                "sense_id": "b79871b4-d79c-3c90-a3d6-9b45f105e3c2",
                                                "text": "Elle en obtint des matinées, des chemises, des peignoirs à désespérer les peintres par leur diaphanéïté neigeuse."
                                            },
                                            {
                                                "example_id": "c6890756-7471-451c-8f7a-f14261b380b0",
                                                "sense_id": "b79871b4-d79c-3c90-a3d6-9b45f105e3c2",
                                                "text": "Il s’était emparé, ostensiblement d’ailleurs, d’un mannequin recouvert d’une matinée blanche."
                                            },
                                            {
                                                "example_id": "b38560d0-fe29-4ee1-932c-4fa861013adf",
                                                "sense_id": "b79871b4-d79c-3c90-a3d6-9b45f105e3c2",
                                                "text": "En matinée de foulard blanc, sale et fripée, les cheveux retenus sur le haut de la tête par un peigne mis de travers, les coudes sur la table, Gabrielle fumait une cigarette et sirotait un verre de chartreuse."
                                            },
                                            {
                                                "example_id": "867b4812-038f-49ae-b1d4-581e90ba58d6",
                                                "sense_id": "b79871b4-d79c-3c90-a3d6-9b45f105e3c2",
                                                "text": "Elles ont fait toilette, abandonnant pour une fois les peignoirs, matinées, robes de chambre et autres vêtements d’intérieur dans lesquels elles vivent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
