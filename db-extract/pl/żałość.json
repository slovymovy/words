                        "glosses": [
                            "uczucie dojmującego smutku, żalu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b42614d-acfe-45f9-833d-2a3d17668303",
                                "sense_id": "0f63332d-567f-3310-8ac5-9fa4b93bc55d",
                                "text": "Jedyne, co możesz zrobić w swojej żałości, to próbować trwać; jedyne, w co możesz uwierzyć, to że przełkniesz kolejną rację żywnościową, grudowatą szarą papkę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d511074-ed4f-40a2-a5a7-40d21d489a9f",
                        "source_entry_id": "f7263ed5-74dd-3d12-a256-303cdfacf191",
