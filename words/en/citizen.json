{
    "word_family": [
        "citizenship",
        "citizeness",
        "citizenry",
        "non-citizen",
        "fellow-citizen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0a09c97-db4e-3dee-a00d-11a5e8011247",
                    "sense_definition": "A person who is a legally recognized member of a country and has the rights and protections of that country.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "legal_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a British <w>citizen</w> who was born in London but now lives abroad.",
                            "target_lang_translations": {
                                "ru": "Она британская <w>гражданка</w>, которая родилась в Лондоне, но сейчас живет за границей."
                            }
                        },
                        {
                            "text": "Every <w>citizen</w> has the right to vote in the national election.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>гражданин</w> имеет право голоса на общенациональных выборах."
                            }
                        }
                    ],
                    "synonyms": [
                        "national"
                    ],
                    "antonyms": [
                        "alien",
                        "foreigner"
                    ],
                    "common_phrases": [
                        "british citizen",
                        "foreign citizen",
                        "senior citizen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, обладающее правовым статусом члена государства, наделенное правами и обязанностями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гражданин",
                                "target_lang_sense_clarification": "мужской род или общий термин"
                            },
                            {
                                "target_lang_word": "гражданка",
                                "target_lang_sense_clarification": "женский род"
                            },
                            {
                                "target_lang_word": "подданный",
                                "target_lang_sense_clarification": "в монархическом государстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da345249-1dd6-3114-9f19-497b24828b49",
                    "sense_definition": "A person who lives in a particular town or city.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inhabitant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>citizens</w> of the small town gathered to discuss the new park.",
                            "target_lang_translations": {
                                "ru": "<w>Жители</w> маленького городка собрались, чтобы обсудить новый парк."
                            }
                        },
                        {
                            "text": "Local <w>citizens</w> are concerned about the increasing traffic in the city center.",
                            "target_lang_translations": {
                                "ru": "Местные <w>горожане</w> обеспокоены растущим трафиком в центре города."
                            }
                        }
                    ],
                    "synonyms": [
                        "resident",
                        "inhabitant",
                        "local",
                        "townsman",
                        "townswoman"
                    ],
                    "antonyms": [
                        "villager",
                        "outsider"
                    ],
                    "common_phrases": [
                        "local citizen",
                        "concerned citizen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, проживающий в определенном городе или населенном пункте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горожанин",
                                "target_lang_sense_clarification": "житель города"
                            },
                            {
                                "target_lang_word": "житель",
                                "target_lang_sense_clarification": "население определенного места"
                            },
                            {
                                "target_lang_word": "гражданин",
                                "target_lang_sense_clarification": "в контексте городского сообщества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad3b978a-95d4-34a7-b748-2c7e56352fd4",
                    "sense_definition": "A person who is not a member of the police or the military; a civilian.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "civilian",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer was praised for protecting a private <w>citizen</w> during the incident.",
                            "target_lang_translations": {
                                "ru": "Полицейского похвалили за защиту <w>гражданского лица</w> во время инцидента."
                            }
                        },
                        {
                            "text": "In this country, a private <w>citizen</w> cannot carry a weapon without a permit.",
                            "target_lang_translations": {
                                "ru": "В этой стране <w>рядовой гражданин</w> не может носить оружие без разрешения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "private citizen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, не являющееся военнослужащим или сотрудником полиции; гражданское лицо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гражданское лицо",
                                "target_lang_sense_clarification": "официальный термин"
                            },
                            {
                                "target_lang_word": "штатский",
                                "target_lang_sense_clarification": "не военный"
                            },
                            {
                                "target_lang_word": "мирный житель",
                                "target_lang_sense_clarification": "в контексте конфликтов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a51ccc71-2fd5-3085-800f-e01af95005cd",
                    "sense_definition": "A member of a particular group or a resident of a metaphorical place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inhabitant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He considered himself a <w>citizen</w> of the world rather than of one nation.",
                            "target_lang_translations": {
                                "ru": "Он считал себя скорее <w>гражданином</w> мира, чем одной нации."
                            }
                        },
                        {
                            "text": "The scientist studied the various <w>citizens</w> of the deep ocean.",
                            "target_lang_translations": {
                                "ru": "Ученый изучал различных <w>обитателей</w> глубокого океана."
                            }
                        }
                    ],
                    "synonyms": [
                        "denizen",
                        "occupant"
                    ],
                    "common_phrases": [
                        "citizen of the world"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used metaphorically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель определенной группы или обитатель метафорического пространства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гражданин",
                                "target_lang_sense_clarification": "в переносном смысле"
                            },
                            {
                                "target_lang_word": "обитатель",
                                "target_lang_sense_clarification": "о живых существах или среде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2436c10e-c0f9-3f80-9e66-8649890e4d87",
                    "sense_definition": "A title or form of address used to emphasize equality, especially during the French Revolution or among socialists.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The revolutionary addressed his comrade as <w>Citizen</w> Smith.",
                            "target_lang_translations": {
                                "ru": "Революционер обратился к своему товарищу: «<w>Гражданин</w> Смит»."
                            }
                        },
                        {
                            "text": "In the old documents, he was referred to simply as <w>Citizen</w> Louis.",
                            "target_lang_translations": {
                                "ru": "В старых документах его называли просто «<w>гражданин</w> Луи»."
                            }
                        }
                    ],
                    "synonyms": [
                        "comrade"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращение, подчеркивающее равенство, характерное для революционных периодов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гражданин",
                                "target_lang_sense_clarification": "историческое обращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05426ce7-2511-35b4-90ae-898f4de551d1",
                    "sense_definition": "An object or application within a software system that follows specific rules or standards.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "software",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application is designed to be a good <w>citizen</w> in the mobile ecosystem.",
                            "target_lang_translations": {
                                "ru": "Приложение разработано так, чтобы быть «порядочным <w>участником</w>» мобильной экосистемы."
                            }
                        },
                        {
                            "text": "A first-class <w>citizen</w> in this programming language can be passed as an argument.",
                            "target_lang_translations": {
                                "ru": "<w>Объект</w> первого класса в этом языке программирования может быть передан в качестве аргумента."
                            }
                        }
                    ],
                    "common_phrases": [
                        "first-class citizen"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "technical jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объект или сущность в программировании, обладающая полным набором прав или стандартов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объект",
                                "target_lang_sense_clarification": "в техническом контексте"
                            },
                            {
                                "target_lang_word": "сущность",
                                "target_lang_sense_clarification": "первого класса"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}