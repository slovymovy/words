                ],
                "senses": [
                    {
                        "sense_id": "7bd4d42d-72b8-31db-ba99-a9abe2e6df83",
                        "entry_id": "89688231-017c-3b5f-b0ca-b6c83e601b78",
                        "glosses": [
                            "mieszkaniec Asyżu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "714b3d16-7018-4681-a7ca-ca3efa54ddca",
                                "sense_id": "7bd4d42d-72b8-31db-ba99-a9abe2e6df83",
                                "text": "Radosny tłum asyżan przeszedł ulicami miasta."
                            },
                            {
                                "example_id": "947750fb-dc42-4f60-91fc-4b30d65e951e",
                                "sense_id": "7bd4d42d-72b8-31db-ba99-a9abe2e6df83",
                                "text": "Asyżanie, gdy go zobaczyli w mieście, uczynili wielkie zbiegowisko, drwiąc i szydząc z Franciszka jak z obłąkanego, nie szczędząc mu przy tym razów kijami i kamieniami"
                            },
                            {
                                "example_id": "bafa2794-892f-4c36-a8c7-a48a3a0c09ad",
                                "sense_id": "7bd4d42d-72b8-31db-ba99-a9abe2e6df83",
                                "text": "W tym określonym wypadku, w roku tysiąc trzysta dziewięćdziesiątym dziewiątym (nie żył już San Francesco, nie żyła Santa Chiara, oboje, których głosy przywodziły do zgody, do opamiętania) asyżanie, będący w wojnie z Perugią, zdobyli i zniszczyli opactwo, w którym schronili się oblężeni. Nie ocalały ani kobiety, ani dzieci"
                            },
                            {
                                "example_id": "9f601a29-55ab-4a8b-b316-fc0238dfd94c",
                                "sense_id": "7bd4d42d-72b8-31db-ba99-a9abe2e6df83",
                                "text": "(…) Chrystus (…) rzekł był wyraźnie pewnemu młodemu asyżaninowi, klęczącemu w dusznej rozterce w rozpadającej się w gruzy pustej kapliczce San Damiano za murami jego rodzinnego miasta: „Franciszku, napraw mój dom, który jest w ruinie”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
