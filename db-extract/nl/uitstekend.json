                "senses": [
                    {
                        "sense_id": "481efeae-5d88-380a-bf04-d2ed805511c2",
                        "entry_id": "e440c327-cf26-3903-a535-6813cad878a2",
                        "glosses": [
                            "naar buiten gericht, zich voorbij anderen uitstrekkend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5698517-7591-4bdc-abf7-45feeffb2af1",
                                "sense_id": "481efeae-5d88-380a-bf04-d2ed805511c2",
                                "text": "Hij bezeerde zich aan die uitstekende punt van de tafel."
                            }
                        ]
                    },
                    {
                        "sense_id": "7195ead3-7514-3cec-b86b-fb1b6766fbcd",
                        "entry_id": "e440c327-cf26-3903-a535-6813cad878a2",
                        "glosses": [
                            "bijzonder goed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ec6f111-322b-4b78-8ce2-eb97fad42783",
                                "sense_id": "7195ead3-7514-3cec-b86b-fb1b6766fbcd",
                                "text": "Dat was een uitstekend concert."
                            },
                            {
                                "example_id": "cf5a4681-eab2-4521-b3ef-7e7bb607a470",
                                "sense_id": "7195ead3-7514-3cec-b86b-fb1b6766fbcd",
                                "text": "Denemarken ook nauwelijks, in de pers hadden ze het uitgebreid gehad over de gemoedelijke verhouding tussen de Deense bevolking en de Duitse gasten. De koning en de regering van Denemarken zaten nog op hun plaats en de samenwerking leek uitstekend te functioneren binnen de Germaanse verbroedering."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a83b11e-b437-4fc7-a521-56fd4dec3c0a",
                        "source_entry_id": "e440c327-cf26-3903-a535-6813cad878a2",
                        "source_sense_id": "7195ead3-7514-3cec-b86b-fb1b6766fbcd",
