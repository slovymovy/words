                "senses": [
                    {
                        "sense_id": "18a98994-77d1-3b1d-9605-bcc8aad3166f",
                        "entry_id": "ad9e1669-1400-33d2-abd4-66c1a6a1d03a",
                        "glosses": [
                            "S’acclamer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ba1cca-56b0-431b-9e0c-4e980b7b038d",
                                "sense_id": "18a98994-77d1-3b1d-9605-bcc8aad3166f",
                                "text": "Mais se faire auto-acclamer, revient en fait à des vieux poncifs \" vive la reine !\"."
                            },
                            {
                                "example_id": "6ab7822d-7865-4bda-aae8-fa21eee0f3f6",
                                "sense_id": "18a98994-77d1-3b1d-9605-bcc8aad3166f",
                                "text": "Il y a aussi d'autres filles et copines dans cette revue mais je les laisse s'auto-acclamer, comme je viens de le faire, dans leur propres blogs."
                            },
                            {
                                "example_id": "142d7521-f495-4b39-a4fa-2d51991c2334",
                                "sense_id": "18a98994-77d1-3b1d-9605-bcc8aad3166f",
                                "text": "Oui, bon, ça va, j'ai le droit de m'auto-acclamer non ?"
                            }
                        ]
                    }
