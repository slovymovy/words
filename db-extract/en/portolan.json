                        "form_id": "f89e8815-d4e1-47e9-abdb-af3b1e001c51",
                        "entry_id": "3c575aab-1c5d-35c9-8dbb-9fbd15944e7d",
                        "tags": [
                            "plural"
                        ],
                        "form": "portolans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13a52ad8-a7fe-3acd-ba7e-c7e8810e0ba4",
                        "entry_id": "3c575aab-1c5d-35c9-8dbb-9fbd15944e7d",
                        "glosses": [
                            "A chart of European navigable waters based on descriptions of coasts."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "a937541a-f0e1-4139-958a-3e75045d6b42",
                                "sense_id": "13a52ad8-a7fe-3acd-ba7e-c7e8810e0ba4",
                                "text": "Portolans are as old as the European mariner's magnetic compass, and for about two centuries the two depended on each other for the growth and safe passage of Mediterranean trade."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20513eed-cde0-461e-b023-c30ca709d80f",
                        "source_entry_id": "3c575aab-1c5d-35c9-8dbb-9fbd15944e7d",
                        "source_sense_id": "13a52ad8-a7fe-3acd-ba7e-c7e8810e0ba4",
                        "source_sense_description": "chart of European navigable waters",
                        "target_lang_word": "portulan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portulan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c842882-aff3-3e5d-a331-9494a22fc5e0",
                                        "entry_id": "72a35582-1a25-35a0-aece-b66813409484",
                                        "glosses": [
                                            "Carte marine en projection plane, en usage du XIIIᵉ au XVᵉ siècle, qui décrivait précisément les ports et les côtes, et servait de guide aux navigateurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de77cc83-52f7-488c-b905-863565917128",
                                                "sense_id": "6c842882-aff3-3e5d-a331-9494a22fc5e0",
                                                "text": "Au-dessus du divan, un portulan occuperait toute la longueur du panneau."
                                            },
                                            {
                                                "example_id": "420880bf-4e1b-4bd1-b2c2-aac81c0b7d5d",
                                                "sense_id": "6c842882-aff3-3e5d-a331-9494a22fc5e0",
                                                "text": "Le Rapporteur attendait le Policier dans ce qu’il avait baptisé la chambre des cartes. C’était une sorte de fumoir dont tous les murs ainsi que le plafond étaient tapissés de planisphères et de portulans."
                                            },
                                            {
                                                "example_id": "2e6899c1-4925-42c2-8025-f8173b532c88",
                                                "sense_id": "6c842882-aff3-3e5d-a331-9494a22fc5e0",
                                                "text": "Les premiers portulans furent dressés par les cartographes de la république de Gênes."
                                            },
                                            {
                                                "example_id": "2e9dc89c-cf28-464f-b7ef-4e1fb3f7f071",
                                                "sense_id": "6c842882-aff3-3e5d-a331-9494a22fc5e0",
                                                "text": "Un portulan vénitien."
                                            },
                                            {
                                                "example_id": "938e0d95-b845-4b82-935b-2b49d12f6ffb",
                                                "sense_id": "6c842882-aff3-3e5d-a331-9494a22fc5e0",
                                                "text": "Une carte-portulan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6cf1cc1-491c-3365-b1dd-571aad0350a2",
                                        "entry_id": "72a35582-1a25-35a0-aece-b66813409484",
                                        "glosses": [
                                            "Livre, recueil qui contenait ces cartes, ainsi que des indications utiles à la navigation, comme la direction des courants, les marées, l'orientation des vents. Note : aujourd’hui les « instructions nautiques » ont remplacé ces portulans."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f68440e-8419-403d-9a12-92fd3aa3e252",
                                                "sense_id": "f6cf1cc1-491c-3365-b1dd-571aad0350a2",
                                                "text": "Le portulan de la mer Méditerranée, réalisé par le français Henry Michelot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
