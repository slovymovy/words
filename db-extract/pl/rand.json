                                    {
                                        "sense_id": "131e45d5-f132-3946-a809-4d14154df428",
                                        "entry_id": "bc2810fb-05eb-3e24-8ddd-a587e1797902",
                                        "glosses": [
                                            "To rant; to storm."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55accf86-4e8c-42e2-97fc-e4a5797aeb3d",
                                                "sense_id": "131e45d5-f132-3946-a809-4d14154df428",
                                                "text": "[…] I ſmelt out my noble ſtincker Greenſheild in his Chamber, and as tho my heart ſtringes had bin crackt, I vvept, & thumpd, and thumpd, and rau'd and randed, and raild, and told him hovv my vvife vvas novv grovvne as common as baibery, and that ſhee had hierd her Taylor to ride vvith her to VVare, to meete a Gentleman of the Court."
                                            }
                                        ]
