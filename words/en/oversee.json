{
    "word_family": [
        "overseer",
        "oversight"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f0e2aa9-07c1-34e4-bc0c-4901eaaab2a6",
                    "sense_definition": "To supervise, guide, or direct the actions of a person, group, or project to ensure everything is done correctly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "supervision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is the duty of the committee to <w>oversee</w> the spending of all federal funds.",
                            "target_lang_translations": {
                                "ru": "В обязанности комитета входит <w>контролировать</w> расходование всех федеральных средств.",
                                "zh": "委员会的职责是<w>监督</w>所有联邦资金的使用。"
                            }
                        },
                        {
                            "text": "The manager will <w>oversee</w> the project to make sure it stays on schedule.",
                            "target_lang_translations": {
                                "ru": "Менеджер будет <w>курировать</w> проект, чтобы убедиться, что он идет по графику.",
                                "zh": "经理将<w>负责</w>该项目，以确保其按进度进行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "superintend",
                        "supervise",
                        "manage",
                        "direct",
                        "monitor"
                    ],
                    "common_phrases": [
                        "oversee the project",
                        "oversee the spending",
                        "oversee daily operations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контролировать, направлять или руководить действиями человека, группы или проекта, чтобы обеспечить правильность выполнения.",
                        "zh": "监督、指导或管理个人、团队或项目，以确保一切按规定妥善进行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "курировать",
                                "target_lang_sense_clarification": "проект или направление"
                            },
                            {
                                "target_lang_word": "контролировать",
                                "target_lang_sense_clarification": "процесс или расходы"
                            },
                            {
                                "target_lang_word": "надзирать",
                                "target_lang_sense_clarification": "осуществлять надзор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "监督",
                                "target_lang_sense_clarification": "察看并督促工作或资金使用"
                            },
                            {
                                "target_lang_word": "监管",
                                "target_lang_sense_clarification": "监督管理"
                            },
                            {
                                "target_lang_word": "负责",
                                "target_lang_sense_clarification": "统筹指导项目或事务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d657e13-d405-3326-804f-23e6bbcbe0b7",
                    "sense_definition": "To inspect or examine an area or activity, often to ensure safety or welfare.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inspection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gamekeepers <w>oversee</w> a hunting ground to see to the wildlife's welfare and look for poachers.",
                            "target_lang_translations": {
                                "ru": "Егеря <w>наблюдают</w> за охотничьими угодьями, чтобы заботиться о благополучии диких животных и искать браконьеров.",
                                "zh": "猎场看守人<w>监管</w>猎场，以关照野生动物并搜寻盗猎者。"
                            }
                        },
                        {
                            "text": "The safety officer must <w>oversee</w> the site to identify any potential hazards.",
                            "target_lang_translations": {
                                "ru": "Сотрудник по технике безопасности должен <w>инспектировать</w> объект для выявления любых потенциальных опасностей.",
                                "zh": "安全员必须<w>巡视</w>现场，以排查任何潜在隐患。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "oversee the site",
                        "oversee the grounds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инспектировать или осматривать территорию или деятельность, часто для обеспечения безопасности или благополучия.",
                        "zh": "巡查、视察或检查某一区域或活动，通常为了确保安全或福利。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инспектировать",
                                "target_lang_sense_clarification": "проверять состояние"
                            },
                            {
                                "target_lang_word": "наблюдать",
                                "target_lang_sense_clarification": "следить за порядком"
                            },
                            {
                                "target_lang_word": "осматривать",
                                "target_lang_sense_clarification": "территорию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巡视",
                                "target_lang_sense_clarification": "巡行视察现场"
                            },
                            {
                                "target_lang_word": "检查",
                                "target_lang_sense_clarification": "排查隐患或查看情况"
                            },
                            {
                                "target_lang_word": "监管",
                                "target_lang_sense_clarification": "看管和维护区域秩序与安全"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df495403-bf81-3195-8ce1-40389af4865e",
                    "sense_definition": "To survey or look at something from a wide angle or a high vantage point.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From the balcony, you can <w>oversee</w> the entire valley stretching out below.",
                            "target_lang_translations": {
                                "ru": "С балкона можно <w>обозревать</w> всю долину, раскинувшуюся внизу.",
                                "zh": "从阳台上，你可以<w>俯瞰</w>下方延绵的整座山谷。"
                            }
                        },
                        {
                            "text": "The tower was built to <w>oversee</w> the surrounding landscape for miles.",
                            "target_lang_translations": {
                                "ru": "Башня была построена, чтобы <w>окидывать взором</w> окрестный пейзаж на многие мили вокруг.",
                                "zh": "建造这座塔是为了能<w>眺望</w>方圆数英里的周边景色。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "oversee the landscape",
                        "oversee the valley"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осматривать или смотреть на что-либо под широким углом или с высокой точки обзора.",
                        "zh": "从高处或广角俯瞰、眺望某处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обозревать",
                                "target_lang_sense_clarification": "вид или ландшафт"
                            },
                            {
                                "target_lang_word": "окидывать взором",
                                "target_lang_sense_clarification": "пространство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "俯瞰",
                                "target_lang_sense_clarification": "从高处往下看"
                            },
                            {
                                "target_lang_word": "俯视",
                                "target_lang_sense_clarification": "从高处向下看"
                            },
                            {
                                "target_lang_word": "眺望",
                                "target_lang_sense_clarification": "从高处远望"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a8c3256-b86e-3a96-94f9-800fdc9d0820",
                    "sense_definition": "To observe someone or something secretly or unintentionally.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He happened to <w>oversee</w> their private meeting while walking through the garden.",
                            "target_lang_translations": {
                                "ru": "Он случайно <w>увидел</w> их частную встречу, когда гулял по саду.",
                                "zh": "他穿过花园时，碰巧<w>窥见</w>了他们的私下会面。"
                            }
                        },
                        {
                            "text": "It was never my intention to <w>oversee</w> such a confidential conversation.",
                            "target_lang_translations": {
                                "ru": "Я никогда не намеревался <w>подсматривать</w> за столь конфиденциальным разговором.",
                                "zh": "我绝非故意要<w>偷看</w>如此机密的谈话。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тайно или непреднамеренно наблюдать за кем-то или чем-то.",
                        "zh": "暗中或无意中看到、窥见某人或某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсматривать",
                                "target_lang_sense_clarification": "тайно наблюдать"
                            },
                            {
                                "target_lang_word": "случайно увидеть",
                                "target_lang_sense_clarification": "непреднамеренно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "窥见",
                                "target_lang_sense_clarification": "暗中或偶然看见"
                            },
                            {
                                "target_lang_word": "无意中看到",
                                "target_lang_sense_clarification": "碰巧看见"
                            },
                            {
                                "target_lang_word": "偷看",
                                "target_lang_sense_clarification": "暗中观察"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8561be17-9968-3e53-829f-7cfeed641f69",
                    "sense_definition": "To fail to see, to ignore, or to <w>overlook</w> something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "neglect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She chose to <w>oversee</w> his rude behavior and continued the conversation politely.",
                            "target_lang_translations": {
                                "ru": "Она предпочла <w>проигнорировать</w> его грубое поведение и вежливо продолжила разговор.",
                                "zh": "她选择<w>忽视</w>他的粗鲁举止，继续礼貌地交谈。"
                            }
                        },
                        {
                            "text": "The witness seemed to <w>oversee</w> the most important detail of the event.",
                            "target_lang_translations": {
                                "ru": "Свидетель, казалось, <w>упустил из виду</w> самую важную деталь происшествия.",
                                "zh": "目击者似乎<w>漏看</w>了事件中最关键的细节。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is no longer in common modern usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не заметить, проигнорировать или упустить что-либо из виду (устаревшее).",
                        "zh": "（古旧）未注意、忽视或漏看某事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упускать из виду",
                                "target_lang_sense_clarification": "не заметить"
                            },
                            {
                                "target_lang_word": "игнорировать",
                                "target_lang_sense_clarification": "намеренно не замечать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忽视",
                                "target_lang_sense_clarification": "不重视或不予理会"
                            },
                            {
                                "target_lang_word": "疏忽",
                                "target_lang_sense_clarification": "粗心遗漏"
                            },
                            {
                                "target_lang_word": "漏看",
                                "target_lang_sense_clarification": "未能看见"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}