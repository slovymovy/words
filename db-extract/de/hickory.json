                "senses": [
                    {
                        "sense_id": "4b6ffb77-78f8-3489-9de9-7cad69543043",
                        "entry_id": "f399fbe0-967a-31c5-b6a9-c89cebfb85ec",
                        "glosses": [
                            "Nussbaum und selbständige Gattung aus der Familie der Walnussgewächse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1e989a0-0586-4306-8e70-40849bdef38c",
                                "sense_id": "4b6ffb77-78f8-3489-9de9-7cad69543043",
                                "text": "Die Hickory wächst in Nordamerika."
                            },
                            {
                                "example_id": "534eb779-f211-4dd0-a702-1484d719395f",
                                "sense_id": "4b6ffb77-78f8-3489-9de9-7cad69543043",
                                "text": "Dort, inmitten eines blattleeren Ästegewirrs von Buchen, Hickorys und Gelbbirken, schwebt ein aus einem Dutzend Trichtern zusammengesetzter Zylinder."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3af1e700-ffbc-4536-8a6e-cfa284f864dc",
                        "source_entry_id": "f399fbe0-967a-31c5-b6a9-c89cebfb85ec",
                        "source_sense_id": "4b6ffb77-78f8-3489-9de9-7cad69543043",
                        "source_sense_description": "Botanik: Nussbaum und selbständige Gattung aus der Familie der Walnussgewächse",
                        "target_lang_word": "hickory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hickory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7779b811-652c-3bed-bd5b-b24a4aab2803",
                                        "entry_id": "9adf7ed5-a9ca-3296-a35d-a338b21071be",
                                        "glosses": [
                                            "Any of various deciduous hardwood trees of the genera Carya and Annamocarya, one species of which, Carya illinoinensis, is the source of pecan nuts."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5496b54a-3641-41cc-8d0a-054434ad80bd",
                                                "sense_id": "7779b811-652c-3bed-bd5b-b24a4aab2803",
                                                "text": "[H]e came across this young man sawin' on a fiddle and playin' it hot\nAnd the devil jumped up on a hickory stump\nAnd said, \"Boy, let me tell you what.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b11b56f1-9e8e-3216-a699-89d12fc7c5f0",
                                        "entry_id": "9adf7ed5-a9ca-3296-a35d-a338b21071be",
                                        "glosses": [
                                            "The wood of these trees."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "799ff308-135c-3b07-8e13-f2590c4cffc7",
                                        "entry_id": "9adf7ed5-a9ca-3296-a35d-a338b21071be",
                                        "glosses": [
                                            "A coarse, durable cotton fabric."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "968f0808-4a52-4240-b53d-7ce9efde0c69",
                                                "sense_id": "799ff308-135c-3b07-8e13-f2590c4cffc7",
                                                "text": "The loggers wore hickory shirts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a76131cb-baf4-3989-827d-97f8758a7be7",
                                        "entry_id": "9adf7ed5-a9ca-3296-a35d-a338b21071be",
                                        "glosses": [
                                            "A club with a head made from hickory wood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2825053d-5808-4098-b058-9af20d4d4696",
                                                "sense_id": "a76131cb-baf4-3989-827d-97f8758a7be7",
                                                "text": "What you find out is, if you have good hickories, you can play anywhere from 5,300 yards to 6,100 with no problem."
                                            },
                                            {
                                                "example_id": "57b433d2-8a8d-412b-9932-603f210ff140",
                                                "sense_id": "a76131cb-baf4-3989-827d-97f8758a7be7",
                                                "text": "I still had in my possession thirteen sets of hickories and a good stock of gutty golf balls, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c016e39e-1fa0-4c6f-bbfe-2fe5552528d8",
                        "source_entry_id": "f399fbe0-967a-31c5-b6a9-c89cebfb85ec",
                        "source_sense_id": "4b6ffb77-78f8-3489-9de9-7cad69543043",
                        "source_sense_description": "Botanik: Nussbaum und selbständige Gattung aus der Familie der Walnussgewächse",
                        "target_lang_word": "hickory",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hickory",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23dde594-2462-37f7-ac14-2edf3e7a92b8",
                                        "entry_id": "fa3b1e55-7efc-3082-8bab-3290e06e7105",
                                        "glosses": [
                                            "Synonyme de caryer, connu aussi sous l’appellation de noyer blanc, le bois de cet arbre du genre Carya sert entre autre à confectionner des manches d’outil ou bien des baguettes de batterie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc897dc1-e3f7-43ff-ab19-244d42835ba5",
                                                "sense_id": "23dde594-2462-37f7-ac14-2edf3e7a92b8",
                                                "text": "Le frêne peut convenir pour les skis de tourisme et de promenade. Cependant les avantages incontestables de l’hickory comme souplesse, glissement, résistance et durée, font que ce dernier devra toujours être préféré, lorsque les moyens de dépense le permettront."
                                            },
                                            {
                                                "example_id": "a42b9f39-11b3-4063-a378-01ea126083f0",
                                                "sense_id": "23dde594-2462-37f7-ac14-2edf3e7a92b8",
                                                "text": "En 1826, les Écossais importent d’Amérique l’hickory, un bois extrêmement dur mais flexible, pour fabriquer les bâtons de golf."
                                            },
                                            {
                                                "example_id": "42738d47-abdf-46df-b441-97654b11aa8e",
                                                "sense_id": "23dde594-2462-37f7-ac14-2edf3e7a92b8",
                                                "text": "Le tout est renforcé avec du hickory, un arbre reconnu pour sa résistance à la tension."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
