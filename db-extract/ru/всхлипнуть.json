                "senses": [
                    {
                        "sense_id": "0eb3d2fc-63bf-354d-9c9d-0f27a85d4fc7",
                        "entry_id": "d92c97b2-8172-327a-a47d-ff5afab4120e",
                        "glosses": [
                            "to sob, to weep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cee0d7d2-961a-40ea-9413-dcbd79547198",
                                "sense_id": "0eb3d2fc-63bf-354d-9c9d-0f27a85d4fc7",
                                "text": "Он протяну́л ему́ ру́ку. Эми́ль покачну́лся вперёд, всхли́пнул, прижа́л её к свои́м губа́м — и, соскочи́в с доро́ги, побежа́л наза́д к Фра́нкфурту, че́рез по́ле.",
                                "translation": "He held out his hand to him. Emil bent forward, sobbed, pressed it to his lips, and darting away from the road, ran back towards Frankfort across country.",
                                "english": "He held out his hand to him. Emil bent forward, sobbed, pressed it to his lips, and darting away from the road, ran back towards Frankfort across country."
                            }
                        ]
                    }
                ],
