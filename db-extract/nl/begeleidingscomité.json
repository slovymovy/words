                        "examples": [
                            {
                                "example_id": "435d1791-55c0-4c35-a3fd-ad792c275a8f",
                                "sense_id": "4be9b434-82c6-300e-9666-12385049664d",
                                "text": "Zoals voorzien in de verkoopvoorwaarden zal een begeleidingscomité, voorgezeten door het commissariaat-generaal voor toerisme, toezien op het waarborgen van de leefmilieukwaliteit van de site en moeten alle investeringsprojecten voorgelegd worden. “Het bod is vergezeld van een intentieverklaring, ondertekend door Alychlo en Natagora. Dat heeft betrekking op een samenwerkingsakkoord voor de valorisering van het Domaine de Hottemme en het Domaine du Mont des Pins, een natuurreservaat van de gemeente Durbuy dat wordt beheerd door Natagora”."
                            },
                            {
                                "example_id": "3d532093-901a-40c0-9154-a3428b66188a",
                                "sense_id": "4be9b434-82c6-300e-9666-12385049664d",
                                "text": "In totaal gingen 85 groepjes studenten aan de slag, waarvan 45 groepjes ook tot een uitgewerkt campagnevoorstel kwamen. Daaruit distilleerde een begeleidingscomité de zes sterkste voorstellen."
                            }
                        ]
