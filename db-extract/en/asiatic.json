    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1d99969b-3ce0-3abe-8b63-d8e7458350ec",
                "word": "Asiatic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d617cc27-4fff-4084-8968-97c04c462246",
                        "entry_id": "1d99969b-3ce0-3abe-8b63-d8e7458350ec",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more Asiatic"
                    },
                    {
                        "form_id": "ce4394b2-78b8-466d-8c42-58aec5eb96cd",
                        "entry_id": "1d99969b-3ce0-3abe-8b63-d8e7458350ec",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most Asiatic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f2fad161-f759-350c-bfeb-0b7b762a0213",
                        "entry_id": "1d99969b-3ce0-3abe-8b63-d8e7458350ec",
                        "glosses": [
                            "Asian, specifically, relating to the parts of Asia east of Egypt, i.e the Middle East or West Asia."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "91ccfd00-cb72-3feb-a839-0a7a5f1611a5",
                        "entry_id": "1d99969b-3ce0-3abe-8b63-d8e7458350ec",
                        "glosses": [
                            "Eccentric or crazy as a result of spending a long time in the Far East."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8b8c1c1b-0ed7-4d1b-913e-0dcec5f6547d",
                                "sense_id": "91ccfd00-cb72-3feb-a839-0a7a5f1611a5",
                                "text": "A soldier might grab his rifle and batter his way to the heart of some Jap position. Back home they gave him all sorts of medals but his companions dismissed him as the poor bastard who finally went Asiatic."
                            },
                            {
                                "example_id": "af123b60-b0db-4345-86a6-714176583d69",
                                "sense_id": "91ccfd00-cb72-3feb-a839-0a7a5f1611a5",
                                "text": "“[…] This ship has been in the forward area since March ’42. It’s been through a lot of action. The men are all Asiatic. They probably think a fantail watch in Pearl Harbor is foolishness. […]”"
                            },
                            {
                                "example_id": "ef9a9a5f-31fc-4b3d-ae63-95c0869b423d",
                                "sense_id": "91ccfd00-cb72-3feb-a839-0a7a5f1611a5",
                                "text": "The note was good-humored and Willie swiftly decided not to take offense. “No thanks. I don’t want any medals for extraordinary heroism.” [¶] “Old man is really Asiatic, sir, ain’t he?” said Meatball, stepping into his trousers."
                            },
                            {
                                "example_id": "238e4286-ff7a-40af-92d8-60bc1d7f2a56",
                                "sense_id": "91ccfd00-cb72-3feb-a839-0a7a5f1611a5",
                                "text": "Now how the hell, we asked ourselves, does a guy this old get from a navy ammo dump to command of a battleship? Not just any battleship but the flagship of the Battle Force! Had the brass hats at the Bureau of Navigation gone Asiatic?"
                            },
                            {
                                "example_id": "c6f9959a-e0cf-4a3b-ab16-918a92704743",
                                "sense_id": "91ccfd00-cb72-3feb-a839-0a7a5f1611a5",
                                "text": "This was a place that if you stayed there for any length of time, you went “Asiatic”. That was the expression for someone who went cuckoo. We had a long brutally boring patrol duty there, until we left for the island of Tarawa […]"
                            },
                            {
                                "example_id": "b6b2444e-2874-4543-85b8-4ebb36f8e597",
                                "sense_id": "91ccfd00-cb72-3feb-a839-0a7a5f1611a5",
                                "text": "Enlisted men sometimes went Asiatic, or “rock happy,” after long service in the islands. This was common knowledge on the scuttlebutt network."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a0b5e317-84e9-3b7b-8a4c-54c30c6acb3e",
