                "senses": [
                    {
                        "sense_id": "3d8fc0d3-b0cd-35d0-bec9-14613529f937",
                        "entry_id": "492dfb04-92c9-333a-bb7d-db5496105686",
                        "glosses": [
                            "installer, assembler, fitter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "344e5a86-e2b7-4be9-b74a-2d7eab072b7b",
                                "sense_id": "3d8fc0d3-b0cd-35d0-bec9-14613529f937",
                                "text": "Не кочегары мы, не плотники,\nНо сожалений горьких нет - как нет!\nА мы монтажники - высотники, да!\nИ с высоты вам шлём привет.",
                                "translation": "We are neither stokers nor carpenters;\nYet bitter regrets [we have] none - just none!\nStill, we are installers [and] steeplejacks - aye!\nAnd from on high we send you greetings.",
                                "english": "We are neither stokers nor carpenters;\nYet bitter regrets [we have] none - just none!\nStill, we are installers [and] steeplejacks - aye!\nAnd from on high we send you greetings."
                            }
                        ]
                    }
                ],
