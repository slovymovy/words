                                    {
                                        "sense_id": "d7f20893-cb1f-3c14-b044-de2f74a8ddc1",
                                        "entry_id": "bb46f237-34b7-36df-8680-31b5371bf02f",
                                        "glosses": [
                                            "Ce que l’on donne aux pauvres par charité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cb9590e-a290-4a9d-a2f9-4e8ae42750b5",
                                                "sense_id": "d7f20893-cb1f-3c14-b044-de2f74a8ddc1",
                                                "text": "Faire du bien à des pauvres honteux, c’est une belle aumône, une aumône bien employée, bien placée."
                                            },
                                            {
                                                "example_id": "1f88b119-3b9e-4a5b-8154-f09cec980711",
                                                "sense_id": "d7f20893-cb1f-3c14-b044-de2f74a8ddc1",
                                                "text": "Faire l’aumône."
                                            },
                                            {
                                                "example_id": "1df1bb47-82a9-421d-8484-dd2f93c36323",
                                                "sense_id": "d7f20893-cb1f-3c14-b044-de2f74a8ddc1",
                                                "text": "Tronc des aumônes."
                                            },
                                            {
                                                "example_id": "7e6b1477-c745-4a6a-af6d-ef4e49d1bc1f",
                                                "sense_id": "d7f20893-cb1f-3c14-b044-de2f74a8ddc1",
                                                "text": "Être réduit à l’aumône."
                                            },
                                            {
                                                "example_id": "a23ad193-420c-44b6-b8e4-7e52c08569d0",
                                                "sense_id": "d7f20893-cb1f-3c14-b044-de2f74a8ddc1",
                                                "text": "Les musulmans jettent facilement l’aumône. Certains rigoristes poussent même le scrupule jusqu'à faire souvent le relevé de leur avoir pour en distribuer exactement le dixième aux pauvres, selon les prescriptions du Koran."
                                            },
                                            {
                                                "example_id": "01e58419-2424-44ed-92ad-f9d4940d83df",
                                                "sense_id": "d7f20893-cb1f-3c14-b044-de2f74a8ddc1",
                                                "text": "Sans eux, les riches ne peuvent donner l’aumône et prouver leur générosité, mais aussi leur puissance aux yeux de tous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b16e8228-1e75-3897-b4a9-a4b0c0eafc17",
                                        "entry_id": "bb46f237-34b7-36df-8680-31b5371bf02f",
                                        "glosses": [
                                            "Somme d'argent dérisoire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15dbdb13-4a39-4f12-88b6-16d9f35ba77c",
                                                "sense_id": "b16e8228-1e75-3897-b4a9-a4b0c0eafc17",
                                                "text": "Je vous demande un salaire décent pour mon travail, pas une aumône."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55ec6d8f-6197-3f48-8217-881d7987ab5e",
                                        "entry_id": "bb46f237-34b7-36df-8680-31b5371bf02f",
                                        "glosses": [
                                            "Faveur qu'on daigne accorder par pitié à quelqu’un."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11125575-6bbb-4fc7-a44e-304261b20452",
                                                "sense_id": "55ec6d8f-6197-3f48-8217-881d7987ab5e",
                                                "text": "La plus belle femme de la terre n’obtiendrait pas l’aumône d’une œillade dans ce moment-là."
                                            }
                                        ]
                                    }
                                ]
                            },
