                "senses": [
                    {
                        "sense_id": "de74448b-474f-3567-9304-600ecad0306d",
                        "entry_id": "ce2b57e2-f713-382d-9f8a-6b2c68600929",
                        "glosses": [
                            "mit großem Eifer und hoher Einsatzbereitschaft betriebenes Spielen, bisweilen ausartend in Spielsucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbd9f4b4-af67-4567-b929-ef67ae068bf0",
                                "sense_id": "de74448b-474f-3567-9304-600ecad0306d",
                                "text": "„Das Interesse der Spieler, ihre Neugier und ihre Aktivität müssen erst geweckt und ihre Spielleidenschaft verstärkt werden.“"
                            },
                            {
                                "example_id": "afa54e73-3daf-4e5a-b433-4021e952a22d",
                                "sense_id": "de74448b-474f-3567-9304-600ecad0306d",
                                "text": "„Die Spielbank bescherte der Stadt die Mitleidlosigkeit zum Selbstschutz vor der Spielleidenschaft als ungeschriebenes Gesetz.“"
                            },
                            {
                                "example_id": "aa8ea6cd-75d3-43fe-b692-b19d4db86dfb",
                                "sense_id": "de74448b-474f-3567-9304-600ecad0306d",
                                "text": "„Manche Erwachsene werden von einer suchtähnlichen Spielleidenschaft befallen, die sie total im Augenblick gefangen hält.“"
                            },
                            {
                                "example_id": "f249b360-c3e1-43e5-b194-b6793df318f2",
                                "sense_id": "de74448b-474f-3567-9304-600ecad0306d",
                                "text": "„Als Tochter des berühmten romantischen Dichters Lord Byron nahm Ada Lovelace am gesellschaftlichen Leben Londons teil, machte mit außerehelichen Liebesaffären von sich reden und häufte durch ihre Spielleidenschaft erhebliche Wettschulden an.“"
                            },
                            {
                                "example_id": "c05c8fe2-b5d2-4efc-8d44-4771e3139a9e",
                                "sense_id": "de74448b-474f-3567-9304-600ecad0306d",
                                "text": "„Mit zahlreichen Fakten untermauert McGonigal, wie schnell sich die Spielleidenschaft überall in der Welt immer mehr ausbreitet – und es die Menschen in virtuelle Welten zieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
