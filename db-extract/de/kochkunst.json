                        ],
                        "form": "die Kochkunst"
                    },
                    {
                        "form_id": "54be5f2b-14aa-4274-8983-40e59dad216c",
                        "entry_id": "bf42035f-3420-3d7a-ba95-8760f0909ab1",
                        "tags": [
                            "accusative",
