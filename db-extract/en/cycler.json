                ],
                "senses": [
                    {
                        "sense_id": "7af8541f-6bcc-3afd-83cd-238a13bdaefa",
                        "entry_id": "aadefa07-d010-35f9-92f9-d8784859b8f8",
                        "glosses": [
                            "Anything with a cyclic (repetitious) behaviour. Something that cycles between different states."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9f0fc3d-95c8-4feb-8a12-0151361c0aa1",
                                "sense_id": "7af8541f-6bcc-3afd-83cd-238a13bdaefa",
                                "text": "The battery cycler allows us to switch between batteries as each one runs out."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ec8a4f1-5ffb-333d-92e7-c9ed63563aad",
                        "entry_id": "aadefa07-d010-35f9-92f9-d8784859b8f8",
                        "glosses": [
                            "An orbit that approaches two astronomical bodies on a regular basis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e91e334-9f89-4af8-aeba-603f248122aa",
                                "sense_id": "4ec8a4f1-5ffb-333d-92e7-c9ed63563aad",
                                "text": "The Earth-Mars cyclers could potentially be used for transporting people between the two planets."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c1d240a-70c4-3f3c-85ad-5e7c4811de8d",
                        "entry_id": "aadefa07-d010-35f9-92f9-d8784859b8f8",
                        "glosses": [
                            "A, usually man-made, object that follows such an orbit."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "730467ea-bf7b-43bc-b8e5-ebf5abb3460f",
                                "sense_id": "2c1d240a-70c4-3f3c-85ad-5e7c4811de8d",
                                "text": "If we had more than one cycler then the length of time between the outbound and inbound journeys could be reduced to a few months."
                            }
                        ]
                    },
                    {
                        "sense_id": "206f57b7-dde4-3a45-a6c5-90cb89bb2edd",
                        "entry_id": "aadefa07-d010-35f9-92f9-d8784859b8f8",
                        "glosses": [
                            "A person with bipolar disorder, often used when comparing the speed of mood swings."
                        ],
                        "tags": [
                            "euphemistic"
                        ],
                        "examples": [
                            {
                                "example_id": "a9dcc808-b45e-4a3b-a672-4f37f56581fd",
                                "sense_id": "206f57b7-dde4-3a45-a6c5-90cb89bb2edd",
                                "text": "My son's a fast cycler which is much harder for people to understand."
                            }
                        ]
                    },
                    {
                        "sense_id": "e98efdaa-44f8-363a-b993-0bfb3fea8cf7",
                        "entry_id": "aadefa07-d010-35f9-92f9-d8784859b8f8",
                        "glosses": [
                            "A device for performing dialysis; for mechanically purifying blood."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d073387d-9e53-4e8c-9385-ac1a30eeed95",
                                "sense_id": "e98efdaa-44f8-363a-b993-0bfb3fea8cf7",
                                "text": "The only issue I have had with my cycler was when the cat started chewing on the connecting line."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2fe1fcb-42eb-380e-a6e3-88e6a08444b8",
                        "entry_id": "aadefa07-d010-35f9-92f9-d8784859b8f8",
                        "glosses": [
                            "Ellipsis of thermal cycler, a machine for creating multiple copies of DNA sequences."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "433159b7-a2e3-4324-a1f0-5c565cb35c41",
                                "sense_id": "d2fe1fcb-42eb-380e-a6e3-88e6a08444b8",
                                "text": "We took samples from the tubes in the cycler at regular intervals"
                            }
                        ]
                    },
                    {
                        "sense_id": "e0e6c891-7bf5-3d8d-9541-d66f3d73a99d",
                        "entry_id": "aadefa07-d010-35f9-92f9-d8784859b8f8",
                        "glosses": [
                            "A task in a cycle of tasks where the status of being active task is passed around the loop."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c8affee-5b85-4bc2-b435-57762c3ac650",
                                "sense_id": "e0e6c891-7bf5-3d8d-9541-d66f3d73a99d",
                                "text": "When the last cycler has run for 200ms we pass control back to the first one and begin again."
                            }
                        ]
                    }
