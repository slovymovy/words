                "senses": [
                    {
                        "sense_id": "312e01c8-6fee-333f-b05b-4ac32c4daf1a",
                        "entry_id": "57970250-6b4f-307a-a5e0-5f483a7703bb",
                        "glosses": [
                            "Qui permet de redonner de la vitalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a578b8c7-1cd4-4081-8c9c-1e10f78bdb2e",
                                "sense_id": "312e01c8-6fee-333f-b05b-4ac32c4daf1a",
                                "text": "Certains produits de dernière génération, aux noms étranges, étaient, disait-on, capables de véritables miracles : acides de fruit « revitalisants », élastine « redensifiante », collagène « repulpant », rétinol « restructurant »."
                            },
                            {
                                "example_id": "8a0f251d-a1c6-4bd3-91ab-39920072f69b",
                                "sense_id": "312e01c8-6fee-333f-b05b-4ac32c4daf1a",
                                "text": "Je commencerai par décrire les caractéristiques des activités revitalisantes et ce qu’elles peuvent nous offrir."
                            },
                            {
                                "example_id": "09cf8bbe-4d62-458d-8432-fde8a8ff69fc",
                                "sense_id": "312e01c8-6fee-333f-b05b-4ac32c4daf1a",
                                "text": "Cette deuxième méthode de respiration dynamisante et revitalisante peut être effectuée directement à la suite de la première méthode."
                            }
                        ]
                    }
