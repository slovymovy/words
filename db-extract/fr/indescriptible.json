        "fr-extract.jsonl": [
            {
                "entry_id": "40a15c1a-cf95-351f-a430-efe7720ab2fa",
                "word": "indescriptible",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4d01141f-a72c-4dc1-b28f-1ab4d102df9f",
                        "entry_id": "40a15c1a-cf95-351f-a430-efe7720ab2fa",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "indescriptibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8255cb6b-cfc2-3a46-838c-688f2d1e0ca9",
                        "entry_id": "40a15c1a-cf95-351f-a430-efe7720ab2fa",
                        "glosses": [
                            "Qui ne peut être décrit ou exprimé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9499b8eb-8a7d-4353-9a0b-1fc8f3471bd1",
                                "sense_id": "8255cb6b-cfc2-3a46-838c-688f2d1e0ca9",
                                "text": "Tandis que le convoi d’artillerie évitait Malmédy, une pagaille indescriptible régnait dans la ville."
                            },
                            {
                                "example_id": "fe4b03ca-f839-4661-aa82-bab976c057e4",
                                "sense_id": "8255cb6b-cfc2-3a46-838c-688f2d1e0ca9",
                                "text": "À l’instant, je me sens au milieu de nulle part. C’est une sensation de malaise indescriptible, un inconfort inqualifiable."
                            },
                            {
                                "example_id": "2a9f1332-3ef6-42bc-ae66-e9cc0374534b",
                                "sense_id": "8255cb6b-cfc2-3a46-838c-688f2d1e0ca9",
                                "text": "D’autres légumes émettent des sons indescriptibles comme le choc d’une aubergine ouverte en deux, le crissement de deux feuilles de choux, l’ensemble produisant une musique électro inédite qui a suscité l’intérêt de plus de 2,5 millions de personnes qui ont visionné leur vidéo sur internet."
                            }
                        ]
                    },
                    {
                        "sense_id": "cae60779-1644-33ab-9287-49f58af58152",
                        "entry_id": "40a15c1a-cf95-351f-a430-efe7720ab2fa",
                        "glosses": [
                            "Dont la description ne rend ou ne rendrait pas justice à la réalité."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "856cac3c-253a-40b5-a6de-6cdc8510dbbe",
                                "sense_id": "cae60779-1644-33ab-9287-49f58af58152",
                                "text": "La misère qui règne est indescriptible. Les troupes ont transformé les environs en un vaste désert, où il ne reste plus un habitant, plus une tête de bétail, plus un boisseau de grain."
                            },
                            {
                                "example_id": "89cf8c72-c805-43d8-8d6a-ecadedcb229d",
                                "sense_id": "cae60779-1644-33ab-9287-49f58af58152",
                                "text": "Là-dessus notre équipe eut mission d’aller à Souain […]. Une demi-heure après nous étions sur le terrain volcanique et comme lunaire tant de fois décrit, et réellement indes­criptible. Des coups de pouce d’un sculpteur gigantesque dans la glaise séchée, ou bien cet aspect des nids de guêpes, gris et feuilletés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fe8073b-c698-44ee-bdbc-dc31c1607983",
                        "source_entry_id": "40a15c1a-cf95-351f-a430-efe7720ab2fa",
                        "target_lang_word": "indescribable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indescribable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e3ca83f-4bb6-3844-9f08-311cbfdfd24b",
                                        "entry_id": "caa1fcdb-acf9-3e12-9a8d-ed7671d4c937",
                                        "glosses": [
                                            "Impossible (or very difficult) to describe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fcb5258-42fb-461c-b4f7-7e4bb2a8166d",
                                                "sense_id": "7e3ca83f-4bb6-3844-9f08-311cbfdfd24b",
                                                "text": "He proved it with indescribable mathematics."
                                            },
                                            {
                                                "example_id": "cfd49ab5-9a09-41a9-a2ce-909644fa0360",
                                                "sense_id": "7e3ca83f-4bb6-3844-9f08-311cbfdfd24b",
                                                "text": "Presently the men set up the melancholy little chant that I had heard on the first night when we were captured in the whaleboat, and the effect produced by their voices was very curious, and quite indescribable."
                                            },
                                            {
                                                "example_id": "da6fec10-d5be-427f-9d0b-f56425fc1ada",
                                                "sense_id": "7e3ca83f-4bb6-3844-9f08-311cbfdfd24b",
                                                "text": "But there was also about him an indescribable air which no mechanic could have acquired in the practice of his handicraft however dishonestly exercised: [...] the air of moral nihilism common to keepers of gambling hells and disorderly houses; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c46774b0-1fc8-3492-b0cb-f4328ea740e4",
                                        "entry_id": "caa1fcdb-acf9-3e12-9a8d-ed7671d4c937",
                                        "glosses": [
                                            "Exceeding all description."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0139d94e-2250-4964-ad6d-1aaab2f596b8",
                                                "sense_id": "c46774b0-1fc8-3492-b0cb-f4328ea740e4",
                                                "text": "Our hotel had an indescribable view of the Bay of Naples."
                                            },
                                            {
                                                "example_id": "8ff1d9c1-3839-4c1f-8087-f4272ad39645",
                                                "sense_id": "c46774b0-1fc8-3492-b0cb-f4328ea740e4",
                                                "text": "The time was when, had such an idea entered her mind, it would have been torture indescribable and agony the most intense; but then, subdued as was the usual warmth of her temperament, an awful suspension seemed to hold her feelings in control."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79c914ab-1b55-4dd7-a25e-81017ec11a97",
                        "source_entry_id": "40a15c1a-cf95-351f-a430-efe7720ab2fa",
