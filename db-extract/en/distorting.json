                "senses": [
                    {
                        "sense_id": "55d039b4-8b2c-35be-a3f8-16539daf17ba",
                        "entry_id": "e07c51e6-fc58-3ef3-8919-9e6ca0cafd9a",
                        "glosses": [
                            "That distorts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a9493d0-a768-4f29-bfef-ae0f4339780d",
                                "sense_id": "55d039b4-8b2c-35be-a3f8-16539daf17ba",
                                "text": "It's like looking in a distorting mirror at the fair."
                            },
                            {
                                "example_id": "16db0b38-b06b-43a6-bb3d-8538d8d575d3",
                                "sense_id": "55d039b4-8b2c-35be-a3f8-16539daf17ba",
                                "text": "However, the procedure has been applied only to those below the threshold and who might move up, and not to those just above, who might move down. This has had a very distorting effect on the distributions."
                            },
                            {
                                "example_id": "ac2a56a3-12a0-4be7-9706-9b5c11630e18",
                                "sense_id": "55d039b4-8b2c-35be-a3f8-16539daf17ba",
                                "text": "This is somewhat counter-intuitive, and indeed goes against the double-dividend argument that in economies with very distorting tax systems we should raise pollution taxes and lower other taxes."
                            }
                        ]
                    }
                ],
