                "senses": [
                    {
                        "sense_id": "e20428aa-ebdf-3a52-b305-db9bcf0b007e",
                        "entry_id": "176017a9-7ac3-3af5-bb18-2fb643e58e67",
                        "glosses": [
                            "scherenartiges Frisiergerät, um Haare in die gewünschte Form (Locken, Wellen) zu bringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56eb875f-4bd6-4aea-9c69-617b366c7721",
                                "sense_id": "e20428aa-ebdf-3a52-b305-db9bcf0b007e",
                                "text": "„Ich beobachte meine Mutter, wie sie ihre Brennschere immer vorher an einer Zeitung ausprobiert, damit die nicht zu heiß ist.“"
                            },
                            {
                                "example_id": "aa535f6b-9ce5-44c9-9bb4-e67c311be8cd",
                                "sense_id": "e20428aa-ebdf-3a52-b305-db9bcf0b007e",
                                "text": "„Mit ihren nackten Schultern, ihrem blauen Kleid und den kurzen, von der Brennschere leicht angesengten Haaren, die sie immerfort zurückwarf, hielt Sophie diesem Grobian die Lippen hin – verlockender und verlogener als nur je eine Filmschauspieerin, die noch mit den geschlossenen Augen der Lust nach der Kamera schielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
