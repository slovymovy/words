                "senses": [
                    {
                        "sense_id": "5e02fe55-53b0-3a2c-928c-fddf201356e3",
                        "entry_id": "5326a0bf-8c1d-3695-a174-432fa5dcbebc",
                        "glosses": [
                            "Donner un caractère hétéro à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1961c20-4413-4a6e-b16c-e9fabe7c2007",
                                "sense_id": "5e02fe55-53b0-3a2c-928c-fddf201356e3",
                                "text": "J’ai du mal à expliquer qu’il ne faut pas hétéroïser l’homosexualité."
                            },
                            {
                                "example_id": "fd289e9f-cef6-40d4-959c-ef0e9d0ff808",
                                "sense_id": "5e02fe55-53b0-3a2c-928c-fddf201356e3",
                                "text": "Ils ont choisi le jeune rocker britannique Josh Beech pour le côté brut, et Myf Shepherd pour hétéroïser un peu le tout."
                            },
                            {
                                "example_id": "24724807-5afd-429e-a763-96de9af906c4",
                                "sense_id": "5e02fe55-53b0-3a2c-928c-fddf201356e3",
                                "text": "Voilà donc ce que j’avais décidé, j’allais m’hétéroïser de façon radicale jusqu’à ce que les hommes ne deviennent pour moi que des camarades de classe ou des amis et non pas des cibles potentielles."
                            }
                        ]
                    }
