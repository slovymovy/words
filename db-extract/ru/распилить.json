                    },
                    {
                        "form_id": "2766df52-f3aa-4adc-8e42-d43669aa0dfb",
                        "entry_id": "c4885607-a772-38d5-a09c-6c784f19e7dc",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "распили́в"
                    },
                    {
                        "form_id": "76c7f2aa-5ae4-4896-9a24-057b7397f7c9",
                        "entry_id": "c4885607-a772-38d5-a09c-6c784f19e7dc",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "распили́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee6198a5-afde-3120-ba74-0bb9755dc838",
                        "entry_id": "c4885607-a772-38d5-a09c-6c784f19e7dc",
                        "glosses": [
                            "разре́зать пилой, закончить процесс пиления на части"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1abc6aac-8a16-4bd5-b242-a78f172b51b1",
                                "sense_id": "ee6198a5-afde-3120-ba74-0bb9755dc838",
                                "text": "Цепи твои распилить мне нетрудно, а подземный ход, чрез который я вошла, имеет сообщение с моим жилищем; но это бы значило совершить только половину дела, и товарищи твои осталось бы в темнице."
                            },
                            {
                                "example_id": "10d169d2-69bc-47e5-8615-8a55ded0dffd",
                                "sense_id": "ee6198a5-afde-3120-ba74-0bb9755dc838",
                                "text": "Мужик по нужде продает сажень дров за рубль, а распилить и расколоть берут рубль двадцать."
                            },
                            {
                                "example_id": "04170360-742c-45f4-86d9-624ae543b38d",
                                "sense_id": "ee6198a5-afde-3120-ba74-0bb9755dc838",
                                "text": "Они вышли на крыльцо и без козел, прижимая бревно ногами, приподнимая его, распилили."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab804a77-6bd0-3671-bd27-1fddbee604f3",
                        "entry_id": "c4885607-a772-38d5-a09c-6c784f19e7dc",
                        "glosses": [
                            "перен., жарг. растратить путём нецелевого расходования средств"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e6c72fe-9c28-4685-bbdd-b3d2b836d52f",
                                "sense_id": "ab804a77-6bd0-3671-bd27-1fddbee604f3",
                                "text": "У нас царит, если можно так выразиться, диктатура бухгалтеров — всё сводится к тому, как освоить деньги, как «распилить» бюджет."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1c1e795-59a0-4ba0-8e15-169fa5235fab",
                        "source_entry_id": "c4885607-a772-38d5-a09c-6c784f19e7dc",
                        "target_lang_word": "zersägen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zersägen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14d19bd3-8733-30b7-b323-a8ff6b170dfa",
                                        "entry_id": "a55fe13e-aa26-39aa-a6e1-4dcfc02ae314",
                                        "glosses": [
                                            "etwas mit der Säge in kleine Stücke zerteilen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d387d82c-33e4-4b36-ae18-ef9d6f44711d",
                                                "sense_id": "14d19bd3-8733-30b7-b323-a8ff6b170dfa",
                                                "text": "Der Mann war bei Aufräumarbeiten gerade damit beschäftigt, einen vom Wind auf die Straße gestürzten Baum zu zersägen, als der Wurzelstock nachrutschte."
                                            },
                                            {
                                                "example_id": "663c77a0-f6b6-414f-808f-f67b5e928f72",
                                                "sense_id": "14d19bd3-8733-30b7-b323-a8ff6b170dfa",
                                                "text": "Die anderen Fleischer der Hauptstadt beziehen ihre Ware von modernen Schlachthöfen, in deren riesigen Hallen Fleisch im Akkord gehauen wird: betäuben, aufschlitzen, zersägen."
                                            },
                                            {
                                                "example_id": "34e460db-5cc1-4649-9e77-663ad6965b47",
                                                "sense_id": "14d19bd3-8733-30b7-b323-a8ff6b170dfa",
                                                "text": "Vor ein paar Jahrzehnten noch zersägten sie - auf der Bühne, in sicherem Abstand zum Publikum - ihre liebreizende Assistentin und klebten sie danach wieder zusammen."
                                            },
                                            {
                                                "example_id": "d882fcec-a80b-49b5-ad8d-70762b53c3e2",
                                                "sense_id": "14d19bd3-8733-30b7-b323-a8ff6b170dfa",
                                                "text": "Sprengmeister Martin Tietjen will sie nun zersägen und auf diese Weise den Sprengstoff unschädlich machen."
                                            },
                                            {
                                                "example_id": "b964088c-523a-494a-82bf-525f18f8edbe",
                                                "sense_id": "14d19bd3-8733-30b7-b323-a8ff6b170dfa",
                                                "text": "Nach zwei Kopfschüssen wurde das Opfer zersägt und in die Donau geworfen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3c8f339-41b8-4717-98a2-25e384a19760",
                        "source_entry_id": "c4885607-a772-38d5-a09c-6c784f19e7dc",
                        "target_lang_word": "durchsägen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "durchsägen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48cbab78-628f-3244-904a-e7a73f72fc70",
                                        "entry_id": "78985335-f332-3607-9107-48feadd69a33",
                                        "glosses": [
                                            "mit Hilfe des Werkzeugs Säge durchtrennen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "557b9a82-4096-4134-b9e9-f290b8df51c3",
                                                "sense_id": "48cbab78-628f-3244-904a-e7a73f72fc70",
                                                "text": "Wenn wir den Baumstamm durchsägen, können wir ihn leichter bewegen und von der Straße wegschaffen."
                                            },
                                            {
                                                "example_id": "9cf46189-3761-4d2e-bf9d-19098497eefd",
                                                "sense_id": "48cbab78-628f-3244-904a-e7a73f72fc70",
                                                "text": "Er kann seine Handschellen gar nicht alleine durchgesägt haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
