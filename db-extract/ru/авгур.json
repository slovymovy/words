                                "target_senses": [
                                    {
                                        "sense_id": "4c17cca5-f137-3a79-8c34-32b1f0ef9ff8",
                                        "entry_id": "538ff34a-c6dc-357c-bc7c-ee85c1f8ffa8",
                                        "glosses": [
                                            "römischer Priester/Beamter, der durch Beobachtung von Vögeln und anderen Tieren den Willen der Götter deutete"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "663ef132-6c28-4301-ae38-f3e04fb62241",
                                                "sense_id": "4c17cca5-f137-3a79-8c34-32b1f0ef9ff8",
                                                "text": "Im alten Rom trugen die Auguren als Zeichen ihrer Würde einen Krummstab."
                                            }
