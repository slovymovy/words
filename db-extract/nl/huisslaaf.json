                        "examples": [
                            {
                                "example_id": "7eef9227-1901-4764-adb2-9b00ec1b5eb6",
                                "sense_id": "429446ff-243c-3de0-9e74-26c14f092f99",
                                "text": "In de tijd van slavernij werden vele mensen gedwongen te leven als huisslaven in de huizen van hun meesters.",
                                "translation": "During the time of slavery, many people were forced to live as house slaves in the houses of their masters.",
                                "english": "During the time of slavery, many people were forced to live as house slaves in the houses of their masters."
                            },
                            {
                                "example_id": "7b245820-a07d-4ecd-bdd4-b0e4b5335aef",
                                "sense_id": "429446ff-243c-3de0-9e74-26c14f092f99",
                                "text": "De huisslaven hadden de verantwoordelijkheid voor het huishouden en het bedienen van hun meesters.",
                                "translation": "The house slaves were responsible for household chores and serving their masters.",
                                "english": "The house slaves were responsible for household chores and serving their masters."
                            },
                            {
                                "example_id": "79976ce8-b9e2-45ee-98fb-d1998bc01e8e",
                                "sense_id": "429446ff-243c-3de0-9e74-26c14f092f99",
                                "text": "Het leven van een huisslaaf was zwaar en vol ontberingen.",
                                "translation": "The life of a house slave was difficult and full of hardships.",
                                "english": "The life of a house slave was difficult and full of hardships."
                            }
                        ]
                    }
