                    {
                        "translation_id": "37611aca-dfc5-4459-8061-2de1e98e7022",
                        "source_entry_id": "e0386515-c79b-32f0-8283-fc577ffa95e9",
                        "source_sense_id": "56569014-52e5-3f5e-a862-680dde06c3f0",
                        "target_lang_word": "Etrusker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Etrusker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eace647d-1a16-3b2b-852f-003308207cba",
                                        "entry_id": "afcc52d0-5e47-3721-beba-19242d1e2df8",
                                        "glosses": [
                                            "Angehöriger des antiken Volkes, das in der Toskana, Umbrien sowie in Latium siedelte und laut Dionysios von Halikarnassos sich selbst Rasenna nannte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb346ef6-60d7-42c4-9a87-1c326edbbb3f",
                                                "sense_id": "eace647d-1a16-3b2b-852f-003308207cba",
                                                "text": "„Die Römer, die zum Stamm der Latiner gehörten, unterhielten enge Kontakte zu den Etruskern, die in der Toskana und in Campanien siedelten.“"
                                            },
                                            {
                                                "example_id": "5cafed69-736a-4db4-8a99-20e1f7d849b3",
                                                "sense_id": "eace647d-1a16-3b2b-852f-003308207cba",
                                                "text": "„Die Kelten drangen bis nach Italien vor und drängten die Etrusker zurück.“"
                                            },
                                            {
                                                "example_id": "00ac9b95-b9b7-4a2f-9a26-864586786647",
                                                "sense_id": "eace647d-1a16-3b2b-852f-003308207cba",
                                                "text": "„In der Lombardei siedelten bis zum 5. Jahrhundert v. Chr. Völker verschiedener Abstammung: Räter, den Latinern verwandte Umbrer, ferner Etrusker und Kelten.“"
                                            },
                                            {
                                                "example_id": "460def2b-9c33-4deb-8702-0fe7f56442cd",
                                                "sense_id": "eace647d-1a16-3b2b-852f-003308207cba",
                                                "text": "„Bald hatten die Kelten die Etrusker in Oberitalien und in der Poebene unterworfen und sich festgesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
