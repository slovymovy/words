                            "beroep"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b6da696-d6a6-43fc-b0fd-0b9735063576",
                        "source_entry_id": "b7adce79-c94b-34ef-b136-575fba037be6",
                        "source_sense_id": "ed1ff5e2-1af2-395f-bcdb-f335cb3cc099",
                        "target_lang_word": "Psychiater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Psychiater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                        "entry_id": "3fc3e076-3a91-3ccb-99eb-d4b075f337ef",
                                        "glosses": [
                                            "Facharzt für Geistes- und Gemütskrankheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16f908a9-3fac-4d71-81a5-108bd693bd12",
                                                "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                                "text": "Der Psychiater hat den Kranken in das Krankenhaus für Neurologie und Psychiatrie eingewiesen."
                                            },
                                            {
                                                "example_id": "48642a70-efc8-49c2-b017-893d761cc26e",
                                                "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                                "text": "„Die Mutter einer Schizophrenen benachrichtigte den behandelnden Psychiater telefonisch, dass der Zustand ihrer Tochter sich wieder verschlechterte.“"
                                            },
                                            {
                                                "example_id": "29c0a2ef-cfec-478a-bc6a-d75d67e87920",
                                                "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                                "text": "„Ein Psychiater von heute hätte vielleicht die verschiedenartigsten narzißstischen Persönlichkeitsstörungen diagnostiziert.“"
                                            },
                                            {
                                                "example_id": "a8a3d7bc-51c1-4b5b-ac2d-4475fa64e102",
                                                "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                                "text": "„Ich wäre dann auf jeden Fall irrsinnig, aber es ist mir trotzdem nie eingefallen, zum Psychiater zu gehen.“"
                                            },
                                            {
                                                "example_id": "5cb63d82-949c-4e79-a015-b9f12d4a0fe7",
                                                "sense_id": "135b9e50-33ff-37ca-8009-ed5198870728",
                                                "text": "„Man saß im Wartezimmer eines Psychiaters in Gesellschaft von lauter Bekloppten und fragte sich, ob man selber einer war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d8121f0-284f-4e1b-92aa-d5f3a5ef0fc1",
                        "source_entry_id": "b7adce79-c94b-34ef-b136-575fba037be6",
                        "source_sense_id": "ed1ff5e2-1af2-395f-bcdb-f335cb3cc099",
                        "target_lang_word": "psychiatrist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychiatrist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1784e18b-d742-309e-ab70-a4ea3f10ef8a",
                                        "entry_id": "a29938c5-2b59-308d-ae67-502a1a7fc02c",
                                        "glosses": [
                                            "A medical doctor specializing in psychiatry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac721783-f899-49b8-bd37-7920fe9c0138",
                                                "sense_id": "1784e18b-d742-309e-ab70-a4ea3f10ef8a",
                                                "text": "Says Colonel Thomas Murray, chief Army psychiatrist in South Viet Nam: “Some of our psychiatrists are the most improbable military guys: soft, flabby, unexercised.”"
                                            },
                                            {
                                                "example_id": "23e7ad4f-6866-4744-99b7-3031543f7f5a",
                                                "sense_id": "1784e18b-d742-309e-ab70-a4ea3f10ef8a",
                                                "text": "Even medical schools seem to have submitted to psychophobia by training psychiatrists almost exclusively as psychopharmacologists instead of as psychotherapists."
                                            },
                                            {
                                                "example_id": "b406d66d-6d28-4b91-ab66-e8294d5a729a",
                                                "sense_id": "1784e18b-d742-309e-ab70-a4ea3f10ef8a",
                                                "text": "Pass the chalk. Dr. Levine was there with a friend and fellow psychiatrist (detect a pattern?), Alexa Albert, Coco’s mother, who squinted up into the sun as her daughter effortlessly sailed skyward. Dr. Albert is an acrophobe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf4dab21-0538-48ca-869f-e8d8b192fc0f",
                        "source_entry_id": "b7adce79-c94b-34ef-b136-575fba037be6",
                        "source_sense_id": "ed1ff5e2-1af2-395f-bcdb-f335cb3cc099",
                        "target_lang_word": "psychiatre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychiatre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92f46b6e-6bcb-3a12-b553-4db617f0c382",
                                        "entry_id": "0ab3c7f4-67d5-38b3-9bd2-f2b453eb426b",
                                        "glosses": [
                                            "Médecin spécialiste de la psychiatrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77dfd513-83ee-4d27-8544-8951d0c0ba7c",
                                                "sense_id": "92f46b6e-6bcb-3a12-b553-4db617f0c382",
                                                "text": "Je l’ai déjà indiqué; un cyclothymique est soigné d’habitude par son médecin habituel; plus rarement il va consulter un médecin neurologique, et ce n’est qu’exceptionnellement qu’il s’adresse à un psychiatre."
                                            },
                                            {
                                                "example_id": "eefb174c-b9e1-4861-bc7b-fb27d91025ef",
                                                "sense_id": "92f46b6e-6bcb-3a12-b553-4db617f0c382",
                                                "text": "Il serait donc vain de nier l’existence et les progrès des maladies mentales au (19) siècle. Les psychiatres classificateurs de l’époque n’ont pas travaillé à enfermer des innocents. A partir des années 1800, la société est massivement pathogène. Et c’est normal."
                                            },
                                            {
                                                "example_id": "d5fb44ec-ad0a-444e-a936-ef194d2b997e",
                                                "sense_id": "92f46b6e-6bcb-3a12-b553-4db617f0c382",
                                                "text": "Seulement, exiger de son nouveau partenaire et/ou de ses enfants de bouleverser très rapidement leur quotidien est risqué, estime le psychiatre Christophe Fauré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8bb0d18-5a9c-4010-836e-1179f3529752",
                        "source_entry_id": "b7adce79-c94b-34ef-b136-575fba037be6",
