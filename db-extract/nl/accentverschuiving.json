                    {
                        "sense_id": "58c542a0-49ab-359d-9aac-0d23ae970033",
                        "entry_id": "ef2cf54c-7448-3354-a19a-675beb2abf83",
                        "glosses": [
                            "verandering waarbij de aandacht meer op een ander onderdeel wordt gevestigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58bbdb9c-1e1a-4812-b867-0b4efca9f7f6",
                                "sense_id": "58c542a0-49ab-359d-9aac-0d23ae970033",
                                "text": "De meeste topstukken hangen weer op hun oude plek, al zijn er kleine accentverschuivingen. Een schilderij van Abraham Bloemaert, Theagenes ontvangt de erepalm van Chariclea, hing altijd hoog in de trapzaal, maar is nu door Buvelot op ooghoogte gehangen."
                            },
                            {
                                "example_id": "15a7a5ab-609d-4f60-a4f8-338ef206e094",
                                "sense_id": "58c542a0-49ab-359d-9aac-0d23ae970033",
                                "text": "Ook Gates’ belangrijkste uitvoerende kracht, de arts Chris Elias, die als hoofd ontwikkeling bij de BMGF belast is met alle projecten op het gebied van landbouw, gezinsplanning, voeding en vaccinatie, is niet helemaal gerust op de accentverschuiving van klassieke hulp naar handel, die onder minister Ploumen in Nederland plaatsvindt."
                            }
                        ]
                    }
