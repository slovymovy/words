    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "19d6f1f1-e059-3d66-8fce-8f5e8ad9fc40",
                "word": "gaslighted",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2ddfab79-d0e7-3054-a75d-161391771e2c",
                        "entry_id": "19d6f1f1-e059-3d66-8fce-8f5e8ad9fc40",
                        "glosses": [
                            "Illuminated by burning gas."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "83c1c1e1-e05d-4d2b-9e4f-5e95fa6dae1c",
                                "sense_id": "2ddfab79-d0e7-3054-a75d-161391771e2c",
                                "text": "Between 1830 and 1880 Germany became a land of railways, gaslighted cities, newspapers, and universities, the last being world leaders in the study of history, philosophy, philology, and law."
                            },
                            {
                                "example_id": "ef83a8ef-cdbc-4bbe-9d19-7b8cc7701627",
                                "sense_id": "2ddfab79-d0e7-3054-a75d-161391771e2c",
                                "text": "He told them he had been gazing at them this hour past, studying the scene before him; how strangely they appeared to him, standing on this little bright gaslighted perch amid the dark sea of life that surged round them; […]"
                            },
                            {
                                "example_id": "2a5cc6a6-71cf-45a8-b070-2a82935165f4",
                                "sense_id": "2ddfab79-d0e7-3054-a75d-161391771e2c",
                                "text": "Once beyond the gaslighted streets, the sense of darkness in the midst of the surging multitude was oppressive and unnatural."
                            },
                            {
                                "example_id": "5a02f811-fcce-4dce-ac25-6f962a8e9d9e",
                                "sense_id": "2ddfab79-d0e7-3054-a75d-161391771e2c",
                                "text": "She had often written glibly about them, but now she was seeing how they actually linked the towns of the nation together, how they connected the lamps of lonely cottages and the lights in lonely small-town depots as well as the gaslighted cities."
                            }
                        ]
                    }
                ],
