                        "glosses": [
                            "hoher Korb, der wie ein Rucksack getragen wird"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "70d99e63-f982-4965-af16-883ab8b3284f",
                                "sense_id": "30e0d2bf-a58e-3a31-9693-df5ebaeba521",
                                "text": "Er trug eine Kiepe voll Äpfel auf dem Rücken."
                            },
                            {
                                "example_id": "a93a89c0-9ef3-43f3-bfef-98d30ad5afe5",
                                "sense_id": "30e0d2bf-a58e-3a31-9693-df5ebaeba521",
                                "text": "„In einer Kiepe, wie sie die Kartoffelsammler auf der Kolchose benutzten, habe er das Kind getragen, erinnerte sich eine der Frauen in dem hohen Haus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
