                ],
                "senses": [
                    {
                        "sense_id": "ad117cee-cd95-3792-923d-702e1573ddad",
                        "entry_id": "b48033e8-215c-35ca-9d57-9042ecf0b4fb",
                        "glosses": [
                            "Druckwerk"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "428aaf33-a940-4d70-aa30-0aaf97feeff4",
                                "sense_id": "ad117cee-cd95-3792-923d-702e1573ddad",
                                "text": "Verteilt wird das Imprimat per Flugzeug. Das erlaubt die flächendeckende Versorgung der ganzen Schweiz mit dem Blatt."
                            },
                            {
                                "example_id": "c4c6805f-5ef8-458b-b5bc-ba5448bcbdd4",
                                "sense_id": "ad117cee-cd95-3792-923d-702e1573ddad",
                                "text": "„Mag man dafür in der preiswerten Economyklasse noch Verständnis aufbringen, so fühlt man sich als einer der letzten noch vor dem Vorhang placierten Passagiere betrogen, wenn die «Neue Zürcher Zeitung» - oder jedes andere in der persönlichen Präferenz hoch geschätzte Imprimat - nicht mehr erhältlich ist.“"
                            },
                            {
                                "example_id": "92fb5571-837d-4623-834c-f858aece09be",
                                "sense_id": "ad117cee-cd95-3792-923d-702e1573ddad",
                                "text": "Wo wird das selbst getextete und auch eigens graphisch gestaltete Imprimat überall angeboten?"
                            },
                            {
                                "example_id": "c11f035b-27be-4d5a-af8a-cf14315f29f0",
                                "sense_id": "ad117cee-cd95-3792-923d-702e1573ddad",
                                "text": "Nur eine Woche später halten Sie nun, werte Leserinnen und Leser, mit der SIMMENTAL ZEITUNG das Nachfolge-Imprimat in den Händen."
                            },
                            {
                                "example_id": "9cf9c398-dca1-4dc0-b2e0-1ede63aca22c",
                                "sense_id": "ad117cee-cd95-3792-923d-702e1573ddad",
                                "text": "Daß Burks Werk ungeachtet mehrerer kritischer Spitzen das Imprimat der Elvis-Presley-Gesellschaft erhielt, kündet vom Bröckeln der Fronten in der Elvis-Forschung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c0f1e226-4acd-32ca-b5de-522dae77949d",
                        "entry_id": "b48033e8-215c-35ca-9d57-9042ecf0b4fb",
                        "glosses": [
                            "nach innen verschobenes Knochenfragment bei einer Impressionsfraktur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2ba1421-4c43-40d7-8130-f65dbafd3a73",
                                "sense_id": "c0f1e226-4acd-32ca-b5de-522dae77949d",
                                "text": "„Das Perikranium wird rund um das Imprimat inzidiert und abgelöst, so daß die einzelnen Knochenfragmente unterfahren und herausgehoben werden können […].“"
                            },
                            {
                                "example_id": "f5d3eb05-15b0-4d85-be0d-8ce08e950edf",
                                "sense_id": "c0f1e226-4acd-32ca-b5de-522dae77949d",
                                "text": "„Neben dem Imprimat setzt man ein Bohrloch, von dem aus mit oder ohne Erweiterung des Zuganges das Imprimat herausgehebelt oder fragmentweise vorsichtig herausgehoben werden kann […].“"
                            },
                            {
                                "example_id": "b8ce303d-c7ee-41e4-9daf-c7e1d9385ff1",
                                "sense_id": "c0f1e226-4acd-32ca-b5de-522dae77949d",
                                "text": "„Nach offener Reposition wird das Imprimat mit einem Elevatorium angehoben und mit autogener Spongiosa, allogenem Knochen oder Knochenersatzmaterialien unterfüttert […].“"
                            },
                            {
                                "example_id": "d5581edf-d204-42e7-b23d-cc1950492ae6",
                                "sense_id": "c0f1e226-4acd-32ca-b5de-522dae77949d",
                                "text": "„Die Hebung des Imprimats konnte fortgesetzt werden.“"
                            },
                            {
                                "example_id": "f4da32fc-55df-4085-840c-fd80f0b81ac0",
                                "sense_id": "c0f1e226-4acd-32ca-b5de-522dae77949d",
                                "text": "„Bei letzteren ist häufig, projektionsbedingt, eine scheinbare Überlagerung von Kalottenanteilen in Form einer verdichteten Knochenzeichnung Hinweis für ein Imprimat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc4a6d98-2835-4e9f-8727-296cf54cbe83",
                        "source_entry_id": "b48033e8-215c-35ca-9d57-9042ecf0b4fb",
                        "source_sense_id": "ad117cee-cd95-3792-923d-702e1573ddad",
                        "source_sense_description": "schweizerisch: Druckwerk",
                        "target_lang_word": "imprint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "030f03ce-c00d-3531-a1e6-210dc1d6a896",
                                        "entry_id": "54ed6ba6-da9c-3549-bc37-26d961cbdbbe",
                                        "glosses": [
                                            "An impression; the mark left behind by printing something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e3e92d4-c89c-4a39-9138-1b63db5f4127",
                                                "sense_id": "030f03ce-c00d-3531-a1e6-210dc1d6a896",
                                                "text": "The day left an imprint in my mind."
                                            },
                                            {
                                                "example_id": "5c5e71f2-2238-46fa-9b1c-1b7bcafb080e",
                                                "sense_id": "030f03ce-c00d-3531-a1e6-210dc1d6a896",
                                                "text": "It was the moment everyone knew the Champions League trophy was on its way back to the Bernabéu and, once again, that the four-times Ballon d’Or winner had left his imprint on another final."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d362f5d0-42f7-3b7b-9f22-e6b6993edd4f",
                                        "entry_id": "54ed6ba6-da9c-3549-bc37-26d961cbdbbe",
                                        "glosses": [
                                            "The name and details of a publisher or printer, as printed in a book etc.; a publishing house."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc7f73f7-96b1-4930-9836-446a5aa5d039",
                                                "sense_id": "d362f5d0-42f7-3b7b-9f22-e6b6993edd4f",
                                                "text": "From their Belmont Avenue address they issued such memorable titles as I Peddle Jazz, Camera Bait, Our Flesh Was Cheap, Lesbian Twins, and His Sex, His Problem under at least four different imprints—Saber, Fabian, Vega, and National Library Books."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c35547b1-c6ed-3d8a-9029-91bc3bf3a992",
                                        "entry_id": "54ed6ba6-da9c-3549-bc37-26d961cbdbbe",
                                        "glosses": [
                                            "A distinctive marking, symbol or logo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "086ef0e2-b7cd-45df-9939-3c0ce900ec5e",
                                                "sense_id": "c35547b1-c6ed-3d8a-9029-91bc3bf3a992",
                                                "text": "The shirts bore the company imprint on the right sleeve."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "imprint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76f226ba-b9d3-3b85-b732-d7ab15f18367",
                                        "entry_id": "9002b7c8-988b-367a-80d0-cf47bbcfe3e0",
                                        "glosses": [
                                            "To leave a print, impression, image, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82d078b4-956b-4995-a52f-a93f95e7c9b1",
                                                "sense_id": "76f226ba-b9d3-3b85-b732-d7ab15f18367",
                                                "text": "For a fee, they can imprint the envelopes with a monogram."
                                            },
                                            {
                                                "example_id": "21ff95b7-eca7-4154-ad25-a933baeb59be",
                                                "sense_id": "76f226ba-b9d3-3b85-b732-d7ab15f18367",
                                                "text": "For though a Child quickly aſſent to this Propoſition, That an Apple is not Fire; when, by familiar Acquaintance, he has got the Idea's of thoſe two different things diſtinctly imprinted on his Mind, and has learnt that the names Apple and Fire ſtand for them; yet it will be ſome years after, perhaps, before the ſame Child will aſſent to this Propoſition, That it is impoſſible for the ſame thing to be, and not to be."
                                            },
                                            {
                                                "example_id": "074ae4a6-6725-4740-9394-68e742b7d3ef",
                                                "sense_id": "76f226ba-b9d3-3b85-b732-d7ab15f18367",
                                                "text": "Him great in peace and wealth fair Deva knows; / For ſhe amidſt his ſpacious meadows flows; / Inclines her urn upon his fatten'd lands; / And ſees his num'rous herd imprint her ſands."
                                            },
                                            {
                                                "example_id": "b404ea84-a95f-4402-9c09-3424313eaffe",
                                                "sense_id": "76f226ba-b9d3-3b85-b732-d7ab15f18367",
                                                "text": "Nature imprints upon whate'er we ſee / That has a heart and life in it, be free; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "075c6fc5-7087-3493-a1bf-b2a462d335b2",
                                        "entry_id": "9002b7c8-988b-367a-80d0-cf47bbcfe3e0",
                                        "glosses": [
                                            "To learn something indelibly at a particular stage of life, such as who one's parents are."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a8ee736-e4e7-4019-88b5-82a818c6d344",
                                                "sense_id": "075c6fc5-7087-3493-a1bf-b2a462d335b2",
                                                "text": "That is, by way of this initial imprinting the young animal becomes a socialized member of its species. Animals misimprinted to other species show a variety of abnormal social behaviors as adults."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ea4916a-685f-3434-a3b8-64e18f633d84",
                                        "entry_id": "9002b7c8-988b-367a-80d0-cf47bbcfe3e0",
                                        "glosses": [
                                            "To mark a gene as being from a particular parent so that only one of the two copies of the gene is expressed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d48e72a4-102b-4c2d-9dd2-ed7618eaa412",
                        "source_entry_id": "b48033e8-215c-35ca-9d57-9042ecf0b4fb",
                        "source_sense_id": "ad117cee-cd95-3792-923d-702e1573ddad",
                        "source_sense_description": "schweizerisch: Druckwerk",
                        "target_lang_word": "empreinte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empreinte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "589e452b-2cbf-3b29-b9a4-87db98c6f325",
                                        "entry_id": "b65421a6-f5ee-39bf-858d-0912d061cc7b",
                                        "glosses": [
                                            "Figure empreinte, impression, marque obtenue par pression."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc8deea9-ff86-406c-9302-a647028a4f18",
                                                "sense_id": "589e452b-2cbf-3b29-b9a4-87db98c6f325",
                                                "text": "Marbre et Sabine avaient obtenu de leur lieutenant la permission de suivre quelques traces fraîches […]. Ces empreintes étaient évidemment dues au passage récent d'une demi-douzaine de daims de grande taille."
                                            },
                                            {
                                                "example_id": "d40ba11e-06da-4c71-9022-265a9811b826",
                                                "sense_id": "589e452b-2cbf-3b29-b9a4-87db98c6f325",
                                                "text": "A Beduaram il entre dans cette vaste et monotone plaine saharienne, sans végétation et où l’empreinte même de l’animal ne laisse qu’une trace insensible que le moindre vent efface."
                                            },
                                            {
                                                "example_id": "f5828c03-6522-4340-bb53-866e480e6a23",
                                                "sense_id": "589e452b-2cbf-3b29-b9a4-87db98c6f325",
                                                "text": "Nous campons sur sa rive droite, dans un terrain spongieux, où chaque pas laisse une empreinte profonde qui se remplit d’eau, […]."
                                            },
                                            {
                                                "example_id": "3feaff4e-f20c-448d-a520-d8cdecd55891",
                                                "sense_id": "589e452b-2cbf-3b29-b9a4-87db98c6f325",
                                                "text": "[…], ils me font toujours souvenir du ciel gris de chaleur, de la poussière qui portait l’empreinte de pieds nus et des touffes immobiles des hauts papayers lisses […]."
                                            },
                                            {
                                                "example_id": "c39d39ff-9d9d-4300-9b01-e8d767ad9e6d",
                                                "sense_id": "589e452b-2cbf-3b29-b9a4-87db98c6f325",
                                                "text": "À son arrivée, on lui avait demandé une empreinte de sa carte de crédit, et elle l’avait donnée, elle ne voyait pas comment refuser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e629efd-8ea6-3959-a92f-d94e2e6e1053",
                                        "entry_id": "b65421a6-f5ee-39bf-858d-0912d061cc7b",
                                        "glosses": [
                                            "Figure de plantes, d’insectes, de poissons, etc., qu’on trouve empreintes sur certaines pierres."
                                        ],
                                        "tags": [
                                            "Histoire naturelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88d96979-f0d3-4283-b2f9-e6f1041728f1",
                                                "sense_id": "0e629efd-8ea6-3959-a92f-d94e2e6e1053",
                                                "text": "Empreintes de fougère. Empreintes de poissons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a52080b-63df-348d-9404-245ddc95df9b",
                                        "entry_id": "b65421a6-f5ee-39bf-858d-0912d061cc7b",
                                        "glosses": [
                                            "Forme en creux à l'intérieur d'un moule qui permet d'obtenir une pièce."
                                        ],
                                        "tags": [
                                            "Fonderie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2be80e00-f8a1-4d10-bef5-79a66a21caf3",
                                                "sense_id": "7a52080b-63df-348d-9404-245ddc95df9b",
                                                "text": "Un moule peut contenir plusieurs empreintes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38721055-9807-36bf-bd71-7c63f7c36d28",
                                        "entry_id": "b65421a6-f5ee-39bf-858d-0912d061cc7b",
                                        "glosses": [
                                            "Trace laissée par un contact de la peau sur un objet."
                                        ],
                                        "tags": [
                                            "Anthropométrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a7c4df8-e879-4ee0-ad29-588bc1e0b22a",
                                                "sense_id": "38721055-9807-36bf-bd71-7c63f7c36d28",
                                                "text": "« Oui, j'ai bien un pouce ici », confirme la dactylo-technicienne. Elle repose poudre et pinceau pour saisir un carré de transfert transparent qu'elle vient appliquer avec soin sur l’empreinte à relever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3aca11f-799f-35ac-921e-2441aa12b7cd",
                                        "entry_id": "b65421a6-f5ee-39bf-858d-0912d061cc7b",
                                        "glosses": [
                                            "Marque distinctive et durable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4281ba26-6331-4925-9362-640e4bd3561a",
                                                "sense_id": "c3aca11f-799f-35ac-921e-2441aa12b7cd",
                                                "text": "Le style du chantre d’Ulysse n’est pas un style d’école et de pratique ; et l’ongle du lion, la divine empreinte du génie y est partout manifeste, et aussi évidente, sinon aussi brûlante, que dans le style du chantre d’Achille."
                                            },
                                            {
                                                "example_id": "96b4c6cb-503e-4c0c-bf4d-b16f771db44f",
                                                "sense_id": "c3aca11f-799f-35ac-921e-2441aa12b7cd",
                                                "text": "Qu’il s’agisse d’une entrée ou d’une sortie de prison, d’une libération ou d’un transfèrement, ou simplement de la notification d’une décision administrative ou judiciaire (comme un arrêté d’expulsion, par exemple), le but est toujours le même : conserver une empreinte suffisante de la personnalité pour pouvoir identifier la description présente avec celle que l’on pourrait être amené à relever ultérieurement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c18a1067-d880-38f4-8a42-cc808cbf6df5",
                                        "entry_id": "b65421a6-f5ee-39bf-858d-0912d061cc7b",
                                        "glosses": [
                                            "Fixation du nouveau-né sur le premier objet qui se présente à lui."
                                        ],
                                        "tags": [
                                            "Éthologie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ba2f327-53f3-3885-b3e4-558eae89fad5",
                                        "entry_id": "b65421a6-f5ee-39bf-858d-0912d061cc7b",
                                        "glosses": [
                                            "Résultat d'une fonction de hachage qui permet d’identifier la donnée initiale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fba3be0e-0f1e-4a43-9b0a-a7d87af55946",
                                                "sense_id": "3ba2f327-53f3-3885-b3e4-558eae89fad5",
                                                "text": "La technique visant à assurer l’intégrité d’un message consiste à réduire celui-ci à un « condensat » (empreinte) qui est une information de longueur fixe obtenue à l’aide d’un algorithme réducteur, le « hachage »."
                                            },
                                            {
                                                "example_id": "7e5474b6-ad00-4f3a-b05b-ab07789c4587",
                                                "sense_id": "3ba2f327-53f3-3885-b3e4-558eae89fad5",
                                                "text": "Le mineur fait passer dans la fonction de hachage (SHA-256 dans le cas du Bitoin, Script pour d’autres cryptomonnaies), obtenant en retour un hash, ou somme de contrôle, ou empreinte, qui est en l’occurrence un arbre de Merkle."
                                            }
                                        ]
                                    }
