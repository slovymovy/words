                "senses": [
                    {
                        "sense_id": "5b188d79-fde2-3511-ae06-4a47605a80f8",
                        "entry_id": "516a270f-fe5d-3b09-a3c2-6da105ddb85d",
                        "glosses": [
                            "Niederschlag, bei dem Regen und Schnee zugleich – gemischt – fallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f7d6ffd-6658-42c2-aacf-021b63347c4b",
                                "sense_id": "5b188d79-fde2-3511-ae06-4a47605a80f8",
                                "text": "Soeben fällt heftiger Schneeregen."
                            },
                            {
                                "example_id": "932b08eb-0362-4316-9f7e-1abfe0dccdc5",
                                "sense_id": "5b188d79-fde2-3511-ae06-4a47605a80f8",
                                "text": "„Die Nacht war stockdunkel, dichte Nebelschwaden zogen über die Erde, ganz Richmond lag im Dunst, während Schneeregen fiel.“"
                            },
                            {
                                "example_id": "717031ad-27c2-4652-b7c2-7b084d2bb6f9",
                                "sense_id": "5b188d79-fde2-3511-ae06-4a47605a80f8",
                                "text": "„Sie wurde krank, nachdem der Vater sie gegen Hallas Willen in kaltem Frühlingswetter, das am Nachmittag in Schneeregen und strengen, kalten Nordwind überging, auf einen Ausflug in dienstlichen Angelegenheiten mitgenommen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
