                                "sense_id": "a3baca39-cb83-3f7e-b456-0111ee1b789c",
                                "text": "Przy naszym rynku znajduje się poczta, kościół, komisariat i urząd miasta."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2a5764e2-a9d2-3f8c-b448-61a906fa8387",
