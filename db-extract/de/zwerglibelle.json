                        "cross_references": [
                            {
                                "target_word": "déesse précieuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9ec0fd0-1096-34d4-9130-17e5935dc780",
                                        "entry_id": "ad24dc3c-e64c-36fb-9802-c186756852d0",
                                        "glosses": [
                                            "Espèce de petite demoiselle des mares et tourbières d’Eurasie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74c0767a-ca87-4139-838c-1448678119e7",
                                                "sense_id": "d9ec0fd0-1096-34d4-9130-17e5935dc780",
                                                "text": "Avec ses 24 à 26 mm de longueur la Déesse précieuse est la plus petite libellule d’Europe. Son corps est très étroit et ses ailes courtes."
                                            },
                                            {
                                                "example_id": "af0fe31c-bc76-4fa9-8d7f-955350131460",
                                                "sense_id": "d9ec0fd0-1096-34d4-9130-17e5935dc780",
                                                "text": "Certains noms français des libellules reprennent littéralement les caractéristiques des noms latins, mais d’autres tels que la Déesse précieuse et la Petite nymphe au corps de feu enflamment l’imaginaire… Mais entre naturalistes, on continue d’utiliser les noms latins pour garder la tête froide !"
                                            },
                                            {
                                                "example_id": "1d6b8762-2188-4deb-84a2-79581f105328",
                                                "sense_id": "d9ec0fd0-1096-34d4-9130-17e5935dc780",
                                                "text": "Quatre ans déjà que la silhouette gracile, verte métallisée et tachetée de marques bleues de la Déesse précieuse - un insecte de la famille des demoiselles, proche des libellules - n’a plus été aperçue dans les tourbières du Jura, unique site où l’espèce était présente en France, avec une petite dizaine d’individus recensés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
