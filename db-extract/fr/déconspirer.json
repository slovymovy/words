                "senses": [
                    {
                        "sense_id": "4164be0c-fa48-3664-ab3c-ad03c17547be",
                        "entry_id": "645f2bd9-9707-3482-98db-8c25aaaecbd8",
                        "glosses": [
                            "Faire des révélations sur l’identité et les actes de personnes qui avaient conspiré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0ea9b2d-3cd0-424b-8887-dcd076368d0b",
                                "sense_id": "4164be0c-fa48-3664-ab3c-ad03c17547be",
                                "text": "Certes, le CNSAS est censé « déconspirer » le passé trouble de certains juges et fonctionnaires. Mais la loi exempte les politiques de haut rang et les parlementaires."
                            },
                            {
                                "example_id": "b379e099-9baf-412b-919c-9e0b12b6d3e0",
                                "sense_id": "4164be0c-fa48-3664-ab3c-ad03c17547be",
                                "text": "\"C’est trop tard, il fallait déconspirer dès la Révolution\" soutiennent, avec regret, des voix aussi insoupçonnables que celle de Bogdan Hossu."
                            },
                            {
                                "example_id": "85082f67-ccad-4594-8100-47f1605931ed",
                                "sense_id": "4164be0c-fa48-3664-ab3c-ad03c17547be",
                                "text": "Nous avions une loi qui nous demandait de \"déconspirer\", mais pas de dossiers!"
                            },
                            {
                                "example_id": "1f52d1ac-935d-40b1-ae15-b6d5e5db5f1b",
                                "sense_id": "4164be0c-fa48-3664-ab3c-ad03c17547be",
                                "text": "Au contraire, un retour sur cette affaire peut amener à déconspirer l’opération menée avec toutes les conséquences pour notre gouvernement."
                            }
                        ]
                    }
                ],
