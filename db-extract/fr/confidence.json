        "fr-extract.jsonl": [
            {
                "entry_id": "c6f254ec-3f49-3e9c-996a-5f4dd2d050dc",
                "word": "confidence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7c93c371-2776-4179-ac82-1b956809774d",
                        "entry_id": "c6f254ec-3f49-3e9c-996a-5f4dd2d050dc",
                        "tags": [
                            "plural"
                        ],
                        "form": "confidences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb1aa085-1f9c-36b4-ad29-fea18abd7c74",
                        "entry_id": "c6f254ec-3f49-3e9c-996a-5f4dd2d050dc",
                        "glosses": [
                            "Communication d’un secret."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03a0103e-aca4-4e13-a937-6c8c1cf161c3",
                                "sense_id": "fb1aa085-1f9c-36b4-ad29-fea18abd7c74",
                                "text": "Il fut trahi par un homme à qui il avait fait confidence de son projet."
                            },
                            {
                                "example_id": "c8dc464c-92d5-43d9-aa0c-5c575674f02b",
                                "sense_id": "fb1aa085-1f9c-36b4-ad29-fea18abd7c74",
                                "text": "Il faut croire que le Père de Ragon était peu soucieux de livrer aux moqueuses oreilles de Chiffon les confidences de celles qu'elle appelait si irrévérencieusement « les grenouilles de bénitier », car subitement il se ravisa, disant, comme s'il n'avait rien entendu : […]."
                            },
                            {
                                "example_id": "2c8a4a46-909d-4794-a265-0ca4fe06c93a",
                                "sense_id": "fb1aa085-1f9c-36b4-ad29-fea18abd7c74",
                                "text": "Elle avait reçu, pourtant, bien des confidences. Quand il en avait trop gros sur le cœur, à de certains moments trop heureux ou trop tragiques de sa vie, […], Balzac, en dépit de sa force de renfermement, éprouvait le besoin de s'épancher..."
                            },
                            {
                                "example_id": "85e524f7-93d1-4e33-b18b-058b7cf618e5",
                                "sense_id": "fb1aa085-1f9c-36b4-ad29-fea18abd7c74",
                                "text": "Il faut que je vous mette dans la confidence."
                            },
                            {
                                "example_id": "3bf86c81-563a-42c7-bd2b-dda5d5b58d8f",
                                "sense_id": "fb1aa085-1f9c-36b4-ad29-fea18abd7c74",
                                "text": "Ses dents en or et sa claudication laissaient entendre, avant qu'il ne se fût livré à la moindre confidence, que son ancien métier entraînait certains risques."
                            },
                            {
                                "example_id": "be678f89-851f-44a4-8e73-0ccecc73b3ac",
                                "sense_id": "fb1aa085-1f9c-36b4-ad29-fea18abd7c74",
                                "text": "Si l'on ne peut pas dire que les réponses soient tout à fait franches du collier, on ne peut pas non plus estimer que les prisonniers se refusent à des confidences."
                            }
                        ]
                    },
                    {
                        "sense_id": "386184fb-6bd0-37e1-83e9-2ad3aa86f7d8",
                        "entry_id": "c6f254ec-3f49-3e9c-996a-5f4dd2d050dc",
                        "glosses": [
                            "Confiance qui porte quelqu’un à faire part de ses secrets à un autre."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "43f3c18f-3bd2-4fa0-b86d-161277598282",
                                "sense_id": "386184fb-6bd0-37e1-83e9-2ad3aa86f7d8",
                                "text": "Je suis éphébophile et non pédéraste, Madame, précisait l'Ambassadeur à la reine Isabelle avec qui il était sur le pied de la confidence, de ce ton leste que seul vous octroie le commerce d'une longue amitié."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0676566-44d8-436d-9a93-9faa5de32bb4",
                        "source_entry_id": "c6f254ec-3f49-3e9c-996a-5f4dd2d050dc",
                        "target_lang_word": "confidence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confidence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d54a281-052b-3fee-b037-1a8f8fd8e5e8",
                                        "entry_id": "4a72190e-4978-3219-8349-225208226a49",
                                        "glosses": [
                                            "Self-assurance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91447330-766d-4ee2-9b41-8225eff0253b",
                                                "sense_id": "2d54a281-052b-3fee-b037-1a8f8fd8e5e8",
                                                "text": "He entered the ring with confidence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d5d7ed5-8890-383b-8d3b-cb24a38a0962",
                                        "entry_id": "4a72190e-4978-3219-8349-225208226a49",
                                        "glosses": [
                                            "A feeling of certainty; firm trust or belief; faith."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c953efe6-64e8-4d49-99ac-8fd103c483f5",
                                                "sense_id": "7d5d7ed5-8890-383b-8d3b-cb24a38a0962",
                                                "text": "She had confidence it would soon end."
                                            },
                                            {
                                                "example_id": "b87f62f3-206b-4ad0-be18-546ff46a3863",
                                                "sense_id": "7d5d7ed5-8890-383b-8d3b-cb24a38a0962",
                                                "text": "It is better to truſt in the Lord : then to put confidence in man. / It is better to truſt in the Lord : then to put confidence in Princes."
                                            },
                                            {
                                                "example_id": "fe0ebaca-3e7d-455d-bd1d-3d022851f240",
                                                "sense_id": "7d5d7ed5-8890-383b-8d3b-cb24a38a0962",
                                                "text": "Khedron hesitated for a moment, wondering how far he should take Jeserac into his confidence. He knew that Jeserac was kindly and well-intentioned, but he also knew that he must be bound by the same taboos that controlled everyone on Diaspar."
                                            },
                                            {
                                                "example_id": "669172c3-6af4-459e-90db-9fb65c35f788",
                                                "sense_id": "7d5d7ed5-8890-383b-8d3b-cb24a38a0962",
                                                "text": "But electric vehicles and the batteries that made them run became ensnared in corporate scandals, fraud, and monopolistic corruption that shook the confidence of the nation and inspired automotive upstarts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6af89e55-bf6e-3c86-b402-7747c6e4b71e",
                                        "entry_id": "4a72190e-4978-3219-8349-225208226a49",
                                        "glosses": [
                                            "Information held in secret; a piece of information shared but to thence be kept in secret."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a9ca2b6-ec39-4f53-acab-368b3a1a7db1",
                                                "sense_id": "6af89e55-bf6e-3c86-b402-7747c6e4b71e",
                                                "text": "In the course of these confidences it became quite plain to me I had been represented to the wife of the high dignitary, and goodness knows to how many more people besides, as an exceptional and gifted creature - a piece of good fortune for the Company - a man you don’t get hold of every day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dae91c80-8457-32d2-ac69-01719c3315d1",
                                        "entry_id": "4a72190e-4978-3219-8349-225208226a49",
                                        "glosses": [
                                            "Boldness; presumption."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
