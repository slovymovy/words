                "senses": [
                    {
                        "sense_id": "060ba27a-1654-356b-af79-406845393ad8",
                        "entry_id": "b3a3a316-03fd-3f10-adf3-75640e1dba09",
                        "glosses": [
                            "ein Elementarteilchen aus der Gruppe der Leptonen; verwandt mit dem Elektron"
                        ],
                        "tags": [
                            "physics",
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "5dbf44f9-3e9b-4f32-aec0-63074fd2f06a",
                                "sense_id": "060ba27a-1654-356b-af79-406845393ad8",
                                "text": "Myonen können, genauso wie Elektronen, um Atomkerne kreisen."
                            },
                            {
                                "example_id": "44b47a59-4efe-43ca-90d9-9d5c2960a3b7",
                                "sense_id": "060ba27a-1654-356b-af79-406845393ad8",
                                "text": "Das Myon war das erste Elementarteilchen, das außerhalb eines Atomes gefunden wurde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "981b09d5-a6df-30e3-97bb-ca2f6dcf61a3",
                        "entry_id": "b3a3a316-03fd-3f10-adf3-75640e1dba09",
                        "glosses": [
                            "kleinste Funktionseinheit eines Muskels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffa8c565-fc3d-42ae-8ecf-a5e8746313b5",
                                "sense_id": "981b09d5-a6df-30e3-97bb-ca2f6dcf61a3",
                                "text": "Ein Muskel besteht aus mehreren Myonen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83493257-14df-4278-b45e-3f1c57af4101",
                        "source_entry_id": "b3a3a316-03fd-3f10-adf3-75640e1dba09",
                        "source_sense_id": "060ba27a-1654-356b-af79-406845393ad8",
                        "source_sense_description": "Elementarteilchen aus der Gruppe der Leptonen",
                        "target_lang_word": "muon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6db1e4b9-4f7a-304a-9d35-a2720167fe53",
                                        "entry_id": "28b3bd39-b592-366d-ba4d-ff5872407aea",
                                        "glosses": [
                                            "An unstable elementary particle in the lepton family, having similar properties to the electron but with a mass 207 times greater."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3640b4f-53a1-4b79-b6b7-35246d3b0182",
                                                "sense_id": "6db1e4b9-4f7a-304a-9d35-a2720167fe53",
                                                "text": "The μ-meson of Powell (called here muon) is instead a disintegration product of the pion, only weakly linked to the nucleons and therefore of little importance in the explanation of nuclear forces."
                                            },
                                            {
                                                "example_id": "ad6ab89e-7010-4dfa-9ae4-0fc68c4f7137",
                                                "sense_id": "6db1e4b9-4f7a-304a-9d35-a2720167fe53",
                                                "text": "The spectrum of electrons arising from the decay of the negative mu meson has been determined. The muons are arrested in the gas of a high pressure hydrogen filled diffusion cloud chamber."
                                            },
                                            {
                                                "example_id": "0bee3996-50e4-4fe6-a1cc-b40ffa89b0bd",
                                                "sense_id": "6db1e4b9-4f7a-304a-9d35-a2720167fe53",
                                                "text": "The data comes from experiments at the Fermilab US particle accelerator facility, which explored how subatomic particles called muons – similar to electrons but about 200 times heavier – move in a magnetic field."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a105b4df-88a5-43d1-8b45-c5cd9e9f4719",
                        "source_entry_id": "b3a3a316-03fd-3f10-adf3-75640e1dba09",
                        "source_sense_id": "060ba27a-1654-356b-af79-406845393ad8",
                        "source_sense_description": "Elementarteilchen aus der Gruppe der Leptonen",
                        "target_lang_word": "muon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "073c004d-d775-3fbc-92c7-256218cebdc9",
                                        "entry_id": "1df1106f-bc74-341e-a07d-5814c7fadf48",
                                        "glosses": [
                                            "Particule élémentaire appartenant à la famille des leptons, dont la masse est 207 fois plus grande que celle de l'électron, et possédant un spin 1/2."
                                        ],
                                        "tags": [
                                            "Physique des particules"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "114972cc-148e-4df0-93ff-5187aae9728d",
                                                "sense_id": "073c004d-d775-3fbc-92c7-256218cebdc9",
                                                "text": "On sait depuis longtemps que l’électron a un grand frère qui s’appelle le muon, qui n’en diffère que par une masse près de deux cents fois plus grande, et, d’après les lois de l’électrodynamique quantique, que le muon observe religieusement, par un moment magnétique réduit dans le même rapport."
                                            },
                                            {
                                                "example_id": "a75a4901-513e-4e04-b4c8-dc0d33f17c60",
                                                "sense_id": "073c004d-d775-3fbc-92c7-256218cebdc9",
                                                "text": "Pourquoi de si grosses machines pour déceler de si petites particules, aux noms pour moi enchanteurs — électrons, muons, neutrinos, quarks, fermions, pions, bosons, hypérons ou kaons ?"
                                            },
                                            {
                                                "example_id": "5e346c90-8494-418c-9c18-fe4d1ce299fa",
                                                "sense_id": "073c004d-d775-3fbc-92c7-256218cebdc9",
                                                "text": "L’autre catégorie de particules élémentaires, les leptons, est liée aux électrons qu'elle contient. À nouveau, on en trouve de trois catégories par ordre de masse : les électrons, les muons et les tauons. Les muons sont 200 fois plus lourds que les électrons, les tauons 3 700 fois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d969ba70-67ec-42bd-948e-c88dc8eb06cb",
                        "source_entry_id": "b3a3a316-03fd-3f10-adf3-75640e1dba09",
                        "source_sense_id": "060ba27a-1654-356b-af79-406845393ad8",
