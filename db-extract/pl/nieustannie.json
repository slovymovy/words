                "forms": [],
                "senses": [
                    {
                        "sense_id": "76b61ef6-4c94-31d1-958e-9653836c46a8",
                        "entry_id": "21cc9da2-95de-3986-af7b-4a7e119fff3e",
                        "glosses": [
                            "bez przerwy, non-stop, bez ustanku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "608420f0-6cf0-4b41-8c0c-7d5e5b44f60a",
                                "sense_id": "76b61ef6-4c94-31d1-958e-9653836c46a8",
                                "text": "Czy musisz nieustannie narzekać na swoich sąsiadów?"
                            },
                            {
                                "example_id": "7a2a299c-7e3c-4260-b67d-b03739590478",
                                "sense_id": "76b61ef6-4c94-31d1-958e-9653836c46a8",
                                "text": "W istocie bowiem proces emisji, sprzedaży i wykupu weksli skarbowych trwa nieustannie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14b17254-7d9e-432d-97b8-b17ad8f1ad05",
                        "source_entry_id": "21cc9da2-95de-3986-af7b-4a7e119fff3e",
                        "source_sense_id": "76b61ef6-4c94-31d1-958e-9653836c46a8",
                        "target_lang_word": "incessantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incessantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "609e7f3d-9a0a-3a8c-b720-4ebe9a4fa969",
                                        "entry_id": "1c0b5e0c-ce41-3dbd-9e12-4edd7241bf72",
                                        "glosses": [
                                            "In a manner without pause or stop, especially to the point of annoyance; not ceasing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8942fe8-0ec5-4c4c-994d-570e2a765d3f",
                                                "sense_id": "609e7f3d-9a0a-3a8c-b720-4ebe9a4fa969",
                                                "text": "He jabbered incessantly and annoyed everyone."
                                            },
                                            {
                                                "example_id": "536a0ccc-3282-4737-88a6-732bbbeeeadf",
                                                "sense_id": "609e7f3d-9a0a-3a8c-b720-4ebe9a4fa969",
                                                "text": "We see the eye subdued, the practised smile, / The word well weighed before it pass the lip, / And know not of the misery within: / Yet there it works incessantly, and fears / The time to come; for time is terrible, / Avenging, and betraying."
                                            },
                                            {
                                                "example_id": "2e14b3c7-51e7-4df8-aa70-a7cd7fc6aace",
                                                "sense_id": "609e7f3d-9a0a-3a8c-b720-4ebe9a4fa969",
                                                "text": "There were the tawny rocks, like lions couchant, defying the ocean, whose waves incessantly dashed against and scoured them with vast quantities of gravel."
                                            },
                                            {
                                                "example_id": "f9c7e3be-79a0-4415-a38f-d8f664b958e3",
                                                "sense_id": "609e7f3d-9a0a-3a8c-b720-4ebe9a4fa969",
                                                "text": "\"You are old, Father William,\" the young man said, / \"And your hair has become very white; / And yet you incessantly stand on your head— / Do you think, at your age, it is right?\""
                                            },
                                            {
                                                "example_id": "c9c5f751-e862-4067-8772-2e8d94d1463f",
                                                "sense_id": "609e7f3d-9a0a-3a8c-b720-4ebe9a4fa969",
                                                "text": "But just there a small hairy terrier exploded out at the gate, like a floor-mop impelled by some sort of internal combustion, which sent him off into a frenzy of yapping, incessantly jerked backwards by the explosive force of his own detonations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fabb34e-2301-3f1c-94da-4807df624300",
                                        "entry_id": "1c0b5e0c-ce41-3dbd-9e12-4edd7241bf72",
                                        "glosses": [
                                            "Immediately."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6211416c-3be8-4c87-8e64-b48947def4c9",
                        "source_entry_id": "21cc9da2-95de-3986-af7b-4a7e119fff3e",
                        "source_sense_id": "76b61ef6-4c94-31d1-958e-9653836c46a8",
                        "target_lang_word": "non-stop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "non-stop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "365caa5f-883f-338e-b32f-80c1a47e1bbc",
                                        "entry_id": "b34b90a4-9e23-341b-9e05-be9c1bbee154",
                                        "glosses": [
                                            "Alternative form of nonstop."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cc81790-80ee-4d06-90f8-6c75f1ca87d4",
                                                "sense_id": "365caa5f-883f-338e-b32f-80c1a47e1bbc",
                                                "text": "In addition to the non-stop Heathrow Express service, there is a Transport for London stopping service to London Paddington: this is the Heathrow Connect service taken over by TfL in May 2018."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "non-stop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "290e079d-fe38-3b9e-a596-4da860dcaedc",
                                        "entry_id": "1684da14-b66d-330e-b8db-5fa9ad736119",
                                        "glosses": [
                                            "Alternative form of nonstop."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f26629c4-6eeb-49b7-bffd-ea769ff514a4",
                                                "sense_id": "290e079d-fe38-3b9e-a596-4da860dcaedc",
                                                "text": "The through Moorgate service has been most handsomely speeded up, and suburban trains in both directions now run non-stop between Kings Cross (Underground) and Elstree."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "non-stop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "469e7600-10fc-3242-b06e-802224a0f6b6",
                                        "entry_id": "448099ef-9389-3409-99f8-a3076dc5acb1",
                                        "glosses": [
                                            "Alternative form of nonstop."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e478549-f965-4e2e-9c81-e42863c98b68",
                                                "sense_id": "469e7600-10fc-3242-b06e-802224a0f6b6",
                                                "text": "The Victoria-Brighton non-stops, the Victoria-Eastbourne and Hastings, Victoria-Worthing and Littlehampton, Victoria-Bognor and Portsmouth and Victoria-Oxted line services were, with a very few exceptions, all re-routed to and from London Bridge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92ce8725-ffc6-4c8d-b6fa-714774077803",
                        "source_entry_id": "21cc9da2-95de-3986-af7b-4a7e119fff3e",
