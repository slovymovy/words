                        "glosses": [
                            "Doctrine morale qui fait de l'ensemble des animaux des patients moraux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c152395a-dc12-4390-b6ba-639ffb349ec1",
                                "sense_id": "04a2204b-a109-36c5-9cd8-c550c508ad7b",
                                "text": "Sur le registre scientifique, sa critique souligne que le zoocentrisme dominant s’appuie sur la biologie – nos 98 %, et plus, de gènes communs avec les chimpanzés – en négligeant les sciences humaines. Comme si la linguistique, l’économie, l’histoire, etc., n’avaient rien à dire des particularités très singulières des animaux humains !"
                            }
                        ]
                    },
