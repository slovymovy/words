                "senses": [
                    {
                        "sense_id": "a9cec488-ed50-3efd-bfa8-33198149fcef",
                        "entry_id": "59ac3cf3-c87a-3940-b198-8603733db167",
                        "glosses": [
                            "Sport consistant à glisser sur la mer ou la neige avec une planche."
                        ],
                        "tags": [
                            "Snowboard",
                            "Surf"
                        ],
                        "examples": [
                            {
                                "example_id": "6b889d93-78ce-4395-8ba8-9e6d453a5b04",
                                "sense_id": "a9cec488-ed50-3efd-bfa8-33198149fcef",
                                "text": "Il faut dire que cette multichampionne a le surf dans le sang, car elle a été initiée par son père dès l’âge de 4 ans."
                            },
                            {
                                "example_id": "d6d06289-706b-426e-b510-d8fa01cec850",
                                "sense_id": "a9cec488-ed50-3efd-bfa8-33198149fcef",
                                "text": "On y pratique le surf, le kitesurf, le bodyboard et le windsurf."
                            }
                        ]
                    },
                    {
                        "sense_id": "beed9170-182b-30a1-8fef-67619a2b54ea",
                        "entry_id": "59ac3cf3-c87a-3940-b198-8603733db167",
                        "glosses": [
                            "Planche permettant la pratique de ce sport."
                        ],
                        "tags": [
                            "Snowboard",
                            "Surf"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d1ef4e45-c522-3122-bd50-de74d27698c4",
                        "entry_id": "59ac3cf3-c87a-3940-b198-8603733db167",
                        "glosses": [
                            "Genre de musique populaire associé à la culture du surf."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ca47ada-ee35-4e98-af2d-abee33c94260",
                        "source_entry_id": "59ac3cf3-c87a-3940-b198-8603733db167",
                        "source_sense_description": "sport",
                        "target_lang_word": "surf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f77cfcc2-afce-3c10-b474-938cb47f2fc2",
                                        "entry_id": "44086575-14d4-3bb2-9a21-8972a7e740cb",
                                        "glosses": [
                                            "Waves that break on an ocean shoreline."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01a73d25-af03-4547-95e0-ac4543b32f86",
                                                "sense_id": "f77cfcc2-afce-3c10-b474-938cb47f2fc2",
                                                "text": "[…] perhaps it was the look of the island, with its gray, melancholy woods, and wild stone spires, and the surf that we could both see and hear foaming and thundering on the steep beach […]"
                                            },
                                            {
                                                "example_id": "5d2e290d-d6ed-4bdc-97a8-89b5258b4a70",
                                                "sense_id": "f77cfcc2-afce-3c10-b474-938cb47f2fc2",
                                                "text": "'But when the surf fell enough for the boats to get ashore, and Greening held a lantern for me to jump down into the passage, after we had got the side out of the tomb, the first thing the light fell on at the bottom was a white face turned skyward."
                                            },
                                            {
                                                "example_id": "21753215-8a41-4c22-a7f4-fd9ac8bebe5c",
                                                "sense_id": "f77cfcc2-afce-3c10-b474-938cb47f2fc2",
                                                "text": "It was alone, nervously alighting and flying short distances along the surf."
                                            },
                                            {
                                                "example_id": "48276293-a40d-45ed-b755-7faa8496465e",
                                                "sense_id": "f77cfcc2-afce-3c10-b474-938cb47f2fc2",
                                                "text": "In most instances the inshore holes or pockets along the surf do not produce as well as the cuts or sloughs between sand bars."
                                            },
                                            {
                                                "example_id": "2dadf7bc-1c3f-4706-89d7-49f922005c8d",
                                                "sense_id": "f77cfcc2-afce-3c10-b474-938cb47f2fc2",
                                                "text": "Snook are found in rivers, canals, inlets and along the surf, especially around sand bars, tidal rips, jetties, bridges and piers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a60c878-8e23-3f84-9a30-63fd4b678f58",
                                        "entry_id": "44086575-14d4-3bb2-9a21-8972a7e740cb",
                                        "glosses": [
                                            "An instance or session of riding a surfboard in the surf."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ff96ba5-bcb9-4618-8f26-b6e83e5ec03e",
                                                "sense_id": "1a60c878-8e23-3f84-9a30-63fd4b678f58",
                                                "text": "We went for a surf this morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdc4f57c-379f-30fc-9172-2e114e039e15",
                                        "entry_id": "44086575-14d4-3bb2-9a21-8972a7e740cb",
                                        "glosses": [
                                            "A dance popular in the 1960s in which the movements of a surfboard rider are mimicked."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a49d51c-454b-42c4-b34f-41cd2753f897",
                                                "sense_id": "bdc4f57c-379f-30fc-9172-2e114e039e15",
                                                "text": "She [...] loves to cook, sew and dance. She's up on all the latest steps like the frug, the hully-gully and the surf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9ffbaa2-7b5c-34da-8b41-07eb5824b7a9",
                                        "entry_id": "44086575-14d4-3bb2-9a21-8972a7e740cb",
                                        "glosses": [
                                            "The bottom of a drain."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "surf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa96b51e-a201-3e28-9c17-297a07a8e869",
                                        "entry_id": "75e033b1-58db-35ff-99a9-2feb332e97ca",
                                        "glosses": [
                                            "To ride a wave on a surfboard; to pursue or take part in the sport of surfing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07f5c902-176a-3a09-8af4-dd1fc7a503d7",
                                        "entry_id": "75e033b1-58db-35ff-99a9-2feb332e97ca",
                                        "glosses": [
                                            "To surf at a specified place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02fd7798-f32f-325b-bbfe-baf1ddc6ba52",
                                        "entry_id": "75e033b1-58db-35ff-99a9-2feb332e97ca",
                                        "glosses": [
                                            "To bodysurf; to swim in the surf at a beach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e4c4f26-e5ef-42ec-9d8c-435d4ad9affe",
                                                "sense_id": "02fd7798-f32f-325b-bbfe-baf1ddc6ba52",
                                                "text": "Such diversion as Podson could extort from his isolation was soon vitiated by repetition. He surfed. He sun-baked - with discretion till his skin had peeled and given him a harder cuticle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03881382-4c07-34c6-9c8f-bc1314f9773c",
