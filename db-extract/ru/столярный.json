                        "form": "столя́рнее"
                    },
                    {
                        "form_id": "4c09d797-adc7-45d9-bcea-4e0da3e9a44a",
                        "entry_id": "9b206fd2-b9fe-3d69-b6b1-cc01fbfb63dd",
