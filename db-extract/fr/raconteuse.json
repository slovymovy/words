                                        "entry_id": "dc181607-390b-3e9d-b775-071822746f02",
                                        "glosses": [
                                            "A person who relates stories through one medium or another to an audience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0c57f2e-2fe4-488d-8fcc-33db0d6a8e14",
                                                "sense_id": "068c57c2-df82-3884-9954-d3d64c081c9f",
                                                "text": "\"Charlotte is the best storyteller I ever heard,\" said Fern, poking her dish towel into a cereal bowl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a1c1321-ba6c-3a26-b3ae-7b8ddce1d736",
                                        "entry_id": "dc181607-390b-3e9d-b775-071822746f02",
                                        "glosses": [
                                            "A liar; a fibber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6299eda-b799-45e5-bfe8-278ecde3fcf4",
                                                "sense_id": "2a1c1321-ba6c-3a26-b3ae-7b8ddce1d736",
                                                "text": "There was once upon a time a king, who had a daughter, and she was such an awful story-teller, that you couldn't find a greater anywhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da794001-4a9f-353f-879f-b7ea9ef347e0",
                                        "entry_id": "dc181607-390b-3e9d-b775-071822746f02",
                                        "glosses": [
                                            "A game master, particularly in games focused on collaborative storytelling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77fd8062-67ee-4a8e-9e3b-620b4e7c518b",
                        "source_entry_id": "36920922-f3c0-31de-ba14-481c1eb47583",
                        "source_sense_id": "f71dd620-83f2-3951-bc5c-36b02f3bbc0b",
                        "target_lang_word": "raconteuse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raconteuse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f1300c6-e717-3ba6-bb07-c97cef082ee5",
                                        "entry_id": "c44dee88-e757-3907-93c1-54aa26e2152d",
                                        "glosses": [
                                            "A female storyteller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06e544a9-7b49-481d-9ddf-755f4dfb6724",
                                                "sense_id": "0f1300c6-e717-3ba6-bb07-c97cef082ee5",
                                                "text": "There is a fascinating passage in Margaret Atwood's Surfacing where four Canadians on their way up a river in the wilderness come upon a heron someone preceding them has killed and strung from a tree. Having surveyed its disgusting remains, the raconteuse asks herself \"Why had they strung it up like a lynch victim, why didn't they just throw it away like the trash?\""
                                            },
                                            {
                                                "example_id": "0d54541d-35e6-44d6-a58e-fce0726c038a",
                                                "sense_id": "0f1300c6-e717-3ba6-bb07-c97cef082ee5",
                                                "text": "Tom's mother was a superb raconteuse with the enviable gift of painting a verbal canvas of enchanting colours, transporting her audience into a realm of her own making that invariably enhanced the core of the tale."
                                            },
                                            {
                                                "example_id": "99e2fb50-13e1-4f0d-bc79-780c187a002c",
                                                "sense_id": "0f1300c6-e717-3ba6-bb07-c97cef082ee5",
                                                "text": "So, Shasta had reflected at once, Aunt Lily, by acclamation the family raconteuse, had certainly piqued her concern and puzzlement, if not exactly her surprise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
