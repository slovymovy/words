                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daguerréotypie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14734584-f083-358f-8fdc-083cd7ad29b5",
                                        "entry_id": "e79f84d9-458b-374a-b4eb-d437a301f7d0",
                                        "glosses": [
                                            "Procédé photographique qui utilise le daguerréotype."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1d740b9-5bc7-490a-9ab4-563f5504dc89",
                                                "sense_id": "14734584-f083-358f-8fdc-083cd7ad29b5",
                                                "text": "[…], telle une mauvaise daguerréotypie couverte çà et là de taches de moisissures irisées sur les bords et pareilles aux teintes d’arc-en-ciel que la décomposition peint aux visages des noyés."
                                            },
                                            {
                                                "example_id": "9be865a4-ba77-43f6-9317-db5ecf61efb6",
                                                "sense_id": "14734584-f083-358f-8fdc-083cd7ad29b5",
                                                "text": "Le procédé rendu public sous l’appellation daguerréotypie suscite un intérêt passionné."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
