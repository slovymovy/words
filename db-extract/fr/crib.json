                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crib",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e8df105-ced1-3f20-b655-6150bf5215b9",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A baby’s bed with high, often slatted, often moveable sides, suitable for a child who has outgrown a cradle or bassinet."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb90079-9a1e-4570-9ddf-87a04dbd0e82",
                                                "sense_id": "0e8df105-ced1-3f20-b655-6150bf5215b9",
                                                "text": "In two minutes I was kneeling by the child’s crib, and Sandy was dispatching servants here, there, and everywhere, all over the palace. I took in the situation almost at a glance -- membranous croup!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a313a301-8e70-33f0-b4ef-25648462a632",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A bed for a child older than a baby."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "092c53bc-be74-4d80-832c-de81a7e592ba",
                                                "sense_id": "a313a301-8e70-33f0-b4ef-25648462a632",
                                                "text": "a day or two afterwards I learned that Miss Temple, on returning to her own room at dawn, had found me laid in the little crib; my face against Helen Burns’s shoulder, my arms round her neck. I was asleep, and Helen was -- dead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8ace4b6-6a5b-3647-9366-f7e69fba9fb5",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A small sleeping berth in a packet or other small vessel."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc760bd9-e071-3136-973d-3814fed9649b",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A wicker basket."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7607fec3-31d1-3ba8-9c58-edcb212e8cdd",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A manger, a feeding trough for animals elevated off the earth or floor, especially one for fodder such as hay."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c1b5609-a7fa-376b-92f9-3447b7eb71ef",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "The baby Jesus and the manger in a creche or nativity scene, consisting of statues of Mary, Joseph and various other characters such as the magi."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "650375e7-a284-3f10-93d5-15e0dc5bc581",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A bin for drying or storing grain, as with a corn crib."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c940a2f5-0577-4ca9-9b5c-ab8e7440e135",
                                                "sense_id": "650375e7-a284-3f10-93d5-15e0dc5bc581",
                                                "text": "I began to think of my horse. He, however, like an old campaigner, had taken good care of himself. I found him paying assiduous attention to the crib of Indian corn, and dexterously drawing forth and munching the ears that protruded between the bars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1853d98-3e15-31f0-a0d6-4e8698e79b1d",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A small room or covered structure, especially one of rough construction, used for storage or penning animals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc6bd515-fc70-4f57-9c01-4921f6bb0251",
                                                "sense_id": "a1853d98-3e15-31f0-a0d6-4e8698e79b1d",
                                                "text": "A kitchen, a meat-house, a dairy, a crib with two stalls in the rear, one for the horse the other for the cow, were the out-buildings"
                                            },
                                            {
                                                "example_id": "bf44a79a-a42d-411e-96ee-d71b46b891a0",
                                                "sense_id": "a1853d98-3e15-31f0-a0d6-4e8698e79b1d",
                                                "text": "Where no oxen are, the crib is clean: but much increase is by the strength of the ox."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b2d9fbb-4678-3ba7-8202-9d0d295277fb",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A confined space, as with a cage or office-cubicle"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e71eb00d-e64f-48ad-9905-0aeb74fbb1e6",
                                                "sense_id": "8b2d9fbb-4678-3ba7-8202-9d0d295277fb",
                                                "text": "The singers were in a crib of wirework (like a large meat-safe or bird-cage) in one corner"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b84df8ea-fa39-3984-b44b-428ce640c3fa",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A job, a position; (British) an appointment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e44cca2-864e-4d2a-80ed-b431d30d597b",
                                                "sense_id": "b84df8ea-fa39-3984-b44b-428ce640c3fa",
                                                "text": "He had seen so many lean years of faithful service when the enemy held the corner on all the official cribs that, now in the days of his party’s fatness and of his own righteous reward, the habit of good, honest hustling stuck to him, and he lined up an array of pulls and indorsements that made him swell with happiness every time he went over the list."
                                            },
                                            {
                                                "example_id": "baf6f505-5a5e-4f58-a729-35353a0bf764",
                                                "sense_id": "b84df8ea-fa39-3984-b44b-428ce640c3fa",
                                                "text": "but if I have lost my crib and get nothing in exchange I shall feel what a soft Johnny I have been."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5042affb-c3bf-3c83-9c35-6a83d59c8909",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A hovel, a roughly constructed building best suited to the shelter of animals but used for human habitation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "915830aa-a8da-440e-84c4-26dfe9d30710",
                                                "sense_id": "5042affb-c3bf-3c83-9c35-6a83d59c8909",
                                                "text": "Why rather, sleep, liest thou in smoky cribs, / Upon uneasy pallets stretching thee, / And hushed with buzzing night-flies to thy slumber, / Than in the perfumed chambers of the great,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9114b240-6683-3f42-bcc3-1141a254bed1",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A boxy structure traditionally built of heavy wooden timbers, to support an existing structure from below, as with a mineshaft or a building being raised off its foundation in preparation for being moved; see cribbing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3edcbbbf-2668-3038-8057-853026caa54d",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A collection of quotes or references for use in speaking, for assembling a written document, or as an aid to a project of some sort; a crib sheet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35ce74e8-6147-31a0-84f5-c79cc9ec8c82",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A minor theft, extortion or embezzlement, with or without criminal intent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f511a5ea-2544-340c-86b8-f7cec4f71d07",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "The card game cribbage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b37165c-e79d-4bb6-ba78-d93b396e3b83",
                                                "sense_id": "f511a5ea-2544-340c-86b8-f7cec4f71d07",
                                                "text": "“May we play crib, Mrs. Radford?” he asked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd92cbeb-9ffc-36da-aab8-2812722d6adc",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "The cards discarded by players and used by the dealer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "742895bc-b971-43fa-9228-d548a91b4942",
                                                "sense_id": "dd92cbeb-9ffc-36da-aab8-2812722d6adc",
                                                "text": "The cards were brought and Fanny played at cribbage with her aunt till bed-time; and as Sir Thomas was reading to himself, no sounds were heard in the room for the next two hours beyond the reckonings of the game—And that makes thirty-one, four in hand and eight in crib."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3521b56c-17ad-32c1-aa51-01fa3eadd9c0",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A known piece of information corresponding to a section of encrypted text, that is then used to work out the remaining sections."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de325f95-aec5-3f2b-9acf-fe028b3b35db",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A small holiday home, often near a beach and of simple construction."
                                        ],
                                        "tags": [
                                            "New-Zealand",
                                            "Southern",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2a6fef1-54ae-3248-bbb3-9bfa05fd5b07",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A snack or packed lunch, especially as taken to work to eat during a break."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f48b488c-4d5b-4c24-a351-e654d49c22c9",
                                                "sense_id": "b2a6fef1-54ae-3248-bbb3-9bfa05fd5b07",
                                                "text": "He ate a thick square of banana cake from his crib and stared into the fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b3c0b98-5d1d-3058-91f6-bfae483605c6",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A small raft made of timber."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8786d92-5d24-330c-a9fb-69f12a32d128",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "The stomach."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee63bc4e-2e8e-4382-b6fd-ffdf19f67e09",
                                                "sense_id": "a8786d92-5d24-330c-a9fb-69f12a32d128",
                                                "text": "Here's Pannum and Lap, and good Poplars of Yarrum, / To fill up the Crib, and to comfort the Quarron."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f11aa06-f691-36b2-9271-37a185691097",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A literal translation, usually of a work originally in Latin or Ancient Greek."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "349396c5-970d-49e6-afe0-455c0b4f0bc2",
                                                "sense_id": "0f11aa06-f691-36b2-9271-37a185691097",
                                                "text": "[On Chapman's use of a Latin literal translation of Homer] As will appear, he blocked out his translation from the Latin crib, keeping one eye uneasily on the Greek, and, enlightened by Scapula or by his own poetic intuition, worked out his own rendering, often marking the departure from the Latin by a defiant note in the margin or commentary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ee0675d-a373-3166-be13-6f2fa3a61ad7",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "A cheat sheet or past test used by students; crib sheet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "776c6a62-21e7-3a36-87e2-706c3f5b4ede",
                                        "entry_id": "08e5b0e8-2572-316d-8a3f-45a67a4d96af",
                                        "glosses": [
                                            "One’s residence, house or dwelling place, or usual place of resort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acfd3abf-df96-4ac1-8b84-073dab86191d",
                                                "sense_id": "776c6a62-21e7-3a36-87e2-706c3f5b4ede",
                                                "text": "Why, you would not be boosing till lightman's in a square crib like mine, as if you were in a flash panny?"
                                            },
                                            {
                                                "example_id": "27a7fa52-94ac-4779-84e3-5af12e922461",
                                                "sense_id": "776c6a62-21e7-3a36-87e2-706c3f5b4ede",
                                                "text": "Toby and me were over the garden-wall the night afore last, sounding the panels of the door and shutters. The crib's barred up at night like a jail; but there's one part we can crack, safe and softly."
                                            },
                                            {
                                                "example_id": "f22d3c91-c9a6-4760-a562-f98ed7d11e33",
                                                "sense_id": "776c6a62-21e7-3a36-87e2-706c3f5b4ede",
                                                "text": "My flow, my show brought me the dough / That bought me all my fancy things / My crib, my cars, my pools, my jewels."
                                            },
                                            {
                                                "example_id": "c682c585-c49a-4ced-8bdb-1014071aa9d2",
                                                "sense_id": "776c6a62-21e7-3a36-87e2-706c3f5b4ede",
                                                "text": "I knew every inch ofthis joint. I had come of age up in here, and it was more of a home to me than the crib where I rested my head each night."
                                            },
                                            {
                                                "example_id": "3885bbc4-b977-40cf-ace6-d3f014f3c5e0",
                                                "sense_id": "776c6a62-21e7-3a36-87e2-706c3f5b4ede",
                                                "text": "Franklin Clinton (Shawn Fonteno): Eh stop shootin' rockets at my crib!\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crib",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94217d30-ff0d-3e06-9728-8273cfad73ec",
                                        "entry_id": "c7879b16-bead-362b-a2ac-8c943ecd0733",
                                        "glosses": [
                                            "To place or confine in a crib."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8afaf4c5-f690-417d-a7a3-3a72fd613521",
                                                "sense_id": "94217d30-ff0d-3e06-9728-8273cfad73ec",
                                                "text": "They may go to their beds and give themselves no trouble about their work, and yet in the morning the maids will find the kitchen swept up, and water brought in, and the men will find the horses in the stable well cleaned and curried, and perhaps a supply corn cribbed for them from the neighbours barns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56256ea1-eb70-37c1-b278-2f4e27224909",
                                        "entry_id": "c7879b16-bead-362b-a2ac-8c943ecd0733",
                                        "glosses": [
                                            "To shut up or confine in a narrow habitation; to cage; to cramp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10f9863a-40df-4c23-8f38-1ec1a32a4105",
                                                "sense_id": "56256ea1-eb70-37c1-b278-2f4e27224909",
                                                "text": "if only the vital energy be not cribbed or cramped"
                                            },
                                            {
                                                "example_id": "b860312e-dcb2-4eba-b81e-3f03c464b66b",
                                                "sense_id": "56256ea1-eb70-37c1-b278-2f4e27224909",
                                                "text": "But now I am cabin'd, cribbed, confined, bound in, / To saucy doubts and fears"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7f2ce4e-ed74-33b4-8f6e-300fb4741960",
                                        "entry_id": "c7879b16-bead-362b-a2ac-8c943ecd0733",
                                        "glosses": [
                                            "To collect one or more passages and/or references for use in a speech, written document or as an aid for some task; to create a crib sheet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fe2bf05-2cae-4ed3-af2e-6650f4b88570",
                                                "sense_id": "a7f2ce4e-ed74-33b4-8f6e-300fb4741960",
                                                "text": "I cribbed the recipe from the Food Network site, but made a few changes of my own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f06b2a7-f058-3974-86ed-1385ea8db2b9",
                                        "entry_id": "c7879b16-bead-362b-a2ac-8c943ecd0733",
                                        "glosses": [
                                            "To plagiarize; to copy; to cheat."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30c7c55c-2bef-4c40-8ad9-bbe0e933aa76",
                                                "sense_id": "1f06b2a7-f058-3974-86ed-1385ea8db2b9",
                                                "text": "He then proceeded to patch his tags together with the help of his Gradus, producing an incongruous and feeble result of eight elegiac lines, the minimum quantity for his form, and finishing up with two highly moral lines extra, making ten in all, which he cribbed entire from one of his books, beginning \"O genus humanum,\" and which he himself must have used a dozen times before, whenever an unfortunate or wicked hero, of whatever nation or language under the sun, was the subject."
                                            },
                                            {
                                                "example_id": "39db42e9-85df-4345-b96c-52156aab3a30",
                                                "sense_id": "1f06b2a7-f058-3974-86ed-1385ea8db2b9",
                                                "text": "This subplot—as well as a few other threads that have been teased from the Star Wars saga’s next installment—prompts another question: just how much of this film’s plot will be cribbed from The Empire Strikes Back?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "513be4d8-fdf1-3ab8-b129-b984d72b9a74",
                                        "entry_id": "c7879b16-bead-362b-a2ac-8c943ecd0733",
                                        "glosses": [
                                            "To install timber supports, as with cribbing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0c1b686-f17a-326a-8771-5bd61dd85a0b",
                                        "entry_id": "c7879b16-bead-362b-a2ac-8c943ecd0733",
                                        "glosses": [
                                            "To steal or embezzle."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40045341-85ba-48b5-82f2-90c48c4749ae",
                                                "sense_id": "d0c1b686-f17a-326a-8771-5bd61dd85a0b",
                                                "text": "There are a brace of birds and hare, that I cribbed this morning out of a basket of game."
                                            },
                                            {
                                                "example_id": "c2acf823-85c7-4934-aded-b34befb5dee9",
                                                "sense_id": "d0c1b686-f17a-326a-8771-5bd61dd85a0b",
                                                "text": "It was very easy, Briggs said, to make a galley-slave of a boy all the half-year, and then score him up idle; and to crib two dinners a-week out of his board, and then score him up greedy; but that wasn’t going to be submitted to, he believed, was it?"
                                            },
                                            {
                                                "example_id": "7c63556a-6e7a-4b1a-8857-89502d80fc9c",
                                                "sense_id": "d0c1b686-f17a-326a-8771-5bd61dd85a0b",
                                                "text": "\"Somebody crib the mayor's crown jools, or has some joyous cuss eloped with the auto patrol?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff4a5176-a9bc-3fa6-ab5d-27c91ab4a9c8",
                                        "entry_id": "c7879b16-bead-362b-a2ac-8c943ecd0733",
                                        "glosses": [
                                            "To complain, to grumble"
                                        ],
                                        "tags": [
                                            "India"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0642e2b-bb18-443e-a2ee-cbd9aa318691",
                                                "sense_id": "ff4a5176-a9bc-3fa6-ab5d-27c91ab4a9c8",
                                                "text": "She calls on the neighbours, she's out half the time and doesn't answer the telephone, and when I start cribbing she just laughs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31c5b3a8-a7ac-3917-a5aa-6cbb8487fafb",
                                        "entry_id": "c7879b16-bead-362b-a2ac-8c943ecd0733",
                                        "glosses": [
                                            "To crowd together, or to be confined, as if in a crib or in narrow accommodations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "194c0b61-c4d1-4822-8b78-bc6f745e1c07",
                                                "sense_id": "31c5b3a8-a7ac-3917-a5aa-6cbb8487fafb",
                                                "text": "[…] who ſought to make the glory of the Nation and Church of England, which was ever Regal and Epiſcopal ſince it was Chriſtian, truckle under a Scotch Canopy, and to make Biſhops to crib in a Presbyterian trundle-bed; as much as Kingly Majeſtie, to be confounded with Democracy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f26ccd6b-c8b6-3450-8d23-105cd5bf0992",
                                        "entry_id": "c7879b16-bead-362b-a2ac-8c943ecd0733",
                                        "glosses": [
                                            "To seize the manger or other solid object with the teeth and draw in wind."
