                ],
                "senses": [
                    {
                        "sense_id": "9173dd08-eec9-3b85-b831-0f79a4288ac6",
                        "entry_id": "88f8eb22-0dd3-355a-8c66-0c63113dbfe5",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f16ce7b-1098-4ea7-b42b-2ec0e40eaa68",
                                "sense_id": "9173dd08-eec9-3b85-b831-0f79a4288ac6",
                                "text": "Frau Retzlaff ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d52723b2-d96c-4bc9-a36b-78b1650f4998",
                                "sense_id": "9173dd08-eec9-3b85-b831-0f79a4288ac6",
                                "text": "Herr Retzlaff wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4a29a36c-eea5-4360-80c7-5d7241f55196",
                                "sense_id": "9173dd08-eec9-3b85-b831-0f79a4288ac6",
                                "text": "Die Retzlaffs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a71cc95c-b5b9-4124-8b90-711025cb4f66",
                                "sense_id": "9173dd08-eec9-3b85-b831-0f79a4288ac6",
                                "text": "Der Retzlaff trägt nie die Schals, die die Retzlaff ihm strickt."
                            },
                            {
                                "example_id": "ea82379b-c879-43a7-a07b-1b4bbdfee0a4",
                                "sense_id": "9173dd08-eec9-3b85-b831-0f79a4288ac6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Retzlaff kommt, geht der Herr Retzlaff.“"
                            },
                            {
                                "example_id": "30e1330f-808a-4727-a6fa-f2221bb4c222",
                                "sense_id": "9173dd08-eec9-3b85-b831-0f79a4288ac6",
                                "text": "Retzlaff kommt und geht."
                            },
                            {
                                "example_id": "d0a84a29-5c18-4d59-9371-e698167ff5ff",
                                "sense_id": "9173dd08-eec9-3b85-b831-0f79a4288ac6",
                                "text": "Retzlaffs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
