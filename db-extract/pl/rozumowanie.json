                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e98b16dc-9910-4107-acce-95e073ca6b32",
                                "sense_id": "07735b80-930e-382e-bc10-c8c6c2c5cdfa",
                                "text": "Dowód matematyczny jest formalnym rozumowaniem, korzystającym z zasad logiki, aksjomatów, założeń twierdzenia i wcześniej udowodnionych twierdzeń."
                            }
                        ],
