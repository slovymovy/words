                    }
                ],
                "senses": [
                    {
                        "sense_id": "f023f3c5-84fc-305d-b4f6-fa613da1fcff",
                        "entry_id": "ec672b84-710b-334c-875a-403bab6209c6",
                        "glosses": [
                            "met veel ingrepen en aandacht, zo intens mogelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ea15058-26ae-41dc-90e2-d4f8a987cee7",
                                "sense_id": "f023f3c5-84fc-305d-b4f6-fa613da1fcff",
                                "text": "De intensieve behandeling resulteerde niet in de gewenste vooruitgang."
                            },
                            {
                                "example_id": "807c4b52-c588-4dfa-b5de-c4559c5b4c68",
                                "sense_id": "f023f3c5-84fc-305d-b4f6-fa613da1fcff",
                                "text": "Meer voedsel produceren kan dan alleen door meer land aan te wenden. Moderne, intensieve landbouw is de enige manier om uitbreiding van landbouwareaal te stoppen en de natuur te redden, zo concludeerde het World Resource Institute begin december in een uitgebreid rapport."
                            },
                            {
                                "example_id": "71e4a9ce-ed68-466c-a74a-ed5bc31905d0",
                                "sense_id": "f023f3c5-84fc-305d-b4f6-fa613da1fcff",
                                "text": "In 2002 en 2003 trok ik intensief op met Muskee, omdat ik zijn biografie schreef. Hij nam me mee op autoritten, waarbij hij veel klassieke muziek liet horen. Hij was verknocht aan Drenthe en liet mij de bossen en groene vlakten zien die hij zo goed kende. Hij gidste me naar het vennetje waar de regels voor zijn grootste hit 'Window of my eyes' in hem opkwamen."
                            },
                            {
                                "example_id": "d46fce73-f250-4f00-bb12-86688e12318a",
                                "sense_id": "f023f3c5-84fc-305d-b4f6-fa613da1fcff",
                                "text": "De vijf andere bedrijven met pluimvee die zich in een straal van 3 kilometer rondom het getroffen bedrijf bevinden, worden gescreend. De komende twee weken worden die dieren intensief gemonitord op ziekteverschijnselen, schrijft ook 1Limburg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dafd030d-aaf8-4771-9856-529d0b3edd9f",
                        "source_entry_id": "ec672b84-710b-334c-875a-403bab6209c6",
                        "source_sense_id": "f023f3c5-84fc-305d-b4f6-fa613da1fcff",
                        "target_lang_word": "intensive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intensive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ef01bc0-f122-32d8-ba00-15826dafb63d",
                                        "entry_id": "0fab30d3-e20c-35c4-9ab5-64551d22c735",
                                        "glosses": [
                                            "Done with intensity or to a great degree; thorough."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f63d657a-c06f-4da9-8552-3af6a2799395",
                                                "sense_id": "0ef01bc0-f122-32d8-ba00-15826dafb63d",
                                                "text": "Secondly, I continue to base my concepts on intensive study of a limited suite of collections, rather than superficial study of every packet that comes to hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b460e678-bdda-311f-adb2-d10bef0d8f0a",
                                        "entry_id": "0fab30d3-e20c-35c4-9ab5-64551d22c735",
                                        "glosses": [
                                            "Being made more intense."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a26540c-022b-3b24-8f69-c21418ef9d85",
                                        "entry_id": "0fab30d3-e20c-35c4-9ab5-64551d22c735",
                                        "glosses": [
                                            "Making something more intense; intensifying.",
                                            "Of agriculture: increasing the productivity of an area of land."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43ede2c6-8ffe-3ad6-b28b-3b7769ca625a",
                                        "entry_id": "0fab30d3-e20c-35c4-9ab5-64551d22c735",
                                        "glosses": [
                                            "Making something more intense; intensifying.",
                                            "Of a word: serving to give emphasis or force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de0baa89-fc8c-4637-938d-c1a7e9aafcd6",
                                                "sense_id": "43ede2c6-8ffe-3ad6-b28b-3b7769ca625a",
                                                "text": "an intensive verb or preposition"
                                            },
                                            {
                                                "example_id": "5e68af15-10a7-4ac1-b68b-f8c8f0b17b26",
                                                "sense_id": "43ede2c6-8ffe-3ad6-b28b-3b7769ca625a",
                                                "text": "Ariſtophanes deriueth it [the word asp] from Alpha, an intenſiue Particle, and Spizo vvhich ſignifieth to extend; either by reaſon of his ſharpe-ſhrill hiſſing, or for the length of his body."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "801a6175-f5a9-3bff-8380-071380ea8aca",
                                        "entry_id": "0fab30d3-e20c-35c4-9ab5-64551d22c735",
                                        "glosses": [
                                            "Involving much activity in a short period of time; highly concentrated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b02802d0-99ba-4987-81d5-08c27a177deb",
                                                "sense_id": "801a6175-f5a9-3bff-8380-071380ea8aca",
                                                "text": "I took a three-day intensive course in finance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8057ba86-0be9-3d1e-aff8-b52d26fb2fb6",
                                        "entry_id": "0fab30d3-e20c-35c4-9ab5-64551d22c735",
                                        "glosses": [
                                            "Of or pertaining to innate or internal intensity or strength rather than outward extent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e30feba1-22c4-3a2d-a050-d16fb207eb61",
                                        "entry_id": "0fab30d3-e20c-35c4-9ab5-64551d22c735",
                                        "glosses": [
                                            "Chiefly suffixed to a noun: using something with intensity; requiring a great amount of something; demanding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "109db218-b8a4-461a-aa9d-acb7406b7694",
                                                "sense_id": "e30feba1-22c4-3a2d-a050-d16fb207eb61",
                                                "text": "This job is difficult because it is so labour-intensive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac08b5cb-5545-38d9-bfc1-0573c7b7d9c3",
                                        "entry_id": "0fab30d3-e20c-35c4-9ab5-64551d22c735",
                                        "glosses": [
                                            "Chiefly suffixed to a noun: using something with intensity; requiring a great amount of something; demanding.",
                                            "Chiefly in intensive care: of care or treatment: involving a great degree of life support, monitoring, and other forms of effort in order to manage life-threatening conditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87a7f3f0-960d-49a1-85b7-653e9c0cfecb",
                                                "sense_id": "ac08b5cb-5545-38d9-bfc1-0573c7b7d9c3",
                                                "text": "She was moved to the intensive-care unit of the hospital."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c225df6e-b8af-3c44-9066-ee00625786fa",
                                        "entry_id": "0fab30d3-e20c-35c4-9ab5-64551d22c735",
                                        "glosses": [
                                            "That can be intensified; allowing an increase of degree."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f9fe57d-189e-4e0e-a5c9-0128d3d482f4",
                                                "sense_id": "c225df6e-b8af-3c44-9066-ee00625786fa",
                                                "text": "As his [God's] Perfection is infinitely greater than the perfection of a Man, ſo it is infinitely greater than the perfection of an Angel; and vvere it not infinitely greater than the perfection of an Angel, it could not be infinitely greater than the perfection of a Man, becauſe the intenſive diſtance betvveen the perfection of an Angel and of a Man is but finite: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d55029e1-a742-3e8c-984f-18d56df3895a",
                                        "entry_id": "0fab30d3-e20c-35c4-9ab5-64551d22c735",
                                        "glosses": [
                                            "Synonym of intense (“extreme or very high or strong in degree; of feelings, thoughts, etc.: strongly focused”)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c92bbd7-96f5-4b3d-a951-a8bd283dfa63",
                                                "sense_id": "d55029e1-a742-3e8c-984f-18d56df3895a",
                                                "text": "Faſcination is the povver and act of Imagination, intenſiue vpon other bodies, than the bodie of the Imaginant; […]"
                                            },
                                            {
                                                "example_id": "69823b3c-a8a5-49f7-8c62-c8ec9e390f4c",
                                                "sense_id": "d55029e1-a742-3e8c-984f-18d56df3895a",
                                                "text": "The queſtion is in vvhat part of this Serpent the poyſon doth lye; Some ſay in the head alone, and that therefore the Bazeliske is deafe, bycauſe the Ayre vvhich ſerueth the Organe of hearing, is reſolued by the intenſiue calidity: but this ſeemeth not to bee true, […]"
                                            },
                                            {
                                                "example_id": "90b51673-1b59-4d7e-9098-23e9f7e720bc",
                                                "sense_id": "d55029e1-a742-3e8c-984f-18d56df3895a",
                                                "text": "[T]he Imagination invvardly or outvvardly moued, repreſents to the vnderſtanding, not intiſements only to favour the paſſion or diſlike, but a very intenſiue pleaſure follovves the paſſion, or diſpleaſure, and the vvill and reaſon are captivated by delighting in it."
                                            },
                                            {
                                                "example_id": "155cd851-f981-401e-8016-830651dd8c71",
                                                "sense_id": "d55029e1-a742-3e8c-984f-18d56df3895a",
                                                "text": "Some therefore vvere of opinion, that […] vvith that aſſiduous attendance, and intenſive circumſpection vvhich a long indulgent fortune did require, he vvas grovvn not unvvilling, for his ovvn eaſe, to beſtovv handſomly upon another ſome part of the pains, and perhaps of the envie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intensive",
                                "target_lang_code": "en",
