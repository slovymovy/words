            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dc28ad64-7ef1-3ab5-9262-855d68a4985a",
                    "sense_definition": "Tijdelijk niet in staat om iets te doen of helder te denken vanwege een emotionele of lichamelijke klap; diep geschokt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bert was diep <w>ontsteld</w> door het plotselinge verlies van zijn broer.",
                            "target_lang_translations": {
                                "en": "Bert was deeply <w>shocked</w> by the sudden loss of his brother."
                            }
                        },
                        {
                            "text": "De bewoners reageerden <w>ontsteld</w> op het nieuws over de geplande fabriek.",
                            "target_lang_translations": {
                                "en": "The residents reacted with <w>dismay</w> to the news about the planned factory."
                            }
                        }
                    ],
                    "synonyms": [
                        "aangeslagen"
                    ],
                    "common_phrases": [
                        "diep ontsteld",
                        "ontsteld reageren"
                    ],
                    "target_lang_definitions": {
                        "en": "Temporarily unable to act or think clearly due to an emotional or physical blow; deeply shocked or upset."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shocked",
                                "target_lang_sense_clarification": "deeply affected by surprise or distress"
                            },
