                "senses": [
                    {
                        "sense_id": "bf509ae8-3d11-3795-98da-250308c2a641",
                        "entry_id": "f4db6547-51fa-339a-bd24-52bf309474d0",
                        "glosses": [
                            "Schatz, der Gegenstände enthält, die aus Gold bestehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3bac8d1-1171-4d28-833c-f2563a9774ae",
                                "sense_id": "bf509ae8-3d11-3795-98da-250308c2a641",
                                "text": "„Seit Jahrzehnten werden im heutigen Bulgarien zahlreiche Gold- und Silberschätze ergraben und in großen Ausstellungen gezeigt.“"
                            },
                            {
                                "example_id": "8608d2fc-052b-40dd-889f-e954e5ba6182",
                                "sense_id": "bf509ae8-3d11-3795-98da-250308c2a641",
                                "text": "„Dort, in den Bergen, lebe ein Volk, das seinen Anführer komplett mit Gold einpudere und über immense Goldschätze verfüge, so sagte man.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "978b6b04-1b65-30b2-acec-933d00352e98",
                        "entry_id": "f4db6547-51fa-339a-bd24-52bf309474d0",
                        "glosses": [
                            "Person, die man sehr gerne hat"
                        ],
                        "tags": [
                            "Kosewort"
                        ],
                        "examples": [
                            {
                                "example_id": "f1416811-9855-460c-8a38-5bcc2071f728",
                                "sense_id": "978b6b04-1b65-30b2-acec-933d00352e98",
                                "text": "Komm her, mein Goldschatz, ich habe etwas für dich!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
