                "translations": [
                    {
                        "translation_id": "0874e11d-e19d-4c0c-9f09-2acd54100d6b",
                        "source_entry_id": "14a3c88e-e681-340f-9e88-18def12a052b",
                        "source_sense_description": "impossible to solve",
                        "target_lang_word": "insoluble",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insoluble",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56d05df9-1d69-3f81-a707-689e44abfe57",
                                        "entry_id": "df6ee93a-89ba-3304-a58d-2c247b4f26eb",
                                        "glosses": [
                                            "Qui ne peut pas être solubilisé ou dissout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1524cc6-c597-48ac-85ef-2c62f9efa93c",
                                                "sense_id": "56d05df9-1d69-3f81-a707-689e44abfe57",
                                                "text": "L’acide palmitique forme des cristaux blancs en forme de paillettes, très ténus, insolubles dans l'eau, solubles dans l'alcool et l'éther."
                                            },
                                            {
                                                "example_id": "534072a7-425c-4aa3-a3e0-7f4826740303",
                                                "sense_id": "56d05df9-1d69-3f81-a707-689e44abfe57",
                                                "text": "La morphine-base, insoluble dans l’eau froide, est ainsi transformée en son sel, le morphinate de calcium, parfaitement soluble."
                                            },
                                            {
                                                "example_id": "7e1d4c69-2673-4265-945f-c38fbd449f82",
                                                "sense_id": "56d05df9-1d69-3f81-a707-689e44abfe57",
                                                "text": "A titre d'exemple, la réaction simplifiée (3) résume la transformation de phosphate tricalcique insoluble en phosphate monocalcique nettement plus soluble sous l’effet d'un acide carboxylique : […]."
                                            },
                                            {
                                                "example_id": "86f335fe-a4de-462c-8991-281d212be10a",
                                                "sense_id": "56d05df9-1d69-3f81-a707-689e44abfe57",
                                                "text": "Ils cherchaient notamment dans quelles conditions de pression et de température l’hélium deviendrait insoluble dans l’hydrogène."
                                            },
                                            {
                                                "example_id": "81f9a05e-c041-4e64-abfd-dd5c2a02fe47",
                                                "sense_id": "56d05df9-1d69-3f81-a707-689e44abfe57",
                                                "text": "L'anéthol, l’huile essentielle qui donne son goût au pastis, est soluble dans l’alcool ou les mélanges fortement alcoolisés, tandis qu’il est insoluble dans l’eau ou les mélanges faiblement alcoolisés."
                                            },
                                            {
                                                "example_id": "e37d7d6e-7ce7-41eb-9e1f-a8e809a799e0",
                                                "sense_id": "56d05df9-1d69-3f81-a707-689e44abfe57",
                                                "text": "Le gaz moutarde, lui, est insoluble dans l'eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ffbdf6d-6ff9-33a5-bdb0-d0d1cd4bc0c2",
                                        "entry_id": "df6ee93a-89ba-3304-a58d-2c247b4f26eb",
                                        "glosses": [
                                            "Qui ne peut être résolu."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "087938f0-0b17-41c0-bdf0-1fe28c2a0e42",
                                                "sense_id": "4ffbdf6d-6ff9-33a5-bdb0-d0d1cd4bc0c2",
                                                "text": "On a tort de dire que le problème des n corps est insoluble, en laissant entendre qu’il présente des difficultés mathématiques insurmontables ou qu’il n’a pas du tout de solution."
                                            },
                                            {
                                                "example_id": "b79047bf-173a-420c-a3b1-d8f5708cfe17",
                                                "sense_id": "4ffbdf6d-6ff9-33a5-bdb0-d0d1cd4bc0c2",
                                                "text": "C’est d’ailleurs cette propriété qui a permis de montrer, en 1882, que la quadrature du cercle est un problème insoluble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0ada8bd-27e8-4926-9fa9-d0e1c450f444",
                        "source_entry_id": "14a3c88e-e681-340f-9e88-18def12a052b",
                        "source_sense_description": "impossible to solve",
                        "target_lang_word": "unlösbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unlösbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f08e4a63-1413-3abb-b5d2-9314992965fa",
                                        "entry_id": "fd93ad07-88ce-30b0-8bbc-d9f2603022a3",
                                        "glosses": [
                                            "eine feste Verbindung aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a6945da-94e9-4e94-8472-82009d2dac47",
                                                "sense_id": "f08e4a63-1413-3abb-b5d2-9314992965fa",
                                                "text": "„Zum Glück las ich den Brief gleich weiter und ersah daraus die beglückende Gewißheit, daß auch Du so fest von der unlösbaren Zusammengehörigkeit unserer Seelen überzeugt bist, daß kein äußeres Geschick daran noch etwas ändern kann.“"
                                            },
                                            {
                                                "example_id": "66508e5a-0c36-4f0f-9750-f5c20c80bd8f",
                                                "sense_id": "f08e4a63-1413-3abb-b5d2-9314992965fa",
                                                "text": "„Dieser Ring hatte nicht das Oremus eines Priesters empfangen, sie hatten nicht der Unterschrift des Bürgermeisters bedurft, um einander als wackere Menschen anzugehören, treuer und unlösbarer als in vielen durch den Segen der Kirche geweihten Ehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "644a189a-16bb-3d75-b14d-a97886d6f741",
                                        "entry_id": "fd93ad07-88ce-30b0-8bbc-d9f2603022a3",
                                        "glosses": [
                                            "zu keinem Resultat führend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1159aa2c-4b65-466f-8fb3-317d52232b29",
                                                "sense_id": "644a189a-16bb-3d75-b14d-a97886d6f741",
                                                "text": "„Dieser Mann war ein unlösbares Problem für sich und für die anderen. Ritterlich von Gemüt, aber schroff und schwierig im Verkehr, hatte er nichts von der leichten Umgänglichkeit des Italieners, sondern erinnerte eher an einen französischen grandseigneur des ancien régime.“"
                                            },
                                            {
                                                "example_id": "c120160b-0d7e-4c36-a5b8-2484c469bfff",
                                                "sense_id": "644a189a-16bb-3d75-b14d-a97886d6f741",
                                                "text": "„Nothwendig musste diese dogmatische Auffassung des Species-Begriffes und die damit verbundene Willkür zu den unlösbarsten Widersprüchen und zu den unhaltbarsten Annahmen führen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
