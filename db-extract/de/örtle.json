                ],
                "senses": [
                    {
                        "sense_id": "ecbb5afb-5afa-38b5-9c91-ffbe8ff73513",
                        "entry_id": "c2485d9d-1c01-34eb-8fc1-a4b6d013cfd7",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f2380a0-6ed7-4fb2-8251-0b9c28fd2ac7",
                                "sense_id": "ecbb5afb-5afa-38b5-9c91-ffbe8ff73513",
                                "text": "Frau Örtle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2384e6e9-6027-400c-913f-383d02193924",
                                "sense_id": "ecbb5afb-5afa-38b5-9c91-ffbe8ff73513",
                                "text": "Herr Örtle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "83312fd5-b835-4b4a-93b6-abb93745661b",
                                "sense_id": "ecbb5afb-5afa-38b5-9c91-ffbe8ff73513",
                                "text": "Die Örtles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "3b96cb7d-428a-4964-aa6d-61ecf4b06f4f",
                                "sense_id": "ecbb5afb-5afa-38b5-9c91-ffbe8ff73513",
                                "text": "Der Örtle trägt nie die Pullover, die die Örtle ihm strickt."
                            },
                            {
                                "example_id": "a535c808-8254-44fe-83d5-2f33c0fda360",
                                "sense_id": "ecbb5afb-5afa-38b5-9c91-ffbe8ff73513",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Örtle kommt, geht der Herr Örtle.“"
                            },
                            {
                                "example_id": "5a37269e-dc6e-4ed1-9afd-7c8125736b4f",
                                "sense_id": "ecbb5afb-5afa-38b5-9c91-ffbe8ff73513",
                                "text": "Örtle kommt und geht."
                            },
                            {
                                "example_id": "a9e5467b-908a-4e4d-a126-511d88192c57",
                                "sense_id": "ecbb5afb-5afa-38b5-9c91-ffbe8ff73513",
                                "text": "Örtles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
