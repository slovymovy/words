                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben de hele avond gezellig zitten <w>klappen</w> in het café.",
                            "target_lang_translations": {
                                "en": "We sat <w>chatting</w> pleasantly in the pub all evening.",
                                "ru": "Мы весь вечер приятно <w>болтали</w> в кафе.",
                                "fr": "Nous avons passé toute la soirée à <w>bavarder</w> agréablement dans le café."
                            }
