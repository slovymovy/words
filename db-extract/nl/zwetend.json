                            {
                                "example_id": "4fcce513-3cf1-4ea0-bef0-6a2747e3a19f",
                                "sense_id": "5e614116-43a3-3fbf-9885-2672e7d40f94",
                                "text": "De zwetende man stonk vreselijk, maar hij zei dat eerlijk zweet niet stinkt."
                            },
                            {
                                "example_id": "abf474b5-6492-435e-8d84-04e58638547a",
                                "sense_id": "5e614116-43a3-3fbf-9885-2672e7d40f94",
                                "text": "De zwetende malariapatiënt lag tandenklapperend in bed."
                            },
                            {
                                "example_id": "ff28e6bb-097d-49ad-8aaf-aa6d1a1c67e0",
                                "sense_id": "5e614116-43a3-3fbf-9885-2672e7d40f94",
                                "text": "Nog steeds schoot hij 's nachts zwetend wakker uit een droom waarin hij opnieuw de angstige gezichten van de neerhurkende dorpelingen voor zich zag."
                            }
                        ]
                    }
