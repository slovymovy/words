                        "sense_id": "c954ea53-32b1-3c4f-8b30-83b7798ba493",
                        "entry_id": "38adfcdf-14fe-3baa-9025-341d407949fb",
                        "glosses": [
                            "CH₄, najprostszy alkan, bezwonny i bezbarwny gaz, główny składnik gazu ziemnego, stosowany do syntezy wielu związków organicznych i jako gaz opałowy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07088fce-14ef-4fc2-8c37-3b8677a4ff0c",
                                "sense_id": "c954ea53-32b1-3c4f-8b30-83b7798ba493",
                                "text": "Metan powstaje w przyrodzie w wyniku beztlenowego rozkładu szczątek roślinnych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cc5eed7-eaf8-4b21-9c14-d2ad9fdc53f8",
                        "source_entry_id": "38adfcdf-14fe-3baa-9025-341d407949fb",
                        "source_sense_id": "c954ea53-32b1-3c4f-8b30-83b7798ba493",
                        "target_lang_word": "methane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "methane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "417d03de-bdaa-3bd3-a33b-30240149811f",
                                        "entry_id": "31927b7f-d0ec-3aa2-904b-05d7a2b1543e",
                                        "glosses": [
                                            "The simplest aliphatic hydrocarbon, CH₄, being a constituent of natural gas, and one of the most abundant greenhouse gases."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a46da6bb-1a5f-42b7-873a-aa7a62266bec",
                                                "sense_id": "417d03de-bdaa-3bd3-a33b-30240149811f",
                                                "text": "Cattle emit a large amount of methane."
                                            },
                                            {
                                                "example_id": "b7569ad7-6167-49ae-8b2c-06c59c7e0dfa",
                                                "sense_id": "417d03de-bdaa-3bd3-a33b-30240149811f",
                                                "text": "Methane, an invisible, odorless gas that makes up more than 95% of natural gas fuel, can be as much as 80 times more potent as a global warmer per given unit than CO₂, which is more plentiful in the atmosphere. While there are less emissions than CO₂, methane lasts around 12 years, while CO₂ lingers for centuries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11306617-b7dc-3413-bdea-0fcd77927f45",
                                        "entry_id": "31927b7f-d0ec-3aa2-904b-05d7a2b1543e",
                                        "glosses": [
                                            "Any of very many derivatives of methane."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "568159b0-c1fe-4ebf-898f-1a7034e29494",
                        "source_entry_id": "38adfcdf-14fe-3baa-9025-341d407949fb",
