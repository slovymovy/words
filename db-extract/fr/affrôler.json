                "senses": [
                    {
                        "sense_id": "38218e4e-87a5-30c8-9c60-78f508e3573c",
                        "entry_id": "69330923-e920-36b6-9dbf-e6efc5f8ef63",
                        "glosses": [
                            "Frôler, effleurer."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "9b246811-17d0-4f76-ab21-2e6cf0544231",
                                "sense_id": "38218e4e-87a5-30c8-9c60-78f508e3573c",
                                "text": "Ej’suis guère à l’aise quand on m’affrôle eç’te gonfle, à ç’t’heure…"
                            },
                            {
                                "example_id": "77d11db7-1792-447f-a85a-a2db3d9c4d21",
                                "sense_id": "38218e4e-87a5-30c8-9c60-78f508e3573c",
                                "text": "« L’oncle » affrôlé ne sait plus dans quel non rapport il est sans rapport avec l’enlevant, sa rampe bascule, l’oncle plonge labile fétu dans le vent que l’enfant lève, l’oncle chute, rampe, en avant de tout, tandis qu’à une incalculable distance libre comme l’air, hétérogène, le héros ne se gêne pas pour grimper d’un autre essor."
                            },
                            {
                                "example_id": "c648fcc2-136f-4174-b4f4-619caa804bc6",
                                "sense_id": "38218e4e-87a5-30c8-9c60-78f508e3573c",
                                "text": "Elle te frôle et tu es affrôlé."
                            }
                        ]
                    }
                ],
