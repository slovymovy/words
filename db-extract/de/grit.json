                                                "text": "grits and eggs"
                                            },
                                            {
                                                "example_id": "8d5ea609-f937-41d0-bfd1-e20bf2a1449a",
                                                "sense_id": "c65055b7-07a5-3486-87e4-ea0fcb6e201c",
                                                "text": "ham and grits"
                                            }
                                        ]
