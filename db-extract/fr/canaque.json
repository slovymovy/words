                "senses": [
                    {
                        "sense_id": "81de7621-9a53-3b36-ae14-0f75fa00f189",
                        "entry_id": "44db4606-2dd9-343a-a16e-a91c3da46169",
                        "glosses": [
                            "Relatif aux Canaques, habitants autochtones de la Nouvelle-Calédonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62f813d1-5b0a-4603-a6b0-40dafef3efa9",
                                "sense_id": "81de7621-9a53-3b36-ae14-0f75fa00f189",
                                "text": "Le cousin Rigouillard était parti du pays, très jeune, et il était revenu, un beau jour, avec des colis innombrables qui recelaient les objets les plus hétéroclites, autruches empaillées, pirogues canaques, porcelaines japonaises, etc."
                            },
                            {
                                "example_id": "f2ad4585-a694-4ff1-b31a-28a13d7e675c",
                                "sense_id": "81de7621-9a53-3b36-ae14-0f75fa00f189",
                                "text": "La forme de l’esclavage était celle de l’esclavage domestique et le sort des esclaves était certainement moins dur que celui des nègres qui travaillaient dans les plantations d’Amérique ou même les coolies chinois ou canaques qui les ont remplacés."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5f002fa-ae7f-33f4-8b5e-660e8ae23cf4",
                        "entry_id": "44db4606-2dd9-343a-a16e-a91c3da46169",
                        "glosses": [
                            "Sauvage, malappris"
                        ],
                        "tags": [
                            "broadly",
                            "dated",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9791486a-b072-462b-83bb-46786ccd5c0f",
                                "sense_id": "f5f002fa-ae7f-33f4-8b5e-660e8ae23cf4",
                                "text": "Dites-moi, mon ami, ce n'est point la coutume de servir la salade dans l'assiette du gigot. Nous ne sommes pas des canaques."
                            },
                            {
                                "example_id": "3e205ff1-0cc1-48c3-8cf5-d6b559b58e59",
                                "sense_id": "f5f002fa-ae7f-33f4-8b5e-660e8ae23cf4",
                                "text": "Malheureusement, la méthode la plus efficace pour casser les noix est aussi la plus bruyante. Stupéfiés d'abord par notre tapage, les chiens entreprirent vaillamment de nous imiter, Rouquette employait comme marteau le talon d'un de ses souliers, si bien que M. Pamaret dut renoncer à sa belle allocution : \"vous êtes... vous êtes une bande de tanates ! \" Et il s'enfuit, noir de fureur. Des tanates en son patois ne pouvant signifier que des canaques …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f613a24b-fc21-4b88-94fc-1b52378e1315",
                        "source_entry_id": "44db4606-2dd9-343a-a16e-a91c3da46169",
                        "target_lang_word": "Kanak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5e6c9f9-bb00-3ebc-8976-e4aa44ff46b6",
                                        "entry_id": "c35c40e8-2bfa-37e9-9273-93ef4b45c9ca",
                                        "glosses": [
                                            "An indigenous Melanesian inhabitant of New Caledonia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb5c8fe9-3956-4e0c-85be-d6ada93e3b2e",
                                                "sense_id": "e5e6c9f9-bb00-3ebc-8976-e4aa44ff46b6",
                                                "text": "In the working-class districts of Nouméa, which have a high population of indigenous Kanak residents, buildings were burned and wrecked vehicles remained in the middle of the road."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff1ce3ba-70ac-452f-b26d-6dba2b6f5b8e",
                        "source_entry_id": "44db4606-2dd9-343a-a16e-a91c3da46169",
