                "senses": [
                    {
                        "sense_id": "591ac496-fd55-3e84-a884-dd1beb88604a",
                        "entry_id": "d1e0cc2b-cf37-377a-ade0-5013ff2c3177",
                        "glosses": [
                            "гидрол. волнение, взброс воды на море, возникающее в результате резкого изменения скорости морского течения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21bc64e3-e5e4-4ec0-b422-7321626005f0",
                                "sense_id": "591ac496-fd55-3e84-a884-dd1beb88604a",
                                "text": "Приходилось лавировать в бурлящей толчее, происходившей от столкновения приливно-отливных течений, быстрин и сулоев."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d529793-7d28-3252-90a1-3c79bf8e1e90",
                        "entry_id": "d1e0cc2b-cf37-377a-ade0-5013ff2c3177",
                        "glosses": [
                            "гидрол. водоворот на месте встречи двух течений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c19b79c-525a-4705-81a2-4f159be2b727",
                                "sense_id": "9d529793-7d28-3252-90a1-3c79bf8e1e90",
                                "text": "Я тоже поднялся на ноги и увидел огромный сулой в том месте, где две протоки сливались вместе."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb507bc1-5ecb-35a0-81b9-bea01a4b4c2f",
                        "entry_id": "d1e0cc2b-cf37-377a-ade0-5013ff2c3177",
                        "glosses": [
                            "устар., рег. рассол, сусло, репный квас"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c3b5458-b454-4f6a-a609-ebd8d62094e3",
                                "sense_id": "cb507bc1-5ecb-35a0-81b9-bea01a4b4c2f",
                                "text": "Посем привели их ко кладезю, где сулой, и, почерпнув ведром, влили в горшки и сварили кисель."
                            }
                        ]
                    }
                ],
