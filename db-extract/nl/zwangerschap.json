                                        "sense_id": "09b64bf6-1227-3706-8650-4daa267350e2",
                                        "entry_id": "c8244267-da72-3509-a559-ea18d5187948",
                                        "glosses": [
                                            "The condition of being pregnant; an instance of this."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cda46db-58ba-4d6e-b373-f8ba12258a2c",
                                                "sense_id": "09b64bf6-1227-3706-8650-4daa267350e2",
                                                "text": "News that the duchess is in the \"very early stages\" of pregnancy with the third-in-line to the throne was officially released after she was taken to the King Edward VII hospital in central London, suffering from hyperemesis gravidarun, very acute morning sickness."
                                            },
                                            {
                                                "example_id": "b2b1b7fe-c8dc-4d9f-aaf4-22603daa0719",
                                                "sense_id": "09b64bf6-1227-3706-8650-4daa267350e2",
                                                "text": "Viable non-malformed singleton pregnancies were selected for cerebellar measurements; transcerebellar diameter, (TCD), left and right cerebellar diameters (LCD, RCD)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc875bae-8cde-32ee-9a52-c9a2ca127fb5",
                                        "entry_id": "c8244267-da72-3509-a559-ea18d5187948",
                                        "glosses": [
                                            "The period of time this condition prevails."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "203f0162-573f-3c0c-93d4-65b75fc89fbf",
                                        "entry_id": "c8244267-da72-3509-a559-ea18d5187948",
                                        "glosses": [
                                            "The progression of stages from conception to birth."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73a1bfd0-4789-42dc-ae25-a7f9f66c9e09",
                        "source_entry_id": "e4c83e27-ef28-38de-a12a-e7cebf001020",
                        "source_sense_id": "d7040d45-f101-3531-88ae-8c7f0db8a2b5",
                        "source_sense_description": "de tijd dat een vrouw een ongeboren kind met zich draagt",
                        "target_lang_word": "grossesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grossesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a0cafa7-a375-3938-802f-769807d47528",
                                        "entry_id": "6c74f056-91b7-3616-830c-b7ec3bed6520",
                                        "glosses": [
                                            "État d’une femme enceinte ou durée de cet état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ff2be47-549c-4d34-b3c7-da8e6b800779",
                                                "sense_id": "8a0cafa7-a375-3938-802f-769807d47528",
                                                "text": "Il considérait la reproduction comme un vice de l’amour, la grossesse comme une maladie d’araignée. Il a écrit quelque part : les anges sont hermaphrodites et stériles."
                                            },
                                            {
                                                "example_id": "7c80b310-d073-45ed-92ef-3bfd344165a3",
                                                "sense_id": "8a0cafa7-a375-3938-802f-769807d47528",
                                                "text": "Quelle que soit l’époque de la grossesse à laquelle on examine le ventre par la plessimétrie, on trouve presque toujours que très en dehors, une étendue plus ou moins grande des régions iliaques est occupée par le cœcum et par l’S iliaque."
                                            },
                                            {
                                                "example_id": "e648befb-7d5f-435d-b487-6b058dbaefd7",
                                                "sense_id": "8a0cafa7-a375-3938-802f-769807d47528",
                                                "text": "Une nouvelle grossesse s’étant manifestée, une doctoresse pronostiqua la naissance de deux jumeaux."
                                            },
                                            {
                                                "example_id": "02140f8c-797a-4a30-9be8-8fdc02741164",
                                                "sense_id": "8a0cafa7-a375-3938-802f-769807d47528",
                                                "text": "Ces petits inconvénients de la grossesse que la Dolly d’Anna Karénine […] trouvait plus pénible que les douleurs de l’enfantement."
                                            },
                                            {
                                                "example_id": "63baacb7-5c79-483b-8d94-dd3d48a0b383",
                                                "sense_id": "8a0cafa7-a375-3938-802f-769807d47528",
                                                "text": "Nous avons un besoin urgent d’un médicament combiné, spermicide et virucide, qui puisse protéger à la fois contre la grossesse et les MST."
                                            },
                                            {
                                                "example_id": "b525652d-cf07-45f6-b51d-2667d4f371d7",
                                                "sense_id": "8a0cafa7-a375-3938-802f-769807d47528",
                                                "text": "Elle affirmait ne pas savoir que les préservatifs étaient périmés, mais pouvait-il lui faire confiance ? Peut-être avait-elle manigancé cette grossesse depuis le début."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
