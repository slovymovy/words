                },
                {
                    "sense_id": "fc9e4862-eb55-3f77-a3c1-8419a303f028",
                    "sense_definition": "The refrain or chorus of a song.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer repeated the <w>fading</w> of the ballad to emphasize the theme.",
                            "target_lang_translations": {
                                "ru": "Певец повторил <w>рефрен</w> баллады, чтобы подчеркнуть ее тему.",
