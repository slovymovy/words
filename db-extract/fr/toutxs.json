                                    },
                                    {
                                        "sense_id": "c5db3e3f-2cdc-326b-8723-a940e01e0226",
                                        "entry_id": "f53ed22e-0f36-3444-b976-b9640151bfd0",
                                        "glosses": [
                                            "The totality of one's possessions."
