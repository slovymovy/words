                            {
                                "example_id": "8de019cb-ffcc-4916-a751-67e48d9d1bcc",
                                "sense_id": "bcc45b1f-3e60-36d3-ab3a-5e6dfcc749f2",
                                "text": "„Ein Edikt von Elisabeth I. unterwarf jedoch die Ministrels der Gerichtsbarkeit der Gemeinden und stellte sie den Landstreichern gleich (1572).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5017d523-16d1-3c8e-b70d-fa5c53a3d492",
                        "entry_id": "52081437-d8cc-37f6-b1c7-ff3f53e5d60c",
