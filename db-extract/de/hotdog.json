                ],
                "senses": [
                    {
                        "sense_id": "db4bfdc8-7562-3c2a-8a48-20ec6a3957b0",
                        "entry_id": "76a43899-638e-3d30-b4ca-c35061c3c1a8",
                        "glosses": [
                            "Fastfood, bestehend aus einem warmen Würstchen in einem länglichen Brötchen, das mit Senf oder Ketchup und gegebenenfalls weiteren Zutaten (etwa Röstzwiebeln, Sauerkraut, Remoulade, Mayonnaise oder Saure-Gurken-Scheiben) verzehrt wird; das Brötchen wird entweder aufgeschnitten oder aber der Länge nach ausgehöhlt, um das Würstchen darin zu platzieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e7704e6-468b-48d2-b9b1-8c939e5adef3",
                                "sense_id": "db4bfdc8-7562-3c2a-8a48-20ec6a3957b0",
                                "text": "Anlässlich seines elften Geburtstags gab es Hotdogs zum Essen."
                            },
                            {
                                "example_id": "dd6e323a-e535-4419-8f07-d0bc9ecf755a",
                                "sense_id": "db4bfdc8-7562-3c2a-8a48-20ec6a3957b0",
                                "text": "„Touristen steigen aus ihren kleinen weißen Mietwagen, kaufen sich Süßigkeiten und Hotdogs.“"
                            },
                            {
                                "example_id": "a83c238c-7dab-4e18-8a41-ba6c1fe98145",
                                "sense_id": "db4bfdc8-7562-3c2a-8a48-20ec6a3957b0",
                                "text": "„Die Quellen widersprechen einander ein wenig, wann der Hotdog nach Schweden gekommen ist.“"
                            },
                            {
                                "example_id": "0b5d42ca-4bd7-4df6-9f24-cae8e63712fd",
                                "sense_id": "db4bfdc8-7562-3c2a-8a48-20ec6a3957b0",
                                "text": "„Aldís zog die Nase hoch, schnäuzte sich, suchte Zuflucht im Imbiss des Ladens, wo sie einen Hotdog bestellte, aber gar keinen Hunger verspürte und das Würstchen nach dem ersten Bissen in die Tonne warf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edcde169-a1b2-48d3-8075-8d4e8a8dd40a",
                        "source_entry_id": "76a43899-638e-3d30-b4ca-c35061c3c1a8",
                        "source_sense_id": "db4bfdc8-7562-3c2a-8a48-20ec6a3957b0",
                        "target_lang_word": "hotdog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hotdog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe2a8f04-5547-3ffc-9adb-5b9e8ebcba3e",
                                        "entry_id": "98a7e58e-ca20-3029-8c37-809e6163170b",
                                        "glosses": [
                                            "Alternative spelling of hot dog."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb9175e5-d088-4c53-a5f1-ed4988cf76c8",
                                                "sense_id": "fe2a8f04-5547-3ffc-9adb-5b9e8ebcba3e",
                                                "text": "Mama’s Fried Chicken […] serves good fried birds, but better yet is their crawfish étouffée, served by the bowl, or ladled into a hotdog bun and dubbed a ‘crawdog.’"
                                            },
                                            {
                                                "example_id": "5a41b2b2-3523-4882-bd4b-7172e84d0516",
                                                "sense_id": "fe2a8f04-5547-3ffc-9adb-5b9e8ebcba3e",
                                                "text": "I dress him for the occasion; however, it is like putting a cocktail wiener into a hotdog bun."
                                            },
                                            {
                                                "example_id": "f9070319-bc1b-41f9-9152-de7b5a895ecc",
                                                "sense_id": "fe2a8f04-5547-3ffc-9adb-5b9e8ebcba3e",
                                                "text": "But the cars & trucks held cartons of roast chickens, slabs of cheeses, loaves of bread, racks of hotdogs, case upon case of soft drinks, cases of bottled sparkling water, pies, cakes, roast beefs & baked hams."
                                            },
                                            {
                                                "example_id": "c6346a61-4c90-4341-b28b-9c29257c7227",
                                                "sense_id": "fe2a8f04-5547-3ffc-9adb-5b9e8ebcba3e",
                                                "text": "If you happen to know about the legs or hotdogs meme, Evil Kermit, or what a Milkshake Duck or VSCO girl is, you are poised to do well in this version of the game [Trivial Pursuit Decades: 2010–2020]."
                                            }
                                        ]
                                    }
                                ]
                            },
