{
    "word_family": [
        "conversation",
        "conversational",
        "conversationalist",
        "conversely"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "03d3c21c-6bbb-3df2-92e7-9a25c5d57c88",
                    "sense_definition": "To talk; to engage in conversation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "talk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sat on the balcony for hours, <w>conversing</w> about their childhood memories.",
                            "target_lang_translations": {
                                "ru": "Они часами сидели на балконе, <w>беседуя</w> о воспоминаниях детства."
                            }
                        },
                        {
                            "text": "It is polite to <w>converse</w> with your dinner guests rather than staring at your phone.",
                            "target_lang_translations": {
                                "ru": "Вежливо <w>разговаривать</w> с гостями за ужином, а не утыкаться в телефон."
                            }
                        }
                    ],
                    "synonyms": [
                        "conversate",
                        "convo",
                        "discourse"
                    ],
                    "common_phrases": [
                        "converse with guests",
                        "converse in English"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговаривать, вести беседу, общаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беседовать",
                                "target_lang_sense_clarification": "вести разговор, общаться"
                            },
                            {
                                "target_lang_word": "разговаривать",
                                "target_lang_sense_clarification": "вести беседу"
                            },
                            {
                                "target_lang_word": "общаться",
                                "target_lang_sense_clarification": "поддерживать общение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0bfaaed-561f-39d5-99f1-8c24185e90dc",
                    "sense_definition": "To keep company; to hold intimate intercourse; to commune.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "commune",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He loved to walk alone in the forest to <w>converse</w> with nature.",
                            "target_lang_translations": {
                                "ru": "Он любил гулять в лесу в одиночестве, чтобы <w>общаться</w> с природой."
                            }
                        },
                        {
                            "text": "She spent her final years in a convent, seeking to <w>converse</w> with the divine.",
                            "target_lang_translations": {
                                "ru": "Последние годы жизни она провела в монастыре, стремясь к <w>единению</w> с божественным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "converse with nature"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the sense of spiritual or intimate communion"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общаться духовно, вести внутренний диалог, сливаться с кем-либо или чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общаться",
                                "target_lang_sense_clarification": "духовно или мысленно"
                            },
                            {
                                "target_lang_word": "единиться",
                                "target_lang_sense_clarification": "находиться в гармонии, сливаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1319562-8ffb-3c9d-aade-417d17b556ff",
                    "sense_definition": "To have knowledge of something, from long talk or study.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was deeply <w>conversed</w> in the ancient philosophies of the East.",
                            "target_lang_translations": {
                                "ru": "Он был глубоко <w>знаком</w> с древними философиями Востока."
                            }
                        },
                        {
                            "text": "To truly understand the law, one must <w>converse</w> with its historical precedents.",
                            "target_lang_translations": {
                                "ru": "Чтобы по-настоящему понять закон, нужно <w>быть знакомым</w> с его историческими прецедентами."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Rarely used in modern English to mean being conversant with"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть хорошо знакомым с чем-либо, глубоко изучить что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть знакомым",
                                "target_lang_sense_clarification": "с учением, философией"
                            },
                            {
                                "target_lang_word": "быть сведущим",
                                "target_lang_sense_clarification": "в какой-либо области"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d522e221-9a83-3de6-8ff3-47568bee204d",
                    "sense_definition": "The opposite or reverse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opposite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some people believe that wealth brings happiness, but the <w>converse</w> can also be true.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди верят, что богатство приносит счастье, но <w>обратное</w> тоже может быть верным."
                            }
                        },
                        {
                            "text": "She argued that technology isolates us, while her colleague maintained the <w>converse</w>.",
                            "target_lang_translations": {
                                "ru": "Она утверждала, что технологии изолируют нас, в то время как её коллега отстаивал <w>противоположное</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the converse is true"
                    ],
                    "target_lang_definitions": {
                        "ru": "Противоположность, обратное утверждение или положение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противоположность",
                                "target_lang_sense_clarification": "обратное утверждение"
                            },
                            {
                                "target_lang_word": "обратное",
                                "target_lang_sense_clarification": "противоположное положение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "107a5258-afd7-3aee-8a21-45ebb716943d",
                    "sense_definition": "Of a proposition or theorem consisting of a statement of the form \"If A is true, then B is true\", the statement \"If B is true, then A is true\" which need not be equivalent to the first one.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All trout are fish, but the <w>converse</w>, that all fish are trout, is not true.",
                            "target_lang_translations": {
                                "ru": "Вся форель — это рыба, но <w>обратное утверждение</w> о том, что вся рыба — это форель, неверно."
                            }
                        },
                        {
                            "text": "In geometry, proving a theorem does not automatically prove its <w>converse</w>.",
                            "target_lang_translations": {
                                "ru": "В геометрии доказательство теоремы не означает автоматического доказательства <w>обратной теоремы</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prove the converse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обратное утверждение или теорема в логике и математике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обратное утверждение",
                                "target_lang_sense_clarification": "в логике"
                            },
                            {
                                "target_lang_word": "обратная теорема",
                                "target_lang_sense_clarification": "в математике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62a31baf-42dd-31ed-94d8-ac0349993af4",
                    "sense_definition": "Free verbal interchange of thoughts or views; conversation; chat.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "talk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the evening in friendly <w>converse</w> by the fireplace.",
                            "target_lang_translations": {
                                "ru": "Они провели вечер в дружеской <w>беседе</w> у камина."
                            }
                        },
                        {
                            "text": "He preferred the quiet of his study to the vain <w>converse</w> of the world.",
                            "target_lang_translations": {
                                "ru": "Он предпочитал тишину своего кабинета тщетным <w>разговорам</w> этого мира."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hold converse"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Mainly literary or archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Непринужденный разговор, беседа, общение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беседа",
                                "target_lang_sense_clarification": "разговор, общение"
                            },
                            {
                                "target_lang_word": "разговор",
                                "target_lang_sense_clarification": "обмен мыслями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90e8dd39-3b29-378c-8251-1bd1874ecb53",
                    "sense_definition": "One of a pair of terms that name or describe a relationship from opposite perspectives; converse antonym; relational antonym.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The words 'parent' and 'child' represent a classic example of a relational <w>converse</w>.",
                            "target_lang_translations": {
                                "ru": "Слова «родитель» и «ребенок» представляют собой классический пример относительного <w>конверсива</w>."
                            }
                        },
                        {
                            "text": "In linguistics, 'buy' and 'sell' are analyzed as a pair of <w>converses</w>.",
                            "target_lang_translations": {
                                "ru": "В лингвистике слова «покупать» и «продавать» анализируются как пара <w>конверсивов</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из пары терминов, описывающих отношение с противоположных точек зрения (конверсив)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конверсив",
                                "target_lang_sense_clarification": "в лингвистике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c72268a1-f68e-3a6b-b559-e3626f77f262",
                    "sense_definition": "Synonym of <w>transpose</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In matrix algebra, the <w>converse</w> of a matrix is often referred to as its transpose.",
                            "target_lang_translations": {
                                "ru": "В матричной алгебре <w>транспонированная матрица</w> часто называется просто транспонированной."
                            }
                        },
                        {
                            "text": "He calculated the <w>converse</w> of the linear transformation to solve the equation.",
                            "target_lang_translations": {
                                "ru": "Он вычислил <w>обратное</w> линейное преобразование, чтобы решить уравнение."
                            }
                        }
                    ],
                    "synonyms": [
                        "transpose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Транспонированная матрица или преобразование."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "транспонированная матрица",
                                "target_lang_sense_clarification": "в математике"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c93ff5c0-fb9e-39e0-add3-cac03a6ea4e9",
                    "sense_definition": "Opposite; reversed in order or relation; reciprocal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opposite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must also consider the <w>converse</w> case where demand exceeds supply.",
                            "target_lang_translations": {
                                "ru": "Мы также должны рассмотреть <w>обратный</w> случай, когда спрос превышает предложение."
                            }
                        },
                        {
                            "text": "The two phenomena are linked in a <w>converse</w> relationship.",
                            "target_lang_translations": {
                                "ru": "Эти два явления связаны <w>обратной</w> зависимостью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "converse relation",
                        "converse case"
                    ],
                    "target_lang_definitions": {
                        "ru": "Противоположный, обратный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обратный",
                                "target_lang_sense_clarification": "противоположный по отношению"
                            },
                            {
                                "target_lang_word": "противоположный",
                                "target_lang_sense_clarification": "обратный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "37cdc866-21db-3f74-92ec-15970e494b1f",
                    "sense_definition": "A shoe of an American-based brand of that name.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "shoes",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "She wore a classic pair of black <w>Converse</w> with her jeans.",
                            "target_lang_translations": {
                                "ru": "Она носила классическую пару черных <w>конверсов</w> с джинсами."
                            }
                        },
                        {
                            "text": "He bought new <w>Converse</w> sneakers for the upcoming school year.",
                            "target_lang_translations": {
                                "ru": "Он купил новые кеды <w>Converse</w> к предстоящему учебному году."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pair of Converse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кеды марки Converse."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конверсы",
                                "target_lang_sense_clarification": "обувь бренда Converse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b1503a8-fb54-3042-87d8-45b7e9d31c76",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surnames",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historic building was designed by the famous architect George <w>Converse</w>.",
                            "target_lang_translations": {
                                "ru": "Это историческое здание было спроектировано известным архитектором Джорджем <w>Конверсом</w>."
                            }
                        },
                        {
                            "text": "We invited Dr. <w>Converse</w> to speak at our annual conference.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили доктора <w>Конверса</w> выступить на нашей ежегодной конференции."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия Конверс."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Конверс",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}