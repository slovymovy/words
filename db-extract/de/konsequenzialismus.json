                        "entry_id": "3f1359e7-7479-326d-9ce7-08a9810ca5bb",
                        "glosses": [
                            "Theorie, die den moralischen Wert einer Handlung an ihren Konsequenzen misst"
                        ],
                        "tags": [
                            "Ethik"
                        ],
                        "examples": [
                            {
                                "example_id": "2ddaa167-8d90-44ff-a34d-21e2c7d04624",
                                "sense_id": "a2023196-33db-3695-8dbb-63dfc6504da7",
                                "text": "„Zwar hat Nida-Rümelin seine frühere scharfsinnige Kritik des Konsequenzialismus und damit den Gedanken an so etwas wie unbedingte, kategorische Pflichten nicht aufgegeben.“"
                            },
                            {
                                "example_id": "342ce52d-1552-48b2-920c-8c205875eea6",
                                "sense_id": "a2023196-33db-3695-8dbb-63dfc6504da7",
                                "text": "„Er argumentiert mit ihr gegen den Konsequenzialismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73435581-9bf9-4f43-a34b-86579771c9e0",
