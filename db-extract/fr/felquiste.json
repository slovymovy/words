                        "glosses": [
                            "Qui se rapporte au Front de libération du Québec ou à ses militants."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "59cfcde3-4939-488f-92bf-fc346ad88f52",
                                "sense_id": "ba76c507-39cc-3dd7-aeec-4690330d4632",
                                "text": "L'enlèvement d'un ministre et d'un diplomate par des cellules felquistes, l'assassinat de Pierre Laporte, la Loi sur les mesures de guerre, bref, la Crise d'octobre 70 est à nous et en nous."
                            },
                            {
                                "example_id": "64baea34-6909-4d4a-ab99-7ef11b9eb4ad",
                                "sense_id": "ba76c507-39cc-3dd7-aeec-4690330d4632",
                                "text": "Selon lui, une telle décision ouvrirait la porte à des abus dignes de la Crise d’octobre 1970, qui avait mené à 450 arrestations sans mandat de prétendus sympathisants felquistes."
                            }
                        ]
                    }
