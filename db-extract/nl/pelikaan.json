                                    {
                                        "sense_id": "7be841d6-9d1b-3c36-94a2-50a8656881fd",
                                        "entry_id": "5be3e672-6e18-38ef-b01a-ba6df1e41a11",
                                        "glosses": [
                                            "Vogel aus der Familie der Pelicanidae mit charakteristischem Hautsack am Unterschnabel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa4bf58b-81bb-4453-a66f-599c187b96c6",
                                                "sense_id": "7be841d6-9d1b-3c36-94a2-50a8656881fd",
                                                "text": "Ein Pelikan kann kaum mit einem anderen Vogel verwechselt werden."
                                            },
                                            {
                                                "example_id": "c790bc95-2060-4cb1-bfc1-cdd91d86c410",
                                                "sense_id": "7be841d6-9d1b-3c36-94a2-50a8656881fd",
                                                "text": "Außer auf Antarktika gibt es auf allen Erdteilen Pelikane."
                                            },
                                            {
                                                "example_id": "379d070d-c304-4181-9493-8d12d3dcbb45",
                                                "sense_id": "7be841d6-9d1b-3c36-94a2-50a8656881fd",
                                                "text": "„Celeste hatte die Insel auf 99 Jahre gepachtet und brachte Besucher aus der Stadt mit dem Floß hinüber zu seinen Hirschkühen, Pelikanen und Marabus, zu den Mufflons aus dem Aïr und den Dorkas-Gazellen aus der Ténéré.“"
                                            },
                                            {
                                                "example_id": "ad675bfc-9d86-4fa3-9ed6-84db92402b11",
                                                "sense_id": "7be841d6-9d1b-3c36-94a2-50a8656881fd",
                                                "text": "„Überall watschelten Wildenten umher, Pelikane, Wasserhühner, Rotschnäbel, Phildeons mit ihren Pinselzungen und ein paar Leierschwänze mit schillernden Schwanzfedern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "257a0915-cde9-4c90-8d00-7c6bd5c2b26c",
                        "source_entry_id": "26bc5c9c-69a8-353b-8520-43f49db2f60e",
                        "source_sense_id": "d1d84b35-5f8c-3092-994c-acd8e2090bd8",
                        "source_sense_description": "benaming voor vogels uit de familie Pelecanidae",
                        "target_lang_word": "pelican",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pelican",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7aa092c8-6a93-30a7-b928-6eab0c1fa9c3",
                                        "entry_id": "9a842c3f-44d2-379d-9f10-5f97eb15af56",
                                        "glosses": [
                                            "Any of various seabirds of the family Pelecanidae, having a long bill with a distendable pouch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6a1815d-85e5-48d7-aea4-499cfa2692bc",
                                                "sense_id": "7aa092c8-6a93-30a7-b928-6eab0c1fa9c3",
                                                "text": "The old have outlived that mental world we so misname in calling it a world of enjoyment;—they have outlived the feverish dreams which waste those keen hopes—the pelicans of the heart, feeding on the life-blood of their parent;—they have now no part in the excitement of success, whether in its desire or disappointment."
                                            },
                                            {
                                                "example_id": "3e18ec4b-953c-49d2-ba73-90c07c078ac4",
                                                "sense_id": "7aa092c8-6a93-30a7-b928-6eab0c1fa9c3",
                                                "text": "Pelicans fly below us with stiffly formal strokes, and gulls wheel and keen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11c3e63e-c46c-386e-a62a-f8059f59470e",
