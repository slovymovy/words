                    {
                        "sense_id": "753e30f9-ec59-38ac-9802-5d8a7fe19183",
                        "entry_id": "a0d0fc55-2998-3ca0-93f1-d983b60ac431",
                        "glosses": [
                            "Transformé par la pensée, en fonction d’un idéal ; plus beau que nature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba96f3bf-3832-4178-befc-126afa6e60ea",
                                "sense_id": "753e30f9-ec59-38ac-9802-5d8a7fe19183",
                                "text": "Il n'y a pas d'homme idéal, juste des hommes idéalisés. Autant pour les femmes."
                            },
                            {
                                "example_id": "89a09448-cebf-47c2-977e-77fdcf45e701",
                                "sense_id": "753e30f9-ec59-38ac-9802-5d8a7fe19183",
                                "text": "Les murs plâtrés du tombeau étaient richement et habilement décorés de fresques animées, représentant des vues idéalisées de la vie et des activités de Nebamon."
                            }
                        ]
                    }
