                "senses": [
                    {
                        "sense_id": "f4308735-0eca-3d57-ba17-9b64265027ee",
                        "entry_id": "bc66f2f5-beaf-3f1e-bd4e-871a78262c0b",
                        "glosses": [
                            "typisch Wiener Witz um Graf Bobby als Protagonisten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b1fe172-c086-4b05-9697-7246a4adfb69",
                                "sense_id": "f4308735-0eca-3d57-ba17-9b64265027ee",
                                "text": "„Ab sofort erschienen nur noch Graf-Bobby-Witze.“"
                            },
                            {
                                "example_id": "11d12191-7b40-4e3f-a259-f519c32ce46e",
                                "sense_id": "f4308735-0eca-3d57-ba17-9b64265027ee",
                                "text": "„Die Figur wurde in den 1950er Jahren so populär, dass Graf-Bobby-Witze nicht nur in Anthologien und Sammlungen erschienen, sondern auch Filme mit Graf Bobby als Hauptfigur produziert wurden.“"
                            },
                            {
                                "example_id": "9fe448a0-9bc0-496f-b98c-84af92419462",
                                "sense_id": "f4308735-0eca-3d57-ba17-9b64265027ee",
                                "text": "„Es handelt sich um einen Graf-Bobby-Witz:...“"
                            },
                            {
                                "example_id": "b17360db-e07b-4686-ad50-2403f12f6b77",
                                "sense_id": "f4308735-0eca-3d57-ba17-9b64265027ee",
                                "text": "„Noch zu Zeiten der Monarchie entstand die Witzfigur des trottelig-dekadenten Wiener Grafen Bobby, der sich stets in standesgemässer Gesellschaft bewegte, etwa mit Graf Rudi oder Baron Mucki. Graf-Bobby-Witze waren zeitweise so erfolgreich, dass daraus Kinofilme entstanden, die Figur wurde mehrmals von Peter Alexander verkörpert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
