                {
                    "sense_id": "85f555f3-b690-3984-bcb9-036bac95d608",
                    "sense_definition": "De nacht die volgt op de huidige dag.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik hoop dat je <vannacht> goed zult slapen na deze lange dag.",
                            "target_lang_translations": {
                                "en": "I hope you will sleep well <tonight> after this long day.",
                                "ru": "Надеюсь, ты хорошо выспишься <сегодня ночью> после этого долгого дня.",
                                "de": "Ich hoffe, dass du <w>heute Nacht</w> nach diesem langen Tag gut schlafen wirst.",
                                "pl": "Mam nadzieję, że <w>dziś w nocy</w> będziesz dobrze spać po tym długim dniu.",
                                "fr": "J'espère que tu dormiras bien <w>cette nuit</w> après cette longue journée.",
                                "it": "Spero che tu possa dormire bene <w>stanotte</w> dopo questa lunga giornata.",
                                "cs": "Doufám, že se <w>dnes v noci</w> po tomto dlouhém dni dobře vyspíš.",
                                "tr": "Umarım bu uzun günden sonra <w>bu gece</w> iyi uyursun.",
                                "es": "Espero que duermas bien <w>esta noche</w> después de este largo día."
                            }
                        },
                        {
                            "text": "De weermannen verwachten voor <vannacht> zware vorst aan de grond.",
                            "target_lang_translations": {
                                "en": "The weathermen expect heavy ground frost for <tonight>.",
                                "ru": "Синоптики ожидают сильные заморозки на почве <сегодня ночью>.",
                                "de": "Die Meteorologen erwarten für <w>heute Nacht</w> starken Bodenfrost.",
                                "pl": "Synoptycy spodziewają się na <w>dzisiejszą noc</w> silnych przyziemnych przymrozków.",
                                "fr": "Les météorologues prévoient de fortes gelées au sol pour <w>cette nuit</w>.",
                                "it": "I meteorologi prevedono forti gelate al suolo per <w>stanotte</w>.",
                                "cs": "Meteorologové očekávají na <w>dnešní noc</w> silné přízemní mrazíky.",
                                "tr": "Meteorologlar <w>bu gece</w> için yerde kuvvetli don bekliyor.",
                                "es": "Los meteorólogos prevén heladas fuertes a ras de suelo para <w>esta noche</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "voor vannacht",
                        "tot vannacht"
                    ],
                    "target_lang_definitions": {
                        "en": "The night that follows the current day.",
                        "ru": "Ночь, которая наступит после текущего дня.",
                        "de": "Die Nacht, die auf den heutigen Tag folgt.",
                        "pl": "Noc, która nastąpi po dzisiejszym dniu.",
                        "fr": "La nuit qui suit le jour actuel.",
                        "it": "La notte che segue il giorno corrente.",
                        "cs": "Noc, která následuje po dnešním dni.",
                        "tr": "Bugünden sonra gelecek olan gece.",
                        "es": "La noche que sigue al día de hoy."
                    },
