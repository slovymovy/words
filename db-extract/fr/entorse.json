                                        "glosses": [
                                            "To weaken, as a joint, ligament, or muscle, by sudden and excessive exertion, as by wrenching; to overstrain, or stretch injuriously, but without luxation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c6e8458-bd1a-466b-ae0e-6c00645dcc9d",
                                                "sense_id": "5e2f4a81-7412-36bd-904f-7d969b0a2fc5",
                                                "text": "He sprained his knee after falling off the bicycle."
                                            },
                                            {
                                                "example_id": "a5a884ef-c0ac-4168-ae48-ed3cd5d1cb70",
                                                "sense_id": "5e2f4a81-7412-36bd-904f-7d969b0a2fc5",
                                                "text": "Hi! I suppose you're expecting the Roadrunner! Well, he sprained a giblet cornering a sharp coive the other day, uh, so, uh, I'm standing in for him."
                                            }
                                        ]
                                    }
                                ]
                            },
