                        "glosses": [
                            "Faire perdre son caractère amérindien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98318f8e-d01e-480c-9ac7-d5ac0da7c2d3",
                                "sense_id": "3975e6a1-12ef-34a7-b388-fc596331a560",
                                "text": "Toute une série de moments importants de notre quête de ce que nous sommes sur cette terre désamérindianisée par des millions de différences et dont ni Radio Tralala, ni Tébé Tremblek, ni Canal Ignorance, ni les Chaînes Dédit/Crébit, ni Cholestérol et DéDépressions ne parleront jamais."
                            },
                            {
                                "example_id": "4c521ea0-50f9-4777-97fa-670b4832e560",
                                "sense_id": "3975e6a1-12ef-34a7-b388-fc596331a560",
                                "text": "L’Amérindien qui se civilise, selon cette logique, se désamérindianise."
                            }
                        ]
                    }
