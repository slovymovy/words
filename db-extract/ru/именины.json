                    }
                ],
                "senses": [
                    {
                        "sense_id": "2353175d-ad02-3ff5-a17a-d5f7a2e5b14e",
                        "entry_id": "8805723c-fbb4-3e97-9040-c6638252333f",
                        "glosses": [
                            "чей-либо личный праздник в день, когда церковь отмечает память одноимённого святого или ангела"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61aa1dc0-18ce-4f3f-8b41-9b4e2064d12d",
                                "sense_id": "2353175d-ad02-3ff5-a17a-d5f7a2e5b14e",
                                "text": "Я изредка бывал у Нади ― особенно на 18 июня, мои именины и «нашу с ней» годовщину (но она этой даты не замечала); при её муже мне у неё было тоскливо, а она ко мне не приходила, ни с мужем, ни одна"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a20a8878-d42a-42eb-b44c-34c4bc29a19e",
                        "source_entry_id": "8805723c-fbb4-3e97-9040-c6638252333f",
                        "source_sense_id": "2353175d-ad02-3ff5-a17a-d5f7a2e5b14e",
                        "target_lang_word": "name day",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "name day",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f984315a-2496-382a-a59d-0b2cdd5a62f1",
                                        "entry_id": "439c9d17-d47f-34d2-bc31-9d38c05a9fc9",
                                        "glosses": [
                                            "The feast day of the saint after whom one is named."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2ae653e-9332-4eb6-a363-dbdcbfe086f3",
                                                "sense_id": "f984315a-2496-382a-a59d-0b2cdd5a62f1",
                                                "text": "In Italy, many individuals celebrate not only their birthday but also their name day, the feast day of the saint for whom they were named. Celebrations on one's name day are often as important as those on one's birthday; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbdd89bd-8282-33fd-8f37-3814af48fa30",
                                        "entry_id": "439c9d17-d47f-34d2-bc31-9d38c05a9fc9",
                                        "glosses": [
                                            "Synonym of ticket day."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38e00d4a-18fc-4ad0-8ebf-4f54a2cf42fe",
                        "source_entry_id": "8805723c-fbb4-3e97-9040-c6638252333f",
                        "source_sense_id": "2353175d-ad02-3ff5-a17a-d5f7a2e5b14e",
                        "target_lang_word": "saint's day",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ed47d186-b077-48ed-b793-0f3a8dd74d53",
                        "source_entry_id": "8805723c-fbb4-3e97-9040-c6638252333f",
                        "source_sense_id": "2353175d-ad02-3ff5-a17a-d5f7a2e5b14e",
                        "target_lang_word": "Namenstag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Namenstag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f7bd650-4556-361e-adb3-6ac2e2f17d02",
                                        "entry_id": "1a515110-e012-344a-8a2f-abda1ba81906",
                                        "glosses": [
                                            "Gedenktag für den Namenspatron"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ae4309c-c46a-4ffc-b804-fb609cf0f095",
                                                "sense_id": "5f7bd650-4556-361e-adb3-6ac2e2f17d02",
                                                "text": "Das Feiern des Namenstages hat in manchen Gegenden den Geburtstag zeitweilig verdrängt."
                                            },
                                            {
                                                "example_id": "b7c3544e-fc59-4117-b109-1397d067ac1c",
                                                "sense_id": "5f7bd650-4556-361e-adb3-6ac2e2f17d02",
                                                "text": "„Manche Leute feiern hier sogar ihren Geburtstag oder Namenstag.“"
                                            },
                                            {
                                                "example_id": "e1c50f45-0225-4593-9563-e52a7c231f46",
                                                "sense_id": "5f7bd650-4556-361e-adb3-6ac2e2f17d02",
                                                "text": "„Neben dem Geburtstag wurde und wird von katholischen Namensträgern oft der Namenstag besonders begangen.“"
                                            },
                                            {
                                                "example_id": "e3d16a73-ceb5-4541-81da-f2f432046b04",
                                                "sense_id": "5f7bd650-4556-361e-adb3-6ac2e2f17d02",
                                                "text": "„Bei Rostows wurde ein doppelter Namenstag gefeiert, da die Mutter und die jüngste Tochter beide Natalja hiessen.“"
                                            },
                                            {
                                                "example_id": "9fa25cbc-36c8-4502-a56b-8a1025c2a378",
                                                "sense_id": "5f7bd650-4556-361e-adb3-6ac2e2f17d02",
                                                "text": "„Als er hörte, daß ich bei Don Gennaro wohnte, besuchte er ihn, um ihm zu seinem Namenstag zu gratulieren, der am Tag nach dem Eintritt der Nonne bei den Klarissinnen gefeiert wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
