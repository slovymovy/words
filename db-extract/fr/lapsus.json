                                            {
                                                "example_id": "56c2d54b-9dc1-4731-94ef-91b9281d14ce",
                                                "sense_id": "d0752415-1a7b-306d-a2be-614d673cb8d9",
                                                "text": "A sabedoria dos velhos é um grande engano."
                                            },
                                            {
                                                "example_id": "93cacaa5-7918-4f95-9f86-b9682bf07b01",
                                                "sense_id": "d0752415-1a7b-306d-a2be-614d673cb8d9",
                                                "text": "É pecado pensar mal dos outros, mas raramente é engano."
                                            },
                                            {
                                                "example_id": "bdf82a9c-1e58-4291-ba26-d1d9182961f9",
                                                "sense_id": "d0752415-1a7b-306d-a2be-614d673cb8d9",
                                                "text": "Os homens mudam de governantes com grande facilidade, esperando sempre uma melhoria. Essa esperança os leva a se levantar em armas contra os atuais. E isto é um engano, pois a experiência demonstra mais tarde que a mudança foi para pior."
                                            }
                                        ]
