                                "target_senses": [
                                    {
                                        "sense_id": "b07ad9af-f44f-377e-9c28-74d43da8d13c",
                                        "entry_id": "6dbcd64f-6212-34a5-a21b-6df4f08cf22c",
                                        "glosses": [
                                            "abweichend von der Moral; der Moral entgegenlaufend; losgelöst von moralischer Beurteilung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50396782-dd29-4b66-b8ea-e851abcd30d0",
                                                "sense_id": "b07ad9af-f44f-377e-9c28-74d43da8d13c",
                                                "text": "Das ist ein äußerst amoralisches Angebot!"
                                            },
                                            {
                                                "example_id": "86771caa-9088-4804-a976-5ae674d180ed",
                                                "sense_id": "b07ad9af-f44f-377e-9c28-74d43da8d13c",
                                                "text": "„Das moralische Skandalon ihres amoralischen Lebensstils ist längst konsensfähig geworden, vorausgesetzt, man verfügt über das nötige Kleingeld.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f666a33-3bf2-45ad-9be8-451db459d40f",
                        "source_entry_id": "373256d5-3443-32b7-95bd-a670ac6db150",
                        "source_sense_id": "51de1253-123c-3dd2-bd08-70d323e95c51",
                        "source_sense_description": "frei von Moral; sie missachtend; amoralisch, unmoralisch",
                        "target_lang_word": "unmoralisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unmoralisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a9fec04-1f94-35d1-8576-e9523b7e6ca6",
                                        "entry_id": "56b12df7-87ef-3c4c-be1a-522375c357d1",
                                        "glosses": [
                                            "ethischen Werten und Normen zuwiderlaufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5ff7083-65ea-4590-8518-d3f56f8c6878",
                                                "sense_id": "0a9fec04-1f94-35d1-8576-e9523b7e6ca6",
                                                "text": "Mit jemandem, der sich so unmoralisch verhält, möchte ich nichts zu tun haben."
                                            },
                                            {
                                                "example_id": "24bd181f-4d07-47d1-bbd5-f97e783a6778",
                                                "sense_id": "0a9fec04-1f94-35d1-8576-e9523b7e6ca6",
                                                "text": "„Renovierungen bringen nicht nur viel Lärm und Schmutz mit sich: Wollen Vermieter ihre Mieter raushaben, setzen sie auch unmoralische Methoden an.“"
                                            },
                                            {
                                                "example_id": "7780879d-9325-41d3-93d0-e9bf21f1bf4e",
                                                "sense_id": "0a9fec04-1f94-35d1-8576-e9523b7e6ca6",
                                                "text": "„Der Hamburger SV hat zwar die Rettung in der Bundesliga erzwungen, aber dies zu einem unmoralisch hohen Preis.“"
                                            },
                                            {
                                                "example_id": "42c6d5fd-05b6-46d6-83d4-1be6ad15e2a0",
                                                "sense_id": "0a9fec04-1f94-35d1-8576-e9523b7e6ca6",
                                                "text": "„Dem Gesindel hatte er damit gleich einmal gezeigt, wer in Tratschen das Sagen hat und dass weder Verbrecher, noch unmoralische Schlampen im Ort willkommen sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
