                    },
                    {
                        "translation_id": "d1d5f65d-0488-4a09-a8f7-6e41021c7822",
                        "source_entry_id": "498da370-6aaf-3484-b2eb-a2702a1c299c",
                        "source_sense_id": "c9e23392-558d-3f36-8f65-d74b4bcc5dcb",
                        "source_sense_description": "a utensil for supporting wood while burning",
                        "target_lang_word": "Kaminbock",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaminbock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87ec7d33-82c6-3f61-98d3-34b0891c6e3d",
                                        "entry_id": "57ec1979-b05f-3fa0-bd74-ab12e3d6fbf1",
                                        "glosses": [
                                            "Gestell in einem offenen Kamin, auf welches Feuerholz gelegt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e18b52b-1475-462c-b2fe-9861a403c39d",
                                                "sense_id": "87ec7d33-82c6-3f61-98d3-34b0891c6e3d",
                                                "text": "Der Kaminbock war ausgesprochen kunstvoll gefertigt."
                                            },
                                            {
                                                "example_id": "5fae8604-1393-4195-88f8-6b5331f289fb",
                                                "sense_id": "87ec7d33-82c6-3f61-98d3-34b0891c6e3d",
                                                "text": "„Auch im Schlafzimmer der Königin in Versailles waren solche Kaminböcke aufgestellt.“"
                                            },
                                            {
                                                "example_id": "e2336d83-8bfa-46e3-9778-d11f3fb40453",
                                                "sense_id": "87ec7d33-82c6-3f61-98d3-34b0891c6e3d",
                                                "text": "„Als Umrahmung der beiden offenen Kamine in Rockefellers Living-Room an New Yorks Fifth Avenue schufen Matisse und Leger Mitte der dreißiger Jahre deckenhohe Wandgemälde; Alberto und Diego Giacometti entwarfen dazu Kaminböcke im Art-Déco-Stil, aber auch vergoldete Konsoltische, Stehlampen und einen lederbezogenen Coffee-Table.“"
                                            },
                                            {
                                                "example_id": "db4d7ce2-458f-42b5-aa2d-26e9c9cdb42d",
                                                "sense_id": "87ec7d33-82c6-3f61-98d3-34b0891c6e3d",
                                                "text": "„Feuervergoldete Kaminböcke in Gestalt steigender Rösser auf schwingenden Roccaillen (135.000 Euro) passen trefflich in die französische Ambiance, die Albrecht Neuhaus pflegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
