                "senses": [
                    {
                        "sense_id": "2d08f9c3-ca27-3317-b095-79e34fac8e27",
                        "entry_id": "8168ddef-6d48-3777-bb4a-225df8efc495",
                        "glosses": [
                            "Faire perdre ses flocons à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ec8d6f9-e8a0-46c9-b41b-3985dd5f1aee",
                                "sense_id": "2d08f9c3-ca27-3317-b095-79e34fac8e27",
                                "text": "L’acide citrique tend à défloconner la plupart des minerais auxquels il est ajouté et l’addition ultérieure d’hydrate de soude n’en contrarie pas l’effet."
                            },
                            {
                                "example_id": "0a57d604-c1d6-4c4c-b63d-ac851dafdc78",
                                "sense_id": "2d08f9c3-ca27-3317-b095-79e34fac8e27",
                                "text": "Au contraire les particules de gangue, mouillées par l’eau ne floconnent pas, ne coagulent pas ; et si elles ont tendance à le faire, l’addition d’un alcali les défloconne."
                            }
                        ]
                    }
                ],
