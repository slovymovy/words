                ],
                "senses": [
                    {
                        "sense_id": "a584e2af-3748-3517-9d07-681c13775d01",
                        "entry_id": "73e33e8f-932e-32d3-a109-ec4c818b97fd",
                        "glosses": [
                            "Provoquer chez soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b97df55-8056-47f6-b0ca-dc3c1324d434",
                                "sense_id": "a584e2af-3748-3517-9d07-681c13775d01",
                                "text": "Dans tous les cas de figure, le crash est autoprovoqué et n'est en aucun cas inévitable."
                            },
                            {
                                "example_id": "2a761de0-5421-4328-b0b4-6b9f56eeae96",
                                "sense_id": "a584e2af-3748-3517-9d07-681c13775d01",
                                "text": "Ou comment s'autoprovoquer une anesthèsie buccale et se filer la gerbe dans le même temps."
                            },
                            {
                                "example_id": "8658d597-de3c-4df4-a52e-18fef795fd4e",
                                "sense_id": "a584e2af-3748-3517-9d07-681c13775d01",
                                "text": "On ne veut pas s'autoprovoquer de crise cardiaque au volant?"
                            }
                        ]
                    },
                    {
                        "sense_id": "91d828e6-fb82-336a-9f43-949c0675f7db",
                        "entry_id": "73e33e8f-932e-32d3-a109-ec4c818b97fd",
                        "glosses": [
                            "Se provoquer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eeea2f7-8beb-424c-974a-b639934dd3f4",
                                "sense_id": "91d828e6-fb82-336a-9f43-949c0675f7db",
                                "text": "Tu ne le penseras pas vraiment, mais tu le penseras encore et encore dans le but de t'autoprovoquer."
                            },
                            {
                                "example_id": "f12c2b88-6619-44d3-b702-5ef36cc630a1",
                                "sense_id": "91d828e6-fb82-336a-9f43-949c0675f7db",
                                "text": "mon chum aimerait ca que je m'autoprovoque."
                            }
                        ]
                    }
