{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15b843a5-7080-3dfd-ae3d-60d8a7d1f0f7",
                    "sense_definition": "A blue-green coating or patina that naturally forms on copper, brass, and bronze over time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "patina",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient bronze statue was covered in a thick layer of <w>verdigris</w>.",
                            "target_lang_translations": {
                                "ru": "Древняя бронзовая статуя была покрыта толстым слоем <w>патины</w>."
                            }
                        },
                        {
                            "text": "Years of exposure to the elements left the church roof green with <w>verdigris</w>.",
                            "target_lang_translations": {
                                "ru": "Годы воздействия непогоды окрасили крышу церкви в зелёный цвет из-за <w>медянки</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "aerugo"
                    ],
                    "common_phrases": [
                        "coated with verdigris",
                        "green with verdigris"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сине-зелёный налёт или патина, образующаяся со временем на меди, латуни и бронзе в результате окисления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "патина",
                                "target_lang_sense_clarification": "налёт на меди и бронзе"
                            },
                            {
                                "target_lang_word": "медянка",
                                "target_lang_sense_clarification": "зелёный налёт на меди"
                            },
                            {
                                "target_lang_word": "зелёный налёт",
                                "target_lang_sense_clarification": "на медных сплавах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f3e8c59-f34d-3975-980b-e403b497b8d4",
                    "sense_definition": "A moderate greenish-blue or bluish-green color, like that of aged copper.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painter chose a subtle <w>verdigris</w> to depict the ocean waves.",
                            "target_lang_translations": {
                                "ru": "Художник выбрал нежный <w>цвет ярь-медянки</w>, чтобы изобразить океанские волны."
                            }
                        },
                        {
                            "text": "Her new silk dress had an unusual shade resembling <w>verdigris</w>.",
                            "target_lang_translations": {
                                "ru": "У её нового шёлкового платья был необычный оттенок, напоминающий <w>патину</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Умеренный синевато-зелёный или зелёно-голубой цвет окислившейся меди."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цвет ярь-медянки",
                                "target_lang_sense_clarification": "синевато-зелёный оттенок"
                            },
                            {
                                "target_lang_word": "серо-зелёный цвет",
                                "target_lang_sense_clarification": "оттенок патины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5172a8c-90e5-37e2-9f1c-0c71d0a99236",
                    "sense_definition": "A chemical compound consisting primarily of basic copper acetate, used as a pigment or fungicide.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the laboratory, the chemist prepared synthetic <w>verdigris</w> for the experiment.",
                            "target_lang_translations": {
                                "ru": "В лаборатории химик приготовил синтетическую <w>ярь-медянку</w> для эксперимента."
                            }
                        },
                        {
                            "text": "Traditional artists ground <w>verdigris</w> to make a brilliant green pigment.",
                            "target_lang_translations": {
                                "ru": "Художники прошлого растирали <w>ярь-медянку</w>, чтобы получить яркий зелёный пигмент."
                            }
                        }
                    ],
                    "synonyms": [
                        "Spanish green"
                    ],
                    "target_lang_definitions": {
                        "ru": "Химическое соединение, преимущественно основный ацетат меди, используемое в качестве пигмента или фунгицида."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ярь-медянка",
                                "target_lang_sense_clarification": "медный пигмент или реактив"
                            },
                            {
                                "target_lang_word": "медянка",
                                "target_lang_sense_clarification": "уксуснокислая медь"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "65f9fe48-4bb9-3cef-9a1b-12630c83cb9f",
                    "sense_definition": "To coat or cover with verdigris.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "patina",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The damp coastal air will slowly <w>verdigris</w> the copper pipes outside.",
                            "target_lang_translations": {
                                "ru": "Влажный прибрежный воздух будет медленно <w>покрывать патиной</w> медные трубы снаружи."
                            }
                        },
                        {
                            "text": "Decades of rain had begun to <w>verdigris</w> the ornate iron and bronze gates.",
                            "target_lang_translations": {
                                "ru": "Десятилетия дождей начали <w>покрывать зелёным налётом</w> кованые железные и бронзовые ворота."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрываться или покрывать слоем зелёного налёта (патины)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрывать патиной",
                                "target_lang_sense_clarification": "вызывать появление зелёного налёта"
                            },
                            {
                                "target_lang_word": "окислять",
                                "target_lang_sense_clarification": "медные поверхности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}