                "senses": [
                    {
                        "sense_id": "24e8d9d3-7fbe-3e61-96cc-01c4859716ef",
                        "entry_id": "0f191ad9-67eb-3d32-9d6a-ce1296facd35",
                        "glosses": [
                            "разг., фам. то же, что друг"
                        ],
                        "tags": [],
