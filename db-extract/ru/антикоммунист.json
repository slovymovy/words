                                        "examples": [
                                            {
                                                "example_id": "78057990-8785-4465-b618-62957a4efd37",
                                                "sense_id": "ff274d1a-e6c6-3cd5-b21c-7fd6e81ab9ad",
                                                "text": "– Vous êtes un anticommuniste, un saboteur, un agent de la réaction !"
                                            },
                                            {
                                                "example_id": "630d5e27-09e0-43e6-975f-225311507334",
                                                "sense_id": "ff274d1a-e6c6-3cd5-b21c-7fd6e81ab9ad",
                                                "text": "Les tactiques qu’utilise un anticommuniste aussi viscéral sont des plus intéressantes."
                                            }
