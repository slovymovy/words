                    {
                        "translation_id": "ebbeff6f-ef55-415b-b31b-e8c6094f4f2d",
                        "source_entry_id": "ccea26f6-3213-3e94-bf03-acd52cc50bcf",
                        "source_sense_id": "e4abc9d4-b61f-3c4a-81f5-47750096b42c",
                        "source_sense_description": "decoratieve pot die het zout bevat",
                        "target_lang_word": "salière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e38b465a-b30a-3e4b-9638-88e9f28de28a",
                                        "entry_id": "a9908f40-8ed7-34fc-aedd-fbb74121bb7b",
                                        "glosses": [
                                            "Récipient dans lequel on met le sel sur la table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9e40b1-621d-4db6-9f5d-98c32e0ce781",
                                                "sense_id": "e38b465a-b30a-3e4b-9638-88e9f28de28a",
                                                "text": "Salière de faïence, de cristal, d’argent."
                                            },
                                            {
                                                "example_id": "86f43f5f-a849-4b05-927b-59508efffae1",
                                                "sense_id": "e38b465a-b30a-3e4b-9638-88e9f28de28a",
                                                "text": "Le long du cordon des assiettes, l’armée des verres, les carafes d’eau et de vin, les petites salières, tout le cristal du service était mince et léger comme de la mousseline."
                                            },
                                            {
                                                "example_id": "56b69f30-b7df-41b2-8014-aca1a625fcf0",
                                                "sense_id": "e38b465a-b30a-3e4b-9638-88e9f28de28a",
                                                "text": "La salade manque de sel, et la salière n’est pas sur la table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4ffc358-6a69-371c-b292-783d27ba0ada",
                                        "entry_id": "a9908f40-8ed7-34fc-aedd-fbb74121bb7b",
                                        "glosses": [
                                            "Ustensile de cuisine, ordinairement de bois, où l’on met le sel et qu’on pend à la cheminée pour le tenir au sec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67710fe6-ca8e-4db2-8c06-355018c973f3",
                                                "sense_id": "c4ffc358-6a69-371c-b292-783d27ba0ada",
                                                "text": "Salière de bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b77fbb7a-7df7-3d6e-bccc-985f8faf1ece",
                                        "entry_id": "a9908f40-8ed7-34fc-aedd-fbb74121bb7b",
                                        "glosses": [
                                            "Creux que les humains ont quelquefois au dessus des clavicules."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9448828-e8b5-4468-96c0-5e6e01b5d92d",
                                                "sense_id": "b77fbb7a-7df7-3d6e-bccc-985f8faf1ece",
                                                "text": "Elle avait un cou de jeune fille, avec des salières au dessus des clavicules tendres, et la gorge, sous le linon, agitée par le rire et la gêne respiratoire, d'un mouvement irrégulier, court et ahanant, semblait frêle et jeune."
                                            },
                                            {
                                                "example_id": "c6f780f5-24d3-4c76-a2da-c736e3b0739a",
                                                "sense_id": "b77fbb7a-7df7-3d6e-bccc-985f8faf1ece",
                                                "text": "Et de grogner que ça la gênait, que ça agrandissait son décolleté, que, maintenant, on voyait ses salières."
                                            },
                                            {
                                                "example_id": "40a7fbd6-e09a-4286-9249-a8c85c83bbba",
                                                "sense_id": "b77fbb7a-7df7-3d6e-bccc-985f8faf1ece",
                                                "text": "« Je dois t’avertir qu’elle est un peu forte. Mais il vaut mieux ça que des salières. Et ça peut s’arranger avec l’âge. »"
                                            },
                                            {
                                                "example_id": "98709277-85d2-403b-a5cf-91f6d52fa14b",
                                                "sense_id": "b77fbb7a-7df7-3d6e-bccc-985f8faf1ece",
                                                "text": "Une étole d’hermine couvre les maigres épaules ; un peu plus bas que les salières qui pointent, un bouquet de violettes de Parme cache la poitrine plate sous son décolletage noyé de dentelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d67fc88-7524-3306-9cec-3b872bfbe242",
                                        "entry_id": "a9908f40-8ed7-34fc-aedd-fbb74121bb7b",
                                        "glosses": [
                                            "Creux qui se forme au-dessus des yeux des chevaux quand ils vieillissent."
                                        ],
                                        "tags": [
                                            "Hippologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0141fb4-aa87-4e03-82be-a14593528d12",
                                                "sense_id": "7d67fc88-7524-3306-9cec-3b872bfbe242",
                                                "text": "Une des choses les plus importantes à connaître, c'est l’âge du cheval ; les vieux chevaux ont ordinairement les salières creuses, mais cet indice est équivoque, puisque de jeunes chevaux, engendrés de vieux étalons, ont aussi les salières creuses."
                                            },
                                            {
                                                "example_id": "d95f6d9c-9159-406c-adbe-a94c0b85c102",
                                                "sense_id": "7d67fc88-7524-3306-9cec-3b872bfbe242",
                                                "text": "La salière enchâssant l’œil vitreux s’approfondissait de plus en plus et la joue maigre semblait disséquée."
                                            },
                                            {
                                                "example_id": "cc1eebb8-c522-4d30-821e-74a82a824b42",
                                                "sense_id": "7d67fc88-7524-3306-9cec-3b872bfbe242",
                                                "text": "Le maquignon de bas étage […] travaille les oreilles, souffle les salières, burine les dents, place une queue postiche, taille les sabots, mastique les seimes, donne un coup de pinceau, refait une jeunesse, farde, corrige, embellit ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21409fe0-da8c-3e01-b1b2-b82b1e3d391e",
                                        "entry_id": "a9908f40-8ed7-34fc-aedd-fbb74121bb7b",
                                        "glosses": [
                                            "Chez un bovidé, partie de l'épaule la plus proche du cou."
                                        ],
                                        "tags": [
                                            "Boucherie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
