                    {
                        "sense_id": "3b8c016a-8bff-3dd7-b65a-8b89382593bd",
                        "entry_id": "89edea1b-f52a-37cd-865e-e953eedf7f96",
                        "glosses": [
                            "kledingstuk voor het bovenlichaam met knoopjes aan de voorzijde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7da2b26-b2e7-4993-b090-1f56dfe4f625",
                                "sense_id": "3b8c016a-8bff-3dd7-b65a-8b89382593bd",
                                "text": "Onder enthousiast applaus komt Brooke Shields het toneel op. Iedereen buigt naar voren, uiterst benieuwd naar wat ze draagt. „Oh”, zegt de blonde vrouw naast me teleurgesteld en zakt weer terug. De hoog gesloten zwarte bloes, kaki rok en bruine laarzen zijn niet erg Hollywood. Als ze zit, bedekt ze kuis het kleine stukje blote knie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e83067d-e455-429f-8e69-b226f3ed196e",
                        "source_entry_id": "89edea1b-f52a-37cd-865e-e953eedf7f96",
                        "source_sense_id": "3b8c016a-8bff-3dd7-b65a-8b89382593bd",
                        "source_sense_description": "kledingstuk",
                        "target_lang_word": "Bluse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bluse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f57cdc2-752b-35a1-9e7d-42aa983d14c6",
                                        "entry_id": "9a63b29c-2526-3815-9efc-41cc8f27e1ec",
                                        "glosses": [
                                            "den Oberkörper bedeckendes, leichtes Kleidungsstück, vor allem für Damen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d576fa5b-edb7-480b-9bd6-a0116855b5cf",
                                                "sense_id": "1f57cdc2-752b-35a1-9e7d-42aa983d14c6",
                                                "text": "Zum seriösen dunklen Hosenanzug passt eine schlichte weiße Bluse."
                                            },
                                            {
                                                "example_id": "8aa68b81-bcf5-43b2-a677-8a8c3017b022",
                                                "sense_id": "1f57cdc2-752b-35a1-9e7d-42aa983d14c6",
                                                "text": "„Sie ist schwarz gekleidet, die Rockfalten bewegen sich fast nicht, die Bluse ist knapp und hat einen Kragen aus weißer kleinmaschiger Spitze.“"
                                            },
                                            {
                                                "example_id": "613a937d-6ac3-4f6e-a888-44c21ed3470a",
                                                "sense_id": "1f57cdc2-752b-35a1-9e7d-42aa983d14c6",
                                                "text": "„Normalerweise fangen Frauen beim Oberkörper an und legen als Erstes die Bluse ab.“"
                                            },
                                            {
                                                "example_id": "036ce099-421a-467a-9802-814b34b91783",
                                                "sense_id": "1f57cdc2-752b-35a1-9e7d-42aa983d14c6",
                                                "text": "„Die Bluse war tief ausgeschnitten.“"
                                            },
                                            {
                                                "example_id": "7ead9be2-110a-4401-9b55-5f882be18705",
                                                "sense_id": "1f57cdc2-752b-35a1-9e7d-42aa983d14c6",
                                                "text": "„Sie hatte die zu weite Bluse eingenäht, den Wollrock gekürzt und sich in einem Anfall von Übermut Seidenstrümpfe gekauft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
