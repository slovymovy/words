                        "examples": [
                            {
                                "example_id": "13731256-c939-4bc1-95b5-5c750de7919c",
                                "sense_id": "34441b06-4097-3bc4-ba38-3ccd7f289c01",
                                "text": "Knowing you don't like me but saying you do, telling lies / You flodging dogs!"
                            },
                            {
                                "example_id": "9d8d111c-f336-4793-8144-4311001c4a1c",
                                "sense_id": "34441b06-4097-3bc4-ba38-3ccd7f289c01",
                                "text": "Bossman: Tell me about it. At first, I thought you were flodging. / Dani M: flodging? / Bossman: It means lying. […]"
                            },
                            {
                                "example_id": "541f9e88-f2ba-4b4e-9f23-5e612daf703c",
                                "sense_id": "34441b06-4097-3bc4-ba38-3ccd7f289c01",
                                "text": "It's so many thotties shawty you ain't gotta flodge to me. Put that on god and lie to me[?] you make me sick"
                            },
                            {
                                "example_id": "a4be9dce-6767-470f-b27f-f9da1f36a8de",
                                "sense_id": "34441b06-4097-3bc4-ba38-3ccd7f289c01",
                                "text": "Never flodged on how I lived. Fight a nigga over a bitch."
                            }
                        ]
