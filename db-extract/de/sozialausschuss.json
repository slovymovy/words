                "senses": [
                    {
                        "sense_id": "aa931448-d061-3006-8aab-069eed0061a8",
                        "entry_id": "717e9fa6-a03b-3cca-bfd0-06335910a8d4",
                        "glosses": [
                            "Gremium bestehend aus einer Gruppe von Personen aus einem Parlament, die sich mit Themen/Gesetzen der Arbeit, sozialen Fragen, Kindern/Jugend und Familien beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d26e2c5-a459-4b72-b5b5-a7e9ba5dc348",
                                "sense_id": "aa931448-d061-3006-8aab-069eed0061a8",
                                "text": "„Was war am 2. Jul. 1921? – Der Sozialausschuss des Reichstags in Berlin legt neue Unterstützungssätze für junge Mütter fest.“"
                            },
                            {
                                "example_id": "09f66ac1-bf5c-47f8-9396-953025fa619d",
                                "sense_id": "aa931448-d061-3006-8aab-069eed0061a8",
                                "text": "„»Ich sitze im Sozialausschuss der Stadt und bin Sprecherin eines Demokratiebündnisses, das sich gegen Nazis und Rechtsextremismus einsetzt.«“"
                            },
                            {
                                "example_id": "44613180-201d-4a56-929b-ebe747e75034",
                                "sense_id": "aa931448-d061-3006-8aab-069eed0061a8",
                                "text": "„Philipp Schreiner geht am Sonntag für die SPD ins Rennen. Er will sich noch breiter engagieren. Fürs Jugendkomitee saß er bislang im Sozialausschuss der Stadt.“"
                            },
                            {
                                "example_id": "80117241-7e83-4a64-818a-c5f400ac1cca",
                                "sense_id": "aa931448-d061-3006-8aab-069eed0061a8",
                                "text": "[Coronapandemie 2022:] „Der Sozialausschuss des Landtages hat zum Thema \"Lockerungen\" am Montagvormittag Mediziner befragt.“"
                            },
                            {
                                "example_id": "91c5ce77-ffc8-4056-a148-56072fb20ee9",
                                "sense_id": "aa931448-d061-3006-8aab-069eed0061a8",
                                "text": "„In einem Bericht für den Sozialausschuss des Landtages kritisierte Trauernicht Vattenfall erneut scharf und warf dem Unternehmen falsche Angaben nach den Störfällen in den Reaktoren vor.“"
                            },
                            {
                                "example_id": "901bda6f-f958-4c70-9858-b7e2d166fdf8",
                                "sense_id": "aa931448-d061-3006-8aab-069eed0061a8",
                                "text": "„Bessere Reha-Maßnahmen und mehr Forschung: Die vier Fraktionen im Niedersächsischen Landtag wollen die Situation für Long-Covid-Patienten verbessern. Darauf haben sie sich im Sozialausschuss geeinigt.“"
                            },
                            {
                                "example_id": "98edb8cf-6ccc-4790-8e18-0540f8faf25d",
                                "sense_id": "aa931448-d061-3006-8aab-069eed0061a8",
                                "text": "[Rente für Getto-Arbeiter:] „Mit diesem Problem befasst sich heute der Sozialausschuss des Bundestages.“"
                            },
                            {
                                "example_id": "15769bcc-1229-42ac-baa4-2ff920d4578c",
                                "sense_id": "aa931448-d061-3006-8aab-069eed0061a8",
                                "text": "„In einer CDU, deren Sozialdemokratisierung unter Angela Merkel Fahrt aufnimmt, hört man im Zweifel lieber auf die Sozialausschüsse als auf die Industrieverbände.“"
                            },
                            {
                                "example_id": "ff2f3b11-55d0-4938-b9aa-cb789ed5f9a7",
                                "sense_id": "aa931448-d061-3006-8aab-069eed0061a8",
                                "text": "„Drei von vier Ungarn haben ein Einkommen, das nicht einmal die Hälfte des EU-Durchschnitts ausmacht. Das ergab kürzlich eine Anhörung vor dem Sozialausschuss des Parlaments im Auftrag der Internationalen Arbeitsorganisation ILO.“"
                            },
                            {
                                "example_id": "7309f2f0-7f4c-4b2b-9d3a-bcf4199536e5",
                                "sense_id": "aa931448-d061-3006-8aab-069eed0061a8",
                                "text": "[Abtreibungsgesetz in Polen:] […] „»Der Sozialausschuss sollte sich so schnell wie möglich mit dem Gesetz befassen, damit es in zweiter Lesung beschlossen werden kann.«“"
                            },
                            {
                                "example_id": "499515d1-8138-4464-9dcc-5dc5677173f9",
                                "sense_id": "aa931448-d061-3006-8aab-069eed0061a8",
                                "text": "„Was war am 16. Okt. 1966? – Der Sozialausschuss der Vereinten Nationen beschließt in New York gegen die Stimme Südafrikas, den 21. März fortan als \"Internationalen Tag der Abschaffung der Rassendiskriminierung\" zu begehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
