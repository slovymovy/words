{
    "word_family": [
        "knuppelen",
        "knuppelpad",
        "knuppelagent"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "18f72b70-51cb-3224-b43a-ffcb768d8b7a",
                    "sense_definition": "een korte, dikke stok die als wapen wordt gebruikt om mee te slaan",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "wapens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politieagent hield een houten <w>knuppel</w> in zijn hand tijdens de demonstratie.",
                            "target_lang_translations": {
                                "en": "The police officer held a wooden <w>baton</w> in his hand during the demonstration."
                            }
                        },
                        {
                            "text": "De bende kwam de straat in met <w>knuppels</w> en kettingen om de boel te vernielen.",
                            "target_lang_translations": {
                                "en": "The gang entered the street with <w>clubs</w> and chains to destroy everything."
                            }
                        }
                    ],
                    "synonyms": [
                        "stok",
                        "knods",
                        "wapenstok"
                    ],
                    "common_phrases": [
                        "houten knuppel",
                        "met een knuppel slaan"
                    ],
                    "target_lang_definitions": {
                        "en": "a short, thick stick used as a weapon for striking"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "club",
                                "target_lang_sense_clarification": "a heavy stick used as a weapon"
                            },
                            {
                                "target_lang_word": "baton",
                                "target_lang_sense_clarification": "a stick used by police"
                            },
                            {
                                "target_lang_word": "bludgeon",
                                "target_lang_sense_clarification": "a short, heavy club with one thicker end"
                            },
                            {
                                "target_lang_word": "cudgel",
                                "target_lang_sense_clarification": "a short, thick stick used as a weapon"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13cdd4f4-b1d5-3359-8521-2bf553585221",
                    "sense_definition": "een onhandig, lomp of dom persoon",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "persoonskenmerken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die grote <w>knuppel</w> liet per ongeluk al het servies op de grond vallen.",
                            "target_lang_translations": {
                                "en": "That big <w>oaf</w> accidentally dropped all the dishes on the floor."
                            }
                        },
                        {
                            "text": "Wat een <w>knuppel</w> is het ook, hij begrijpt de simpelste instructies niet.",
                            "target_lang_translations": {
                                "en": "What a <w>dunderhead</w> he is, he doesn't understand the simplest instructions."
                            }
                        }
                    ],
                    "synonyms": [
                        "labbekak",
                        "oen",
                        "lompard",
                        "kluns"
                    ],
                    "common_phrases": [
                        "onhandige knuppel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel en licht beledigend"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a clumsy, awkward, or foolish person"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clumsy oaf",
                                "target_lang_sense_clarification": "an awkward person"
                            },
                            {
                                "target_lang_word": "lout",
                                "target_lang_sense_clarification": "an aggressive or clumsy man"
                            },
                            {
                                "target_lang_word": "dunderhead",
                                "target_lang_sense_clarification": "a stupid person"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "665cfa3c-deb6-3170-85ba-36c11660be32",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>knuppelen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>knuppel</w> de palen in de grond om het hek stevig vast te zetten.",
                            "target_lang_translations": {
                                "en": "I <w>hammer</w> the poles into the ground to secure the fence firmly."
                            }
                        },
                        {
                            "text": "Als ik die oude methode gebruik, <w>knuppel</w> ik het hout tot het splijt.",
                            "target_lang_translations": {
                                "en": "When I use that old method, I <w>club</w> the wood until it splits."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm van het werkwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present tense of 'to club' or 'to hammer'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "club",
                                "target_lang_sense_clarification": "to hit with a heavy object"
                            },
                            {
                                "target_lang_word": "hammer",
                                "target_lang_sense_clarification": "to drive something in with force"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8366a34e-3d5c-3b8e-8926-0ddd9fe10bda",
                    "sense_definition": "de gebiedende wijs van <w>knuppelen</w>",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Knuppel</w> die haringen nu eens goed de grond in!",
                            "target_lang_translations": {
                                "en": "<w>Hammer</w> those pegs into the ground properly for once!"
                            }
                        },
                        {
                            "text": "Schiet op en <w>knuppel</w> die paaltjes vast voordat het donker wordt.",
                            "target_lang_translations": {
                                "en": "Hurry up and <w>hammer</w> those posts in before it gets dark."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative form of 'to club' or 'to hammer'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "club",
                                "target_lang_sense_clarification": "command to hit with a heavy object"
                            },
                            {
                                "target_lang_word": "hammer",
                                "target_lang_sense_clarification": "command to drive something in with force"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}