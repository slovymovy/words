                ],
                "senses": [
                    {
                        "sense_id": "942e1658-72b2-3eb3-856a-1fbd2eb9f25b",
                        "entry_id": "a0cfd899-a0ac-33c0-a6ee-e6020880a9e6",
                        "glosses": [
                            "Freude, Gefühl der Zufriedenheit, die jemand beim Wahrnehmen eines bestimmten Klangs (besonders Musik) empfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "868d5c1a-d916-4f08-aaf9-3c059e09d86c",
                                "sense_id": "942e1658-72b2-3eb3-856a-1fbd2eb9f25b",
                                "text": "„Zum Hörgenuss trägt die Produktion bei, die jedes Detail der Musik luftig, lupenklar und warm vermittelt.“"
                            },
                            {
                                "example_id": "35a27b31-3125-4128-b130-2921e2e012da",
                                "sense_id": "942e1658-72b2-3eb3-856a-1fbd2eb9f25b",
                                "text": "„Ein imposantes Lautsprechersystem verspricht Hörgenuss rundum.“"
                            },
                            {
                                "example_id": "5672cbfe-a8b2-4658-8f5c-25fe0fcd741d",
                                "sense_id": "942e1658-72b2-3eb3-856a-1fbd2eb9f25b",
                                "text": "„Und extra leichte Kopfhörer versprechen einen mehrstündigen Hörgenuss ohne Druckstellen.“"
                            },
                            {
                                "example_id": "8a4e9ac5-0f27-417a-ac76-439b1605afb7",
                                "sense_id": "942e1658-72b2-3eb3-856a-1fbd2eb9f25b",
                                "text": "„Großen Hörgenuss bringen Musik und Filme in vollen Mensen allerdings selten.“"
                            },
                            {
                                "example_id": "224b02a0-9564-4765-a2eb-caea47a5f910",
                                "sense_id": "942e1658-72b2-3eb3-856a-1fbd2eb9f25b",
                                "text": "„Der einfachste Weg zum Hörgenuss scheint noch immer der Kopfhörer im Ohr zu sein.“"
                            },
                            {
                                "example_id": "0a09b289-37c8-4689-b89a-36ba885c3110",
                                "sense_id": "942e1658-72b2-3eb3-856a-1fbd2eb9f25b",
                                "text": "„Die Besucher entdeckten beim Schlendern durch die Straßen und Gassen nicht nur allerlei Hörgenüsse, sondern bekämen so auch die Möglichkeit, ihre Stadt an manchen Ecken ganz neu zu entdecken.“"
                            },
                            {
                                "example_id": "e4d15c95-1fee-43a9-9629-d136a4fe1e6b",
                                "sense_id": "942e1658-72b2-3eb3-856a-1fbd2eb9f25b",
                                "text": "„‚The End Of An Ear‘ hielt auch, was es versprach: Es stieß im schöneren Sinn bis an die Grenze der gewohnten Hörgenüsse vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
