                    {
                        "sense_id": "990d8331-4e03-31a0-9728-d33805fad2b8",
                        "entry_id": "5e76fa38-74b3-36c0-9b70-7c0f0e95f9d4",
                        "glosses": [
                            "A hill or mountain."
                        ],
                        "tags": [
                            "South-Africa"
                        ],
                        "examples": [
                            {
                                "example_id": "691c7d87-1a65-45a2-995e-53d4cbb94495",
                                "sense_id": "990d8331-4e03-31a0-9728-d33805fad2b8",
                                "text": "[…] a zigzag line of Lee-Enfield flashes, and a charge which took the kop at a cost of ten casualties. The victors held the key to the Ladysmith lock."
                            },
                            {
                                "example_id": "c43839f2-1c3b-4d3e-9c48-45f90338e5a8",
                                "sense_id": "990d8331-4e03-31a0-9728-d33805fad2b8",
                                "text": "Within three hours, we took the kop. The dead and wounded were everywhere.\nThe Boers had taken the kop, collected their prisoners and had suffered very few casualties. However, they did not have the strength to hold the prisoners […]"
                            },
                            {
                                "example_id": "7d02302f-f42f-4e7b-bf0e-d5633965afcd",
                                "sense_id": "990d8331-4e03-31a0-9728-d33805fad2b8",
                                "text": "A party of burghers, under Commandant Nel, of Kroonstad, were ordered to station themselves on a kop with a flat top, called Swartbooiskop, an hour and a half to the south of Nicholson's Nek."
                            }
                        ]
                    }
                ],
