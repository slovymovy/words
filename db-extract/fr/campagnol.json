                "entry_id": "cc7197ef-c047-31b2-99e2-2a5553ca44ca",
                "word": "campagnol",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "45a71103-adf3-4ed3-a0df-6fdb72572473",
                        "entry_id": "cc7197ef-c047-31b2-99e2-2a5553ca44ca",
                        "tags": [
