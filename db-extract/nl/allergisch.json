                "senses": [
                    {
                        "sense_id": "023d029b-c27b-3f02-90c6-ed65d70d4fa8",
                        "entry_id": "c9528432-bdbf-356f-b9e8-411be2e502c1",
                        "glosses": [
                            "overgevoelig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe800847-06b9-42bc-95a3-2e4e6b53c6ae",
                                "sense_id": "023d029b-c27b-3f02-90c6-ed65d70d4fa8",
                                "text": "Hij is allergisch voor zuivelprodcuten."
                            },
                            {
                                "example_id": "1db91bdb-67f9-433f-b8e5-af55ad58d8a0",
                                "sense_id": "023d029b-c27b-3f02-90c6-ed65d70d4fa8",
                                "text": "Misschien ben ik allergisch voor de stof aan de binnenkant van mijn nieuwe bergschoenen?"
                            }
                        ]
                    },
                    {
                        "sense_id": "31f18bc1-a301-3c23-9f59-df83f35ead19",
                        "entry_id": "c9528432-bdbf-356f-b9e8-411be2e502c1",
                        "glosses": [
                            "van overgevoeligheid getuigend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d34c8713-ca45-4bcd-bba8-cd4265b323d8",
                                "sense_id": "31f18bc1-a301-3c23-9f59-df83f35ead19",
                                "text": "Een allergische reactie op medicijnen."
                            }
                        ]
                    },
                    {
                        "sense_id": "36660c99-f70c-3490-b781-0687e07f8601",
                        "entry_id": "c9528432-bdbf-356f-b9e8-411be2e502c1",
                        "glosses": [
                            "afkerig, wars"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a7d72f81-9044-47cb-a044-32dc7f7f7336",
                                "sense_id": "36660c99-f70c-3490-b781-0687e07f8601",
                                "text": "Ik ben allergisch voor dit gedrag."
                            },
                            {
                                "example_id": "b744449c-329b-496f-8830-32b7cc668a07",
                                "sense_id": "36660c99-f70c-3490-b781-0687e07f8601",
                                "text": "Over het algemeen was Harold allergisch voor mensen die zeiden dat ze schilderden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0de0ad9d-e542-4327-929e-d63bbe3498bb",
                        "source_entry_id": "c9528432-bdbf-356f-b9e8-411be2e502c1",
                        "source_sense_id": "023d029b-c27b-3f02-90c6-ed65d70d4fa8",
                        "source_sense_description": "overgevoelig",
                        "target_lang_word": "allergisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allergisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb13beb2-659d-3d5f-b34c-42ca72f82068",
                                        "entry_id": "a8a618d9-b6dd-3bb3-83fe-a9aa51210c63",
                                        "glosses": [
                                            "eine Überreaktion des menschlichen Körpers verursachend; eine Allergie hervorrufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cee36cbf-6f52-4bd4-9373-53b58aff6b20",
                                                "sense_id": "cb13beb2-659d-3d5f-b34c-42ca72f82068",
                                                "text": "„Ich reagiere allergisch auf einiges, was fliegt: Pollen von Bäumen, Gräsern und Getreide und Katzenhaare.“"
                                            },
                                            {
                                                "example_id": "6461b9e0-1069-4d12-a44d-0976939f8267",
                                                "sense_id": "cb13beb2-659d-3d5f-b34c-42ca72f82068",
                                                "text": "Verglichen mit anderen Lebensmitteln weisen insbesondere Erdnüsse ein sehr hohes allergisches Potential auf. Die Ursache dafür ist, dass Erdnüsse eine Vielzahl von Allergenen besitzen."
                                            },
                                            {
                                                "example_id": "fb184d68-7859-4da2-a51e-9193d88999da",
                                                "sense_id": "cb13beb2-659d-3d5f-b34c-42ca72f82068",
                                                "text": "Säuglinge mit Nahrungsmittelallergie (typische Symptome: Erbrechen, Durchfälle, atopische Dermatitis) „wachsen“ in den meisten Fällen bis zum 5. Lebensjahr aus dieser Allergieform „heraus“ und reagieren danach nicht mehr allergisch auf Nahrungsmittel."
                                            },
                                            {
                                                "example_id": "dd3c03b4-2e42-436e-b4dd-8dee0d120931",
                                                "sense_id": "cb13beb2-659d-3d5f-b34c-42ca72f82068",
                                                "text": "Ob Pollen, Tierhaare oder Hausstaub - viele Menschen reagieren auf bestimmte Stoffe allergisch. Dann tränen die Augen, der Gaumen juckt und der Hals schwillt an. Gerade im Frühling haben die meisten die Nase davon voll."
                                            },
                                            {
                                                "example_id": "527ce4a2-7552-422f-abb7-b0204f2af532",
                                                "sense_id": "cb13beb2-659d-3d5f-b34c-42ca72f82068",
                                                "text": "Allergien gegen Bienenstiche sind keine Seltenheit; vor allem Imker sind betroffen. Studien zufolge reagieren zwischen 14 und 49 Prozent aller Imker allergisch auf Bienengift."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19c41d3f-c3cd-3d3f-9c3d-9c989be5e66b",
                                        "entry_id": "a8a618d9-b6dd-3bb3-83fe-a9aa51210c63",
                                        "glosses": [
                                            "etwas absolut nicht leiden könnend, etwas absolut nicht ausstehen oder akzeptieren könnend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "766e732d-6a6d-444d-8d3f-045bb2dd2a77",
                                                "sense_id": "19c41d3f-c3cd-3d3f-9c3d-9c989be5e66b",
                                                "text": "„Ich bin allergisch gegen offene Zahnpastatuben. Wenn meine Kinder die so liegen lassen, dann gibt's Ärger!“"
                                            },
                                            {
                                                "example_id": "f9d51fb7-687b-46b1-93da-43bf26bd2988",
                                                "sense_id": "19c41d3f-c3cd-3d3f-9c3d-9c989be5e66b",
                                                "text": "„Mein Sohn sagt immer, dass er allergisch auf Hausaufgaben reagiert.“"
                                            },
                                            {
                                                "example_id": "b68c0d11-e54f-4154-9cf8-bff3e76487d4",
                                                "sense_id": "19c41d3f-c3cd-3d3f-9c3d-9c989be5e66b",
                                                "text": "„Eines kann ich bei einem Mann überhaupt nicht leiden: wenn er ungepflegt ist. Da reagiere ich allergisch drauf, den lasse ich stehen.“"
                                            },
                                            {
                                                "example_id": "0ec70138-f3f6-43dc-b820-30f0dcd723a9",
                                                "sense_id": "19c41d3f-c3cd-3d3f-9c3d-9c989be5e66b",
                                                "text": "[…] eines eint die Machthaber der arabischen Welt: Sie fürchten das Gelächter, sind allergisch gegen den Witz, der die etablierte Ordnung - und mit ihnen auch sie selbst – herausfordern könnte."
                                            },
                                            {
                                                "example_id": "52b59575-6c57-4d8c-a1e4-5694f3c54092",
                                                "sense_id": "19c41d3f-c3cd-3d3f-9c3d-9c989be5e66b",
                                                "text": "An der Hochschule habe er [Gerhard Lüdeker, Forscher an der Universität Bremen] die Erfahrung gemacht, dass Studenten immer weniger Interesse an dem Thema Nationalsozialismus zeigten. \"Die Reaktionen darauf fallen zum Teil sogar allergisch aus\", berichtet der Medienwissenschaftler."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
