                "translations": [
                    {
                        "translation_id": "7fd94192-6c59-425a-b9e0-88638bc07b6c",
                        "source_entry_id": "1b24d49e-b05c-3e91-9ee5-ce4b69707a68",
                        "source_sense_id": "6039cb4f-b7ee-38a7-8a44-bbfe23c77a03",
                        "target_lang_word": "Titelblatt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Titelblatt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f27d55a4-182c-3c98-9bcc-fc2cf0f9d679",
                                        "entry_id": "76191030-5518-3b25-8c7b-0e06ce11c818",
                                        "glosses": [
                                            "Blatt am Anfang eines Buches, auf dem (mindestens) Autor/Herausgeber und Titel aufgeführt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b98eb0f-76e1-4811-9498-536f776f0741",
                                                "sense_id": "f27d55a4-182c-3c98-9bcc-fc2cf0f9d679",
                                                "text": "„Es wäre doch eine nette Überraschung, wenn der Gatte als Stimulans für die Genesung das fertige Buch mit seinem Namen auf dem Titelblatt bald in Händen hätte.“"
                                            },
                                            {
                                                "example_id": "f37e416f-347a-4e24-bcf4-1450faff035b",
                                                "sense_id": "f27d55a4-182c-3c98-9bcc-fc2cf0f9d679",
                                                "text": "„Das Titelblatt dieser 1522 in Wittenberg herausgebrachten bilderstürmerischen Schrift ist geschmückt mit einem Bild.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5455be8b-4975-3fb6-bba0-5cd5a7025742",
                                        "entry_id": "76191030-5518-3b25-8c7b-0e06ce11c818",
                                        "glosses": [
                                            "erste Seite einer Broschüre, Zeitschrift, Zeitung … mit auffälligem Titel"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b850b51f-68e7-45b2-9b86-87d2ef18beb9",
                        "source_entry_id": "1b24d49e-b05c-3e91-9ee5-ce4b69707a68",
                        "source_sense_id": "6039cb4f-b7ee-38a7-8a44-bbfe23c77a03",
                        "target_lang_word": "Titelseite",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Titelseite",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29c81732-2dbb-3383-8fa1-4866e1a23a55",
                                        "entry_id": "228eb547-401a-3b5f-a4fe-9f36a10ecc18",
                                        "glosses": [
                                            "erste Seite einer Zeitschrift oder Zeitung, die den Titel enthält und oftmals auch den Hinweis auf die Hauptnachricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d7a5bf2-334d-4b3d-bcaf-d36a25122339",
                                                "sense_id": "29c81732-2dbb-3383-8fa1-4866e1a23a55",
                                                "text": "„Von den griechischen Titelseiten blickt mittlerweile nahezu jeden Tag die verkniffene Kanzlerin.“"
                                            },
                                            {
                                                "example_id": "cb401493-0e25-42c6-a876-87fd97829e8e",
                                                "sense_id": "29c81732-2dbb-3383-8fa1-4866e1a23a55",
                                                "text": "„Er zeigt ihr die Druckschrift des Reisebüros auf Hochglanzpapier mit einem pompösen Autobus auf der Titelseite.“"
                                            },
                                            {
                                                "example_id": "e27d5fe7-f6df-4fd2-a9c8-6d56fd493a63",
                                                "sense_id": "29c81732-2dbb-3383-8fa1-4866e1a23a55",
                                                "text": "„Die Schlagzeilen sind dick, die Titelseiten voll mit Artikeln über die schreckliche Scheidung zwischen Frankreich und Algerien, die in den letzten Zuckungen liegt.“"
                                            },
                                            {
                                                "example_id": "05840028-1c07-458a-8a48-1152049453d9",
                                                "sense_id": "29c81732-2dbb-3383-8fa1-4866e1a23a55",
                                                "text": "„Ich stehe auf, gehe zu den beiden Bücherschränken, um zu sehen, welche Bücher sie enthalten, doch mein Blick bleibt an der Titelseite der zuoberst auf dem Stapel liegenden Zeitschrift hängen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "087674ca-b243-3abd-b749-823d82dcfbc8",
                                        "entry_id": "228eb547-401a-3b5f-a4fe-9f36a10ecc18",
                                        "glosses": [
                                            "die Seite eines Buches, die unter anderem den Titel und den Autor nennt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c35f73aa-9a28-4c2f-9e3f-d980595b4b7c",
                                                "sense_id": "087674ca-b243-3abd-b749-823d82dcfbc8",
                                                "text": "Auf der Titelseite des Romans steht auch der herausgebende Verlag."
                                            },
                                            {
                                                "example_id": "9aba3199-d2d1-4c90-92f1-59eef12cf16f",
                                                "sense_id": "087674ca-b243-3abd-b749-823d82dcfbc8",
                                                "text": "„Die Frau ist wie ein Buch, von dem, ob gut oder schlecht, zunächst die Titelseite gefallen muß; bietet sie keinen Anreiz, so erweckt sie auch nicht die Lust zum Lesen, und diese Lust ist nur so stark wie das Interesse, das sie einflößt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
