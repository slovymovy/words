                    {
                        "sense_id": "96854dc2-0f54-3d0f-a44f-25906281fd5d",
                        "entry_id": "16cd612f-f4fc-34be-83cc-228f008d3834",
                        "glosses": [
                            "besonders gesicherter, gepanzerter Schrank, in dem Geld und andere Wertgegenstände aufbewahrt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77e4ab6b-0a25-44fc-b566-78428d12e46e",
                                "sense_id": "96854dc2-0f54-3d0f-a44f-25906281fd5d",
                                "text": "Die Einbrecher haben den Geldschrank aufgebrochen."
                            },
                            {
                                "example_id": "24089d83-4b73-4408-a18f-09d66e356473",
                                "sense_id": "96854dc2-0f54-3d0f-a44f-25906281fd5d",
                                "text": "„Gewöhnlich hat der Rittmeister den Schlüssel zu diesem Geldschrank und rückt nur vor jeder Löhnung oder sonstigen Ausgabe das nötige Geld heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c73cc533-bb11-4865-99c3-6ada8d69a5b6",
                        "source_entry_id": "16cd612f-f4fc-34be-83cc-228f008d3834",
                        "source_sense_id": "96854dc2-0f54-3d0f-a44f-25906281fd5d",
                        "source_sense_description": "besonders gesicherter, gepanzerter Schrank, in dem Geld und andere Wertgegenstände aufbewahrt werden",
                        "target_lang_word": "safe",
                        "target_lang_code": "en",
