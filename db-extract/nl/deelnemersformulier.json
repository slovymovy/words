                    {
                        "sense_id": "f2ce450e-033f-3db7-8023-6d711318def4",
                        "entry_id": "95d91516-36bf-32f3-8743-496b8594396b",
                        "glosses": [
                            "lijst waarop de namen staan van de deelnemers aan een bepaald evenement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b499e88-0efa-442e-841b-d0aab7db37bd",
                                "sense_id": "f2ce450e-033f-3db7-8023-6d711318def4",
                                "text": "Bij het mannentoernooi werd Robin Haase bij de loting gekoppeld aan het servicekanon Ivo Karlovic, die vorig jaar de finale verloor. Tallon Griekspoor, de tweede Nederlander op het deelnemersformulier, ontmoet de Griek Stefanos Tsitsipas."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa6785d1-e529-3bd9-97d4-daae249a3685",
                        "entry_id": "95d91516-36bf-32f3-8743-496b8594396b",
                        "glosses": [
                            "formulier waarop een deelnemer zijn of haar gegevens invult"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e60961b-cc4c-4acb-9f10-3049a3d02101",
                                "sense_id": "fa6785d1-e529-3bd9-97d4-daae249a3685",
                                "text": "Nog niet eerder had hij zoveel succes met de samenstelling van een team. „Ooit heb ik eens een dagklassement gewonnen, maar dat is echt al heel lang geleden. Ik kan mij nog herinneren dat je in het verleden een deelnemersformulier per post moest opsturen. Als je per ongeluk een verkeerd nummer had opgeschreven, dan zat je ineens vast aan een renner die minder goed was.”"
                            }
                        ]
                    }
