                                        "sense_id": "967a98fb-7a1a-3791-95b2-2fa57b7e22a3",
                                        "entry_id": "70b54f9b-6078-3d80-9a74-5768f43d27ba",
                                        "glosses": [
                                            "Gegend, die hauptsächlich zum Wohnen genutzt wird, also nicht gewerblich oder industriell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "531cea09-e54f-4c71-90b2-1c812dc96808",
                                                "sense_id": "967a98fb-7a1a-3791-95b2-2fa57b7e22a3",
                                                "text": "„Wie hoch ist die ortsübliche Miete, was zahlen andere Mieter in ähnlichen Objekten, ist das Viertel eine beliebte Wohngegend oder wechseln die Mieter dort sehr häufig? All diese Fragen muss der Käufer beantworten können, um die Vermietbarkeit der Immobilie realistisch einschätzen zu können.“"
                                            },
                                            {
                                                "example_id": "e28db95b-0cf8-4c9a-b07e-288a1a20a7ab",
                                                "sense_id": "967a98fb-7a1a-3791-95b2-2fa57b7e22a3",
                                                "text": "„Die eleganten Häuser in dieser Wohngegend lagen rechts und links jeweils etwa 100 Meter von der Anliegerstraße entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
