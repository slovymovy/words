            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bb08dd1c-c1eb-3689-8292-1c939bc012ee",
                    "sense_definition": "Provoquer de l'agacement, de l'énervement ou de la colère chez quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce bruit incessant finit par m'<w>irriter</w> profondément après une longue journée.",
                            "target_lang_translations": {
                                "en": "This incessant noise ends up <w>irritating</w> me deeply after a long day.",
                                "ru": "Этот непрерывный шум после долгого дня в конце концов сильно меня <w>раздражает</w>.",
                                "de": "Dieser unaufhörliche Lärm <w>ärgert</w> mich nach einem langen Tag schließlich zutiefst.",
                                "es": "Al final, este ruido incesante me <w>irrita</w> profundamente después de un largo día.",
                                "zh": "这种没完没了的噪音，忙碌了一整天之后，最终把我<w>惹恼</w>了。"
                            }
                        },
                        {
                            "text": "Ses remarques désobligeantes ont le don d'<w>irriter</w> tout le monde autour de la table.",
                            "target_lang_translations": {
                                "en": "His unkind remarks have a knack for <w>irritating</w> everyone around the table.",
                                "ru": "Его неприятные замечания умеют <w>раздражать</w> всех за столом.",
                                "de": "Seine abfälligen Bemerkungen haben die Gabe, alle am Tisch zu <w>ärgern</w>.",
                                "es": "Sus comentarios desagradables tienen el don de <w>irritar</w> a todo el mundo alrededor de la mesa.",
                                "zh": "他那些不中听的话总能<w>惹恼</w>桌边的每一个人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "agacer",
                        "énerver",
                        "exaspérer"
                    ],
                    "antonyms": [
                        "apaiser",
                        "calmer"
                    ],
                    "common_phrases": [
                        "irriter les esprits",
                        "irriter les nerfs"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause irritation, annoyance or anger in someone.",
                        "ru": "Вызывать раздражение, досаду или гнев у кого-либо.",
                        "de": "Bei jemandem Ärger, Gereiztheit oder Wut hervorrufen.",
                        "es": "Causar enfado, molestia o ira en alguien.",
                        "zh": "使人感到烦躁、恼火或愤怒。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "annoy",
                                "target_lang_sense_clarification": "everyday, mild irritation"
                            },
                            {
                                "target_lang_word": "irritate",
                                "target_lang_sense_clarification": "getting on someone's nerves"
                            },
                            {
                                "target_lang_word": "exasperate",
                                "target_lang_sense_clarification": "extreme frustration, patience exhausted"
                            }
                        ],
                        "ru": [
