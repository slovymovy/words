                "senses": [
                    {
                        "sense_id": "17062589-b977-3d01-91f0-41a40f08325e",
                        "entry_id": "991c684e-db50-3f53-950c-5f514b4059ac",
                        "glosses": [
                            "Gruppe von Menschen, die gemeinsam an einer Jagd teilnehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb22c505-f6ca-497b-86c6-7475418c13c4",
                                "sense_id": "17062589-b977-3d01-91f0-41a40f08325e",
                                "text": "„Eine europäische Gräfin gerät mit ihrer piekfeinen Jagdgesellschaft in ein Apachen-Reservat.“"
                            },
                            {
                                "example_id": "0abde2ab-fc60-402c-988f-d21865679e98",
                                "sense_id": "17062589-b977-3d01-91f0-41a40f08325e",
                                "text": "„Nach einer Stunde war die ganze Jagdgesellschaft vor der Freitreppe versammelt.“"
                            },
                            {
                                "example_id": "296e9b25-7d1f-4d9c-90a0-2433636b1ed7",
                                "sense_id": "17062589-b977-3d01-91f0-41a40f08325e",
                                "text": "„Wir sind eine Jagdgesellschaft, und wir jagen nach Fett.“"
                            },
                            {
                                "example_id": "9a92ca50-b6dd-4a95-8578-33fd525cefa9",
                                "sense_id": "17062589-b977-3d01-91f0-41a40f08325e",
                                "text": "„Pencroff lud sich die Beute auf die Schultern und ließ die Jagdgesellschaft kehrtmachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4f81fc34-fef5-3e4c-aab7-352582821f62",
                        "entry_id": "991c684e-db50-3f53-950c-5f514b4059ac",
                        "glosses": [
                            "Verein von Jägern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e832347-85d1-4aca-87b6-07e110c9929a",
                                "sense_id": "4f81fc34-fef5-3e4c-aab7-352582821f62",
                                "text": "„In der Regel entsprechen die Jagdreviere den Gemeindegebieten, in welchen von den politischen Gemeinden das Jagdrecht über einen Zeitraum von acht Jahren an eine Jagdgesellschaft verpachtet wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
