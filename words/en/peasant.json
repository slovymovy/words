{
    "word_family": [
        "peasantry",
        "peasantlike"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fca09ee1-58c6-304d-aed9-411501d21987",
                    "sense_definition": "A member of a low social class who works on the land, such as a small farmer or agricultural laborer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "agricultural_worker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>peasant</w> worked from dawn until dusk to harvest the wheat.",
                            "target_lang_translations": {
                                "ru": "Местный <w>крестьянин</w> работал от рассвета до заката, чтобы собрать урожай пшеницы.",
                                "de": "Der örtliche <w>Bauer</w> arbeitete von Sonnenaufgang bis Sonnenuntergang, um den Weizen zu ernten.",
                                "pl": "Miejscowy <w>chłop</w> pracował od świtu do zmierzchu, by zebrać pszenicę."
                            }
                        },
                        {
                            "text": "In many historical societies, the <w>peasant</w> class formed the backbone of the economy.",
                            "target_lang_translations": {
                                "ru": "Во многих исторических обществах <w>крестьянское</w> сословие составляло основу экономики.",
                                "de": "In vielen historischen Gesellschaften bildete der <w>Bauernstand</w> das Rückgrat der Wirtschaft.",
                                "pl": "W wielu historycznych społeczeństwach warstwa <w>chłopska</w> stanowiła fundament gospodarki."
                            }
                        }
                    ],
                    "synonyms": [
                        "serf",
                        "rustic",
                        "peon"
                    ],
                    "antonyms": [
                        "noble",
                        "aristocrat"
                    ],
                    "common_phrases": [
                        "peasant class",
                        "poor peasant",
                        "local peasant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель низшего социального класса, работающий на земле, например, мелкий фермер или сельскохозяйственный рабочий.",
                        "de": "Ein Mitglied einer niedrigen sozialen Schicht, das auf dem Land arbeitet, wie ein Kleinbauer oder ein landwirtschaftlicher Arbeiter.",
                        "pl": "Członek niższej warstwy społecznej pracujący na roli, np. drobny rolnik lub pracownik rolny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крестьянин",
                                "target_lang_sense_clarification": "человек, занимающийся сельским трудом"
                            },
                            {
                                "target_lang_word": "мужик",
                                "target_lang_sense_clarification": "историческое название простолюдина-крестьянина"
                            },
                            {
                                "target_lang_word": "селянин",
                                "target_lang_sense_clarification": "устаревшее обозначение сельского жителя"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Bauer",
                                "target_lang_sense_clarification": "jemand, der Ackerbau oder Viehhaltung betreibt"
                            },
                            {
                                "target_lang_word": "Kleinbauer",
                                "target_lang_sense_clarification": "Bauer mit einem kleinen landwirtschaftlichen Betrieb"
                            },
                            {
                                "target_lang_word": "Landmann",
                                "target_lang_sense_clarification": "veraltete Bezeichnung für einen Bauern"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "chłop",
                                "target_lang_sense_clarification": "członek warstwy społecznej chłopstwa"
                            },
                            {
                                "target_lang_word": "rolnik",
                                "target_lang_sense_clarification": "osoba zajmująca się rolnictwem"
                            },
                            {
                                "target_lang_word": "włościanin",
                                "target_lang_sense_clarification": "określenie mieszkańca wsi (często historyczne)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90dfb5ed-a36a-3bb0-a0ec-bc5dd686c9a4",
                    "sense_definition": "A person who lives in the country or a rural area.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rural_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a simple <w>peasant</w> who had never traveled beyond his village.",
                            "target_lang_translations": {
                                "ru": "Он был простым <w>селянином</w>, который никогда не выезжал за пределы своей деревни.",
                                "de": "Er war ein einfacher <w>Landbewohner</w>, der nie über sein Dorf hinaus gereist war.",
                                "pl": "Był prostym <w>wieśniakiem</w>, który nigdy nie wyjeżdżał poza swoją wieś."
                            }
                        },
                        {
                            "text": "The city dwellers often looked down upon the humble <w>peasant</w> from the hills.",
                            "target_lang_translations": {
                                "ru": "Горожане часто свысока смотрели на скромного <w>крестьянина</w> с холмов.",
                                "de": "Die Stadtbewohner blickten oft auf den bescheidenen <w>Bauern</w> aus den Hügeln herab.",
                                "pl": "Mieszczanie często patrzyli z góry na skromnego <w>wieśniaka</w> z gór."
                            }
                        }
                    ],
                    "synonyms": [
                        "villager",
                        "rustic",
                        "countryman"
                    ],
                    "antonyms": [
                        "townie",
                        "city-dweller"
                    ],
                    "common_phrases": [
                        "simple peasant",
                        "country peasant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, живущий в сельской местности или в деревне.",
                        "de": "Eine Person, die auf dem Land oder in einer ländlichen Gegend lebt.",
                        "pl": "Osoba mieszkająca na wsi lub na obszarach wiejskich."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сельский житель",
                                "target_lang_sense_clarification": "человек, проживающий в деревне"
                            },
                            {
                                "target_lang_word": "крестьянин",
                                "target_lang_sense_clarification": "житель деревни"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Landbewohner",
                                "target_lang_sense_clarification": "Person, die auf dem Land lebt"
                            },
                            {
                                "target_lang_word": "Dorfbewohner",
                                "target_lang_sense_clarification": "Einwohner eines Dorfes"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wieśniak",
                                "target_lang_sense_clarification": "człowiek mieszkający na wsi"
                            },
                            {
                                "target_lang_word": "mieszkaniec wsi",
                                "target_lang_sense_clarification": "osoba zamieszkująca tereny wiejskie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fcef095-04ac-3ce5-b3bb-ae6312e729b8",
                    "sense_definition": "An uncouth, crude, or ill-bred person who lacks social polish.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "uncouth_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop eating with your hands like a <w>peasant</w> and use your fork.",
                            "target_lang_translations": {
                                "ru": "Перестань есть руками как <w>деревенщина</w>, пользуйся вилкой.",
                                "de": "Hör auf, wie ein <w>Bauerntrampel</w> mit den Händen zu essen, und benutze deine Gabel.",
                                "pl": "Przestań jeść rękami jak <w>wieśniak</w> i użyj widelca."
                            }
                        },
                        {
                            "text": "The wealthy businessman dismissed his critics as uneducated <w>peasants</w>.",
                            "target_lang_translations": {
                                "ru": "Богатый бизнесмен отмахнулся от своих критиков, назвав их необразованными <w>мужланами</w>.",
                                "de": "Der reiche Geschäftsmann tat seine Kritiker als ungebildete <w>Proleten</w> ab.",
                                "pl": "Bogaty biznesmen zbył swoich krytyków, nazywając ich niewykształconymi <w>prostakami</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "boor",
                        "yokel",
                        "churl",
                        "clodhopper"
                    ],
                    "antonyms": [
                        "gentleman"
                    ],
                    "common_phrases": [
                        "ignorant peasant",
                        "uneducated peasant"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as an insult"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубый, неотесанный или невоспитанный человек, которому не хватает манер.",
                        "de": "Eine ungehobelte, grobe oder ungebildete Person, der es an sozialen Umgangsformen mangelt.",
                        "pl": "Osoba nieokrzesana, prymitywna lub źle wychowana, której brakuje ogłady."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деревенщина",
                                "target_lang_sense_clarification": "пренебрежительное обозначение неотесанного человека"
                            },
                            {
                                "target_lang_word": "мужлан",
                                "target_lang_sense_clarification": "грубый, невежественный человек"
                            },
                            {
                                "target_lang_word": "невежа",
                                "target_lang_sense_clarification": "человек, не знающий правил приличия"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Bauerntrampel",
                                "target_lang_sense_clarification": "abwertend für eine dümmliche, hinterwäldlerische Person"
                            },
                            {
                                "target_lang_word": "Rüpel",
                                "target_lang_sense_clarification": "Person, die sich schlecht benimmt"
                            },
                            {
                                "target_lang_word": "Prolet",
                                "target_lang_sense_clarification": "abwertend für einen ungehobelten, ungebildeten Menschen"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wieśniak",
                                "target_lang_sense_clarification": "pejoratywne określenie prostaka"
                            },
                            {
                                "target_lang_word": "prostak",
                                "target_lang_sense_clarification": "człowiek prymitywny, niekulturalny"
                            },
                            {
                                "target_lang_word": "cham",
                                "target_lang_sense_clarification": "osoba grubiańska, niekulturalna"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be50687d-13de-3a30-9289-5ccd1d25b25e",
                    "sense_definition": "Relating to or characteristic of people who work the land; simple or unsophisticated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "peasant_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a hearty <w>peasant</w> dish made of simple root vegetables.",
                            "target_lang_translations": {
                                "ru": "Нам понравилось сытное <w>крестьянское</w> блюдо из простых корнеплодов.",
                                "de": "Wir genossen ein herzhaftes <w>bäuerliches</w> Gericht aus einfachem Wurzelgemüse.",
                                "pl": "Zjedliśmy sycące <w>chłopskie</w> danie z prostych warzyw korzeniowych."
                            }
                        },
                        {
                            "text": "The fashion designer was inspired by traditional <w>peasant</w> clothing from Eastern Europe.",
                            "target_lang_translations": {
                                "ru": "Модельер черпал вдохновение в традиционной <w>крестьянской</w> одежде из Восточной Европы.",
                                "de": "Der Modedesigner ließ sich von traditioneller <w>bäuerlicher</w> Kleidung aus Osteuropa inspirieren.",
                                "pl": "Projektant mody inspirował się tradycyjnym <w>chłopskim</w> strojem z Europy Wschodniej."
                            }
                        }
                    ],
                    "synonyms": [
                        "rustic",
                        "bucolic",
                        "unsophisticated"
                    ],
                    "antonyms": [
                        "sophisticated",
                        "refined"
                    ],
                    "common_phrases": [
                        "peasant dish",
                        "peasant blouse",
                        "peasant food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к людям, работающим на земле, или характерный для них; простой или бесхитростный.",
                        "de": "Bezieht sich auf Menschen, die auf dem Land arbeiten, oder ist für sie charakteristisch; einfach oder schlicht.",
                        "pl": "Związany z ludźmi pracującymi na roli lub dla nich charakterystyczny; prosty, nieskomplikowany."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крестьянский",
                                "target_lang_sense_clarification": "относящийся к быту или сословию крестьян"
                            },
                            {
                                "target_lang_word": "деревенский",
                                "target_lang_sense_clarification": "простой, сельский стиль"
                            },
                            {
                                "target_lang_word": "простецкий",
                                "target_lang_sense_clarification": "незамысловатый, грубый"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bäuerlich",
                                "target_lang_sense_clarification": "den Bauernstand oder das Landleben betreffend"
                            },
                            {
                                "target_lang_word": "ländlich",
                                "target_lang_sense_clarification": "einfach, schlicht, auf das Land bezogen"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "chłopski",
                                "target_lang_sense_clarification": "dotyczący chłopów lub ich stylu życia"
                            },
                            {
                                "target_lang_word": "wiejski",
                                "target_lang_sense_clarification": "charakterystyczny dla wsi, prosty"
                            },
                            {
                                "target_lang_word": "prosty",
                                "target_lang_sense_clarification": "nieskomplikowany, surowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0ce2d34-1e87-3a01-9693-08dc1d2abe98",
                    "sense_definition": "Lowly, vulgar, or lacking in moral principles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "moral_judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt like a <w>peasant</w> slave, trapped by his own dishonest choices.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>рабской</w> душой, оказавшись в ловушке собственного нечестного выбора.",
                                "de": "Er fühlte sich wie ein <w>niedriger</w> Sklave, gefangen in seinen eigenen unehrlichen Entscheidungen.",
                                "pl": "Czuł się jak <w>podły</w> niewolnik, uwięziony przez własne nieuczciwe wybory."
                            }
                        },
                        {
                            "text": "The play depicts the <w>peasant</w> behavior of those who betray their friends for money.",
                            "target_lang_translations": {
                                "ru": "Пьеса изображает <w>низкое</w> поведение тех, кто предает своих друзей ради денег.",
                                "de": "Das Stück stellt das <w>niedrige</w> Verhalten derer dar, die ihre Freunde für Geld verraten.",
                                "pl": "Sztuka ukazuje <w>podłe</w> zachowanie tych, którzy zdradzają przyjaciół dla pieniędzy."
                            }
                        }
                    ],
                    "synonyms": [
                        "vulgar",
                        "base",
                        "lowly"
                    ],
                    "antonyms": [
                        "noble",
                        "honorable"
                    ],
                    "common_phrases": [
                        "peasant slave"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to denote low moral status"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Низменный, вульгарный или лишенный моральных принципов.",
                        "de": "Niedrig, vulgär oder ohne moralische Prinzipien.",
                        "pl": "Niski, wulgarny lub pozbawiony zasad moralnych."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рабский",
                                "target_lang_sense_clarification": "низменный, лишенный достоинства"
                            },
                            {
                                "target_lang_word": "подлый",
                                "target_lang_sense_clarification": "низкий по происхождению или духу (архаичное)"
                            },
                            {
                                "target_lang_word": "вульгарный",
                                "target_lang_sense_clarification": "грубый и низменный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "niedrig",
                                "target_lang_sense_clarification": "moralisch minderwertig"
                            },
                            {
                                "target_lang_word": "vulgär",
                                "target_lang_sense_clarification": "grob, unfein"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "podły",
                                "target_lang_sense_clarification": "moralnie niski, niegodziwy"
                            },
                            {
                                "target_lang_word": "niskiego stanu",
                                "target_lang_sense_clarification": "o niskim pochodzeniu lub charakterze"
                            },
                            {
                                "target_lang_word": "wulgarny",
                                "target_lang_sense_clarification": "grubiański, nieprzyzwoity"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}