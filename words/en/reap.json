{
    "word_family": [
        "reaper",
        "reaping"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eb795fad-b549-3788-9909-395aa5127adb",
                    "sense_definition": "To obtain or receive something as a result of one's own or others' previous actions, whether good or bad.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consequences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you work hard now, you will <w>reap</w> the benefits of your efforts later in life.",
                            "target_lang_translations": {
                                "ru": "Если вы будете усердно работать сейчас, вы будете <w>пожинать</w> плоды своих усилий позже в жизни."
                            }
                        },
                        {
                            "text": "The company's decision to invest in new technology <w>reaped</w> a rich reward within just one year.",
                            "target_lang_translations": {
                                "ru": "Решение компании инвестировать в новые технологии <w>принесло</w> богатые плоды всего за один год."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reap a reward",
                        "reap the benefits",
                        "reap what you sow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать что-либо (плоды, выгоду, последствия) как результат своих или чужих прошлых действий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пожинать",
                                "target_lang_sense_clarification": "результаты или плоды труда"
                            },
                            {
                                "target_lang_word": "получать",
                                "target_lang_sense_clarification": "выгоду или вознаграждение"
                            },
                            {
                                "target_lang_word": "извлекать",
                                "target_lang_sense_clarification": "пользу или уроки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fb49391-06f4-3a28-92ee-db94289152da",
                    "sense_definition": "To cut and gather a crop, such as grain, from a field during harvest time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers began to <w>reap</w> the wheat as soon as the sun rose over the horizon.",
                            "target_lang_translations": {
                                "ru": "Фермеры начали <w>жать</w> пшеницу, как только солнце взошло над горизонтом."
                            }
                        },
                        {
                            "text": "In the past, workers would <w>reap</w> the harvest by hand using sharp sickles.",
                            "target_lang_translations": {
                                "ru": "В прошлом рабочие <w>собирали</w> урожай вручную, используя острые серпы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reap the harvest",
                        "reap the grain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Срезать и собирать урожай (зерновые) в поле во время жатвы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жать",
                                "target_lang_sense_clarification": "срезать зерновые серпом или машиной"
                            },
                            {
                                "target_lang_word": "снимать",
                                "target_lang_sense_clarification": "собирать урожай"
                            },
                            {
                                "target_lang_word": "убирать",
                                "target_lang_sense_clarification": "урожай с поля"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d35d51e6-63a7-3829-9f99-054125fc805c",
                    "sense_definition": "To terminate a child process that has already finished executing, removing its entry from the system's process table.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The operating system must <w>reap</w> the child process to prevent it from becoming a zombie.",
                            "target_lang_translations": {
                                "ru": "Операционная система должна <w>завершить</w> дочерний процесс, чтобы он не превратился в зомби."
                            }
                        },
                        {
                            "text": "If the parent fails to <w>reap</w> its children, the process table may eventually fill up.",
                            "target_lang_translations": {
                                "ru": "Если родительский процесс не <w>обработает</w> свои дочерние процессы, таблица процессов может со временем переполниться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reap a process",
                        "reap child processes"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Завершать дочерний процесс, который уже закончил выполнение, удаляя его запись из таблицы процессов системы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завершать",
                                "target_lang_sense_clarification": "обработку дочернего процесса"
                            },
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "записи о процессах-зомби"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0440b17f-1789-3bea-8f6d-c5249a357e02",
                    "sense_definition": "To shave or remove hair from the face; to deprive of a beard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grooming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nobleman appeared with his chin newly <w>reapt</w>, looking fresh and well-groomed for the wedding.",
                            "target_lang_translations": {
                                "ru": "Дворянин явился со свеже<w>бритым</w> подбородком, выглядя свежим и ухоженным для свадьбы."
                            }
                        },
                        {
                            "text": "He chose to <w>reap</w> his beard before attending the formal royal banquet.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>сбрить</w> бороду перед посещением официального королевского банкета."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Брить или удалять волосы с лица; лишать бороды (архаичное/литературное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брить",
                                "target_lang_sense_clarification": "удалять бороду"
                            },
                            {
                                "target_lang_word": "сбривать",
                                "target_lang_sense_clarification": "растительность на лице"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2cf7e841-d0da-3138-a751-c400524de61e",
                    "sense_definition": "A small bundle or handful of grain that has been cut and laid down.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worker gathered each <w>reap</w> of wheat and tied them together into a larger bundle.",
                            "target_lang_translations": {
                                "ru": "Рабочий собрал каждую <w>охапку</w> пшеницы и связал их вместе в большой сноп."
                            }
                        },
                        {
                            "text": "He left a single <w>reap</w> on the ground as he moved to the next section of the field.",
                            "target_lang_translations": {
                                "ru": "Он оставил один <w>пучок</w> на земле, переходя к следующему участку поля."
                            }
                        }
                    ],
                    "synonyms": [
                        "sheaf"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "dialectal agricultural term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая охапка или пучок срезанного зерна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сноп",
                                "target_lang_sense_clarification": "связка срезанных стеблей"
                            },
                            {
                                "target_lang_word": "охапка",
                                "target_lang_sense_clarification": "небольшое количество зерна"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}