                                "sense_id": "010654a4-c339-31a0-a8a0-a683f864fd49",
                                "text": "„Der neue Landespolizeipräsident in Baden-Württemberg will Tätowierungen, Piercings und Ohrringe an Polizisten verbieten.“"
                            },
                            {
                                "example_id": "642e4022-12d6-43c3-9266-587101e6a126",
                                "sense_id": "010654a4-c339-31a0-a8a0-a683f864fd49",
                                "text": "„Landespolizeipräsident Binias legt aus Ärger über die eigene Partei sein Amt nieder.“"
                            },
                            {
                                "example_id": "152531a9-c390-4ab5-ac34-f5a7b3a45710",
                                "sense_id": "010654a4-c339-31a0-a8a0-a683f864fd49",
                                "text": "„Er sei von Landespolizeipräsident Udo Münch in den routinemäßigen Sitzungen grundsätzlich über den Prozess der Vergabe informiert worden, erklärte Beuth.“"
                            }
