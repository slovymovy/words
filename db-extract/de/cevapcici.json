                                "target_senses": [
                                    {
                                        "sense_id": "6740a4d8-613c-36bc-9a6a-e239eb5468ba",
                                        "entry_id": "f3a19377-59af-3841-90eb-ce3b6f7ebf92",
                                        "glosses": [
                                            "кулин. блюдо народов Балканского полуострова, жареные колбаски из перемолотого мяса с луком и приправами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b05185c-cc20-4f97-923f-9ac3b85fd799",
                                                "sense_id": "6740a4d8-613c-36bc-9a6a-e239eb5468ba",
                                                "text": "В стремительной последовательности перед нами сменялись на столе солёный овечий сыр, горячая острая лапша, пита — слоёный пирог со шпинатом, чевапчичи — жаренные на углях говяжьи колбаски, обильно посыпанные репчатым луком."
                                            },
                                            {
                                                "example_id": "f9cebb93-6705-41ca-9736-4c3ed5881561",
                                                "sense_id": "6740a4d8-613c-36bc-9a6a-e239eb5468ba",
                                                "text": "Чевапчичи подают с большим количеством нарезанного кольцами лука и свежим белым хлебом (питой)."
                                            }
                                        ]
