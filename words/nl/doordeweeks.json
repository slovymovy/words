                    "sense_id": "8a2e8246-bd71-397f-85fb-58ad18f8b793",
                    "sense_definition": "op dagen die binnen de werkweek vallen (maandag tot en met vrijdag)",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet <w>doordeweeks</w> altijd vroeg opstaan om naar mijn werk te gaan.",
                            "target_lang_translations": {
                                "en": "I always have to get up early <w>during the week</w> to go to work.",
                                "pl": "Muszę <w>w tygodniu</w> zawsze wcześnie wstawać, żeby iść do pracy."
                            }
                        },
                        {
                            "text": "Hij eet <w>doordeweeks</w> meestal heel gezond, maar in het weekend snoept hij veel.",
                            "target_lang_translations": {
                                "en": "He usually eats very healthily <w>on weekdays</w>, but he eats a lot of sweets on the weekend.",
                                "pl": "On je <w>w dni powszednie</w> zazwyczaj bardzo zdrowo, ale w weekendy je dużo słodyczy."
                            }
                        }
                    ],
                    "synonyms": [
                        "op werkdagen"
                    ],
                    "antonyms": [
                        "'s weekends"
                    ],
                    "common_phrases": [
                        "gewoon doordeweeks"
                    ],
                    "target_lang_definitions": {
                        "en": "on days that fall within the work week (Monday through Friday)",
                        "pl": "w dniach przypadających na tydzień roboczy (od poniedziałku do piątku)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "during the week",
