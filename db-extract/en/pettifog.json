                        "glosses": [
                            "To quibble over trivial matters; nitpick."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7111e793-982e-400d-a3e0-a4269cafc16f",
                                "sense_id": "215c1dbd-f328-3bbc-8ff7-6e0f938ab144",
                                "text": "Don't pettifog or we will soon grow weary."
                            },
                            {
                                "example_id": "d55370ca-5adf-495d-b5fe-aef8ef7af388",
                                "sense_id": "215c1dbd-f328-3bbc-8ff7-6e0f938ab144",
                                "text": "[Deacon Mushrat to Pogo:] The Machiavellian barratry of a pettifogging public has maundered into do-nothingism."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad9adb53-c163-36b4-938f-5f5db49c95f3",
                        "entry_id": "419a5b79-628a-3bca-b1d2-f007400e490c",
                        "glosses": [
                            "To do a petty business as a lawyer, or carry out law business in a petty or tricky way."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3933919a-3ca1-451f-80af-19091f02972c",
                                "sense_id": "ad9adb53-c163-36b4-938f-5f5db49c95f3",
                                "text": "He is a common barreter for his pleasure, that takes no money, but pettifogs gratis."
                            }
                        ]
                    }
