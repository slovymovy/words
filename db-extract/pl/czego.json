                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f69447b6-13a0-433c-b185-28290c260cdf",
                                                "sense_id": "100ca17b-3fcf-3735-a240-86db71440f55",
                                                "text": "Wir wissen nicht, weshalb Franz sich so entschieden hat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "weshalb",
