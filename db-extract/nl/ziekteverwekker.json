        "nl-extract.jsonl": [
            {
                "entry_id": "272de240-176a-3c8b-b008-c519df155e48",
                "word": "ziekteverwekker",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "5fa2619f-5122-41aa-b299-0175b09c4ee1",
                        "entry_id": "272de240-176a-3c8b-b008-c519df155e48",
                        "tags": [
