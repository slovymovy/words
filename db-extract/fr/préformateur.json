                    {
                        "sense_id": "0f7a1dfe-45d2-3112-8517-8d478e3b4958",
                        "entry_id": "2ff82632-5b76-3768-b088-e5d68f2b1753",
                        "glosses": [
                            "Personne dont le rôle est de déterminer quels partis politiques formeront une coalition pour former un gouvernement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80344ae5-7a73-44f7-8f54-a80fb7036c74",
                                "sense_id": "0f7a1dfe-45d2-3112-8517-8d478e3b4958",
                                "text": "Le Roi a reçu Bart De Wever (N-VA) et Paul Magnette (PS) pendant une petite heure samedi après-midi. Sans surprise, il a prolongé la mission des deux préformateurs jusqu’au 17 août."
                            },
                            {
                                "example_id": "09c94913-910a-4518-839d-566b811816e8",
                                "sense_id": "0f7a1dfe-45d2-3112-8517-8d478e3b4958",
                                "text": "Le préformateur Elio Di Rupo poursuit ses rencontres à un rythme soutenu. Différents présidents de partis, notamment ceux du SP.A, du CD&V et d’Ecolo, ont été reçus ce mercredi."
                            }
                        ]
                    }
