                    {
                        "sense_id": "4aaa48d2-195d-382a-a7f8-9f065723e7fa",
                        "entry_id": "75ae3eb7-642b-3cf0-a409-2e8e4ede0648",
                        "glosses": [
                            "Relatif à la cordillère des Andes."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "06163925-0de1-3f57-a668-25f2fdbf305e",
                        "entry_id": "75ae3eb7-642b-3cf0-a409-2e8e4ede0648",
                        "glosses": [
                            "Relatif aux Rocheuses, généralement entendues comme une extension géologique nord-américaine continue de la cordillère des Andes."
                        ],
                        "tags": [
                            "broadly",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fcf72c2d-5a66-40f9-ac3d-3e0ba34fe9b8",
                                "sense_id": "06163925-0de1-3f57-a668-25f2fdbf305e",
                                "text": "Le drame cordillérien est l'un des plus longs dont on puisse retracer l'histoire au cours des temps géologiques proprement dits. Il prend point d'appui sur les terrains antécambriens dont on connaît des fragments anciens …."
                            },
                            {
                                "example_id": "ed65244d-3366-4038-9da9-e2a9c58f1042",
                                "sense_id": "06163925-0de1-3f57-a668-25f2fdbf305e",
                                "text": "L'occasion était bonne d'examiner en détail ce magnifique chardon cordillérien afin de serrer de plus près l'identité du C. minganense reliquat de la Minganie."
                            }
                        ]
                    },
                    {
                        "sense_id": "5467ae1e-02d1-309a-8e36-e796e98ab8eb",
                        "entry_id": "75ae3eb7-642b-3cf0-a409-2e8e4ede0648",
                        "glosses": [
                            "Relatif à toute cordillère, i.e. toute chaîne de montagnes linéaire dont l'orogenèse a résulté de la subduction d'une plaque tectonique sous une autre."
                        ],
