                ],
                "senses": [
                    {
                        "sense_id": "c066a3df-5e03-33c7-9eaf-672d5dc2cbf0",
                        "entry_id": "3b93d998-7fd1-3c3b-aab8-6b9759c120dd",
                        "glosses": [
                            "Intercity-Express – die schnellste und komfortabelste (Fern-)Zugkategorie der Deutschen Bahn und ihrer Partner in den Nachbarländern; InterCityExpress"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "d1a711c3-2186-4ee2-85ef-fcfcbf88e4e0",
                                "sense_id": "c066a3df-5e03-33c7-9eaf-672d5dc2cbf0",
                                "text": "Der ICE unterscheidet sich durch seine äußere Gestaltung von allen anderen Zügen der Deutschen Bahn."
                            },
                            {
                                "example_id": "d0527828-8595-43bf-8634-d704ca0d372e",
                                "sense_id": "c066a3df-5e03-33c7-9eaf-672d5dc2cbf0",
                                "text": "„Mein Sohn Daniel fuhr 1991 - er wohnte in Stuttgart und arbeitete in Hamburg - mit der Jungfernfahrt des ICE von Hamburg nach München.“"
                            },
                            {
                                "example_id": "45265ac1-26e1-4ac4-8e29-d0cadbec924e",
                                "sense_id": "c066a3df-5e03-33c7-9eaf-672d5dc2cbf0",
                                "text": "„Mit einem lauten Quietschen fuhr der ICE ein, und zusammen mit einer Schar junger Männer und Frauen in dunklen Anzügen und strengen Kostümen nahm ich neben der Zugtür Aufstellung.“"
                            },
                            {
                                "example_id": "b784bc2a-2228-420c-bf97-08ccfa35cc00",
                                "sense_id": "c066a3df-5e03-33c7-9eaf-672d5dc2cbf0",
                                "text": "„Der ICE nach Basel hat auch Verspätung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "14d24cd6-d8a9-3244-9423-986b7521182f",
                        "entry_id": "3b93d998-7fd1-3c3b-aab8-6b9759c120dd",
                        "glosses": [
                            "InterCity-Experimental – die Vorgängerbezeichnung eines Versuchs-Triebzugs der Deutschen Bahn zur Erforschung und Entwicklung von Triebfahrzeugen für den Hochgeschwindigkeitsverkehr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54e727b9-64c7-4cac-9552-20755af76c59",
                                "sense_id": "14d24cd6-d8a9-3244-9423-986b7521182f",
                                "text": "Der ICE stellte am 1. Mai 1988 im Rahmen der Versuchs- und Rekordfahrten den damaligen Geschwindigkeitsrekord von 406,9 km/h auf."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
