                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c66bc8a-7774-3635-b94e-1e2949fa9dc0",
                                        "entry_id": "3dfb4318-e966-3521-98fa-108ade87f1ee",
                                        "glosses": [
                                            "Nom de plusieurs rois de Judée."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "638c607d-db9b-4aff-9331-6f018c940073",
                                                "sense_id": "9c66bc8a-7774-3635-b94e-1e2949fa9dc0",
                                                "text": "Pourtant, avant de rentrer à Alexandrie, il lui faut encore aller à Damas, à Jérusalem et aussi à Gaza, et enfin à Jéricho ! Il lui faut, elle reine d'Égypte, rencontrer Hérode."
                                            },
                                            {
                                                "example_id": "76a85a89-826c-4761-b2f8-ee8b81f5c3d8",
                                                "sense_id": "9c66bc8a-7774-3635-b94e-1e2949fa9dc0",
                                                "text": "C’est au cours de cette guerre que les légions de Titus ont détruit Jérusalem et le temple d’Hérode avant d’exterminer la dernière poche de résistance juive dans la place forte de Massada…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
