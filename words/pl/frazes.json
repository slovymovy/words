                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego specyficzny <w>frazes</w> literacki sprawia, że książkę czyta się z dużym trudem.",
                            "target_lang_translations": {
                                "ru": "Его специфический литературный <w>слог</w> делает книгу трудной для чтения."
                            }
