                "senses": [
                    {
                        "sense_id": "a306305e-bad3-314f-af09-03c00632b488",
                        "entry_id": "8c51e727-9dd9-3a9a-ba06-8c92a4744339",
                        "glosses": [
                            "Faire passer à un état préurbain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7b98caa-db9d-4201-9ef1-6c68c0df96d4",
                                "sense_id": "a306305e-bad3-314f-af09-03c00632b488",
                                "text": "En quelque sorte, le chemin de fer viabilise, structure et « préurbanise » des espaces informes composés fréquemment de pâtis, de champs."
                            },
                            {
                                "example_id": "a1c3876a-b9d1-4b0c-a304-1602f5fd09de",
                                "sense_id": "a306305e-bad3-314f-af09-03c00632b488",
                                "text": "A Rome, les lois de bonification de l’Agro Romano ont eu un effet induit pervers car, dotant le territoire d’infrastructures minimales (routes, division des grands domaines), elles l’ont « préurbanisé »."
                            }
                        ]
                    }
