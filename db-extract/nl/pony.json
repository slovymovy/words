                    {
                        "translation_id": "8db5bc37-fecf-4cea-b7a1-a1fe3e52d0f4",
                        "source_entry_id": "074d506d-da15-3a4b-8a89-e05ee38e456b",
                        "source_sense_id": "dcfcdf35-3f69-3705-a9dd-333b0e895ad7",
                        "source_sense_description": "paard uit een ras met een schofthoogte tot ongeveer anderhalve meter",
                        "target_lang_word": "poney",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poney",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa0ec3ce-80f2-316d-bac6-71701959ffd7",
                                        "entry_id": "7e79d6d2-5006-375f-b433-d8a50af430b3",
                                        "glosses": [
                                            "Cheval de petite taille (adulte moins de 1,49 m de hauteur au garrot), au trot rapide et sec, servant maintenant surtout pour l'agrément, souvent cheval de loisir, cheval de selle ou cheval polyvalent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7c4fc62-62b4-442c-9141-33c23ad425f8",
                                                "sense_id": "aa0ec3ce-80f2-316d-bac6-71701959ffd7",
                                                "text": "[…] la comtesse Vanska, avec ses poneys pie ; madame Daste, et ses fameux stappers noirs ; madame de Guende et madame Tessière, en coupé."
                                            },
                                            {
                                                "example_id": "c21d02d3-6541-4b3c-b114-6d0f6fb5c5bf",
                                                "sense_id": "aa0ec3ce-80f2-316d-bac6-71701959ffd7",
                                                "text": "Le poney est le seul moyen de transport dans ce pays dépourvu de voies de communication; il est à l’Islandais ce que le chameau est au Bédouin : il porte le voyageur et tous ses impedimenta."
                                            },
                                            {
                                                "example_id": "f7f17a17-c0b5-40b6-a5d3-a0ca96890b7f",
                                                "sense_id": "aa0ec3ce-80f2-316d-bac6-71701959ffd7",
                                                "text": "J'avais laissé Reykjavik, un grand village ; […] ; des poneys et une ou deux mauvaises carrioles assuraient le transport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a7518eb-c2b4-3f99-a0fb-ba4b75a57cc3",
                                        "entry_id": "7e79d6d2-5006-375f-b433-d8a50af430b3",
                                        "glosses": [
                                            "Fait de retomber à cheval sur le sommet d'une bosse."
                                        ],
                                        "tags": [],
                                        "examples": [
