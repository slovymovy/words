{
    "word_family": [
        "trap",
        "trapper",
        "trapping"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "982eca78-d0d1-3bb7-9410-e93009662d72",
                    "sense_definition": "Caught in a physical trap or enclosure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "trapped_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small animal was <w>trapped</w> inside the metal cage.",
                            "target_lang_translations": {
                                "fr": "Le petit animal était <w>pris au piège</w> à l'intérieur de la cage en métal."
                            }
                        },
                        {
                            "text": "Firefighters rescued the people who were <w>trapped</w> in the burning building.",
                            "target_lang_translations": {
                                "fr": "Les pompiers ont secouru les personnes qui étaient <w>coincées</w> dans le bâtiment en feu."
                            }
                        }
                    ],
                    "synonyms": [
                        "snared"
                    ],
                    "antonyms": [
                        "untrapped",
                        "unsnared"
                    ],
                    "common_phrases": [
                        "trapped inside",
                        "trapped under"
                    ],
                    "target_lang_definitions": {
                        "fr": "Pris au piège ou enfermé dans un espace physique."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pris au piège",
                                "target_lang_sense_clarification": "utilisé pour quelqu'un ou quelque chose qui ne peut pas sortir d'un lieu"
                            },
                            {
                                "target_lang_word": "coincé",
                                "target_lang_sense_clarification": "terme courant pour désigner une personne ou un objet immobilisé dans un espace restreint"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b67c3218-ec18-34e9-81df-9fd8adb993b9",
                    "sense_definition": "Feeling unable to escape a difficult or unpleasant situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trapped_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt <w>trapped</w> in a job that she did not enjoy.",
                            "target_lang_translations": {
                                "fr": "Elle se sentait <w>prisonnière</w> d'un travail qu'elle n'aimait pas."
                            }
                        },
                        {
                            "text": "Many people feel <w>trapped</w> by their financial responsibilities.",
                            "target_lang_translations": {
                                "fr": "Beaucoup de gens se sentent <w>coincés</w> par leurs responsabilités financières."
                            }
                        }
                    ],
                    "common_phrases": [
                        "trapped in"
                    ],
                    "target_lang_definitions": {
                        "fr": "Se sentir incapable d'échapper à une situation difficile ou désagréable."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "prisonnier",
                                "target_lang_sense_clarification": "utilisé au sens figuré pour exprimer l'absence de liberté dans une situation"
                            },
                            {
                                "target_lang_word": "coincé",
                                "target_lang_sense_clarification": "utilisé familièrement pour exprimer l'impossibilité de changer une situation"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ffc8bc4c-b443-3715-8595-fa55cc3344aa",
                    "sense_definition": "Simple past and past participle of <w>trap</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter <w>trapped</w> a rabbit in the woods.",
                            "target_lang_translations": {
                                "fr": "Le chasseur a <w>attrapé</w> un lapin dans les bois."
                            }
                        },
                        {
                            "text": "The police have <w>trapped</w> the suspect in the alleyway.",
                            "target_lang_translations": {
                                "fr": "La police a <w>coincé</w> le suspect dans la ruelle."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Passé simple et participe passé du verbe attraper."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "attrapé",
                                "target_lang_sense_clarification": "participe passé du verbe attraper"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}