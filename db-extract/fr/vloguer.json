                ],
                "senses": [
                    {
                        "sense_id": "902b56f9-6262-358b-9b7d-3c4b8b62d93f",
                        "entry_id": "a2262c9b-041e-362c-8ca6-7a2c9167338c",
                        "glosses": [
                            "Tenir, créer, gérer un vlog / vlogue, créer des vidéos et les publier via Internet."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "5796c6a4-5909-4cc8-ad8f-c72a6e9e990d",
                                "sense_id": "902b56f9-6262-358b-9b7d-3c4b8b62d93f",
                                "text": "Dernières nouvelles du blog : il vlogue. Ce journal semi-intime publié sur internet, qui remporte de plus en plus de succès dans tous les milieux ­ et fait un tabac chez les politiques - se décline désormais en version vidéo : le vlog."
                            },
                            {
                                "example_id": "f63d03e4-3e3f-4987-8c52-dbdec7479cc5",
                                "sense_id": "902b56f9-6262-358b-9b7d-3c4b8b62d93f",
                                "text": "J'me dis que peut-être que je devrais vloguer ce genre de virées…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98256d21-f565-42ac-80cc-8f2b8d184ece",
                        "source_entry_id": "a2262c9b-041e-362c-8ca6-7a2c9167338c",
                        "source_sense_id": "902b56f9-6262-358b-9b7d-3c4b8b62d93f",
                        "target_lang_word": "vlog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vlog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eca85017-60be-3cad-a232-5327da3af533",
                                        "entry_id": "73e8edb3-3010-3aa3-b7a5-5cfd27f58a28",
                                        "glosses": [
                                            "A weblog using video as its primary presentation format."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a33c2bb-a5f4-4214-a3ea-81df96db6359",
                                                "sense_id": "eca85017-60be-3cad-a232-5327da3af533",
                                                "text": "When you create this kind of videoless vlog, where you don't have the video recorded on a camcorder, you have to be more conscious of the story you want to tell."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vlog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ceaaefb-94b6-3a47-a41b-1d9323e301f6",
                                        "entry_id": "3f873129-2f9c-35a2-835e-ed2d4449c6a0",
                                        "glosses": [
                                            "To contribute to a video weblog."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1460c239-d0ea-4096-a4c3-17e90404e922",
                                                "sense_id": "4ceaaefb-94b6-3a47-a41b-1d9323e301f6",
                                                "text": "I like to take walks when I'm having my breaks at work, and then I vlog my walks and put them online. I can just ramble on about philosophy, or whatever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6d8244e-eb38-3987-9828-5d23b6a1499f",
                                        "entry_id": "3f873129-2f9c-35a2-835e-ed2d4449c6a0",
                                        "glosses": [
                                            "To post (something) to a video weblog."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
