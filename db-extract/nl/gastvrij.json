                        "target_lang_word": "gastfreundlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gastfreundlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4307a85-90c3-3736-90d5-8430ff5f3743",
                                        "entry_id": "94ffeee4-7837-399e-8ca5-21e033b1d111",
                                        "glosses": [
                                            "freundlich und aufmerksam zu Gästen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "601ca90d-51c8-45a4-a062-234295261bc7",
                                                "sense_id": "d4307a85-90c3-3736-90d5-8430ff5f3743",
                                                "text": "Dieses Urlaubsland kann man nur empfehlen, die Menschen dort sind sehr gastfreundlich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
