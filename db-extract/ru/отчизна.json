                        ]
                    },
                    {
                        "translation_id": "970ca3c1-ec8c-44eb-8cb4-4a947b9f4458",
                        "source_entry_id": "591fd391-935a-37ba-9e87-158750ee6640",
                        "source_sense_id": "358ee47d-28f1-3fad-be6c-5fdb3414499c",
                        "target_lang_word": "Vaterland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vaterland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72ea94ce-4aa8-3e77-91ea-db6879e68283",
                                        "entry_id": "78d6f16d-36b2-3074-8daa-4d057a89cb77",
                                        "glosses": [
                                            "Land, aus dem man stammt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "508b806c-9812-4dc1-8b3c-1069d96eca4b",
                                                "sense_id": "72ea94ce-4aa8-3e77-91ea-db6879e68283",
                                                "text": "„Sie ist von Werten wie Stolz getragen und von Worten wie Vaterland.“"
                                            },
                                            {
                                                "example_id": "444a0255-f8f8-44f5-945e-3f81329aa5b3",
                                                "sense_id": "72ea94ce-4aa8-3e77-91ea-db6879e68283",
                                                "text": "„Mit keinem anderen Fluß unseres Vaterlandes, sagte ich mir, ist die Mosel zu vergleichen.“"
                                            },
                                            {
                                                "example_id": "25ff8eb7-cc6b-4d39-89ba-7b1473c93841",
                                                "sense_id": "72ea94ce-4aa8-3e77-91ea-db6879e68283",
                                                "text": "„Als der Krieg beginnt, ist Klaus gerade mal 19 Jahre alt und überzeugt davon, für sein Vaterland kämpfen zu müssen.“"
                                            },
                                            {
                                                "example_id": "74051796-5e93-4e82-94af-53dd9cbb26a4",
                                                "sense_id": "72ea94ce-4aa8-3e77-91ea-db6879e68283",
                                                "text": "„Begeistert von dem Gehörten, sprachen Anna Pawlownas Gäste noch lange von der Lage des Vaterlandes und äusserte allerhand Mutmassungen über den Ausgang der Schlacht, die dieser Tage geliefert worden sein musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5984250-f19f-4484-805f-dd2382ebf8d0",
                        "source_entry_id": "591fd391-935a-37ba-9e87-158750ee6640",
