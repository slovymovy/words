                "senses": [
                    {
                        "sense_id": "1ed0c80d-cd7a-3b61-bdb2-50a4be5b026f",
                        "entry_id": "a3e76de1-f2f6-3bfa-ab62-8d4b76be5e4f",
                        "glosses": [
                            "A foolish person; a simpleton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeca4f5d-86b0-4a5c-a948-fa00ebd54188",
                                "sense_id": "1ed0c80d-cd7a-3b61-bdb2-50a4be5b026f",
                                "text": "1608, A Yorkshire Tragedy, dubiously claimed to be by William Shakespeare\nWhy, the more fool she; aye, the more ninny hammer she."
                            },
                            {
                                "example_id": "ef1dcfea-7069-4541-b24a-ee060e4fb25d",
                                "sense_id": "1ed0c80d-cd7a-3b61-bdb2-50a4be5b026f",
                                "text": "\"You silly, awkward, ill-bred country sow,\" quoth one, \"have you no more manners than to rail at Hocus that has saved that clod-pated numskulled ninny-hammer of yours from ruin, and all his family?"
                            },
                            {
                                "example_id": "b3cf6cfc-798c-462a-be65-895d450affa4",
                                "sense_id": "1ed0c80d-cd7a-3b61-bdb2-50a4be5b026f",
                                "text": "'Silly noodle!—foolish simpleton!—bewildered ninnyhammer! He had brains in his head once.'"
                            },
                            {
                                "example_id": "7762873c-5875-47f4-a65f-1acd9180e335",
                                "sense_id": "1ed0c80d-cd7a-3b61-bdb2-50a4be5b026f",
                                "text": "'Well, if I don't deserve to be hung on the end of one as a warning to numbskulls! You're nowt but a ninnyhammer, Sam Gamgee: that's what the Gaffer said to me often enough, it being a word of his. Rope!'"
                            }
                        ]
                    }
                ],
