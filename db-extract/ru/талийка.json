                        "examples": [
                            {
                                "example_id": "1762040a-aa0e-4429-b5f5-c341fa5bff5a",
                                "sense_id": "015f123c-184d-3b7a-a000-f78246fc3123",
                                "text": "Видишь, талийка-то стала какая тоненькая, стройная; так городской барышней и смотришь."
                            },
                            {
                                "example_id": "2ceb7cd0-8f68-4516-b3db-11a64b55d481",
                                "sense_id": "015f123c-184d-3b7a-a000-f78246fc3123",
                                "text": "Четыре ладные девочки с узенькими талийками вели под уздцы допотопное чудище."
                            }
                        ]
                    }
