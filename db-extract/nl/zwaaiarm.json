                    {
                        "sense_id": "834e6240-4f21-37b1-8d9e-38cd6616ade0",
                        "entry_id": "6c14fdaa-da62-305f-a59a-43d2b9fff1f8",
                        "glosses": [
                            "de draaiende arm van een hijskraan of soortgelijke machine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7600def1-2404-4208-8f04-3b7294fc4302",
                                "sense_id": "834e6240-4f21-37b1-8d9e-38cd6616ade0",
                                "text": "‘We verwachten dat het vanaf deze week goed druk wordt. De studenten komen eraan. Vooral de hoogste en snelste kermisattractie, de Flying Rudolph, een zwaaiarm van zestig meter hoog met aan elk uiteinde een cabine, moet studenten lokken."
                            }
                        ]
                    },
                    {
                        "sense_id": "916fa149-63d7-3778-84e5-92ccd12893d8",
                        "entry_id": "6c14fdaa-da62-305f-a59a-43d2b9fff1f8",
                        "glosses": [
                            "een menselijke arm waarmee men zwaait"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5315c223-c4b8-40fe-99a9-cca01d370c32",
                                "sense_id": "916fa149-63d7-3778-84e5-92ccd12893d8",
                                "text": "Van Gorp plaatst ook links voor zijn verantwoordelijkheid, maar ziet toch verschillen met de iconische foto uit Ninove. ‘Ik heb die fotoreeks gezien. Ik zie ook zwaaiarmen, opgestoken vingers, en die ene zeer gestrekte arm. Je kan erover discussiëren of die een Hitlergroet brengt of niet. Maar waar geen discussie over kan bestaan, is dat het om mannen gaat met zeer rechtse sympathieën.’"
                            }
                        ]
                    }
