                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the dark storm <w>nighed</w>, the sailors prepared the ship for rough seas.",
                            "target_lang_translations": {
                                "pl": "Gdy ciemna burza się <w>przybliżała</w>, żeglarze przygotowywali statek na wzburzone morze.",
                                "ru": "Когда тёмная буря <w>приближалась</w>, моряки готовили корабль к шторму."
                            }
                        },
                        {
                            "text": "The traveler watched the distant lights of the city as he <w>nighed</w> his destination.",
                            "target_lang_translations": {
                                "pl": "Podróżnik obserwował odległe światła miasta, gdy <w>zbliżał się</w> do celu swojej podróży.",
                                "ru": "Путник наблюдал за далёкими огнями города, <w>приближаясь</w> к цели своего путешествия."
