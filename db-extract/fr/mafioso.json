                    },
                    {
                        "form_id": "1348596b-1bfc-4a33-8145-9b9ca53f557c",
                        "entry_id": "1ae2b68a-691b-37ad-8c33-ed199021a94c",
                        "tags": [],
                        "form": "maffioso"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2a78762-6a6e-3fad-9ec9-aa3b8b43a370",
                        "entry_id": "1ae2b68a-691b-37ad-8c33-ed199021a94c",
                        "glosses": [
                            "Membre de la mafia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf0bd8d0-f9d9-4791-9470-555154a44b70",
                                "sense_id": "d2a78762-6a6e-3fad-9ec9-aa3b8b43a370",
                                "text": "La peau d'un mafioso… Je suis ce mafioso. Ils sont des centaines à vouloir ma mort, à travers la Sicile et, si je parviens à quitter cette île de malheur, à travers le monde."
                            },
                            {
                                "example_id": "21aa04bb-2db5-4b88-b554-69be3e492cfa",
                                "sense_id": "d2a78762-6a6e-3fad-9ec9-aa3b8b43a370",
                                "text": "Certains ajoutent que la « super prison » de Palmi, où sont enfermés actuellement les terroristes des Brigades rouges et certains mafiosi, aurait été construite avec l’accord de la mafia."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a823498a-6778-4312-be1d-4f7ea3f45472",
                        "source_entry_id": "1ae2b68a-691b-37ad-8c33-ed199021a94c",
                        "source_sense_id": "d2a78762-6a6e-3fad-9ec9-aa3b8b43a370",
                        "target_lang_word": "Mafioso",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mafioso",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f96c38e4-70eb-3a7a-8a6a-9979172b5187",
                                        "entry_id": "4befd2e6-2a8c-3280-8996-221f8263b333",
                                        "glosses": [
                                            "Mitglied einer Mafia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0777b353-0289-4a93-97f8-f84d3eb679b7",
                                                "sense_id": "f96c38e4-70eb-3a7a-8a6a-9979172b5187",
                                                "text": "„Die Tatsache, dass der Mafioso in seiner Heimat festgenommen worden sei, unterstütze die These des ermordeten Mafia-Jägers Borsellino, der stets erklärt habe, dass die Mafiosi Fische seien, die nur in heimischen Gewässern schwimmen.“"
                                            },
                                            {
                                                "example_id": "7b774cb5-1507-44bf-8d75-b677956ffc2d",
                                                "sense_id": "f96c38e4-70eb-3a7a-8a6a-9979172b5187",
                                                "text": "„Basha saß bereits schon einmal wegen seiner vermuteten Beziehungen zu dem bosnischen Mafioso Damir Fazlic auf der Anklagebank.“"
                                            },
                                            {
                                                "example_id": "74884e00-833e-4075-8af4-4d791e313580",
                                                "sense_id": "f96c38e4-70eb-3a7a-8a6a-9979172b5187",
                                                "text": "„Todesstrafen gegen Abweichler wurden von einer borgata ausgesprochen und an alle anderen im gleichen Gebiet übermittelt. […] Eine größere ›Generalversammlung‹ wählte die Capos und diskutierte die vorgesehene Ermordung von Mafiosi.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f7dd401-3acb-44c9-ad81-7c6f521429a6",
                        "source_entry_id": "1ae2b68a-691b-37ad-8c33-ed199021a94c",
                        "source_sense_id": "d2a78762-6a6e-3fad-9ec9-aa3b8b43a370",
                        "target_lang_word": "Mafioso",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mafioso",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fcba0f8-44e8-3316-9dd3-b9c577993693",
                                        "entry_id": "d24d218d-f099-38cc-996b-472d4323cf21",
                                        "glosses": [
                                            "A member of the Mafia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93753107-2c97-488f-ac4d-a19175c0a4b3",
                                                "sense_id": "1fcba0f8-44e8-3316-9dd3-b9c577993693",
                                                "text": "Phil put his arms around him. Drew him in close, pressed his cheek to Dane's the way the Mafiosi in the fifties would kiss somebody right before they punched his ticket."
                                            },
                                            {
                                                "example_id": "398c5214-0438-4f84-afc2-2e6f1d2376c2",
                                                "sense_id": "1fcba0f8-44e8-3316-9dd3-b9c577993693",
                                                "text": "“Sometimes, I swear you have no idea about the concept of money. Only you could give a one-of-a-kind ring to a female Mafioso, so casually.”"
                                            },
                                            {
                                                "example_id": "c4b87189-4816-4a24-9d0b-28efd9727d58",
                                                "sense_id": "1fcba0f8-44e8-3316-9dd3-b9c577993693",
                                                "text": "“As the library grows in popularity, the community gets stronger and she gets more powerful. She ultimately goes from this timorous lady to a local kingpin. Kind of like a female Mafioso. And then someone crosses her so she has a vengeance to play out.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18430c85-b532-34c4-871a-184c69a6900d",
                                        "entry_id": "d24d218d-f099-38cc-996b-472d4323cf21",
                                        "glosses": [
                                            "A member of the Mafia.",
                                            "A male member of the Mafia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae0a665f-d786-4337-a89f-a0ba156b6288",
                                                "sense_id": "18430c85-b532-34c4-871a-184c69a6900d",
                                                "text": "The widow of one murdered Mafioso gave her son the bloody jacket that her husband had been killed in. […] So far there has not been a Mafiosa who has made it to the top on her own."
                                            },
                                            {
                                                "example_id": "2d1d8423-1e11-4b4b-98ed-2160184965c7",
                                                "sense_id": "18430c85-b532-34c4-871a-184c69a6900d",
                                                "text": "Is there a feminine for mafiosos? Mafiosas? Because apparently that’s what we are, the Mothers’ Mafia."
                                            },
                                            {
                                                "example_id": "afe403b9-92bf-4da7-940e-65d071a68001",
                                                "sense_id": "18430c85-b532-34c4-871a-184c69a6900d",
                                                "text": "Ninetta had grown up in a Mafia village, her family was Mafia, and she had fallen in love with a Mafioso. And she was a Mafiosa herself."
                                            },
                                            {
                                                "example_id": "37369c00-0cda-449f-bfcd-9b5dc404f5fc",
                                                "sense_id": "18430c85-b532-34c4-871a-184c69a6900d",
                                                "text": "Plotted from the beginning fitting a plan for a Mafioso dictator / Never deviating from the decision to be the first for a throwaway bride / Whims and whimsical thinking guides the denial of the Mafiosa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
