                        "examples": [
                            {
                                "example_id": "8caaa1a9-170d-47fe-8571-c24a441161f9",
                                "sense_id": "c9412ef7-e877-3cb9-a400-6e8293fc8f52",
                                "text": "„Ein Schweizer Gericht hat Jan Ullrich wegen einer Alkoholfahrt im Jahr 2014 zu einer Bewährungsstrafe von 21 Monaten verurteilt.“"
                            },
                            {
                                "example_id": "ef283738-758a-4763-98b8-c8304bb59b0b",
                                "sense_id": "c9412ef7-e877-3cb9-a400-6e8293fc8f52",
                                "text": "„Eine Alkoholfahrt auf dem Rad führt aber nicht nur zu einer empfindlichen Geldstrafe: Nach der Rechtsprechung […] muss ab 1,6 Promille die Fahrerlaubnisbehörde zwingend eine medizinisch-psychologische Untersuchung (MPU) anordnen.“"
                            }
                        ],
