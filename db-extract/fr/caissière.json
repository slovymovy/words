        "fr-extract.jsonl": [
            {
                "entry_id": "0731c21b-bd6b-3c47-99db-b67446dcf665",
                "word": "caissière",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bc629719-05d9-4a9d-85a1-1db1ec117cce",
                        "entry_id": "0731c21b-bd6b-3c47-99db-b67446dcf665",
                        "tags": [
                            "plural"
                        ],
                        "form": "caissières"
                    },
                    {
                        "form_id": "feffc88c-66aa-4a45-a82c-b862aa1d1e1f",
                        "entry_id": "0731c21b-bd6b-3c47-99db-b67446dcf665",
                        "tags": [
                            "masculine"
                        ],
                        "form": "caissier"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f4b28e1-c6ca-342b-bba1-4cc261a5ef8f",
                        "entry_id": "0731c21b-bd6b-3c47-99db-b67446dcf665",
                        "glosses": [
                            "Femme qui tient la caisse chez un banquier, chez un négociant, ou dans une administration, dans un établissement public, dans un supermarché."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "08dfa493-11fa-46bd-9293-6a469a3846d2",
                                "sense_id": "3f4b28e1-c6ca-342b-bba1-4cc261a5ef8f",
                                "text": "Et il lui montra, en dehors de l’enceinte, en face, dans une autre cabine de bois jaune, la caissière, une vieille et énorme femme, qui rangeait des piles de sous et de pièces de cinq francs."
                            },
                            {
                                "example_id": "6995d398-81d2-4186-b604-1fbc0cbfe760",
                                "sense_id": "3f4b28e1-c6ca-342b-bba1-4cc261a5ef8f",
                                "text": "Il était à peine deux heures de l'après-midi, et, outre la caissière, il n'y avait dans la brasserie, au moment où j'y entrai, que deux filles assez belles, soigneusement frisées et maquillées, qui comptaient leurs jetons au coin d'une table."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efee5fa3-1c4a-45f4-a4b1-f648d1800ecd",
                        "source_entry_id": "0731c21b-bd6b-3c47-99db-b67446dcf665",
                        "source_sense_id": "3f4b28e1-c6ca-342b-bba1-4cc261a5ef8f",
                        "target_lang_word": "Kassiererin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kassiererin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10522fc4-a026-3ed5-9a3b-4ed3d36bcf69",
                                        "entry_id": "97af040c-751c-3283-acc2-9eaa1932bbda",
                                        "glosses": [
                                            "die Kasse Führende, Verwalterin der Kasse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c061433a-2679-4cad-b909-2df52911a236",
                                                "sense_id": "10522fc4-a026-3ed5-9a3b-4ed3d36bcf69",
                                                "text": "An dieser Packung klebt kein Preisschild. Ich werde die Kassiererin nach dem Preis fragen."
                                            },
                                            {
                                                "example_id": "2f5c684c-c42e-40b2-912e-fafa75cf1600",
                                                "sense_id": "10522fc4-a026-3ed5-9a3b-4ed3d36bcf69",
                                                "text": "„Die Kassiererin am Tresen sagte mir, dass der samische Tanzabend abgesagt wurde, der dort am kommenden Wochenende stattfinden sollte.“"
                                            },
                                            {
                                                "example_id": "1680351d-88fb-48f8-8621-78c76795e504",
                                                "sense_id": "10522fc4-a026-3ed5-9a3b-4ed3d36bcf69",
                                                "text": "„Die Mundbewegungen der Kassiererin kann Eos wegen der Entfernung nicht erkennen, und Anrath wendet ihr meistens den Rücken zu.“"
                                            },
                                            {
                                                "example_id": "587ebacf-3196-45f4-9595-94cddd3f2eb7",
                                                "sense_id": "10522fc4-a026-3ed5-9a3b-4ed3d36bcf69",
                                                "text": "„Die Kassiererin, keine aus dem Dorf, sah kaum auf.“"
                                            },
                                            {
                                                "example_id": "73be57cc-6b04-408f-9fe5-824303a067ca",
                                                "sense_id": "10522fc4-a026-3ed5-9a3b-4ed3d36bcf69",
                                                "text": "„Der Strichcode nutzt uns Verbrauchern ganz direkt: Wenn die Kassiererin im Supermarkt einen Artikel scannt, dann wird dabei automatisch die Prüfziffer kontrolliert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "570a685e-11ff-4043-9ce0-7932d051c70f",
                        "source_entry_id": "0731c21b-bd6b-3c47-99db-b67446dcf665",
                        "source_sense_id": "3f4b28e1-c6ca-342b-bba1-4cc261a5ef8f",
                        "target_lang_word": "cashier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cashier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d849fe08-a723-30a9-8b40-44205e6a9e6f",
                                        "entry_id": "a1bdde7b-daf3-3b50-a4b4-c4e27f0a4a62",
                                        "glosses": [
                                            "To dismiss (someone, especially military personnel) from service."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a4524eb-9d1c-47f1-929d-d7ccf2ead8b0",
                                                "sense_id": "d849fe08-a723-30a9-8b40-44205e6a9e6f",
                                                "text": "His ninth Legion having mutined neere unto Placentia, he presently cassiered the same with great ignominie unto it[…]."
                                            },
                                            {
                                                "example_id": "cbaf8a10-df26-493a-be83-eb3a9f60a6cb",
                                                "sense_id": "d849fe08-a723-30a9-8b40-44205e6a9e6f",
                                                "text": "The recent cashiering for disobedience of orders of a Major-General who is claimed, we know not with what truth, to be of the \"conservative\" order, has raised this outcry louder and fiercer than ever."
                                            },
                                            {
                                                "example_id": "cae7eb05-cd9c-4dbb-ab2b-c9976e26c2ce",
                                                "sense_id": "d849fe08-a723-30a9-8b40-44205e6a9e6f",
                                                "text": "They found an Army officer who had been a military failure until Bernard Baruch promoted him to General, and who in 1945 should have been able to hope for nothing better than that he could escape a court martial and thus avoid being cashiered, if he could prove that all the atrocities and all the sabotage of American interests of which he had been guilty in Europe had been carried out over his protest and under categorical orders from the President."
                                            },
                                            {
                                                "example_id": "ba4b0f25-ca75-4f8a-b3f1-702acfca5166",
                                                "sense_id": "d849fe08-a723-30a9-8b40-44205e6a9e6f",
                                                "text": "The Directory had been deregulating the economy since Thermidor; but it had not cashiered the police spies on which the Terror had depended, and these allowed the government to keep abreast of the threat."
                                            },
                                            {
                                                "example_id": "0ae51aac-ffb8-46ad-894b-536f8cd857a9",
                                                "sense_id": "d849fe08-a723-30a9-8b40-44205e6a9e6f",
                                                "text": "Inevitably his appeals for financial assistance were ignored and, though not cashiered from the army, he was pointedly cold-shouldered by his brother officers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "639eb2ba-1419-3d5a-b79f-3705cef20f7a",
                                        "entry_id": "a1bdde7b-daf3-3b50-a4b4-c4e27f0a4a62",
                                        "glosses": [
                                            "To discard, put away."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7805d957-4c6a-4c36-a94e-06d35ad110e8",
                                                "sense_id": "639eb2ba-1419-3d5a-b79f-3705cef20f7a",
                                                "text": "Once Princess in Love was published, Diana threw both Hewitt and Pasternak under the bus. Besotted to the end, her cashiered toy soldier never revealed whether or not he had done her bidding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45f78957-cb15-3a51-aa68-49cc81506748",
                                        "entry_id": "a1bdde7b-daf3-3b50-a4b4-c4e27f0a4a62",
                                        "glosses": [
                                            "To annul."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cashier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37d43ca8-2f5e-38b4-893a-e7010ab67783",
                                        "entry_id": "b6caccf0-5784-3c22-95cd-52201432e7b2",
                                        "glosses": [
                                            "One who works at a till or receives payments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81717908-07f2-4d5d-8b7b-cd41633d6cf2",
                                                "sense_id": "37d43ca8-2f5e-38b4-893a-e7010ab67783",
                                                "text": "The chefs never cooked before, the cashiers never cashiered before, the dishwashers never dishwashed before, the waitresses never waitressed before, and the managers never managed before."
                                            },
                                            {
                                                "example_id": "ec577b25-a5b9-49a0-a5f0-0e5c86081235",
                                                "sense_id": "37d43ca8-2f5e-38b4-893a-e7010ab67783",
                                                "text": "So when everyone was stopping at the grocery store for one or two things on the way home from work, inundating each express lane with at least ten custies, the cashier on the express lane was due for a break […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "886b4e9b-6e18-3f5f-aa01-193050756239",
                                        "entry_id": "b6caccf0-5784-3c22-95cd-52201432e7b2",
                                        "glosses": [
                                            "Person in charge of the cash of a business or bank."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cashier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f175d604-5797-3012-9ffb-6ad999b141dd",
                                        "entry_id": "db16acaf-4b3a-3ecc-ba3e-b3ef4e9a7d20",
                                        "glosses": [
                                            "To work as a cashier (at a till or receiving payment)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e5d535f-288b-43a6-9054-b4f7e9c16d62",
                                                "sense_id": "f175d604-5797-3012-9ffb-6ad999b141dd",
                                                "text": "The employer places more emphasis on cashiering skills. Taking the customer's money has risen in importance to the point where many stores have specialists whose sole duty is manning the cash registers."
                                            },
                                            {
                                                "example_id": "d1919cb4-3552-4c57-803a-48d09c9aab97",
                                                "sense_id": "f175d604-5797-3012-9ffb-6ad999b141dd",
                                                "text": "The chefs never cooked before, the cashiers never cashiered before, the dishwashers never dishwashed before, the waitresses never waitressed before, and the managers never managed before."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aad47ef8-c6c3-4e0b-8955-9278ac7c7326",
                        "source_entry_id": "0731c21b-bd6b-3c47-99db-b67446dcf665",
