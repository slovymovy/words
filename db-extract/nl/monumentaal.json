                                "target_senses": [
                                    {
                                        "sense_id": "82e05230-7b5b-3668-a5d1-30100ed1612f",
                                        "entry_id": "63f56697-4660-3e1a-b897-3d2f53971b2f",
                                        "glosses": [
                                            "gewaltig und eindrucksvoll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edebe791-8459-4ece-8d8a-8a4ac2a5d62c",
                                                "sense_id": "82e05230-7b5b-3668-a5d1-30100ed1612f",
                                                "text": "Auch nach den Umbauarbeiten blieb der monumentale Charakter der Anlage erhalten."
                                            },
                                            {
                                                "example_id": "f2eaa9e2-510f-418f-ab24-8ada9d37a42a",
                                                "sense_id": "82e05230-7b5b-3668-a5d1-30100ed1612f",
                                                "text": "Meine Mutter war seit jeher eine Frau von monumentalen Ausmaßen."
                                            },
                                            {
                                                "example_id": "f48a82a6-8715-47a6-9511-b7637599deae",
                                                "sense_id": "82e05230-7b5b-3668-a5d1-30100ed1612f",
                                                "text": "„Das mächtige Kreuz vor der Kirche, von Steinmetzen aus heimischem Basalt gehauen, imponiert durch seine monumentale Größe ebenso wie durch seine Aussagekraft als Mahnmal für die Toten der beiden Weltkriege des 20. Jahrhunderts (…).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75e31281-22c7-4f6d-8f40-05f83ebad7ba",
                        "source_entry_id": "8cdf5069-9ef6-3acc-acab-8e896e654394",
