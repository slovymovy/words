                    "frequency": "High",
                    "semantic_group_id": "eclairage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut changer l'<w>ampoule</w> du salon parce qu'elle ne fonctionne plus."
                        },
                        {
                            "text": "Cette nouvelle <w>ampoule</w> consomme beaucoup moins d'énergie que l'ancienne."
                        }
                    ],
                    "synonyms": [
                        "lampe"
                    ],
                    "common_phrases": [
                        "ampoule électrique",
                        "changer une ampoule"
                    ]
                },
                {
                    "sense_id": "a64a9c66-d471-3582-b2a4-5d89109b58a6",
                    "sense_definition": "Soulèvement de la peau rempli de liquide, provoqué par un frottement répété ou une brûlure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai marché toute la journée avec des chaussures neuves et j'ai une <w>ampoule</w> douloureuse."
                        },
                        {
                            "text": "Elle a mis un pansement protecteur sur ses <w>ampoules</w> pour continuer la randonnée."
                        }
                    ],
                    "synonyms": [
                        "cloque",
                        "phlyctène",
                        "vésicule"
                    ],
                    "common_phrases": [
                        "ampoule au pied",
                        "avoir des ampoules"
                    ]
                },
                {
                    "sense_id": "80580cbf-c41a-3632-98a7-0b18034cbb8b",
                    "sense_definition": "Petit récipient en verre scellé contenant un médicament liquide buvable ou injectable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pharmacie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infirmière prépare une <w>ampoule</w> de vaccin avant de pratiquer l'injection."
                        },
                        {
                            "text": "Le médecin lui a prescrit une <w>ampoule</w> de vitamines à prendre chaque matin."
