                                        "entry_id": "4af3f468-4b4d-362c-8b1c-b1f3dc2c9a55",
                                        "glosses": [
                                            "enunciazione estremamente sintetica, dallo stile spesso immaginifico e pregna di significati, implicazioni, sottintesi, enigmi, rivelazioni profetiche ma anche arguzie e sottigliezze, col carattere di sentenza, massima, proverbio o aforisma, diffusa soprattutto nella letteratura mistica, religiosa e filosofica e spesso legata direttamente o per imitazione a un sapere e a una trasmissione del sapere di tipo oracolare"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae21610c-185e-43bf-9ca1-b2d599aad4fe",
                        "source_entry_id": "ec1d3422-4ac3-3c32-b486-ed143979da3f",
                        "source_sense_id": "3ae52436-1d5d-307e-997f-d486d5aa13c4",
                        "target_lang_word": "Apophthegma",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apophthegma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18302bc3-c103-312b-b60d-500e4fdd1533",
                                        "entry_id": "8efd55d9-dc2c-376e-ad0b-51194a530a63",
                                        "glosses": [
                                            "witziger, treffender Ausspruch, Sinnspruch"
                                        ],
                                        "tags": [
                                            "Rhetorik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd405b64-230e-4eeb-8896-e6dbcb1a7ff3",
                                                "sense_id": "18302bc3-c103-312b-b60d-500e4fdd1533",
                                                "text": "„Nach einigen punktierten Zeilen, welche die Lücke bezeichnen, liest man: ›Nichts ist trauriger auf dieser Welt, als ein Dummkopf zu sein …‹ Wars Jakob, der dieses Apophthegma über seine Lippen brachte, oder war es sein Herr? Das könnte der Gegenstand einer langen und schwierigen Dissertation werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f7d3d10-2b05-470b-9b0d-ea13049ac569",
                        "source_entry_id": "ec1d3422-4ac3-3c32-b486-ed143979da3f",
                        "source_sense_id": "3ae52436-1d5d-307e-997f-d486d5aa13c4",
