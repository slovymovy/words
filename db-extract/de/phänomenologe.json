                "senses": [
                    {
                        "sense_id": "ce69d936-e1e5-33ea-8f4a-645f5a98b244",
                        "entry_id": "d04b02a4-554b-3a7f-836e-fc312581f1ab",
                        "glosses": [
                            "Wissenschaftler, der sich mit der Phänomenologie beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7937888-9776-47a9-bcb9-ed6927bc371d",
                                "sense_id": "ce69d936-e1e5-33ea-8f4a-645f5a98b244",
                                "text": "„Ein Ranking von Zeitschriften legt diesen Streit implizit bei oder setzt die Beilegung dieses Streites vielmehr voraus. Ein Phänomenologe und ein Analytiker in der Philosophie verstehen unter einem guten philosophischen Argument etwas grundlegend anderes. Anhänger von Heidegger und Anhänger von Russell können sich nicht einigen, was sie unter Logik verstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21059cad-6c07-4fa6-95de-27b9804ffb3d",
                        "source_entry_id": "d04b02a4-554b-3a7f-836e-fc312581f1ab",
                        "source_sense_id": "ce69d936-e1e5-33ea-8f4a-645f5a98b244",
                        "source_sense_description": "Philosophie: Wissenschaftler, der sich mit der Phänomenologie beschäftigt",
