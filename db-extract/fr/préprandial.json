                "senses": [
                    {
                        "sense_id": "a1e6023f-e266-3053-ade6-8484e61a6b04",
                        "entry_id": "90f11c2f-1a57-33ee-8d12-679a8de54b89",
                        "glosses": [
                            "ou Qui concerne le moment qui précède le repas, qui se produit avant le repas."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "ef6b485d-4568-4f6c-9b02-20f25b0e4f9c",
                                "sense_id": "a1e6023f-e266-3053-ade6-8484e61a6b04",
                                "text": "Cette peptonothérapie préprandiale n’est pas seulement une méthode skeptophylactique."
                            },
                            {
                                "example_id": "81b8a270-e7e0-404d-989a-c3a1abf3da5d",
                                "sense_id": "a1e6023f-e266-3053-ade6-8484e61a6b04",
                                "text": "Leurs caractéristiques en font cependant d’excellents candidats pour une administration préprandiale d’insuline."
                            },
                            {
                                "example_id": "46b3d746-96b8-4cd6-ba70-4b59ce33e4b3",
                                "sense_id": "a1e6023f-e266-3053-ade6-8484e61a6b04",
                                "text": "En octobre, en novembre, au cours de notre promenade préprandiale autour du lac, nous les désignions [les oiseaux migrateurs]."
                            },
                            {
                                "example_id": "e607ed77-0425-44d1-8cad-9f5279fcf002",
                                "sense_id": "a1e6023f-e266-3053-ade6-8484e61a6b04",
                                "text": "Loin de moi l'intention d'épouser la pauvre Charlotte à seule fin de l'éliminer ensuite de quelque façon vulgaire, horrible, autant que dangereuse, de l'assassiner par exemple en mettant cinq cachets de bichlorure de mercure dans son sherry préprandial ou quelque chose du genre."
                            }
                        ]
                    }
