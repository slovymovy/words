                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The statistical software handles <w>missings</w> by ignoring those rows.",
                            "target_lang_translations": {
                                "ru": "Статистическая программа обрабатывает <w>пропуски</w>, игнорируя эти строки.",
                                "de": "Die Statistiksoftware behandelt <w>fehlende Werte</w>, indem sie diese Zeilen ignoriert.",
                                "zh": "统计软件通过忽略这些行来处理<w>缺失值</w>。"
                            }
                        },
                        {
                            "text": "We need to analyze the pattern of <w>missings</w> in the survey results.",
                            "target_lang_translations": {
                                "ru": "Нам нужно проанализировать структуру <w>пропущенных значений</w> в результатах опроса.",
                                "de": "Wir müssen das Muster der <w>Datenlücken</w> in den Umfrageergebnissen analysieren.",
                                "zh": "我们需要分析调查结果中<w>遗漏</w>数据的规律。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Значение или элемент, который не записан в наборе данных.",
                        "de": "Ein Wert oder Element, das in einem Datensatz nicht erfasst wurde.",
                        "zh": "指数据集中未记录的值或项目。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропуск",
                                "target_lang_sense_clarification": "отсутствие данных"
                            },
                            {
                                "target_lang_word": "пропущенное значение",
                                "target_lang_sense_clarification": "термин статистики"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fehlender Wert",
                                "target_lang_sense_clarification": "statistischer Fachbegriff"
                            },
                            {
                                "target_lang_word": "Datenlücke",
                                "target_lang_sense_clarification": "allgemein für fehlende Informationen"
