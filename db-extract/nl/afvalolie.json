                        "examples": [
                            {
                                "example_id": "a19840ca-9238-4996-adcc-e6792cc6461e",
                                "sense_id": "66499d80-502e-32d7-8d85-216030a64af4",
                                "text": "Het Interregionaal Milieuteam van de bovenregionale recherche Noord- en Oost-Nederland doorzoekt woensdag voor de tweede keer het terrein en gebouwen van raffinaderij North Refinery in Farmsum bij Delfzijl. Een woordvoerster van het Openbaar Ministerie (OM) wilde de naam van de onderneming woensdag niet bevestigen. De raffinaderij bewerkt onder meer afvalolie. Vorig jaar op 9 maart werd er ook al een doorzoeking in het bedrijf gedaan."
                            },
                            {
                                "example_id": "85fed9e8-dffc-41d8-9ce7-e081e1a574bf",
                                "sense_id": "66499d80-502e-32d7-8d85-216030a64af4",
                                "text": "Een milieuschandaal dat vooral de kwetsbaarheid van de voedselketen blootlegde, kostte Dehaene in 1999 onverwacht het premierschap. Kort voor de verkiezingen brak de dioxinecrisis uit. Giftige afvalolie was terechtgekomen in kippenvoer, zodat verdachte kippen op de zondagse dis waren beland."
                            }
