                "senses": [
                    {
                        "sense_id": "d8bd3cf6-e9e8-3c65-97a8-6bb2b6e4408a",
                        "entry_id": "1250941d-29b0-31cc-9c50-cafe0edf24db",
                        "glosses": [
                            "Sortir du sac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07798a05-10d9-44e0-ac95-1c5f5fde29ee",
                                "sense_id": "d8bd3cf6-e9e8-3c65-97a8-6bb2b6e4408a",
                                "text": "Le bois pourra être désensaché, mais sera livré en sacs à Amemuiden."
                            },
                            {
                                "example_id": "701f21fa-a6a9-4869-88a3-18cb73013de2",
                                "sense_id": "d8bd3cf6-e9e8-3c65-97a8-6bb2b6e4408a",
                                "text": "Il faut alors désensacher pour ciseler, ce qui complique un peu les choses ;"
                            },
                            {
                                "example_id": "8169a867-19b9-48f6-8fb9-2c63fd444ace",
                                "sense_id": "d8bd3cf6-e9e8-3c65-97a8-6bb2b6e4408a",
                                "text": "Tous les fruits étaient ensachés mais il fut possible de désensacher ceux de deux arbres dans la parcelle traitée et d’un dans la parcelle témoin."
                            }
                        ]
                    },
                    {
                        "sense_id": "da10a8a6-6334-335e-a21b-7d0168a3460b",
                        "entry_id": "1250941d-29b0-31cc-9c50-cafe0edf24db",
                        "glosses": [
                            "Rendre visible."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "50386729-d90a-4cc4-b3b3-f7524e91a19b",
                                "sense_id": "da10a8a6-6334-335e-a21b-7d0168a3460b",
                                "text": "Pour mettre un savoir au clair, il faut le désensacher, il faut l’étaler, il faut le partager avec autrui, il faut le discuter sur le plan de la représentation relationnelle à deux dimensions."
                            }
                        ]
                    }
