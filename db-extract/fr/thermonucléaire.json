                        ],
                        "form": "thermonucléaires"
                    },
                    {
                        "form_id": "b55164b6-4d5e-44f8-ac69-5add7d48f669",
                        "entry_id": "fb831a37-ccc4-3c70-9717-9f74ba838582",
                        "tags": [],
                        "form": "thermo-nucléaire"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4fa517a8-2b71-397f-9581-c71b4e9deb70",
                        "entry_id": "fb831a37-ccc4-3c70-9717-9f74ba838582",
                        "glosses": [
                            "Relatif à la fusion de noyaux atomiques à des températures élevées."
                        ],
                        "tags": [
                            "Nucléaire"
                        ],
                        "examples": [
                            {
                                "example_id": "f78cf526-637c-4839-bffd-c8cc8c36a653",
                                "sense_id": "4fa517a8-2b71-397f-9581-c71b4e9deb70",
                                "text": "La fusion thermonucléaire ou fusion nucléaire est un processus où deux noyaux atomiques s’assemblent pour former un noyau plus lourd, processus à l’œuvre de manière naturelle dans le soleil et la plupart des étoiles de l’univers ^([1])."
                            },
                            {
                                "example_id": "218f5afa-b350-4162-8bf6-2fd6acd3a978",
                                "sense_id": "4fa517a8-2b71-397f-9581-c71b4e9deb70",
                                "text": "Dans les conditions actuelles, seule la fission des noyaux lourds est mise à contribution, puisque la fusion thermonucléaire de noyaux légers n’est pas encore maîtrisée."
                            }
                        ]
                    },
                    {
                        "sense_id": "dcfa02ad-3c1e-3c68-945f-d888ebd5d6f0",
                        "entry_id": "fb831a37-ccc4-3c70-9717-9f74ba838582",
                        "glosses": [
                            "Relatif à l’utilisation des armes atomiques basées sur la fusion nucléaire, en particulier par opposition à celles fondées sur la fission."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ea94d46-44df-4a57-bb2c-c0da1e93c68d",
                                "sense_id": "dcfa02ad-3c1e-3c68-945f-d888ebd5d6f0",
                                "text": "Une ogive thermonucléaire."
                            },
                            {
                                "example_id": "e7ccaa9b-79d0-4d6f-b8c2-7fc0d959d849",
                                "sense_id": "dcfa02ad-3c1e-3c68-945f-d888ebd5d6f0",
                                "text": "La complexité des phénomènes physiques mis en jeu lors d’une explosion de bombe à fission et de bombe thermonucléaire dépasse largement les possibilités actuelles d’en calculer théoriquement les effets avec précision."
                            },
                            {
                                "example_id": "d5baafda-7949-42f4-ad64-3f4cd7d7c728",
                                "sense_id": "dcfa02ad-3c1e-3c68-945f-d888ebd5d6f0",
                                "text": "Lapinot - La compassion est ce qui sépare l'homme de l'animal, Richard...\nRichard - Ah bon ?... Je croyais que c'était la capacité à faire la guerre thermonucléaire..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d2b1009-fd5b-4fb8-96dc-6401c9e5cc6c",
                        "source_entry_id": "fb831a37-ccc4-3c70-9717-9f74ba838582",
                        "source_sense_description": "Relatif à la fusion de noyaux atomiques à des températures élevées",
                        "target_lang_word": "thermonuclear",
