                                                "example_id": "aa077e48-f9f6-40a6-8416-80aedb2bfd8c",
                                                "sense_id": "23370d64-8188-31d8-86ce-35a288b36cae",
                                                "text": "Sauerkraut gilt als typisch deutsches Gericht, ist aber auch in anderen Ländern bekannt und beliebt."
                                            },
                                            {
                                                "example_id": "136888df-28f3-480a-b9bc-b269f77f3553",
                                                "sense_id": "23370d64-8188-31d8-86ce-35a288b36cae",
                                                "text": "Mit etwas Kümmel wird auch Sauerkraut bekömmlich."
                                            },
                                            {
                                                "example_id": "bffb7854-34e7-45a6-924b-6c80079fbc05",
                                                "sense_id": "23370d64-8188-31d8-86ce-35a288b36cae",
                                                "text": "„In Deutschland gibt es Sauerkraut, Haxe und Kohlsuppe.“"
                                            },
                                            {
                                                "example_id": "64e43947-46e5-4ffe-9d59-84838655a55c",
                                                "sense_id": "23370d64-8188-31d8-86ce-35a288b36cae",
                                                "text": "„In der Vorstellung auswärtiger Karikaturisten ißt der Deutsche nur Sauerkraut und nichts als Sauerkraut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
