                        "entry_id": "80acacae-7c19-304c-815a-e9a571d87b41",
                        "glosses": [
                            "od zodiak"
                        ],
                        "tags": [
                            "adjective"
                        ],
                        "examples": [
                            {
                                "example_id": "67f6d597-b83f-4381-acdc-4b61fb7e7d04",
                                "sense_id": "6a5a716c-66d3-3bb6-b219-7ca0284a4314",
                                "text": "Przeważały znaki zodiakalne, pentagramy i heksagramy, nie brakowało spiral i tetraktysów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf4268d8-2fd5-4e65-b82a-7e979a1c6327",
                        "source_entry_id": "80acacae-7c19-304c-815a-e9a571d87b41",
                        "source_sense_id": "6a5a716c-66d3-3bb6-b219-7ca0284a4314",
                        "target_lang_word": "zodiacal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zodiacal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15c135f4-1cda-3ca9-be71-ec11df9d2b9a",
                                        "entry_id": "21157a71-36d1-3980-8537-5c4fb7aa4829",
                                        "glosses": [
                                            "Of or pertaining to the zodiac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5716980-9ba0-4739-a208-e41c03302d7b",
                                                "sense_id": "15c135f4-1cda-3ca9-be71-ec11df9d2b9a",
                                                "text": "[…] in some passages of the Old Testament they think they discover the Zodiacal course of the Sun […]"
                                            },
                                            {
                                                "example_id": "98df22f0-ad00-4be8-808b-674cd3d1844a",
                                                "sense_id": "15c135f4-1cda-3ca9-be71-ec11df9d2b9a",
                                                "text": "For several evenings the pale twinkling of the somber zodiacal stars lighted up the west side of the heavens for some time after the sun had set."
                                            },
                                            {
                                                "example_id": "7d198725-bc8e-403f-99ca-011c0fa676eb",
                                                "sense_id": "15c135f4-1cda-3ca9-be71-ec11df9d2b9a",
                                                "text": "She knew by heart everyone’s Zodiacal sign."
                                            },
                                            {
                                                "example_id": "8cb5f37b-0934-4a9a-817b-8e9784e50f70",
                                                "sense_id": "15c135f4-1cda-3ca9-be71-ec11df9d2b9a",
                                                "text": "In the zodiacal procession of the poles, the 25,920-year cycle, Lascaux is the time of Virgo, and Virgo is associated with artistic excellence and discrimination."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0dc923a-0675-4e83-8f59-5257d31b67c3",
                        "source_entry_id": "80acacae-7c19-304c-815a-e9a571d87b41",
                        "source_sense_id": "6a5a716c-66d3-3bb6-b219-7ca0284a4314",
                        "target_lang_word": "zodiakální",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "48bf937c-0ccb-44f4-bf6b-05a04596216e",
                        "source_entry_id": "80acacae-7c19-304c-815a-e9a571d87b41",
                        "source_sense_id": "6a5a716c-66d3-3bb6-b219-7ca0284a4314",
                        "target_lang_word": "zodiacal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zodiacal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5fafa37f-3a38-3bef-9af1-6f95be6c1477",
                                        "entry_id": "5f72828e-1534-3b0a-ade1-a6918c664d27",
                                        "glosses": [
                                            "Relatif au zodiaque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a2da938-6628-42e0-bb00-e393efac4efa",
                                                "sense_id": "5fafa37f-3a38-3bef-9af1-6f95be6c1477",
                                                "text": "Les étoiles qui se trouvent sur la route du Soleil, ou à peu près, c’est-à-dire les étoiles zodiacales, paraissent, le soir, se plonger successivement dans les rayons du Soleil, lorsque cet astre vient de se coucher, et paraissent ensuite se dégager, le matin, de ses rayons, quelques instants avant son lever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26673403-b34b-3101-a1bf-eb5dab33cd14",
                                        "entry_id": "5f72828e-1534-3b0a-ade1-a6918c664d27",
                                        "glosses": [
                                            "Qualifie la lueur blanche en forme de cône, que l’on observe, après le coucher du soleil et avant son lever, dans le plan de l’écliptique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed7066f6-2265-4d00-a283-a073f3afcac2",
                                                "sense_id": "26673403-b34b-3101-a1bf-eb5dab33cd14",
                                                "text": "En expérimentant, comme je viens de le dire, sur la lumière zodiacale à l’est et à l’ouest, je n’ai pu distinguer aucune trace de polarisation. J’ai depuis répété plusieurs fois la même observation sur la partie la plus brillante de la lumière zodiacale avant le lever et après le coucher du soleil, et j’ai trouvé le même résultat. Je crois donc pouvoir affirmer que la lumière zodiacale n’est pas polarisée, même lorsqu’on la voit sous l’équateur dans son plus vif éclat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37be8b66-f962-3f01-9784-96e8a5c508cb",
                                        "entry_id": "5f72828e-1534-3b0a-ade1-a6918c664d27",
                                        "glosses": [
                                            "Relatif aux classifications de l’horoscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a44729c7-e7a4-4840-a4b4-61d652a5cb52",
                                                "sense_id": "37be8b66-f962-3f01-9784-96e8a5c508cb",
                                                "text": "Votre Sérénité, concentrez-vous bien, et dites-moi, je vous prie, quel est le signe zodiacal de Monsieur ?"
                                            },
                                            {
                                                "example_id": "59a19cfb-c3f9-420b-8625-5410a38fed5f",
                                                "sense_id": "37be8b66-f962-3f01-9784-96e8a5c508cb",
                                                "text": "Si la divination astrologique fonctionne, c'est précisément parce que nous ne sommes pas réellement libres d'agir de manière autonome, nos mouvements étant contrôlés par des orbites astrales déviées : il est donc possible de tracer une carte zodiacale du corps humain et de connaître l'influence de chaque planète sur nos membres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
