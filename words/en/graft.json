                {
                    "sense_id": "3cc173bb-c4d3-3d90-b11c-da658af63ce3",
                    "sense_definition": "to join one thing to another in a way that creates a close or permanent union",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "union",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect tried to <w>graft</w> a modern glass extension onto the historic stone building.",
                            "target_lang_translations": {
                                "ru": "Архитектор попытался <w>привить</w> современную стеклянную пристройку к историческому каменному зданию."
                            }
                        },
                        {
                            "text": "The director managed to <w>graft</w> a romantic subplot onto the action movie quite seamlessly.",
                            "target_lang_translations": {
                                "ru": "Режиссеру удалось довольно органично <w>вплести</w> романтическую линию в боевик."
                            }
