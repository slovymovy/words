                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "24b51b34-6385-480a-8874-372b8d383f47",
                                "sense_id": "d3a58412-00de-3e51-857d-e74072ec7145",
                                "text": "Weil sie eine Ja-Sagerin ist, wird sie immer wieder unterdrückt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "13784cd0-37fd-36c2-9bba-ec34574e1a4a",
                        "entry_id": "6520cb77-c44e-3b56-b514-e6b0a5a27150",
                        "glosses": [
                            "bemerkenswerter (pointierter, lustiger, umstrittener) Ausspruch, Apophthegma; oft als Kompositum mit dem Thema oder der Person geschrieben"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "fc32cece-809b-499e-8a6c-d8beddb84b53",
                                "sense_id": "13784cd0-37fd-36c2-9bba-ec34574e1a4a",
                                "text": "Diesen Sager kann ich nicht nachvollziehen."
                            },
                            {
                                "example_id": "921d0e3b-d023-453e-a7d5-20097871d056",
                                "sense_id": "13784cd0-37fd-36c2-9bba-ec34574e1a4a",
                                "text": "Außenminister Franco Frattini hat sich in einem Schreiben an die Österreichische Nationalratspräsidentin Barbara Prammer über den Südtirol-Sager des Dritten Nationalratspräsidenten Martin Graf beschwert. (Sager über das Thema Südtirol.)"
                            },
                            {
                                "example_id": "dbe4a0d2-092f-4cb1-96fc-5b7a70b516c7",
                                "sense_id": "13784cd0-37fd-36c2-9bba-ec34574e1a4a",
                                "text": "Die wahlkämpfende niederösterreichische ÖVP nutzt den Gusenbauer-Sager nun für ihre Zwecke. (Sager von Herrn Gusenbauer.)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
