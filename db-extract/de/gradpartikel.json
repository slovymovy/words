                        "sense_id": "ad5dbd88-7c31-3d58-84f5-a4f1b2faa1ff",
                        "entry_id": "4f2683b9-17c9-3f05-9dbf-796042881260",
                        "glosses": [
                            "Adverbe de degré, graduant un adjectif ou un verbe (cf. note)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e37b7f4e-2f21-4991-bee7-4c20609075be",
                                "sense_id": "ad5dbd88-7c31-3d58-84f5-a4f1b2faa1ff",
                                "text": "Einige wenige Gradpartikeln lassen sich steigern: sehr - mehr - am meisten; wenig - weniger - am wenigsten.",
                                "translation": "Quelques adverbe de degré peuvent être gradués : très - plus - le plus ; peu - moins - le moins."
                            }
                        ]
                    }
