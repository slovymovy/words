                                "target_senses": [
                                    {
                                        "sense_id": "2ad98b5f-ce15-34f8-8e60-f5e56ce62a5a",
                                        "entry_id": "1f74df1c-872a-3a9e-8581-d18e0742f395",
                                        "glosses": [
                                            "An instinct or intuition; an immediate or basic feeling or reaction without a logical rationale."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16a51060-5f69-4118-9ccb-8be59f08482b",
                                                "sense_id": "2ad98b5f-ce15-34f8-8e60-f5e56ce62a5a",
                                                "text": "Don't think too hard about the answers to a personality test; just go with your gut feeling."
                                            },
                                            {
                                                "example_id": "a7f78cad-4bfe-4c49-8870-ed148e663629",
                                                "sense_id": "2ad98b5f-ce15-34f8-8e60-f5e56ce62a5a",
                                                "text": "Houston had a gut feeling he was being followed, so he hurried to his car."
                                            },
                                            {
                                                "example_id": "193b6e44-2f84-44c5-ad2d-bd17f8c98a12",
                                                "sense_id": "2ad98b5f-ce15-34f8-8e60-f5e56ce62a5a",
                                                "text": "“At the root are these moral intuitions — these gut feelings — and they are very strong,” said Jeff Huntsinger, a social psychologist at Loyola University Chicago who studies emotion and decision-making and collaborated with Dr. Omer’s team."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
