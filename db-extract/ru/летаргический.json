                                "target_senses": [
                                    {
                                        "sense_id": "6463691f-9746-31cf-b492-a5297072e2e9",
                                        "entry_id": "8df0c311-3680-3141-8cf8-0b4d1c8a6e44",
                                        "glosses": [
                                            "te slaapzuchtig, duf en inactief"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7e44423-0540-454d-85d5-bec1a3df237a",
                                                "sense_id": "6463691f-9746-31cf-b492-a5297072e2e9",
                                                "text": "Warhaus geeft een donkere twist aan de seventieschansons van Gainsbourg en de lethargische woordenstroom van Cohen. Live zet de band vooral in op bezwerende grooves, zoals in het instrumentale ‘Beaches’. Bij ‘Here I stand’ leek het alsof we in ‘Theme from turnpike’ van dEUS verzeild waren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97e33123-cbd6-30d4-a3d2-a36adb8fbf83",
                                        "entry_id": "8df0c311-3680-3141-8cf8-0b4d1c8a6e44",
                                        "glosses": [
                                            "heel onverschillig en inactief zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "216dc6d7-27c7-4441-9207-f6f930ca05dc",
                                                "sense_id": "97e33123-cbd6-30d4-a3d2-a36adb8fbf83",
                                                "text": "Net zoals veel mensen weet De Breij ook niet goed wat ze aan moet met de beangstigende verhalen die elke dag de nieuwssites en kranten vullen. ,,Er zitten op dit moment meer enge machthebbers in het zadel dan ooit eerder in het recente verleden: Kim Jong-un, Erdogan, Trump, Poetin. We worden er allemaal lethargisch van. We lezen berichten over homokampen in Tsjetsjenië en veel mensen vinden dat niet eens meer gek.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
