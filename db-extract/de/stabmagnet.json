                "senses": [
                    {
                        "sense_id": "16ee25c6-8e28-37a4-a01f-0239bed03695",
                        "entry_id": "4bd967b2-b8af-3118-9b3c-19373c342f01",
                        "glosses": [
                            "Magnet in Form eines Stabes; stabförmiger Magnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "583f1a50-b68f-432c-adfa-2c8db9332535",
                                "sense_id": "16ee25c6-8e28-37a4-a01f-0239bed03695",
                                "text": "„Im Normalfall sieht es so aus, als wäre die Erdachse ein Stabmagnet.“"
                            },
                            {
                                "example_id": "35680fdb-67ae-46fd-9981-222ee1dcba20",
                                "sense_id": "16ee25c6-8e28-37a4-a01f-0239bed03695",
                                "text": "„„Das Erdmagnetfeld ist in Wirklichkeit etwas komplizierter als der große Stabmagnet, den man sich im Innern des Globus vorstellt“, sagt der Geophysiker Lühr, zugleich Projektleiter für „Swarm“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
