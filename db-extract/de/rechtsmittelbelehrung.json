                        "examples": [
                            {
                                "example_id": "8da81c78-67b2-49df-9822-7c605903e2f5",
                                "sense_id": "564a15d2-65c5-321d-9858-357324def17a",
                                "text": "„In Abgrenzung zur Rechtsmittelbelehrung wird Rechtsbehelfsbelehrung (dann im engeren Sinn) auch die Rechtsbehelfsbelehrung im weiteren Sinn genannt, die andere Rechtsbehelfe als Rechtsmittel betrifft.“"
                            },
                            {
                                "example_id": "f5696750-f166-46f9-ad7d-a1bb1966ba5c",
                                "sense_id": "564a15d2-65c5-321d-9858-357324def17a",
                                "text": "„Jeder Bescheid ist ausdrücklich als solcher zu bezeichnen und hat den Spruch und die Rechtsmittelbelehrung zu enthalten.“"
                            }
                        ],
