                    {
                        "translation_id": "f30632ec-1c8d-4d63-af36-4d973aa7412e",
                        "source_entry_id": "e04dfda3-9386-36ab-bc6e-650b0d24540a",
                        "source_sense_id": "cf1f4ebe-a3de-39da-afac-62077552ea1f",
                        "source_sense_description": "hulpmiddel om bij te houden waar iemand is tijdens het lezen van een boek",
                        "target_lang_word": "Lesezeichen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lesezeichen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22b0cd5f-0f6f-3d99-b2eb-a77fb4a6fe3b",
                                        "entry_id": "828f056e-6b50-37b3-93af-bcd05fb65ec2",
                                        "glosses": [
                                            "ein flaches Objekt, das in ein Buch gelegt wird, um eine bestimmte Seite schnell zu finden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6355eaef-c4a5-4a5b-b94e-9acce5542450",
                                                "sense_id": "22b0cd5f-0f6f-3d99-b2eb-a77fb4a6fe3b",
                                                "text": "Mein Lesezeichen befindet sich auf Seite 21."
                                            },
                                            {
                                                "example_id": "6a43773c-0dc9-40b9-bff5-42c10005b9ba",
                                                "sense_id": "22b0cd5f-0f6f-3d99-b2eb-a77fb4a6fe3b",
                                                "text": "„Es lag einfach so zwischen zwei Seiten, wie ein Lesezeichen.“"
                                            },
                                            {
                                                "example_id": "6b394a8b-3f5d-4e77-898e-7c4b12c85660",
                                                "sense_id": "22b0cd5f-0f6f-3d99-b2eb-a77fb4a6fe3b",
                                                "text": "„Aus dem Inhalt der Lesezeichen geht zudem unzweifelhaft hervor, dass Steinberg, was auch den späteren Verbleib der Handschrift erklärt, ihr Besitzer gewesen sein muss.“"
                                            },
                                            {
                                                "example_id": "358609cc-cb5c-4784-8906-ac5ca6c14884",
                                                "sense_id": "22b0cd5f-0f6f-3d99-b2eb-a77fb4a6fe3b",
                                                "text": "„Neben mir das Tagebuch mit dem Lesezeichen auf dem Nachttisch, genauso, wie ich es neben den Wecker gelegt habe.“"
                                            },
                                            {
                                                "example_id": "d7bf6b67-b28b-475f-8fd9-58807b04480a",
                                                "sense_id": "22b0cd5f-0f6f-3d99-b2eb-a77fb4a6fe3b",
                                                "text": "„In diese Schriftstücke waren Hunderte von bunten Lesezeichen geklemmt, die in den Windwellen der Ventilatoren raschelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e9316943-0737-32f8-834d-b741853194dd",
                                        "entry_id": "828f056e-6b50-37b3-93af-bcd05fb65ec2",
                                        "glosses": [
                                            "ein zugänglich platzierter Hyperlink innerhalb eines Programms, insbesondere eines Internetbrowsers, der meist vom Anwender erstellt werden kann und zum schnellen Auffinden bestimmter Inhalte (zum Beispiel von Internetseiten) dient"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
