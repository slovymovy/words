                        "glosses": [
                            "Relatif à l’algologie, l'étude de la douleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83bd73f5-de33-4778-a45f-144a50a49eab",
                                "sense_id": "60fbd088-087c-3575-9875-52f8daba156d",
                                "text": "Il allait découvrir dans cet ouvrage l'intérêt de l'approche algologique, et les nombreuses similitudes entre celle-ci et sa propre pratique qui intégrait les composantes physique, psychologique et sociale de la douleur."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbb869db-e471-374b-add2-6fd286176570",
                        "entry_id": "4182d7ae-5d3f-3eb1-a37c-8c2b2ab02ed8",
                        "glosses": [
                            "Relatif à l’algologie, l'étude des algues."
