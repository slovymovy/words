                    {
                        "translation_id": "03548523-5131-417d-8201-6cd7a6d2cebf",
                        "source_entry_id": "237fb0ec-39db-3cf7-a770-c638587c14cf",
                        "target_lang_word": "long-distance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "long-distance",
