                    "sense_id": "a6181780-22f2-3c06-9da5-e9ce331820f9",
                    "sense_definition": "The tail of cattle used as food, typically braised or stewed in rich dishes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "culinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ordered a warm bowl of <w>oxtail</w> soup at the restaurant.",
                            "target_lang_translations": {
                                "pl": "Zamówiła w restauracji miskę ciepłej zupy z <w>ogona wołowego</w>."
                            }
                        },
                        {
                            "text": "The chef prepared tender braised <w>oxtail</w> served with mashed potatoes.",
                            "target_lang_translations": {
                                "pl": "Szef kuchni przygotował delikatny, duszony <w>ogon wołowy</w> podawany z puree ziemniaczanym."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oxtail soup",
                        "braised oxtail",
                        "stewed oxtail"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ogon bydła wykorzystywany jako składnik kulinarny, zazwyczaj duszony lub gotowany na gęste zupy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ogon wołowy",
                                "target_lang_sense_clarification": "w kuchni"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8285a483-b686-3385-af38-67137acceaf3",
                    "sense_definition": "The tail of an ox, cow, or bull.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cow used its <w>oxtail</w> to swat away flies in the summer heat.",
                            "target_lang_translations": {
                                "pl": "W letnim upale krowa odganiała muchy swoim <w>ogonem</w>."
                            }
                        },
                        {
                            "text": "A long <w>oxtail</w> hung down behind the resting animal.",
                            "target_lang_translations": {
                                "pl": "Długi <w>ogon</w> zwisał za odpoczywającym zwierzęciem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
