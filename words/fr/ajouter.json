{
    "word_family": [
        "ajout",
        "rajout",
        "rajouter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7c50e10-1cdd-3f95-85b5-39c3faf32029",
                    "sense_definition": "Mettre une chose en plus d'une autre pour former un tout ou augmenter une quantité.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>ajouter</w> un peu de sel dans la soupe."
                        },
                        {
                            "text": "N'<w>ajoutez</w> pas trop de sucre dans votre café."
                        }
                    ],
                    "synonyms": [
                        "additionner",
                        "joindre"
                    ],
                    "antonyms": [
                        "enlever",
                        "retirer",
                        "soustraire"
                    ],
                    "common_phrases": [
                        "ajouter du sel",
                        "ajouter un ingrédient"
                    ]
                },
                {
                    "sense_id": "8ddd19b1-6fdc-348a-9b19-8f3671bd7dc1",
                    "sense_definition": "Dire ou écrire quelque chose en plus pour compléter ce qui a été dit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de terminer la réunion, elle <w>ajoute</w> quelques remarques importantes."
                        },
                        {
                            "text": "« Je serai là demain », <w>ajouta</w>-t-il avec un grand sourire."
                        }
                    ],
                    "synonyms": [
                        "préciser",
                        "poursuivre"
                    ],
                    "common_phrases": [
                        "ajouter un commentaire",
                        "ajouter un mot"
                    ]
                },
                {
                    "sense_id": "55d87087-ab15-3a50-be14-6c421926a9a3",
                    "sense_definition": "Venir en plus, s'additionner ou se combiner avec d'autres éléments.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nouveaux problèmes s'<w>ajoutent</w> à une situation déjà compliquée."
                        },
                        {
                            "text": "Cette dépense imprévue s'<w>ajoute</w> à nos factures du mois."
                        }
                    ],
                    "synonyms": [
                        "s'additionner",
                        "se cumuler"
                    ],
                    "common_phrases": [
                        "s'ajouter à la liste",
                        "s'ajouter aux difficultés"
                    ]
                },
                {
                    "sense_id": "f01607b1-7ce1-317d-b208-668f6a24bf9e",
                    "sense_definition": "Accroître ou renforcer une impression, un effet ou un sentiment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "augmentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le silence de la nuit ne fait qu'<w>ajouter</w> au mystère des lieux."
                        },
                        {
                            "text": "Ces détails historiques <w>ajoutent</w> un intérêt particulier au récit."
                        }
                    ],
                    "synonyms": [
                        "accroître",
                        "renforcer"
                    ],
                    "antonyms": [
                        "atténuer",
                        "diminuer"
                    ],
                    "common_phrases": [
                        "ajouter au charme",
                        "ajouter au mystère"
                    ]
                },
                {
                    "sense_id": "5fd9fd14-cf70-3eb9-b969-cac1c9900814",
                    "sense_definition": "Amplifier la vérité en inventant ou en exagérant des faits.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En racontant ses aventures passées, il <w>ajoute</w> toujours beaucoup à la réalité."
                        },
                        {
                            "text": "Ne croyez pas tout ce qu'elle dit, elle a tendance à <w>ajouter</w> aux faits réels."
                        }
                    ],
                    "synonyms": [
                        "broder",
                        "exagérer"
                    ]
                }
            ]
        }
    ]
}