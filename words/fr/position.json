                    "frequency": "High",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le porte-parole a clairement expliqué la <w>position</w> du gouvernement sur cette réforme."
                        },
                        {
                            "text": "Chacun a pu défendre sa <w>position</w> au cours de ce débat animé."
