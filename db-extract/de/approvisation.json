                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "94bb2eb9-9b80-4727-a021-5ce03deed180",
                                "sense_id": "0ab3d94e-a30c-34a2-a108-cc68147d5e2d",
                                "text": "„Den größten Vortheil hätte die Stadtverwaltung selbst davon, weil ein sehr bedeutender Theil der Approvisation der Stadt dadurch auf die vollkommenste Weise gesichert wäre.“"
                            },
                            {
                                "example_id": "f9f55aca-288c-423c-aa53-7f3166f3d61d",
                                "sense_id": "0ab3d94e-a30c-34a2-a108-cc68147d5e2d",
                                "text": "„Es wird vorgeschlagen, dass die Vertreter der Gesundheitsabteilung ein genaues Memorandum über die Approvisation der Spitäler abliefern sollen; der Judenrat soll es beim Kreisbauernamt verwenden.“"
                            }
                        ],
