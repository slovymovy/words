                            {
                                "example_id": "73d6db4e-f580-488d-bd93-9efec6e9f5aa",
                                "sense_id": "523592b9-de90-328a-bbae-7d4dbd5c28c0",
                                "text": "Beursbedrijf Euronext besloot de opening een half uur op te schuiven. Het euvel was snel verholpen en om 09.30 uur kon de handel van start gaan. Andere Euronext-beurzen, zoals die in Parijs, Brussel en Lissabon kampten met hetzelfde probleem."
                            }
