                "senses": [
                    {
                        "sense_id": "df7801f9-7a62-3213-a4e0-72d2e8809682",
                        "entry_id": "fea79118-8db5-3683-a118-bdd2f8aa8659",
                        "glosses": [
                            "Greffer en pratiquant une auto-greffe (le receveur est aussi le donneur)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24900af4-b220-4889-8b71-b9acee576151",
                                "sense_id": "df7801f9-7a62-3213-a4e0-72d2e8809682",
                                "text": "Tous les trois sont envoyés sans traîner au bloc opératoire pour tenter de les autogreffer."
                            },
                            {
                                "example_id": "e92f7cb6-c018-4e8a-baaa-23a6aa38b1cf",
                                "sense_id": "df7801f9-7a62-3213-a4e0-72d2e8809682",
                                "text": "Justement, on ne peut pas s’autogreffer."
                            },
                            {
                                "example_id": "20b74ac9-23fa-46f0-b390-8b02dbd6bfdb",
                                "sense_id": "df7801f9-7a62-3213-a4e0-72d2e8809682",
                                "text": "Certaines personnes ont même essayé de s’autogreffer à la maison, mais c’est une procédure que je vous déconseille vivement."
                            }
                        ]
                    }
