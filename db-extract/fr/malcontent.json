                "senses": [
                    {
                        "sense_id": "3000bb34-d894-36c7-81fa-970c903266ff",
                        "entry_id": "0cfc2708-9a41-3197-8c81-4fd31496d75f",
                        "glosses": [
                            "Personne mécontente."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "0f5374e8-7965-45a4-8411-99c6804141bf",
                                "sense_id": "3000bb34-d894-36c7-81fa-970c903266ff",
                                "text": "Un grincheux, un aigri, un malcontent."
                            },
                            {
                                "example_id": "8af4869c-71e9-4a6f-942d-ed70bde003dd",
                                "sense_id": "3000bb34-d894-36c7-81fa-970c903266ff",
                                "text": "La société s'accommode assez bien de ses pauvres, aussi longtemps qu'elle peut absorber les malcontents soit dans les hôpitaux, soit dans les prisons. Lorsque la proportion des malcontents s'augmente dangereusement, elle appelle ses gendarmes et ouvre en plein ses cimetières."
                            }
                        ]
                    }
                ],
