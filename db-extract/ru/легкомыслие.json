                    {
                        "form_id": "cd2bfb98-6b84-40e6-ade8-e3a8f046e849",
                        "entry_id": "1081a48b-daf1-32a2-bf30-6c460f9fc00c",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "легкомы́слиях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9ab639ba-d1c2-39fb-a27e-afb31372cffb",
                        "entry_id": "1081a48b-daf1-32a2-bf30-6c460f9fc00c",
                        "glosses": [
                            "необдуманность, несерьёзность, опрометчивость в словах и поступках"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db40d1b4-b0e4-4268-91ba-e43b1521c881",
                                "sense_id": "9ab639ba-d1c2-39fb-a27e-afb31372cffb",
                                "text": "…Я просто спешил прожить день до вечера; зато ночью я спал… детское легкомыслие мне помогало."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b6a9795-cbee-3964-bcb1-605d743256ca",
                        "entry_id": "1081a48b-daf1-32a2-bf30-6c460f9fc00c",
                        "glosses": [
                            "отсутствие моральной твёрдости, строгости в поведении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff15d3c7-9229-42d2-b835-0f929217a4ef",
                                "sense_id": "8b6a9795-cbee-3964-bcb1-605d743256ca",
                                "text": "Ничто не могло сравниться с вольным легкомыслием, безумством и роскошью французов того времени."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d5d4904-20c9-4f81-a92e-63023014c670",
                        "source_entry_id": "1081a48b-daf1-32a2-bf30-6c460f9fc00c",
                        "source_sense_description": "необдуманность",
                        "target_lang_word": "Leichtsinn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leichtsinn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                        "entry_id": "8e4a3488-b732-384a-af21-c6ccec03346d",
                                        "glosses": [
                                            "Mangel an Vorsicht und Überlegung beim Handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47f6d732-d8a4-41dc-8a85-3eddf4d357c7",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "Wahrscheinlich war es tödlicher Leichtsinn beim Überholen, der am Sonntagabend einen 31-jährigen Heidelberger das Leben kostete."
                                            },
                                            {
                                                "example_id": "ea07347b-1659-43e5-bb70-b26b7a74cb37",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "Der Leichtsinn ist ein Schwimmgürtel für den Strom des Lebens. (Ludwig Börne)"
                                            },
                                            {
                                                "example_id": "e9b0731e-088c-4926-ab54-ecca946a64eb",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "„Bei mir war es Leichtsinn und das wohlige Gefühl, meinem Körper etwas Gutes getan und somit etwas Nützliches geleistet zu haben.“"
                                            },
                                            {
                                                "example_id": "ce027ee3-2ad3-421c-97fe-b122506baa94",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "„Es ist weniger Galgenhumor als Leichtsinn und vielleicht Unkenntnis der Sachlage.“"
                                            },
                                            {
                                                "example_id": "8715f2b0-f4ec-4397-8ae2-27b93dee9d72",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "„Man möge mich nicht des Leichtsinns im Studium meines Tagebuches beschuldigen, mit Gewissenhaftigkeit entziffere ich die dunklen Stellen und freue mich wie jeder andere Gelehrte, wenn ich das Richtige herausfinde.“"
                                            },
                                            {
                                                "example_id": "eab4ad4e-7158-4fd0-ae27-2068f96a02d7",
                                                "sense_id": "1731c294-60f8-3cde-8373-92f8d48320cb",
                                                "text": "„Wenn unerfahrene Bergsportler die falsche Route wählen oder dem sicheren Weg das steile Gelände vorziehen, arbeitet der Leichtsinn der Technik entgegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
