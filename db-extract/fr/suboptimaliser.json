                                "example_id": "684361fa-deac-43c8-ac12-6c98547cc761",
                                "sense_id": "f0848e65-5237-33e4-8844-822eb9252662",
                                "text": "Le transfert des usages de la vie publique dans la sphère économique limite l’application des droits de propriété et \"suboptimalise\" les décisions des dirigeants."
                            }
                        ]
