                                        "entry_id": "c3f1c7bd-4099-30d6-b186-c19cb7d7d0da",
                                        "glosses": [
                                            "Kur'an'da önerilen ve Peygamber'in hayatında uygulamaları görülen hayat tarzını yaşama gayreti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95648b56-042b-44e3-aab7-8b7ddcd474ec",
                                                "sense_id": "3dd60413-2ce8-3ba4-8830-5741738dbb40",
                                                "text": "Tasavvuf tarîki, nefsi ayıklayıp temizlemek ve rûhu pâk ederek lâhut âlemine yükselmek yoludur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70c49416-3648-3562-9eb8-80607f4ab453",
                                        "entry_id": "c3f1c7bd-4099-30d6-b186-c19cb7d7d0da",
                                        "glosses": [
                                            "Allah'ın vasıflarını ve Kâinat'ın oluşumunu varlık birliği anlayışıyla açıklayan dinî ve felsefî akım"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4a1e7fd-b664-492b-afa7-7baa13bfd61b",
                                                "sense_id": "70c49416-3648-3562-9eb8-80607f4ab453",
                                                "text": "Bu dil derindir ve birçok tasavvuf deyimleri ile zengindir de!"
