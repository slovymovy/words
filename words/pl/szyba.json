                    "frequency": "High",
                    "semantic_group_id": "szkło",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas wczorajszej burzy silny wiatr rozbił <w>szybę</w> w oknie.",
                            "target_lang_translations": {
                                "ru": "Во время вчерашней бури сильный ветер разбил <w>стекло</w> в окне."
                            }
                        },
                        {
                            "text": "Kierowca musiał dokładnie wyczyścić przednią <w>szybę</w> przed wyruszeniem w długą trasę.",
                            "target_lang_translations": {
                                "ru": "Водителю пришлось тщательно очистить лобовое <w>стекло</w> перед отправлением в дальнюю дорогу."
