{
    "word_family": [
        "look",
        "lookout",
        "overlook"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f67f55ea-fc43-38f8-b4b9-4a820a1be3bd",
                    "sense_definition": "A person's general attitude or way of thinking about life and the world.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "perspective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite the many challenges she faced, she maintained a positive <w>outlook</w> on life.",
                            "target_lang_translations": {
                                "ru": "Несмотря на множество трудностей, с которыми она столкнулась, она сохраняла позитивный <w>взгляд</w> на жизнь.",
                                "zh": "尽管她遭遇了许多挑战，她依然对生活保持着积极的<w>态度</w>。"
                            }
                        },
                        {
                            "text": "Traveling to different countries can significantly change your <w>outlook</w> on global issues.",
                            "target_lang_translations": {
                                "ru": "Путешествия в разные страны могут значительно изменить ваше <w>мировоззрение</w> в отношении глобальных проблем.",
                                "zh": "去不同国家旅行会显著改变你对全球问题的<w>看法</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attitude",
                        "perspective",
                        "point of view",
                        "viewpoint",
                        "standpoint"
                    ],
                    "common_phrases": [
                        "positive outlook",
                        "outlook on life",
                        "mental outlook"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее отношение человека к жизни и миру или его образ мышления.",
                        "zh": "一个人对生活和世界的总体态度或思维方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взгляд",
                                "target_lang_sense_clarification": "мнение или образ мыслей"
                            },
                            {
                                "target_lang_word": "мировоззрение",
                                "target_lang_sense_clarification": "система взглядов на мир"
                            },
                            {
                                "target_lang_word": "точка зрения",
                                "target_lang_sense_clarification": "позиция, с которой оцениваются события"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "态度",
                                "target_lang_sense_clarification": "对生活、世界或事物的总体态度"
                            },
                            {
                                "target_lang_word": "看法",
                                "target_lang_sense_clarification": "对某类问题的理解和判断"
                            },
                            {
                                "target_lang_word": "观念",
                                "target_lang_sense_clarification": "较系统的人生或世界认识"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1e59a93-9b05-3ffc-aae3-ca514565fad0",
                    "sense_definition": "The likely future situation or the prospect of what is going to happen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "future",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The economic <w>outlook</w> for the next quarter remains uncertain due to rising inflation.",
                            "target_lang_translations": {
                                "ru": "Экономические <w>перспективы</w> на следующий квартал остаются неопределенными из-за растущей инфляции.",
                                "zh": "由于通货膨胀加剧，下一季度的经济<w>前景</w>仍然不明朗。"
                            }
                        },
                        {
                            "text": "The weather <w>outlook</w> suggests that we should expect heavy rain throughout the weekend.",
                            "target_lang_translations": {
                                "ru": "<w>Прогноз</w> погоды указывает на то, что нам следует ожидать сильных дождей в течение всех выходных.",
                                "zh": "天气<w>预报</w>显示，整个周末都可能有大雨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expectation",
                        "prognosis",
                        "prospect"
                    ],
                    "common_phrases": [
                        "economic outlook",
                        "weather outlook",
                        "future outlook"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вероятная ситуация в будущем или прогноз того, что произойдет.",
                        "zh": "未来可能出现的情况，或对将要发生之事的预测。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перспективы",
                                "target_lang_sense_clarification": "будущие возможности или ожидания"
                            },
                            {
                                "target_lang_word": "прогноз",
                                "target_lang_sense_clarification": "предсказание развития событий"
                            },
                            {
                                "target_lang_word": "виды на будущее",
                                "target_lang_sense_clarification": "планы или предположения о будущем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前景",
                                "target_lang_sense_clarification": "未来发展的可能情况"
                            },
                            {
                                "target_lang_word": "展望",
                                "target_lang_sense_clarification": "对未来情况的总体判断"
                            },
                            {
                                "target_lang_word": "预报",
                                "target_lang_sense_clarification": "对天气等情况的预先判断"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6558c8b1-0de6-3f42-b226-de51930c94ea",
                    "sense_definition": "The physical view or scene that can be seen from a particular place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "view",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel room offered a magnificent <w>outlook</w> over the valley and the distant mountains.",
                            "target_lang_translations": {
                                "ru": "Из гостиничного номера открывался великолепный <w>вид</w> на долину и далекие горы.",
                                "zh": "从酒店房间可以看到山谷和远山的壮丽<w>景色</w>。"
                            }
                        },
                        {
                            "text": "From the balcony, there is a pleasant <w>outlook</w> through the wide windows toward the garden.",
                            "target_lang_translations": {
                                "ru": "С балкона через широкие окна открывается приятная <w>панорама</w> сада.",
                                "zh": "从阳台透过宽大的窗户，可以看到花园宜人的<w>景致</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prospect",
                        "overlook"
                    ],
                    "common_phrases": [
                        "magnificent outlook",
                        "pleasant outlook"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический вид или пейзаж, который открывается из определенного места.",
                        "zh": "从某个地方能够看到的实际景象或风景。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вид",
                                "target_lang_sense_clarification": "панорама, открывающаяся взору"
                            },
                            {
                                "target_lang_word": "панорама",
                                "target_lang_sense_clarification": "широкий обзор местности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "景色",
                                "target_lang_sense_clarification": "从某处看到的自然或城市景象"
                            },
                            {
                                "target_lang_word": "景致",
                                "target_lang_sense_clarification": "较书面语，指可欣赏的景物"
                            },
                            {
                                "target_lang_word": "景观",
                                "target_lang_sense_clarification": "从某位置看到的整体景象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa34e534-6afa-3729-8ae4-4d182344cc98",
                    "sense_definition": "A specific place or position from which something can be observed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "view",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers stopped at a hidden <w>outlook</w> perched on the edge of the cliff.",
                            "target_lang_translations": {
                                "ru": "Пешие туристы остановились на скрытой <w>смотровой площадке</w>, расположенной на краю обрыва.",
                                "zh": "徒步者们在悬崖边一个隐蔽的<w>观景台</w>停了下来。"
                            }
                        },
                        {
                            "text": "The tower served as a strategic <w>outlook</w> for monitoring the surrounding forest.",
                            "target_lang_translations": {
                                "ru": "Башня служила стратегическим <w>наблюдательным пунктом</w> для мониторинга окружающего леса.",
                                "zh": "这座塔楼是监视周围森林的战略<w>瞭望点</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vantage point",
                        "overlook"
                    ],
                    "common_phrases": [
                        "scenic outlook"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное место или позиция, с которой можно вести наблюдение.",
                        "zh": "可以观察事物的特定地点或位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наблюдательный пункт",
                                "target_lang_sense_clarification": "место для наблюдения"
                            },
                            {
                                "target_lang_word": "смотровая площадка",
                                "target_lang_sense_clarification": "место с хорошим обзором"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "观景台",
                                "target_lang_sense_clarification": "供观景的地点"
                            },
                            {
                                "target_lang_word": "瞭望点",
                                "target_lang_sense_clarification": "用于观察周围情况的位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "144ca09c-0430-3781-b6ea-db9a52b69565",
                    "sense_definition": "The external appearance or physical look of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The modern <w>outlook</w> of the building contrasts sharply with the traditional houses nearby.",
                            "target_lang_translations": {
                                "ru": "Современный <w>внешний вид</w> здания резко контрастирует с традиционными домами поблизости.",
                                "zh": "这栋建筑的现代<w>外观</w>与附近的传统房屋形成了鲜明对比。"
                            }
                        },
                        {
                            "text": "Some people disliked the <w>outlook</w> of the new car, saying it looked too industrial.",
                            "target_lang_translations": {
                                "ru": "Некоторым не понравился <w>облик</w> нового автомобиля, они говорили, что он выглядит слишком индустриально.",
                                "zh": "有些人不喜欢这辆新车的<w>外形</w>，说它看起来太工业化了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "look out"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Often found in Hong Kong English usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внешний облик или физический вид чего-либо.",
                        "zh": "某物的外部样貌或外在形象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внешний вид",
                                "target_lang_sense_clarification": "наружность объекта"
                            },
                            {
                                "target_lang_word": "облик",
                                "target_lang_sense_clarification": "характерный внешний вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外观",
                                "target_lang_sense_clarification": "物体外部呈现出来的样子"
                            },
                            {
                                "target_lang_word": "外形",
                                "target_lang_sense_clarification": "尤其指车辆、建筑等的形状样式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b683bd6-37c0-33b9-9529-f5928c0957ba",
                    "sense_definition": "To stare at someone so intensely that they are forced to look away; to overcome by staring.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "staring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner attempted to <w>outlook</w> the guard, but eventually had to lower his eyes.",
                            "target_lang_translations": {
                                "ru": "Заключенный попытался <w>переглядеть</w> охранника, но в конце концов был вынужден опустить глаза.",
                                "zh": "囚犯试图<w>瞪退</w>狱警，但最终还是不得不垂下眼睛。"
                            }
                        },
                        {
                            "text": "He tried to <w>outlook</w> his opponent during the negotiation to show his dominance.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>переглядеть</w> своего оппонента во время переговоров, чтобы показать свое превосходство.",
                                "zh": "他试图在谈判中<w>瞪退</w>对手，以显示自己的强势。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outstare",
                        "face down",
                        "browbeat"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пристально смотреть на кого-то, пока тот не отведет глаза; переглядеть.",
                        "zh": "以强烈的注视迫使对方移开目光；通过瞪视压倒对方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переглядеть",
                                "target_lang_sense_clarification": "заставить отвести взгляд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瞪退",
                                "target_lang_sense_clarification": "用逼视迫使对方先移开视线"
                            },
                            {
                                "target_lang_word": "以目光压倒",
                                "target_lang_sense_clarification": "用目光在气势上压过对方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97e99957-6d37-3061-a22f-db32349a0391",
                    "sense_definition": "To face or look in an outward direction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The balcony was <w>outlooking</w> on the piazza, providing a perfect view of the festival.",
                            "target_lang_translations": {
                                "ru": "Балкон <w>выходил</w> на площадь, обеспечивая идеальный вид на фестиваль.",
                                "zh": "阳台<w>朝向</w>广场，可以把节庆景象尽收眼底。"
                            }
                        },
                        {
                            "text": "The old tower had several small windows for <w>outlooking</w> across the sea.",
                            "target_lang_translations": {
                                "ru": "В старой башне было несколько маленьких окон, <w>выходящих</w> на море.",
                                "zh": "这座古塔有几扇小窗，<w>朝向</w>大海。"
                            }
                        }
                    ],
                    "synonyms": [
                        "look out"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly found in historical texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть обращенным или смотреть в наружном направлении.",
                        "zh": "朝向外部，或面朝某个外侧方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходить",
                                "target_lang_sense_clarification": "быть обращенным в сторону чего-либо (об окнах, балконе)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "朝向",
                                "target_lang_sense_clarification": "朝着外面的某个方向"
                            },
                            {
                                "target_lang_word": "面向",
                                "target_lang_sense_clarification": "面朝某处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daa58d31-e717-3444-a3c1-e1fb14250846",
                    "sense_definition": "To surpass someone or something in attractiveness or appearance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In her fine dress, she quite <w>outlooked</w> her sister at the evening ball.",
                            "target_lang_translations": {
                                "ru": "В своем прекрасном платье она совершенно <w>затмила</w> сестру на вечернем балу.",
                                "zh": "她穿着华丽的礼服，在晚会上简直<w>艳压</w>她姐姐。"
                            }
                        },
                        {
                            "text": "The general <w>outlooked</w> his subordinates while mounted on his stately horse.",
                            "target_lang_translations": {
                                "ru": "Генерал <w>выглядел внушительнее</w> своих подчиненных, восседая на своем статном коне.",
                                "zh": "将军骑在高大的马上，显得比部下更<w>出众</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily 18th and 19th century usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Превосходить кого-либо или что-либо по привлекательности или внешнему виду.",
                        "zh": "在外貌、风采或吸引力方面胜过别人或别的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затмевать",
                                "target_lang_sense_clarification": "выглядеть лучше других"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "艳压",
                                "target_lang_sense_clarification": "在外表或吸引力上压过别人"
                            },
                            {
                                "target_lang_word": "出众",
                                "target_lang_sense_clarification": "外貌或气势显得更胜一筹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ac37307-0f0f-3846-9612-76b057e95f07",
                    "sense_definition": "To inspect something thoroughly or to select items.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inspection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before heading to the river, you must <w>outlook</w> all your fishing tackle to ensure it is ready.",
                            "target_lang_translations": {
                                "ru": "Перед тем как отправиться на реку, вы должны <w>осмотреть</w> все свои рыболовные снасти, чтобы убедиться в их готовности.",
                                "zh": "去河边之前，你必须把所有钓具都<w>检查</w>一遍，确保它们已经准备妥当。"
                            }
                        },
                        {
                            "text": "He spent the morning <w>outlooking</w> the best timber for his construction project.",
                            "target_lang_translations": {
                                "ru": "Он провел утро, <w>отбирая</w> лучшую древесину для своего строительного проекта.",
                                "zh": "他整个上午都在<w>挑选</w>最适合他建筑项目的木材。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно осматривать что-либо или отбирать предметы.",
                        "zh": "彻底检查某物，或从中挑选物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осматривать",
                                "target_lang_sense_clarification": "проверять готовность или качество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "检查",
                                "target_lang_sense_clarification": "仔细查看以确认状态或质量"
                            },
                            {
                                "target_lang_word": "挑选",
                                "target_lang_sense_clarification": "从多项中加以挑拣选择"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8597658a-0505-3c0e-9c2b-cde5896f7c34",
                    "sense_definition": "To look beyond a certain limit or boundary.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that one should never <w>outlook</w> the horizon of their own interests.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что никогда не следует <w>взирать поверх</w> горизонта собственных интересов.",
