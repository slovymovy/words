                ],
                "senses": [
                    {
                        "sense_id": "a941d645-8f7d-3a96-9dac-62249fad6316",
                        "entry_id": "0d34789b-4e05-301c-a76e-5388e9853df6",
                        "glosses": [
                            "Rococo, rocaille, à la mode sous Mme de Pompadour, à la mode du XVIIIᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "529d32c1-74a5-4af4-a4a3-ce049dc3a032",
                                "sense_id": "a941d645-8f7d-3a96-9dac-62249fad6316",
                                "text": "Cela est pompadour."
                            },
                            {
                                "example_id": "4a32164e-8dea-4dbd-9fce-d6d16a1e9204",
                                "sense_id": "a941d645-8f7d-3a96-9dac-62249fad6316",
                                "text": "Costume pompadour, costume de femme avec poudre, paniers, fleurs, dentelles et rubans à profusion."
                            },
                            {
                                "example_id": "d697ba7b-bbe0-46ba-b3ba-80f80f2e96f1",
                                "sense_id": "a941d645-8f7d-3a96-9dac-62249fad6316",
                                "text": "Robes à la Pompadour, négligés coquets que la marquise de Pompadour avait inventés."
                            },
                            {
                                "example_id": "92614ac0-2a97-4bd8-8ebd-1ec229fecd4b",
                                "sense_id": "a941d645-8f7d-3a96-9dac-62249fad6316",
                                "text": "Coiffure Pompadour, coiffure consistant à tirer les cheveux vers le haut de manière à dégager le front."
                            },
                            {
                                "example_id": "13f6e605-ab34-4a25-87c1-3b0395d9c74a",
                                "sense_id": "a941d645-8f7d-3a96-9dac-62249fad6316",
                                "text": "Étoffes pompadour, celles sur lesquelles il y a des bouquets de plusieurs couleurs dans lesquelles, généralement, le bleu et le rose dominent, ou à raies ayant des bouquets jetés sur les raies."
                            },
                            {
                                "example_id": "ebed23fd-e431-4198-8bb4-0943ef5ff897",
                                "sense_id": "a941d645-8f7d-3a96-9dac-62249fad6316",
                                "text": "Cet appartement est orné dans le goût pompadour."
                            }
                        ]
                    },
                    {
                        "sense_id": "55830b4c-8460-3254-8965-446770c91aa8",
                        "entry_id": "0d34789b-4e05-301c-a76e-5388e9853df6",
                        "glosses": [
                            "Désigne une certaine manière d'écrire comparée au goût pompadour en fait d'habillement et d'ameublement."
                        ],
                        "tags": [],
                        "examples": []
                    }
