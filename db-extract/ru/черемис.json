                                                "example_id": "cce6c704-6c17-4844-94b2-b717f6d49995",
                                                "sense_id": "5cc06424-00c1-3ef3-9b54-1de481ab69f5",
                                                "text": "He hopped across and went to lift Mari, but she shook her head and jumped over [by] herself."
