                ],
                "senses": [
                    {
                        "sense_id": "32205093-eed5-3c19-9414-615d5452c44d",
                        "entry_id": "354cdede-0f17-36ae-9020-a43810a16ce3",
                        "glosses": [
                            "Umstand, als Paar/Gegensatzpaar aufzutreten/betrachtet zu werden, das Paar selbst"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "6325e30e-4d86-416e-8202-4d3bfceab377",
                                "sense_id": "32205093-eed5-3c19-9414-615d5452c44d",
                                "text": "„Die organischen Bestandtheile scheinen auch nicht nach dem Gesetze der Binärität gemischt zu seyn, nach welchem die anorganischen Körper vielleicht alle in zwei electrisch verschiedene Bestandtheile zerfallen, welche sich, eben durch den electrischen Gegensatz bedingt, chemisch verbunden haben.“ (1826)"
                            },
                            {
                                "example_id": "8117e0d1-142a-4a62-b133-c0f4d9fe3568",
                                "sense_id": "32205093-eed5-3c19-9414-615d5452c44d",
                                "text": "„Die Annäherungen zum Gesetz der Binärität und der electrochemischen Dichotomie scheinen sich immer mehr zu verlieren, je intensiver und höher die organische Kraft wird, womit die Schwierigkeit der chemischen Analyse des Organischen im Verhältniss stehen dürfte.“ (1827)"
                            },
                            {
                                "example_id": "c0a174ee-9346-41ae-bb58-afd6852c63a3",
                                "sense_id": "32205093-eed5-3c19-9414-615d5452c44d",
                                "text": "„Im Konzept findet man u. a. folgende Binäritäten: Realismus-Idealismus, Nachahmung–Nachbildung, Franzosen-Deutschen, Affen-Menschen.“"
                            },
                            {
                                "example_id": "37d095c6-6bc4-4d2c-957c-e97a6f812d1b",
                                "sense_id": "32205093-eed5-3c19-9414-615d5452c44d",
                                "text": "„Die Briten hatten nämlich die vielgestaltige indische Kolonialgesellschaft nicht nur zunehmend auf die Binärität zweier Nationen – der Hindus und der Muslime – heruntergebrochen und dadurch deren Frontstellung mitverursacht, sie hatten diese Konfrontation auch noch […]“"
                            },
                            {
                                "example_id": "0191718a-bb16-4191-8890-70da232b95cb",
                                "sense_id": "32205093-eed5-3c19-9414-615d5452c44d",
                                "text": "„Das setzt voraus die Binärität der Geschlechter sowie die Annahme einer vorsozialen Prägung, einer WesensNatur der Geschlechter auf der Basis historisch indifferenter binärer Körper.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
