                                    {
                                        "sense_id": "5ba1a749-466a-30b3-a5c3-9245763a111d",
                                        "entry_id": "f028b7cb-2a86-3aef-918f-52e4c9369b3c",
                                        "glosses": [
                                            "zentralasiatisches Hochgebirge im Osten Tadschikistans und angrenzenden Staaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae642c7c-9d6f-4335-bbb3-4b7420be462e",
                                                "sense_id": "5ba1a749-466a-30b3-a5c3-9245763a111d",
                                                "text": "Der höchste Gipfel des Pamir liegt auf 7649 Meter."
                                            },
                                            {
                                                "example_id": "1d92b3f5-343a-48f3-8aa7-d6a7c3993cf3",
                                                "sense_id": "5ba1a749-466a-30b3-a5c3-9245763a111d",
                                                "text": "„Es gibt viele Wandermöglichkeiten im Pamir, durch unberührte und einsame Gegenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
