                    {
                        "sense_id": "6f28e893-393e-3190-b1e4-dad1c81f360b",
                        "entry_id": "43670c10-ae6a-36cb-a256-8f995710aabd",
                        "glosses": [
                            "een groep muziekanten die rock-'n-roll muziek maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f2e7bd1-cd69-4482-94b0-d34967f80562",
                                "sense_id": "6f28e893-393e-3190-b1e4-dad1c81f360b",
                                "text": "Studio Fox heeft regisseur Bryan Singer (X-Men, The Usual Suspects) van de film Bohemian Rhapsody over de Britse rockgroep Queen gehaald."
                            },
                            {
                                "example_id": "7c1a6c36-be6c-4a3d-8d4d-46748e320b47",
                                "sense_id": "6f28e893-393e-3190-b1e4-dad1c81f360b",
                                "text": "De Zuid-Koreaanse rockgroep FT Island stond donderdagavond in The Box in Amsterdam. Vele honderden meiden en -jongens gooiden collectief hun rockhanden in de lucht, en bewogen door de bruisende energie die de zaal overspoelde."
                            },
                            {
                                "example_id": "24006500-eade-4d41-8fd0-dffd08c8b661",
                                "sense_id": "6f28e893-393e-3190-b1e4-dad1c81f360b",
                                "text": "Er werd ze een grote toekomst voorspeld. De Oldenzaalse rockgroep Shiver (1997-2007), voortgekomen uit de coverband Memphis, bracht in 1999 het veelbelovende album Mirror uit. Ik nomineer ‘Gate of Heaven’ als beste Twentse song."
                            }
                        ]
                    }
