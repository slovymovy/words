                {
                    "sense_id": "ae1ef86f-259a-396d-ba4d-49a5e73cf8d2",
                    "sense_definition": "Turned over with the blade of a plough to create furrows (usually for planting crops).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The birds gathered in the <w>ploughed</w> field to look for worms.",
                            "target_lang_translations": {
                                "de": "Die Vögel versammelten sich auf dem <w>gepflügten</w> Feld, um nach Würmern zu suchen.",
                                "zh": "鸟儿们聚集在<w>耕过</w>的田里寻找虫子。",
                                "es": "Los pájaros se reunieron en el campo <w>arado</w> para buscar gusanos.",
                                "tr": "Kuşlar solucan aramak için <w>sürülmüş</w> tarlada toplandı."
                            }
                        },
                        {
                            "text": "Walking across the freshly <w>ploughed</w> land was difficult and muddy.",
                            "target_lang_translations": {
                                "de": "Das Gehen über das frisch <w>gepflügte</w> Land war mühsam und schlammig.",
                                "zh": "走在刚<w>翻过</w>的土地上既困难又泥泞。",
                                "es": "Caminar por la tierra recién <w>labrada</w> era difícil y fangoso.",
                                "tr": "Yeni <w>sürülmüş</w> arazide yürümek zor ve çamurluydu."
                            }
                        }
                    ],
                    "synonyms": [
                        "tilled",
                        "cultivated"
                    ],
                    "antonyms": [
                        "unploughed",
                        "untilled"
                    ],
                    "common_phrases": [
                        "freshly ploughed field",
                        "ploughed land"
                    ],
                    "target_lang_definitions": {
                        "de": "Mit der Pflugschar umgeworfen, um Furchen zu ziehen (meist für die Aussaat)",
                        "zh": "指土地经过犁耕，通常是为了播种",
                        "es": "Tierra que ha sido removida con un arado para crear surcos, generalmente para la siembra.",
                        "tr": "Toprağı havalandırmak veya ekime hazırlamak için sabanla altüst edilmiş"
                    },
