                "senses": [
                    {
                        "sense_id": "a89a01c5-37e3-3fb4-b98a-00d3548ea65b",
                        "entry_id": "ab22b1b7-2b78-332e-ba1c-470f57667ea7",
                        "glosses": [
                            "(gezielte) Durchführung oder Bearbeitung von Aufgaben (häufig Arbeitsaufgaben), um deren Erledigung zu gewährleisten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e4bf5f7-e7b3-44d1-a500-122b348048da",
                                "sense_id": "a89a01c5-37e3-3fb4-b98a-00d3548ea65b",
                                "text": "„Sie haben eine sehr gute mündliche und schriftliche Ausdrucksweise, verfügen über gute kognitive und organisatorische Fähigkeiten, sind belastbar sowie selbstständig und flexibel bei der Aufgabenerledigung.“"
                            },
                            {
                                "example_id": "f4f1c89d-627e-4b55-a424-ca69273a5c44",
                                "sense_id": "a89a01c5-37e3-3fb4-b98a-00d3548ea65b",
                                "text": "„Neben Ihrem sachbezogenen Durchsetzungsvermögen besitzen Sie Darstellungs- und Verhandlungsgeschick sowie die Fähigkeit zur systematischen und eigenverantwortlichen Aufgabenerledigung.“"
                            },
                            {
                                "example_id": "a725a783-1e45-46f8-81a0-c14329d5f460",
                                "sense_id": "a89a01c5-37e3-3fb4-b98a-00d3548ea65b",
                                "text": "„Beispielsweise kann ein schlechtes Zeitmanagement einen großen Stressfaktor darstellen und auch zur Verspätung der Aufgabenerledigung führen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
