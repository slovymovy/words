                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children played <w>happily</w> in the garden all afternoon.",
                            "target_lang_translations": {
                                "ru": "Дети <w>весело</w> играли в саду весь день.",
                                "tr": "Çocuklar bütün öğleden sonra bahçede <w>neşeyle</w> oynadı.",
                                "zh": "孩子们整个下午都在花园里<w>快乐地</w>玩耍。",
                                "pl": "Dzieci przez całe popołudnie <w>wesoło</w> bawiły się w ogrodzie.",
                                "nl": "De kinderen speelden de hele middag <w>vrolijk</w> in de tuin.",
                                "de": "Die Kinder spielten den ganzen Nachmittag <w>fröhlich</w> im Garten.",
                                "fr": "Les enfants ont joué <w>joyeusement</w> dans le jardin tout l'après-midi.",
                                "it": "I bambini hanno giocato <w>felicemente</w> in giardino per tutto il pomeriggio.",
                                "cs": "Děti si celé odpoledne na zahradě <w>vesele</w> hrály.",
                                "es": "Los niños jugaron <w>alegremente</w> en el jardín toda la tarde."
                            }
                        },
                        {
                            "text": "They lived <w>happily</w> ever after in the small cottage.",
                            "target_lang_translations": {
                                "ru": "Они жили долго и <w>счастливо</w> в маленьком домике.",
                                "tr": "Küçük kulübede ömrünün sonuna kadar <w>mutlulukla</w> yaşadılar.",
                                "zh": "他们从此在小屋里过上了<w>幸福</w>的生活。",
                                "pl": "Żyli długo i <w>szczęśliwie</w> w małym domku.",
                                "nl": "Ze leefden nog lang en <w>gelukkig</w> in het kleine huisje.",
                                "de": "Sie lebten in dem kleinen Häuschen bis ans Ende ihrer Tage <w>glücklich</w> zusammen.",
                                "fr": "Ils vécurent <w>heureux</w> pour toujours dans la petite maison.",
                                "it": "Vissero <w>felici</w> e contenti nel piccolo cottage.",
                                "cs": "V malém domku pak žili dlouho a <w>šťastně</w>.",
                                "es": "Vivieron <w>felizmente</w> para siempre en la pequeña cabaña."
                            }
                        }
                    ],
