                ],
                "senses": [
                    {
                        "sense_id": "ba87ad45-050f-3bc2-b5fe-adcaaf3b7e69",
                        "entry_id": "38966573-7ce1-344d-9f89-1c728ce869da",
                        "glosses": [
                            "Sendung, die am späten Abend ausgestrahlt wird, meist mit einem (bekannten) Moderator und Gästen, Musikeinlagen und Satire/Witzen"
                        ],
                        "tags": [
                            "Fernsehen"
                        ],
                        "examples": [
                            {
                                "example_id": "0b85f4a4-8a82-4c1b-a02a-1c235cfcd3f0",
                                "sense_id": "ba87ad45-050f-3bc2-b5fe-adcaaf3b7e69",
                                "text": "„Von Oktober 2013 bis Dezember 2019 moderierte er die politisch-satirische Late-Night-Show Neo Magazin auf ZDFneo.“"
                            },
                            {
                                "example_id": "a39b823a-7860-44f7-b34c-44caedf15187",
                                "sense_id": "ba87ad45-050f-3bc2-b5fe-adcaaf3b7e69",
                                "text": "„Ina Müller, jüngst mit dem Deutschen Fernsehpreis ausgezeichnet, hat mir ihrer Late-Night-Show \"Inas Nacht\" am Freitag eine Rekordquote erzielt.“"
                            },
                            {
                                "example_id": "59bcae72-6c78-474d-814b-14cda4d133af",
                                "sense_id": "ba87ad45-050f-3bc2-b5fe-adcaaf3b7e69",
                                "text": "„Inhaltlich orientierte sich die Show an US-amerikanischen Late-Night-Shows wie der Late Show with David Letterman oder der Tonight Show.“"
                            },
                            {
                                "example_id": "2cebae60-1337-49e3-8840-e15e81acf5dc",
                                "sense_id": "ba87ad45-050f-3bc2-b5fe-adcaaf3b7e69",
                                "text": "[USA, 2025:] „Kimmel hatte das Kirk-Attentat am Montag in seiner beliebten Late-Night-Show thematisiert.“"
                            },
                            {
                                "example_id": "939e04d8-90d7-4e61-adaf-1e54d150fe52",
                                "sense_id": "ba87ad45-050f-3bc2-b5fe-adcaaf3b7e69",
                                "text": "[USA, 2025:] „Mit der Absetzung von Jimmy Kimmels Late-Night-Show greift Trump erneut in die US-amerikanische Medienlandschaft ein, die zunehmend nach rechts rückt.“"
                            },
                            {
                                "example_id": "460395b6-b59b-4091-9f0a-206db14d6b3a",
                                "sense_id": "ba87ad45-050f-3bc2-b5fe-adcaaf3b7e69",
                                "text": "[USA, 2025:] „Die Absetzung von Late-Night-Shows hat zur Folge, dass aus Sicht der US-Regierung unliebsame Meinungen vom Bildschirm verschwinden.“"
                            },
                            {
                                "example_id": "2bfc35d4-bf88-453f-b9f7-d177df0d25d9",
                                "sense_id": "ba87ad45-050f-3bc2-b5fe-adcaaf3b7e69",
                                "text": "[USA, 2025:] „Darüber hinaus werden Menschen eingeschüchtert. So erhielten Mitarbeitende der Late-Night-Show von Jimmy Kimmel und auch Mitarbeitende des Disney-Konzerns, dem der Sender ABC gehört, Morddrohungen.“"
                            },
                            {
                                "example_id": "f3b00d4f-6f8e-491e-bbfa-a132d13c773e",
                                "sense_id": "ba87ad45-050f-3bc2-b5fe-adcaaf3b7e69",
                                "text": "„Die abgesetzte Late-Night-Show von Jimmy Kimmel soll am Dienstag zurückkehren. Das teilte ABC-Eigentümer Disney in einem Statement mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
