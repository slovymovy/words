                        "source_entry_id": "28dd00f5-eb2a-3b12-bfac-e1dba2524c39",
                        "source_sense_description": "purported science",
                        "target_lang_word": "pseudowetenschap",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
