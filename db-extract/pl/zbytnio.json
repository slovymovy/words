                                                "example_id": "fd9d3570-cf52-4314-bead-13192e4ce58e",
                                                "sense_id": "1092d980-8469-3642-8a5c-3fe7cab4c1f5",
                                                "text": "驚きの余り言葉が出てこない。"
                                            }
                                        ]
                                    }
                                ]
                            },
