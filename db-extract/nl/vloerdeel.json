                "senses": [
                    {
                        "sense_id": "5c26ec5d-bb33-32cc-8c73-8e427397a8f2",
                        "entry_id": "8db391a2-2ed0-37d7-946f-ea5330da77f1",
                        "glosses": [
                            "een samenhangend stuk vloer dat samen met andere vloerdelen één vloer vormt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06f5194c-a6c3-4fbe-aaf8-6c6efcfc569a",
                                "sense_id": "5c26ec5d-bb33-32cc-8c73-8e427397a8f2",
                                "text": "Het storten van de wanden en vloer loopt elke keer één moot vooruit, zodat de verschillende ploegen elkaar niet in de weg lopen en achter elkaar kunnen doorwerken. Het laatste vloerdeel wordt naar verwachting gestort in februari 2012."
                            },
                            {
                                "example_id": "845f2bce-3cc5-4d89-8e55-db473fd69c47",
                                "sense_id": "5c26ec5d-bb33-32cc-8c73-8e427397a8f2",
                                "text": "De woontoren in aanbouw in het centrum van Rotterdam stortte donderdagmiddag in. Zes bouwvakkers raakten daarbij gewond, waarvan vijf ernstig. Omdat er nog een vloerdeel schuin hing, was de constructie nog niet veilig en moesten tien winkels aan de Lijnbaan hun deuren sluiten."
                            },
                            {
                                "example_id": "dce330fb-9dfd-4ef6-bcbd-80263c163083",
                                "sense_id": "5c26ec5d-bb33-32cc-8c73-8e427397a8f2",
                                "text": "Woensdag werden de eerste drie loopvloeren met een kraan naar de top van de toren - 97 meter hoog - gehesen. Het vierde vloerdeel en de zes ton zware spiltrap zouden donderdag de weg omhoog volgen. Dat ging niet door. Zowel 's morgens als 's middags werden te hoge windsnelheden gemeten."
                            }
                        ]
                    }
