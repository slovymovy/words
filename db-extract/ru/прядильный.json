                        ],
                        "form": "пряди́льна"
                    },
                    {
                        "form_id": "d165e318-0390-466a-a7b2-3411cf959905",
                        "entry_id": "75a59b1f-8781-3e80-a158-f4cdf35b5382",
                        "tags": [
                            "plural",
