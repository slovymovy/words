            {
                "entry_id": "b3f93e6b-c81d-3bc4-b594-807a87ab80a7",
                "word": "Cafi",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9e03bc39-bf9d-3c8e-a613-5f301faa84cc",
                        "entry_id": "b3f93e6b-c81d-3bc4-b594-807a87ab80a7",
                        "glosses": [
                            "Centre d’accueil qui a accueilli des Français qui avaient été rapatriés d’Indochine, à Sainte-Livrade-sur-Lot, dans le Lot-et-Garonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb6d2a7f-f3e5-4498-b08c-085e396ecd42",
                                "sense_id": "9e03bc39-bf9d-3c8e-a613-5f301faa84cc",
                                "text": "Cafi, pour Camp d’accueil des Français d’Indochine, aussi appelé « la cité des rapatriés »."
                            },
                            {
                                "example_id": "1cb78fd9-8be7-4225-8b94-d233c0b2c204",
                                "sense_id": "9e03bc39-bf9d-3c8e-a613-5f301faa84cc",
                                "text": "Le centre d’accueil des Français d’Indochine (Cafi), ouvert en 1956 à Sainte-Livrade-sur-Lot, est devenu un quartier résidentiel où la culture des rapatriés a pris racine."
                            },
                            {
                                "example_id": "fba778b1-d6e9-40c0-9d70-3c2325b0d4e8",
                                "sense_id": "9e03bc39-bf9d-3c8e-a613-5f301faa84cc",
                                "text": "Le 15 août 2014, en présence du préfet de Lot-et-Garonne, d’élus locaux, de représentants d’associations d’Eurasiens de France, et des différents financeurs, ont été inaugurés la pagode, la chapelle et le lieu de mémoire du Centre d’accueil des Français d'Indochine (Cafi) de Sainte-Livrade-sur-Lot (Lot-et-Garonne)."
                            }
                        ]
                    }
