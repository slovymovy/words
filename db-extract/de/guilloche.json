                                        "sense_id": "fec3e3a3-75e7-36eb-b166-062852a02961",
                                        "entry_id": "4dbbe6f0-81e4-375f-9846-88e94e8d8567",
                                        "glosses": [
                                            "A fine engraved pattern of spirals, intertwining bands, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba64b78d-d5b9-4a09-a323-0671f015df60",
                                                "sense_id": "fec3e3a3-75e7-36eb-b166-062852a02961",
                                                "text": "A railroad right-of-way, straight across the Balkan Peninsula, conceded in Cyrillic and Arabic script all woven in and out of the loveliest green guilloche by the no-longer-quite-unabsorbed entity of East Roumelia."
                                            }
                                        ]
                                    },
