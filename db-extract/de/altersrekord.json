                ],
                "senses": [
                    {
                        "sense_id": "534c1526-7c2b-3340-b076-aae971350a16",
                        "entry_id": "e7411e69-3b8a-3599-9b5f-5849cc9f19a7",
                        "glosses": [
                            "längste Lebensdauer, die ein Lebewesen (aus einer Gruppe) erreicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d40ca71-1840-47b7-944f-5628da5faa14",
                                "sense_id": "534c1526-7c2b-3340-b076-aae971350a16",
                                "text": "Der Grönlandhai hält den Altersrekord unter den Wirbeltieren: er wird bis zu 400 Jahre alt."
                            },
                            {
                                "example_id": "bc803894-2f9c-40bd-b31d-57bf4b732788",
                                "sense_id": "534c1526-7c2b-3340-b076-aae971350a16",
                                "text": "„Die langlebigsten Landsäugetiere sind Menschen: Den Altersrekord hält die Französin Jeanne Louise Calment, die am 4. August 1997 im Alter von 122 Jahren und 164 Tagen starb.“"
                            },
                            {
                                "example_id": "122ecbf0-6017-47e5-8f42-5a990052556e",
                                "sense_id": "534c1526-7c2b-3340-b076-aae971350a16",
                                "text": "„In Gefangenschaft werden Okapis üblicherweise 15 bis 20 Jahre alt, aus der Natur liegen zur Lebenserwartung keine Erkenntnisse vor. Der Altersrekord in zoologischer Haltung beläuft sich auf 33 Jahre.“"
                            },
                            {
                                "example_id": "31a816ed-6364-4fcd-929d-c4667d767907",
                                "sense_id": "534c1526-7c2b-3340-b076-aae971350a16",
                                "text": "[Fledermäuse, Großes Mausohr:] „Der bisher nachgewiesene Altersrekord liegt bei 25 Jahren.“"
                            },
                            {
                                "example_id": "7a599ac7-84df-46a7-a636-0aef5f63ec51",
                                "sense_id": "534c1526-7c2b-3340-b076-aae971350a16",
                                "text": "„Bäume können uralt werden. 200 bis 300 Jahre sind die Regel, einige Arten können sogar 1.000 Jahre erreichen. Doch meistens ist ihr Alter mehr Dichtung als Wahrheit. Nur ganz wenige Exemplare erreichen den Altersrekord.“"
                            },
                            {
                                "example_id": "cd514113-df68-4b58-8373-e9c1d477ad2a",
                                "sense_id": "534c1526-7c2b-3340-b076-aae971350a16",
                                "text": "[Schlagzeile:] „Altersrekord – Riesenschwamm wächst seit 10.000 Jahren – Das vermutlich älteste Tier der Welt lebt auf dem Meeresgrund in der Antarktis: Der Riesenschwamm nahm sich offenbar mehrere tausend Jahre Zeit, um seine stattliche Größe zu erreichen.“",
                                "translation": "erreicht als jüngste Person:"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4ca5cfa4-9928-3efc-b0ef-76fce385e0c5",
                        "entry_id": "e7411e69-3b8a-3599-9b5f-5849cc9f19a7",
                        "glosses": [
                            "Alter einer Person, die etwas als jüngste oder älteste erreicht/geleistet hat"
                        ],
                        "tags": [
                            "Gesellschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "f63e1cf8-7fa8-4153-9d8a-a47e0df860b2",
                                "sense_id": "4ca5cfa4-9928-3efc-b0ef-76fce385e0c5",
                                "text": "„Mit 55 Jahren stellt er außerdem einen Altersrekord auf dem Mount Everest auf.“"
                            },
                            {
                                "example_id": "c82e8dc4-decc-49ba-9f1a-40ca753e5942",
                                "sense_id": "4ca5cfa4-9928-3efc-b0ef-76fce385e0c5",
                                "text": "„Oliver hält mehrere Altersrekorde britischer Schiedsrichter.“"
                            },
                            {
                                "example_id": "a7e33cf9-7265-4eb9-94aa-d1f6d3daeb5c",
                                "sense_id": "4ca5cfa4-9928-3efc-b0ef-76fce385e0c5",
                                "text": "[Über den Fußballer Nuri Şahin:] „In seiner Debütsaison stellte Şahin für Borussia Dortmund, die Bundesliga und die Türkei mehrere Altersrekorde auf und galt als eines der vielversprechendsten Talente Europas.“"
                            },
                            {
                                "example_id": "ac1e21b7-dd9d-4175-81bf-08c9fad20fd2",
                                "sense_id": "4ca5cfa4-9928-3efc-b0ef-76fce385e0c5",
                                "text": "[Über den Fußballer Lamine Yamal:] „Yamal löscht Vonlanthens Altersrekord – dieser reagiert humorvoll – Der 16-jährige Spanier wird mit seinem Treffer zum 1:1 gegen Frankreich zum jüngsten Torschützen an einer EM-Endrunde.“"
                            },
                            {
                                "example_id": "d3f538c4-f2f9-4b5b-9879-f3a32405c2c5",
                                "sense_id": "4ca5cfa4-9928-3efc-b0ef-76fce385e0c5",
                                "text": "[Über den Fußballer Cavan Sullivan:] „Er ist sogar noch jünger als EM-Shootingstar Lamine Yamal, sein Weg zum Weltklub Manchester City ist bereits vorgezeichnet - und nun hat Teenager Cavan Sullivan auch noch mit einem Altersrekord für Aufsehen gesorgt. Mit 14 Jahren und 293 Tagen debütierte der US-Amerikaner am Mittwoch (Ortszeit) in der nordamerikanischen Profiliga MLS“ […].",
                                "translation": "erreicht als älteste Person:"
                            },
                            {
                                "example_id": "bee1f44c-a839-4c6d-a2dd-67cfe062d4a1",
                                "sense_id": "4ca5cfa4-9928-3efc-b0ef-76fce385e0c5",
                                "text": "„Die bisher älteste Frau, die auf dem Everest war, ist die Japanerin Tamae Watanabe. Sie erreichte erstmals am 16. Mai 2002 als schon damals mit 63 Jahren älteste Besteigerin den Gipfel über die Südostroute von Nepal aus. Durch eine erneute Begehung des Gipfels am 19. Mai 2012 über die Nordroute von Tibet aus erhöhte sie ihren eigenen, bis dahin ungeschlagenen Altersrekord auf 73 Jahre.“"
                            },
                            {
                                "example_id": "62c7d746-829e-4c12-a916-72821546aea3",
                                "sense_id": "4ca5cfa4-9928-3efc-b0ef-76fce385e0c5",
                                "text": "[Sieg bei einem Skiprungwettbewerb:] „Mit dem Alter von zu diesem Zeitpunkt 41 Jahren und 219 Tagen überbot er den Altersrekord seines Landsmannes Takanobu Okabe, der das Weltcup-Skispringen auf den Puijo-Schanzen in Kuopio am 10. März 2009 mit 38 Jahren und 135 Tagen gewonnen hatte.“"
                            },
                            {
                                "example_id": "954784a8-ea8d-4a9b-bbc4-a716d144ff5f",
                                "sense_id": "4ca5cfa4-9928-3efc-b0ef-76fce385e0c5",
                                "text": "„Der weltweite Altersrekord bei einer Entbindung wird derzeit von einer Spanierin aus Barcelona gehalten, die 2006 nach einer künstlichen Befruchtung im Alter von 67 Jahren Zwillinge zur Welt brachte.“"
                            },
                            {
                                "example_id": "67d35a58-04d4-4930-bac2-64dd10c4d65c",
                                "sense_id": "4ca5cfa4-9928-3efc-b0ef-76fce385e0c5",
                                "text": "[Über den US-amerikanischen Astronauten John Glenn:] „Den Altersrekord stellte er auf, als er im Oktober 1998 als 77-Jähriger erneut in den Weltraum flog.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
