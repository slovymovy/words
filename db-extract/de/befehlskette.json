                "senses": [
                    {
                        "sense_id": "b21321fd-6b5c-3bbb-9c1e-7982ccae0ccc",
                        "entry_id": "ba50a7e8-18ae-3ba7-8136-9a5f397dc200",
                        "glosses": [
                            "Reihenfolge der Weitergabe von Befehlen innerhalb einer Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89e933b0-5fdf-494c-bd15-2b1088b39c2d",
                                "sense_id": "b21321fd-6b5c-3bbb-9c1e-7982ccae0ccc",
                                "text": "„Nicht jeder in der Befehlskette war dem Senator politisch verbunden, und seine bizarre Meldung einer Entführung war richtig schön peinlich.“"
                            },
                            {
                                "example_id": "fe286df6-548c-4976-bde3-b1d9d7bbcf45",
                                "sense_id": "b21321fd-6b5c-3bbb-9c1e-7982ccae0ccc",
                                "text": "„Ich bin auch frustriert, aber ich sage dir, dass wir beide zu weit unten in der Befehlskette stehen, um etwas dagegen zu unternehmen.“"
                            },
                            {
                                "example_id": "9f8a6c12-be4a-4eb7-88fb-5ad246ed7eb6",
                                "sense_id": "b21321fd-6b5c-3bbb-9c1e-7982ccae0ccc",
                                "text": "„Der ISI-Offizier wollte die Information des Mannes nicht über die normale Befehlskette weiterreichen, er wollte, dass General Malik selbst nach Malakand kam, um den Tawhid-Boten zu befragen und sich seine Informationen anzusehen.“"
                            },
                            {
                                "example_id": "31901997-b880-4870-9c52-a3b040c7de29",
                                "sense_id": "b21321fd-6b5c-3bbb-9c1e-7982ccae0ccc",
                                "text": "„Mitte November versprach bei einem Besuch dort der israelische Generalstabschef Herzi Halevi, dass der Kampf gegen die Hisbollah auch noch weiter im Landesinneren fortgesetzt werde. Die Schiiten-Miliz habe bereits viele Angehörige verloren, ihre Befehlsketten seien zusammengebrochen und deren Infrastrukturen zerstört worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
