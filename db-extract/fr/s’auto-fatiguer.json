                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1821f10-69d0-43c0-9e4f-3afe0d3e0f01",
                                "sense_id": "639b8579-2c6c-3afa-afc2-119f531c2721",
                                "text": "Non mais vous n'imaginez pas combien de fois ça m'arrive de m'auto-fatiguer."
                            },
                            {
                                "example_id": "8a3c64ff-3746-46e2-a9da-d98343d83324",
                                "sense_id": "639b8579-2c6c-3afa-afc2-119f531c2721",
                                "text": "Tu dois t'auto-fatiguer, non ?"
                            },
                            {
                                "example_id": "b19b0233-d2c5-4b44-bfb4-ea6f7e21e9c8",
                                "sense_id": "639b8579-2c6c-3afa-afc2-119f531c2721",
                                "text": "J'avoue, je me fais marrer toute seule... et très souvent, je finis par m'auto-fatiguer !!"
                            }
