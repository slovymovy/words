                    "sense_id": "74ee26ee-7428-3a21-8998-55f64b181a17",
                    "sense_definition": "de plaats waar een reis of een route eindigt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "locatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange vlucht bereikten we eindelijk onze <w>bestemming</w> in Spanje.",
                            "target_lang_translations": {
