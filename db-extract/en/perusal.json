                        "entry_id": "268bec8e-d11b-35e5-a78e-382337500f51",
                        "glosses": [
                            "The act or process of perusing, or an instance of it.",
                            "Studying something carefully; a careful study."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4b44a382-5bac-41ca-92cf-dc42c6089d32",
                                "sense_id": "e377902d-2cbd-389e-b3b1-cc9f1e344171",
                                "text": "Please find attached the relevant documents for your perusal."
                            },
                            {
                                "example_id": "3aa16b0f-2ff5-4cb5-a110-3ffcc66f2038",
                                "sense_id": "e377902d-2cbd-389e-b3b1-cc9f1e344171",
                                "text": "Having therefore no assistance but from general grammar, I applied myself to the perusal of our writers;"
                            },
                            {
                                "example_id": "ecc6d757-0f72-48d8-951f-414595dc9418",
                                "sense_id": "e377902d-2cbd-389e-b3b1-cc9f1e344171",
                                "text": "These were business hours, and a feeling of loneliness crept over him, perhaps germinated by his sight of the illustrated papers, and accentuated by an attempted perusal of them."
                            }
                        ]
                    },
                    {
                        "sense_id": "efa3507e-5277-3448-8ca6-ce636e8b0b7f",
                        "entry_id": "268bec8e-d11b-35e5-a78e-382337500f51",
                        "glosses": [
                            "The act or process of perusing, or an instance of it.",
                            "Giving something a cursory scan; a cursory scan."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
