    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b29d8db-e469-3d35-a9a1-2767ef1b49d0",
                    "sense_definition": "Associer une personne à une autre ou à un groupe pour l'aider dans une fonction ou une tâche.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adjoindre_personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a décidé d'<w>adjoindre</w> un nouvel assistant à son équipe pour mener à bien les projets en cours."
                        },
                        {
                            "text": "Pour résoudre cette affaire complexe, les enquêteurs ont choisi d'<w>adjoindre</w> des experts scientifiques à leur groupe de travail."
                        }
                    ],
                    "synonyms": [
                        "associer",
                        "adjoindre"
                    ],
                    "antonyms": [
                        "séparer",
                        "écarter"
                    ],
                    "common_phrases": [
                        "adjoindre un collaborateur",
                        "adjoindre un assistant"
                    ]
                },
                {
                    "sense_id": "63a73239-70f9-38ec-abc9-17a43a3f3311",
                    "sense_definition": "Ajouter ou rattacher une chose à une autre pour former un tout ou compléter l'ensemble.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adjoindre_chose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le propriétaire a fait <w>adjoindre</w> un atelier d'artiste à l'aile sud de sa maison de campagne."
                        },
                        {
                            "text": "L'auteur a préféré <w>adjoindre</w> plusieurs annexes explicatives à la fin de son manuel technique."
                        }
                    ],
                    "synonyms": [
                        "ajouter",
                        "annexer"
                    ],
                    "antonyms": [
                        "détacher",
                        "soustraire"
                    ],
                    "common_phrases": [
                        "adjoindre une annexe",
                        "adjoindre un document"
                    ]
                },
                {
                    "sense_id": "3022bb6d-574a-3d5d-8f08-a27c33f5ee42",
                    "sense_definition": "S'ajouter à quelque chose d'autre, venir en supplément ou en complément.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "adjoindre_pronominal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À ces contraintes budgétaires déjà lourdes s'<w>adjoint</w> une baisse notable des effectifs de l'entreprise."
                        },
                        {
                            "text": "Au premier constat scientifique s'<w>adjoignent</w> de nouvelles observations réalisées sur le terrain."
                        }
                    ],
                    "synonyms": [
                        "s'ajouter",
                        "se joindre"
                    ],
                    "antonyms": [
                        "se détacher",
                        "se séparer"
                    ]
                }
            ]
        }
    ]
