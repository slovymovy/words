                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a9357ac-0b2d-4214-a994-b2e56403e180",
                                "sense_id": "7de15f75-c947-33ef-9d82-bd517e2239be",
                                "text": "„Bin ich auf einer Konferenz von Militärs oder in einer Dorfmoschee?“"
                            },
                            {
                                "example_id": "892f1bb0-d16f-494c-8e93-20627f30260e",
                                "sense_id": "7de15f75-c947-33ef-9d82-bd517e2239be",
                                "text": "„Die weißen Läufer waren nach dem beturbanten Iman der Dorfmoschee modelliert.“"
                            },
                            {
                                "example_id": "ecee7fa8-162a-4e9c-8d98-948ce4197e20",
                                "sense_id": "7de15f75-c947-33ef-9d82-bd517e2239be",
                                "text": "„In dem Maße, wie die Datenerfassung eine Eigendynamik entwickelte, tauchten um 1945 zusätzliche Angaben auf wie Beschreibungen der Dorfmoscheen, die Namen der Imams mit Charakterisierungen wie »er ist ein gewöhnlicher Mann«, und sogar genaue Schilderungen der Wohnzimmer in den Häusern dieser Honoratioren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
