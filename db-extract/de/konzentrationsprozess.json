                ],
                "senses": [
                    {
                        "sense_id": "c72cec07-85c2-32ec-abd1-73375fd6e24d",
                        "entry_id": "8e563723-d7a1-34d3-884c-8883c88372aa",
                        "glosses": [
                            "Vorgang, bei dem sich Unternehmen zusammenschließen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d55cb6b-3180-4cbe-9a75-944da497f72c",
                                "sense_id": "c72cec07-85c2-32ec-abd1-73375fd6e24d",
                                "text": "„Nicht selten konnten größere Unternehmen kleinere in Konkurs gegangene Betriebe aufkaufen, dadurch kam es zu einem Konzentrationsprozess.“"
                            },
                            {
                                "example_id": "65f7c546-5e4a-4c2c-b6b2-f751daa197f5",
                                "sense_id": "c72cec07-85c2-32ec-abd1-73375fd6e24d",
                                "text": "„Maßgeblich getrieben durch Finanzinvestoren und strategische Investoren schreitet der Konzentrationsprozess in der Pflegebranche und anderen Sektoren der Sozial- und Gesundheitswirtschaft dynamisch voran.“"
                            },
                            {
                                "example_id": "3e9929a4-fefa-4b78-a06c-9a282352db55",
                                "sense_id": "c72cec07-85c2-32ec-abd1-73375fd6e24d",
                                "text": "„Die strenge Gleichbehandlungspolitik verhindert jedoch ein wirtschaftliches Arbeiten der Zeitungen und die Presse stürzt bald in die Krise, was zu einem Konzentrationsprozess führt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
