                "senses": [
                    {
                        "sense_id": "1c917367-2c6f-30b7-81e6-7be684bb0a6f",
                        "entry_id": "ef1b62f6-080a-3c31-a61d-d1e64deafa96",
                        "glosses": [
                            "Farbe, welche die Wahrnehmung durch einen Betrachter verringern soll, zur Tarnung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ebcc9db-9b1b-4595-abb7-172befd4806a",
                                "sense_id": "1c917367-2c6f-30b7-81e6-7be684bb0a6f",
                                "text": "„Die verschmierte Tarnfarbe und der Schweiß, der sich damit vermischte, entstellten ihn zusätzlich.“"
                            },
                            {
                                "example_id": "b5aa085a-4f19-414e-bee9-5f8e7aaee329",
                                "sense_id": "1c917367-2c6f-30b7-81e6-7be684bb0a6f",
                                "text": "„Er dachte an das, was Buckley ihm erzählt hatte, und vor seinem geistigen Auge sah er Shaun Diamond und Gene Young und Ed Goleta in Kampfanzügen, mit Tarnfarbe im Gesicht und langen Messern in den Händen, und sie beobachteten ihn heimlich und warteten nur auf den richtigen Augenblick, um loszuschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
