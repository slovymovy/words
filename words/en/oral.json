{
    "word_family": [
        "orally",
        "orality",
        "oralism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5d2e7abf-457f-30b4-a768-ee84b5bcc5f0",
                    "sense_definition": "Spoken rather than written.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "speech_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have to give an <w>oral</w> presentation in front of the whole class.",
                            "target_lang_translations": {
                                "ru": "Нам нужно выступить с <w>устной</w> презентацией перед всем классом.",
                                "zh": "我们得在全班面前做一次<w>口头</w>报告。"
                            }
                        },
                        {
                            "text": "Many cultures pass down their history through <w>oral</w> tradition rather than books.",
                            "target_lang_translations": {
                                "ru": "Многие культуры передают свою историю через <w>устные</w> предания, а не через книги.",
                                "zh": "许多文化通过<w>口头</w>传统而不是书籍来传承自己的历史。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spoken",
                        "verbal"
                    ],
                    "antonyms": [
                        "written"
                    ],
                    "common_phrases": [
                        "oral exam",
                        "oral presentation",
                        "oral history",
                        "oral agreement",
                        "oral tradition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Произносимый вслух, а не записанный",
                        "zh": "用说的而不是用写的；口头表达的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устный",
                                "target_lang_sense_clarification": "речь, соглашение, история"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口头的",
                                "target_lang_sense_clarification": "指讲话、协议、考试等以说的形式进行，不是书面的"
                            },
                            {
                                "target_lang_word": "口述的",
                                "target_lang_sense_clarification": "强调通过口述表达或传承"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edf65c7a-3a3a-3e74-9e5c-61162ae94ee4",
                    "sense_definition": "Relating to the mouth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouth_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Good <w>oral</w> hygiene is essential for keeping your teeth and gums healthy.",
                            "target_lang_translations": {
                                "ru": "Хорошая гигиена <w>полости рта</w> необходима для здоровья зубов и десен.",
                                "zh": "良好的<w>口腔</w>卫生对保持牙齿和牙龈健康至关重要。"
                            }
                        },
                        {
                            "text": "The dentist performed a thorough examination of the patient's <w>oral</w> cavity.",
                            "target_lang_translations": {
                                "ru": "Стоматолог провел тщательный осмотр <w>ротовой</w> полости пациента.",
                                "zh": "牙医对患者的<w>口腔</w>进行了全面检查。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "oral hygiene",
                        "oral health",
                        "oral cavity",
                        "oral surgery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к рту или полости рта",
                        "zh": "与嘴或口腔有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ротовой",
                                "target_lang_sense_clarification": "анатомический термин"
                            },
                            {
                                "target_lang_word": "оральный",
                                "target_lang_sense_clarification": "медицинский или общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口腔的",
                                "target_lang_sense_clarification": "解剖、医学中最常用，指与口或口腔有关"
                            },
                            {
                                "target_lang_word": "口部的",
                                "target_lang_sense_clarification": "较宽泛，指与嘴部有关"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "071df29b-14cf-3367-b47b-e9199710928d",
                    "sense_definition": "Done or taken by the mouth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouth_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed an <w>oral</w> antibiotic to treat the infection.",
                            "target_lang_translations": {
                                "ru": "Врач выписал <w>пероральный</w> антибиотик для лечения инфекции.",
                                "zh": "医生开了一种<w>口服</w>抗生素来治疗感染。"
                            }
                        },
                        {
                            "text": "This medication is for <w>oral</w> use only and should not be injected.",
                            "target_lang_translations": {
                                "ru": "Это лекарство предназначено только для <w>перорального</w> применения, его нельзя вводить инъекционно.",
                                "zh": "这种药物仅限<w>口服</w>，不能注射。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "oral medication",
                        "oral contraceptive",
                        "oral vaccine",
                        "oral dose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимаемый через рот (о лекарствах)",
                        "zh": "经由嘴进行的，或通过口服用的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пероральный",
                                "target_lang_sense_clarification": "медицинский термин"
                            },
                            {
                                "target_lang_word": "оральный",
                                "target_lang_sense_clarification": "например, о контрацептивах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口服的",
                                "target_lang_sense_clarification": "尤指药物、疫苗等经嘴服用"
                            },
                            {
                                "target_lang_word": "经口的",
                                "target_lang_sense_clarification": "医学用语，指通过口进入体内"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d46a2dc-ef0a-3e66-8d5b-f14ebb13ea14",
                    "sense_definition": "Relating to or denoting a stage of infantile psychosexual development during which libidinal gratification is derived from intake (as of food), by sucking, and later by biting.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "psychoanalysis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "According to Freud, the <w>oral</w> stage is the first phase of psychosexual development.",
                            "target_lang_translations": {
                                "ru": "Согласно Фрейду, <w>оральная</w> стадия является первой фазой психосексуального развития.",
                                "zh": "根据弗洛伊德的理论，<w>口欲期</w>是心理性欲发展的第一阶段。"
                            }
                        },
                        {
                            "text": "Some psychologists attribute smoking habits to an <w>oral</w> fixation developed in childhood.",
                            "target_lang_translations": {
                                "ru": "Некоторые психологи приписывают привычку курить <w>оральной</w> фиксации, развившейся в детстве.",
                                "zh": "一些心理学家把吸烟习惯归因于童年形成的<w>口欲</w>固着。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "oral stage",
                        "oral fixation"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "psychoanalysis"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к ранней стадии психосексуального развития (по Фрейду)",
                        "zh": "与精神分析中婴儿早期通过口部活动获得满足的发展阶段有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оральный",
                                "target_lang_sense_clarification": "психоанализ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口欲期",
                                "target_lang_sense_clarification": "精神分析中指婴儿早期通过吸吮、咬等获得满足的阶段"
                            },
                            {
                                "target_lang_word": "口欲",
                                "target_lang_sense_clarification": "用于“口欲固着”等精神分析术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a30ede42-e789-341b-8d14-541aedeeb6bb",
                    "sense_definition": "A spoken test or examination, particularly in a language class.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was very nervous before my Spanish <w>oral</w>, but I think I passed.",
                            "target_lang_translations": {
                                "ru": "Я очень нервничал перед <w>устным экзаменом</w> по испанскому, но, думаю, я сдал.",
                                "zh": "西班牙语<w>口试</w>前我非常紧张，不过我觉得自己通过了。"
                            }
                        },
                        {
                            "text": "The final grade for the course includes both a written exam and an <w>oral</w>.",
                            "target_lang_translations": {
                                "ru": "Итоговая оценка за курс включает как письменный экзамен, так и <w>устный</w>.",
                                "zh": "这门课的期末成绩既包括笔试，也包括<w>口试</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "French oral",
                        "Spanish oral",
                        "pass an oral"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устный экзамен или зачет",
                        "zh": "口头进行的测试或考试，尤指语言课中的口试。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устный экзамен",
                                "target_lang_sense_clarification": "проверка знаний"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口试",
                                "target_lang_sense_clarification": "尤指语言课中的口头考试"
                            },
                            {
                                "target_lang_word": "口头考试",
                                "target_lang_sense_clarification": "较正式，也可指口头测验或答辩"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
