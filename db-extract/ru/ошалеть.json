                ],
                "senses": [
                    {
                        "sense_id": "b0bf3e75-7986-3c6e-9c18-8a8b680ed42c",
                        "entry_id": "077b7666-3fd1-39c4-96af-1754b5fc4122",
                        "glosses": [
                            "прост. потерять способность здраво мыслить, ясно понимать окружающее, происходящее; обалдеть, одуреть"
                        ],
                        "tags": [],
