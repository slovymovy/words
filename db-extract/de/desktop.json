                                                "sense_id": "3eb45b4b-48f1-37db-a62e-bafd35381478",
                                                "text": "I installed a new application and it added its icon to my desktop."
                                            },
                                            {
                                                "example_id": "9f8eab29-5133-48ac-8814-e4a92c1d745b",
                                                "sense_id": "3eb45b4b-48f1-37db-a62e-bafd35381478",
                                                "text": "Important menus, such as the root menu or Workspace menu, are \"pinnable,\" which means that you can pin them up and keep them on your desktop […]"
                                            }
