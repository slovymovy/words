                "senses": [
                    {
                        "sense_id": "6318fd11-2777-38d8-a79d-6199e2a6f4e7",
                        "entry_id": "95241690-db37-3673-92cd-e1ab1ce84793",
                        "glosses": [
                            "native or inhabitant of Bydgoszcz (usually male)"
                        ],
                        "tags": [
                            "masculine",
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "d4d9ff6b-5841-4ce0-a869-7ae5be904649",
                                "sense_id": "6318fd11-2777-38d8-a79d-6199e2a6f4e7",
                                "text": "Filharmonia Pomorska w Bydgoszczy powinna być filharmonią toruńczyków, teatr toruński – teatrem bydgoszczan i włocławiaków, a tygodniki społeczno-kulturalne tu wychodzące powinny integrować środowiska artystyczne, wynosić ich dokonania poza własny region a nie barykadować się w granicach województwa.",
                                "translation": "The Pomeranian Concert Hall in Bydgoszcz should be a concert hall of the inhabitants of Toruń, the Toruń theater – a theater of the inhabitants of Bydgoszcz and Wroclaw, and the sociocultural weeklies published here should integrate the artistic communities, bring their accomplishments outside their own region, and not barricade themselves in",
                                "english": "The Pomeranian Concert Hall in Bydgoszcz should be a concert hall of the inhabitants of Toruń, the Toruń theater – a theater of the inhabitants of Bydgoszcz and Wroclaw, and the sociocultural weeklies published here should integrate the artistic communities, bring their accomplishments outside their own region, and not barricade themselves in"
                            },
                            {
                                "example_id": "609fb370-b500-48a4-b63d-75b2a7fa2508",
                                "sense_id": "6318fd11-2777-38d8-a79d-6199e2a6f4e7",
                                "text": "Do tej pory bydgoszczanin zaliczył 6 zwycięstw w pojedynczych zawodach, w sumie zdobył 4 medale (1 srebrny, 3 brązowe).",
                                "translation": "Until now the inhabitant of Bydgoszcz has gain 6 wins in solo tournaments; hes has won in total 4 medals (1 silver, 3 bronze medals).",
                                "english": "Until now the inhabitant of Bydgoszcz has gain 6 wins in solo tournaments; hes has won in total 4 medals (1 silver, 3 bronze medals)."
                            },
                            {
                                "example_id": "2e6d7111-43a5-4faa-a827-9c351ed89c9d",
                                "sense_id": "6318fd11-2777-38d8-a79d-6199e2a6f4e7",
                                "text": "Najważniejszy będzie bydgoszczanin Robert Szczepański, pseudonim Maximus.",
                                "translation": "The most important one will be the inhabitant of Bydgoszcz, Robert Szczepański, pseudonym Maximus.",
                                "english": "The most important one will be the inhabitant of Bydgoszcz, Robert Szczepański, pseudonym Maximus."
                            }
                        ]
                    }
                ],
