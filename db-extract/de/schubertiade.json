                "senses": [
                    {
                        "sense_id": "a971d5b2-0c6a-3ca0-b139-7ccb2369605e",
                        "entry_id": "a844aab1-be60-317e-862d-56df64928a97",
                        "glosses": [
                            "ursprünglich Privatkonzerte, die ausschließlich Werken von Franz Schubert gewidmet sind. Die heute weltweite Tradition der Schubertiaden entstand in Schuberts engem Wiener Freundeskreis ab 1821 u.a. um die Familie Sonnleithner und um Joseph Spaun (1788 – 1865)"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "8396e075-c298-4af8-a273-28abc1132839",
                                "sense_id": "a971d5b2-0c6a-3ca0-b139-7ccb2369605e",
                                "text": "„Am 15. Dez. 1826 fand wiederum eine große »Schubertiade« (im Hause Spauns) statt, die durch Schwinds Sepia-Zeichnung des Jahres 1868 (»Ein Schubert-Abend bei Josef Spaun«) besonders berühmt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f457741a-3433-3944-9417-cb533b2647ca",
                        "entry_id": "a844aab1-be60-317e-862d-56df64928a97",
                        "glosses": [
                            "aktuell findet der Begriff eine erweiterte Verwendung für Schubert-Musikfestspiele oder Schubert-Festivals"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "c5534bca-6cce-4a57-9a4a-569ce830bb6c",
                                "sense_id": "f457741a-3433-3944-9417-cb533b2647ca",
                                "text": "\"Ein Festival für Franz Schubert. Ihm den gebührenden Platz neben Mozart und Beethoven einzuräumen, war die Idee der ersten Schubertiade, die 1976 von Hermann Prey in Hohenems gegründet wurde.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
