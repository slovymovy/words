{
    "word_family": [
        "disownment",
        "owner",
        "ownership"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "68180a9c-ec5b-3159-a4af-00a7fb54a2c3",
                    "sense_definition": "To refuse to acknowledge a person, especially a family member, as having any relationship with oneself.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "repudiate_relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His angry parents threatened to <w>disown</w> him if he dropped out of university."
                        },
                        {
                            "text": "After the scandalous revelation, the family decided to <w>disown</w> their youngest son completely."
                        }
                    ],
                    "synonyms": [
                        "renounce"
                    ],
                    "common_phrases": [
                        "threatened to disown",
                        "disown a child"
                    ]
                },
                {
                    "sense_id": "267b19e8-7b93-32fb-98db-d878973285bf",
                    "sense_definition": "To repudiate or deny any connection with or responsibility for something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "repudiate_relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party leader tried to <w>disown</w> the controversial remarks made by the candidate."
                        },
                        {
                            "text": "The corporation acted quickly to <w>disown</w> any connection to the illicit offshore accounts."
                        }
                    ],
                    "synonyms": [
                        "disavow",
                        "disclaim",
                        "repudiate"
                    ],
                    "common_phrases": [
                        "disown the statement",
                        "disown any connection"
                    ]
                },
                {
                    "sense_id": "05a37bc4-2b89-3e0f-8ae4-67c75e4186f3",
                    "sense_definition": "To detach a background process so that it continues running after the user logs out.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>disown</w> the process before closing the terminal window so it continues running."
                        },
                        {
                            "text": "He used the shell command to <w>disown</w> the long backup script."
                        }
                    ],
                    "common_phrases": [
                        "disown a process",
                        "disown a job"
                    ]
                }
            ]
        }
    ]
