                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "organisatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politieke <w>structuren</w> van de partij kwamen bijeen om de nieuwe strategie te bespreken.",
                            "target_lang_translations": {
                                "en": "The political <w>structures</w> of the party met to discuss the new strategy."
                            }
                        },
                        {
                            "text": "Als ode aan de vrouw hebben mannelijke adspirant kandidaten en <w>structuren</w> van de partij vandaag gekookt voor alle bezoekers.",
                            "target_lang_translations": {
