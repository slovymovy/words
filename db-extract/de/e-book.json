                "senses": [
                    {
                        "sense_id": "7c661f37-5738-32ad-9756-793bae1f58ca",
                        "entry_id": "a5ae46de-69d8-326e-9ef8-8cb7cfcab127",
                        "glosses": [
                            "ein auf einem Computer oder auf speziellen Lesegeräten lesbares, digitales Buch"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "8179e307-3e33-4466-9401-39f69fb782ea",
                                "sense_id": "7c661f37-5738-32ad-9756-793bae1f58ca",
                                "text": "Immer mehr Bücher erscheinen nicht nur als Druckausgabe, sondern auch als E-Book."
                            },
                            {
                                "example_id": "6ed542c4-5c06-48e4-9032-b13ed2a71e19",
                                "sense_id": "7c661f37-5738-32ad-9756-793bae1f58ca",
                                "text": "In E-Books kann der Leser leichter suchen als in einem gedruckten Buch, es ist jedoch schwerer zu lesen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b612a25d-7b32-3837-ae13-4d9c3cd08a29",
                        "entry_id": "a5ae46de-69d8-326e-9ef8-8cb7cfcab127",
                        "glosses": [
                            "Gerät, auf dem man solche Bücher lesen kann"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "b5e8c66b-645a-4166-83fb-17ca540c65dd",
                                "sense_id": "b612a25d-7b32-3837-ae13-4d9c3cd08a29",
                                "text": "Ohne ihr E-Book geht sie nicht mehr aus dem Haus."
                            },
                            {
                                "example_id": "11842e35-c004-4862-9caa-9330aac90ec4",
                                "sense_id": "b612a25d-7b32-3837-ae13-4d9c3cd08a29",
                                "text": "Am liebsten liegt er auf dem Sofa und liest einen spannenden Roman auf seinem E-Book."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
