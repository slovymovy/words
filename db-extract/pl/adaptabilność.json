                ],
                "senses": [
                    {
                        "sense_id": "253dee31-0d17-39b5-a922-52cf745e9496",
                        "entry_id": "89f090ce-511d-3c2a-abe2-3674c729d162",
                        "glosses": [
                            "Adaptabilität, Anpassungsfähigkeit"
                        ],
                        "tags": [
                            "speziell Physiologie"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23b8f76f-9b7c-4323-8f71-19056d7c3dea",
                        "source_entry_id": "89f090ce-511d-3c2a-abe2-3674c729d162",
                        "source_sense_id": "253dee31-0d17-39b5-a922-52cf745e9496",
                        "source_sense_description": "Biologie, speziell Physiologie: Adaptabilität, Anpassungsfähigkeit",
                        "target_lang_word": "Adaptabilität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adaptabilität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c63e9af-62f5-31e0-981f-8d683122ce73",
                                        "entry_id": "74791813-c3a7-31b5-abfb-17942e31cbc0",
                                        "glosses": [
                                            "Eigenschaft/Vermögen, sich anzupassen (zu adaptieren)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c9ab970-901e-49dd-ab83-92ff26b8e5bf",
                                                "sense_id": "8c63e9af-62f5-31e0-981f-8d683122ce73",
                                                "text": "„Diese Adaptabilität muß sich nicht nur auf die Formulierung seiner Ziele, sondern vor allem auf die Modi ihrer Verwirklichung auswirken.“"
                                            },
                                            {
                                                "example_id": "96cb78ee-bc8d-4f9a-bd12-31698231e419",
                                                "sense_id": "8c63e9af-62f5-31e0-981f-8d683122ce73",
                                                "text": "„Am anderen Ende der Adaptabilität finden wir jene Familiensysteme, die wir als ‚chaotisch‘ bezeichnen. Bei diesen Familien wird pausenlos etwas verändert, es kommt ununterbrochen zur Änderung von Regeln, Rollen, Aufgaben und Funktionen, so dass man sich nicht auskennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "57d38f3b-00a1-3b6f-aa80-bcb5c793f86c",
                                        "entry_id": "74791813-c3a7-31b5-abfb-17942e31cbc0",
                                        "glosses": [
                                            "Trainierbarkeit (im Leistungssport); Vermögen Trainingsbelastung in eine Anpassung des Körpers umzusetzen (zum Beispiel in Muskelaufbau, Ausdauer)"
                                        ],
                                        "tags": [
                                            "Sportmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d8b5bf6-417c-4975-960e-f452c3590eb4",
                                                "sense_id": "57d38f3b-00a1-3b6f-aa80-bcb5c793f86c",
                                                "text": "„Im Sportbereich wird Adaptabilität als Trainierbarkeit bezeichnet.“"
                                            },
                                            {
                                                "example_id": "23721a56-5ed1-4b01-a8a4-1e39ddaa3928",
                                                "sense_id": "57d38f3b-00a1-3b6f-aa80-bcb5c793f86c",
                                                "text": "„Danach schwächt sich die Adaptabilität für diese Fähigkeiten allmählich ab, während sie sich in der Folgezeit für kraftbetonte Schnelligkeitsleistungen deutlich verbessert.“"
                                            },
                                            {
                                                "example_id": "98e82a1b-9c98-48ec-a90b-247369f295f3",
                                                "sense_id": "57d38f3b-00a1-3b6f-aa80-bcb5c793f86c",
                                                "text": "„Es wird daher zwischen Phasen einer erhöhten Adaptabilität, sog. sensitiven Phasen, und Phasen einer verminderten Adaptabilität, sog. kritischen Phasen, unterschieden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5df4ebec-c3db-44a5-ad18-1d10a2bdaf08",
                        "source_entry_id": "89f090ce-511d-3c2a-abe2-3674c729d162",
                        "source_sense_id": "253dee31-0d17-39b5-a922-52cf745e9496",
