                                        "glosses": [
                                            "To watch multiple episodes of a television programme in a short period of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6cff83f-ff59-4ade-b2b3-bf782a7e21fe",
                                                "sense_id": "e996b0eb-eaf1-3977-a646-ee23def580ff",
                                                "text": "Thankfully, due to the power of BBC iPlayer, I was able to binge-watch the whole series of The Great British Sewing Bee last Sunday."
                                            },
                                            {
                                                "example_id": "70574636-93ed-42bc-b389-75bea2bea8ad",
                                                "sense_id": "e996b0eb-eaf1-3977-a646-ee23def580ff",
                                                "text": "\"People come to shows, but not in the numbers we all hope for. We must give audiences a reason to tear away from the Internet and binge-watching Doctor Who.\""
                                            },
                                            {
                                                "example_id": "3c46696a-0891-4b4b-9a5f-e311830f774f",
                                                "sense_id": "e996b0eb-eaf1-3977-a646-ee23def580ff",
                                                "text": "\"Oh, that was good, too,\" she [Hillary Clinton] said, describing a little self-consciously how she and her husband Bill \"totally binge-watched\" the first season of House of Cards."
                                            }
                                        ]
                                    }
