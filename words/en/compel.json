{
    "word_family": [
        "compulsion",
        "compulsive",
        "compulsory",
        "compelling",
        "compellable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e5ab5de0-f78a-37aa-b8c8-0df5d390c188",
                    "sense_definition": "To force, constrain, or coerce someone to do something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law will <w>compel</w> companies to disclose their annual carbon emissions.",
                            "target_lang_translations": {
                                "ru": "Новый закон <w>обяжет</w> компании раскрывать информацию о ежегодных выбросах углерода."
                            }
                        },
                        {
                            "text": "The judge may <w>compel</w> attendance at the hearing if the witness refuses to appear.",
                            "target_lang_translations": {
                                "ru": "Судья может <w>принудить</w> к явке на слушание, если свидетель отказывается явиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "force",
                        "coerce",
                        "constrain",
                        "oblige"
                    ],
                    "antonyms": [
                        "dissuade",
                        "permit"
                    ],
                    "common_phrases": [
                        "compel attendance",
                        "feel compelled to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принуждать, заставлять или ограничивать кого-либо в действиях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заставлять",
                                "target_lang_sense_clarification": "делать так, чтобы действие стало необходимым"
                            },
                            {
                                "target_lang_word": "принуждать",
                                "target_lang_sense_clarification": "насильно навязывать совершение действия"
                            },
                            {
                                "target_lang_word": "обязывать",
                                "target_lang_sense_clarification": "налагать обязанности или предписывать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49192bf3-13f6-33f3-b64f-f10fd2fd0e28",
                    "sense_definition": "To powerfully motivate or irresistibly drive a course of action or feeling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel has a propulsive energy that will <w>compel</w> you to keep reading until the end.",
                            "target_lang_translations": {
                                "ru": "Роман обладает такой стремительной энергией, которая <w>заставит</w> вас читать до самого конца."
                            }
                        },
                        {
                            "text": "His extraordinary courage and dedication <w>compel</w> respect from both friends and enemies.",
                            "target_lang_translations": {
                                "ru": "Его необычайное мужество и преданность делу <w>вызывают</w> уважение как у друзей, так и у врагов."
                            }
                        }
                    ],
                    "synonyms": [
                        "drive",
                        "impel",
                        "inspire"
                    ],
                    "common_phrases": [
                        "compel respect",
                        "compel attention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно мотивировать или непреодолимо побуждать к действию или чувству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "пробуждать чувства или реакцию, например уважение"
                            },
                            {
                                "target_lang_word": "побуждать",
                                "target_lang_sense_clarification": "склонять к какому-либо действию"
                            },
                            {
                                "target_lang_word": "внушать",
                                "target_lang_sense_clarification": "вызывать невольное чувство или мысль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d57dca7a-c3ff-3989-84c1-a9b60f4cd6ab",
                    "sense_definition": "To exact or produce something by force or authority.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government has the power to execute laws and <w>compel</w> order during a crisis.",
                            "target_lang_translations": {
                                "ru": "Правительство обладает властью исполнять законы и <w>обеспечивать</w> порядок во время кризиса."
                            }
                        },
                        {
                            "text": "The ancient tyrant would <w>compel</w> tribute from every village he conquered.",
                            "target_lang_translations": {
                                "ru": "Древний тиран <w>взыскивал</w> дань с каждой завоеванной им деревни."
                            }
                        }
                    ],
                    "synonyms": [
                        "exact",
                        "extort",
                        "enforce"
                    ],
                    "common_phrases": [
                        "compel order",
                        "compel obedience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добиваться чего-либо или обеспечивать исполнение силой или властью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обеспечивать",
                                "target_lang_sense_clarification": "добиваться соблюдения порядка или закона"
                            },
                            {
                                "target_lang_word": "взыскивать",
                                "target_lang_sense_clarification": "принудительно получать дань или налоги"
                            },
                            {
                                "target_lang_word": "навязывать",
                                "target_lang_sense_clarification": "силой устанавливать свою волю или порядок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b7412a1-cf62-31d3-bf2d-559d66c4d8c7",
                    "sense_definition": "To force to yield, to overpower, or to subjugate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "subdue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mighty warrior sought to <w>compel</w> all creatures to his absolute will.",
                            "target_lang_translations": {
                                "ru": "Могучий воин стремился <w>подчинить</w> всех существ своей абсолютной воле."
                            }
                        },
                        {
                            "text": "After a long day of labor, a deep and easy sleep <w>compelled</w> their weary limbs.",
                            "target_lang_translations": {
                                "ru": "После долгого трудового дня глубокий и легкий сон <w>одолел</w> их усталые тела."
                            }
                        }
                    ],
                    "synonyms": [
                        "subdue",
                        "overpower",
                        "subjugate",
                        "vanquish"
                    ],
                    "antonyms": [
                        "surrender",
                        "yield"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять уступить, подавлять или подчинять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подчинять",
                                "target_lang_sense_clarification": "заставлять действовать по своей воле"
                            },
                            {
                                "target_lang_word": "покорять",
                                "target_lang_sense_clarification": "усмирять или завоевывать"
                            },
                            {
                                "target_lang_word": "одолевать",
                                "target_lang_sense_clarification": "о физическом состоянии, например сне или усталости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c36e9a87-e451-3677-976b-a60034d4c25b",
                    "sense_definition": "To drive together or round up animals or people.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shepherds <w>compelled</w> the stray sheep into the fold as night began to fall.",
                            "target_lang_translations": {
                                "ru": "Пастухи <w>согнали</w> заблудших овец в загон, когда начали сгущаться сумерки."
                            }
                        },
                        {
                            "text": "The soldiers were ordered to <w>compel</w> the prisoners into a single troop for transport.",
                            "target_lang_translations": {
                                "ru": "Солдатам было приказано <w>собрать</w> пленных в один отряд для транспортировки."
                            }
                        }
                    ],
                    "synonyms": [
                        "gather",
                        "herd",
                        "marshal"
                    ],
                    "antonyms": [
                        "scatter",
                        "disperse"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сгонять вместе или собирать животных или людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "сводить воедино в одном месте"
                            },
                            {
                                "target_lang_word": "сгонять",
                                "target_lang_sense_clarification": "принудительно перемещать в одну группу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}