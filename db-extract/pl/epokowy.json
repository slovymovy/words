                "senses": [
                    {
                        "sense_id": "01b7b7bc-2888-3323-a7a3-649f243a2245",
                        "entry_id": "c2dd2bf5-f2b7-354d-855f-d2f404f71da4",
                        "glosses": [
                            "mający ogromne znaczenie z punktu widzenia następstw"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "c3fac517-c596-4e07-abaa-7bc2e66b3eef",
                                "sense_id": "01b7b7bc-2888-3323-a7a3-649f243a2245",
                                "text": "Pielgrzymka papieska była epokowym wydarzeniem dla tego afrykańskiego kraju."
                            },
                            {
                                "example_id": "a1795ad4-dcd3-4b41-a60f-1a9f50f99e75",
                                "sense_id": "01b7b7bc-2888-3323-a7a3-649f243a2245",
                                "text": "Rok 1945 był epokowy dla ziemi kłodzkiej, ponieważ znalazła się ona w granicach państwa polskiego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69f957df-8bfb-4346-b7b6-4facfd07ac65",
                        "source_entry_id": "c2dd2bf5-f2b7-354d-855f-d2f404f71da4",
                        "source_sense_id": "01b7b7bc-2888-3323-a7a3-649f243a2245",
                        "target_lang_word": "epochal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epochal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36a3fa3e-b19c-32d8-8317-c6d1b2df672b",
                                        "entry_id": "0ac14042-4de0-30f2-a4a0-d6193b5d1b6e",
                                        "glosses": [
                                            "Of or pertaining to an epoch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5235ae3b-74ad-32f5-a78f-6adc261b3b24",
                                        "entry_id": "0ac14042-4de0-30f2-a4a0-d6193b5d1b6e",
                                        "glosses": [
                                            "Highly important or significant; monumental, epoch-making."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "030f1d4e-9231-417b-96b8-e5b94fc0aba6",
                                                "sense_id": "5235ae3b-74ad-32f5-a78f-6adc261b3b24",
                                                "text": "But they were the great epochal design; their influence on locomotive development is felt to this day and their niche in railway history is secure."
                                            },
                                            {
                                                "example_id": "9ec34f35-1c37-485a-b751-60546ac4ba40",
                                                "sense_id": "5235ae3b-74ad-32f5-a78f-6adc261b3b24",
                                                "text": "It had been an epochal decade for cancer epidemiology, but equally, an epochal decade for tobacco."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
