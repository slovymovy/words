                                        "glosses": [
                                            "Ce qui préserve, qui sauve moralement."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e49a9c7e-9a17-473f-8ba4-123f478631e5",
                                                "sense_id": "789d148d-f995-358c-afa2-1803e3bd42e7",
                                                "text": "Et puis Jacques croyait en la force vive de la vérité, en la bonne vertu rédemptrice du travail."
