{
    "word_family": [
        "dictation",
        "dictator",
        "dictatorial",
        "dictatorship",
        "dictum"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "199fd62f-d79f-34c3-8a6e-6d2c1ddc101a",
                    "sense_definition": "To say or read aloud words to be written down or recorded by someone else.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager will <w>dictate</w> a letter to his assistant during the morning meeting.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>продиктует</w> письмо своему помощнику во время утреннего совещания.",
                                "tr": "Müdür, sabah toplantısında asistanına bir mektup <w>dikte edecek</w>."
                            }
                        },
                        {
                            "text": "She prefers to <w>dictate</w> notes into her phone rather than typing them out.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает <w>надиктовывать</w> заметки в телефон, а не печатать их.",
                                "tr": "Notları yazmak yerine telefonuna <w>sesli olarak yazdırmayı</w> tercih ediyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dictate a letter",
                        "dictate notes",
                        "dictate a passage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Произносить или читать слова вслух, чтобы другой человек их записал.",
                        "tr": "Başkası yazsın ya da kaydetsin diye kelimeleri sesli olarak söylemek veya okumak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диктовать",
                                "target_lang_sense_clarification": "произносить текст для записи"
                            },
                            {
                                "target_lang_word": "надиктовывать",
                                "target_lang_sense_clarification": "записывать голос на устройство или диктовать частями"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dikte etmek",
                                "target_lang_sense_clarification": "yazılması için sesli söylemek"
                            },
                            {
                                "target_lang_word": "yazdırmak",
                                "target_lang_sense_clarification": "söyleyerek yazıya döktürmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07818b21-dcdb-357e-b0ee-b0d9ec74a82d",
                    "sense_definition": "To determine, influence, or decisively affect the outcome or nature of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local geology <w>dictates</w> the approximate location of the new tunnel.",
                            "target_lang_translations": {
                                "ru": "Местная геология <w>диктует</w> примерное местоположение нового туннеля.",
                                "tr": "Bölgenin jeolojik yapısı, yeni tünelin yaklaşık konumunu <w>belirliyor</w>."
                            }
                        },
                        {
                            "text": "Market trends often <w>dictate</w> terms for small business owners.",
                            "target_lang_translations": {
                                "ru": "Рыночные тенденции часто <w>диктуют</w> условия владельцам малого бизнеса.",
                                "tr": "Piyasa trendleri genellikle küçük işletme sahiplerine şartları <w>dikte eder</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "determine",
                        "govern",
                        "prescribe"
                    ],
                    "common_phrases": [
                        "dictate terms",
                        "dictate the pace",
                        "dictate the outcome"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определять, влиять или решающим образом воздействовать на результат или характер чего-либо.",
                        "tr": "Bir şeyin sonucunu veya niteliğini belirlemek, etkilemek ya da kesin biçimde şekillendirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диктовать",
                                "target_lang_sense_clarification": "навязывать условия или определять ход событий"
                            },
                            {
                                "target_lang_word": "предопределять",
                                "target_lang_sense_clarification": "заранее определять результат"
                            },
                            {
                                "target_lang_word": "обуславливать",
                                "target_lang_sense_clarification": "создавать условия для чего-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "belirlemek",
                                "target_lang_sense_clarification": "şekillendirmek veya tayin etmek"
                            },
                            {
                                "target_lang_word": "dikte etmek",
                                "target_lang_sense_clarification": "şart koşmak veya gidişatı belirlemek"
                            },
                            {
                                "target_lang_word": "yönlendirmek",
                                "target_lang_sense_clarification": "etkisiyle yön vermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7dc5653-ddd8-3842-994b-2f896ef6377a",
                    "sense_definition": "To give orders or commands with authority, often in an overbearing way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "command",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You cannot simply <w>dictate</w> to others how they should live their lives.",
                            "target_lang_translations": {
                                "ru": "Вы не можете просто <w>диктовать</w> другим, как им следует жить.",
                                "tr": "Başkalarına hayatlarını nasıl yaşamaları gerektiğini öylece <w>dayatamazsınız</w>."
                            }
                        },
                        {
                            "text": "The general began to <w>dictate</w> orders to the troops stationed at the border.",
                            "target_lang_translations": {
                                "ru": "Генерал начал <w>отдавать</w> приказы войскам, дислоцированным на границе.",
                                "tr": "General, sınırda konuşlanmış birliklere emirler <w>yağdırmaya</w> başladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "command",
                        "order",
                        "decree"
                    ],
                    "antonyms": [
                        "obey",
                        "follow",
                        "submit"
                    ],
                    "common_phrases": [
                        "dictate orders",
                        "dictate to someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдавать приказы или распоряжения, используя власть, часто в повелительной манере.",
                        "tr": "Genellikle baskıcı veya otoriter bir tavırla buyruk ya da emir vermek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диктовать",
                                "target_lang_sense_clarification": "навязывать свою волю"
                            },
                            {
                                "target_lang_word": "командовать",
                                "target_lang_sense_clarification": "распоряжаться, отдавать приказы"
                            },
                            {
                                "target_lang_word": "предписывать",
                                "target_lang_sense_clarification": "официально устанавливать правила или действия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dikte etmek",
                                "target_lang_sense_clarification": "zorla kabul ettirmek, dayatmak"
                            },
                            {
                                "target_lang_word": "dayatmak",
                                "target_lang_sense_clarification": "kendi isteğini zorla yaptırmak"
                            },
                            {
                                "target_lang_word": "emretmek",
                                "target_lang_sense_clarification": "buyruk vermek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6952e6fa-5151-304f-aec0-e9a15b4e108a",
                    "sense_definition": "A rule, principle, or command that must be followed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt he must obey the <w>dictates</w> of his conscience regardless of the cost.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что должен повиноваться <w>велениям</w> совести, чего бы это ни стоило.",
                                "tr": "Bedeli ne olursa olsun vicdanının <w>sesine</w> uyması gerektiğini hissetti."
                            }
                        },
                        {
                            "text": "The <w>dictates</w> of fashion change so rapidly that it is hard to keep up.",
                            "target_lang_translations": {
                                "ru": "<w>Требования</w> моды меняются так быстро, что за ними трудно уследить.",
                                "tr": "Modanın <w>kuralları</w> o kadar hızlı değişiyor ki ayak uydurmak zor."
                            }
                        }
                    ],
                    "synonyms": [
                        "command",
                        "decree",
                        "edict",
                        "mandate"
                    ],
                    "common_phrases": [
                        "dictates of conscience",
                        "dictates of fashion",
                        "dictates of reason"
                    ],
                    "target_lang_definitions": {
                        "ru": "Правило, принцип или веление, которому необходимо следовать.",
                        "tr": "Uyulması gereken bir kural, ilke veya buyruk."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "веление",
                                "target_lang_sense_clarification": "внутренний призыв или высшее требование"
                            },
                            {
                                "target_lang_word": "диктат",
                                "target_lang_sense_clarification": "жесткое требование или навязанная воля"
                            },
                            {
                                "target_lang_word": "требование",
                                "target_lang_sense_clarification": "то, что необходимо соблюдать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "buyruk",
                                "target_lang_sense_clarification": "emir, ferman veya içsel gereklilik"
                            },
                            {
                                "target_lang_word": "emir",
                                "target_lang_sense_clarification": "talimat veya kural"
                            },
                            {
                                "target_lang_word": "dikta",
                                "target_lang_sense_clarification": "dayatma veya zorunlu kural"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}