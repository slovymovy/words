                "senses": [
                    {
                        "sense_id": "5bda1e55-dd71-3e67-a40a-a941b515d527",
                        "entry_id": "d97efd18-9933-3e3d-86c4-5617fbcceb5c",
                        "glosses": [
                            "van een factor dat het een contract kan doen beëindigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b14f3f78-ef23-4172-a11b-7bf5f4f9b8c1",
                                "sense_id": "5bda1e55-dd71-3e67-a40a-a941b515d527",
                                "text": "Hij bevestigde dat De Wyllandrie over twee jaar zijn oude horecafunctie weer terugkrijgt. „Volgens het bestemmingsplan is dat de enige mogelijkheid.” Minder duidelijk was Cazemier over de afhandeling van eventuele schade die door ondernemers wordt geleden. Hij zei daarover nog in gesprek te zijn met het COA. Als het COA en het rijk niet thuis geven, zo moest Cazemier toegeven, dan is de gemeente verantwoordelijk. Maar dat zal geen ontbindende factor zijn voor de komst van de vluchtelingen naar Ootmarsum."
                            }
                        ]
                    },
                    {
                        "sense_id": "65e6fc8a-6ec7-3840-b397-2fae3145dfdd",
                        "entry_id": "d97efd18-9933-3e3d-86c4-5617fbcceb5c",
                        "glosses": [
                            "van een dood organisme dat het vergaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e39b7ada-4f0c-47d1-8426-af0e143fc563",
                                "sense_id": "65e6fc8a-6ec7-3840-b397-2fae3145dfdd",
                                "text": "Staatsbosbeheer en Ark Natuurontwikkeling hebben maandag een doodgereden ree voor een camera gelegd in natuurgebied de Gelderse Poort bij Nijmegen. Tot eind februari kunnen mensen via de livestream op de zogenoemde KadaverCam (zie onder) volgen hoe het ontbindende dier wordt opgegeten door andere dieren."
                            }
                        ]
                    }
