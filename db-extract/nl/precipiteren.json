                        "target_lang_word": "precipitate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precipitate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f184d15-deb1-3d35-8843-32454aae585e",
                                        "entry_id": "c8f92e63-f7c9-3139-90c7-5dd19362f987",
                                        "glosses": [
                                            "To make something happen suddenly and quickly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a9c4471-6ec4-4afe-b68f-0ab67bf31d8e",
                                                "sense_id": "0f184d15-deb1-3d35-8843-32454aae585e",
                                                "text": "to precipitate a journey, or a conflict"
                                            },
                                            {
                                                "example_id": "24e38a07-38f0-4cb1-b02c-69951d33f53e",
                                                "sense_id": "0f184d15-deb1-3d35-8843-32454aae585e",
                                                "text": "it precipitated their success"
                                            },
                                            {
                                                "example_id": "fe6de442-1f89-4bf1-806d-ef314172a40c",
                                                "sense_id": "0f184d15-deb1-3d35-8843-32454aae585e",
                                                "text": "if they be stout and daring, it may precipitate their designs, and prove dangerous"
                                            },
                                            {
                                                "example_id": "467a2825-f431-4d2f-948b-3f9795bef4ec",
                                                "sense_id": "0f184d15-deb1-3d35-8843-32454aae585e",
                                                "text": "Back to his sight precipitates her steps."
                                            },
                                            {
                                                "example_id": "a1e027d9-5bcc-410e-bdae-31eb58b69ba1",
                                                "sense_id": "0f184d15-deb1-3d35-8843-32454aae585e",
                                                "text": "Freshly arrived in Paris in 1871 at the age of 17, Rimbaud proceded ^([sic]) to precipitate the collapse of Verlaine's marital menage, and with it his social position."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf46f187-3742-39e4-8ecb-07a91b3099fc",
                                        "entry_id": "c8f92e63-f7c9-3139-90c7-5dd19362f987",
                                        "glosses": [
                                            "To throw an object or person from a great height."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37400a2f-8e19-4034-9829-0358cdb41476",
                                                "sense_id": "cf46f187-3742-39e4-8ecb-07a91b3099fc",
                                                "text": "In gallopping heedlessly along, with her eyes turned upwards, she had unwarily approached too near the bank; it had given way with her, and she and her horse had been precipitated to the pebbled margin of the river."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a11a556b-584b-3e17-a7b6-d156da6b4022",
                                        "entry_id": "c8f92e63-f7c9-3139-90c7-5dd19362f987",
                                        "glosses": [
                                            "To send violently into a certain state or condition."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcb40ff5-2dda-4173-bbf5-4c7a9968c350",
                                                "sense_id": "a11a556b-584b-3e17-a7b6-d156da6b4022",
                                                "text": "we were precipitated into a conflict"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fcd317b-f3a0-3ae1-82b4-5fc30b66d0be",
                                        "entry_id": "c8f92e63-f7c9-3139-90c7-5dd19362f987",
                                        "glosses": [
                                            "(chemistry) To come out of a liquid solution into solid form."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f319b551-4e74-4bd6-87c6-02f9a7eaeb6c",
                                                "sense_id": "2fcd317b-f3a0-3ae1-82b4-5fc30b66d0be",
                                                "text": "Adding the acid will cause the salt to precipitate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1aa8f3a-1a69-3613-97bd-753e268f22b3",
                                        "entry_id": "c8f92e63-f7c9-3139-90c7-5dd19362f987",
                                        "glosses": [
                                            "(chemistry) To separate a substance out of a liquid solution into solid form."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ccc027a-ad47-397d-9b4c-0bf21fc086a6",
                                        "entry_id": "c8f92e63-f7c9-3139-90c7-5dd19362f987",
                                        "glosses": [
                                            "To have water in the air fall to the ground, for example as rain, snow, sleet, or hail; be deposited as condensed droplets."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ae32430-650f-40b7-bd49-5a9a0ba5256a",
                                                "sense_id": "9ccc027a-ad47-397d-9b4c-0bf21fc086a6",
                                                "text": "It will precipitate tomorrow, but we don't know whether as rain or snow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0348ca10-2420-3d90-86e5-e4386039fca0",
                                        "entry_id": "c8f92e63-f7c9-3139-90c7-5dd19362f987",
                                        "glosses": [
                                            "To cause (water in the air) to condense or fall to the ground."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f52da370-1d68-4a99-99f8-dfebc9c40a27",
                                                "sense_id": "0348ca10-2420-3d90-86e5-e4386039fca0",
                                                "text": "The light vapour of the preceding evening had been precipitated by the cold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23305a13-726b-38de-8559-bb01eaf1f23a",
                                        "entry_id": "c8f92e63-f7c9-3139-90c7-5dd19362f987",
                                        "glosses": [
                                            "To fall headlong."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24a5f4e1-5907-3b04-95ad-55395bb6c6eb",
                                        "entry_id": "c8f92e63-f7c9-3139-90c7-5dd19362f987",
                                        "glosses": [
                                            "To act too hastily; to be precipitous."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "precipitate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da604edc-9e0a-3530-9cf6-58a48e2918af",
                                        "entry_id": "a55b6bf5-98be-3a9d-ad9c-397f0b7ff9e9",
                                        "glosses": [
                                            "headlong; falling steeply or vertically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c174796-985d-4d2c-ab2d-2b86ba9489a5",
                                                "sense_id": "da604edc-9e0a-3530-9cf6-58a48e2918af",
                                                "text": "When the full stores their ancient bounds disdain, / Precipitate the furious torrent flows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14acf6c4-058a-3740-8a44-bc4cdb5a85a3",
                                        "entry_id": "a55b6bf5-98be-3a9d-ad9c-397f0b7ff9e9",
                                        "glosses": [
                                            "Very steep; precipitous."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26afcf1e-c32e-301a-bca1-554bb61bff6e",
                                        "entry_id": "a55b6bf5-98be-3a9d-ad9c-397f0b7ff9e9",
                                        "glosses": [
                                            "With a hasty impulse; hurried; headstrong."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d53d7343-2458-4f8b-8fd3-7a62f4808a25",
                                                "sense_id": "26afcf1e-c32e-301a-bca1-554bb61bff6e",
                                                "text": "Though thoughtful far beyond your years, you are very inexperienced; and I would not have a preference that may originate in your little knowledge of others, or a romantic exaggeration of slight kindnesses, lead you into a precipitate union with me, unless you most seriously examine your own heart, and weigh the various consequences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "343ef2e7-8ab1-3af3-a952-a314acae67cf",
                                        "entry_id": "a55b6bf5-98be-3a9d-ad9c-397f0b7ff9e9",
                                        "glosses": [
                                            "Moving with excessive speed or haste; overly hasty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f11eb64-3a65-48d3-9c0d-614533fe657d",
                                                "sense_id": "343ef2e7-8ab1-3af3-a952-a314acae67cf",
                                                "text": "The king was too precipitate in declaring war."
                                            },
                                            {
                                                "example_id": "b3fb6f97-7050-47ff-9380-0ede0344e022",
                                                "sense_id": "343ef2e7-8ab1-3af3-a952-a314acae67cf",
                                                "text": "a precipitate case of disease"
                                            },
                                            {
                                                "example_id": "29fce29e-87a8-4d92-b283-1a56257052fb",
                                                "sense_id": "343ef2e7-8ab1-3af3-a952-a314acae67cf",
                                                "text": "Being a trifle precipitate in his entry, he trod on a bottle, and was instantly extinguished by a Japanese screen, which appeared to collapse on him out of pure decrepitude."
                                            },
                                            {
                                                "example_id": "2a25534b-7224-48a1-b3e7-eab7af310ac2",
                                                "sense_id": "343ef2e7-8ab1-3af3-a952-a314acae67cf",
                                                "text": "'One moment!\" said Malone. \"I beg, sir, that you will not be precipitate. I value your friendship too much to risk the loss of it if it can, in any way, be avoided.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b7c5040-33f9-3dda-a389-2d08cefd4739",
                                        "entry_id": "a55b6bf5-98be-3a9d-ad9c-397f0b7ff9e9",
                                        "glosses": [
                                            "Performed very rapidly or abruptly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42439510-1f3d-4259-b47d-b09516e0a52d",
                                                "sense_id": "9b7c5040-33f9-3dda-a389-2d08cefd4739",
                                                "text": "It had cost me a distinct psychological effort to do so, and now that I was shut inside I had a momentary longing for precipitate retreat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "precipitate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93d8f917-de04-3bc8-a78b-1df874111706",
                                        "entry_id": "5664b2d2-ef77-3e34-93d5-d302166fb6c6",
                                        "glosses": [
                                            "A product resulting from a process, event, or course of action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb026926-14fc-4dd4-ae95-69b633c5ff8b",
                                                "sense_id": "93d8f917-de04-3bc8-a78b-1df874111706",
                                                "text": "As for the musculature it is a precipitate of Spirit and the signature of the cosmos is in it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2d5e011-4e05-3eb8-b021-08c290bfff34",
                                        "entry_id": "5664b2d2-ef77-3e34-93d5-d302166fb6c6",
                                        "glosses": [
                                            "A solid that exits the liquid phase of a solution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
