                {
                    "sense_id": "44222bf4-4b77-3099-a8ae-f3b9b6245a8f",
                    "sense_definition": "Qui appartient à la légende, qui est transmis par des récits merveilleux ou mythiques.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mythe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dragon est une créature <w>légendaire</w> présente dans de nombreuses cultures à travers le monde."
                        },
                        {
                            "text": "Ce livre pour enfants raconte les exploits d'un roi <w>légendaire</w> et de ses chevaliers."
                        }
                    ],
                    "synonyms": [
                        "mythique",
                        "fabuleux",
                        "imaginaire"
                    ],
                    "antonyms": [
                        "historique",
                        "réel"
                    ],
                    "common_phrases": [
