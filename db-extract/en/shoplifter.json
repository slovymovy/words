                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34c16950-33d5-43e5-8987-6dfa12180ce6",
                                "sense_id": "a890a122-9b53-3fcb-871e-ba6ba0938dc6",
                                "text": "The shoplifters are much less to be dreaded than the sneak, as they do not carry off cash, and rarely any very valuable property; they have, however, lately hit on a scheme which has proved successful in numerous instances. […] It cannot be too often enforced on the shopkeeper, that these men know the places which are good for this purpose, and that careless people will always have an abundance of customers of this kind, and that it is their own fault, in all cases of shoplifting, when they lose their goods."
                            }
                        ]
                    }
                ],
