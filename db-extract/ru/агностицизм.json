                                "target_senses": [
                                    {
                                        "sense_id": "4d21b5e6-cc79-3158-a8ea-9bb17f03bf47",
                                        "entry_id": "7da831d4-feb4-34b0-b8ef-6b921fca72f9",
                                        "glosses": [
                                            "The view that absolute truth or ultimate certainty is unattainable, especially regarding knowledge not based on experience or perceivable phenomena."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6dad3154-b6ad-39c0-84f4-00a9fa618605",
                                        "entry_id": "7da831d4-feb4-34b0-b8ef-6b921fca72f9",
                                        "glosses": [
                                            "The view that the existence of God or of all deities is unknown, unknowable, unproven, or unprovable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0331212e-c314-4fb7-bda8-6a6f053a1b9e",
                                                "sense_id": "6dad3154-b6ad-39c0-84f4-00a9fa618605",
                                                "text": "Holonyms: epistemology, cosmology, ontology, philosophy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "742ed1e8-349e-331f-8852-5d2857428236",
                                        "entry_id": "7da831d4-feb4-34b0-b8ef-6b921fca72f9",
                                        "glosses": [
                                            "Doubt, uncertainty, or scepticism regarding the existence of a god or gods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "438b7260-8954-43c3-ad4c-efd5b38b2fc7",
                                                "sense_id": "742ed1e8-349e-331f-8852-5d2857428236",
                                                "text": "1956, January 31ˢᵗ: Alan Alexander Milne; quoted in:"
                                            },
                                            {
                                                "example_id": "7566b3c2-b698-4266-8b0e-a5f2863ce70b",
                                                "sense_id": "742ed1e8-349e-331f-8852-5d2857428236",
                                                "text": "1988: James B. Simpson, Simpson’s Contemporary Quotations, № 4,393 (Houghton Mifflin, →ISBN\nThe Old Testament is responsible for more atheism, agnosticism, disbelief — call it what you will — than any book ever written; it has emptied more churches than all the counterattractions of cinema, motor bicycle and golf course."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0052da42-77fa-3994-9f5d-a4d98bf48c09",
                                        "entry_id": "7da831d4-feb4-34b0-b8ef-6b921fca72f9",
                                        "glosses": [
                                            "Doubt, uncertainty, or scepticism regarding any subject of dispute."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
