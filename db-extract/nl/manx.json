                    },
                    {
                        "translation_id": "2e42f0a6-037f-429e-82ae-501bd3632b35",
                        "source_entry_id": "8fd7bc19-7e9c-3c63-ba0b-010fca867536",
                        "source_sense_id": "9642be22-9e08-3bcd-9ef7-8b51aaf30e2a",
                        "source_sense_description": "een Keltische taal die (als tweede taal) wordt gesproken op het eiland Man",
