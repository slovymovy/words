{
    "word_family": [
        "ethical",
        "ethically",
        "ethics",
        "ethicist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d64afdfa-b60c-397b-a4b5-08dccbafd7ec",
                    "sense_definition": "A set of principles of right and wrong behavior guiding a specific group or individual",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "moral_principles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Protestant work <w>ethic</w> emphasizes the importance of hard work and discipline.",
                            "target_lang_translations": {
                                "ru": "Протестантская трудовая <w>этика</w> подчеркивает важность усердного труда и дисциплины."
                            }
                        },
                        {
                            "text": "She has a strong personal <w>ethic</w> that prevents her from lying to her clients.",
                            "target_lang_translations": {
                                "ru": "У нее сильная личная <w>этика</w>, которая не позволяет ей лгать своим клиентам."
                            }
                        }
                    ],
                    "synonyms": [
                        "morality",
                        "creed",
                        "ethos"
                    ],
                    "common_phrases": [
                        "work ethic",
                        "personal ethic",
                        "professional ethic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор принципов правильного и неправильного поведения, которыми руководствуется определенная группа или человек"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "этика",
                                "target_lang_sense_clarification": "система моральных принципов"
                            },
                            {
                                "target_lang_word": "мораль",
                                "target_lang_sense_clarification": "нравственные нормы"
                            },
                            {
                                "target_lang_word": "кодекс",
                                "target_lang_sense_clarification": "свод правил поведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e195400-055e-3e34-856d-e7f65f6afff4",
                    "sense_definition": "The moral quality or righteousness of a specific action",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "moral_principles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee questioned the <w>ethic</w> of using such data without the users' consent.",
                            "target_lang_translations": {
                                "ru": "Комитет поставил под сомнение <w>этичность</w> использования таких данных без согласия пользователей."
                            }
                        },
                        {
                            "text": "Many people debate the <w>ethic</w> of capital punishment in modern society.",
                            "target_lang_translations": {
                                "ru": "Многие люди спорят о <w>нравственности</w> смертной казни в современном обществе."
                            }
                        }
                    ],
                    "synonyms": [
                        "morality",
                        "rectitude"
                    ],
                    "antonyms": [
                        "immorality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Моральное качество или правомерность конкретного действия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "этичность",
                                "target_lang_sense_clarification": "соответствие нормам морали"
                            },
                            {
                                "target_lang_word": "нравственность",
                                "target_lang_sense_clarification": "моральная чистота поступка"
                            },
                            {
                                "target_lang_word": "правомерность",
                                "target_lang_sense_clarification": "с точки зрения морали"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3ecac3e9-8774-34f2-a16e-53529cf07058",
                    "sense_definition": "Relating to morals or the principles of right and wrong",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher presented an <w>ethic</w> argument regarding the nature of human kindness.",
                            "target_lang_translations": {
                                "ru": "Философ представил <w>этический</w> аргумент относительно природы человеческой доброты."
                            }
                        },
                        {
                            "text": "They discussed the <w>ethic</w> implications of the new law during the meeting.",
                            "target_lang_translations": {
                                "ru": "В ходе встречи они обсудили <w>этические</w> последствия нового закона."
                            }
                        }
                    ],
                    "synonyms": [
                        "ethical",
                        "moral"
                    ],
                    "antonyms": [
                        "unethical",
                        "immoral"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к морали или принципам правильного и неправильного"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "этический",
                                "target_lang_sense_clarification": "связанный с этикой"
                            },
                            {
                                "target_lang_word": "нравственный",
                                "target_lang_sense_clarification": "относящийся к морали"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}