        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a622501d-9e9d-360b-8dec-61e8d7d2db72",
                "word": "onside",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "feb4ea7c-f334-3e09-8054-b687e9bad58e",
                        "entry_id": "a622501d-9e9d-360b-8dec-61e8d7d2db72",
                        "glosses": [
                            "Not in an offside position; In the part of the playing area where one can legally play the ball, puck, etc."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "680e3d99-5193-42c9-9e43-e2711d3a4e13",
                                "sense_id": "feb4ea7c-f334-3e09-8054-b687e9bad58e",
                                "text": "Rafael van der Vaart then stayed onside to slot past Paddy Kenny when he collected Ledley King's mis-hit shot."
                            },
                            {
                                "example_id": "d4f8c2f9-f282-46b2-af85-41d267d03c18",
                                "sense_id": "feb4ea7c-f334-3e09-8054-b687e9bad58e",
                                "text": "The goal was allowed because the attacker was onside."
                            },
                            {
                                "example_id": "89bd7927-1877-4931-b9c4-23930685fa51",
                                "sense_id": "feb4ea7c-f334-3e09-8054-b687e9bad58e",
                                "text": "After passing the puck, the center immediately breaks to the front of the net, making certain to stay onside."
                            },
                            {
                                "example_id": "61b29d90-9cb5-4504-9732-8331f092aaac",
                                "sense_id": "feb4ea7c-f334-3e09-8054-b687e9bad58e",
                                "text": "The difference in recovery percentage between surprise onside kicks and non-surprise onside kicks is striking."
                            },
                            {
                                "example_id": "30f9b041-bd45-429e-83f0-08a002a226d7",
                                "sense_id": "feb4ea7c-f334-3e09-8054-b687e9bad58e",
                                "text": "If the ball carrier you are doubling gets the ball through the lane, the rotation is as follows: The onside man who was denying his man the ball continues the same technique."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ff4bc4e-a1b4-3ae9-97f7-aaa888e08103",
                        "entry_id": "a622501d-9e9d-360b-8dec-61e8d7d2db72",
                        "glosses": [
                            "Within bounds."
                        ],
                        "tags": [
                            "broadly",
                            "not-comparable",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "93ec9e17-7f9a-49f2-8bd9-df80aed8ec6b",
                                "sense_id": "7ff4bc4e-a1b4-3ae9-97f7-aaa888e08103",
                                "text": "[Verse 2:Kano]:On-sight, thought he was onside, innit. Saw them guys, no shots fired innit. If you ain't real then don't ride, innit. That postcode, that's offside, innit."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c151b98-9881-357c-8649-fbf7aba4f3ec",
                        "entry_id": "a622501d-9e9d-360b-8dec-61e8d7d2db72",
                        "glosses": [
                            "On the side of a vehicle from which the driver, paddler, etc. propels it."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2b095818-d0e1-4af2-9ed9-5ebe7fc1d8b3",
                                "sense_id": "1c151b98-9881-357c-8649-fbf7aba4f3ec",
                                "text": "The toll plaza will consist of an administration building and 16 onside modern barrier-type toll boths, with provision for four additional toll booths should future traffic demand require them."
                            },
                            {
                                "example_id": "9fedce17-2041-48a1-87a7-78201ac9e359",
                                "sense_id": "1c151b98-9881-357c-8649-fbf7aba4f3ec",
                                "text": "No, there's no way I call up just for a chat, like 'Hi, Nigel, you've left your rear onside winker on!'"
                            },
                            {
                                "example_id": "94c99f8b-896e-42df-a230-43e6075689aa",
                                "sense_id": "1c151b98-9881-357c-8649-fbf7aba4f3ec",
                                "text": "Continue the rotation until your onside shoulder is pointing toward the bow and your onside arm is fully extended."
                            },
                            {
                                "example_id": "6038b749-6904-46dc-b070-c44ca781e078",
                                "sense_id": "1c151b98-9881-357c-8649-fbf7aba4f3ec",
                                "text": "For more advanced paddlers the boat can be steered back onto the onside stroke by putting a little offside edge on at the end of the stroke, thus reducing the need for cross-bow strokes."
                            },
                            {
                                "example_id": "16d5c332-ec0a-42f5-a562-15b58785a08a",
                                "sense_id": "1c151b98-9881-357c-8649-fbf7aba4f3ec",
                                "text": "The reverse sweep turns the canoe sharply onside, reducing forward momentum. The solo paddler's body rotates onside with the onside shoulder turned towards the stern."
                            }
                        ]
                    },
                    {
                        "sense_id": "6099518b-af0b-3746-86e3-928d351b3a1b",
                        "entry_id": "a622501d-9e9d-360b-8dec-61e8d7d2db72",
                        "glosses": [
                            "Favourably located, from the point of view of the player taking a finesse."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "641069ff-ede8-4af0-8221-71e157d40eaf",
                                "sense_id": "6099518b-af0b-3746-86e3-928d351b3a1b",
                                "text": "With A-Q-10 opposite x-x-x, you have a 24% chance of three tricks, both missing honors being onside. You have a 52% chance of two tricks, with one honor onside and the other offside. FInally, you have a 24% chance of making only one trick, when both the king and the jack are offside."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7f5ecdc-4c38-304e-af40-bfe95bb1e368",
                        "entry_id": "a622501d-9e9d-360b-8dec-61e8d7d2db72",
                        "glosses": [
                            "In agreement or support; on board."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e1695f47-9590-4cb6-88a0-3fa5a7cf9e0f",
                                "sense_id": "b7f5ecdc-4c38-304e-af40-bfe95bb1e368",
                                "text": "There was a very delicate balancing act the whole time about measures that would keep the Unionists onside without upsetting the Nationalist-Republican community too much."
                            }
                        ]
                    }
