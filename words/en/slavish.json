{
    "word_family": [
        "slave",
        "slavery",
        "enslave"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1c0a5e41-7ba3-3682-94b0-e953d8c76270",
                    "sense_definition": "Relating to or characteristic of a slave; showing excessive submission or fear.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "submissive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers were forced into <w>slavish</w> obedience by their cruel master.",
                            "target_lang_translations": {
                                "de": "Die Arbeiter wurden von ihrem grausamen Herrn zu <w>sklavischem</w> Gehorsam gezwungen."
                            }
                        },
                        {
                            "text": "He refused to accept such <w>slavish</w> treatment from his employer.",
                            "target_lang_translations": {
                                "de": "Er weigerte sich, eine solch <w>sklavische</w> Behandlung durch seinen Arbeitgeber hinzunehmen."
                            }
                        }
                    ],
                    "synonyms": [
                        "abject",
                        "servile",
                        "submissive"
                    ],
                    "antonyms": [
                        "independent",
                        "assertive"
                    ],
                    "common_phrases": [
                        "slavish obedience",
                        "slavish devotion"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich wie ein Sklave verhaltend; übermäßig unterwürfig oder ängstlich."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sklavisch",
                                "target_lang_sense_clarification": "in Bezug auf unterwürfiges Verhalten"
                            },
                            {
                                "target_lang_word": "unterwürfig",
                                "target_lang_sense_clarification": "allgemein für eine unterwürfige Haltung"
                            },
                            {
                                "target_lang_word": "kriecherisch",
                                "target_lang_sense_clarification": "abwertend für eine übertrieben unterwürfige Art"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "960db057-7c47-3f7c-aea4-d905fc6b3568",
                    "sense_definition": "Lacking originality or creativity; copying something exactly without thinking.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "unoriginal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist avoided a <w>slavish</w> imitation of the old masters.",
                            "target_lang_translations": {
                                "de": "Der Künstler vermied eine <w>sklavische</w> Nachahmung der alten Meister."
                            }
                        },
                        {
                            "text": "His <w>slavish</w> adherence to the rules prevented any real progress.",
                            "target_lang_translations": {
                                "de": "Sein <w>sklavisches</w> Festhalten an den Regeln verhinderte jeden echten Fortschritt."
                            }
                        }
                    ],
                    "synonyms": [
                        "imitative",
                        "unoriginal",
                        "mechanical"
                    ],
                    "antonyms": [
                        "original",
                        "creative"
                    ],
                    "common_phrases": [
                        "slavish imitation",
                        "slavish adherence"
                    ],
                    "target_lang_definitions": {
                        "de": "Mangel an Originalität oder Kreativität; etwas ohne eigenes Nachdenken exakt kopierend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sklavisch",
                                "target_lang_sense_clarification": "in Bezug auf eine unkritische Nachahmung"
                            },
                            {
                                "target_lang_word": "nachahmerisch",
                                "target_lang_sense_clarification": "etwas kopierend ohne eigene Ideen"
                            },
                            {
                                "target_lang_word": "mechanisch",
                                "target_lang_sense_clarification": "ohne eigenes Denken oder Gefühl ausgeführt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}