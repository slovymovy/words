                "translations": [
                    {
                        "translation_id": "8127c946-1ff6-4f27-acb7-b12f387a34ea",
                        "source_entry_id": "66300708-3f8e-36d3-b88c-94647fef232c",
                        "source_sense_id": "a1d0fddd-1a5c-3a0e-99d3-d3134f6a41a6",
                        "target_lang_word": "basking shark",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "basking shark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42f6b3a1-cd3d-359d-98f7-de03c3a94d84",
                                        "entry_id": "c5910c4e-f369-390d-9e0d-095184f77997",
                                        "glosses": [
                                            "A very large shark, Cetorhinus maximus, that feeds at or close to the surface by filtering plankton from the water and is found in all the world's temperate oceans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e2c0a6c-00f5-460f-bad1-6eff0c08b58b",
                                                "sense_id": "42f6b3a1-cd3d-359d-98f7-de03c3a94d84",
                                                "text": "Like the whale shark, the basking shark is a huge, slow-moving plankton feeder. Also like the whale shark, the basking shark is the sole member of a family created especially to accommodate it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
