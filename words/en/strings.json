                {
                    "sense_id": "33142402-f761-3db1-b604-cf72b1d498fa",
                    "sense_definition": "Collectively, the musical instruments in an orchestra that produce sound by vibrating strings, such as violins, violas, and cellos.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conductor signaled for the <strings> to play softer.",
                            "target_lang_translations": {
                                "ru": "Дирижер дал знак <струнным> играть тише.",
                                "fr": "Le chef d'orchestre a fait signe aux <w>cordes</w> de jouer plus doucement."
                            }
                        },
                        {
                            "text": "She has played in the <strings> section for five years.",
                            "target_lang_translations": {
                                "ru": "Она играла в секции <струнных> пять лет.",
                                "fr": "Elle joue dans la section des <w>cordes</w> depuis cinq ans."
                            }
                        }
                    ],
                    "synonyms": [
                        "string section"
                    ],
                    "common_phrases": [
                        "strings section"
                    ],
                    "target_lang_definitions": {
                        "ru": "Струнная группа оркестра; музыкальные инструменты, издающие звук вибрацией струн.",
                        "fr": "Section des instruments à cordes d'un orchestre."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "струнные",
                                "target_lang_sense_clarification": "музыкальные инструменты"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "cordes",
                                "target_lang_sense_clarification": "section des instruments à cordes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39163803-3f3b-35f2-9176-e995227815da",
                    "sense_definition": "Special conditions, restrictions, or obligations that are attached to an offer or agreement, often making it less attractive.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conditions_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They offered us the grant money with no <strings> attached.",
                            "target_lang_translations": {
                                "ru": "Они предложили нам грант без каких-либо <условий>.",
                                "fr": "Ils nous ont offert la subvention sans aucune <w>condition</w> cachée."
                            }
                        },
                        {
                            "text": "It sounds like a great deal, but are there any hidden <strings>?",
                            "target_lang_translations": {
                                "ru": "Звучит как отличное предложение, но нет ли здесь скрытых <оговорок>?",
                                "fr": "Cela semble être une excellente affaire, mais y a-t-il des <w>contraintes</w> cachées ?"
                            }
                        }
                    ],
                    "synonyms": [
                        "conditions",
                        "restrictions",
                        "provisos",
                        "stipulations"
                    ],
                    "common_phrases": [
                        "strings attached",
                        "no strings attached",
                        "pull strings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особые условия, ограничения или обязательства, связанные с предложением или соглашением.",
                        "fr": "Conditions, restrictions ou obligations cachées liées à une offre ou un accord."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "условия",
                                "target_lang_sense_clarification": "ограничения, требования"
                            },
                            {
                                "target_lang_word": "обязательства",
                                "target_lang_sense_clarification": "в идиоме \"без обязательств\""
                            },
                            {
                                "target_lang_word": "оговорки",
                                "target_lang_sense_clarification": "специальные пункты соглашения"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "conditions",
                                "target_lang_sense_clarification": "exigences ou contraintes"
                            },
                            {
                                "target_lang_word": "contraintes",
                                "target_lang_sense_clarification": "obligations restrictives"
                            }
                        ]
                    }
                }
            ]
