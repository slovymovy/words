                ],
                "translations": [
                    {
                        "translation_id": "210aa741-3b32-4016-87d5-f5b66cb20c75",
                        "source_entry_id": "44ef675e-9cc2-3a8c-b011-16d99ac9de18",
                        "target_lang_word": "leash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec2c5fca-0ace-3b31-a2ea-e45c9f269d57",
                                        "entry_id": "1266b861-af7a-39f2-abcd-29a6d4ff8cf7",
                                        "glosses": [
                                            "A strap, cord or rope with which to restrain an animal, often a dog."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c12c79b4-cf3c-4cd7-bd59-abcc1397c0cf",
                                                "sense_id": "ec2c5fca-0ace-3b31-a2ea-e45c9f269d57",
                                                "text": "A stout woman upholstered in velvet, her flabby cheeks too much massaged, swirled by with her poodle straining at its leash"
                                            },
                                            {
                                                "example_id": "115d48df-c142-4590-8499-7d98fdb213cf",
                                                "sense_id": "ec2c5fca-0ace-3b31-a2ea-e45c9f269d57",
                                                "text": "like a fawning greyhound in the leash"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26664251-7d65-394a-b030-becec201df69",
                                        "entry_id": "1266b861-af7a-39f2-abcd-29a6d4ff8cf7",
                                        "glosses": [
                                            "A brace and a half; a tierce."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43368eaf-6ce7-3dca-ac6b-ac033daea871",
                                        "entry_id": "1266b861-af7a-39f2-abcd-29a6d4ff8cf7",
                                        "glosses": [
                                            "A set of three animals (especially greyhounds, foxes, bucks, and hares;)"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c264b467-1f40-3bc0-9343-dfac5543c12f",
                                        "entry_id": "1266b861-af7a-39f2-abcd-29a6d4ff8cf7",
                                        "glosses": [
                                            "A group of three."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d57611dd-ecaf-4768-90c9-cbd685411e0c",
                                                "sense_id": "c264b467-1f40-3bc0-9343-dfac5543c12f",
                                                "text": "Sirrah, I am sworn brother to a leash of drawers; and can call them all by their Christian names, as, Tom, Dick, and Francis."
                                            },
                                            {
                                                "example_id": "f1f74826-28fd-4fcd-b466-fc052c665227",
                                                "sense_id": "c264b467-1f40-3bc0-9343-dfac5543c12f",
                                                "text": "[I] kept my chamber a leash of days."
                                            },
                                            {
                                                "example_id": "59387630-e181-44a2-8b74-f19d0ce8c792",
                                                "sense_id": "c264b467-1f40-3bc0-9343-dfac5543c12f",
                                                "text": "It had an odd promiscuous tone, / As if h' had talk'd three parts in one; / Which made some think, when he did gabble, / Th' had heard three labourers of Babel; / Or Cerberus himself pronounce / A leash of languages at once."
                                            },
                                            {
                                                "example_id": "404cd7fe-38d4-421f-903b-788708f3501a",
                                                "sense_id": "c264b467-1f40-3bc0-9343-dfac5543c12f",
                                                "text": "An I could climb and lay my hand upon it, / Then were I wealthier than a leash of kings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89e24f2b-67d4-39dc-9b65-7c7aabe87a67",
                                        "entry_id": "1266b861-af7a-39f2-abcd-29a6d4ff8cf7",
                                        "glosses": [
                                            "A string with a loop at the end for lifting warp threads, in a loom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9cdd0f4-203d-3e2c-953f-8cef5a7328a6",
                                        "entry_id": "1266b861-af7a-39f2-abcd-29a6d4ff8cf7",
                                        "glosses": [
                                            "A leg rope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "665e3c91-00ba-45ce-a725-f0f9aaffc1b6",
                                                "sense_id": "d9cdd0f4-203d-3e2c-953f-8cef5a7328a6",
                                                "text": "Probably the idea was around before that, but the first photo of the leash in action was published that year"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fc11cca-6058-3b96-a4c2-fe4209c62794",
                                        "entry_id": "1266b861-af7a-39f2-abcd-29a6d4ff8cf7",
                                        "glosses": [
                                            "A kind of metrical construct in Skeltonics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "leash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "640d14e1-5f62-31c1-bc84-87a109792814",
