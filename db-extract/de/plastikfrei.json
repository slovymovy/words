                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4835cd8-f3bc-3bca-80d7-62dd662c8c24",
                        "entry_id": "d7b7ed0c-eabc-3c8c-8753-aed16ebb0580",
                        "glosses": [
                            "kein Plastik enthaltend; ohne Plastik/Kunststoffe auskommend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28e084af-8cc8-4a8b-ba09-ca05eab051b4",
                                "sense_id": "f4835cd8-f3bc-3bca-80d7-62dd662c8c24",
                                "text": "„Küchenhelfer gibt es wie Sand am Meer, in der Zwischenzeit auch plastikfrei.“"
                            },
                            {
                                "example_id": "aafd5a5d-e58a-4114-b88c-2148a487f2e4",
                                "sense_id": "f4835cd8-f3bc-3bca-80d7-62dd662c8c24",
                                "text": "„Warum nicht Gesetze dafür schaffen, dass es Vorschrift wird, dass der Supermarkt plastikfrei sein muss?“"
                            },
                            {
                                "example_id": "2bd3c1eb-d975-44e4-9541-6b795550b2c1",
                                "sense_id": "f4835cd8-f3bc-3bca-80d7-62dd662c8c24",
                                "text": "„Länder, Unternehmen und Bürgerinitiativen sollen darüber nachdenken, wie eine plastikfreie Welt aussehen könnte.“"
                            },
                            {
