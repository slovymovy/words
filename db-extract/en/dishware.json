                    {
                        "translation_id": "7a4248f2-ee03-4fd8-a2e7-8b11360e25ae",
                        "source_entry_id": "7d304fe7-e972-3a05-be90-10cf5168592d",
                        "source_sense_id": "8304775c-3ce0-3552-9300-caf5290b0264",
                        "source_sense_description": "crockery",
                        "target_lang_word": "посу́да",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "посу́да",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "56f1e837-2972-3859-88b5-50a4b7d3617e",
                                        "entry_id": "562d0946-ec85-344a-924b-e04a2405ca3d",
                                        "glosses": [
                                            "обобщённое название кухонной утвари — сосудов и ёмкостей для хранения или приготовления еды, питья, а также столовых приборов для приёма пищи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42e25cce-f1a3-4b6e-a478-e11a7e7e4242",
                                                "sense_id": "56f1e837-2972-3859-88b5-50a4b7d3617e",
                                                "text": "Мама сказала ему, чтобы он наконец вымыл посуду."
                                            },
                                            {
                                                "example_id": "e5b4a4b6-27a9-4e1e-8bdf-f9d9a0d17c61",
                                                "sense_id": "56f1e837-2972-3859-88b5-50a4b7d3617e",
                                                "text": "Я вошёл в чистенькую комнатку, убранную по-старинному. В углу стоял шкаф с посудой .."
                                            },
                                            {
                                                "example_id": "af89a0f1-65ee-4090-aa08-dd0611192461",
                                                "sense_id": "56f1e837-2972-3859-88b5-50a4b7d3617e",
                                                "text": "Хозяйка поставила на стол полутораведерный самовар, чайную посуду, принесла две большие булки."
                                            },
                                            {
                                                "example_id": "d9a04d70-24d6-4991-bd2e-8146ca269c4f",
                                                "sense_id": "56f1e837-2972-3859-88b5-50a4b7d3617e",
                                                "text": "Аксинья Захаровна вынимала из сундуков серебряную и фарфоровую посуду, приготовленную дочерям в приданое."
                                            },
                                            {
                                                "example_id": "22e93a47-fa3c-4592-8f2d-56dd4c247eb5",
                                                "sense_id": "56f1e837-2972-3859-88b5-50a4b7d3617e",
                                                "text": "Людмила Николаевна перемыла кухонную и столовую посуду, и Виктор Павлович вытирал под её руководством тарелки, вилки и ножи, чайную посуду она не доверила ему."
                                            },
                                            {
                                                "example_id": "65262cc7-00f5-4e2a-be6e-9e61dec8692b",
                                                "sense_id": "56f1e837-2972-3859-88b5-50a4b7d3617e",
                                                "text": "На кухне хозяйка мыла посуду после праздничного стола."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07c79535-a415-35ae-85b8-26b7d608e82e",
                                        "entry_id": "562d0946-ec85-344a-924b-e04a2405ca3d",
                                        "glosses": [
                                            "стеклянная или пластиковая тара, в которой продаётся товар"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82f94bfe-f5a5-4986-a180-315d55afe069",
                                                "sense_id": "07c79535-a415-35ae-85b8-26b7d608e82e",
                                                "text": "На ценнике была указана цена одного килограмма подсолнечного масла без стоимости посуды."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecced050-af5c-353f-919a-e1b33f0d863e",
                                        "entry_id": "562d0946-ec85-344a-924b-e04a2405ca3d",
                                        "glosses": [
                                            "хим. ёмкость для хранения жидкостей и сыпучих веществ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9c530c0-c7f0-4ad5-8d5a-394e1a33dd17",
                                                "sense_id": "ecced050-af5c-353f-919a-e1b33f0d863e",
                                                "text": "Мытьё химической посуды — важный навык любого химика-аналитика."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
