                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67f7697f-848f-3de6-97a8-aaf8d878eac5",
                                        "entry_id": "76d44634-8755-3d78-8664-7fc2376285a0",
                                        "glosses": [
                                            "A heavy breather."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be1f9628-8a1b-41ee-a7a2-cdd5671f9117",
                                                "sense_id": "67f7697f-848f-3de6-97a8-aaf8d878eac5",
                                                "text": "Most of us make sense of the world through talk and sight, and breathers represent that most anxiety provoking experience, nothingness with a hint of possibility."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22527e13-f840-38d5-ad48-609c10c7b666",
                                        "entry_id": "76d44634-8755-3d78-8664-7fc2376285a0",
                                        "glosses": [
                                            "A short break; a rest or respite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fe9bacf-18a8-4b43-a797-e7e9b6d8592a",
                                                "sense_id": "22527e13-f840-38d5-ad48-609c10c7b666",
                                                "text": "After a short breather she was ready to continue up the hill."
                                            },
                                            {
                                                "example_id": "3ae6d589-fe28-46b9-9176-e14f0d9da151",
                                                "sense_id": "22527e13-f840-38d5-ad48-609c10c7b666",
                                                "text": "I took a breather and decided not to ruin my life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "855648fd-96e1-3a1f-ac42-300f3506bd3b",
                                        "entry_id": "76d44634-8755-3d78-8664-7fc2376285a0",
                                        "glosses": [
                                            "A spatially localized, time-periodic excitation in a one-dimensional lattice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8a9bb7d-414a-30d6-975c-a831701e78b9",
                                        "entry_id": "76d44634-8755-3d78-8664-7fc2376285a0",
                                        "glosses": [
                                            "That which puts one out of breath, such as violent exercise."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated"
                                        ],
