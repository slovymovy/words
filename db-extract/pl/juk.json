                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29b1b831-b209-3901-9ab7-ad799e298346",
                                        "entry_id": "70fbbf1e-79da-3033-a626-fd81262deb4a",
                                        "glosses": [
                                            "A covered pouch, usually one of a pair, laid across the back of a horse, donkey, or mule behind its saddle, or hanging over the rear wheel of a motorcycle; often made of leather or (on a motorcycle) a rigid material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16127fca-0ab1-4f2b-ae4c-6891476d9358",
                                                "sense_id": "29b1b831-b209-3901-9ab7-ad799e298346",
                                                "text": "Frustrated, rushed, you toss the saddlebags filled with textbooks, ungraded papers, and drafts of poems onto the back of your cruiser motorcycle and roar off down Ambler not thinking speed and a strong crosswind will lift the saddlebags into flight like some leather-winged prehistoric bird hanging in the air a second before flopping onto the busiest street in North Abilene."
                                            },
                                            {
                                                "example_id": "4408073c-b6ff-4220-986e-36bf9c80be12",
                                                "sense_id": "29b1b831-b209-3901-9ab7-ad799e298346",
                                                "text": "Lifting the reins over the horse's head, he tied them to a nearby tree limb and moved back to the saddlebags. Untying the leather thongs that bound them behind the saddle, he picked the saddlebags up, hobbled to a nearby tree, and sat down at its base."
                                            },
                                            {
                                                "example_id": "2109d7c4-d9c3-47b5-821b-01dd6277eb4d",
                                                "sense_id": "29b1b831-b209-3901-9ab7-ad799e298346",
                                                "text": "There was no camp, bedroll, or fire and no other sign of a man, just the saddled horse with saddlebags and packs tied on behind it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d6fa017-7291-3d15-924d-d4d780bcaadd",
                                        "entry_id": "70fbbf1e-79da-3033-a626-fd81262deb4a",
                                        "glosses": [
                                            "pannier"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "nonstandard"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1817251e-be51-3bf1-8993-83444e10e52a",
                                        "entry_id": "70fbbf1e-79da-3033-a626-fd81262deb4a",
                                        "glosses": [
                                            "A seat pack or a seat bag (a pouch or a small bag attached to the seat or seat post of a bicycle)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af5f528c-c249-3823-9bba-8f6a47a629a9",
                                        "entry_id": "70fbbf1e-79da-3033-a626-fd81262deb4a",
                                        "glosses": [
                                            "Loose fatty flesh on a person's upper thighs or buttocks, that hangs like saddlebags."
                                        ],
                                        "tags": [
                                            "US",
                                            "in-plural",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b466f28-fad2-438e-bc76-783de910ffd0",
                                                "sense_id": "af5f528c-c249-3823-9bba-8f6a47a629a9",
                                                "text": "The area treated was always the side of the thighs, where she had visible saddlebags."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07216704-a623-3a9b-91e9-5e9f7c616419",
                                        "entry_id": "70fbbf1e-79da-3033-a626-fd81262deb4a",
                                        "glosses": [
                                            "A style of house with two rooms separated by a small hall and open space."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
