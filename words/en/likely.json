        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "92504198-66f3-3faa-b1d8-ae552040179c",
                    "sense_definition": "In all probability; probably.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "probability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He will most <w>likely</w> win the election given the current economy.",
                            "target_lang_translations": {
                                "ru": "Учитывая текущую экономическую ситуацию, он, <w>скорее всего</w>, победит на выборах.",
                                "tr": "Mevcut ekonomi göz önüne alındığında seçimleri <w>büyük ihtimalle</w> o kazanacak.",
                                "zh": "考虑到当前的经济状况，他<w>很可能</w>会赢得选举。"
                            }
                        },
                        {
                            "text": "We will <w>likely</w> arrive a few minutes late due to traffic.",
                            "target_lang_translations": {
                                "ru": "Мы, <w>вероятно</w>, прибудем на несколько минут позже из-за пробок.",
                                "tr": "Trafik nedeniyle <w>muhtemelen</w> birkaç dakika geç varacağız.",
                                "zh": "由于交通拥堵，我们<w>大概</w>会迟到几分钟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "probably",
                        "presumably"
                    ],
                    "common_phrases": [
                        "most likely",
                        "very likely",
                        "quite likely"
                    ],
                    "target_lang_definitions": {
                        "ru": "По всей вероятности; возможно.",
                        "tr": "Büyük ihtimalle; muhtemelen.",
                        "zh": "很有可能；大概。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вероятно",
                                "target_lang_sense_clarification": "по всей видимости"
                            },
                            {
                                "target_lang_word": "скорее всего",
                                "target_lang_sense_clarification": "с наибольшей вероятностью"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "muhtemelen",
                                "target_lang_sense_clarification": "büyük bir ihtimalle"
