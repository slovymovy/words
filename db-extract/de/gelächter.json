                        ],
                        "form": "das Gelächter"
                    },
                    {
                        "form_id": "82a7e85b-83f9-480f-ac56-2510f9748221",
                        "entry_id": "c7135f6b-6686-37d9-b32a-3259906af9f2",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gelächter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "afd3304c-334b-3a3f-8ad8-10a6891d9ec1",
                        "entry_id": "c7135f6b-6686-37d9-b32a-3259906af9f2",
                        "glosses": [
                            "beständiges Lachen, das über eine relativ lange Zeit andauert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ce7980d-c454-4024-9d31-e8dd878528f4",
                                "sense_id": "afd3304c-334b-3a3f-8ad8-10a6891d9ec1",
                                "text": "„Im Einschlafen hörte ich eine schrille Stimme zu mir heraufdringen, die manchmal von männlichem Gelächter unterbrochen wurde.“"
                            },
                            {
                                "example_id": "f8b9894c-4848-4bba-a762-0304e2fa5b7c",
                                "sense_id": "afd3304c-334b-3a3f-8ad8-10a6891d9ec1",
                                "text": "Die Männer brachen in schallendes Gelächter aus."
                            },
                            {
                                "example_id": "a3bde9df-a514-4ca6-8b61-0e7af9b3f3fc",
                                "sense_id": "afd3304c-334b-3a3f-8ad8-10a6891d9ec1",
                                "text": "„Wir stimmten alle in das Gelächter ein und prosteten uns mit unserem Tee zu.“"
                            },
                            {
                                "example_id": "c09b4b79-6571-40cd-a0a0-c17638091cae",
                                "sense_id": "afd3304c-334b-3a3f-8ad8-10a6891d9ec1",
                                "text": "„Eine Regung von Gelächter selbst in diesem Augenblick.“"
                            },
                            {
                                "example_id": "2bedd8bd-e919-42c7-bad1-2cb55285232f",
                                "sense_id": "afd3304c-334b-3a3f-8ad8-10a6891d9ec1",
                                "text": "„Ohne das Gelächter wäre diese Szene eine ganz andere gewesen, aber das hätte ich meiner Großmutter nicht begreiflich machen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecdda14a-38f0-42e1-9b1a-5f31f1364a22",
                        "source_entry_id": "c7135f6b-6686-37d9-b32a-3259906af9f2",
                        "source_sense_id": "afd3304c-334b-3a3f-8ad8-10a6891d9ec1",
                        "source_sense_description": "beständiges Lachen, das über eine relativ lange Zeit andauert",
                        "target_lang_word": "laughter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laughter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a076e396-38e6-33c3-939d-3291e63543fb",
                                        "entry_id": "225a4d83-1fbc-3dac-ae9d-dfdd255b9e6d",
                                        "glosses": [
                                            "The sound of laughing, produced by air so expelled; any similar sound."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32ad3a68-acd0-439a-998b-c4a728f68dda",
                                                "sense_id": "a076e396-38e6-33c3-939d-3291e63543fb",
                                                "text": "Their loud laughter betrayed their presence."
                                            },
                                            {
                                                "example_id": "fef6fcae-c8df-4fee-aa09-7a2e844df01c",
                                                "sense_id": "a076e396-38e6-33c3-939d-3291e63543fb",
                                                "text": "There was some laughter, and Roddle was left free to expand his ideas on the periodic visits of cowboys to the town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5adbddc-4873-39ed-9981-82c689ee088a",
                                        "entry_id": "225a4d83-1fbc-3dac-ae9d-dfdd255b9e6d",
                                        "glosses": [
                                            "A movement (usually involuntary) of the muscles of the laughing face, particularly of the lips, and of the whole body, with a peculiar expression of the eyes, indicating merriment, satisfaction or derision, and usually attended by a sonorous and interrupted expulsion of air from the lungs."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63d3f143-aa17-4cad-a513-1deec1caf1c6",
                                                "sense_id": "c5adbddc-4873-39ed-9981-82c689ee088a",
                                                "text": "The act of laughter, which is caused by a sweet contraction of the muscles of the face, and a pleasant agitation of the vocal organs, is not merely, or totally within the jurisdiction of ourselves."
                                            },
                                            {
                                                "example_id": "a14eed29-c356-483c-b1b3-0379c0093bbf",
                                                "sense_id": "c5adbddc-4873-39ed-9981-82c689ee088a",
                                                "text": "Archly the maiden smiled, and with eyes overrunning with laughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da8c494a-b76f-3067-a392-84d8d43ecc13",
                                        "entry_id": "225a4d83-1fbc-3dac-ae9d-dfdd255b9e6d",
                                        "glosses": [
                                            "A reason for merriment."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
