                    },
                    {
                        "translation_id": "a17c53cd-40e4-4bf4-8e80-4a047d09e843",
                        "source_entry_id": "191c1f6a-5aab-3e9b-b990-febdb27c6f44",
                        "target_lang_word": "squat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "squat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f413452-99ab-37df-97da-c3d5c99ca74b",
                                        "entry_id": "8d82623a-2c18-38dc-9388-b8fb50b5dc89",
                                        "glosses": [
                                            "Relatively short or low, and thick or broad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eabfdae9-797e-45d0-8e00-04862788a9b3",
                                                "sense_id": "7f413452-99ab-37df-97da-c3d5c99ca74b",
                                                "text": "The SQUILL-INSECT. […] So called from ſome ſimilitude to the Squill-fiſh: chiefly, in having a long Body cover'd with a Cruſt compoſed of ſeveral Rings or Plates. The Head is broad and ſquat. He hath a pair of notable ſharp Fangs before, both hooked inward like a Bulls horns."
                                            },
                                            {
                                                "example_id": "f0c0e27f-4a13-4cdb-82ef-cfb1c3ac9024",
                                                "sense_id": "7f413452-99ab-37df-97da-c3d5c99ca74b",
                                                "text": "What in the midst lay but the Tower itself? / The round squat turret, blind as the fool's heart, / Built of round stone, without a counterpart / In the whole world. […]"
                                            },
                                            {
                                                "example_id": "adc4f475-456b-4cdb-a3f6-0b8a7feff69e",
                                                "sense_id": "7f413452-99ab-37df-97da-c3d5c99ca74b",
                                                "text": "On the gentle slopes there are farms, ancient and rocky, with squat, moss-coated cottages brooding eternally over old New England secrets in the lee of great ledges […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a81c0d68-aa83-3523-b02f-c2d196117293",
                                        "entry_id": "8d82623a-2c18-38dc-9388-b8fb50b5dc89",
                                        "glosses": [
                                            "Sitting on one's heels; sitting close to the ground; cowering or crouching."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39b8a2fd-3b3b-4ee1-98a0-e58a8715abcc",
                                                "sense_id": "a81c0d68-aa83-3523-b02f-c2d196117293",
                                                "text": "[H]im there they found, / Squat like a toad, cloſe at the ear of Eve, / Aſſaying by his deviliſh art to reach / The organs of her fancy', and with them forge / Illuſions as he liſt, phantaſms and dreams, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "squat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6cf3bda-9c12-34af-bd2b-93c07f8a2b28",
                                        "entry_id": "5d5ebd93-7f4b-30af-8d9f-3d57f31e9d65",
                                        "glosses": [
                                            "A position assumed by bending deeply at the knees while resting on one's feet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf35035f-499b-4531-97b9-192c2158b33b",
                                                "sense_id": "e6cf3bda-9c12-34af-bd2b-93c07f8a2b28",
                                                "text": "Sit in a squat, with your feet a comfortable distance apart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "126ab3c7-318d-3519-b99d-abd03942693f",
                                        "entry_id": "5d5ebd93-7f4b-30af-8d9f-3d57f31e9d65",
                                        "glosses": [
                                            "Any of various modes of callisthenic exercises performed by moving the body and bending at least one knee."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47c727b4-bd11-3b01-91ec-7d9d6ee96e78",
                                        "entry_id": "5d5ebd93-7f4b-30af-8d9f-3d57f31e9d65",
                                        "glosses": [
                                            "Any of various modes of callisthenic exercises performed by moving the body and bending at least one knee.",
                                            "A specific exercise in weightlifting performed by bending deeply at the knees and then rising (back squat), especially with a barbell resting across the shoulders (barbell back squat)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa9fba5a-3515-4184-86ff-eb5ed2324afe",
                                                "sense_id": "47c727b4-bd11-3b01-91ec-7d9d6ee96e78",
                                                "text": "The king of all quad exercises, and arguably the best single-weight resistance exercise, is the squat."
                                            },
                                            {
                                                "example_id": "4bcd8814-e143-496e-958f-b6fb834f8dfd",
                                                "sense_id": "47c727b4-bd11-3b01-91ec-7d9d6ee96e78",
                                                "text": "Before we can discuss ass-to-grass squats, or ATG squats for short, we must first establish some knowledge about squats in general. […] Now, lift the bar off the squat rack rests and step away from any part of the rack that may inhibit a full range of motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "671ebe1f-49fb-3c9f-bf8f-a094d2e8d495",
                                        "entry_id": "5d5ebd93-7f4b-30af-8d9f-3d57f31e9d65",
                                        "glosses": [
                                            "A building occupied without permission, as practiced by a squatter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "450d03ec-f39d-4b07-b731-4a966ef09744",
                                                "sense_id": "671ebe1f-49fb-3c9f-bf8f-a094d2e8d495",
                                                "text": "Your dumb self can't appreciate the freedom in my thought / The weak sense of autonomy when I'm flipping in my squat"
                                            },
                                            {
                                                "example_id": "6129b78d-cc41-4a48-baa4-18c3f37a9cce",
                                                "sense_id": "671ebe1f-49fb-3c9f-bf8f-a094d2e8d495",
                                                "text": "\"Keeping your friends warm and dry, that doesn't happen here. If you want to spend a night in a squat, it's all political to get in.\" Lately, as buildings have filled and become stringent about new admissions, much of the squatters' \"My house is your house\" rhetoric has become hollow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76679f6d-e1b2-332f-bd4e-285f89027fc0",
                                        "entry_id": "5d5ebd93-7f4b-30af-8d9f-3d57f31e9d65",
                                        "glosses": [
                                            "A place of concealment in which a hare spends time when inactive, especially during the day; a form."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2766b877-39ed-3375-b3e4-3d7f7974da3c",
                                        "entry_id": "5d5ebd93-7f4b-30af-8d9f-3d57f31e9d65",
                                        "glosses": [
                                            "A toilet used by squatting as opposed to sitting; a squat toilet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f799a2b9-7445-3380-8e19-2092074e6260",
                                        "entry_id": "5d5ebd93-7f4b-30af-8d9f-3d57f31e9d65",
                                        "glosses": [
                                            "Clipping of diddly-squat; something of no value."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9630dc4-6b14-424d-8165-4ebf67662e41",
                                                "sense_id": "f799a2b9-7445-3380-8e19-2092074e6260",
                                                "text": "I know squat about nuclear physics."
                                            },
                                            {
                                                "example_id": "6a57cb64-ed80-4790-8b93-d5283e9ac46b",
                                                "sense_id": "f799a2b9-7445-3380-8e19-2092074e6260",
                                                "text": "We didn't ask for rent, but we assumed they'd help around the house. But they don't do squat."
                                            },
                                            {
                                                "example_id": "801023b1-4c22-4e90-aa55-8ed3236eec28",
                                                "sense_id": "f799a2b9-7445-3380-8e19-2092074e6260",
                                                "text": "\"Joke's on you. They're used to me mostly talking about superficial stuff. Nobody's going to notice squat.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ef2812a-686b-3ad7-9a1b-ab57242f52ae",
                                        "entry_id": "5d5ebd93-7f4b-30af-8d9f-3d57f31e9d65",
                                        "glosses": [
                                            "A small vein of ore."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5bf3bce9-5b55-3569-9990-d48e4932a5ce",
                                        "entry_id": "5d5ebd93-7f4b-30af-8d9f-3d57f31e9d65",
                                        "glosses": [
                                            "A mineral consisting of tin ore and spar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be019107-d21d-42eb-8b53-cc1c34063b6b",
                                                "sense_id": "5bf3bce9-5b55-3569-9990-d48e4932a5ce",
                                                "text": "A Mineral, very ponderous, and probably holding Tin. […] 'Twas part of a Squat, at Hewas-Work; not far from Polgouth, in St. Stephen's Liberty, Cornwall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99ab2e06-cc21-3632-8b4d-d00f8f23b54f",
                                        "entry_id": "5d5ebd93-7f4b-30af-8d9f-3d57f31e9d65",
                                        "glosses": [
                                            "Squat effect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e6cb08e-6fa2-30bc-b044-4a646ea586d6",
                                        "entry_id": "5d5ebd93-7f4b-30af-8d9f-3d57f31e9d65",
