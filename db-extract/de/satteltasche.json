                    },
                    {
                        "translation_id": "0f5ee7d0-9657-4de4-a972-809ff558068e",
                        "source_entry_id": "d01e5179-6c33-3f8c-9dae-99bdc866f7b7",
                        "source_sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                        "source_sense_description": "Tasche, die man am Sattel eines Fahrrades/Motorrades oder Reittiers befestigen kann",
                        "target_lang_word": "sacoche de selle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "94d35e02-5b2d-41ad-8c3b-09fd9e55b4ce",
                        "source_entry_id": "d01e5179-6c33-3f8c-9dae-99bdc866f7b7",
                        "source_sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                        "source_sense_description": "Tasche, die man am Sattel eines Fahrrades/Motorrades oder Reittiers befestigen kann",
                        "target_lang_word": "fontes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fontes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f889e5f2-6d56-3e3c-bbfe-7cedbb18b2dc",
                                        "entry_id": "ebfe84e9-456f-3da4-945c-13df9acb6b02",
                                        "glosses": [
                                            "Fourreau de cuir pour les pistolets."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41fc2b74-b0d7-4fa5-b24a-76d46b7dc889",
                                                "sense_id": "f889e5f2-6d56-3e3c-bbfe-7cedbb18b2dc",
                                                "text": "[…] ; mon père glissa ses propres pistolets, chef-d’œuvre de la manufacture de Toula, dans mes fontes, m’embrassa, et donna l’ordre du départ."
                                            },
                                            {
                                                "example_id": "5db119d6-0b95-4b87-b5f2-3eec0c5b468c",
                                                "sense_id": "f889e5f2-6d56-3e3c-bbfe-7cedbb18b2dc",
                                                "text": "On ne l’avait pas même vu toucher les fontes de sa selle. […]. Un éclair s’alluma dans la main du jeune comte et un coup de feu retentit."
                                            },
                                            {
                                                "example_id": "604bcfac-087c-4edb-9f9f-6471bd3c2454",
                                                "sense_id": "f889e5f2-6d56-3e3c-bbfe-7cedbb18b2dc",
                                                "text": "Vous étiez seul avec lui, alors vous prîtes un pistolet dans vos fontes, et, tandis qu’il se penchait, vous lui brisâtes les reins ; […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fontes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73a1c92a-4cdd-3624-a9fa-debb7a144b69",
                                        "entry_id": "d99ea42c-ab12-39ce-8adf-2717dac17b27",
                                        "glosses": [
                                            "Pluriel de fonte."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "374be9b9-a2d8-4e0e-9bd2-2d387fb20093",
                                                "sense_id": "73a1c92a-4cdd-3624-a9fa-debb7a144b69",
                                                "text": "Je fourre les plans dans les fontes de ta bécane."
                                            },
                                            {
                                                "example_id": "f627af8a-ea6d-410c-bfd6-c14cfb4cb49a",
                                                "sense_id": "73a1c92a-4cdd-3624-a9fa-debb7a144b69",
                                                "text": "Dans certains cas (fontes spéciales et fonte de moulage), il peut être nécessaire de décyanurer cette purge."
                                            },
                                            {
                                                "example_id": "3374e6ea-be0b-468d-9b02-f7ca32152e28",
                                                "sense_id": "73a1c92a-4cdd-3624-a9fa-debb7a144b69",
                                                "text": "Sa monture, un troisième la maintenait, tandis que pas moins de trois hommes en pillaient les fontes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
