                ],
                "senses": [
                    {
                        "sense_id": "3e0aa073-60ff-3508-95c2-119f5c2a5e40",
                        "entry_id": "67972d89-e084-3191-b6e6-12407a13d994",
                        "glosses": [
                            "erfolgreich durchgeführte hochgradig waghalsige Unternehmung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc91a353-a8d2-42f3-8f65-ba465d344bde",
                                "sense_id": "3e0aa073-60ff-3508-95c2-119f5c2a5e40",
                                "text": "„Nach den bekannt gewordenen Informationen lässt sich vermuten, nicht beweisen, dass es sich bei dem Unglücksflug um ein fliegerisches Husarenstück handelte, wie es in Offizierskreisen der Luftwaffe vieler Länder Tradition hat.“"
                            },
                            {
                                "example_id": "dd3623c2-6cb1-466e-a2a4-0cae69b36909",
                                "sense_id": "3e0aa073-60ff-3508-95c2-119f5c2a5e40",
                                "text": "„Glaubt man den Augenzeugen, so war es nicht das erste Mal, daß ein Militärpilot das Husarenstück versucht hat, während der Betriebszeit unter den Seilen durchzutauchen.“"
                            },
                            {
                                "example_id": "5a4b9ed8-bfa0-47f2-9ee7-c1d0b8fec711",
                                "sense_id": "3e0aa073-60ff-3508-95c2-119f5c2a5e40",
                                "text": "„Die Anklageerhebung war in ihrer Überrumpelung ein Husarenstück, weil der damals zuständige Staatsanwalt die den Verteidigern eingeräumte Frist zur Stellungnahme nicht abgewartet hat.“"
                            },
                            {
                                "example_id": "6de344ae-2681-49f1-a7c0-53e681ca5af2",
                                "sense_id": "3e0aa073-60ff-3508-95c2-119f5c2a5e40",
                                "text": "„Es war zweifellos ein Fehler, daß das ZKM nicht die Zusammenarbeit mit den alten Karlsruher Einrichtungen suchte, etwa der Staatlichen Kunsthalle und der Kunstakademie, die sich ebenso in die Ecke gedrängt fühlen wie die Stuttgarter Staatsgalerie, der Klotz das lang geplante Sammlermuseum in einem Husarenstück vor der Nase wegschnappte.“"
                            },
                            {
                                "example_id": "64436890-1b81-42e6-9e02-0b7bbc68f988",
                                "sense_id": "3e0aa073-60ff-3508-95c2-119f5c2a5e40",
                                "text": "„Die Schalker müssen nach ihrem Husarenstück in Madrid auch in Berlin Charakterstärke zeigen, Wolfsburg darf sich gegen den Tabellenvorletzten Freiburg keine Blöße geben.“"
                            },
                            {
                                "example_id": "437baaad-050a-43fa-8195-6984e20e78ee",
                                "sense_id": "3e0aa073-60ff-3508-95c2-119f5c2a5e40",
                                "text": "„Was Helmy den Gestapo-Männern darbot, war sein letztes Husarenstück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
