                    {
                        "sense_id": "30011c6e-f441-302b-b51e-7d36db7ba29f",
                        "entry_id": "d06dba82-312e-3b73-b6cf-0cf7e9e67b84",
                        "glosses": [
                            "Tobacco."
                        ],
                        "tags": [
                            "slang",
