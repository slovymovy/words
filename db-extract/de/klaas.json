                "translations": [
                    {
                        "translation_id": "f694bf11-b27c-4b1c-8dc1-8e2bda2ec49a",
                        "source_entry_id": "47a2b3ff-b6ed-3e06-a625-2da0c520db9d",
                        "source_sense_id": "3da16d24-757a-36c4-bed7-ef2e00afc877",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Nick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aee706aa-2aeb-3212-9769-81c6aa982e5d",
                                        "entry_id": "8c6a88f3-603a-3b63-aadf-c5348799f7f7",
                                        "glosses": [
                                            "A diminutive of the male given name Nicholas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc98c486-e6eb-47e9-8b76-d28a7cd8ec24",
                                                "sense_id": "aee706aa-2aeb-3212-9769-81c6aa982e5d",
                                                "text": "His name is Nick. I love it. It makes him seem nice, and regular, which he is. When he tells me his name, I say, 'Now, that's a real name.'"
                                            },
                                            {
                                                "example_id": "c644e9ff-0263-4928-9acd-d0f62254e3e1",
                                                "sense_id": "aee706aa-2aeb-3212-9769-81c6aa982e5d",
                                                "text": "You look at the groypers, you look at Nick Fuentes, you look at people who are by any measure white supremacists and people we would have called the kooky Nazi right, with their Pepe the Frog memes — they all felt very ill at home in Mitt Romney’s Republican Party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "802a7809-2d80-4b4a-a622-3c7305ddc217",
                        "source_entry_id": "47a2b3ff-b6ed-3e06-a625-2da0c520db9d",
                        "source_sense_id": "3da16d24-757a-36c4-bed7-ef2e00afc877",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Коля",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Коля",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d0ab2cdd-93c4-3fc8-93fc-3b268f64af11",
                                        "entry_id": "ac491cdb-e627-3bb8-a16e-c5e0b4c375b1",
                                        "glosses": [
                                            "гипокор. к Николай"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "886edace-8be3-4f7f-9c0f-605f7c582675",
                                                "sense_id": "d0ab2cdd-93c4-3fc8-93fc-3b268f64af11",
                                                "text": "Коля тотчас же возразил ей, что если б он не уважал в ней женщину, и сверх того свои убеждения, то немедленно доказал бы ей, что умеет ответить на подобное оскорбление."
                                            },
                                            {
                                                "example_id": "f14fc64d-a56a-4c62-b673-e4806246d0e9",
                                                "sense_id": "d0ab2cdd-93c4-3fc8-93fc-3b268f64af11",
                                                "text": "Лапкин вынул из кармана рубль и подал его Коле."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
