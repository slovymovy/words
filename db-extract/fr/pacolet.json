                    {
                        "sense_id": "e6787835-dc0a-3fb5-b233-fa68fb22d467",
                        "entry_id": "af802ae3-94d7-3fd0-abf8-61ee5e830ac9",
                        "glosses": [
                            "Cheville d'amarrage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "805ef782-d1cd-477a-8dcc-e1db6d6b0216",
                                "sense_id": "e6787835-dc0a-3fb5-b233-fa68fb22d467",
                                "text": "Ils font cette amarre au moyen d'un œillet qui est formé au bout des Paux, dans lequel ils sont passer les libans ployés en deux , dans l'anse que forme cette duplicature, une cheville qu'ils nomment pacolet. — (Duhamel du Monceau, Descriptions des arts et métiers, Éd. Saillant& Nyon, Paris 1769)"
                            },
                            {
                                "example_id": "9bbf45f0-bd57-4e6d-baed-b17519c5324c",
                                "sense_id": "e6787835-dc0a-3fb5-b233-fa68fb22d467",
                                "text": "Quand le patron veut finir sa pêche et lever son filet, il tire à lui une petite ligne qui répond à la cheville nommée pacolet."
                            }
                        ]
                    }
