                        "source_entry_id": "16aa9419-e202-3d40-9138-f306c8db5a60",
                        "source_sense_id": "45c4a5c9-4402-3948-849e-4becf2d9a11e",
                        "source_sense_description": "kruid gebruikt in de keuken",
                        "target_lang_word": "thym",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thym",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d88394a-cccc-395a-87d4-34b2eefedbcd",
                                        "entry_id": "c448a957-6f66-35e5-8142-e14ca22f22a7",
                                        "glosses": [
                                            "Genre de plantes de la famille des Lamiacées dont l’espèce la plus connue est le Thymus vulgaris, plante aromatique et médicinale, qui est utilisée en cuisine et pour la préparation d’infusions et de décoctions. Sauvage et très répandu dans les garrigues des rives de la méditerranée, il est aussi, pour ses vertus, cultivé dans les jardins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d27fb8c5-fbbd-48d6-b5ff-8ec71570872c",
                                                "sense_id": "4d88394a-cccc-395a-87d4-34b2eefedbcd",
                                                "text": "Mais, je n’y ai pas trouvé, comme aux jours où tu partageais mon repas, la trace courbe de tes dents, qui rendait à ma bouche la mie aussi douce qu’un baiser, et c’est le cœur serré que je reprends les sentiers parsemés de pierres violettes. Ils sont embaumés de menthe et de thym, et le mistral, venu du nord, commence à souffler sur la vallée."
                                            },
                                            {
                                                "example_id": "2aef507f-ca69-4486-ba37-41d185123951",
                                                "sense_id": "4d88394a-cccc-395a-87d4-34b2eefedbcd",
                                                "text": "Les abeilles butinent le thym."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b30da26-0992-32f7-bb71-104cd2f66adb",
                                        "entry_id": "c448a957-6f66-35e5-8142-e14ca22f22a7",
                                        "glosses": [
                                            "Inflorescence séchée de l’arbre servant à faire les tisanes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44c1cd85-0559-39d7-8ab0-7476a9ea04dc",
                                        "entry_id": "c448a957-6f66-35e5-8142-e14ca22f22a7",
                                        "glosses": [
                                            "Boisson, infusion préparée à partir de ces inflorescences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fccf2486-5d01-4287-80a5-4f4ea9af0d96",
                                                "sense_id": "44c1cd85-0559-39d7-8ab0-7476a9ea04dc",
                                                "text": "Tout en parlant, ils buvaient tous deux, à petits coups, la tisane de thym, enrichie d'un petit trait de marc du pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3080607b-c449-3f6c-8c24-16424a9a8629",
                                        "entry_id": "c448a957-6f66-35e5-8142-e14ca22f22a7",
                                        "glosses": [
                                            "Nom usuel utilisé avec un épithète pour désigner des plantes, souvent odorantes, autres que du genre Thymus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54738770-b2a3-4ed2-8039-6fdac3d74694",
                                                "sense_id": "3080607b-c449-3f6c-8c24-16424a9a8629",
                                                "text": "Ajowan - Trachyspermum ammi. Historique: Appelée également thym des Indes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
