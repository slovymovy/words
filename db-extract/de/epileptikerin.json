                ],
                "senses": [
                    {
                        "sense_id": "2642c549-01d1-3660-b263-a2d845dc7f7c",
                        "entry_id": "cd84f7af-1268-3b58-aa17-1ace1d91bf53",
                        "glosses": [
                            "weibliche Person, die an Epilepsie leidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26888bb1-9f77-47a1-9f3f-5ef6efc1a2ec",
                                "sense_id": "2642c549-01d1-3660-b263-a2d845dc7f7c",
                                "text": "„Es geht Regisseur Hans-Christian Schmid nicht um die Exzesse des Exorzierens. Er entwickelt die Epileptikerin, die der Welt allmählich verloren geht, als dreifaches Opfer: der Eltern, der Medizin, der Religion.“"
                            },
                            {
                                "example_id": "7a36e82f-7608-4b94-9a3d-c1d10e04f4c9",
                                "sense_id": "2642c549-01d1-3660-b263-a2d845dc7f7c",
                                "text": "Die 23-jährige Epileptikerin aus Klingenberg im Bistum Würzburg war 1976 verhungert, nachdem an ihr in bischöflichem Auftrag in vielen Sitzungen der Große Exorzismus vollzogen worden war."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00aacbeb-d8b0-46a4-9aff-d3181b4bedb0",
                        "source_entry_id": "cd84f7af-1268-3b58-aa17-1ace1d91bf53",
                        "source_sense_id": "2642c549-01d1-3660-b263-a2d845dc7f7c",
                        "source_sense_description": "Medizin: weibliche Person, die an Epilepsie leidet",
                        "target_lang_word": "epileptic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epileptic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "290ffc7a-7875-3e94-ba20-2f910bfe16ef",
                                        "entry_id": "8f6df32e-9c6c-3a59-8374-074b00a7dfc1",
                                        "glosses": [
                                            "Of or relating to epilepsy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54d4ac17-5b12-43e0-8472-ba27ebf6d0cb",
                                                "sense_id": "290ffc7a-7875-3e94-ba20-2f910bfe16ef",
                                                "text": "The children die off in vast numbers: those pale roses are all nerves. Hence, will presently burst forth the epileptic dances of the fourteenth century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b83c24ce-482e-330d-8568-f9c68aa3e1a9",
                                        "entry_id": "8f6df32e-9c6c-3a59-8374-074b00a7dfc1",
                                        "glosses": [
                                            "Of or relating to an epileptic or epileptics (epileptic people)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "epileptic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11bdf900-772b-3311-a9ed-454dcab37d00",
                                        "entry_id": "1df7acdb-59ce-39b9-8940-c980479d1de3",
                                        "glosses": [
                                            "A person who has epilepsy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9920540c-653b-4de9-bd9f-20b061d2a3f2",
                                                "sense_id": "11bdf900-772b-3311-a9ed-454dcab37d00",
                                                "text": "The present Immigration Act on the books bars entry to Canada to homosexuals, prostitutes, epileptics, and those said to be \"living off the avails of homosexualism or prostitution.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efffccbc-51b8-3901-acfb-33d687f08bfe",
                                        "entry_id": "1df7acdb-59ce-39b9-8940-c980479d1de3",
                                        "glosses": [
                                            "A medicine for the cure of epilepsy."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7661341-b4dd-43e0-a8da-a17146de8c49",
                        "source_entry_id": "cd84f7af-1268-3b58-aa17-1ace1d91bf53",
                        "source_sense_id": "2642c549-01d1-3660-b263-a2d845dc7f7c",
                        "source_sense_description": "Medizin: weibliche Person, die an Epilepsie leidet",
                        "target_lang_word": "épileptique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épileptique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2d538a8-f5a0-31b5-bcad-0e47ae193d02",
                                        "entry_id": "84e089a9-db39-32d0-beb7-a23b19d1eb99",
                                        "glosses": [
                                            "Qui tient de l’épilepsie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a01ace1-9316-46f7-96f2-4c9f8270bb34",
                                                "sense_id": "a2d538a8-f5a0-31b5-bcad-0e47ae193d02",
                                                "text": "Symptôme épileptique."
                                            },
                                            {
                                                "example_id": "e08db46c-bfd1-477a-af12-1c602a55afa3",
                                                "sense_id": "a2d538a8-f5a0-31b5-bcad-0e47ae193d02",
                                                "text": "Convulsions épileptiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c48cf927-4b04-3ff6-915f-d439becbd29a",
                                        "entry_id": "84e089a9-db39-32d0-beb7-a23b19d1eb99",
                                        "glosses": [
                                            "Qui est sujet à l’épilepsie, atteint d’épilepsie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da65d00a-1a82-481c-8d3a-1ba064d57b2e",
                                                "sense_id": "c48cf927-4b04-3ff6-915f-d439becbd29a",
                                                "text": "Il a un frère épileptique. Substantivement,"
                                            },
                                            {
                                                "example_id": "b537c8f5-1826-4d7b-982c-79a0011f4066",
                                                "sense_id": "c48cf927-4b04-3ff6-915f-d439becbd29a",
                                                "text": "Un, une épileptique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46c0a298-8974-308e-9a1e-11be3777558d",
                                        "entry_id": "84e089a9-db39-32d0-beb7-a23b19d1eb99",
                                        "glosses": [
                                            "Pour indiquer une violente agitation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dce59e89-c03e-42d4-9b63-38f6cc4ea34a",
                                                "sense_id": "46c0a298-8974-308e-9a1e-11be3777558d",
                                                "text": "Colère épileptique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c639de05-fba2-376b-9ed9-7248106bcaf6",
                                        "entry_id": "84e089a9-db39-32d0-beb7-a23b19d1eb99",
                                        "glosses": [
                                            "Plein de rebondissements, très inhabituel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb48cf7f-3ab1-4443-b9f0-61c89e6082f9",
                                                "sense_id": "c639de05-fba2-376b-9ed9-7248106bcaf6",
                                                "text": "« Si je descends, je te mets un coup de boule », lui avait répondu le pêcheur, donnant le ton d’un quinquennat épileptique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épileptique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb4c870a-75dc-3f57-9014-c3c1d093e9f4",
                                        "entry_id": "180ca7f1-cdb5-3ca7-849f-631785a9f2b6",
                                        "glosses": [
                                            "Celui ou celle qui souffre d’épilepsie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b591bdcf-6f49-4687-8fb3-b6b40945110c",
                                                "sense_id": "cb4c870a-75dc-3f57-9014-c3c1d093e9f4",
                                                "text": "[…] ; mais si cette névrose ne se manifeste qu’au souvenir de ce qui peut l’avoir procurée, comme le passage d’un pont qui s’est écroulé, un plancher de wagon effondré, etc., il est évident que le vendeur évitera de conduire l’épileptique près de ces objets."
                                            },
                                            {
                                                "example_id": "6ece50e1-bc97-48aa-a572-b27aa24d108e",
                                                "sense_id": "cb4c870a-75dc-3f57-9014-c3c1d093e9f4",
                                                "text": "L'auteur expose que la gémellarité par elle-même ne semble pas prédisposer d'une façon particulière à l’épilepsie. Comme on l'observe chez les épileptiques en général, l’épilepsie des jumeaux est très fréquemment symptomatique de malformations ou d'altérations cérébrales ([…])."
                                            },
                                            {
                                                "example_id": "deb9d5d2-9630-49b8-ac38-6e87a081a65a",
                                                "sense_id": "cb4c870a-75dc-3f57-9014-c3c1d093e9f4",
                                                "text": "De plus en plus nombreux étaient les malheureux qui demandaient des soins et de la nourriture. C'était un défilé ininterrompu de clopineux, d’idiots de naissance, de rachitiques, d’épileptiques, d’ulcéreux, de variqueux perdus […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
