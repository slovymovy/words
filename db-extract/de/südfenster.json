                ],
                "senses": [
                    {
                        "sense_id": "b9eded9e-62ff-326b-869a-c098aae9eb1a",
                        "entry_id": "af65f085-c542-374f-b304-6eef1e944d9f",
                        "glosses": [
                            "Fenster, welches sich an der Südseite eines Gebäudes befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "148013a3-03be-4630-995d-c801d5b7430e",
                                "sense_id": "b9eded9e-62ff-326b-869a-c098aae9eb1a",
                                "text": "„Aus dem fast zwölf Meter langen Südfenster schweift der Blick über Baumkronen von Lärche, Birke und Zwetschke zum Anninger am Horizont.“"
                            },
                            {
                                "example_id": "e0f43076-45b8-4ca3-90c1-842792c920a2",
                                "sense_id": "b9eded9e-62ff-326b-869a-c098aae9eb1a",
                                "text": "„Täglich geht er jetzt im eigenen Garten spazieren, sitzt beinahe jeden Abend am Ofen und blickt zufrieden durch das Südfenster auf den Turm von Löbenicht, welcher ihm besonders lieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
