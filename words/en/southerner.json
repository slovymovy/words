            "senses": [
                {
                    "sense_id": "627853ca-f730-3853-8261-438dd3949180",
                    "sense_definition": "A native or inhabitant of the southern part of a country or region.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a lifelong <w>southerner</w>, she found the cold northern winters difficult to endure.",
                            "target_lang_translations": {
                                "es": "Como <w>sureña</w> de toda la vida, le resultaba difícil soportar los fríos inviernos del norte."
                            }
                        },
                        {
                            "text": "Many people say that a typical <w>southerner</w> speaks with a distinct regional accent.",
                            "target_lang_translations": {
                                "es": "Mucha gente dice que un <w>sureño</w> típico habla con un marcado acento regional."
                            }
                        }
                    ],
                    "synonyms": [
                        "southron"
                    ],
                    "antonyms": [
                        "northerner"
                    ],
                    "target_lang_definitions": {
                        "es": "Persona natural o habitante de la parte sur de un país o región."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "sureño",
                                "target_lang_sense_clarification": "masculino"
                            },
                            {
                                "target_lang_word": "sureña",
                                "target_lang_sense_clarification": "femenino"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b7e1f29-aa30-3d7f-81f9-f27a0b75f1f4",
                    "sense_definition": "A native or inhabitant of the southern region of the United States.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author described the unique hospitality that every <w>Southerner</w> takes pride in showing guests.",
                            "target_lang_translations": {
                                "es": "El autor describió la hospitalidad única que todo <w>sureño</w> se enorgullece de mostrar a sus invitados."
                            }
                        },
                        {
                            "text": "He grew up in Georgia and considered himself a proud <w>Southerner</w> throughout his life.",
                            "target_lang_translations": {
                                "es": "Creció en Georgia y se consideró un orgulloso <w>sureño</w> durante toda su vida."
                            }
                        }
                    ],
                    "synonyms": [
                        "Southron"
                    ],
                    "antonyms": [
                        "northerner"
                    ],
                    "common_phrases": [
