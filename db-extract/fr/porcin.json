                                        "entry_id": "c5532ce1-cab6-38da-af33-da3e6bc55a6e",
                                        "glosses": [
                                            "Any artiodactyl of the suborder Suina of pigs, peccaries, and hippopotami."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01f48bed-8c80-46c3-8ae1-b4449bc3f9af",
                                                "sense_id": "29ced8d3-788b-398d-9170-a986eb425d14",
                                                "text": "The temporal fossa has a capacity in its proportions and form more resembling that of carnivores than that of the ordinary suillines."
                                            },
                                            {
                                                "example_id": "5ad04266-0636-4fc8-a28e-6373a63b8d1a",
                                                "sense_id": "29ced8d3-788b-398d-9170-a986eb425d14",
                                                "text": "The Oregon Pliocene has afforded the Suillines, Platygonus Condoni Mh., and Dicotyles Hesperius Mh., besides Rhinoceros Oregonensis Mh."
                                            },
                                            {
                                                "example_id": "7e19dfdc-7a0a-46ea-bf51-fbe88d65229e",
                                                "sense_id": "29ced8d3-788b-398d-9170-a986eb425d14",
                                                "text": "The genus Platygonus is represented by several species, one of which was very abundant in the Post-Tertiary of North America, and is apparently the last example of a side branch, before the American Suillines culminate in existing Peccaries."
                                            }
                                        ]
                                    }
                                ]
                            }
