                        "form_id": "df55b347-3b9e-4239-9db5-5b236f10e91e",
                        "entry_id": "8e6cec88-9827-3f97-a8dd-6c9b3c11ae0c",
                        "tags": [
                            "invariable"
                        ],
                        "form": "^((h aspiré))\\ɔl.kɔʁ\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb3d1b89-77e5-3210-8b1b-e9a1b9cac0c5",
                        "entry_id": "8e6cec88-9827-3f97-a8dd-6c9b3c11ae0c",
                        "glosses": [
                            "Saut, bond que fait un cheval."
                        ],
                        "tags": [
                            "Manège"
                        ],
                        "examples": [
                            {
                                "example_id": "dc8026d2-2640-4d26-b4d8-bfe03fbd6506",
                                "sense_id": "fb3d1b89-77e5-3210-8b1b-e9a1b9cac0c5",
                                "text": "Ce cheval fait des haut-le-corps."
                            },
                            {
                                "example_id": "290bb214-6047-40bd-a2aa-1da50b6813bb",
                                "sense_id": "fb3d1b89-77e5-3210-8b1b-e9a1b9cac0c5",
                                "text": "Je voulus fouetter les chevaux ; mais elle craignaient pour moi les ruades et pour elles les haut-le-corps."
                            }
                        ]
                    },
                    {
                        "sense_id": "20dc0bd3-b16d-30da-a9a6-d63010bcc5e2",
                        "entry_id": "8e6cec88-9827-3f97-a8dd-6c9b3c11ae0c",
                        "glosses": [
                            "Mouvements instinctifs de quelqu’un auquel on fait des propositions qui le révoltent, ou en parlant de quelqu’un qui éprouve une grande surprise."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "04dfbee6-20d1-412e-a314-493264ef9cef",
                                "sense_id": "20dc0bd3-b16d-30da-a9a6-d63010bcc5e2",
                                "text": "Malgré un haut-le-corps de la despotique mademoiselle d’Hérouville, le duc sortit avec le petit notaire."
                            },
                            {
                                "example_id": "c93c3708-0835-4ca9-84aa-26545dd478de",
                                "sense_id": "20dc0bd3-b16d-30da-a9a6-d63010bcc5e2",
                                "text": "En entendant nommer l’affaire Brocq, Fandor n’avait pu se défendre d’un haut-le-corps."
                            },
                            {
                                "example_id": "3154cb97-31c3-493b-9d5d-4f31c4c5e49e",
                                "sense_id": "20dc0bd3-b16d-30da-a9a6-d63010bcc5e2",
                                "text": "À l’aube, je fus pris de haut-le-corps comme en ont à Rome les condamnés à mort qui s’ouvrent les veines dans leur bain."
                            },
                            {
                                "example_id": "fce80bc4-9d13-482f-99b7-2ff6c57499c9",
                                "sense_id": "20dc0bd3-b16d-30da-a9a6-d63010bcc5e2",
                                "text": "À chacune de mes paroles, le tenancier réagit par un haut-le-corps."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0321fcf-f973-3a21-b015-33f46f377b78",
                        "entry_id": "8e6cec88-9827-3f97-a8dd-6c9b3c11ae0c",
