                                                "example_id": "0962d24e-c396-44b8-be04-a7f42401dfd6",
                                                "sense_id": "99cf0b6a-9e07-3145-8d99-68bf4017a8f1",
                                                "text": "Shipment of hazardous waste on this route is strictly prohibited."
                                            }
                                        ]
