                                "example_id": "5e9ea4b4-083f-4771-98af-232ff3b7542a",
                                "sense_id": "9b0b804a-2bdd-3ee4-8a9e-0aed311ceb75",
                                "text": "Eine Sesterze war gleich 2½ As, daher der Name sesquitertius, die mit der Verschlechterung des As zugleich sank. Die Sesterze war der vierte Theil des Denar [...]"
                            },
                            {
                                "example_id": "f38b9b74-89f5-4d17-a2a2-4c1578b28666",
                                "sense_id": "9b0b804a-2bdd-3ee4-8a9e-0aed311ceb75",
                                "text": "„Sehr gern werde ich deiner Leiche eine Sesterze für Charon in die Hand drücken.“"
                            }
                        ]
                    }
