                                    {
                                        "sense_id": "5e41be9b-58c1-31a5-99ce-268beca9a0f4",
                                        "entry_id": "ae1b6edd-115c-35d0-abcd-6a069c1df064",
                                        "glosses": [
                                            "Of or pertaining to one, all, or any of the Ripuarian dialects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "353b0a57-c958-4170-ab21-47d8b7f8c576",
                                                "sense_id": "5e41be9b-58c1-31a5-99ce-268beca9a0f4",
                                                "text": "New Belgium … shows a triglossic situation:\n(1) New Belgium Eupen: Besides standard German (as the official language) also Low Franconian/East Limburgian dialects (in the western part) and Ripuarian dialects (in the eastern part) as well as standard French are spoken.\n(2) New Belgium Malmédy: ….\n(3) New Belgium St Vith: Besides standard German (as the official language) also Ripuarian dialects (in the northern part) and Moselle Franconian dialects (in the central and southern part) as well as standard French are spoken."
                                            }
                                        ]
                                    },
