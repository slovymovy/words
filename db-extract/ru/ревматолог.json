                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhumatologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "743f3f0c-84a4-34bc-baf8-62972701aca6",
                                        "entry_id": "dda5a24f-0bfe-3c01-bbc8-1bf407844259",
                                        "glosses": [
                                            "Médecin spécialiste des maladies des os, articulations, muscles, tendons et ligaments, ainsi que des rhumatismes inflammatoires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4feaeccb-da2f-49df-8f0d-fe6d525c254e",
                                                "sense_id": "743f3f0c-84a4-34bc-baf8-62972701aca6",
                                                "text": "La Dre Marie-Paule Morin, rhumatologue pédiatre au CHU Sainte-Justine, confirme que le syndrome inflammatoire multisystémique est plus fréquent depuis la COVID-19."
                                            },
                                            {
                                                "example_id": "2c6c5aa2-7885-40d2-a1e0-d4303080f5a4",
                                                "sense_id": "743f3f0c-84a4-34bc-baf8-62972701aca6",
                                                "text": "Il faut donc se mesurer régulièrement au-delà de 50 ans, mais « aussi s’interroger lors de la survenue d’une fracture à bas niveau d’énergie, comme celle survenant après une chute de sa hauteur », indique le Dʳ Éric Lespessailles, rhumatologue au CHR d’Orléans, membre du conseil scientifique du GRIO (Groupe de recherche et d’information sur les ostéoporoses)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
