                    },
                    {
                        "translation_id": "5fdd548e-0385-442f-bfde-ff81d81b2882",
                        "source_entry_id": "2198d15a-aee0-356e-bcc8-14f0b5246262",
                        "source_sense_id": "647902fa-3c17-3f66-9082-e99fa57fc8cd",
                        "source_sense_description": "samenklontering",
                        "target_lang_word": "Zusammenschluss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zusammenschluss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9743e130-dc48-3255-9850-8b2092918cf0",
                                        "entry_id": "e1fc9c78-217f-322a-b9bf-9e1ae6a2fcd9",
                                        "glosses": [
                                            "eine Verbindung von verschiedenen Personen oder Unternehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9391cb6-b0c8-49d5-a204-bf26e96bf21a",
                                                "sense_id": "9743e130-dc48-3255-9850-8b2092918cf0",
                                                "text": "„Die Stimmberechtigten von Flaach, Volken, Dorf, Buch am Irchel und Berg am Irchel äussern sich zum Zusammenschluss ihrer fünf Primarschulen und der Sekundarschule.“"
                                            },
                                            {
                                                "example_id": "a948a669-19be-4e67-ba59-d1ef361b8e6c",
                                                "sense_id": "9743e130-dc48-3255-9850-8b2092918cf0",
                                                "text": "„Erst durch ihn hatten die Mitgliedstaaten erfahren, dass sie von einem Zusammenschluss tatsächlich greifbare Vorteile hatten, und die Fürsten konnten ihre Macht ohne größeren Gesichtsverlust Stück für Stück abgeben.“"
                                            },
                                            {
                                                "example_id": "552b2bef-59d8-4c24-94f9-4ea5f5c89bbf",
                                                "sense_id": "9743e130-dc48-3255-9850-8b2092918cf0",
                                                "text": "„Für den Erfolg des Aufstandes hätte es eines Zusammenschlusses bedurft zwischen den Gesellen in den kleineren Werkstätten sowie den Lohnkräften in den Meistereien auf der einen Seite und den Zunftmeistern und Meistereibesitzern auf der anderen.“"
                                            },
                                            {
                                                "example_id": "336e7326-2dc8-4de4-8aaf-5e223b820f80",
                                                "sense_id": "9743e130-dc48-3255-9850-8b2092918cf0",
                                                "text": "„Es scheint für nahezu jedes Betätigungsfeld oder Interessensgebiet einen solchen Zusammenschluss von Gleichgesinnten zu geben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
