                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c82056a-02c2-4fca-8ff4-46b902b0cc04",
                                                "sense_id": "db36ba14-51c7-3d31-9926-75df2fb8415d",
                                                "text": "La mélique bleue, croissant dans les prés humides, est nuisible aux bestiaux à l’époque de la floraison."
                                            },
                                            {
                                                "example_id": "9456ac42-8af2-47ee-a5be-2dbd5ea0accf",
                                                "sense_id": "db36ba14-51c7-3d31-9926-75df2fb8415d",
                                                "text": "La mélique ciliée (Melica ciliata) atteint 60 cm."
                                            },
                                            {
                                                "example_id": "8e4608bb-c65b-4d93-822b-4b02153a6a85",
                                                "sense_id": "db36ba14-51c7-3d31-9926-75df2fb8415d",
                                                "text": "Elle a un joli nom que je vous donne quand je pense à vous, « la mélique penchée »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
