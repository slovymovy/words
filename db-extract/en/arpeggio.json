                    {
                        "translation_id": "f0f70f2d-7980-46b1-b86c-f822cd89bc02",
                        "source_entry_id": "50080332-9562-3d7f-a0b4-6b77b55322c5",
                        "source_sense_id": "ac4d00fa-1ab1-3f17-a4e8-9ecf93fb9b7d",
                        "source_sense_description": "notes of a chord played individually",
                        "target_lang_word": "Arpeggio",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arpeggio",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e89c2483-c91e-34f1-830f-fc67de3dda2e",
                                        "entry_id": "df1deb7c-613d-3b53-8c8e-67948f1be153",
                                        "glosses": [
                                            "Akkord, bei dem die einzelnen Töne nicht gleichzeitig, sondern in kurzen Abständen nacheinander erklingen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef938b9e-215c-4de2-970b-df039efe449c",
                                                "sense_id": "e89c2483-c91e-34f1-830f-fc67de3dda2e",
                                                "text": "Sehr gut sieht man dies, wenn man sich den melodischen und rhythmischen Verlauf ohne das rankende Beiwerk pianistischer Raffinessen veranschaulicht: Viele Werke schließen mit einem Arpeggio auf dem Schlußakkord."
                                            },
                                            {
                                                "example_id": "fa721cad-f697-4102-8467-70b16eb217c9",
                                                "sense_id": "e89c2483-c91e-34f1-830f-fc67de3dda2e",
                                                "text": "„Als er die Treppe hinabging, ließen ihn andere Klavierklänge stillstehen: Arpeggien, Dezimen überspannend, sonore Bass-Oktaven, wechselnde Harmoniefolgen.“"
                                            },
                                            {
                                                "example_id": "e727b133-6254-42d3-a9f1-0b2a150a1817",
                                                "sense_id": "e89c2483-c91e-34f1-830f-fc67de3dda2e",
                                                "text": "„Sie schienen überall zu sein und von überall zu kommen, stark und fordernd, manchmal allein und manchmal wie ein Arpeggio und ein unaugelöster Akkord trostloser Trauer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
