                                        "entry_id": "426f4185-c258-32a7-b492-a3ab03552562",
                                        "glosses": [
                                            "jemand, der dafür bezahlt worden ist, bei einer Aufführung (zum Beispiel einem Theaterstück) zu klatschen"
                                        ],
                                        "tags": [],
