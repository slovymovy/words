                                            {
                                                "example_id": "09051614-98f3-4930-9bcb-f6506b5b4954",
                                                "sense_id": "5d89df8d-8bd9-3857-8f31-cab67c48d77d",
                                                "text": "The Earth is turning about its axis as we speak."
                                            },
                                            {
                                                "example_id": "a037505d-ed23-4993-944c-a49b107f557d",
                                                "sense_id": "5d89df8d-8bd9-3857-8f31-cab67c48d77d",
                                                "text": "He made wooden soldiers by turning them on a hand lathe."
