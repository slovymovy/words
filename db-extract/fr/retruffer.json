                "senses": [
                    {
                        "sense_id": "f314d7b8-113e-3e47-b124-90f9ab16ad36",
                        "entry_id": "54266883-c832-32c9-8d95-c3419a8f1fc5",
                        "glosses": [
                            "Truffer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc96e4ca-669a-4ab8-85c9-1883d36a0ab7",
                                "sense_id": "f314d7b8-113e-3e47-b124-90f9ab16ad36",
                                "text": "mais que le pauvre se nourrisse de haricots, pendant que le riche truffe et retruffe ses morceaux ; que le pauvre sente la bise qui traverse sa mansarde le glacer sous une méchante couverture"
                            },
                            {
                                "example_id": "1c7d9cc9-686d-402a-99f6-3d194ec96e27",
                                "sense_id": "f314d7b8-113e-3e47-b124-90f9ab16ad36",
                                "text": "Elles obligent les « réalistes » à retruffer les organes et comités du Parti, de l'État et de l'Armée relativement nombreux qu'ils s'étaient jusqu'alors abstenus de reprendre en main, et, par voie de conséquence, à précipiter le mouvement de réhabilitation des cadres éliminés pour « déviation droitiste » de 1966 à 1971, à mener, en un mot, ce mouvement jusqu'à son terme à une allure record."
                            }
                        ]
                    }
