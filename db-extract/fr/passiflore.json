                                        "entry_id": "5277e677-c045-3b91-a69a-78f1e2ef55af",
                                        "glosses": [
                                            "Vertreter der artenreichen Pflanzengattung Passiflora aus der Familie der Passionsblumengewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
