                "senses": [
                    {
                        "sense_id": "fee993de-7960-348b-9287-c3df4e85f888",
                        "entry_id": "2ae98bba-a6db-32c9-ad51-f61830655d15",
                        "glosses": [
                            "perfective form of обурева́ть (oburevátʹ, “to overwhelm”), or of simple бури́ть (burítʹ, “to churn, to drag”)"
                        ],
                        "tags": [
                            "form-of",
                            "perfective",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "dfc425c8-25f1-4f1d-9a94-7b51d4fabaf7",
                                "sense_id": "fee993de-7960-348b-9287-c3df4e85f888",
                                "text": "Сразу скажу, что до конца рыбалки так и не понял, почему нас никто не обурил. […] Выезжая со льда, видели, что многие сонно сидят над лунками, и снова встал вопрос: почему же не обурили?"
                            }
                        ]
                    }
                ],
