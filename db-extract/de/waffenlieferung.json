                "senses": [
                    {
                        "sense_id": "a2b3da1f-b8d3-3595-8b13-7e79ee807b5e",
                        "entry_id": "912a7cdb-6011-3643-8651-0c791829a087",
                        "glosses": [
                            "das Liefern von (Kriegs-)Waffen an jemanden, der sie bestellt hat oder dem sie zugedacht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c24584f-32ad-4f0f-ac81-33749394d77d",
                                "sense_id": "a2b3da1f-b8d3-3595-8b13-7e79ee807b5e",
                                "text": "Die Waffenlieferung in den afrikanischen Staat war illegal."
                            },
                            {
                                "example_id": "ddb8974f-e994-48fb-bc2a-e424d23ab56e",
                                "sense_id": "a2b3da1f-b8d3-3595-8b13-7e79ee807b5e",
                                "text": "„Laut US-Kreisen reifen in Washington nun Pläne, die syrischen Rebellen mit Waffenlieferungen zu unterstützen.“"
                            },
                            {
                                "example_id": "4212004d-f97b-41cf-af8f-b9d618d9f962",
                                "sense_id": "a2b3da1f-b8d3-3595-8b13-7e79ee807b5e",
                                "text": "„Eine regelrechte Armee war das natürlich nicht, man war vor allem damit beschäftigt, die Engländer um Waffenlieferungen zu bitten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
