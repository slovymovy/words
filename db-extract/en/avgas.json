                        "sense_id": "cceb2b7a-ea4e-32b7-bc13-7d440af8be06",
                        "entry_id": "008792ea-50e6-3a5e-9dc2-684f2469b8ba",
                        "glosses": [
                            "Gasoline fuel for piston-engined aircraft."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "185760e1-d377-4c28-bf5e-9a0fa4f411f5",
                                "sense_id": "cceb2b7a-ea4e-32b7-bc13-7d440af8be06",
                                "text": "Cylinder cracks are nothing new, however, and there is no reason to expect autogas-burning engines to have a higher incidence of head cracking than avgas-users"
                            },
                            {
                                "example_id": "33deb8e2-2ee3-4fe9-bbaf-55ea810cdd9f",
                                "sense_id": "cceb2b7a-ea4e-32b7-bc13-7d440af8be06",
                                "text": "In the area of autogas volatility, a Reid vapor pressure of 9.0 to 15 is very common, compared to the vapor pressure of avgas, which is 5.5 to 7"
                            },
                            {
                                "example_id": "968b1592-5245-4387-a702-215c85dc224b",
                                "sense_id": "cceb2b7a-ea4e-32b7-bc13-7d440af8be06",
                                "text": "Autogas can be obtained for a fraction of the cost of avgas, but its use is not without controversy."
                            }
                        ]
                    }
