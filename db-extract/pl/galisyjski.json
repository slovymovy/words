                "translations": [
                    {
                        "translation_id": "ec097b45-de7c-4324-b98b-b8618e670e62",
                        "source_entry_id": "ef8b21f8-c33b-35ef-9617-df3bbcf6ddf6",
                        "source_sense_id": "0e4c2d99-70eb-3846-bf8c-e6c426678369",
                        "target_lang_word": "Galicisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Galicisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc675c1d-8501-36b5-bf4e-08249f142ce6",
                                        "entry_id": "66f54260-8cfa-3b6d-9882-2011ef453de0",
                                        "glosses": [
                                            "dem Portugiesischen nächstverwandte romanische Sprache, die im nordwestlichen Teil der iberischen Halbinsel (in den spanischen autonomen Gemeinschaften Galicien – dort auch Amtssprache – und in Teilen Asturiens sowie im Bierzo der Provinz León) von ungefähr 3,5 Millionen Menschen gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d3447c2-f02e-4a38-b905-71a186889076",
                                                "sense_id": "dc675c1d-8501-36b5-bf4e-08249f142ce6",
                                                "text": "Sprechen Sie Galicisch?"
                                            },
                                            {
                                                "example_id": "74df8429-ba18-4a91-ab21-a980bf5595e6",
                                                "sense_id": "dc675c1d-8501-36b5-bf4e-08249f142ce6",
                                                "text": "Wie heißt das auf Galicisch?"
                                            },
                                            {
                                                "example_id": "5a4792b2-4775-41b6-abdf-a4896496bf72",
                                                "sense_id": "dc675c1d-8501-36b5-bf4e-08249f142ce6",
                                                "text": "„Auch für das Galicische gilt: Die Namengebung hat bereits im Mittelalter ihre definitive sprachliche und formale Gestalt angenommen; der permanente Druck des Kastilischen hat nichts Wesentliches verändert.“"
                                            },
                                            {
                                                "example_id": "c38a60ba-2735-42e0-b591-a3b6b519a1ec",
                                                "sense_id": "dc675c1d-8501-36b5-bf4e-08249f142ce6",
                                                "text": "„Galicisch zu schreiben wurde verboten, Zeitungen und Rundfunk benutzten nur Spanisch, und der Unterricht in Schulen, Gymnasien, Priesterseminaren oder in der Universität erfolgte auf Spanisch.“"
                                            },
                                            {
                                                "example_id": "5ce5d39a-3a5a-4878-9342-20816d2b0123",
                                                "sense_id": "dc675c1d-8501-36b5-bf4e-08249f142ce6",
                                                "text": "„Allgemein wird sehr viel Galicisch gesprochen, auch in den Städten, wo vor allem jüngere Leute bewusst die galicische Sprache benutzen. […] Außer in Galicien wird auch in einigen Gebieten im Westen Asturiens und im Bierzo, im Westen Leóns, Galicisch gesprochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
