                    {
                        "sense_id": "b91450fd-ef39-3a90-ac3d-3dc12718ed10",
                        "entry_id": "c4c6fa24-ddfe-338d-bcea-2c6cbbbbec5d",
                        "glosses": [
                            "Petit étang où l’on élève de l’alevin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa1df8db-681a-4e2d-808e-5475ef05e5da",
                                "sense_id": "b91450fd-ef39-3a90-ac3d-3dc12718ed10",
                                "text": "L’alevinier à fond et bords vaseux et à eaux dormantes sera destiné aux poissons qui vivent et multiplient dans ces eaux."
                            },
                            {
                                "example_id": "9b1ada08-d027-456f-96b8-f0f9737a9c43",
                                "sense_id": "b91450fd-ef39-3a90-ac3d-3dc12718ed10",
                                "text": "Enfin, lorsqu'elle était enfant, Sphyrène préférait l'eau douce des aleviniers ou des anguillères à l'âcreté saline qui lui brûlait les yeux."
                            }
                        ]
                    }
