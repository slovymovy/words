                ],
                "senses": [
                    {
                        "sense_id": "c8b1740c-cd48-3145-b708-a98e6b12e446",
                        "entry_id": "b1382103-acc5-38ec-a92d-3f75bf92685f",
                        "glosses": [
                            "Very durable; long-lasting."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37630b06-1562-4af8-bcd2-c9c834d1a25b",
                                "sense_id": "c8b1740c-cd48-3145-b708-a98e6b12e446",
                                "text": "In Paradyce, that place of pleaſure perdurable / The progeny of parrottis, were fayre and fauorable"
                            },
                            {
                                "example_id": "191c619f-f95d-4ab8-b835-d24ec3164497",
                                "sense_id": "c8b1740c-cd48-3145-b708-a98e6b12e446",
                                "text": "O perdurable shame! Let's stab our selues."
                            },
                            {
                                "example_id": "360f5aa2-db61-46a0-9d8d-c5afe6383ba0",
                                "sense_id": "c8b1740c-cd48-3145-b708-a98e6b12e446",
                                "text": "Ere now marmoreal floods had spread their couch / Of perdurable snow, or granite wrought / Its skyward impulse from earth's hearth of fire / Up to insanest heights."
                            },
                            {
                                "example_id": "b8a2dd04-17c8-41b8-b4e9-7f7c5c6f9002",
                                "sense_id": "c8b1740c-cd48-3145-b708-a98e6b12e446",
                                "text": "There is one quality which unites all great and perdurable writers, you don't NEED schools and colleges to keep 'em alive."
                            },
                            {
                                "example_id": "0faad691-5ea5-4e23-8707-be84d5d4fa4f",
                                "sense_id": "c8b1740c-cd48-3145-b708-a98e6b12e446",
                                "text": "Together, our studies show that the perception of moral decline is pervasive, perdurable, unfounded and easily produced."
                            }
                        ]
                    }
                ],
