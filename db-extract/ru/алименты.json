                                        "sense_id": "96d82ce5-e7ef-3991-a732-bb0ed7dea955",
                                        "entry_id": "eed060c7-8e3c-396e-a2f7-c49c3f28879e",
                                        "glosses": [
                                            "Money required or spent to provide for the needs of a person or a family."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1004a56-ecd3-4bab-bdfa-303e4f23bcb2",
                                                "sense_id": "96d82ce5-e7ef-3991-a732-bb0ed7dea955",
                                                "text": "From Pond to Pond he roamed, from moor to moor; / Housing, with God's good help, by choice or chance: / And in this way he gained an honest maintenance."
                                            }
                                        ]
