                    {
                        "sense_id": "516b29dd-46ac-3ebd-8251-c3377a1ee9f5",
                        "entry_id": "8c12b074-fb70-3106-acc4-981fdf34e1b9",
                        "glosses": [
                            "To dance."
                        ],
                        "tags": [
                            "dated",
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bf115ec7-25f6-453c-af18-e2c33ab8df18",
                                "sense_id": "516b29dd-46ac-3ebd-8251-c3377a1ee9f5",
                                "text": "Longhair terping got another boost around these parts Tuesday (3) when the Jooss Ballet returned to the New York City Center for a three-week stint. Heavy balletomane audience was on hand, generous in its applause welcoming back this unique troupe after a five-year wartime absence."
                            }
                        ]
                    }
