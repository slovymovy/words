                                        "examples": [
                                            {
                                                "example_id": "394f33e7-fc80-4628-8c40-f755058de804",
                                                "sense_id": "11b3771d-a214-32bf-a0c5-54635b7fa44d",
                                                "text": "Dinner is, by this nest of viper’s^([sic]) standards, surprisingly lovely. A moving toast from Viserys leads the divided room to rebuild bridges that had long ago been burned to ashes."
                                            }
