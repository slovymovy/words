                            {
                                "example_id": "7934c9a4-efb7-4d36-9e90-fc0f237abf02",
                                "sense_id": "bce6c5ec-4281-38dd-b0c9-fa7a01020b9c",
                                "text": "„»’n Mann muss schon ’ne Seele voll Schweinescheiße ham, um mit ’nem Mädel zu machen, was du mit der gemacht hast«, antwortete der Koloss, aber sein Ruf klang für Rufus’ Ohren nach keiner menschlichen Stimme, die er je vernommen hatte.“"
                            },
                            {
                                "example_id": "f3bc7405-8424-4f42-8a6e-15fa94127cb4",
                                "sense_id": "bce6c5ec-4281-38dd-b0c9-fa7a01020b9c",
                                "text": "„Nur das Bein brennt wie das höllische Feuer, mein Schädel platzt, ich muss pissen, und meine Zunge schmeckt wie ein Kübel Schweinescheiße.“"
                            }
                        ],
