                "senses": [
                    {
                        "sense_id": "3a88a7a1-3b11-3694-b151-0087bbafed28",
                        "entry_id": "ace2cdf1-5609-3cc9-8a3c-e6f5e31dc4b0",
                        "glosses": [
                            "Pluriel de faux-cil."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "b2c25b64-a5fe-4488-ba16-87529efe363c",
                                "sense_id": "3a88a7a1-3b11-3694-b151-0087bbafed28",
                                "text": "Si la colle saute aux yeux, maquilez au mascara ou à l'eye-liner liquide. Recouvrez faux et vrais cils de mascara pour les homogénéiser. Retirez toujours les faux-cils avant de vous coucher."
                            },
                            {
                                "example_id": "590a1f6e-cf07-4db2-9fc9-25b14237a856",
                                "sense_id": "3a88a7a1-3b11-3694-b151-0087bbafed28",
                                "text": "Dans les deux cas, on met un peut de colle spécialement destinée aux faux-cils (grise ou noire, évitez la version blanche, trop apparente) à la base des faux-cils, et on utilise une pince à épiler pour venir les placer aussi près que possible de la racine des cils naturels."
                            },
                            {
                                "example_id": "9950329b-d211-40c0-aefb-717599cfacb8",
                                "sense_id": "3a88a7a1-3b11-3694-b151-0087bbafed28",
                                "text": "Elle avait l'impression que l’un de ses faux-cils était en train de se détacher. Elle a appuyé dessus pour essayer de le remettre en place, se disant que c'était sans doute à cause de la chaleur. Elle portait une nouvelle paire de faux-cils."
                            }
                        ]
                    }
