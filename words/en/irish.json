                },
                {
                    "sense_id": "89b189ab-f386-39e2-8d96-d6d56f11b3bd",
                    "sense_definition": "The Irish people.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_people",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The <w>Irish</w> are well known for their warm hospitality.",
                            "target_lang_translations": {
                                "ru": "<w>Ирландцы</w> хорошо известны своим теплым гостеприимством.",
                                "zh": "<w>爱尔兰人</w>以热情好客而闻名。"
                            }
                        },
                        {
                            "text": "Many of the <w>Irish</w> emigrated to America in the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Многие <w>ирландцы</w> эмигрировали в Америку в девятнадцатом веке.",
                                "zh": "十九世纪时，许多<w>爱尔兰人</w>移民到了美国。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ирландский народ.",
                        "zh": "爱尔兰民族。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ирландцы",
                                "target_lang_sense_clarification": "народ"
