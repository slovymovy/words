                "senses": [
                    {
                        "sense_id": "1d5e5a9b-a85a-33f6-829c-e3ba1c3b52be",
                        "entry_id": "752312ce-627d-3f2e-85f4-2cbb470bdec1",
                        "glosses": [
                            "Schicht aus retikulären Fibrillen und Fasern, die Epithelzellen, Endothelzellen und Gliazellen vom benachbarten Bindegewebe abgrenzt und diese zugleich daran verankert, während Fett- und Muskelzellen vollständig davon umhüllt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6d806c6-1064-413d-a0a4-c2997db93f61",
                                "sense_id": "1d5e5a9b-a85a-33f6-829c-e3ba1c3b52be",
                                "text": "„Nach einem gegenwärtig postulierten Modell entsteht die Basalmembran durch spezifische Interaktionen zwischen den drei Proteinen L. [Laminin], Kollagen des Typs IV sowie Entactin und dem Proteoglycan Perlecan.“"
                            },
                            {
                                "example_id": "e3263005-d66c-4315-99bb-66ef9d2bcb5f",
                                "sense_id": "1d5e5a9b-a85a-33f6-829c-e3ba1c3b52be",
                                "text": "„Der Primärharn wird in den Malpighi-Nierenkörperchen gebildet, das Blut in den Nierenglomeruli unter Druck durch die poröse Endothelwand der Kapillaren und die Basalmembran gepresst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
