                                "example_id": "de64c027-cb3e-4711-8a78-09d8a1240f58",
                                "sense_id": "d2c4745c-e899-3c40-8ee8-546e79b6693e",
                                "text": "Nécessité « d'équiniser » l'antibiogramme du cheval"
                            }
                        ]
