                "translations": [
                    {
                        "translation_id": "1746f70a-63c9-485f-97e1-5d0068593d47",
                        "source_entry_id": "82586fb1-1408-3f10-a69f-d76faba7e8c3",
                        "source_sense_id": "771ded8f-3dba-3c4b-9099-88b035175b3a",
                        "target_lang_word": "acrylique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acrylique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3725aaad-9410-3cf5-9de3-e46c33bdcce8",
                                        "entry_id": "b3409168-612d-3256-a83a-4caed1b27447",
                                        "glosses": [
                                            "S’emploie pour qualifier divers produits servant à la fabrication de produits de synthèse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dfe46a3-19d1-493a-a96c-1e544fb27239",
                                                "sense_id": "3725aaad-9410-3cf5-9de3-e46c33bdcce8",
                                                "text": "Le groupe a finalisé le 25 janvier l'acquisition d'actifs acryliques de Dow Chemical en Amérique du Nord, une transaction qui lui permet d'étendre son offre dans le domaine des coatings (revêtements) et des monomères acryliques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "acrylique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ba050f1-8a72-3fbc-a48e-6b30822a5f11",
                                        "entry_id": "70c0b3f1-a074-3d34-b1f8-7dabb203a29d",
                                        "glosses": [
                                            "Fibres textiles artificielles obtenues par polymérisation du nitrile acrylique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e657cafc-2544-422d-b635-df31aaf671ec",
                                                "sense_id": "3ba050f1-8a72-3fbc-a48e-6b30822a5f11",
                                                "text": "« Les prélèvements ont montrés des quantités significatives de fibres de polyester, d'acrylique, de nylon et de prolypropylène », écrit dans un communiqué Imogen Napper, chercheuse à l'université britannique de Plymouth et qui fait partie des explorateurs."
                                            },
                                            {
                                                "example_id": "be6ae19f-5cd8-41cf-a16c-9a1aa8b2e41a",
                                                "sense_id": "3ba050f1-8a72-3fbc-a48e-6b30822a5f11",
                                                "text": "– Tu me trouves comment en acrylique ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9c419b8-acca-36a7-9066-020fd20d553c",
                                        "entry_id": "70c0b3f1-a074-3d34-b1f8-7dabb203a29d",
                                        "glosses": [
                                            "Peinture à base d’acrylique."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15dd5196-ad48-4fe3-a94b-55d8fc73ca61",
                                                "sense_id": "b9c419b8-acca-36a7-9066-020fd20d553c",
                                                "text": "Il comptabilise à ce jour, 1 000 toiles qui ont vu le jour dans son atelier ou sur les cimaises de sa galerie landernéenne : des œuvres abstraites ou tournées vers la mer et les bateaux, essentiellement réalisées à l’acrylique, sur bois, ardoise ou pans de palettes avec des techniques diverses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5deb422-46d5-3174-862e-89ba6c6ed98b",
                                        "entry_id": "70c0b3f1-a074-3d34-b1f8-7dabb203a29d",
                                        "glosses": [
                                            "Tableau réalisé à l’acrylique."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9ce228a-3d29-4cba-adf7-71bc9f185ed2",
                                                "sense_id": "c5deb422-46d5-3174-862e-89ba6c6ed98b",
                                                "text": "L’acrylique est vraiment la plus abordable des techniques pour le peintre amateur en quête de progrès rapides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
