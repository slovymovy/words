                        "examples": [
                            {
                                "example_id": "2245691e-24e5-41ed-a19d-fef81118f4fc",
                                "sense_id": "78081936-24fd-344c-be2f-3954087bb781",
                                "text": "„Zwei Bänke weiter hatte er die Dekanin, den Stadtpfarrer und den ehemaligen Oberbürgermeister Schlauch entdeckt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
