    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "618eace7-ff42-3c78-ba97-f7ba72ec7f30",
                    "sense_definition": "Een regelmatig, kort klikkend of tikkend geluid makend",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>tikkende</w> klok aan de muur was het enige geluid in de stille kamer.",
                            "target_lang_translations": {
                                "en": "The <w>ticking</w> clock on the wall was the only sound in the quiet room."
                            }
                        },
                        {
                            "text": "Ik hoorde een vreemd <w>tikkend</w> geluid onder de motorkap van de auto.",
                            "target_lang_translations": {
                                "en": "I heard a strange <w>ticking</w> sound under the car's hood."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tikkende klok"
                    ],
                    "target_lang_definitions": {
                        "en": "Making a regular, short clicking or tapping sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ticking",
                                "target_lang_sense_clarification": "referring to the sound of a clock or mechanism"
                            },
                            {
                                "target_lang_word": "tapping",
                                "target_lang_sense_clarification": "referring to a light, repetitive striking sound"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3668facd-a78c-3dc6-ac22-73ffe32c9435",
                    "sense_definition": "Onvoltooid deelwoord van <w>tikken</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zat zenuwachtig met zijn vingers op tafel te <w>tikkend</w>.",
                            "target_lang_translations": {
                                "en": "He was sitting nervously <w>tapping</w> his fingers on the table."
                            }
                        },
                        {
                            "text": "De regen was zachtjes tegen het raam aan het <w>tikkend</w>.",
                            "target_lang_translations": {
                                "en": "The rain was softly <w>tapping</w> against the window."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "onvoltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
