                "senses": [
                    {
                        "sense_id": "be09c077-12fb-3d1f-a562-1227a9168e28",
                        "entry_id": "0458f064-b839-3088-bb0f-23b864ff6479",
                        "glosses": [
                            "astronomer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53fdc946-61eb-48c3-8236-83e93e947d60",
                                "sense_id": "be09c077-12fb-3d1f-a562-1227a9168e28",
                                "text": "Он был не жена́т, потому́ что ему́ не́когда бы́ло жени́ться и не́чем бы́ло бы корми́ть жену́, — да и кака́я же ду́ра реши́лась бы вы́йти за астроно́ма?",
                                "translation": "He wasn’t married, because he had no time to get married and would have been unable to feed a wife—and anyway what fool would want to marry an astronomer?",
                                "english": "He wasn’t married, because he had no time to get married and would have been unable to feed a wife—and anyway what fool would want to marry an astronomer?"
                            }
                        ]
                    }
                ],
