                                    {
                                        "sense_id": "293b9f78-122a-3438-a2fe-515ef605ca64",
                                        "entry_id": "bddfe198-c834-3d19-825e-09d2fc598ea2",
                                        "glosses": [
                                            "A person who tells stories."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42695eea-863d-3a6a-9002-af08e764baae",
                                        "entry_id": "bddfe198-c834-3d19-825e-09d2fc598ea2",
                                        "glosses": [
                                            "A bank clerk who receives and pays out money."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec0216cc-a31a-42c6-a8cb-6dc5500d9b3d",
                                                "sense_id": "42695eea-863d-3a6a-9002-af08e764baae",
                                                "text": "Sukumar was thirty years old, four years into his bank job, where he’d moved up to the role of teller, turning up to work on time every day, counting the money, making the deposits, entering in the ledger, filing the reports."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ff1e369-1c01-3dec-8ad5-b3cb33ce6fab",
                                        "entry_id": "bddfe198-c834-3d19-825e-09d2fc598ea2",
                                        "glosses": [
                                            "A cashier at any place of business."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b2a9238-8384-4c8b-ae39-528e12d167b1",
                                                "sense_id": "1ff1e369-1c01-3dec-8ad5-b3cb33ce6fab",
                                                "text": "In the case discussed above, for example, the employee who stole money did so by waiting until another teller was on break, then logging on to that teller's register, ringing a “no sale,” and taking the cash."
                                            },
                                            {
                                                "example_id": "0b75dbe0-06ef-40ce-be97-55d371e3c22f",
                                                "sense_id": "1ff1e369-1c01-3dec-8ad5-b3cb33ce6fab",
                                                "text": "The young femail teller fingered the prices into the cash register at great speed with great dexterity while simultaneously holding a conversation with the teller in the next lane."
                                            },
                                            {
                                                "example_id": "6848b34d-db92-48c6-9f3e-435916e827a1",
                                                "sense_id": "1ff1e369-1c01-3dec-8ad5-b3cb33ce6fab",
                                                "text": "The main street was shuttered; the only sign of life she detected was behind the window of the petrol station, where the teller was counting the day's cash balance into the till."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "272fb4cd-e9f7-314a-8a17-1489f4017870",
                                        "entry_id": "bddfe198-c834-3d19-825e-09d2fc598ea2",
                                        "glosses": [
                                            "Synonym of automated teller machine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
