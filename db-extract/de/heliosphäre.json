                                        "glosses": [
                                            "The region of space where interstellar medium is blown away by solar wind; the boundary, heliopause, is often considered the edge of the Solar System."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c9a5e5d-6e01-43d6-9277-fd7c5da71fb7",
                                                "sense_id": "490e9b77-82a4-3e6c-9754-50f317d69c75",
                                                "text": "The heliosphere isn’t really a sphere at all, more an elongated teardrop shape."
                                            }
