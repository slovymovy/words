        "fr-extract.jsonl": [
            {
                "entry_id": "f51d1aa1-198b-3fa0-b17b-6ac3d2545cef",
                "word": "thorax",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "672987d8-7805-367f-bb84-8babba378581",
                        "entry_id": "f51d1aa1-198b-3fa0-b17b-6ac3d2545cef",
                        "glosses": [
                            "Cage de la poitrine, où sont enfermés les poumons et le cœur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "564dc362-0076-4383-a53d-4d38ad319950",
                                "sense_id": "672987d8-7805-367f-bb84-8babba378581",
                                "text": "Partout ! lui dit le vieux vigneron, en se levant pour se promener de long en long dans la salle et se haussant le thorax par un mouvement plein d’orgueil comme son mot, partout !"
                            },
                            {
                                "example_id": "027887f9-b923-45b5-929a-7eff7241dfb1",
                                "sense_id": "672987d8-7805-367f-bb84-8babba378581",
                                "text": "Il fut réveillé brutalement par une crise effroyable. Il lui sembla qu’un poids énorme, toute la maison, s’était écroulé sur sa poitrine, à ce point que le thorax, aplati, touchait le dos ; et il ne respirait plus, la douleur gagnait les épaules, le cou, paralysait le bras gauche."
                            },
                            {
                                "example_id": "4276e4d9-b01f-473f-a64b-c54afbc5a474",
                                "sense_id": "672987d8-7805-367f-bb84-8babba378581",
                                "text": "Des hauteurs de Carpentras, […] on pouvait apercevoir les remparts d’Avignon comme un thorax de bœuf blanchi par les fourmis."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c95b51f-9a23-3068-8a27-f2039415bb33",
                        "entry_id": "f51d1aa1-198b-3fa0-b17b-6ac3d2545cef",
                        "glosses": [
                            "Un des trois grands segments de l'anatomie de l'insecte. Il porte les trois paires de pattes et les ailes éventuelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c18d1c7-c126-431e-9a48-08460413a191",
                                "sense_id": "0c95b51f-9a23-3068-8a27-f2039415bb33",
                                "text": "Pour éviter de se faire repérer, certaines espèces de papillons de nuit disposent, sur le thorax et à la jointure des ailes, d’une couverture de poils."
                            },
                            {
                                "example_id": "20e0ee00-d912-41e6-afae-38c010c02126",
                                "sense_id": "0c95b51f-9a23-3068-8a27-f2039415bb33",
                                "text": "Le thorax plat de ces insectes, dont la largeur représente un tiers de la longueur du corps, est constitué de segments flanqués de trois paires de pattes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f781ffd3-22d3-459a-ad2a-db22b6242ca4",
                        "source_entry_id": "f51d1aa1-198b-3fa0-b17b-6ac3d2545cef",
                        "target_lang_word": "Thorax",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thorax",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11cd25a2-a909-32d1-aada-3ec1d712d137",
                                        "entry_id": "ccd2ea3c-9d3d-3c31-b3a5-e76c4a5addcb",
                                        "glosses": [
                                            "Brustkorb beim Menschen und allen Wirbeltieren, der die inneren Organe schützend verbirgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c295fba9-c0e2-4f64-869a-68bd68e1dcf2",
                                                "sense_id": "11cd25a2-a909-32d1-aada-3ec1d712d137",
                                                "text": "„Die Wand des Thorax wird von Brustwirbelsäule, Brustbein und Rippen (knöcherner Thorax) sowie von Muskulatur gebildet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "387f14e1-1991-3ae5-a70d-69a460fe338f",
                                        "entry_id": "ccd2ea3c-9d3d-3c31-b3a5-e76c4a5addcb",
                                        "glosses": [
                                            "mittlerer Teil von Gliederfüßern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb4e18d3-cb8c-4e41-9d44-27136e30c778",
                                                "sense_id": "387f14e1-1991-3ae5-a70d-69a460fe338f",
                                                "text": "Die beweglichen, freischwimmenden Puppen der Stechmücken tragen auf dem Vorderende des Thorax dorsal zwei „Hörnchen“, mit denen sie „am Wasserspiegel hängen“; auf deren Spitze befinden sich Stigmenöffnungen, so daß auf solche Weise die Aufnahme atmosphärischer Luft möglich ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
