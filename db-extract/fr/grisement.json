                        "glosses": [
                            "Glauquement, en gris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c982d564-981a-47c6-bb71-9b27bec03f90",
                                "sense_id": "d61cdc13-0b37-3681-895d-dd8ef5c7dfad",
                                "text": "La vue de son visage maussade et mécontent où s'étalait grisement un intellectualisme israélite pénible et compliqué, suffisait, même en plein élan d'inspiration, à lui cailler le sang, à lui geler le cœur, à éteindre l'étincelle qui allait enflammer."
                            },
                            {
                                "example_id": "bcb5ec98-6d99-4ef9-a0dc-591768ecd882",
                                "sense_id": "d61cdc13-0b37-3681-895d-dd8ef5c7dfad",
                                "text": "Exauce mon souhait, toi qui sais\nQue ma pauvre existence se meurt,\nAu milieu d'un monde décalé,\nGrisement dessiné par le malheur."
                            }
                        ]
                    }
