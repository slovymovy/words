                                "target_senses": [
                                    {
                                        "sense_id": "77a45afc-0530-357a-a239-c5de0998d994",
                                        "entry_id": "d2e66390-110f-3fcf-a766-603850407b62",
                                        "glosses": [
                                            "jemandem (heimlich) etwas wegnehmen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cca96bc-d535-4093-8481-27532237c352",
                                                "sense_id": "77a45afc-0530-357a-a239-c5de0998d994",
                                                "text": "„Meine Frau sagt, daß man mich bestohlen hat, und du wärst wohl schlau genug, um mir zu sagen, wer mich bestohlen hat und um wieviel.“"
                                            },
                                            {
                                                "example_id": "13e28293-639b-4152-b9f1-f90d5cacaf60",
                                                "sense_id": "77a45afc-0530-357a-a239-c5de0998d994",
                                                "text": "„Also ich wollte den Bäcker bezahlen, der mir immer die Brötchen an die Türklinke hängt, und suchte meinen Geldbeutel, er ist weg, ich bin bestohlen worden.“"
                                            },
                                            {
                                                "example_id": "3aee084e-c5be-4dad-908b-a3d25b7b26b5",
                                                "sense_id": "77a45afc-0530-357a-a239-c5de0998d994",
                                                "text": "„Daß ihre Mutter verachtet, verhöhnt, mißhandelt, daß Florentine selber um ihre Jugend bestohlen worden war, dies Alles hatte nur das Geld verursacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
