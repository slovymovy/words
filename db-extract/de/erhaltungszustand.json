                        ],
                        "form": "den Erhaltungszustand"
                    },
                    {
                        "form_id": "58d24850-27be-4f1e-9a9f-0eb032b9cb1b",
                        "entry_id": "97556bf7-b4d2-325c-9173-9b0741b639de",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Erhaltungszustände"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3004ae94-2722-319b-898e-1ae3b19f3082",
                        "entry_id": "97556bf7-b4d2-325c-9173-9b0741b639de",
                        "glosses": [
                            "gegenwärtiger (qualitativer) Zustand einer Sache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50035540-b69d-4eb8-aa11-38c6fed7110a",
                                "sense_id": "3004ae94-2722-319b-898e-1ae3b19f3082",
                                "text": "„Von einem guten Erhaltungszustand sind manche Klassiker erkennbar weit entfernt.“"
                            },
                            {
                                "example_id": "4b169967-1cc6-4da3-ba15-5a8ccb094d09",
                                "sense_id": "3004ae94-2722-319b-898e-1ae3b19f3082",
                                "text": "„Millionen gebrauchter Handys liegen hierzulande ungenutzt herum. Dabei bieten Händler je nach Erhaltungszustand gutes Geld für die Geräte.“"
                            },
                            {
                                "example_id": "8b607b43-66dc-4a6c-947d-55abdce25a7a",
                                "sense_id": "3004ae94-2722-319b-898e-1ae3b19f3082",
                                "text": "„Die Malereien in den Kirchen der Altmark seien in ihrer ungewöhnlichen Vielzahl und gutem Erhaltungszustand einzigartig, sagte Elisabeth Rüber-Schütte vom Landesamt am Montag.“"
                            },
                            {
                                "example_id": "0b67f167-5196-4d39-bcb1-45d8fdbbecce",
                                "sense_id": "3004ae94-2722-319b-898e-1ae3b19f3082",
                                "text": "„Er steht stellvertretend für eine weitere Problematik der Sanierung, die unterschiedlichen Erhaltungszustände der Räume.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a3262aba-fe6d-3a07-986a-a9d5beb28d51",
                        "entry_id": "97556bf7-b4d2-325c-9173-9b0741b639de",
                        "glosses": [
                            "Ausmaß der Gefährdung von bestimmten Arten und Lebensräumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "772cf994-5547-49cf-93be-2015a4c7abe3",
                                "sense_id": "a3262aba-fe6d-3a07-986a-a9d5beb28d51",
                                "text": "„Der Erhaltungszustand des Wolfs wird dagegen weiterhin als 'schlecht' bewertet, obwohl die Tiere sich seit Jahren in Deutschland ausbreiten.“"
                            },
                            {
                                "example_id": "aff29098-4749-4e24-9af0-72409fb449ea",
                                "sense_id": "a3262aba-fe6d-3a07-986a-a9d5beb28d51",
                                "text": "„Der Erhaltungszustand einer Art wird durch die Gesamtheit der Einflüsse, die sich langfristig auf die Verbreitung und die Größe der Populationen der betreffenden Arten auswirken können, bestimmt (Artikel 1 lit. i Richtlinie 92/43/EWG).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
