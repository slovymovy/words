                "senses": [
                    {
                        "sense_id": "69a98074-33b3-3ae0-935d-d993bffe873a",
                        "entry_id": "b687ac10-2480-31fb-9878-89d62fbda4dc",
                        "glosses": [
                            "kreisförmig angelegte Zuschauertribüne um eine Arena herum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca55773-d0fb-4903-8a67-36a7fa26e98f",
                                "sense_id": "69a98074-33b3-3ae0-935d-d993bffe873a",
                                "text": "„Das Stadion umfasste damals eine Tribüne mit 2.000 überdachten Sitzplätzen und ungefähr 40.000 Stehplätzen im Stadionrund.“"
                            },
                            {
                                "example_id": "263c73af-25ae-4a44-b455-a83e2ca71819",
                                "sense_id": "69a98074-33b3-3ae0-935d-d993bffe873a",
                                "text": "„Im Stadionrund zurück, wurde ich bei meinem Start angekündigt wie ein großer Läufer.“"
                            },
                            {
                                "example_id": "f91383b5-8101-4935-a8a7-77bae28559b7",
                                "sense_id": "69a98074-33b3-3ae0-935d-d993bffe873a",
                                "text": "„3000 Mädchenbeine hoben sich im Stadionrund zur Marschmusik, ebenso viele Arme flogen im Marschtakt empor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
