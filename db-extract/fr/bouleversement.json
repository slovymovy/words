        "fr-extract.jsonl": [
            {
                "entry_id": "ac8b7533-5fbb-3ad8-a3d7-e6ab7e8ed4de",
                "word": "bouleversement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "246f323b-366b-430f-8454-8c262de4ca30",
                        "entry_id": "ac8b7533-5fbb-3ad8-a3d7-e6ab7e8ed4de",
                        "tags": [
                            "plural"
                        ],
                        "form": "bouleversements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85d08f4f-9509-3e2d-bbd4-602900d1ddec",
                        "entry_id": "ac8b7533-5fbb-3ad8-a3d7-e6ab7e8ed4de",
                        "glosses": [
                            "Action de bouleverser ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "831bd4fa-ddee-410e-bd90-09e256f0cd6d",
                                "sense_id": "85d08f4f-9509-3e2d-bbd4-602900d1ddec",
                                "text": "La jeune femme était inquiète de ce bouleversement qu'elle sentait envahir son existence. Elle était heureuse cependant, car elle avait une raison de vivre et d'espérer."
                            },
                            {
                                "example_id": "75e21c39-b1bc-4392-9f2c-3f7c9b2b0be2",
                                "sense_id": "85d08f4f-9509-3e2d-bbd4-602900d1ddec",
                                "text": "Les mêlées aériennes révélèrent une autre particularité qui eut son contre-coup sur le bouleversement social."
                            },
                            {
                                "example_id": "17dc15b9-3fb3-4a02-a57f-7d23e0698dbc",
                                "sense_id": "85d08f4f-9509-3e2d-bbd4-602900d1ddec",
                                "text": "Au milieu de ce bouleversement, bien des fortunes furent anéanties."
                            },
                            {
                                "example_id": "d803e093-20af-4829-a86c-dee76342a099",
                                "sense_id": "85d08f4f-9509-3e2d-bbd4-602900d1ddec",
                                "text": "Les bouleversements qui renversent les empires."
                            },
                            {
                                "example_id": "9bc4fa3a-f0d4-4abd-ba00-e570a3baf5a8",
                                "sense_id": "85d08f4f-9509-3e2d-bbd4-602900d1ddec",
                                "text": "Ses affaires sont dans un bouleversement total."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67788e41-d1cb-410e-adbf-bfff5a43f67c",
                        "source_entry_id": "ac8b7533-5fbb-3ad8-a3d7-e6ab7e8ed4de",
                        "source_sense_id": "85d08f4f-9509-3e2d-bbd4-602900d1ddec",
                        "target_lang_word": "Umwälzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umwälzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15d5c5b0-92f3-310f-a99a-bf9104510469",
                                        "entry_id": "a58aa7cc-6c44-3a4e-af20-b16f739858d1",
                                        "glosses": [
                                            "sehr starke, grundlegende Veränderung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e13add1b-cf3f-4ecc-905c-a427d55512a8",
                                                "sense_id": "15d5c5b0-92f3-310f-a99a-bf9104510469",
                                                "text": "„John Hammond, stets ein aufmerksamer Beobachter der Ereignisse seiner Zeit, erkennt sehr bald, welche Umwälzungen Homer Capeharts Erfindung der Jukebox für die Phono-Industrie bringen wird.“"
                                            },
                                            {
                                                "example_id": "1372b47b-cbd3-4e10-b9f6-a966ac7a98a3",
                                                "sense_id": "15d5c5b0-92f3-310f-a99a-bf9104510469",
                                                "text": "„Die politische Umwälzung vollendete sich im Landtagsgebäude.“"
                                            },
                                            {
                                                "example_id": "1f3b94cf-457c-401b-8d5e-e93b034fc911",
                                                "sense_id": "15d5c5b0-92f3-310f-a99a-bf9104510469",
                                                "text": "„In den bedrückenden Jahren der Apartheid hatte sie erwogen, das Land zu verlassen, aber sie war geblieben und hatte sich über die politischen Umwälzungen gefreut, die Freilassung Mandelas, den neuen Wohlstand und die Fußballweltmeisterschaft.“"
                                            },
                                            {
                                                "example_id": "dc28de4e-5911-481f-978b-0908e13342e2",
                                                "sense_id": "15d5c5b0-92f3-310f-a99a-bf9104510469",
                                                "text": "„Durch die gemeinsam erlebten politischen Umwälzungen seit 1914 pflegen die Europäer ein ganz eigenes, hoch entwickeltes Verständnis von Machtpolitik und politischer Verantwortung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99bb4ed6-d77f-3e01-a3e8-dcb51192bcb6",
                                        "entry_id": "a58aa7cc-6c44-3a4e-af20-b16f739858d1",
                                        "glosses": [
                                            "technischer Prozess ständigen Flusses einer Flüssigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
