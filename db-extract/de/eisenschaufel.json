                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7d7b0a2-adeb-45bb-b217-cecc5fd3b7c9",
                                "sense_id": "9b64230b-b86a-3b4b-b779-0298fd3211ac",
                                "text": "„Jedes Mal, wenn ich die Eisenschaufel in den kleinen Hügel aus Erde stieß, die darauf wartete, in das Loch zurückbefördert zu werden, aus dem sie herausgegraben worden war, versuchte ich, mir vorzustellen, dass das nicht wirklich zwei tote Körper waren, sondern nur Kleiderhaufen, weggeworfen von Auswanderern auf dem Weg in ein Land jenseits der menschlichen Kartografie, in ein Land, wo die Engel lebten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
