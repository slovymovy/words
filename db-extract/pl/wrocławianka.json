                "senses": [
                    {
                        "sense_id": "656d9dce-5b15-389e-a46b-9649e64064ed",
                        "entry_id": "cfe4c618-2347-3640-a4e9-a3825f0e1020",
                        "glosses": [
                            "female equivalent of wrocławianin; native or inhabitant of Wrocław"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d2dac67c-4ad3-4522-aa2e-03691efd9c2a",
                                "sense_id": "656d9dce-5b15-389e-a46b-9649e64064ed",
                                "text": "Spikerkę poprowadzi, wespół z Tomaszem Lorkiem, znany z telewizji publicznej Maciej Kurzajewski, a kierownikiem startu będzie piękna wrocławianka…",
                                "translation": "The announcer will be Maciej Kurzajewski, known from public television, together with Tomasz Lorek, and the start manager will be a beautiful Wrocławian...",
                                "english": "The announcer will be Maciej Kurzajewski, known from public television, together with Tomasz Lorek, and the start manager will be a beautiful Wrocławian..."
                            },
                            {
                                "example_id": "63657b3d-d3c9-4f05-bf50-a98d94f841e6",
                                "sense_id": "656d9dce-5b15-389e-a46b-9649e64064ed",
                                "text": "Ja nie Wrocławianka, ale podpowiem, że fajne i ciepłe śpiworki można dostać w sklepach H&M, przynajmniej w Warszawie.",
                                "translation": "I'm a Wrocławian, but I can tell you that you can get nice and warm sleeping bags in H&M stores, at least in Warsaw.",
                                "english": "I'm a Wrocławian, but I can tell you that you can get nice and warm sleeping bags in H&M stores, at least in Warsaw."
                            }
                        ]
                    }
                ],
