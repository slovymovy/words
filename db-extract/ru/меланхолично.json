                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd37d081-7a59-4d7f-b323-e5581a74d668",
                                                "sense_id": "8e7dfbfa-2d9b-3950-ad1f-7a9ecb440274",
                                                "text": "Quand la bonne femme y vint, vers les huit heures, avec un copieux déjeuner, elle le trouva assis qui embattait mélancoliquement sa faux."
                                            },
                                            {
                                                "example_id": "6c6c3011-2b49-4643-9c04-299e9aa64023",
                                                "sense_id": "8e7dfbfa-2d9b-3950-ad1f-7a9ecb440274",
                                                "text": "Le soir seulement, au moment où le soleil se couchait, on ouvrait la fenêtre, et la mourante souriait mélancoliquement à son dernier rayon."
                                            },
                                            {
                                                "example_id": "d2978d9f-d3a9-42de-85a4-12f07b695dd3",
                                                "sense_id": "8e7dfbfa-2d9b-3950-ad1f-7a9ecb440274",
                                                "text": "La mer calme grondait mélancoliquement."
                                            }
                                        ]
                                    }
                                ]
