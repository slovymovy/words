                ],
                "senses": [
                    {
                        "sense_id": "3c722caa-f8db-3ac8-9d7c-7d5e3b2985f1",
                        "entry_id": "86999c2b-3c43-33af-9c56-9faa762a55d6",
                        "glosses": [
                            "verheerender Brand des Berliner Reichstages in der Nacht vom 27. auf den 28. Februar 1933"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "d3b363d2-72fc-4266-b8ad-f1650c64bfe6",
                                "sense_id": "3c722caa-f8db-3ac8-9d7c-7d5e3b2985f1",
                                "text": "Der Reichstagsbrand wurde durch einen Brandstifter ausgelöst."
                            },
                            {
                                "example_id": "f3c3c98f-1d53-4c70-a0f4-fc04847ab35e",
                                "sense_id": "3c722caa-f8db-3ac8-9d7c-7d5e3b2985f1",
                                "text": "Die Nationalsozialisten nutzten den Reichstagsbrand, um ihre politischen Gegner zu verfolgen."
                            },
                            {
                                "example_id": "a511ff2c-3605-43ea-8418-8d0ff547b58e",
                                "sense_id": "3c722caa-f8db-3ac8-9d7c-7d5e3b2985f1",
                                "text": "„Mit dem Reichstagsbrand am 27. Februar 1933 ging die Demokratie in Flammen auf.“"
                            },
                            {
                                "example_id": "a77b9cf4-b21c-41b6-bb5e-07d9c37ec649",
                                "sense_id": "3c722caa-f8db-3ac8-9d7c-7d5e3b2985f1",
                                "text": "„Sie begannen mit der Verhaftung gleich bei Machtantritt der Nazis 1933, nach dem Reichstagsbrand, und endeten mit der Entlassung unseres Vaters aus Buchenwald 1938.“"
                            },
                            {
                                "example_id": "4d34d5c5-da1e-4b1c-acd5-56161ea20075",
                                "sense_id": "3c722caa-f8db-3ac8-9d7c-7d5e3b2985f1",
                                "text": "„Anna Seghers und ihr Mann gehen ebenfalls am Tag nach dem Reichstagsbrand in die Schweiz, ihre Kinder sind noch in Mainz.“"
                            },
                            {
                                "example_id": "520e6a41-e409-4679-aa23-62cc25f77b7d",
                                "sense_id": "3c722caa-f8db-3ac8-9d7c-7d5e3b2985f1",
                                "text": "„In der Nacht des Reichstagsbrandes stürmen SA-Leute seine Wohnung, um ihn wie viele andere umzubringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
