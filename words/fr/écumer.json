    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bbc0a7e6-11ad-3d8e-bdf6-95195616c52f",
                    "sense_definition": "Produire de l'écume ou se couvrir d'une mousse blanchâtre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mousse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la tempête, la mer <w>écumait</w> avec force contre les rochers de la falaise."
                        },
                        {
                            "text": "Le cheval fatigué <w>écumait</w> après cette longue course à travers la forêt."
                        }
                    ],
                    "synonyms": [
                        "mousser"
                    ],
                    "common_phrases": [
                        "mer qui écume",
                        "écumer sous le mors"
                    ]
                },
                {
                    "sense_id": "d7197331-e659-38fb-8bb5-882fc125d85d",
                    "sense_definition": "Enlever la mousse ou les impuretés qui surnagent à la surface d'un liquide en ébullition.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier doit <w>écumer</w> le bouillon pour qu'il devienne parfaitement limpide."
                        },
                        {
                            "text": "Pendant la cuisson des fruits, il faut <w>écumer</w> la confiture avec une cuillère."
                        }
                    ],
                    "synonyms": [
                        "dépouiller"
                    ],
                    "common_phrases": [
                        "écumer le bouillon",
                        "écumer la confiture"
                    ]
                },
                {
                    "sense_id": "d7500231-54ac-3b74-8840-33ac6b73deaa",
                    "sense_definition": "Manifester une colère extrême et violente.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En apprenant cette trahison inattendue, le directeur s'est mis à <w>écumer</w> de colère."
                        },
                        {
                            "text": "Le client mécontent <w>écumait</w> de rage devant le retard inadmissible de sa commande."
                        }
                    ],
                    "synonyms": [
                        "bouillir",
                        "enrager"
                    ],
                    "common_phrases": [
                        "écumer de rage",
                        "écumer de colère"
                    ]
                },
                {
                    "sense_id": "6275c806-e80d-3483-b961-ebcd01c4654d",
                    "sense_definition": "Parcourir une zone maritime pour piller des navires ou y exercer la piraterie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "piraterie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au dix-septième siècle, de redoutables corsaires venaient <w>écumer</w> les mers du Sud."
                        },
                        {
                            "text": "Ce navire de pirates a longtemps <w>écumé</w> les côtes pour attaquer les marchands."
                        }
                    ],
                    "synonyms": [
                        "pirater",
                        "piller"
                    ],
                    "common_phrases": [
                        "écumer les mers",
                        "écumer les côtes"
                    ]
                },
                {
                    "sense_id": "83ff6d75-0128-365b-957c-3c5c420b54b8",
                    "sense_definition": "Parcourir méthodiquement plusieurs endroits afin de chercher ou collecter quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recherche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a passé tout son samedi à <w>écumer</w> les magasins à la recherche d'une robe."
                        },
                        {
                            "text": "Les collectionneurs aiment <w>écumer</w> les brocantes de village dès le lever du jour."
                        }
                    ],
                    "synonyms": [
                        "fouiller",
                        "arpenter"
                    ],
                    "common_phrases": [
                        "écumer les magasins",
                        "écumer les brocantes"
                    ]
                }
            ]
        }
    ]
}