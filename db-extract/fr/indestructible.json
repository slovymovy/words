        "fr-extract.jsonl": [
            {
                "entry_id": "ca404da6-9d9c-3abf-8dcd-e13f1d159e70",
                "word": "indestructible",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6fa1f343-9786-4105-9f26-b87a6858426b",
                        "entry_id": "ca404da6-9d9c-3abf-8dcd-e13f1d159e70",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "indestructibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52b63354-3f14-3c58-9a24-33fc96732b66",
                        "entry_id": "ca404da6-9d9c-3abf-8dcd-e13f1d159e70",
                        "glosses": [
                            "Qui ne peut être détruit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad13026d-2eff-4479-a055-53f0987bbf8e",
                                "sense_id": "52b63354-3f14-3c58-9a24-33fc96732b66",
                                "text": "Ainsi, en dirigeant les eaux de manière à ce qu’elles n’engorgeassent plus le canal indestructible que la Nature avait fait elle-même, et le débarrassant des terres qui l’avait comblé, l’irrigation serait facilitée par cette longue gouttière, élevée d’environ dix pieds au-dessus de la plaine."
                            },
                            {
                                "example_id": "be499cca-8aa8-4e96-9794-9dd4f79d14c0",
                                "sense_id": "52b63354-3f14-3c58-9a24-33fc96732b66",
                                "text": "Celui-là, reprit Léonora, porte au cœur une indestructible ambition : fils de roi, régner à son tour !"
                            },
                            {
                                "example_id": "c750bbba-9c6d-4f17-bfcd-9247c58c3ed8",
                                "sense_id": "52b63354-3f14-3c58-9a24-33fc96732b66",
                                "text": "Baptiste, incapable d'imaginer que l’école nous guettait, avait consacré trois jours entiers à construire un radeau qu’il prétendait indestructible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc9d0ae3-76be-4685-83a8-e0cf3d653cbd",
                        "source_entry_id": "ca404da6-9d9c-3abf-8dcd-e13f1d159e70",
                        "source_sense_id": "52b63354-3f14-3c58-9a24-33fc96732b66",
