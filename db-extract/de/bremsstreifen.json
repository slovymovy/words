                "senses": [
                    {
                        "sense_id": "836672f6-6f2c-3e61-bcb4-46e69531ee63",
                        "entry_id": "a4eca016-0a12-3e65-b28a-2da6d29093e3",
                        "glosses": [
                            "längliche Kotspur in einer Unterhose/Toilette"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0a258256-5d26-43c3-ae17-1c59a5d8753e",
                                "sense_id": "836672f6-6f2c-3e61-bcb4-46e69531ee63",
                                "text": "„Den darauf, weil er sich die Augenbrauen rasiert, und den danach, weil er Quad fährt. Und den Letzten, weil er mich an jemanden aus meiner Schulzeit erinnert, der Bremsstreifen in der Unterhose gehabt haben soll. Das ist doch lächerlich.“"
                            },
                            {
                                "example_id": "5e1e76a8-bb18-42d9-b56e-f908017b89da",
                                "sense_id": "836672f6-6f2c-3e61-bcb4-46e69531ee63",
                                "text": "„Er kümmerte sich mehr um seine Unterwäsche als um seine übrigen Klamotten, da er heute noch flachgelegt werden wollte und dieses Unterfangen nicht an einer weißen Unterhose mit Bremsstreifen scheitern sollte.“"
                            },
                            {
                                "example_id": "8a826a24-2831-4444-b6f3-d6ecb8eb82a4",
                                "sense_id": "836672f6-6f2c-3e61-bcb4-46e69531ee63",
                                "text": "„Und auf dem Mitarbeiterklo hinterlässt er regelmäßig Bremsstreifen, denn ein Prinz fasst doch keine Klobürste an!“"
                            },
                            {
                                "example_id": "b47e0497-ab2f-466d-91f6-42d9d464fd40",
                                "sense_id": "836672f6-6f2c-3e61-bcb4-46e69531ee63",
                                "text": "„Ein Kuhfladen auf dem Dorfplatz, ein Hundehaufen auf dem Gehweg oder ein Bremsstreifen auf der öffentlichen Toilette lässt sich nicht einfach löschen, wegklicken oder mit cut and paste an einen anderen Ort verschieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
