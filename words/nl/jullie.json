                {
                    "sense_id": "605e8556-aaae-3c6f-9be5-db46af4f17ac",
                    "sense_definition": "Verwijst naar de personen tegen wie men spreekt (meervoud) als lijdend of meewerkend voorwerp, of na een voorzetsel.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "object_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zal het morgen aan <w>jullie</w> geven.",
                            "target_lang_translations": {
                                "en": "I will give it to <w>you</w> tomorrow.",
                                "ru": "Я дам это <w>вам</w> завтра.",
                                "pl": "Dam to <w>wam</w> jutro.",
                                "de": "Ich werde es <w>euch</w> morgen geben.",
                                "fr": "Je <w>vous</w> le donnerai demain.",
                                "it": "Lo darò a <w>voi</w> domani.",
                                "cs": "Dám <w>vám</w> to zítra.",
                                "tr": "Onu yarın <w>size</w> vereceğim.",
                                "es": "Se lo daré a <w>vosotros</w> mañana."
                            }
                        },
                        {
                            "text": "De leraar heeft <w>jullie</w> gisteren in de stad gezien.",
                            "target_lang_translations": {
                                "en": "The teacher saw <w>you</w> in the city yesterday.",
                                "ru": "Учитель видел <w>вас</w> вчера в городе.",
                                "pl": "Nauczyciel widział <w>was</w> wczoraj w mieście.",
                                "de": "Der Lehrer hat <w>euch</w> gestern in der Stadt gesehen.",
                                "fr": "L'enseignant <w>vous</w> a vus en ville hier.",
                                "it": "L'insegnante <w>vi</w> ha visti in città ieri.",
                                "cs": "Učitel <w>vás</w> včera viděl ve městě.",
                                "tr": "Öğretmen dün <w>sizi</w> şehirde gördü.",
                                "es": "El profesor <w>os</w> vio ayer en la ciudad."
                            }
                        }
                    ],
