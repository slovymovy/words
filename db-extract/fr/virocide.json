                "translations": [
                    {
                        "translation_id": "8bfa95b3-a2d4-4cc8-ad63-30c93c6e59dc",
                        "source_entry_id": "58faa0f3-248d-3c88-abc7-a3e7057281ac",
                        "source_sense_id": "4e53b50b-dd3c-31d6-93d0-98d978fc0afa",
                        "source_sense_description": "Biologie, Medizin: viruzid",
                        "target_lang_word": "viruzid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viruzid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f05f25fa-30ee-368e-8eeb-96470d38aa15",
                                        "entry_id": "086b220f-0cc3-308f-b773-2c1fb789f5d6",
                                        "glosses": [
                                            "Viren beschädigend und/oder abtötend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d36bd2d-72b3-4879-a2ad-cb1ff202e1ec",
                                                "sense_id": "f05f25fa-30ee-368e-8eeb-96470d38aa15",
                                                "text": "Dieses Desinfektionsmittel ist viruzid."
                                            },
                                            {
                                                "example_id": "34d3c347-fed7-4ea2-98f2-6cd9775d0c24",
                                                "sense_id": "f05f25fa-30ee-368e-8eeb-96470d38aa15",
                                                "text": "Um Corona- und Influenza-Viren ausreichend zu eliminieren, müssen Desinfektionsmittel zumindest „begrenzt viruzid“ sein. Das bedeutet, sie sind gegen behüllte Viren wirksam."
                                            },
                                            {
                                                "example_id": "43aadfe6-c2b2-4fe5-a093-b9e883ef5098",
                                                "sense_id": "f05f25fa-30ee-368e-8eeb-96470d38aa15",
                                                "text": "Für ein viruzides Händedesinfektionsmittel darf heute nur noch behauptet werden, dass es den Standard von 2008 erfüllt, d. h. dass es gegen Polio-, Adeno-, Polyomavirus 40 und Vacciniavirus wirksam ist."
                                            },
                                            {
                                                "example_id": "a9bc912b-94b4-4d16-820b-dfb3fafa25e3",
                                                "sense_id": "f05f25fa-30ee-368e-8eeb-96470d38aa15",
                                                "text": "Die von der Sonne ausgehende UV-Strahlung wirkt stark viruzid."
                                            },
                                            {
                                                "example_id": "a3dc160c-fc4c-42db-8157-cf85da8c045a",
                                                "sense_id": "f05f25fa-30ee-368e-8eeb-96470d38aa15",
                                                "text": "Für die hygienische Händedesinfektion sind daher nur wenige Wirkstoffe bzw. Präparate geeignet, die sowohl eine viruzide Wirksamkeit gewährleisten als auch den hohen Anforderungen an die Hautverträglichkeit entsprechen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
