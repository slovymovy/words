                        "sense_id": "89be4a5f-3872-34b2-8716-9b8ffcab7c4f",
                        "entry_id": "95fb478a-486b-3e7e-83f4-a58eeecb264c",
                        "glosses": [
                            "ein Zustand, in dem man keinen Appetit hat"
