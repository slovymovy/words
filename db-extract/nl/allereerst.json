                "senses": [
                    {
                        "sense_id": "c99f0423-cac0-32dc-8a97-d8d95bff9364",
                        "entry_id": "1fc5ed24-e696-397d-bf1b-3da278b2d35c",
                        "glosses": [
                            "komend vóór elk ander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a312da31-5439-4858-a8da-dc38d5f72e6c",
                                "sense_id": "c99f0423-cac0-32dc-8a97-d8d95bff9364",
                                "text": "Hoe kan het dat opvolger Benedictus XVI wel onmiddellijk optrad tegen deze Maciel? Ieder antwoord roept weer nieuwe vragen op. Een allereerst, kort onderzoek naar deze strenge priestercongregatie was er in maart. In opdracht van paus Benedictus bogen vijf bisschoppen zich over de corrupte boedel."
                            },
                            {
                                "example_id": "c22309eb-1701-4af9-881d-07eec0b3c8f5",
                                "sense_id": "c99f0423-cac0-32dc-8a97-d8d95bff9364",
                                "text": "De allereerste leerling die klaar is met zijn proefwerk krijgt een punt extra."
                            },
                            {
                                "example_id": "8d5233d7-d5fa-4dc0-b2ab-a1085a6404e6",
                                "sense_id": "c99f0423-cac0-32dc-8a97-d8d95bff9364",
                                "text": "Maar hij wantrouwde hem in de allereerste plaats. Omdat Pradelle van aanvallen hield. Stormenderhand nemen, bestormen, veroveren, hij deed niets liever."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "57342978-8be7-3364-baa0-1625c75d97bb",
                "word": "allereerst",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ad0c2ee9-fb78-3696-b1d6-543b1422f1d2",
                        "entry_id": "57342978-8be7-3364-baa0-1625c75d97bb",
                        "glosses": [
                            "geheel op de eerste plaats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec8eeafe-c06a-495a-b26f-0d2c5a69c756",
                                "sense_id": "ad0c2ee9-fb78-3696-b1d6-543b1422f1d2",
                                "text": "Aanvankelijk had ik geaarzeld, allereerst omdat ik nog steeds bezig was in mijn boek van Muriel Spark, een verzameling korte verhalen en hoorspelen die zes jaar daarvoor was uitgegeven."
                            },
                            {
                                "example_id": "416727a1-e08a-4213-a363-8fc737d05d5c",
                                "sense_id": "ad0c2ee9-fb78-3696-b1d6-543b1422f1d2",
                                "text": "Allereerst wil ik een woord van dank spreken voor alle medewerkers die dit project mogelijk gemaakt hebben."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
