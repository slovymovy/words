                ],
                "senses": [
                    {
                        "sense_id": "1167d872-5f08-3fb8-a1cf-838ca934aba8",
                        "entry_id": "c382c672-2f17-3619-92a4-6cdf861046af",
                        "glosses": [
                            "Bahnstrecke, die nicht mit einer Oberleitung ausgerüstet ist; welche nur mit Dieselfahrzeugen befahren werden kann"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "b6c87be3-5f96-480c-81cd-35cb845d2bb2",
                                "sense_id": "1167d872-5f08-3fb8-a1cf-838ca934aba8",
                                "text": "„Die regionale Dieselstrecke RB82 geht von Bad Oldesloe nach Neumünster.“"
                            },
                            {
                                "example_id": "fdc96f9a-73f4-455c-9ed8-52128cf086e7",
                                "sense_id": "1167d872-5f08-3fb8-a1cf-838ca934aba8",
                                "text": "„Der Ausbau der eingleisigen Dieselstrecke im Abschnitt Wien-Stadlau und der Staatsgrenze bei Marchegg zu einer elektrifizierten und teilweise zweigleisigen Hochleistungsstrecke erfolgt laut ÖBB unter laufendem Betrieb.“"
                            },
                            {
                                "example_id": "ca5b8fd3-f7f9-49fa-8e17-432d065e4467",
                                "sense_id": "1167d872-5f08-3fb8-a1cf-838ca934aba8",
                                "text": "„Damit die Strecke zwischen Friedrichshafen und Radolfzell nicht als letzte Dieselstrecke von schnelleren Verbindungen abgehängt ist, hat der Kreistag seine Unterstützung für die Elektrifizierung zugesagt.“"
                            },
                            {
                                "example_id": "5097ade5-0fbd-48bf-a105-30dde1ee2889",
                                "sense_id": "1167d872-5f08-3fb8-a1cf-838ca934aba8",
                                "text": "„Es entstehen aber noch weitere kleinere Bahnhöfe in drei Stadtteilen Lindaus. Außerdem werden Bahnübergänge vor der Lindauer Insel beseitigt, die Signaltechnik wird erneuert und die alte Dieselstrecke nach jahrelangem Warten elektrifiziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
