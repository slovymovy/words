{
    "word_family": [
        "multiple",
        "multiplication",
        "multiplier",
        "multiplicity",
        "multiplicative",
        "multitude"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1847a1bc-1eb6-3f23-b99b-d4903beb8a70",
                    "sense_definition": "To calculate the product of two or more numbers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the first grade, children learn how to <w>multiply</w> small numbers like two and five.",
                            "target_lang_translations": {
                                "ru": "В первом классе дети учатся <w>умножать</w> маленькие числа, такие как два и пять.",
                                "zh": "一年级的孩子学习如何<w>乘</w>像二和五这样的小数字。"
                            }
                        },
                        {
                            "text": "If you <w>multiply</w> three by seven, the result is twenty-one.",
                            "target_lang_translations": {
                                "ru": "Если <w>умножить</w> три на семь, получится двадцать один.",
                                "zh": "如果你把三和七<w>相乘</w>，结果是二十一。"
                            }
                        }
                    ],
                    "antonyms": [
                        "divide"
                    ],
                    "common_phrases": [
                        "multiply by seven",
                        "multiply two numbers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вычислять произведение двух или более чисел.",
                        "zh": "计算两个或多个数字的乘积。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умножать",
                                "target_lang_sense_clarification": "математическое действие"
                            },
                            {
                                "target_lang_word": "умножить",
                                "target_lang_sense_clarification": "совершить действие умножения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乘",
                                "target_lang_sense_clarification": "数学运算"
                            },
                            {
                                "target_lang_word": "相乘",
                                "target_lang_sense_clarification": "执行乘法动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a07b6be7-7efd-36d9-bc43-966b346f4d8d",
                    "sense_definition": "To perform the mathematical operation of multiplication.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had been <w>multiplying</w> for an hour before he realized he made a mistake in the first step.",
                            "target_lang_translations": {
                                "ru": "Он <w>умножал</w> уже целый час, прежде чем понял, что допустил ошибку на первом этапе.",
                                "zh": "他<w>做乘法</w>做了一个小时，才发现第一步就错了。"
                            }
                        },
                        {
                            "text": "The student was <w>multiplying</w> in her head while the teacher wrote on the board.",
                            "target_lang_translations": {
                                "ru": "Ученица <w>умножала</w> в уме, пока учитель писал на доске.",
                                "zh": "老师在黑板上写字时，学生正在心里<w>做乘法</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "divide"
                    ],
                    "common_phrases": [
                        "multiplying in head"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять математическую операцию умножения.",
                        "zh": "进行乘法数学运算。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умножать",
                                "target_lang_sense_clarification": "процесс вычисления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "做乘法",
                                "target_lang_sense_clarification": "进行计算的过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "084c486d-e41e-35cb-887c-bb97a58f6b92",
                    "sense_definition": "To increase the amount, degree, or number of something significantly.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new marketing campaign helped to <w>multiply</w> our sales within just a few months.",
                            "target_lang_translations": {
                                "ru": "Новая маркетинговая кампания помогла <w>приумножить</w> наши продажи всего за несколько месяцев.",
                                "zh": "新的营销活动在短短几个月内就帮助我们的销售额实现了<w>倍增</w>。"
                            }
                        },
                        {
                            "text": "Complaints will <w>multiply</w> rapidly if the company does not address the technical issues soon.",
                            "target_lang_translations": {
                                "ru": "Количество жалоб будет стремительно <w>множиться</w>, если компания в ближайшее время не решит технические проблемы.",
                                "zh": "如果公司不尽快解决技术问题，投诉将会迅速<w>增多</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "decrease",
                        "reduce"
                    ],
                    "common_phrases": [
                        "multiply the efforts",
                        "multiply the chances"
                    ],
                    "target_lang_definitions": {
                        "ru": "Значительно увеличивать количество, степень или число чего-либо.",
                        "zh": "显著增加某事物的数量、程度或规模。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приумножить",
                                "target_lang_sense_clarification": "увеличить имеющееся"
                            },
                            {
                                "target_lang_word": "умножить",
                                "target_lang_sense_clarification": "увеличить в несколько раз"
                            },
                            {
                                "target_lang_word": "увеличить",
                                "target_lang_sense_clarification": "сделать больше"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增加",
                                "target_lang_sense_clarification": "使数量变多"
                            },
                            {
                                "target_lang_word": "倍增",
                                "target_lang_sense_clarification": "成倍增加"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c25e54de-4474-3430-a641-4bd7f2a7d6fc",
                    "sense_definition": "To grow or increase in number or quantity.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rabbits tend to <w>multiply</w> very quickly when they have enough food and space.",
                            "target_lang_translations": {
                                "ru": "Кролики склонны очень быстро <w>размножаться</w>, когда у них достаточно еды и места.",
                                "zh": "当有足够的食物和空间时，兔子往往会迅速<w>繁衍</w>。"
                            }
                        },
                        {
                            "text": "As the city grew, the number of small businesses began to <w>multiply</w> in the suburbs.",
                            "target_lang_translations": {
                                "ru": "По мере роста города число малых предприятий в пригородах начало <w>расти</w>.",
                                "zh": "随着城市的发展，郊区的小企业数量开始<w>增多</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "dwindle"
                    ],
                    "common_phrases": [
                        "multiply quickly",
                        "multiply in number"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расти или увеличиваться в количестве или численности.",
                        "zh": "在数量或规模上增长或增加。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "множиться",
                                "target_lang_sense_clarification": "становиться многочисленнее"
                            },
                            {
                                "target_lang_word": "увеличиваться",
                                "target_lang_sense_clarification": "в количестве"
                            },
                            {
                                "target_lang_word": "плодиться",
                                "target_lang_sense_clarification": "быстро увеличиваться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增多",
                                "target_lang_sense_clarification": "数量变多"
                            },
                            {
                                "target_lang_word": "繁衍",
                                "target_lang_sense_clarification": "指数量快速增长"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1c6b9fa-b7b6-3e9a-95ee-88665ace3af4",
                    "sense_definition": "To breed or produce offspring; to propagate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bacteria can <w>multiply</w> at an alarming rate in warm and moist environments.",
                            "target_lang_translations": {
                                "ru": "Бактерии могут <w>размножаться</w> с пугающей скоростью в теплой и влажной среде.",
                                "zh": "在温暖潮湿的环境中，细菌会以惊人的速度<w>繁殖</w>。"
                            }
                        },
                        {
                            "text": "The species was able to <w>multiply</w> and thrive after being introduced to the new habitat.",
                            "target_lang_translations": {
                                "ru": "Вид смог <w>размножиться</w> и процветать после интродукции в новую среду обитания.",
                                "zh": "该物种被引入新栖息地后，能够<w>繁衍</w>并茁壮成长。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "multiply and thrive",
                        "bacteria multiply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размножаться или производить потомство; распространяться.",
                        "zh": "繁殖或产生后代；传播。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размножаться",
                                "target_lang_sense_clarification": "биологический процесс"
                            },
                            {
                                "target_lang_word": "плодиться",
                                "target_lang_sense_clarification": "давать потомство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "繁殖",
                                "target_lang_sense_clarification": "生物学过程"
                            },
                            {
                                "target_lang_word": "繁衍",
                                "target_lang_sense_clarification": "产生后代"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26a97b88-5b3a-31c0-b6b7-2bfad48fc6f7",
                    "sense_definition": "To be a factor in a multiplication operation with another number.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this specific algebraic equation, the variable x <w>multiplies</w> the entire expression inside the parentheses.",
                            "target_lang_translations": {
                                "ru": "В этом конкретном алгебраическом уравнении переменная x <w>умножается</w> на все выражение в скобках.",
                                "zh": "在这个特定的代数方程中，变量 x 与括号内的整个表达式<w>相乘</w>。"
                            }
                        },
                        {
                            "text": "Carefully arrange the factors to ensure that two <w>multiplies</w> four to get the correct result.",
                            "target_lang_translations": {
                                "ru": "Тщательно расставьте множители, чтобы два <w>умножалось</w> на четыре для получения правильного результата.",
                                "zh": "仔细排列因数，确保二与四<w>相乘</w>以得到正确结果。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "multiplies the factor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть множителем в операции умножения с другим числом.",
                        "zh": "在乘法运算中作为乘数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умножаться",
                                "target_lang_sense_clarification": "о числе в уравнении"
                            },
                            {
                                "target_lang_word": "умножать",
                                "target_lang_sense_clarification": "выступать множителем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相乘",
                                "target_lang_sense_clarification": "作为乘数参与运算"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b5b6912-5be1-3912-ae7c-919d09ea070c",
                    "sense_definition": "An instance or act of performing a multiplication.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The processor speed increases significantly if the software requires fewer <w>multiplies</w> per second.",
                            "target_lang_translations": {
                                "ru": "Скорость процессора значительно возрастает, если программному обеспечению требуется меньше <w>операций умножения</w> в секунду.",
                                "zh": "如果软件每秒所需的<w>乘法运算</w>次数较少，处理器速度会显著提高。"
                            }
                        },
                        {
                            "text": "You should list the total number of adds and <w>multiplies</w> required for each formula.",
                            "target_lang_translations": {
                                "ru": "Вам следует указать общее количество сложений и <w>умножений</w>, необходимых для каждой формулы.",
                                "zh": "你应该列出每个公式所需的加法和<w>乘法运算</w>的总数。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "number of multiplies"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used primarily in technical or computing contexts as a shorthand for multiplication operations."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай или акт выполнения умножения.",
                        "zh": "执行乘法运算的实例或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умножение",
                                "target_lang_sense_clarification": "операция в программировании или технике"
                            },
                            {
                                "target_lang_word": "акт умножения",
                                "target_lang_sense_clarification": "единичное действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乘法运算",
                                "target_lang_sense_clarification": "技术或计算语境"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "43904a73-ee4b-3c6f-bbbd-ae8f15e39822",
                    "sense_definition": "In many or multiple different ways.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "diversity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The themes of the novel are <w>multiply</w> connected to the historical events of that era.",
                            "target_lang_translations": {
                                "ru": "Темы романа <w>многократно</w> связаны с историческими событиями той эпохи.",
                                "zh": "这部小说的各个主题与那个时代的重大历史事件有着<w>多重</w>联系。"
                            }
                        },
                        {
                            "text": "The data was <w>multiply</w> verified by several independent research teams across the globe.",
                            "target_lang_translations": {
                                "ru": "Данные были <w>неоднократно</w> проверены несколькими независимыми исследовательскими группами по всему миру.",
                                "zh": "这些数据已由全球多个独立研究团队<w>反复</w>验证。"
                            }
                        }
                    ],
                    "synonyms": [
                        "manifold"
                    ],
                    "common_phrases": [
                        "multiply connected"
                    ],
                    "target_lang_definitions": {
                        "ru": "Многими или различными способами.",
                        "zh": "以多种或不同的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "многократно",
                                "target_lang_sense_clarification": "повторяющимся образом"
                            },
                            {
                                "target_lang_word": "разнообразно",
                                "target_lang_sense_clarification": "различными путями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多重地",
                                "target_lang_sense_clarification": "以多种方式"
                            },
                            {
                                "target_lang_word": "反复地",
