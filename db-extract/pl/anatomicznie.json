                    {
                        "translation_id": "6073b815-db9f-4223-84fc-b9dd7748919e",
                        "source_entry_id": "79be1ec9-047b-344b-baf8-6e2ac5263013",
                        "source_sense_id": "a33cfe61-addd-3a88-8ed6-302773a0206c",
