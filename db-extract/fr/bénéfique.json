                                        "sense_id": "a95e3114-613e-3ddb-9994-6b26eba9af71",
                                        "entry_id": "49779225-b90d-3d79-8f5b-58616bd6c9b9",
                                        "glosses": [
                                            "Helpful or good to something or someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5acda19-c0b3-4461-9bf4-32ac9b4035bd",
                                                "sense_id": "a95e3114-613e-3ddb-9994-6b26eba9af71",
                                                "text": "Recycling and reusing garbage can be beneficial to the environment."
                                            },
                                            {
                                                "example_id": "cf6afeab-94f7-4697-a89f-8ad91c9dc593",
                                                "sense_id": "a95e3114-613e-3ddb-9994-6b26eba9af71",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42c680f4-e224-3065-9078-80da19574745",
                                        "entry_id": "49779225-b90d-3d79-8f5b-58616bd6c9b9",
                                        "glosses": [
                                            "Relating to a benefice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
