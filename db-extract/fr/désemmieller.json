                "senses": [
                    {
                        "sense_id": "ec48d746-9db5-31c6-ad16-c96654711f8b",
                        "entry_id": "b6d5e881-cae3-383f-90e6-dbf152f60c15",
                        "glosses": [
                            "Enlever le miel de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00dbef18-2ea4-4500-911e-433a664962f0",
                                "sense_id": "ec48d746-9db5-31c6-ad16-c96654711f8b",
                                "text": "Mais il m'a tellement emmiellé en m'élevant que j'ai mal tourné rien que pour me désemmieller."
                            },
                            {
                                "example_id": "4e7f6ccc-c8d0-4781-b434-0da080bb1df4",
                                "sense_id": "ec48d746-9db5-31c6-ad16-c96654711f8b",
                                "text": "Mystery, le fer de lance du métal mantais, viendra désemmieller vos cages à son avec une rage non feinte."
                            },
                            {
                                "example_id": "b94de379-2858-4318-a9a8-8052dcfcf512",
                                "sense_id": "ec48d746-9db5-31c6-ad16-c96654711f8b",
                                "text": "De toute façon, qui prête jamais un conduit auditif désemmiellé, qui est apte à l'écoute ? Pour lui, l'impression était nouvelle. Il n'était plus actant...."
                            }
                        ]
                    }
