                        "tr": [
                            {
                                "target_lang_word": "dizi",
                                "target_lang_sense_clarification": "matematiksel terim"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f916f510-6fa4-36aa-b6c3-dc38fe6c7794",
