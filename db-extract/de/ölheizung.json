                "senses": [
                    {
                        "sense_id": "eaedfa2d-1b1d-3c07-a873-fbe5de03cce4",
                        "entry_id": "dcaafb17-09d4-3a1a-a606-ff34ed085315",
                        "glosses": [
                            "Heizung, die mit Heizöl als Energieträger betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddd3a8cd-b8c8-442b-ac3d-98ccdc60759a",
                                "sense_id": "eaedfa2d-1b1d-3c07-a873-fbe5de03cce4",
                                "text": "Für eine Ölheizung benötigt man Platz für einen oder mehrere Öltanks."
                            },
                            {
                                "example_id": "5935f98f-945f-4550-8f3c-a2bf6496d3ab",
                                "sense_id": "eaedfa2d-1b1d-3c07-a873-fbe5de03cce4",
                                "text": "„Die Wände wurden neu eingezogen und isoliert, die Hütte bekam ein ordentliches Dach mit richtigen Dachziegeln, und auch eine Ölheizung ließ man Vater installieren.“"
                            },
                            {
                                "example_id": "d058c416-9dfc-4293-8cc1-e62ec1fe5205",
                                "sense_id": "eaedfa2d-1b1d-3c07-a873-fbe5de03cce4",
                                "text": "„Ölheizungen wurden fast völlig vom Markt verdrängt: Im Jahr 2000 war noch jeder fünfte Neubau mit einer Ölheizung ausgestattet, 2022 dann nur noch 0,4 Prozent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
