                "senses": [
                    {
                        "sense_id": "99adc51b-27c2-3e1f-a754-20a22020f610",
                        "entry_id": "12c644b2-0349-3c18-83a2-82c64f91c7d7",
                        "glosses": [
                            "истор. наследственный титул принадлежащих к высшей придворной знати испанских дворян, который давал право стоять перед королём с покрытой головой"
                        ],
                        "tags": [
                            "в средневековой Испании"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "13ce4b7c-21d3-3e7f-abc5-5a0b99ad6d40",
                        "entry_id": "12c644b2-0349-3c18-83a2-82c64f91c7d7",
                        "glosses": [
                            "истор. дворянский титул"
                        ],
                        "tags": [
                            "в Испании в 16–20 веков до 1931 года"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "65741054-a33e-3cc6-bac2-6615c8cf9121",
                        "entry_id": "12c644b2-0349-3c18-83a2-82c64f91c7d7",
                        "glosses": [
                            "истор. лицо, обладающее таким титулом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e68775eb-d95a-443f-a455-32e944541415",
                                "sense_id": "65741054-a33e-3cc6-bac2-6615c8cf9121",
                                "text": "Испанский гранд пожал у него руку, сенаторша Рыдвинова, смотревшая, прищурившись, в лорнет, ещё издали кивала ему головой."
                            }
                        ]
                    }
