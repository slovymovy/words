                    },
                    {
                        "form_id": "eb74e31a-dc35-40c9-a684-f1f56b059c1b",
                        "entry_id": "7cbcdf8e-7d1d-3b57-a303-342148ca609b",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "délirantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c2514c9-d7db-310d-96d2-cd2ca87c325e",
                        "entry_id": "7cbcdf8e-7d1d-3b57-a303-342148ca609b",
                        "glosses": [
                            "Qui présente les caractères du délire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4372b648-5320-43a3-96c6-b9b8e16750cb",
                                "sense_id": "9c2514c9-d7db-310d-96d2-cd2ca87c325e",
                                "text": "Les flagorneries dédicatoires des écrivains louis-quatorziens aplatis sur les marches du trône paraissent aujourd'hui si délirantes, que nous nous interrogeons sur leur sincérité, voire leur lucidité."
                            },
                            {
                                "example_id": "79678006-abeb-4aa1-b434-e2bdbe7858e6",
                                "sense_id": "9c2514c9-d7db-310d-96d2-cd2ca87c325e",
                                "text": "Un tapissier… Ce n’est pas la peine de s’imaginer des scénarios tordus délirants avec des gendarmes ultra-sexys faisant une haie d’honneur, me présentant un homme torse nu en salopette sur un escabeau avec son couteau à maroufler dans la main droite et une rose entre les dents."
                            },
                            {
                                "example_id": "8e312b43-4348-40bb-8903-dfdf056af9a1",
                                "sense_id": "9c2514c9-d7db-310d-96d2-cd2ca87c325e",
                                "text": "L’idéologie est un système délirant qui se partage, qui se partage tellement qu'il peut servir de base théorique à une réorganisation totalitaire de la société."
                            }
                        ]
                    },
                    {
                        "sense_id": "565a7f02-3ddb-3707-bf5e-54e86c451560",
                        "entry_id": "7cbcdf8e-7d1d-3b57-a303-342148ca609b",
                        "glosses": [
                            "Qui est en proie au délire."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ed063161-bb5e-46ff-9730-817c2eb62785",
                                "sense_id": "565a7f02-3ddb-3707-bf5e-54e86c451560",
                                "text": "Un malade délirant."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce2c666d-7d78-38b9-89bf-775a9d4f86eb",
                        "entry_id": "7cbcdf8e-7d1d-3b57-a303-342148ca609b",
                        "glosses": [
                            "Qui provoque une vive impression à l'esprit."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "9c8b538d-dba9-432c-aa21-223ac41342ab",
                                "sense_id": "ce2c666d-7d78-38b9-89bf-775a9d4f86eb",
                                "text": "Ainsi, défilèrent consécutivement les qualificatifs de dément, délirant, chouette, bath, et pas mal. On pouvait tout aussi bien dire d'une fille qu'elle était chouette et d'une capitale étrangère visitée à Pâques que c'était pas mal."
                            },
                            {
                                "example_id": "a10db0a5-7c37-416c-a82d-0f116879113a",
                                "sense_id": "ce2c666d-7d78-38b9-89bf-775a9d4f86eb",
                                "text": "On s’amuse beaucoup, malgré quelques longueurs, face à des personnages aussi délirants qu’un Russe capitaliste, un Américain communiste (Woody Harrelson, irrésistible) et un couple de vieux Anglais à la bonhomie trompeuse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "430fb06c-c2f8-4422-8feb-540a45264114",
                        "source_entry_id": "7cbcdf8e-7d1d-3b57-a303-342148ca609b",
                        "target_lang_word": "delirious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delirious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e87a83de-850f-3252-a92f-fcc924e76382",
                                        "entry_id": "eddab45b-9ffc-3fef-b005-2480d47b1501",
                                        "glosses": [
                                            "Being in the state of delirium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b5526e6-6494-480e-998d-fbe9ebca1f14",
                                                "sense_id": "e87a83de-850f-3252-a92f-fcc924e76382",
                                                "text": "⁠Or has the shock, so harshly given,\n[…] made me that delirious man\n⁠Whose fancy fuses old and new,\n⁠And flashes into false and true,\nAnd mingles all without a plan?"
                                            },
                                            {
                                                "example_id": "6e48336e-0779-4b73-9981-90421bc53f4f",
                                                "sense_id": "e87a83de-850f-3252-a92f-fcc924e76382",
                                                "text": "[…]the angelic form of a creature whose very existence was a gigantic balm of Gilead to the lacerated body of our hero, and, in a half delirious state of mind, he felt like leaping mountains to raise prostrate female forms, and to become blessed with hymeneal joys of the most glorious character; but, his imagination soon forsook him, and a raging fever, accompanied by the most violent deadly delirium, ensued, which lasted a fortnight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cc33396-9ba2-3432-8ea5-7300993d4734",
                                        "entry_id": "eddab45b-9ffc-3fef-b005-2480d47b1501",
                                        "glosses": [
                                            "Having uncontrolled excitement; ecstatic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
