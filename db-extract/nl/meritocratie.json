                                        "entry_id": "2ed16a65-95b7-3c0f-a691-8a9922e16c00",
                                        "glosses": [
                                            "Gobierno de aquellos que llegan al poder por sus méritos o talento, conocimientos técnicos y habilidades profesionales."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b4c765d-7c4a-4220-8ab5-85603cc8362a",
                                                "sense_id": "cb2f8525-2124-3be2-a777-df90934916bc",
                                                "text": "La meritocracia se implanta para superar una segregación vertical y horizontal que perjudica a las mujeres"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
