                                        "sense_id": "f9b01c26-eb4b-37a3-9441-6485090c7947",
                                        "entry_id": "210b0f69-7f32-3f78-9e49-1d55ed9acab2",
                                        "glosses": [
                                            "Having two heads; two-headed."
                                        ],
