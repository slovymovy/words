                "entry_id": "6c662afe-f939-3760-a14d-dc949f4007eb",
                "word": "expresbrief",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "e7d2f0f0-b353-4469-94f2-aa99ed219ad6",
