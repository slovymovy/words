                "senses": [
                    {
                        "sense_id": "d6891883-272f-394a-a00b-f390a7b7e9e0",
                        "entry_id": "30ca6989-883b-36bf-84e6-fb5df043c428",
                        "glosses": [
                            "Torturer, rompre sur la roue."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f36d442f-6c93-4e2a-98c3-2387798c4cdf",
                                "sense_id": "d6891883-272f-394a-a00b-f390a7b7e9e0",
                                "text": "Plusieurs nations estiment horrible et cruel de tourmenter et dérompre un homme, de la faute duquel vous êtes encore en doubte."
                            }
                        ]
                    },
                    {
                        "sense_id": "632a66d5-e800-3610-a756-d92bc2b0930f",
                        "entry_id": "30ca6989-883b-36bf-84e6-fb5df043c428",
                        "glosses": [
                            "Dérompre harnois : rompre l’armure d’un chevalier."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "09da3891-7e28-4975-afa8-53f4e4e791ae",
                                "sense_id": "632a66d5-e800-3610-a756-d92bc2b0930f",
                                "text": "Ils [Grammont et son ami Matta] valaient bien ces deux frères [Amadis et Galaor] ; car s’ils ne savaient pas autrement pourfendre géants, dérompre harnois et porter en croupe belles damoiselles sans leur parler de rien, ils savaient jouer, et les autres n’y connaissaient rien."
                            }
                        ]
                    },
                    {
                        "sense_id": "57beba5e-6c8a-3422-a348-f97e54871f24",
                        "entry_id": "30ca6989-883b-36bf-84e6-fb5df043c428",
                        "glosses": [
                            "Transformer (un pré, un champ) d’une culture en une autre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cd995fa3-54e2-397b-9ad3-acac6e3f1dd6",
                        "entry_id": "30ca6989-883b-36bf-84e6-fb5df043c428",
                        "glosses": [
                            "Se dit de l’action d’un oiseau de proie qui fond sur un autre et le précipite à terre par un coup violent."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "93374a8a-c91f-3dec-9f36-0b573e43a083",
                        "entry_id": "30ca6989-883b-36bf-84e6-fb5df043c428",
                        "glosses": [
                            "Couper les chiffons pourris en petits morceaux avant de les porter dans les piles à effilocher."
                        ],
                        "tags": [],
                        "examples": []
                    }
