                                    },
                                    {
                                        "sense_id": "ab4952bf-dda0-3d96-969a-f856dbbfaea8",
                                        "entry_id": "ebe21587-a860-31d7-a404-55c1a2cfc659",
                                        "glosses": [
                                            "A kind of wreath or strap of plaited cordage."
                                        ],
                                        "tags": [],
