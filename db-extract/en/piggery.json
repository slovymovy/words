                ],
                "senses": [
                    {
                        "sense_id": "527aa69b-fa5b-3c98-b7ff-50c3fe9b7abb",
                        "entry_id": "44d925e3-528c-35f4-9640-6d2bfeabc542",
                        "glosses": [
                            "A place, such as a farm, where pigs are kept or raised."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc2b8be8-41ae-481f-a0b1-5c25daf663a0",
                                "sense_id": "527aa69b-fa5b-3c98-b7ff-50c3fe9b7abb",
                                "text": "Two heavy pails of swill—meat scraps floating in custard—from the school kitchens to be carried with a friend, Hans Solish, all the way to the piggery."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa0d9fd3-ecae-3272-a31b-a24b80981006",
                        "entry_id": "44d925e3-528c-35f4-9640-6d2bfeabc542",
                        "glosses": [
                            "Piggish behaviour."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2786a05d-f032-4d5a-bf7c-d63cdf5bbf3d",
                        "source_entry_id": "44d925e3-528c-35f4-9640-6d2bfeabc542",
                        "source_sense_description": "A place where pigs are kept or raised",
                        "target_lang_word": "porcherie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porcherie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80fe6cbe-5c2e-31ea-8399-028a28acddbc",
                                        "entry_id": "8e155562-59ba-3ff0-ac4d-b571d57c2abe",
                                        "glosses": [
                                            "Lieu où on élève des porcs."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "498ccfc7-8313-4dc2-87d2-f11813dd3491",
                                                "sense_id": "80fe6cbe-5c2e-31ea-8399-028a28acddbc",
                                                "text": "Or, l’honnêteté m’oblige à dire que ces porcheries industrielles sont des lieux abominables, constituant une sorte d’enfer sur Terre pour les animaux qui s’y trouvent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39d4ca6d-bf54-3aa4-abdd-9bd6cd594484",
                                        "entry_id": "8e155562-59ba-3ff0-ac4d-b571d57c2abe",
                                        "glosses": [
                                            "Lieu très sale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2df92556-6182-41f4-8591-b04e018e23b4",
                                                "sense_id": "39d4ca6d-bf54-3aa4-abdd-9bd6cd594484",
                                                "text": "Sa chambre est une véritable porcherie."
                                            },
                                            {
                                                "example_id": "b84f4c80-728e-48dc-9cb1-06b5c5fa60e7",
                                                "sense_id": "39d4ca6d-bf54-3aa4-abdd-9bd6cd594484",
                                                "text": "Encore un peu de temps et ils se rendront à l’idée suivante que, non seulement les « petits gestes » n’aident pas trop la planète, mais au contraire aident à ce que la porcherie capitaliste continue de la détruire, comme toujours quand les diversions permettent d’oublier l’essentiel et que le secondaire laisse les coudées encore plus franches au principal : « pendant que ces imbéciles ont le nez dans leurs bacs, songeons tranquillement à nos prochains modèles de voitures encore plus remplies de circuits intégrés que les précédentes »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "061710fb-a018-460e-b845-4001a07c99d0",
                        "source_entry_id": "44d925e3-528c-35f4-9640-6d2bfeabc542",
                        "source_sense_description": "A place where pigs are kept or raised",
                        "target_lang_word": "Schweinestall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schweinestall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                        "entry_id": "1a2e12e2-39b4-3b17-a458-256ef0bd1e6a",
                                        "glosses": [
                                            "Stall, in dem Hausschweine gehalten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cdad035-2258-491d-a042-a1a14e5437e1",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "Morgen wird der Schweinestall ausgemistet."
                                            },
                                            {
                                                "example_id": "d007560b-ebe8-42fb-941b-805e7be335a0",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Die Dondorfer Zinkwanne im ausgedienten Schweinestall vor Augen, prustete ich los.“"
                                            },
                                            {
                                                "example_id": "5abb44c0-231c-4ce3-97f5-5a468848098d",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Ein paar Kuh- und Schweineställe bildeten das Ganze dieser Hinterwäldler-Siedlung.“"
                                            },
                                            {
                                                "example_id": "8b8e6511-8ae8-4260-b382-9929bde2a5f7",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Er war ein Mannsbild und in der Faktorei ein Mädchen für alles und durfte im Schweinestall schlafen.“"
                                            },
                                            {
                                                "example_id": "3fb20b0b-18e5-4111-8b03-230c72a060f4",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Bald wurde der Schweinestall zu eng.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ad271371-ca7f-3476-b818-68012d9fd713",
                                        "entry_id": "1a2e12e2-39b4-3b17-a458-256ef0bd1e6a",
                                        "glosses": [
                                            "unordentlicher, schmutziger Raum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6fe1252-dd75-4b32-a6ea-4776e2da22e3",
                                                "sense_id": "ad271371-ca7f-3476-b818-68012d9fd713",
                                                "text": "Wie kannst du in aller Ruhe in diesem Schweinestall sitzen und fernsehen?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
