                    ],
                    "common_phrases": [
                        "rozsiać ziarno",
                        "rozsiać nasiona"
                    ],
                    "target_lang_definitions": {
                        "ru": "разбросать семена на большой площади для выращивания растений"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассеять",
                                "target_lang_sense_clarification": "распределить семена по поверхности почвы"
                            },
                            {
                                "target_lang_word": "засеять",
                                "target_lang_sense_clarification": "засадить поле семенами"
