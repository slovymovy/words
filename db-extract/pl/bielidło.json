                    {
                        "sense_id": "5e62f04e-1f41-3f0d-a7c2-a7bf99105052",
                        "entry_id": "7a6a8ca1-a669-3af7-ab7b-e23e83535fb9",
                        "glosses": [
                            "Soda"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5764f3c6-5062-3360-90a1-1604b7023c8e",
                        "entry_id": "7a6a8ca1-a669-3af7-ab7b-e23e83535fb9",
                        "glosses": [
                            "weiße Schminke"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "9ff4423e-92f6-43be-8267-5b9dada8d545",
                                "sense_id": "5764f3c6-5062-3360-90a1-1604b7023c8e",
                                "text": "„Cera nie potrzebowała bielidła ani różu, była świeżości wiosennej, a krew to ją oblewała purpurą, to śnieżną zostawiała po sobie białość.“",
                                "translation": "Ihre Haut brauchte keine weiße Schminke noch Rouge, sie war von frühlingshafter Frische und das Blut übergoss sie bald mit Purpur, ließ bald eine schneeweiße Farbe hinter sich zurück."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16558f55-5a34-496d-852f-0fc13f3551d6",
                        "source_entry_id": "7a6a8ca1-a669-3af7-ab7b-e23e83535fb9",
                        "source_sense_id": "5e62f04e-1f41-3f0d-a7c2-a7bf99105052",
                        "source_sense_description": "veraltet: wasserfreies Natriumcarbonat, das zum Putzen, Waschen verwendet wird: Soda",
                        "target_lang_word": "Soda",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Soda",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62f3ef53-5c35-3820-bb5d-0d2cbc35f31a",
                                        "entry_id": "00c67caa-aed6-3171-8f83-0e5788e4871b",
                                        "glosses": [
                                            "ein Natriumsalz (Dekahydrat des Natriumcarbonats)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c148658b-11b5-4614-9260-659dd9bce27a",
                                                "sense_id": "62f3ef53-5c35-3820-bb5d-0d2cbc35f31a",
                                                "text": "Soda wird bei der Glasherstellung verwendet."
                                            },
                                            {
                                                "example_id": "74b48288-58de-4c38-bb60-2522c6f965d1",
                                                "sense_id": "62f3ef53-5c35-3820-bb5d-0d2cbc35f31a",
                                                "text": "„Die Forscher haben nun die hellste Stelle der Oberfläche untersucht, nämlich das innerer des 90 Kilometer grossen Occator-Kraters. Der überraschender Befund: Die Ablagerungen bestehen hauptsächlich aus Natriumkarbonat, im Volksmund auch Soda genannt.“"
                                            },
                                            {
                                                "example_id": "9dca79d2-744d-4fd3-a0fb-1ca1e9d0755c",
                                                "sense_id": "62f3ef53-5c35-3820-bb5d-0d2cbc35f31a",
                                                "text": "„Sowohl mit Kalk als auch mit Soda ließ sich das Fett verseifen, unter Zusatz von Kalk entstand allerdings nur unlösliche Kalkseife, während man mit Soda lösliche Haushaltsseife herstellen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2fe98773-f38a-3ea3-b122-13e355864649",
                                        "entry_id": "00c67caa-aed6-3171-8f83-0e5788e4871b",
                                        "glosses": [
                                            "kurz für Sodawasser, ein natron- und kohlensäurehaltiges (Mineral-)Wasser"
                                        ],
                                        "tags": [
                                            "nur n"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fff6f26-3a90-4865-a3f8-cda1853d46a6",
                                                "sense_id": "2fe98773-f38a-3ea3-b122-13e355864649",
                                                "text": "Einige Cocktails werden mit Soda gemischt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
