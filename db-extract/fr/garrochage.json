                    },
                    {
                        "sense_id": "34537d2a-cd9d-32bb-b37a-1506a89d7dcf",
                        "entry_id": "e5566483-3050-3411-826b-8cd7ed72952d",
                        "glosses": [
                            "Action de lancer ou de distribuer sans soin."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1787821b-d995-418b-96a4-8304cbbce93c",
                                "sense_id": "34537d2a-cd9d-32bb-b37a-1506a89d7dcf",
                                "text": "J'accuse la Ligue nationale d'avoir fait de cet excitant sport qu'est le hockey le symbole de ta violence, du garrochage de rondelle et de l’accrochage."
                            },
                            {
                                "example_id": "ce6f22a2-10f8-4b80-923a-5c7840917c34",
                                "sense_id": "34537d2a-cd9d-32bb-b37a-1506a89d7dcf",
                                "text": "Dès les premiers enregistrements, Albert, l’œil affolé, me parlera avant tout de «garrochage» de livres lors de mes vitrines de la fin. Je lui ferai promesse chaque fois : faire croire au public d'avoir lu attentivement la douzaine ou la quinzaine de livres posés en vrac sur ma table de coin."
                            },
                            {
                                "example_id": "45bebc6b-43c2-45f6-9cf7-fd13fb6c383f",
                                "sense_id": "34537d2a-cd9d-32bb-b37a-1506a89d7dcf",
                                "text": "Je ne parle pas du plan Paillé, qui est littéralement du garrochage de centaines de millions de dollars par les fenêtres sans aucune espèce de balise. Imaginez, mettre des 50 000 $ à la disposition de tout un chacun sans même exiger une cenne de mise de fond : il faut le faire !"
                            }
                        ]
                    }
