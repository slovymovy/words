                                "target_senses": [
                                    {
                                        "sense_id": "e9d645a2-de55-39c3-9f61-c060b7f3c206",
                                        "entry_id": "b9082697-dad4-3e97-8d4e-fc86630336f5",
                                        "glosses": [
                                            "Payment, such as property or money, paid by the bride's family to the groom or his family at the time of marriage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d9d370d-43b9-3333-b5b6-854c6ecdc241",
                                        "entry_id": "b9082697-dad4-3e97-8d4e-fc86630336f5",
                                        "glosses": [
                                            "Payment by the groom or his family to the bride's family."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b0c6b11-1160-43c7-b0aa-7d0eab74eb61",
                                                "sense_id": "1d9d370d-43b9-3333-b5b6-854c6ecdc241",
                                                "text": "The family of the groom makes sure the new couple has a house to live in and land to cultivate; they will also pay for the dowry (crucial, for without dowry the new father has no rights over his children; Trouwborst 1962: 136ff.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa91117f-fc07-37ec-a66a-6f5784f2185a",
                                        "entry_id": "b9082697-dad4-3e97-8d4e-fc86630336f5",
                                        "glosses": [
                                            "Inheritance from a deceased husband to his widow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e47c5f6c-a487-3912-951a-0f3ca3ea3f44",
                                        "entry_id": "b9082697-dad4-3e97-8d4e-fc86630336f5",
                                        "glosses": [
                                            "A natural gift or talent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97e4f50e-392f-3c3e-a7de-8e23411e2084",
                                        "entry_id": "b9082697-dad4-3e97-8d4e-fc86630336f5",
                                        "glosses": [
                                            "A large amount."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc0faf00-57bc-4693-b133-78245531240b",
                                                "sense_id": "97e4f50e-392f-3c3e-a7de-8e23411e2084",
                                                "text": "But no palace had so fair a ceiling; for from the wooden beams were suspended a whole dowry of copper vessels—pails, cauldrons, water pots, of every colour from lustrous black to the palest pink."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dowry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62db4bc0-5a52-3bd1-93b7-91fe724a5e8e",
                                        "entry_id": "ad62d414-5899-3644-a7af-6c3b5243b230",
