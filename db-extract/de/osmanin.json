                        "glosses": [
                            "weibliche Angehörige des Osmanischen Reiches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a81925f-0bab-4093-81ad-773b7ab4ee7b",
                                "sense_id": "f014b286-1e00-39b3-b782-8f189d4eb995",
