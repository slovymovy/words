                "senses": [
                    {
                        "sense_id": "71244bd1-36b7-306f-b89e-8cbc6f033d28",
                        "entry_id": "5d57bd24-1175-31f7-b2a4-c8282634ceee",
                        "glosses": [
                            "self-optimization"
