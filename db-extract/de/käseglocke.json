                    {
                        "sense_id": "24ef26ee-72da-303a-a553-95d86bd82230",
                        "entry_id": "8f18dbd5-6f6e-3434-8aa7-a483769f6c7d",
                        "glosses": [
                            "Geschirr, welches Käse und andere Lebensmittel abdeckt, um sie vor Ungeziefer und Gerüchen zu schützen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63c627d7-8171-4f28-8be5-4368353c7049",
                                "sense_id": "24ef26ee-72da-303a-a553-95d86bd82230",
                                "text": "Sie bewahrten ihren Harzer Käse in der Käseglocke auf, damit sich der Geruch nicht in der Wohnung verteilt."
                            },
                            {
                                "example_id": "7efa80cc-f99c-4815-83b1-ebf83db0dce8",
                                "sense_id": "24ef26ee-72da-303a-a553-95d86bd82230",
                                "text": "„Marlock stand neben einer Metallsäule, die eine gläserne Käseglocke trug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
