                "senses": [
                    {
                        "sense_id": "f24acfdb-90ea-342b-98ac-d2aedd551fe7",
                        "entry_id": "cc27e457-a694-3217-b89c-fad7e1100fc3",
                        "glosses": [
                            "koncepcja dążąca do uzgodnienia sprzeczności pomiędzy wiarą w dobro i wszechmoc bożą a istnieniem zła i nieszczęść na świecie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df822478-4400-4bd1-af2b-027c1b4d96df",
                                "sense_id": "f24acfdb-90ea-342b-98ac-d2aedd551fe7",
                                "text": "Teodyceę na gruncie chrześcijańskim rozwinął szeroko Augustyn"
                            },
                            {
                                "example_id": "ced4b6ca-949d-44d6-a5b1-4905ac447d64",
                                "sense_id": "f24acfdb-90ea-342b-98ac-d2aedd551fe7",
                                "text": "(…) za antynatalizmem przemawiają te same argumenty, które są stosowane w rozważaniach o teodycei. To nie jest najlepszy ze światów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d6f4b79-ba59-4e2e-957b-29b04e16f353",
                        "source_entry_id": "cc27e457-a694-3217-b89c-fad7e1100fc3",
                        "source_sense_id": "f24acfdb-90ea-342b-98ac-d2aedd551fe7",
                        "target_lang_word": "theodicy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theodicy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff99dba3-ea09-3366-9993-c2d40d70cf9e",
                                        "entry_id": "5a47e603-7b63-357a-963e-96ec7a7e0878",
                                        "glosses": [
                                            "A justification of a deity or of particular attributes of a deity; specifically, a justification of the existence of evil and suffering in the world; a work or discourse justifying the ways of God."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16f4b0e4-d903-4eb5-a1ff-f3a800e34857",
                                                "sense_id": "ff99dba3-ea09-3366-9993-c2d40d70cf9e",
                                                "text": "2000 [Kluwer Academic], Charles Seymour, A Theodicy of Hell, 2010, Springer, Softcover reprint, page 195,\nIn general, my theodicy of hell is more congenial to those denominations with less rigidly defined doctrinal systems.\nDoes this mean I have allowed theodicy to encroach on theology, contrary to my avowed purpose?"
                                            },
                                            {
                                                "example_id": "7280f0df-ffc2-4b4c-b47f-598a3ca0c0da",
                                                "sense_id": "ff99dba3-ea09-3366-9993-c2d40d70cf9e",
                                                "text": "Distilling the characteristic features of the theodicies of the world religions, Weber identified five varieties or forms that the answers to this problem take, which in his view speaks to the varieties of forms that religion itself takes: a messiah who initiates the end of the world as we know it, the transmigration of souls, a universal day of judgment, predestination, or dual divinities of good and evil."
                                            },
                                            {
                                                "example_id": "558c178a-b272-4a24-a865-d65aef63b706",
                                                "sense_id": "ff99dba3-ea09-3366-9993-c2d40d70cf9e",
                                                "text": "God was now nothing more than a distant cause of causes; what mattered was matter, and man acting in nature. The theodicy, the master-narrative, had become secularized."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f40cb97-babd-41c4-9906-8870e6632503",
                        "source_entry_id": "cc27e457-a694-3217-b89c-fad7e1100fc3",
                        "source_sense_id": "f24acfdb-90ea-342b-98ac-d2aedd551fe7",
                        "target_lang_word": "teodicea",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a59b0d20-ce35-42f0-9ec5-ef6313b21d26",
                        "source_entry_id": "cc27e457-a694-3217-b89c-fad7e1100fc3",
                        "source_sense_id": "f24acfdb-90ea-342b-98ac-d2aedd551fe7",
                        "target_lang_word": "théodicée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "théodicée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62c26c04-f533-3b91-be81-7c40c06a2dee",
                                        "entry_id": "d6eeeed4-c870-3ca3-bf7e-0aec09419f3a",
                                        "glosses": [
                                            "Tentative d’explication du mal qui existe dans le monde malgré la bonté de Dieu, de la nature, de la société, ou de l’homme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12bc7fc3-29df-4e5d-88ba-fa02a7c23ff7",
                                                "sense_id": "62c26c04-f533-3b91-be81-7c40c06a2dee",
                                                "text": "Retenez bien au moins que les théories du progrès sont inconciliables avec la vieille théodicée."
                                            },
                                            {
                                                "example_id": "3c274edf-9691-4c64-a514-c5cc0dbc0539",
                                                "sense_id": "62c26c04-f533-3b91-be81-7c40c06a2dee",
                                                "text": "C’est pourquoi le précepte, cependant vieux déjà : « Ne fais pas à autrui ce que tu ne voudrais pas qu’on te fît », loin de tomber en décrépitude, comme toutes les théodicées, par le progrès de l’esprit humain, n’a fait que gran­dir de siècle en siècle, et se dégage avec une irré­sistible énergie des décombres de la métaphysique religieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e752ab24-5641-35c5-93b4-cef22b2dccf0",
                                        "entry_id": "d6eeeed4-c870-3ca3-bf7e-0aec09419f3a",
                                        "glosses": [
                                            "Tentative de justification du bon-fonctionnement d'une situation ou d'une organisation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07029c7e-5de1-410e-bf39-13043c01c4f4",
                                                "sense_id": "e752ab24-5641-35c5-93b4-cef22b2dccf0",
                                                "text": "L’ombre de Marx, ou à tout le moins celle de Keynes, plane de nouveau comme un surmoi sur les théodicées libérales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5340fe27-93df-452d-acc5-f9175284bf98",
                        "source_entry_id": "cc27e457-a694-3217-b89c-fad7e1100fc3",
                        "source_sense_id": "f24acfdb-90ea-342b-98ac-d2aedd551fe7",
                        "target_lang_word": "teodicea",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teodicea",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "65b77ff6-8e5e-368e-aa8d-691fc46f59db",
                                        "entry_id": "4fbfc21d-a357-3d84-9ddb-5f1b4d45f6e6",
                                        "glosses": [
                                            "Rama de la filosofía que estudia, a la luz de la razón, todo lo relacionado con el Ser Supremo y lo que directamente se relaciona con ese centro de reflexión. Se diferencia de la Teología en que sólo usa la razón, mientras que la Teología actúa a la luz de una fe determinada, es decir de una adhesión suprarracional."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9d03dbc-9cd8-36a1-9ca3-57b67fa36db3",
                                        "entry_id": "4fbfc21d-a357-3d84-9ddb-5f1b4d45f6e6",
                                        "glosses": [
                                            "Término usado por el filósofo alemán Gottfried Wilhelm Leibniz, en 1697, dio forma para intentar justificar a Dios ante la desgracia y el mal existentes en el mundo a pesar de su omnipotencia y bondad."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4560625f-8553-4959-87f6-67d2fd1ba4fd",
                        "source_entry_id": "cc27e457-a694-3217-b89c-fad7e1100fc3",
                        "source_sense_id": "f24acfdb-90ea-342b-98ac-d2aedd551fe7",
                        "target_lang_word": "Theodizee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theodizee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "702912ad-b55d-3a7c-84d1-d1db25706a75",
                                        "entry_id": "9ecab854-a9e4-30a1-9af8-b9aa718b8ab3",
                                        "glosses": [
                                            "der Versuch einer Rechtfertigung eines allmächtigen, allgütigen und allwissenden Gottes angesichts allen Übels und Leidens in der Welt"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b489241c-a363-433a-98f9-f6efc5468ef1",
                                                "sense_id": "702912ad-b55d-3a7c-84d1-d1db25706a75",
                                                "text": "„Der Ausgang dieſes Rechtehandels vor dem Gerichtshofe der Philoſophie iﬅ nun: daß alle bisherige Theodicee das nicht leiﬅe was ſie verſpricht, nehmlich die moraliſche Weisheit in der Weltregierung gegen die Zweifel, die dagegen aus dem was die Erfahrung an dieſer Welt zu erkennen giebt, gemacht werden, zu rechtfertigen; obgleich freilich dieſe Zweifel als Einwürfe, ſo weit unſre Einſicht in die Beſchaffenheit unſrer Vernunft in Anſehnung der letztern reicht, auch das Gegentheil nicht beweiſen können.“"
                                            },
                                            {
                                                "example_id": "b212408e-5d1b-4076-b5e4-010f79312287",
                                                "sense_id": "702912ad-b55d-3a7c-84d1-d1db25706a75",
                                                "text": "Einige Rabbiner argumentieren nicht rein religiös, wenn es um die sogenannte Theodizee-Frage geht, um die Frage nach Gottes Rolle bei all dem Übel in der Welt."
                                            },
                                            {
                                                "example_id": "d454167c-67b2-4355-9eb5-5d104bda3ce4",
                                                "sense_id": "702912ad-b55d-3a7c-84d1-d1db25706a75",
                                                "text": "„Der geschichtliche Umstand, daß Theodizeen […] überaus verbreitet waren, sowie die sachliche, existentiell zentrale Dichte, zu der sich im Theodizeeproblem im engeren Sinne die Fragen nach Gott, Mensch und Welt zusammenfassen, mögen dazu beigetragen haben, daß das Wort Theodizee in einer nicht zu fördernden Bedeutungsausweitung zur Bezeichnung des Gesamtbestandes der Probleme und Resultate der philosophischen Erkenntnis Gottes gebraucht wurde […].“"
                                            },
                                            {
                                                "example_id": "0573cd43-c1e5-4b68-9750-9c463740ad5d",
                                                "sense_id": "702912ad-b55d-3a7c-84d1-d1db25706a75",
                                                "text": "„Von seinen frühesten philosophischen Entwürfen an bemüht sich Leibniz, das dem Monotheismus und der natürlichen Religion eigentümliche … Problem der Vereinbarkeit der göttlichen Attribute Macht, Güte und Gerechtigkeit mit den Übeln und Zweckwidrigkeiten dieser Welt zu lösen. So schreibt Leibniz rückblickend: «Ich hatte mir einstmals vorgenommen eine Theodizee zu schreiben und darinnen Gottes Gütigkeit, Weisheit und Gerechtigkeit […] zu vindicieren»“"
                                            },
                                            {
                                                "example_id": "2d8b4660-e4b8-41f4-b6c5-9399786420aa",
                                                "sense_id": "702912ad-b55d-3a7c-84d1-d1db25706a75",
                                                "text": "„Zur Debatte stand die Theodizee, das Problem der Rechtfertigung eines allmächtigen, allwissenden und gütigen Gottes angesichts der Existenz des Leidens und des Bösen in einer offensichtlich unvollkommenen Welt.“"
                                            },
                                            {
                                                "example_id": "bbb003ed-b3c7-4814-b68e-f5379389ecaa",
                                                "sense_id": "702912ad-b55d-3a7c-84d1-d1db25706a75",
                                                "text": "„Gott zum Tribunal der Menschen vorzuladen, nicht um ihn zu verteidigen, sondern um ihn mit seinen nicht gehaltenen Versprechen, mit dem lächerlich gewordenen Bund zwischen ihm und den Menschen zu konfrontieren, damit er sich für sein Schweigen inmitten des Schreckens rechtfertige: Das ist die in ihr tragisches Gegenteil verkehrte Theodizee. Jegliche Theodizee ist ein unterfangen, die göttlichen Attribute von Gerechtigkeit, Güte und Allmacht im Angesicht des Problems des Bösen zu retten.[…]Die Theodizee ist also ganz grundsätzlich als Entlastung und Reinwaschung Gottes zu verstehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "460db5c2-2efc-4005-979a-a37659fc7dbc",
                        "source_entry_id": "cc27e457-a694-3217-b89c-fad7e1100fc3",
                        "source_sense_id": "f24acfdb-90ea-342b-98ac-d2aedd551fe7",
                        "target_lang_word": "теодицея",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "теодицея",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e09195e5-ee60-329d-af6b-9b6ad303327d",
                                        "entry_id": "fa43e1e9-1c46-3b48-8c68-db6f2e31a8d7",
                                        "glosses": [
                                            "совокупность религиозно-философских доктрин, призванных оправдать управление Вселенной добрым Божеством, несмотря на наличие зла в мире"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cde0a9e-71e9-41c0-a2b1-d649e6a3b2c7",
                                                "sense_id": "e09195e5-ee60-329d-af6b-9b6ad303327d",
                                                "text": "Есть в этих архивах формально-логическое доказательство невозможности Теодицеи, основанной на доводах разума, поскольку в основе любой Теодицеи лежит логическое противоречие..."
