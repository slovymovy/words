{
    "word_family": [
        "talented",
        "talentless",
        "untalented"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f893a97-b560-3e92-865a-8a5690f6ab83",
                    "sense_definition": "A marked natural ability or skill.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a real <w>talent</w> for drawing.",
                            "target_lang_translations": {
                                "ru": "У него настоящий <w>талант</w> к рисованию.",
                                "zh": "他在绘画方面确实很有<w>天赋</w>。"
                            }
                        },
                        {
                            "text": "She discovered a hidden <w>talent</w> for singing at a young age.",
                            "target_lang_translations": {
                                "ru": "Она обнаружила скрытый <w>талант</w> к пению в юном возрасте.",
                                "zh": "她很小的时候就发现了自己唱歌的<w>天赋</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "endowment",
                        "gift",
                        "ability"
                    ],
                    "common_phrases": [
                        "natural talent",
                        "talent for",
                        "hidden talent",
                        "talent show"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдающиеся природные способности или навыки.",
                        "zh": "显著的自然能力或技能。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "талант",
                                "target_lang_sense_clarification": "выдающиеся способности"
                            },
                            {
                                "target_lang_word": "дар",
                                "target_lang_sense_clarification": "природное дарование"
                            },
                            {
                                "target_lang_word": "одарённость",
                                "target_lang_sense_clarification": "свойство личности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天赋",
                                "target_lang_sense_clarification": "天生的才能"
                            },
                            {
                                "target_lang_word": "才能",
                                "target_lang_sense_clarification": "表现出来的能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caf3832f-bd60-3e6b-90e5-3e7732349ff1",
                    "sense_definition": "People of talent, viewed collectively; a talented person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director searched their <w>talent</w> pool to fill the new opening.",
                            "target_lang_translations": {
                                "ru": "Режиссёр искал <w>таланты</w> в своей базе, чтобы закрыть вакансию.",
                                "zh": "导演在他们的<w>人才</w>库中寻找合适的人选来填补空缺。"
                            }
                        },
                        {
                            "text": "The agency is looking for fresh <w>talent</w> to star in the movie.",
                            "target_lang_translations": {
                                "ru": "Агентство ищет новые <w>таланты</w> для съёмок в фильме.",
                                "zh": "这家经纪公司正在寻找新晋<w>人才</w>来担任电影主角。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "talent scout",
                        "talent agency",
                        "local talent",
                        "top talent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Талантливые люди в совокупности; талантливый человек.",
                        "zh": "被视为人才的人，或指代人才群体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "талант",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "дарование",
                                "target_lang_sense_clarification": "о человеке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人才",
                                "target_lang_sense_clarification": "有才能的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1fad48a-46eb-3198-b656-a996073fba80",
                    "sense_definition": "The men or women of a place or area, judged by their attractiveness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Not much <w>talent</w> in this bar tonight, so let's go somewhere else.",
                            "target_lang_translations": {
                                "ru": "В этом баре сегодня мало <w>красоток</w>, так что пойдём в другое место.",
                                "zh": "今晚这家酒吧没什么<w>帅哥美女</w>，我们换个地方吧。"
                            }
                        },
                        {
                            "text": "He went to the club to check out the local <w>talent</w>.",
                            "target_lang_translations": {
                                "ru": "Он пошёл в клуб, чтобы заценить местных <w>красоток</w>.",
                                "zh": "他去俱乐部是为了看看当地的<w>帅哥美女</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "local talent"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "referring to attractive people"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчины или женщины, оцениваемые по их внешней привлекательности.",
                        "zh": "指代某地外表有吸引力的人（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красотки",
                                "target_lang_sense_clarification": "разг.: привлекательные люди (девушки/парни) места"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帅哥美女",
                                "target_lang_sense_clarification": "指代外貌出众的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0109efae-655f-3281-a412-fb2f93abfb8e",
                    "sense_definition": "A unit of weight and money used in ancient times in Greece, the Roman Empire, and the Middle East.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king paid a tribute of one hundred <w>talents</w> of silver.",
                            "target_lang_translations": {
                                "ru": "Царь выплатил дань в сто <w>талантов</w> серебра.",
                                "zh": "国王进贡了一百<w>塔兰特</w>白银。"
                            }
                        },
                        {
                            "text": "In ancient times, a <w>talent</w> was a significant amount of money.",
                            "target_lang_translations": {
                                "ru": "В древние времена <w>талант</w> был значительной суммой денег.",
                                "zh": "在古代，一个<w>塔兰特</w>是一笔巨款。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица веса и денежная единица, использовавшаяся в древности в Греции, Римской империи и на Ближнем Востоке.",
                        "zh": "古代希腊、罗马及中东地区使用的重量和货币单位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "талант",
                                "target_lang_sense_clarification": "историческая единица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塔兰特",
                                "target_lang_sense_clarification": "古代货币或重量单位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "417af6cf-bbfd-3cf9-ac91-0a90890e22b3",
                    "sense_definition": "A city in Jackson County, Oregon, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We drove through <w>Talent</w> on our way to the coast.",
                            "target_lang_translations": {
                                "ru": "Мы проехали через <w>Талент</w> по пути к побережью.",
                                "zh": "我们在去海岸的路上开车经过了<w>塔伦特</w>。"
                            }
                        },
                        {
                            "text": "The town of <w>Talent</w> is located in Oregon.",
                            "target_lang_translations": {
                                "ru": "Город <w>Талент</w> находится в Орегоне.",
                                "zh": "<w>塔伦特</w>镇位于俄勒冈州。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в округе Джексон, штат Орегон, США.",
                        "zh": "美国俄勒冈州杰克逊县的一个城市。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Талент",
                                "target_lang_sense_clarification": "город"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塔伦特",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}