                ],
                "senses": [
                    {
                        "sense_id": "c1a99227-aac3-36dc-8886-cef285d8b799",
                        "entry_id": "d8422eff-66bb-3fb8-81ee-a2aa1127bb20",
                        "glosses": [
                            "Utiliser la fonction qui permet de reporter la sonnerie d’un réveil pour se rendormir un court moment."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "c7421270-3d5e-4b58-ac23-a5dd2a8e14a2",
                                "sense_id": "c1a99227-aac3-36dc-8886-cef285d8b799",
                                "text": "J’ai même rencontré quelqu’un qui m’expliquait mettre son réveil plus tôt pour pouvoir snoozer deux fois plus !"
                            },
                            {
                                "example_id": "f0f8cb5c-d796-4364-9025-2dec940fd1ed",
                                "sense_id": "c1a99227-aac3-36dc-8886-cef285d8b799",
                                "text": "Snoozer, c'est quand on appuie sur son téléphone portable pour reporter la sonnerie à plus tard."
                            }
                        ]
                    },
                    {
                        "sense_id": "5dcbe9fe-7b68-36ba-ab6b-d734903e033a",
                        "entry_id": "d8422eff-66bb-3fb8-81ee-a2aa1127bb20",
                        "glosses": [
                            "Ne pas se mettre au travail, procrastiner."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "bfa0b39e-a237-471d-ac7a-02f76f772b1d",
                                "sense_id": "5dcbe9fe-7b68-36ba-ab6b-d734903e033a",
                                "text": "Snoozer, c’est continuer à roupiller ou reporter au lendemain ce que l’on peut faire le jour même."
                            },
                            {
                                "example_id": "c91af227-6281-4b3c-9e6c-6fdfe7673a49",
                                "sense_id": "5dcbe9fe-7b68-36ba-ab6b-d734903e033a",
                                "text": "[…] j’ai persévéré dans ces siestes où je snoozais sans fin, et ça te rendait ouf, comme si mon temps de sommeil était à ton débit […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "df4dd00a-a951-3ac5-b0d9-05fbc2198f0c",
                        "entry_id": "d8422eff-66bb-3fb8-81ee-a2aa1127bb20",
                        "glosses": [
                            "Reporter à plus tard."
                        ],
                        "tags": [
                            "familiar",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "160f0d38-457f-4a7f-ae04-821e1726b288",
                                "sense_id": "df4dd00a-a951-3ac5-b0d9-05fbc2198f0c",
                                "text": "Repousser son alarme, snoozer son réveil, utiliser la fonction rappel de son téléphone... Ces pratiques quotidiennes sont néfastes pour le sommeil et la santé."
                            },
                            {
                                "example_id": "6dcd9453-3f88-48ea-a5e6-c6b13cd622dd",
                                "sense_id": "df4dd00a-a951-3ac5-b0d9-05fbc2198f0c",
                                "text": "Qu’il était temps que je pense à « décorer ma vie de bébés ». Que je ne pourrais bientôt plus snoozer mon horloge biologique."
                            },
                            {
                                "example_id": "43d4a277-c6b4-4b63-841d-0d6d441ade41",
                                "sense_id": "df4dd00a-a951-3ac5-b0d9-05fbc2198f0c",
                                "text": "Les notifications adoptent un design plus moderne, plus simple et plus fonctionnel, avec la possibilité de les « snoozer » plus rapidement ou encore de les désactiver en les faisant glisser."
                            }
                        ]
                    }
                ],
