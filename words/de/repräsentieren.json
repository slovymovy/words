    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "15b07257-430e-3d6e-8336-1fedb863feb0",
                    "sense_definition": "eine Person, eine Gruppe, eine Institution oder ein Land offiziell nach außen hin vertreten",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "vertreten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Botschafter wird unser Land bei den Verhandlungen <w>repräsentieren</w>."
                        },
                        {
                            "text": "Als gewählte Sprecherin <w>repräsentiert</w> sie die Interessen aller Kollegen im Betriebsrat."
                        }
                    ],
                    "synonyms": [
                        "vertreten"
                    ],
                    "common_phrases": [
                        "ein Land repräsentieren",
                        "ein Unternehmen repräsentieren"
                    ]
                },
                {
                    "sense_id": "340cd9c0-7d21-3457-af5d-3b66cbc7d2b5",
                    "sense_definition": "einen bestimmten Wert, eine Bedeutung oder einen Anteil verkörpern oder darstellen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "darstellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Diese seltenen Gemälde <w>repräsentieren</w> einen unschätzbaren kulturellen Wert für das Museum."
                        },
                        {
                            "text": "Die Ergebnisse der Studie <w>repräsentieren</w> den aktuellen Stand der wissenschaftlichen Forschung."
                        }
                    ],
                    "synonyms": [
                        "darstellen",
                        "verkörpern"
                    ],
                    "common_phrases": [
                        "einen hohen Wert repräsentieren"
                    ]
                },
                {
                    "sense_id": "106eb009-5d34-3e7c-a618-ab5f85768e19",
                    "sense_definition": "durch würdevolles, repräsentatives Auftreten oder gesellschaftlichen Aufwand einer bestimmten Stellung gerecht werden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "auftreten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zu den Pflichten des Vorstands gehört es vor allem, bei feierlichen Abendveranstaltungen zu <w>repräsentieren</w>."
                        },
                        {
                            "text": "Das Personal am Empfang ist darin geschult worden, das Haus stets stilvoll zu <w>repräsentieren</w>."
                        }
                    ]
                }
            ]
        }
    ]
