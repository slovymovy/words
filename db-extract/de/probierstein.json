                "senses": [
                    {
                        "sense_id": "9b5b47dd-3ed0-36af-93ac-e489b6469bf2",
                        "entry_id": "c28b515d-aa2c-3402-8afd-500e9c647675",
                        "glosses": [
                            "spezieller Stein, zum Prüfen einer mutmaßlichen Edelmetalllegierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d18e0b51-ed16-4850-9e57-52b4c64a861d",
                                "sense_id": "9b5b47dd-3ed0-36af-93ac-e489b6469bf2",
                                "text": "Als der Juwelier ihren Ehering über den Probierstein rieb, um dessen Wert festzulegen, erinnerte sie sich an den Moment, da ihr Mann ihr den Ring erstmals überstreifte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db3ed0d1-a108-4905-9f7a-88108151cb31",
                        "source_entry_id": "c28b515d-aa2c-3402-8afd-500e9c647675",
                        "source_sense_id": "9b5b47dd-3ed0-36af-93ac-e489b6469bf2",
                        "source_sense_description": "spezieller Stein, zum Prüfen einer mutmaßlichen Edelmetalllegierung",
                        "target_lang_word": "touchstone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "touchstone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be5f5094-2b64-31b1-8995-cce04c3d98d4",
                                        "entry_id": "6ea11009-3382-3a87-9cf6-c078ef5da581",
                                        "glosses": [
                                            "A stone used to verify the quality of gold alloys by rubbing them in order to leave a visible trace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8aa1cd67-d1bd-3a4f-910c-093732f96b9e",
                                        "entry_id": "6ea11009-3382-3a87-9cf6-c078ef5da581",
                                        "glosses": [
                                            "A standard of comparison or evaluation."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c27ab2ec-15be-4fc9-a295-f27a73870955",
                                                "sense_id": "8aa1cd67-d1bd-3a4f-910c-093732f96b9e",
                                                "text": "The foregoing doctrine affords us also a touchstone for the trial of spirits."
                                            },
                                            {
                                                "example_id": "c9bffb0a-0937-41ef-b1de-678e4bf88d23",
                                                "sense_id": "8aa1cd67-d1bd-3a4f-910c-093732f96b9e",
                                                "text": "\"Expectation of life\" is an elastic term: the touchstone here is rather the aggregate amount of work that the locomotive does during its working life."
                                            },
                                            {
                                                "example_id": "d648cb87-1c88-4afe-bd1b-78e47ddd52ac",
                                                "sense_id": "8aa1cd67-d1bd-3a4f-910c-093732f96b9e",
                                                "text": "Although there has not been very much direct treatment of the Holocaust in analytic moral philosophy, the Nazis appear again and again as examples or touchstones in the construction of moral theories."
                                            },
                                            {
                                                "example_id": "68d1fbc8-ea62-4453-85c3-40ed39a7438b",
                                                "sense_id": "8aa1cd67-d1bd-3a4f-910c-093732f96b9e",
                                                "text": "In the print firestorm that followed the publication of the royal couple's letters, the generalissima was one polemical touchstone. The Annotations to The Kings Cabinet Opened itself depicted the queen as an enemy to king and country: […]"
                                            },
                                            {
                                                "example_id": "6eb3dc36-8c07-419e-be6b-539ad806d295",
                                                "sense_id": "8aa1cd67-d1bd-3a4f-910c-093732f96b9e",
                                                "text": "Brokeback Mountain did take home three Oscars, including a prestigious best director prize for Ang Lee, and remains a beloved gay touchstone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "114c2f29-cef3-4d66-9ea9-12b95fb7db8a",
                        "source_entry_id": "c28b515d-aa2c-3402-8afd-500e9c647675",
                        "source_sense_id": "9b5b47dd-3ed0-36af-93ac-e489b6469bf2",
                        "source_sense_description": "spezieller Stein, zum Prüfen einer mutmaßlichen Edelmetalllegierung",
                        "target_lang_word": "touchau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "touchau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d5e4e5e-dc7c-3533-a685-5f4467ed5b68",
                                        "entry_id": "efac187b-8f6c-3645-b6cd-dfadcdef0f02",
                                        "glosses": [
                                            "Petites plaques d'alliage d'or ou d'argent, chacune d'un titre différent, disposées en étoile, qui permet de déterminer, par comparaison de l'empreinte laissée sur la pierre de touche, le titre d'un bijou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b0a9c0d-4ec9-4049-8c09-edd514e2a06c",
                                                "sense_id": "2d5e4e5e-dc7c-3533-a685-5f4467ed5b68",
                                                "text": "Quant au touchau, il est appliqué d'une manière générale sur les minuscules accessoires d'orfèvrerie."
                                            },
                                            {
                                                "example_id": "5210d8b4-5c1f-4457-9a1a-a335520b0dac",
                                                "sense_id": "2d5e4e5e-dc7c-3533-a685-5f4467ed5b68",
                                                "text": "Et les exemples sont légion. Du grand écrivain scrupuleux au pion morose, du grammairien puriste au discoureur mondain, on se passe l’épais touchau qui marque et rejette les métaux impurs. À ce degré de confiance, il n’est plus d’auteur ni d’ouvrage ; nous sommes en présence d’un objet de culte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
