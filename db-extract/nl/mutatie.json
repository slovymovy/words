                                    },
                                    {
                                        "sense_id": "dc21595b-3fbf-3890-a8f1-2cb16585903e",
                                        "entry_id": "43335c2f-a916-3f0f-8534-0e805f4d0ec3",
                                        "glosses": [
                                            "A group of thrushes."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "noun",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf4d0075-8667-478f-a3c0-c34fd7acf20c",
                                                "sense_id": "dc21595b-3fbf-3890-a8f1-2cb16585903e",
                                                "text": "Birdwatchers would enjoy a host of sparrows, a herd of swans, a descent of woodpeckers, a herd of wrens, and mutation of thrushes."
                                            },
                                            {
                                                "example_id": "4fe4be53-982f-4f50-8be6-19213edd112a",
                                                "sense_id": "dc21595b-3fbf-3890-a8f1-2cb16585903e",
                                                "text": "Names for a group: A flute or mutation of thrushes."
                                            },
                                            {
                                                "example_id": "635d8ce0-0fe7-4bb2-8acf-741aef4f8c37",
                                                "sense_id": "dc21595b-3fbf-3890-a8f1-2cb16585903e",
                                                "text": "A Mutation of Thrushes\nThe authors of the books of venery were not predicting Darwin with this term, but taking a cue from a common fable of the time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
