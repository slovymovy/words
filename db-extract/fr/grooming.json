                "senses": [
                    {
                        "sense_id": "7df0e4a8-078c-3fde-93be-f2ac61ff7443",
                        "entry_id": "f48058ec-1296-3d50-8fbd-50981eec9630",
                        "glosses": [
                            "Toilettage."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "b6756fda-cd38-4739-81b2-e6839d6eea10",
                                "sense_id": "7df0e4a8-078c-3fde-93be-f2ac61ff7443",
                                "text": "Mais les grands singes sont surtout des as en matière de prévention des conflits, grâce à la pratique de l’épouillage ou « grooming »."
                            },
                            {
                                "example_id": "481ec440-7829-49f6-a5e5-35191bf9a9e1",
                                "sense_id": "7df0e4a8-078c-3fde-93be-f2ac61ff7443",
                                "text": "Les singes passent beaucoup de temps en grooming, autrement dit en séances de toilettage ou d’épouillage mutuel."
                            }
                        ]
                    },
                    {
                        "sense_id": "90754e95-3e5d-37d4-9e3a-2cb3cfd08476",
                        "entry_id": "f48058ec-1296-3d50-8fbd-50981eec9630",
                        "glosses": [
                            "Prise de contact par un adulte, aux intérêts sexuels déviants, avec un mineur via Internet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e006787-e60e-463d-9f8f-f9ebdd4fd505",
                                "sense_id": "90754e95-3e5d-37d4-9e3a-2cb3cfd08476",
                                "text": "L’étude universitaire a permis d’établir de véritables relations « auteur-victime » dans le grooming et de proposer des techniques de prévention."
                            },
                            {
                                "example_id": "2fbed7e1-6578-49bf-b319-366a5d08d507",
                                "sense_id": "90754e95-3e5d-37d4-9e3a-2cb3cfd08476",
                                "text": "Par exemple, le grooming, qui consiste, pour un adulte, à se faire passer pour un enfant pour solliciter une demande sexuelle, devrait faire partie de cette réglementation."
                            }
                        ]
                    }
