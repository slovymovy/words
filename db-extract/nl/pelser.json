                        "entry_id": "f7ee7ccc-3c53-33aa-bc3b-54bd3a667788",
                        "glosses": [
                            "benaming voor de Europese sardine Sardina pilchardus, gebruikt voor de volgroeide exemplaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eadfb43-fe2a-431f-b4b8-bd5be3b1b668",
                                "sense_id": "77285782-75a6-3a85-9b69-1165cdd08736",
                                "text": "De sardijn of pelser heeft de grootte van een kleine haring en wordt veel gevangen langs de kusten van den Atlantischen Oceaan van af de Z.W. punt van Engeland tot de N.W. punt van Spanje."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2e24a3f-f1bc-3522-8ebe-961acad01790",
                        "entry_id": "f7ee7ccc-3c53-33aa-bc3b-54bd3a667788",
                        "glosses": [
                            "iemand die van bont kleren maakt"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "991a7298-e307-4750-8c53-87114bead023",
                                "sense_id": "c2e24a3f-f1bc-3522-8ebe-961acad01790",
                                "text": "In 1615 werd bepaald dat vleeshouwers schape- en geitehuiden eerst aan de pelsers moesten aanbieden, en als zij deze niet tegen marktconforme prijzen wilden kopen, dan pas mochten ze deze aan handelaren van buiten de stad verkopen."
                            }
                        ]
                    }
