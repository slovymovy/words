                                        "entry_id": "39e66fb9-2a88-3fb6-8c58-3a7efdc64a41",
                                        "glosses": [
                                            "aus Tierhaaren gewonnenes Produkt für die Herstellung von Garn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34a88ccd-bdea-4ae0-90f3-2b5757774950",
                                                "sense_id": "5efbb342-a2df-3eac-9e21-1d5c80ab8697",
                                                "text": "Die Wolle wird zu Garn gesponnen."
                                            },
                                            {
                                                "example_id": "54d52564-6462-4bf4-af7a-f569daff9737",
                                                "sense_id": "5efbb342-a2df-3eac-9e21-1d5c80ab8697",
                                                "text": "„Mufflonwolle besaßen sie, aber keinerlei Gerät, um die Wolle zu spinnen und zu weben.“"
                                            },
                                            {
                                                "example_id": "fc4b97c4-4d2a-4d5a-a0ec-fe5a6fe4efa2",
                                                "sense_id": "5efbb342-a2df-3eac-9e21-1d5c80ab8697",
                                                "text": "„Die Wolle war eine Mischung aus Alpaka und Seide, glatt und weich, wie Daunen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e9fb9eb-234c-3747-a92c-14802abe9ce2",
                                        "entry_id": "39e66fb9-2a88-3fb6-8c58-3a7efdc64a41",
                                        "glosses": [
                                            "aus Wolle^([1]) bestehendes Garn"
                                        ],
                                        "tags": [],
                                        "examples": [
