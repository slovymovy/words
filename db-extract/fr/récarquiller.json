                        "sense_id": "209cbbcc-2bef-35d9-8788-1a02eff9a099",
                        "entry_id": "87de4a6e-4eff-3666-82a0-a4220e474e15",
                        "glosses": [
                            "Écarquiller à nouveau."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c7236ebf-ad63-47a5-bd48-d0131346e405",
                                "sense_id": "209cbbcc-2bef-35d9-8788-1a02eff9a099",
                                "text": "Ce contact étonna grandement la jeune fille qui récarquilla les yeux."
                            },
                            {
                                "example_id": "d22196e4-6b31-43f7-8342-71f838856411",
                                "sense_id": "209cbbcc-2bef-35d9-8788-1a02eff9a099",
                                "text": "Il écarquilla les yeux. Il récarquilla de yeux. (sic)"
                            },
                            {
                                "example_id": "10e8c5af-24f7-41ef-9866-6734359aa3b3",
                                "sense_id": "209cbbcc-2bef-35d9-8788-1a02eff9a099",
                                "text": "Deux jambes plus longues qu’un jour sans pain, comme disait mon grand_père qui n’avait jamais connu le Lido ni le Crazy Horse Saloon, se positionnent en chevalet à l’aplomb de mes yeux récarquillant."
                            }
                        ]
                    }
