                    "frequency": "High",
                    "semantic_group_id": "Umsetzung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>Ausführung</w> der geplanten Bauarbeiten verzögerte sich leider um mehrere Wochen."
                        },
                        {
                            "text": "Der Vorstand wollte den neuen Plan so schnell wie möglich zur <w>Ausführung</w> bringen."
                        }
                    ],
                    "synonyms": [
                        "Durchführung",
                        "Umsetzung"
                    ],
                    "common_phrases": [
