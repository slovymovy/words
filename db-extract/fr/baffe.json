        "fr-extract.jsonl": [
            {
                "entry_id": "ce33710d-1cf8-32a3-94b9-508a9c98caa4",
                "word": "baffe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "315a4e24-6199-4521-8eea-3569016c616c",
                        "entry_id": "ce33710d-1cf8-32a3-94b9-508a9c98caa4",
                        "tags": [
                            "plural"
                        ],
                        "form": "baffes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ca173db-26cb-3e57-8cff-b4070573b8a3",
                        "entry_id": "ce33710d-1cf8-32a3-94b9-508a9c98caa4",
                        "glosses": [
                            "Gifle."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3fe75221-56ca-4bed-acf7-c85038058bb0",
                                "sense_id": "8ca173db-26cb-3e57-8cff-b4070573b8a3",
                                "text": "Ça commençait par de grandes baffes gentilles sur la gueule du chiot qui faisait ce qu’il pouvait pour mordre. Alors ça se terminait par deux ou trois coups de pied bien sentis dans le ventre de l’animal."
                            },
                            {
                                "example_id": "64549215-b58f-4446-96b8-fb1fcf528042",
                                "sense_id": "8ca173db-26cb-3e57-8cff-b4070573b8a3",
                                "text": "Alors quoi : parler, cultiver la délicatesse, aimer l’autre ? Oui. À condition d’endurer les baffes ? Nous allons d’échec en échec."
                            }
                        ]
                    },
                    {
                        "sense_id": "337d6757-dd0f-3928-8506-80c6cb2737af",
                        "entry_id": "ce33710d-1cf8-32a3-94b9-508a9c98caa4",
                        "glosses": [
                            "Coup du sort."
                        ],
                        "tags": [
                            "colloquial",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8fb2e5ee-9472-450f-8009-af196c496907",
                                "sense_id": "337d6757-dd0f-3928-8506-80c6cb2737af",
                                "text": "Je pense à Diane, à notre fils mort, à cette putain de malchance qui s’abat sur nous depuis plus de deux ans maintenant. Diane qui était née pour être heureuse, et qui se prend baffe sur baffe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6deae779-1246-4691-ae76-f65000d4485a",
                        "source_entry_id": "ce33710d-1cf8-32a3-94b9-508a9c98caa4",
                        "target_lang_word": "optater",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "optater",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "31a3db55-d259-3052-94a5-6795dad4cb71",
                                        "entry_id": "ae896e01-b6e5-367b-b911-f72c752911c2",
                                        "glosses": [
                                            "een harde slag"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ce9ae25-4ab0-36e5-97a1-d6f80e0b3025",
                                        "entry_id": "ae896e01-b6e5-367b-b911-f72c752911c2",
                                        "glosses": [
                                            "een flinke tegenvaller"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44c84f5d-530a-47be-8068-6e9cfac3d0aa",
                                                "sense_id": "0ce9ae25-4ab0-36e5-97a1-d6f80e0b3025",
                                                "text": "De koers van de supermarktreus kreeg onlangs een flinke optater door een winstwaarschuwing van de Amerikaanse concurrent Kroger half juni. Een paar dagen daarna zorgde de aankondiging van de overname van Whole Foods door Amazon voor een nieuwe tik. De daling van zo'n 10 procent op de beurs is Ahold Delhaize nog niet te boven."
                                            },
                                            {
                                                "example_id": "9344e0e2-ee34-4965-b06e-c54bfc8e87c5",
                                                "sense_id": "0ce9ae25-4ab0-36e5-97a1-d6f80e0b3025",
                                                "text": "In 2009 krijgt haar carrière een flinke optater te verwerken: Pechstein wordt betrapt op bloeddoping. Er volgt een felle juridische strijd, maar ze kan niet voorkomen dat ze twee jaar wordt geschorst. Ze loopt dan al tegen de veertig, dus iedereen gaat ervan uit dat het tijdperk Pechstein ten einde is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
