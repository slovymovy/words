                    {
                        "sense_id": "7c599717-17ff-3d79-806c-d1184c3761a1",
                        "entry_id": "cee22b26-b142-362f-9899-c50629c3e206",
                        "glosses": [
                            "Eigenschaft, dass sich eine Flüssigkeit mit ihrer Oberfläche in einem engen Gefäß (Kapillare) auf einem anderen Niveau einpendelt als in einem weiteren Gefäß"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "59206192-8596-46d1-b070-f00faebae372",
                                "sense_id": "7c599717-17ff-3d79-806c-d1184c3761a1",
                                "text": "„So sorgt die Kapillarität dafür, dass in Pflanzen das Wasser und die darin enthaltenen Nährstoffe von den Wurzeln in die Blätter transportiert werden.“"
                            },
                            {
                                "example_id": "57374810-67d7-4ca3-8ef4-10fadded63f8",
                                "sense_id": "7c599717-17ff-3d79-806c-d1184c3761a1",
                                "text": "„Unter dem Begriff Kapillarität wird eine Reihe von Erscheinungen zusammengefasst, bei denen es um Gleichgewichte von Grenzflächen geht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
