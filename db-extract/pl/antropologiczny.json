                        "glosses": [
                            "związany z antropologią, dotyczący antropologii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bed28591-767e-455b-ad65-917a17324896",
                                "sense_id": "49056dab-fda4-322b-9d7c-d64191368b4b",
                                "text": "Esej to nie tylko gatunek literacki. To również zagadnienie psychologiczne, antropologiczne, egzystencjalne"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b94c1bd-e294-4c40-abe3-0754a1311b44",
                        "source_entry_id": "5e80f026-f83b-3c2d-ad3b-2043d9af6968",
                        "source_sense_id": "49056dab-fda4-322b-9d7c-d64191368b4b",
                        "target_lang_word": "anthropological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropological",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d632e8a9-a001-3e55-a1b1-457970790853",
                                        "entry_id": "24a39c39-d9e7-31f1-8975-e6e291f03fac",
                                        "glosses": [
                                            "Relating to anthropology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aeff9c4-766e-4cfe-9c72-94e447843701",
                                                "sense_id": "d632e8a9-a001-3e55-a1b1-457970790853",
                                                "text": "Much of the film is a detached, almost anthropological, look at the lives of the women and men, both white and of color, who live in the slums and housing projects outside of Paris."
                                            },
                                            {
                                                "example_id": "caa701b0-975f-4740-856f-f6f83e8f0575",
                                                "sense_id": "d632e8a9-a001-3e55-a1b1-457970790853",
                                                "text": "He draws eclectically on studies of baboons, descriptive anthropological accounts of hunter-gatherer societies and, in a few cases, the fossil record."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4886b6de-553a-446f-86a5-06f56a996a24",
                        "source_entry_id": "5e80f026-f83b-3c2d-ad3b-2043d9af6968",
                        "source_sense_id": "49056dab-fda4-322b-9d7c-d64191368b4b",
