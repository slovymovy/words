                                "example_id": "c5953e9c-185a-416f-9a73-49c465975201",
                                "sense_id": "8e520114-5443-3b83-82a1-89dbc5912c39",
                                "text": "Zijn carrière eindigde abrupt in 1928 na de ramp met de St. Francis-dam in de San Francisquito Canyon, die al een paar uur na ingebruikneming doorbrak."
                            },
                            {
                                "example_id": "ab275711-3a58-40ea-a33c-2c069d30e9c7",
                                "sense_id": "8e520114-5443-3b83-82a1-89dbc5912c39",
                                "text": "Tijdens zijn bezoek aan Israël heeft Premier Rutte een deel van het programma afgelast. Het gaat om de feestelijke ingebruikneming van een containerscanner op de grens van Israël en Gaza."
                            }
                        ]
