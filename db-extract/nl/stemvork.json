                "senses": [
                    {
                        "sense_id": "79d7ed39-e499-3f43-9ab7-2f39b0ff6d46",
                        "entry_id": "bf633e43-bfc3-3eed-8c49-d4772e8bfac9",
                        "glosses": [
                            "een stalen U-vormig instrument dat bij aanslaan een onveranderlijke toon voortbrengt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ac05f1d-b1dc-4d46-a99f-4f694b63a0ab",
                                "sense_id": "79d7ed39-e499-3f43-9ab7-2f39b0ff6d46",
                                "text": "Een stemvork brengt een toon voort."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1be6533f-f519-4d0a-a986-415fd72d1922",
                        "source_entry_id": "bf633e43-bfc3-3eed-8c49-d4772e8bfac9",
                        "source_sense_id": "79d7ed39-e499-3f43-9ab7-2f39b0ff6d46",
                        "source_sense_description": "stemvork",
                        "target_lang_word": "Stimmgabel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stimmgabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41110396-3ef3-3c4d-b7b4-f0900dcb37a5",
                                        "entry_id": "ca2f19e6-5db8-3ebf-81a9-3269c01a68cd",
                                        "glosses": [
                                            "ein Gerät aus Metall mit zwei Zinken / Stäben auf einem Stiel, das beim Anschlagen einer der Zinken auf einer bestimmten Tonhöhe / Frequenz schwingt; die meisten Stimmgabeln sind auf den Kammerton mit 440 Hz geeicht; sie dient Musikern zum Stimmen ihrer Instrumente, Chören beim Einsingen oder Ärzten beim Testen von Berührungsempfindlichkeit"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd2d767b-0c6c-4e2d-90b7-c199c5ef86ed",
                                                "sense_id": "41110396-3ef3-3c4d-b7b4-f0900dcb37a5",
                                                "text": "„Der Dirigent eines Orchesters legt vor Konzertbeginn mit einer Stimmgabel für alle Musiker einen verbindlichen Grundton fest, nach dem die Instrumente gestimmt werden müssen.“"
                                            },
                                            {
                                                "example_id": "df80387e-a7a4-4aa3-9338-9c31baa6c77a",
                                                "sense_id": "41110396-3ef3-3c4d-b7b4-f0900dcb37a5",
                                                "text": "„Wenn jemand ein Gerät stimmen möchte, dann kann man unsere Stimmgabel nutzen, was wir selbst entwickelt haben, mit dem Programmierer, Flasher und mit einem Musiker.“"
                                            },
                                            {
                                                "example_id": "f9958285-a223-4886-bb8d-91da98706d95",
                                                "sense_id": "41110396-3ef3-3c4d-b7b4-f0900dcb37a5",
                                                "text": "„Lose verteilter Sand auf einer dünnen Metallplatte sammelt sich entlang bestimmter Linien und Muster, wenn man die Platte mit einem Geigenbogen oder einer Stimmgabel in Schwingungen versetzt.“"
                                            },
                                            {
                                                "example_id": "d61c2673-24d1-43b9-bcd6-50ce8bd0421d",
                                                "sense_id": "41110396-3ef3-3c4d-b7b4-f0900dcb37a5",
                                                "text": "„Instrumente stimmen – an sich ist das nicht weiter schwer. Einfach eine Stimmgabel anschlagen, und der Musikus stimmt den Ton etwa seiner Geige darauf ab.“"
                                            },
                                            {
                                                "example_id": "bfe69fe2-1236-434b-a7c6-46bb0152b9e5",
                                                "sense_id": "41110396-3ef3-3c4d-b7b4-f0900dcb37a5",
                                                "text": "„Wenn man aber eine Stimmgabel anschlägt und sie in eine Schale mit Wasser hält (solange sie noch klingt), breiten sich an der Wasseroberfläche Wellen aus - die Schallwellen sind sichtbar geworden!“"
                                            },
                                            {
                                                "example_id": "1ca3fcf8-ec22-4112-bde8-c741d0096199",
                                                "sense_id": "41110396-3ef3-3c4d-b7b4-f0900dcb37a5",
                                                "text": "„Wird eine Stimmgabel angeschlagen, komprimieren die Zinken kurzzeitig die Luft, so dass ein kleines Gebiet mit höherem Druck entsteht. Diese komprimierte Luft breitet sich aus - ähnlich wie bei kreisförmigen Wellen im Wasser, wenn man einen Stein hineinwirft.“"
                                            },
                                            {
                                                "example_id": "0bcd62e4-5351-48a5-9a66-d5e9ef4f6752",
                                                "sense_id": "41110396-3ef3-3c4d-b7b4-f0900dcb37a5",
                                                "text": "„Am Beispiel einer Stimmgabel läßt sich sogar spüren, wie der Klang vibriert.“"
                                            },
                                            {
                                                "example_id": "6a41f4bf-6fb3-4c21-92ed-bb27feed20e3",
                                                "sense_id": "41110396-3ef3-3c4d-b7b4-f0900dcb37a5",
                                                "text": "„Für die Diagnose verwenden Ärzte für PRM hauptsächlich Augen, Hände und den Reflexhammer. Dazu kommen eine Stimmgabel, um die Sensibilität von Patienten auf Vibrationen zu testen, […]“"
                                            },
                                            {
                                                "example_id": "45fa86ce-234a-428a-aade-6397e5430db2",
                                                "sense_id": "41110396-3ef3-3c4d-b7b4-f0900dcb37a5",
                                                "text": "„Bei sogenannten Quantitativen Sensorischen Tests wird die Reaktion auf Temperatur, Druck und Berührungen geprüft. Dabei müssen Betroffene beispielsweise angeben, ab wann sie die Schwingungen einer Stimmgabel nicht mehr spüren. So lässt sich die Leitfähigkeit der Nervenbahnen prüfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce07baf3-8f2e-43d1-b6f6-1b66bb510ebd",
                        "source_entry_id": "bf633e43-bfc3-3eed-8c49-d4772e8bfac9",
                        "source_sense_id": "79d7ed39-e499-3f43-9ab7-2f39b0ff6d46",
