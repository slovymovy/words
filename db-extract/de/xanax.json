                "senses": [
                    {
                        "sense_id": "5b9e0b7a-5ea8-375e-86fd-f36721e879d1",
                        "entry_id": "a3c3f8c9-d1a4-34b3-a122-992e45e400b7",
                        "glosses": [
                            "Arzneistoff aus der Gruppe der Benzodiazepine mit mittlerer Wirkungsdauer, der zur kurzzeitigen Behandlung von Angst- und Panikstörungen eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4244551-0811-4d65-988a-bcf4e2abdac0",
                                "sense_id": "5b9e0b7a-5ea8-375e-86fd-f36721e879d1",
                                "text": "„Dies sei kein ernstgemeinter Selbstmordversuch, sagte sie, es sei wahrscheinlich nur so eine Hilferufgeschichte, aber sie hätte zuviel Xanax genommen.“"
                            },
                            {
                                "example_id": "800ad6d3-6425-489e-b16b-d72ee846b49c",
                                "sense_id": "5b9e0b7a-5ea8-375e-86fd-f36721e879d1",
                                "text": "„Er steckte sich die Taschen seines Trenchcoats voll mit Vicodin und Ambien und Xanax, Unmengen davon in Plastik versiegelt.“"
                            },
                            {
                                "example_id": "714b03ae-b612-49ed-9143-8aae277ec37e",
                                "sense_id": "5b9e0b7a-5ea8-375e-86fd-f36721e879d1",
                                "text": "„‚Was kann ich mir denn von zwei Rupien kaufen? Das reicht ja nicht einmal für ein paar Bonbons. Gib mir Xanax oder wenigstens Lexo.‘“"
                            },
                            {
                                "example_id": "7c798f82-95de-4956-ab90-0b7261a031b6",
                                "sense_id": "5b9e0b7a-5ea8-375e-86fd-f36721e879d1",
                                "text": "„Echt, sie musste Xanax nehmen, nur um Mrs. Dalloway zu lesen, und trotzdem hat sie fast ein Jahr lang geweint.“"
                            },
                            {
                                "example_id": "eeab9cdb-651b-467a-8f2f-6f3c24cdde0a",
                                "sense_id": "5b9e0b7a-5ea8-375e-86fd-f36721e879d1",
                                "text": "„Ich schätze, er hat sich Xanax eingeschmissen, denn auf dem Nachttisch liegt noch eine halbe, und als ich ihn trete, regt er sich nicht.“"
                            },
                            {
                                "example_id": "bffe5c2e-c766-4dbd-92ed-ceb9302513f3",
                                "sense_id": "5b9e0b7a-5ea8-375e-86fd-f36721e879d1",
                                "text": "„Statt Blumen oder Kondolenzkarten schickte meine Mutter Oma und mir üppige Geschenkkörbe voll Xanax.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
