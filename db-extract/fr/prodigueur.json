                        "sense_id": "5f7f7bf6-8939-3c5e-8eef-39686fb14417",
                        "entry_id": "932586b7-36e0-3784-84c2-348235264140",
                        "glosses": [
                            "Personne qui prodigue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9537f34-6522-42f7-ad07-b96ca2af144d",
                                "sense_id": "5f7f7bf6-8939-3c5e-8eef-39686fb14417",
                                "text": "Mais ce fut avant tout un remueur d’idées, un prodigueur de vie intellectuelle."
                            },
                            {
                                "example_id": "bd0b8562-79e2-4551-9f4e-4889ce433f57",
                                "sense_id": "5f7f7bf6-8939-3c5e-8eef-39686fb14417",
                                "text": "Dans ces temps d'orage, où nous autres prodigueurs de vie, nous voyons couler si vite et finir si brusquement nos jours usés par le travail et les passions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53336934-eabd-456a-9306-985a58bf27ad",
                        "source_entry_id": "932586b7-36e0-3784-84c2-348235264140",
                        "source_sense_id": "5f7f7bf6-8939-3c5e-8eef-39686fb14417",
                        "target_lang_word": "verkwister",
                        "target_lang_code": "nl",
