                        "examples": [
                            {
                                "example_id": "2b151849-6a0f-4081-a3ee-844992bcbbde",
                                "sense_id": "9dd541cd-c8c0-3078-8266-aabdb6ea1936",
                                "text": "Het motief van de man is onduidelijk. Volgens plaatselijke media is de man vaker in aanraking gekomen met de politie. Zo schoot hij in 2001 per ongeluk zijn 8-jarige zoon dood bij een jachtongeluk."
                            },
                            {
                                "example_id": "3b7d2a56-98aa-42a1-ae30-077960e3bba5",
                                "sense_id": "9dd541cd-c8c0-3078-8266-aabdb6ea1936",
                                "text": "Robin zei bijvoorbeeld dat Warner Keith kon vermoorden en kon doen alsof het een jachtongeluk was. Ze zou hem een geweer en munitie geven en vertellen wanneer haar man op welke plek jaagde."
                            }
                        ]
                    }
