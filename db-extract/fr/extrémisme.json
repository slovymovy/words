                                        "entry_id": "c367294e-d0f8-3732-9d12-0b6f77c19586",
                                        "glosses": [
                                            "doutrina ou modelo de ação política que preconiza soluções extremas, radicais e revolucionárias, para os problemas sociais"
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [
                                            {
