                "senses": [
                    {
                        "sense_id": "4b617d28-635a-38c4-9872-f716ea787314",
                        "entry_id": "1ce2dbe0-15cb-35a7-ba10-9df04e316cc5",
                        "glosses": [
                            "dokonywanie aneksji terytorium innego państwa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f683f101-70aa-4f5a-abd6-e557ccc32eca",
                                "sense_id": "4b617d28-635a-38c4-9872-f716ea787314",
                                "text": "Anglia i Francja wyraziły zgodę na anektowanie przez Niemcy Czechosłowacji dla ratowania siebie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "83665e3c-6a9a-32a5-900e-5774f8ba08e6",
                        "entry_id": "1ce2dbe0-15cb-35a7-ba10-9df04e316cc5",
                        "glosses": [
                            "samowolne zajmowanie czegoś, zwykle pomieszczeń, lokali, budynków"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44829aa8-4199-4a58-89b9-8d39c83cefb6",
                        "source_entry_id": "1ce2dbe0-15cb-35a7-ba10-9df04e316cc5",
                        "source_sense_id": "4b617d28-635a-38c4-9872-f716ea787314",
                        "target_lang_word": "аннексирование",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "аннексирование",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a3e0c663-3501-3a5a-8cc3-69c56d5b9371",
                                        "entry_id": "a4ce4bdd-2b5c-3fcd-a4a3-1cf9572bdb3d",
                                        "glosses": [
                                            "полит. действие по значению гл. аннексировать; насильственное присоединение, захват территории, принадлежащей другому государству или народу; также результат такого действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c819af46-bfdf-4cec-b745-6bc578f8cd8c",
                                                "sense_id": "a3e0c663-3501-3a5a-8cc3-69c56d5b9371",
                                                "text": "Его Величество вполне допускает, что между королем Оскаром и берлинским кабинетом достигнуто соглашение, по которому король предоставляет себя в полное распоряжение Германии, имея при этом в виду в случае войны аннексирование Дании Норвегией."
                                            },
                                            {
                                                "example_id": "58f91c01-8fe1-40c3-b058-adb6595adeee",
                                                "sense_id": "a3e0c663-3501-3a5a-8cc3-69c56d5b9371",
                                                "text": "Обращаясь к лорду Дерби и Вильяму Гладстону, Миклухо-Маклай вместе с тем ждал помощи из России. 11 октября 1883 г. он писал Копытову: «…вопрос аннексирования моего берега меня значительно интересует, но протестовать словами, а не делом мне кажется было бы смешно, но если я молчу пока, то это молчание вовсе не соответствует бездействию»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
