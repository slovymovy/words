                                "sense_id": "7e4bca9e-bba3-383d-91b4-f63855024cfe",
                                "text": "нам о́чень недостава́ло вас",
                                "translation": "we missed you very much; we missed you badly",
                                "english": "we missed you very much; we missed you badly"
                            }
                        ]
