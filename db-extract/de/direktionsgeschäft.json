                ],
                "senses": [
                    {
                        "sense_id": "e7929370-593c-39cc-94bb-1f6e665a52c0",
                        "entry_id": "4f536077-edaa-3ba5-b62d-0af36bafc573",
                        "glosses": [
                            "Verwaltungsaufgaben, die zu einem übernommenen Amt gehören (früher oft im Zusammenhang mit Schulen, Anstalten, Theatern und Ähnlichem)"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "d3050053-0bb3-4e26-9e38-45f72d9c38bb",
                                "sense_id": "e7929370-593c-39cc-94bb-1f6e665a52c0",
                                "text": "„Als Schillern, bei Goethe's zeitweiliger Abwesenheit von Weimar, das Direktionsgeschäft der Bühne einmal allein und ausschließlich überlassen werden mußte, schrieb dieser an Goethe nach Oberrosla, wo letzterer sich aufhielt.“"
                            },
                            {
                                "example_id": "6da9de57-c4f7-45ff-b054-96391b1c2176",
                                "sense_id": "e7929370-593c-39cc-94bb-1f6e665a52c0",
                                "text": "„Schließlich wäre Schalk noch zu verpflichten, über jeweilige Aufforderung der Bundestheaterverwaltung nach deren fallweisen Weisungen die Führung der Direktionsgeschäfte neben seinen Obliegenheiten als Kapellmeister zu versehen.“"
                            },
                            {
                                "example_id": "c1310946-6714-4ceb-8e33-1929cde7beb5",
                                "sense_id": "e7929370-593c-39cc-94bb-1f6e665a52c0",
                                "text": "„Der Präsident kann durch den Geschäftsplan Bürovorständen, Gruppenleitern oder geeigneten Bürobearbeitern auf Dienstposten des gehobenen Dienstes bestimmte Direktionsgeschäfte zur selbständigen Erledigung übertragen.“"
                            },
                            {
                                "example_id": "e724fe92-51c9-4e79-96b8-a5b30f8106ed",
                                "sense_id": "e7929370-593c-39cc-94bb-1f6e665a52c0",
                                "text": "„Nach ausführlichen Besprechungen und Verhandlungen wurde ich im November 1918 von dem damaligen Generalintendanten mittels Dekret mit der Führung der Direktionsgeschäfte betraut.“"
                            },
                            {
                                "example_id": "8f0a6c11-2d91-4e0f-9f11-1f907ea578ef",
                                "sense_id": "e7929370-593c-39cc-94bb-1f6e665a52c0",
                                "text": "„Mag sein, daß er in das Direktionsgeschäft noch hineinwachsen muß…“"
                            },
                            {
                                "example_id": "adbca53b-709e-4429-bc5e-d1f1ae5ea3cb",
                                "sense_id": "e7929370-593c-39cc-94bb-1f6e665a52c0",
                                "text": "„Es kann nicht sein, dass jedes Direktionsgeschäft innerhalb der Regierung von allen ausführlich diskutiert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fcf211b8-5bb2-320d-8b7e-265600f3b6b3",
                        "entry_id": "4f536077-edaa-3ba5-b62d-0af36bafc573",
                        "glosses": [
                            "Geschäft zwischen Bank oder Versicherung und Kunde, das vom Hause selbst abgewickelt wird und nicht über Agenten, Vertreter oder Makler läuft und bei dem deshalb keine Vermittlungsgebühren anfallen"
                        ],
                        "tags": [
                            "Banken",
                            "Versicherungen"
                        ],
                        "examples": [
                            {
                                "example_id": "dcea0b6d-fffa-4461-baf8-78c37f3cd705",
                                "sense_id": "fcf211b8-5bb2-320d-8b7e-265600f3b6b3",
                                "text": "„Die Styriawest habe der R+V um das Jahr 2010 herum bei einem österreichischen Baukonzern ein Geschäft mit etwa 60.000 Jahresprämie vermittelt. Vor kurzen habe die R+V daraus ein Direktionsgeschäft gemacht und die Styriawest informiert, dass ein Betreuerwechsel vorgenommen wurde.“"
                            },
                            {
                                "example_id": "f249c174-cd43-4001-bf16-4f459cb3294e",
                                "sense_id": "fcf211b8-5bb2-320d-8b7e-265600f3b6b3",
                                "text": "„Sie übernehmen die fachliche und disziplinarische Führung der Underwriter im Direktionsgeschäft und treffen Zeichnungsentscheidungen bei vorlagepflichtigen Risiken aus dem In- und Ausland im industriellen und gewerblichen Haftpflichtgeschäft.“"
                            },
                            {
                                "example_id": "74c2e39c-850e-4bce-ac61-cf0463d36aac",
                                "sense_id": "fcf211b8-5bb2-320d-8b7e-265600f3b6b3",
                                "text": "„Sonstige: Absatzkanäle, die sich keiner der genannten Kategorie zuordnen lassen (z. B. Direktionsgeschäft, spezielle Kooperationen etc.)“"
                            },
                            {
                                "example_id": "7cc60240-4fa4-4cb8-8b57-61a15009358c",
                                "sense_id": "fcf211b8-5bb2-320d-8b7e-265600f3b6b3",
                                "text": "„Je homogener Güter sind, desto umfangreicher sind im allgemeinen die einzelnen Aufträge […] und desto mehr wird der Verkauf zu einem ‚Direktionsgeschäft‘.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
