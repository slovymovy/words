                "senses": [
                    {
                        "sense_id": "1dc0c322-abbc-3b84-bd7e-e9072572745b",
                        "entry_id": "55402070-34c9-3242-a986-f3997ab4d633",
                        "glosses": [
                            "Handeln in Spielform"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "877777f9-43d3-4da6-bf99-26be02191877",
                                "sense_id": "1dc0c322-abbc-3b84-bd7e-e9072572745b",
                                "text": "„Die Zahl der Abhandlungen und theoretischen Ansätze ist inzwischen fast unübersehbar groß geworden, ohne daß es zu einer Übereinstimmung gekommen ist, was die wesentlichen Merkmale oder das Wesen menschlicher Spieltätigkeit betrifft.“"
                            },
                            {
                                "example_id": "da7c9371-f2e3-42bb-b994-83aa5897fe51",
                                "sense_id": "1dc0c322-abbc-3b84-bd7e-e9072572745b",
                                "text": "„Die Spieltätigkeit soll den im Motiv enthaltenen Sinn der Handlung und deren Beziehungen zum Ziel ausdrücken und nicht dieses Ziel in Gestalt eines dinglichen Resultats verwirklichen.“"
                            },
                            {
                                "example_id": "c7201a07-70f5-4b9d-bfa6-55243ee46c87",
                                "sense_id": "1dc0c322-abbc-3b84-bd7e-e9072572745b",
                                "text": "„Die für Spieltätigkeiten vorhandenen Zeit-, Raum-, Energie- und Motivationsbudges sind aber stets begrenzt.“"
                            },
                            {
                                "example_id": "d4e9fa89-943d-4724-9f27-c2ad55b0ff82",
                                "sense_id": "1dc0c322-abbc-3b84-bd7e-e9072572745b",
                                "text": "„Es ist deutlich geworden, daß die Untersuchung der Entwicklung und Bedeutung der kindlichen Spieltätigkeit vor allem mit Hilfe psychologischer Kategorien […] erfolgen muß.“"
                            },
                            {
                                "example_id": "59d02d17-2112-474b-8320-2e64642db110",
                                "sense_id": "1dc0c322-abbc-3b84-bd7e-e9072572745b",
                                "text": "„In der ersten mündlichen Verhandlung mußte der DVV dann eingestehen, daß der genaue Wortlaut eines im Jahre 1976 in Tunis gefaßten und die Spieltätigkeit der Klägerin betreffenden Beschlusses der FIVB den Parteien nicht vorliegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
