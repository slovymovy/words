                "senses": [
                    {
                        "sense_id": "d9414226-02df-3847-936c-e7191aba8ac7",
                        "entry_id": "36ae4f45-dda8-3e3d-9030-f7021be6dc13",
                        "glosses": [
                            "organischer Dünger aus den Exkrementen von Seevögeln und Fledermäusen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25912593-39db-457d-b5db-8ae9bd25189c",
                                "sense_id": "d9414226-02df-3847-936c-e7191aba8ac7",
                                "text": "Der Lebensraum der Humboldt-Pinguine wird durch das Verschwinden der Vorkommen an Guano durch den Raubbau zunehmend bedroht."
                            },
                            {
                                "example_id": "b2acf49d-8caf-4131-bfb3-7fa833fac720",
                                "sense_id": "d9414226-02df-3847-936c-e7191aba8ac7",
                                "text": "„Außerdem verwendete man als Dünger Guano, der in großem Mengen an der Küste vorkam und garantierte so gute Ernten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39bc5a70-f4bb-4a0f-b22d-c40889e6de3e",
                        "source_entry_id": "36ae4f45-dda8-3e3d-9030-f7021be6dc13",
                        "source_sense_id": "d9414226-02df-3847-936c-e7191aba8ac7",
                        "source_sense_description": "organischer Dünger aus den Exkrementen von Seevögeln und Fledermäusen",
                        "target_lang_word": "guano",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guano",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d3d1f2f-f598-3b70-bd74-1edfac89e8e7",
                                        "entry_id": "02dc4274-1ca7-3ddf-a263-846f0ff5b584",
                                        "glosses": [
                                            "Dung from a sea bird or from a bat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f282790e-17de-46b1-bf9c-598469439264",
                                                "sense_id": "2d3d1f2f-f598-3b70-bd74-1edfac89e8e7",
                                                "text": "The guano, so extensively used for manure, is full of the most beautiful infusoria, some of them splendidly iridiscent; and there is no better method of testing the genuineness of this useful substance than by the microscope."
                                            },
                                            {
                                                "example_id": "fd0e1ebb-4cd7-44aa-a011-d19638bb5258",
                                                "sense_id": "2d3d1f2f-f598-3b70-bd74-1edfac89e8e7",
                                                "text": "In the second experiment, a comparative trial was made between guano and bone-dust mixed with coal ashes."
                                            },
                                            {
                                                "example_id": "3fbab12d-8329-4f22-b3d0-f8eb2398b490",
                                                "sense_id": "2d3d1f2f-f598-3b70-bd74-1edfac89e8e7",
                                                "text": "Low-grade phosphatic guanos can be mixed with coffee hulls and pulp, which contain a small amount of potash."
                                            },
                                            {
                                                "example_id": "525fdaa2-e04b-46ab-8597-75d5324d7ae1",
                                                "sense_id": "2d3d1f2f-f598-3b70-bd74-1edfac89e8e7",
                                                "text": "The great white bat has great white guano!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2445e52a-7e3b-38f2-80ef-b3fbde75797c",
                                        "entry_id": "02dc4274-1ca7-3ddf-a263-846f0ff5b584",
                                        "glosses": [
                                            "Coccothrinax borhidiana, a variety of palm tree indigenous to Cuba."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eae64fa5-58be-482c-aa72-b7263e55d839",
                                                "sense_id": "2445e52a-7e3b-38f2-80ef-b3fbde75797c",
                                                "text": "A roof made of guano palm fronds will last up to 15 years, although Maya harvesters point out that the leaves must be cut when the moon is full; otherwise, the stems become susceptible to insect damage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8eb818ca-b7e8-341d-8c3f-d30e281f6047",
                                        "entry_id": "02dc4274-1ca7-3ddf-a263-846f0ff5b584",
                                        "glosses": [
                                            "A variety of seabird."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5c42a6e-50b5-4705-bb49-e455933fbee1",
                                                "sense_id": "8eb818ca-b7e8-341d-8c3f-d30e281f6047",
                                                "text": "The Animals of these Islands, are some Hogs, Lizards, and Guanoes; and some of those Creatures mentioned in Chap. XI. which are like, but much bigger than the Guano."
                                            },
                                            {
                                                "example_id": "bb212b8c-6270-4e56-ae81-852b924c72e8",
                                                "sense_id": "8eb818ca-b7e8-341d-8c3f-d30e281f6047",
                                                "text": "Dampier observes, that no part of the globe is so well stocked with guanoes and land-tortoises as the Gallapagos. The guanoes are fat, tame, and of an extraordinary size."
                                            },
                                            {
                                                "example_id": "f8b7fb73-ea6f-4b69-83b9-1b66affef1fe",
                                                "sense_id": "8eb818ca-b7e8-341d-8c3f-d30e281f6047",
                                                "text": "These they call Guanoes, and the dung Guano, the Indian name for excrement in general. These birds, after spending the whole day in catching their food in the sea, repair at night to rest on the islands near the coast […]"
                                            },
                                            {
                                                "example_id": "91303041-7d9a-4935-b987-489297863004",
                                                "sense_id": "8eb818ca-b7e8-341d-8c3f-d30e281f6047",
                                                "text": "The fish consumed by the guanoes, (as the fishing birds are called) are anchovies, the shoals of which are beyond all comparison."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "guano",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82f6d7fc-1c28-3971-9ac0-9e4ee4ae9258",
                                        "entry_id": "c5c3ddcb-e119-3ad8-bda3-30d8f4e32443",
                                        "glosses": [
                                            "To fertilize (land) with guano."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "302d3b42-36bd-4cbf-8c02-f2fae3343f3a",
                        "source_entry_id": "36ae4f45-dda8-3e3d-9030-f7021be6dc13",
                        "source_sense_id": "d9414226-02df-3847-936c-e7191aba8ac7",
                        "source_sense_description": "organischer Dünger aus den Exkrementen von Seevögeln und Fledermäusen",
                        "target_lang_word": "guano",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guano",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "304a26b1-8213-3724-b379-08f2b04e6d1f",
                                        "entry_id": "8748c35f-5600-3ef9-9083-f8b13ef9d362",
                                        "glosses": [
                                            "Amas de fiente d’oiseaux de mer ou de chauve-souris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "969b0d0a-787d-4bcb-80f8-fd3daf0f0b49",
                                                "sense_id": "304a26b1-8213-3724-b379-08f2b04e6d1f",
                                                "text": "Marjolin se tut, dans ce coin empesté par l’afflux des odeurs. C’était une rudesse alcaline de guano."
                                            },
                                            {
                                                "example_id": "112e0d36-7c9f-4fa8-b054-8f94c3bc2e8e",
                                                "sense_id": "304a26b1-8213-3724-b379-08f2b04e6d1f",
                                                "text": "Seuls quelques milliers d’oiseaux y ont établi leur domicile […]. Le guano, largement fabriqué par ces nombreux habitants, donne l’illusion de la neige."
                                            },
                                            {
                                                "example_id": "a78195e4-03ac-43f9-a768-3fb73820df58",
                                                "sense_id": "304a26b1-8213-3724-b379-08f2b04e6d1f",
                                                "text": "La dépigeonnisation, c'est moins sévère que la dératisation. Ce qui est gênant avec les pigeons, c'est tout ce guano frais qu'ils posent sur les bancs."
                                            },
                                            {
                                                "example_id": "670176e8-b0f2-47ec-91e4-512d81897ea2",
                                                "sense_id": "304a26b1-8213-3724-b379-08f2b04e6d1f",
                                                "text": "— Mieux, pour venger illico ce dernier, une colombe de la paix peut lâcher une rafale de généreux guanos bien calibrés (et qui sentent bon leur terroir campagnard) sur un entier Stade de France overbooké de footeux braillards !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b09b2cc-1289-32a9-a473-4d3ed172c0bf",
                                        "entry_id": "8748c35f-5600-3ef9-9083-f8b13ef9d362",
                                        "glosses": [
                                            "Cette substance employée comme engrais."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ee5a931-7439-4171-95b3-b829324c9e36",
                                                "sense_id": "4b09b2cc-1289-32a9-a473-4d3ed172c0bf",
                                                "text": "Dans les localités où il y a des cultures industrielles, on importe du guano."
                                            },
                                            {
                                                "example_id": "a5ac6be0-a1ef-4e0c-a5ff-24ba2ea91658",
                                                "sense_id": "4b09b2cc-1289-32a9-a473-4d3ed172c0bf",
                                                "text": "Ils ne peut y avoir rien de plus sublime que lorsque des syndicats agricoles discutent avec des marchands d’engrais au sujet des prix du guano."
                                            },
                                            {
                                                "example_id": "3b2b4c5d-7825-496c-9688-df6bb5c798fc",
                                                "sense_id": "4b09b2cc-1289-32a9-a473-4d3ed172c0bf",
                                                "text": "Aux places où l’on répandit trop de guano le blé se rue par taches plus drues et plus foncées, et l’on se demande quelles ombres de nuages tombent ainsi, de plus haut que le ciel, qui est bleu."
                                            },
                                            {
                                                "example_id": "49256319-51f9-46a1-9a9b-a93396cc3c2e",
                                                "sense_id": "4b09b2cc-1289-32a9-a473-4d3ed172c0bf",
                                                "text": "La plupart du temps, la publicité qu’on lit aux carrefours, dans les bourgs, concerne des calcimètres, des acidimètres, des vinoscopes, des glucomètres, des pèse-moûts, des vinomètres, des mustimètres, des ébullioscopes, […], des guanos, des superphosphates, des acides tartriques, des tannins, des adhésols, des tétracuprites, des pyralumnols…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9c1f5e5-eb1f-3b90-a375-70e241d859fc",
                                        "entry_id": "8748c35f-5600-3ef9-9083-f8b13ef9d362",
                                        "glosses": [
                                            "Viande séchée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39f5537e-bf6e-49ef-8aba-069f366f5d79",
                                                "sense_id": "d9c1f5e5-eb1f-3b90-a375-70e241d859fc",
                                                "text": "Le guano de viande est un produit fabriqué avec des déchets de viandes d'animaux séchés et moulus auxquels on ajoute du chlorure de potassium et du phosphate de soude."
                                            },
                                            {
                                                "example_id": "c28da614-9652-4f3f-9712-c11c59b0b688",
                                                "sense_id": "d9c1f5e5-eb1f-3b90-a375-70e241d859fc",
                                                "text": "Guano de Fray-Bentos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
