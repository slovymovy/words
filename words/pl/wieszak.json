                    "sense_definition": "Przedmiot o łukowatym lub trójkątnym kształcie, z hakiem pośrodku, służący do wieszania ubrań na drążku.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "wieszak_ubraniowy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wieszaki</w> do ubrań wyrabiane są z drewna, metalu lub plastiku."
                        },
                        {
                            "text": "Powieś proszę tę koszulę na <w>wieszaku</w> w szafie."
                        }
                    ],
                    "common_phrases": [
