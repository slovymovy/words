                            {
                                "example_id": "461ef438-a4ab-42d6-8c33-d61c55340e8d",
                                "sense_id": "68db3ac3-2bf4-39b5-bf77-24dda01afd5f",
                                "text": "Die erste Lichtquelle in der Stein- und Bronzezeit war der Kienspan, ein Stück Holz mit viel Harz, das man in einem Feuer zum Glühen brachte.",
                                "translation": "De eerste lichtbron in de steen- en bronstijd was de kienspaan, een stuk hout met veel hars, dat men met in een vuurtje tot gloeien bracht."
                            }
                        ]
                    }
