                        "examples": [
                            {
                                "example_id": "b5fe15db-c35e-4988-a979-fd46fce097ed",
                                "sense_id": "c465db6f-1cf2-353d-9ca9-6cda3897b273",
                                "text": "Que cependant, nous remettans au Seigneur, desirons nous accourager en sa grace, accourager aussi le peuple en luy monstrant soigneusement comment il doit faire son proffit d'une si grande visitation ;"
                            },
                            {
                                "example_id": "17764922-e7af-41f3-925a-9172094b2366",
                                "sense_id": "c465db6f-1cf2-353d-9ca9-6cda3897b273",
                                "text": "Je voulais tout simplement t'accourager avec tes projets visuels et aussi que je continue de suivre ton cheminement artistique depuis plusieurs années soit dans les journaux et même vus de tes créations à Gatineau en l'an 2000 à Montréal ou ailleurs...Québec je crois.."
                            }
                        ]
                    }
