                    {
                        "sense_id": "5a82c2ab-4b09-3d77-9dd4-aed83bcea5ba",
                        "entry_id": "322c20dd-1be2-360f-bed3-bef322e0f251",
                        "glosses": [
                            "Laufschuhe mit an der Sohle herausstehenden Dornen aus Kunststoff oder Stahl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24104fcf-02b5-4f9b-836a-f08c9fc7b979",
                                "sense_id": "5a82c2ab-4b09-3d77-9dd4-aed83bcea5ba",
                                "text": "Für den Finallauf zog der Sprinter wieder seine Spikes an."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d4f5b937-364c-34dd-ad4a-24270f96198e",
                        "entry_id": "322c20dd-1be2-360f-bed3-bef322e0f251",
                        "glosses": [
                            "Reifen mit Stahlstiften zum Fahren auf Eis oder Schnee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92ee0288-bde6-4f45-837a-8f7ab4394e66",
                                "sense_id": "d4f5b937-364c-34dd-ad4a-24270f96198e",
                                "text": "Ohne Spikes kann man auf der Eisfläche nicht fahren."
                            },
                            {
                                "example_id": "be38cd3d-d58d-4046-b2bf-7027f3c3451c",
                                "sense_id": "d4f5b937-364c-34dd-ad4a-24270f96198e",
                                "text": "„Doch um mein Ohr summte diese Fliege, und ich genoss es, herumzufahren… Das säuselnde Geräusch des Motors mit dem Dauerdröhnen der Spikes auf der Straße verschmelzen zu hören.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
