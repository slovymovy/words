                "entry_id": "87a7bfcf-2620-3cf3-a05f-d7fc89de3287",
                "word": "hansom",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2d3d97b3-f489-45b9-a611-84e22c222c97",
                        "entry_id": "87a7bfcf-2620-3cf3-a05f-d7fc89de3287",
                        "tags": [
                            "plural"
                        ],
                        "form": "hansoms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "45a7a9f6-0140-358b-95fc-12cd6b0e605f",
                        "entry_id": "87a7bfcf-2620-3cf3-a05f-d7fc89de3287",
                        "glosses": [
                            "Ellipsis of Hansom cab."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "548a0292-eda0-45c3-9ad9-c42e6b7b39e9",
                                "sense_id": "45a7a9f6-0140-358b-95fc-12cd6b0e605f",
                                "text": "I rose accordingly from table, got into a hansom, and drove straight to Jekyll's house."
                            },
                            {
                                "example_id": "ac1347c8-ac0c-4a5b-9433-7e6d25f0a6c0",
                                "sense_id": "45a7a9f6-0140-358b-95fc-12cd6b0e605f",
                                "text": "\"Yes, if you have nothing better to do.\" A minute later we were both in a hansom, driving furiously for the Brixton Road."
                            },
                            {
                                "example_id": "00277c1b-0d02-48a3-ac04-56168b68ad3e",
                                "sense_id": "45a7a9f6-0140-358b-95fc-12cd6b0e605f",
                                "text": "“There the cause of death was soon ascertained ; the victim of this daring outrage had been stabbed to death from ear to ear with a long, sharp instrument, in shape like an antique stiletto, which […] was subsequently found under the cushions of the hansom.[…]”"
                            },
                            {
                                "example_id": "4299dbf9-ce03-4049-bb0c-9abf2bfcc8f6",
                                "sense_id": "45a7a9f6-0140-358b-95fc-12cd6b0e605f",
                                "text": "The shooting motor cars, more like spiders in the moon than terrestrial objects, the thundering drays, the jingling hansoms, and little black broughams, made her think of the world she lived in."
                            },
                            {
                                "example_id": "67f37fa1-2b78-4f81-a0f4-5603fae841a3",
                                "sense_id": "45a7a9f6-0140-358b-95fc-12cd6b0e605f",
                                "text": "The ghost of Selby stirred in him. His thoughts slipped back to the day when he had stolen from his well-appointed office to a waiting hansom—there had still been a good many hansoms in those days—and driven quickly to the docks."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
