                        "examples": [
                            {
                                "example_id": "4d14fcae-32b9-4700-b8cb-e08c1227df2e",
                                "sense_id": "5bb1ca0e-b6f2-35b9-995f-6a216fc60103",
                                "text": "Den Ablad erledigen wir morgen."
                            },
                            {
                                "example_id": "0312f530-95ab-445e-9bdb-b87395c846ad",
                                "sense_id": "5bb1ca0e-b6f2-35b9-995f-6a216fc60103",
                                "text": "„Der Lastwagenfahrer hatte sein Fahrzeug auf der Fahrbahn abgestellt und war mit dem Ablad beschäftigt.“"
                            },
                            {
                                "example_id": "ff95e551-96fa-4e70-96e5-b9f60b576577",
                                "sense_id": "5bb1ca0e-b6f2-35b9-995f-6a216fc60103",
                                "text": "„Es waren eben einige Mannen dabei […] Badewannen von Lastwagen zu laden. [Voubrasse] stand dabei und überwachte den Ablad.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
