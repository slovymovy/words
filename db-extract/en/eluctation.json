                        "examples": [
                            {
                                "example_id": "6219d9c9-8975-4bb9-8541-1bd169c25f0f",
                                "sense_id": "5a73946f-da86-3120-9ca1-86c19131fec4",
                                "text": "Ye do, in common, sue to God for us, as your poor fellow-members, for our happy eluctation out of those miseries and temptations"
                            },
                            {
                                "example_id": "be619f7a-96c9-4e8c-9a7c-2b189a868efe",
                                "sense_id": "5a73946f-da86-3120-9ca1-86c19131fec4",
                                "text": "There is nothing more acceptable unto the ingenious world than this noble eluctation of truth"
                            },
                            {
                                "example_id": "2d104303-d95f-4664-8de8-f64cd8f87f75",
                                "sense_id": "5a73946f-da86-3120-9ca1-86c19131fec4",
                                "text": "July 1, 1627, John Donne, Sermon preached at Chilsey\nif I be with him in his afflictions, I shall be with him in his eluctations, in his victory, in his triumph"
                            }
                        ]
