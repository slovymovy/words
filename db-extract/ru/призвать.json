                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86ee237f-ee5e-4c1c-8b93-1ec7aefe6899",
                                "sense_id": "5d6bf4a3-af24-3d66-9994-a9b4aa4681aa",
                                "text": "Услышав сие, Иисус говорит им: не здоровые имеют нужду во враче, но больные; Я пришел призвать не праведников, но грешников к покаянию.",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            }
                        ]
                    },
                    {
                        "sense_id": "510b42a3-1ed4-34c5-8e1b-c5e9ff865b20",
                        "entry_id": "b2168bf3-e980-34e3-a605-29f50df58dc4",
                        "glosses": [
                            "to call upon (to), to urge (to)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4ec13ba-d79e-4d9a-970f-f93ead38450a",
                                "sense_id": "510b42a3-1ed4-34c5-8e1b-c5e9ff865b20",
                                "text": "призва́ть к я́дерному разоруже́нию",
                                "translation": "to urge a nuclear disarmament",
