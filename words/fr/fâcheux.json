                    "frequency": "Middle",
                    "semantic_group_id": "desagreable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est vraiment <w>fâcheux</w> que vous ne puissiez pas venir à cette réunion importante."
                        },
