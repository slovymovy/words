                    "sense_id": "99964528-ae3d-30ac-acc8-0bf36b6dac85",
                    "sense_definition": "Большое количество чего-либо, изобилие.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В парке собралось <w>множество</w> людей, чтобы посмотреть на праздник.",
                            "target_lang_translations": {
                                "de": "Im Park versammelte sich eine <w>Menge</w> Menschen, um das Fest zu sehen."
                            }
                        },
                        {
                            "text": "У него есть <w>множество</w> интересных идей для нового проекта.",
                            "target_lang_translations": {
                                "de": "Er hat eine <w>Vielzahl</w> interessanter Ideen für das neue Projekt."
                            }
                        }
                    ],
                    "synonyms": [
                        "совокупность"
                    ],
                    "antonyms": [
                        "отсутствие"
                    ],
                    "common_phrases": [
                        "множество людей",
                        "множество проблем"
                    ],
                    "target_lang_definitions": {
