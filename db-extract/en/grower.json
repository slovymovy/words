                    {
                        "translation_id": "cfa3cc04-6958-418b-b232-b15e18f1bbc0",
                        "source_entry_id": "4cfc6435-942c-37f7-928e-424f57e1c342",
                        "source_sense_id": "2d86eeda-c4c7-34c1-82b9-a6acaa4c5cf6",
                        "source_sense_description": "Anbauer, Bauer, Erzeuger, Pflanzer, Züchter",
                        "target_lang_word": "Bauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                        "entry_id": "c18475f1-9fa4-3a4c-82f6-673473763031",
                                        "glosses": [
                                            "jemand, der Ackerbau oder Viehhaltung betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b5c81e3-40d1-4bf0-a864-8abadd06b0ae",
                                                "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                                "text": "Mein Vater war Bauer, er hat nun aber seinen Hof verkauft."
                                            },
                                            {
                                                "example_id": "102c1961-6dd5-4adb-ad78-c7193316c0ed",
                                                "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                                "text": "„Eine Million Tonnen Äpfel ernten deutsche Bauern pro Jahr.“"
                                            },
                                            {
                                                "example_id": "5af08d67-fd70-48d9-b727-6dac37a0e33e",
                                                "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                                "text": "„Besonders unsere Gutsleute, aber auch manche Bauern sind um uns bemüht, als wollten sie gegen die neuen Machthaber demonstrieren.“"
                                            },
                                            {
                                                "example_id": "3ba1cac4-2fe2-49ad-91f1-0d2b5a356696",
                                                "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                                "text": "„Der Bauer stand mit seiner Familie allein und bedrückt in einer Ecke, da er keine Schmeichler hatte, weder Freunde noch versteckte Feinde.“"
                                            },
                                            {
                                                "example_id": "6593f0af-8c0d-4b9c-b210-2fccf3ff2664",
                                                "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                                "text": "„Wie der Bauer nicht ohne sein Ackergerät oder Vertreter anderer Berufe ohne ihr spezielles Handwerkszeug, so kommen Wissenschaftler wie Techniker und überhaupt Fachleute aller Disziplinen nicht ohne eine genau definierte Begrifflichkeit aus: eben ihre von Fach zu Fach verschiedene Terminologie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bbfbbdd0-0c93-3a0d-8d54-372e1c2fbf2d",
                                        "entry_id": "c18475f1-9fa4-3a4c-82f6-673473763031",
                                        "glosses": [
                                            "in Ständegesellschaften Angehöriger des Bauernstandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1810c0c8-5ea0-4762-a180-66067fd9de08",
                                                "sense_id": "bbfbbdd0-0c93-3a0d-8d54-372e1c2fbf2d",
                                                "text": "Die Bauern probten den Aufstand."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c0bcc91b-89b0-3d07-84a2-f644965940bc",
                                        "entry_id": "c18475f1-9fa4-3a4c-82f6-673473763031",
                                        "glosses": [
                                            "Mensch mit schlechten Manieren"
                                        ],
                                        "tags": [
                                            "Schimpfwort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07474465-d49b-42f7-8f6e-8689896b4210",
                                                "sense_id": "c0bcc91b-89b0-3d07-84a2-f644965940bc",
                                                "text": "Bedank' dich mal, du Bauer!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f2b02869-effd-3224-bef6-f78a843fde03",
                                        "entry_id": "c18475f1-9fa4-3a4c-82f6-673473763031",
                                        "glosses": [
                                            "schwächste der Schachfiguren"
                                        ],
                                        "tags": [
                                            "Schach"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33ede86a-206a-428b-a155-1804e421e74c",
                                                "sense_id": "f2b02869-effd-3224-bef6-f78a843fde03",
                                                "text": "„Eine kleines Land hatte gegenüber einer Großmacht die Initiative ergriffen und die Welt wissen lassen, daß es sich im Schachspiel der europäischen Machtpolitik nicht als bloßer Bauer mißbrauchen lassen wollte.“"
                                            },
                                            {
                                                "example_id": "0051bd2d-e5d0-4f75-b2b7-3498fef46ec1",
                                                "sense_id": "f2b02869-effd-3224-bef6-f78a843fde03",
                                                "text": "Weiß zieht seinen Bauern von e2 nach e4."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "fea17f1d-97ab-3306-8b7d-53bec16a9e00",
                                        "entry_id": "c18475f1-9fa4-3a4c-82f6-673473763031",
                                        "glosses": [
                                            "der Bube oder Unter in verschiedenen Kartenspielen"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1388b76-df2b-4826-978d-280964468a6b",
                                                "sense_id": "fea17f1d-97ab-3306-8b7d-53bec16a9e00",
                                                "text": "Sieben, Neune, Bauer, steht wie eine Mauer."
                                            },
                                            {
                                                "example_id": "e2d67c29-1172-4700-a323-512d0a5345f5",
                                                "sense_id": "fea17f1d-97ab-3306-8b7d-53bec16a9e00",
