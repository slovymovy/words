        "fr-extract.jsonl": [
            {
                "entry_id": "733d3284-b765-31c3-a86a-753624873a12",
                "word": "jujube",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "210b1ada-f2bf-41db-897f-030e7d477ea8",
                        "entry_id": "733d3284-b765-31c3-a86a-753624873a12",
                        "tags": [
                            "plural"
                        ],
                        "form": "jujubes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd18ee0c-4ff2-31b9-9b46-f1d354d133fd",
                        "entry_id": "733d3284-b765-31c3-a86a-753624873a12",
                        "glosses": [
                            "Fruit du jujubier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d11e4a7-b654-4fb3-90b0-ababe41cee9d",
                                "sense_id": "cd18ee0c-4ff2-31b9-9b46-f1d354d133fd",
                                "text": "Le jujubier peut s'élever à 6—8 m […]. Le fruit, mucilagineux et sucré, est comestible et connu sous le nom de jujube. On en fabrique une boisson alcoolisée."
                            },
                            {
                                "example_id": "0fefb2c1-c33c-45dc-846c-8d0b52e22bfa",
                                "sense_id": "cd18ee0c-4ff2-31b9-9b46-f1d354d133fd",
                                "text": "Il comblait son ami de réglisse, de pâtes au jujube, au lichen et de pastilles pectorales à base d’eucalyptus que le père Blafaphas fabriquait lui-même, d’après la recette d’un vieux curé."
                            },
                            {
                                "example_id": "e11cdf50-c28a-4a9f-8e3c-f2060d0083e6",
                                "sense_id": "cd18ee0c-4ff2-31b9-9b46-f1d354d133fd",
                                "text": "Pâte de jujube, préparation qui se fait avec la décoction du jujube, le sirop de sucre, l'eau de fleur d'orange et l'eau pure."
                            },
                            {
                                "example_id": "64db80cc-97a2-4cbc-99e4-e48289adc56b",
                                "sense_id": "cd18ee0c-4ff2-31b9-9b46-f1d354d133fd",
                                "text": "De son temps il n’y avait pas de magasin Luska ; mais une bonne femme, la mère Pinaud, étalait ses berlingots et son jujube sur une petite table en face de l’école…"
                            },
                            {
                                "example_id": "49861ee5-2ab2-4613-b4b9-51eba63faa87",
                                "sense_id": "cd18ee0c-4ff2-31b9-9b46-f1d354d133fd",
                                "text": "Elle tourna elle-même le bouton et l’on entendit un chanteur corse, un filet d’huile, une jujube."
                            },
                            {
                                "example_id": "4fc21b98-f48c-4008-b942-1112b3b594c5",
                                "sense_id": "cd18ee0c-4ff2-31b9-9b46-f1d354d133fd",
                                "text": "Elle choisit sur la table le plus gros jujube, le plus rouge, le plus lisse de peau, elle l’offre à son homme, ce qui, dans le langage des fruits, signifie « un baiser, tout de suite »."
                            }
                        ]
                    },
