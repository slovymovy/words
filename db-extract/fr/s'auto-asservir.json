                    {
                        "sense_id": "a966e4e3-bece-34c2-90c2-30d2ec6eeff4",
                        "entry_id": "02b21245-bbc8-3891-8e80-729c006e25f3",
                        "glosses": [
                            "S’asservir soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e848ee85-6079-41c9-b6d2-a6d5f9422721",
                                "sense_id": "a966e4e3-bece-34c2-90c2-30d2ec6eeff4",
                                "text": "L'être abandonné devenu l'être superflu n'est aucunement décrit comme un être auto-asservi."
                            },
                            {
                                "example_id": "6d56e3e6-3c41-413c-b27a-41b331e2b162",
                                "sense_id": "a966e4e3-bece-34c2-90c2-30d2ec6eeff4",
                                "text": "Celle que Markus Tramper vient d'ôter à ses propres concitoyens. La Loi Martiale a été votée en Europe ! Ces chiens n'en ont pas assez d'asservir les autres nations, il leur faut aussi s'auto asservir !"
                            }
                        ]
