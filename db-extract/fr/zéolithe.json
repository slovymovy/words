                ],
                "senses": [
                    {
                        "sense_id": "0592729b-fe3b-3612-9974-82a423e426bf",
                        "entry_id": "c173a380-d845-3074-862d-55bd593bd6b2",
                        "glosses": [
                            "Minéral appartenant au groupe des silicates, sous groupe des tectosilicates dans lequel il forme une famille comprenant des aluminosilicates hydratés de métaux des groupes 1 et 2 du tableau périodique des éléments, de composition proche de celle des argiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "027da3df-e139-4399-9b13-ca3606f01d3c",
                                "sense_id": "0592729b-fe3b-3612-9974-82a423e426bf",
                                "text": "Nous ne nous arrêtons qu'une minute pour ramasser sur le bord de la rivière quelques échantillons de zéolithe, et le froid rendant l'ardeur aux chevaux , la caravane se remet en marche."
                            },
                            {
                                "example_id": "5acc91ee-b3ac-45fc-9e6b-086c7f13f7d6",
                                "sense_id": "0592729b-fe3b-3612-9974-82a423e426bf",
                                "text": "Toutes les autres conditions étant égales, les formations argilo-siliceuses, argilo-loessiques ou molassiques, plus riches en zéolithes et sels minéraux podzolisent plus lentement et donnent des podzols moins prononcés que les formations sablonneuses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78119d32-43af-4350-8558-0ae3944923e6",
                        "source_entry_id": "c173a380-d845-3074-862d-55bd593bd6b2",
                        "source_sense_id": "0592729b-fe3b-3612-9974-82a423e426bf",
