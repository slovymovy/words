                "senses": [
                    {
                        "sense_id": "1b4d4c30-cc1d-3c53-b3c3-d00ad5768caa",
                        "entry_id": "072e6c20-f855-3b4d-9e06-7fe0b2943736",
                        "glosses": [
                            "die Inbesitznahme von körperlichen Gütern oder geistigen Werten; das Erreichen von Zielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fc559c0-1409-4c9c-8505-11c9b9103a47",
                                "sense_id": "1b4d4c30-cc1d-3c53-b3c3-d00ad5768caa",
                                "text": "„Als Zusammenschluss gilt einerseits die Fusion, andererseits die Erlangung der Kontrolle über ein Unternehmen (Art. 3 Abs. 1 FKVO).“"
                            },
                            {
                                "example_id": "e3244df9-9c74-4450-8f65-4c3689505762",
                                "sense_id": "1b4d4c30-cc1d-3c53-b3c3-d00ad5768caa",
                                "text": "„Über die Erlangung von Prestige und die Verteilung von Geschenken sicherten sie sich also kriegerische Macht, oder anders gesagt, Reichtümer wurden in Gewaltmittel konvertiert.“"
                            },
                            {
                                "example_id": "84d2398d-47a5-4bb9-a5e8-f597541c2249",
                                "sense_id": "1b4d4c30-cc1d-3c53-b3c3-d00ad5768caa",
                                "text": "„Er selbst setzt die Ziele und strebt im Rahmen dieser seiner Sinn- und Zielgebung danach, die äußeren Einflüsse für die Erlangung seiner Ziele nutzbar zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
