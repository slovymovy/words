        "nl-extract.jsonl": [
            {
                "entry_id": "3ca7b198-6b4d-349f-95ef-ec51884c0c20",
                "word": "mooiprater",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "b8fc6616-d30f-4f8d-9ade-e7f74e410c53",
                        "entry_id": "3ca7b198-6b4d-349f-95ef-ec51884c0c20",
                        "tags": [
                            "plural"
                        ],
                        "form": "mooipraters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4eac5ac5-2dcd-32e3-8268-9bc5a302280f",
                        "entry_id": "3ca7b198-6b4d-349f-95ef-ec51884c0c20",
                        "glosses": [
                            "iemand die uit eigenbelang, met vriendelijke praatjes, zaken mooier en beter voorstelt dan ze in werkelijkheid zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24a6a9e7-d56b-4958-ae6c-87848b4f57f4",
                                "sense_id": "4eac5ac5-2dcd-32e3-8268-9bc5a302280f",
                                "text": "Het is schering en inslag: keurig geklede personen die met een mooi verhaal geld aan vooral bejaarde vrouwen ontfutselen. In Hengelo was het drie keer achter elkaar raak en werden vrouwen van 85, 82 en 79 jaar slachtoffer van een mooiprater."
                            },
                            {
                                "example_id": "b35a5533-1b9f-4011-a984-35433d2eb2de",
                                "sense_id": "4eac5ac5-2dcd-32e3-8268-9bc5a302280f",
                                "text": "Er werden foto’s uit de oude doos getoond en beelden van het huwelijk van Elisabeth en Stijn Saelens in een kasteel in Frankrijk. ‘Stijn kon het goed uitleggen. Een mooiprater. Hij had geen respect voor mensen’, zegt Van Poucke. ‘Toch bleef André hem beschouwen als zijn zoon.’"
                            },
                            {
                                "example_id": "81f43cd3-86ac-4934-a8c7-8cd672234a24",
                                "sense_id": "4eac5ac5-2dcd-32e3-8268-9bc5a302280f",
                                "text": "Een opgewonden Turkse schreeuwlelijk die hier landjepik probeert te spelen en onze eigen Polderlandse mooipraters die woensdag zoveel mogelijk blauwe stoeltjes willen veroveren op het Binnenhof."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0052fbd-9d34-45d7-a96e-b4f43f724e6c",
                        "source_entry_id": "3ca7b198-6b4d-349f-95ef-ec51884c0c20",
                        "source_sense_id": "4eac5ac5-2dcd-32e3-8268-9bc5a302280f",
                        "target_lang_word": "fawner",
