                        ],
                        "form": "сачка́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f52dee81-56d2-3dd0-aa50-bc81b5047f41",
                        "entry_id": "f5797383-3106-3ad0-b917-bdde3ebb6516",
                        "glosses": [
                            "жарг. бездельник, лодырь"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2b8b6d97-d478-3d39-83a9-511e9743aa96",
                        "entry_id": "f5797383-3106-3ad0-b917-bdde3ebb6516",
                        "glosses": [
                            "воен. матрос, ловивший гильзы от снарядов на морском флоте сачком и ничем более на корабле не занимавшийся. Источник программа \\\"Что? Где? Когда?\\\" на Первом канале от 15 октября 2011 г., вопрос от телезрителя знатокам."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70b0e34b-0586-48d4-918c-652a367735d4",
                        "source_entry_id": "f5797383-3106-3ad0-b917-bdde3ebb6516",
                        "target_lang_word": "Faulenzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Faulenzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "158c104b-27ff-388d-b373-c8a83f67ce89",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "eine faule Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a7f2623-8713-45a3-89d6-ae6469fd9d4a",
                                                "sense_id": "158c104b-27ff-388d-b373-c8a83f67ce89",
                                                "text": "„Will dieser Faulenzer etwa den ganzen Tag im Bett bleiben?“"
                                            },
                                            {
                                                "example_id": "f148d6ce-b2b1-4990-949e-97eb522be881",
                                                "sense_id": "158c104b-27ff-388d-b373-c8a83f67ce89",
                                                "text": "„Dabei war Paris einmal die Stadt der Boheme und der Langschläfer, der großen Denker an Café-Tischen und der Faulenzer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6efab29e-5ec9-326f-ab04-b9f51d46bc95",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Unterlage, um auf unliniertem Blatt gerade schreiben zu können"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6c76b3c-5c6f-4d03-aef1-4ba36c430ac4",
                                                "sense_id": "6efab29e-5ec9-326f-ab04-b9f51d46bc95",
                                                "text": "„V. erklärte, er benötige zur Abfassung des Testamentes Papier und einen »Faulenzer«, worauf Dechant R. noch angab, wo Papier und Faulenzer zu finden seien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "425c4d44-898c-3a9b-a0ea-b50f49bfd1d2",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Leine als Hilfe beim Segelbergen, die vom Mast zum Baum gespannt ist"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0a44abe-82f6-481a-86e2-ac9ac6d3ef40",
                                                "sense_id": "425c4d44-898c-3a9b-a0ea-b50f49bfd1d2",
                                                "text": "Der Faulenzer ist die vom Mast zum Baum gespannte Leine, die verhindern soll, dass ein Segel während des Bergens über Bord geht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0be80a08-2c51-3967-a5fc-e1ad18ff0076",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Übersetzung eines fremdsprachigen Textes"
                                        ],
                                        "tags": [
                                            "Schülersprache ab 1900"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0f1085f9-7272-3024-8564-e8516c9ea509",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Strich über den Buchstaben m und n, der anzeigt, dass dieser Buchstabe als doppelt geschrieben gelten soll"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f2a45d25-ac07-3142-841e-41e2f63eb52b",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Hilfsmittel für Berechnungen, etwa Rechenschieber oder Buch mit Tabellen für Umrechnungen oder für Ähnliches"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "1582b448-be8e-390b-b7be-86f8e9df0208",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Schraube am Hinterrad eines Fahrrads, die das Aufsteigen erleichtert"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "70092dc5-e734-30ee-905b-d3ee00def9e1",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "bequeme Sitzgelegenheit, etwa Lehnstuhl, Couch oder Liegestuhl"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "d065b2cd-0207-3781-b749-d15424d8952d",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Etui, in dem verschiedene Schreibutensilien wie Stifte, Lineal, Radiergummi oder Tintenpatronen ungeordnet aufbewahrt werden"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45e7de56-4193-4df3-bca6-644f1df34159",
                                                "sense_id": "d065b2cd-0207-3781-b749-d15424d8952d",
                                                "text": "„Beim Herausgehen aus der Klasse musste sie ohnedies am Platz von Chris vorbei. Der war so ins Gespräch mit Paul vertieft, dass sie den zusammengefalteten Zettel unbemerkt in den Faulenzer stecken konnte, der noch offen auf dem Tisch lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "22eda61d-0d24-3e24-99ea-efc003118f73",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Metallgestell mit Kippfunktion, in das ein Bembel gestellt wird, damit man ihn bequem so weit kippen kann, dass das Einschenken des Inhalts in Gläser mühelos möglich ist"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eeedaa5-595a-4bc9-8647-9c4cb6dbb277",
                                                "sense_id": "22eda61d-0d24-3e24-99ea-efc003118f73",
                                                "text": "„Zum Glück brauchte er nicht nachzubestellen, denn sofort füllte ihm der Schankmeister aus dem Bembel, der im Faulenzer stand, nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11fc1c89-35a8-4de3-ab9e-10695c4bbb6e",
                        "source_entry_id": "f5797383-3106-3ad0-b917-bdde3ebb6516",
                        "target_lang_word": "Müßiggänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Müßiggänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d69acea-3f4b-3786-95b1-506d64623104",
                                        "entry_id": "9699b566-b593-39d1-8c29-e24775d6afff",
                                        "glosses": [
                                            "Person, die keiner Arbeit nachgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5757199c-6e92-4fba-b88f-17abb84cabab",
                                                "sense_id": "4d69acea-3f4b-3786-95b1-506d64623104",
                                                "text": "„Dann brachte sie alle Müßiggänger auf den Weg nach San Giobbe, um die Geschichte von der Heldin selbst zu hören.“"
                                            },
                                            {
                                                "example_id": "1f578327-4519-4d0a-9c3f-6fa10b77c6a1",
                                                "sense_id": "4d69acea-3f4b-3786-95b1-506d64623104",
                                                "text": "„Grausamkeit ist Luxus für Müßiggänger, wie Rauschgifte und seidene Hemden.“"
                                            },
                                            {
                                                "example_id": "b7ada99a-e2ba-42f8-b614-49a2b75d009c",
                                                "sense_id": "4d69acea-3f4b-3786-95b1-506d64623104",
                                                "text": "„Mr. Dayton versprach ihm das auch und schritt gleich darauf, durch die ihm Bahn machende Menge, mit Sander an seiner Seite in der Richtung zum eigenen Haus, während der Konstabler, von einem großen Haufen Müßiggänger gefolgt, den jungen Bootsmann in das Gefängnis brachte und ihn dort seinen eigenen Betrachtungen überließ.“"
                                            },
                                            {
                                                "example_id": "6e9890f9-4209-4045-a865-124650a11b4d",
                                                "sense_id": "4d69acea-3f4b-3786-95b1-506d64623104",
                                                "text": "„Er hatte diesmal keinen Müßiggänger vor sich, sondern einen Mann, der sich auskannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8440adcf-6b12-4f9b-ac3b-17a423a3363d",
                        "source_entry_id": "f5797383-3106-3ad0-b917-bdde3ebb6516",
                        "target_lang_word": "Nichtstuer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nichtstuer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ceb62a2c-5861-3e50-9828-52d73ab92328",
                                        "entry_id": "e452b5db-6363-38ef-9978-0e536d925bc6",
                                        "glosses": [
                                            "Person, die nichts tut, keiner sinnvollen Beschäftigung nachgeht"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8e837cc-c0fe-4996-915d-7ba2d13fcc3c",
                                                "sense_id": "ceb62a2c-5861-3e50-9828-52d73ab92328",
                                                "text": "„Das war ein dicker Franzose, ein ungebildeter träger Nichtstuer; man sieht jedoch bei einem Franzosen gern darüber hinweg und prüft selten seinen inneren Wert, wenn er sich gut benimmt, anständig kleidet, bei Tisch heiter ist, die Mädchen liebt und sich den Freuden der Tafel verschreibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d384d110-54bb-483c-bffe-56be09896ed8",
                        "source_entry_id": "f5797383-3106-3ad0-b917-bdde3ebb6516",
                        "target_lang_word": "Tagedieb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tagedieb",
