                "senses": [
                    {
                        "sense_id": "7a2f2949-082b-334c-ab1a-fe1ede465364",
                        "entry_id": "619c672e-e614-3042-b434-23b3acec0206",
                        "glosses": [
                            "Pflanze, die ganz oder teilweise im Wasser wächst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1e98a6e-9f60-4393-bc82-c17a45434091",
                                "sense_id": "7a2f2949-082b-334c-ab1a-fe1ede465364",
                                "text": "„Bei Hydrophyten (Wasserpflanzen) sind die Spaltöffnungen reduziert oder liegen in der oberen Epidermis.“"
                            },
                            {
                                "example_id": "6d353de9-10b7-4faa-b15c-0bb12fc40f2e",
                                "sense_id": "7a2f2949-082b-334c-ab1a-fe1ede465364",
                                "text": "„Einziger echter neuer Hydrophyt (Wasserpflanze) mit nennenswerten Anteilen in Deutschland ist die Kanadische Wasserpest.“"
                            },
                            {
                                "example_id": "90ac0098-34f9-44a6-badf-02c6b8638a61",
                                "sense_id": "7a2f2949-082b-334c-ab1a-fe1ede465364",
                                "text": "„In Bezug auf den Wasserfaktor der Umgebung bauen die Xerophyten, Hygrophyten und Hydrophyten spezifische Blatttypen auf.“"
                            },
                            {
                                "example_id": "dd6740fe-c0ba-43bb-903b-b34be59b0e3b",
                                "sense_id": "7a2f2949-082b-334c-ab1a-fe1ede465364",
                                "text": "„Diese Plastizität der Blattmorphologie erhöht die Überlebenschancen der Hydrophyten unter den Bedingungen von stark schwankenden Wasserständen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
