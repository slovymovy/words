                        "glosses": [
                            "Qui présente une dilatation anormale, en parlant d’un vaisseau ou d’un organe creux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69b88a16-d5ec-4cb5-86e6-dd1224f83836",
                                "sense_id": "38386f99-5d73-3da6-9f05-1f5a95c4183d",
                                "text": "L’urographie révèle un système pyélocaliciel droit légèrement ectasique et un uretère droit atone."
                            },
                            {
                                "example_id": "bd318f78-e44b-4b51-8c53-13568600dddf",
                                "sense_id": "38386f99-5d73-3da6-9f05-1f5a95c4183d",
                                "text": "L’hyperplasie glandulaire simple correspond à l’augmentation des glandes endométriales à la lumière tantôt ectasique tantôt rectiligne ou « angulaire », mais toujours séparées par un chorion cytogène abondant."
                            }
                        ]
                    },
