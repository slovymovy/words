                    {
                        "translation_id": "db39b525-7fd1-49d4-9e52-3990f23961f6",
                        "source_entry_id": "85c9dad3-15c6-38f4-89af-917357c0c76b",
                        "target_lang_word": "vapid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vapid",
