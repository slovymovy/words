                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a46f0410-a1aa-4136-8ae5-3b9413008854",
                                "sense_id": "c2c72558-3f4f-3010-93b1-e37147db97e8",
                                "text": "Ne craignez point de faire la disserteuse, ne craignez point de joindre aux grâces de votre personne la force de votre esprit."
                            },
                            {
                                "example_id": "3d894f45-6dac-4c23-8a25-3adf0eab75fc",
                                "sense_id": "c2c72558-3f4f-3010-93b1-e37147db97e8",
                                "text": "Par voie de conséquence, il ne lui serait possible que de poser à l’élégant disserteur mondain, inapte à fournir autre chose que des formulations critiques, voire méchantes’: il n’y aurait, au vrai, aucune autre possibilité."
                            }
                        ]
