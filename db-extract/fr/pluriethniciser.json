                "senses": [
                    {
                        "sense_id": "5ff95266-d9a0-35b0-9787-f466ac973d3c",
                        "entry_id": "c9243934-3d97-3460-8ac0-322a90f2b3f6",
                        "glosses": [
                            "Donner un caractère pluriethnique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2945ebfd-d19c-43c2-ba83-dc1e09f49be4",
                                "sense_id": "5ff95266-d9a0-35b0-9787-f466ac973d3c",
                                "text": "Cela jusqu'à créer des univers pluriethnicisés, segmentés et conflictuels, dont Tom Wolfe a bien démonté les mécanismes dans son roman Bloody Miami, version terminale du cauchemar américain."
                            },
                            {
                                "example_id": "b2e7baa5-d2d2-486a-8ca5-0b92b73b4e36",
                                "sense_id": "5ff95266-d9a0-35b0-9787-f466ac973d3c",
                                "text": "Les niches économiques, la territorialisation de celles-ci et l'encastrement des relations sociales et économiques montrent que le fonctionnement est complexe et ne se résume plus à un ethnicisation des niches, car celles-ci ont tendance à se pluriethniciser (transports, restauration, services) tout en gardant une stratégie propre de fonctionnement réticulaire."
                            }
                        ]
                    }
