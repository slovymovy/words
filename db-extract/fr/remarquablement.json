        "fr-extract.jsonl": [
            {
                "entry_id": "bd587606-8cc5-3225-b209-c8b6f737e0fd",
                "word": "remarquablement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "73e79eb0-718d-3c4a-81b5-f06b029637f5",
                        "entry_id": "bd587606-8cc5-3225-b209-c8b6f737e0fd",
                        "glosses": [
                            "D’une manière remarquable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa7aafc4-9f83-4667-ac36-b67bc622ed7a",
                                "sense_id": "73e79eb0-718d-3c4a-81b5-f06b029637f5",
                                "text": "Aussi, lorsque, après avoir franchi une porte vitrée immense, donnant sur un vestibule un peu moins vaste que le Square du temple, nous nous engageâmes dans un large escalier aux marches déclives, usées et traîtresses, mais qu’une rampe remarquablement ciselée aidait à gravir sans péril, je me contentai, toujours prudent, d’admirer l’élégante rampe en silence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9cc89b8-f63a-4197-a394-eb7cb355e493",
                        "source_entry_id": "bd587606-8cc5-3225-b209-c8b6f737e0fd",
                        "source_sense_id": "73e79eb0-718d-3c4a-81b5-f06b029637f5",
                        "target_lang_word": "bemerkenswert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bemerkenswert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94ffa72b-78cb-3cef-b299-2b0cc7252b97",
                                        "entry_id": "0d36f4ef-8248-3c68-b6be-20b181ba95c0",
                                        "glosses": [
                                            "Aufmerksamkeit verdienend; so beschaffen, dass es bemerkt werden sollte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae41f0ca-9191-4435-ad3e-ef351447a668",
                                                "sense_id": "94ffa72b-78cb-3cef-b299-2b0cc7252b97",
                                                "text": "Auf der Tagung wurde ein bemerkenswerter Vortrag gehalten."
                                            },
                                            {
                                                "example_id": "9018703d-8a7e-4d28-ab5a-fffc7c683747",
                                                "sense_id": "94ffa72b-78cb-3cef-b299-2b0cc7252b97",
                                                "text": "Ein bemerkenswerte Änderung in ihrer Strategie zur Versorgung der Internationalen Raumstation ISS deutete der neue Chef Michael Griffin am 21. Juni 2005 bei einem Sponsor-Frühstück bei der „Space Transportation Association“ mit Sitz in Maryland an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef8d69f9-d97b-446f-94d4-a1619ee164ad",
                        "source_entry_id": "bd587606-8cc5-3225-b209-c8b6f737e0fd",
