                "senses": [
                    {
                        "sense_id": "fb9ce9b4-7501-3784-9d72-4f9ebdf3a0be",
                        "entry_id": "c366b9bf-8ef2-306c-a1f1-70611f659881",
                        "glosses": [
                            "Haltung/Bereitschaft/Handlungsweise, die in deutlichem Maße ein verantwortliches und nachdenkendes Verhalten zeigt, bei dem eine Person bereit ist, die Konsequenzen zu tragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce596edd-4a06-4a45-b9f0-365ed4aa806f",
                                "sense_id": "fb9ce9b4-7501-3784-9d72-4f9ebdf3a0be",
                                "text": "Ihr Bereitschaft zur Verantwortungsübernahme ist nicht sehr ausgeprägt."
                            },
                            {
                                "example_id": "9548f1dd-20bd-45c3-be74-2f29101d6dd8",
                                "sense_id": "fb9ce9b4-7501-3784-9d72-4f9ebdf3a0be",
                                "text": "„Die ‚Verantwortungsübernahme‘, wie sie in dem ritualisierten öffentlichen Rücktritt von Vorständen nach ‚Fehlentscheidungen‘ erfolgen, stellt insofern keine überzeugende Erledigung des kriminologisch relevanten Konflikts dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
