                                "target_senses": [
                                    {
                                        "sense_id": "787e0103-63b1-3f1f-9fba-7a6a8ee22f94",
                                        "entry_id": "ac0f0c54-3054-3074-8ac4-44059e08b65d",
                                        "glosses": [
                                            "Méthode d’envoi de message consistant à placer un message dans une bouteille ou un récipient étanche et de le confier au hasard des vagues, dans l’espoir qu’une personne le lise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e84ee6-df4d-4ff3-b44b-168a778dc8a8",
                                                "sense_id": "787e0103-63b1-3f1f-9fba-7a6a8ee22f94",
                                                "text": "Le naufragé a été retrouvé grâce à son envoi de bouteilles à la mer."
                                            },
                                            {
                                                "example_id": "2b11958b-626f-483a-8e4f-2f1397efee3e",
                                                "sense_id": "787e0103-63b1-3f1f-9fba-7a6a8ee22f94",
                                                "text": "La Hollande est parmi les plaines les plus célèbres. Elle se situe dix mètres au-dessous du niveau de la mer, si bien que les épaves qui, partout, viennent d’en bas à la marée haute, tombent ici sur la plage de dix mètres de haut, menaçant la vie des promeneurs. C’est pourquoi il est interdit au large des côtes de Hollande, de jeter des bouteilles à la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8ce0249-5153-312d-9ff0-f833824b178a",
                                        "entry_id": "ac0f0c54-3054-3074-8ac4-44059e08b65d",
                                        "glosses": [
                                            "Petite annonce."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39ce462f-9f44-4718-ba49-56c961664d8d",
                                                "sense_id": "f8ce0249-5153-312d-9ff0-f833824b178a",
                                                "text": "Dans cet espace insolite du Web découvert grâce à une émission de télévision, les jumelles, âgées de 37 ans, ont jeté une bouteille à la mer cybernétique pour essayer de trouver l’âme sœur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
