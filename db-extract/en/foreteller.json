                                            {
                                                "example_id": "1489fefe-7047-4d0f-b156-456ef6507521",
                                                "sense_id": "96e9bafb-9776-399c-b9a7-c564f912697d",
                                                "text": "Zajmował się różnymi procederami, był sutenerem, fałszerzem pieniędzy, wróżbiarzem, magikiem i złodziejem, a zacierał za sobą ślady tak biegle, że policja karać go mogła co najwyżej za zuchwalstwo"
                                            }
