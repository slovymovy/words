                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dense storm clouds began to <w>adumbrate</w> the sunlit valley."
                        },
                        {
                            "text": "Looming mountains <w>adumbrated</w> the small village during the cold winter months."
