                                        "entry_id": "ee37a825-8575-3fed-846b-5ec2c8220e74",
                                        "glosses": [
                                            "Nebenmeer des Pazifischen Ozeans zwischen Australien, Neuguinea, den Salomon-Inseln und Vanuatu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d57261f-d171-4455-b67a-bcff3764215f",
                                                "sense_id": "61eccc9d-e6d4-3a97-a0a7-53959ea7efe5",
                                                "text": "„Rund um Australien bilden sich zwischen November und April ebenfalls tropische Zyklone: Diese entstehen vor allem in der Arafurasee und gefährden besonders das Northern Territory und den Norden von Western Australia, außerdem in der Korallensee.“"
                                            },
                                            {
                                                "example_id": "5793f478-34ad-4deb-8bed-4d8940f7a15f",
                                                "sense_id": "61eccc9d-e6d4-3a97-a0a7-53959ea7efe5",
                                                "text": "„Die Hafenstadt Port Moresby befindet sich im südöstlichen Teil der Insel Neuguinea an der Südküste der Korallensee.“"
                                            },
                                            {
                                                "example_id": "79783f1f-c200-4ff1-8656-7cdbd9f39633",
                                                "sense_id": "61eccc9d-e6d4-3a97-a0a7-53959ea7efe5",
                                                "text": "„Im Gegensatz zum Nordpazifik verlaufen die Bahnen der tropischen Wirbelstürme, die im Südpazifik entstehen, fast ausschließlich westlich von 160° Ost (durch Polynesien, Melanesien, die Korallensee, den Golf von Carpentaria und die Arafurasee).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
