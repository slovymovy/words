                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "post",
                                "target_lang_sense_clarification": "vertical upright of a goal"
                            },
                            {
                                "target_lang_word": "goalpost",
                                "target_lang_sense_clarification": "upright post supporting the crossbar"
                            },
                            {
                                "target_lang_word": "upright",
                                "target_lang_sense_clarification": "vertical post of a goal"
                            }
                        ]
                    }
                }
            ]
        }
    ]
