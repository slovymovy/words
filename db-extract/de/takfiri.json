                "senses": [
                    {
                        "sense_id": "1f4db62f-e276-3672-8ae8-dac33f71686d",
                        "entry_id": "8434f45b-7e29-3858-b510-700b7c32c5db",
                        "glosses": [
                            "Person muslimischen Glaubens (zumeist sunnitischer Konfession), die eine andere Person gleichen Glaubens (gleicher oder anderer Konfession) der Apostasie bezichtigt (diese als vogelfrei erklärt und nicht vor Gewaltanwendungen zurückschrickt)"
                        ],
                        "tags": [
                            "islamische Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "2a5dec6c-57c9-40b0-b420-cfdf05b692ff",
                                "sense_id": "1f4db62f-e276-3672-8ae8-dac33f71686d",
                                "text": "„Die Takfiris akzeptieren ausnahmslos die Scharia.“"
                            },
                            {
                                "example_id": "effa5e9f-62d0-40ef-aa2a-3e56e22aa533",
                                "sense_id": "1f4db62f-e276-3672-8ae8-dac33f71686d",
                                "text": "„Alternativ könnte die Ideologie als ‚Takfirismus‘ bezeichnet werden: Die Takfiri erklären andersdenke Muslime zu Abtrünnigen, die getötet werden können.“"
                            },
                            {
                                "example_id": "2224390e-df19-4d00-bfc1-d659f9d38b5a",
                                "sense_id": "1f4db62f-e276-3672-8ae8-dac33f71686d",
                                "text": "„Ein sunnitischer Religionsführer sagte ‚Al-Hayat‘, dass die Gruppen, die die sunnitischen Provinzen zerstörten, Terroristen und Takfiris seien. Takfiri ist die Bezeichnung für die islamischen Fundamentalisten, die andere Muslime zu Ungläubigen erklären.“"
                            },
                            {
                                "example_id": "2e790690-b6db-4fee-b65e-3af66a573517",
                                "sense_id": "1f4db62f-e276-3672-8ae8-dac33f71686d",
                                "text": "„Trotz des ihnen widerfahrenen Unrechts lässt Abu Hussein nichts auf seine alten sunnitischen Nachbarn kommen. ‚Sie haben uns gebeten zu bleiben und versprachen uns, uns zu schützen. Einige weinten sogar, als wir losfuhren‘, sagt er. Er macht extremistische Sunniten, so genannte Takfiri, für seine Vertreibung verantwortlich.“"
                            },
                            {
                                "example_id": "bebf733d-3aa5-47ce-929a-8fa3982c01ed",
                                "sense_id": "1f4db62f-e276-3672-8ae8-dac33f71686d",
                                "text": "„Und er legte besonderen Nachdruck darauf, mir zu sagen, dass Meliani ein ganz Strenger war. Ein Takfiri.“"
                            },
                            {
                                "example_id": "e2633aa9-3403-40d1-8551-9aedb333b526",
                                "sense_id": "1f4db62f-e276-3672-8ae8-dac33f71686d",
                                "text": "„Diese sich islamisch legitimierenden Terroristen sind nicht nur […]Djihadisten, sondern darüber hinaus auch Takfiri, d. h. muslimische Fanatiker, die andersdenkende Muslime zu Ungläubigen erklären, sie ins Visier nehmen und töten; sie halten sich für die ‚true believers‘ (Eric Hofer) des Islam.“"
                            },
                            {
                                "example_id": "e49f96ef-264e-44d8-8c25-8428d7eb98d6",
                                "sense_id": "1f4db62f-e276-3672-8ae8-dac33f71686d",
                                "text": "„Außerdem können andere Muslime, die nicht der eigenen extremistischen Lesart des Islams folgen, zu ‚Takfiris‘ - Ketzern - erklärt werden, die genauso erbittert bekämpft werden müssen.“"
                            },
                            {
                                "example_id": "1dbdc43f-242e-49b3-b5c9-f20aaa866a7d",
                                "sense_id": "1f4db62f-e276-3672-8ae8-dac33f71686d",
                                "text": "„Er berichtete von einem Treffen gewaltbereiter Takfiri in Casablanca am kommenden Samstag.“"
                            },
                            {
                                "example_id": "c9628852-00f1-4c41-87ce-329d9312ca1d",
                                "sense_id": "1f4db62f-e276-3672-8ae8-dac33f71686d",
                                "text": "„Takfiris gehen davon aus, dass alle anderen Muslime ungläubig sind.“"
                            },
                            {
                                "example_id": "29c573e5-3d5b-4799-8297-3757709b29f4",
                                "sense_id": "1f4db62f-e276-3672-8ae8-dac33f71686d",
                                "text": "„Den Vorwurf seiner libanesischen Gegner, sein Engagement in Kusair ziehe das Land in den syrischen Strudel, kehrte Nasrallah um, indem er sagte, der Hizbullah beschütze Libanon und dessen konfessionellen Frieden vor dem Ansturm der «Takfiri». Mit diesem Ausdruck werden diejenigen sunnitischen Extremisten bezeichnet, die all jene, die nicht ihrer religiösen Überzeugung folgen, als Ungläubige verdammen und damit zum Abschuss freigeben. Die Takfiri seien zu Tausenden nach Syrien geströmt, meinte Nasrallah warnend, und hätten vor, nach dem Fall von Damaskus auch Libanon einzunehmen. Sie bedrohten alle Libanesen, Christen wie Muslime, sagte der Hizbullah-Chef und führte den Irak an, wo die Takfiri in den Jahren der amerikanischen Besetzung zahlreiche sunnitische Geistliche und Stammesführer umgebracht hätten. Falls Syrien und Libanon an die Takfiri falle, werde auch Israel wieder nach Libanon eindringen, sagte er voraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
