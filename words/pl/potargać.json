{
    "word_family": [
        "targać",
        "roztargać",
        "stargać",
        "wytargać",
        "zatargać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4fc726c2-ef81-33aa-b56a-dccd75a8db9e",
                    "sense_definition": "uczynić coś splątanym lub zwichrzonym, zwłaszcza włosy lub sierść",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "splatanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Silny wiatr na plaży zupełnie <w>potargał</w> moje długie włosy.",
                            "target_lang_translations": {
                                "en": "The strong wind on the beach completely <w>messed up</w> my long hair."
                            }
                        },
                        {
                            "text": "Dziadek podszedł do wnuka i pieszczotliwie <w>potargał</w> go po głowie.",
                            "target_lang_translations": {
                                "en": "Grandfather went over to his grandson and affectionately <w>ruffled</w> his hair."
                            }
                        }
                    ],
                    "synonyms": [
                        "poczochrać",
                        "pokudłać",
                        "rozczochrać",
                        "rozmierzwić",
                        "rozwichrzyć"
                    ],
                    "common_phrases": [
                        "potargać włosy",
                        "potargać na wietrze"
                    ],
                    "target_lang_definitions": {
                        "en": "to make something tangled or disheveled, especially hair or fur"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ruffle",
                                "target_lang_sense_clarification": "hair or fur"
                            },
                            {
                                "target_lang_word": "tousle",
                                "target_lang_sense_clarification": "make hair untidy"
                            },
                            {
                                "target_lang_word": "mess up",
                                "target_lang_sense_clarification": "hair"
                            },
                            {
                                "target_lang_word": "dishevel",
                                "target_lang_sense_clarification": "hair or appearance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfd5eb3f-8ad4-385f-97eb-9f0271217b3a",
                    "sense_definition": "rozerwać, podrzeć na kawałki lub uszkodzić coś przez szarpanie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "niszczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pies w zabawie <w>potargał</w> ważną gazetę leżącą na stoliku.",
                            "target_lang_translations": {
                                "en": "While playing, the dog <w>shredded</w> an important newspaper that was lying on the table."
                            }
                        },
                        {
                            "text": "Zahaczył o ostry gwóźdź w płocie i <w>potargał</w> nową kurtkę.",
                            "target_lang_translations": {
                                "en": "He caught on a sharp nail in the fence and <w>tore</w> his new jacket."
                            }
                        }
                    ],
                    "synonyms": [
                        "roztargać"
                    ],
                    "common_phrases": [
                        "potargać spodnie",
                        "potargać kartkę"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często używane w języku potocznym w znaczeniu podarcia ubrania lub papieru"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to tear, rip into pieces, or damage something by pulling or yanking"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tear",
                                "target_lang_sense_clarification": "clothes, paper, etc."
                            },
                            {
                                "target_lang_word": "rip",
                                "target_lang_sense_clarification": "tear apart or damage"
                            },
                            {
                                "target_lang_word": "shred",
                                "target_lang_sense_clarification": "tear into strips or pieces"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcdd4422-8062-3b8e-9fed-b3de86083785",
                    "sense_definition": "dźwignąć lub przenieść z trudem coś bardzo ciężkiego",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noszenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przez brak windy ledwo <w>potargałem</w> te ciężkie walizki na czwarte piętro.",
                            "target_lang_translations": {
                                "en": "Because there was no elevator, I barely managed to <w>lug</w> those heavy suitcases up to the fourth floor."
                            }
                        },
                        {
                            "text": "Sąsiad sam <w>potargał</w> masywną pralkę do piwnicy i teraz bolą go plecy.",
                            "target_lang_translations": {
                                "en": "The neighbor <w>hauled</w> the massive washing machine to the basement by himself, and now his back hurts."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane potocznie w odniesieniu do dźwigania"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to haul, lug, or carry something heavy with great effort"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lug",
                                "target_lang_sense_clarification": "carry heavy objects with difficulty"
                            },
                            {
                                "target_lang_word": "haul",
                                "target_lang_sense_clarification": "pull or drag something heavy"
                            },
                            {
                                "target_lang_word": "drag",
                                "target_lang_sense_clarification": "pull along with effort"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3765b6f9-0cc3-3590-bf74-4d3b2cac23fd",
                    "sense_definition": "szarpać, ciągnąć lub tarmosić coś lub kogoś przez pewien czas",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "szarpanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chwilę <w>potargał</w> za klamkę, ale zamek ani drgnął.",
                            "target_lang_translations": {
                                "en": "He <w>jiggled</w> the door handle for a moment, but the lock wouldn't budge."
                            }
                        },
                        {
                            "text": "Zanim pies puścił stary but, jeszcze trochę nim <w>potargał</w> po podłodze.",
                            "target_lang_translations": {
                                "en": "Before the dog let go of the old shoe, it <w>shook</w> it across the floor a bit more."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to jerk, pull, or shake something or someone repeatedly for a while"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jiggle",
                                "target_lang_sense_clarification": "repeatedly yank or shake slightly"
                            },
                            {
                                "target_lang_word": "tug",
                                "target_lang_sense_clarification": "pull or jerk repeatedly for a while"
                            },
                            {
                                "target_lang_word": "shake",
                                "target_lang_sense_clarification": "wobble or yank violently"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}