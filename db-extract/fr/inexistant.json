                ],
                "senses": [
                    {
                        "sense_id": "496d91d0-5c5b-34b7-9e1a-a81954ddd84e",
                        "entry_id": "5aa5ed45-5aad-34c0-ab67-07dc48f8cbe0",
                        "glosses": [
                            "Qui n’existe pas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48777081-77d1-44c2-b455-b0d79934a1b9",
                                "sense_id": "496d91d0-5c5b-34b7-9e1a-a81954ddd84e",
                                "text": "Gabriel Fauré disait de la musique que son écriture comme son audition entraînaient un « désir de choses inexistantes »."
                            },
                            {
                                "example_id": "1f94f78a-cebc-4dd2-8534-b65f61a19058",
                                "sense_id": "496d91d0-5c5b-34b7-9e1a-a81954ddd84e",
                                "text": "Cet état de fait singulier interpella aussitôt le jeune homme : soit Diana était de mèche avec le géant et jouait un rôle pour mieux tromper Germaine de Picou-Sinbrac, soit elle était atteinte d’une double personnalité qui lui permettait de psychosomatiser des maux inexistants."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7713727-0f88-3962-9d27-626ac7590064",
                        "entry_id": "5aa5ed45-5aad-34c0-ab67-07dc48f8cbe0",
                        "glosses": [
                            "Dont l’existence, dont la nature est sans valeur."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "dfd4de4f-29d9-4b91-b5a0-667e76642a57",
                                "sense_id": "d7713727-0f88-3962-9d27-626ac7590064",
                                "text": "Non contents d'être inexistants eux-mêmes, les gens voulaient encore annihiler sa personnalité à lui, réglementer ses idées, enrayer l'indépendance de ses actes..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "259b7e2f-d3ed-4580-99ab-3771d01f7185",
                        "source_entry_id": "5aa5ed45-5aad-34c0-ab67-07dc48f8cbe0",
                        "target_lang_word": "non-existent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "non-existent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "924c1b14-8068-3a7f-a010-f9afef633103",
                                        "entry_id": "bfda67c6-39a1-3558-93d7-0e9efc0dd150",
                                        "glosses": [
                                            "Alternative spelling of nonexistent."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e960bbb-ad6e-4f50-9701-9cf25d553921",
                                                "sense_id": "924c1b14-8068-3a7f-a010-f9afef633103",
                                                "text": "Roads were practically non-existent and travel was undertaken mainly by water, streams and rivers providing the only practical routes."
                                            },
                                            {
                                                "example_id": "617a0ceb-5d20-4ea6-88e7-2e9e0146675a",
                                                "sense_id": "924c1b14-8068-3a7f-a010-f9afef633103",
                                                "text": "It is hardly surprising, therefore, that the present rail passenger service is meagre and between Wetherby and Church Fenton almost non-existent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
