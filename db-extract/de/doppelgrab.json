                "senses": [
                    {
                        "sense_id": "5d241179-fc65-3beb-9a62-1412d690d0b0",
                        "entry_id": "3006bfee-e96a-3505-addd-51937ea6982a",
                        "glosses": [
                            "Grab, in dem zwei Personen bestattet sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59e6f8ed-3f39-46db-ad77-82d483f014d7",
                                "sense_id": "5d241179-fc65-3beb-9a62-1412d690d0b0",
                                "text": "[5. Februar 2007:] „Bei Erdarbeiten in Norditalien wird ein Doppelgrab aus der Jungsteinzeit entdeckt.“"
                            },
                            {
                                "example_id": "7be25415-1d50-4eaf-92fa-8db75cd679ae",
                                "sense_id": "5d241179-fc65-3beb-9a62-1412d690d0b0",
                                "text": "„Die Idee zum Doppelgrab bekam meine Mutter wohl von Rely.“"
                            },
                            {
                                "example_id": "f1166cec-3654-4cf9-9108-f400de896d14",
                                "sense_id": "5d241179-fc65-3beb-9a62-1412d690d0b0",
                                "text": "„Schenk werde in den kommenden Tagen im engsten Freundeskreis beigesetzt, sagt Klemmer. Er [wird] seine letzte Ruhe in einem Doppelgrab neben seiner Frau finden.“"
                            },
                            {
                                "example_id": "793a72f6-0302-4575-837f-443c21209aa3",
                                "sense_id": "5d241179-fc65-3beb-9a62-1412d690d0b0",
                                "text": "„»Ich habe meine Frau hier vor vier Jahren beerdigt, und wie es für eine Ehepaar üblich ist, haben wir ein Doppelgrab.«“"
                            },
                            {
                                "example_id": "9e718eda-a0df-4550-ad62-6a13ea14eaa4",
                                "sense_id": "5d241179-fc65-3beb-9a62-1412d690d0b0",
                                "text": "[S-Bahnhof in Berlin-Wannsee:] „Nicht weit von dort ist das Doppelgrab von Henriette Vogel und Heinrich von Kleist.“"
                            },
                            {
                                "example_id": "b2e9b864-a22b-4ccc-9fc9-b8485d537b8a",
                                "sense_id": "5d241179-fc65-3beb-9a62-1412d690d0b0",
                                "text": "„Metallenes Eichenlaub ziert die eisernen Grabtafeln der beiden 1893 gefallenen Deutschen. „Sargeant Louis Wrede geb. 2. März 1868 gest. 2. Okt. 1893“ und der „Gefreite W. Sakolowski geb. 14. Sept. 1869 gest. 12. April 1893“. Das Doppelgrab ist mit weißen Steinen bedeckt, die in der Sonne glitzern.“"
                            },
                            {
                                "example_id": "61696a15-41bf-46eb-a265-cf7a79fe442c",
                                "sense_id": "5d241179-fc65-3beb-9a62-1412d690d0b0",
                                "text": "„Neben dem offenen Doppelgrab steht ein Holztischchen mit einer Flasche Sliwowitz und einem halben Dutzend Gläschen.“"
                            },
                            {
                                "example_id": "e7618dd0-f377-4b4a-8ceb-cb3a67419ee3",
                                "sense_id": "5d241179-fc65-3beb-9a62-1412d690d0b0",
                                "text": "„Schon der Gärtnerlehrling lernt [, …] dass auf einem Einzelgrab 15 Prozent der Fläche mit Blühpflanzen bedeckt sein sollten und auf einem Doppelgrab ungefähr 25 Prozent.“"
                            },
                            {
                                "example_id": "15c68ac5-270c-4dcc-b23f-a95fdb2bd7a7",
                                "sense_id": "5d241179-fc65-3beb-9a62-1412d690d0b0",
                                "text": "[Bonn:] „Aber schon viel länger lebten hier Menschen: Das älteste Doppelgrab am Venusberg stammt aus der Zeit um 4080 v. Chr.“"
                            },
                            {
                                "example_id": "ddd04da2-8eca-4b7e-9e58-333fa28f1f60",
                                "sense_id": "5d241179-fc65-3beb-9a62-1412d690d0b0",
                                "text": "„Noch bevor man das Kloster ʿAin Muṣṭafā Kāschif vom Friedhof el-Bagawāt kommend erreicht, stößt man auf ein spätkoptisches Doppelgrab aus dem 9. oder 10. Jahrhundert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
