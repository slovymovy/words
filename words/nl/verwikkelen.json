                        "verwikkeld in een proces"
                    ],
                    "target_lang_definitions": {
                        "pl": "Być wplątanym w jakąś sprawę w sposób zagmatwany lub uciążliwy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "być uwikłanym",
                                "target_lang_sense_clarification": "znajdować się w trudnej, skomplikowanej sytuacji"
                            },
                            {
                                "target_lang_word": "być wplątanym",
                                "target_lang_sense_clarification": "uczestniczyć w czymś nieprzyjemnym lub kontrowersyjnym"
                            }
                        ]
                    }
                }
