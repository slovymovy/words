                ],
                "translations": [
                    {
                        "translation_id": "fa6b4012-3b7e-4f22-a5e0-543d0e408486",
                        "source_entry_id": "249d6272-37af-3164-8828-5547240da5b9",
                        "target_lang_word": "носик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "носик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "53db8fe0-f4b1-3665-a50a-b3f8d03cf5a1",
                                        "entry_id": "1fece7f1-750e-3efa-8be5-ad35c8153b47",
                                        "glosses": [
                                            "разг. уменьш.-ласк. к нос"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44944b7b-8687-4bbd-b965-328747d8adc0",
                                                "sense_id": "53db8fe0-f4b1-3665-a50a-b3f8d03cf5a1",
                                                "text": "Из комнаты вышел Алик, заметно подросший, бледное веснушчатое создание лет одиннадцати в очках на тонком носике."
                                            },
                                            {
                                                "example_id": "36751c12-f524-4507-bd22-bd453a9569c3",
                                                "sense_id": "53db8fe0-f4b1-3665-a50a-b3f8d03cf5a1",
                                                "text": "Околоцветник простой, венчикообразный; плод на верхушке с более или менее длинным, перистым носиком."
                                            },
                                            {
                                                "example_id": "f053d64c-f105-479e-812f-840e5ebf106d",
                                                "sense_id": "53db8fe0-f4b1-3665-a50a-b3f8d03cf5a1",
                                                "text": "Леночка трагически морщит носик, сдвигает подрисованные бровки."
                                            },
                                            {
                                                "example_id": "a6bb1cf3-cca1-4468-93be-f186d09b60b5",
                                                "sense_id": "53db8fe0-f4b1-3665-a50a-b3f8d03cf5a1",
                                                "text": "Чёрные как смоль, гладко причёсанные волосы оттеняли свежее молодое личико с вздёрнутым носиком и хитрыми блестящими, весёленькими глазками."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98bf8fcc-5a8e-348e-a85d-4764e96e629c",
                                        "entry_id": "1fece7f1-750e-3efa-8be5-ad35c8153b47",
                                        "glosses": [
                                            "разг. выступающая часть сосуда, предназначенная для выливания жидкости"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8441109d-9128-4dfe-84dc-a612ab31d20a",
                                                "sense_id": "98bf8fcc-5a8e-348e-a85d-4764e96e629c",
                                                "text": "Я поднял чайник и почувствовал, что он переполнен, потому что из носика выплеснулась струйка."
                                            },
                                            {
                                                "example_id": "21683392-1331-4173-8a3f-f2bdea63e6ea",
                                                "sense_id": "98bf8fcc-5a8e-348e-a85d-4764e96e629c",
                                                "text": "У дверей, где над шайкой висел глиняный рукомойник с носиком."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0c7d3ba-78cc-320a-8f69-4dec722cfac4",
