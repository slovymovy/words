{
    "word_family": [
        "vergelding",
        "vergeldend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ebbd9e5e-ed7d-343f-a4f0-12e7af83bda0",
                    "sense_definition": "wraak nemen voor een onrecht of vijandige daad; betaald zetten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wraak_nemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iran gaat cyberaanvallen van de VS <w>vergelden</w>.",
                            "target_lang_translations": {
                                "en": "Iran is going to <w>retaliate</w> against cyberattacks from the US."
                            }
                        },
                        {
                            "text": "Zij besloten de aanval onmiddellijk te <w>vergelden</w> met een tegenaanval.",
                            "target_lang_translations": {
                                "en": "They decided to <w>retaliate</w> against the attack immediately with a counterattack."
                            }
                        }
                    ],
                    "synonyms": [
                        "wreken",
                        "afstraffen",
                        "revancheren"
                    ],
                    "antonyms": [
                        "vergeven"
                    ],
                    "common_phrases": [
                        "een aanval vergelden",
                        "met gelijke munt vergelden"
                    ],
                    "target_lang_definitions": {
                        "en": "To take revenge for an injustice or hostile act; to retaliate or pay back."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "retaliate",
                                "target_lang_sense_clarification": "to respond to an attack or injury with a similar one"
                            },
                            {
                                "target_lang_word": "avenge",
                                "target_lang_sense_clarification": "to take vengeance for an injustice or wrong"
                            },
                            {
                                "target_lang_word": "repay",
                                "target_lang_sense_clarification": "to pay back a wrong or hostile act"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2779eae1-fed5-3482-abd3-81e5503d7278",
                    "sense_definition": "een ontvangen weldaad of dienst belonen of goedmaken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "belonen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik hoop dat ik jouw vriendelijkheid ooit op een dag kan <w>vergelden</w>.",
                            "target_lang_translations": {
                                "en": "I hope that I can <w>repay</w> your kindness one day."
                            }
                        },
                        {
                            "text": "Zij wilde zijn goede daden met dankbaarheid <w>vergelden</w>.",
                            "target_lang_translations": {
                                "en": "She wanted to <w>reciprocate</w> his good deeds with gratitude."
                            }
                        }
                    ],
                    "synonyms": [
                        "vergoeden",
                        "compenseren",
                        "belonen",
                        "goedmaken"
                    ],
                    "common_phrases": [
                        "goeds met goeds vergelden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Often used in formal or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To reward, return, or make up for a received kindness, benefit, or service."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "repay",
                                "target_lang_sense_clarification": "to return a favor, kindness, or service"
                            },
                            {
                                "target_lang_word": "reciprocate",
                                "target_lang_sense_clarification": "to give or feel something in return for a gesture or kindness"
                            },
                            {
                                "target_lang_word": "reward",
                                "target_lang_sense_clarification": "to give something in return for a good deed or service"
                            },
                            {
                                "target_lang_word": "compensate",
                                "target_lang_sense_clarification": "to make up for or balance out a service or favor"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}