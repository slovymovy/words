                        "examples": [
                            {
                                "example_id": "4c45e5b2-ce53-4d0e-8053-7fcf411aceb2",
                                "sense_id": "9f418a85-4b4f-3a96-b093-8abf287ab996",
                                "text": "She told me she'd love me and I told her I'd do the same / Then I OD'd in Denver and I just can't remember her name"
                            },
                            {
                                "example_id": "fcff13e6-3bba-4763-a29e-a794b03a7b7f",
                                "sense_id": "9f418a85-4b4f-3a96-b093-8abf287ab996",
                                "text": "‘My brother,[…], is at Radley, on account of my parents thinking it a bad idea to have us both at the same school.’\n‘On account of your being twins?’ said Adrian.\n‘Right, on account of my mother OD-ing on fertility drugs.[…]’"
                            }
                        ]
                    }
