                "senses": [
                    {
                        "sense_id": "d6fa218d-a218-36f9-820e-c804eb73bafa",
                        "entry_id": "f00cb019-cf75-362b-8774-2df43ae5f866",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e81fcb6-7e5b-4a90-b0e0-47e75a98d489",
                                "sense_id": "d6fa218d-a218-36f9-820e-c804eb73bafa",
                                "text": "Frau Pawelka ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "14faeef1-d649-4afb-bed5-101f0a297fc9",
                                "sense_id": "d6fa218d-a218-36f9-820e-c804eb73bafa",
                                "text": "Herr Pawelka wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2bc0d4b0-ab8e-4901-aeac-049956d38bc1",
                                "sense_id": "d6fa218d-a218-36f9-820e-c804eb73bafa",
                                "text": "Die Pawelkas kommen heute aus dem Spreewald."
                            },
                            {
                                "example_id": "8e177274-ef96-4583-ae1e-3098fbbed5df",
                                "sense_id": "d6fa218d-a218-36f9-820e-c804eb73bafa",
                                "text": "Der Pawelka trägt nie die Schals, die die Pawelka ihm strickt."
                            },
                            {
                                "example_id": "10078715-89f1-4aaa-b30d-2f63a15e9799",
                                "sense_id": "d6fa218d-a218-36f9-820e-c804eb73bafa",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pawelka kommt, geht der Herr Pawelka.“"
                            },
                            {
                                "example_id": "234b6c3f-baa3-4c30-8c31-f49763997738",
                                "sense_id": "d6fa218d-a218-36f9-820e-c804eb73bafa",
                                "text": "Pawelka kommt und geht."
                            },
                            {
                                "example_id": "3ebdea06-83be-419b-8ffd-9685e8bb0c0c",
                                "sense_id": "d6fa218d-a218-36f9-820e-c804eb73bafa",
                                "text": "Pawelkas kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
