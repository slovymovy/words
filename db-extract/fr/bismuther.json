                        "entry_id": "12f5a6f9-2a41-3065-a814-9ff36e21b77c",
                        "glosses": [
                            "Traiter par le bismuth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68552a4f-d0f5-4c0d-b5df-dd5f34a8d5f6",
                                "sense_id": "22caf384-e484-3558-91da-329fac5cfaed",
                                "text": "Les objets à bismuther sont plongés dans ce bain à la température ordinaire, en employant un faible courant."
                            },
                            {
                                "example_id": "1265a61d-4242-4290-9fca-c4592ab4db6b",
                                "sense_id": "22caf384-e484-3558-91da-329fac5cfaed",
                                "text": "Ou peut-être même, n'est-il pas destiné à vieillir comme certains vins qui doivent être bus sans attendre sous peine de se bismuther ou de devenir aigres comme du vinaigre."
                            }
                        ]
                    }
