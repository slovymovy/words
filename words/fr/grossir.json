                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as tendance à <w>grossir</w> les problèmes au lieu de chercher des solutions.",
                            "target_lang_translations": {
                                "en": "You tend to <w>exaggerate</w> problems instead of looking for solutions.",
                                "ru": "Тебе свойственно <w>преувеличивать</w> проблемы, вместо того чтобы искать решения.",
                                "de": "Du neigst dazu, Probleme zu <w>übertreiben</w>, statt nach Lösungen zu suchen.",
                                "es": "Tienes tendencia a <w>exagerar</w> los problemas en lugar de buscar soluciones.",
                                "zh": "你总是喜欢<w>夸大</w>问题，而不去寻找解决办法。"
                            }
