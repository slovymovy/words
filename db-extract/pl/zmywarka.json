                                "target_senses": [
                                    {
                                        "sense_id": "9f3b2793-29d6-3462-9629-b5cf223176f8",
                                        "entry_id": "4170b418-ad3a-3d02-a6b2-e1d365f68eb4",
                                        "glosses": [
                                            "Küchengerät, das Geschirr reinigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "793e6d05-0410-40e4-99b0-d009e2fcfe76",
                                                "sense_id": "9f3b2793-29d6-3462-9629-b5cf223176f8",
                                                "text": "Ein Geschirrspüler kann bei mangelnder Wartung schnell verkalken."
                                            },
                                            {
                                                "example_id": "0a29ea9b-d1d6-4796-ba17-860def106ee6",
                                                "sense_id": "9f3b2793-29d6-3462-9629-b5cf223176f8",
                                                "text": "„Meine Hände zitterten, als ich Teller und Tassen in den Geschirrspüler räumte, mitten in der Bewegung anhielt und alles wieder auf den Tisch stellte.“"
                                            },
                                            {
                                                "example_id": "bd549b8b-75a0-4a92-b46e-3f36ea78e7c5",
                                                "sense_id": "9f3b2793-29d6-3462-9629-b5cf223176f8",
                                                "text": "„Zum völligen Entsetzen von Elena schneidet Klaus sogar die Tetrapaks auf und stellt sie in den Geschirrspüler, bevor er sie in die Wertstofftonne wirft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
