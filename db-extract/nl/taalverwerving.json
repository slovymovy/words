                "translations": [
                    {
                        "translation_id": "147e28cc-b309-4092-9140-eccbb6f6a42b",
                        "source_entry_id": "01f6f763-b605-3206-a680-4f017d060333",
                        "source_sense_id": "62fa841a-a12a-3b76-ad98-0947bf01f632",
                        "target_lang_word": "Spracherwerb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spracherwerb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ed57fd6-5877-3946-a48f-e3bf5a157796",
                                        "entry_id": "ffb44e81-2e3f-3c95-961d-4f0f07a793f6",
                                        "glosses": [
                                            "Erlernen einer Sprache, entweder als Muttersprache oder als Fremd- oder Zweitsprache."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21960ed1-56a4-48b9-b832-c32b06b667ab",
                                                "sense_id": "1ed57fd6-5877-3946-a48f-e3bf5a157796",
                                                "text": "Mit Spracherwerb ist gemeint, dass jemand alle Einheiten und Regeln der betreffenden Sprache erlernen kann."
                                            },
                                            {
                                                "example_id": "d9f45014-3ce1-4c2d-b454-b0de8aa52c26",
                                                "sense_id": "1ed57fd6-5877-3946-a48f-e3bf5a157796",
                                                "text": "Unter Spracherwerb werden sehr verschiedene Dinge zusammengefasst: Der spontane (natürliche) Erwerb der Muttersprache und evt. einer Zweitsprache (dies, falls nächste Verwandte verschiedensprachig sind) einerseits und andererseits der spätere, bewusste Erwerb einer Fremdsprache, der etwa von der Pubertät an in der Regel nicht mehr spontan erfolgt."
                                            },
                                            {
                                                "example_id": "d83daf6c-322f-4102-bbea-fca0efb5a53c",
                                                "sense_id": "1ed57fd6-5877-3946-a48f-e3bf5a157796",
                                                "text": "„Unter Spracherwerb versteht man ganz allgemein den Vorgang, wie Menschen Sprache(n) zu verstehen und zu sprechen lernen; seien es Fremdsprachen, Fachsprachen. Gruppensprachen oder künstliche Sprachen. Der Spracherwerb des Kindes, von dem in diesem Arbeitsheft die Rede ist, bezeichnet das Erlernen einer ersten Sprache (‚first language acquisition‘).“"
                                            },
                                            {
                                                "example_id": "c945ba4c-13c8-42cc-bdbf-0d1f0afb6754",
                                                "sense_id": "1ed57fd6-5877-3946-a48f-e3bf5a157796",
                                                "text": "„Dabei spielen Fragen des Spracherwerbs (des Erwerbs der Regeln) eine wichtige Rolle.“"
                                            },
                                            {
                                                "example_id": "f603f9b6-fe5c-4e87-bd8b-06797d24a3b6",
                                                "sense_id": "1ed57fd6-5877-3946-a48f-e3bf5a157796",
                                                "text": "„Der Spracherwerb von Kindern ist bekanntlich ein wichtiger Prüfstein für den explanativen Gehalt einer jeden Grammatiktheorie.“"
                                            },
                                            {
                                                "example_id": "4e2fe14c-fa04-47a9-ade0-1b2f85e9951a",
                                                "sense_id": "1ed57fd6-5877-3946-a48f-e3bf5a157796",
                                                "text": "„Schon beim Spracherwerb zeigen sich ja Regularitäten, und zwar gerade in den vielen Fehlern, die Kinder machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
