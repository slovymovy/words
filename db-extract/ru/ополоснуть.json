                        "source_sense_id": "6410f0dc-928c-3b34-a956-f939f9104166",
                        "target_lang_word": "rincer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rincer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3a49b50-095d-381a-a53b-376deb953aa9",
                                        "entry_id": "d0e8523c-850b-331e-8656-b1e184a0421e",
                                        "glosses": [
                                            "Nettoyer, laver et en frottant, en parlant des bouteilles, des verres, des tasses et de quelques autres vases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d48a894-d734-40d8-aade-4b27b609d965",
                                                "sense_id": "b3a49b50-095d-381a-a53b-376deb953aa9",
                                                "text": "Rincez ces verres."
                                            },
                                            {
                                                "example_id": "3c2f626b-2384-4a2f-baa2-1abdc7ece5c0",
                                                "sense_id": "b3a49b50-095d-381a-a53b-376deb953aa9",
                                                "text": "Il faut rincer cette cruche, cette bouteille."
                                            },
                                            {
                                                "example_id": "687109d6-5011-4ac5-8cfa-a28d0241f7ce",
                                                "sense_id": "b3a49b50-095d-381a-a53b-376deb953aa9",
                                                "text": "Se rincer la bouche, laver sa bouche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ab277a9-7fde-3f7a-a835-8c254ef9e938",
                                        "entry_id": "d0e8523c-850b-331e-8656-b1e184a0421e",
                                        "glosses": [
                                            "Faire un dernier lavage dans de l’eau sans savon, éventuellement à un pH non neutre, comme dernière opération pour évacuer les agents de nettoyage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea5f7b8-9a52-48c5-816d-323e4e9b976f",
                                                "sense_id": "3ab277a9-7fde-3f7a-a835-8c254ef9e938",
                                                "text": "Après lui avoir massé le cuir chevelu pendant une bonne minute, elle lui remit la tête sous le jet en s'attachant à ne pas crisper les doigts pendant qu'elle le rinçait."
                                            },
                                            {
                                                "example_id": "758027bb-595e-49ba-b486-6e1a220360db",
                                                "sense_id": "3ab277a9-7fde-3f7a-a835-8c254ef9e938",
                                                "text": "Rincer du linge, de la vaisselle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1c20d7b-5440-37b0-b0a2-28f457de85b4",
                                        "entry_id": "d0e8523c-850b-331e-8656-b1e184a0421e",
                                        "glosses": [
                                            "Laver, se désaltérer, humecter, boire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e39be35c-2768-407b-953c-48a3a8aea0ed",
                                                "sense_id": "b1c20d7b-5440-37b0-b0a2-28f457de85b4",
                                                "text": "Se rincer la bouche, se laver la bouche avec un liquide que l'on recrache."
                                            },
                                            {
                                                "example_id": "db4538b1-4bf1-4eba-8a42-271c0f61733b",
                                                "sense_id": "b1c20d7b-5440-37b0-b0a2-28f457de85b4",
                                                "text": "Se rincer le gosier, se rincer la dalle, boire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fe0cc89-76e8-32ab-8f19-631f32f431e0",
                                        "entry_id": "d0e8523c-850b-331e-8656-b1e184a0421e",
                                        "glosses": [
                                            "Frapper quelqu'un, lui administrer une bastonnade, une rincée."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a47fa341-eee4-4877-93ea-572584c2a5b4",
                                                "sense_id": "8fe0cc89-76e8-32ab-8f19-631f32f431e0",
                                                "text": "Si je voulais parler, je la ferais rincer par son mari, qui n'entendrait pas raillerie. , Bibliothèque de la Pléiade, Tome 1, p. 552."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a88c701a-388e-330e-8350-1d8b48d6cc2a",
                                        "entry_id": "d0e8523c-850b-331e-8656-b1e184a0421e",
                                        "glosses": [
                                            "Offrir à boire à quelqu'un, payer à sa place sa consommation"
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2355173e-701b-4654-9ec8-d062dd60f56d",
                                                "sense_id": "a88c701a-388e-330e-8350-1d8b48d6cc2a",
                                                "text": "On rentre dans le club habillés comme des princes\nFresh, fresh, fresh en jeans ou en pinces\nMets toi bien, ce soir c'est moi qui rince\nSi tu danses à la Carlton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad20b98e-a4d6-39ef-bcbb-7c711866da80",
                                        "entry_id": "d0e8523c-850b-331e-8656-b1e184a0421e",
                                        "glosses": [
                                            "Voler, dérober."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8c727f3-7b3c-4c99-b9ee-c0c86ebb6ae8",
                                                "sense_id": "ad20b98e-a4d6-39ef-bcbb-7c711866da80",
                                                "text": "Un jour, des malfaiteurs, enhardis par ce silence, crurent assez légèrement pouvoir rincer la caisse de ce Juif."
                                            },
                                            {
                                                "example_id": "96951002-d3ba-4aef-9cad-d759fcdd7721",
                                                "sense_id": "ad20b98e-a4d6-39ef-bcbb-7c711866da80",
                                                "text": "Rincer une cabriole veut dire dévaliser une chambre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "add70cfb-f828-3f78-9424-936e9f7e9dd6",
                                        "entry_id": "d0e8523c-850b-331e-8656-b1e184a0421e",
                                        "glosses": [
                                            "Fatiguer, exténuer, épuiser."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bc022c9-ea9c-4cae-9ec2-3fa7347beba0",
                                                "sense_id": "add70cfb-f828-3f78-9424-936e9f7e9dd6",
                                                "text": "Ce week-end avec vous m’a rincée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rincer",
