    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d4150acf-ab19-3b99-849d-56968107553e",
                    "sense_definition": "A person or group that receives an advantage or profit from something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recipient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local community was the primary <w>beneficiary</w> of the new park project.",
                            "target_lang_translations": {
                                "ru": "Местное сообщество стало основным <w>выгодополучателем</w> от проекта нового парка.",
                                "tr": "Yeni park projesinin ana <w>faydalanıcısı</w> yerel halk oldu."
                            }
                        },
                        {
                            "text": "You are the lucky <w>beneficiary</w> of this special offer which includes a free upgrade.",
                            "target_lang_translations": {
                                "ru": "Вы — счастливый <w>получатель</w> этого специального предложения, которое включает бесплатное обновление.",
                                "tr": "Ücretsiz yükseltme içeren bu özel teklifin şanslı <w>yararlananı</w> sizsiniz."
                            }
                        }
                    ],
                    "synonyms": [
                        "recipient",
                        "receiver"
                    ],
                    "antonyms": [
                        "maleficiary"
                    ],
                    "common_phrases": [
                        "primary beneficiary",
                        "intended beneficiary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо или группа лиц, получающих выгоду или прибыль от чего-либо.",
                        "tr": "Bir şeyden avantaj, fayda veya kar sağlayan kişi veya grup."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бенефициар",
                                "target_lang_sense_clarification": "лицо, извлекающее выгоду"
                            },
                            {
                                "target_lang_word": "выгодополучатель",
                                "target_lang_sense_clarification": "тот, кто получает пользу"
                            },
                            {
                                "target_lang_word": "получатель",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "faydalanıcı",
                                "target_lang_sense_clarification": "genel anlamda yarar sağlayan"
                            },
                            {
                                "target_lang_word": "yararlanan",
                                "target_lang_sense_clarification": "fayda gören kişi"
                            },
                            {
                                "target_lang_word": "hak sahibi",
                                "target_lang_sense_clarification": "avantaj elde eden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a1cb1ec-4b75-3b5e-a89e-cadfcc423d7c",
                    "sense_definition": "A person designated to receive money or property from a trust, will, or legal estate.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_recipient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer explained that each <w>beneficiary</w> would receive an equal share of the estate.",
                            "target_lang_translations": {
                                "ru": "Адвокат объяснил, что каждый <w>наследник</w> получит равную долю имущества.",
                                "tr": "Avukat, her <w>mirasçının</w> terekeden eşit pay alacağını açıkladı."
                            }
                        },
                        {
                            "text": "He named his sister as the sole <w>beneficiary</w> of his will to ensure she was provided for.",
                            "target_lang_translations": {
                                "ru": "Он назначил свою сестру единственным <w>бенефициаром</w> в своем завещании, чтобы обеспечить её будущее.",
                                "tr": "Geleceğinin güvence altında olmasını sağlamak için kız kardeşini vasiyetnamesinin tek <w>lehine vasiyet edileni</w> olarak belirledi."
                            }
                        }
                    ],
                    "synonyms": [
                        "heir",
                        "inheritor",
                        "legatee"
                    ],
                    "common_phrases": [
                        "sole beneficiary",
                        "named beneficiary"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, назначенное для получения денежных средств или имущества из траста, по завещанию или в рамках наследства.",
                        "tr": "Bir vakıf, vasiyetname veya miras yoluyla para ya da mülk almak üzere belirlenmiş kişi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наследник",
                                "target_lang_sense_clarification": "по завещанию"
                            },
