                    {
                        "translation_id": "cf3782db-d27b-447e-835d-2570f75f99b3",
                        "source_entry_id": "189858dc-8718-376b-b086-67920e26ca65",
                        "source_sense_id": "2efac479-2662-3a52-b60d-11948c8a3fa8",
                        "source_sense_description": "a female equestrian",
                        "target_lang_word": "вса́дница",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вса́дница",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2e320f35-35a8-3a0c-95d3-79db6d9dda88",
                                        "entry_id": "e6d00df4-014f-3838-8b64-878961672d91",
                                        "glosses": [
                                            "женск. к всадник; женщина, сидящая или едущая верхом на лошади, скакуне"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f027400f-d512-43a1-a0fa-cec58c7799f1",
                                                "sense_id": "2e320f35-35a8-3a0c-95d3-79db6d9dda88",
                                                "text": "По дороге приближался всадник на коне. Нет, всадница, разглядел Харченко. С интересом дожидался приближения."
                                            },
                                            {
                                                "example_id": "cfed07a7-f807-4b66-bd3d-515a27855706",
                                                "sense_id": "2e320f35-35a8-3a0c-95d3-79db6d9dda88",
                                                "text": "Между прочим, нынешний чемпион Европы ― немецкая всадница на лошади из Латвии."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1f7ddf1-90ac-4c1d-9caf-2450977883a1",
