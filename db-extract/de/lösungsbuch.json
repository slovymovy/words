                "senses": [
                    {
                        "sense_id": "deb1e9d9-9fda-394d-ab3d-4751399ccdda",
                        "entry_id": "13f91d2e-bbe3-3fe1-9719-b3a59362ca18",
                        "glosses": [
                            "Buch, das Anleitungen und Tipps zum Durchspielen von Videospielen enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94daf6d9-b196-4956-a8c6-c40368966d32",
                                "sense_id": "deb1e9d9-9fda-394d-ab3d-4751399ccdda",
                                "text": "„Im September erschien der letzte Teil der Trilogie – „Shadow of the Tomb Raider“ und nun ist zur Freude aller Gamer auch das Lösungsbuch für das Spiel da.“"
                            },
                            {
                                "example_id": "8b07e11e-ae18-4353-b7f1-e6024b37b12f",
                                "sense_id": "deb1e9d9-9fda-394d-ab3d-4751399ccdda",
                                "text": "„Wahre Fans kommen an der extrem schicken Collector's Edition des Spiels und des offiziellen Lösungsbuchs aber nicht vorbei.“"
                            },
                            {
                                "example_id": "d9d121e5-27a0-42b2-88a5-e8bc3657f5cc",
                                "sense_id": "deb1e9d9-9fda-394d-ab3d-4751399ccdda",
                                "text": "„Wer die Apokalypse in all ihren Feinheiten genießen möchte, greift daher zum Lösungsbuch.“"
                            },
                            {
                                "example_id": "5c1c75ea-ef4f-4c35-9ebd-9c9ce4fa0c06",
                                "sense_id": "deb1e9d9-9fda-394d-ab3d-4751399ccdda",
                                "text": "„Ja sogar für Entwickler gehört es zum guten Ton, ganze Lösungsbücher zu veröffentlichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
