                    {
                        "translation_id": "d5681517-effa-4b54-ad9e-1e462ce1567a",
                        "source_entry_id": "78001fed-d3eb-3a8c-9b8d-ca0fd6352326",
                        "source_sense_description": "the mountain range separating Spain from France",
                        "target_lang_word": "Pyrénées",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pyrénées",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d30376b-8f2f-3065-8c17-4a5d8c92be9c",
                                        "entry_id": "a928afd4-5a54-33ae-b7da-f277f56c9cbb",
                                        "glosses": [
                                            "Chaîne de montagnes séparant la France et l’Espagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68f34d2d-6c3d-446a-bde5-2497501308ab",
                                                "sense_id": "5d30376b-8f2f-3065-8c17-4a5d8c92be9c",
                                                "text": "Au XIIIᵉ siècle, la montagne Noire et les rampes des Pyrénées étaient couvertes de forêts ; […]."
                                            },
                                            {
                                                "example_id": "04c5cc88-ba16-49cc-a8c9-f706de62e1d2",
                                                "sense_id": "5d30376b-8f2f-3065-8c17-4a5d8c92be9c",
                                                "text": "Un exemple bien connu est celui de Ramondia pyrenaica. Cette jolie plante dont les rosettes velues et les fleurs mauves ornent les roches des Pyrénées centrales et espagnoles ne se trouve au monde qu'aux Pyrénées."
                                            },
                                            {
                                                "example_id": "26cedabf-62a3-43b8-9945-aaf30df503cd",
                                                "sense_id": "5d30376b-8f2f-3065-8c17-4a5d8c92be9c",
                                                "text": "D'abord réservées aux scientifiques, les Pyrénées ont ensuite accueilli un tourisme prudent en attendant les pyrénéistes, ivres de conquêtes."
                                            },
                                            {
                                                "example_id": "b8eeb89b-24e0-4c82-89e6-72471a2e0e0f",
                                                "sense_id": "5d30376b-8f2f-3065-8c17-4a5d8c92be9c",
                                                "text": "En 2010 : champion du monde de ski-alpinisme en Vertical Race ; traversée des Pyrénées d'ouest en est, en 8 jours (ce qui signifie plus ou moins 850 kilomètres en 113 heures de course au total)."
                                            },
                                            {
                                                "example_id": "d72d0f1d-db51-49b9-b284-964e2782a3ad",
                                                "sense_id": "5d30376b-8f2f-3065-8c17-4a5d8c92be9c",
                                                "text": "Après avoir parcouru avec mes amis randonneurs le trajet d’Hendaye au cirque de Gavarnie, ensemble nous attaquons en cette année 1987 le tronçon des Pyrénées centrales qui doit nous mener vers Bagnères-de-Luchon par la HRP, le massif de la Maladeta et le pic d’Aneto, point culminant des Pyrénées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cf0980f-24f9-4a92-9d28-bf8ae18b68f5",
                        "source_entry_id": "78001fed-d3eb-3a8c-9b8d-ca0fd6352326",
                        "source_sense_description": "the mountain range separating Spain from France",
                        "target_lang_word": "Pyrenäen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pyrenäen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba70b155-ac6e-327d-9aba-0057e43f6cde",
                                        "entry_id": "0941e43c-dc98-35e4-a80c-b78ef2ec5cc0",
                                        "glosses": [
                                            "das Grenzgebirge zwischen Frankreich und Spanien"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f90552cf-71d3-40d7-aab2-2cc1d69f451a",
                                                "sense_id": "ba70b155-ac6e-327d-9aba-0057e43f6cde",
                                                "text": "„\"Pyrenäen\" - das war eine rostbraune Sache auf der sonst grünen und schwarzen Karte, darin ein paar Bergkleckse standen. … Dies waren die wissenschaftlichen Kenntnisse, die mir die deutsche Schule in Bezug auf die Pyrenäen mitgegeben hatte.“"
                                            },
                                            {
                                                "example_id": "1a3296e4-e9f8-46be-92f6-a1c4a7d5de20",
                                                "sense_id": "ba70b155-ac6e-327d-9aba-0057e43f6cde",
                                                "text": "„In den Pyrenäen war es kalt.“"
                                            },
                                            {
                                                "example_id": "468b2f92-202d-40a4-a12e-23e43fb00967",
                                                "sense_id": "ba70b155-ac6e-327d-9aba-0057e43f6cde",
                                                "text": "„Sowie er die Pyrenäen überschritten hat, folgt der Sieg dem Enkel Heinrichs IV. überall.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
