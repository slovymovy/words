                    {
                        "form_id": "2dcf4b22-fb45-44e6-a38e-d4e5133d391b",
                        "entry_id": "2d10d42c-df26-3768-ab2f-b108a020591f",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "affinitaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "661ce352-1454-320d-87c1-0a084e39d17b",
                        "entry_id": "2d10d42c-df26-3768-ab2f-b108a020591f",
                        "glosses": [
                            "Qui est associé, en raison de certaines affinités."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eedab15b-ca46-41cc-8ae7-e3a68cda8fa6",
                                "sense_id": "661ce352-1454-320d-87c1-0a084e39d17b",
                                "text": "[…] ou à construire éventuellement au sein de l’entreprise, un réseau affinitaire, fait de « connivences affectives » entre personnes."
                            }
                        ]
                    },
                    {
                        "sense_id": "ccde407a-97cc-312d-b81c-07c080e683b9",
                        "entry_id": "2d10d42c-df26-3768-ab2f-b108a020591f",
                        "glosses": [
                            "Relatif à l’affinité, à la tendance à se lier, à créer des liaisons covalentes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df6329c6-6fa3-4f04-ac3d-70ca13788d5d",
                                "sense_id": "ccde407a-97cc-312d-b81c-07c080e683b9",
                                "text": "On observe, par conséquent, que les rendements augmentent à mesure que la capacité affinitaire du groupe aminé diminue […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "b5311351-2212-3ace-b872-d1564455babc",
                        "entry_id": "2d10d42c-df26-3768-ab2f-b108a020591f",
                        "glosses": [
                            "Groupe de personnes qui est statistiquement associé, en raison d'affinités, besoins ou activités communes."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "14c4e7ec-e08a-4040-b3cf-1eccb10d0378",
                                "sense_id": "b5311351-2212-3ace-b872-d1564455babc",
                                "text": "Une assurance affinitaire est un contrat de garantie étudié pour s'adresser à un ensemble de personnes disposant d’une activité commune ou ayant un besoin commun (extension d'assurance pour le matériel électro-ménager, pour des pratiques sportives….)."
                            }
                        ]
                    },
                    {
                        "sense_id": "eaaab12f-d55b-3be5-8a09-0e57d15c4240",
                        "entry_id": "2d10d42c-df26-3768-ab2f-b108a020591f",
                        "glosses": [
                            "Se dit d’un groupe de pays qui partagent la même opinion."
                        ],
                        "tags": [
                            "Relations internationales"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55e39910-133e-498a-a134-0cc65dbdb94d",
                        "source_entry_id": "2d10d42c-df26-3768-ab2f-b108a020591f",
                        "source_sense_id": "661ce352-1454-320d-87c1-0a084e39d17b",
                        "target_lang_word": "peer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc82eabf-3130-3469-82e9-20c1dd4f05df",
                                        "entry_id": "897fdd48-3305-3ccd-bfb2-e4844ee3299a",
                                        "glosses": [
                                            "To look with difficulty, or as if searching for something."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "235b434d-1b39-496e-8c9f-a14a004c2731",
                                                "sense_id": "dc82eabf-3130-3469-82e9-20c1dd4f05df",
                                                "text": "[…] I should be still / Plucking the grass, to know where sits the wind, / Peering in maps for ports, and piers, and roads;"
                                            },
                                            {
                                                "example_id": "4e88ca68-8218-4d6f-9b2c-325275718b67",
                                                "sense_id": "dc82eabf-3130-3469-82e9-20c1dd4f05df",
                                                "text": "As if thro’ a dungeon grate he peer’d\nWith broad and burning face."
                                            },
                                            {
                                                "example_id": "234a74e9-beb7-4758-83ec-dec07e580a29",
                                                "sense_id": "dc82eabf-3130-3469-82e9-20c1dd4f05df",
                                                "text": "He walked slowly past the gate and peered through a narrow gap in the cedar hedge. The girl was moving along a sanded walk, toward a gray, unpainted house, with a steep roof, broken by dormer windows."
                                            },
                                            {
                                                "example_id": "8bd2f4b3-9e6e-44a1-87ad-68a32a5a1302",
                                                "sense_id": "dc82eabf-3130-3469-82e9-20c1dd4f05df",
                                                "text": "He would peek into the curtained windows, or, climbing upon the roof, peer down the black depths of the chimney in vain endeavor to solve the unknown wonders that lay within those strong walls."
                                            },
                                            {
                                                "example_id": "ed377d2d-21f2-4480-bc92-f75d8c032373",
                                                "sense_id": "dc82eabf-3130-3469-82e9-20c1dd4f05df",
                                                "text": "Long before you see the lean, handsome heads peering mildly over the half-doors of the loose boxes, you know that East Ilsley's business is training racehorses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e06ea34-95e3-37ad-a0a3-43424b985767",
                                        "entry_id": "897fdd48-3305-3ccd-bfb2-e4844ee3299a",
                                        "glosses": [
                                            "To come in sight; to appear."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "016c70da-aff7-453b-b9b4-7df87fc9f369",
                                                "sense_id": "9e06ea34-95e3-37ad-a0a3-43424b985767",
                                                "text": "And as the sun breaks through the darkest clouds, / So honour peereth in the meanest habit."
                                            },
                                            {
                                                "example_id": "646218f1-0d0d-4aa7-8ecf-b05220af017c",
                                                "sense_id": "9e06ea34-95e3-37ad-a0a3-43424b985767",
                                                "text": "I, I, let you alone, cunning Artificer! / See, hovv his gorget peeres aboue his govvne; / To tell the people, in vvhat danger he vvas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2384d7cb-c412-3086-9fed-a5fffa9cc266",
                                        "entry_id": "359de114-d8c9-3d81-83c9-a0c1006d7fe7",
                                        "glosses": [
                                            "A look; a glance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5359b2-82af-4770-a43e-5a41dc11fd03",
                                                "sense_id": "2384d7cb-c412-3086-9fed-a5fffa9cc266",
                                                "text": "Blessed are those organisers who provide one-and-all with a name tag, for then the participants will chat together. A quick peer at your neighbour's lapel is much the simplest way to become introduced […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5428e13f-8060-31c6-ac9f-469ccc1f9fbc",
                                        "entry_id": "7310d3f6-c7d0-343f-9750-8d9a697821ec",
                                        "glosses": [
                                            "Somebody who is, or something that is, at a level or of a value equal (to that of something else)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0506090-cb43-433a-96fd-1bba5f1d7245",
                                                "sense_id": "5428e13f-8060-31c6-ac9f-469ccc1f9fbc",
                                                "text": "In song he never had his peer."
                                            },
                                            {
                                                "example_id": "2eb06df7-0bc0-45ce-90bf-37e5aaf57515",
                                                "sense_id": "5428e13f-8060-31c6-ac9f-469ccc1f9fbc",
                                                "text": "Shall they draw off to their privileged quarters, and consort only with their peers?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f71b37e-ba40-3adf-a5d6-1cb19af0d809",
                                        "entry_id": "7310d3f6-c7d0-343f-9750-8d9a697821ec",
                                        "glosses": [
                                            "Someone who is approximately the same age (as someone else)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b50d5b3-beeb-3ed2-81e2-5fb3ae8a7fde",
                                        "entry_id": "7310d3f6-c7d0-343f-9750-8d9a697821ec",
                                        "glosses": [
                                            "A noble with a title, i.e., a peerage, and in times past, with certain rights and privileges not enjoyed by commoners."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c5227a1-e726-42e0-a5a4-6a3a7081dc90",
                                                "sense_id": "0b50d5b3-beeb-3ed2-81e2-5fb3ae8a7fde",
                                                "text": "a peer of the realm"
                                            },
                                            {
                                                "example_id": "5a7ed20e-2aa2-4ef2-b590-a5bdf126c598",
                                                "sense_id": "0b50d5b3-beeb-3ed2-81e2-5fb3ae8a7fde",
                                                "text": "a noble peer of mickle trust and power"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2c437e4-f6b7-370f-b276-2a175658c70c",
                                        "entry_id": "7310d3f6-c7d0-343f-9750-8d9a697821ec",
                                        "glosses": [
                                            "A comrade; a companion; an associate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3643e539-66fc-40fb-a3e5-ab088f768ac7",
                                                "sense_id": "d2c437e4-f6b7-370f-b276-2a175658c70c",
                                                "text": "He all his Peeres in beautie did surpas,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae79d2d7-dbcc-308e-81a9-c97dd040c0f9",
                                        "entry_id": "08fc87f7-3dcf-30e9-b5bb-97c60e38119c",
                                        "glosses": [
                                            "To make equal in rank."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00a14034-bb26-4e56-a9c8-1f48c7514db0",
                                                "sense_id": "ae79d2d7-dbcc-308e-81a9-c97dd040c0f9",
                                                "text": "Being now Peered with the Lord Chancellor, and the Earl of Essex."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3845c10-7f58-30fd-8db9-665f14be36b3",
                                        "entry_id": "08fc87f7-3dcf-30e9-b5bb-97c60e38119c",
                                        "glosses": [
                                            "To carry communications traffic terminating on one's own network on an equivalency basis to and from another network, usually without charge or payment. Contrast with transit where one pays another network provider to carry one's traffic."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "peer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca812257-7507-3785-854e-3f687a40f690",
                                        "entry_id": "c3567761-b06d-35b7-a937-4078b6f56405",
                                        "glosses": [
                                            "Someone who pees, someone who urinates."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5df9ad9-d92e-4777-8942-d198c8ffbd24",
                                                "sense_id": "ca812257-7507-3785-854e-3f687a40f690",
                                                "text": "As was the caveat about peeing in a pool. Of course, peeing in a pool wasn't dangerous to the person ... If you peed in a pool, and you were carrying the polio virus, presumably *other* people were put at risk, not the peer (pee-er?)."
                                            },
                                            {
                                                "example_id": "805f45a2-b570-488b-a528-86465f1df0f7",
                                                "sense_id": "ca812257-7507-3785-854e-3f687a40f690",
                                                "text": "SOunds^([sic]) like you've already broken him quite well, if he's peeing when disciplined. Pretty sad. He's not a dog, not that treating a dog like this is any better either. You've turned your child into a submissive peer."
                                            },
                                            {
                                                "example_id": "26cdb819-f4c1-48ae-9303-76691b0d87ec",
                                                "sense_id": "ca812257-7507-3785-854e-3f687a40f690",
                                                "text": "Submissive peeing, on the other hand, IS related to anxiety. But submissive peeing is not marking. A submissive peer is generally a very submissive dog."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "152935c2-89c0-4533-837c-01b7dfd4c7ff",
                        "source_entry_id": "2d10d42c-df26-3768-ab2f-b108a020591f",
                        "source_sense_id": "eaaab12f-d55b-3be5-8a09-0e57d15c4240",
                        "target_lang_word": "like-minded",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "like-minded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "950ea4c1-574b-347e-98f4-36f796b80728",
                                        "entry_id": "5936e71a-2bd9-3817-bac6-f84175a57591",
                                        "glosses": [
                                            "Of similar opinion, given to holding similar opinions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a7e1ab2-4dfd-40ed-8234-5eac3bcb3d12",
                                                "sense_id": "950ea4c1-574b-347e-98f4-36f796b80728",
                                                "text": "The like-minded politicians voted the same way so often they were thought of as one person rather than two."
                                            },
                                            {
                                                "example_id": "64e67d2f-a230-4152-80e3-c790c923b86d",
                                                "sense_id": "950ea4c1-574b-347e-98f4-36f796b80728",
                                                "text": "With the ability to network with like-minded young professionals from across the railway industry, while experiencing the history and culture of Japan and its railway network, YRTs first inter-continental tour can be deemed a great success!"
                                            },
                                            {
                                                "example_id": "df560cca-df1b-4986-9caf-b137a835c56c",
                                                "sense_id": "950ea4c1-574b-347e-98f4-36f796b80728",
                                                "text": "Even friends and advisers working with [Zohran] Mamdani’s campaign and like-minded allies on the city council, among the three dozen New York leaders who spoke with CNN, say privately that they fear Mamdani is behind in preparing for what’s ahead if he wins November’s election, as reliable public polls show he is in strong position to do."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
