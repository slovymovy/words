                    {
                        "translation_id": "1766ce66-b39e-451f-9d57-5073e5cd9798",
                        "source_entry_id": "abe143d2-4287-3800-9549-8b1dfe985969",
                        "source_sense_id": "11d49f4d-ebc3-3743-93a3-117256004bb6",
                        "target_lang_word": "Österreicher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Österreicher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4b788fe-042d-3abe-877c-24896e338b33",
                                        "entry_id": "ef7bd1a3-e353-345a-aa68-d81f1f2e57c5",
                                        "glosses": [
                                            "Staatsbürger der Republik Österreich; Angehöriger des österreichischen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01b44255-1058-488b-b50d-d49626104ff6",
                                                "sense_id": "b4b788fe-042d-3abe-877c-24896e338b33",
                                                "text": "Wir trafen auf einen Österreicher, mitten in Peru!"
                                            },
                                            {
                                                "example_id": "155d72d9-0345-49bf-8813-1b22048f7e2e",
                                                "sense_id": "b4b788fe-042d-3abe-877c-24896e338b33",
                                                "text": "„Der Österreicher versteht, was eine Tomate ist, kaum ein Deutscher hingegen weiß, was Paradeiser bedeutet oder dass Palatschinken nicht aus Fleisch besteht.“"
                                            },
                                            {
                                                "example_id": "f3082e41-a833-40bb-ac03-3f76f0e91f7f",
                                                "sense_id": "b4b788fe-042d-3abe-877c-24896e338b33",
                                                "text": "Die Österreicher haben gewählt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Österreicher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aebafd59-156d-307d-8234-aca4018d4754",
                                        "entry_id": "966ad286-ea39-3144-93cb-560da2c9521e",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63ec218a-4d39-472b-9a95-37b1e9eabcb8",
                                                "sense_id": "aebafd59-156d-307d-8234-aca4018d4754",
                                                "text": "Österreichers kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "8de2c466-974f-43a8-8420-168d6add6e54",
                                                "sense_id": "aebafd59-156d-307d-8234-aca4018d4754",
                                                "text": "Frau Österreicher ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "356dcc14-af4e-41f5-8e1c-a5d0532448bc",
                                                "sense_id": "aebafd59-156d-307d-8234-aca4018d4754",
                                                "text": "Herr Österreicher wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "8ad9f4cf-adaf-432b-95b2-505a6703ec37",
                                                "sense_id": "aebafd59-156d-307d-8234-aca4018d4754",
                                                "text": "Die Österreichers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "f3e85cd8-3e6e-48d1-9061-64232ee17499",
                                                "sense_id": "aebafd59-156d-307d-8234-aca4018d4754",
                                                "text": "Der Österreicher trägt nie die Schals, die die Österreicher ihm strickt."
                                            },
                                            {
                                                "example_id": "299e48dc-d566-41d6-9f54-f87d28f0bf5e",
                                                "sense_id": "aebafd59-156d-307d-8234-aca4018d4754",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Österreicher kommt, geht der Herr Österreicher.“"
                                            },
                                            {
                                                "example_id": "392672f1-3a97-49e4-9e10-c3832959b107",
                                                "sense_id": "aebafd59-156d-307d-8234-aca4018d4754",
                                                "text": "Österreicher kommt und geht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f18b14d-0fbd-4d58-87aa-4841285b37bc",
                        "source_entry_id": "abe143d2-4287-3800-9549-8b1dfe985969",
                        "source_sense_id": "11d49f4d-ebc3-3743-93a3-117256004bb6",
                        "target_lang_word": "Autrichien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autrichien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa5a9e2c-8f4d-3b02-b90f-f45b8eb35b30",
                                        "entry_id": "f09d4c84-e328-38fc-a419-27fce94b81ac",
                                        "glosses": [
                                            "Habitant de l’Autriche, pays d’Europe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25dedc17-217d-4251-9ffb-6f8255b8f96e",
                                                "sense_id": "aa5a9e2c-8f4d-3b02-b90f-f45b8eb35b30",
                                                "text": "Les Autrichiens s’occupent peu de politique métaphysique ; les questions de cette nature peuvent bien fixer l’attention de quelques esprits, mais la foule y attache peu d’intérêt."
                                            },
                                            {
                                                "example_id": "55d08928-8e72-4ff4-a3df-ac82715cc6bd",
                                                "sense_id": "aa5a9e2c-8f4d-3b02-b90f-f45b8eb35b30",
                                                "text": "Mais ce n’est que le commencement de plus grands malheurs : ces Prussiens, ces Autrichiens, ces Russes, ces Espagnols, et tous ces peuples que nous avons pillés depuis 1804, vont profiter de notre misère pour tomber sur nous."
                                            },
                                            {
                                                "example_id": "e92ba76b-ba19-48ae-8e39-c5cfaa91fbff",
                                                "sense_id": "aa5a9e2c-8f4d-3b02-b90f-f45b8eb35b30",
                                                "text": "Le chercheur a été récompensé, au côté de l’Américain John Clauser et de l’Autrichien Anton Zeilinger, pour ses découvertes sur l’intrication quantique. Il s'agit d’un phénomène où deux particules restent corrélées, quelle que soit la distance qui les sépare."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
