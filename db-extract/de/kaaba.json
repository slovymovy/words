                "senses": [
                    {
                        "sense_id": "967db25f-dc1b-3f7e-babf-c929b051ab5a",
                        "entry_id": "8132df48-a790-3f44-bf95-4da1d19c4096",
                        "glosses": [
                            "größtes Heiligtum des Islam"
                        ],
                        "tags": [
                            "Islam"
                        ],
                        "examples": [
                            {
                                "example_id": "dd2c5310-381a-46e4-b4c7-e72665b36686",
                                "sense_id": "967db25f-dc1b-3f7e-babf-c929b051ab5a",
                                "text": "Die Kaaba steht in Mekka und muss bei jedem Besuch gegen den Uhrzeigersinn sieben Mal umrundet werden."
                            },
                            {
                                "example_id": "6ada6ad0-85bd-4396-a98c-576ff928f382",
                                "sense_id": "967db25f-dc1b-3f7e-babf-c929b051ab5a",
                                "text": "Der schwarze Stein in der Kaaba soll ein Meteorit sein und wird im Islam als Baustein der Ur-Kaaba gesehen, die Adam als erstes Gotteshaus errichtet worden sein soll."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
