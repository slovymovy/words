                    }
                ],
                "senses": [
                    {
                        "sense_id": "9dad7dbb-5acc-37f5-a339-94a423f304c5",
                        "entry_id": "7714ec36-c456-3e73-b6b1-2b1f9c3e92c2",
                        "glosses": [
                            "зоол. крупный степной грызун из рода сурков, осень и зиму проводящий в спячке (лат. Marmota bobak)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd093800-e7e9-42b9-8261-c6fdd583183c",
                                "sense_id": "9dad7dbb-5acc-37f5-a339-94a423f304c5",
                                "text": "Так, например, ласточки и мыши, несмотря на свою плодовитость и многочисленность, изменяются очень мало, так же точно, как и байба́к, оставшийся неизменённым от Польши до Лены; суслик же, напротив, несмотря на своё сходство с байбако́м, представляет очень значительные разновидности."
                            }
                        ]
                    },
                    {
                        "sense_id": "43c5a201-3bca-3f4c-a034-2a38cc10c560",
                        "entry_id": "7714ec36-c456-3e73-b6b1-2b1f9c3e92c2",
                        "glosses": [
                            "перен., разг. неповоротливый, ленивый человек, лежебока"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaf0b1f7-2827-440a-9bc8-ccab05208614",
                                "sense_id": "43c5a201-3bca-3f4c-a034-2a38cc10c560",
                                "text": "Кто был то, что называют тюрюк, то есть человек, которого нужно было подымать пинко́м на что-нибудь; кто был просто байба́к, лежавший, как говорится, весь век на боку, которого даже напра́сно было подымать: не встанет ни в каком случае."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "895039a0-bbe3-4a11-9c56-3081471ecb6e",
                        "source_entry_id": "7714ec36-c456-3e73-b6b1-2b1f9c3e92c2",
                        "source_sense_description": "степной грызун",
                        "target_lang_word": "steppe marmot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7decb02c-ed58-48d0-811e-6b7ba1ad70af",
                        "source_entry_id": "7714ec36-c456-3e73-b6b1-2b1f9c3e92c2",
                        "source_sense_description": "ленивый человек",
                        "target_lang_word": "lazybones",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lazybones",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "818d7c42-de56-36cd-a548-1677b5d63528",
                                        "entry_id": "18391f2b-83f8-3aec-a12d-f88168c1b325",
                                        "glosses": [
                                            "A person who is lazy."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30ab6633-a973-4d2f-9b81-5cfca76e3bf2",
                                                "sense_id": "818d7c42-de56-36cd-a548-1677b5d63528",
                                                "text": "Isn't it time you got up, you lazybones?"
                                            },
                                            {
                                                "example_id": "a47b6e10-d081-41c5-83e6-cdfbd9671ac9",
                                                "sense_id": "818d7c42-de56-36cd-a548-1677b5d63528",
                                                "text": "The foremost traveller stopped and called impatiently to his companion. \"Come on, can't yer? What a lazybones yer are, Charlotte.\""
                                            },
                                            {
                                                "example_id": "e002ed92-5928-4038-b4ac-76af0910b503",
                                                "sense_id": "818d7c42-de56-36cd-a548-1677b5d63528",
                                                "text": "His father thought that there was no doubt some more suitable work to be found for him, for he who should watch hares ought to be light and smart, and no lazybones, and when the hares began to run and fly about, there would be quite another dance than hanging about the house all day doing nothing."
                                            },
                                            {
                                                "example_id": "a5acdf05-dfa2-4a73-bcb9-acb7c793aa6d",
                                                "sense_id": "818d7c42-de56-36cd-a548-1677b5d63528",
                                                "text": "How long will you lie there, O lazybones? When will you rise from your sleep?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a75de80f-d171-47bb-850a-a8bf4376ace2",
                        "source_entry_id": "7714ec36-c456-3e73-b6b1-2b1f9c3e92c2",
                        "source_sense_description": "ленивый человек",
                        "target_lang_word": "sluggard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sluggard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe18e69a-865a-3d66-afcf-a25d178e2a7e",
                                        "entry_id": "f72add4d-0cf1-3cc0-8c5b-820909c5e28d",
                                        "glosses": [
                                            "A person who is lazy, stupid, or idle by habit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8c02f44-47b7-3219-85e7-655094e67b54",
                                        "entry_id": "f72add4d-0cf1-3cc0-8c5b-820909c5e28d",
                                        "glosses": [
                                            "A person slow to begin necessary work, a slothful person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5bfe300c-8cb8-3feb-a490-f4448b1c6ad2",
                                        "entry_id": "f72add4d-0cf1-3cc0-8c5b-820909c5e28d",
                                        "glosses": [
                                            "A fearful or cowardly person, a poltroon."
                                        ],
