                    {
                        "sense_id": "c4e004f9-f487-3bec-99b1-97225259a573",
                        "entry_id": "6ba1a0e8-f25c-3c73-a5e9-9d0dd82ef0dd",
                        "glosses": [
                            "onderneming die publicaties in de vorm van gedrukte bundels papier maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48a3a279-edcc-4e91-8abd-3ccbc95ab743",
                                "sense_id": "c4e004f9-f487-3bec-99b1-97225259a573",
                                "text": "De Amerikaanse internetwinkel Amazon.com heeft de in 2000 opgerichte digitale boekdrukkerij BookSurge overgenomen. Dat bedrijf beschikt over een catalogus met duizenden titels waaruit het op aanvraag kan drukken."
                            },
                            {
                                "example_id": "e1e7b460-6b3b-4b21-8927-03f7aa817f96",
                                "sense_id": "c4e004f9-f487-3bec-99b1-97225259a573",
                                "text": "Beide uitgaven zijn uitgegeven in samenwerking met museumdrukkerij Die Haghe in Voorburg. Met deze boekdrukkerij werd tevens, in het kader van Kinder Dichter aan huis, een poëzie-affiche uitgegeven met gedichten van Jos van Hest, Karel Eykman, Johanna Kruit, Koos Meinderts en Theo Olthuis."
                            }
                        ]
                    },
                    {
                        "sense_id": "8be8c23f-0be7-34f1-ab28-4f743cfec021",
                        "entry_id": "6ba1a0e8-f25c-3c73-a5e9-9d0dd82ef0dd",
                        "glosses": [
                            "werkplaats waar publicaties in de vorm van gedrukte bundels papier worden gemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d396f78-7438-46ba-929d-1d192ef15628",
                                "sense_id": "8be8c23f-0be7-34f1-ab28-4f743cfec021",
                                "text": "De voorm. boekdrukkerij van J.H. Kok (Hofstraat 23) is gebouwd in 1908 en heeft jugendstil-decoraties."
                            },
                            {
                                "example_id": "4c50853b-f848-427a-8f52-ec5c5cbccd23",
                                "sense_id": "8be8c23f-0be7-34f1-ab28-4f743cfec021",
                                "text": "Voorstelling van een boekdrukkerij aan het begin van de negentiende eeuw (boven) en rond 1870 (onder)."
                            }
                        ]
                    },
                    {
                        "sense_id": "8797a988-a92a-33ce-be24-9f2be94ba50e",
                        "entry_id": "6ba1a0e8-f25c-3c73-a5e9-9d0dd82ef0dd",
                        "glosses": [
                            "vak van mensen die publicaties in de vorm van gedrukte bundels papier maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24b43759-b9a8-4739-94e8-018791f66611",
                                "sense_id": "8797a988-a92a-33ce-be24-9f2be94ba50e",
                                "text": "In \"De boekdrukkerij\" wordt een niet eerder gepubliceerde drukkershandleiding uit 1822 bezorgd van Johan Coenraad Zweijgardt, waarin de nadruk ligt op zogeheten formaatschema's (hoe je vellen moet vouwen)."
                            },
                            {
                                "example_id": "35894dde-3ae3-450c-80ad-853bb3931c6d",
                                "sense_id": "8797a988-a92a-33ce-be24-9f2be94ba50e",
                                "text": "Van oudsher waren de boekdrukkerij en de plaatdrukkerij, wegens de aanwending van geheel verschillende druktechnieken (respectievelijk hoog- en diepdruk), sterk gescheiden werelden."
                            }
                        ]
                    }
                ],
