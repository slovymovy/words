        "nl-extract.jsonl": [
            {
                "entry_id": "61dec4b8-6519-3f6a-8674-b1369192bb77",
                "word": "iedereen",
                "pos": "pron",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f318d6ba-620e-389f-9057-ef38ff07c9e5",
                        "entry_id": "61dec4b8-6519-3f6a-8674-b1369192bb77",
                        "glosses": [
                            "elke persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4376f5ee-a242-4551-9e36-815b9df64113",
                                "sense_id": "f318d6ba-620e-389f-9057-ef38ff07c9e5",
                                "text": "Jack was een kale man van in de zestig die 35 jaar geleden zelf de PCT had gelopen. Het ging er volgens hem destijds heel anders aan toe dan nu. ‘Mijn rugzak woog wel 20 kilo, en nu loopt iedereen met dat ultralichte spul."
                            },
                            {
                                "example_id": "771d81f4-45fa-4c8b-8d21-5dc7b1382fc8",
                                "sense_id": "f318d6ba-620e-389f-9057-ef38ff07c9e5",
                                "text": "Mensen zijn van slag en geschokt. Na een maand waarin iedereen verwachtte dat het zou gaan gebeuren, waren we er zo'n beetje over uit dat die nog best een tijd vol zou kunnen houden. Dit is een donderslag bij heldere hemel en Rome zal vandaag in rouw zijn.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c93090ad-b1ea-4bbd-a773-bb69eb8fba14",
                        "source_entry_id": "61dec4b8-6519-3f6a-8674-b1369192bb77",
                        "source_sense_id": "f318d6ba-620e-389f-9057-ef38ff07c9e5",
                        "source_sense_description": "elke persoon",
                        "target_lang_word": "jedermann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jedermann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02d3facf-a4ef-3faa-a9d7-a6090fbaf64f",
                                        "entry_id": "137860de-0fc4-39b2-9609-fbdd8407b79d",
                                        "glosses": [
                                            "jede einzelne Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69c028f4-eec0-49bb-99eb-a910e943bb20",
                                                "sense_id": "02d3facf-a4ef-3faa-a9d7-a6090fbaf64f",
                                                "text": "„Jeder glücklich erreichte Gipfel vermittelt das Bewusstsein, sich ein nicht jedermann zugängliches, dem Bergsteiger wichtiges Stück Bergwelt unseres Globus selbst erarbeitet und damit zu eigen gemacht zu haben.“"
                                            },
                                            {
                                                "example_id": "34f4e447-ec4c-4b2d-b432-937c2d8d81b2",
                                                "sense_id": "02d3facf-a4ef-3faa-a9d7-a6090fbaf64f",
                                                "text": "Jedermann ist bei dem Fest willkommen."
                                            },
                                            {
                                                "example_id": "9fe1efd1-b457-47d9-acaf-f9b3b5e4c1a3",
                                                "sense_id": "02d3facf-a4ef-3faa-a9d7-a6090fbaf64f",
                                                "text": "Das ist nicht jedermanns Sache."
                                            },
                                            {
                                                "example_id": "d96960e6-1be5-49ae-abc4-1dfb8501d7b3",
                                                "sense_id": "02d3facf-a4ef-3faa-a9d7-a6090fbaf64f",
                                                "text": "„Offenbar kann jedermann einfach in ein x-beliebiges Krankenhaus hineinlaufen und seine Arbeitskraft als Praktikant anbieten, gratis, versteht sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4288b7ae-fc80-44e1-9b8f-e15765a10ec5",
                        "source_entry_id": "61dec4b8-6519-3f6a-8674-b1369192bb77",
                        "source_sense_id": "f318d6ba-620e-389f-9057-ef38ff07c9e5",
                        "source_sense_description": "elke persoon",
                        "target_lang_word": "everybody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "everybody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d28fb094-324f-371f-8e16-9844732a61ff",
                                        "entry_id": "04462f4d-4e69-33a0-873b-12cab5040666",
                                        "glosses": [
                                            "All people."
                                        ],
                                        "tags": [
                                            "indefinite",
                                            "pronoun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6fd6f57-581c-4730-8fdd-601a5d908c07",
                                                "sense_id": "d28fb094-324f-371f-8e16-9844732a61ff",
                                                "text": "Does everybody have their ticket(s) at hand?"
                                            },
                                            {
                                                "example_id": "1f433952-009c-4483-bf71-d4eb54de2f84",
                                                "sense_id": "d28fb094-324f-371f-8e16-9844732a61ff",
                                                "text": "Selwyn, sitting up rumpled and cross-legged on the floor, after having boloed Drina to everybody's exquisite satisfaction, looked around at the sudden rustle of skirts to catch a glimpse of a vanishing figure—a glimmer of ruddy hair and the white curve of a youthful face, half-buried in a muff."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23b01e61-b63e-4bcd-a88d-6392a87b4fab",
                        "source_entry_id": "61dec4b8-6519-3f6a-8674-b1369192bb77",
                        "source_sense_id": "f318d6ba-620e-389f-9057-ef38ff07c9e5",
                        "source_sense_description": "elke persoon",
                        "target_lang_word": "everyone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "everyone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbb22043-e421-3baf-9b8d-b89abaf9db74",
                                        "entry_id": "900017cf-2cdf-3847-82ad-f653289c17db",
                                        "glosses": [
                                            "Every person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "690048ef-5c9c-4e9e-8119-8330512a54aa",
                                                "sense_id": "cbb22043-e421-3baf-9b8d-b89abaf9db74",
                                                "text": "She was really hungry, so the chicken and tarts served to divert her attention for a time. It was well I secured this forage; or both she, I and Sophie, to whom I conveyed a share of our repast, would have run a chance of getting no dinner at all: every one down stairs was too much engaged to think of us."
                                            },
                                            {
                                                "example_id": "138a8586-2885-4db3-9c0a-3cdebab86dc4",
                                                "sense_id": "cbb22043-e421-3baf-9b8d-b89abaf9db74",
                                                "text": "Everyone’s heart palpitated as Leo Dillon handed up the paper and everyone assumed an innocent face."
                                            },
                                            {
                                                "example_id": "b5526461-319c-45de-8b97-8f0e485df903",
                                                "sense_id": "cbb22043-e421-3baf-9b8d-b89abaf9db74",
                                                "text": "Hello, everyone!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ab0a77b-792d-46f3-91c1-4657a9d3cc8c",
                        "source_entry_id": "61dec4b8-6519-3f6a-8674-b1369192bb77",
                        "source_sense_id": "f318d6ba-620e-389f-9057-ef38ff07c9e5",
                        "source_sense_description": "elke persoon",
                        "target_lang_word": "tout le monde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tout le monde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa4455ed-b7cb-37e1-bbf7-6253a4b05114",
                                        "entry_id": "1a5caf55-d12b-3d1f-bb51-1ca7bda32cdd",
                                        "glosses": [
                                            "Toutes les personnes d’un ensemble donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f43e5f1-dfa1-422e-a2b1-449cb9ab2ff4",
                                                "sense_id": "fa4455ed-b7cb-37e1-bbf7-6253a4b05114",
                                                "text": "Une autre fatalité pesait sur les Rabalan : ils se suicidaient. Depuis cent ans, on ne connaissait pas un seul Rabalan qui fût mort, comme tout le monde, dans son lit, de mort naturelle."
                                            },
                                            {
                                                "example_id": "904113c7-bb25-494e-89f2-98269d4d3c95",
                                                "sense_id": "fa4455ed-b7cb-37e1-bbf7-6253a4b05114",
                                                "text": "Les immenses succès obtenus par la civilisation matérielle ont fait croire que le bonheur se produirait tout seul, pour tout le monde, dans un avenir tout prochain."
                                            },
                                            {
                                                "example_id": "3e621a8f-f45b-4411-b8d5-1f8bf5dc52a4",
                                                "sense_id": "fa4455ed-b7cb-37e1-bbf7-6253a4b05114",
                                                "text": "Si les trois villages se soulevaient et qu’on tuât deux ou trois gendarmes, guillotinerait-on tout le monde ?"
                                            },
                                            {
                                                "example_id": "7db06f76-0238-41d5-94ca-d0d3974b991d",
                                                "sense_id": "fa4455ed-b7cb-37e1-bbf7-6253a4b05114",
                                                "text": "Toilette du bataillon. Le barbier passe pour particulièrement francophile. Tout le monde va se raser chez lui."
                                            },
                                            {
                                                "example_id": "97278878-44f6-46cf-bf43-4d38ba67e2e2",
                                                "sense_id": "fa4455ed-b7cb-37e1-bbf7-6253a4b05114",
                                                "text": "Le repas était, comme toujours en Polynésie, une affaire très sérieuse et tout le monde mangeait en silence."
                                            },
                                            {
                                                "example_id": "71de622b-0a12-4f84-b7fa-af94bcaf9971",
                                                "sense_id": "fa4455ed-b7cb-37e1-bbf7-6253a4b05114",
                                                "text": "De leur balcon qu'on atteignait par une échelle,, les musiciens déversaient sans répit sur la foule, des airs de valse, de java, de shimmy, de charleston et tout le monde se trémoussait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d8ed968-865f-3324-bcb5-715671504e1d",
                                        "entry_id": "1a5caf55-d12b-3d1f-bb51-1ca7bda32cdd",
                                        "glosses": [
                                            "Toutes les parties prenantes d'une affaire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a730bb1-1a12-454f-926d-3a2f841fa6ff",
                                                "sense_id": "1d8ed968-865f-3324-bcb5-715671504e1d",
                                                "text": "La proposition rallia tout le monde et l’on se mit en devoir d’en réaliser l’exécution ; […]."
                                            },
                                            {
                                                "example_id": "fbacb302-bae0-44bd-a002-c9ab32b80116",
                                                "sense_id": "1d8ed968-865f-3324-bcb5-715671504e1d",
                                                "text": "Le vin vaut ce qu’il vaut, mais Marthe le touche à bon prix et comme la clientèle est soiffarde, tout le monde est content."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
