                        "entry_id": "2a629b5b-8d57-3ba5-8c02-3e2ccf25268f",
                        "glosses": [
                            "neuronal bedingte Unfähigkeit der glatten Muskulatur von Hohlorganen, sich zu entspannen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46f5864a-ed1d-47f0-9207-79161952c0e7",
                                "sense_id": "fc85472d-20df-3432-80ce-9e10bc5cbc89",
                                "text": "Achalasie kann auch in der Speiseröhre, im Darm und im Harntrakt vorkommen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a280e4e1-c27a-31ed-8b01-4c488c8a1add",
                        "entry_id": "2a629b5b-8d57-3ba5-8c02-3e2ccf25268f",
                        "glosses": [
                            "Störung des unteren Sphinkters (Schließmuskels) der Speiseröhre (Ösophagus), wobei dieser während des Schluckaktes nicht oder nur ungenügend erschlafft"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "ef208012-c2ac-44ac-a26a-291910bd811d",
                                "sense_id": "a280e4e1-c27a-31ed-8b01-4c488c8a1add",
                                "text": "Achalasie der Speiseröhre kann lebenslang bestehen bleiben, aber die Beschwerden können effektiv gelindert werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
