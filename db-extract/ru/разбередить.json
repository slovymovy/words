                                                "sense_id": "b641810b-a516-3d82-b41c-6909e9d0f113",
                                                "text": "A cable chafes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2a777ae-d74e-34e1-9c12-ed757d79a5c8",
                                        "entry_id": "d11b4237-41da-3799-8a82-38e696a6e209",
                                        "glosses": [
                                            "To have a feeling of vexation; to be vexed; to fret; to be irritated."
