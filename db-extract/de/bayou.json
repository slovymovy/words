                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d12c9124-8673-465f-9e94-9a2bf7ba1b64",
                                "sense_id": "ea8d8cb0-368e-3a75-a172-3b9aa8513b69",
                                "text": "„Das Dampfboot war unterdessen in das Bayou eingelaufen, Weiber und Kinder strömten über die Bretter ans Ufer.“"
                            },
                            {
                                "example_id": "d5d53720-7870-44af-a239-5ec0768b0fb1",
                                "sense_id": "ea8d8cb0-368e-3a75-a172-3b9aa8513b69",
                                "text": "„Das Büro lag im fünfzehnten Stock und bot einen Blick auf die Skyline von Houston und das offene Flachland bis zum Kanal und dem Bayou dahinter.“"
                            }
