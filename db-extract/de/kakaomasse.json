                        "glosses": [
                            "gemahlene Kakaobohnen, die als Grundlage für Schokolade dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a6163ac-aabb-4e91-90b4-c1296c271c97",
                                "sense_id": "f91ca221-4ea7-3940-8b82-80f561f19080",
                                "text": "„Die sogenannte Raw Chocolate mit 70 Prozent Kakaoanteil entsteht durch eine besonders sanfte Vermahlung der Bohnen bei niedrigen Temperaturen. So verbleiben mehr Antioxidantien und Flavonoiden in der Kakaomasse.“"
                            },
                            {
                                "example_id": "23eb9f4c-0016-484c-ac7f-e717dc51d5ac",
                                "sense_id": "f91ca221-4ea7-3940-8b82-80f561f19080",
                                "text": "Kakaomasse besteht aus Kakaobutter und Kakaotrockenmasse."
                            }
