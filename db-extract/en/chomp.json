                                                "example_id": "00b6ebf3-c42c-4799-854c-42f76cbba1ca",
                                                "sense_id": "434a7a22-99d2-3539-b41d-5d10c25d2e94",
                                                "text": "Es gibt reichlich Kuchen, an dem sich vor allem die Kinder ergötzen, auch Immas Jüngster, mittlerweile ein Jahr und drei Monate alt, mampft schon tapfer mit."
                                            },
                                            {
                                                "example_id": "e0a5716e-1e90-4832-9ce5-9cdee5235d76",
                                                "sense_id": "434a7a22-99d2-3539-b41d-5d10c25d2e94",
