                        "sense_id": "3a4be274-147c-360c-b703-ddb50dad8650",
                        "entry_id": "6c1e6af0-d8c8-304a-b018-bf7156c93990",
                        "glosses": [
                            "A territory in northern Canada. Capital: Iqaluit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9066b681-5dba-4614-ab6b-92020062b2cb",
                                "sense_id": "3a4be274-147c-360c-b703-ddb50dad8650",
                                "text": "All of the houses in Nunavut must be built on stilts because the permafrost makes it impossible to sink foundations."
                            }
                        ]
                    }
                ],
