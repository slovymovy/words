                "senses": [
                    {
                        "sense_id": "fe2789b9-2973-3a12-a63a-3fc6a3a323d7",
                        "entry_id": "b0353357-d8cd-3ca6-a27d-4ade824c42af",
                        "glosses": [
                            "występ artysty muzycznego stanowiący cały program koncertu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02e6ef97-daa9-4df8-a37e-c6300cbf9ced",
                                "sense_id": "fe2789b9-2973-3a12-a63a-3fc6a3a323d7",
                                "text": "Spotkaliśmy się na recitalu Mariana Opani."
                            },
                            {
                                "example_id": "edbd362a-1e65-4aae-ba23-fe8d28c89ca0",
                                "sense_id": "fe2789b9-2973-3a12-a63a-3fc6a3a323d7",
                                "text": "Chłopaki zaciągnęli go do kina, potem Pawełek zdobył bilety na recital Ewy Demarczyk, a potem był mecz hokejowy Polska – NRD, na który poszli całą gromadą i na przemian to wrzeszczeli, to dęli w trąbki, dopingując swojaków."
                            },
                            {
                                "example_id": "c9a6f04e-1911-4c99-b5b7-3dbccc4f8ca0",
                                "sense_id": "fe2789b9-2973-3a12-a63a-3fc6a3a323d7",
                                "text": "Piwnica powinna nadal tętnić życiem. Powinny odbywać się tu recitale, koncerty, rewie piosenek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
