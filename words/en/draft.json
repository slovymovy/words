{
    "word_family": [
        "draught",
        "draftee",
        "drafter",
        "drafty",
        "draftsmanship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04ab6c5e-b971-3e63-b10f-34c886ff334f",
                    "sense_definition": "A preliminary version of a written work or drawing that is not yet in its final form.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to finish the first <w>draft</w> of my essay before the weekend.",
                            "target_lang_translations": {
                                "ru": "Мне нужно закончить первый <w>черновик</w> эссе до выходных.",
                                "zh": "我需要在周末前完成论文的第<w>一稿</w>。"
                            }
                        },
                        {
                            "text": "The author shared a rough <w>draft</w> of the new chapter with her editor.",
                            "target_lang_translations": {
                                "ru": "Автор поделилась черновым <w>наброском</w> новой главы со своим редактором.",
                                "zh": "作者与编辑分享了新章节的<w>草稿</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "final version"
                    ],
                    "common_phrases": [
                        "rough draft",
                        "first draft",
                        "final draft"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предварительная версия письменной работы или рисунка, которая еще не находится в окончательной форме.",
                        "zh": "书面作品或图画的初步版本，尚未定稿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черновик",
                                "target_lang_sense_clarification": "для текста"
                            },
                            {
                                "target_lang_word": "набросок",
                                "target_lang_sense_clarification": "для рисунка или текста"
                            },
                            {
                                "target_lang_word": "эскиз",
                                "target_lang_sense_clarification": "для рисунка или проекта"
                            },
                            {
                                "target_lang_word": "проект",
                                "target_lang_sense_clarification": "документа или плана"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "草稿",
                                "target_lang_sense_clarification": "用于文章或文书的初稿"
                            },
                            {
                                "target_lang_word": "草案",
                                "target_lang_sense_clarification": "用于法律或正式计划的初步文案"
                            },
                            {
                                "target_lang_word": "草图",
                                "target_lang_sense_clarification": "用于图画或设计"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1a0b7ce-f7ae-331b-a248-3c69e4d69be5",
                    "sense_definition": "A current of cool air moving through a room or vehicle, often caused by an open window or door.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "air_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt a cold <w>draft</w> coming from under the front door.",
                            "target_lang_translations": {
                                "ru": "Я почувствовал холодный <w>сквозняк</w>, идущий из-под входной двери.",
                                "zh": "我感觉到从前门底下吹进了一股<w>冷风</w>。"
                            }
                        },
                        {
                            "text": "Please close the window because there is a <w>draft</w> in here.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, закрой окно, потому что здесь <w>сквозняк</w>.",
                                "zh": "请把窗户关上，这里有<w>穿堂风</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cold draft",
                        "feel a draft"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поток прохладного воздуха, движущийся через комнату или транспортное средство, часто вызванный открытым окном или дверью.",
                        "zh": "穿过房间或车辆的冷空气流，通常由开着的门窗引起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сквозняк",
                                "target_lang_sense_clarification": "в помещении"
                            },
                            {
                                "target_lang_word": "тяга",
                                "target_lang_sense_clarification": "в печи или трубе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穿堂风",
                                "target_lang_sense_clarification": "室内空气对流"
                            },
                            {
                                "target_lang_word": "冷风",
                                "target_lang_sense_clarification": "指从缝隙吹入的冷气"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dbb1a9d-ef53-3273-a361-07a1042e21de",
                    "sense_definition": "A system where people are required by law to join the military; conscription.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many young men were worried about the military <w>draft</w> during the war.",
                            "target_lang_translations": {
                                "ru": "Многие молодые люди были обеспокоены военным <w>призывом</w> во время войны.",
                                "zh": "战争期间，许多年轻人对<w>征兵</w>感到担忧。"
                            }
                        },
                        {
                            "text": "The government decided to end the <w>draft</w> and move to a volunteer army.",
                            "target_lang_translations": {
                                "ru": "Правительство решило отменить <w>призыв</w> и перейти к добровольческой армии.",
                                "zh": "政府决定结束<w>征兵制</w>，转向志愿兵役制。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "military draft",
                        "avoid the draft"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система, при которой люди обязаны по закону вступать в армию; призыв.",
                        "zh": "法律规定公民必须服兵役的制度；征兵。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "призыв",
                                "target_lang_sense_clarification": "на военную службу"
                            },
                            {
                                "target_lang_word": "набор",
                                "target_lang_sense_clarification": "в армию"
                            },
                            {
                                "target_lang_word": "контрибуция",
                                "target_lang_sense_clarification": "воинская повинность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "征兵",
                                "target_lang_sense_clarification": "国家强制征召入伍"
                            },
                            {
                                "target_lang_word": "兵役",
                                "target_lang_sense_clarification": "指服役义务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e02726d-84a5-3025-bad8-104a5db7dc4b",
                    "sense_definition": "Beer or other drinks served from a large container like a keg or cask rather than from a bottle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beverages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pub has a great selection of local <w>draft</w> beers on tap.",
                            "target_lang_translations": {
                                "ru": "В пабе отличный выбор местного <w>разливного</w> пива.",
                                "zh": "这家酒吧有多种当地的<w>扎啤</w>供应。"
                            }
                        },
                        {
                            "text": "I usually prefer <w>draft</w> cider because it tastes fresher than the bottled version.",
                            "target_lang_translations": {
                                "ru": "Я обычно предпочитаю <w>разливной</w> сидр, потому что он на вкус свежее бутылочного.",
                                "zh": "我通常更喜欢<w>散装</w>苹果酒，因为它比瓶装的喝起来更新鲜。"
                            }
                        }
                    ],
                    "antonyms": [
                        "bottled"
                    ],
                    "common_phrases": [
                        "draft beer",
                        "on draft"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пиво или другие напитки, подаваемые из большого контейнера, такого как кег или бочка, а не из бутылки.",
                        "zh": "从大容器（如桶或罐）中供应而非瓶装的啤酒或其他饮料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разливное",
                                "target_lang_sense_clarification": "о напитках"
                            },
                            {
                                "target_lang_word": "бочковое",
                                "target_lang_sense_clarification": "о пиве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扎啤",
                                "target_lang_sense_clarification": "指桶装啤酒"
                            },
                            {
                                "target_lang_word": "散装",
                                "target_lang_sense_clarification": "指非瓶装的饮料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23413334-79ae-3cff-81cf-81873eca5da5",
                    "sense_definition": "A process in professional sports where teams take turns selecting new players from a pool of candidates.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was the first overall pick in the basketball <w>draft</w> this year.",
                            "target_lang_translations": {
                                "ru": "Он был выбран под первым номером на баскетбольном <w>драфте</w> в этом году.",
                                "zh": "他是今年篮球<w>选秀</w>的状元。"
                            }
                        },
                        {
                            "text": "The team is looking for a new quarterback in the upcoming sports <w>draft</w>.",
                            "target_lang_translations": {
                                "ru": "Команда ищет нового квотербека на предстоящем спортивном <w>драфте</w>.",
                                "zh": "球队正在即将到来的体育<w>选秀</w>中寻找新的四分卫。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "draft pick",
                        "sports draft"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс в профессиональном спорте, когда команды по очереди выбирают новых игроков из пула кандидатов.",
                        "zh": "职业体育中，各队轮流从候选人池中挑选新球员的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драфт",
                                "target_lang_sense_clarification": "спортивный термин"
                            },
                            {
                                "target_lang_word": "отбор",
                                "target_lang_sense_clarification": "игроков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选秀",
                                "target_lang_sense_clarification": "体育界挑选新人的机制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95cb6409-cf88-380d-b1b4-9c6dcdb47472",
                    "sense_definition": "The amount of liquid swallowed in one continuous act of drinking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took a long <w>draft</w> of cold water after her long run.",
                            "target_lang_translations": {
                                "ru": "Она сделала долгий <w>глоток</w> холодной воды после долгой пробежки.",
                                "zh": "长跑后，她大喝了<w>一口</w>凉水。"
                            }
                        },
                        {
                            "text": "He finished the entire glass of juice in a single <w>draft</w>.",
                            "target_lang_translations": {
                                "ru": "Он выпил весь стакан сока одним <w>глотком</w>.",
                                "zh": "他<w>一口气</w>喝完了整杯果汁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "swig"
                    ],
                    "common_phrases": [
                        "deep draft",
                        "single draft"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often spelled 'draught' in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество жидкости, проглатываемое за один непрерывный акт питья.",
                        "zh": "一次连续吞咽动作所喝下的液体量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глоток",
                                "target_lang_sense_clarification": "однократное глотание"
                            },
                            {
                                "target_lang_word": "затяжка",
                                "target_lang_sense_clarification": "при курении или вдохе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一口",
                                "target_lang_sense_clarification": "指一次喝下的量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "842d30de-4caf-33c2-9e30-2779059bd9c5",
                    "sense_definition": "The vertical distance between the waterline and the bottom of a ship's hull; the depth of water a ship needs to float.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship has a shallow <w>draft</w>, allowing it to enter smaller harbors.",
                            "target_lang_translations": {
                                "ru": "У корабля небольшая <w>осадка</w>, что позволяет ему заходить в небольшие гавани.",
                                "zh": "这艘船的<w>吃水</w>很浅，可以进入较小的港口。"
                            }
                        },
                        {
                            "text": "The captain checked the vessel's <w>draft</w> before entering the shallow canal.",
                            "target_lang_translations": {
                                "ru": "Капитан проверил <w>осадку</w> судна перед входом в мелководный канал.",
                                "zh": "船长在进入浅水运河前检查了船只的<w>吃水</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shallow draft",
                        "deep draft"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вертикальное расстояние между ватерлинией и нижней частью корпуса судна; глубина воды, необходимая судну для плавания.",
                        "zh": "水线与船底之间的垂直距离；船只浮动所需的深度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осадка",
                                "target_lang_sense_clarification": "судна"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吃水",
                                "target_lang_sense_clarification": "船舶航海术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5890c286-e941-33b4-aa2a-78b0ef8ee0c3",
                    "sense_definition": "To prepare a preliminary version of a document, letter, or plan.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer will <w>draft</w> a contract for the new business partnership.",
                            "target_lang_translations": {
                                "ru": "Юрист <w>составит проект</w> контракта для нового делового партнерства.",
                                "zh": "律师将为新的商业伙伴关系<w>起草</w>一份合同。"
                            }
                        },
                        {
                            "text": "I need to <w>draft</w> an email to my boss explaining the situation.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>набросать</w> письмо моему боссу с объяснением ситуации.",
                                "zh": "我需要给老板<w>草拟</w>一封邮件说明情况。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "draft a letter",
                        "draft a proposal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подготовить предварительную версию документа, письма или плана.",
                        "zh": "准备文件、信件或计划的初步版本。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "составлять",
                                "target_lang_sense_clarification": "проект документа"
                            },
                            {
                                "target_lang_word": "набрасывать",
                                "target_lang_sense_clarification": "черновик"
                            },
                            {
                                "target_lang_word": "проектировать",
                                "target_lang_sense_clarification": "план"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "起草",
                                "target_lang_sense_clarification": "正式撰写文件"
                            },
                            {
                                "target_lang_word": "草拟",
                                "target_lang_sense_clarification": "拟定初步方案"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e175608-e322-375e-a9c4-9a1ef0ff90e9",
                    "sense_definition": "To officially order someone to join the military or a specific organization.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>drafted</w> into the army shortly after he finished college.",
                            "target_lang_translations": {
                                "ru": "Его <w>призвали</w> в армию вскоре после окончания колледжа.",
                                "zh": "他大学毕业后不久就被<w>征召</w>入伍了。"
                            }
                        },
                        {
                            "text": "The committee decided to <w>draft</w> her as the new chairperson.",
                            "target_lang_translations": {
                                "ru": "Комитет решил <w>привлечь</w> её в качестве нового председателя.",
                                "zh": "委员会决定<w>招募</w>她担任新主席。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "be drafted into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально приказать кому-либо вступить в армию или определенную организацию.",
                        "zh": "正式命令某人加入军队或特定组织。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "призывать",
                                "target_lang_sense_clarification": "в армию"
                            },
                            {
                                "target_lang_word": "мобилизовать",
                                "target_lang_sense_clarification": "на службу"
                            },
                            {
                                "target_lang_word": "набирать",
                                "target_lang_sense_clarification": "в организацию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "征召",
                                "target_lang_sense_clarification": "强制入伍或加入组织"
                            },
                            {
                                "target_lang_word": "招募",
                                "target_lang_sense_clarification": "指选拔人才"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34db1f16-c0f5-378d-a518-28bdc78a7069",
                    "sense_definition": "To drive or cycle very closely behind another vehicle to use its air current to reduce wind resistance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cyclist began to <w>draft</w> behind the lead rider to save energy.",
                            "target_lang_translations": {
                                "ru": "Велосипедист начал <w>ехать в потоке</w> за лидером, чтобы сэкономить силы.",
                                "zh": "为了节省体力，骑手开始在领骑者身后<w>跟车</w>。"
                            }
                        },
                        {
                            "text": "In racing, drivers often <w>draft</w> each other to gain more speed on the straightaway.",
                            "target_lang_translations": {
                                "ru": "В гонках водители часто <w>используют воздушный поток</w> друг друга, чтобы набрать скорость на прямой.",
                                "zh": "在赛车比赛中，车手们经常通过<w>跟车</w>在直道上获得更快的速度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slipstream"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ехать на автомобиле или велосипеде очень близко за другим транспортным средством, чтобы использовать его воздушный поток для уменьшения сопротивления ветра.",
                        "zh": "在另一辆车后紧跟行驶，利用其气流减少风阻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идти в потоке",
                                "target_lang_sense_clarification": "за лидером"
                            },
                            {
                                "target_lang_word": "слипстримить",
                                "target_lang_sense_clarification": "в гонках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跟车",
                                "target_lang_sense_clarification": "赛车或骑行中利用气流"
