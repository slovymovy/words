    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1be2caa4-feeb-34e5-9287-135ce27ca523",
                    "sense_definition": "Mollusque gastéropode terrestre muni d'une coquille en spirale et avançant très lentement.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mollusque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la pluie, les enfants cherchent un <w>escargot</w> sur le chemin du jardin."
                        },
                        {
                            "text": "Dans mon potager, chaque <w>escargot</w> mange les feuilles de salade pendant la nuit."
                        }
                    ],
                    "synonyms": [
                        "limaçon",
                        "colimaçon",
                        "cagouille"
                    ],
                    "common_phrases": [
                        "coquille d'escargot",
                        "bave d'escargot"
                    ]
                },
                {
                    "sense_id": "df930a81-c711-37e9-8d32-9a9cf494ac69",
                    "sense_definition": "Plat traditionnel cuisiné à base de ce mollusque, souvent préparé avec du beurre persillé.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "mollusque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au restaurant, les touristes commandent une douzaine d'<w>escargots</w> en entrée."
                        },
                        {
                            "text": "Pour les fêtes de fin d'année, nous préparons toujours des <w>escargots</w> au beurre et à l'ail."
                        }
                    ],
                    "common_phrases": [
                        "escargots de Bourgogne"
                    ]
                },
                {
                    "sense_id": "9a5bd5af-9420-359f-a479-10957917d0db",
                    "sense_definition": "Personne particulièrement lente dans ses mouvements ou dans son travail.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dépêche-toi un peu, tu avances vraiment comme un <w>escargot</w> ce matin."
                        },
                        {
                            "text": "Avec la neige sur la route, les voitures roulent à une allure d'<w>escargot</w>."
                        }
                    ],
                    "common_phrases": [
                        "allure d'escargot",
                        "avancer comme un escargot"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "au sens figuré"
                        }
                    ]
                },
                {
                    "sense_id": "e7edca97-e26d-3d43-9343-217390a34788",
                    "sense_definition": "Objet ou disposition en forme de spirale ou d'hélice.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "forme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous montons au sommet du phare par un vieil escalier en <w>escargot</w>."
                        },
                        {
                            "text": "L'architecte a dessiné une rampe d'accès enroulée en <w>escargot</w> autour du bâtiment."
                        }
                    ],
                    "synonyms": [
                        "colimaçon"
                    ],
                    "common_phrases": [
                        "escalier en escargot"
                    ]
                },
                {
                    "sense_id": "b7c7ea49-3a90-3e18-9287-02b0cb449ac8",
                    "sense_definition": "Viennoiserie roulée en spirale garnie de crème pâtissière et de raisins secs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "forme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En passant à la boulangerie, il achète un délicieux <w>escargot</w> aux raisins tout chaud."
                        },
                        {
                            "text": "Dans l'est de la France, les clients commandent un <w>escargot</w> plutôt qu'un pain aux raisins."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "principalement dans l'Est de la France"
                        }
                    ]
                }
            ]
        }
