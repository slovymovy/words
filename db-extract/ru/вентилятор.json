                                        "sense_id": "21740099-9508-3972-819c-2c8e15809f70",
                                        "entry_id": "f082ffe6-4dd5-366c-84c0-3715c05c34da",
                                        "glosses": [
                                            "A device that circulates fresh air and expels stale or noxious air."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45f5aab1-8f11-3a78-b322-a250dc3f1def",
                                        "entry_id": "f082ffe6-4dd5-366c-84c0-3715c05c34da",
                                        "glosses": [
                                            "A machine that moves breathable air into and out of the lungs of a patient who is unable to breathe sufficiently."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5375c277-d66b-3e9e-9d32-144d9931a647",
                                        "entry_id": "f082ffe6-4dd5-366c-84c0-3715c05c34da",
                                        "glosses": [
                                            "Some behaviour or happening that relieves a tense atmosphere or situation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45451881-8c4a-492a-a9b2-0452a1f884f9",
                                                "sense_id": "5375c277-d66b-3e9e-9d32-144d9931a647",
                                                "text": "A lover's quarrel is made up of jealousies, doubts, hopes, fears, and all sorts of fantastic fancies: a matrimonial dispute, on the contrary, is composed of familiar and ordinary matter, a sort of ventilator to the temper!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f45fb32-e47d-3ac2-a0ae-76aed3380906",
                                        "entry_id": "f082ffe6-4dd5-366c-84c0-3715c05c34da",
                                        "glosses": [
                                            "A play or an actor so bad as to empty the theater."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eaef5249-2861-494e-b131-cfc21f92f0e7",
                        "source_entry_id": "e925216d-47b1-36a1-b735-6b2ab194a8c5",
                        "target_lang_word": "ventilador",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ventilador",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "04258fe2-c1a5-3500-8a3c-ef29571dc4da",
                                        "entry_id": "a8a2545f-0120-378b-901e-a75e13e54c14",
                                        "glosses": [
                                            "Máquina de fluido concebida para producir una corriente de aire mediante un rodete con aspas que giran produciendo una diferencia de presiones. Entre sus aplicaciones, destacan las de hacer circular y renovar el aire en un lugar cerrado para proporcionar oxígeno suficiente a los ocupantes y eliminar olores, principalmente en lugares cerrados; así como la de disminuir la resistencia de transmisión de calor por convección."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8362da9-d788-4377-9c4f-591df829dfa0",
                        "source_entry_id": "e925216d-47b1-36a1-b735-6b2ab194a8c5",
