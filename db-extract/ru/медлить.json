                "translations": [
                    {
                        "translation_id": "88a21c7f-184e-40e6-9426-5a5c2767eee0",
                        "source_entry_id": "29c29035-94fb-385b-adb5-8d522a0a5411",
                        "target_lang_word": "tardar",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tardar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "df7ffa08-b58b-336e-a14d-011d1ee8b712",
                                        "entry_id": "e83a71da-5473-37ad-9441-2a9886036bd7",
                                        "glosses": [
                                            "Ocupar más tiempo del acostumbrado en algo."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8353339-c254-44ee-8197-2e0ee7851277",
                        "source_entry_id": "29c29035-94fb-385b-adb5-8d522a0a5411",
                        "target_lang_word": "tarder",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tarder",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3318ab9-8fb3-34e6-bea0-1997c29c3114",
                                        "entry_id": "5226241f-0225-3ebe-a9bc-c978b6664684",
                                        "glosses": [
                                            "Arriver tard ; être lent à venir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f43b846a-9e21-4b81-8e3e-65a9fd124657",
                                                "sense_id": "b3318ab9-8fb3-34e6-bea0-1997c29c3114",
                                                "text": "Notre hôte, absent au moment de notre arrivée, ne tarde pas à paraître et me fait l’accueil auquel je m’attendais de sa part."
                                            },
                                            {
                                                "example_id": "cf96d733-8778-40a1-a039-f010261d0bcb",
                                                "sense_id": "b3318ab9-8fb3-34e6-bea0-1997c29c3114",
                                                "text": "Pourquoi avez-vous tant tardé? — Allez et ne tardez pas. — Il a bien tardé en chemin."
                                            },
                                            {
                                                "example_id": "b4de9d1c-c5ee-4b26-8e18-a0eee37f5e08",
                                                "sense_id": "b3318ab9-8fb3-34e6-bea0-1997c29c3114",
                                                "text": "\"Je ne vais pas tarder\", dit Romain en voulant partir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3c1865e-1622-307e-bb17-f13c738913dd",
                                        "entry_id": "5226241f-0225-3ebe-a9bc-c978b6664684",
                                        "glosses": [
                                            "Différer de faire quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c6cf775-25cf-4dec-9d0e-705e8c641be0",
                                                "sense_id": "b3c1865e-1622-307e-bb17-f13c738913dd",
                                                "text": "Grâce au concours que me prêtera notre consul à Tiflis, je ne tarderai pas à être en règle avec l’administration moscovite."
                                            },
                                            {
                                                "example_id": "7eb78fa7-4df4-4127-9cf3-52a68ee8edc9",
                                                "sense_id": "b3c1865e-1622-307e-bb17-f13c738913dd",
                                                "text": "Rentrée à la maison, ayant réussi à faire partager aux voisins son inquiétude, Mme Mirondeau les décida […] à partir sans tarder à la recherche de son époux."
                                            },
                                            {
                                                "example_id": "9db41c89-4d52-4b9d-9a3b-f72c34154f67",
                                                "sense_id": "b3c1865e-1622-307e-bb17-f13c738913dd",
                                                "text": "L’aérage est une condition de première nécessité, car la respiration des ouvriers, la combustion des lumières et le tirage des coups de mine ne tarderaient pas à vicier l’air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "099813d3-ce39-3588-a170-2cd9970342be",
                                        "entry_id": "5226241f-0225-3ebe-a9bc-c978b6664684",
                                        "glosses": [
                                            "Pour marquer l’impatience que l’on a de quelque chose."
                                        ],
                                        "tags": [
