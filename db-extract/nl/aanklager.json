                ],
                "senses": [
                    {
                        "sense_id": "219342ad-650a-3bdf-9c43-036d58fb3839",
                        "entry_id": "f0b7cc3a-e0a1-31de-9c3b-2f6f14e9b2a2",
                        "glosses": [
                            "iemand die een strafzaak aanspant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b99bcc45-03bc-40db-9a95-f2f7b08f2f5f",
                                "sense_id": "219342ad-650a-3bdf-9c43-036d58fb3839",
                                "text": "'De openbare aanklager had twintig jaar geëist voor het sympathiseren met de marxistisch-leninistische beweging, terrorisme en landverraad. We hoorden pas weken later dat de rechtszaak had plaatsgevonden."
                            },
                            {
                                "example_id": "cfb46809-7568-438e-bea7-a5884dc9b322",
                                "sense_id": "219342ad-650a-3bdf-9c43-036d58fb3839",
                                "text": "Het eerste punt was, zoals verwacht, de mededeling van de openbaar aanklager, ene Ebba Bengtsson-Stàhle, dat zij weliswaar de leiding over het vooronderzoek had, maar uiteraard alle vertrouwen had in de competentie van de politie en rekende op een even goede samenwerking als altijd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bcb5d2f-7f59-478e-871a-75cc5f9a8fe7",
                        "source_entry_id": "f0b7cc3a-e0a1-31de-9c3b-2f6f14e9b2a2",
                        "source_sense_id": "219342ad-650a-3bdf-9c43-036d58fb3839",
                        "source_sense_description": "iemand die een proces aanspant",
                        "target_lang_word": "Ankläger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ankläger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a113e211-314c-3324-a693-ea4a5044a5f9",
                                        "entry_id": "039dfc9f-5764-31b8-98b1-0c4e0d1f8c09",
                                        "glosses": [
                                            "Person, die im Gericht die Anklage vertritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "795d8c6f-86ef-4ff4-a3d7-6cd40dd16a3f",
                                                "sense_id": "a113e211-314c-3324-a693-ea4a5044a5f9",
                                                "text": "„Barry Roux geht von Anfang an auf Angriff: In seinem Schlussplädoyer beschuldigt Pistorius' Verteidiger Staatsanwalt Gerrie Nel schwer. […] Dann nimmt der Anwalt die Beweisführung des Anklägers auseinander.“"
                                            },
                                            {
                                                "example_id": "c07bb0ef-6ac3-4267-847b-b0ad69b76b90",
                                                "sense_id": "a113e211-314c-3324-a693-ea4a5044a5f9",
                                                "text": "„Punkt für Punkt geht Roux die Anschuldigungen, die Ankläger Nel gestern erhob, durch.“"
                                            },
                                            {
                                                "example_id": "beb3b889-8e48-467c-89fd-1ee283b85b1d",
                                                "sense_id": "a113e211-314c-3324-a693-ea4a5044a5f9",
                                                "text": "„Das Radiogerät lieferte die Stimmen des Anklägers und der Zeugen, Stimmen, die sich in der Luft auflösten, und Sarale lieferte die dazugehörigen Bilder.“"
                                            },
                                            {
                                                "example_id": "8dc68049-0fbc-4ed5-883a-4b553adcb03a",
                                                "sense_id": "a113e211-314c-3324-a693-ea4a5044a5f9",
                                                "text": "„Der Ankläger wird zum Beschuldigten, der Fehltritt zur logischen Notwendigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce19a523-5868-4d50-8c5a-661bc5788652",
                        "source_entry_id": "f0b7cc3a-e0a1-31de-9c3b-2f6f14e9b2a2",
