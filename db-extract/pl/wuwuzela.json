                "senses": [
                    {
                        "sense_id": "cff78153-470e-30aa-a258-b6aed036e542",
                        "entry_id": "03ea5c5a-f38a-3274-b121-3b75426cd94e",
                        "glosses": [
                            "afrykański aerofon ustnikowy używany przez kibiców piłki nożnej do robienia hałasu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5175bcaa-f92a-4320-ba9f-74290d2a149d",
                                "sense_id": "cff78153-470e-30aa-a258-b6aed036e542",
                                "text": "Niemal pół roku po piłkarskich mistrzostwach świata w RPA specjaliści nie mają wątpliwości. Prestiżowa impreza wypromowała wuwuzele i… podniosła poziom serotoniny obywateli, ale nie odmieniła sytuacji gospodarczej najbiedniejszych mieszkańców kraju"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6f25902-402b-4602-92a6-49ebb009d1bb",
                        "source_entry_id": "03ea5c5a-f38a-3274-b121-3b75426cd94e",
                        "source_sense_id": "cff78153-470e-30aa-a258-b6aed036e542",
                        "target_lang_word": "vuvuzela",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vuvuzela",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f7cc928-f4fe-3cba-adc3-60be6f7e47ff",
                                        "entry_id": "be60b53d-afcb-3c57-bcaf-d11197637023",
                                        "glosses": [
                                            "A trumpet-shaped horn, now usually plastic, that produces a loud buzzing sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0df0bd89-b6a9-4b13-b53f-b11d0b3ce609",
                                                "sense_id": "1f7cc928-f4fe-3cba-adc3-60be6f7e47ff",
                                                "text": "When the Manchester United squad walked through the arrival gates at Durban International yesterday, most players heard a vuvuzela for the first time."
                                            },
                                            {
                                                "example_id": "f677ce6a-5f42-4824-ac26-1bca9554c60e",
                                                "sense_id": "1f7cc928-f4fe-3cba-adc3-60be6f7e47ff",
                                                "text": "I’m talking, of course, about the vuvuzela. Essentially, a metre-long blowhorn, which you may struggle to get past a steward at an English football ground."
                                            },
                                            {
                                                "example_id": "dbace0c4-f78b-4477-af04-3ea882a332a5",
                                                "sense_id": "1f7cc928-f4fe-3cba-adc3-60be6f7e47ff",
                                                "text": "For some, the vuvuzelas herald the country’s piercing emergence from the forced racial hush of apartheid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52779dd1-e8a6-47d8-bf06-66b671db2e33",
                        "source_entry_id": "03ea5c5a-f38a-3274-b121-3b75426cd94e",
                        "source_sense_id": "cff78153-470e-30aa-a258-b6aed036e542",
                        "target_lang_word": "vuvuzela",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vuvuzela",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "c8da4b0b-d9be-3aa2-b52b-d4cdf7b90fa3",
                                        "entry_id": "8f40171d-7fee-31cb-9329-a5158f1f1dca",
                                        "glosses": [
                                            "africký hudební nástroj, dlouhá úzká trubka vydávající velmi hlasitý monotónní zvuk a používaná diváky při fotbalových utkáních"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f6c858c-a728-4366-a496-10b2da631997",
                                                "sense_id": "c8da4b0b-d9be-3aa2-b52b-d4cdf7b90fa3",
                                                "text": "„Bylo by diskriminující, kdybychom vuvuzely při mistrovství zakázali,“ řekl šéf fotbalu Sepp Blatter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d52e9d9b-01d5-4a03-87a2-0d7206209107",
                        "source_entry_id": "03ea5c5a-f38a-3274-b121-3b75426cd94e",
                        "source_sense_id": "cff78153-470e-30aa-a258-b6aed036e542",
                        "target_lang_word": "vuvuzela",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vuvuzela",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6c5807c-16da-3d79-b766-f838d0ddbe63",
                                        "entry_id": "6b274795-e548-37de-bfcf-89a50626fb3a",
                                        "glosses": [
                                            "Long cor, d’environ un mètre de long, utilisé par les supporters de football dans les stades d’Afrique du Sud pour soutenir leur équipe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd6c6a26-7dcf-4753-80aa-3af96a38404b",
                                                "sense_id": "b6c5807c-16da-3d79-b766-f838d0ddbe63",
                                                "text": "Elle pourrait bien être la star de la Coupe du Monde. Vendredi, la « vuvuzela » a fait une entrée remarquée dans la compétition. La vuvuzela, c’est ce long instrument d’origine sud-africaine semblable à un clairon, dans lequel les supporters mettent tout leur souffle pendant 90 minutes, sinon plus. Problème : correctement utilisée, elle peut émettre jusqu’à 130 décibels ! Alors quand plusieurs dizaines de milliers de vuvuzelas résonnent en même temps dans une enceinte semi-fermée, le bruit devient très vite insupportable."
                                            },
                                            {
                                                "example_id": "ad892407-f1f4-4d1c-abb9-9fefc31770d2",
                                                "sense_id": "b6c5807c-16da-3d79-b766-f838d0ddbe63",
                                                "text": "Nous recevons des appels de personnes qui se plaignent du bourdonnement de leur TV pdt le match : nous leur apprenons le mot vuvuzela ! :)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffd14737-872c-4572-b6c0-c9bd2b1a8fc2",
                        "source_entry_id": "03ea5c5a-f38a-3274-b121-3b75426cd94e",
                        "source_sense_id": "cff78153-470e-30aa-a258-b6aed036e542",
                        "target_lang_word": "vuvuzela",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vuvuzela",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "4687e9f0-156c-31ab-8115-3249d81f83ba",
                                        "entry_id": "ee7e3aae-46eb-37ef-bc18-00cb810a3cf3",
                                        "glosses": [
                                            "Instrumento musical de viento, a modo de corneta de material habitualmente plástico, que produce una nota monótona e intensa, usado en especial por los simpatizantes en los partidos de fútbol en Sudáfrica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13c654cb-dab3-4369-9d89-382071ce377f",
                                                "sense_id": "4687e9f0-156c-31ab-8115-3249d81f83ba",
                                                "text": "Algunas vuvuzelas, el cuerno de plástico africano popularizado gracias al mundial de fútbol, también han salido a relucir."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
