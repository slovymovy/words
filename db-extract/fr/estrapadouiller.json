                "senses": [
                    {
                        "sense_id": "d370b22c-f354-3d6e-b8a4-dd46a8fac926",
                        "entry_id": "fa5beefd-35c7-3224-83e2-6d349e41b585",
                        "glosses": [
                            "Tuer, assassiner."
                        ],
                        "tags": [
                            "familiar",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "dd20484d-0ab7-4728-9df0-4f9c85e572e8",
                                "sense_id": "d370b22c-f354-3d6e-b8a4-dd46a8fac926",
                                "text": "- Eh, j’y suis pour rien, compañero ! C’est ce fou de Berbila qui a failli t’estrapadouiller."
                            },
                            {
                                "example_id": "8606a1e1-8ead-43f8-94c3-7fafe71347af",
                                "sense_id": "d370b22c-f354-3d6e-b8a4-dd46a8fac926",
                                "text": "En général, c’est Barbotin qui fait la liaison. Alors, la solution s’impose : attendre Barbotin dans le couloir avec un masque de Barbotin, l’estrapadouiller, entrer chez Cachin avec le masque sur la figure."
                            },
                            {
                                "example_id": "a937974e-0e8e-40d2-afbe-beb3bfd1abb1",
                                "sense_id": "d370b22c-f354-3d6e-b8a4-dd46a8fac926",
                                "text": "J’ai l’impression que c’était un des types à qui ils avaient refilé de la fausse monnaie et qui avait dû leur en pousser une bien bruyante. Alors ils l’ont estrapadouillé."
                            },
                            {
                                "example_id": "1f92f923-b462-42c8-844d-2f3f45b3a2ca",
                                "sense_id": "d370b22c-f354-3d6e-b8a4-dd46a8fac926",
                                "text": "- Quoi, ce vieux bouc de Delezenne fait encore des siennes ? Il nous faut l’estrapadouiller, que diable !"
                            }
                        ]
                    }
                ],
