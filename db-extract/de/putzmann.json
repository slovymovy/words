                "senses": [
                    {
                        "sense_id": "f2148835-a00f-3cf2-8088-c2d36b394869",
                        "entry_id": "6e3b46e7-43c5-3810-9849-d6c10fb5792f",
                        "glosses": [
                            "Mann, der Räume sauber macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d96eceef-da40-4b38-94d4-6bc84c923d50",
                                "sense_id": "f2148835-a00f-3cf2-8088-c2d36b394869",
                                "text": "Heute stellen viele Unternehmen nicht nur Putzfrauen, sondern auch Putzmänner ein. Häufig haben sie die Aufgabe, Fenster zu putzen."
                            },
                            {
                                "example_id": "c14e3b30-78a2-4790-b644-66cb5a660da7",
                                "sense_id": "f2148835-a00f-3cf2-8088-c2d36b394869",
                                "text": "Gemeinsam mit Dogic hoffen 860.000 Kollegen auf mehr Geld. Und rund 2000 Putzmänner und Putzfrauen, verteilt aufs gesamte Bundesgebiet, haben dafür ihre Arbeit niedergelegt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
