                        "entry_id": "3266d452-ac0f-3b4d-abd0-6b26ebcc3e6f",
                        "glosses": [
                            "A form of Japanese rice wine, less alcoholic than saké and used in cooking."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "caf225d2-05a4-418f-a6aa-30cdd1c4c020",
                                "sense_id": "ed8fc2c1-69d7-3dad-b19e-66412395f132",
                                "text": "Although naturally brewed mirin is made from only water, sweet brown rice, and rice koji, much of the mirin sold in natural food stores and Oriental markets is sweetened with sugar or corn syrup; read labels carefully."
                            },
                            {
                                "example_id": "663f0af1-9ad7-4682-9b0a-9868907482e2",
                                "sense_id": "ed8fc2c1-69d7-3dad-b19e-66412395f132",
                                "text": "Teriyaki sauce, a mixture of mirin, sake, soy sauce, and sometimes sugar, may be brushed on meats, fish, or vegetables […]"
                            }
                        ]
                    }
