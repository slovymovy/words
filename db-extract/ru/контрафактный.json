                        ],
                        "form": "контрафа́ктны"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9d2be2b0-6b0d-3a71-a60e-7e3d911c1fba",
                        "entry_id": "2bbade68-f60c-3299-882f-2d5da61b3ae6",
                        "glosses": [
                            "экон. поддельный; выпускаемый и распространяемый с нарушением авторских и патентных прав, товарных знаков, стандартов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1602e3cd-7379-41fc-ba0b-faef2dba65da",
                                "sense_id": "9d2be2b0-6b0d-3a71-a60e-7e3d911c1fba",
                                "text": "Единственный весомый плюс объединения с Беларусью ― польский контрафактный товар."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "141c98e2-32be-4e0f-a542-e21a362c91ac",
                        "source_entry_id": "2bbade68-f60c-3299-882f-2d5da61b3ae6",
                        "source_sense_id": "9d2be2b0-6b0d-3a71-a60e-7e3d911c1fba",
                        "target_lang_word": "counterfactual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "counterfactual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28ae3ba0-b7f5-3f65-ac34-4c0f93766197",
                                        "entry_id": "c5231880-a6df-3fc9-96a8-dd9a6d2d5ed1",
                                        "glosses": [
                                            "Contrary to known or agreed facts; untrue."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3eb29f6-5ddf-4a1e-8c1b-c651fec60c84",
                                                "sense_id": "28ae3ba0-b7f5-3f65-ac34-4c0f93766197",
                                                "text": "a leaderless disinformation campaign, with claims leaping from conspiracy theorists to state propagandists to alternative-media outlets and back—an ecosystem I call the Counterfactual Community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fc92960-6c46-3450-94cb-d2e442a976f4",
                                        "entry_id": "c5231880-a6df-3fc9-96a8-dd9a6d2d5ed1",
                                        "glosses": [
                                            "Of or in comparison to a hypothetical state of the world."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "424f94e2-6dfe-4eeb-8aea-cceae51db38c",
                                                "sense_id": "8fc92960-6c46-3450-94cb-d2e442a976f4",
                                                "text": "What would have happened if those great Chinese voyages [by Zheng He] had continued? It's one of those questions in counter-factual history about which it is impossible to be sure."
                                            },
                                            {
                                                "example_id": "afe35f51-6dbf-4011-936f-f470c4376359",
                                                "sense_id": "8fc92960-6c46-3450-94cb-d2e442a976f4",
                                                "text": "The counterfactual 1982 of the novel plays variations on our historical record and contains clear allusions to the present."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "counterfactual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee7ce859-0b01-36b8-8bb0-1e0708b447c3",
                                        "entry_id": "7df06904-27a7-34f3-8989-468699109758",
                                        "glosses": [
                                            "A claim, hypothesis, or other belief that is contrary to the facts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d528ed39-6f43-3f86-a8de-e334fdbb059c",
                                        "entry_id": "7df06904-27a7-34f3-8989-468699109758",
                                        "glosses": [
                                            "A hypothetical state of the world, used to assess the impact of an action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67b15335-687d-426a-aa5f-a3cb48ea9152",
                                                "sense_id": "d528ed39-6f43-3f86-a8de-e334fdbb059c",
                                                "text": "Just as counterfactuals employ too much imagination to qualify as historical works, alternate history often labors under too great a load of artificial \"facts\" to take flight as fiction."
                                            },
                                            {
                                                "example_id": "a6a1a524-283d-4ffa-a587-46f6d7fc6e28",
                                                "sense_id": "d528ed39-6f43-3f86-a8de-e334fdbb059c",
                                                "text": "We can spin out complicated counterfactuals that justify the Iraq invasion, and complicated counterfactuals that make it look even worse."
                                            },
                                            {
                                                "example_id": "5474e981-9caa-40bf-ae08-26eb2ca88768",
                                                "sense_id": "d528ed39-6f43-3f86-a8de-e334fdbb059c",
                                                "text": "The implicit counterfactual — that these members would support gun control if not for the $1,000 they received from the NRA — seems unlikely to me."
                                            },
                                            {
                                                "example_id": "f106c7bc-df6d-4b06-8904-72cfe5466725",
                                                "sense_id": "d528ed39-6f43-3f86-a8de-e334fdbb059c",
                                                "text": "Roese also says counterfactuals can serve emotional purposes. You can think about how things could have been worse, and so feel better about yourself, and grateful for where you are."
                                            },
                                            {
                                                "example_id": "4d894ed4-b8de-41b6-91a3-af947e18ba20",
                                                "sense_id": "d528ed39-6f43-3f86-a8de-e334fdbb059c",
                                                "text": "Imagine a counterfactual in which we started relaxing restrictions at an even earlier time, just as the cases began to trend downward."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dca73719-8451-3c31-b84d-2da33c101a9f",
                                        "entry_id": "7df06904-27a7-34f3-8989-468699109758",
                                        "glosses": [
                                            "A conditional statement in which the conditional clause is false."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c259146a-37a5-4821-9cab-9bd252b5e5bc",
                        "source_entry_id": "2bbade68-f60c-3299-882f-2d5da61b3ae6",
                        "source_sense_id": "9d2be2b0-6b0d-3a71-a60e-7e3d911c1fba",
                        "target_lang_word": "counterfeit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "counterfeit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b66542b-dd31-315f-a08f-d71564de64ae",
                                        "entry_id": "34cc7705-0d3d-3dc3-b047-1437af523ac5",
                                        "glosses": [
                                            "To falsely produce what appears to be official or valid; to produce a forged copy of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7785e139-a9fb-45d7-9984-70f145b39b1a",
                                                "sense_id": "4b66542b-dd31-315f-a08f-d71564de64ae",
                                                "text": "to counterfeit the signature of another, coins, notes, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68e0808b-8d52-358c-be24-34819d326fc3",
                                        "entry_id": "34cc7705-0d3d-3dc3-b047-1437af523ac5",
                                        "glosses": [
                                            "To produce a faithful copy of."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "580fa649-8684-4235-9408-570b791b8cfd",
                                                "sense_id": "68e0808b-8d52-358c-be24-34819d326fc3",
                                                "text": "The title page of White's original album includes a descriptive title page that identifies the contents as “the pictures of sondry things collected and counterfeited according to the truth,\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "061491ed-b510-302c-9e42-1c81a6983bf8",
                                        "entry_id": "34cc7705-0d3d-3dc3-b047-1437af523ac5",
                                        "glosses": [
                                            "To feign; to mimic."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4397781-c585-4250-9708-68c84b38fe1e",
                                                "sense_id": "061491ed-b510-302c-9e42-1c81a6983bf8",
                                                "text": "to counterfeit the voice of another person"
                                            },
                                            {
                                                "example_id": "08ecee5c-49f3-4bc3-8604-abb9f021b53d",
                                                "sense_id": "061491ed-b510-302c-9e42-1c81a6983bf8",
                                                "text": "Full well they laughed with counterfeited glee / At all his jokes, for many a joke had he."
                                            },
                                            {
                                                "example_id": "d3cccca0-843a-4312-a9eb-cdde7cb56c50",
                                                "sense_id": "061491ed-b510-302c-9e42-1c81a6983bf8",
                                                "text": "I again conveyed his key into his pocket, and counterfeiting sleep—though I never once closed my eyes, lay in bed till after he arose and went to prayers—an exercise to which I had long been unaccustomed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b8c49b9-4c35-3ca0-a77a-f5b7ea0b608b",
                                        "entry_id": "34cc7705-0d3d-3dc3-b047-1437af523ac5",
                                        "glosses": [
                                            "Of a turn or river card, to invalidate a player's hand by making a better hand on the board."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "counterfeit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f72ae19-9750-38b7-8e56-7e2218f02cc5",
                                        "entry_id": "a3028b06-0ef9-3b58-81d4-c767ca867f27",
                                        "glosses": [
                                            "False, especially of money; intended to deceive or carry appearance of being genuine."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20d06b26-88ed-4067-bca1-7247de4e7ea8",
                                                "sense_id": "5f72ae19-9750-38b7-8e56-7e2218f02cc5",
                                                "text": "This counterfeit watch looks like the real thing, but it broke a week after I bought it."
                                            },
                                            {
                                                "example_id": "08877001-343f-4bb0-8345-97ca535206f2",
                                                "sense_id": "5f72ae19-9750-38b7-8e56-7e2218f02cc5",
                                                "text": "Finding out Irish people might have been slaves is kind of like finding a counterfeit bill where you're like, \"You think I can use this for something?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41305980-d1c3-3611-b32a-167c52b31ecc",
                                        "entry_id": "a3028b06-0ef9-3b58-81d4-c767ca867f27",
                                        "glosses": [
                                            "Inauthentic."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bf588ed-8fc2-4e6a-b86e-8c6dd1f4e43c",
                                                "sense_id": "41305980-d1c3-3611-b32a-167c52b31ecc",
                                                "text": "counterfeit sympathy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1cc490c-eaf8-3496-8ca1-7a2dabede5ad",
                                        "entry_id": "a3028b06-0ef9-3b58-81d4-c767ca867f27",
                                        "glosses": [
                                            "Assuming the appearance of something; deceitful; hypocritical."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "471e7692-4094-4a98-8d93-9243d25ae3a8",
                                                "sense_id": "b1cc490c-eaf8-3496-8ca1-7a2dabede5ad",
                                                "text": "an arrant counterfeit rascal"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "counterfeit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5083b22-07dd-307e-9696-6a04fdcba60f",
                                        "entry_id": "5598638d-9d1c-326c-8f89-091965ca7d92",
                                        "glosses": [
                                            "A non-genuine article; a fake."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dcb81d5-0c6a-4fee-9b3a-a840801f65b6",
                                                "sense_id": "a5083b22-07dd-307e-9696-6a04fdcba60f",
                                                "text": "Never call a true piece of gold a counterfeit."
                                            },
                                            {
                                                "example_id": "5201e071-d4eb-46a0-88f7-b64f715b95fd",
                                                "sense_id": "a5083b22-07dd-307e-9696-6a04fdcba60f",
                                                "text": "Some of these counterfeits are fabricated with such exquisite taste and skill, that it is the achievement of criticism to distinguish them from originals."
                                            },
                                            {
                                                "example_id": "dbb600f1-0ad1-4b60-9bce-8a0dbe0c0a04",
                                                "sense_id": "a5083b22-07dd-307e-9696-6a04fdcba60f",
                                                "text": "‘Revelation’, to a philosopher such as Plotinus, was not merely irrational: it led to second-rate counterfeits of traditional academic philosophical culture. It was as if the inhabitants of an underdeveloped country were to seek to catch up with western technology by claiming to have learnt nuclear physics through dreams and oracles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b057628-867b-3b3e-92db-aa7b3094db09",
                                        "entry_id": "5598638d-9d1c-326c-8f89-091965ca7d92",
                                        "glosses": [
                                            "One who counterfeits; a counterfeiter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8060c63-8fa3-3ff7-b7f0-f7b6e8a07838",
                                        "entry_id": "5598638d-9d1c-326c-8f89-091965ca7d92",
                                        "glosses": [
                                            "That which resembles another thing; a likeness; a portrait; a counterpart."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ef81f9-9763-43f5-8566-2ee585343d50",
                                                "sense_id": "f8060c63-8fa3-3ff7-b7f0-f7b6e8a07838",
                                                "text": "Thou drawest a counterfeit / Best in all Athens."
                                            },
                                            {
                                                "example_id": "d16be9d5-c8b5-4ec4-9099-72db0279e166",
                                                "sense_id": "f8060c63-8fa3-3ff7-b7f0-f7b6e8a07838",
                                                "text": "Even Nature's self envied the same, / And grudged to see the counterfeit should shame / The thing itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4a62fba-43a2-30f9-8807-d6578678b0e8",
                                        "entry_id": "5598638d-9d1c-326c-8f89-091965ca7d92",
                                        "glosses": [
                                            "An impostor; a cheat."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffff56b1-089f-4668-8f15-42486bce0921",
                                                "sense_id": "c4a62fba-43a2-30f9-8807-d6578678b0e8",
                                                "text": "I fear thou art another counterfeit; / And yet, in faith, thou bear'st thee like a king."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
