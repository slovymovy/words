                                    {
                                        "sense_id": "170bf907-e03a-3709-b977-425cf8d3914c",
                                        "entry_id": "eb18db88-cdba-34e3-9977-c4a74f924bfc",
                                        "glosses": [
                                            "sich im Vergleich abhebend, einen unterschiedlichen Charakter besitzend, durch Absonderung entstanden oder entstehend"
                                        ],
                                        "tags": [
                                            "häufig mit der Tendenz zum Außergewöhnlichen",
                                            "zum Komischen",
                                            "zum Skurrilen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c332a895-d611-4827-b7a8-da89899e876f",
                                                "sense_id": "170bf907-e03a-3709-b977-425cf8d3914c",
                                                "text": "Im Grunde ist jeder Mensch sonderbar."
                                            },
                                            {
                                                "example_id": "bc5ba0c4-0a0d-4b29-b395-9130b3c50fef",
                                                "sense_id": "170bf907-e03a-3709-b977-425cf8d3914c",
                                                "text": "„Brechts Lehrtheater ist ein Welttheater, in welchem die unendliche Welt sonderbar klein und viereckig geworden ist: etwas größer vielleicht als eine Zigarrenkiste, kaum größer als eine deutsche Schulstube.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
