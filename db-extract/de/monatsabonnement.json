                "senses": [
                    {
                        "sense_id": "b54e84d4-6bce-35f9-9dc3-be920951acfc",
                        "entry_id": "7d65396d-cd19-3520-bf6c-e4918ef76597",
                        "glosses": [
                            "Abonnement, das einen Monat Gültigkeit hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdfd4e00-0bc7-4593-a905-1bd976b016fb",
                                "sense_id": "b54e84d4-6bce-35f9-9dc3-be920951acfc",
                                "text": "„Nach und nach trudelten weitere Männer ein, die alle ein Monatsabonnement hatten.“"
                            },
                            {
                                "example_id": "54f9eb54-c970-448c-906d-939cc005f1c1",
                                "sense_id": "b54e84d4-6bce-35f9-9dc3-be920951acfc",
                                "text": "„Er erhält von seinem Arbeitgeber zusätzlich zum ohnehin geschuldeten Arbeitslohn ein Monatsabonnement für die ICE-Strecke Düsseldorf–Frankfurt.“"
                            },
                            {
                                "example_id": "28c52533-fd9a-4aa9-93f8-0fb2d6ca222c",
                                "sense_id": "b54e84d4-6bce-35f9-9dc3-be920951acfc",
                                "text": "„Als Nächstes wollte man die Korrelation zwischen dem für ein Monatsabonnement ausgegebenen Betrag und der Kundenzufriedenheit untersuchen, denn die Beträge schwankten zwischen 10 € und 5000 € pro Monat.“"
                            },
                            {
                                "example_id": "b9bad58e-cc36-43d5-b6e1-3a7d9869ed59",
                                "sense_id": "b54e84d4-6bce-35f9-9dc3-be920951acfc",
                                "text": "„Diese Monatsabonnements sind aber auch so teuer, daß sie von den Eltern unserer Kinder einfach nicht hätten bestritten werden können.“"
                            },
                            {
                                "example_id": "ae576347-0b6c-4912-a088-cc1949974a89",
                                "sense_id": "b54e84d4-6bce-35f9-9dc3-be920951acfc",
                                "text": "„Die Nachricht, dass die Verwaltung der Birsigtalbahn die Preise für die Monatsabonnemente zur Benutzung der Birsigtalbahn um rund 40 % erhöhte, hat einen Sturm der Entrüstung und des Unwillens hervorgerufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
