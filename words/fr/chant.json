                        "professeur de chant"
                    ]
                },
                {
                    "sense_id": "6e989d06-030a-3505-92cf-84e3caeb5210",
                    "sense_definition": "Composition musicale vocale accompagnée de paroles.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la chorale a entonné un <w>chant</w> de Noël devant le public réuni."
                        },
                        {
                            "text": "Les marins chantaient un vieux <w>chant</w> traditionnel pour se donner du courage."
                        }
                    ],
                    "synonyms": [
                        "chanson",
                        "hymne"
                    ],
                    "common_phrases": [
