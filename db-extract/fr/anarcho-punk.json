                    },
                    {
                        "sense_id": "24c89623-487a-3bf4-b0c0-589e6298c0c4",
                        "entry_id": "d2b2b97b-3c76-3007-bdcb-47c7260956d6",
                        "glosses": [
                            "Genre musical contestataire caractérisé par l’utilisation de guitare électrique et d’un chant crié aux textes engagés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca9857cb-9449-44ed-b2f0-75fabb21f694",
                                "sense_id": "24c89623-487a-3bf4-b0c0-589e6298c0c4",
                                "text": "Sur deux soirs noirs, très noirs, le festival réunira la sale graine et la fine fleur de l’anarcho-punk de France et d’Europe."
                            },
                            {
                                "example_id": "7aa66a0f-20d9-4195-bd6b-4fbd00178cbd",
                                "sense_id": "24c89623-487a-3bf4-b0c0-589e6298c0c4",
                                "text": "Au loin, elle reconnut les premiers accords de Go Green d’Oï Polloï, le groupe anglais d’anarcho-punk."
                            }
                        ]
                    },
