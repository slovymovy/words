{
    "word_family": [
        "chesty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef58de39-7569-396f-8e22-5a8f764a220d",
                    "sense_definition": "The upper front part of the human body between the neck and the stomach, containing the heart and lungs.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He folded his arms across his <w>chest</w> and waited.",
                            "target_lang_translations": {
                                "ru": "Он скрестил руки на <w>груди</w> и стал ждать.",
                                "zh": "他双臂交叉抱在<w>胸前</w>，等待着。"
                            }
                        },
                        {
                            "text": "The doctor listened to her <w>chest</w> with a stethoscope.",
                            "target_lang_translations": {
                                "ru": "Врач послушал её <w>грудь</w> стетоскопом.",
                                "zh": "医生用听诊器听了听她的<w>胸部</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chest pain",
                        "broad chest",
                        "bare chest",
                        "get off one's chest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхняя передняя часть туловища человека между шеей и животом, содержащая сердце и легкие.",
                        "zh": "人体颈部和腹部之间的上半身前部，内有心脏和肺。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грудь",
                                "target_lang_sense_clarification": "часть тела"
                            },
                            {
                                "target_lang_word": "грудная клетка",
                                "target_lang_sense_clarification": "анатомический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胸部",
                                "target_lang_sense_clarification": "身体部位"
                            },
                            {
                                "target_lang_word": "胸腔",
                                "target_lang_sense_clarification": "解剖学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e07df85-c161-3cd1-b3f6-4213c3827a57",
                    "sense_definition": "A large, strong box with a heavy lid, used for storing things or moving them.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pirates buried a heavy wooden <w>chest</w> filled with gold.",
                            "target_lang_translations": {
                                "ru": "Пираты закопали тяжелый деревянный <w>сундук</w>, наполненный золотом.",
                                "zh": "海盗们埋下了一个装满黄金的沉重木<w>箱</w>。"
                            }
                        },
                        {
                            "text": "She keeps her childhood toys in a large <w>chest</w> at the foot of her bed.",
                            "target_lang_translations": {
                                "ru": "Она хранит свои детские игрушки в большом <w>сундуке</w> в изножье кровати.",
                                "zh": "她把童年的玩具放在床尾的一个大<w>箱子</w>里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trunk",
                        "box",
                        "case"
                    ],
                    "common_phrases": [
                        "treasure chest",
                        "wooden chest",
                        "toy chest",
                        "tool chest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой прочный ящик с тяжелой крышкой, используемый для хранения или перевозки вещей.",
                        "zh": "一种带有沉重盖子的大型坚固箱子，用于存放或搬运物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сундук",
                                "target_lang_sense_clarification": "большой ящик с крышкой, часто старинный"
                            },
                            {
                                "target_lang_word": "ящик",
                                "target_lang_sense_clarification": "контейнер для хранения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "箱子",
                                "target_lang_sense_clarification": "通用容器"
                            },
                            {
                                "target_lang_word": "木箱",
                                "target_lang_sense_clarification": "材质为木头的箱子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a276a41a-f3ea-350d-adab-dffe08e8ed25",
                    "sense_definition": "A piece of furniture consisting of a set of drawers for holding clothes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I put my clean socks in the top drawer of the <w>chest</w>.",
                            "target_lang_translations": {
                                "ru": "Я положил свои чистые носки в верхний ящик <w>комода</w>.",
                                "zh": "我把干净的袜子放进了<w>抽屉柜</w>的最上层。"
                            }
                        },
                        {
                            "text": "They bought a pine <w>chest</w> to match the bed frame.",
                            "target_lang_translations": {
                                "ru": "Они купили сосновый <w>комод</w> под цвет каркаса кровати.",
                                "zh": "他们买了一个松木<w>抽屉柜</w>来搭配床架。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chest of drawers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет мебели, состоящий из набора выдвижных ящиков для хранения одежды.",
                        "zh": "一种带有抽屉的家具，用于存放衣物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комод",
                                "target_lang_sense_clarification": "мебель с выдвижными ящиками"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抽屉柜",
                                "target_lang_sense_clarification": "家具类型"
                            },
                            {
                                "target_lang_word": "五斗橱",
                                "target_lang_sense_clarification": "传统的抽屉柜"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0383cb5-e6fc-3190-b634-04c12687e4df",
                    "sense_definition": "To control or hit a ball using the upper front part of the body, especially in soccer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sport_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker <w>chested</w> the ball down and kicked it into the goal.",
                            "target_lang_translations": {
                                "ru": "Нападающий <w>принял</w> мяч <w>на грудь</w>, опустил его вниз и ударил по воротам.",
                                "zh": "前锋用<w>胸部</w>把球停下，然后起脚射门得分。"
                            }
                        },
                        {
                            "text": "He <w>chested</w> the pass to his teammate to keep the play moving.",
                            "target_lang_translations": {
                                "ru": "Он <w>скинул грудью</w> пас своему товарищу по команде, чтобы продолжить игру.",
                                "zh": "他用<w>胸部</w>将球传给队友，以保持比赛节奏。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chest the ball",
                        "chest it down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать или отбивать мяч верхней передней частью туловища, особенно в футболе.",
                        "zh": "在足球等运动中，用身体前部控制或拦截球。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимать на грудь",
                                "target_lang_sense_clarification": "футбольный термин"
                            },
                            {
                                "target_lang_word": "отбивать грудью",
                                "target_lang_sense_clarification": "действие в спорте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胸部停球",
                                "target_lang_sense_clarification": "足球术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}