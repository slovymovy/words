            "senses": [
                {
                    "sense_id": "e26fe469-f456-3e7e-a022-b7e6a46532e8",
                    "sense_definition": "Causing irritation, annoyance, or discomfort; bothersome or irksome.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "irritating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My old car is very <w>nettlesome</w> because it breaks down constantly.",
                            "target_lang_translations": {
                                "ru": "Моя старая машина очень <w>раздражает</w>, потому что она постоянно ломается."
                            }
                        },
                        {
                            "text": "The constant noise from the construction site was quite <w>nettlesome</w> for the neighbors.",
                            "target_lang_translations": {
                                "ru": "Постоянный шум со стройки был весьма <w>надоедливым</w> для соседей."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoying",
                        "bothersome",
                        "irksome",
                        "vexing"
                    ],
                    "antonyms": [
                        "pleasant",
                        "agreeable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий раздражение, досаду или дискомфорт; надоедливый или неприятный."
                    },
                    "translations": {
                        "ru": [
                            {
