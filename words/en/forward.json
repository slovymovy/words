                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "progress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did everything he could to <w>forward</w> his own career.",
                            "target_lang_translations": {
