                            {
                                "example_id": "d8242442-5a43-45aa-bd18-e62f6e0f13bb",
                                "sense_id": "ca38505b-17bc-3d39-b7ad-7bf57dc90240",
                                "text": "Der Südostwind flaute am Abend ab."
                            },
                            {
                                "example_id": "cc1128d4-fae8-436c-819a-2f796d757701",
                                "sense_id": "ca38505b-17bc-3d39-b7ad-7bf57dc90240",
                                "text": "„Aber sie verbrämte ihr Sträuben durch eine Ergänzung, die es mir versüßte; sie meinte nämlich, wir könnten überrascht werden, und es sei besser, bis zum Abend zu warten, da der Südostwind ja noch stärker blase als am Vortag.“"
                            }
                        ],
