                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad0314db-5055-4698-8efe-1b9c92e5981f",
                                "sense_id": "d039b869-d34e-38ca-8f56-57dbc51d7902",
                                "text": "„Der Hauptfeldwebel verweigerte den Impfbefehl.“"
                            },
                            {
                                "example_id": "c7488fa9-0eeb-4b48-8b37-821529c331df",
                                "sense_id": "d039b869-d34e-38ca-8f56-57dbc51d7902",
                                "text": "„Im vergangenen Juli hatte das Amtsgericht (AG) Bad Kissingen den 27-Jährigen freigesprochen, weil es den Impfbefehl aus dem Jahr 2022 nicht für verhältnismäßig hielt.“"
                            },
                            {
                                "example_id": "c33685ad-6075-43b8-9907-1eded5ff2fe8",
                                "sense_id": "d039b869-d34e-38ca-8f56-57dbc51d7902",
                                "text": "„Er begründete das den Angaben nach damit, dass er den Impfbefehl für rechts- und verfassungswidrig halte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
