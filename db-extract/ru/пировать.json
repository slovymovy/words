                ],
                "senses": [
                    {
                        "sense_id": "14c0d9c4-c483-349a-a9f6-63ef45a34756",
                        "entry_id": "b849c4d1-348d-31fd-9c02-a6cf351fd6e9",
                        "glosses": [
                            "проводить время на пире, за пиром; принимать участие в пире"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f793088-7123-4092-8c36-59b356d5753f",
                                "sense_id": "14c0d9c4-c483-349a-a9f6-63ef45a34756",
                                "text": "Ты целый день пировал у немца, воротился пьян, завалился в посте́лю, да и спал до сего ча́са, как уж к обедне отблаговестили."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a2d390a-320b-4842-bdb7-33022f097f1d",
                        "source_entry_id": "b849c4d1-348d-31fd-9c02-a6cf351fd6e9",
                        "source_sense_id": "14c0d9c4-c483-349a-a9f6-63ef45a34756",
                        "target_lang_word": "feast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4499a9e-6638-3f42-8810-0f76c6c16aa6",
                                        "entry_id": "04753c9f-92ca-3e48-8427-b321ccd14482",
                                        "glosses": [
                                            "A holiday, festival, especially a religious one"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2877a9f-ed1b-43f7-ba49-220865df89b6",
                                                "sense_id": "d4499a9e-6638-3f42-8810-0f76c6c16aa6",
                                                "text": "The seventh day shall be a feast to the Lord."
                                            },
                                            {
                                                "example_id": "0b05dcf1-561f-4e23-814c-425be5303c4b",
                                                "sense_id": "d4499a9e-6638-3f42-8810-0f76c6c16aa6",
                                                "text": "Now his parents went to Jerusalem every year at the feast of the passover."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ae85136-2876-32b0-96f1-7abb30dfbc3a",
                                        "entry_id": "04753c9f-92ca-3e48-8427-b321ccd14482",
                                        "glosses": [
                                            "A very large meal, often of a ceremonial nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ec09425-9087-4fd9-9eff-1b89f3f49d20",
                                                "sense_id": "5ae85136-2876-32b0-96f1-7abb30dfbc3a",
                                                "text": "We had a feast to celebrate the harvest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9863f69-0d43-3c03-97b2-d78f2675a438",
                                        "entry_id": "04753c9f-92ca-3e48-8427-b321ccd14482",
                                        "glosses": [
                                            "Something delightful"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bebc70b9-6ff3-4843-917f-18e7ec695d06",
                                                "sense_id": "b9863f69-0d43-3c03-97b2-d78f2675a438",
                                                "text": "It was a feast for the eyes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f457f9d-fbda-3daf-90a9-7f8ce13fc79e",
                                        "entry_id": "4b89ca0f-a952-34a1-8fcf-e891b4347b48",
                                        "glosses": [
                                            "To partake in a feast, or large meal."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b748fbd4-6ebe-45dd-b8e4-b3599661b0ab",
                                                "sense_id": "1f457f9d-fbda-3daf-90a9-7f8ce13fc79e",
                                                "text": "I feasted on turkey and dumplings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7161a144-b64c-3114-8b4d-510e0403bce6",
                                        "entry_id": "4b89ca0f-a952-34a1-8fcf-e891b4347b48",
                                        "glosses": [
                                            "To dwell upon (something) with delight."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07d4fa5d-1560-488e-986a-1f1561493273",
                                                "sense_id": "7161a144-b64c-3114-8b4d-510e0403bce6",
                                                "text": "With my love's picture then my eye doth feast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b090fe59-d756-35fb-bcec-4bd44bd0c4e6",
                                        "entry_id": "4b89ca0f-a952-34a1-8fcf-e891b4347b48",
                                        "glosses": [
                                            "To hold a feast in honor of (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59c9db80-1d4d-4c6c-8e7e-1076bc731421",
                                                "sense_id": "b090fe59-d756-35fb-bcec-4bd44bd0c4e6",
                                                "text": "He that shall see this day, and live old age,\nWill yearly on the vigil feast his neighbors\nAnd say “Tomorrow is Saint Crispian.”"
                                            },
                                            {
                                                "example_id": "0a8e348b-1309-44d1-847f-d2a516e7031e",
                                                "sense_id": "b090fe59-d756-35fb-bcec-4bd44bd0c4e6",
                                                "text": "His ancestor, he said, had been feasted there, when he went forward with the then Lord Ravenswood to the fatal battle of Flodden, in which they both fell."
                                            },
                                            {
                                                "example_id": "d7f69121-5aac-4c4d-a817-34343b80a094",
                                                "sense_id": "b090fe59-d756-35fb-bcec-4bd44bd0c4e6",
                                                "text": "We feasted them after the victory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15ef318b-4929-31d9-8364-59810c446f91",
                                        "entry_id": "4b89ca0f-a952-34a1-8fcf-e891b4347b48",
                                        "glosses": [
                                            "To serve as a feast for; to feed sumptuously."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e454e0d-b62d-4ee5-95fb-e24067140212",
                                                "sense_id": "15ef318b-4929-31d9-8364-59810c446f91",
                                                "text": "1597–1598, Joseph Hall, Virgidemiarum\nOr once a week, perhaps, for novelty / Reez'd bacon-soords shall feast his family."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcfa353c-b135-4203-9e55-a03deaed7fe4",
                        "source_entry_id": "b849c4d1-348d-31fd-9c02-a6cf351fd6e9",
                        "source_sense_id": "14c0d9c4-c483-349a-a9f6-63ef45a34756",
                        "target_lang_word": "carouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54f9dc79-e176-3ec9-afaf-363d24ae1e49",
                                        "entry_id": "f165a10c-d425-3fa3-b516-7323b3016b2d",
                                        "glosses": [
                                            "To engage in a noisy or drunken social gathering."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b9f28e4-116a-4c14-8f74-5863f8dc80fe",
                                                "sense_id": "54f9dc79-e176-3ec9-afaf-363d24ae1e49",
                                                "text": "We are all going to carouse at Brian's tonight."
                                            },
                                            {
                                                "example_id": "2b999c5e-99b9-42d3-8bc9-3ae09ca623ae",
                                                "sense_id": "54f9dc79-e176-3ec9-afaf-363d24ae1e49",
                                                "text": "The prospect of two hundred (or more) loitering and carousing patrons streaming out of the club at 1 a.m. is profoundly disturbing to us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "305c7533-d92f-3b84-a6a9-a952a83dab40",
                                        "entry_id": "f165a10c-d425-3fa3-b516-7323b3016b2d",
                                        "glosses": [
                                            "To drink to excess."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be848210-a461-468f-afb5-11cf6d696c55",
                                                "sense_id": "305c7533-d92f-3b84-a6a9-a952a83dab40",
                                                "text": "If I survive this headache, I promise no more carousing at Brian’s."
                                            },
                                            {
                                                "example_id": "417b1f28-2c7e-4c7e-9fac-197c80beb7e6",
                                                "sense_id": "305c7533-d92f-3b84-a6a9-a952a83dab40",
                                                "text": "[…] the cup-bearers did fill great gems made in form of cups with ancient wine, and the Demons caroused to Lord Juss deep draughts in honour of this day of his nativity."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "carouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e71407b-d74b-3534-9610-da7bce412a5c",
                                        "entry_id": "36b0287b-ad2a-3771-875c-6ca3bed0e2d6",
                                        "glosses": [
                                            "A large draught of liquor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bd9547b-8b76-486b-9b40-812fa24379c7",
                                                "sense_id": "3e71407b-d74b-3534-9610-da7bce412a5c",
                                                "text": "[…] therefore forward I went with my hey-de-gaies to Ilford, where I againe reſted, and was by the people of the towne and countrey there-about very very wel welcomed, being offred carowſes in the great ſpoon, one whole draught being able at that time to haue drawne my little wit drye; […]"
                                            },
                                            {
                                                "example_id": "e874e851-40bb-497b-bade-cba83f586477",
                                                "sense_id": "3e71407b-d74b-3534-9610-da7bce412a5c",
                                                "text": "Had our great Pallace the capacity\nTo Campe this hoaſt, we all would ſup together,\nAnd drinke Carowſes to the next dayes Fate […]"
                                            },
                                            {
                                                "example_id": "d1f4334f-e303-4efe-9bc1-624153ce4e27",
                                                "sense_id": "3e71407b-d74b-3534-9610-da7bce412a5c",
                                                "text": "[…] he hadde ſo many eyes watching ouer him, as he coulde not drinke a full Carouſe of Sacke, but the State was aduertised thereof, within few houres after."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c010ecd2-93a1-3611-81e0-f180f936840e",
                                        "entry_id": "36b0287b-ad2a-3771-875c-6ca3bed0e2d6",
                                        "glosses": [
                                            "A drinking bout; a carousal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78eb115d-59e4-433d-9610-4c9364c96de5",
                                                "sense_id": "c010ecd2-93a1-3611-81e0-f180f936840e",
                                                "text": "The early feast and late carouse."
                                            },
                                            {
                                                "example_id": "c29e7fcf-a58d-4d70-95c9-06f05951a745",
                                                "sense_id": "c010ecd2-93a1-3611-81e0-f180f936840e",
                                                "text": "PORSON […] would not only frequently “steal a few hours from the night,” but see out both lights and liquids, and seem none the worse for the carouse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6f2a185-66fa-4d1b-bed9-d1bce9380317",
