                    "frequency": "Middle",
                    "semantic_group_id": "odeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ouvre vite la fenêtre de la cuisine parce que ce vieux fromage <w>fouette</w> vraiment trop !"
