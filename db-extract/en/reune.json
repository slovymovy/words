                "senses": [
                    {
                        "sense_id": "4a8ed633-8446-3a60-beef-4bb3ea51419e",
                        "entry_id": "c7c96820-d9a8-3528-948b-e2f849792f1c",
                        "glosses": [
                            "To reunite."
                        ],
                        "tags": [
                            "proscribed"
                        ],
                        "examples": [
                            {
                                "example_id": "4e64ce08-363f-4c2d-a525-e6aa8feb7597",
                                "sense_id": "4a8ed633-8446-3a60-beef-4bb3ea51419e",
                                "text": "[…] we begin to realize what it means to have a REAL LIVE CLASS get together and decide to reune."
                            },
                            {
                                "example_id": "6104c2cb-4838-4f9e-a0bc-4c2a024e4566",
                                "sense_id": "4a8ed633-8446-3a60-beef-4bb3ea51419e",
                                "text": "This is the last time we can reune as a group, as on Saturday, June 21, we will be inducted into the Emeritus Club at the Alumni luncheon by Dr. Alexander G. Ruthven, President of the University of Michigan. From then on, we reune with the Emeritus Club every year."
                            },
                            {
                                "example_id": "85ef520f-d3a2-45b4-aac6-3f85bee63b5d",
                                "sense_id": "4a8ed633-8446-3a60-beef-4bb3ea51419e",
                                "text": "Heartened by this widespread response, a series of special broadcasts were planned for Commencement week. The Alumni Association sent notices to all alumni throughout the country: \"Reune by radio if you can't reune in person,\" was the message."
                            }
                        ]
                    }
