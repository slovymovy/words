                "senses": [
                    {
                        "sense_id": "32ccab56-95c3-31dc-bf28-f2673aa0b0dd",
                        "entry_id": "a1be1ba2-ade6-324c-a4ab-15408019a963",
                        "glosses": [
                            "To create a lexicon for."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4c799e3-58f6-40ea-a9d3-6231eb9d215a",
                                "sense_id": "32ccab56-95c3-31dc-bf28-f2673aa0b0dd",
                                "text": "In order to delineate and label realities, there are no natural concepts that only require linguistic label to be reflected; rather, groups lexiconize naturalized concepts and elements; pivotal to this linguistic encoding of notions are customs and worldview, both of which have been located within the Yoruba cosmology."
                            },
                            {
                                "example_id": "08c64701-80bc-404c-bee2-1d25e866847d",
                                "sense_id": "32ccab56-95c3-31dc-bf28-f2673aa0b0dd",
                                "text": "We hope that the present attempt to lexiconize the vast and multifaceted worlds of music's Romanticisms will serve as a stepping-stone for more satisfactory future contributions."
                            },
                            {
                                "example_id": "c63d512b-149d-4051-a463-ea2b138fb332",
                                "sense_id": "32ccab56-95c3-31dc-bf28-f2673aa0b0dd",
                                "text": "The dog had no way of naming things for itself and so Teddy had dutifully taken it upon himself to lexiconize the world for it."
                            }
                        ]
                    }
                ],
