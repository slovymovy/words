                        "glosses": [
                            "fest stehender Unterstand mit Dach, in dem Bienenstöcke aufgestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7606821-1700-403f-a059-591da2c5262e",
                                "sense_id": "da5a6ed6-d2b6-3ffa-99b1-1e50d6436a52",
                                "text": "In einem Bienenstand werden je nach Landwirt und dessen Ackerfrucht unterschiedlich viele Bienenstöcke aufgestellt."
                            },
                            {
                                "example_id": "0a698d18-fc0c-4d68-834c-69e5d610a2c1",
                                "sense_id": "da5a6ed6-d2b6-3ffa-99b1-1e50d6436a52",
                                "text": "„Über den Winter ist Winterpause angesagt, trotzdem sollte man regelmäßig den Bienenstand kontrollieren, Deckel müssen sturmsicher beschwert oder fixiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
