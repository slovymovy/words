                                                "sense_id": "4c390652-579c-37d5-b284-c884bb6da2bd",
                                                "text": "The photogenic bacteria were visible in the dark room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28924110-9480-37c0-9e28-dd373ec55018",
                                        "entry_id": "52d9941a-0d4c-329e-95e7-25f9a041bab0",
                                        "glosses": [
                                            "Looking good when photographed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae25efa2-9e19-4d8b-a8b5-d2662e6f093d",
                                                "sense_id": "28924110-9480-37c0-9e28-dd373ec55018",
                                                "text": "The company hired the spokesperson for his photogenic face."
                                            },
                                            {
                                                "example_id": "d052ad30-5777-4362-a79b-a8f60877d344",
                                                "sense_id": "28924110-9480-37c0-9e28-dd373ec55018",
                                                "text": "Despite being compellingly photogenic, many eagles are difficult photographic targets, particularly when there is bright sunlight."
                                            },
                                            {
                                                "example_id": "300dd3d9-f3a4-47b2-858f-9826f78048b5",
                                                "sense_id": "28924110-9480-37c0-9e28-dd373ec55018",
                                                "text": "\"And besides, you've made it so easy to find reference images of you. You're quite... photogenic.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
