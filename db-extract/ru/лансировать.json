                "senses": [
                    {
                        "sense_id": "7724c21f-8385-334f-83a7-1e6d7b7427aa",
                        "entry_id": "0eb25728-6d08-374d-b81a-07d9dbf27395",
                        "glosses": [
                            "устар. пускать (пустить) в оборот, распространять (распространить) в публике, вводить (ввести) в моду, продвигать (продвинуть)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43471e33-6653-4aea-84cc-2d336bf49c33",
                                "sense_id": "7724c21f-8385-334f-83a7-1e6d7b7427aa",
                                "text": "Они могли бы очень меня лансировать в свет, если бы захотели."
                            },
                            {
                                "example_id": "62e9308e-beed-4bcc-b0ae-676fba54e5d5",
                                "sense_id": "7724c21f-8385-334f-83a7-1e6d7b7427aa",
                                "text": "Тут же на бульваре, позади балагана, наполненного сусальными пряниками, уличные шансоньеры, неунывающие острословы, знатоки и любимцы Парижа, собирают толпу писком дедовских скрипок и лансируют новую песенку, которой суждено, по-видимому, занять место прошлогоднего «Mon homme»…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f5e8a5b-814c-4e22-974f-aad6b60f83c4",
                        "source_entry_id": "0eb25728-6d08-374d-b81a-07d9dbf27395",
                        "source_sense_id": "7724c21f-8385-334f-83a7-1e6d7b7427aa",
                        "target_lang_word": "lancieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lancieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6244344a-eed9-3749-a069-8ed950fd1593",
                                        "entry_id": "4b6b83a2-4e73-3e2c-aa20-2ecc7abddc04",
                                        "glosses": [
                                            "an die Öffentlichkeit bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "692e87bc-911a-4b3e-9e38-4eb9daaf6393",
                                                "sense_id": "6244344a-eed9-3749-a069-8ed950fd1593",
                                                "text": "Gezielt lancierte der Vorstand die beabsichtige Verpflichtung von zwei Topspielern für die nächste Saison so frühzeitig, dass der Dauerkartenverkauf davon profitieren musste."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "feed52d6-07ff-390d-91df-dde280393c0a",
                                        "entry_id": "4b6b83a2-4e73-3e2c-aa20-2ecc7abddc04",
                                        "glosses": [
                                            "geschickt an einen günstigen Platz, in eine vorteilhafte Position bringen (auch mit zweifelhaften, unredlichen Methoden)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39ca32b5-348d-4a8b-9158-69e3a109b2ca",
                                                "sense_id": "feed52d6-07ff-390d-91df-dde280393c0a",
                                                "text": "Er hat hier einige seiner Vereinskameraden lanciert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8ab98e07-fcc9-3fcb-8612-48c7cb2ec598",
                                        "entry_id": "4b6b83a2-4e73-3e2c-aa20-2ecc7abddc04",
                                        "glosses": [
                                            "einer Person oder Sache durch bestimmte Maßnahmen zur Bekanntheit verhelfen (zum Beispiel bei der Markteinführung eines neuen Produktes)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b3fca0c-75e9-4542-aa32-58bd45a4e766",
                                                "sense_id": "8ab98e07-fcc9-3fcb-8612-48c7cb2ec598",
                                                "text": "„Außerdem lancieren sie Mode, vor allem T-Shirts und Sweatshirts mit bunten Druckmotiven, geliefert von der hauseigenen Grafikabteilung.“"
                                            },
                                            {
                                                "example_id": "00761119-fc93-412f-b5de-a5d72626be11",
                                                "sense_id": "8ab98e07-fcc9-3fcb-8612-48c7cb2ec598",
                                                "text": "„John Hammond hat Beziehungen zu den wichtigen Plattenfirmen und verwendet seinen Einfluss darauf, Karrieren zu lancieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
