                "senses": [
                    {
                        "sense_id": "22f8ab5a-a9d7-3908-bee9-4d4337a0af9a",
                        "entry_id": "fd129b99-785c-3a9b-987b-4af8d6cb4e59",
                        "glosses": [
                            "eine Frau, die Rache ausübt (die sich oder jemand anders rächt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b492027-704d-4d58-b024-1727187827f9",
                                "sense_id": "22f8ab5a-a9d7-3908-bee9-4d4337a0af9a",
                                "text": "Nachdem man ihr das Liebste genommen hatte, wurde sie zur furchtlosen Rächerin."
                            },
                            {
                                "example_id": "6245092e-5026-4f5b-bcca-479f4a676d58",
                                "sense_id": "22f8ab5a-a9d7-3908-bee9-4d4337a0af9a",
                                "text": "„Dagegen mobilisiert Dahl nicht nur schauderhafte Bilder von Gewalt, sondern auch die ältesten Rachegöttinnen der europäischen Literatur. Wer seine Erynnien sind und warum diese zeitgenössischen Rächerinnen nicht, wie bei Aischylos die Eumeniden, von ihrer Rache ablassen können - das finden die modernen Kreuzritter der A-Gruppe nach und nach heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
