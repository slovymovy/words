                {
                    "sense_id": "f7552850-46ab-365b-89e8-3c5e1ffc5e29",
                    "sense_definition": "Een brede, open en waterdichte bak die gebruikt wordt voor de was of om iets in schoon te maken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wasbak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij maakte een <w>teil</w> met sop om zijn motor schoon te maken.",
                            "target_lang_translations": {
                                "en": "He prepared a <w>tub</w> of soapy water to clean his motorcycle."
                            }
                        },
                        {
                            "text": "Vroeger deden mensen de was in een grote zinken <w>teil</w>.",
                            "target_lang_translations": {
                                "en": "In the past, people did the laundry in a large zinc <w>tub</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tobbe"
                    ],
                    "common_phrases": [
                        "zinken teil",
                        "teil met sop"
                    ],
                    "target_lang_definitions": {
                        "en": "A wide, open, and waterproof container used for washing or cleaning things."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tub",
                                "target_lang_sense_clarification": "a wide, open container used for washing"
                            },
                            {
                                "target_lang_word": "basin",
                                "target_lang_sense_clarification": "a large open bowl for water"
                            },
                            {
                                "target_lang_word": "washbowl",
                                "target_lang_sense_clarification": "a bowl used for washing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a2ac86c-1754-30a5-a8dd-3a5923ee7740",
                    "sense_definition": "Een schaal of bakje dat gebruikt wordt voor het serveren van een gerecht.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "servies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De warme groenten werden geserveerd in een mooie aardewerken <w>teil</w>.",
                            "target_lang_translations": {
                                "en": "The warm vegetables were served in a beautiful earthenware <w>dish</w>."
                            }
                        },
                        {
                            "text": "Zet die <w>teil</w> met salade maar midden op de eettafel.",
                            "target_lang_translations": {
                                "en": "Just put that <w>bowl</w> of salad in the middle of the dining table."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A dish or bowl used for serving food."
                    },
                    "translations": {
