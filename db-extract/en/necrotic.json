                                        "glosses": [
                                            "Qui est en rapport avec la nécrose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6a5fc15-2a73-4b83-9539-7be43be01eb7",
                                                "sense_id": "1bd80393-e198-37b3-bcfd-5a6a5380ad0d",
                                                "text": "Le phosphure de zinc employé comme rodenticide puissant, produit en général des lésions nécrotiques ou rénales et entraîne la mort par défaillance cardiaque."
                                            },
                                            {
                                                "example_id": "6190c931-4129-4d8c-a1bb-3bd1a963a397",
                                                "sense_id": "1bd80393-e198-37b3-bcfd-5a6a5380ad0d",
                                                "text": "Avec le temps, une rétraction de la zone nécrotique est également possible ; la nécrose est alors objectivée au centre de la tête, sans ou avec peu de rapport avec la lame osseuse sous-chondale."
                                            }
                                        ]
