                                        "entry_id": "4eca3782-9ca3-322d-a533-a9b8d943c0ca",
                                        "glosses": [
                                            "ανώτατος κληρικός ή προϊστάμενος κληρικών μιας εκκλησιαστικής περιφέρειας"
                                        ],
