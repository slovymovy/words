                ],
                "senses": [
                    {
                        "sense_id": "6f71ad4d-288f-3532-b164-83418764dcfc",
                        "entry_id": "3dce8317-741c-3ece-b630-75ca1ab39d7b",
                        "glosses": [
                            "Greifen des Turngeräts von unten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fe1736a-049e-4911-8d74-84427cc77d88",
                                "sense_id": "6f71ad4d-288f-3532-b164-83418764dcfc",
                                "text": "Beim Untergriff zeigen die beiden Handinnenflächen nach oben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e3c024ac-d754-337e-b358-7910b85bb7bc",
                        "entry_id": "3dce8317-741c-3ece-b630-75ca1ab39d7b",
                        "glosses": [
                            "umschlingender Griff über den Hüften beim Ringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4e8ae97-f468-4e64-b932-50b88e505bdc",
                                "sense_id": "e3c024ac-d754-337e-b358-7910b85bb7bc",
                                "text": "Um den Untergriff ringen. Es handelt sich darum, wer von zweien den andern unter den Armen um die Hüften fassen und diesen Griff (den sogen. Untergriff) eine gewisse, z. B. vom Lehrer durch Zählen bestimmte Zeit hindurch beibehalten kann."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5e729ce1-7875-3f7c-a919-6b57e54581a0",
                        "entry_id": "3dce8317-741c-3ece-b630-75ca1ab39d7b",
                        "glosses": [
                            "Beleidigung oder versteckter Angriff"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "912d7cc7-7a38-46fd-a6d3-320f5f463d67",
                                "sense_id": "5e729ce1-7875-3f7c-a919-6b57e54581a0",
                                "text": "Die österreichische Kabaretttradition stellt wohl ein Spezifikum dar. Lieder, in denen der Hang zur Parodie, zur Satire, zum beißenden Untergriff zum Ausdruck kommt, verbunden mit Ansätzen zu theatralischer Darstellung, gab es schon in der Altwiener Volkskomödie, dann bei Nestroy in Form von Couplets."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
