                "senses": [
                    {
                        "sense_id": "770cbf0d-1383-3728-8b04-c267513380e1",
                        "entry_id": "80a68ffb-7c82-31ad-bb24-8574d6a8cbbc",
                        "glosses": [
                            "Propriété d’un cristal dont la symétrie est inférieure à celle du réseau périodique qui lui correspond."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c33a05f-9233-45cc-9e3a-966ad2659452",
                                "sense_id": "770cbf0d-1383-3728-8b04-c267513380e1",
                                "text": "Lorsque le cristal a une symétrie moindre que le réseau, on parle de mériédrie (hémièdre si elle ne comporte que la moitié des faces du système holoèdre correspondant, tétartoèdre avec le quart des faces..)."
                            },
                            {
                                "example_id": "f6941d71-170b-440c-afe9-0fb02518c19b",
                                "sense_id": "770cbf0d-1383-3728-8b04-c267513380e1",
                                "text": "Dans les deux derniers types de macles ce n’est plus le réseau-période tout entier qui se prolonge strictement (mériédrie) ou à peu près (pseudomériédrie) de part et d’autre de la surface d’accolement."
                            },
                            {
                                "example_id": "f87a6f18-d297-4428-ad02-fb4c22ee034a",
                                "sense_id": "770cbf0d-1383-3728-8b04-c267513380e1",
                                "text": "On voit qu’en réalité les mériédries d’ordre supérieur ne pourraient être distinguées des pseudo-mériédries que par des mesures d’angles rigoureuses."
                            }
                        ]
                    }
