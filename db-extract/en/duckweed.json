                    {
                        "translation_id": "193156fe-dff6-4825-ac82-8cd08612b52b",
                        "source_entry_id": "80709f78-7c8f-3401-a59f-8a110da79003",
                        "source_sense_id": "0596dea4-c67c-3409-b1db-18923f6d8932",
