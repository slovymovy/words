    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "863f1bcd-c150-359a-98c5-8520cc5b458d",
                "word": "manservant",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "79c47b8c-cd7c-4e0c-b47f-8360587f86aa",
                        "entry_id": "863f1bcd-c150-359a-98c5-8520cc5b458d",
                        "tags": [
                            "plural"
                        ],
                        "form": "manservants"
                    },
                    {
                        "form_id": "f136bedc-a041-4170-8746-8d6fe387b8b9",
                        "entry_id": "863f1bcd-c150-359a-98c5-8520cc5b458d",
                        "tags": [
                            "plural"
                        ],
                        "form": "menservants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f3a417f-f8f5-3af3-8196-b4063b7c5848",
                        "entry_id": "863f1bcd-c150-359a-98c5-8520cc5b458d",
                        "glosses": [
                            "A male servant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af5af702-f600-48a1-a72f-eb7201d71b09",
                                "sense_id": "8f3a417f-f8f5-3af3-8196-b4063b7c5848",
                                "text": "I asked my manservant to attend to the washing and cleaning."
                            },
                            {
                                "example_id": "e2233c3d-9ff1-4f5f-a72f-dedf75fdd739",
                                "sense_id": "8f3a417f-f8f5-3af3-8196-b4063b7c5848",
                                "text": "Sixe dayes thou ſhalt labour, and doe all thy worke. But the ſeuenth day is the Sabbath of the Lord thy God: in it thou ſhalt not doe any worke, thou, nor thy ſonne, nor thy daughter, nor thy man ſeruant, nor thy maid ſeruant, nor thine oxe, nor thine aſſe, nor any of thy cattel, nor thy ſtranger that is within thy gates, that thy man ſeruant and thy maid ſeruant may reſt as well as thou."
                            },
                            {
                                "example_id": "8b9d3b69-281e-4952-86c5-671c5675d8a6",
                                "sense_id": "8f3a417f-f8f5-3af3-8196-b4063b7c5848",
                                "text": "\"A great people were they. They conquered till none were left to conquer, and then they dwelt at ease within their rocky mountain walls, with their man servants and their maid servants, their minstrels, their sculptors, and their concubines, and traded and quarrelled, and ate and hunted and slept and made merry till their time came.\""
                            },
                            {
                                "example_id": "33f08b9e-7ea3-44c2-a7be-d5b7c9e1985f",
                                "sense_id": "8f3a417f-f8f5-3af3-8196-b4063b7c5848",
                                "text": "But a man who holds so tightly to what he calls his rights over what he calls his debts will hold tightly also to what he calls his rights over her whom he calls his wife. No sir smile neighbour shall covet his ox or his wife or his manservant or his maidservant or his jackass. / —Or his jennyass, Buck Mulligan antiphoned."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06c22d8e-5d34-4a06-bb75-6db027e0aa58",
                        "source_entry_id": "863f1bcd-c150-359a-98c5-8520cc5b458d",
                        "source_sense_id": "8f3a417f-f8f5-3af3-8196-b4063b7c5848",
                        "source_sense_description": "male servant",
                        "target_lang_word": "serviteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serviteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0e4f0f7-692c-320a-bfee-798143b71204",
                                        "entry_id": "690c6ce5-b6c7-3a49-a189-3e4866de6d8d",
                                        "glosses": [
                                            "Celui qui est au service d’une personne ou d’une collectivité."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41e2861f-c5b7-407b-9317-c535bbbd9fe2",
                                                "sense_id": "b0e4f0f7-692c-320a-bfee-798143b71204",
                                                "text": "Un fidèle serviteur de l’État. — Ce roi sut récompenser ses zélés serviteurs."
                                            },
                                            {
                                                "example_id": "f40c6b8e-93a8-4034-95f5-e5a8f0fe37a8",
                                                "sense_id": "b0e4f0f7-692c-320a-bfee-798143b71204",
                                                "text": "Un grand serviteur de Dieu, est un homme d’une grande piété, d’une grande charité, uniquement occupé de la prière et des bonnes œuvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d4302fa-bc5a-3792-8354-e747d909e8d5",
                                        "entry_id": "690c6ce5-b6c7-3a49-a189-3e4866de6d8d",
                                        "glosses": [
                                            "Domestique."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a6787aa-0a28-4331-871a-27f64cceac37",
                                                "sense_id": "1d4302fa-bc5a-3792-8354-e747d909e8d5",
                                                "text": "Et ces costumes, ils se trouvaient étendus dans les séchoirs, numérotés par habilleuses, car on leur donnait aussi des serviteurs pour s’en vêtir !"
                                            },
                                            {
                                                "example_id": "8ab14a53-ac78-489a-92e7-b2aa60dba5e1",
                                                "sense_id": "1d4302fa-bc5a-3792-8354-e747d909e8d5",
                                                "text": "Devoirs des serviteurs envers leurs maîtres."
                                            },
                                            {
                                                "example_id": "ea496f26-93c2-4297-896d-462e07b31a5b",
                                                "sense_id": "1d4302fa-bc5a-3792-8354-e747d909e8d5",
                                                "text": "Maîtres et serviteurs, tous mangeaient à la même table."
                                            },
                                            {
                                                "example_id": "080b8da2-d97c-4469-add4-efa239f35cdb",
                                                "sense_id": "1d4302fa-bc5a-3792-8354-e747d909e8d5",
                                                "text": "Le témoin devra déclarer s’il est parent, allié ou serviteur de l’une des parties. Note : on se sert plus communément du mot Domestique mais, en termes de l’Écriture et aussi dans le style soutenu, on emploie toujours le mot Serviteur."
                                            },
                                            {
                                                "example_id": "465b18cb-d925-4b45-b571-035feea1947a",
                                                "sense_id": "1d4302fa-bc5a-3792-8354-e747d909e8d5",
                                                "text": "Heureux le serviteur que son maître trouvera veillant !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11948689-d46f-3383-b80d-2f789c12cbaf",
                                        "entry_id": "690c6ce5-b6c7-3a49-a189-3e4866de6d8d",
                                        "glosses": [
                                            "Celui qui se dévoue avec attachement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5d1d11d-579a-4ae9-9be2-9d52f8d042a2",
                                                "sense_id": "11948689-d46f-3383-b80d-2f789c12cbaf",
                                                "text": "Du Paty l’a compris et, connaissant par expérience l’implacabilité du criminel aux abois, il se voit abandonné sans recours à toutes les puissances du mal dont il fut le serviteur, […]."
                                            },
                                            {
                                                "example_id": "99d8976a-4115-4072-b821-fd08d9f4e975",
                                                "sense_id": "11948689-d46f-3383-b80d-2f789c12cbaf",
                                                "text": "J’ai toujours été serviteur de votre père, de votre famille."
                                            },
                                            {
                                                "example_id": "aceeb733-3900-490a-a1a0-db4b4302ff5f",
                                                "sense_id": "11948689-d46f-3383-b80d-2f789c12cbaf",
                                                "text": "Je suis votre ami et votre serviteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f72de91-bef2-31ec-acc2-104edabde900",
                                        "entry_id": "690c6ce5-b6c7-3a49-a189-3e4866de6d8d",
                                        "glosses": [
                                            "Formule de politesse dont on se servait pour finir les lettres et qui est aujourd’hui peu usitée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "460a9526-0c02-409c-b5d2-e44071fab880",
                                                "sense_id": "3f72de91-bef2-31ec-acc2-104edabde900",
                                                "text": "Votre serviteur,"
                                            },
                                            {
                                                "example_id": "1d741d1d-6fc9-4282-a227-7fbd266991a4",
                                                "sense_id": "3f72de91-bef2-31ec-acc2-104edabde900",
                                                "text": "Votre très humble et très obéissant serviteur,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "672e0d27-c1ca-3b6e-a00f-eea9e5f6f9c1",
                                        "entry_id": "690c6ce5-b6c7-3a49-a189-3e4866de6d8d",
                                        "glosses": [
                                            "Formule de politesse dont on se servait en saluant quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c9b8504-9ef0-457e-9661-9e1b94e114f1",
                                                "sense_id": "672e0d27-c1ca-3b6e-a00f-eea9e5f6f9c1",
                                                "text": "Serviteur, monsieur.\nBonjour, monsieur."
                                            },
                                            {
                                                "example_id": "37f929b8-a0c7-45a1-a37d-f4756bdd965b",
                                                "sense_id": "672e0d27-c1ca-3b6e-a00f-eea9e5f6f9c1",
                                                "text": "Serviteur."
                                            },
                                            {
                                                "example_id": "1add65c8-64ae-461c-abd8-c404cd55ef54",
                                                "sense_id": "672e0d27-c1ca-3b6e-a00f-eea9e5f6f9c1",
                                                "text": "Je suis votre serviteur ou, elliptiquement,"
                                            },
                                            {
                                                "example_id": "cfe81b4e-26e8-46a0-964a-3683fe0220a7",
                                                "sense_id": "672e0d27-c1ca-3b6e-a00f-eea9e5f6f9c1",
                                                "text": "Votre serviteur,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38fee1ab-dfc9-396e-9771-71596af61055",
                                        "entry_id": "690c6ce5-b6c7-3a49-a189-3e4866de6d8d",
                                        "glosses": [
                                            "Je suis votre serviteur, je suis son serviteur se dit à quelqu’un ou de quelqu’un pour marquer que l’on refuse ce qu’il demande ou ce qu’il propose, ou que l’on n’est point du même avis."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4550287e-3099-4bac-90eb-7eee853634d0",
                                                "sense_id": "38fee1ab-dfc9-396e-9771-71596af61055",
                                                "text": "Vous me demandez telle chose, je suis votre serviteur."
                                            },
                                            {
                                                "example_id": "0e0c0f86-9a7f-449d-9e2c-b9473854630b",
                                                "sense_id": "38fee1ab-dfc9-396e-9771-71596af61055",
                                                "text": "On peut aussi l'exprimer de manière elliptique :",
                                                "translation": "La raison en était évidente à tous : cet homme, serviteur ! était l’image du calme, au point d’être absent. — (Daniel Boulanger, Le jardin d'Armide, 1969, réédition Le Livre de Poche, 1980, page 52)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e60711c-01ba-3291-9dc7-37237e5fbe22",
                                        "entry_id": "690c6ce5-b6c7-3a49-a189-3e4866de6d8d",
                                        "glosses": [
                                            "Ustensile servant à présenter des mets composé d’un ou plusieurs plateaux circulaires superposés et reliés autour d’un pied."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8296ae76-1878-3256-810f-2bfe96e78205",
                                        "entry_id": "690c6ce5-b6c7-3a49-a189-3e4866de6d8d",
                                        "glosses": [
                                            "Serveur, garçon de café"
                                        ],
