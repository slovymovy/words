    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2b1e78eb-15b9-3541-8c4f-98607280d3ae",
                "word": "acidification",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7a0b12d0-d0ba-4253-8ef2-69658178c5e4",
                        "entry_id": "2b1e78eb-15b9-3541-8c4f-98607280d3ae",
                        "tags": [
                            "plural"
                        ],
                        "form": "acidifications"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2d99238-4103-339b-b1cd-d0f70f0f1069",
                        "entry_id": "2b1e78eb-15b9-3541-8c4f-98607280d3ae",
                        "glosses": [
                            "The act or process of making something sour (acidifying), or changing into an acid."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6d586c29-d58c-41fe-9bc9-5f7ee195fe0f",
                                "sense_id": "e2d99238-4103-339b-b1cd-d0f70f0f1069",
                                "text": "Coral reefs, for instance, are suffering from the higher temperatures and the effects of acidification whilst also being weakened by bad fishing practices, pollution, siltation and toxic algal blooms."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee412d4a-8df4-4809-b25c-74b1b0f112ea",
                        "source_entry_id": "2b1e78eb-15b9-3541-8c4f-98607280d3ae",
                        "source_sense_id": "e2d99238-4103-339b-b1cd-d0f70f0f1069",
                        "source_sense_description": "the act or process of making something sour (acidifying), or changing into an acid",
                        "target_lang_word": "verzuring",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verzuring",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "67fc7c9a-5ac9-34da-9a3d-0265060152c6",
                                        "entry_id": "0fe5c726-5dd4-396b-9fb1-1c1ed7f8be4d",
                                        "glosses": [
                                            "van iets dat het zuurder wordt met name als vorm van milieu verontreiniging"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4fbf581-f06c-41b5-b640-e97b2b80bded",
                                                "sense_id": "67fc7c9a-5ac9-34da-9a3d-0265060152c6",
                                                "text": "Langetermijnindicatoren geven aan dat de ontwikkelingen, zoals toenemende kooldioxideconcentraties, zeespiegelstijging en verzuring van de oceanen, zeer zorgelijk blijven. Het ijsoppervlak in het noordpoolgebied blijft onder het gemiddelde en ook de hoeveelheid zee-ijs in het gebied rond de Zuidpool stevent af op een laagterecord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2641e19-0224-3bd7-9666-c4520d458bfc",
                                        "entry_id": "0fe5c726-5dd4-396b-9fb1-1c1ed7f8be4d",
                                        "glosses": [
                                            "zuur worden van melk bij bederf"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59dca16a-147f-3b7b-b105-da1cbfb8cf54",
                                        "entry_id": "0fe5c726-5dd4-396b-9fb1-1c1ed7f8be4d",
                                        "glosses": [
                                            "zuurder worden van spieren door melkzuur na zware inspanning"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a44e816-6ca5-4a05-9754-cd17ba2d33f3",
                                                "sense_id": "59dca16a-147f-3b7b-b105-da1cbfb8cf54",
                                                "text": "Het pak is getest en goedgekeurd om internationale wedstrijden mee te schaatsen. „Voor de Winterspelen krijgen we deze week de nieuwe pakken binnen. Wat het voordeel is? Je kunt dat bij shorttrack niet in tijd uitdrukken, maar omdat het pak minder weerstand biedt, treedt de verzuring minder snel op. Het is een miniem verschil, maar het draait vaak om details.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "388d0390-2d45-3995-917a-bc60e36ee9b1",
                                        "entry_id": "0fe5c726-5dd4-396b-9fb1-1c1ed7f8be4d",
                                        "glosses": [
                                            "in een chagrijnige stemming raken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c94cd4e-58ea-482c-8b61-bec88971cc8e",
                                                "sense_id": "388d0390-2d45-3995-917a-bc60e36ee9b1",
                                                "text": "Daarnaast gaat Raymann volgend jaar weer met zijn eigen programma toeren en doet hij steeds meer klussen als motivational speaker. „Er heeft veel verzuring plaatsgevonden in Nederland en dat is doorgeslopen in veel bedrijven, terwijl Nederlanders van nature geen zure mensen zijn. De geluksbeleving van te veel mensen lijkt kapot te zijn. En ik weet die boodschap met een flinke dosis humor over te brengen; hopelijk blijft het dan wat langer hangen.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af760e4d-be2f-4bbe-ae81-c60f9495c1aa",
                        "source_entry_id": "2b1e78eb-15b9-3541-8c4f-98607280d3ae",
                        "source_sense_id": "e2d99238-4103-339b-b1cd-d0f70f0f1069",
                        "source_sense_description": "the act or process of making something sour (acidifying), or changing into an acid",
                        "target_lang_word": "acidification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acidification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29444df7-8741-3d50-8999-6536b6757cbb",
                                        "entry_id": "79e6a26a-6bc0-3f25-8464-192a752b9e37",
                                        "glosses": [
                                            "Transformation en acide, action d’acidifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04d555e6-26e1-4daf-be7c-8f07a887dc6d",
                                                "sense_id": "29444df7-8741-3d50-8999-6536b6757cbb",
                                                "text": "Quelle que soit la souche considérée, la croissance mycélienne conduit à l’acidification du milieu de culture."
                                            },
                                            {
                                                "example_id": "0aa975f1-a723-4b6d-9f7c-1ab538a8b621",
                                                "sense_id": "29444df7-8741-3d50-8999-6536b6757cbb",
                                                "text": "«Quel climat a pu générer cette transition ? Une acidification, une glaciation ? C'est ce que nous cherchons», explique le géologue."
                                            },
                                            {
                                                "example_id": "633ee1fe-7b4c-4f08-aa44-6ebfe4e2076b",
                                                "sense_id": "29444df7-8741-3d50-8999-6536b6757cbb",
                                                "text": "L’acidification de l’océan est la diminution progressive du pH des océans qui, entre 1751 et 2004, a diminué de 8,25 à 8,14."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
