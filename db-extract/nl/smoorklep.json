                        "sense_id": "42ddb0c2-09bb-34a1-b0d6-80019430bc23",
                        "entry_id": "9947fdfa-9050-342e-bd90-ac7e3038e9a4",
                        "glosses": [
                            "klep waarmee men de brandstoftoevoer naar een verbrandingsmotor kan regelen"
                        ],
                        "tags": [
                            "motortechniek"
                        ],
                        "examples": [
                            {
                                "example_id": "680bd91a-9b75-42d1-aa7f-ce92aa4ac381",
                                "sense_id": "42ddb0c2-09bb-34a1-b0d6-80019430bc23",
                                "text": "Als die te snel draait, zorgt de centrifugale kracht ervoor dat de hefboomarmen omhooggaan, waardoor de mof wordt opgetild en de opening van de smoorklep in de mof kleiner wordt, zodat er minder vloeistof in de cilinder komt en de machine minder snel gaat."
                            },
                            {
                                "example_id": "6fd4d2ea-d0a3-4fee-8c0c-2e60d52852f6",
                                "sense_id": "42ddb0c2-09bb-34a1-b0d6-80019430bc23",
                                "text": "De motoren, die in Antwerpen aankomen, worden verder aangekleed. Dit wil zeggen dat de transmissie op de motor aangebracht wordt, de smoorklep, alternator, starter, riem en steunen."
                            }
                        ]
                    }
