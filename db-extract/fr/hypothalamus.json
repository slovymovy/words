        "fr-extract.jsonl": [
            {
                "entry_id": "c3a295c2-6c6c-363c-b469-f365c8f78437",
                "word": "hypothalamus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9d71d4f1-abc6-3843-b35b-4c411b85bfd5",
                        "entry_id": "c3a295c2-6c6c-363c-b469-f365c8f78437",
                        "glosses": [
                            "Région diencéphalique du cerveau qui intervient dans la régulation des fonctions endocrines, autonomes et comportementales (sexuelles, alimentaires, défensive, de stress, de thermorégulation, du cycle circadien)."
                        ],
                        "tags": [
                            "Endocrinologie"
                        ],
                        "examples": [
                            {
                                "example_id": "aab48720-5667-490d-98c9-bb86cfd2b898",
                                "sense_id": "9d71d4f1-abc6-3843-b35b-4c411b85bfd5",
                                "text": "L'hypothalamus constitue les parois inféro-latérales du IIIème ventricule sous le thalamus, de chaque côté, dont il est séparé par le sillon hypothalamique."
                            },
                            {
                                "example_id": "66474622-c229-493e-8d34-cc5583254a18",
                                "sense_id": "9d71d4f1-abc6-3843-b35b-4c411b85bfd5",
                                "text": "Souvenez-vous, nous avons déjà traversé l’hypothalamus pour y repérer les boutons qui déclenchent le sommeil, l’éveil et le rêve."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef78cbaa-bfce-44bb-b100-84e99b3bd6cb",
                        "source_entry_id": "c3a295c2-6c6c-363c-b469-f365c8f78437",
                        "source_sense_id": "9d71d4f1-abc6-3843-b35b-4c411b85bfd5",
                        "target_lang_word": "Hypothalamus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hypothalamus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                                        "entry_id": "670944db-33a0-333b-b6ae-462e31e4c64a",
                                        "glosses": [
                                            "Teil des Zwischenhirns zur Steuerung der vegetativen Funktionen des Körpers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd494726-8356-4833-b67b-68b7fc927b9a",
                                                "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                                                "text": "„Bislang gingen Forscher davon aus, dass eine spezialisierte Gehirnregion im so genannten Hypothalamus je nach Tageszeit bestimmte Gene ein- oder ausschaltet.“"
                                            },
                                            {
                                                "example_id": "a610f6d5-fd16-4030-9a65-1f1068635028",
                                                "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                                                "text": "„Verspielte Katzen verwandelten sie von einem Augenblick zum andern durch Stimulierung ihres lateralen Hypothalamus in wilde Tiger und dann ebenso plötzlich wieder in schnurrende Kätzchen.“"
                                            },
                                            {
                                                "example_id": "0090e9ec-c9f1-4bb5-b76d-db4af28704d7",
                                                "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                                                "text": "„Sie legten den Tieren Elektroden an den Hypothalamus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76f68924-59f6-4f83-b1e7-264f0b878658",
                        "source_entry_id": "c3a295c2-6c6c-363c-b469-f365c8f78437",
                        "source_sense_id": "9d71d4f1-abc6-3843-b35b-4c411b85bfd5",
                        "target_lang_word": "hypothalamus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypothalamus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d91d08b5-f9ae-30bc-8b47-7bc7291717ae",
                                        "entry_id": "3ac8ba65-2086-333c-814d-ea92292ece2a",
                                        "glosses": [
                                            "A region of the forebrain located below the thalamus, forming the basal portion of the diencephalon, and functioning to regulate body temperature, some metabolic processes and governing the autonomic nervous system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d24e1f8-a785-4b45-a9b6-fa6b3338152d",
                                                "sense_id": "d91d08b5-f9ae-30bc-8b47-7bc7291717ae",
                                                "text": "To avoid catastrophe, the brain has its trusty control centre, the hypothalamus, which tells the body to cool itself by sweating or to warm itself by shivering."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8be235ee-19a4-462d-9387-9e177d87e646",
                        "source_entry_id": "c3a295c2-6c6c-363c-b469-f365c8f78437",
