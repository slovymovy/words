        "fr-extract.jsonl": [
            {
                "entry_id": "fbb2bf56-4a18-3f65-9df5-e2c9332c8ee8",
                "word": "éteule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "18255c69-a4cf-420f-a208-d39d4129cd20",
                        "entry_id": "fbb2bf56-4a18-3f65-9df5-e2c9332c8ee8",
                        "tags": [
                            "plural"
                        ],
                        "form": "éteules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c3ff542-3d2e-3c9c-b14c-f4d86b87b2c5",
                        "entry_id": "fbb2bf56-4a18-3f65-9df5-e2c9332c8ee8",
                        "glosses": [
                            "Partie du chaume, passée sous la lame de la faux ou de la moissonneuse, qui reste fixée à la terre après la moisson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afda7b60-7af5-46b5-8daf-60d18cd70d30",
                                "sense_id": "2c3ff542-3d2e-3c9c-b14c-f4d86b87b2c5",
                                "text": "Je vois quelque chose, mais ça ne peut pas être le lièvre ; c'est une bosse de terre, jaune comme toutes les mottes de l'éteule."
                            },
                            {
                                "example_id": "be373fb8-ef67-40a5-be14-f35f81fc7209",
                                "sense_id": "2c3ff542-3d2e-3c9c-b14c-f4d86b87b2c5",
                                "text": "Séduit que j’avais été par un tableau […] qui représentait une vue de la plaine de Fontenay-aux-Roses, avec des éteules pleines de lièvres et des luzernes pleines de perdrix."
                            },
                            {
                                "example_id": "b0aebee1-3b8e-4e3b-b89f-1195be9f8b49",
                                "sense_id": "2c3ff542-3d2e-3c9c-b14c-f4d86b87b2c5",
                                "text": "Les trois ou quatre capucins qui boultinaient par les éteules étaient tôt fusillés et cuits."
                            },
                            {
                                "example_id": "a707c0a5-aef8-4470-9efa-94e314d6d65f",
                                "sense_id": "2c3ff542-3d2e-3c9c-b14c-f4d86b87b2c5",
                                "text": "Des poussières, des fumées ou des brouillards que la terre exhalait sous les coups du soleil commençaient à s’élever çà et là, d’éteules où la moisson était déjà raclée, de petits champs de foin couleur de flammes et même des forêts où l’on sentait que la chaleur était en train de cuire les dernières herbes fraîches."
                            },
                            {
                                "example_id": "0a35fb91-a0ec-4d54-905a-ef6e5080e9a6",
                                "sense_id": "2c3ff542-3d2e-3c9c-b14c-f4d86b87b2c5",
                                "text": "Alors, j’entendis deux mille cigales, et dans les éteules enchantées, le premier grillon des vacances qui limait un barre d’argent."
                            }
                        ]
                    },
                    {
                        "sense_id": "23bf25b6-0849-3356-b626-ce6334bb6bd9",
                        "entry_id": "fbb2bf56-4a18-3f65-9df5-e2c9332c8ee8",
                        "glosses": [
                            "Vaguelette secondaire d’un mascaret ; ételle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad118a33-f6fd-438a-81f2-03fabb32adf4",
                                "sense_id": "23bf25b6-0849-3356-b626-ce6334bb6bd9",
                                "text": "Le mascaret consiste en un brusque relèvement du niveau de l’eau accompagnant l’arrivée du flot, se traduisant souvent par une vague déferlante suivie de lames successives, les éteules."
                            },
                            {
                                "example_id": "968396a4-153a-4648-a298-e6c57cbd9b7a",
                                "sense_id": "23bf25b6-0849-3356-b626-ce6334bb6bd9",
                                "text": "Pour citer quelques problématiques actuelles : quel est le rôle de la dispersion sur l’amplitude maximale d’un tsunami ? Sur les éteules (vaguelettes secondaires) des mascarets ?"
                            }
                        ]
                    }
                ],
