                    {
                        "sense_id": "cefd56ee-2670-3098-b32f-a3699ab11750",
                        "entry_id": "1646be20-480c-30db-a80e-d1fe017e0bd5",
                        "glosses": [
                            "Of a state or other geographic area, denoting those parts which are not metropolitan, but are somewhat densely populated and usually contain a number of significant towns."
                        ],
                        "tags": [
                            "Australia",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "dca55cd5-19ed-495e-93da-45b7ae1c086d",
                                "sense_id": "cefd56ee-2670-3098-b32f-a3699ab11750",
                                "text": "The new Remoteness Structure covers the whole of Australia and classifies Australia into regions which share common characteristics of remoteness. There are six Remoteness Areas in the Structure: Major Cities of Australia, Inner Regional Australia, Outer Regional Australia, Remote Australia, Very Remote Australia and Migratory."
                            },
                            {
                                "example_id": "a829f073-a061-4339-847b-9805e4bc24a1",
                                "sense_id": "cefd56ee-2670-3098-b32f-a3699ab11750",
                                "text": "The wheatlands region stretching across Australia offers a graphic illustration of the processes of social and economic change in rural and regional Australia."
                            },
                            {
                                "example_id": "db4a6652-ec57-4c8b-8a5e-cdad3b9e5501",
                                "sense_id": "cefd56ee-2670-3098-b32f-a3699ab11750",
                                "text": "HEMA produces four-wheel-drive and motorbike road atlases and many regional four-wheel-drive maps—good if you plan to go off the trails—an atlas of Australia′s national parks, and maps to Kakadu and Lamington national parks."
                            }
                        ]
                    }
