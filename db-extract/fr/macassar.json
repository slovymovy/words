                "forms": [],
                "senses": [
                    {
                        "sense_id": "44206811-605b-3bae-b216-7b3bbd4f0129",
                        "entry_id": "d36e0df5-7be8-3c1e-930f-ab979c8cc3e0",
                        "glosses": [
                            "Nom donné au bois de Diospyros celebica, arbre de la famille des Ebenaceae (Ébenacées)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f48b5fa0-da13-49bb-9908-e24b08954393",
                                "sense_id": "44206811-605b-3bae-b216-7b3bbd4f0129",
                                "text": "Finitions : décor cerisier, wengé, bouleau Helsinki et placages bois véritable frêne-olivier, noyer américain et macassar."
                            },
                            {
                                "example_id": "e8cf7555-252f-40f4-96fa-bf656ba27cf2",
                                "sense_id": "44206811-605b-3bae-b216-7b3bbd4f0129",
                                "text": "Au moment de mettre la touche finale à son mur poétique, Jan Willem Bruins peint, dans une couleur flirtant à la lisière du brin et du noir, que l'on pourrait appeler ébène ou macassar, deux carrés, posés de biais, pas tout à fait sur la pointe, en un joyeux déséquilibre, pour signer son œuvre d'un dernier clin d'œil impertinent."
                            }
                        ]
                    }
