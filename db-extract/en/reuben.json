                                "target_senses": [
                                    {
                                        "sense_id": "e24bcfc6-2b47-32b5-878a-101982a8fd6f",
                                        "entry_id": "94e56252-eb90-3fc1-a439-bcf9014348ab",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "490801ff-c131-4253-8100-641ef8dfbdc5",
                                                "sense_id": "e24bcfc6-2b47-32b5-878a-101982a8fd6f",
                                                "text": "Die Rubens fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "a498eccb-b51b-483d-a268-cf5ba563b07d",
                                                "sense_id": "e24bcfc6-2b47-32b5-878a-101982a8fd6f",
                                                "text": "Der Ruben trägt nie die Schals, die die Ruben ihm strickt."
                                            },
                                            {
                                                "example_id": "3d230701-df54-4691-9f4a-dea30eec8743",
                                                "sense_id": "e24bcfc6-2b47-32b5-878a-101982a8fd6f",
                                                "text": "Frau Ruben ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "37ba93a1-e120-4476-a371-8146ee4ef678",
                                                "sense_id": "e24bcfc6-2b47-32b5-878a-101982a8fd6f",
                                                "text": "Herr Ruben wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "31c66ff7-6a7c-4cf1-98dd-02e0bf3303f3",
                                                "sense_id": "e24bcfc6-2b47-32b5-878a-101982a8fd6f",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ruben kommt, geht der Herr Ruben.“"
                                            },
                                            {
                                                "example_id": "4a334184-e4a4-46b6-b74f-1e19d90eee4b",
                                                "sense_id": "e24bcfc6-2b47-32b5-878a-101982a8fd6f",
                                                "text": "Ruben kommt und geht."
                                            },
                                            {
                                                "example_id": "d2da4ff7-ce8f-40e9-b56f-1756ca7207d5",
                                                "sense_id": "e24bcfc6-2b47-32b5-878a-101982a8fd6f",
                                                "text": "Rubens kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
