        "fr-extract.jsonl": [
            {
                "entry_id": "0acd90ed-6460-3223-852c-7ed54989543f",
                "word": "pétoche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b1c45a95-3eea-49a3-a39b-db989e8fa2a4",
                        "entry_id": "0acd90ed-6460-3223-852c-7ed54989543f",
                        "tags": [
                            "plural"
                        ],
                        "form": "pétoches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df28acb8-53bc-363f-b15f-e24a992d43fc",
                        "entry_id": "0acd90ed-6460-3223-852c-7ed54989543f",
                        "glosses": [
                            "Peur."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "95b65015-750f-40b9-9701-9c40973adb2b",
                                "sense_id": "df28acb8-53bc-363f-b15f-e24a992d43fc",
                                "text": "En me « dévoilant » ainsi devant des gens que je ne connaissais pas, j’avais la « pétoche » de tomber sur un faux résistant provocateur qui chercherait à attirer un « pianiste », comme ces annonces qui paraissaient à intervalles réguliers dans les journaux : […]"
                            },
                            {
                                "example_id": "9e8fd443-5492-483b-ad5b-839ad53ffb39",
                                "sense_id": "df28acb8-53bc-363f-b15f-e24a992d43fc",
                                "text": "On riait de la pétoche des possédants qui filaient en Suisse planquer leur argent, on rassurait avec condescendance les secrétaires persuadées que leur appartement serait nationalisé."
                            },
                            {
                                "example_id": "917044cc-dafb-4a29-b325-641e91adbc4e",
                                "sense_id": "df28acb8-53bc-363f-b15f-e24a992d43fc",
                                "text": "— Ouf ! fit Grey, Nephtys, tu peux te vanter de nous avoir foutu la pétoche !\n— La pétoche ?\n— Oui, la trouille, quoi ! Enfin, euh… la peur !"
                            },
                            {
                                "example_id": "dc20532b-8a5e-4885-92e1-f60a8d10bfd2",
                                "sense_id": "df28acb8-53bc-363f-b15f-e24a992d43fc",
                                "text": "– Pff, casser, toujours casser… D’accord, c’est marrant de temps en temps, mais moi je préférerais encore me renifler une Zarabe. Belle, et bien coincée du cul. Ou alors une p’tite bourge, bien blanche ? Les cris d’une vierge qu’a la pétoche, ça c’est excitant ! ricana Zef."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e8d7bf4-6d78-34e0-a4df-580a736646d7",
                        "entry_id": "0acd90ed-6460-3223-852c-7ed54989543f",
                        "glosses": [
                            "Petite bougie fabriquée avec de la résine, utilisée autrefois pour l'éclairage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "393de04d-b98d-4868-a29d-e22b617f0c96",
                                "sense_id": "0e8d7bf4-6d78-34e0-a4df-580a736646d7",
                                "text": "La pétoche a roulé sous le lit, et, instantanément, la paillasse flambe"
                            }
                        ]
                    },
                    {
                        "sense_id": "1f3c2929-817b-3f7d-bc8e-f427332e32ca",
                        "entry_id": "0acd90ed-6460-3223-852c-7ed54989543f",
                        "glosses": [
                            "Bougie, lumière quelle quelle soit."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "696be43f-3a2f-424e-b3ef-ae05b805f2f2",
                                "sense_id": "1f3c2929-817b-3f7d-bc8e-f427332e32ca",
                                "text": "— Les vaches ! dit Chalumot. Y en a pas un qu’aurait soufflé la pétoche…\nIl ne se leva point pour l’éteindre, et ramena les draps sur son visage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8031dcca-ccf6-4691-aa7a-7a8726102f6d",
                        "source_entry_id": "0acd90ed-6460-3223-852c-7ed54989543f",
                        "target_lang_word": "Schiss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schiss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8a20ffc-ddd5-343e-8b21-f8cc90b6e093",
                                        "entry_id": "1f315049-4c24-31ee-af6c-1659195f142e",
                                        "glosses": [
                                            "der Vorgang des Ausscheidens von Kot"
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ca14642-7961-4c7c-bdf2-d071aa119edb",
                                                "sense_id": "c8a20ffc-ddd5-343e-8b21-f8cc90b6e093",
                                                "text": "Ich konnte den Schiss leider nicht unterdrücken."
                                            },
                                            {
                                                "example_id": "d1dd8975-ca37-4a51-9e64-bdbe3e9d9248",
                                                "sense_id": "c8a20ffc-ddd5-343e-8b21-f8cc90b6e093",
                                                "text": "Du hast nicht richtig zugehört, die Novelle von Keller heißt nicht etwa „Der Schiss von der Kanzel“, sondern „Der Schuss von der Kanzel“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "832145ef-9cc7-3ea7-898a-4e98f9e1d883",
                                        "entry_id": "1f315049-4c24-31ee-af6c-1659195f142e",
                                        "glosses": [
                                            "ausgeschiedener Kot"
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66c21da8-add5-4927-b068-fbaba04c0500",
                                                "sense_id": "832145ef-9cc7-3ea7-898a-4e98f9e1d883",
                                                "text": "Wie er im Treppenhaus in den Schiss eines Köters trat, sagte seine Neuangetraute, die schon seit ihrer Kindheit in der Stadt lebte, bloß trocken: „Willkommen in Berlin!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f9d34407-3362-3ef3-84a3-44fc922764eb",
                                        "entry_id": "1f315049-4c24-31ee-af6c-1659195f142e",
                                        "glosses": [
                                            "Angst"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9d732fe-e436-4b67-aa4d-546dfec48768",
                                                "sense_id": "f9d34407-3362-3ef3-84a3-44fc922764eb",
                                                "text": "Wenn es rundherum kracht, hat jeder Soldat Schiss – manchmal auch im wörtlichen Sinne."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc760afd-9a8b-45cf-98ba-1f49b361cb56",
                        "source_entry_id": "0acd90ed-6460-3223-852c-7ed54989543f",
                        "target_lang_word": "angst",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "angst",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "83487635-1e1a-33fa-a6a8-e3e04a048923",
                                        "entry_id": "38f533dd-f3c8-34b1-8aa8-6d6b72af2ecc",
                                        "glosses": [
                                            "gevoel dat er onheil of gevaar dreigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a42a7af8-9a96-4088-8417-d0772cfc7e6f",
                                                "sense_id": "83487635-1e1a-33fa-a6a8-e3e04a048923",
                                                "text": "Mijn hart bonst van de angst."
                                            },
                                            {
                                                "example_id": "10823626-d3f2-4fb8-aa63-30e6b9cbe3e8",
                                                "sense_id": "83487635-1e1a-33fa-a6a8-e3e04a048923",
                                                "text": "` Wanneer je angstig bent, mijn zoon, zoek dan de reden van je angst. Zoek in je hart naar iets dat je angst kan laten verdwijnen."
                                            },
                                            {
                                                "example_id": "5c981f8c-c459-44a3-9bdf-16063cf0615f",
                                                "sense_id": "83487635-1e1a-33fa-a6a8-e3e04a048923",
                                                "text": "Binnen het halfuur waarin wij passagiers op onze papieren werden gecontroleerd raakten de ramen beslagen van angst, ja, ik dacht de angst hangt in de lucht en dat is de angst van ons soort mensen."
                                            },
                                            {
                                                "example_id": "9677f7aa-c3c3-446b-a071-1afa97e9d170",
                                                "sense_id": "83487635-1e1a-33fa-a6a8-e3e04a048923",
                                                "text": "`Onze gasten kunnen gerust slapen in de wetenschap dat hun vertrekken duchtig worden bewaakt; zei Montebello. `Om zich toegang te verschaffen tot de bovenverdiepingen dient men te passeren tussen de hybride verschijningsvorm van de angst en het verraderlijk spinnende poesje dat voor raadselen stelt, die respectievelijk staan voor het weinig realistische zelfbeeld van de man en het wezen van de vrouw, als u het mij toestaat u te amuseren met mijn dilettantisme op het gebied van de symboliek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
