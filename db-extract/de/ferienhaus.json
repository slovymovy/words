                                        "glosses": [
                                            "A small house."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3981d82d-8072-3362-99d0-25f1cba84d11",
                                        "entry_id": "254bd885-1c26-31a5-99d9-1fb9189340b8",
                                        "glosses": [
                                            "A seasonal home of any size or stature, a recreational home or a home in a remote location."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85d687fe-0395-45ec-9445-a65c4c03f392",
                                                "sense_id": "3981d82d-8072-3362-99d0-25f1cba84d11",
                                                "text": "Most cottages in the area were larger and more elaborate than my home."
                                            },
                                            {
                                                "example_id": "c7ffec60-9384-4d0b-8ea3-f8fe2419b6af",
                                                "sense_id": "3981d82d-8072-3362-99d0-25f1cba84d11",
                                                "text": "Thinks I to myself, “Sol, you're run off your course again. This is a rich man's summer ‘cottage’ and if you don't look out there's likely to be some nice, lively dog taking an interest in your underpinning.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "608e36b2-8a4c-371f-b062-0d9cc4dd9db3",
                                        "entry_id": "254bd885-1c26-31a5-99d9-1fb9189340b8",
