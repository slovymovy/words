                                ]
                            },
                            {
                                "target_word": "minuscule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4b691d4-57f5-370b-b43a-4430365adf01",
                                        "entry_id": "4c4bcbb0-7dc6-3aca-9b29-78866839909a",
                                        "glosses": [
                                            "Petite lettre comme a, b, c, par opposition à la capitale, de plus grand format comme A, B, C."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65ac7993-8d60-4605-b50b-a342ba49f1a4",
                                                "sense_id": "a4b691d4-57f5-370b-b43a-4430365adf01",
                                                "text": "Le caractère anguleux et allongé des minuscules des premières années du 13ᵉ siècle s'est maintenant étendu à toutes les majuscules, la fourche à l'extrémité des hastes montantes tend à s'écarter encore, on ne trouve quasiment plus de perluettes ni de « e » cédillés, les abréviations plus communes au 13ᵉ siècle comme le « ; » pour le est sont maintenant intégrées et le pied de mouche est connu ([…])."
                                            },
                                            {
                                                "example_id": "3013d02e-1ba9-40ee-8288-4c5c49063ee1",
                                                "sense_id": "a4b691d4-57f5-370b-b43a-4430365adf01",
                                                "text": "On écrit champagne avec une minuscule quand il s’agit du vin de Champagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b744838-ba17-3a65-9b31-8c097e7ea447",
                                        "entry_id": "4c4bcbb0-7dc6-3aca-9b29-78866839909a",
                                        "glosses": [
                                            "Petite capitale, par opposition aux grandes."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
