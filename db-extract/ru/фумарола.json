                        "cross_references": []
                    },
                    {
                        "translation_id": "6fc6abcf-4a2f-4de7-a099-bab306274923",
                        "source_entry_id": "8526972e-f7f0-3aa3-83d5-abb414b51eb7",
                        "source_sense_id": "fd5f4fe8-a306-388b-b75d-e8559fe37518",
                        "target_lang_word": "Fumarole",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fumarole",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9b964f0-2a35-3810-917b-8fe985a6318a",
                                        "entry_id": "a6d3051c-ca60-3ad3-92c7-d76613a1fa4c",
                                        "glosses": [
                                            "über vulkanischem Gebiet aus Erdspalten ausströmende Wasserdämpfe und Gase"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dcecbf7-de13-44c7-b6b2-6a5c50f432d3",
                                                "sense_id": "c9b964f0-2a35-3810-917b-8fe985a6318a",
                                                "text": "Das Magma verbirgt sich unter der erstarrten Lava, sichtbar ist nur der Dampf der Fumarolen."
                                            },
                                            {
                                                "example_id": "12d6d4d4-9f28-43fa-b92a-601a208d9ac0",
                                                "sense_id": "c9b964f0-2a35-3810-917b-8fe985a6318a",
                                                "text": "Kraterseen, heiße Quellen, Fumarolen - alles zeugt von gewaltigen Naturkräften, die hier nie wirklich zur Ruhe kommen."
                                            },
                                            {
                                                "example_id": "fadef9bb-257f-4b9b-a4d3-7a491840b7af",
                                                "sense_id": "c9b964f0-2a35-3810-917b-8fe985a6318a",
                                                "text": "Vor knapp einhundert Jahren kam es auf der Insel zum letzten Mal zu einem Vulkanausbruch, heute sind auf den Hängen ihres höchsten Berges nur noch vereinzelte Fumarolen zu beobachten."
                                            },
                                            {
                                                "example_id": "45f43514-ad63-4211-9df3-f43212419852",
                                                "sense_id": "c9b964f0-2a35-3810-917b-8fe985a6318a",
                                                "text": "Ein phantastischer unterseeischer Garten öffnet sich, in dem Perlenketten aufsteigen, Gasblasen aus submarinen Fumarolen, die im Sonnenlicht zu unwirklichen diamantenen Pflanzen zusammenwachsen."
                                            },
                                            {
                                                "example_id": "c88f695b-3cfd-44ac-ba2e-7b72715f9230",
                                                "sense_id": "c9b964f0-2a35-3810-917b-8fe985a6318a",
                                                "text": "Aus mehr als 10 000 heißen Quellen, Fumarolen und Geysiren dringt hier gluckernd, gurgelnd, röchelnd und brodelnd Wärme aus dem Erdinneren durch die dünne Kruste ins Freie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9369922b-7dce-4f97-be9c-e69aff97edbf",
                        "source_entry_id": "8526972e-f7f0-3aa3-83d5-abb414b51eb7",
                        "source_sense_id": "fd5f4fe8-a306-388b-b75d-e8559fe37518",
                        "target_lang_word": "fumerolle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fumerolle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87f18ebf-f737-3239-a60b-e0b712d3db15",
                                        "entry_id": "f3c0096f-90d5-3931-a51c-d8afeede2185",
                                        "glosses": [
                                            "Petite crevasse d’un terrain volcanique d’où s’échappe de la fumée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42f92bfa-5167-457d-9662-267b67470770",
                                                "sense_id": "87f18ebf-f737-3239-a60b-e0b712d3db15",
                                                "text": "Les solfatares sont des fumerolles d'où s'échappe du soufre."
                                            },
                                            {
                                                "example_id": "3b8dc81d-9715-477c-a067-1d80570dbc19",
                                                "sense_id": "87f18ebf-f737-3239-a60b-e0b712d3db15",
                                                "text": "— Je l’ai vu en photo, sur un canapé en velours, tapotant de la main sur l’accoudoir, avec ses cheveux invariablement blancs et son air de pythie grecque assise sur les fumerolles de l’île de Ré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9785c133-8bce-325a-b2c3-3bd21c137ec8",
                                        "entry_id": "f3c0096f-90d5-3931-a51c-d8afeede2185",
                                        "glosses": [
                                            "Cette fumée elle-même, émission de gaz volcaniques souvent toxiques."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c757e5ba-19c9-4c9e-ade3-9433f4e148bd",
                                                "sense_id": "9785c133-8bce-325a-b2c3-3bd21c137ec8",
                                                "text": "Le documentaire montrait des mineurs indonésiens extrayant le soufre sans masque à gaz malgré les abondantes fumerolles toxiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f42b2de-f34b-3e2a-8198-0d402dd4ca9f",
                                        "entry_id": "f3c0096f-90d5-3931-a51c-d8afeede2185",
                                        "glosses": [
                                            "Fumée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "495b6126-e5de-4dd6-bd25-8b5dc04e0213",
                                                "sense_id": "6f42b2de-f34b-3e2a-8198-0d402dd4ca9f",
                                                "text": "On passait devant son bureau d’où s’envolaient les fumerolles de sa pipe […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
