                        "glosses": [
                            "Mann, der aus sexuell motiviertem Interesse Kinder anspricht, um sie zu überreden, mit ihm zu gehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02f9c71b-9168-4773-b31d-01f92da87975",
                                "sense_id": "390db323-609e-3a10-9543-cd8198d00f11",
                                "text": "„Schulleitung und Polizei warnen vor einem Mitschnacker.“"
                            },
                            {
                                "example_id": "64864555-da74-4864-8d97-da86b3f9906f",
                                "sense_id": "390db323-609e-3a10-9543-cd8198d00f11",
                                "text": "„Am Mittwochabend schlug der mutmaßliche Mitschnacker gleich zwei Mal zu. Zunächst sprach er an der Leipeltstraße eine 11-Jährige an […].“"
                            },
                            {
                                "example_id": "37b66106-9cdf-4fa2-ba9b-8807ddc1c4d0",
                                "sense_id": "390db323-609e-3a10-9543-cd8198d00f11",
                                "text": "„Der ›Mitschnacker‹ war unterwegs. Schloss ich die Augen, sah ich ihn als schwarz gekleideten Mann mit Melone und Süßigkeiten, dessen einziges Ziel es war, Kinder ins Verderben zu führen.“"
                            }
                        ],
