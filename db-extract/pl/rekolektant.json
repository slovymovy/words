                                "example_id": "ca08f584-856a-49c5-b2c0-1fa02de47f6d",
                                "sense_id": "bbe7aca4-0d3e-36b0-9525-3b3aa4fbe8d0",
                                "text": "Każdy rekolektant znalazł na stoliku nocnym ramowy program rekolekcji."
                            },
                            {
                                "example_id": "8a5fd76a-f5cd-44bf-89c1-2749613948b5",
                                "sense_id": "bbe7aca4-0d3e-36b0-9525-3b3aa4fbe8d0",
                                "text": "Panie kucharki zgotowały rekolektantom nie lada niespodziankę."
                            },
                            {
                                "example_id": "71480576-2be2-4eed-bf08-7b957643c7f5",
                                "sense_id": "bbe7aca4-0d3e-36b0-9525-3b3aa4fbe8d0",
                                "text": "Rekolektantom bardzo podobały się ojca homilie i konferencje ascetyczne."
                            }
                        ],
