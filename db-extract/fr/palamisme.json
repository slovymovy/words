                "senses": [
                    {
                        "sense_id": "ec3119f0-6bc0-3b2a-a448-84e51aaf7d7b",
                        "entry_id": "6b80e2f5-6d06-3db7-a31d-97d99c22dc53",
                        "glosses": [
                            "Doctrine religieuse selon laquelle Dieu s’est fait homme, pour que l’homme devienne Dieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94184608-314e-4b42-bf4a-4a1f8f1a75dd",
                                "sense_id": "ec3119f0-6bc0-3b2a-a448-84e51aaf7d7b",
                                "text": "Le palamisme exprime bien le réalisme de la vie chrétienne, la transformation réelle de l’homme tout entier dans la lumière de l’Esprit Saint."
                            },
                            {
                                "example_id": "685396ab-3a13-47cb-b979-1b65dda0addc",
                                "sense_id": "ec3119f0-6bc0-3b2a-a448-84e51aaf7d7b",
                                "text": "On voit souvent principalement en Vladimir Lossky le théologien qui a préparé la voie du père Jean Meyendorff en actualisant le palamisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31a41b12-00ed-479e-b315-5218d204d6a2",
                        "source_entry_id": "6b80e2f5-6d06-3db7-a31d-97d99c22dc53",
                        "source_sense_id": "ec3119f0-6bc0-3b2a-a448-84e51aaf7d7b",
                        "target_lang_word": "Palamism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palamism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcce9307-81e8-315d-83d5-0d611235c9f0",
                                        "entry_id": "b8db00d6-61aa-3d56-b32c-4d6f3b7750dd",
                                        "glosses": [
                                            "The beliefs and practices of the Palamites."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c6c30ea-75be-498b-8fd7-2d80c8e2f6cd",
                                                "sense_id": "dcce9307-81e8-315d-83d5-0d611235c9f0",
                                                "text": "The last years of the empire witnessed in Palamism a great revival of mystical personal religion."
                                            },
                                            {
                                                "example_id": "a79c1184-dcd2-446e-b2fd-8127d3630673",
                                                "sense_id": "dcce9307-81e8-315d-83d5-0d611235c9f0",
                                                "text": "The victory of Palamism in the fourteenth century was therefore the victory of a specifically Christian, God-centered humanism for which the Greek patristic tradition always stood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
