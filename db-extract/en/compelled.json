                    {
                        "sense_id": "98579249-d177-3fe6-b02f-8ed507a57f3f",
                        "entry_id": "d0e32bc1-198b-37b7-8921-0ee2850b7791",
                        "glosses": [
                            "Driven; forced."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df972259-9c47-437f-b91e-3c6084f6a31b",
                                "sense_id": "98579249-d177-3fe6-b02f-8ed507a57f3f",
                                "text": "I do believe state policymakers are very compelled to address those early years."
                            },
                            {
                                "example_id": "39bc4429-6e64-4e9c-a81c-e9c1f30c930d",
                                "sense_id": "98579249-d177-3fe6-b02f-8ed507a57f3f",
                                "text": "I was very compelled by the experience of watching Hamlet and the opening scene that has the ghost of his father on the parapet saying, “Revenge my death.”"
                            },
                            {
                                "example_id": "1c2ac261-1235-4232-a51c-490e904cd24e",
                                "sense_id": "98579249-d177-3fe6-b02f-8ed507a57f3f",
                                "text": "I was the only one who was in a position to do it, and I felt very compelled to do so."
                            }
                        ]
                    }
                ],
