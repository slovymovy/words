                "senses": [
                    {
                        "sense_id": "1e82b7a8-f074-31b3-bf93-b6b50fe62fe5",
                        "entry_id": "c0b2ecb4-6085-37e4-82bf-c33e9485eb02",
                        "glosses": [
                            "муз. второй голос в музыкальной партии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b9d347e-7be3-479b-b9cb-02e622dcc010",
                                "sense_id": "1e82b7a8-f074-31b3-bf93-b6b50fe62fe5",
                                "text": "Женская втора взлетает теперь, как бы забегая вперёд, и справа и слева, но не обгоняя."
                            }
                        ]
                    },
                    {
                        "sense_id": "26e4f263-a677-3395-93cf-4f14215ba6cf",
                        "entry_id": "c0b2ecb4-6085-37e4-82bf-c33e9485eb02",
                        "glosses": [
                            "муз. вторая партия, исполняемая на одном из инструментов в ансамбле"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a7e8e0a2-a902-33a5-bf1c-ba99165523aa",
                        "entry_id": "c0b2ecb4-6085-37e4-82bf-c33e9485eb02",
                        "glosses": [
                            "муз. инструмент, ведущий вторую партию в ансамбле"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6698b91-be44-461d-87db-70b91bc9ff4d",
                                "sense_id": "a7e8e0a2-a902-33a5-bf1c-ba99165523aa",
                                "text": "Играют на двух балалайках — приме и вторе."
                            },
                            {
                                "example_id": "5d779b1f-35c1-41f4-8e47-733cb361e1b9",
                                "sense_id": "a7e8e0a2-a902-33a5-bf1c-ba99165523aa",
                                "text": "Ты с басом, Мишенька, садись против альта, // Я, прима, сяду против вторы; // Тогда пойдёт уж музыка не та: // У нас запляшут лес и горы!"
                            }
                        ]
                    }
                ],
