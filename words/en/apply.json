{
    "word_family": [
        "application",
        "applicable",
        "applicant",
        "applicator",
        "misapply",
        "reapply"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dda29c01-a217-35f6-88d8-09b3dbab1186",
                    "sense_definition": "To submit a formal request or oneself as a candidate for a job, position, or admission.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to <w>apply</w> for a job at the local library.",
                            "target_lang_translations": {
                                "ru": "Я решил <w>подать заявление</w> на работу в местную библиотеку."
                            }
                        },
                        {
                            "text": "She will <w>apply</w> for a visa so she can travel abroad next summer.",
                            "target_lang_translations": {
                                "ru": "Она <w>подаст документы</w> на визу, чтобы поехать за границу следующим летом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "apply for a job",
                        "apply for a visa",
                        "apply to college"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подавать официальное заявление или представлять свою кандидатуру на работу, должность или поступление в учебное заведение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавать заявление",
                                "target_lang_sense_clarification": "официальный документ"
                            },
                            {
                                "target_lang_word": "подавать заявку",
                                "target_lang_sense_clarification": "на участие или конкурс"
                            },
                            {
                                "target_lang_word": "обращаться",
                                "target_lang_sense_clarification": "с просьбой или запросом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13ffeb46-8289-3cfb-a1b7-79f6478a097e",
                    "sense_definition": "To be relevant or to have an effect in a particular situation or for a specific person.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relevance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please note that these special rules only <w>apply</w> to international students.",
                            "target_lang_translations": {
                                "ru": "Обратите внимание, что эти особые правила <w>распространяются</w> только на иностранных студентов."
                            }
                        },
                        {
                            "text": "The discount does not <w>apply</w> to items that are already on sale.",
                            "target_lang_translations": {
                                "ru": "Скидка не <w>действует</w> на товары, которые уже продаются по акции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "apply to everyone",
                        "rules apply to",
                        "does not apply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть актуальным, иметь отношение или распространяться на конкретную ситуацию или человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "относиться",
                                "target_lang_sense_clarification": "иметь отношение к кому-либо"
                            },
                            {
                                "target_lang_word": "распространяться",
                                "target_lang_sense_clarification": "о правилах или законах"
                            },
                            {
                                "target_lang_word": "применяться",
                                "target_lang_sense_clarification": "быть применимым"
                            },
                            {
                                "target_lang_word": "касаться",
                                "target_lang_sense_clarification": "иметь значение для кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36b4922c-e3c8-3eb5-ab09-317e25003b3e",
                    "sense_definition": "To spread or put a substance onto a surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>apply</w> sunscreen every two hours while you are at the beach.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>наносить</w> солнцезащитный крем каждые два часа, пока вы на пляже."
                            }
                        },
                        {
                            "text": "The doctor told him to <w>apply</w> cream to the rash twice a day.",
                            "target_lang_translations": {
                                "ru": "Врач сказал ему <w>мазать</w> сыпь кремом дважды в день."
                            }
                        }
                    ],
                    "synonyms": [
                        "attach"
                    ],
                    "common_phrases": [
                        "apply cream to",
                        "apply a layer",
                        "apply pressure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить или распределять вещество по поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наносить",
                                "target_lang_sense_clarification": "крем, мазь или краску"
                            },
                            {
                                "target_lang_word": "прикладывать",
                                "target_lang_sense_clarification": "плотно прижимать к поверхности"
                            },
                            {
                                "target_lang_word": "мазать",
                                "target_lang_sense_clarification": "распределять по поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b7e0b6b-4348-39ad-a815-aee3d9f26df2",
                    "sense_definition": "To use a rule, method, or piece of knowledge in a specific situation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students must learn how to <w>apply</w> the formulas they learned in math class.",
                            "target_lang_translations": {
                                "ru": "Студенты должны научиться <w>применять</w> формулы, которые они выучили на уроке математики."
                            }
                        },
                        {
                            "text": "It is important to <w>apply</w> the skills you have gained to real-world problems.",
                            "target_lang_translations": {
                                "ru": "Важно <w>использовать</w> полученные навыки для решения реальных проблем."
                            }
                        }
                    ],
                    "synonyms": [
                        "use"
                    ],
                    "common_phrases": [
                        "apply the law",
                        "apply a method",
                        "apply knowledge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать правило, метод или знание в конкретной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "применять",
                                "target_lang_sense_clarification": "использовать на практике"
                            },
                            {
                                "target_lang_word": "использовать",
                                "target_lang_sense_clarification": "употреблять для дела"
                            },
                            {
                                "target_lang_word": "прилагать",
                                "target_lang_sense_clarification": "усилия или знания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f53ec282-0b5e-311c-ad8c-72312ad04778",
                    "sense_definition": "To work hard and stay focused on a task.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>apply</w> yourself to your studies, you will surely pass the exam.",
                            "target_lang_translations": {
                                "ru": "Если ты <w>приложишь усилия</w> к учебе, ты обязательно сдашь экзамен."
                            }
                        },
                        {
                            "text": "He managed to finish the project on time because he <w>applied</w> himself diligently.",
                            "target_lang_translations": {
                                "ru": "Ему удалось закончить проект вовремя, потому что он <w>усердно работал</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "devote"
                    ],
                    "common_phrases": [
                        "apply oneself to",
                        "apply your mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Усердно работать и сохранять концентрацию на задаче."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стараться",
                                "target_lang_sense_clarification": "прилагать усилия"
                            },
                            {
                                "target_lang_word": "усердно заниматься",
                                "target_lang_sense_clarification": "сосредоточенно работать"
                            },
                            {
                                "target_lang_word": "прикладывать усилия",
                                "target_lang_sense_clarification": "работать над собой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed8e25d0-ab79-3f3f-960d-c8d0bffd7c80",
                    "sense_definition": "To designate or use resources, such as money, for a specific purpose.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to <w>apply</w> the remaining funds to the building's renovation.",
                            "target_lang_translations": {
                                "ru": "Комитет решил <w>направить</w> оставшиеся средства на ремонт здания."
                            }
                        },
                        {
                            "text": "The grant was <w>applied</w> toward the purchase of new laboratory equipment.",
                            "target_lang_translations": {
                                "ru": "Грант был <w>использован</w> для покупки нового лабораторного оборудования."
                            }
                        }
                    ],
                    "synonyms": [
                        "appropriate"
                    ],
                    "common_phrases": [
                        "apply funds to",
                        "apply resources"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направлять или использовать ресурсы, такие как деньги, для определенной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направлять",
                                "target_lang_sense_clarification": "ресурсы или средства"
                            },
                            {
                                "target_lang_word": "использовать",
                                "target_lang_sense_clarification": "употреблять для цели"
                            },
                            {
                                "target_lang_word": "выделять",
                                "target_lang_sense_clarification": "средства на что-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "60cdb0e8-b843-3b9a-b026-7c603a309b9d",
                    "sense_definition": "An alternative spelling of <w>appley</w>, meaning resembling or tasting of apples.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "apple_like",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cider had a distinct, <w>apply</w> aroma that reminded him of autumn.",
                            "target_lang_translations": {
                                "ru": "У сидра был отчетливый <w>яблочный</w> аромат, который напоминал ему об осени."
                            }
                        },
                        {
                            "text": "She described the dessert as having a pleasantly <w>apply</w> flavor.",
                            "target_lang_translations": {
                                "ru": "Она описала десерт как имеющий приятный <w>яблочный</w> вкус."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант написания слова «appley», означающий напоминающий яблоко или имеющий вкус яблок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яблочный",
                                "target_lang_sense_clarification": "со вкусом или запахом яблок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}