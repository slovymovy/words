                                                "example_id": "0d225208-159a-4cfc-8906-17cec2fdcb12",
                                                "sense_id": "d87f3316-4d44-37aa-8b18-7819e70b5f25",
                                                "text": "Nurse Cramer's face blanched and she turned to Dunbar desperately for aid."
                                            },
                                            {
