                "translations": [
                    {
                        "translation_id": "18009205-77f6-40d4-998a-665f99542418",
                        "source_entry_id": "f2f6b3a0-f77a-378a-aad8-7488e9ce2b2b",
                        "source_sense_id": "836b3315-a8b7-3be2-a784-ed7cd6e2c2b5",
                        "target_lang_word": "successor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "successor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4eb8d969-c6a7-3cf0-b7c8-0a81538137e5",
                                        "entry_id": "9f17324e-abc8-381c-9f6e-afcbba85f969",
                                        "glosses": [
                                            "A person or thing that immediately follows another in holding an office or title."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10c1fcc2-87d4-4a26-842f-374a532443ca",
                                                "sense_id": "4eb8d969-c6a7-3cf0-b7c8-0a81538137e5",
                                                "text": "George W. Bush was successor to Bill Clinton as President of the US."
                                            },
                                            {
                                                "example_id": "c3e6b8b0-a061-449e-8306-9c568b1d2807",
                                                "sense_id": "4eb8d969-c6a7-3cf0-b7c8-0a81538137e5",
                                                "text": "After Li Tan's death in 1625, Hsu Hsin-su (許心素), leader of the Chang-chou people dwelling in and around the city of Hsia-men (廈門, or Amoy), emerged as his successor."
                                            },
                                            {
                                                "example_id": "d275e2be-85d0-47fa-af4f-731542e1a0b0",
                                                "sense_id": "4eb8d969-c6a7-3cf0-b7c8-0a81538137e5",
                                                "text": "As Di Matteo celebrated and captain John Terry raised the trophy for the fourth time, the Italian increased his claims to become the permanent successor to Andre Villas-Boas by landing a trophy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a0f3926-b8ac-3bba-b1f8-f886fb420741",
                                        "entry_id": "9f17324e-abc8-381c-9f6e-afcbba85f969",
                                        "glosses": [
                                            "The next heir in order or succession."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a0589cd-de14-3783-a1bf-c6e23c65a5bf",
                                        "entry_id": "9f17324e-abc8-381c-9f6e-afcbba85f969",
                                        "glosses": [
                                            "A person who inherits a title or office."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "994c7ce7-3d45-37e4-9076-5dd750a5ef8d",
                                        "entry_id": "9f17324e-abc8-381c-9f6e-afcbba85f969",
                                        "glosses": [
                                            "The integer, ordinal number or cardinal number immediately following another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c977ee43-f609-433e-a27b-a0f7fbd0d06a",
                                                "sense_id": "994c7ce7-3d45-37e4-9076-5dd750a5ef8d",
                                                "text": "A limit ordinal is not the successor of any ordinal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb10f7c4-7975-44f5-8d84-264af101ddc1",
                        "source_entry_id": "f2f6b3a0-f77a-378a-aad8-7488e9ce2b2b",
                        "source_sense_id": "69c32a5a-e856-38bb-988f-6b3ce2e31d35",
                        "target_lang_word": "heir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9f9aa98-bda6-3c67-a141-a9e7651b250b",
                                        "entry_id": "90a5fd77-a8b7-3511-b9d2-6ca0573d2e92",
                                        "glosses": [
                                            "Someone who inherits, or is designated to inherit, the property of another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41c01ed0-177f-490a-835b-4d805ad7fd22",
                                                "sense_id": "a9f9aa98-bda6-3c67-a141-a9e7651b250b",
                                                "text": "My brother is the heir to our childhood house and yet has no interest in it."
                                            },
                                            {
                                                "example_id": "ce062d38-7fd1-4bf2-b721-0aa205cb1ef4",
                                                "sense_id": "a9f9aa98-bda6-3c67-a141-a9e7651b250b",
                                                "text": "I am my father's heir and only son."
                                            },
                                            {
                                                "example_id": "6cf4edfe-ee0e-40c8-8f5c-99d6bc86915f",
                                                "sense_id": "a9f9aa98-bda6-3c67-a141-a9e7651b250b",
                                                "text": "As to eleemoſynary corporations, by the dotation the founder and his heirs are of common right the legal viſitors, to ſee that that property is rightly employed, which would otherwiſe have deſcended to the viſitor himſelf: […]"
                                            },
                                            {
                                                "example_id": "d4094309-022d-45d1-9c81-af73d6738909",
                                                "sense_id": "a9f9aa98-bda6-3c67-a141-a9e7651b250b",
                                                "text": "And no use for anyone to tell Charles that this was because the Family was in mourning for Mr Granville Darracott […]: Charles might only have been second footman at Darracott Place for a couple of months when that disaster occurred, but no one could gammon him into thinking that my lord cared a spangle for his heir."
                                            },
                                            {
                                                "example_id": "65dae598-a8be-4d2a-934a-04b7df334e00",
                                                "sense_id": "a9f9aa98-bda6-3c67-a141-a9e7651b250b",
                                                "text": "In ancient Greece, the Spartans developed rules that consolidated property into a narrow class of heirs, while the growing population of people left behind were reclassified as hypomeiones—inferiors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe4890ae-0f43-3229-a4da-a7db9335ab9f",
                                        "entry_id": "90a5fd77-a8b7-3511-b9d2-6ca0573d2e92",
                                        "glosses": [
                                            "One who inherits, or has been designated to inherit, a hereditary title or office."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f697c8b-bc8d-44f3-a4dc-fce53b21cf9b",
                                                "sense_id": "fe4890ae-0f43-3229-a4da-a7db9335ab9f",
                                                "text": "Vittorio Emanuele, the Italian throne's last heir, was apprehended in 1978 after a teen died from a gunshot on an exclusive island."
                                            },
                                            {
                                                "example_id": "994fee9e-61b7-4e23-90be-9b4bf263c7c2",
                                                "sense_id": "fe4890ae-0f43-3229-a4da-a7db9335ab9f",
                                                "text": "As the heir to the British throne, the Prince of Wales is a very public figure."
                                            },
                                            {
                                                "example_id": "062c312e-9cf4-4040-9d11-623cf20c99ee",
                                                "sense_id": "fe4890ae-0f43-3229-a4da-a7db9335ab9f",
                                                "text": "Now, after the death of Queen Elizabeth II, William, 40, is the Prince of Wales and the heir to the British throne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ca7e90e-0c85-319c-b8f7-4448604e61fb",
                                        "entry_id": "90a5fd77-a8b7-3511-b9d2-6ca0573d2e92",
                                        "glosses": [
                                            "A successor in a role, representing continuity with the predecessor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "251aaeba-c85c-4cec-8503-a48d582bee0a",
                                                "sense_id": "5ca7e90e-0c85-319c-b8f7-4448604e61fb",
                                                "text": "And I his heir in misery alone."
                                            },
                                            {
                                                "example_id": "70735c44-468f-4a8b-adaa-9d4c88ab9afb",
                                                "sense_id": "5ca7e90e-0c85-319c-b8f7-4448604e61fb",
                                                "text": "\"I wish we were back in Tenth Street. But so many children came[…]and the Tenth Street house wasn't half big enough; and a dreadful speculative builder built this house and persuaded Austin to buy it. Oh, dear, and here we are among the rich and great; and the steel kings and copper kings and oil kings and their heirs and dauphins.[…]\""
                                            },
                                            {
                                                "example_id": "1ec8e9a1-d026-4439-a9dd-3dd01a3e812a",
                                                "sense_id": "5ca7e90e-0c85-319c-b8f7-4448604e61fb",
                                                "text": "India is run by gerontocrats and epigones: grey hairs and groomed heirs."
                                            },
                                            {
                                                "example_id": "0493c632-55ed-49f3-af1e-af5edb6e59f5",
                                                "sense_id": "5ca7e90e-0c85-319c-b8f7-4448604e61fb",
                                                "text": "Sergeant Schlock has no horse, no armor, and no sword, but even the mightiest Mongol horse-warrior would see in him a fit heir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "heir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e8f4e3e-f43a-3ca7-a1b8-0025bf4df344",
                                        "entry_id": "73c009d0-643b-3ff0-8176-2e2b71e8844e",
                                        "glosses": [
                                            "To inherit."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "935b9e74-dff3-4b9a-8ade-42a17abfcfec",
                                                "sense_id": "4e8f4e3e-f43a-3ca7-a1b8-0025bf4df344",
                                                "text": "[…] Leonard Houtz & John Myer to be executors to this my last will & testament & lastly my children shall heir equally, one as much as the other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
