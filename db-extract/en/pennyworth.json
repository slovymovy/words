    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "42383f1f-2dc1-3042-8a5a-755464ab9b69",
                "word": "pennyworth",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4bae2f62-0a69-46f3-b6c6-ea231c8a7186",
                        "entry_id": "42383f1f-2dc1-3042-8a5a-755464ab9b69",
                        "tags": [
                            "plural"
                        ],
                        "form": "pennyworths"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8663bc3b-926e-3c9b-bb2f-7b6c43270a85",
                        "entry_id": "42383f1f-2dc1-3042-8a5a-755464ab9b69",
                        "glosses": [
                            "The amount that can be bought for a penny."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1613f075-9d35-44ef-b378-98720dbaa74f",
                                "sense_id": "8663bc3b-926e-3c9b-bb2f-7b6c43270a85",
                                "text": "She was learned in decocting all kinds of herb-tea, infallible in curing burns, sprains, and scalds ; and not a few pennyworths of gingerbread and paradise (for the latter she was very famous) went among her young customers, for which the till was never the richer."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd5a6047-4058-395a-903d-547862ca0e91",
                        "entry_id": "42383f1f-2dc1-3042-8a5a-755464ab9b69",
                        "glosses": [
                            "A small quantity or value."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c98af0d9-64ea-4782-8a1a-f8327058672a",
                                "sense_id": "bd5a6047-4058-395a-903d-547862ca0e91",
                                "text": "VVhy Lambe, vvhy Lady, fie you ſluggabed, / VVhy Loue I ſay, Madam, ſvveeteheart, vvhy Bride: / VVhat not a vvord, you take your pennivvorths novv, / Sleepe for a vveeke, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "119c2f76-10de-3bd5-80b3-04fabfa88d2f",
                        "entry_id": "42383f1f-2dc1-3042-8a5a-755464ab9b69",
                        "glosses": [
                            "A good bargain."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "0e3f9546-5ccd-45f1-85fa-b8ca8abdf9ca",
                                "sense_id": "119c2f76-10de-3bd5-80b3-04fabfa88d2f",
                                "text": "VVilt thou purchaſe it Nic.? thou ſhalt have a lumping Pennyvvorth; nay, rather than vve ſhould differ, I'll give thee ſomething to take it off my Hands."
                            }
                        ]
                    }
                ],
