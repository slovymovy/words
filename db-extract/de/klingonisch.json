                        ],
                        "examples": [
                            {
                                "example_id": "7db6a541-28c6-458f-b506-0d1ab6b42c06",
                                "sense_id": "e2799664-a001-3ce2-9ab4-d917078b9315",
                                "text": "Im Internet gibt es das offizielle Wörterbuch Klingonisch-Deutsch/Deutsch-Klingonisch"
                            },
                            {
                                "example_id": "e2d8c513-90ca-4d1e-95ff-567781985a87",
                                "sense_id": "e2799664-a001-3ce2-9ab4-d917078b9315",
                                "text": "Klingonisch wurde 1984 entwickelt."
                            },
                            {
                                "example_id": "521a3913-b3f9-42c9-a7de-5ea6c141fe19",
                                "sense_id": "e2799664-a001-3ce2-9ab4-d917078b9315",
                                "text": "„Nach dem ‚Kleinen Prinz‘ hat Star-Trek-Sprachexperte Lieven L. Litaer jetzt auch ‚Alice im Wunderland‘ ins Klingonische übersetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
