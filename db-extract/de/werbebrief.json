                "senses": [
                    {
                        "sense_id": "84b347a5-31ee-31bc-8f6e-31298b806a5a",
                        "entry_id": "8a9fe787-0a3b-3a05-8ade-866f55eb3ab1",
                        "glosses": [
                            "Brief, mit dem für etwas geworben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d7cdec0-08c7-4b77-a482-cd4dee48b17d",
                                "sense_id": "84b347a5-31ee-31bc-8f6e-31298b806a5a",
                                "text": "„Die weiter laufende Versendung dieser Werbebriefe, das Bestimmen der Empfänger schien eine der wichtigsten Aufgaben des Herrn Hoppe zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "338654c0-1944-44d9-afd2-ec954683abae",
                        "source_entry_id": "8a9fe787-0a3b-3a05-8ade-866f55eb3ab1",
                        "source_sense_id": "84b347a5-31ee-31bc-8f6e-31298b806a5a",
                        "source_sense_description": "Brief, mit dem für etwas geworben wird",
                        "target_lang_word": "publicité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "publicité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcdba10c-62d9-3e64-bac0-27fe574cc590",
                                        "entry_id": "451da586-abfc-37aa-b352-48d67dea6401",
                                        "glosses": [
                                            "Notoriété publique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4023f889-a91a-4194-8ccc-016eced47418",
                                                "sense_id": "bcdba10c-62d9-3e64-bac0-27fe574cc590",
                                                "text": "La publicité du crime en rend la punition plus nécessaire."
                                            },
                                            {
                                                "example_id": "ed7eb2b7-e16e-47cb-87f0-5e74db78ba2d",
                                                "sense_id": "bcdba10c-62d9-3e64-bac0-27fe574cc590",
                                                "text": "Qu’ils soient poètes, hommes politiques, négriers, marchands de contremarques ou toutes ces belles choses ensemble, qu’ils aient encore le pied dans la noire crotte du début ou qu’ils aient depuis longtemps escaladé les frises, ils sont identiques par la plus enragée fringale de publicité et de tintamarre."
                                            },
                                            {
                                                "example_id": "fe767f0e-d173-4b48-b8a9-2432ef0a44e6",
                                                "sense_id": "bcdba10c-62d9-3e64-bac0-27fe574cc590",
                                                "text": "C'est une publicité dont le géant du hard-discount français se serait sans doute bien passé. Jeudi, la cour d'appel de Pau a confirmé la condamnation de Lidl pour «vente illicite d'alcool à un mineur» dans une affaire d’accident routier ayant provoqué la mort d’un adolescent en 2021."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4645f0bd-6b6b-375e-ae17-77a84a5e728f",
                                        "entry_id": "451da586-abfc-37aa-b352-48d67dea6401",
                                        "glosses": [
                                            "Action de rendre public, résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b588ea3-028b-415e-bf9a-d69929c9ac7f",
                                                "sense_id": "4645f0bd-6b6b-375e-ae17-77a84a5e728f",
                                                "text": "La publicité des débats judiciaires en matière criminelle est consacrée par nos lois."
                                            },
                                            {
                                                "example_id": "abfda167-9b39-4bca-9881-f0d558854a7a",
                                                "sense_id": "4645f0bd-6b6b-375e-ae17-77a84a5e728f",
                                                "text": "Leurs démêlés ont eu, ont reçu la plus grande publicité."
                                            },
                                            {
                                                "example_id": "485f086e-90f0-4a26-929a-53d7a8e87c03",
                                                "sense_id": "4645f0bd-6b6b-375e-ae17-77a84a5e728f",
                                                "text": "Il a donné toute la publicité possible à ses réclamations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05739c9a-db34-3f6e-8049-a68efa6fd212",
                                        "entry_id": "451da586-abfc-37aa-b352-48d67dea6401",
                                        "glosses": [
                                            "Action de rendre public, résultat de cette action.",
                                            "Possibilité pour le public d'assister aux audiences d'un tribunal. Antonyme : huis clos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bd4c716-b0ae-49c1-bc77-18cc7e65238a",
                                                "sense_id": "05739c9a-db34-3f6e-8049-a68efa6fd212",
                                                "text": "La loi exige la publicité des débats judiciaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b5f6e5a-26b3-310d-8597-4eb65cd0dcc5",
                                        "entry_id": "451da586-abfc-37aa-b352-48d67dea6401",
                                        "glosses": [
                                            "Action, fait de promouvoir la vente d'un produit en exerçant sur le public une influence, une action psychologique afin de créer en lui des besoins, des désirs ; ensemble des moyens employés pour promouvoir un produit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38b045fe-0b1e-4fe7-8086-edfb9ffc0509",
                                                "sense_id": "2b5f6e5a-26b3-310d-8597-4eb65cd0dcc5",
                                                "text": "Les différences socioculturelles sont l'expression des écarts de perception entre la culture du marché source et celle du pays cible. La partie la plus visible de ces écarts est traduite pas la publicité. Les images et les slogans, les contextes de mise en avant des produits et des services sont la partie la plus perméable aux différences socioculturelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "459d87ab-2b93-3881-bfad-3649504ded9f",
                                        "entry_id": "451da586-abfc-37aa-b352-48d67dea6401",
                                        "glosses": [
                                            "Annonce de caractère commercial par les journaux, les affiches, les prospectus et tous autres moyens de réclame."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfda8a90-e4b0-4753-b7e0-a435ca49a770",
                                                "sense_id": "459d87ab-2b93-3881-bfad-3649504ded9f",
                                                "text": "Publicité lumineuse."
                                            },
                                            {
                                                "example_id": "80921666-8899-449c-bb45-d61b4407350c",
                                                "sense_id": "459d87ab-2b93-3881-bfad-3649504ded9f",
                                                "text": "Une publicité pleine page sur la quatrième de couverture."
                                            },
                                            {
                                                "example_id": "e7d8e205-893d-4c32-94b6-3ef61998ca35",
                                                "sense_id": "459d87ab-2b93-3881-bfad-3649504ded9f",
                                                "text": "Ces réclames, que l'on ne désignait pas encore [en 1955] sous le vocable de « publicités », faisaient vivre grassement Paris Match et je n'avais pas matière à m'en plaindre, tout au plus à sourire de leur puérilité."
                                            },
                                            {
                                                "example_id": "3189bfb6-64c8-4042-bcde-a3fbd87777ff",
                                                "sense_id": "459d87ab-2b93-3881-bfad-3649504ded9f",
                                                "text": "Quand, la popularité du denim s’affolant, les adolescents le baptisent blue-jeans ou jeans (au pluriel en américain), les fabricants ne leur font pas une leçon de vocabulaire : ils adoptent eux-mêmes le mot dans leurs publicités."
                                            },
                                            {
                                                "example_id": "3881821f-613e-40b5-8d8e-6c409489f836",
                                                "sense_id": "459d87ab-2b93-3881-bfad-3649504ded9f",
                                                "text": "déterminer les informations utiles, qui doivent être directement et facilement accessibles à partir de la publicité, concernant les principaux paramètres utilisés pour déterminer le destinataire auquel la publicité est présentée et, le cas échéant, la manière dont ces paramètres peuvent être modifiés"
                                            },
                                            {
                                                "example_id": "320064ef-913d-4f33-b953-c7dfb7bf587f",
                                                "sense_id": "459d87ab-2b93-3881-bfad-3649504ded9f",
                                                "text": "Si « votre démocratie peut être détruite avec quelques centaines de milliers de dollars de publicité numérique d’un pays étranger, alors elle n’est pas très forte », a-t-il lâché."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd0b6577-2dcc-3b5e-a446-d7f41e9fe215",
                                        "entry_id": "451da586-abfc-37aa-b352-48d67dea6401",
                                        "glosses": [
                                            "Secteur, domaine des pratiques publicitaires."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08ff99ae-62c5-4a79-ac78-7f0a2012f448",
                                                "sense_id": "bd0b6577-2dcc-3b5e-a446-d7f41e9fe215",
                                                "text": "Or il est à la veille, grâce à de puissantes interventions, d'affermer complètement la publicité de Lutèce-Journal."
                                            },
                                            {
                                                "example_id": "f8e46474-8e32-4b73-b5e2-4408fc044df3",
                                                "sense_id": "bd0b6577-2dcc-3b5e-a446-d7f41e9fe215",
                                                "text": "La publicité devrait croitre de 3 % par an dans les prochaines années."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bed265c2-f8f7-4e6b-aa41-94836712310f",
                        "source_entry_id": "8a9fe787-0a3b-3a05-8ade-866f55eb3ab1",
                        "source_sense_id": "84b347a5-31ee-31bc-8f6e-31298b806a5a",
                        "source_sense_description": "Brief, mit dem für etwas geworben wird",
                        "target_lang_word": "tract",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tract",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bed8b97-c17d-3c3e-a8cc-ee89d267ceab",
                                        "entry_id": "dd9699ca-459a-33e6-9c4f-19c86dae6bf2",
                                        "glosses": [
                                            "Petit document servant à la propagande ou à la publicité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "296a190b-3875-4c1a-a2df-ddbc29c592cc",
                                                "sense_id": "9bed8b97-c17d-3c3e-a8cc-ee89d267ceab",
                                                "text": "La direction nationale du Parti communiste, dans sa presse clandestine, dans ses tracts, attaquait toujours plutôt Vichy que l'occupant."
                                            },
                                            {
                                                "example_id": "4b0dbd82-04bd-498d-8a3f-b48a38957819",
                                                "sense_id": "9bed8b97-c17d-3c3e-a8cc-ee89d267ceab",
                                                "text": "Car la chanson a été importante dans le dispositif d'une subversion politique qui, tout compte fait, a peut-être plus avancé par le 45 tours que par le tract, par le mange-disques que par le cocktail Molotov."
                                            },
                                            {
                                                "example_id": "4efaf5fa-1622-491e-92cb-b5aa0268724c",
                                                "sense_id": "9bed8b97-c17d-3c3e-a8cc-ee89d267ceab",
                                                "text": "Ainsi, l’un des spécialistes du mouvement islamique tend à croire que Hamas a surnuméroté ses tracts afin de donner l’impression qu’il avait publié ses tracts avant la DNU."
                                            },
                                            {
                                                "example_id": "d67f16f0-5835-4d52-8984-94b900a56a7b",
                                                "sense_id": "9bed8b97-c17d-3c3e-a8cc-ee89d267ceab",
                                                "text": "En 1976, sur le modèle des chaînes d’amitié, se diffusent dans les hôpitaux et les écoles une liste que l’on appelle très rapidement le “tract de Villejuif”, puisque prétendûment émanant de l’Hôpital de Villejuif, l’Institut Gustave Roussy, en pointe dans le traitement des malades de cancers depuis plusieurs décennies. Cette liste, que dit-elle ? Que certains de cette très longue série d’additifs sont cancérigènes et donc à éviter absolument."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6bd7e2a-9bd5-4d89-97d9-ba4346ce9433",
                        "source_entry_id": "8a9fe787-0a3b-3a05-8ade-866f55eb3ab1",
                        "source_sense_id": "84b347a5-31ee-31bc-8f6e-31298b806a5a",
                        "source_sense_description": "Brief, mit dem für etwas geworben wird",
                        "target_lang_word": "réclame",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réclame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb44f683-ffbb-324c-a9d5-e44197f16b46",
                                        "entry_id": "4f152e46-3c82-3008-9ac9-2657c5b6441c",
                                        "glosses": [
                                            "Le cri et le signe qu’on fait à un oiseau pour le faire revenir au leurre ou sur le poing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2519a4a9-2c69-4f19-9a4c-6ce62d8c0dfb",
                                                "sense_id": "bb44f683-ffbb-324c-a9d5-e44197f16b46",
                                                "text": "Un oiseau qui vient au réclame."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "réclame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db42452b-fd60-341f-bb10-f906ed5c4b04",
                                        "entry_id": "59a9ea5f-64b9-3fe9-af87-a35ee14c10b3",
                                        "glosses": [
                                            "Article inséré dans la presse et qui a pour objet d’attirer l’attention sur un produit de grande consommation, plus sûrement que par une annonce ostensiblement payée. On dit aujourd’hui « publireportage » ou « publicité infomerciale » dans ce sens."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e80c441a-4a1d-47c2-852f-2b1e67c3e6b5",
                                                "sense_id": "db42452b-fd60-341f-bb10-f906ed5c4b04",
                                                "text": "[…] flétrissez aussi le charlatanisme de ces pseudo-virtuoses qui ont obtenu des succès apocryphes à New-York ou en Californie, et qui, précédés de réputations flambardes, à base de réclame, escortés de notices abracadabrantes, viennent défigurer sur nos grandes scènes lyriques des partitions dont elles ridiculisent la majesté par les exagérations de leur style exotique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f83605f-3e14-3e93-a732-028a081d701f",
                                        "entry_id": "59a9ea5f-64b9-3fe9-af87-a35ee14c10b3",
                                        "glosses": [
                                            "Toute forme de publicité."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92167d1b-fb80-45f8-9eea-535201bada3d",
                                                "sense_id": "2f83605f-3e14-3e93-a732-028a081d701f",
                                                "text": "Quoi, c’était cela, ces fiers artistes, ces admirables écrivains, dont on chante la gloire, dont on célèbre le génie… cela, ces êtres petits, vulgaires, affreusement cuistres, singeant les façons des mondains qu’ils raillent, d’une vanité burlesque, d’une jalousie féroce ; à plat ventre, eux aussi, devant l’argent ; adorant, les genoux dans la poussière, la Réclame, cette vieille gueuse, qu’ils hissent sur des peluches extravagantes…"
                                            },
                                            {
                                                "example_id": "8f4b0615-edc0-4593-b1a5-6ab67e7071cc",
                                                "sense_id": "2f83605f-3e14-3e93-a732-028a081d701f",
                                                "text": "Duchotel. — Je l’ai rangé sur la table du salon… Comme ça, les gens le feuillettent, ça fait toujours de la réclame."
                                            },
                                            {
                                                "example_id": "68123d33-e6ab-4d81-aad7-1424d4241555",
                                                "sense_id": "2f83605f-3e14-3e93-a732-028a081d701f",
                                                "text": "En outre la réclame commerciale et industrielle, voire même la propagande politique, se sont emparées de l’image et de ses dérivés, les considérant comme des moyens puissants autant qu’avantageux […]"
                                            },
                                            {
                                                "example_id": "0e519ce7-a257-4abc-82e5-4b70e6b47cb6",
                                                "sense_id": "2f83605f-3e14-3e93-a732-028a081d701f",
                                                "text": "Payée en services rendus à des gens influents, payée en dîners et en réceptions, payée en argent même, c’est la réclame qui est à la base de la célébrité de cet écrivain. Aussi, il sait ce que vaut la gloire !"
                                            },
                                            {
                                                "example_id": "6b4371cc-4cf7-4b10-87df-4a7d7eea55b1",
                                                "sense_id": "2f83605f-3e14-3e93-a732-028a081d701f",
                                                "text": "Dans la même direction, la réclame d’un cinéma flambait telle un tison […]"
                                            },
                                            {
                                                "example_id": "1c34a933-642e-44ab-9adf-eeb2eb19b6a0",
                                                "sense_id": "2f83605f-3e14-3e93-a732-028a081d701f",
                                                "text": "Offrir cinq cents flacons de vinaigre des quatre-voleurs comme produit désinfectant au bureau de bienfaisance du XIᵉ arrondissement, c’est un acte généreux ; faire savoir qu’il provient de la maison Maille, Robillard, Segond et Cie, cela devient de la réclame […]"
                                            },
                                            {
                                                "example_id": "ef290049-9b5a-4ed1-b5cb-187e831f30c8",
                                                "sense_id": "2f83605f-3e14-3e93-a732-028a081d701f",
                                                "text": "Ces réclames, que l’on ne désignait pas encore [en 1955] sous le vocable de « publicités », faisaient vivre grassement Paris Match et je n’avais pas matière à m’en plaindre, tout au plus à sourire de leur puérilité."
                                            },
                                            {
                                                "example_id": "5086edcb-009a-428f-91dc-97c999283b41",
                                                "sense_id": "2f83605f-3e14-3e93-a732-028a081d701f",
                                                "text": "— Enfin, la pendule-réclame Guérin-Boutron, fixée près d’une cabine de téléphone, marquait une fois pour toutes la demie de minuit, en cas de contestation."
                                            },
                                            {
                                                "example_id": "5ca95529-1305-4338-bfa8-2151c1c0685d",
                                                "sense_id": "2f83605f-3e14-3e93-a732-028a081d701f",
                                                "text": "[…] on avait ajouté deux écriteaux réclames, dont l’un recommandait une montre à 3 fr. 95 et l’autre un tonique pour le système nerveux. Ces deux écriteaux étaient placés sur un plan horizontal, de façon à frapper la vue des voyageurs du monorail aérien […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ec6a38f-457c-3588-bfce-4b6b41d172f6",
                                        "entry_id": "59a9ea5f-64b9-3fe9-af87-a35ee14c10b3",
                                        "glosses": [
                                            "Mot, ou fin de mot, qu’on mettait au-dessous de la dernière ligne d’une feuille ou d’une page d’impression et qui se trouve en première position sur la page suivante."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a54cab17-3765-3f1c-9696-94c7af15fd32",
                                        "entry_id": "59a9ea5f-64b9-3fe9-af87-a35ee14c10b3",
                                        "glosses": [
                                            "Promotion, réduction."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b3d9549-8996-400f-9a24-517c8ac06488",
                                                "sense_id": "a54cab17-3765-3f1c-9696-94c7af15fd32",
                                                "text": "Dans ce supermarché, les légumes sont en réclame jusqu'à la fin de la semaine."
                                            },
                                            {
                                                "example_id": "ac5e5aaf-07ee-4097-ada4-a2e75f607f03",
                                                "sense_id": "a54cab17-3765-3f1c-9696-94c7af15fd32",
                                                "text": "Pour faire des économies, j'achète beaucoup de produits en réclame."
                                            },
                                            {
                                                "example_id": "ca819ce1-3373-4bc6-bcda-fe436db616b8",
                                                "sense_id": "a54cab17-3765-3f1c-9696-94c7af15fd32",
                                                "text": "Les magasins font beaucoup de réclames sur le matériel scolaire, car c'est bientôt la rentrée des classes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
