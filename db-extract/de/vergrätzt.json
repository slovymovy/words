                ],
                "senses": [
                    {
                        "sense_id": "d1b79f84-c1dc-3eaa-bdd3-f0df6c33a9c0",
                        "entry_id": "0033adbb-b740-34b0-8788-eee037278e14",
                        "glosses": [
                            "Ärger empfindend, Wut zum Ausdruck bringend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "807d0c63-61d4-4062-a412-9236831cff31",
                                "sense_id": "d1b79f84-c1dc-3eaa-bdd3-f0df6c33a9c0",
                                "text": "„Etwas vergrätzt war dieser dann nur, als ich keinerlei Verständnis für den Ärger beim gescheiterten Kauf der Nachbargrundstücke zeigte.“"
                            },
                            {
                                "example_id": "56bd077d-81d1-471a-aef8-9cdb48e269e8",
                                "sense_id": "d1b79f84-c1dc-3eaa-bdd3-f0df6c33a9c0",
                                "text": "„Diana wirkte auch entsprechend vergrätzt und kühl, was ihr Sanny nicht einmal verübeln konnte.“"
                            },
                            {
                                "example_id": "ecf87058-0cc5-456b-962b-31e665325098",
                                "sense_id": "d1b79f84-c1dc-3eaa-bdd3-f0df6c33a9c0",
                                "text": "„Aber sie war so häßlich und sah so recht vergrätzt aus, daß der Prinz nur ungern sein Wort hielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
