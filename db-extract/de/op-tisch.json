                "senses": [
                    {
                        "sense_id": "9fc4e7df-5477-3618-89dd-b4c901df4a2f",
                        "entry_id": "5c937225-fa84-3b1c-b0b7-d1eca4e24edc",
                        "glosses": [
                            "Vorrichtung im Operationssaal, auf der die Patienten, die operiert werden, während der Operation liegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fc4050b-f5a5-4029-a652-cd3ee567c0df",
                                "sense_id": "9fc4e7df-5477-3618-89dd-b4c901df4a2f",
                                "text": "„Ich sitze auf einem OP-Tisch.“"
                            },
                            {
                                "example_id": "1f2a7827-9eaa-4564-8220-9a91a8b5787d",
                                "sense_id": "9fc4e7df-5477-3618-89dd-b4c901df4a2f",
                                "text": "„Ein Arzt mit einer Maske über dem Gesicht blickt starr vom OP-Tisch weg.“"
                            },
                            {
                                "example_id": "760f52d5-4fdf-4d05-b235-77a0766f8b44",
                                "sense_id": "9fc4e7df-5477-3618-89dd-b4c901df4a2f",
                                "text": "„Seine Muskeln lockerten sich, vollkommen entspannt lag er auf dem OP-Tisch.“"
                            },
                            {
                                "example_id": "e8fd25ed-6981-42cb-8435-e2bad9066d74",
                                "sense_id": "9fc4e7df-5477-3618-89dd-b4c901df4a2f",
                                "text": "„Im Leichenschauhaus legt der Amtsdiener die Überreste auf einem OP-Tisch aus.“"
                            },
                            {
                                "example_id": "aada8bfd-0516-43fa-9dde-37c0d592e91d",
                                "sense_id": "9fc4e7df-5477-3618-89dd-b4c901df4a2f",
                                "text": "„In einigen Räumen gab es sogar ein paar Käfige oder OP-Tische und medizinisches Gerät.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
