            {
                "entry_id": "2594cb23-472b-36ad-8fa1-cf6150cc01f2",
                "word": "archimandrite",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bbcda4e1-9d60-49e5-bb11-28509931463f",
                        "entry_id": "2594cb23-472b-36ad-8fa1-cf6150cc01f2",
                        "tags": [
                            "plural"
                        ],
                        "form": "archimandrites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50ab527d-a06c-3a23-a4a6-d55920754257",
                        "entry_id": "2594cb23-472b-36ad-8fa1-cf6150cc01f2",
                        "glosses": [
                            "The superior of a large monastery, or group of monasteries, in the Orthodox Church."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27f3c2b1-cb8e-4c8c-9ac5-9626d9f49bfb",
                                "sense_id": "50ab527d-a06c-3a23-a4a6-d55920754257",
                                "text": "My predecessors generally preferred to live and work in the monastery proper, but I like the solitude of the caves. I have been an archimandrite, here at Pskov, since 1915 and a humble monk for twenty years before that."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb13177e-308e-3f61-8778-aa63bcf1738a",
                        "entry_id": "2594cb23-472b-36ad-8fa1-cf6150cc01f2",
                        "glosses": [
                            "An honorary title sometimes given to a monastic priest."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5206b773-3a23-47af-bcfa-6ec662c9a2a0",
                        "source_entry_id": "2594cb23-472b-36ad-8fa1-cf6150cc01f2",
                        "source_sense_description": "The superior of a large monastery, or group of monasteries, in the Orthodox Church",
                        "target_lang_word": "archimandrite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archimandrite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d68e05c-16b6-366f-b2d4-d2b80092cb63",
                                        "entry_id": "46b8b7df-4b4a-3aa1-bde6-d484e88b0686",
                                        "glosses": [
                                            "Supérieur de monastère (abbé en Occident, higoumène en Orient) dans l’église grecque à qui l’évêque a confié la supervision de plusieurs monastères ou groupements monastiques."
                                        ],
                                        "tags": [
                                            "À l’origine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ec6b59e-de0f-4570-ba5e-1a5170471454",
                                                "sense_id": "1d68e05c-16b6-366f-b2d4-d2b80092cb63",
                                                "text": "Le terme higoumène est également beaucoup moins fréquent dans les sources du Vᵉ siècle que celui d’archimandrite."
                                            },
                                            {
                                                "example_id": "b343baec-cd6c-4773-9a5f-7ff408c2b18d",
                                                "sense_id": "1d68e05c-16b6-366f-b2d4-d2b80092cb63",
                                                "text": "[…] ils rapportèrent une chasuble brodée d’or à l’archimandrite du couvent de Méjigorsh à Kiew,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55aaa0d5-4675-3577-8ac9-84fde9165d67",
                                        "entry_id": "46b8b7df-4b4a-3aa1-bde6-d484e88b0686",
                                        "glosses": [
                                            "Titre honorifique conféré à certains hiéromoines (moines prêtres) qui assument une charge importante dans un monastère, à la tête d’une paroisse ou dans l’administration d’une métropole. C’est la plus haute dignité avant d’accéder à l’épiscopat."
                                        ],
                                        "tags": [
                                            "Aujourd’hui"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad21e5ed-3fdf-4114-89f2-77e49fd8125f",
                                                "sense_id": "55aaa0d5-4675-3577-8ac9-84fde9165d67",
                                                "text": "Archimandrite du Mont Athos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ed8fc06-b36f-4986-acc5-69ec0155b98e",
                        "source_entry_id": "2594cb23-472b-36ad-8fa1-cf6150cc01f2",
