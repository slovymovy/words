                "senses": [
                    {
                        "sense_id": "034a0b69-95f8-367c-903b-95354b4f0783",
                        "entry_id": "7b809b4e-4b45-3ee9-bade-39707424612d",
                        "glosses": [
                            "To do something insufficiently; especially, to undercook."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5c1c9cbb-ecb7-456b-a540-b442476e6eb3",
                                "sense_id": "034a0b69-95f8-367c-903b-95354b4f0783",
                                "text": "Sorry to say, I've underdone the pot roast. I think we'd better put it back in the oven for a bit."
                            },
                            {
                                "example_id": "b4d91b18-35e4-4d73-971a-45375abd6adb",
                                "sense_id": "034a0b69-95f8-367c-903b-95354b4f0783",
                                "text": "Sorry to say, I've underdone the downspout repair. I think we'd better hire someone to replace the whole thing."
                            }
                        ]
                    },
                    {
                        "sense_id": "0638003d-8f20-36c2-8c6c-01b104c6118e",
                        "entry_id": "7b809b4e-4b45-3ee9-bade-39707424612d",
                        "glosses": [
                            "To do something insufficiently; especially, to undercook.",
                            "To do less than is requisite."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3cb9912d-73e2-460f-8b84-695a739edc2e",
                                "sense_id": "0638003d-8f20-36c2-8c6c-01b104c6118e",
                                "text": "Near-synonyms: (of tasks) half-ass, shortchange, phone in"
                            },
                            {
                                "example_id": "04f9397b-b07d-4b94-9f2e-2592250f6bd5",
                                "sense_id": "0638003d-8f20-36c2-8c6c-01b104c6118e",
                                "text": "We warned him not to underdo it. This customer expects attention to detail."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4295d3b-574b-3d1c-892c-b8672ef2e103",
                        "entry_id": "7b809b4e-4b45-3ee9-bade-39707424612d",
                        "glosses": [
                            "To do something insufficiently; especially, to undercook.",
                            "To act below one's abilities; do less than one can."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "80651e24-ec04-430f-9998-6362c825fed3",
                                "sense_id": "d4295d3b-574b-3d1c-892c-b8672ef2e103",
                                "text": "Near-synonyms: underachieve, slack off"
                            }
                        ]
                    },
