                    {
                        "sense_id": "c7d82549-8deb-32a2-a4c1-7c3bacba2faf",
                        "entry_id": "6ea83a17-b106-34ba-9ece-9b37b79bc65c",
                        "glosses": [
                            "Pointe dure et raide, à l’extrémité d’un organe végétal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86e3b0e1-ef4e-4ab9-a4fd-b234d605b55e",
                                "sense_id": "c7d82549-8deb-32a2-a4c1-7c3bacba2faf",
                                "text": "La noix se présente sous forme d’une coquille, ou coque, qui est l’endocarpe lignifié. Cette coque qui mesure de quatre à cinq centimètres de long sur trois à quatre centimètres de large, se sépare en deux et présente à son sommet un mucron plus ou moins accentué."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce0403cb-1859-3bfb-9259-cbe466402c25",
                        "entry_id": "6ea83a17-b106-34ba-9ece-9b37b79bc65c",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26d81783-2b19-457f-8e14-814f6206ac78",
                                "sense_id": "ce0403cb-1859-3bfb-9259-cbe466402c25",
                                "text": "Mais il faut distinguer entre toutes la chrysalide de l’Ac. rufomixtata, qui possède cet étrange caractère d’une glossothèque libre, longue, dépassant le mucron, puis contournée en dessous jusqu’au thorax."
                            }
                        ]
                    }
                ],
