                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9388973-2607-3978-8a0a-d99c662506ee",
                        "entry_id": "14c7d83c-fbe3-31ec-847b-badfb5132763",
                        "glosses": [
                            "завершить мойку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccfc013e-3eda-49e5-b7d5-cade0da2bb41",
                                "sense_id": "c9388973-2607-3978-8a0a-d99c662506ee",
                                "text": "Он домыл последнее блюдце, поставил его в сушилку, кое-как затер лужу на линолеуме и пошел в большую комнату."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84147b3d-9497-4f0e-ae3c-25a29baf9f5f",
                        "source_entry_id": "14c7d83c-fbe3-31ec-847b-badfb5132763",
                        "source_sense_id": "c9388973-2607-3978-8a0a-d99c662506ee",
                        "target_lang_word": "finir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ccb911c2-ba2f-3c20-8785-d603208d7fe2",
                                        "entry_id": "78956a25-26e0-3e60-8526-c7fba78e8a28",
                                        "glosses": [
                                            "Achever, terminer, arriver à échéance, cesser, finaliser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69a3f3d9-8769-4d55-a37a-f1f0b8e2d3cd",
                                                "sense_id": "ccb911c2-ba2f-3c20-8785-d603208d7fe2",
                                                "text": "[…], et elle lui fit signe d'attendre qu'elle eût fini de donner à boire à cet affligé, un malheureux couvreur qui s'était cassé les deux bras en tombant d'un toit."
                                            },
                                            {
                                                "example_id": "807a4a3e-57de-412c-a2db-68fc4b484feb",
                                                "sense_id": "ccb911c2-ba2f-3c20-8785-d603208d7fe2",
                                                "text": "Quand il avait fini d'un plat, il repoussait un peu sa chaise afin de donner de l'aise à son ventre et il attendait."
                                            },
                                            {
                                                "example_id": "0f9a16b2-3816-4658-b5d6-645843d5706f",
                                                "sense_id": "ccb911c2-ba2f-3c20-8785-d603208d7fe2",
                                                "text": "Finir un discours par une belle péroraison."
                                            },
                                            {
                                                "example_id": "986c810a-dae1-4147-91b2-3f74d6334d50",
                                                "sense_id": "ccb911c2-ba2f-3c20-8785-d603208d7fe2",
                                                "text": "Finir une affaire, un ouvrage."
                                            },
                                            {
                                                "example_id": "17a818a8-a146-403c-9cce-43103c96510a",
                                                "sense_id": "ccb911c2-ba2f-3c20-8785-d603208d7fe2",
                                                "text": "Finissons ce badinage."
                                            },
                                            {
                                                "example_id": "e4345ea7-91c7-4bc7-a490-3de531907aa8",
                                                "sense_id": "ccb911c2-ba2f-3c20-8785-d603208d7fe2",
                                                "text": "J’ai fini par apprendre ce que veut dire finir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7340275-26e2-38dd-958a-daf3f4643340",
                                        "entry_id": "78956a25-26e0-3e60-8526-c7fba78e8a28",
                                        "glosses": [
                                            "Exécuter avec un soin minutieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a08248e-413b-4a5f-8946-758f43e1b606",
                                                "sense_id": "a7340275-26e2-38dd-958a-daf3f4643340",
                                                "text": "Ce peintre finit patiemment, finit trop."
                                            },
                                            {
                                                "example_id": "1d318424-c677-4cdf-8644-49316f442829",
                                                "sense_id": "a7340275-26e2-38dd-958a-daf3f4643340",
                                                "text": "Cet artiste ne sait pas finir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96162ed3-7b19-3933-8797-cbbf384ce1cc",
                                        "entry_id": "78956a25-26e0-3e60-8526-c7fba78e8a28",
                                        "glosses": [
                                            "Être la fin ou le terme de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6a2852a-daf5-4675-baf0-4b43ade1aa4f",
                                                "sense_id": "96162ed3-7b19-3933-8797-cbbf384ce1cc",
                                                "text": "Finissez donc, vous me faites mal."
                                            },
                                            {
                                                "example_id": "92693fe1-b330-4897-a8c8-69a8c69b367f",
                                                "sense_id": "96162ed3-7b19-3933-8797-cbbf384ce1cc",
                                                "text": "Cet enfant ne finira pas, si on ne le châtie."
                                            },
                                            {
                                                "example_id": "c8bd6916-70df-48fe-8a37-0b04017e1aad",
                                                "sense_id": "96162ed3-7b19-3933-8797-cbbf384ce1cc",
                                                "text": "Faites-le donc finir."
                                            },
                                            {
                                                "example_id": "ff1b7210-d289-4ba4-b58c-cb36f5af7d90",
                                                "sense_id": "96162ed3-7b19-3933-8797-cbbf384ce1cc",
                                                "text": "Savoir finir à propos."
                                            },
                                            {
                                                "example_id": "2e452101-255f-41c1-ba56-9370476e6eb0",
                                                "sense_id": "96162ed3-7b19-3933-8797-cbbf384ce1cc",
                                                "text": "La période qui finit son discours est remarquable."
                                            },
                                            {
                                                "example_id": "558e9ef7-eb5e-4509-85ca-f5a90d5bc9c2",
                                                "sense_id": "96162ed3-7b19-3933-8797-cbbf384ce1cc",
                                                "text": "Cette campagne finira la guerre."
                                            },
                                            {
                                                "example_id": "92996fda-9ac6-4755-a237-5ad27414029b",
                                                "sense_id": "96162ed3-7b19-3933-8797-cbbf384ce1cc",
                                                "text": "L’instant qui doit finir sa vie, le cours de sa vie."
                                            },
                                            {
                                                "example_id": "8d1d0289-99af-4991-b25a-ee1343761cb9",
                                                "sense_id": "96162ed3-7b19-3933-8797-cbbf384ce1cc",
                                                "text": "J’ai commencé par où il avait fini."
                                            },
                                            {
                                                "example_id": "f8e2a012-4368-4b3d-b07c-e81a09f40078",
                                                "sense_id": "96162ed3-7b19-3933-8797-cbbf384ce1cc",
                                                "text": "Je ne finirai pas sans un mot d’espoir."
                                            },
                                            {
                                                "example_id": "0faecaa7-0274-4567-bca5-144e285214d5",
                                                "sense_id": "96162ed3-7b19-3933-8797-cbbf384ce1cc",
                                                "text": "Finissez donc, vous êtes bien long."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bf45e0c-3961-31a8-bff0-5b806e4ccced",
                                        "entry_id": "78956a25-26e0-3e60-8526-c7fba78e8a28",
                                        "glosses": [
                                            "Terminer l’action indiquée par le verbe à l’infinitif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62311e2e-b402-40a8-8f4b-f00c4ef10ab8",
                                                "sense_id": "0bf45e0c-3961-31a8-bff0-5b806e4ccced",
                                                "text": "Finir de parler, d’écrire, de jouer, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f92ac1b-0a4b-3165-9bd1-e7ed3131475f",
                                        "entry_id": "78956a25-26e0-3e60-8526-c7fba78e8a28",
                                        "glosses": [
                                            "Cesser des choses trop longues, ennuyeuses, désagréables ou intolérables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dac65632-acc7-4876-bbfe-8e32c7660386",
                                                "sense_id": "2f92ac1b-0a4b-3165-9bd1-e7ed3131475f",
                                                "text": "Nous n’en finirions pas si nous voulions tout rapporter."
                                            },
                                            {
                                                "example_id": "e589b0da-ee5e-4ded-ac60-a61870a7644d",
                                                "sense_id": "2f92ac1b-0a4b-3165-9bd1-e7ed3131475f",
                                                "text": "Cette discussion a trop duré, il est temps d’en finir."
                                            },
                                            {
                                                "example_id": "0d631cfa-7417-4589-816e-8ee271264140",
                                                "sense_id": "2f92ac1b-0a4b-3165-9bd1-e7ed3131475f",
                                                "text": "En finir avec une question."
                                            },
                                            {
                                                "example_id": "c9d40998-f9f5-4e6c-8aab-f1bf7dd19e6e",
                                                "sense_id": "2f92ac1b-0a4b-3165-9bd1-e7ed3131475f",
                                                "text": "En finir avec les rebelles, avec une sédition."
                                            },
                                            {
                                                "example_id": "8bb5971e-7f5d-4b55-8607-b02fad9f9065",
                                                "sense_id": "2f92ac1b-0a4b-3165-9bd1-e7ed3131475f",
                                                "text": "En finir avec un ennemi, le détruire."
                                            },
                                            {
                                                "example_id": "aec90bcf-f4c4-4362-ac67-a7a3bce8ff85",
                                                "sense_id": "2f92ac1b-0a4b-3165-9bd1-e7ed3131475f",
                                                "text": "Je suis pressé d’en finir avec cet homme."
                                            },
                                            {
                                                "example_id": "75426709-ba13-4a9f-888c-dfd4d1dc78d1",
                                                "sense_id": "2f92ac1b-0a4b-3165-9bd1-e7ed3131475f",
                                                "text": "Dès qu’il s’y met, il n’en finit plus."
                                            },
                                            {
                                                "example_id": "f7712548-7f46-4b51-8c6f-6941419f3404",
                                                "sense_id": "2f92ac1b-0a4b-3165-9bd1-e7ed3131475f",
                                                "text": "C’est un homme qui n’en finit jamais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "036816a9-6b06-3f56-9ffc-d241d2a6c0e3",
                                        "entry_id": "78956a25-26e0-3e60-8526-c7fba78e8a28",
                                        "glosses": [
                                            "Se terminer ou être terminé."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab8749a0-9958-4ec4-a965-1bd7276cb6ae",
                                                "sense_id": "036816a9-6b06-3f56-9ffc-d241d2a6c0e3",
                                                "text": "Ce mur finit à tel endroit."
                                            },
                                            {
                                                "example_id": "d9db7968-f596-4b90-b902-770c25d4bc32",
                                                "sense_id": "036816a9-6b06-3f56-9ffc-d241d2a6c0e3",
                                                "text": "C’est là que finit mon champ."
                                            },
                                            {
                                                "example_id": "6ef347d3-fcd3-446b-9d9f-75b98167f58e",
                                                "sense_id": "036816a9-6b06-3f56-9ffc-d241d2a6c0e3",
                                                "text": "Ce mot finit par une voyelle."
                                            },
                                            {
                                                "example_id": "5601b6d3-f3d6-4e1c-b70e-53bea4cf7916",
                                                "sense_id": "036816a9-6b06-3f56-9ffc-d241d2a6c0e3",
                                                "text": "Cela finit en pointe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3270f715-4750-3ec2-a163-05e078f93046",
                                        "entry_id": "78956a25-26e0-3e60-8526-c7fba78e8a28",
                                        "glosses": [
                                            "Prendre fin, arriver à son terme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03847908-9bfd-4ace-b1dc-93a2f6e2ea37",
                                                "sense_id": "3270f715-4750-3ec2-a163-05e078f93046",
                                                "text": "Le sermon finissait."
                                            },
                                            {
                                                "example_id": "a286fbd8-27e8-4fea-80c9-20decbe3b163",
                                                "sense_id": "3270f715-4750-3ec2-a163-05e078f93046",
                                                "text": "Laisse-moi te finir."
                                            },
                                            {
                                                "example_id": "2f81d6ae-4530-4fd0-8d0d-4d049e65efb0",
                                                "sense_id": "3270f715-4750-3ec2-a163-05e078f93046",
                                                "text": "Son bail finira à Pâques."
                                            },
                                            {
                                                "example_id": "013ddf2e-ea2c-4b13-91c0-c6ab4baec17f",
                                                "sense_id": "3270f715-4750-3ec2-a163-05e078f93046",
                                                "text": "Tout finit en ce monde."
                                            },
                                            {
                                                "example_id": "4c62d05e-144f-48d3-8db6-c5a72dc0afe3",
                                                "sense_id": "3270f715-4750-3ec2-a163-05e078f93046",
                                                "text": "Il est temps que cela finisse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d02150e0-84d4-3ff0-ae40-4ab3704d992c",
                                        "entry_id": "78956a25-26e0-3e60-8526-c7fba78e8a28",
                                        "glosses": [
                                            "Avoir une certaine fin ou une certaine issue ; arriver à un certain résultat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7be46a30-b268-4e36-bbdf-01d8a6ffadea",
                                                "sense_id": "d02150e0-84d4-3ff0-ae40-4ab3704d992c",
                                                "text": "Elle a tenu les emplois les plus divers, pour finir dans les vestiaires d’une boîte de nuit."
                                            },
                                            {
                                                "example_id": "dfb10242-621b-4a38-9134-4efedc104603",
                                                "sense_id": "d02150e0-84d4-3ff0-ae40-4ab3704d992c",
                                                "text": "Désormais, pour continuer de se voir, il faut aux amants user de subterfuges. Après tout, il est prêtre, elle est mariée, tous deux savent ou devraient savoir que cela finira mal."
                                            },
                                            {
                                                "example_id": "9e75637a-42f9-48bb-b0eb-13f2f96b35e0",
                                                "sense_id": "d02150e0-84d4-3ff0-ae40-4ab3704d992c",
                                                "text": "– Vous finirez chez Renault !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "517636f7-1f11-37d8-a166-70d41fa29b73",
                                        "entry_id": "78956a25-26e0-3e60-8526-c7fba78e8a28",
                                        "glosses": [
                                            "Mourir."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ad95e55-d729-426c-a26f-fc496b2abe9b",
                                                "sense_id": "517636f7-1f11-37d8-a166-70d41fa29b73",
                                                "text": "Ainsi finit ce prince."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5f23a1f-17c0-3370-a416-de71f35f222e",
                                        "entry_id": "78956a25-26e0-3e60-8526-c7fba78e8a28",
                                        "glosses": [
                                            "Suivi de « par » et d’un infinitif il indique que l’action est le terme ou le résultat de ce qui a précédé. → voir finir par"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee1ab5ab-08fb-4f92-ba74-6e70b89b57fa",
                                                "sense_id": "e5f23a1f-17c0-3370-a416-de71f35f222e",
                                                "text": "[…]; tout le monde dit que la France se dépeuple, qu’il naît de moins en moins d’enfants, et que l’Allemagne, dont la population augmente toujours, finira par avoir deux fois autant de soldats que nous."
                                            },
                                            {
                                                "example_id": "bb779d32-1e19-4543-a4f0-1171a0678669",
                                                "sense_id": "e5f23a1f-17c0-3370-a416-de71f35f222e",
                                                "text": "[…], on lui glisse toujours quelques douceurs. Elle les refuse, puis finit par les accepter pour sa vieille mère : un pot de miel, une paire de grives, une hottée de pommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c79b7cb5-36b8-35aa-a352-230404f5c14b",
                                        "entry_id": "78956a25-26e0-3e60-8526-c7fba78e8a28",
                                        "glosses": [
                                            "Assouvir un désir jusqu’à l’épuisement et l’oubli."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f920c02b-5453-436c-8c84-e0d0523e4888",
                                                "sense_id": "c79b7cb5-36b8-35aa-a352-230404f5c14b",
                                                "text": "[…] se finir au whisky dans les bras d’un clochard ou qui sait du Prince Charmant sur son beau cheval blanc ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0b203e4-41c4-3db1-af0b-602292bec6b3",
                                        "entry_id": "78956a25-26e0-3e60-8526-c7fba78e8a28",
                                        "glosses": [
                                            "Jouir, avoir un orgasme jusqu’à atteindre la période réfractaire, éjaculer."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb500bc3-c8db-41ad-a4a2-10f7c51e6bf4",
                                                "sense_id": "c0b203e4-41c4-3db1-af0b-602292bec6b3",
                                                "text": "Est-ce que tu as fini ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
