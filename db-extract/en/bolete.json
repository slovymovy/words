                                "target_senses": [
                                    {
                                        "sense_id": "1f1c6a74-8528-3c09-bc41-251986162630",
                                        "entry_id": "1a0ced38-20f1-3996-afa7-03a440dcbaff",
                                        "glosses": [
                                            "Champignon à tubes séparables du chapeau, dont les orifices ressemblent à des pores, et à chair non coriace comme celle des polypores."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6ca0f61-a9b5-48c4-936f-2641d62ad32e",
                                                "sense_id": "1f1c6a74-8528-3c09-bc41-251986162630",
                                                "text": "Comme il avait plu, Grand Jo, un panier à la main, cherchait des champignons et apprenait à son neveu à distinguer le vrai cèpe du faux, et le bolet bronzé, qui est excellent, du bolet de Satan qui est dangereux."
                                            },
                                            {
                                                "example_id": "f1503621-0e25-4051-abd5-4b4a4cf8bb0e",
                                                "sense_id": "1f1c6a74-8528-3c09-bc41-251986162630",
                                                "text": "L’arrière-saison prolongeait l’éclosion tardive des bolets, des russules « jolies », des tricholomes bleus."
                                            },
                                            {
                                                "example_id": "ec036ead-05fb-4695-82f0-5a209bd6428d",
                                                "sense_id": "1f1c6a74-8528-3c09-bc41-251986162630",
                                                "text": "Sire ! Des bolets, sire. À ce prix-là, j'en prends combien ?"
                                            },
                                            {
                                                "example_id": "398d1aa0-7a4d-4ed3-91f7-1296e9e1898d",
                                                "sense_id": "1f1c6a74-8528-3c09-bc41-251986162630",
                                                "text": "À toi : un bouillon d’orignal ;\ndu caribou et ses effluves de lichen ; des bolets\ngrands comme nos visages ;\ndes herbes pour les tisanes, de l’épilobe baignée\ndans l’eau de la source ;\ndes choses simples, des choses vivantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
