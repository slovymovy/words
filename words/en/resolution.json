{
    "word_family": [
        "resolve",
        "resolute",
        "resolutely",
        "resoluteness",
        "unresolved"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c455fc2f-40ac-34c4-9db4-5515cd120f95",
                    "sense_definition": "A firm decision to do or not to do something, often made at the beginning of a new year.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "decision_intent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My New Year's <w>resolution</w> is to learn how to play the guitar.",
                            "target_lang_translations": {
                                "ru": "Моё новогоднее <w>обещание</w> — научиться играть на гитаре.",
                                "pl": "Moim noworocznym <w>postanowieniem</w> jest nauka gry na gitarze."
                            }
                        },
                        {
                            "text": "She made a <w>resolution</w> to eat healthier food this year.",
                            "target_lang_translations": {
                                "ru": "Она приняла <w>решение</w> питаться более здоровой пищей в этом году.",
                                "pl": "Podjęła <w>postanowienie</w>, że w tym roku będzie jeść zdrowiej."
                            }
                        }
                    ],
                    "common_phrases": [
                        "New Year's resolution",
                        "make a resolution",
                        "keep a resolution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твёрдое решение сделать или не делать что-либо, часто принимаемое в начале нового года",
                        "pl": "Mocne postanowienie zrobienia czegoś lub zrezygnowania z czegoś, często podejmowane na początku nowego roku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решение",
                                "target_lang_sense_clarification": "намерение, замысел"
                            },
                            {
                                "target_lang_word": "обещание",
                                "target_lang_sense_clarification": "в контексте новогодних обещаний"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "postanowienie",
                                "target_lang_sense_clarification": "zamiar, decyzja"
                            },
                            {
                                "target_lang_word": "decyzja",
                                "target_lang_sense_clarification": "wybór działania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42365fba-6b65-3337-8fe7-6bb7b1262306",
                    "sense_definition": "The amount of detail that an image or screen shows, often measured by the number of pixels.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "technical_detail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This camera captures photos in very high <w>resolution</w>.",
                            "target_lang_translations": {
                                "ru": "Эта камера делает снимки в очень высоком <w>разрешении</w>.",
                                "pl": "Ten aparat robi zdjęcia w bardzo wysokiej <w>rozdzielczości</w>."
                            }
                        },
                        {
                            "text": "You might need to lower the screen <w>resolution</w> to make the text larger.",
                            "target_lang_translations": {
                                "ru": "Возможно, вам придётся уменьшить <w>разрешение</w> экрана, чтобы сделать текст крупнее.",
                                "pl": "Może być konieczne zmniejszenie <w>rozdzielczości</w> ekranu, aby powiększyć tekst."
                            }
                        }
                    ],
                    "common_phrases": [
                        "high resolution",
                        "screen resolution",
                        "low resolution",
                        "4K resolution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Степень детализации изображения или экрана, часто измеряемая количеством пикселей",
                        "pl": "Stopień szczegółowości obrazu lub ekranu, często mierzony liczbą pikseli."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрешение",
                                "target_lang_sense_clarification": "экрана, изображения"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rozdzielczość",
                                "target_lang_sense_clarification": "ekranu, obrazu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a54e1407-3dd7-3d9c-b398-bf7b58e7ebfc",
                    "sense_definition": "The act of finding an answer or solution to a conflict, problem, or dispute.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "solving_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are hoping for a peaceful <w>resolution</w> to the crisis.",
                            "target_lang_translations": {
                                "ru": "Мы надеемся на мирное <w>разрешение</w> кризиса.",
                                "pl": "Mamy nadzieję na pokojowe <w>rozwiązanie</w> kryzysu."
                            }
                        },
                        {
                            "text": "The <w>resolution</w> of the technical issue took longer than expected.",
                            "target_lang_translations": {
                                "ru": "<w>Решение</w> технической проблемы заняло больше времени, чем ожидалось.",
                                "pl": "<w>Rozwiązanie</w> problemu technicznego zajęło więcej czasu, niż się spodziewano."
                            }
                        }
                    ],
                    "synonyms": [
                        "solution"
                    ],
                    "common_phrases": [
                        "conflict resolution",
                        "dispute resolution",
                        "speedy resolution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс поиска ответа или решения конфликта, проблемы или спора",
                        "pl": "Akt znalezienia odpowiedzi lub rozwiązania konfliktu, problemu lub sporu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрешение",
                                "target_lang_sense_clarification": "конфликта, спора"
                            },
                            {
                                "target_lang_word": "урегулирование",
                                "target_lang_sense_clarification": "кризиса, ситуации"
                            },
                            {
                                "target_lang_word": "решение",
                                "target_lang_sense_clarification": "проблемы, задачи"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rozwiązanie",
                                "target_lang_sense_clarification": "problemu, zagadki"
                            },
                            {
                                "target_lang_word": "rozstrzygnięcie",
                                "target_lang_sense_clarification": "sporu, konfliktu"
                            },
                            {
                                "target_lang_word": "uregulowanie",
                                "target_lang_sense_clarification": "sytuacji, kryzysu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2700158b-7551-361b-b375-ba7b30032c71",
                    "sense_definition": "A formal statement of opinion or intention agreed on by a legislative body or other formal meeting.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "decision_intent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee passed a <w>resolution</w> to increase funding for the project.",
                            "target_lang_translations": {
                                "ru": "Комитет принял <w>резолюцию</w> об увеличении финансирования проекта.",
                                "pl": "Komisja przyjęła <w>uchwałę</w> o zwiększeniu finansowania projektu."
                            }
                        },
                        {
                            "text": "The United Nations adopted a <w>resolution</w> calling for an immediate ceasefire.",
                            "target_lang_translations": {
                                "ru": "Организация Объединённых Наций приняла <w>резолюцию</w>, призывающую к немедленному прекращению огня.",
                                "pl": "Organizacja Narodów Zjednoczonych przyjęła <w>rezolucję</w> wzywającą do natychmiastowego zawieszenia broni."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruling"
                    ],
                    "common_phrases": [
                        "pass a resolution",
                        "adopt a resolution",
                        "draft resolution",
                        "joint resolution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное заявление о мнении или намерении, принятое законодательным органом или на официальном собрании",
                        "pl": "Oficjalne oświadczenie o opinii lub zamiarze uzgodnione przez organ ustawodawczy lub inne formalne zgromadzenie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резолюция",
                                "target_lang_sense_clarification": "официальный документ"
                            },
                            {
                                "target_lang_word": "постановление",
                                "target_lang_sense_clarification": "решение органа власти"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rezolucja",
                                "target_lang_sense_clarification": "oficjalny dokument"
                            },
                            {
                                "target_lang_word": "uchwała",
                                "target_lang_sense_clarification": "akt woli organu"
                            },
                            {
                                "target_lang_word": "postanowienie",
                                "target_lang_sense_clarification": "orzeczenie proceduralne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45e23900-368f-37b9-a649-cc8b590387c8",
                    "sense_definition": "The quality of being determined or having a strong will.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "character_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pursued his goals with great <w>resolution</w> despite the obstacles.",
                            "target_lang_translations": {
                                "ru": "Он преследовал свои цели с огромной <w>решимостью</w>, несмотря на препятствия.",
                                "pl": "Dążył do swoich celów z wielką <w>stanowczością</w> pomimo przeszkód."
                            }
                        },
                        {
                            "text": "Her <w>resolution</w> to finish the marathon never wavered.",
                            "target_lang_translations": {
                                "ru": "Её <w>решимость</w> завершить марафон никогда не колебалась.",
                                "pl": "Jej <w>determinacja</w>, by ukończyć maraton, nigdy nie osłabła."
                            }
                        }
                    ],
                    "synonyms": [
                        "determination",
                        "resolve",
                        "tenacity",
                        "steadfastness",
                        "conviction"
                    ],
                    "common_phrases": [
                        "waver in resolution",
                        "show resolution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество, характеризующееся целеустремлённостью или сильной волей",
                        "pl": "Cecha bycia zdeterminowanym lub posiadania silnej woli."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решимость",
                                "target_lang_sense_clarification": "готовность к действию"
                            },
                            {
                                "target_lang_word": "решительность",
                                "target_lang_sense_clarification": "свойство характера"
                            },
                            {
                                "target_lang_word": "твёрдость",
                                "target_lang_sense_clarification": "непоколебимость"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rezygnacja",
                                "target_lang_sense_clarification": "gotowość do działania"
                            },
                            {
                                "target_lang_word": "stanowczość",
                                "target_lang_sense_clarification": "cecha charakteru"
                            },
                            {
                                "target_lang_word": "determinacja",
                                "target_lang_sense_clarification": "silna wola"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdeabb2e-8db9-390f-9a01-83c515f122ad",
                    "sense_definition": "The part of a story, play, or movie where the plot is resolved and the conflict ends.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "narrative_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel's <w>resolution</w> left many readers with unanswered questions.",
                            "target_lang_translations": {
                                "ru": "<w>Развязка</w> романа оставила у многих читателей вопросы без ответов.",
                                "pl": "<w>Rozwiązanie</w> akcji powieści pozostawiło wielu czytelników z pytaniami bez odpowiedzi."
                            }
                        },
                        {
                            "text": "I enjoyed the buildup of the movie, but the <w>resolution</w> felt rushed.",
                            "target_lang_translations": {
                                "ru": "Мне понравилось развитие сюжета фильма, но <w>развязка</w> показалась скомканной.",
                                "pl": "Podobało mi się budowanie napięcia w filmie, ale <w>rozwiązanie</w> wydawało się pospieszne."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plot resolution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть рассказа, пьесы или фильма, где разрешается сюжет и заканчивается конфликт",
                        "pl": "Część opowiadania, sztuki lub filmu, w której fabuła zostaje wyjaśona, a konflikt kończy się."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развязка",
                                "target_lang_sense_clarification": "сюжета"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rozwiązanie",
                                "target_lang_sense_clarification": "akcji, fabuły"
                            },
                            {
                                "target_lang_word": "rozwiązanie akcji",
                                "target_lang_sense_clarification": "struktura narracyjna"
                            }
                        ]
                    }
                }
            ]
        }
