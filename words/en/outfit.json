{
    "word_family": [
        "outfitter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d8be03fb-6128-3b58-82df-bdfe33ed8483",
                    "sense_definition": "A set of clothes worn together, usually for a specific occasion or purpose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing_set",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a fashionable new <w>outfit</w> for the wedding.",
                            "target_lang_translations": {
                                "ru": "Она купила модный новый <w>наряд</w> на свадьбу.",
                                "pl": "Kupiła modny nowy <w>strój</w> na wesele.",
                                "zh": "她为婚礼买了一套时髦的新<w>服装</w>。"
                            }
                        },
                        {
                            "text": "He decided to wear a casual <w>outfit</w> to the party.",
                            "target_lang_translations": {
                                "ru": "Он решил надеть на вечеринку повседневный <w>наряд</w>.",
                                "pl": "Zdecydował się założyć na imprezę swobodny <w>ubiór</w>.",
                                "zh": "他决定穿一套休闲的<w>行头</w>去参加派对。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clothes"
                    ],
                    "common_phrases": [
                        "wear an outfit",
                        "matching outfit",
                        "whole outfit",
                        "expensive outfit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Комплект одежды, который носят вместе, обычно для определенного случая или цели.",
                        "pl": "Zestaw ubrań noszonych razem, zazwyczaj na konkretną okazję lub w określonym celu.",
                        "zh": "一套搭配在一起穿的衣服，通常是为了特定的场合或目的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наряд",
                                "target_lang_sense_clarification": "одежда, костюм, обычно праздничная"
                            },
                            {
                                "target_lang_word": "костюм",
                                "target_lang_sense_clarification": "комплект верхней одежды"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ubiór",
                                "target_lang_sense_clarification": "elementy nakładane na ciało"
                            },
                            {
                                "target_lang_word": "strój",
                                "target_lang_sense_clarification": "komplet ubrań na daną okazję"
                            },
                            {
                                "target_lang_word": "kreacja",
                                "target_lang_sense_clarification": "elegancki ubiór, zazwyczaj kobiecy"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "服装",
                                "target_lang_sense_clarification": "指整体的穿着打扮"
                            },
                            {
                                "target_lang_word": "行头",
                                "target_lang_sense_clarification": "指一套完整的装束，常用于口语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9364ab77-5b61-34aa-8cce-abb4bb474f1f",
                    "sense_definition": "A business company, firm, or organization.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He works for a small construction <w>outfit</w> in the city.",
                            "target_lang_translations": {
                                "ru": "Он работает в небольшой строительной <w>фирме</w> в городе.",
                                "pl": "Pracuje w małej <w>firmie</w> budowlanej w mieście.",
                                "zh": "他在城里的一家小型建筑<w>公司</w>工作。"
                            }
                        },
                        {
                            "text": "They are a professional <w>outfit</w> that always delivers on time.",
                            "target_lang_translations": {
                                "ru": "Это профессиональная <w>компания</w>, которая всегда выполняет работу вовремя.",
                                "pl": "To profesjonalna <w>ekipa</w>, która zawsze dostarcza wszystko na czas.",
                                "zh": "他们是一个专业的<w>团队</w>，总是能按时交付。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "small outfit",
                        "professional outfit",
                        "run an outfit"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe a business informally"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Коммерческая компания, фирма или организация.",
                        "pl": "Przedsiębiorstwo, firma lub organizacja.",
                        "zh": "商业公司、企业或组织。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компания",
                                "target_lang_sense_clarification": "коммерческое предприятие"
                            },
                            {
                                "target_lang_word": "фирма",
                                "target_lang_sense_clarification": "предприятие, организация"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "firma",
                                "target_lang_sense_clarification": "przedsiębiorstwo"
                            },
                            {
                                "target_lang_word": "interes",
                                "target_lang_sense_clarification": "potocznie o działalności gospodarczej"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公司",
                                "target_lang_sense_clarification": "商业经营实体"
                            },
                            {
                                "target_lang_word": "机构",
                                "target_lang_sense_clarification": "指某种组织或团体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d311f768-c527-3a46-bedc-50d5348e816c",
                    "sense_definition": "A cohesive group of people working together as a unit, such as a military unit or a sports team.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers in that <w>outfit</w> were known for their bravery.",
                            "target_lang_translations": {
                                "ru": "Солдаты этого <w>подразделения</w> славились своей храбростью.",
                                "pl": "Żołnierze z tej <w>jednostki</w> byli znani ze swojego męstwa.",
                                "zh": "那个<w>部队</w>的士兵以勇敢著称。"
                            }
                        },
                        {
                            "text": "The visiting <w>outfit</w> played a defensive game against the home team.",
                            "target_lang_translations": {
                                "ru": "Приезжая <w>команда</w> играла от обороны против хозяев поля.",
                                "pl": "Przyjezdny <w>zespół</w> zagrał defensywnie przeciwko gospodarzom.",
                                "zh": "客队在对阵主队时采取了防守策略，这支<w>队伍</w>表现得很稳健。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "military outfit",
                        "entire outfit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сплоченная группа людей, работающих как единое целое, например, воинское подразделение или спортивная команда.",
                        "pl": "Zgrana grupa ludzi pracujących razem jako jednostka, np. oddział wojskowy lub drużyna sportowa.",
                        "zh": "一个作为一个整体协同工作的紧密群体，例如军事单位或运动队。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подразделение",
                                "target_lang_sense_clarification": "воинская единица"
                            },
                            {
                                "target_lang_word": "команда",
                                "target_lang_sense_clarification": "спортивный коллектив"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ekipa",
                                "target_lang_sense_clarification": "zespół ludzi mający zadanie do wykonania"
                            },
                            {
                                "target_lang_word": "zespół",
                                "target_lang_sense_clarification": "grupa osób realizująca wspólny cel"
                            },
                            {
                                "target_lang_word": "jednostka",
                                "target_lang_sense_clarification": "oddział wojskowy"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "队伍",
                                "target_lang_sense_clarification": "指有组织的集体"
                            },
                            {
                                "target_lang_word": "单位",
                                "target_lang_sense_clarification": "指特定的组织或部门"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca6ce33b-aef5-3396-b9bb-1ef00672d3ef",
                    "sense_definition": "A set of tools, articles, or equipment needed for a specific purpose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing_set",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He keeps a puncture repair <w>outfit</w> in his bicycle bag.",
                            "target_lang_translations": {
                                "ru": "Он держит <w>набор</w> для ремонта проколов в своей велосипедной сумке.",
                                "pl": "W torbie rowerowej trzyma <w>zestaw</w> do naprawy dętek.",
                                "zh": "他在自行车包里放了一套补胎<w>工具</w>。"
                            }
                        },
                        {
                            "text": "The camping <w>outfit</w> included a tent, sleeping bags, and cooking gear.",
                            "target_lang_translations": {
                                "ru": "Походное <w>снаряжение</w> включало палатку, спальные мешки и кухонную утварь.",
                                "pl": "W skład <w>ekwipunku</w> kempingowego wchodził namiot, śpiwory i sprzęt do gotowania.",
                                "zh": "这套露营<w>装备</w>包括帐篷、睡袋和炊具。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "repair outfit",
                        "camping outfit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор инструментов, предметов или оборудования, необходимых для определенной цели.",
                        "pl": "Zestaw narzędzi, artykułów lub sprzętu potrzebnego do określonego celu.",
                        "zh": "为特定目的所需的一套工具、物品或设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снаряжение",
                                "target_lang_sense_clarification": "совокупность предметов для чего-либо"
                            },
                            {
                                "target_lang_word": "экипировка",
                                "target_lang_sense_clarification": "снаряжение, обмундирование"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zestaw",
                                "target_lang_sense_clarification": "komplet narzędzi lub przyborów"
                            },
                            {
                                "target_lang_word": "ekwipunek",
                                "target_lang_sense_clarification": "wyposażenie potrzebne na wyprawę"
                            },
                            {
                                "target_lang_word": "sprzęt",
                                "target_lang_sense_clarification": "urządzenia lub akcesoria do konkretnej czynności"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装备",
                                "target_lang_sense_clarification": "指进行某项活动所需的成套器材"
                            },
                            {
                                "target_lang_word": "工具包",
                                "target_lang_sense_clarification": "指成套的工具"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "15a66150-358c-3b3c-8838-c6f4fc6485ce",
                    "sense_definition": "To provide someone or something with necessary equipment or clothing for a specific purpose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "to_equip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The expedition was <w>outfitted</w> with the latest navigation technology.",
                            "target_lang_translations": {
                                "ru": "Экспедиция была <w>снаряжена</w> новейшими навигационными технологиями.",
                                "pl": "Ekspedycja została <w>wyposażona</w> w najnowszą technologię nawigacyjną.",
                                "zh": "探险队<w>配备</w>了最新的导航技术。"
                            }
                        },
                        {
                            "text": "The store can <w>outfit</w> you with everything you need for the ski trip.",
                            "target_lang_translations": {
                                "ru": "В этом магазине вас могут <w>экипировать</w> всем необходимым для лыжной поездки.",
                                "pl": "Sklep może cię <w>ekwipować</w> we wszystko, czego potrzebujesz na wyjazd narciarski.",
                                "zh": "这家店可以为你<w>装备</w>好滑雪旅行所需的一切。"
                            }
                        }
                    ],
                    "synonyms": [
                        "equip",
                        "fit"
                    ],
                    "common_phrases": [
                        "outfit with",
                        "fully outfitted"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабжать кого-либо или что-либо необходимым оборудованием или одеждой для определенной цели.",
                        "pl": "Zapewnienie komuś lub czemuś niezbędnego sprzętu lub odzieży do określonego celu.",
                        "zh": "为某人或某物提供特定目的所需的必要设备或服装。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снаряжать",
                                "target_lang_sense_clarification": "снабжать всем необходимым"
                            },
                            {
                                "target_lang_word": "экипировать",
                                "target_lang_sense_clarification": "снабжать снаряжением"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wyposażyć",
                                "target_lang_sense_clarification": "zaopatrzyć w potrzebne rzeczy"
                            },
                            {
                                "target_lang_word": "ekwipować",
                                "target_lang_sense_clarification": "dostarczyć rynsztunek lub sprzęt"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "配备",
                                "target_lang_sense_clarification": "指提供必要的设备"
                            },
                            {
                                "target_lang_word": "装备",
                                "target_lang_sense_clarification": "指提供器材或服装"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}