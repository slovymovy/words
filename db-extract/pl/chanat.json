                                        "examples": [
                                            {
                                                "example_id": "074d4344-736a-417a-848f-03f35d243583",
                                                "sense_id": "00b49ec2-d2db-34e2-92c0-126553f3b9c5",
                                                "text": "V roce 1475 se Krymský chanát stal oficiálně vazalem Osmanské říše."
                                            }
                                        ]
                                    }
                                ]
