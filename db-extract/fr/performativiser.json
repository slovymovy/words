                "senses": [
                    {
                        "sense_id": "f62d5587-5e12-3ee4-9e96-23d0ce810e79",
                        "entry_id": "dab246b1-8d55-3595-acfd-5d097f78d0f1",
                        "glosses": [
                            "Donner un caractère performatif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f24462b-60ae-4ecc-af68-bf950a42d70a",
                                "sense_id": "f62d5587-5e12-3ee4-9e96-23d0ce810e79",
                                "text": "La force émotive est en fait la force qui anime la performance, et mettre en œuvre la force émotive, c’est performativiser le texte, l’énoncé, le terme ou le syntagme."
                            }
                        ]
                    },
                    {
                        "sense_id": "48243b54-5d90-36fa-bf2a-56d1167f80da",
                        "entry_id": "dab246b1-8d55-3595-acfd-5d097f78d0f1",
                        "glosses": [
                            "Donner un caractère performant à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3d9867f-1cbf-449c-be61-123671fbb20e",
                                "sense_id": "48243b54-5d90-36fa-bf2a-56d1167f80da",
                                "text": "Birdwinstell, Hall ou Bateson partent comme Goffman de l’idée que les individus, plus que de produire la communication y participent et qu’un individu devient membre d’un groupe ou d’une société au moment où il commence à être prévisible et capable de performativiser la culture à travers ses faits et gestes."
                            }
                        ]
                    }
                ],
