                    {
                        "sense_id": "a528f818-c618-36c7-825e-2a02b8713562",
                        "entry_id": "82959169-c657-394f-bece-9e2d8a72420e",
                        "glosses": [
                            "Grès rouge du Trias utilisé pour la construction de maisons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91b4af48-b156-4a1f-af19-f707d48ceeaa",
                                "sense_id": "a528f818-c618-36c7-825e-2a02b8713562",
                                "text": "Les maisons en brownstone (grès rouge) de l’Upper West Side aux cast iron buildings (bâtiments en fonte) de SoHo, en passant par les folies Art déco de Miami Beach, Tony Goldman a laissé son empreinte de restaurateur à New York comme en Floride."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bb06a73-d1f1-361f-86c2-548a57f4fc6d",
                        "entry_id": "82959169-c657-394f-bece-9e2d8a72420e",
                        "glosses": [
                            "Maison construite avec cette pierre, en particulier à New York."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "444842bc-2e3a-4f9c-a512-bacf649c4899",
                                "sense_id": "1bb06a73-d1f1-361f-86c2-548a57f4fc6d",
                                "text": "C’était l’un de ces brownstones construits à la fin du XIXᵉ siècle, avec une façade de pierres brunes et un joli jardin."
                            }
                        ]
                    },
                    {
                        "sense_id": "84cebf2e-67f4-364a-b7c2-6743a72f8a3a",
                        "entry_id": "82959169-c657-394f-bece-9e2d8a72420e",
                        "glosses": [
                            "Maison en bord de rue et accolée aux maisons voisines."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2ec70c61-e6d6-4e60-9170-467dcb004f83",
                                "sense_id": "84cebf2e-67f4-364a-b7c2-6743a72f8a3a",
                                "text": "L’un des avantages de la possession d’un brownstone est certainement la réduction de l’impôt foncier, car les maisons de un à trois logements appartiennent à une classe d’imposition différente de celle des condos et des coopératives."
                            }
                        ]
                    }
                ],
                "translations": [
