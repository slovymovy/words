                        ],
                        "examples": [
                            {
                                "example_id": "5a3ac081-2667-4f59-9323-381d9f7b1d4d",
                                "sense_id": "8e42201b-8507-3a69-b1c5-374a31c52ace",
                                "text": "Le dimanche à la gaguère, le clairin à la cannelle, au citron ou à l’anis, montait vite à la tête des habitants, surtout des perdants, et il y eut des cas où les bâtons se mirent de la partie ; grâce à Dieu, ça n’allait pas plus loin, pas jusqu’à la machette, heureusement et quelques jours plus tard on se réconciliait, mais ce n’était pas tellement sûr qu’on ne gardait pas au fond de soi un restant de rancune tenace…"
                            }
                        ]
                    }
