                        "form": "почи́в"
                    },
                    {
                        "form_id": "eb2483f1-36a5-4a3c-ba15-45e06fd40eed",
                        "entry_id": "f0395d57-0346-3203-bfc0-5902e9d1cdf2",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "почи́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2fd884b2-87e6-358a-8c6e-f2a0a50efaf0",
                        "entry_id": "f0395d57-0346-3203-bfc0-5902e9d1cdf2",
                        "glosses": [
                            "книжн. ритор. устар. успокоиться, предаться полному покою, бездействию, погрузиться в покой; прекратиться, стихнуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5ed1300-089b-415a-aed6-eb22e053afbf",
                                "sense_id": "2fd884b2-87e6-358a-8c6e-f2a0a50efaf0",
                                "text": "Почить от дел."
                            },
                            {
                                "example_id": "5d544366-63e9-4766-bbf5-3514028ab70b",
                                "sense_id": "2fd884b2-87e6-358a-8c6e-f2a0a50efaf0",
                                "text": "Почить на лаврах."
                            },
                            {
                                "example_id": "892cda0a-d7ac-40f1-99fc-f465279479f9",
                                "sense_id": "2fd884b2-87e6-358a-8c6e-f2a0a50efaf0",
                                "text": "Над урной, где твой прах лежит, народов ненависть почила."
                            },
                            {
                                "example_id": "49868e27-703d-4719-bdc3-a9a9b564cd6b",
                                "sense_id": "2fd884b2-87e6-358a-8c6e-f2a0a50efaf0",
                                "text": "Здесь почиет в мире сладострастия мудрец."
                            },
                            {
                                "example_id": "1db1b610-31bf-402e-b2e2-1968ac98db8c",
                                "sense_id": "2fd884b2-87e6-358a-8c6e-f2a0a50efaf0",
                                "text": "Почиет в мире Теодорих и Дант не встанет с ложа сна."
                            },
                            {
                                "example_id": "c48489ad-edd3-4458-a522-afec9ffd93e2",
                                "sense_id": "2fd884b2-87e6-358a-8c6e-f2a0a50efaf0",
                                "text": "— Почий среди пустынных волн! Великолепная могила!"
                            }
                        ]
                    },
                    {
                        "sense_id": "c079f2f2-da61-39fe-9326-c071a926881a",
                        "entry_id": "f0395d57-0346-3203-bfc0-5902e9d1cdf2",
                        "glosses": [
                            "уснуть"
                        ],
                        "tags": [
                            "со словом «сном» и без него"
                        ],
                        "examples": [
                            {
                                "example_id": "45ccb63d-31f7-4196-8182-cd1716339f18",
                                "sense_id": "c079f2f2-da61-39fe-9326-c071a926881a",
                                "text": "Почил тихим сном."
                            }
                        ]
                    },
                    {
                        "sense_id": "a72ad934-c490-3ce5-ae25-056ebe7fa1dd",
                        "entry_id": "f0395d57-0346-3203-bfc0-5902e9d1cdf2",
                        "glosses": [
                            "умереть"
                        ],
                        "tags": [
                            "со словами «смертным сном» и т. п. и без них"
                        ],
                        "examples": [
                            {
                                "example_id": "13a01724-46c0-468d-9b36-cdf6fec64d6f",
                                "sense_id": "a72ad934-c490-3ce5-ae25-056ebe7fa1dd",
                                "text": "Там угасал Наполеон, там он почил среди мучений."
                            },
                            {
                                "example_id": "54704685-09d0-449d-a842-cf39ddb59a45",
                                "sense_id": "a72ad934-c490-3ce5-ae25-056ebe7fa1dd",
                                "text": "Давно уж почил непробудным он сном."
                            }
                        ]
                    }
                ],
