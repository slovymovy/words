                        "source_entry_id": "060b8c1e-f165-37fe-a5ab-2dd065c79bd6",
                        "source_sense_id": "d2977dcd-fe3f-3fe0-b760-7ded3e0d1bf1",
                        "source_sense_description": "Medizin: Krankheit, bei der sich das Immunsystem gegen den eigenen Körper richtet",
                        "target_lang_word": "autoimmune disease",
                        "target_lang_code": "en",
