                "senses": [
                    {
                        "sense_id": "d7cca5df-166d-3cf5-a765-d1ca1b16cbe9",
                        "entry_id": "e5b7ce00-7950-3341-9b31-bbd82d904c19",
                        "glosses": [
                            "Art und Weise, wie amtliche oder rechtliche Schriftstücke verfasst werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb1c5d2d-4cfb-4d09-b621-e86dd3b417f8",
                                "sense_id": "d7cca5df-166d-3cf5-a765-d1ca1b16cbe9",
                                "text": "„Auf diese Weise bildete sich ein deutscher Kanzleistil heraus, der die getreue Nachahmung des lateinischen war: zu Recht nach Überzeugung der Humanisten, war doch für sie der einzige Weg, die deutsche Sprache zu heben, die genaue Nachahmung der lateinischen.“"
                            },
                            {
                                "example_id": "3f5675e1-d310-421d-8ec0-05eb5e54d2da",
                                "sense_id": "d7cca5df-166d-3cf5-a765-d1ca1b16cbe9",
                                "text": "„So ist der Stil, aber es ist keiner, den etwa ein diplomatisches Protokollbuch vorgibt, und auch kein Kanzleistil, wie ihn Wieland zu Biberach zu schreiben (und sich in ihn einzugewöhnen) hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
