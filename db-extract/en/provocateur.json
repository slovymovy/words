                            {
                                "example_id": "959623a7-e02a-4bd6-8ee4-187bb48ed623",
                                "sense_id": "31eb73e4-77d5-31a8-997e-5d8e20aae3c4",
                                "text": "Gerard Mortier, an iconoclastic impresario and one of the opera world’s premier provocateurs, will become general manager and artistic director of the New York City Opera in 2009."
                            },
                            {
                                "example_id": "41df3a39-f491-402d-8ef6-2c8efba51f3a",
                                "sense_id": "31eb73e4-77d5-31a8-997e-5d8e20aae3c4",
                                "text": "Cannes is smacking its lips in anticipation of filmmaker and provocateur Michael Moore's latest jeremiad against the US administration, which receives its premiere at the film festival today."
                            }
                        ]
                    },
