                                    {
                                        "sense_id": "83d0f64e-dae3-3611-867e-d4c71ed628db",
                                        "entry_id": "cac19b8f-dd8d-3c07-890b-ceed807182a6",
                                        "glosses": [
                                            "One who gulps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95dd9806-ed3e-4af3-8ff1-62b3a50cc79e",
                                                "sense_id": "83d0f64e-dae3-3611-867e-d4c71ed628db",
                                                "text": "Believers in Fletcher's system were anything but quick shovelers and gulpers of food."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "371467b5-e350-3e81-93f4-b13159f0ecf8",
                                        "entry_id": "cac19b8f-dd8d-3c07-890b-ceed807182a6",
                                        "glosses": [
                                            "A gulper eel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ceb2a876-9de6-4988-acce-f75abf03e0c7",
                        "source_entry_id": "cdb17441-9c62-3a00-a958-d85744cbf0a6",
                        "source_sense_id": "f3631d6e-d720-359e-b6af-665593647baf",
                        "source_sense_description": "crédule",
                        "target_lang_word": "gullible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gullible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2e71207-e0e0-3857-9f69-e326c4fda75f",
                                        "entry_id": "e45ee3f8-21a2-3434-a4e6-2b249dea2b25",
                                        "glosses": [
                                            "Easily deceived or duped; naive, easily cheated or fooled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a110d8fd-9f8d-476d-82b7-8ed8b1697759",
                                                "sense_id": "f2e71207-e0e0-3857-9f69-e326c4fda75f",
                                                "text": "Andrew is so gullible, the way he still believes in Santa Claus, the Easter Bunny, the Tooth Fairy, and the Sandman at the age of fourteen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gullible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da8f3d64-50fe-38a1-8a32-e4c4c7ad6538",
                                        "entry_id": "37c14882-ba0d-36a0-b21e-4a1ac7c1f4ed",
                                        "glosses": [
                                            "A gullible person; someone easily fooled or tricked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2511c913-67fa-467a-b129-5a25c191f72f",
                                                "sense_id": "da8f3d64-50fe-38a1-8a32-e4c4c7ad6538",
                                                "text": "They pictured to these gullibles the unearthly delights that were to be enjoyed as servants of the Spaniards. But such tricks could not last, for Cuba was too close to Saint Domingue, and news of the real conditions leaked across the windward passage and were bruited about."
                                            },
                                            {
                                                "example_id": "b73fc4c9-6c68-4678-a1eb-aefed1cc04d2",
                                                "sense_id": "da8f3d64-50fe-38a1-8a32-e4c4c7ad6538",
                                                "text": "Spurious accounts that snare the gullible are readily available. Skeptical treatments are much harder to find."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
