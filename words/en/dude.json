                {
                    "sense_id": "ceafdb85-fcc3-3ad4-b750-57175ebf474a",
                    "sense_definition": "To take a vacation at a dude ranch.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family went <w>duding</w> in Montana last summer.",
                            "target_lang_translations": {
                                "ru": "Прошлым летом семья ездила <w>отдыхать на ранчо</w> в Монтане.",
                                "zh": "去年夏天，这家人去蒙大拿州的牧场<w>度假</w>了。"
                            }
                        },
                        {
                            "text": "He enjoys <w>duding</w> because he loves riding horses.",
                            "target_lang_translations": {
                                "ru": "Ему нравится <w>отдых на ранчо</w>, потому что он любит кататься на лошадях.",
                                "zh": "他很喜欢去<w>牧场度假</w>，因为他热爱骑马。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US West"
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить отпуск на туристическом ранчо.",
                        "zh": "在度假牧场度假。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдыхать на ранчо",
                                "target_lang_sense_clarification": "описательный перевод"
