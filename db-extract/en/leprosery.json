                        "entry_id": "5831ab6b-44a1-305a-af18-50af9a969194",
                        "glosses": [
                            "A building used to house lepers, usually in permanent quarantine from the rest of society."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8e68565-77ec-4d75-9fb1-445fb27e4e88",
                                "sense_id": "46bf88d3-94ca-3825-a9be-9a624926f1b2",
                                "text": "Lewis VIII, king of France, made bequests in the year 1227 to two thousand Leprosaries within his own dominions."
                            },
                            {
                                "example_id": "65e9265b-c904-4a7a-aa8c-f92b0a89c9d9",
                                "sense_id": "46bf88d3-94ca-3825-a9be-9a624926f1b2",
                                "text": "There was a rule that the leproserie should take contagious cases only."
                            }
                        ]
                    }
