                "senses": [
                    {
                        "sense_id": "f824067b-446f-3818-94a3-297dc93e2b84",
                        "entry_id": "23d4efac-e20e-3d59-bf92-47bcdc6a5a29",
                        "glosses": [
                            "merkwürdiger Vorfall"
                        ],
                        "tags": [
                            "veraltet oder altertümelnd"
                        ],
                        "examples": [
                            {
                                "example_id": "2f6c3e33-b8d4-4ad8-b9d9-24aa06165208",
                                "sense_id": "f824067b-446f-3818-94a3-297dc93e2b84",
                                "text": "„Er folgt, wie gesagt, dem traditionellen Strukturmuster: Man begibt sich auf den Weg in der unbestimmten Erwartung von Aventüren, und man nimmt sie so an, wie sie sich anbieten.“"
                            },
                            {
                                "example_id": "bf19bdd9-602e-4f50-8dad-67c6a18de5f9",
                                "sense_id": "f824067b-446f-3818-94a3-297dc93e2b84",
                                "text": "„Dass Hedin gleichzeitig ein seriöser Geograph war, ist seinen populären Aventüren kaum anzumerken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
