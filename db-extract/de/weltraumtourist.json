                "senses": [
                    {
                        "sense_id": "64cb85b1-192b-32df-bfb5-f145ced7a7bd",
                        "entry_id": "4505be85-e700-3d33-a7f2-0926fafd1a79",
                        "glosses": [
                            "(männliche) zivile Person, die gegen Bezahlung eine Reise in den Weltraum unternimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cf9088a-7800-4261-bd8e-10322ab04c69",
                                "sense_id": "64cb85b1-192b-32df-bfb5-f145ced7a7bd",
                                "text": "„Tito war berühmt geworden, weil er als erster Weltraumtourist überhaupt der internationalen Raumstation ISS einen Besuch abgestattet hatte.“"
                            },
                            {
                                "example_id": "6ff68961-8858-4bc5-b0ed-748f21920a5d",
                                "sense_id": "64cb85b1-192b-32df-bfb5-f145ced7a7bd",
                                "text": "„Dafür bekommen die Weltraumtouristen rund zweistündige Flüge, einige Minuten Schwerelosigkeit und Ausblicke auf die Erde, die sonst nur Astronauten genießen können.“"
                            },
                            {
                                "example_id": "00bde5e5-4564-487d-b116-293c1fa618b6",
                                "sense_id": "64cb85b1-192b-32df-bfb5-f145ced7a7bd",
                                "text": "„Die bisher sieben Weltraumtouristen waren auf der internationalen Raumstation ISS rund 400 Kilometer über der Erde, Dennis Tito machte 2001 den Anfang.“"
                            },
                            {
                                "example_id": "d00ab433-b251-4bed-a284-e00baab8161b",
                                "sense_id": "64cb85b1-192b-32df-bfb5-f145ced7a7bd",
                                "text": "„Padalka und US-Astronaut Michael Barratt, die den Weltraumtouristen mitbrachten, bleiben bis Mitte Oktober in der Station.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
