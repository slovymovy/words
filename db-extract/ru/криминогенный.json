                                        "glosses": [
                                            "die Kriminalität fördernd, (lateinisch-griechisch) Kriminalität auslösend, zu kriminellem Verhalten anstiftend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16dbe502-bb6f-405b-ad57-410c70419f3d",
                                                "sense_id": "8048b0f4-cb25-30f0-b410-b72a168007c5",
