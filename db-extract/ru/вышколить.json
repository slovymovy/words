                "senses": [
                    {
                        "sense_id": "e54bef60-05c4-3523-a00c-1aa2bcf8a390",
                        "entry_id": "a1865615-7cbc-3a45-9626-d4962a6373b9",
                        "glosses": [
                            "разг. обучая, воспитывая, внушить строгие правила поведения, приучить к порядку, сделать дисциплинированным"
                        ],
                        "tags": [
                            "кого."
                        ],
                        "examples": [
                            {
                                "example_id": "1653568d-3905-432a-a450-392e36d642df",
                                "sense_id": "e54bef60-05c4-3523-a00c-1aa2bcf8a390",
                                "text": "Что она медлит ответом, это понятно для Марьи Алексевны: она хочет совершенно вышколить жениха, так чтоб он без неё дохнуть не смел, и вынудить покорность у Анны Петровны."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce472f6a-c526-4a91-b42d-4300dd7fa3e5",
                        "source_entry_id": "a1865615-7cbc-3a45-9626-d4962a6373b9",
                        "source_sense_id": "e54bef60-05c4-3523-a00c-1aa2bcf8a390",
                        "target_lang_word": "beschulen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beschulen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c411deaf-9870-35b9-8621-360f0a96f6d2",
                                        "entry_id": "babcdba0-c830-3cdd-93dc-e408de3f9f6e",
                                        "glosses": [
                                            "mit Schulunterricht versorgen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ac8e9f2-fdf7-43d6-a7b3-278bdeecb1a4",
                                                "sense_id": "c411deaf-9870-35b9-8621-360f0a96f6d2",
                                                "text": "„Freie Träger beschulen Jugendliche, die eine staatliche Schule ohne Abschluss verlassen haben.“"
                                            },
                                            {
                                                "example_id": "6d5f82c2-ad65-47ea-ae94-97c95fdc2df2",
                                                "sense_id": "c411deaf-9870-35b9-8621-360f0a96f6d2",
                                                "text": "„Schüler - aller Schulformen - sind bei uns viel zu bequem. Sie wollen sich unterhalten und beschulen lassen, der Lehrer ist verantwortlich für das, was sie lernen.“"
                                            },
                                            {
                                                "example_id": "9374f99e-437b-467d-9d90-f64ae92e0823",
                                                "sense_id": "c411deaf-9870-35b9-8621-360f0a96f6d2",
                                                "text": "Die Hundertwasserschule beschult Schülerinnen und Schüler in der Primarstufe, die Hermann Hesse-Schule ist eine Schule für Schülerinnen und Schüler der Sekundarstufe."
                                            },
                                            {
                                                "example_id": "b5c764a4-0ad3-4db5-bb67-7f156c20c6fd",
                                                "sense_id": "c411deaf-9870-35b9-8621-360f0a96f6d2",
                                                "text": "Richtig sei, dass manche Berufsfelder nicht doppelt im Kreis beschult werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
