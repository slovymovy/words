                "senses": [
                    {
                        "sense_id": "ac353013-6c38-3930-b79a-be306c37a39a",
                        "entry_id": "1679ad93-7c3b-300d-b740-63f2828760ca",
                        "glosses": [
                            "wie auf einer Bühne des Kabaretts dargestellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e89c785-5053-4145-842a-05b89b28588f",
                                "sense_id": "ac353013-6c38-3930-b79a-be306c37a39a",
                                "text": "„Katie Freudenschuss [ist ein] kabarettistisches Multitalent aus Gießen.“"
                            },
                            {
                                "example_id": "98ca2474-a75b-4014-b100-6eb2957dce1f",
                                "sense_id": "ac353013-6c38-3930-b79a-be306c37a39a",
                                "text": "„Franz Hohler […] gilt er als wichtigste kabarettistische Stimme der Schweiz.“"
                            },
                            {
                                "example_id": "16f6c48f-5361-47f8-a172-8cfedd2e53f0",
                                "sense_id": "ac353013-6c38-3930-b79a-be306c37a39a",
                                "text": "„Da, wo andere Kabarettisten noch einen drauf setzen, ist für einen Pfarrer[, der im Kabarett auftritt,] schon Schluss, vor allem wenn Menschen beleidigt werden. Da ist die kabarettistische Grenze für den evangelischen Pfarrer ganz klar erreicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
