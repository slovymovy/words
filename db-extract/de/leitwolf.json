                "senses": [
                    {
                        "sense_id": "ad63eec1-c1b7-390d-a534-89d39aa14493",
                        "entry_id": "3d2f19ec-4f62-3eb1-bcdd-d57f7e8d1728",
                        "glosses": [
                            "alpha wolf (leader of a pack)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "4087d2d5-27f2-4d5c-a4b0-452e6efc8c22",
                                "sense_id": "ad63eec1-c1b7-390d-a534-89d39aa14493",
                                "text": "Der Leitwolf zog seine Lefzen zurück. Gefletschte Zähne glänzten im Mondlicht. Er knurrte, sträubte das Fell. Sei ganz behutsam. Der Leitwolf betrachtete uns als feindliches Rudel, das in sein Revier eingedrungen war. Er war ein Alphatier."
                            }
                        ]
                    },
                    {
                        "sense_id": "6efe6308-d120-3241-81c7-dba134fb71a0",
                        "entry_id": "3d2f19ec-4f62-3eb1-bcdd-d57f7e8d1728",
                        "glosses": [
                            "leader"
                        ],
                        "tags": [
                            "figuratively",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "e02bc632-8882-4c9d-9d58-008a72f97f88",
                                "sense_id": "6efe6308-d120-3241-81c7-dba134fb71a0",
                                "text": "Je nach Situation muss die Führungskraft mal als einfühlsamer Coach handeln (der seine Mitarbeiter berät), mal als Leitwolf (der sagt, wo es langgeht), mal als Löwenbändiger (der mit der Peitsche droht) usw."
                            }
                        ]
                    }
                ],
