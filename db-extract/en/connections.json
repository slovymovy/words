                                                "example_id": "54e6b210-2950-45f8-97e4-dcba9f7df6e2",
                                                "sense_id": "66f93586-9134-3bf1-9d57-85c2b053979f",
                                                "text": "Escuchen bien, no pienso repetirlo. Por favor, chicos, no manoseen los enchufes; puede ser muy peligroso."
                                            }
