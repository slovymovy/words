                    {
                        "sense_id": "07a794ce-5fc7-3121-a011-a126a24e7cd7",
                        "entry_id": "5a481c10-d5f1-3d2b-87b9-59c75ce8d5a8",
                        "glosses": [
                            "plaats waar de regering en het parlement gehuisvest zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0b97be1-0022-49c4-9c48-e4ec469b556e",
                                "sense_id": "07a794ce-5fc7-3121-a011-a126a24e7cd7",
                                "text": "Voor hem is de residentie van oudsher regeringszetel en landelijk centrum van rechtspraak en diplomatie."
                            },
                            {
                                "example_id": "a9de5c4a-cc2e-4efd-9ca7-e41924db636c",
                                "sense_id": "07a794ce-5fc7-3121-a011-a126a24e7cd7",
                                "text": "Wie er achter de aanslag zit, is nog onbekend. In Aden heeft de Zuidelijke Overgangsraad (STC) de macht. In het begin van de Jemenitische burgeroorlog in 2014 vormde die een bondgenootschap met president Hadi, tegen de sjiitische Houthi-rebellen in het noorden. De regeringszetel werd verplaatst van hoofdstad Sanaa, die veroverd werd door de Houthi's, naar Aden. Later raakten Hadi en zijn regering ook in conflict met de STC en vertrok de regering uit Aden."
                            }
                        ]
                    }
