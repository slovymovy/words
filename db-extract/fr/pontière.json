                ],
                "senses": [
                    {
                        "sense_id": "7d98159c-10f2-34cf-a1c8-11fdc021e3f8",
                        "entry_id": "793411a0-9a0c-33b6-8d2e-61e55b093790",
                        "glosses": [
                            "Pont flottant constitué généralement par quelques bateaux sur lesquels on pose un tablier en bois, utilisé par les pontonniers de l’armée pour traverser un cours d’eau ou effectuer des réparations sur un pont existant."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8aaf5635-75cd-4171-baa2-ceb81d98222b",
                                "sense_id": "7d98159c-10f2-34cf-a1c8-11fdc021e3f8",
                                "text": "On établira , au défaut de grands bateaux, chaque chevalet sur une pontière de bateaux, sur un grand radeau d’arbres ou de tonneaux, ou sur une pontière de radeaux."
                            },
                            {
                                "example_id": "75fe0484-1477-4843-be26-64abfa0647ca",
                                "sense_id": "7d98159c-10f2-34cf-a1c8-11fdc021e3f8",
                                "text": "Les moyens de franchissement de la Moulouïa ont été augmentés et améliorés. … A Moul-èl-Bacha, une pontière, sorte de radeau constitué par deux bateaux supportant un morceau de tablier, a été établie."
                            }
                        ]
                    }
                ],
