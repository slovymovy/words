                "forms": [
                    {
                        "form_id": "dc10077c-5213-47a4-8781-27d19f57dd5e",
                        "entry_id": "3b494e07-ee42-36d8-b1d2-2a8a7492e53e",
                        "tags": [
                            "plural"
                        ],
                        "form": "ketchs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0ca3cd9e-c38b-3af9-8cd7-1e07cb7960a6",
                        "entry_id": "3b494e07-ee42-36d8-b1d2-2a8a7492e53e",
                        "glosses": [
                            "Voilier à deux mâts, dont le grand mât est devant, et le mât d’artimon devant la mèche du safran."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1602998-ca6e-46a1-95ee-287fb0ff5ccc",
                                "sense_id": "0ca3cd9e-c38b-3af9-8cd7-1e07cb7960a6",
                                "text": "C’est un fifty-fifty, un Spey I, de construction anglaise ; douze mètres vingt hors tout et un mètre quarante-cinq de tirant d’eau, gréé en ketch, avec un diesel de cinquante chevaux."
                            },
                            {
                                "example_id": "b8fae64d-3754-4d3b-84b8-6e7d41b66661",
                                "sense_id": "0ca3cd9e-c38b-3af9-8cd7-1e07cb7960a6",
                                "text": "C'était sans doute jadis un ketch d'un modèle ou d'un autre mais les mâts avaient été brisés pratiquement au ras du pont et la seule chose qui restait au-dessus c'étaient des taquets de cuivre et quelques montants du bastingage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d58faa4-0045-4c45-81b0-1d53e573e54b",
                        "source_entry_id": "3b494e07-ee42-36d8-b1d2-2a8a7492e53e",
                        "source_sense_id": "0ca3cd9e-c38b-3af9-8cd7-1e07cb7960a6",
                        "target_lang_word": "Ketsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ketsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66542546-5bce-3287-a614-827b3bc87627",
                                        "entry_id": "e7bc634d-a7ff-3df7-85ec-c8bfaa8a2ef6",
                                        "glosses": [
                                            "Segelschiffstyp mit zwei Masten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41feff2f-f504-450a-b258-0605119abce7",
                                                "sense_id": "66542546-5bce-3287-a614-827b3bc87627",
                                                "text": "„Etwa zwei Stunden später gingen wir mit der Ketsch in der Nordbucht vor Anker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fa2fe54-1c68-4369-b83e-69f6721eedfc",
                        "source_entry_id": "3b494e07-ee42-36d8-b1d2-2a8a7492e53e",
                        "source_sense_id": "0ca3cd9e-c38b-3af9-8cd7-1e07cb7960a6",
                        "target_lang_word": "ketch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ketch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "969191bf-5d8e-34e5-8481-07a83746fa05",
                                        "entry_id": "c411a5ca-103b-3b15-96e4-35d37adaf347",
                                        "glosses": [
                                            "To hang."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5028f505-f204-4c2a-b335-7c9f79af030f",
                                                "sense_id": "969191bf-5d8e-34e5-8481-07a83746fa05",
                                                "text": "'Squire Ketch rejoices as much to hear of a new Vox, as an old Sexton does to hear of a new Delight."
                                            },
                                            {
                                                "example_id": "df040962-0ca6-493d-8262-8a305602833b",
                                                "sense_id": "969191bf-5d8e-34e5-8481-07a83746fa05",
                                                "text": "Well! If he has a mind to be Ketch'd, speed him say I."
                                            },
                                            {
                                                "example_id": "d27685d5-f8ae-4819-aa64-e97179deb4a6",
                                                "sense_id": "969191bf-5d8e-34e5-8481-07a83746fa05",
                                                "text": "Ignorant of many of the secrets of ketchcraft."
                                            },
                                            {
                                                "example_id": "f3a4a618-9fc8-4ee2-94a1-59e90d787803",
                                                "sense_id": "969191bf-5d8e-34e5-8481-07a83746fa05",
                                                "text": "1859, MATSELL Vocab. s.v. (Farmer),\nI'll ketch you; I'll hang you."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ketch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4a1eb4d-986b-35bf-a2fa-012dbf7926ab",
                                        "entry_id": "eea275c2-c936-35b2-b56e-3770aa152272",
                                        "glosses": [
                                            "A fore-and-aft rigged sailing vessel with two masts, main and mizzen, the mizzen being stepped forward of the rudder post."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "759b6db5-40cf-427f-abcd-0a1bdaf8a97b",
                                                "sense_id": "a4a1eb4d-986b-35bf-a2fa-012dbf7926ab",
                                                "text": "[…] to finish her new Habit or Appearance, and make her Change compleat, he ordered her Sails to be alter’d; and as she sailed before with a Half-Sprit, like a Yacht, she sailed now with square Sail and Mizen Mast, like a Ketch; so that, in a Word, she was a perfect Cheat […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ketch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95c57f36-7266-3fa0-9d10-87d92012afdb",
                                        "entry_id": "c1dfa7cf-9339-3455-be9a-a2b3eaa9be1d",
                                        "glosses": [
                                            "Pronunciation spelling of catch."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "pronunciation-spelling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7455c60d-4c3a-4ddd-a01e-4968ae291e44",
                                                "sense_id": "95c57f36-7266-3fa0-9d10-87d92012afdb",
                                                "text": "I guess, he is trying to ketch mebut it won't du. I'm tu old a bird to be ketch'd with chaff."
                                            },
                                            {
                                                "example_id": "b032196c-4a6f-457f-9eec-13637a0aa827",
                                                "sense_id": "95c57f36-7266-3fa0-9d10-87d92012afdb",
                                                "text": "Wot is it, lambs, as they ketches in seas, rivers, lakes, and ponds?"
                                            },
                                            {
                                                "example_id": "67987377-fb45-4a64-a002-ee00bce66f79",
                                                "sense_id": "95c57f36-7266-3fa0-9d10-87d92012afdb",
                                                "text": "[…] I got to go to church and sweat and sweat—I hate them ornery sermons! I can’t ketch a fly in there, I can’t chaw, I got to wear shoes all Sunday."
                                            },
                                            {
                                                "example_id": "a372ca2d-897c-46dd-9f07-3040234118f4",
                                                "sense_id": "95c57f36-7266-3fa0-9d10-87d92012afdb",
                                                "text": "You'll ketch your death. The fire's out long ago."
                                            },
                                            {
                                                "example_id": "2ff75ca9-7dab-4131-8e35-4b5f9ef90bb9",
                                                "sense_id": "95c57f36-7266-3fa0-9d10-87d92012afdb",
                                                "text": "You'll never ketch me hollerin' at no Republican gatherin'."
                                            },
                                            {
                                                "example_id": "935c32f1-752d-4173-a996-87d0651bab7f",
                                                "sense_id": "95c57f36-7266-3fa0-9d10-87d92012afdb",
                                                "text": "If so you gonna ketch hell."
                                            },
                                            {
                                                "example_id": "4c10962f-d3fe-44ed-8145-f31f7f8a434b",
                                                "sense_id": "95c57f36-7266-3fa0-9d10-87d92012afdb",
                                                "text": "You heard about that joke a dollar down and a dollar when you ketch me?"
                                            },
                                            {
                                                "example_id": "5f84bde1-1cbe-4fe9-9868-0707680cef2e",
                                                "sense_id": "95c57f36-7266-3fa0-9d10-87d92012afdb",
                                                "text": "Run, nigger, run, de patrollers will ketch you."
                                            }
                                        ]
                                    }
                                ]
                            },
