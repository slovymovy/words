                "senses": [
                    {
                        "sense_id": "9fee3518-3248-3c26-8e33-c50c92628430",
                        "entry_id": "96c1defd-1a43-3c06-bea9-59f810beb09a",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bb4c7cb-3dbc-4cd8-804a-c1e91c11dc53",
                                "sense_id": "9fee3518-3248-3c26-8e33-c50c92628430",
                                "text": "Frau Bucken ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fe4b2e83-7f52-4d06-a274-121d8784b02f",
                                "sense_id": "9fee3518-3248-3c26-8e33-c50c92628430",
                                "text": "Herr Bucken wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8cd6ddca-d265-42ba-a20f-fb37fd34c241",
                                "sense_id": "9fee3518-3248-3c26-8e33-c50c92628430",
                                "text": "Die Buckens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d568a363-8904-412f-92f0-da602e6ee7a6",
                                "sense_id": "9fee3518-3248-3c26-8e33-c50c92628430",
                                "text": "Der Bucken trägt nie die Schals, die die Bucken ihm strickt."
                            },
                            {
                                "example_id": "3c2d6a1b-4c07-48aa-8978-cb66ba0e9432",
                                "sense_id": "9fee3518-3248-3c26-8e33-c50c92628430",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bucken kommt, geht der Herr Bucken.“"
                            },
                            {
                                "example_id": "b38fe7fe-33a2-407c-81d5-675365fb775b",
                                "sense_id": "9fee3518-3248-3c26-8e33-c50c92628430",
                                "text": "Bucken kommt und geht."
                            },
                            {
                                "example_id": "d6a6ac57-0ec2-4604-9706-c1b1390c463a",
                                "sense_id": "9fee3518-3248-3c26-8e33-c50c92628430",
                                "text": "Buckens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
