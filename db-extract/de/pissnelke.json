                "senses": [
                    {
                        "sense_id": "f4429313-765b-3563-8b7f-7d4074e15f7e",
                        "entry_id": "20eaf407-8071-3649-a423-0d3e5c08fdee",
                        "glosses": [
                            "Fotze"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "31b1701b-75b8-45cb-92e9-22162f113de5",
                                "sense_id": "f4429313-765b-3563-8b7f-7d4074e15f7e",
                                "text": "„Ich bleibe lieber für mich; mit dieser Kakerlake Paul und seiner aalglatten Pissnelke Daphne will ich nichts zu tun haben.“"
                            },
                            {
                                "example_id": "10cc02ab-ac8d-4bcd-8cc1-ecc3515ae461",
                                "sense_id": "f4429313-765b-3563-8b7f-7d4074e15f7e",
                                "text": "„Hey du Pissnelke. Willst du ein paar aufs Maul?“"
                            },
                            {
                                "example_id": "8e784eac-1c8f-4c0a-8581-87f88cf22754",
                                "sense_id": "f4429313-765b-3563-8b7f-7d4074e15f7e",
                                "text": "„Schleimfotze, Drecksloch, Pissnelke, Fickgrotte, Kackbratze, Dorfmatratze: Ich hasse dich! Töle, Schnepfe, Zicke, Stute, Kröte, Pute: Ich hasse dich! Stinkmöse, Bumsdose, Strichnutte, Fickflittchen, Fischritze, Drecksbitch: Ich hasse dich!“"
                            },
                            {
                                "example_id": "0e149387-dbde-4eb3-8e73-f99f566fd0d0",
                                "sense_id": "f4429313-765b-3563-8b7f-7d4074e15f7e",
                                "text": "„‚Ich weiß, dass du stinkst,‘ sagte Eric. ‚Pissnelke!‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
