                        "cross_references": [
                            {
                                "target_word": "парсек",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "72c6c9f5-9b81-371c-b560-ff32ed19451a",
                                        "entry_id": "0c0d8641-acd6-3826-aa04-eab1c780c3f6",
                                        "glosses": [
                                            "астрон. единица измерения расстояний, равная расстоянию, для которого годичный параллакс равен одной секунде (1 пк ≈ 206 265 а. е. ≈ 3,0857·10¹⁶ м)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "703ada0e-7ad7-4697-8508-8662fbc310d5",
                                                "sense_id": "72c6c9f5-9b81-371c-b560-ff32ed19451a",
                                                "text": "Ныне как единица расстояния в астрономии применяется парсек, равный 3,26 светового года."
                                            },
                                            {
                                                "example_id": "6bc2a5a9-fc12-405c-82c9-44adc74b0bca",
                                                "sense_id": "72c6c9f5-9b81-371c-b560-ff32ed19451a",
                                                "text": "Представим себе воображаемого наблюдателя, отдалённого от Солнца на расстояние 10 парсек (немного больше 30 световых лет) и находящегося в плоскости орбиты Юпитера."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
