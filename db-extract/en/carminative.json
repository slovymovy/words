                                        "entry_id": "fac0de74-5f41-3fb9-bc8a-f80d8facbcb7",
                                        "glosses": [
                                            "Qui favorise l’expulsion des flatuosités contenues dans l’intestin, en parlant des substances médicinales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cdc3b7f-d36b-4c0c-998d-4e682a4b11c7",
                                                "sense_id": "68ad28d1-b68a-3019-bff6-96f9ebe2b8c8",
                                                "text": "C’est sur ces bases étiologiques, qu’il était nécessaire, indiquer préalablement, que nous pouvons maintenant édifier la médication carminative."
                                            }
                                        ]
                                    }
                                ]
