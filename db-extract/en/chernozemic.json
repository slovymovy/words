                "senses": [
                    {
                        "sense_id": "17003aaf-d1b3-357a-be19-b35f6aa32d24",
                        "entry_id": "e81e392e-e356-399e-960a-9ca17d2bca86",
                        "glosses": [
                            "Being or containing chernozem."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fde6df57-6f25-4481-84a6-6a37719e73f4",
                                "sense_id": "17003aaf-d1b3-357a-be19-b35f6aa32d24",
                                "text": "chernozemic soils"
                            },
                            {
                                "example_id": "6290e332-ed1a-4e10-8221-df584e766ffa",
                                "sense_id": "17003aaf-d1b3-357a-be19-b35f6aa32d24",
                                "text": "The term \"chernozemic\" is a new word suggested by Dr. Nikiforoff. There seems to be a need for a term which will have the same relation to chernozem as podzolic has to podzol."
                            },
                            {
                                "example_id": "bed66ec7-c411-4550-b48e-64e1a8f082a7",
                                "sense_id": "17003aaf-d1b3-357a-be19-b35f6aa32d24",
                                "text": "They have a dark upper A horizon that usually contains approximately the same amount of organic matter as the geographically associated chernozemic soils."
                            },
                            {
                                "example_id": "b81d2989-632a-4f50-a1b1-7deac2af1953",
                                "sense_id": "17003aaf-d1b3-357a-be19-b35f6aa32d24",
                                "text": "The most important chernozemic regions of the world are the Danube Basin and the southern Soviet Union in Eurasia, the Great Plains of the United States and the zemic prairies of Canada, and the Pampas region of Argentina."
                            },
                            {
                                "example_id": "da74880d-a5ea-4882-8aca-7d2bd9902594",
                                "sense_id": "17003aaf-d1b3-357a-be19-b35f6aa32d24",
                                "text": "All these soils have chernozemic soil properties (dark colour, A–C profile, high base saturation, bioturbation)."
                            }
                        ]
                    }
                ],
