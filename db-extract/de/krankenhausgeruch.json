                "senses": [
                    {
                        "sense_id": "f78a3a59-923a-31f4-8946-da49cef4b8a0",
                        "entry_id": "d23a73a4-1f7a-3ce5-9f65-a76a773db018",
                        "glosses": [
                            "Geruch, der in einem Krankenhaus herrscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c451b4d-f226-4015-8303-9a469a19ebe2",
                                "sense_id": "f78a3a59-923a-31f4-8946-da49cef4b8a0",
                                "text": "„Sie gelangten in einen dunklen Korridor, in dem der Krankenhausgeruch so stark war, dass Rostow sich die Nase zuhielt und einen Augenblick haltmachen musste, um neue Kräfte zum Weitergehen zu sammeln.“"
                            },
                            {
                                "example_id": "dbc13ef5-3f69-4ab8-8094-77c5c2ae9fd8",
                                "sense_id": "f78a3a59-923a-31f4-8946-da49cef4b8a0",
                                "text": "„Er eilte durch den Torbogen des Cochin, hinter dem ihm wie ein Schwall alle Krankenhausgerüche, die er je eingeatmet hatte, entgegenschlugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
