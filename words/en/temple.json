                            {
                                "target_lang_word": "висок",
                                "target_lang_sense_clarification": "анатомическая область головы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80a65389-4e2b-3d77-ae35-45018f5dbe5e",
                    "sense_definition": "Something that is regarded as sacred, important, or worthy of great care.",
