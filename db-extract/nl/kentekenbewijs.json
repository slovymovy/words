                                    {
                                        "sense_id": "475fb5df-3a3c-31a2-9ba7-ae3742a0701d",
                                        "entry_id": "30343798-ad6b-3c95-b84b-077c9b04e8ea",
                                        "glosses": [
                                            "Nom courant du certificat d’immatriculation d’un véhicule automobile, qui se présente sous la forme d’une carte et qui comporte le nom du propriétaire, le numéro d’immatriculation dudit véhicule et ses principales caractéristiques techniques : poids, nombre de places, puissance fiscale, etc."
                                        ],
                                        "tags": [
                                            "Administration",
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85674fde-adc2-43d6-bf38-91227a591831",
                                                "sense_id": "475fb5df-3a3c-31a2-9ba7-ae3742a0701d",
                                                "text": "Lorsqu’on conduit, il faut toujours être en mesure de présenter la carte grise du véhicule aux forces de l’ordre, lors d’un contrôle."
                                            },
                                            {
                                                "example_id": "8f6962e1-2094-41c4-bdfd-a1139ef68d9e",
                                                "sense_id": "475fb5df-3a3c-31a2-9ba7-ae3742a0701d",
                                                "text": "Elle me rendit mes papiers comme un gardien de la paix restitue la carte grise d’un automobiliste suspect et, me prenant familièrement par le bras, elle m’offrit de me faire voir sa maison."
                                            },
                                            {
                                                "example_id": "0d24a836-b588-4d22-9d08-19b37fd43714",
                                                "sense_id": "475fb5df-3a3c-31a2-9ba7-ae3742a0701d",
                                                "text": "« Je serai obligé, Madame, de vous demander de rentrer avec le gazogène. Je ne peux pas prendre la responsabilité de vous emmener avec nous, nous n’avons ni carte grise ni papiers…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
