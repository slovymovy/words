                        "sense_id": "bf99e086-fb3c-35a7-a9f2-375d36ea9ae8",
                        "entry_id": "d05ff225-915b-3326-a747-71e33a9a00aa",
                        "glosses": [
                            "Qui peut être augmenté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fbcda61-9f9d-4f40-8c64-010b4063c463",
                                "sense_id": "bf99e086-fb3c-35a7-a9f2-375d36ea9ae8",
                                "text": "Une grandeur supposée toujours augmentable ou divisible de plus en plus, ne peut être supposée augmentée ou divisée à l’infini, en sorte qu’elle ne soit plus augmentable ou divisible."
                            },
                            {
                                "example_id": "31f33dbe-bae7-461b-a24f-5a49304fa2ef",
                                "sense_id": "bf99e086-fb3c-35a7-a9f2-375d36ea9ae8",
                                "text": "L’infini en puissance est potentialité, virtualité. Il se trouve dans le nombre, puisque ce dernier est augmentable à l’infini en puissance ; mais il ne saurait y avoir de nombre ultime, un nombre « infini actuel »."
                            },
                            {
                                "example_id": "4b11b0cb-f82c-48c5-a5ea-b3fc7260eff1",
                                "sense_id": "bf99e086-fb3c-35a7-a9f2-375d36ea9ae8",
                                "text": "Les AirPods Pro sont utilisables, en écoute continue, pendant 4h30, une durée augmentable jusqu’à 24 heures avec le boitier, lui-même rechargeable sans fil avec les chargeurs Qi."
                            }
                        ]
                    }
