                "senses": [
                    {
                        "sense_id": "8d0be996-bd55-3f22-baa5-85573a834182",
                        "entry_id": "fe171787-8afc-3065-b1bb-cada48da7d72",
                        "glosses": [
                            "morals; morality"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8711110-d626-4c61-b1d7-fd007fb249c3",
                                "sense_id": "8d0be996-bd55-3f22-baa5-85573a834182",
                                "text": "двойна́я мора́ль",
                                "translation": "double standard",
                                "english": "double standard"
                            },
                            {
                                "example_id": "d376ab8d-9941-411c-9aac-c937a77afed5",
                                "sense_id": "8d0be996-bd55-3f22-baa5-85573a834182",
                                "text": "Я по́нял, что его́ религио́зная мора́ль попа́ла в столкнове́ние с своего́ ро́да «поли́тикою».",
                                "translation": "I understood that his religious morality had come into collision with a species of politics.",
                                "english": "I understood that his religious morality had come into collision with a species of politics."
                            }
                        ]
                    },
                    {
                        "sense_id": "09f4e84e-f422-3e87-bd62-7035aded5f4d",
                        "entry_id": "fe171787-8afc-3065-b1bb-cada48da7d72",
                        "glosses": [
                            "lecturing, reprimanding, telling someone off"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d98a8fe6-3cc1-44d8-9924-57788de21c8a",
                                "sense_id": "09f4e84e-f422-3e87-bd62-7035aded5f4d",
                                "text": "чита́ть мора́ль",
                                "translation": "to moralize",
                                "english": "to moralize"
                            }
                        ]
                    }
                ],
