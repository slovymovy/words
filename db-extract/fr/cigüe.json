                ],
                "senses": [
                    {
                        "sense_id": "19f43e71-5ee9-343a-af78-ef91d52f19fa",
                        "entry_id": "419822ac-6717-3355-87d3-995ecd69075d",
                        "glosses": [
                            "Genre de plantes ombellifères dont quelques espèces sont très vénéneuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e9d7be4-fc50-439a-be74-9166507b99c4",
                                "sense_id": "19f43e71-5ee9-343a-af78-ef91d52f19fa",
                                "text": "Je coupe toutes les cigües du jardin pour éviter que les enfants ne les mangent."
                            },
                            {
                                "example_id": "c4a9fd39-7db0-4bfe-a43f-0af9e5ee1763",
                                "sense_id": "19f43e71-5ee9-343a-af78-ef91d52f19fa",
                                "text": "Grande cigüe (Conium maculatum) : principale espèce de ce genre."
                            },
                            {
                                "example_id": "ff9b70ab-d112-4ae3-97c3-f09a8467ac0f",
                                "sense_id": "19f43e71-5ee9-343a-af78-ef91d52f19fa",
                                "text": "Cigüe aquatique (Cicuta virosa) : autre espèce très vénéneuse, également nommée cigüe vénéneuse, cigüe vireuse, persil des marais ou cicutaire du Nord."
                            },
                            {
                                "example_id": "2b9762df-6732-4ea2-8d43-20d1dbc89dcf",
                                "sense_id": "19f43e71-5ee9-343a-af78-ef91d52f19fa",
                                "text": "Petite cigüe (Aethusa cynapium) : voir faux persil, aethuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "07bf3bbb-def9-30c3-93dd-fd6bd63fbf7f",
                        "entry_id": "419822ac-6717-3355-87d3-995ecd69075d",
                        "glosses": [
                            "Poison extrait de la grande cigüe dont les Athéniens se servaient pour faire mourir ceux qui étaient condamnés à mort."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "af9ac8bd-6877-4e17-8707-d94d90ca3d18",
                                "sense_id": "07bf3bbb-def9-30c3-93dd-fd6bd63fbf7f",
                                "text": "Socrate et Phocion furent condamnés à boire la cigüe."
                            },
                            {
                                "example_id": "a57acb5b-482a-4054-bb12-21f43109b005",
                                "sense_id": "07bf3bbb-def9-30c3-93dd-fd6bd63fbf7f",
                                "text": "La cigüe tue par paralysie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9900cd4-56c0-4ec4-9f0d-2a753081a69f",
                        "source_entry_id": "419822ac-6717-3355-87d3-995ecd69075d",
                        "target_lang_word": "Schierling",
                        "target_lang_code": "de",
