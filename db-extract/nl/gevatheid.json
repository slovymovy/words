                                            },
                                            {
                                                "example_id": "493dcbd4-7b4f-4c00-b3ca-b13d5acfc98f",
                                                "sense_id": "8f2e09d7-32d9-312d-b4e0-3890c8bca811",
                                                "text": "Cut it out, Sis, an' lissen ter er wise crack. Will yer be nice if I pay yer fine?"
                                            }
