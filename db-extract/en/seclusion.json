                "senses": [
                    {
                        "sense_id": "281f4e15-399c-348b-9610-964b04218667",
                        "entry_id": "e4b00d30-3f88-3c2c-9828-214bd0d5882f",
                        "glosses": [
                            "The act of secluding, shutting out or keeping apart."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a19c0e75-0ff8-4df5-9fa7-a142519bfd09",
                                "sense_id": "281f4e15-399c-348b-9610-964b04218667",
                                "text": "Seclusion may be used only as a therapeutic measure to prevent a recipient from causing physical harm to himself or physical abuse to others."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe967b3d-7414-3edc-9ebc-0622f70447c4",
                        "entry_id": "e4b00d30-3f88-3c2c-9828-214bd0d5882f",
                        "glosses": [
                            "The state of being secluded or shut out, as from company, society, the world, etc.; solitude."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1e528de3-fb23-4be8-a21d-6331e5cfdbb5",
                                "sense_id": "fe967b3d-7414-3edc-9ebc-0622f70447c4",
                                "text": "Madame de Mercœur was at first unwilling that Francesca should share her seclusion; but her young companion was too much in earnest to be refused. Francesca was still depressed by her recent parting with Guido, and clung to Henriette as her only friend,—she would have felt so utterly alone with Marie; besides, she too wished to pray for the absent and the dear."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d525b5f-9259-3952-9eac-f0eacd494778",
                        "entry_id": "e4b00d30-3f88-3c2c-9828-214bd0d5882f",
                        "glosses": [
                            "A secluded, isolated or private place."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "92225303-ab8c-3ffb-8408-f2c6e367dde5",
                        "entry_id": "e4b00d30-3f88-3c2c-9828-214bd0d5882f",
                        "glosses": [
                            "The mature phase of the extratropical cyclone life cycle."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "250cbd33-36e5-4b9f-8e16-39dd2012494b",
                                "sense_id": "92225303-ab8c-3ffb-8408-f2c6e367dde5",
                                "text": "warm seclusion"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d143520d-9868-407a-bac2-46dbba279563",
                        "source_entry_id": "e4b00d30-3f88-3c2c-9828-214bd0d5882f",
                        "source_sense_description": "act of secluding, or the state of being secluded; a shutting out or keeping apart, or the state of being shut out",
                        "target_lang_word": "séclusion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "séclusion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f3f5d60-2ed3-3e9c-9855-5ba10ea05391",
                                        "entry_id": "efd50b58-79a3-338d-a128-f7a21e888358",
                                        "glosses": [
                                            "Moyens organiques permettant à un être vivant de s’isoler et de se protéger passivement des agressions dues à un milieu défavorable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7cc2391-99e6-46bf-9066-cce4c0b0d2ee",
                                                "sense_id": "6f3f5d60-2ed3-3e9c-9855-5ba10ea05391",
                                                "text": "La séclusion esthétique de l’aventure est toujours incomplète."
                                            },
                                            {
                                                "example_id": "2472c754-6f8b-44bb-950d-68ba4f06f59e",
                                                "sense_id": "6f3f5d60-2ed3-3e9c-9855-5ba10ea05391",
                                                "text": "De part et d’autre, les langues, les habitudes, les conversations et les rapports au ciel, à l’amour et à la mort n’étaient pas les mêmes. En biologie, le mot séclusion désignait cette séparation des organes. Chacun, derrière sa membrane, se distingue de l’autre tout en laissant circuler les composés. Les éléments se protègent sans s’isoler. Tous prospèrent sans se dissoudre dans un tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78345a0f-4e1f-3faf-8c53-70036d11cdc9",
                                        "entry_id": "efd50b58-79a3-338d-a128-f7a21e888358",
                                        "glosses": [
                                            "Jonction d'un front froid avec un front chaud, qui se produit à une certaine distance du centre d'une dépression avant que l'occlusion ne se produise, de sorte qu'une masse d'air chaud est enfermée, isolée et complètement entourée d'air plus froid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "baa786c9-d82f-4bf7-ab07-1beb9020f58f",
                        "source_entry_id": "e4b00d30-3f88-3c2c-9828-214bd0d5882f",
                        "source_sense_description": "act of secluding, or the state of being secluded; a shutting out or keeping apart, or the state of being shut out",
                        "target_lang_word": "isolement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isolement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a32ce25f-d61b-39ec-a1ad-5ab6c51e7115",
                                        "entry_id": "55c99dec-0235-3314-9de4-4a30ef1fe9cf",
                                        "glosses": [
                                            "Action d'isoler, de mettre à part."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4a8cf04-f284-4d52-90df-990b72d69429",
                                                "sense_id": "a32ce25f-d61b-39ec-a1ad-5ab6c51e7115",
                                                "text": "Dès le Moyen Âge, l’homme avait trouvé un moyen très efficace de lutter contre les pandémies : l’isolement ou le confinement, principe qui est encore très utilisé de nos jours."
                                            },
                                            {
                                                "example_id": "9e15c20b-6959-4b67-9b2c-4716acf4a1b5",
                                                "sense_id": "a32ce25f-d61b-39ec-a1ad-5ab6c51e7115",
                                                "text": "Il gueule du matin au soir et, quand il a commencé à tout casser dans sa cellule sous les regards horrifiés de ses deux codétenus qui voyaient déjà leur tour arriver, il a été placé à l’isolement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "920f6b92-421e-3248-8878-6d9d3425fae6",
                                        "entry_id": "55c99dec-0235-3314-9de4-4a30ef1fe9cf",
                                        "glosses": [
                                            "État d’une personne qui vit isolée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49871a31-9a1b-498e-8756-d61162f1a944",
                                                "sense_id": "920f6b92-421e-3248-8878-6d9d3425fae6",
                                                "text": "Vivre dans l’isolement, dans un grand, dans un complet isolement. — Cet état d’isolement lui est pénible."
                                            },
                                            {
                                                "example_id": "1d4e915d-92cb-49b1-bf42-ad1547952c38",
                                                "sense_id": "920f6b92-421e-3248-8878-6d9d3425fae6",
                                                "text": "Si l’isolement trempe les forts, il est la pierre d’achoppement des incertains."
                                            },
                                            {
                                                "example_id": "eb5211b3-3f18-466e-b5b9-0797e7f1bdbc",
                                                "sense_id": "920f6b92-421e-3248-8878-6d9d3425fae6",
                                                "text": "Mes symptômes sont légers pour l'instant et je suis en isolement avec ma famille"
                                            },
                                            {
                                                "example_id": "fc5076a4-861e-41e9-af0c-34ddccd77d07",
                                                "sense_id": "920f6b92-421e-3248-8878-6d9d3425fae6",
                                                "text": "Il est important de tendre la main à la personne psychotraumatisée et de le faire de façon répétée dans le temps, afin de lutter contre le sentiment d’isolement et d’abandon qu’elle peut ressentir d’autant qu’elle peut être en difficulté pour prendre l’initiative d’aller vers l’autre et élaborer une demande d’aide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b998f7fc-79f8-3289-9975-7a54d2bcb051",
                                        "entry_id": "55c99dec-0235-3314-9de4-4a30ef1fe9cf",
                                        "glosses": [
                                            "État de ce qui est isolé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c30e181c-8fa8-455a-a981-398650365417",
                                                "sense_id": "b998f7fc-79f8-3289-9975-7a54d2bcb051",
                                                "text": "En plein Atlantique, […], se dresse un étrange rocher, majestueux et terrible dans son isolement. […]. Rokall dresse son sommet à 21 mètres, hauteur d'une maison de cinq étages, et sa circonférence est d'environ 100 mètres."
                                            },
                                            {
                                                "example_id": "082d277a-def6-489c-bae8-2706bf1decf6",
                                                "sense_id": "b998f7fc-79f8-3289-9975-7a54d2bcb051",
                                                "text": "Le désert solognot se confirme et semble se complaire dans son isolement comme au temps où marécages et autres humidités l'écartaient du reste du monde. petits nous sommes petits nous resterons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a35f1c1-ccad-3e85-aeb8-7399cdb5ca2a",
                                        "entry_id": "55c99dec-0235-3314-9de4-4a30ef1fe9cf",
                                        "glosses": [
                                            "Distance entre deux parties de construction qui ne se touchent pas."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2dfb6206-2335-321f-95ff-c33194278e8f",
                                        "entry_id": "55c99dec-0235-3314-9de4-4a30ef1fe9cf",
                                        "glosses": [
                                            "Séparation opérée par des milieux non conducteurs entre un corps qu’on électrise et les corps environnants qui pourraient lui enlever son électricité."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc4cf658-7e80-37ca-83ec-a2178149cd69",
                                        "entry_id": "55c99dec-0235-3314-9de4-4a30ef1fe9cf",
                                        "glosses": [
                                            "L'isolement topographique d'un sommet désigne la distance séparant un sommet déterminé d'un point de même altitude situé sur les pentes d'un autre sommet plus élevé et le plus proche possible."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d958a2ba-b9a2-4807-8872-b4359ec7d0b3",
                        "source_entry_id": "e4b00d30-3f88-3c2c-9828-214bd0d5882f",
                        "source_sense_description": "act of secluding, or the state of being secluded; a shutting out or keeping apart, or the state of being shut out",
                        "target_lang_word": "Abgeschiedenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abgeschiedenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab105ee3-fee1-31a8-bbec-98273639a408",
                                        "entry_id": "93aab2ad-8d17-30f6-b4ff-26ecc8c006c9",
                                        "glosses": [
                                            "Zustand, abgeschieden/für sich allein zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5a7aa1a-7513-4ea7-aafe-85ad57514269",
                                                "sense_id": "ab105ee3-fee1-31a8-bbec-98273639a408",
                                                "text": "„Und wie gut war es zu wissen, dass ich jederzeit in die klösterliche Abgeschiedenheit des Hildegard-Kollegs entweichen konnte.“"
                                            },
                                            {
                                                "example_id": "cc6b005d-27b0-4b48-b00c-7c18f316b4d1",
                                                "sense_id": "ab105ee3-fee1-31a8-bbec-98273639a408",
                                                "text": "„Die Inselbewohner lebten bis zum Zweiten Weltkrieg in relativer Abgeschiedenheit, bis schließlich Tausende von amerikanischen Soldaten in den Pazifikraum einfielen.“"
                                            },
                                            {
                                                "example_id": "e676f010-0ddc-47f4-aec7-58f5e360f670",
                                                "sense_id": "ab105ee3-fee1-31a8-bbec-98273639a408",
                                                "text": "„Viele Fragen, die mich vor dem Schlaganfall eher als Gedankenspiele gestreift hatten, wurden in der Abgeschiedenheit des Krankenzimmers elementar.“"
                                            },
                                            {
                                                "example_id": "4bf4212d-613d-4152-9d14-3e2afdf99ca7",
                                                "sense_id": "ab105ee3-fee1-31a8-bbec-98273639a408",
                                                "text": "„Nach den verwirrenden Bildern, den bestürzenden Begegnungen mit Anna und seinem Vater, die ihn nach seiner Ankunft in Atem gehalten hatten, war er in eine elfenbeinerne Abgeschiedenheit getaucht, als ginge ihn das Rätsel der Gegenwart nichts an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
