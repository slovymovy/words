    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b0bfc00-34ce-3da5-9573-2ae190aeca22",
                    "sense_definition": "To focus one's attention or thoughts exclusively and intensely on something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_focus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Try not to <w>fixate</w> on past mistakes when planning for your future."
                        },
                        {
                            "text": "The media tends to <w>fixate</w> on sensational scandals rather than real policy issues."
                        }
                    ],
                    "synonyms": [
                        "focus",
                        "dwell",
                        "concentrate"
                    ],
                    "antonyms": [
                        "ignore",
                        "overlook"
                    ],
                    "common_phrases": [
                        "fixate on"
                    ]
                },
                {
                    "sense_id": "8090aa14-4266-3084-a744-ccebb877a1a8",
                    "sense_definition": "To look or stare steadily and intensely at someone or something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "visual_focus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat began to <w>fixate</w> on the laser dot moving across the carpet."
                        },
                        {
                            "text": "His eyes seemed to <w>fixate</w> on the strange painting across the room."
                        }
                    ],
                    "synonyms": [
                        "stare",
                        "gaze"
                    ],
                    "common_phrases": [
                        "fixate on"
                    ]
                },
                {
                    "sense_id": "a7e8a851-3084-3dcf-b641-68c391609b93",
                    "sense_definition": "To develop an obsessive or unhealthy emotional attachment to a person, object, or idea.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_focus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Psychologists noted that the patient began to <w>fixate</w> on unresolved childhood conflicts."
                        },
                        {
                            "text": "It is unhealthy to <w>fixate</w> on a romantic partner to the exclusion of your friends."
                        }
                    ],
                    "synonyms": [
                        "obsess"
                    ],
                    "common_phrases": [
                        "fixate on"
                    ]
                },
                {
