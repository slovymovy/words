                "senses": [
                    {
                        "sense_id": "10df66e7-3120-3c5d-9ede-7da2f6f6a232",
                        "entry_id": "fbaa090e-4f7d-3c45-9854-0878b3b93e21",
                        "glosses": [
                            "Großstadt in der Provinz Anhui in China"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b3c6782-fe1d-4597-8c2f-538724d0cc52",
                                "sense_id": "10df66e7-3120-3c5d-9ede-7da2f6f6a232",
                                "text": "Anqing liegt circa 250km östlich von Wuhan."
                            },
                            {
                                "example_id": "9a9c0db3-ed67-4c98-ad6f-4d7e0aac38b5",
                                "sense_id": "10df66e7-3120-3c5d-9ede-7da2f6f6a232",
                                "text": "„Andere Passagiere beobachteten sie während des Boardings in der Statd Anqing beim Werfen der Münzen und meldeten den Vorfall.“"
                            },
                            {
                                "example_id": "f103e6ed-709f-4b08-8d07-bf3993bbd38d",
                                "sense_id": "10df66e7-3120-3c5d-9ede-7da2f6f6a232",
                                "text": "„Sein Vater Zhu Shichen floh von Nanjing nach Anqing, weil er die dortigen Steuern nicht bezahlen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5421ec48-6a7d-484b-8675-b26a963abdac",
                        "source_entry_id": "fbaa090e-4f7d-3c45-9854-0878b3b93e21",
                        "source_sense_id": "10df66e7-3120-3c5d-9ede-7da2f6f6a232",
