                "senses": [
                    {
                        "sense_id": "6fc4f0dc-cfe4-3a1f-b3d2-126a57e8cc1e",
                        "entry_id": "891eb39c-beeb-351e-9b6b-25bb97a11dea",
                        "glosses": [
                            "ein Gebiet, das anhand unterschiedlicher grundlegender klimatischer Verhältnisse abgegrenzt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f619c6ca-756e-45dc-860f-cb29f66842b8",
                                "sense_id": "6fc4f0dc-cfe4-3a1f-b3d2-126a57e8cc1e",
                                "text": "Die tatsächlichen Verhältnisse am Boden werden charakterisiert durch die physischen Klimazonen."
                            },
                            {
                                "example_id": "6a8075e5-da79-4d82-8aa2-c49a86e1d55a",
                                "sense_id": "6fc4f0dc-cfe4-3a1f-b3d2-126a57e8cc1e",
                                "text": "„Atemzug für Atemzug realisierten meine Bronchien, dass sie nicht zu Hause und selbstverschuldet in eine Klimazone geraten waren, die ihrem angestammten Platz im Norden diametral entgegengesetzt war.“"
                            },
                            {
                                "example_id": "7edb8713-299b-4d6e-ac15-9b5917629d8f",
                                "sense_id": "6fc4f0dc-cfe4-3a1f-b3d2-126a57e8cc1e",
                                "text": "„Er war athletisch gebaut und in allen Klimazonen abgehärtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
