                ],
                "senses": [
                    {
                        "sense_id": "883f3ee0-9b4b-360f-bde8-8649df184f53",
                        "entry_id": "ef2b19cb-bb92-3b1e-8829-5dddef13c08e",
                        "glosses": [
                            "Refermer sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4d05059-ecea-49c1-af89-f2999371148a",
                                "sense_id": "883f3ee0-9b4b-360f-bde8-8649df184f53",
                                "text": "Si le capteur ne répond plus, le moteur auto-referme le store dans un délai autour de 40 minutes environ…"
                            },
                            {
                                "example_id": "96127f77-9a8b-4eea-86db-783c2c92d6fe",
                                "sense_id": "883f3ee0-9b4b-360f-bde8-8649df184f53",
                                "text": "Tu peux aussi faire une porte qui s’ouvre en début de partie, une fois FullyOpen elle s’auto-referme et une fois FullyClosed elle se rouvre."
                            },
                            {
                                "example_id": "81373302-6e9c-4fea-b677-9dc06879678a",
                                "sense_id": "883f3ee0-9b4b-360f-bde8-8649df184f53",
                                "text": "Il existe également des gaines tubulaires fendues le long d’un axe longitudinal et qui, suite à un traitement thermique, peuvent s’auto-refermer par recouvrement des bords longitudinaux de la gaine l’un sur l’autre."
                            }
                        ]
                    }
