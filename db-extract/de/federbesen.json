                "senses": [
                    {
                        "sense_id": "9e9ee061-c153-33c6-911a-2542c854092f",
                        "entry_id": "26923048-46f4-30ef-ae6d-8b6d03fdf90f",
                        "glosses": [
                            "Gerät zum Zusammenkehren von Gartenabfällen oder zum Abstauben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9abc60f-6384-4d43-a9d6-34e12667535b",
                                "sense_id": "9e9ee061-c153-33c6-911a-2542c854092f",
                                "text": "„Laub lässt sich am besten mit einem speziellen Laubrechen oder Federbesen zusammenkehren, der aus biegsamen, federnden Metallstreben besteht.“"
                            },
                            {
                                "example_id": "b2123ead-e772-4d50-b320-e4d784479cc2",
                                "sense_id": "9e9ee061-c153-33c6-911a-2542c854092f",
                                "text": "„Er war gewitzigt worden und hatte in der Nähe der Eiche einen Federbesen versteckt gehabt, welchen er jetzt benützte, die Spuren zu verwischen.“"
                            },
                            {
                                "example_id": "0ebe7b0c-8b55-463d-b1f6-36ea93102409",
                                "sense_id": "9e9ee061-c153-33c6-911a-2542c854092f",
                                "text": "„Lene staubte die vergoldeten Bilderrahmen im Zimmer des Hausherren mit dem Federbesen ab.“"
                            },
                            {
                                "example_id": "3cc459e1-2650-408a-9601-6221a58e8180",
                                "sense_id": "9e9ee061-c153-33c6-911a-2542c854092f",
                                "text": "„In diesem Fall sollten Sie das Schnittgut mit einem Federbesen zusammenfegen und entfernten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
