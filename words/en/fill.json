    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a06d2558-dbc0-3198-bd82-ec06650c56dd",
                    "sense_definition": "To make something full by putting contents or substance into it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "make_full",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>filled</w> the glass with cold water.",
                            "target_lang_translations": {
                                "ru": "Она <w>наполнила</w> стакан холодной водой.",
                                "zh": "她把杯子<w>装满</w>了冷水。"
                            }
                        },
                        {
                            "text": "Please <w>fill</w> the tank before you return the car.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>наполните</w> бак, прежде чем вернуть машину.",
                                "zh": "还车前请把油箱<w>加满</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "empty"
                    ],
                    "common_phrases": [
                        "fill with water",
                        "fill the bottle",
                        "fill the tank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо полным, помещая внутрь содержимое или вещество.",
                        "zh": "通过放入内容物或物质使某物变满。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наполнять",
                                "target_lang_sense_clarification": "делать полным"
                            },
                            {
                                "target_lang_word": "заполнять",
                                "target_lang_sense_clarification": "занимать целиком"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装满",
                                "target_lang_sense_clarification": "使容器变满"
                            },
                            {
                                "target_lang_word": "填充",
                                "target_lang_sense_clarification": "填入物质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb98c0ba-90ca-3706-8031-c9fc14e96473",
                    "sense_definition": "To become full of something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "make_full",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bucket <w>filled</w> with rain during the storm.",
                            "target_lang_translations": {
                                "ru": "Ведро <w>наполнилось</w> дождём во время грозы.",
                                "zh": "暴风雨期间，桶里<w>装满</w>了雨水。"
                            }
                        },
                        {
                            "text": "His eyes <w>filled</w> with tears when he heard the news.",
                            "target_lang_translations": {
                                "ru": "Его глаза <w>наполнились</w> слезами, когда он услышал новости.",
                                "zh": "听到这个消息时，他的双眼<w>盈满</w>了泪水。"
                            }
                        }
                    ],
                    "antonyms": [
                        "empty"
                    ],
                    "common_phrases": [
                        "fill with tears",
                        "fill with smoke",
                        "fill up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться полным чего-либо.",
                        "zh": "变得充满某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наполняться",
                                "target_lang_sense_clarification": "становиться полным"
                            },
                            {
                                "target_lang_word": "заполняться",
                                "target_lang_sense_clarification": "занимать пространство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装满",
                                "target_lang_sense_clarification": "变得满"
                            },
                            {
                                "target_lang_word": "充满",
                                "target_lang_sense_clarification": "状态变得饱满"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a1298e4-ad95-31c8-8829-b99169c06aa3",
                    "sense_definition": "To spread throughout and occupy a space, time, or sense completely.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "make_full",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smell of fresh coffee <w>filled</w> the kitchen.",
                            "target_lang_translations": {
                                "ru": "Запах свежего кофе <w>наполнил</w> кухню.",
                                "zh": "新鲜咖啡的香气<w>弥漫</w>在厨房里。"
                            }
                        },
                        {
                            "text": "Loud music <w>filled</w> the air at the festival.",
                            "target_lang_translations": {
                                "ru": "Громкая музыка <w>наполнила</w> воздух на фестивале.",
                                "zh": "节日里，响亮的音乐<w>充斥</w>着空气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pervade",
                        "occupy",
                        "permeate"
                    ],
                    "common_phrases": [
                        "fill the air",
                        "fill the room",
                        "fill the silence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространяться и полностью занимать пространство, время или чувства.",
                        "zh": "扩散并完全占据空间、时间或感官。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заполнять",
                                "target_lang_sense_clarification": "занимать пространство"
                            },
                            {
                                "target_lang_word": "наполнять",
                                "target_lang_sense_clarification": "пропитывать, насыщать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弥漫",
                                "target_lang_sense_clarification": "气味或声音充满空间"
                            },
                            {
                                "target_lang_word": "充满",
                                "target_lang_sense_clarification": "占据空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41561c66-4dad-31a9-b9de-23e295d1043f",
                    "sense_definition": "To repair a hole in a tooth by placing a special substance into it.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dentist had to <w>fill</w> a large cavity in my molar.",
                            "target_lang_translations": {
                                "ru": "Стоматологу пришлось <w>запломбировать</w> большую полость в моем коренном зубе.",
                                "zh": "牙医不得不把我磨牙上的一个大洞<w>补</w>上。"
                            }
                        },
                        {
                            "text": "My tooth still hurts a little where he <w>filled</w> it.",
                            "target_lang_translations": {
                                "ru": "Мой зуб всё ещё немного болит там, где он его <w>запломбировал</w>.",
                                "zh": "他给我<w>补</w>过牙的地方还有点疼。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fill a cavity",
                        "fill a tooth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лечить дырку в зубе, помещая в неё специальное вещество.",
                        "zh": "通过放入特殊物质来修复牙齿上的洞。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пломбировать",
                                "target_lang_sense_clarification": "лечить зуб"
                            },
                            {
                                "target_lang_word": "ставить пломбу",
                                "target_lang_sense_clarification": "процесс лечения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "补牙",
                                "target_lang_sense_clarification": "修复牙齿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a61c565d-e4a4-3561-9b9c-f48f1cfc2200",
                    "sense_definition": "To perform a task, satisfy a need, or supply what is required.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "satisfy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pharmacist will <w>fill</w> your prescription in about ten minutes.",
                            "target_lang_translations": {
                                "ru": "Фармацевт <w>подготовит</w> ваше лекарство по рецепту примерно за десять минут.",
                                "zh": "药剂师大约十分钟后会为你<w>配</w>好药。"
                            }
                        },
                        {
                            "text": "This new community center <w>fills</w> a great need in our neighborhood.",
                            "target_lang_translations": {
                                "ru": "Этот новый общественный центр <w>восполняет</w> огромную потребность в нашем районе.",
                                "zh": "这个新的社区中心<w>满足</w>了我们街区的一大需求。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fill a prescription",
                        "fill a need",
                        "fill a requirement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять задачу, удовлетворять потребность или предоставлять необходимое.",
                        "zh": "执行任务、满足需求或提供所需之物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удовлетворять",
                                "target_lang_sense_clarification": "потребность или запрос"
                            },
                            {
                                "target_lang_word": "выполнять",
                                "target_lang_sense_clarification": "заказ или рецепт"
                            },
                            {
                                "target_lang_word": "восполнять",
                                "target_lang_sense_clarification": "нехватку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "配药",
                                "target_lang_sense_clarification": "按处方准备药物"
                            },
                            {
                                "target_lang_word": "满足",
                                "target_lang_sense_clarification": "满足需求"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0567ab3b-36f1-3d01-85c0-5c6b152012e4",
                    "sense_definition": "To appoint a person to a vacant job or role.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "satisfy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>fill</w> this vacancy as soon as possible.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>заполнить</w> эту вакансию как можно скорее.",
                                "zh": "我们需要尽快<w>填补</w>这个空缺职位。"
                            }
                        },
                        {
                            "text": "The manager position has already been <w>filled</w> by an internal candidate.",
                            "target_lang_translations": {
                                "ru": "Должность менеджера уже <w>занята</w> внутренним кандидатом.",
                                "zh": "经理职位已经由内部候选人<w>担任</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fill a vacancy",
                        "fill a position",
                        "fill a post"
                    ],
                    "target_lang_definitions": {
                        "ru": "Назначать человека на вакантную должность или роль.",
                        "zh": "任命某人担任空缺的职位或角色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заполнять",
                                "target_lang_sense_clarification": "вакансию"
                            },
                            {
                                "target_lang_word": "занимать",
                                "target_lang_sense_clarification": "должность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "填补",
                                "target_lang_sense_clarification": "填补空缺"
                            },
                            {
                                "target_lang_word": "担任",
                                "target_lang_sense_clarification": "占据职位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08b474d8-b31f-3cf1-a26a-7003c3339ffc",
                    "sense_definition": "To supply with food to the point of satisfaction.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "satisfy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy meal <w>filled</w> us so much that we skipped dinner.",
                            "target_lang_translations": {
                                "ru": "Тяжёлая еда <w>насытила</w> нас настолько, что мы пропустили ужин.",
                                "zh": "那顿大餐让我们吃得太饱，以至于我们没吃晚饭。"
                            }
                        },
                        {
                            "text": "Potatoes are cheap and they <w>fill</w> the stomach quickly.",
                            "target_lang_translations": {
                                "ru": "Картошка дешёвая и быстро <w>наполняет</w> желудок.",
                                "zh": "土豆很便宜，而且能很快<w>填饱</w>肚子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fill the stomach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабжать едой до состояния сытости.",
                        "zh": "提供食物直到满足。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насыщать",
                                "target_lang_sense_clarification": "утолять голод"
                            },
                            {
                                "target_lang_word": "наполнять",
                                "target_lang_sense_clarification": "желудок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "填饱",
                                "target_lang_sense_clarification": "使胃部饱足"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "385c3975-b4c9-3a00-a560-e4d8d067e242",
                    "sense_definition": "A sufficient or more than sufficient amount of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children ate their <w>fill</w> of cake and ice cream.",
                            "target_lang_translations": {
                                "ru": "Дети наелись торта и мороженого <w>вдоволь</w>.",
                                "zh": "孩子们把蛋糕和冰淇淋吃了个<w>够</w>。"
                            }
                        },
                        {
                            "text": "I have had my <w>fill</w> of his constant complaints.",
                            "target_lang_translations": {
                                "ru": "С меня <w>хватит</w> его постоянных жалоб.",
                                "zh": "我受够了他没完没了的抱怨。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "eat one's fill",
                        "have one's fill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достаточное или более чем достаточное количество чего-либо.",
                        "zh": "足够或超过足够的量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдоволь",
                                "target_lang_sense_clarification": "достаточное количество"
                            },
                            {
                                "target_lang_word": "досыта",
                                "target_lang_sense_clarification": "до полного насыщения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "足够",
                                "target_lang_sense_clarification": "满足需求的量"
                            },
                            {
                                "target_lang_word": "饱",
                                "target_lang_sense_clarification": "吃得满足"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1e89247-fc60-3d88-bb9a-6aa89a62650f",
                    "sense_definition": "Material used to occupy empty spaces, especially in construction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They used gravel as <w>fill</w> for the foundation of the new road.",
                            "target_lang_translations": {
                                "ru": "Они использовали гравий как <w>насыпь</w> для фундамента новой дороги.",
                                "zh": "他们用碎石作为新路地基的<w>填料</w>。"
                            }
                        },
                        {
                            "text": "The construction crew brought in several trucks of clean <w>fill</w>.",
                            "target_lang_translations": {
                                "ru": "Строительная бригада привезла несколько грузовиков чистого <w>грунта</w>.",
                                "zh": "施工队运来了几卡车干净的<w>回填土</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "land fill",
                        "loose fill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Материал, используемый для заполнения пустот, особенно в строительстве.",
                        "zh": "用于填充空隙的材料，常用于建筑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насыпь",
                                "target_lang_sense_clarification": "земляное сооружение"
                            },
                            {
                                "target_lang_word": "грунт",
                                "target_lang_sense_clarification": "земля для засыпки"
                            },
                            {
                                "target_lang_word": "заполнитель",
                                "target_lang_sense_clarification": "строительный материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "填料",
                                "target_lang_sense_clarification": "填充材料"
                            },
                            {
                                "target_lang_word": "回填土",
                                "target_lang_sense_clarification": "建筑回填用土"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1157246e-507e-38fb-ba80-1294721bdfaf",
                    "sense_definition": "A short musical passage or riff played between phrases of a melody.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drummer played a complex <w>fill</w> before the chorus started.",
                            "target_lang_translations": {
                                "ru": "Барабанщик сыграл сложную <w>сбивку</w> перед началом припева.",
                                "zh": "副歌开始前，鼓手打了一段复杂的<w>加花</w>。"
                            }
                        },
                        {
                            "text": "He added a guitar <w>fill</w> to make the transition smoother.",
                            "target_lang_translations": {
                                "ru": "Он добавил гитарную <w>вставку</w>, чтобы сделать переход более плавным.",
                                "zh": "他加了一段吉他<w>过门</w>，使过渡更平滑。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drum fill",
                        "bass fill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий музыкальный пассаж, исполняемый между фразами мелодии.",
                        "zh": "在旋律乐句之间演奏的短小乐段或即兴演奏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбивка",
                                "target_lang_sense_clarification": "барабанная"
                            },
                            {
                                "target_lang_word": "вставка",
                                "target_lang_sense_clarification": "музыкальная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "过门",
                                "target_lang_sense_clarification": "乐句间的过渡"
                            },
                            {
                                "target_lang_word": "加花",
                                "target_lang_sense_clarification": "鼓点或乐器的装饰性填充"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "731c45fb-c4fc-3984-8bb5-6ded6a1ccf1e",
                    "sense_definition": "A surname transferred from the given name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Fill</w> was known for his contributions to the local library.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Филл</w> был известен своим вкладом в местную библиотеку.",
                                "zh": "<w>菲尔</w>先生以对当地图书馆的贡献而闻名。"
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Fill</w> at the conference.",
                            "target_lang_translations": {
                                "ru": "Я встретил женщину по имени Сара <w>Филл</w> на конференции.",
                                "zh": "我在会议上遇到了一位名叫莎拉·<w>菲尔</w>的女士。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, образованная от личного имени.",
                        "zh": "源自名字的姓氏。"
                    },
