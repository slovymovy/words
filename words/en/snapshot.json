{
    "word_family": [
        "snap",
        "shot",
        "snappy",
        "shooter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03abf282-e83c-3839-82bb-982d87e61b2a",
                    "sense_definition": "A photograph, especially one taken quickly or in a sudden moment of opportunity.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carried a small <w>snapshot</w> of his daughter in his wallet.",
                            "target_lang_translations": {
                                "ru": "Он носил в кошельке маленький <w>снимок</w> своей дочери."
                            }
                        },
                        {
                            "text": "I took a quick <w>snapshot</w> of the sunset before the light faded.",
                            "target_lang_translations": {
                                "ru": "Я быстро сделал <w>кадр</w> заката, пока свет не погас."
                            }
                        }
                    ],
                    "synonyms": [
                        "photo",
                        "photograph",
                        "picture",
                        "snap"
                    ],
                    "common_phrases": [
                        "quick snapshot",
                        "family snapshot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фотография, сделанная быстро или в момент удачной возможности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снимок",
                                "target_lang_sense_clarification": "фотографическое изображение"
                            },
                            {
                                "target_lang_word": "кадр",
                                "target_lang_sense_clarification": "отдельный снимок"
                            },
                            {
                                "target_lang_word": "фото",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9ef134f-6210-3a32-a27c-0d31eec99b23",
                    "sense_definition": "A brief look or portrayal of a situation at a specific moment in time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overview",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The article offered a <w>snapshot</w> of life in that remote region.",
                            "target_lang_translations": {
                                "ru": "Статья предложила краткий <w>обзор</w> жизни в том отдаленном регионе."
                            }
                        },
                        {
                            "text": "This report provides a <w>snapshot</w> of the current economic climate.",
                            "target_lang_translations": {
                                "ru": "Этот отчет дает <w>срез</w> текущего экономического климата."
                            }
                        }
                    ],
                    "synonyms": [
                        "glimpse",
                        "overview",
                        "summary",
                        "profile"
                    ],
                    "common_phrases": [
                        "statistical snapshot",
                        "brief snapshot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткий обзор или описание ситуации в конкретный момент времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обзор",
                                "target_lang_sense_clarification": "краткое описание ситуации"
                            },
                            {
                                "target_lang_word": "срез",
                                "target_lang_sense_clarification": "состояние на текущий момент"
                            },
                            {
                                "target_lang_word": "картина",
                                "target_lang_sense_clarification": "общее представление о ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05796a47-9b6d-30a2-baae-9a28c3068a96",
                    "sense_definition": "A record of the state of a computer system or database at a particular point in time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system administrator took a <w>snapshot</w> of the server before the update.",
                            "target_lang_translations": {
                                "ru": "Системный администратор сделал <w>снапшот</w> сервера перед обновлением."
                            }
                        },
                        {
                            "text": "You can restore your files from a previous <w>snapshot</w> if the data is corrupted.",
                            "target_lang_translations": {
                                "ru": "Вы можете восстановить свои файлы из предыдущего <w>образа</w>, если данные повреждены."
                            }
                        }
                    ],
                    "synonyms": [
                        "backup",
                        "image",
                        "capture"
                    ],
                    "common_phrases": [
                        "system snapshot",
                        "database snapshot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запись состояния компьютерной системы или базы данных в определенный момент времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снапшот",
                                "target_lang_sense_clarification": "технический термин в ИТ"
                            },
                            {
                                "target_lang_word": "мгновенный снимок",
                                "target_lang_sense_clarification": "состояние системы или данных"
                            },
                            {
                                "target_lang_word": "образ",
                                "target_lang_sense_clarification": "копия состояния системы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ec61de0-a66f-33a0-85d7-0182311576db",
                    "sense_definition": "A quick, unplanned shot in sports or hunting, made without taking careful aim.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shooting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker's <w>snapshot</w> from the edge of the box went just wide.",
                            "target_lang_translations": {
                                "ru": "Быстрый <w>удар</w> нападающего с края штрафной прошел чуть мимо ворот."
                            }
                        },
                        {
                            "text": "He missed the target with a hurried <w>snapshot</w> as the deer ran past.",
                            "target_lang_translations": {
                                "ru": "Он промахнулся, сделав поспешный <w>выстрел навскидку</w>, когда олень пробегал мимо."
                            }
                        }
                    ],
                    "common_phrases": [
                        "point-blank snapshot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый, незапланированный выстрел в спорте или на охоте, сделанный без тщательного прицеливания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выстрел навскидку",
                                "target_lang_sense_clarification": "без долгого прицеливания"
                            },
                            {
                                "target_lang_word": "быстрый удар",
                                "target_lang_sense_clarification": "в спорте, например в хоккее"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a85a3bf1-4e46-36a8-a46c-fe80ffbc7b9b",
                    "sense_definition": "To take a photograph of someone or something quickly.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>snapshotted</w> the deer before it disappeared into the woods.",
                            "target_lang_translations": {
                                "ru": "Я <w>сфотографировал</w> оленя до того, как он скрылся в лесу."
                            }
                        },
                        {
                            "text": "She was busy <w>snapshotting</w> the street performers during her vacation.",
                            "target_lang_translations": {
                                "ru": "Во время отпуска она была занята тем, что <w>щелкала</w> уличных артистов."
                            }
                        }
                    ],
                    "synonyms": [
                        "photograph",
                        "snap",
                        "capture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро сфотографировать кого-либо или что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать снимок",
                                "target_lang_sense_clarification": "фотографировать"
                            },
                            {
                                "target_lang_word": "щелкнуть",
                                "target_lang_sense_clarification": "разговорное о фото"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d46eaefb-7bd3-31b7-88c1-c84c4215caa2",
                    "sense_definition": "To capture and save the current state of a computer system or data.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software is designed for <w>snapshotting</w> virtual machines automatically.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение предназначено для автоматического <w>создания снапшотов</w> виртуальных машин."
                            }
                        },
                        {
                            "text": "We <w>snapshotted</w> the database right before the migration started.",
                            "target_lang_translations": {
                                "ru": "Мы <w>зафиксировали состояние</w> базы данных прямо перед началом миграции."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Захватить и сохранить текущее состояние компьютерной системы или данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать снапшот",
                                "target_lang_sense_clarification": "сохранять состояние системы"
                            },
                            {
                                "target_lang_word": "снимать образ",
                                "target_lang_sense_clarification": "фиксировать данные"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}