                                "example_id": "2f934078-b69e-4453-9012-da051c2ffd25",
                                "sense_id": "d2caec8f-fbf9-3cba-85b8-9e9cd9476fd6",
                                "text": "De reizen van Christoffel Columbus zijn de bekendste ontdekkingsreizen."
                            }
                        ]
