                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a590a38-16ef-4191-9956-0d0630fbf09f",
                                "sense_id": "3f6c627c-9de2-3269-ae94-73cc151335b6",
                                "text": "„Neuer Markt setzt Rekordserie mit gewaltigen Kurssprüngen fort“."
                            },
                            {
                                "example_id": "eb967b3e-747c-439b-8d39-dff7a2588e76",
                                "sense_id": "3f6c627c-9de2-3269-ae94-73cc151335b6",
                                "text": "„Patrick Hausding (Berlin) und Sascha Klein (Dresden) haben bei der Heim-EM in Rostock ihre Rekordserie vom Turm fortgesetzt und im Synchronwettbewerb ihr sechstes Gold in Folge gewonnen.“"
                            },
                            {
                                "example_id": "92305f2f-e8f4-4f59-b238-29b78b7b9c9d",
                                "sense_id": "3f6c627c-9de2-3269-ae94-73cc151335b6",
                                "text": "„Die Egalisierung der Rekordserie von fünf Titeln für Schumacher im Ferrari von 2000 bis 2004 dürfte Vettel noch mehr anspornen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
