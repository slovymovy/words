                "senses": [
                    {
                        "sense_id": "db736bc7-139c-30bf-94ca-f30508c034d0",
                        "entry_id": "b8accd6c-7e51-3a8c-8591-95a9abf8b513",
                        "glosses": [
                            "Computersicherheits-Ereignis- und ReaktionsTeam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f1d916b-7156-41a2-a30c-07e7de0a8039",
                                "sense_id": "db736bc7-139c-30bf-94ca-f30508c034d0",
                                "text": "Von der Öffentlichkeit noch relativ wenig beachtet, sind die deutschen CERTs enger zusammen gerückt."
                            },
                            {
                                "example_id": "0caa699a-141a-44af-9b02-147ba0f0ba98",
                                "sense_id": "db736bc7-139c-30bf-94ca-f30508c034d0",
                                "text": "Im November 2011 wurde der österreichische CERT-Verbund – eine Kooperation der österreichischen CERTs – ins Leben gerufen."
                            },
                            {
                                "example_id": "bd27185d-3d03-41e5-b793-84407ba19e21",
                                "sense_id": "db736bc7-139c-30bf-94ca-f30508c034d0",
                                "text": "Die Hauptaufgaben des Austrian Energy CERTs dienen der Stärkung der IT-Sicherheitskompetenz des Energiesektors."
                            },
                            {
                                "example_id": "d62d205b-8738-4e2f-b1f3-514b52920aa8",
                                "sense_id": "db736bc7-139c-30bf-94ca-f30508c034d0",
                                "text": "Siemens CERT ist ein dediziertes Team von Security-Experten mit der Mission die Siemens Infrastruktur abzusichern."
                            },
                            {
                                "example_id": "d8e9970e-e2a3-41f6-b8ac-643eeb32fe65",
                                "sense_id": "db736bc7-139c-30bf-94ca-f30508c034d0",
                                "text": "Allerdings betont er, dass Microsoft User wenigstens warnen und vorerst auf den vom CERT Bund empfohlenen Workaround hinweisen sollte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
