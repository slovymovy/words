                "senses": [
                    {
                        "sense_id": "f8910ff7-09e1-3940-867b-061b0ddae69e",
                        "entry_id": "957d6c83-d7bb-34e2-989d-ed03e5791d3b",
                        "glosses": [
                            "Bewohner der antiken Stadt Kolossä"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18a62cb4-639e-44bd-8691-d5b8212dea23",
                                "sense_id": "f8910ff7-09e1-3940-867b-061b0ddae69e",
                                "text": "Daß Paulus hier von denen, die er nicht kennt, zu den Kolossern in der dritten Person redet, scheint nur ein geringer Einwand, da die kolossische Gemeinde gegen die Menge der übrigen, die sich in demselben Falle befanden, beinahe verschwand."
                            },
                            {
                                "example_id": "c38b9779-5a49-492a-8287-67466215ff67",
                                "sense_id": "f8910ff7-09e1-3940-867b-061b0ddae69e",
                                "text": "„Die Kolosser waren von einer Lehre bedroht, in der sich judaistisches Gedankengut mit heidnischen Glaubenselementen vermischte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ca12adae-369e-36de-b826-d2ae3ca143fa",
                        "entry_id": "957d6c83-d7bb-34e2-989d-ed03e5791d3b",
                        "glosses": [
                            "Brief des Paulus an die Kolosser, einem Bestandteil des Neuen Testaments der Bibel"
                        ],
                        "tags": [
                            "no-plural",
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "0eaa5650-0141-4669-a967-9d77416eeb80",
                                "sense_id": "ca12adae-369e-36de-b826-d2ae3ca143fa",
                                "text": "Paulus schreibt im Kolosser 1,13: „Er hat uns gerettet aus der Macht der Finsternis.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
