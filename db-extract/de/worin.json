                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e6d45a7-c3a9-48ff-95b0-7de7c8f700c5",
                                                "sense_id": "12c94dc1-8fb5-36f3-9a12-ce8821a2310b",
                                                "text": "[T]here is a time wherein one man ruleth ouer another to his owne hurt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9d6d322-612a-37f2-8fb8-5031be114e45",
                                        "entry_id": "a30f983b-503a-35aa-bc17-18969ffc0502",
                                        "glosses": [
                                            "How, or in what way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa20011b-6d9c-4ecf-ac96-e44ac3757647",
                                                "sense_id": "f9d6d322-612a-37f2-8fb8-5031be114e45",
                                                "text": "In order to show them wherein they were wrong, Samuel was instructed to bear witness against them […]"
                                            }
                                        ]
