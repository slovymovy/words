                    {
                        "form_id": "cca2b5a1-e410-4f9c-86d4-686b1a5dd1c7",
                        "entry_id": "bd6c78c2-3e0c-3d4d-9f0a-110ab3717a78",
                        "tags": [
                            "masculine"
                        ],
                        "form": "écouteur"
