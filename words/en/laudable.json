                    "sense_id": "4093f233-f68d-396d-8a4b-5992faa592d1",
                    "sense_definition": "Worthy of praise or approval.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student made a <w>laudable</w> effort to improve her grades before the final exam.",
                            "target_lang_translations": {
                                "zh": "这位学生在期末考试前做出了<w>值得称赞的</w>努力来提高成绩。"
                            }
                        },
                        {
                            "text": "His <w>laudable</w> ambition to help the community earned him great respect from his neighbors.",
                            "target_lang_translations": {
                                "zh": "他帮助社区的<w>可嘉</w>志向赢得了邻居们的极大尊重。"
                            }
                        }
                    ],
                    "synonyms": [
                        "praiseworthy",
                        "commendable"
                    ],
                    "common_phrases": [
                        "laudable ambition",
                        "laudable effort"
                    ],
                    "target_lang_definitions": {
                        "zh": "值得称赞或赞许的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "值得称赞的",
                                "target_lang_sense_clarification": "形容行为或努力值得被表扬。"
                            },
                            {
                                "target_lang_word": "可嘉的",
                                "target_lang_sense_clarification": "书面语，常用于形容勇气或努力。"
                            }
