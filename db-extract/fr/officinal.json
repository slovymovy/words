                    {
                        "sense_id": "72cf0f6a-4e8c-3ff8-948a-131ed851b227",
                        "entry_id": "16660da2-6156-332a-942a-4fc62360f6b2",
                        "glosses": [
                            "Médicinal, pharmaceutique."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "0c501825-44e7-4697-8594-91a59c6ce6cc",
                                "sense_id": "72cf0f6a-4e8c-3ff8-948a-131ed851b227",
                                "text": "Plante officinale."
                            },
                            {
                                "example_id": "336b849b-e482-49be-89bd-58e1c33df11e",
                                "sense_id": "72cf0f6a-4e8c-3ff8-948a-131ed851b227",
                                "text": "Préparations officinales."
                            }
                        ]
                    },
                    {
                        "sense_id": "05fcaaa8-ff90-3ace-8434-4f1078de2b4d",
                        "entry_id": "16660da2-6156-332a-942a-4fc62360f6b2",
                        "glosses": [
                            "Relatif à l'officine."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "17a94083-f362-3dc4-8e73-194b11d9eaa3",
                        "entry_id": "16660da2-6156-332a-942a-4fc62360f6b2",
                        "glosses": [
                            "Se dit d'un médicament qui est préparé à l'avance, par l'industrie pharmaceutique et non à la pharmacie, par un pharmacien ou un préparateur, comme celui que l'on nomme par opposition magistral."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "b4880cda-49cc-46e3-a95d-a531575f7dd0",
                                "sense_id": "17a94083-f362-3dc4-8e73-194b11d9eaa3",
                                "text": "Le médecin qui prescrit un médicament officinal n'a pas à indiquer sur son ordonnance la formule de ce médicament ; il lui suffit d'inscrire le nom officinal du médicament et d'en fixer la dose et le mode d'emploi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "539e3b9e-8f54-4767-a401-eb545ce6dd23",
                        "source_entry_id": "16660da2-6156-332a-942a-4fc62360f6b2",
                        "target_lang_word": "offizinell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "offizinell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d62da14-6edd-34be-a38f-0be6ff3a2d15",
                                        "entry_id": "b41e9f72-9846-3b14-a15e-412bb902ff16",
                                        "glosses": [
                                            "als Arzneimittel geeignet, als Arzneimittel anerkannt, als Arzneimittel zugelassen, als Arzneimittel verwendet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b464e9c4-4f2a-429c-ad5a-d64f206de5dd",
                                                "sense_id": "4d62da14-6edd-34be-a38f-0be6ff3a2d15",
                                                "text": "In Nordamerika ist die Rinde der Virginischen Kornelkirsche als Cortex Corni floridae offizinell."
                                            },
                                            {
                                                "example_id": "fb391808-83ca-4be0-b366-5a526e47b9f0",
                                                "sense_id": "4d62da14-6edd-34be-a38f-0be6ff3a2d15",
                                                "text": "„Aus der spanischen Fliege, einem Käfer, der zu den Forstschädlingen gehört, wird durch Ausziehn mit Chloroform eine organische Substanz, das Kantharidin, gewonnen, die offizinell ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37230966-a2ec-416e-9309-e5d4586b8396",
                        "source_entry_id": "16660da2-6156-332a-942a-4fc62360f6b2",
                        "target_lang_word": "officinal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "officinal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3721855-76fa-39a2-88d1-97428b798fc3",
                                        "entry_id": "5d0ba08c-f300-3305-922d-10f5deec5623",
                                        "glosses": [
                                            "Medicinal."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44b8464d-395e-4514-8ef0-44f036790185",
                                                "sense_id": "a3721855-76fa-39a2-88d1-97428b798fc3",
                                                "text": "The leaves are the officinal part;"
                                            },
                                            {
                                                "example_id": "e74448c7-8052-4497-9794-239ef9669604",
                                                "sense_id": "a3721855-76fa-39a2-88d1-97428b798fc3",
                                                "text": "She was the compound extract of all that was chemically pure and officinal—the dispensary contained nothing equal to her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fe0f39b-ed0a-363d-9d29-1ee3119e227f",
                                        "entry_id": "5d0ba08c-f300-3305-922d-10f5deec5623",
                                        "glosses": [
                                            "Used in a shop, or belonging to it."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "230073e7-1f42-4419-a403-4c7ee00634d3",
                                                "sense_id": "7fe0f39b-ed0a-363d-9d29-1ee3119e227f",
                                                "text": "In this Part of the Town, are also three Convents, seventeen Churches, an Academy, a Printing-House, a Library, the Mint, and the Grand Dispensatory, which last is a very magnificent Building, and the Officinal Furniture is very rich, for the Pots are all of China, and the Glasses Chrystal."
                                            },
                                            {
                                                "example_id": "272a91d5-524a-4c11-92b3-ba1b6b962619",
                                                "sense_id": "7fe0f39b-ed0a-363d-9d29-1ee3119e227f",
                                                "text": "Dr. Kaempfer further observes, that the quantity of Varnish obtained from this officinal Anacardium tree is so great, as not only to serve to vernish all the untensils of China, Tonquin, and Japan, but that it is exported in wooden vessels to Batavia, and several other parts of India."
                                            },
                                            {
                                                "example_id": "f266e94a-a4c4-4eca-896e-2416657a786f",
                                                "sense_id": "7fe0f39b-ed0a-363d-9d29-1ee3119e227f",
                                                "text": "Millepora polymorpha: British officinal Coral. […] This is the Coral of the Shops, and is found in great plenty in the seas round these islands, especially near Falmouth, and the Isle of Man."
                                            },
                                            {
                                                "example_id": "94c4916d-502f-490d-a296-773866956027",
                                                "sense_id": "7fe0f39b-ed0a-363d-9d29-1ee3119e227f",
                                                "text": "I had always, in my officinal state, been kept in awe by lace and embroidery; and imagined that to fright away these unwelcome familiarities, nothing was necessary, but that I should, by splendour of dress, proclaim my reunion with a higher rank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a490afc-3d88-3233-a06d-50dbc519e2cc",
                                        "entry_id": "5d0ba08c-f300-3305-922d-10f5deec5623",
                                        "glosses": [
                                            "Kept in stock by apothecaries; said of such drugs and medicines as may be obtained without special preparation or compounding; not magistral."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
