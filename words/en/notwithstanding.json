{
    "word_family": [],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "e1d7b705-7427-31bb-833b-b45c28d6a7e9",
                    "sense_definition": "In spite of; despite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Notwithstanding</w> the bad weather, they decided to go ahead with the outdoor event. ",
                            "target_lang_translations": {
                                "tr": "Kötü havaya <w>rağmen</w>, açık hava etkinliğini gerçekleştirmeye karar verdiler."
                            }
                        },
                        {
                            "text": "He succeeded in finishing the marathon <w>notwithstanding</w> his severe injury.",
                            "target_lang_translations": {
                                "tr": "Ciddi yaralanmasına <w>rağmen</w> maratonu bitirmeyi başardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "regardless of"
                    ],
                    "common_phrases": [
                        "notwithstanding the fact"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir duruma, engellemeye veya olumsuzluğa bakılmaksızın; -e rağmen, -e karşın."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "-e rağmen",
                                "target_lang_sense_clarification": "bir engel veya olumsuzluğa bakılmaksızın"
                            },
                            {
                                "target_lang_word": "-e karşın",
                                "target_lang_sense_clarification": "bir duruma rağmen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ca7e171d-45b1-31dc-a9a4-e1368f4eb285",
                    "sense_definition": "Nevertheless; in spite of that; all the same.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The task was difficult; he, <w>notwithstanding</w>, persisted until it was finished.",
                            "target_lang_translations": {
                                "tr": "Görev zordu; <w>buna rağmen</w> bitene kadar sebat etti."
                            }
                        },
                        {
                            "text": "The evidence against him was strong; <w>notwithstanding</w>, he maintained his innocence.",
                            "target_lang_translations": {
                                "tr": "Aleyhindeki kanıtlar güçlüydü; <w>yine de</w> masum olduğunu savundu."
                            }
                        }
                    ],
                    "synonyms": [
                        "nevertheless",
                        "nonetheless",
                        "still",
                        "anyway",
                        "after all",
                        "regardless",
                        "yet"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yine de, buna rağmen, buna karşın."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "buna rağmen",
                                "target_lang_sense_clarification": "yine de, buna karşılık"
                            },
                            {
                                "target_lang_word": "yine de",
                                "target_lang_sense_clarification": "her şeye rağmen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "c5e29b85-5cea-35d2-b3d3-6880f8e2548a",
                    "sense_definition": "Although; even though.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They continued their journey, <w>notwithstanding</w> that it was getting dark.",
                            "target_lang_translations": {
                                "tr": "Hava kararmakta <w>olduğu halde</w> yolculuklarına devam ettiler."
                            }
                        },
                        {
                            "text": "She was accepted into the university, <w>notwithstanding</w> that her test scores were slightly low.",
                            "target_lang_translations": {
                                "tr": "Sınav puanları biraz düşük <w>olmasına rağmen</w> üniversiteye kabul edildi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "notwithstanding that"
                    ],
                    "target_lang_definitions": {
                        "tr": "-dığı halde, olmasına rağmen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "olmasına rağmen",
                                "target_lang_sense_clarification": "-dığı halde"
                            },
                            {
                                "target_lang_word": "olduğu halde",
                                "target_lang_sense_clarification": "-masına karşın"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}