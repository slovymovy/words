                                    {
                                        "sense_id": "51fd9a4d-2cc5-3467-b13a-a989118a0873",
                                        "entry_id": "2010b098-402d-3724-ae74-60501f1c3e5e",
                                        "glosses": [
                                            "Late or failing to pay a debt or other financial obligation, like a mortgage or loan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c10123bf-5b9c-4e6c-98c7-d79d9963f1fb",
                                                "sense_id": "51fd9a4d-2cc5-3467-b13a-a989118a0873",
                                                "text": "Fred is delinquent in making his car payment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a25c0ac0-38fd-39b6-b50f-6a654fca7b58",
                                        "entry_id": "2010b098-402d-3724-ae74-60501f1c3e5e",
                                        "glosses": [
                                            "Of a payment or other financial obligation: late or otherwise unfulfilled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae781f69-de31-4be2-aa6a-13a31025f2d7",
                                                "sense_id": "a25c0ac0-38fd-39b6-b50f-6a654fca7b58",
                                                "text": "The company made a new effort to collect delinquent payments."
                                            },
                                            {
                                                "example_id": "23b18011-22c2-49e6-a607-cd46fb35a627",
                                                "sense_id": "a25c0ac0-38fd-39b6-b50f-6a654fca7b58",
                                                "text": "The station's financial difficulties came to a head last week when the Internal Revenue Service had its bank accounts frozen as a result of delinquent taxes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c3d431b-5881-39e2-99f4-0fcf36b9dc87",
                                        "entry_id": "2010b098-402d-3724-ae74-60501f1c3e5e",
                                        "glosses": [
                                            "Failing in or neglectful of a duty or obligation; guilty of a misdeed or offense"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "delinquent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1444af4a-86f8-3f2f-9e34-33a21ffbf042",
                                        "entry_id": "d8df0928-5ce1-396b-a369-d00d8142e8d6",
                                        "glosses": [
                                            "One who disobeys or breaks rules or laws, or who acts against another's wishes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "296e3274-829f-4614-980f-c33d52a834b9",
                                                "sense_id": "1444af4a-86f8-3f2f-9e34-33a21ffbf042",
                                                "text": "She had the consolation of knowing that any offence given to her dignity could be avenged on the delinquent who caused it, an act of justice which could not fail to be consolatory, since every one of her daughters had at times stood in stead of \"guid King James's whipping-boy,\" when circumstances arose to disturb the equanimity of Lady Anne's imperious and irascible temper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87f9567e-84a1-3aca-9002-278b5585fc16",
                                        "entry_id": "d8df0928-5ce1-396b-a369-d00d8142e8d6",
                                        "glosses": [
                                            "A person who has not paid their debts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85c20e18-bac9-3790-8188-4c7f172a7b91",
                                        "entry_id": "d8df0928-5ce1-396b-a369-d00d8142e8d6",
                                        "glosses": [
                                            "A royalist in the First English Civil War (1642-1646)."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1181718-dc24-49da-b9cb-9ce714964b7a",
                        "source_entry_id": "1a8dcc78-4b20-380d-adce-12f4616f3280",
                        "source_sense_id": "ef8e92a8-61d7-393f-806b-89cceb48eb45",
                        "source_sense_description": "weibliche Person, die eine durch ein Strafgesetz mit Strafe bedrohte Handlung begeht",
                        "target_lang_word": "criminal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "criminal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55b6cd5a-e2d8-312f-afae-dfe9b0969c8c",
                                        "entry_id": "ddc6f5d0-7173-3382-af3f-b7ba678931cd",
                                        "glosses": [
                                            "Against the law; forbidden by law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f7d501-5a7f-43a1-9886-32954ba41e3a",
                                                "sense_id": "55b6cd5a-e2d8-312f-afae-dfe9b0969c8c",
                                                "text": "Foppish and fantastic ornaments are only indications of vice, not criminal in themselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa93c8a7-f2ca-3a4b-bd5d-3de22a58d445",
                                        "entry_id": "ddc6f5d0-7173-3382-af3f-b7ba678931cd",
                                        "glosses": [
                                            "Guilty of breaking the law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aed011c3-7ef0-41d1-8e54-a456f52a665e",
                                                "sense_id": "aa93c8a7-f2ca-3a4b-bd5d-3de22a58d445",
                                                "text": "The neglect of any of the relative duties renders us criminal in the sight of God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c40ba212-245f-30a8-85d7-01d38c09cc12",
                                        "entry_id": "ddc6f5d0-7173-3382-af3f-b7ba678931cd",
                                        "glosses": [
                                            "Of or relating to crime or penal law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80a41cd0-17e0-4b42-a100-93ba91cf7d56",
                                                "sense_id": "c40ba212-245f-30a8-85d7-01d38c09cc12",
                                                "text": "His long criminal record suggests that he is a dangerous man."
                                            },
                                            {
                                                "example_id": "9f9a7a7e-0711-4584-9ccf-30b0848b410a",
                                                "sense_id": "c40ba212-245f-30a8-85d7-01d38c09cc12",
                                                "text": "The officers and servants of the crown, violating the personal liberty, or other right of the subject […] in some cases, were liable to criminal process."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fbee928-c0c1-3e1c-80ee-3f7d179d178e",
                                        "entry_id": "ddc6f5d0-7173-3382-af3f-b7ba678931cd",
                                        "glosses": [
                                            "Abhorrent or very undesirable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fae899eb-eafa-49ee-8cc3-93e4f1efa7b5",
                                                "sense_id": "0fbee928-c0c1-3e1c-80ee-3f7d179d178e",
                                                "text": "Printing such asinine opinions is criminal!"
                                            },
                                            {
                                                "example_id": "10389080-f78b-44ee-b222-6f23db83449c",
                                                "sense_id": "0fbee928-c0c1-3e1c-80ee-3f7d179d178e",
                                                "text": "[...] I think it represents exceptional value for money and I think it would be criminal not to go ahead and build it.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "criminal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "baf43a50-e9c6-345d-9f2d-955a6704586f",
                                        "entry_id": "b1231746-5138-34b3-93e1-19bbb808e638",
                                        "glosses": [
                                            "A person who is guilty of a crime, notably breaking the law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36460d70-34bf-47f2-b5c0-011db40d8924",
                                                "sense_id": "baf43a50-e9c6-345d-9f2d-955a6704586f",
                                                "text": "‘[…] There's every Staffordshire crime-piece ever made in this cabinet, and that's unique. The Van Hoyer Museum in New York hasn't that very rare second version of Maria Marten's Red Barn over there, nor the little Frederick George Manning—he was the criminal Dickens saw hanged on the roof of the gaol in Horsemonger Lane, by the way—’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
