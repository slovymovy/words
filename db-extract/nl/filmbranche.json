                                "example_id": "cd367d2b-7a78-457b-8121-a76a358892a4",
                                "sense_id": "1bb47b7e-2614-34b2-897c-64119ad86f43",
                                "text": "Hij wil binnenkort gaan praten met de filmbranche en internetproviders over voorlichting en handhaving van het auteursrecht."
                            },
                            {
                                "example_id": "9cfaab81-8b60-44e1-abc5-154ab69bd860",
                                "sense_id": "1bb47b7e-2614-34b2-897c-64119ad86f43",
                                "text": "Nederlandse filmproducenten willen een schadevergoeding van ruim 1 miljard euro van de Nederlandse staat. Dat bedrag zijn ze naar eigen zeggen misgelopen door illegale downloads. Volgens de filmbranche is de staat daar verantwoordelijk voor."
                            },
                            {
                                "example_id": "ccef2632-74d8-48a0-a25b-96f83cfb57cf",
                                "sense_id": "1bb47b7e-2614-34b2-897c-64119ad86f43",
                                "text": "Mensen die films uit illegale bronnen downloaden, moeten een brief of mail krijgen waarin ze op hun gedrag worden gewezen. Dat vindt de Nederlandse filmbranche."
                            }
                        ]
