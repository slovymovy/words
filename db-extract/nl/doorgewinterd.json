                                        "examples": [
                                            {
                                                "example_id": "5e36e7b9-58e5-4c80-9b67-41f9469ecf64",
                                                "sense_id": "d20587de-2e07-3a33-9312-215331ea9245",
                                                "text": "Der Schauspieler war routiniert genug sich nicht aus der Fassung bringen zu lassen."
                                            },
                                            {
                                                "example_id": "b9bfd6c8-4086-43d7-8514-187435ba9447",
                                                "sense_id": "d20587de-2e07-3a33-9312-215331ea9245",
                                                "text": "In einem am Montag veröffentlichten Bericht wurden die Abschiebungen als \"geordnet und routiniert\" bezeichnet."
                                            },
                                            {
                                                "example_id": "1220a163-2037-45bf-ba94-1926d23a4267",
                                                "sense_id": "d20587de-2e07-3a33-9312-215331ea9245",
                                                "text": "Wir sind zu routiniert. Wir müssten uns viel mehr Gedanken machen, wie wir aus unseren bekannten Mustern ausbrechen."
