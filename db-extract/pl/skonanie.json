                            {
                                "example_id": "8e5aef6d-c9ba-4768-bd2e-47e5c159503a",
                                "sense_id": "966e50ae-6376-3c1b-b184-99e53e9624f3",
                                "text": "Czy niespodziewane skonanie pacjenta odnotowuje się w specjalny sposób w rejestrach?"
