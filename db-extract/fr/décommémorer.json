                "senses": [
                    {
                        "sense_id": "2caf72f4-8aa2-34cc-ad39-ebcf5e00451b",
                        "entry_id": "0e641c56-543c-34ca-a530-b80faba8218f",
                        "glosses": [
                            "Cesser de commémorer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de80694d-61ce-461c-be56-ce89280f8208",
                                "sense_id": "2caf72f4-8aa2-34cc-ad39-ebcf5e00451b",
                                "text": "Je vous dis cela parce qu'il nous faudra bien trouver un moyen, un jour, de décommémorer."
                            },
                            {
                                "example_id": "ab15ac76-8843-4a77-8ed2-53e1cb3b5e2e",
                                "sense_id": "2caf72f4-8aa2-34cc-ad39-ebcf5e00451b",
                                "text": "De fait, cela pose les questions de qui commémore-t-on, qui décommémore-t-on, qui décide de quel nom ?"
                            },
                            {
                                "example_id": "ce5ac7b1-3c33-4167-a436-7ea8d18e6108",
                                "sense_id": "2caf72f4-8aa2-34cc-ad39-ebcf5e00451b",
                                "text": "Disons-le crûment, fallait-il décélébrer Céline en 2011, et décommémorer Maurras en 2018, tout en « commémorant » encore la correspondance de Jacques Chardonne et de Paul Morand, deux homophobes et deux antisémites notoires ?"
                            }
                        ]
                    }
