                    },
                    {
                        "translation_id": "8a5d789b-5d80-4c2e-bd85-c52262de3546",
                        "source_entry_id": "b636ea2c-79bf-3ebd-8434-f04b27261736",
                        "source_sense_id": "f418f448-4042-323d-975b-edb53765c7ef",
