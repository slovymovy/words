                    {
                        "sense_id": "bf541174-7ce6-31ff-96c2-6b2deb6718ba",
                        "entry_id": "4d66d868-911f-34fc-90de-a253a704436e",
                        "glosses": [
                            "technisch sichergestellte Luftzirkulation in einem Gehäuse oder einem technischen System"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f67792b-56d9-4d39-bb40-c15bc51edd56",
                                "sense_id": "bf541174-7ce6-31ff-96c2-6b2deb6718ba",
                                "text": "„Überschreitet eine Festplatte beispielsweise im Betrieb über einen längeren Zeitraum eine festgelegte Temperatur, ist davon auszugehen, dass sie nicht mehr lange arbeitet oder zumindest die Gehäuselüftung versagt.“"
                            },
                            {
                                "example_id": "d5b12af4-f816-4d8d-bac1-9d19ea612b8a",
                                "sense_id": "bf541174-7ce6-31ff-96c2-6b2deb6718ba",
                                "text": "„Hocheffiziente Lüfter und intuitive Gehäuselüftung bieten Kühlung der Unternehmensklasse bei minimaler Energieaufnahme.“"
                            },
                            {
                                "example_id": "291a6b4c-4bd0-4d01-b48b-e35143f48145",
                                "sense_id": "bf541174-7ce6-31ff-96c2-6b2deb6718ba",
                                "text": "„Um die Ruhe zu erreichen, wurde mit Sicherheit ein anderes Laufwerk verbaut – Hersteller noch unbekannt –, vor allem aber das Konzept der Gehäuselüftung überdacht.“"
                            }
                        ],
