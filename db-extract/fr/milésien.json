                ],
                "senses": [
                    {
                        "sense_id": "9eca09af-c6a2-38c6-bc12-068cd549ed8d",
                        "entry_id": "1732a49d-1764-30cd-a9eb-6856dec15253",
                        "glosses": [
                            "Relatif à Milet, ville grecque de l’Asie Mineure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c856a19-38ac-4bdb-b239-94bd4c2f3f43",
                                "sense_id": "9eca09af-c6a2-38c6-bc12-068cd549ed8d",
                                "text": "Conte milésien, conte obscène composés par Aristide de Milet."
                            },
                            {
                                "example_id": "faac490a-0815-491d-b402-ba780942e0ca",
                                "sense_id": "9eca09af-c6a2-38c6-bc12-068cd549ed8d",
                                "text": "Il me semble encore que cette espèce d’écrit et de composition rentre dans le genre des anciennes fables milésiennes, c’est-à-dire de contes extravagants"
                            },
                            {
                                "example_id": "2c95e02d-396f-4648-b65b-16ef398a83c5",
                                "sense_id": "9eca09af-c6a2-38c6-bc12-068cd549ed8d",
                                "text": "Ô conteurs milésiens, ô subtil Pétrone ! ô mon Noël du Fail, s’écria-t-il, ô précurseurs de Jean de La Fontaine ! quel apôtre fut plus sage et meilleur que vous, qu’on appelle couramment des polissons ?"
                            },
                            {
                                "example_id": "0bac008e-579d-42a2-a88c-bd4b4dcff70a",
                                "sense_id": "9eca09af-c6a2-38c6-bc12-068cd549ed8d",
                                "text": "Les conteurs, les auteurs de fables milésiennes, ne font guère, comme des bouchers, que d’appendre à l’étal de petits morceaux de viande appréciés des mouches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6622c941-c14c-48a3-b3f6-345e7acb6a49",
                        "source_entry_id": "1732a49d-1764-30cd-a9eb-6856dec15253",
                        "source_sense_id": "9eca09af-c6a2-38c6-bc12-068cd549ed8d",
