                        "glosses": [
                            "Qui constitue une attestation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "825c8271-7e9d-464d-9c72-ccd10321f415",
                                "sense_id": "fae3b4cc-9567-3000-8f4f-97efe3e27e7a",
                                "text": "Acte de célébration de mariage de Rodolphe d’Escorches, écʳ, avec dˡˡᵉ Jeanne-Henriette le Boulleur, attestatif que la bénédiction nuptiale leur a été donnée en l’église de Monceaux, le 22 septembre 1767."
                            },
                            {
                                "example_id": "432834be-36d4-460b-9be2-afec0fd0a65b",
                                "sense_id": "fae3b4cc-9567-3000-8f4f-97efe3e27e7a",
                                "text": "Les Personnes infirmes et les sexagénaires, qui auront déposé hors du lieu de leur domicile, auront une taxe et demie, d’après les proportions ci-dessus, en représentant certificat de leur Municipalité, attestatif de leur âge ou de leurs infirmités."
                            },
                            {
                                "example_id": "190c1a62-147f-4b74-9c92-c7adbce00aff",
                                "sense_id": "fae3b4cc-9567-3000-8f4f-97efe3e27e7a",
                                "text": "Je suis par conséquent très heureux de vous donner ici un certificat attestatif, fait en toute sincérité, désintéressement et reconnaissance de gratitude avec l’espoir que ces lignes tomberont peut-être bien un jour ou l’autre sous les yeux des personnes contaminées de mon ancienne infirmité."
                            }
                        ]
                    }
