                        ],
                        "form": "die Rechenmaschine"
                    },
                    {
                        "form_id": "7fabeb4e-15cc-4f88-8f67-49e17d5490cb",
                        "entry_id": "07074bcd-a058-38cd-adc9-8909786853ef",
                        "tags": [
