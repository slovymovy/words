                "senses": [
                    {
                        "sense_id": "2f0f719f-7160-33e2-b3fc-a4f8769bbff2",
                        "entry_id": "683fac1f-0368-3114-9fc8-ac631047cd44",
                        "glosses": [
                            "de lichtoranje kleur van amber hebbend, een oranjegele kleur hebbend die oorspronkelijk van barnsteen komt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eddfc4e0-9ba4-4212-90ab-e375d0111170",
                                "sense_id": "2f0f719f-7160-33e2-b3fc-a4f8769bbff2",
                                "text": "Hij rijdt in een amberkleurige auto."
                            },
                            {
                                "example_id": "4c10110f-ac1e-4196-b315-3a04806dc971",
                                "sense_id": "2f0f719f-7160-33e2-b3fc-a4f8769bbff2",
                                "text": "Haar amberkleurige ogen deden me denken aan een leeuwin; ze maakte op mij de indruk van een roofdier dat haar welp beschermt - als die term tenminste in verband kon worden gebracht met het tere porseleinen voorwerp op de chaise- longue."
                            },
                            {
                                "example_id": "8a074d5e-c9c9-4367-8d41-aee13156465f",
                                "sense_id": "2f0f719f-7160-33e2-b3fc-a4f8769bbff2",
                                "text": "Net als de schikgodinnen die hij kende uit de boeken vol mythen, vertoonde zijn baas facetten van drievoudigheid: heden, verleden en toekomst, afhankelijk van de hoeveelheid amberkleurig vocht die zijn kelk die avond had gevuld."
                            }
                        ]
                    }
