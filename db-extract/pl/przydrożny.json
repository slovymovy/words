                            "znajdujący się przy drodze, w pobliżu drogi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7067db96-cb39-4294-a3ff-e32fed09faef",
                                "sense_id": "b5f14aff-503f-31b7-b555-4edf8546cc59",
                                "text": "Nieodłącznym elementem nadbużańskiego krajobrazu są liczne przydrożne krzyże, stawiane najczęściej przy wjeździe do wsi czy przy „świętych źródełkach”."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
