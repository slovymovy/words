                        "sense_id": "fa95d6dd-932f-3772-b9b9-4feffc82dd90",
                        "entry_id": "f29d1939-6a87-3640-90ef-4f5639fa0e66",
                        "glosses": [
                            "vertikaal deel van het raamwerk waarin een deur wordt afgehangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8749e37-712a-4251-adb9-47081c7696da",
                                "sense_id": "fa95d6dd-932f-3772-b9b9-4feffc82dd90",
                                "text": "Volgens de politie greep de verkeersregelaar naar de deurstijl en het stuur en bleef hij een paar meter aan de auto hangen. Daarna viel hij en raakte hij gewond aan zijn hoofd. Ook heeft de man een paar schaafwonden."
                            },
                            {
                                "example_id": "8d438a02-9850-4c30-a5c9-778004cc88f1",
                                "sense_id": "fa95d6dd-932f-3772-b9b9-4feffc82dd90",
                                "text": "S. belt met 112 maar als agenten voor de deur staan doet hij niet open, hij is druk bezig zijn belangrijke spullen in een tas te stoppen. Uiteindelijk blijkt de schade van de brand mee te vallen, een kapotte ruit en een verkoolde deurstijl."
                            }
                        ]
                    }
