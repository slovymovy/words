                    {
                        "translation_id": "7024bae7-4f37-4985-b5bf-7d22e2c509da",
                        "source_entry_id": "b75e41e6-4dd1-3025-98ed-bf2742f9b9fa",
                        "source_sense_id": "271d6b26-8052-3d15-a8d2-86698316c586",
                        "source_sense_description": "een krachtige boot die andere vaartuigen versleept",
                        "target_lang_word": "Schlepper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlepper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "884b0bda-081e-3a83-bd8f-147f65f6cd14",
                                        "entry_id": "b5e0ce2c-d540-3055-95b3-d79b509458eb",
                                        "glosses": [
                                            "kleines Schiff zur Unterstützung größerer Schiffe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5aa5e1f-a692-42c6-a69f-65b8324dbf38",
                                                "sense_id": "884b0bda-081e-3a83-bd8f-147f65f6cd14",
                                                "text": "Schuten werden von Schleppern gezogen."
                                            },
                                            {
                                                "example_id": "21dfd494-7a56-4378-adc0-6bca80aa3fbc",
                                                "sense_id": "884b0bda-081e-3a83-bd8f-147f65f6cd14",
                                                "text": "„Mehrere Schlepper, ein finnischer, ein schwedischer Dampfer sanken nach Volltreffern.“"
                                            },
                                            {
                                                "example_id": "3fca7495-4e8a-4031-88f9-78fea10a3c03",
                                                "sense_id": "884b0bda-081e-3a83-bd8f-147f65f6cd14",
                                                "text": "„Ein Schlepper tutete vom Fluss her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "26947617-1a9e-3e86-9413-415bedd45adb",
                                        "entry_id": "b5e0ce2c-d540-3055-95b3-d79b509458eb",
                                        "glosses": [
                                            "Kraftfahrzeug zum Ziehen von angehängten Lasten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d51d6bf-11b0-449e-aef7-ed09840c7c50",
                                                "sense_id": "26947617-1a9e-3e86-9413-415bedd45adb",
                                                "text": "Er sitzt von früh bis spät auf seinem Schlepper und beackert die Felder."
                                            },
                                            {
                                                "example_id": "be560f5c-408a-496d-af74-f99d3947a5e3",
                                                "sense_id": "26947617-1a9e-3e86-9413-415bedd45adb",
                                                "text": "„Darum sind wir jetzt ärmer, und es ist niemand mehr da, der unsere kaputten Schlepper repariert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "729c3d1f-df3b-30e7-9eaf-79e238935692",
                                        "entry_id": "b5e0ce2c-d540-3055-95b3-d79b509458eb",
                                        "glosses": [
                                            "für den Transport im Berg zuständiger Arbeiter"
                                        ],
                                        "tags": [
                                            "Bergbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60e29f70-86de-4fc6-8ed5-0c5396a72d9a",
                                                "sense_id": "729c3d1f-df3b-30e7-9eaf-79e238935692",
                                                "text": "Der Schlepper musste meist gebückt gehen, weil die Gänge so niedrig waren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ed13dd24-44aa-3c98-89f3-9106231f84ea",
                                        "entry_id": "b5e0ce2c-d540-3055-95b3-d79b509458eb",
                                        "glosses": [
                                            "jemand, der anderen Personen hilft, auf illegale Weise gegen Bezahlung in ein Land zu kommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "585d26ef-0eb2-4494-86c6-eefda584d431",
                                                "sense_id": "ed13dd24-44aa-3c98-89f3-9106231f84ea",
                                                "text": "Die Schlepper nehmen Gesundheitsrisiken und Lebensgefahr der geschmuggelten Personen für ihre geschäftsmäßig betriebene Hilfe in Kauf; gleichzeitig verlangen sie oft hohe Provisionen für den illegalen Grenzübertritt."
                                            },
                                            {
                                                "example_id": "2701f14d-3ee1-4403-8cb7-868025263a10",
                                                "sense_id": "ed13dd24-44aa-3c98-89f3-9106231f84ea",
                                                "text": "„Denn diese Schlepper haben die Hauptarbeit zu verrichten und bekommen auch den Löwenanteil am Ergebnis dieser riesigen Wurzerei.“"
                                            },
                                            {
                                                "example_id": "2b83f154-a4d7-42fa-ac30-0470039570de",
                                                "sense_id": "ed13dd24-44aa-3c98-89f3-9106231f84ea",
                                                "text": "„Und die Schlepper dort verlangen 7000 Dollar für den Trip.“"
                                            },
                                            {
                                                "example_id": "c2791b7e-0fc3-474d-a34c-32866ccab3c1",
                                                "sense_id": "ed13dd24-44aa-3c98-89f3-9106231f84ea",
                                                "text": "„So sind sie auf Schlepper und Schleuser angewiesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "5ddb4536-3705-3543-a251-48ecbf70682d",
                                        "entry_id": "b5e0ce2c-d540-3055-95b3-d79b509458eb",
                                        "glosses": [
                                            "jemand, der andere Personen auf fragwürdige Weise Betrieben (zum Beispiel Nachtlokalen) zuführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "283bf757-e5a3-4b15-9666-2eae98241f68",
                                                "sense_id": "5ddb4536-3705-3543-a251-48ecbf70682d",
                                                "text": "Der Schlepper stand auf St.Pauli vor der Bar und zog den Mann am Oberarm, obwohl dies den Angestellten verboten ist."
                                            },
                                            {
                                                "example_id": "8c9ae8d1-3bfb-4a7c-bfe9-8a8c2e4b1a9d",
                                                "sense_id": "5ddb4536-3705-3543-a251-48ecbf70682d",
                                                "text": "„Von jetzt an war Stavroula zwar vor Neppern, Schleppern und Bauernfängern sicher, konnte allerdings auch nicht mehr mit meiner Mutter in Deutschland telefonieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "81980cd1-520a-3b1e-a1d0-130e3c140924",
                                        "entry_id": "b5e0ce2c-d540-3055-95b3-d79b509458eb",
                                        "glosses": [
                                            "Skilift, Aufstiegshilfe, mit der Personen hinaufgezogen werden"
                                        ],
                                        "tags": [
                                            "Skisport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7731fea-3632-437f-9bce-e6e89eca463f",
                                                "sense_id": "81980cd1-520a-3b1e-a1d0-130e3c140924",
                                                "text": "„Auf der Bruncu Spina begegnen wir einer Kuriosität, einem Skilift. Dieser einsame, doch recht steile Schlepper zieht sich vom Rifugio Baita Bruncu Spina (1570 m) herauf, von wo aus wir die Tour ebenfalls starten könnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
