{
    "word_family": [
        "vision",
        "visual",
        "visibility",
        "visible",
        "visualization"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2cf4dc61-8a6d-363f-add2-6a754e88196b",
                    "sense_definition": "To form a mental image or picture of something in the mind",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mental_imaging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can <w>visualize</w> the house where I grew up, even though I have not been there for years."
                        },
                        {
                            "text": "Try to <w>visualize</w> yourself succeeding at the task before you actually begin working on it."
                        }
                    ],
                    "synonyms": [
                        "envisage",
                        "imagine",
                        "picture"
                    ],
                    "common_phrases": [
                        "visualize success",
                        "visualize clearly"
                    ]
                },
                {
                    "sense_id": "3b81d676-c514-39a8-aca5-db261bffd108",
                    "sense_definition": "To represent or display something in a visible way, such as through a chart or image",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software helps users <w>visualize</w> complex data using simple interactive charts."
                        },
                        {
                            "text": "The artist <w>visualizes</w> the abstract concept of time through a series of large paintings."
                        }
                    ],
                    "synonyms": [
                        "depict",
                        "illustrate",
                        "represent"
                    ],
                    "common_phrases": [
                        "visualize data"
                    ]
                },
                {
                    "sense_id": "90b1cadb-b86c-3450-8a59-130ad02c0a12",
                    "sense_definition": "To make something hidden or internal visible using medical or scientific technology",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_imaging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doctors use ultrasound technology to <w>visualize</w> the baby during pregnancy."
                        },
                        {
                            "text": "Special cameras were used to <w>visualize</w> the airflow patterns inside the engine."
                        }
                    ],
                    "synonyms": [
                        "image",
                        "scan"
                    ]
                },
                {
                    "sense_id": "53feb3bb-7a71-3519-99b7-86458a798baf",
                    "sense_definition": "To perceive something with the eyes",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new imaging system lets doctors <w>visualize</w> structures too small to see by eye."
                        },
                        {
                            "text": "The telescope allows astronomers to <w>visualize</w> distant stars that are otherwise invisible."
                        }
                    ],
                    "synonyms": [
                        "see",
                        "perceive"
                    ],
                    "antonyms": [
                        "hide"
                    ]
                }
            ]
        }
    ]
