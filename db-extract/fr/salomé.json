                            {
                                "example_id": "79203bbf-c8ba-4626-952c-fb147f498ec5",
                                "sense_id": "d3b0bfea-3209-3e6a-839b-6d94bacc3a65",
                                "text": "Les autorités israéliennes ont dévoilé mardi «l'une des grottes funéraires les plus impressionnantes» jamais découvertes dans le pays, datant d'environ 2000 ans et désignée comme étant «le Tombeau de Salomé», l'une des sages-femmes présentes à la naissance de Jésus, d'après certains courants du christianisme."
                            },
                            {
                                "example_id": "15f382c0-6788-4f71-b0c4-85896f0f8b1e",
                                "sense_id": "d3b0bfea-3209-3e6a-839b-6d94bacc3a65",
                                "text": "Avec : Michaël Hirsch, Simon Larvaron, Salomé Villiers."
                            }
                        ]
                    }
