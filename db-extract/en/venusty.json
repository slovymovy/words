                        "examples": [
                            {
                                "example_id": "b6ba774a-74ba-4a94-8b4d-7ca00061ebf4",
                                "sense_id": "6bcb1152-7ce1-3f75-9917-74082ec4be27",
                                "text": "Nature hathe […] geven hym a bewtye – it is called maiestye, or venustie […] – wch passethe all other bewtye."
                            },
                            {
                                "example_id": "29d216d3-12c6-4c17-87d5-9eb392b90c18",
                                "sense_id": "6bcb1152-7ce1-3f75-9917-74082ec4be27",
                                "text": "To him Divine Providence presents the pure, tralucid tenerity of Madonnina Marcia Figlidelre, the caesarial auricolored sinuose venusty of Don Eros Ardeati […]."
                            },
                            {
                                "example_id": "e82bab6d-f02f-4401-8e4a-54add466c0b1",
                                "sense_id": "6bcb1152-7ce1-3f75-9917-74082ec4be27",
                                "text": "She was not really pretty, but she had all the bloom and venusty of youth, with those hazel eyes which seem almost golden when they take the light under dark lashes."
                            }
                        ]
                    }
