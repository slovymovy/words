                                    {
                                        "sense_id": "0369c81c-294a-30c9-8a84-326bfbfc0ff9",
                                        "entry_id": "12722044-eec7-3781-babb-2638db62c733",
                                        "glosses": [
                                            "Uno de los 125 municipios del Estado de México y uno de los municipios que integran la Región Ecatepec, se ubica al noreste de la Ciudad de México en dirección hacia el Estado de Hidalgo, siendo un lugar de transición entre el Valle de México y los Llanos de Apan. Teotihuacán limita al norte con el municipio de San Martín de las Pirámides, al sur con el municipio de Acolman, al suroeste con el municipio de Tecámac, al este con el municipio de Otumba y al oeste con el municipio de Temascalapa."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
