                "senses": [
                    {
                        "sense_id": "795c5654-1f43-361d-9341-1d0e562208f0",
                        "entry_id": "37c36106-3d5a-37a5-826c-1cf10b61fac1",
                        "glosses": [
                            "Enfant de chœur."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "4489732a-f72e-429b-8193-eaea6baf3fdb",
                                "sense_id": "795c5654-1f43-361d-9341-1d0e562208f0",
                                "text": "Un Racine exagérant « Port-Royal », devenu à son déclin d’un mysticisme exalté, tournant de longues heures le long des murs de sa chambre, en clergeon, portant la croix, tandis que son fils revêtu des vêtements sacerdotaux officiait, et que ses filles représentaient divers membres du clergé […]"
                            },
                            {
                                "example_id": "74999a55-c5b8-4074-a11b-42bb37116bee",
                                "sense_id": "795c5654-1f43-361d-9341-1d0e562208f0",
                                "text": "S’il y eut des saintes et des martyres, en revanche point de papesses ou seulement de clergeonnes. La messe est purement virile."
                            },
                            {
                                "example_id": "56443099-5598-46e7-b672-4e2d645d3c4a",
                                "sense_id": "795c5654-1f43-361d-9341-1d0e562208f0",
                                "text": "Le curé Patard enfourchait un engin rugissant, sur lequel il prenait en croupe un clergeon, et les deux motards en surplis allaient porter aux mourants, à quatre-vingt à l'heure, des extrêmes-onctions qui s'annonçaient par un bruit formidable d'échappement."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ce9e064-6660-323a-82ac-e383240d7f83",
                        "entry_id": "37c36106-3d5a-37a5-826c-1cf10b61fac1",
                        "glosses": [
                            "Très jeune séminariste."
                        ],
                        "tags": [
                            "broadly",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "69926841-d67c-49a4-81c5-c27bd89a79a5",
                                "sense_id": "5ce9e064-6660-323a-82ac-e383240d7f83",
                                "text": "“Il a une bonne écriture, le clergeon : ça, je ne dirai pas le contraire !”"
                            },
                            {
                                "example_id": "60d9ca3e-7196-43a1-8170-5067f605a6c7",
                                "sense_id": "5ce9e064-6660-323a-82ac-e383240d7f83",
                                "text": "Il revint brusquement vers le clergeon, posa paternellement les deux mains sur ses épaules."
                            }
                        ]
                    },
                    {
                        "sense_id": "68e9314e-f052-370a-b63c-46ef4e540bd4",
                        "entry_id": "37c36106-3d5a-37a5-826c-1cf10b61fac1",
                        "glosses": [
                            "Jeune pousse de salade frisée."
                        ],
                        "tags": [
                            "Lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "3911845b-06ff-46c5-a17d-e109cce538ad",
                                "sense_id": "68e9314e-f052-370a-b63c-46ef4e540bd4",
                                "text": "Nous faisons bien à Lyon la vente de la laitue frisée cueillie avant son complet développement et qu'on nomme clergeon ou éclergeon, mais ici elle se vend à peine née."
                            }
                        ]
                    }
