                        "glosses": [
                            "to go out, to die out (of light, fire, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ac906e3-9736-48c6-a51f-02fb1a5e412a",
                                "sense_id": "404c6aa0-1bce-3bb4-86a7-7f26bdd1557c",
                                "text": "Мы все смотрели на самовар, а он потух, отразил на боках своих желтизну и угрозу заката и тоже стал чужой, мертвый и непонятный.",
                                "translation": "We all sat watching the samovar, but it went out, its sides reflecting the yellowishness and menace of the sunset, and it seemed also an unfamiliar, dead and incomprehensible object.",
                                "english": "We all sat watching the samovar, but it went out, its sides reflecting the yellowishness and menace of the sunset, and it seemed also an unfamiliar, dead and incomprehensible object."
                            }
                        ]
                    }
