                    },
                    {
                        "translation_id": "fb8723ab-8ec6-4147-9f64-2f3af4c0c9d6",
                        "source_entry_id": "b14f8a06-66d1-3cb1-ac56-b00afc74c502",
                        "source_sense_id": "f5b6498b-c9a8-3b7b-88e5-f03c3edf80db",
                        "target_lang_word": "skeuomorphism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skeuomorphism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dd7222f-5c7d-3f67-a4e4-a2a21209ce66",
                                        "entry_id": "723898f5-0c66-3d59-944c-9b0bbc568727",
                                        "glosses": [
                                            "The incorporation of obsolete or skeuomorphic elements into a design, for familiarity or out of tradition, even though they no longer serve any functional purpose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f4e67b7-ef8a-4fa3-8602-ea52e05dd8f9",
                                                "sense_id": "9dd7222f-5c7d-3f67-a4e4-a2a21209ce66",
                                                "text": "Skeuomorphism is not a thing of the past nor is it limited to traditional crafts. It is found today in countless articles being made from plastic for the first time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1548039f-df72-32bf-b8c5-408e2947fc2d",
                                        "entry_id": "723898f5-0c66-3d59-944c-9b0bbc568727",
                                        "glosses": [
                                            "A user interface style characterized by ornate use of photorealistic textures, shadows, and often glossy highlights, mimicking a three-dimensional render."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
