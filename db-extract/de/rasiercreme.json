                        "glosses": [
                            "zur schonenden Rasur verwendete Substanz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5400a845-8610-4cf5-8c70-5ca20b1bdd18",
                                "sense_id": "90616fd5-63d8-3386-9771-9bd272130847",
                                "text": "„Die Rasiercreme hat eine weichere Konsistenz als Rasierseife. Oft lässt sich die Rasiercreme schneller anwenden. Im Gegensatz zu einer Rasierseife muss sie nicht zwangsläufig zu einem Rasierschaum aufgeschlagen werden. Rasiercreme kann entwender direkt mit der Hand im Gesicht verteilt oder mit einem Pinsel aufgetragen werden: Einfach etwas Rasiercreme in den feuchten Pinsel geben. In einem Tiegel aufgeschlagen, ergibt sie einen schönen, cremigen Schaum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
