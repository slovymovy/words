                "translations": [
                    {
                        "translation_id": "9256ba1e-d9d4-40ae-8d67-219e2207b04d",
                        "source_entry_id": "090f7ada-fa68-3590-95a9-c79c4f820cfc",
                        "source_sense_id": "5796740b-ece5-30f5-a848-7397ade0ea2f",
                        "target_lang_word": "familiarity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "familiarity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16dae9b4-1f0f-3fd3-a4b2-ca939563ee3d",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "The state of being extremely friendly; intimacy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13f0d17c-ef13-4be7-a394-20a1f33e2916",
                                                "sense_id": "16dae9b4-1f0f-3fd3-a4b2-ca939563ee3d",
                                                "text": "It is also folly and injustice to deprive children[…]of their fathers familiaritie, and ever to shew them a surly, austere, grim, and disdainefull countenance, hoping thereby to keepe them in awfull feare and duteous obedience."
                                            },
                                            {
                                                "example_id": "33017085-5850-4476-b7b9-d10d253785c4",
                                                "sense_id": "16dae9b4-1f0f-3fd3-a4b2-ca939563ee3d",
                                                "text": "Do not keep familiarity with any but those, with whom you may improve your time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "380fd6fc-e200-3719-8bd5-61b3f14ff829",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "Undue intimacy; inappropriate informality, impertinence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6c51bd8-d78f-4038-8cbb-c77a80483460",
                                                "sense_id": "380fd6fc-e200-3719-8bd5-61b3f14ff829",
                                                "text": "Murrel did not in the least object to being called a monkey, yet he always felt a slight distaste when Julian Archer called him one.[…]It had to do with a fine shade between familiarity and intimacy which men like Murrel are never ready to disregard, however ready they may be to black their faces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1831a8ab-fa15-3e6b-ad73-7cec0ddae30c",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "An instance of familiar behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8663ec43-d4f9-3def-a344-05426264b3e5",
                                        "entry_id": "663506f5-3fbf-322e-9c46-f70549bf9418",
                                        "glosses": [
                                            "Close or habitual acquaintance with someone or something; understanding or recognition acquired from experience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff5d50aa-18f9-4532-b768-46d8774eff90",
                                                "sense_id": "8663ec43-d4f9-3def-a344-05426264b3e5",
                                                "text": "The objects around have been seen so often, that they have at last become, as it were, unseen; their familiarity does not carry us out of ourselves, for all their associations are our own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a71cb985-e96a-420c-b736-581843203f45",
                        "source_entry_id": "090f7ada-fa68-3590-95a9-c79c4f820cfc",
                        "source_sense_id": "5796740b-ece5-30f5-a848-7397ade0ea2f",
                        "target_lang_word": "familiarité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "familiarité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b859b797-a2ec-3943-a43d-0fd222e6d92a",
                                        "entry_id": "1ae3e996-bba7-3532-851d-51c68b2c0a74",
                                        "glosses": [
                                            "Manière de vivre dans l’intimité de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7467fbea-5919-4e45-84b5-76543c5ea40a",
                                                "sense_id": "b859b797-a2ec-3943-a43d-0fd222e6d92a",
                                                "text": "Nous parlions plus haut de la familiarité patriarcale qui rapproche nécessairement les jeunes gens d'une même tribu."
                                            },
                                            {
                                                "example_id": "5714541d-3809-4e61-9187-146daab34250",
                                                "sense_id": "b859b797-a2ec-3943-a43d-0fd222e6d92a",
                                                "text": "La plus aimable familiarité semblait régner entre tout ce monde-là, car le dîner commença par une plaisanterie à coups de poing à laquelle nous ne comprîmes rien."
                                            },
                                            {
                                                "example_id": "2a5b8e42-b780-4949-889c-05ab9743c79d",
                                                "sense_id": "b859b797-a2ec-3943-a43d-0fd222e6d92a",
                                                "text": "Ces lettres étaient écrites sur un ton de familiarité affectueuse, et si Hervé avait voulu lire entre les lignes, il aurait facilement deviné que la marquise avait une forte inclination pour lui."
                                            },
                                            {
                                                "example_id": "9015359f-c2e0-4cc5-a2e2-b6c390488e5e",
                                                "sense_id": "b859b797-a2ec-3943-a43d-0fd222e6d92a",
                                                "text": "Ils vivent dans la plus grande familiarité. — Il n’y a pas grande familiarité entre eux."
                                            },
                                            {
                                                "example_id": "f425c50c-2f54-49bd-90f6-0311a89c9eac",
                                                "sense_id": "b859b797-a2ec-3943-a43d-0fd222e6d92a",
                                                "text": "La familiarité n’est jamais tolérée en Perse, la politesse y est pointilleuse et grandiloquente, on a souvent tendance à se dire « l’esclave de l’ombre de la grandeur » de l’individu auquel on s’adresse, et dès qu’il s’agit d’altesses, d’altesses femmes surtout, on se met à baiser le sol, sinon dans les actes, du moins par le biais des formules les plus ampoulées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5da887a-05b1-3a64-8217-0c2995d980f9",
                                        "entry_id": "1ae3e996-bba7-3532-851d-51c68b2c0a74",
                                        "glosses": [
                                            "Manière de se comporter trop librement à l’égard d’une personne."
                                        ],
                                        "tags": [
                                            "Surtout au pluriel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bdb2ac7-d0c2-4413-8338-999db5791c99",
                                                "sense_id": "c5da887a-05b1-3a64-8217-0c2995d980f9",
                                                "text": "Prendre, se permettre des familiarités avec quelqu’un."
                                            },
                                            {
                                                "example_id": "cfd5a4d6-ee3e-427f-88cd-4b7784e02ec1",
                                                "sense_id": "c5da887a-05b1-3a64-8217-0c2995d980f9",
                                                "text": "En user avec familiarité."
                                            },
                                            {
                                                "example_id": "f42f961c-ffd3-4eb7-8f42-92f6b01ca99a",
                                                "sense_id": "c5da887a-05b1-3a64-8217-0c2995d980f9",
                                                "text": "Son chapeau mou rabattu sur les yeux, sa grosse figure joviale et colorée, son foulard, son manteau marron et je ne sais quelle familiarité courtoise et bon enfant lui assuraient partout la sympathie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d760742-07c0-3da9-808c-0ffbac81dde8",
                                        "entry_id": "1ae3e996-bba7-3532-851d-51c68b2c0a74",
                                        "glosses": [
                                            "Simplicité, en parlant des ouvrages de l’esprit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fe3464e-ee1c-4f2b-b0a2-99b84f9d88f4",
                                                "sense_id": "9d760742-07c0-3da9-808c-0ffbac81dde8",
                                                "text": "Il y a excès de familiarité dans son style."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
