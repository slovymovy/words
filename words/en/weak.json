{
    "word_family": [
        "weaken",
        "weakness",
        "weakly",
        "weakling"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "34aa34a3-cf83-3220-a514-ff967a87a35a",
                    "sense_definition": "Lacking physical strength, energy, or vigor.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lack_of_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was too <w>weak</w> to stand up without help.",
                            "target_lang_translations": {
                                "ru": "Пациент был слишком <w>слаб</w>, чтобы встать без посторонней помощи.",
                                "zh": "病人太<w>虚弱</w>了，没人帮忙就站不起来。"
                            }
                        },
                        {
                            "text": "I felt <w>weak</w> and dizzy after not eating all day.",
                            "target_lang_translations": {
                                "ru": "Я чувствовал <w>слабость</w> и головокружение, так как не ел весь день.",
                                "zh": "我整天没吃东西，感到<w>无力</w>且头晕。"
                            }
                        }
                    ],
                    "synonyms": [
                        "feeble",
                        "frail",
                        "infirm",
                        "powerless"
                    ],
                    "antonyms": [
                        "strong",
                        "robust",
                        "powerful",
                        "healthy"
                    ],
                    "common_phrases": [
                        "feel weak",
                        "weak muscles",
                        "weak with hunger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не обладающий физической силой, энергией или бодростью.",
                        "zh": "指缺乏体力、精力或活力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "общий перевод"
                            },
                            {
                                "target_lang_word": "обессиленный",
                                "target_lang_sense_clarification": "лишенный сил"
                            },
                            {
                                "target_lang_word": "немощный",
                                "target_lang_sense_clarification": "дряхлый, болезненный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虚弱",
                                "target_lang_sense_clarification": "身体状况不佳"
                            },
                            {
                                "target_lang_word": "无力",
                                "target_lang_sense_clarification": "缺乏力量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e837e0e1-5433-397b-a96f-e0e7bce8ce0f",
                    "sense_definition": "Likely to break or collapse; not firmly constructed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lack_of_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>weak</w> branch snapped under the weight of the snow.",
                            "target_lang_translations": {
                                "ru": "<w>Слабая</w> ветка сломалась под тяжестью снега.",
                                "zh": "<w>脆弱</w>的树枝在积雪的重压下折断了。"
                            }
                        },
                        {
                            "text": "We need to reinforce the <w>weak</w> parts of the bridge.",
                            "target_lang_translations": {
                                "ru": "Нам нужно укрепить <w>слабые</w> части моста.",
                                "zh": "我们需要加固桥梁<w>薄弱</w>的部分。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fragile",
                        "flimsy",
                        "breakable",
                        "unstable",
                        "shaky"
                    ],
                    "antonyms": [
                        "strong",
                        "sturdy",
                        "durable"
                    ],
                    "common_phrases": [
                        "weak structure",
                        "weak link",
                        "weak spot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный ломаться или разрушаться; непрочно сделанный.",
                        "zh": "指容易折断或倒塌；结构不牢固。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непрочный",
                                "target_lang_sense_clarification": "о конструкции или материале"
                            },
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "легко ломающийся"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "ненадежный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脆弱",
                                "target_lang_sense_clarification": "易损坏的"
                            },
                            {
                                "target_lang_word": "不牢固",
                                "target_lang_sense_clarification": "结构不稳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f6de119-d03d-3f23-a524-a6fdb2bfe5cf",
                    "sense_definition": "Containing a lot of water and having little flavor or potency.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dilute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I ordered a strong espresso, but they gave me <w>weak</w> coffee.",
                            "target_lang_translations": {
                                "ru": "Я заказал крепкий эспрессо, но мне дали <w>некрепкий</w> кофе.",
                                "zh": "我点的是浓缩咖啡，但他们给我的咖啡太<w>清淡</w>了。"
                            }
                        },
                        {
                            "text": "The soup was very <w>weak</w> and needed more salt and spices.",
                            "target_lang_translations": {
                                "ru": "Суп был очень <w>жидким</w> и требовал больше соли и специй.",
                                "zh": "这汤太<w>稀</w>了，需要多加点盐和香料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "watery",
                        "dilute",
                        "tasteless",
                        "thin",
                        "bland"
                    ],
                    "antonyms": [
                        "strong",
                        "potent"
                    ],
                    "common_phrases": [
                        "weak tea",
                        "weak coffee",
                        "weak solution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий много воды, имеющий слабый вкус или низкую концентрацию.",
                        "zh": "指含有大量水分，味道淡或浓度低。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "некрепкий",
                                "target_lang_sense_clarification": "о чае, кофе, алкоголе"
                            },
                            {
                                "target_lang_word": "жидкий",
                                "target_lang_sense_clarification": "водянистый (о супе, растворе)"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "малонасыщенный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清淡",
                                "target_lang_sense_clarification": "味道不浓"
                            },
                            {
                                "target_lang_word": "稀",
                                "target_lang_sense_clarification": "浓度低"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4aab421-4694-3581-8709-b76b4a01f647",
                    "sense_definition": "Performing poorly or below standard; lacking skill or proficiency.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ineffective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>weak</w> student in mathematics but excels in history.",
                            "target_lang_translations": {
                                "ru": "Он <w>слабый</w> ученик по математике, но преуспевает в истории.",
                                "zh": "他数学成绩很<w>差</w>，但历史学得很好。"
                            }
                        },
                        {
                            "text": "The team played a <w>weak</w> game and lost by three goals.",
                            "target_lang_translations": {
                                "ru": "Команда показала <w>слабую</w> игру и проиграла с разницей в три мяча.",
                                "zh": "球队表现<w>低迷</w>，输了三个球。"
                            }
                        }
                    ],
                    "synonyms": [
                        "poor",
                        "incompetent",
                        "ineffective",
                        "unskilled",
                        "subpar"
                    ],
                    "antonyms": [
                        "skilled",
                        "capable",
                        "strong"
                    ],
                    "common_phrases": [
                        "weak student",
                        "weak performance",
                        "weak point"
                    ],
                    "target_lang_definitions": {
                        "ru": "Демонстрирующий плохие результаты; не обладающий достаточными навыками.",
                        "zh": "指表现不佳或低于标准；缺乏技能或熟练度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "об уровне подготовки"
                            },
                            {
                                "target_lang_word": "посредственный",
                                "target_lang_sense_clarification": "невыдающийся"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "差",
                                "target_lang_sense_clarification": "水平低"
                            },
                            {
                                "target_lang_word": "薄弱",
                                "target_lang_sense_clarification": "能力不足"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8220539-f877-3911-93c8-6674e6eeaeda",
                    "sense_definition": "Lacking determination or the ability to resist temptation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was too <w>weak</w> to say no to their demands.",
                            "target_lang_translations": {
                                "ru": "Он был слишком <w>слаб</w>, чтобы отказать их требованиям.",
                                "zh": "他太<w>软弱</w>了，无法拒绝他们的要求。"
                            }
                        },
                        {
                            "text": "She had a <w>weak</w> moment and ate the entire chocolate cake.",
                            "target_lang_translations": {
                                "ru": "У неё была минута <w>слабости</w>, и она съела весь шоколадный торт.",
                                "zh": "她一时<w>意志薄弱</w>，把整个巧克力蛋糕都吃了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spineless",
                        "indecisive",
                        "yielding"
                    ],
                    "antonyms": [
                        "resolute",
                        "strong-willed",
                        "firm"
                    ],
                    "common_phrases": [
                        "weak character",
                        "weak will",
                        "weak moment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный решимости или способности противостоять искушению.",
                        "zh": "指缺乏决心或抵御诱惑的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабохарактерный",
                                "target_lang_sense_clarification": "о характере"
                            },
                            {
                                "target_lang_word": "безвольный",
                                "target_lang_sense_clarification": "не имеющий воли"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "морально неустойчивый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "软弱",
                                "target_lang_sense_clarification": "性格不坚定"
                            },
                            {
                                "target_lang_word": "意志薄弱",
                                "target_lang_sense_clarification": "缺乏毅力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56427d3e-964a-339a-8dd1-2345fc488adb",
                    "sense_definition": "Not convincing or effective; lacking logical support.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "ineffective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer presented a very <w>weak</w> defense in court.",
                            "target_lang_translations": {
                                "ru": "Адвокат представил очень <w>слабую</w> защиту в суде.",
                                "zh": "律师在法庭上的辩护非常<w>无力</w>。"
                            }
                        },
                        {
                            "text": "His excuse for being late was <w>weak</w> and nobody believed him.",
                            "target_lang_translations": {
                                "ru": "Его оправдание опоздания было <w>неубедительным</w>, и никто ему не поверил.",
                                "zh": "他迟到的借口很<w>站不住脚</w>，没人相信他。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unconvincing",
                        "flimsy",
                        "unsustained"
                    ],
                    "antonyms": [
                        "compelling",
                        "persuasive",
                        "strong"
                    ],
                    "common_phrases": [
                        "weak argument",
                        "weak excuse",
                        "weak case"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неубедительный или неэффективный; лишенный логического обоснования.",
                        "zh": "指缺乏说服力或效力；缺乏逻辑支持。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неубедительный",
                                "target_lang_sense_clarification": "об аргументах, оправданиях"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "не имеющий веса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无力",
                                "target_lang_sense_clarification": "缺乏说服力"
                            },
                            {
                                "target_lang_word": "站不住脚",
                                "target_lang_sense_clarification": "理由不充分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e08c8181-c0ee-3765-8d99-599e47d4b890",
                    "sense_definition": "Unimpressive, disappointing, or uncool.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang_bad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>weak</w> of him not to show up to the party.",
                            "target_lang_translations": {
                                "ru": "Это было <w>низко</w> с его стороны не прийти на вечеринку.",
                                "zh": "他没来参加聚会，真是太<w>没劲</w>了。"
                            }
                        },
                        {
                            "text": "That ending to the movie was so <w>weak</w>.",
                            "target_lang_translations": {
                                "ru": "Концовка фильма была такой <w>отстойной</w>.",
                                "zh": "那部电影的结局太<w>烂</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lame",
                        "bad"
                    ],
                    "antonyms": [
                        "cool",
                        "awesome"
                    ],
                    "common_phrases": [
                        "that is weak"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Невпечатляющий, разочаровывающий или плохой (сленг).",
                        "zh": "指令人印象不深、失望或糟糕（俚语）。"
                    },
                    "translations": {
                        "ru": [
