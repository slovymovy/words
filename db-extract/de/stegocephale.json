                "senses": [
                    {
                        "sense_id": "3ba11fd0-76ef-3537-adda-d48a94a74101",
                        "entry_id": "29a2abd4-4f2d-33ac-acca-8c79f9c862a1",
                        "glosses": [
                            "Biologie, Zoologie, Paläontologie: Gruppe ausgestorbener, sehr ursprünglicher Amphibien von Salamandergröße bis zu Riesenformen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d208fbe7-2fa2-469f-8cdb-06aa61342ad3",
                                "sense_id": "3ba11fd0-76ef-3537-adda-d48a94a74101",
                                "text": "„Die Stegocephalia, deren Name auf ihr geschlossenes Schädeldach hinweist […], das nur Durchbrüche für Sinnesorgane aber nie Schläfengruben besitzt, lassen mehrere Entwicklungsstadien erkennen, die hier als Unterordnungen betrachtet werden.“"
                            },
                            {
                                "example_id": "49edce5c-c5b3-4910-a1b1-5ba8c3ed9354",
                                "sense_id": "3ba11fd0-76ef-3537-adda-d48a94a74101",
                                "text": "„Bei mehreren Stegocephalen von Magstadt sind so viele Merkmale erhalten, daß eine Bestimmung, zumindest der Gattung, möglich ist.“"
                            },
                            {
                                "example_id": "a827ffc7-bce9-4d94-b748-ebef4aa331ae",
                                "sense_id": "3ba11fd0-76ef-3537-adda-d48a94a74101",
                                "text": "„In der Sammlung des Geologisch-Paläontologischen Instituts der Universität Halle befindet sich schon seit längerer Zeit ein größeres, größtenteils zerstörtes und undeutlich bzw. als Abdruck erhaltenes Skelett eines Stegocephalen, das auf mehrere Platten verteilt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
