                "senses": [
                    {
                        "sense_id": "41e0d7f5-05c7-37ae-a9aa-a4f89f4f0c0f",
                        "entry_id": "a54b574c-80cf-30b1-81b7-fb004c07bae9",
                        "glosses": [
                            "Secluded from society (of a lifestyle, activity etc.); private, quiet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5af0b3fc-e50b-4767-8415-79b798d11bb4",
                                "sense_id": "41e0d7f5-05c7-37ae-a9aa-a4f89f4f0c0f",
                                "text": "I lead a retired lifestyle."
                            }
                        ]
                    },
                    {
                        "sense_id": "a78d58a6-61dd-3af9-9f17-95f73e36981a",
                        "entry_id": "a54b574c-80cf-30b1-81b7-fb004c07bae9",
                        "glosses": [
                            "Of a place, far from civilization, not able to be easily seen or accessed; secluded."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b067319-c9ab-4a9d-b4ec-a27546aabcc5",
                                "sense_id": "a78d58a6-61dd-3af9-9f17-95f73e36981a",
                                "text": "The little stone Saint occupied a retired niche in a side aisle of the old cathedral."
                            }
                        ]
                    },
                    {
                        "sense_id": "c43ddb28-f59a-39b3-800d-e62a56578792",
                        "entry_id": "a54b574c-80cf-30b1-81b7-fb004c07bae9",
                        "glosses": [
                            "Having left employment, especially on reaching pensionable age. (of people)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7b81381-a924-4fc8-a6d0-855cfcab97d4",
                                "sense_id": "c43ddb28-f59a-39b3-800d-e62a56578792",
                                "text": "The retired workers are a major expense due to their pensions."
                            },
                            {
                                "example_id": "19ad04b5-b826-4437-ad6c-19aa6434a8d2",
                                "sense_id": "c43ddb28-f59a-39b3-800d-e62a56578792",
                                "text": "Although he is now freed from responsibility for the '390s', they are still fixtures of everyday life for the retired Hertfordshire resident living alongside the WCML. \"If you stand on the end of the Up Fast platform at Berkhamsted, watching it go round that corner - the sharpest curve it takes anywhere - you just think, 'wow!'"
                            }
                        ]
                    },
                    {
                        "sense_id": "131cd284-92f9-30e1-baa5-11704cb86353",
                        "entry_id": "a54b574c-80cf-30b1-81b7-fb004c07bae9",
                        "glosses": [
                            "No longer in use or production."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bafdd1d-7c19-49f5-bc15-f50855ee96e6",
                                "sense_id": "131cd284-92f9-30e1-baa5-11704cb86353",
                                "text": "Following Jackie Robinson's success, his uniform number, 42, became a retired number across all major league teams."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cf517e1-c82f-4745-8ea8-a8d037e99e57",
                        "source_entry_id": "a54b574c-80cf-30b1-81b7-fb004c07bae9",
                        "source_sense_description": "having left employment",
                        "target_lang_word": "retraité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retraité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84f6faef-4f89-3084-97e6-3be2ef5df427",
                                        "entry_id": "17047f77-6c5c-3fe0-8359-17274406f39b",
                                        "glosses": [
                                            "Qui est à la retraite ; qui touche une pension de retraite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43afa686-6479-4f82-b63d-3d188436a357",
                                                "sense_id": "84f6faef-4f89-3084-97e6-3be2ef5df427",
                                                "text": "Quelque 11 800 personnes, récemment retraitées du NHS (infirmières, médecins, aides-soignants), ont­ ­accepté de reprendre du service pour compenser les personnels absents,en isolation ou malades."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retraité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b48b856-10a2-3ae9-82bb-f562bee972df",
                                        "entry_id": "cc3b0e6f-e546-3c24-8a3d-8387da4ad1f7",
                                        "glosses": [
                                            "Personne à la retraite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a4b2a64-e75e-4d00-a9dc-20e062696ce2",
                                                "sense_id": "1b48b856-10a2-3ae9-82bb-f562bee972df",
                                                "text": "— J'en pense qu'une fille qui habite Le Faouët peut très bien faire ses courses à Gourin, si elle travaille quelque part entre les deux communes, voire même à Gourin, répliqua le retraité de sa grosse voix, en grattant sa barbe poivre et sel."
                                            },
                                            {
                                                "example_id": "ec8b9699-495a-4cf7-b3ef-14417b6f0d05",
                                                "sense_id": "1b48b856-10a2-3ae9-82bb-f562bee972df",
                                                "text": "Un adolescent marche dans la rue\nDernier résistant d’une époque révolue\nCar l’arrondissement vieux de 35 ans\nEst maintenant peuplé de gentils retraités."
                                            },
                                            {
                                                "example_id": "6adbcd76-f519-48b2-a8c0-28d733ab4173",
                                                "sense_id": "1b48b856-10a2-3ae9-82bb-f562bee972df",
                                                "text": "Son auteur, James Mazeaud, est un retraité de 88 ans, installé à L’Isle d’Espagnac."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retraité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd55cfd7-397f-3710-94fb-836118e79c10",
                                        "entry_id": "7a22f81e-e40f-3dde-a140-f504fa0c7bb1",
                                        "glosses": [
                                            "Participe passé masculin singulier de retraiter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b104e7c8-2182-4667-80f2-f3dfb769ffb3",
                                                "sense_id": "fd55cfd7-397f-3710-94fb-836118e79c10",
                                                "text": "Ils m’ont désexpatrié et retraité, après tout je ne suis qu’un paramètre d’ajustement, non ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
