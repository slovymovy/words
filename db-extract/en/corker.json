                "senses": [
                    {
                        "sense_id": "c0fb222f-1d6a-3bc2-8d25-937208573604",
                        "entry_id": "202d9f76-075b-31c4-bb45-eba93f88b3ca",
                        "glosses": [
                            "One who puts corks into bottles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe343f2e-e3a4-4e6c-8b9e-277dff7fc2fe",
                                "sense_id": "c0fb222f-1d6a-3bc2-8d25-937208573604",
                                "text": "Yes it is, Frank. Don't you see? Laertes is to take the best of care of his friends—his proved friends, on the same principle that a wine-corker takes the best of care of his proved bottles."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f9b9498-e24e-3889-a106-e6257e8992eb",
                        "entry_id": "202d9f76-075b-31c4-bb45-eba93f88b3ca",
                        "glosses": [
                            "A person or thing that is exceptional or remarkable."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "1fd1dae7-45da-4263-ac80-5f1736e82508",
                                "sense_id": "2f9b9498-e24e-3889-a106-e6257e8992eb",
                                "text": "He had just had an absolute corker of an idea!"
                            },
                            {
                                "example_id": "fc706df9-ce39-4bdd-9e4b-f87d246cee47",
                                "sense_id": "2f9b9498-e24e-3889-a106-e6257e8992eb",
                                "text": "Well, a body is bound to admit that for just a modest little one-line ad., it's a corker."
                            }
                        ]
                    }
