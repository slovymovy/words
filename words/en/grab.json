{
    "word_family": [
        "grabber",
        "grabby"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44954a8a-5f5a-399c-a3b6-ef79530b14a5",
                    "sense_definition": "To take hold of something or someone suddenly, roughly, or firmly.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>grabbed</w> her hand to pull her back from the cliff edge.",
                            "target_lang_translations": {
                                "ru": "Я <w>схватил</w> её за руку, чтобы оттащить от края обрыва.",
                                "pl": "<w>Chwyciłem</w> ją za rękę, żeby odciągnąć ją od krawędzi urwiska.",
                                "zh": "我<w>抓住</w>她的手，把她从悬崖边拉了回来。"
                            }
                        },
                        {
                            "text": "He managed to <w>grab</w> hold of the rail just before the boat turned.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>схватиться</w> за поручень как раз перед тем, как лодка повернула.",
                                "pl": "Zdołał <w>złapać</w> się poręczy tuż przed tym, jak łódź skręciła.",
                                "zh": "就在船转弯前，他设法<w>抓住</w>了栏杆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "seize",
                        "grasp",
                        "clutch",
                        "snatch",
                        "catch"
                    ],
                    "common_phrases": [
                        "grab hold of",
                        "grab someone's hand",
                        "grab someone's arm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Схватить кого-то или что-то внезапно, грубо или крепко.",
                        "pl": "Nagle, gwałtownie lub mocno chwycić kogoś lub coś.",
                        "zh": "突然、粗暴地或用力地抓住某人或某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схватить",
                                "target_lang_sense_clarification": "совершить действие быстро"
                            },
                            {
                                "target_lang_word": "хватать",
                                "target_lang_sense_clarification": "брать руками"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "chwycić",
                                "target_lang_sense_clarification": "wykonać czynność szybko"
                            },
                            {
                                "target_lang_word": "złapać",
                                "target_lang_sense_clarification": "uchwycić dłonią"
                            },
                            {
                                "target_lang_word": "porwać",
                                "target_lang_sense_clarification": "gwałtownie zabrać"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抓住",
                                "target_lang_sense_clarification": "用手紧紧握住"
                            },
                            {
                                "target_lang_word": "抓",
                                "target_lang_sense_clarification": "动作迅速地拿取"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "863240d2-6c2f-3b41-82be-c5a055eebb81",
                    "sense_definition": "To get, collect, or pick up something quickly or informally.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "obtain_informal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will just <w>grab</w> my jacket and then we can leave.",
                            "target_lang_translations": {
                                "ru": "Я просто <w>захвачу</w> свою куртку, и мы сможем идти.",
                                "pl": "Tylko <w>wezmę</w> kurtkę i możemy wychodzić.",
                                "zh": "我<w>拿</w>上外套我们就可以走了。"
                            }
                        },
                        {
                            "text": "Come inside and <w>grab</w> a seat before the show starts.",
                            "target_lang_translations": {
                                "ru": "Заходи внутрь и <w>займи</w> место до начала шоу.",
                                "pl": "Wejdź do środka i <w>zajmij</w> miejsce, zanim zacznie się występ.",
                                "zh": "进来<w>找</w>个座位坐下，演出马上就要开始了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grab a seat",
                        "grab a taxi",
                        "grab a cab",
                        "grab one's things"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "very common in spoken English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро или неформально взять, получить или забрать что-либо.",
                        "pl": "Szybko lub nieformalnie coś wziąć, odebrać lub przynieść.",
                        "zh": "快速或非正式地拿取、收集或拾起某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взять",
                                "target_lang_sense_clarification": "получить или купить"
                            },
                            {
                                "target_lang_word": "захватить",
                                "target_lang_sense_clarification": "взять с собой"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wziąć",
                                "target_lang_sense_clarification": "zabrać ze sobą"
                            },
                            {
                                "target_lang_word": "zgarnąć",
                                "target_lang_sense_clarification": "szybko zabrać"
                            },
                            {
                                "target_lang_word": "pochwycić",
                                "target_lang_sense_clarification": "wziąć w pośpiechu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拿",
                                "target_lang_sense_clarification": "随手取走"
                            },
                            {
                                "target_lang_word": "顺便带上",
                                "target_lang_sense_clarification": "顺手取走某物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "964f5cd1-a900-375e-b0d8-73043ad90a31",
                    "sense_definition": "To eat or drink something quickly, often informally.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "consume_informal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We do not have much time, so let's just <w>grab</w> a sandwich.",
                            "target_lang_translations": {
                                "ru": "У нас мало времени, так что давай просто <w>возьмём</w> сэндвич.",
                                "pl": "Nie mamy dużo czasu, więc po prostu <w>przekąśmy</w> kanapkę.",
                                "zh": "我们没多少时间了，随便<w>买</w>个三明治吃吧。"
                            }
                        },
                        {
                            "text": "Is there enough time to <w>grab</w> a coffee before the meeting?",
                            "target_lang_translations": {
                                "ru": "Есть ли время <w>взять</w> кофе перед встречей?",
                                "pl": "Czy starczy czasu, żeby <w>wziąć</w> kawę przed spotkaniem?",
                                "zh": "开会前还有时间去<w>买</w>杯咖啡吗？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grab a bite",
                        "grab lunch",
                        "grab a coffee",
                        "grab a drink"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "very common in spoken English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро поесть или выпить что-либо, часто в неформальной обстановке.",
                        "pl": "Szybko coś zjeść lub wypić, zazwyczaj w nieformalnych okolicznościach.",
                        "zh": "快速地吃或喝某样东西，通常是非正式的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перекусить",
                                "target_lang_sense_clarification": "быстро поесть"
                            },
                            {
                                "target_lang_word": "взять",
                                "target_lang_sense_clarification": "купить еду или напиток"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przekąsić",
                                "target_lang_sense_clarification": "zjeść coś małego"
                            },
                            {
                                "target_lang_word": "wziąć",
                                "target_lang_sense_clarification": "kupić jedzenie na szybko"
                            },
                            {
                                "target_lang_word": "skoczyć na",
                                "target_lang_sense_clarification": "udać się na szybki posiłek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "随便吃点",
                                "target_lang_sense_clarification": "快速进食"
                            },
                            {
                                "target_lang_word": "买",
                                "target_lang_sense_clarification": "快速购买食物或饮料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "217256d4-1f89-336c-be1b-1aebfc67c6e1",
                    "sense_definition": "To try to seize or catch something by reaching out suddenly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect suddenly broke free and <w>grabbed</w> at the policeman's belt.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый внезапно вырвался и <w>схватился</w> за ремень полицейского.",
                                "pl": "Podejrzany nagle się wyrwał i <w>chwycił</w> za pas policjanta.",
                                "zh": "嫌疑人突然挣脱，并<w>伸手去抓</w>警察的腰带。"
                            }
                        },
                        {
                            "text": "Stop <w>grabbing</w> at the toys or you will not get any.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>хватать</w> игрушки, иначе ничего не получишь.",
                                "pl": "Przestań <w>wyrywać</w> zabawki, bo żadnej nie dostaniesz.",
                                "zh": "别再<w>伸手去抓</w>玩具了，不然你一个也得不到。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snatch"
                    ],
                    "common_phrases": [
                        "grab at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться схватить или поймать что-то, внезапно протянув руку.",
                        "pl": "Próbować coś pochwycić lub złapać, gwałtownie wyciągając rękę.",
                        "zh": "试图通过突然伸手来抓住或捕捉某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвататься",
                                "target_lang_sense_clarification": "пытаться удержаться или поймать"
                            },
                            {
                                "target_lang_word": "пытаться схватить",
                                "target_lang_sense_clarification": "делать попытку взять"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "chwytać się",
                                "target_lang_sense_clarification": "próbować się złapać"
                            },
                            {
                                "target_lang_word": "sięgać po",
                                "target_lang_sense_clarification": "próbować dosięgnąć i zabrać"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抓",
                                "target_lang_sense_clarification": "试图去抓取"
                            },
                            {
                                "target_lang_word": "伸手去抓",
                                "target_lang_sense_clarification": "做出抓取的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "376497b0-b39c-3896-9641-4d8b35538693",
                    "sense_definition": "To take or seize an opportunity eagerly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opportunity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>grab</w> the chance to travel while you are still young.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>ухватиться</w> за возможность путешествовать, пока ты молод.",
                                "pl": "Powinieneś <w>wykorzystać</w> szansę na podróże, póki jesteś młody.",
                                "zh": "你应该趁年轻<w>抓住</w>旅行的机会。"
                            }
                        },
                        {
                            "text": "The team managed to <w>grab</w> a victory in the final minutes of the game.",
                            "target_lang_translations": {
                                "ru": "Команде удалось <w>вырвать</w> победу на последних минутах игры.",
                                "pl": "Drużynie udało się <w>wydrzeć</w> zwycięstwo w ostatnich minutach meczu.",
                                "zh": "球队在比赛最后几分钟<w>抓住</w>了获胜的机会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "seize",
                        "snatch"
                    ],
                    "common_phrases": [
                        "grab a chance",
                        "grab an opportunity",
                        "grab the headlines"
                    ],
                    "target_lang_definitions": {
                        "ru": "С готовностью воспользоваться возможностью или шансом.",
                        "pl": "Chętnie i szybko skorzystać z nadarzającej się okazji.",
                        "zh": "热切地抓住或利用机会。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухватиться",
                                "target_lang_sense_clarification": "не упустить возможность"
                            },
                            {
                                "target_lang_word": "воспользоваться",
                                "target_lang_sense_clarification": "использовать шанс"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wykorzystać",
                                "target_lang_sense_clarification": "użyć okazji"
                            },
                            {
                                "target_lang_word": "chwycić",
                                "target_lang_sense_clarification": "nie przegapić szansy"
                            },
                            {
                                "target_lang_word": "uchwycić się",
                                "target_lang_sense_clarification": "skorzystać z możliwości"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抓住",
                                "target_lang_sense_clarification": "把握住机会"
                            },
                            {
                                "target_lang_word": "利用",
                                "target_lang_sense_clarification": "把握时机"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1d07588-95c1-3a9d-afb9-a185d8ba88b1",
                    "sense_definition": "To capture the attention or interest of someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "How does the idea of a weekend trip to the mountains <w>grab</w> you?",
                            "target_lang_translations": {
                                "ru": "Как тебе <w>нравится</w> идея поездки в горы на выходные?",
                                "pl": "Jak ci się <w>widzi</w> pomysł weekendowego wypadu w góry?",
                                "zh": "周末去山里旅行这个主意你觉得怎么样，<w>吸引</w>你吗？"
                            }
                        },
                        {
                            "text": "The opening scene of the movie really <w>grabs</w> your attention immediately.",
                            "target_lang_translations": {
                                "ru": "Начальная сцена фильма действительно сразу <w>захватывает</w> ваше внимание.",
                                "pl": "Początkowa scena filmu naprawdę natychmiast <w>przykuwa</w> uwagę.",
                                "zh": "电影的开场戏确实立刻就<w>吸引</w>了你的注意力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grab someone's attention",
                        "how does that grab you"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Завладеть вниманием или интересом кого-либо.",
                        "pl": "Przykuć czyjąś uwagę lub zainteresowanie.",
                        "zh": "吸引某人的注意或兴趣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захватывать",
                                "target_lang_sense_clarification": "увлекать, привлекать внимание"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przykuć",
                                "target_lang_sense_clarification": "zatrzymać uwagę"
                            },
                            {
                                "target_lang_word": "zaciekawić",
                                "target_lang_sense_clarification": "wzbudzić zainteresowanie"
                            },
                            {
                                "target_lang_word": "porywać",
                                "target_lang_sense_clarification": "fascynować"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吸引",
                                "target_lang_sense_clarification": "引起注意"
                            },
                            {
                                "target_lang_word": "打动",
                                "target_lang_sense_clarification": "引起兴趣"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c8b379b3-c710-3446-a8b3-9e806338dcf2",
                    "sense_definition": "A sudden attempt to take hold of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a <w>grab</w> for the ball, but it slipped through his fingers.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>схватить</w> мяч, но тот выскользнул из пальцев.",
                                "pl": "Podjął <w>próbę złapania</w> piłki, ale wyślizgnęła mu się z rąk.",
                                "zh": "他<w>抓</w>了一下球，但球从指间滑落了。"
                            }
                        },
                        {
                            "text": "The thief made a <w>grab</w> for her bag, but she held onto it tightly.",
                            "target_lang_translations": {
                                "ru": "Вор попытался <w>вырвать</w> её сумку, но она крепко держала её.",
                                "pl": "Złodziej próbował <w>wyrwać</w> jej torebkę, ale mocno ją trzymała.",
                                "zh": "小偷试图<w>抓</w>她的包，但她紧紧地抓住了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snatch"
                    ],
                    "common_phrases": [
                        "make a grab for",
                        "up for grabs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапная попытка схватить что-либо.",
                        "pl": "Nagła próba pochwycenia czegoś.",
                        "zh": "试图抓住某物的突然动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рывок",
                                "target_lang_sense_clarification": "резкое движение"
                            },
                            {
                                "target_lang_word": "попытка схватить",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "próba złapania",
                                "target_lang_sense_clarification": "ruch ręką"
                            },
                            {
                                "target_lang_word": "szarpnięcie",
                                "target_lang_sense_clarification": "gwałtowny ruch"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抓",
                                "target_lang_sense_clarification": "一次抓取的尝试"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4c7cd12-ab24-3ce4-bf67-1978665cd2c2",
                    "sense_definition": "A mechanical device designed to clutch, lift, or move objects.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crane used a powerful <w>grab</w> to lift the pile of scrap metal.",
                            "target_lang_translations": {
                                "ru": "Кран использовал мощный <w>захват</w>, чтобы поднять груду металлолома.",
                                "pl": "Dźwig użył potężnego <w>chwytaka</w>, aby podnieść stertę złomu.",
                                "zh": "起重机用一个强力的<w>抓斗</w>吊起了那堆废金属。"
                            }
                        },
                        {
                            "text": "Workers attached a heavy <w>grab</w> to the cable to remove debris from the well.",
                            "target_lang_translations": {
                                "ru": "Рабочие прикрепили тяжелый <w>захват</w> к тросу, чтобы убрать мусор из колодца.",
                                "pl": "Robotnicy przymocowali do liny ciężki <w>chwytak</w>, aby usunąć gruz ze studni.",
                                "zh": "工人们在缆绳上安装了一个沉重的<w>抓斗</w>，以清除井里的杂物。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context"
                        }
                    ],
