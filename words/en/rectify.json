{
    "word_family": [
        "rectification",
        "rectifier",
        "rectifiable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "305a284d-865f-3358-bbec-38febdf13e3a",
                    "sense_definition": "To correct or amend a mistake, error, or defect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "correct_fix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must <w>rectify</w> the situation as soon as possible to avoid further delays.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>исправить</w> ситуацию как можно скорее, чтобы избежать дальнейших задержек."
                            }
                        },
                        {
                            "text": "The company took immediate steps to <w>rectify</w> the mistake before the product was shipped.",
                            "target_lang_translations": {
                                "ru": "Компания предприняла незамедлительные меры, чтобы <w>исправить</w> ошибку до отправки товара."
                            }
                        }
                    ],
                    "synonyms": [
                        "correct",
                        "amend",
                        "fix",
                        "redress"
                    ],
                    "common_phrases": [
                        "rectify the mistake",
                        "rectify an error",
                        "rectify a defect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исправлять или устранять ошибку, недочет или дефект."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исправлять",
                                "target_lang_sense_clarification": "ошибку, дефект"
                            },
                            {
                                "target_lang_word": "устранять",
                                "target_lang_sense_clarification": "недостатки или ошибки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "801d2239-a937-3510-9b36-40c3c9779c3f",
                    "sense_definition": "To remedy or set right an undesirable situation or state of affairs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "correct_fix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is trying to <w>rectify</w> the situation before it worsens.",
                            "target_lang_translations": {
                                "ru": "Правительство пытается <w>исправить</w> ситуацию, пока она не ухудшилась."
                            }
                        },
                        {
                            "text": "New measures were introduced to <w>rectify</w> the situation and restore public confidence.",
                            "target_lang_translations": {
                                "ru": "Были введены новые меры, чтобы <w>исправить</w> ситуацию и восстановить доверие общественности."
                            }
                        }
                    ],
                    "synonyms": [
                        "remedy",
                        "resolve",
                        "resolve"
                    ],
                    "common_phrases": [
                        "rectify the situation",
                        "rectify a problem",
                        "rectify the crisis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшать, исправлять или урегулировать неблагоприятную ситуацию или положение дел."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исправлять",
                                "target_lang_sense_clarification": "ситуацию или положение"
                            },
                            {
                                "target_lang_word": "урегулировать",
                                "target_lang_sense_clarification": "проблему или кризис"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1312d8b2-54f2-37aa-a049-e7e21b05e6c4",
                    "sense_definition": "To convert alternating current (AC) into direct current (DC).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A diode is used to <w>rectify</w> the current in electrical circuits.",
                            "target_lang_translations": {
                                "ru": "Диод используется для того, чтобы <w>выпрямлять</w> ток в электрических цепях."
                            }
                        },
                        {
                            "text": "This electronic circuit can <w>rectify</w> alternating current into a stable direct current.",
                            "target_lang_translations": {
                                "ru": "Эта электронная схема может <w>выпрямлять</w> переменный ток в стабильный постоянный ток."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rectify alternating current",
                        "rectify current"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical domain"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Преобразовывать переменный ток в постоянный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпрямлять",
                                "target_lang_sense_clarification": "электрический ток"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d297d58-2fad-3d80-93b7-400ccb6c4d79",
                    "sense_definition": "To purify or refine a liquid substance by repeated distillation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chemists <w>rectify</w> alcohol to achieve a much higher purity level.",
                            "target_lang_translations": {
                                "ru": "Химики <w>ректифицируют</w> спирт, чтобы достичь гораздо более высокого уровня чистоты."
                            }
                        },
                        {
                            "text": "Specialized equipment is required to <w>rectify</w> spirits during the distillation process.",
                            "target_lang_translations": {
                                "ru": "Для того чтобы <w>очищать</w> спирты в процессе перегонки, требуется специализированное оборудование."
                            }
                        }
                    ],
                    "synonyms": [
                        "purify",
                        "distill",
                        "refine"
                    ],
                    "common_phrases": [
                        "rectify alcohol",
                        "rectify spirits"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical domain"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очищать или перегонять жидкое вещество путем повторной дистилляции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ректифицировать",
                                "target_lang_sense_clarification": "спирт или жидкость повторной перегонкой"
                            },
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "жидкость перегонкой"
                            },
                            {
                                "target_lang_word": "дистиллировать",
                                "target_lang_sense_clarification": "жидкое вещество"
                            }
                        ]
                    }
                }
            ]
        }
