                        "examples": [
                            {
                                "example_id": "39a168d6-87ad-4f5e-b2fd-3fcf9db2f492",
                                "sense_id": "0e2f26c9-a1d9-3706-9ce8-c0b544bc52be",
                                "text": "[…] corbeau Enfienter ma tête, et l’été, les manants, sans gêne, Montrant leur vilain cul, venaient se soulager."
                            },
                            {
                                "example_id": "4b721beb-dee5-4ec3-b202-44b44be66f5d",
