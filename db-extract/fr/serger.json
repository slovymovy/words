                ],
                "senses": [
                    {
                        "sense_id": "5ca5a26d-e97b-30cf-9c14-55aca68491e3",
                        "entry_id": "953494e6-2a2e-34ca-9f9f-c8c1b38b9164",
                        "glosses": [
                            "Celui qui fait des serges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ff1905c-32ed-4d82-9799-5fd304ca4326",
                                "sense_id": "5ca5a26d-e97b-30cf-9c14-55aca68491e3",
                                "text": "Les veuves des vinaigriers et des limonadiers, à Caen, qui, à la fin du xviiiᵉ siècle, étaient très nombreuses, celles des maîtres sergers, à Saint-Lô, qui, en 1730, sont, dans cette seule ville, au nombre de sept, celles des boulangers, chaudronniers, charrons, tourneurs d’Orléans, celles des tonneliers de Nantes, celles des diverses corporations mixtes de la ville de Paris (boulangers, bouchers, charcutiers, apothicaires, rôtisseurs, pâtissiers, épiciers, éventaillistes, tireurs d’or), ont un statut analogue."
                            },
                            {
                                "example_id": "4842e1d2-32a3-42c2-807a-dea46837a8b0",
                                "sense_id": "5ca5a26d-e97b-30cf-9c14-55aca68491e3",
                                "text": "Ils mangèrent et ils passèrent la nuit chez le serger."
                            },
                            {
                                "example_id": "3665188a-5f5a-4a53-bc77-cc346656e13d",
                                "sense_id": "5ca5a26d-e97b-30cf-9c14-55aca68491e3",
                                "text": "Au sud de cette zone, en pleine Champagne, le tissage l'emportait. Reims faisait vivre de gros centres. Ainsi, Tagnon fabriquait non seulement la serge, mais encore l’étamine (25 étaminiers et 25 sergers)."
                            }
                        ]
                    }
                ],
