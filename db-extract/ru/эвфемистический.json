                                    {
                                        "sense_id": "849addcb-d3a4-34bd-ac65-24f910321d7e",
                                        "entry_id": "e034f2d2-6fd5-371f-8657-7a7c5655c382",
                                        "glosses": [
                                            "etwas freundlicher darstellend, als es der Wirklichkeit entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5045a542-8fce-4926-9cf3-af4b4d76d990",
                                                "sense_id": "849addcb-d3a4-34bd-ac65-24f910321d7e",
                                                "text": "„Nullwachstum“ ist eine euphemistische Bezeichnung für Stagnation in der Wirtschaftsentwicklung."
                                            },
                                            {
                                                "example_id": "22789e35-9dd7-4d34-9977-212b6c8b8a54",
                                                "sense_id": "849addcb-d3a4-34bd-ac65-24f910321d7e",
                                                "text": "„Wie ‚Frau‘, so steht auch das Wort ‚Mädel‘ häufig euphemistisch für ›Prostituierte‹.“"
                                            },
                                            {
                                                "example_id": "d5f779c0-e3fa-466d-b785-2345482c2f86",
                                                "sense_id": "849addcb-d3a4-34bd-ac65-24f910321d7e",
                                                "text": "„Euphemistische Funktionen (verhüllen, aufbessern, verdecken) haben viele Wörter, die negative soziale Erscheinungen benennen.“"
                                            }
                                        ],
