                        "glosses": [
                            "Curare non dépolarisant de la famille des aminostéroïdes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c0480c1-9cb6-48de-b5d2-0391c1b405b2",
                                "sense_id": "d02b75d1-ce25-3a58-b0d7-bdc60e05f294",
                                "text": "Les myorelaxants à longue durée d’action tel le pancuronium ne sont pas recommandés, et on leur préfère des myorelaxants à courte ou moyenne durée d’action tels le vecuronium, le cisatracurium, le mivacurium ou le rocuronium."
                            }
                        ]
