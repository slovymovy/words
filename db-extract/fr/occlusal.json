                "senses": [
                    {
                        "sense_id": "0ea8ab2b-ad31-33b1-b813-68c0ea210c82",
                        "entry_id": "77e6b43d-1205-3897-b422-2c6782b4d8c9",
                        "glosses": [
                            "Relatif à l’occlusion dentaire, à la manière dont s’engrènent les dents opposées des mâchoires supérieure et inférieure (maxillaires et mandibulaires)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab39c4dd-d679-4bf0-b36c-b51508b28fb1",
                                "sense_id": "0ea8ab2b-ad31-33b1-b813-68c0ea210c82",
                                "text": "Parfois, il est nécessaire de réaliser des calages dentaires de surélévation, afin de rétablir des contacts occlusaux défaillants. Le port de gouttières nocturnes ou en permanence peut aussi être indiqué, afin de rétablir un équilibre oclusal."
                            },
                            {
                                "example_id": "8caf1e38-97ab-4199-ab6e-9cb33ce56f14",
                                "sense_id": "0ea8ab2b-ad31-33b1-b813-68c0ea210c82",
                                "text": "Une interférence occlusale peut être considérée comme un obstacle au déplacement aisé de la mandibule au cours des déplacements mandibulaires, pouvant nuire au déroulement de certaines fonctions manducatrices comme la mastication, la dilacération, la déglutition, et surtout l’incision."
                            }
                        ]
                    }
