                    {
                        "sense_id": "8f226bf7-b397-379d-bd56-3cdb9807a042",
                        "entry_id": "9f265f65-6c0c-3102-b581-c267474dcced",
                        "glosses": [
                            "早午餐"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c96d17d-d8a5-462e-88e6-7af716697fd3",
                                "sense_id": "8f226bf7-b397-379d-bd56-3cdb9807a042",
                                "text": "I normally have brunch at the café next to work.",
                                "translation": "我通常会在公司旁边的咖啡馆吃早午餐。"
                            },
                            {
                                "example_id": "5cf4e8cc-f823-458c-bb7f-92d010b5df93",
                                "sense_id": "8f226bf7-b397-379d-bd56-3cdb9807a042",
                                "text": "Let's do brunch sometime at the salad bar!",
                                "translation": "咱们找个时间去沙拉吧吃早午餐吧！"
                            },
                            {
                                "example_id": "ad7c084f-d4b0-434e-960d-61952f47962d",
                                "sense_id": "8f226bf7-b397-379d-bd56-3cdb9807a042",
                                "text": "Feeling a bit peckish, Sandra made herself some brunch with the leftovers in her fridge.",
                                "translation": "桑德拉感觉有点饿了，于是用冰箱里的剩菜给自己做了顿早午餐。"
                            },
                            {
                                "example_id": "6e5a6baa-b8ef-4533-b667-1b22c831ad24",
                                "sense_id": "8f226bf7-b397-379d-bd56-3cdb9807a042",
                                "text": "I discovered a meal between breakfast and brunch.",
                                "translation": "我发现了一种介于早餐和早午餐之间的餐点。"
                            }
                        ]
                    }
                ],
