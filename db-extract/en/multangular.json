                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c0bf6f9-363a-3fd9-925a-b49afb107241",
                        "entry_id": "e08a8e55-c691-3cb3-96ed-4f5d636bdd76",
                        "glosses": [
                            "Either of two bones in the wrist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa349155-9ec0-4cdb-8344-a4ebe8814a60",
                                "sense_id": "5c0bf6f9-363a-3fd9-925a-b49afb107241",
                                "text": "The roentgenograms showed local loss of density of the navicular, the multangulars, and the cuboid."
                            },
                            {
                                "example_id": "9ee410a7-b9e7-4678-b3a1-af2d9da35724",
                                "sense_id": "5c0bf6f9-363a-3fd9-925a-b49afb107241",
                                "text": "The distal fragment in contact with the multangulars now has a porosity not seen in the preceding figures."
                            },
                            {
                                "example_id": "fd761ac0-9131-49bb-910d-e793493f2abc",
                                "sense_id": "5c0bf6f9-363a-3fd9-925a-b49afb107241",
                                "text": "Very strong ligaments secure the distal half of the scaphoid to the multangulars and capitate. Similarly the proximal half has a strong attachment to the lunate."
                            },
                            {
                                "example_id": "946bb08d-934b-4b2d-b04f-d7b6ab60719f",
                                "sense_id": "5c0bf6f9-363a-3fd9-925a-b49afb107241",
                                "text": "There is now narrowing of some of the carpal joint spaces, particularly that between the navicular and the multangulars."
                            }
                        ]
                    },
                    {
                        "sense_id": "481e6849-2d51-39a7-991c-c122cf9c4b31",
                        "entry_id": "e08a8e55-c691-3cb3-96ed-4f5d636bdd76",
                        "glosses": [
