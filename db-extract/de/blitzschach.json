                    },
                    {
                        "translation_id": "e1f6f43b-d8af-4873-b015-2f62e23e4210",
                        "source_entry_id": "40b6ac57-0db4-3a07-898e-31ec1bf71649",
                        "source_sense_id": "45e9c19b-0e6d-39eb-adba-a6d4c09f75f9",
                        "source_sense_description": "Form des Schachspiels, wobei jeder Spieler für die gesamte Partie nur wenige Minuten Zeit hat",
                        "target_lang_word": "blitz",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blitz",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "adff526f-f39f-3009-a3bc-cf69043b0679",
                                        "entry_id": "9503f013-70ee-3338-b0c4-2e7528d99527",
                                        "glosses": [
                                            "Blitzkrieg, violente attaque aérienne déclenchée, pendant la guerre de 1939-1945, par les avions de bombardement et les engins V1 et V2 allemands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b5b2cb4-9fdb-4944-a7ef-a99045452289",
                                                "sense_id": "adff526f-f39f-3009-a3bc-cf69043b0679",
                                                "text": "Bien sûr, sur la route de Londres dont nous approchions dans le black-out et que rien ne laissait deviner, quand mille canons se mirent à carillonner. Ce n'était pas encore le blitz."
                                            },
                                            {
                                                "example_id": "d80a13e1-61df-4d6c-b857-c4f354c8d901",
                                                "sense_id": "adff526f-f39f-3009-a3bc-cf69043b0679",
                                                "text": "C’est dans l’après-midi du 7 septembre 1940 que débute le blitz, avec un très violent bombardement de Londres qui se prolonge toute la nuit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03c0b48e-f92c-3885-8dfc-f42c18eb9af8",
                                        "entry_id": "9503f013-70ee-3338-b0c4-2e7528d99527",
                                        "glosses": [
                                            "Attaque soudaine."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e0a5e1f-f256-45f7-a2da-c73c0a43be18",
                                                "sense_id": "03c0b48e-f92c-3885-8dfc-f42c18eb9af8",
                                                "text": "Mené sur tout le territoire national, et destiné à frapper un grand coup contre la ’Ndrangheta, la mafia calabraise, ce « blitz » (comme disent les Italiens) avait pour épicentre Reggio de Calabre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62665279-916f-3180-b8a3-87cb75a76cb5",
                                        "entry_id": "9503f013-70ee-3338-b0c4-2e7528d99527",
                                        "glosses": [
                                            "Au jeu d’échecs et au jeu de go, partie très rapide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d4f83be-aba0-4e22-9e70-56369c3c2485",
                                                "sense_id": "62665279-916f-3180-b8a3-87cb75a76cb5",
                                                "text": "Un blitz est une partie d'échecs jouée en cadence rapide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
