                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10ec8246-77b8-4e1a-be35-d941e20709a6",
                                                "sense_id": "a4bc0561-2179-3768-8609-5cc3c48c9238",
                                                "text": "Sein Herz klopft wild."
                                            },
                                            {
                                                "example_id": "c0e87e8a-c46f-41c6-8bfc-e4e41518c13f",
                                                "sense_id": "a4bc0561-2179-3768-8609-5cc3c48c9238",
                                                "text": "Diese wilde Musik gefällt mir nicht."
                                            },
                                            {
                                                "example_id": "b77126ab-0445-481f-9f02-3e4c18563078",
                                                "sense_id": "a4bc0561-2179-3768-8609-5cc3c48c9238",
                                                "text": "Draußen herrschte ein wilder Sturm, sodass sich die Bäume neigten."
