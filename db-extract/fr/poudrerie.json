        "fr-extract.jsonl": [
            {
                "entry_id": "ba7eafaa-5975-30fe-aedb-da9e64935008",
                "word": "poudrerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "78ebdaba-f069-44ea-9388-7406ba32a287",
                        "entry_id": "ba7eafaa-5975-30fe-aedb-da9e64935008",
                        "tags": [
                            "plural"
                        ],
                        "form": "poudreries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b3e680d-a840-3b7e-af3c-c22fb4fba0eb",
                        "entry_id": "ba7eafaa-5975-30fe-aedb-da9e64935008",
                        "glosses": [
                            "Fabrique de poudre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97a117ec-5953-400f-bf34-9456f59b3f55",
                                "sense_id": "1b3e680d-a840-3b7e-af3c-c22fb4fba0eb",
                                "text": "La poudrerie du Luxembourg venait de sauter."
                            }
                        ]
                    },
                    {
                        "sense_id": "89c3a583-0694-3891-a110-bc32c7959c6b",
                        "entry_id": "ba7eafaa-5975-30fe-aedb-da9e64935008",
                        "glosses": [
                            "Fine neige soulevée par le vent, poudreuse."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "4f6efb81-e01b-4908-bc82-15328a36dc6c",
                                "sense_id": "89c3a583-0694-3891-a110-bc32c7959c6b",
                                "text": "Il eût été surprenant que le français parlé en Amérique, arraché à la mère-patrie et isolé pendant tant de générations, ne s’adapte pas aux besoins des gens de ce pays de poudrerie, de domination anglaise et de pauvreté paysanne."
                            },
                            {
                                "example_id": "56b4ad9c-56b1-4eb4-ba86-1cd52b396d61",
                                "sense_id": "89c3a583-0694-3891-a110-bc32c7959c6b",
                                "text": "Ces régions ne devaient recevoir que peu de neige au cours de la soirée et de la nuit, mais les vents devaient continuer de causer de la poudrerie par endroits."
                            }
                        ]
                    },
                    {
                        "sense_id": "baa78aa9-fd1a-39f9-a639-28280f26e752",
                        "entry_id": "ba7eafaa-5975-30fe-aedb-da9e64935008",
                        "glosses": [
                            "Neige légère qui se déplace à l’horizontale."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "b47c92a7-fa1a-4823-80a2-3c043d70760d",
                                "sense_id": "baa78aa9-fd1a-39f9-a639-28280f26e752",
                                "text": "Le blanc y était parfaitement étale, une mince poudrerie balayant la surface pour plus de splendeur encore."
                            },
                            {
                                "example_id": "7f76dc86-0156-40ba-a9f4-76daa94421ce",
                                "sense_id": "baa78aa9-fd1a-39f9-a639-28280f26e752",
                                "text": "Une poudrerie de tous les diables n’avait cessé de balayer le Québec de part en part, transformant trottoirs et rues en patinoires."
                            },
                            {
                                "example_id": "6a234047-0282-4f55-8b3a-32fb3f72b71f",
                                "sense_id": "baa78aa9-fd1a-39f9-a639-28280f26e752",
                                "text": "Poudrerie et fermeture de route\n La neige parfois forte combinée aux forts vents devrait générer de la poudrerie, ce qui risque de compliquer grandement les déplacements des Québécois. Des fermetures de route sont à prévoir en bordure du fleuve."
                            }
                        ]
                    }
                ],
