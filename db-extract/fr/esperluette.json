                "senses": [
                    {
                        "sense_id": "2610bd35-8949-3b1b-b6ab-f8907e30ee17",
                        "entry_id": "fee3e5b7-70e2-366e-899d-40aca0b06056",
                        "glosses": [
                            "Logogramme & correspondant à la conjonction de coordination et."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4db8d9d-684a-46cc-bb3b-bb2b6f31fd05",
                                "sense_id": "2610bd35-8949-3b1b-b6ab-f8907e30ee17",
                                "text": "L’esperluette permet d’opérer une distinction entre les champs d’une classe et les composants d’un type SEQUENCE ou SET."
                            },
                            {
                                "example_id": "6220d306-65b4-4bd4-9dbc-c8f9f2385ac9",
                                "sense_id": "2610bd35-8949-3b1b-b6ab-f8907e30ee17",
                                "text": "L’esperluette (&) précédant la lettre d’un nom de menu indique la touche de raccourci, qui apparaîtra en souligné."
                            },
                            {
                                "example_id": "670db1b6-9c15-46f2-8609-7f413630b69d",
                                "sense_id": "2610bd35-8949-3b1b-b6ab-f8907e30ee17",
                                "text": "L’esperluette (&) placée avant le nom de la variable dans la définition de ma multiplication () indique que $valeur doit être passée par référence."
                            },
                            {
                                "example_id": "7b649028-5a7f-416c-9841-f30887c9aa1a",
                                "sense_id": "2610bd35-8949-3b1b-b6ab-f8907e30ee17",
                                "text": "Le symbole & s’appelle le « et commercial » ou encore l’« esperluette ». Il est présent sur la touche 1 d’un clavier AZERTY."
                            },
                            {
                                "example_id": "ad936bf8-3db6-49c6-8309-43eb84678b7d",
                                "sense_id": "2610bd35-8949-3b1b-b6ab-f8907e30ee17",
                                "text": "S'il y a plusieurs auteurs, les noms des deux derniers seront séparés par une esperluette (&)."
                            }
                        ]
                    }
                ],
