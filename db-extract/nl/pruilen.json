        "nl-extract.jsonl": [
            {
                "entry_id": "5b4e659c-44ae-39c0-a936-a4ee88058e52",
                "word": "pruilen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5cb643d8-c838-308e-844e-9992222fbd6e",
                        "entry_id": "5b4e659c-44ae-39c0-a936-a4ee88058e52",
                        "glosses": [
                            "boos en ontevreden zijn zonder te zeggen waarom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0b2fb7-8e21-46c7-9920-c9f43e9dc2eb",
                                "sense_id": "5cb643d8-c838-308e-844e-9992222fbd6e",
                                "text": "Ondertussen zat Jan Peumans nog steeds in een hoekje te pruilen, gekwetst door de miskenning van zijn komische talenten."
                            }
                        ]
                    },
                    {
                        "sense_id": "1da87042-8891-30a5-9c5e-38d8f7b7487f",
                        "entry_id": "5b4e659c-44ae-39c0-a936-a4ee88058e52",
                        "glosses": [
                            "droevig zijn zonder geluid te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b39df40-26a9-4c67-9566-948be1847bd6",
                                "sense_id": "1da87042-8891-30a5-9c5e-38d8f7b7487f",
                                "text": "Ze pruilt, barst uit in irrationele woede, of huilt geluidloos."
                            },
                            {
                                "example_id": "5ef13dba-77b1-469b-b813-de79291bca31",
                                "sense_id": "1da87042-8891-30a5-9c5e-38d8f7b7487f",
                                "text": "Baby Ella is wereldberoemd geworden. Niet omdat ze zo lief lacht, maar omdat ze zo lief huilt. Haar ouders Krissy en Matt maakten een filmpje waarin de kleine meid stikjaloers is. Iedere keer als haar ouders elkaar een zoen geven, begint haar lipje te pruilen en barst ze in huilen uit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
