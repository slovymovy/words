                                                "sense_id": "88d93fab-7ed4-3ffd-9208-80e64a6a1299",
                                                "text": "Door een video te maken met deepfake kan men mensen op video dingen laten zeggen die ze in het echt nooit zouden zeggen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5de8adba-c15e-3b65-87a6-a21d5b493f06",
                                        "entry_id": "41299b7a-2209-3491-8f97-da1eaf919239",
                                        "glosses": [
                                            "levensechte video die bestaat uit beelden die met kunstmatige intelligentie uit bestaande opnamen zijn gemaakt"
                                        ],
                                        "tags": [
                                            "media"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3067a741-a733-4da9-a855-a499bd06ac19",
                                                "sense_id": "5de8adba-c15e-3b65-87a6-a21d5b493f06",
                                                "text": "Dit keer kijken we naar twee deepfakes: bewerkte video's waarin het lijkt alsof iemand iets zegt wat die in werkelijkheid nooit gezegd heeft."
                                            }
                                        ]
                                    }
                                ]
                            }
