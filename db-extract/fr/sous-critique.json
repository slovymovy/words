                "senses": [
                    {
                        "sense_id": "bb6a3b68-4054-3d73-8ff7-8224dd4d2c09",
                        "entry_id": "9fd26814-8dc7-3a7a-9cba-2cb06f2bddf2",
                        "glosses": [
                            "En dessous d’un seuil entraînant un changement d’état, de régime."
                        ],
                        "tags": [
                            "generally",
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "e4b6ff29-3cb5-4cc1-b59e-ed6fda10afe0",
                                "sense_id": "bb6a3b68-4054-3d73-8ff7-8224dd4d2c09",
                                "text": "Toutefois, les verres silicatés sont sensibles à l’eau, et une réaction d'hydrolyse peut faire avancer la fissure dès lors qu’elle subit une contrainte de tension inférieure à ce seuil : on appelle cela de la propagation sous-critique."
                            },
                            {
                                "example_id": "3ef16380-77e1-4a70-a5b5-37fa677a0920",
                                "sense_id": "bb6a3b68-4054-3d73-8ff7-8224dd4d2c09",
                                "text": "Comme ils le font pour la sphère, les ingénieurs attribuent donc au cylindre deux C_x : le C_x sous-critique (autour de 1,2) et le C_x supercritique (autour de 0,2)."
                            }
                        ]
                    },
                    {
                        "sense_id": "518039be-fc96-3444-b1dd-d49fc5e9033d",
                        "entry_id": "9fd26814-8dc7-3a7a-9cba-2cb06f2bddf2",
                        "glosses": [
                            "Se dit d’un assemblage de matière fissile dont le facteur de multiplication effectif est inférieur à 1."
                        ],
                        "tags": [
                            "Nucléaire"
                        ],
                        "examples": [
                            {
                                "example_id": "518301ab-9013-462c-8245-26ce16fa0dbb",
                                "sense_id": "518039be-fc96-3444-b1dd-d49fc5e9033d",
                                "text": "Si k_(eff) est inférieur à 1, on a un « étouffement » de la réaction : le réacteur est sous-critique."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b0a2bc8-3057-37f6-bee7-c62283e5a00a",
                        "entry_id": "9fd26814-8dc7-3a7a-9cba-2cb06f2bddf2",
                        "glosses": [
                            "Se dit d’un chemin non critique, c’est-à-dire d’une suite de tâches dont la durée offre une certaine marge sans altérer la durée du projet."
                        ],
