                        "glosses": [
                            "Où croît le gazon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1e8a7b4-1080-4ea3-a622-4864d95f8ea3",
                                "sense_id": "0d5fbb4c-f04e-3ec5-a9fe-2de9ce3e7d9f",
                                "text": "Pour ne faire aucun bruit et pour rester dans l'ombre, elle suivit, le long des allées, la lisière gazonneuse des bois."
                            },
                            {
                                "example_id": "0f0f50ae-a440-4ed6-ad8e-89db9e6bfdf1",
                                "sense_id": "0d5fbb4c-f04e-3ec5-a9fe-2de9ce3e7d9f",
                                "text": "On menait paître ces animaux sur les parties gazonneuses du cap Bathurst, et on faisait provision de l'herbe courte et sèche, qui tapissait les talus, pour les besoins de l'hiver."
                            },
                            {
                                "example_id": "914a5a6c-2ae9-45f1-aa86-57e638083b3e",
                                "sense_id": "0d5fbb4c-f04e-3ec5-a9fe-2de9ce3e7d9f",
                                "text": "Le soleil se couchait sur une riche et gazonneuse clairière de cette forêt que nous avons signalée au commencement de ce chapitre ; … ."
                            }
                        ]
                    }
