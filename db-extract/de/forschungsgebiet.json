                "senses": [
                    {
                        "sense_id": "c5142cff-c52a-3be4-a08f-7b46e3d56064",
                        "entry_id": "ee0a5349-adfc-3e1e-ab7b-f46bd467569b",
                        "glosses": [
                            "inhaltlich zusammenhängender Bereich von Gegenständen, an denen geforscht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "399c9e85-53fc-4834-8afa-4f83c424d769",
                                "sense_id": "c5142cff-c52a-3be4-a08f-7b46e3d56064",
                                "text": "„Eigentlich ist sie keine Expertin für Vögel - ihr Forschungsgebiet sind Moschusochsen, jene Urviecher, die jemand in den Sechzigerjahren in der Nähe des Flughafens von Kangerlussuaq angesiedelt hat - und die sehr zartes Fleisch liefern.“"
                            },
                            {
                                "example_id": "91ec8b82-d953-4715-ba0c-0f02328c1b4b",
                                "sense_id": "c5142cff-c52a-3be4-a08f-7b46e3d56064",
                                "text": "„Was ihm half, sein fünftes und sechstes Lebensjahrzehnt zu überstehen, waren seine Frau Claire, seine zwei Kinder und sein neues Forschungsgebiet: die Anwendung von radioaktiven Isotopen bei der Therapie bösartiger Krankheiten.“"
                            },
                            {
                                "example_id": "77a7e75d-d998-43c6-b61b-3a852ea2afa7",
                                "sense_id": "c5142cff-c52a-3be4-a08f-7b46e3d56064",
                                "text": "„Im ersten Semester durften die Studierenden ihr Forschungsgebiet selbst bestimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
