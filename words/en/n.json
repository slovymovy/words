                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the dictionary, nouns marked with <w>n</w> are neither masculine nor feminine.",
                            "target_lang_translations": {
