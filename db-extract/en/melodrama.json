                                    {
                                        "sense_id": "7858c495-3fff-37f8-8882-1d4b2fb13487",
                                        "entry_id": "25510f1c-68bb-3eb5-aeb6-bc57831753a1",
                                        "glosses": [
                                            "Especie de drama, de acción ordinariamente complicada y jocoseria, y cuyo principal objeto es despertar en la audiencia cierto linaje de vulgar curiosidad y emoción. Representábase acompañado de música instrumental en varios pasajes y ocasiones."
                                        ],
                                        "tags": [
                                            "Cine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5daedf66-d5e5-4bb6-8f9e-e0526e885b92",
                                                "sense_id": "7858c495-3fff-37f8-8882-1d4b2fb13487",
                                                "text": "No te pongas tan serio, Jim. Eres como uno de los héroes de esos melodramas estúpidos que a nuestra madre tanto le gustaba representar»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "011f1771-b09c-3556-8d93-5e5c622b10aa",
