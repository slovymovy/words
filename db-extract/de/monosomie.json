                "senses": [
                    {
                        "sense_id": "0bc2ca68-898a-3343-8bcd-e3815d840ebd",
                        "entry_id": "8c177c17-3cc5-3db4-9c09-18a223543d32",
                        "glosses": [
                            "genetische Störung, bei der im sonst diploiden Chromosomensatz ein bestimmtes Chromosom nur einfach vorliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0981c0d3-c6bd-4467-9527-2000d543a4d8",
                                "sense_id": "0bc2ca68-898a-3343-8bcd-e3815d840ebd",
                                "text": "Ein Beispiel für eine Monosomie ist das Ullrich-Turner-Syndrom (z.B. 45,X0), bei welchem ein Gonosom fehlt, das Fehlen eines Autosoms ist beim Menschen mit dem Leben nicht vereinbar"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
