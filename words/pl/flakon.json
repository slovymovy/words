{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "933b787f-2d16-3486-9815-c98945e6dab0",
                    "sense_definition": "ozdobna buteleczka, zazwyczaj szklana, służąca do przechowywania perfum lub innych pachnideł",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perfumy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na toaletce stał elegancki szklany <w>flakon</w> drogich francuskich perfum.",
                            "target_lang_translations": {
                                "ru": "На туалетном столике стоял элегантный стеклянный <w>флакон</w> дорогих французских духов."
                            }
                        },
                        {
                            "text": "Kupiła piękny <w>flakon</w> perfum jako prezent urodzinowy dla swojej siostry.",
                            "target_lang_translations": {
                                "ru": "Она купила красивый <w>флакон</w> духов в подарок на день рождения сестре."
                            }
                        }
                    ],
                    "common_phrases": [
                        "szklany flakon",
                        "flakon perfum"
                    ],
                    "target_lang_definitions": {
                        "ru": "декоративная бутылочка, обычно стеклянная, предназначенная для духов или других благовоний"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флакон",
                                "target_lang_sense_clarification": "для духов, косметики"
                            },
                            {
                                "target_lang_word": "флакончик",
                                "target_lang_sense_clarification": "небольшой флакон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eba6f275-4e63-3921-b7a5-a55b55b1d842",
                    "sense_definition": "wąskie naczynie na cięte kwiaty; wazon",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "naczynie_kwiaty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Włóż świeże kwiaty do <w>flakonu</w>, zanim zupełnie zwiędną na stole.",
                            "target_lang_translations": {
                                "ru": "Поставь свежие цветы в <w>вазочку</w>, пока они совсем не завяли на столе."
                            }
                        },
                        {
                            "text": "Na parapecie w kuchni postawiła wąski <w>flakon</w> z pojedynczą czerwoną różą.",
                            "target_lang_translations": {
                                "ru": "На подоконнике в кухне она поставила узкую <w>вазочку</w> с одной красной розой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flakon na kwiaty"
                    ],
                    "target_lang_definitions": {
                        "ru": "узкий сосуд для срезанных цветов; вазочка"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вазочка",
                                "target_lang_sense_clarification": "для цветов, узкая ваза"
                            },
                            {
                                "target_lang_word": "ваза",
                                "target_lang_sense_clarification": "для цветов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f84fae34-f6fd-3b36-9953-34a14ab2b7cd",
                    "sense_definition": "ilość płynu mieszcząca się w buteleczce perfum",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "perfumy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W ciągu zaledwie dwóch miesięcy zużyła cały <w>flakon</w> swojej ulubionej wody toaletowej.",
                            "target_lang_translations": {
                                "ru": "Всего за два месяца она израсходовала целый <w>флакон</w> своей любимой туалетной воды."
                            }
                        },
                        {
                            "text": "Ten zapach podobał mu się tak bardzo, że w pół roku wypryskał kolejny <w>flakon</w>.",
                            "target_lang_translations": {
                                "ru": "Этот аромат ему так нравился, что за полгода он использовал еще один <w>флакон</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cały flakon",
                        "zużyć flakon"
                    ],
                    "target_lang_definitions": {
                        "ru": "количество жидкости, вмещающееся во флакон духов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флакон",
                                "target_lang_sense_clarification": "мера объема духов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9085f218-83e1-3e11-b78d-547dc7cb0e47",
                    "sense_definition": "butelka z alkoholem, zwłaszcza wódką",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "alkohol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sąsiedzi przynieśli ze sobą <w>flakon</w> wódki, aby uczcić rozpoczęcie weekendu.",
                            "target_lang_translations": {
                                "ru": "Соседи принесли с собой <w>пузырь</w> водки, чтобы отпраздновать начало выходных."
                            }
                        },
                        {
                            "text": "Po skończonej pracy kupili w pobliskim sklepie zimny <w>flakon</w> na wieczór.",
                            "target_lang_translations": {
                                "ru": "После окончания работы они купили в соседнем магазине холодную <w>бутылку</w> на вечер."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flakon wódki"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "бутылка спиртного, особенно водки (сленг)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пузырь",
                                "target_lang_sense_clarification": "бутылка алкоголя, жарг."
                            },
                            {
                                "target_lang_word": "бутылка",
                                "target_lang_sense_clarification": "алкоголя"
                            },
                            {
                                "target_lang_word": "фунфырик",
                                "target_lang_sense_clarification": "жарг., алкоголь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
