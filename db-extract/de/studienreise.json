                "senses": [
                    {
                        "sense_id": "fcb16ebb-9af8-3d4d-b261-1193bc038dd0",
                        "entry_id": "bb18f107-803b-3e40-b9fe-77dba7aa149a",
                        "glosses": [
                            "Reise, die der Bildung oder weiteren Ausbildung des Reisenden dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c694177c-8f25-4fd6-a03a-6ec7409a2eb9",
                                "sense_id": "fcb16ebb-9af8-3d4d-b261-1193bc038dd0",
                                "text": "„Die Themenwahl bezog sich einerseits auf das persönliche Interesse über den vorbildlichen Sozialstaat und anderseits auf die bevorstehende Studienreise nach Rotterdam.“"
                            },
                            {
                                "example_id": "94f69eb3-1fdd-4820-adda-5c40795557eb",
                                "sense_id": "fcb16ebb-9af8-3d4d-b261-1193bc038dd0",
                                "text": "„Dem Weihnachtsoratorium lauscht man Hand in Hand im Dom, bevor man zur Studienreise aufbricht, um Palladios Villen zu besichtigen.“"
                            },
                            {
                                "example_id": "9c74f629-62d4-4b92-a258-105f42b3c72d",
                                "sense_id": "fcb16ebb-9af8-3d4d-b261-1193bc038dd0",
                                "text": "„In Berlin hatte er eine gemeinsame Ausstellung mit Edvard Munch, und später unternahm er lange Studienreisen nach Kenia und Mexiko.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
