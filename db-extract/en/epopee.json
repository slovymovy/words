                                        "examples": [
                                            {
                                                "example_id": "aab100c7-24ae-4134-b67e-fbdb5f021713",
                                                "sense_id": "cc8ad67d-fb10-317b-ba0a-ae9ea870d278",
                                                "text": "l'epopea dei Templari, incominciata il 13 ottobre 1307, fini con Filippo il Bello che li fece arrestare"
                                            },
                                            {
                                                "example_id": "9b5465a0-9a7d-4f2e-b484-c7479d049bf9",
                                                "sense_id": "cc8ad67d-fb10-317b-ba0a-ae9ea870d278",
                                                "text": "Gilgamesh è espressione dell'epopea mesopotamica"
                                            },
                                            {
                                                "example_id": "5b7c0480-f1de-4365-a996-d698e24d8af3",
                                                "sense_id": "cc8ad67d-fb10-317b-ba0a-ae9ea870d278",
                                                "text": "l'Iliade e l'Odissea sono espressione dell'epopea greca"
                                            },
                                            {
                                                "example_id": "ff31067a-d8b2-4000-abe0-9f9079ca66b7",
                                                "sense_id": "cc8ad67d-fb10-317b-ba0a-ae9ea870d278",
                                                "text": "l'Eneide è espressione dell'epopea romana"
                                            },
                                            {
                                                "example_id": "9dc5bf4b-3396-45c9-bdc0-19a71d48b536",
                                                "sense_id": "cc8ad67d-fb10-317b-ba0a-ae9ea870d278",
                                                "text": "la Canzone di Orlando è espressione dell'epopea francese"
                                            },
                                            {
                                                "example_id": "cbb0731e-894b-43ae-a73b-7c1316529cb3",
                                                "sense_id": "cc8ad67d-fb10-317b-ba0a-ae9ea870d278",
                                                "text": "il Poema del Cid è espressione dell'epopea spagnola"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe89aae2-2e98-4d7a-a73b-8ce019a92fea",
                        "source_entry_id": "89226556-5f1e-3945-b577-650c72a22eac",
                        "source_sense_id": "9a7b11fc-6be0-3e92-b1f1-9804e4db109d",
                        "source_sense_description": "an epic, saga",
                        "target_lang_word": "epopeja",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epopeja",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "cecafc52-de56-3382-8a90-fa2082fbd011",
                                        "entry_id": "45f4329f-261b-3e5b-9880-d97eddc34c8b",
                                        "glosses": [
                                            "dłuższy poemat epicki"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d352fd39-db44-4770-a729-fe202b08f1c1",
                                                "sense_id": "cecafc52-de56-3382-8a90-fa2082fbd011",
                                                "text": "Czy wiesz, która epopeja została napisana heksametrem?"
                                            },
                                            {
                                                "example_id": "21177ca8-df30-4afe-8599-d43a185d7d68",
                                                "sense_id": "cecafc52-de56-3382-8a90-fa2082fbd011",
                                                "text": "Stefan Żeromski napisał swoją epopeję „Powieść o Udałym Walgierzu” w roku 1905."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "53eed199-f43a-3486-87a4-c72b0bec1b73",
                                        "entry_id": "45f4329f-261b-3e5b-9880-d97eddc34c8b",
                                        "glosses": [
                                            "dzieło literackie przedstawiające dzieje narodu w przełomowym dla niego momencie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19d818b9-fb4e-4642-86ed-5b7470faaeed",
                                                "sense_id": "53eed199-f43a-3486-87a4-c72b0bec1b73",
                                                "text": "Typowymi epopejami narodowymi są: „Iliada”, „Odyseja”, „Pieśń o Rolandzie”, „Pieśń o Nibelungach” czy nasz rodzimy Mickiewiczowski „Pan Tadeusz”."
                                            },
                                            {
                                                "example_id": "e8fba9a2-ef8e-4740-89af-f9df7d28e9b1",
                                                "sense_id": "53eed199-f43a-3486-87a4-c72b0bec1b73",
                                                "text": "Może ktoś uznaje „Chłopów” Reymonta za epopeję?"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "82188de9-b0ac-3692-8c5a-250b384f9b16",
                                        "entry_id": "45f4329f-261b-3e5b-9880-d97eddc34c8b",
                                        "glosses": [
                                            "ciąg ważnych wydarzeń stanowiących zamkniętą czasowo całość"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40b1a6b4-855e-4181-ae4b-7bbd73f1dc3b",
                                                "sense_id": "82188de9-b0ac-3692-8c5a-250b384f9b16",
                                                "text": "Reżyserka nakręciła „Kampinoską epopeję” o zorganizowanym przez ludność polską ruchu oporu na terenie Puszczy Kampinoskiej podczas II wojny światowej."
                                            },
                                            {
                                                "example_id": "bb93f819-2da2-4782-84e0-634647c665d2",
                                                "sense_id": "82188de9-b0ac-3692-8c5a-250b384f9b16",
                                                "text": "Dla Francuzów czasy napoleońskie to także epopeja wielkich zwycięstw i glorii."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "b4938714-1f82-3c85-8e94-357332ae7996",
                                        "entry_id": "45f4329f-261b-3e5b-9880-d97eddc34c8b",
                                        "glosses": [
                                            "długa, przewlekła opowieść"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de13f3ef-97d1-418a-b416-ca1d610fee1d",
                                                "sense_id": "b4938714-1f82-3c85-8e94-357332ae7996",
                                                "text": "Wszyscy byli znudzeni tą jego epopeją, gadał o jakimś Zielińskim, co to był tajnym współpracownikiem, ale potem okazało się, że nim wcale nie był, żenada."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    }
                                ]
                            }
                        ]
