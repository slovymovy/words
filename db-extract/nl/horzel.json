                                "target_senses": [
                                    {
                                        "sense_id": "d090c8ed-0c0e-32c1-a9a2-3574402de2a0",
                                        "entry_id": "7edbdfef-3654-3ded-b1b1-247d043b04f2",
                                        "glosses": [
                                            "Insectes diptères ressemblant à de grosses mouches, parasites des animaux quadrupèdes et appartenant au genre Œstrus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc517081-7507-4bac-8404-6a70f49306b3",
                                                "sense_id": "d090c8ed-0c0e-32c1-a9a2-3574402de2a0",
                                                "text": "L’œstre du cheval."
                                            },
                                            {
                                                "example_id": "a2ea52b4-5386-476c-b1a0-75a4d8067220",
                                                "sense_id": "d090c8ed-0c0e-32c1-a9a2-3574402de2a0",
                                                "text": "L’œstre du bœuf."
                                            },
                                            {
                                                "example_id": "471d68f8-f54f-4d2b-b288-082de20bc4e8",
                                                "sense_id": "d090c8ed-0c0e-32c1-a9a2-3574402de2a0",
                                                "text": "Les œstres parasitent les chevaux, les chameaux et les dromadaires, les moutons et les chèvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfc0bc41-5e33-385f-8e54-29a813bb18ba",
                                        "entry_id": "7edbdfef-3654-3ded-b1b1-247d043b04f2",
                                        "glosses": [
                                            "Excitation."
                                        ],
                                        "tags": [
                                            "Très rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37fe13f9-c45e-48ac-aa18-03424ba2c46f",
                                                "sense_id": "cfc0bc41-5e33-385f-8e54-29a813bb18ba",
                                                "text": "Un soir, près d’entrer à l’Opéra, me sentant tourmenté, maîtrisé par mes idées, je remets mon argent dans ma poche, je cours m’enfermer chez moi ; je me mets au lit, après avoir bien fermé mes rideaux pour empêcher le jour d’y pénétrer ; et là, me livrant à tout l’œstre poétique et musical, je composai rapidement en sept ou huit heures la meilleure partie de mon acte."
                                            },
                                            {
                                                "example_id": "93df92e8-ccd4-408b-97bd-6e905a245e8b",
                                                "sense_id": "cfc0bc41-5e33-385f-8e54-29a813bb18ba",
                                                "text": "Je suis plus métromane, et piqué d'un tel œstre que je ferais, je crois, un recueil par trimestre !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
