                "senses": [
                    {
                        "sense_id": "6be7096e-199d-30df-ad73-0ae1418d963e",
                        "entry_id": "ebef23f2-768b-34f2-b22f-21b7efb6f493",
                        "glosses": [
                            "Person, die eine Studie verfasst (geschrieben) hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "585b583e-8aa0-4b80-99ca-5e66406463c4",
                                "sense_id": "6be7096e-199d-30df-ad73-0ae1418d963e",
                                "text": "Der Ärger darüber führt laut Studienautoren nun dazu, dass der Eindruck entsteht, die vermeintlich vertrauenswürdige Polizei würde Straftäter dingfest machen und die Justiz lasse sie wieder frei."
                            },
                            {
                                "example_id": "d06c396f-7736-474c-a435-5ec697fd4330",
                                "sense_id": "6be7096e-199d-30df-ad73-0ae1418d963e",
                                "text": "„Diese erfassten Symptomgruppen deuten darauf hin, dass es sieben verschiedene Erkrankungsformen bei mildem Covid-19-Verlauf gibt. \"Wir konnten ganz klar systemische von organspezifischen Verlaufsformen der primären Covid-19 Erkrankung abgrenzen\", berichtet Winfried Pickl, einer der Studienautoren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
