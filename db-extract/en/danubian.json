                        "translation_id": "6dc11d5c-ff0f-4b60-a3f8-d0248e0466a0",
                        "source_entry_id": "44cc2ef5-9389-390a-8365-636aa18b472e",
                        "source_sense_id": "3c2bc8bc-2133-3f95-9afd-7046ff46b94c",
