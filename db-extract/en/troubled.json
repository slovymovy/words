                "senses": [
                    {
                        "sense_id": "426a00f6-a294-35b3-9591-b8801897187e",
                        "entry_id": "81e6b0f7-2d22-3a86-883d-3c9f499f4ba6",
                        "glosses": [
                            "Anxious, worried, careworn."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8986e09f-5582-4ea7-9602-50144928c90f",
                                "sense_id": "426a00f6-a294-35b3-9591-b8801897187e",
                                "text": "Thanks to that penny he had just spent so recklessly [on a newspaper] he would pass a happy hour, taken, for once, out of his anxious, despondent, miserable self. It irritated him shrewdly to know that these moments of respite from carking care would not be shared with his poor wife, with careworn, troubled Ellen."
                            }
                        ]
                    },
                    {
                        "sense_id": "89a417d1-5d32-32ed-902c-2abc661d0401",
                        "entry_id": "81e6b0f7-2d22-3a86-883d-3c9f499f4ba6",
                        "glosses": [
                            "Afflicted by difficulties."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4127bd5d-4e7f-4c7a-8338-1136b8b46de9",
                                "sense_id": "89a417d1-5d32-32ed-902c-2abc661d0401",
                                "text": "The troubled Internet company announced another round of layoffs last week."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83b63c50-1267-4b4a-b070-51b390cdf587",
                        "source_entry_id": "81e6b0f7-2d22-3a86-883d-3c9f499f4ba6",
                        "source_sense_description": "worried, anxious",
