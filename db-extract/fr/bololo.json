                        ],
                        "examples": [
                            {
                                "example_id": "a2157dd1-4df3-4034-94a4-cd7946c83a92",
                                "sense_id": "e0c00e7d-06bd-3d14-8a3e-f8dc848baa66",
                                "text": "Le cercueil est commandé. Il sera livré bientôt. Quel merdier, avec les papiers ! Carajo! Si vous saviez : Police, Etat Civil à la mairie, certificat par-ci, certificat par-là : le cimetière, l’église, le cercueil et tout le bololo. Je m’en rappellerai de l’enterrement de l’ex-Ambassadeur!!"
                            },
                            {
                                "example_id": "2b310095-73e7-4eca-b919-d7a2ae55d503",
                                "sense_id": "e0c00e7d-06bd-3d14-8a3e-f8dc848baa66",
                                "text": "Edouard Philippe met en garde ceux qui veulent mettre le bololo."
                            }
                        ]
                    }
