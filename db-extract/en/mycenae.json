                                        "entry_id": "6d0ef0f0-fbcd-34c1-ad7c-4e69d26b9cfb",
                                        "glosses": [
                                            "Cité grecque au nord-est de la plaine d'Argos, dans le Péloponnèse, entourée de murs cyclopéens."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a46301d1-40e8-4420-a8e6-17f10844a3d0",
                                                "sense_id": "e86e9bec-1954-3151-9122-80def2cdb214",
                                                "text": "Mycènes donne son nom à la civilisation mycénienne qui se développe à partir de 1700 av. J.-C. en Grèce continentale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ab47993-c3b9-4fe4-ae7d-4908be33cf67",
                        "source_entry_id": "882b770f-3167-3ba6-91b7-6a657711c24a",
