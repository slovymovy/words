                                        "examples": [
                                            {
                                                "example_id": "f6609f8a-d0e4-44b9-bfbd-6775acdf6942",
                                                "sense_id": "27c48db6-bca4-3246-938e-66dbfae2d5ea",
                                                "text": "Alcune tribù amazzoniche vivono ancora nella preistoria."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30e29971-4196-309e-ac1c-61ed142aea32",
                                        "entry_id": "61278191-8d70-3daf-b78b-447de8380451",
                                        "glosses": [
                                            "origine lontana di qualcosa, di una situazione, di un fatto, di una disciplina, ..."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02174db8-ba06-482e-b5db-0d3bdd5876fd",
                                                "sense_id": "30e29971-4196-309e-ac1c-61ed142aea32",
                                                "text": "Nella preistoria dell'informatica i computer occupavano intere stanze, e conoscevano al massimo la tabellina del 9"
                                            }
                                        ]
                                    }
