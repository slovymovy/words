                    {
                        "translation_id": "c06ca10a-17ce-4b49-baf6-2884dd2565b3",
                        "source_entry_id": "28b4dd46-5b6c-3719-97c7-7d547574f898",
                        "source_sense_id": "f8c8845d-2872-3d03-b5fd-16a74a36d49a",
                        "source_sense_description": "in a conspicuous manner",
                        "target_lang_word": "auffällig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auffällig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7f26d56-1d1b-3ffb-bfa8-dad59c0fa2b7",
                                        "entry_id": "a8f0374e-c422-3466-85b4-d7a05e92065d",
                                        "glosses": [
                                            "die Aufmerksamkeit auf sich ziehend; Interesse erweckend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e28821eb-9e7c-4db8-b699-8ae75b659039",
                                                "sense_id": "f7f26d56-1d1b-3ffb-bfa8-dad59c0fa2b7",
                                                "text": "Die Frau war sehr auffällig und schrill gekleidet."
                                            },
                                            {
                                                "example_id": "ce774f61-ba04-44c5-ba7e-4f61e18f4112",
                                                "sense_id": "f7f26d56-1d1b-3ffb-bfa8-dad59c0fa2b7",
                                                "text": "Auffällig finde ich vor allem sein merkwürdiges Verhalten."
                                            },
                                            {
                                                "example_id": "3ec8342c-11a6-44bf-b134-1678ef25baab",
                                                "sense_id": "f7f26d56-1d1b-3ffb-bfa8-dad59c0fa2b7",
                                                "text": "„Bekleidet war er mit einer Baseballkappe mit auffälligem X-Emblem, einem schwarzen T-Shirt und einer schwarzen Hose, er trug einen roten Aktenkoffer.“"
                                            },
                                            {
                                                "example_id": "d87ad73a-a31a-4d93-a122-56e20aabf66d",
                                                "sense_id": "f7f26d56-1d1b-3ffb-bfa8-dad59c0fa2b7",
                                                "text": "„Während die Meeresspiegel fast unmerklich um etwa 3,4 Millimeter pro Jahr steigen, sind andere Klimakatastrophen weit aufälliger. Vor allem Hitze und Dürren nehmen zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c22a22b-d834-463b-afa8-62f3a9eae1d9",
                        "source_entry_id": "28b4dd46-5b6c-3719-97c7-7d547574f898",
                        "source_sense_id": "f8c8845d-2872-3d03-b5fd-16a74a36d49a",
                        "source_sense_description": "in a conspicuous manner",
                        "target_lang_word": "sichtbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sichtbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9af7d63-9b49-32c8-b921-3676fabbbf78",
                                        "entry_id": "9e68b48d-cb22-3b3f-a236-6687921c1db8",
                                        "glosses": [
                                            "dem Sehen zugänglich, mit den Augen wahrnehmbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85ab04ac-964a-4b10-a7d8-006f6def3f38",
                                                "sense_id": "f9af7d63-9b49-32c8-b921-3676fabbbf78",
                                                "text": "Milben sind so klein, dass sie für das menschliche Auge nicht sichtbar sind."
                                            },
                                            {
                                                "example_id": "8cc2b96b-f250-493d-878a-8fc6f9d5843b",
                                                "sense_id": "f9af7d63-9b49-32c8-b921-3676fabbbf78",
                                                "text": "„Die Beobachtungen unterstützen die Theorie, wonach der Großteil des Universums aus unsichtbarer dunkler Materie besteht, die durch Beobachtung ihrer Gravitationskraft auf sichtbare Materie entdeckt wurde.“"
                                            },
                                            {
                                                "example_id": "d2caf792-ad4c-43ef-87cb-b0d124848ad2",
                                                "sense_id": "f9af7d63-9b49-32c8-b921-3676fabbbf78",
                                                "text": "„Was in den zurückliegenden schönen Herbstwochen dazu führte, dass China in Xianyang seinen sichtbarsten Arbeiterausstand seit Jahren erlebte.“"
                                            },
                                            {
                                                "example_id": "ce18ee3d-94bc-4716-a339-10802df1562b",
                                                "sense_id": "f9af7d63-9b49-32c8-b921-3676fabbbf78",
                                                "text": "„Und zwar immer dann, wenn Experten und Medien auf die sichtbarsten Schwächen der Berufsausbildung hinweisen: Zum Beispiel fehlende Lehrstellen in Ballungsgebieten und fehlende Bewerber im Osten.“"
                                            },
                                            {
                                                "example_id": "d30d1701-1b5a-441b-9674-31c23aa72a9b",
                                                "sense_id": "f9af7d63-9b49-32c8-b921-3676fabbbf78",
                                                "text": "„Die sichtbare Verwüstung schließe die Opfer der radioaktiven Verstrahlung nicht ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c08af54c-98e5-458a-aea7-f25740c5577a",
                        "source_entry_id": "28b4dd46-5b6c-3719-97c7-7d547574f898",
                        "source_sense_id": "f8c8845d-2872-3d03-b5fd-16a74a36d49a",
                        "source_sense_description": "in a conspicuous manner",
                        "target_lang_word": "deutlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deutlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2837a437-6747-31c7-82f2-b54126d49227",
                                        "entry_id": "e05ee98e-1cea-3b26-9ce2-b23da691eb6e",
                                        "glosses": [
                                            "eindeutig erkennbar, wahrnehmbar durch die Sinne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58cf7198-6818-4905-8061-fe9737bbcc94",
                                                "sense_id": "2837a437-6747-31c7-82f2-b54126d49227",
                                                "text": "Zwischen den beiden Materialien war ein deutlicher Unterschied zu tasten"
                                            },
                                            {
                                                "example_id": "e5b9f4dc-c515-40dc-aea3-0a019c238ad1",
                                                "sense_id": "2837a437-6747-31c7-82f2-b54126d49227",
                                                "text": "Die Worte waren deutlich hinter der Tür vernehmbar."
                                            },
                                            {
                                                "example_id": "fdf99247-4bdb-4fa9-a578-4b920e76bd7e",
                                                "sense_id": "2837a437-6747-31c7-82f2-b54126d49227",
                                                "text": "Am Telephon: »Könnten sie deutlicher reden? Ich verstehe sie leider kaum.«"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "331e795a-c6a2-3460-826f-a50fcf2d8450",
                                        "entry_id": "e05ee98e-1cea-3b26-9ce2-b23da691eb6e",
                                        "glosses": [
                                            "inhaltlich verständlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c277a7a2-9499-4c9b-84e9-c03b2789c1f6",
                                                "sense_id": "331e795a-c6a2-3460-826f-a50fcf2d8450",
                                                "text": "Der Herr richtete deutliche Worte an den faulen Diener."
                                            },
                                            {
                                                "example_id": "18e1ebad-ef2c-4d93-a95b-a1b2a7e4b8ef",
                                                "sense_id": "331e795a-c6a2-3460-826f-a50fcf2d8450",
                                                "text": "»Habe ich mich klar und deutlich ausgedrückt?«"
                                            },
                                            {
                                                "example_id": "65e5708b-6916-4eec-9c72-e79887a7c6fc",
                                                "sense_id": "331e795a-c6a2-3460-826f-a50fcf2d8450",
                                                "text": "„Der Ruder-Weltmeister [Anmerkung: Torben Johannesen] findet deutliche Worte: »Die Idee zur Öffnung der Dove-Elbe ist ein absoluter Fehler«, sagt er.“"
                                            },
                                            {
                                                "example_id": "7f7927cb-5804-4afd-acbc-d7faa6787a5b",
                                                "sense_id": "331e795a-c6a2-3460-826f-a50fcf2d8450",
                                                "text": "„Dieser Mangel steht in einem deutlichen Missverhältnis zu dem immer wieder von nationalen und europäischen Instanzen erklärten Einsatz für die europäische Sprachenvielfalt und die Mehrsprachigkeit der Europäer.“"
                                            },
                                            {
                                                "example_id": "fe31e5ed-5857-414f-9578-6a2642a84060",
                                                "sense_id": "331e795a-c6a2-3460-826f-a50fcf2d8450",
                                                "text": "„Obergärige Hefen sind zwar empfindlicher als untergärige, aber mit ihnen verläuft die Gärung deutlich schneller und ohne moderne Kühltechnik.“"
                                            },
                                            {
                                                "example_id": "be346ed2-e357-42a6-a337-a836686ca6fa",
                                                "sense_id": "331e795a-c6a2-3460-826f-a50fcf2d8450",
                                                "text": "„In Deutschland ist die Belastung mit Feinstaub sowohl im urbanen als auch im ländlichen Bereich deutlich zurückgegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
