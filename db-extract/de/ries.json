                                                "sense_id": "6f53b286-f8d3-376c-8b3e-4e8929805033",
                                                "text": "I can't go – I still have reams of work left."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "554a5bc5-e67b-430e-98b5-1e3d886f1351",
