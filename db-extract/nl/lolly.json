                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9849d60-15bc-45fa-9319-d734d67ed170",
                        "source_entry_id": "234c41c4-6c78-3bf4-b2a8-9172e20a14fc",
