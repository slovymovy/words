                                    },
                                    {
                                        "sense_id": "56737729-3e69-34cc-8c2f-3c2ae139d001",
                                        "entry_id": "2103440c-1905-3cc7-bd3b-8a0bff1c6846",
                                        "glosses": [
                                            "Debeige; a kind of woollen or mixed dress goods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "beige",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5eb521b5-d883-34b9-9921-028e07d40059",
                                        "entry_id": "16292710-b03f-3921-bfdd-4ed836aa4150",
                                        "glosses": [
                                            "Having a slightly yellowish gray colour, as that of unbleached wool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4a8b26f-5d12-405c-bd94-79bc2164bcc2",
                                                "sense_id": "5eb521b5-d883-34b9-9921-028e07d40059",
                                                "text": "Dagobert had only one customer, an American who wore square, rimless glasses and a beige suit and looked like a Wall Street tycoon."
                                            },
                                            {
                                                "example_id": "df47d560-5953-43f6-bb26-8402bc7feb9e",
                                                "sense_id": "5eb521b5-d883-34b9-9921-028e07d40059",
                                                "text": "Mr. Lauwaert of Sony said he realized that most consumers were not going to buy computers that cost far more than discount beige boxes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "385649c9-1465-3901-9d2b-fc24cdaf5e6f",
                                        "entry_id": "16292710-b03f-3921-bfdd-4ed836aa4150",
                                        "glosses": [
                                            "Comfortably dull and unadventurous, in a way that suggests middle-class suburbia."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5466788b-80fd-464b-8e6b-60e8ce647663",
                                                "sense_id": "385649c9-1465-3901-9d2b-fc24cdaf5e6f",
                                                "text": "Think about it: he grew up in Iowa, the beigest of states, was doted on, loved generously by his parents, the top of his class, probably voted Most Handsome of 2000."
                                            },
                                            {
                                                "example_id": "889d31e7-ec54-4a02-93d4-34bdbac2ed59",
                                                "sense_id": "385649c9-1465-3901-9d2b-fc24cdaf5e6f",
                                                "text": "In the beigest parts of suburbia where I grew up, bridge was a game played by groups of parents in recreation rooms furnished with upright pianos and souvenir sombreros."
                                            },
                                            {
                                                "example_id": "d1cacddd-1e94-4718-b254-05b9f0f0950b",
                                                "sense_id": "385649c9-1465-3901-9d2b-fc24cdaf5e6f",
                                                "text": "For a meal of relentlessly beige food, may I suggest the beigest of wines? That would be chardonnay, which will go beautifully with Melissa Clark’s chicken potpie."
                                            },
                                            {
                                                "example_id": "178cbf07-eb84-461c-bfa6-cb7787bee441",
                                                "sense_id": "385649c9-1465-3901-9d2b-fc24cdaf5e6f",
                                                "text": "He has no criminal record. He has no traffic tickets. His social media posts are just like... he's beige."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "357a9d54-1749-41c0-b426-9bd7f4019991",
                        "source_entry_id": "ed8b6ab1-0e04-344e-a3fb-1f8064bc775f",
                        "source_sense_id": "88c093f6-4a99-3933-83e0-94c87a478938",
                        "target_lang_word": "beige",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beige",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f511a44e-2f08-3e79-8f84-74fbbbd8cc4c",
                                        "entry_id": "684051d6-6af3-3e18-b209-bb23da8c4d99",
                                        "glosses": [
                                            "eine hellgelbbraune Farbe (RAL 1001) aufweisend, die der ungefärbter Wolle beziehungsweise der des Dünensandes gleicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa7f2c58-0037-4225-b8ea-37e60483f1ff",
                                                "sense_id": "f511a44e-2f08-3e79-8f84-74fbbbd8cc4c",
                                                "text": "Sie trug ein beiges Kleid, welches nicht dunkel genug war, um es als ockerfarben zu bezeichnen."
                                            },
                                            {
                                                "example_id": "98a37fd1-1892-4819-a38c-46c8d0fffdf7",
                                                "sense_id": "f511a44e-2f08-3e79-8f84-74fbbbd8cc4c",
                                                "text": "Hast du ein beiges Näpfchen in deinem Farbkasten?"
                                            },
                                            {
                                                "example_id": "662d0bad-0116-483c-bc43-ab2553b2360f",
                                                "sense_id": "f511a44e-2f08-3e79-8f84-74fbbbd8cc4c",
                                                "text": "„Sie trug also ein einfaches weißes Kleid und beige Schuhe, als sie im Kreis von Freunden und Journalisten auf eine gelöste und muntere Weise Gedanken äußerte.“"
                                            },
                                            {
                                                "example_id": "748050a6-7571-4fb7-be83-9cdbb46969bb",
                                                "sense_id": "f511a44e-2f08-3e79-8f84-74fbbbd8cc4c",
                                                "text": "„Sie hatte nach der Schule ihre Feriengarderobe eingekauft, einen Rock aus beiger Baumwolle, Shorts aus dem gleichen Material, zwei weiße Blusen, drei Tops, zwei Sarongs und den besagten Bikini.“"
                                            },
                                            {
                                                "example_id": "e4ea396a-96f9-47a9-a811-73178237af86",
                                                "sense_id": "f511a44e-2f08-3e79-8f84-74fbbbd8cc4c",
                                                "text": "„Sie ist etwas kleiner, hat blond gefärbte Haare und trägt ein beiges Kostüm und schwarze Stöckelschuhe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
