                "senses": [
                    {
                        "sense_id": "d5d5ce65-60d2-3ead-acfb-bbfb0918f125",
                        "entry_id": "8175dbe3-73e0-3519-880d-326b4def97f2",
                        "glosses": [
                            "Tisch, an dem man Toilette/sich zurechtmachen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e662514c-e2db-4213-a429-4accb6b8cce8",
                                "sense_id": "d5d5ce65-60d2-3ead-acfb-bbfb0918f125",
                                "text": "„Sie war an den Spiegel vor dem Toilettentisch getreten, auf dem wie in einer Schauspielergarderobe Puderdosen und Schminktöpfe bereit standen.“"
                            },
                            {
                                "example_id": "d307e2e2-e89f-46f0-9e82-bbcc65c3601e",
                                "sense_id": "d5d5ce65-60d2-3ead-acfb-bbfb0918f125",
                                "text": "„Hochhackige Schuhe standen auf dem Toilettentisch und auf den Stühlen, und Skisachen waren zu einem Haufen neben der Balkontür zusammengeworfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
