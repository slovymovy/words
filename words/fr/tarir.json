    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54a2074f-a29e-3e28-9e6c-47cbd87e11c5",
                    "sense_definition": "Mettre à sec un cours d'eau, une source ou un puits, ou cesser de couler.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La grande sécheresse de cet été a fini par <w>tarir</w> la source du village."
                        },
                        {
                            "text": "Sans pluie régulière, ce petit cours d'eau risque de se <w>tarir</w> avant l'automne."
                        }
                    ],
                    "synonyms": [
                        "assécher"
                    ],
                    "common_phrases": [
                        "tarir une source"
                    ]
                },
                {
                    "sense_id": "fdae8dee-1467-3094-a990-e5fcbc775b4d",
                    "sense_definition": "Épuiser complètement une ressource, une réserve ou une capacité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "epuiser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces dépenses imprévues risquent de <w>tarir</w> les ressources financières de notre petite entreprise."
                        },
                        {
                            "text": "Les nombreuses critiques ont fini par <w>tarir</w> son enthousiasme pour ce projet artistique."
                        }
                    ],
                    "common_phrases": [
                        "tarir les ressources"
                    ]
                },
                {
                    "sense_id": "835971b6-313b-382a-8334-9bca5fb258a4",
                    "sense_definition": "Ne pas cesser de s'exprimer au sujet de quelqu'un ou de quelque chose, souvent pour en faire l'éloge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur ne <w>tarit</w> pas d'éloges sur les progrès impressionnants de ses élèves."
                        },
                        {
                            "text": "Quand elle évoque son voyage en Italie, elle ne <w>tarit</w> plus sur la beauté des paysages."
                        }
                    ],
                    "common_phrases": [
                        "ne pas tarir d'éloges"
                    ]
                }
            ]
        }
    ]
