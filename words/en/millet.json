{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "660af2ab-cf85-3f10-a304-df441e1d15b4",
                    "sense_definition": "A cereal grass or its small edible grains, widely cultivated as food and for animal fodder.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers in arid regions often grow <w>millet</w> because it survives drought well.",
                            "target_lang_translations": {
                                "pl": "Rolnicy w suchych regionach często uprawiają <w>proso</w>, ponieważ dobrze znosi ono suszę."
                            }
                        },
                        {
                            "text": "She added cooked <w>millet</w> to her vegetable soup to make it more filling.",
                            "target_lang_translations": {
                                "pl": "Dodała ugotowaną <w>kaszę jaglaną</w> do zupy jarzynowej, aby była bardziej sycąca."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grow millet",
                        "bowl of millet",
                        "cooked millet"
                    ],
                    "target_lang_definitions": {
                        "pl": "Roślina zbożowa lub jej drobne, jadalne ziarna, szeroko uprawiane jako pożywienie dla ludzi oraz pasza dla zwierząt."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "proso",
                                "target_lang_sense_clarification": "roślina zbożowa oraz jej ziarno"
                            },
                            {
                                "target_lang_word": "kasza jaglana",
                                "target_lang_sense_clarification": "kasza otrzymywana z łuskanych ziaren prosa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c246ac04-bcab-30c9-bda9-79b512eae472",
                    "sense_definition": "Common millet, specifically the species Panicum miliaceum, cultivated for its small pale grains.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "grain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Common <w>millet</w> has been cultivated in Eurasia for thousands of years.",
                            "target_lang_translations": {
                                "pl": "<w>Proso</w> zwyczajne jest uprawiane w Eurazji od tysięcy lat."
                            }
                        },
                        {
                            "text": "The seeds of this wild <w>millet</w> are frequently fed to cage birds.",
                            "target_lang_translations": {
                                "pl": "Ziarna tego dzikiego <w>prosa</w> są często podawane ptakom klatkowym."
                            }
                        }
                    ],
                    "synonyms": [
                        "proso millet"
                    ],
                    "common_phrases": [
                        "common millet"
                    ],
                    "target_lang_definitions": {
                        "pl": "Proso zwyczajne, roślina z gatunku Panicum miliaceum, uprawiana ze względu na drobne, jasne ziarna."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "proso zwyczajne",
                                "target_lang_sense_clarification": "gatunek rośliny Panicum miliaceum"
                            },
                            {
                                "target_lang_word": "proso",
                                "target_lang_sense_clarification": "gatunek zboża"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28a6c6a4-c2f3-32ef-b292-70d63b257d59",
                    "sense_definition": "A recognized semi-autonomous religious community under the Ottoman Empire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Under the Ottoman system, each <w>millet</w> governed its own internal legal affairs.",
                            "target_lang_translations": {
                                "pl": "W systemie osmańskim każdy <w>millet</w> zarządzał własnymi wewnętrznymi sprawami prawnymi."
                            }
                        },
                        {
                            "text": "Members of the Christian <w>millet</w> were permitted to retain their religious customs.",
                            "target_lang_translations": {
                                "pl": "Członkom chrześcijańskiego <w>milletu</w> pozwolono zachować swoje zwyczaje religijne."
                            }
                        }
                    ],
                    "common_phrases": [
                        "millet system"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Ottoman Empire history"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Półautonomiczna wspólnota religijna w imperium osmańskim, posiadająca własne prawa i władze."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "millet",
                                "target_lang_sense_clarification": "wspólnota religijna w imperium osmańskim"
                            }
                        ]
                    }
                }
            ]
        },
        {
