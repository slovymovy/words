    "entries": [
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "e3c63c9b-eaf9-3458-8508-7ab13be9077a",
                    "sense_definition": "The cardinal number occurring after thirty-nine and before forty-one, represented in Roman numerals as XL and in Arabic numerals as 40.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My father just turned <w>forty</w> years old last week.",
                            "target_lang_translations": {
                                "ru": "Моему отцу на прошлой неделе исполнилось <w>сорок</w> лет.",
                                "zh": "我父亲上周刚满<w>四十</w>岁。"
                            }
                        },
                        {
                            "text": "There are <w>forty</w> students in the lecture hall today.",
                            "target_lang_translations": {
                                "ru": "Сегодня в лекционном зале <w>сорок</w> студентов.",
                                "zh": "今天讲堂里有<w>四十</w>名学生。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "top forty",
                        "forty winks",
                        "forty percent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количественное числительное, следующее за тридцать девять и предшествующее сорок один, обозначаемое римскими цифрами как XL и арабскими цифрами как 40.",
                        "zh": "数字40，位于39之后，41之前。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сорок",
                                "target_lang_sense_clarification": "число"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "四十",
                                "target_lang_sense_clarification": "数字"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d37ecd1-fa97-33b9-8d7a-76579af9cdad",
                    "sense_definition": "A bottle of beer or malt liquor containing forty fluid ounces.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stopped at the store to buy a <w>forty</w> for the party.",
                            "target_lang_translations": {
                                "ru": "Он зашел в магазин, чтобы купить <w>бутылку пива</w> для вечеринки.",
                                "zh": "他顺路去商店为派对买了一<w>瓶</w>大瓶装啤酒。"
                            }
                        },
                        {
                            "text": "They sat on the porch sharing a <w>forty</w> on a hot afternoon.",
                            "target_lang_translations": {
                                "ru": "Они сидели на крыльце, распивая <w>бутылку пива</w> жарким днем.",
                                "zh": "在一个炎热的下午，他们坐在门廊上分享一<w>瓶</w>大瓶装啤酒。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drink a forty",
                        "buy a forty"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "refers to the size of the bottle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бутылка пива или солодового ликера емкостью сорок жидких унций (около 1,2 литра).",
                        "zh": "一种容量为40液盎司（约1.2升）的啤酒或麦芽酒瓶。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бутылка пива",
                                "target_lang_sense_clarification": "сленг, обычно объемом 40 унций"
