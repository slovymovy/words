                    },
                    {
                        "translation_id": "a117d45a-feb8-4ebc-9963-3d227deeb019",
                        "source_entry_id": "4377f74f-a1d4-38e9-8c0f-53a95f41bd9a",
                        "source_sense_id": "a81e2363-d46e-3a21-ada0-f7c9049d10e7",
                        "target_lang_word": "à la place de",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à la place de",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82b20eb8-326f-3678-b309-d3338dbb682f",
                                        "entry_id": "e1e75b83-cdcd-3470-9242-d9ceb0a566cc",
                                        "glosses": [
                                            "À l’emplacement désigné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f6c7672-0310-46a4-bfec-6f5f7628cbfb",
                                                "sense_id": "82b20eb8-326f-3678-b309-d3338dbb682f",
                                                "text": "Pour les canards, elle fit creuser une mare à la place d’un bosquet de lilas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dd64141-cbd0-3a1b-8fa5-3671a2cd7437",
                                        "entry_id": "e1e75b83-cdcd-3470-9242-d9ceb0a566cc",
                                        "glosses": [
                                            "Au lieu de (le plus souvent suivi par un nom animé)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07d69dd2-01b7-4300-b360-18f46cc1ea19",
                                                "sense_id": "2dd64141-cbd0-3a1b-8fa5-3671a2cd7437",
                                                "text": "Que va-t-il raconter ce franchimand ? J'aimerais bien mieux, à la place de son babillage, une belle chanson comme tu sais si bien les faire. Tu devrais y penser, dis, collègue ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95ff6fe2-3bae-36dc-a38d-71911989ed76",
                                        "entry_id": "e1e75b83-cdcd-3470-9242-d9ceb0a566cc",
                                        "glosses": [
                                            "En remplacement de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88dad6d3-b416-4c2f-b693-ece75b0a87af",
                                                "sense_id": "95ff6fe2-3bae-36dc-a38d-71911989ed76",
                                                "text": "Châteauneuf remplaça à Genève Castelnau qui était l’agent public des princes ; Villars, à Mayence ; de Pons, à Cologne, à la place de Maulevrier."
                                            },
                                            {
                                                "example_id": "0ff4d7e0-7abc-412a-a54c-9313a4435bb6",
                                                "sense_id": "95ff6fe2-3bae-36dc-a38d-71911989ed76",
                                                "text": "— Et vous comptez tenir le barbeuc dehors tout à l'heure, aussi ? Retourner les steaks hachés à ma place ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce020f67-9b03-3a60-b0d3-aca21af51c48",
                                        "entry_id": "e1e75b83-cdcd-3470-9242-d9ceb0a566cc",
                                        "glosses": [
                                            "Si le sujet était la personne mentionnée."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "familiar"
                                        ],
                                        "note": "« À ta place, je ferais… » signifiant « Si j’étais à ta place, je ferais… » ; « J’aurais accepté à leur place. » signifiant « J’aurais accepté si j’avais été à leur place », etc",
                                        "examples": [
                                            {
                                                "example_id": "b3452f2b-e9aa-4881-a2b0-f47f5efa3448",
                                                "sense_id": "ce020f67-9b03-3a60-b0d3-aca21af51c48",
                                                "text": "À la place de Stéphane, j’aurais accepté le contrat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
