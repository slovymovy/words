                    {
                        "translation_id": "2bcc81d2-b867-4270-94ac-045d0da41d3b",
                        "source_entry_id": "8a13332f-6edc-381b-9062-d32309c8f2b4",
                        "source_sense_id": "c0b38d68-f6d1-3d51-b215-dfb6b067d168",
