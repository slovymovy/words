                                        "entry_id": "f513558b-53d6-37df-8237-6d7dac461310",
                                        "glosses": [
                                            "A noun which, though singular, refers to a group of things or animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b573d2d-8474-4fae-9dea-19370bca4d22",
                                                "sense_id": "f16ea714-8490-3b84-ae84-06641366546c",
                                                "text": "A hundred, a thousand, few, many, are to be considered as collective nouns, and distinguished as such, by the singular article."
                                            },
                                            {
                                                "example_id": "05f94b94-4c7b-460a-a227-bba83290c880",
                                                "sense_id": "f16ea714-8490-3b84-ae84-06641366546c",
                                                "text": "British English tends more than American English to have plural agreement with collective nouns."
                                            }
                                        ]
