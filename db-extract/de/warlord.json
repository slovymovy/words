                ],
                "senses": [
                    {
                        "sense_id": "9b8de334-4b1d-3b46-885f-06f2f62d2fc7",
                        "entry_id": "6aa32c53-ee56-329c-8b29-6885054ad277",
                        "glosses": [
                            "militärischer und politischer Anführer eines Stammes, meist bei bürgerkriegsähnlichen Konflikten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f59089c3-57f8-435c-b547-0a4ca6cc1979",
                                "sense_id": "9b8de334-4b1d-3b46-885f-06f2f62d2fc7",
                                "text": "„Archäologisch ist die Zerstörung von Siedlungen in Mittelitalien zu fassen; die literarischen Quellen berichten von selbstständig operierenden etruskischen Warlords, […].“"
                            },
                            {
                                "example_id": "62d76920-cc1b-48ad-91e9-067601b7182f",
                                "sense_id": "9b8de334-4b1d-3b46-885f-06f2f62d2fc7",
                                "text": "„Die Erfahrungen mit Paramilitarismus in der Weimarer Republik, aber auch die aktuellen Entgrenzungen kriegerischer Gewalt durch selbst ernannte Warlords zeigen, wie gefährlich die Aufkündigung des staatlichen Gewaltmonopols ist.“"
                            },
                            {
                                "example_id": "6a772060-4c81-4862-8575-c2dda53f4f62",
                                "sense_id": "9b8de334-4b1d-3b46-885f-06f2f62d2fc7",
                                "text": "„Wenn es den historischen Artus überhaupt gab, war er ein Warlord in dieser Zeit.“"
                            },
                            {
                                "example_id": "3c40a65d-1831-43eb-ba21-faacb1c8da9d",
                                "sense_id": "9b8de334-4b1d-3b46-885f-06f2f62d2fc7",
                                "text": "„Der Zusammenbruch der Regierung hatte zur Folge, dass nun Warlords und ihre Milizen das staatliche Gewaltmonopol ersetzten und unabhängige Kleinstaaten gründeten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9075c356-1a01-4fca-9054-2322b83f1d71",
                        "source_entry_id": "6aa32c53-ee56-329c-8b29-6885054ad277",
                        "source_sense_id": "9b8de334-4b1d-3b46-885f-06f2f62d2fc7",
                        "source_sense_description": "militärischer und politischer Anführer eines Stammes, meist bei bürgerkriegsähnlichen Konflikten",
                        "target_lang_word": "warlord",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warlord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ff8b9e0-be9d-3037-bc84-b11c7276cbbf",
                                        "entry_id": "d94f7de0-fd7e-33a9-90d6-72b34a09e956",
                                        "glosses": [
                                            "A military commander or bandit leader wielding civilian power in an area where the government is weak."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1399c902-6716-43f6-aed8-d9bb01b93a6b",
                                                "sense_id": "8ff8b9e0-be9d-3037-bc84-b11c7276cbbf",
                                                "text": "Afghanistan's first major battle of the post-Taliban era ended tonight when the soldiers of the warlord besieging this strategic city south of Kabul ran out of ammunition and fled the battlefront in clouds of dust, cursing the warlord to his face for his callousness in committing them to a fight they were doomed to lose."
                                            },
                                            {
                                                "example_id": "f69d5650-c5dd-4b4b-b87d-9602e665c393",
                                                "sense_id": "8ff8b9e0-be9d-3037-bc84-b11c7276cbbf",
                                                "text": "“I’m not a warlord … I’m a liberator of the people,” he said. That’s the problem: So are they all. More than four million people have died in Congo’s wars since 1998, making it the most lethal conflict since World War II."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
