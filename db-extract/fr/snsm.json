                        "glosses": [
                            "Association française, reconnue d'utilité publique, ayant pour but le secours bénévole et gratuit en mer et sur les côtes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac14d620-aa11-4cac-b460-a66f95d62436",
                                "sense_id": "afcc414c-d86d-3111-8e5f-affa720a7ae1",
                                "text": "L’association de sauvetage en mer SNSM assure la sécurité des marins, mais aussi celle des plages."
                            },
                            {
                                "example_id": "7b5b511f-49e2-4c10-9234-410f31ce2caf",
                                "sense_id": "afcc414c-d86d-3111-8e5f-affa720a7ae1",
                                "text": "Marcel, habitué des Gras, s’est déguisé en bouée pour déambuler dans les rues de Tréboul, en attendant la SNSM…"
                            },
                            {
                                "example_id": "3756a769-de8c-4f37-932b-22aa046995eb",
                                "sense_id": "afcc414c-d86d-3111-8e5f-affa720a7ae1",
                                "text": "L’action de l’État en mer repose sur les MRCC (Maritime Rescue Coordination Center), les Cross, en France, mais aussi sur les autorités maritimes (Affaires maritimes, gendarmerie maritime, douane), la SNSM (association de bénévoles), sans oublier les sauveteurs côtiers du SDIS (service départemental d'incendie et de secours)."
                            }
                        ]
                    }
