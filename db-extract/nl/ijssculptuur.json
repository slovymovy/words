                "senses": [
                    {
                        "sense_id": "7a8a6930-32d0-39dc-8c56-5f66ec449286",
                        "entry_id": "d9ac07fc-fd39-3b7e-897b-a20fffad774c",
                        "glosses": [
                            "beeldhouwwerk uitgehouwen uit een blok ijs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0b00845-650e-44d0-b1e4-413a3fe98262",
                                "sense_id": "7a8a6930-32d0-39dc-8c56-5f66ec449286",
                                "text": "Duits vosje blijkt veranderd in ijssculptuur: Het had een beeld uit de animatiefilm Ice Age kunnen zijn: een vos in een gigantisch ijsblok. Maar de foto die een jager gisteren maakte bij het Duitse stadje Fridingen, is echt."
                            },
                            {
                                "example_id": "29c88125-f3b7-4f16-9429-f7b9c56449c5",
                                "sense_id": "7a8a6930-32d0-39dc-8c56-5f66ec449286",
                                "text": "Anton vindt het maar niks, \"het moet nu vriezen en sneeuwen, dit is niet gewoon\". Hij zegt dat terwijl bezoekers van de kerstmarkt vlak bij het Kremlin moeten oppassen dat ze niet in de plassen lopen. De jaarlijkse attractie van een gigantische ijssculptuur ontbreekt deze keer, enkele dagen voor de kerstmarkt openging smolt het bouwwerk."
                            }
                        ]
                    }
