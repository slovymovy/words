                                    {
                                        "sense_id": "b855d33e-88ac-3e28-9fa8-392a5e6b044f",
                                        "entry_id": "4de35574-87af-3708-8d38-0a7387691cbf",
                                        "glosses": [
                                            "To join two materials (especially two metals) together by applying heat, pressure and filler, either separately or in any combination."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84b94af1-65a4-4ad6-ae8e-a97da9712eac",
                                                "sense_id": "b855d33e-88ac-3e28-9fa8-392a5e6b044f",
                                                "text": "[…] and at Dinsdale work will commence in 1957 on a depot to deal with rail welding and track pre-assembly. The plant envisaged will weld new flat-bottom rails into 180-ft. lengths for laying in selected lines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fc0632d-5089-3cff-b730-6cfa44944c42",
                                        "entry_id": "4de35574-87af-3708-8d38-0a7387691cbf",
                                        "glosses": [
                                            "To bind together inseparably; to unite closely or intimately."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9280b9c9-afc5-4694-a6f3-93050c62e62d",
                                                "sense_id": "8fc0632d-5089-3cff-b730-6cfa44944c42",
                                                "text": "The arrows pierced through the welded ranks of the opposing army."
                                            },
                                            {
                                                "example_id": "6b134081-714a-46da-944b-ccd798876000",
                                                "sense_id": "8fc0632d-5089-3cff-b730-6cfa44944c42",
                                                "text": "to weld an alliance"
                                            },
                                            {
                                                "example_id": "c269b308-838f-4342-9591-2da894064c78",
                                                "sense_id": "8fc0632d-5089-3cff-b730-6cfa44944c42",
                                                "text": "Now should men see / Two women faster welded in one love / Than pairs of wedlock."
                                            },
                                            {
                                                "example_id": "c83ab835-5522-4bba-9115-3a3e4a35f50e",
                                                "sense_id": "8fc0632d-5089-3cff-b730-6cfa44944c42",
                                                "text": "The organisational and administrative tasks involved in welding the railways into a single entity have also received much publicity."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "weld",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6654cec1-fbfe-3cdd-8e41-1a1708bbc542",
                                        "entry_id": "51301642-2575-3a09-a7e8-1d7b1ebbfc5c",
                                        "glosses": [
                                            "The joint made by welding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aa47f38-dee0-4698-af46-7f3f08f277ff",
                                                "sense_id": "6654cec1-fbfe-3cdd-8e41-1a1708bbc542",
                                                "text": "Excessive spot weld time may cause the electrode tips to mushroom, resulting in no focus of current and a weak weld."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "weld",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27a66f6e-fa04-33ad-9390-1110400e8f54",
                                        "entry_id": "7c644f1b-59fd-386c-822d-65f044d173c0",
                                        "glosses": [
                                            "To wield."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a6c9795-46df-418e-bd80-3728b06eba56",
                                                "sense_id": "27a66f6e-fa04-33ad-9390-1110400e8f54",
                                                "text": "[Arthur says to a wicked giant] \"he that alle the world weldeth gyue the ſorte lyf & ſameful dethe\" (\"He who wields all the world gives thee short life and shameful death\")"
                                            },
                                            {
                                                "example_id": "56d30c61-b5a4-4725-99c4-79461a9bd200",
                                                "sense_id": "27a66f6e-fa04-33ad-9390-1110400e8f54",
                                                "text": "[Arthur says to conquering knights] \"ye be worthy to welde all your honour and worship\""
                                            },
                                            {
                                                "example_id": "f272f30c-a8c8-45a1-8d80-fa8f37579fc2",
                                                "sense_id": "27a66f6e-fa04-33ad-9390-1110400e8f54",
                                                "text": "Turne thee to those that weld the awfull crowne"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
