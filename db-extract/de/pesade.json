                        "examples": [
                            {
                                "example_id": "878c3e6b-f731-4f89-be3e-56c52e5b9355",
                                "sense_id": "fd3ae6ff-8e00-3ba9-8e46-8f58c9e01757",
                                "text": "Am Ende der Vorführung sollten Anton und ich in die Mitte gehen und eine Pesade zeigen."
                            },
                            {
                                "example_id": "a9dd648d-b458-4937-9682-5440104a3c48",
                                "sense_id": "fd3ae6ff-8e00-3ba9-8e46-8f58c9e01757",
                                "text": "„Man muß aber dennoch das unrechtmäßige Hochbäumen und Steigen der Pferde nicht mit der Pesade vermengen; denn bey derselben muß ein Pferd in der Hand seyn, die Hüften gebogen, und die Schenkel unter sich haben.“ (1766)"
                            }
                        ],
