                    ]
                },
                {
                    "sense_id": "374b85d6-90dd-32e2-9e1b-cccfd3f9d292",
                    "sense_definition": "Qui fait preuve d'un attachement excessif à la régularité, au détriment de la souplesse et de la spontanéité.",
