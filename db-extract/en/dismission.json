                            {
                                "example_id": "54e7696b-7209-423b-a83f-8d2972206fc3",
                                "sense_id": "ffc1939a-4e7e-380d-bde7-359e7d4c30b5",
                                "text": "Though Mrs Honour was principally attached to her own interest, she was not without some little attachment to Sophia. […] She no sooner therefore heard a piece of news, which she imagined to be of great importance to her mistress, than, quite forgetting the anger which she had conceived two days before, at her unpleasant dismission from Sophia’s presence, she ran hastily to inform her of the news."
                            }
                        ]
                    },
