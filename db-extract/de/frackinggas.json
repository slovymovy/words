                ],
                "senses": [
                    {
                        "sense_id": "2bb6cf85-2c96-3a91-b0df-d5a9d39ea7d0",
                        "entry_id": "2961225a-0288-3a8d-a70c-9a5e38488afc",
                        "glosses": [
                            "Erdgas, das mit der Fördermethode Fracking gewonnen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a153b6ab-56a1-4e85-9292-3eca52336e8f",
                                "sense_id": "2bb6cf85-2c96-3a91-b0df-d5a9d39ea7d0",
                                "text": "„In fünf Jahren ließe sich die Förderrate demnach so weit erhöhen, dass Deutschland mit heimischem Frackinggas ein Fünftel seines Erdgasbedarfs decken könnte.“"
                            },
                            {
                                "example_id": "5f15fea0-99d8-4666-bf1e-ede369216034",
                                "sense_id": "2bb6cf85-2c96-3a91-b0df-d5a9d39ea7d0",
                                "text": "„Früher wurde das amerikanische Frackinggas als Umweltsünde verteufelt.“"
                            },
                            {
                                "example_id": "5c74b4c9-9332-4f3d-abf4-a89230ed3b03",
                                "sense_id": "2bb6cf85-2c96-3a91-b0df-d5a9d39ea7d0",
                                "text": "„Zudem kam die EU-Kommission 2012 zu dem Schluss, dass Europa über Frackinggas nicht zum Selbstversorger werden könne – und selbst im besten Fall könne die Abhängigkeit von Importen nur auf 60 Prozent gesenkt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
