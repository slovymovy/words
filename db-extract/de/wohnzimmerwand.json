                    {
                        "form_id": "f7cc9115-6a62-44da-9117-82ff411747e7",
                        "entry_id": "f220db84-9d7c-3a2d-ad94-42756e3f3006",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wohnzimmerwände"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eaa6e068-f56e-3c9f-8718-563f93a940ac",
                        "entry_id": "f220db84-9d7c-3a2d-ad94-42756e3f3006",
                        "glosses": [
                            "einen als Wohnzimmer genutzten Raum zu einer Seite hin abschließendes/begrenzendes Bauteil (beispielsweise aus Klinkersteinen errichtet oder aus Beton geschüttet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb9452fd-1477-4202-844f-27e0e65947a3",
                                "sense_id": "eaa6e068-f56e-3c9f-8718-563f93a940ac",
                                "text": "„An seiner Wohnzimmerwand hängt das Stickbild eines deutschen Schäferhundes.“"
                            },
                            {
                                "example_id": "300d09a2-3803-492b-9486-2272ac4473ce",
                                "sense_id": "eaa6e068-f56e-3c9f-8718-563f93a940ac",
                                "text": "„Giovanni Segantini (1858–1899) war im ausgehenden 19. Jahrhundert ein ungemein populärer Maler; Reproduktionen seiner Werke hingen an zahllosen Wohnzimmerwänden.“"
                            },
                            {
                                "example_id": "fd6cfdf6-97d0-4015-bc4d-756fe7cd3484",
                                "sense_id": "eaa6e068-f56e-3c9f-8718-563f93a940ac",
                                "text": "„Das Porträt, das ihr Vater von Anna gemalt hatte, hing in der Mitte der Wohnzimmerwand.“"
                            },
                            {
                                "example_id": "56bda6f6-90df-400f-8b00-9e61aeeb5174",
                                "sense_id": "eaa6e068-f56e-3c9f-8718-563f93a940ac",
                                "text": "„Mit verbissener Miene ließ Alex den Blick über Wohnzimmerwände und den Fußboden schweifen.“"
                            },
                            {
                                "example_id": "c8ad1c50-aba2-48bd-8df8-05317f792f1d",
                                "sense_id": "eaa6e068-f56e-3c9f-8718-563f93a940ac",
                                "text": "„Die Betten der gesamten Familie befanden sich in Nischen in den Wohnzimmerwänden, und dort aßen und schliefen sie, wechselten die Kleider oder empfingen ihre Gäste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
