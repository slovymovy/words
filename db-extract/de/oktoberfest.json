                    {
                        "sense_id": "dca7a4cd-8c1b-3f40-aba7-8695c8e948bd",
                        "entry_id": "78dacf94-614b-3b3c-9774-0f807030386d",
                        "glosses": [
                            "Fête populaire qui se déroule en septembre et octobre à Munich, Bavière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f71a620d-8759-4806-8ee3-e5b948a9f96e",
                                "sense_id": "dca7a4cd-8c1b-3f40-aba7-8695c8e948bd",
                                "text": "Am Wochenende besuchen sehr viele Menschen das Oktoberfest. — Le week-end, un grand nombre de personnes se rendent à l'Oktoberfest."
                            },
                            {
                                "example_id": "c51b6511-33af-433b-82eb-f3eba888cacb",
                                "sense_id": "dca7a4cd-8c1b-3f40-aba7-8695c8e948bd",
                                "text": "Der Wettergott meint es dieses Jahr nicht gut mit dem Oktoberfest: mal schüttet es, mal nieselt es, aber die Sonne scheint nicht.",
                                "translation": "Cette année, la météo n'ont pas été cléments avec l'Oktoberfest : tantôt il pleut fortement, tantôt il bruine, mais le soleil ne brille pas."
                            }
                        ]
                    },
                    {
                        "sense_id": "135ed251-0d6f-3b54-b2a1-cc4e192d462f",
                        "entry_id": "78dacf94-614b-3b3c-9774-0f807030386d",
                        "glosses": [
                            "Des fêtes similaires, mais plus petites, qui sont récemment organisées à certains autres lieux en Allemagne et dans le monde."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
