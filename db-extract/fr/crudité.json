                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d542614-352c-4717-ac0a-4795861aff3e",
                                                "sense_id": "d7d8d2b9-1f99-3fd0-a4b4-b8ef623f8c19",
                                                "text": "The day broke gray and dull. The clouds hung heavily, and there was a rawness in the air that suggested snow."
                                            },
                                            {
                                                "example_id": "6d8596e6-d6b7-4853-955f-50d0be08c4d6",
                                                "sense_id": "d7d8d2b9-1f99-3fd0-a4b4-b8ef623f8c19",
                                                "text": "Now, in spite of all sorts of defects, all sorts of woollinesses and rawnesses, the American novel is superior to either the English or the French; it is indeed superior, I think, to any European novel […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fc8b740-0135-45c6-acad-cd0fb4f7dc12",
                        "source_entry_id": "68bfca8c-a603-39a1-ade4-ee91589164df",
