                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_woman",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police identified the unidentified victim only as a <w>Jane</w> Doe.",
                            "target_lang_translations": {
                                "ru": "Полиция опознала неизвестную жертву только как <w>Джейн</w> Доу.",
                                "zh": "警方仅将这名身份不明的受害者标记为<w>简</w>·多伊。"
                            }
