    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "46cbdf9b-2b2d-3d04-9ace-c145dd273e81",
                "word": "blessedness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a66d8ff6-8985-441f-b1c6-8375a0dc1b44",
                        "entry_id": "46cbdf9b-2b2d-3d04-9ace-c145dd273e81",
                        "tags": [
                            "plural"
                        ],
                        "form": "blessednesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2142a66d-165e-31ee-be55-6106a4c656e3",
                        "entry_id": "46cbdf9b-2b2d-3d04-9ace-c145dd273e81",
                        "glosses": [
                            "The condition or state of being blessed; holy."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "581ff2cb-067c-4376-8228-3f4b84da3267",
                                "sense_id": "2142a66d-165e-31ee-be55-6106a4c656e3",
                                "text": "But earthlyer happy is the roſe diſtild, / Then that, vvhich, vvithering on the virgin thorne, / Grovves, liues, and dies, in ſingle bleſſedneſſe."
                            },
                            {
                                "example_id": "0b52f8a3-619b-44af-b105-df6af2055793",
                                "sense_id": "2142a66d-165e-31ee-be55-6106a4c656e3",
                                "text": "It matters little to tell you of my blessedness; but my very heart was filled with the light of those radiant eyes, which were to me what the sun is to the world."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d29b81cb-425a-41d9-b648-5e40550e08c3",
                        "source_entry_id": "46cbdf9b-2b2d-3d04-9ace-c145dd273e81",
                        "source_sense_id": "2142a66d-165e-31ee-be55-6106a4c656e3",
                        "source_sense_description": "condition or state of being blessed",
                        "target_lang_word": "gelukzaligheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gelukzaligheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c5eb7e71-3310-32c7-9af2-d875b665cad2",
                                        "entry_id": "2ec8b7a5-41de-3257-9303-5a0160329926",
                                        "glosses": [
                                            "het heel blij en tevreden zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28cc4b2a-9daf-45f0-a6a2-d0d42156a2b1",
                                                "sense_id": "c5eb7e71-3310-32c7-9af2-d875b665cad2",
                                                "text": "Ze kon alleen nog op haar zij liggen en elke avond voor hij in slaap viel kroop Reid tegen haar aan en legde hij zijn hand koesterend op haar buik. Zijn gelukzaligheid was haast onverdraaglijk."
                                            },
                                            {
                                                "example_id": "f170a820-37d8-4ac8-9d5e-6420c1c6d78a",
                                                "sense_id": "c5eb7e71-3310-32c7-9af2-d875b665cad2",
                                                "text": "De gelukzaligheid die van het gezicht van het Schotse jongetje afstraalde, zou Samaras ook graag op het gelaat van de Griekse supporters willen toveren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0596afb7-bc92-320d-8a4d-d79e391a5fce",
                                        "entry_id": "2ec8b7a5-41de-3257-9303-5a0160329926",
                                        "glosses": [
                                            "iets waarvan je heel gelukkig wordt"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6b22ef3-9620-4711-90c2-b6a3fb39d5b7",
                        "source_entry_id": "46cbdf9b-2b2d-3d04-9ace-c145dd273e81",
                        "source_sense_id": "2142a66d-165e-31ee-be55-6106a4c656e3",
                        "source_sense_description": "condition or state of being blessed",
                        "target_lang_word": "zaligheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zaligheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8e5f87fd-87dd-3707-bb7c-ba4a8ec22a2d",
                                        "entry_id": "95e1f590-ce37-37ab-950e-20cd69e5edb1",
                                        "glosses": [
                                            "een toestand waarin men gerechtvaardigd is tegenover God"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b09da5d-1011-4fc6-b26e-972e0391dad6",
                                                "sense_id": "8e5f87fd-87dd-3707-bb7c-ba4a8ec22a2d",
                                                "text": "De zaligheid van paus Johannes Paulus II is onlangs door de huidige paus afgekondigd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5cf8b09-efc2-3a8e-b08b-b936a9e7d1c6",
                                        "entry_id": "95e1f590-ce37-37ab-950e-20cd69e5edb1",
                                        "glosses": [
                                            "overdrachtelijk iets geweldig fijns"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43dc4a80-c92d-4e41-830a-34c6ef76158d",
                                                "sense_id": "c5cf8b09-efc2-3a8e-b08b-b936a9e7d1c6",
                                                "text": "Wat een zaligheid dat je eindelijk voor dat examen geslaagd bent!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e3ef8fd-8b20-459e-9d98-1ed52d8a3640",
                        "source_entry_id": "46cbdf9b-2b2d-3d04-9ace-c145dd273e81",
                        "source_sense_id": "2142a66d-165e-31ee-be55-6106a4c656e3",
                        "source_sense_description": "condition or state of being blessed",
                        "target_lang_word": "gezegendheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4c4c5900-f81e-4e94-8fda-d725101fdd46",
                        "source_entry_id": "46cbdf9b-2b2d-3d04-9ace-c145dd273e81",
                        "source_sense_id": "2142a66d-165e-31ee-be55-6106a4c656e3",
                        "source_sense_description": "condition or state of being blessed",
                        "target_lang_word": "béatitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "béatitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                                        "entry_id": "c3b7c3f7-3685-3412-b68f-640b52751813",
                                        "glosses": [
                                            "Félicité dont les élus jouissent au paradis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67e77094-eb5b-43c2-ac37-2c19a8a459bd",
                                                "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                                                "text": "Ceux-là ne navigueront plus sur les mers mauvaises parce qu’ils ont trouvé le port et que l’ancre a été jetée dans l’incomparable béatitude."
                                            },
                                            {
                                                "example_id": "7cf1e5dc-8d5b-4b8e-aee1-6efdf4d192ac",
                                                "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                                                "text": "J’ai commencé dès ma douzième année à me faire une certaine idée que Donzac, l’année dernière et cette année, m’a rendue claire, c’est qu’à leur insu, les chrétiens qui nous ont élevés prennent en tout le contrepied de l’Évangile, et que de chaque béatitude du Sermon sur la Montagne, ils ont fait une malédiction : qu’ils ne sont pas doux, qu’ils ne sont pas seulement injustes mais qu’ils exècrent la justice."
                                            },
                                            {
                                                "example_id": "bd48a833-516d-47a9-9165-8d60edf67c90",
                                                "sense_id": "c64336d8-bd5e-34c2-9ece-2a9888d8383d",
                                                "text": "La vraie béatitude consiste dans la vue de Dieu. — Les huit béatitudes, les huit sortes de félicités dont l’évangile fait l’énumération."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e443b23-f221-3b6b-82fb-af189376bc62",
                                        "entry_id": "c3b7c3f7-3685-3412-b68f-640b52751813",
                                        "glosses": [
                                            "Bonheur parfait, satisfaction tranquille."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21c79dab-4b80-47e0-b64c-cf23ba4055a1",
                                                "sense_id": "7e443b23-f221-3b6b-82fb-af189376bc62",
                                                "text": "Un grand chat noir, frileusement roulé en boule, rêvait dans la lueur rouge du feu, avec un tout petit ronron de béatitude."
                                            },
                                            {
                                                "example_id": "754abccf-eefc-4198-92ea-cb7a64bfc0fb",
                                                "sense_id": "7e443b23-f221-3b6b-82fb-af189376bc62",
                                                "text": "Je sens mes intestins qui ronronnent légèrement. La digestion sans heurts est le plus grand facteur d'activité. Le cerveau s'emplit avec le ventre et l'optimisme a sa source dans la béatitude des tripes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d45086d9-308c-4419-bc62-f69086ec486c",
                        "source_entry_id": "46cbdf9b-2b2d-3d04-9ace-c145dd273e81",
                        "source_sense_id": "2142a66d-165e-31ee-be55-6106a4c656e3",
                        "source_sense_description": "condition or state of being blessed",
                        "target_lang_word": "Glückseligkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glückseligkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca023b94-58f2-36b6-94af-5c369b3d86ad",
                                        "entry_id": "bfd3c04d-d15c-39d4-b259-68b51f84a1b0",
                                        "glosses": [
                                            "Gefühl ungetrübten Glücks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1b09716-0212-4480-9f97-d932473c72a5",
                                                "sense_id": "ca023b94-58f2-36b6-94af-5c369b3d86ad",
                                                "text": "„Ich möchte darauf verzichten, die Glückseligkeit zu beschreiben, die unser Wiederzusammenfinden in uns auslöste.“"
                                            },
                                            {
                                                "example_id": "6aaa8412-358f-40d2-86c3-d8c1c7dbcba2",
                                                "sense_id": "ca023b94-58f2-36b6-94af-5c369b3d86ad",
                                                "text": "„Er fragte sich, warum man sich damals nicht dieser Glückseligkeit bewusst gewesen war.“"
                                            },
                                            {
                                                "example_id": "51a2c536-544d-4d88-82a7-2f72b7c1db1a",
                                                "sense_id": "ca023b94-58f2-36b6-94af-5c369b3d86ad",
                                                "text": "„Und diese Freiheit wurde zur Glückseligkeit, wenn sie aufging in jener Bindung, die alles Irdische übersteigt.“"
                                            },
                                            {
                                                "example_id": "24e3b885-2e9a-417f-b2db-29f238787f7d",
                                                "sense_id": "ca023b94-58f2-36b6-94af-5c369b3d86ad",
                                                "text": "„Nach dem Jahre 1807 lernte Nikolai Rostow diese Glückseligkeit in ihrem ganzen Umfange kennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14dda0ce-1d60-437a-98b8-07eef5e70c73",
                        "source_entry_id": "46cbdf9b-2b2d-3d04-9ace-c145dd273e81",
                        "source_sense_id": "2142a66d-165e-31ee-be55-6106a4c656e3",
                        "source_sense_description": "condition or state of being blessed",
                        "target_lang_word": "Seligkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seligkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a66fce3b-8696-391c-887d-92d050e67e30",
                                        "entry_id": "bd2e34b4-3cac-3fdc-b45e-e99926dd8f2f",
                                        "glosses": [
                                            "Gefühl voller Zufriedenheit und Glück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fa3f02c-deae-47d1-806f-35e502804903",
                                                "sense_id": "a66fce3b-8696-391c-887d-92d050e67e30",
                                                "text": "„Und als die Seligkeit am größten war, nahm Zdenek seine Trompete und fing an leise zu spielen und immer großartiger.“"
                                            },
                                            {
                                                "example_id": "affe8457-75f8-4e0f-8b78-4f29ee01eefe",
                                                "sense_id": "a66fce3b-8696-391c-887d-92d050e67e30",
                                                "text": "„Nach den überstandenen Leiden empfand Fürst Andrej ein Gefühl der Seligkeit, das er lange nicht mehr verspürt hatte.“"
                                            },
                                            {
                                                "example_id": "62f5ad4e-64cf-4ced-8e2b-0ca4c8d077ee",
                                                "sense_id": "a66fce3b-8696-391c-887d-92d050e67e30",
                                                "text": "„Wo ist die Seligkeit des isländischen Landlebens hin?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f980109-e370-36e3-b0ad-813c5c4b927b",
                                        "entry_id": "bd2e34b4-3cac-3fdc-b45e-e99926dd8f2f",
                                        "glosses": [
                                            "Zustand vollendeter Erlösung, vollendeten Heils"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87c506d8-9a9a-4d09-910d-bc8d6d549c62",
                                                "sense_id": "6f980109-e370-36e3-b0ad-813c5c4b927b",
                                                "text": "„Das erinnert bis zu dem albernen ›stracks gen Himmel‹ mehr an das von Luther befehdete katholische Tauschgeschäft Ablass gegen Seligkeit als an seine eigene Gnadenlehre, der zufolge die Erlösung unabhängig ist von guten Werken und irdischem Wirken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
