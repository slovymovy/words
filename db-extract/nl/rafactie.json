                        "source_sense_id": "cee43300-fd7f-3dbe-b214-68c717c76632",
                        "target_lang_word": "refection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0478aea0-01e1-3000-b674-894b59d0741d",
                                        "entry_id": "80e1d758-3d7e-3fff-9077-477f202f873d",
                                        "glosses": [
                                            "Mental or spiritual refreshment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0c89ecd-9d96-365a-9a78-b9671d246974",
                                        "entry_id": "80e1d758-3d7e-3fff-9077-477f202f873d",
                                        "glosses": [
                                            "Physical refreshment, especially with food or drink."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7aa99c42-cd35-4014-bcd1-880b84ccdfcf",
                                                "sense_id": "f0c89ecd-9d96-365a-9a78-b9671d246974",
                                                "text": "For beſide the common way and road of reception by the root, there may be a refection and imbibition from without; For gentle ſhowrs refreſh plants, though they enter not their roots; [...]"
                                            },
                                            {
                                                "example_id": "daa4054b-4199-43b5-9e38-7470c5cf8068",
                                                "sense_id": "f0c89ecd-9d96-365a-9a78-b9671d246974",
                                                "text": "[S]in and sorrow it were, considering the hardships of this noble and gallant knight, no whit mentioning or weighing those we ourselves have endured, if we were now either to advance or retard the hour of refection beyond the time when the viands are fit to be set before us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4d8bc27-eb7a-3eaf-801f-75aa4c6f9520",
                                        "entry_id": "80e1d758-3d7e-3fff-9077-477f202f873d",
                                        "glosses": [
                                            "A meal, especially a light meal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad952131-a285-480f-9fc5-d6c0b6d040ac",
                                                "sense_id": "c4d8bc27-eb7a-3eaf-801f-75aa4c6f9520",
                                                "text": "[T]he cooks were laying a refection before him of sack and anchovies and garlic sausage and gammons of bacon and - this was the important item - a great pudding dish out of which rose the noble dome of a crisp brown pie-crust."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75a4825d-6eae-47d2-83ca-0108b6adc663",
                        "source_entry_id": "3c711887-e5c1-382a-aadc-f34e7253814c",
                        "source_sense_id": "cee43300-fd7f-3dbe-b214-68c717c76632",
                        "target_lang_word": "réfection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réfection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7640a613-ff2c-3345-bb77-16783956ad57",
                                        "entry_id": "c841baad-eb49-3011-b7df-23f9c1f21f2a",
                                        "glosses": [
                                            "Réparation, rétablissement d’un bâtiment."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b676885f-cb8d-4cfe-b0d5-a9481195519e",
                                                "sense_id": "7640a613-ff2c-3345-bb77-16783956ad57",
                                                "text": "Il en a coûté tant pour la réfection de cette maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06e84441-bfac-3a1a-8a8a-532df882e1af",
                                        "entry_id": "c841baad-eb49-3011-b7df-23f9c1f21f2a",
                                        "glosses": [
                                            "Réparation, recréation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbb8d350-4586-46f9-81f0-eec5a76b326b",
                                                "sense_id": "06e84441-bfac-3a1a-8a8a-532df882e1af",
                                                "text": "Réfection des cartes magnétiques."
                                            },
                                            {
                                                "example_id": "61aa80c5-8338-46fe-9c70-cbb0c0486c26",
                                                "sense_id": "06e84441-bfac-3a1a-8a8a-532df882e1af",
                                                "text": "D’une représentation musical^([sic : musicale]) à un reportage télévisé, d’une manipulation par logiciel à la réfection d’une photo abîmée, de la précision miraculeuse de certains instruments chirurgicaux aux extraordinaires effets spéciaux qui renouvellent le cinéma, nombreux sont les moments où l’émotion que nous ressentons est, en partie, née d’une intervention technologique."
                                            },
                                            {
                                                "example_id": "798442c0-fbff-45ec-b979-b235d25226f3",
                                                "sense_id": "06e84441-bfac-3a1a-8a8a-532df882e1af",
                                                "text": "En effet dès les premières secondes je reconnus Flic, vêtu d'une salopette en jean, qui s'affairait, dans un hangar au bord d'une rivière, à une tâche manuelle consistant apparemment en la réfection d'un canot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "665b6a4e-785c-3ce6-b8f3-898345484bb2",
                                        "entry_id": "c841baad-eb49-3011-b7df-23f9c1f21f2a",
                                        "glosses": [
                                            "Repas, il n’est usité en ce sens que dans les communautés religieuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "871ab3a0-776a-42e9-9197-9c04ea67cffd",
                                                "sense_id": "665b6a4e-785c-3ce6-b8f3-898345484bb2",
                                                "text": "Prendre sa réfection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c862bf4-1ce3-3193-8edb-23d68803238d",
                                        "entry_id": "c841baad-eb49-3011-b7df-23f9c1f21f2a",
                                        "glosses": [
                                            "Repas."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfd5dd01-b8ad-4ba6-bdbe-90c8045e9c9c",
                                                "sense_id": "6c862bf4-1ce3-3193-8edb-23d68803238d",
                                                "text": "Mais, paraît-il, ce n’était pas l’heure de sa réfection, car il finit par allonger sa tête entre ses pattes, en fermant les yeux."
                                            },
                                            {
                                                "example_id": "63c94c1a-4298-4d38-926b-b3ae7a754944",
                                                "sense_id": "6c862bf4-1ce3-3193-8edb-23d68803238d",
                                                "text": "Le matin, pendant la classe, c’est-à-dire de neuf heures un quart à onze heures et demie, elle entretient les feux, prépare les paniers et les tables de réfection, répond à tous les appels, en cas d’accident malpropre, et garde les élèves si la directrice ou une maîtresse a besoin de s’absenter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d7b2cf1-c6fe-3c7a-94e9-21f131b42fe4",
                                        "entry_id": "c841baad-eb49-3011-b7df-23f9c1f21f2a",
                                        "glosses": [
                                            "Reformation à partir d’un modèle préexistant. Opération qui consiste à modifier une forme populaire due à l'évolution normale d'un mot, en la transformant pour la rapprocher de son étymon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "317d2ff9-f69f-407e-89f0-e807bfd56951",
                                                "sense_id": "2d7b2cf1-c6fe-3c7a-94e9-21f131b42fe4",
                                                "text": "Les lettrés de la Renaissance ont procédé à de nombreuses réfections à partir du latin et du grec."
                                            },
                                            {
                                                "example_id": "015a4177-6068-4871-bc3a-035be510b9d1",
                                                "sense_id": "2d7b2cf1-c6fe-3c7a-94e9-21f131b42fe4",
                                                "text": "À la Renaissance, la réfection de certains verbes français s'est faite sur les flexions majoritaires ; comme treuves, trouvons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ff982fa-d5d7-32aa-8770-a8e3c178cafb",
                                        "entry_id": "c841baad-eb49-3011-b7df-23f9c1f21f2a",
                                        "glosses": [
                                            "Remplacement d'un acte atteint de nullité par vice de forme, par un acte identique dans sa nature et son objet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5b2cb07-48af-3f90-9162-0a7708ba0389",
                                        "entry_id": "c841baad-eb49-3011-b7df-23f9c1f21f2a",
                                        "glosses": [
                                            "Réparation chirurgicale de ce qui a été abîmé ou détruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d9b93f0-123a-400a-8fe6-27a06a56e1ce",
                                                "sense_id": "a5b2cb07-48af-3f90-9162-0a7708ba0389",
                                                "text": "Le chirurgien a procédé à la réfection de mon épaule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f882cb55-46e2-307b-918f-4dbf8f27f922",
                                        "entry_id": "c841baad-eb49-3011-b7df-23f9c1f21f2a",
                                        "glosses": [
                                            "Opération consistant à refaire systématiquement la rédaction d’une carte, en modifiant éventuellement les modes d’expression ou de représentation et qui s’accompagne généralement d’une révision cartographique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
