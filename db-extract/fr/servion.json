                "forms": [],
                "senses": [
                    {
                        "sense_id": "7b273069-696c-3f5d-ba37-71e3750d692c",
                        "entry_id": "28f34b6f-536d-321b-a5f2-dbfd408e0b00",
                        "glosses": [
                            "Village et ancienne commune française, située dans le département des Ardennes intégrée dans la commune de Rouvroy-sur-Audry."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15acd9e0-af09-4375-b147-d28a8ca5fa69",
                                "sense_id": "7b273069-696c-3f5d-ba37-71e3750d692c",
                                "text": "A ce calcaire sont superposées des couches d'un calcaire coquiller, dur, renfermant de très grandes coquilles. C'est dans les couches inférieures que sont ouvertes les grandes carrières de Dom, celles de Saint-Martin, de Saint-Walfroy. On les exploite aussi dans la partie occidentale du département, à Servion, à Clavy-Warby, etc."
                            },
                            {
                                "example_id": "6bbb8755-542b-4849-b492-0e10aabce5be",
                                "sense_id": "7b273069-696c-3f5d-ba37-71e3750d692c",
                                "text": "L'église fortifiée de Servion est l'une des plus remarquables du côté ardennais. Fortifié au cours du XVᵉ siècle, cet édifice présente une tour-porche carrée flanquée de deux tours d'angle rondes coiffées d'ardoise, percées de canonnières, qui lui donnent une allure de petit château fort."
                            }
                        ]
                    },
