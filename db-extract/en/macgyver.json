                "senses": [
                    {
                        "sense_id": "9ba798d8-3838-3073-a332-49de576c956c",
                        "entry_id": "3d848362-f1bb-3402-89e8-95dfc6f6a1b0",
                        "glosses": [
                            "To assemble or repair something by ingenious improvisation, using everyday items that would not usually be used for the purpose."
                        ],
                        "tags": [
                            "dated",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c2f1bb37-c94c-4f95-8a99-08d825ed3f50",
                                "sense_id": "9ba798d8-3838-3073-a332-49de576c956c",
                                "text": "Our car broke down and we didn't have any tools but Jim MacGyvered it with some toenail clippers and we were able to limp to the service station."
                            },
                            {
                                "example_id": "2bb4d296-d48f-4762-aae8-bfc0d8bccff9",
                                "sense_id": "9ba798d8-3838-3073-a332-49de576c956c",
                                "text": "It is why some of the American troops experimented with commercial drones that they could weaponize by fixing with explosives, to see how to counter such tactics, much as Russian troops have had to learn how to defend against Ukraine’s use of store-bought drones that have been MacGyvered with explosives."
                            }
                        ]
                    }
                ],
