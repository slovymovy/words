                "senses": [
                    {
                        "sense_id": "a8e1b4a1-543a-3d88-9f25-d8e73511b5e2",
                        "entry_id": "4031e3e3-95f9-3881-9599-b7a1056c8792",
                        "glosses": [
                            "Bassine, munie d’oreilles dans lesquelles on passe une corde en guise d’anse et qui sert à transporter les liquides, en particulier, le mout tiré du pressoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "919f0c6e-e8be-4ad0-a7fd-bab3c8774e58",
                                "sense_id": "a8e1b4a1-543a-3d88-9f25-d8e73511b5e2",
                                "text": "La veille, parce qu’elle s’ennuyait à ne rien faire, elle avait rempli une seille. Et longuement y avait lavé le pantalon de velours de son mari."
                            },
                            {
                                "example_id": "1aed7bb5-043b-4e33-a8e6-2d0d607906d4",
                                "sense_id": "a8e1b4a1-543a-3d88-9f25-d8e73511b5e2",
                                "text": "La boutique, l’arrière-boutique, un appartement au quatrième, deux seilles d’eau pour la cuisine à remplir tous les matins !"
                            },
                            {
                                "example_id": "d36e8ae9-0e19-41f4-8c04-9d3167507553",
                                "sense_id": "a8e1b4a1-543a-3d88-9f25-d8e73511b5e2",
                                "text": "[…], çà et là un puits surmonté d’une potence à laquelle pend une seille, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "ccb297b7-8ec9-335a-ab36-462687eb2c68",
                        "entry_id": "4031e3e3-95f9-3881-9599-b7a1056c8792",
                        "glosses": [
                            "Mesure de capacité d’environ 16 litres."
