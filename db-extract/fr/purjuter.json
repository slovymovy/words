                "senses": [
                    {
                        "sense_id": "4abbd7f5-82f1-3eb6-9016-b7fcf3be85c2",
                        "entry_id": "7f8cba99-c016-363d-9b23-582fa2699d32",
                        "glosses": [
                            "Suinter, transsuder. Se dit surtout des choses dont il est particulièrement facile d’exprimer le jus."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "f9d44006-efaf-416b-b695-fd5dc40b4545",
                                "sense_id": "4abbd7f5-82f1-3eb6-9016-b7fcf3be85c2",
                                "text": "Purjuter, v. n. Suinter, transsuder. Ex. Un fruit qui purjute."
                            },
                            {
                                "example_id": "65e22856-2dd2-4142-9c23-773735acfa06",
                                "sense_id": "4abbd7f5-82f1-3eb6-9016-b7fcf3be85c2",
                                "text": "Il prend son élan, saute au cou du Shadow Wolf et plonge ses pouces au creux des orbites surplombés de sourcils poivre et sel ; il pèse, pèse, pèse encore, fait purjuter les yeux comme la chair d’un fruit mûr."
                            }
                        ]
                    }
