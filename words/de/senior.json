            "senses": [
                {
                    "sense_id": "025241a0-a716-3a3e-9d66-0b1e0129f2e8",
                    "sense_definition": "Mensch im fortgeschrittenen Lebensalter, meist im Renten- oder Pensionsalter",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "alter_mensch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Stadtverwaltung organisiert regelmäßig Ausflüge und kulturelle Veranstaltungen für <w>Senioren</w>."
                        },
                        {
                            "text": "Im Bus bot der junge Mann einem gebrechlichen <w>Senior</w> freundlich seinen Sitzplatz an."
                        }
                    ],
                    "common_phrases": [
                        "Veranstaltungen für Senioren",
                        "Reisen für Senioren"
                    ]
                },
                {
                    "sense_id": "cc6c71c9-9bcf-348f-939c-e55fa516b538",
                    "sense_definition": "älterer Teilhaber oder Leiter eines Unternehmens, meist im Verhältnis zum jüngeren Nachfolger",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "betrieb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach vierzig Jahren übergab der <w>Senior</w> schließlich die gesamte Leitung der Firma an seinen Sohn."
                        },
                        {
                            "text": "Bei wichtigen strategischen Fragen berät sich der Nachfolger immer noch gern mit dem <w>Senior</w>."
                        }
                    ],
                    "synonyms": [
                        "Seniorchef"
                    ],
                    "antonyms": [
                        "Junior",
                        "Juniorchef"
                    ],
                    "common_phrases": [
                        "der Senior im Betrieb"
                    ]
                },
                {
                    "sense_id": "3be8c166-c581-3448-bad0-fbdd599648ef",
                    "sense_definition": "Sportler einer höheren Altersklasse, meist nach dem Verlassen der Jugendmannschaften",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ab der kommenden Fußballsaison spielt der junge Stürmer nicht mehr in der Jugend, sondern bei den <w>Senioren</w>."
                        },
                        {
                            "text": "Am kommenden Wochenende tragen unsere <w>Senioren</w> ein wichtiges Heimspiel gegen die Nachbarstadt aus."
                        }
                    ],
                    "antonyms": [
                        "Junior"
                    ],
                    "common_phrases": [
