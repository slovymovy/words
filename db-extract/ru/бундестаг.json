                                "target_senses": [
                                    {
                                        "sense_id": "cdd11d5f-a5b4-32c4-b5a2-f0f582d5a9b9",
                                        "entry_id": "be079543-5858-333e-9ccb-7b66be461849",
                                        "glosses": [
                                            "die Volksvertretung der Bundesrepublik Deutschland, Deutscher Bundestag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2b22bf1-55d5-41f8-9527-16a13a967b13",
                                                "sense_id": "cdd11d5f-a5b4-32c4-b5a2-f0f582d5a9b9",
                                                "text": "Der Bundestag tagt im Reichstagsgebäude in Berlin."
                                            },
                                            {
                                                "example_id": "f8698d89-ebbe-4ca7-81dd-43d6919d8ff4",
                                                "sense_id": "cdd11d5f-a5b4-32c4-b5a2-f0f582d5a9b9",
                                                "text": "„Am Donnerstagabend verabschiedete der Bundestag eine Novelle, die es Behörden ermöglicht, Verbraucher schneller über Fälle von Etikettenschwindel zu informieren.“"
                                            },
                                            {
                                                "example_id": "5aa5d431-6fb5-4fa9-b59b-b6ccc6b8ffc6",
                                                "sense_id": "cdd11d5f-a5b4-32c4-b5a2-f0f582d5a9b9",
                                                "text": "„Das Mandat der Bundeswehr für OEF wird jährlich durch den Bundestag überprüft.“"
                                            },
                                            {
                                                "example_id": "58423fef-c2d7-4eff-bde3-3f8eb24a6807",
                                                "sense_id": "cdd11d5f-a5b4-32c4-b5a2-f0f582d5a9b9",
                                                "text": "„Die Gesellschaft für Deutsche Sprache unterstützt die Arbeit des Bundestages seit 1966.“"
                                            },
                                            {
                                                "example_id": "f70e3247-6756-4035-80fa-6fa362120b3d",
                                                "sense_id": "cdd11d5f-a5b4-32c4-b5a2-f0f582d5a9b9",
                                                "text": "„Er darf nicht im Bundestag reden, das dürfen nur Abgeordnete, Minister und Ministerpräsidenten.“"
                                            }
                                        ],
