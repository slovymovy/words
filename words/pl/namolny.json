                    "sense_definition": "nużący, jednostajny i przez to męczący dla odbiorcy",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego wykład był tak <w>namolny</w>, że połowa studentów zasypiała w ławkach.",
                            "target_lang_translations": {
                                "ru": "Его лекция была настолько <w>занудной</w>, что половина студентов засыпала за партами."
                            }
