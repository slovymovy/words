                    {
                        "translation_id": "966ca188-ac79-49f2-9193-fba36e7863ca",
                        "source_entry_id": "7dcc2f8a-cfcb-3edd-8133-0b18ad26de13",
                        "source_sense_id": "faa78cea-1986-322d-bc10-52b6508c0f89",
                        "target_lang_word": "aimant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aimant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f24e80c9-ce26-38ed-9d9d-467561a0cd95",
                                        "entry_id": "6bc09e97-6e3f-36c0-8b43-d3cc45d7b5cd",
                                        "glosses": [
                                            "Minéral ou composant générant un champ magnétique, dont une des propriétés est d’attirer le fer."
                                        ],
                                        "tags": [
                                            "Magnétisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "995fd748-a135-4e67-9a19-dfd869501533",
                                                "sense_id": "f24e80c9-ce26-38ed-9d9d-467561a0cd95",
                                                "text": "Pierre d’aimant. L’aimant communique sa vertu attractive au fer et à l’acier. Aiguille frottée d’aimant."
                                            },
                                            {
                                                "example_id": "3cf0d115-f69d-4f81-a3ec-cc45e3d14365",
                                                "sense_id": "f24e80c9-ce26-38ed-9d9d-467561a0cd95",
                                                "text": "Du côté de l’Ouest, au bout des lointains, je cherchais des yeux la mer qui, parfois, quand on était allé très loin, montrait au-dessus de ces lignes déjà si planes, une autre petite raie bleuâtre plus complètement droite, — et attirante, attirante à la longue comme un grand aimant patient, sûr de sa puissance et pouvant attendre."
                                            },
                                            {
                                                "example_id": "fb00e954-cdfe-4cd1-ae0d-ad1493380723",
                                                "sense_id": "f24e80c9-ce26-38ed-9d9d-467561a0cd95",
                                                "text": "Deux jeunes femmes, seules, habitant ensemble, attirent vers elles hommes et femmes comme un aimant. L’aimant, un si joli mot, et qui dit si bien ce qu’il veut dire."
                                            },
                                            {
                                                "example_id": "1029492d-3da0-4a55-afdd-6fbb6d808512",
                                                "sense_id": "f24e80c9-ce26-38ed-9d9d-467561a0cd95",
                                                "text": "Ce projecteur est doté d’un puissant aimant, fort pratique pour le fixer sur les structures métalliques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "019c749e-f999-3d4b-8148-1b0e8be0b7c4",
                                        "entry_id": "6bc09e97-6e3f-36c0-8b43-d3cc45d7b5cd",
                                        "glosses": [
                                            "Objet décoratif aimanté."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4b3831a-2f6f-4712-8259-c976514f38e3",
                                                "sense_id": "019c749e-f999-3d4b-8148-1b0e8be0b7c4",
                                                "text": "Au magasin du musée, on s'arrachait les souvenirs du maître: des aimants pour frigo frappés du portrait de Dora Maar aux répliques à 136 dollars de son indémodable pull marin en passant par les T-shirts estampillés d'une citation du maître …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "764f6875-f043-3fb5-9e63-c5c6fd4419d5",
                                        "entry_id": "6bc09e97-6e3f-36c0-8b43-d3cc45d7b5cd",
                                        "glosses": [
                                            "Ce qui attire et attache."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ba14c8a-cf1e-49eb-bc1d-ce4a9eda6a09",
                                                "sense_id": "764f6875-f043-3fb5-9e63-c5c6fd4419d5",
                                                "text": "Les embouchures de rivières et les ruisseaux sont de vrais aimants à dorés."
                                            },
                                            {
                                                "example_id": "aefd1a79-b38a-4697-9535-56e027998352",
                                                "sense_id": "764f6875-f043-3fb5-9e63-c5c6fd4419d5",
                                                "text": "La modestie, la douceur est un aimant qui attire les cœurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aimant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3146b31e-0814-3e79-91fe-51c793ee3331",
                                        "entry_id": "90ee85ba-2328-381c-8205-af73b3d13964",
                                        "glosses": [
                                            "Qui est porté à aimer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e6fd76-6d7f-4083-8749-c42291ce022a",
                                                "sense_id": "3146b31e-0814-3e79-91fe-51c793ee3331",
                                                "text": "Comment n’accourt-il pas, se demandait-elle, vers chaque homme de génie, une femme aimante, riche, belle qui se fasse son esclave comme dans Lara, le page mystérieux ?"
                                            },
                                            {
                                                "example_id": "b8fd0788-d85a-469d-a072-b00be216beb2",
                                                "sense_id": "3146b31e-0814-3e79-91fe-51c793ee3331",
                                                "text": "Était-ce ton visage penché sur le mien, cette ombre entrevue, ou bien un fantôme aimant, sorti de la nuit pour tromper ma solitude ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aimant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88e8c35c-381a-38b5-9cdb-45d75ceb9b1d",
                                        "entry_id": "f177d9d2-87b1-38d3-ade5-8b8f37d5bb19",
                                        "glosses": [
                                            "Participe présent de aimer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30cdedbe-e74c-4483-91cc-d5d6b1ceeaa1",
                                                "sense_id": "88e8c35c-381a-38b5-9cdb-45d75ceb9b1d",
                                                "text": "Mais que deviendras-tu si, folle en son caprice, N’aimant que le scandale et l’éclat dans le vice, Bien moins pour son plaisir que pour t’inquiéter, Au fond peu vicieuse, elle aime à coquetter ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
