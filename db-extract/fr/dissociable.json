                        ],
                        "form": "dissociables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d4696c3-7d0d-3a47-bc88-942cce9c8818",
                        "entry_id": "5e6dc39a-d9b7-3c91-9ec6-fc367b8ade4d",
                        "glosses": [
                            "Que l’on peut dissocier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "739bf36f-2b6e-43c0-bf23-68c2504aa37b",
                                "sense_id": "4d4696c3-7d0d-3a47-bc88-942cce9c8818",
                                "text": "Il s’agit de donner corps à des entités étatiques incarnant des identités réputées irréductibles et tendanciellement dissociables les unes des autres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca713001-8e9e-42b7-a2f1-04ec04436286",
                        "source_entry_id": "5e6dc39a-d9b7-3c91-9ec6-fc367b8ade4d",
                        "source_sense_id": "4d4696c3-7d0d-3a47-bc88-942cce9c8818",
                        "target_lang_word": "auflösbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auflösbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1932f83d-4606-38dc-9309-3abf444d912e",
                                        "entry_id": "78c40d2f-5274-3df2-b692-1c80dffa7e2f",
                                        "glosses": [
                                            "in Flüssigkeit (Lösungsmittel) in kleinsten Teilchen zu verteilen (aufzulösen) sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33e8e8e7-523c-4ba8-a64c-650a65f05573",
                                                "sense_id": "1932f83d-4606-38dc-9309-3abf444d912e",
                                                "text": "„Hier sei nur betont, dass ein Niederschlag als auflösbar bezeichnet wird, wenn der aus 2 — 4ccm Lösung gefällte Niederschlag auf Zusatz von einigen ccm Säure (8/t-norm.) vollständig oder bis auf einen geringfügigen Rest in Lösung geht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e30ba573-502c-33a3-a571-6651a3562294",
                                        "entry_id": "78c40d2f-5274-3df2-b692-1c80dffa7e2f",
                                        "glosses": [
                                            "auftrennbar, so separierbar/auseinander zu sortieren sein, dass etwas nicht mehr untrennbar zusammengehört"
                                        ],
                                        "tags": [
                                            "über einen Knoten",
                                            "auch übertragen für Problem"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a44f08a-f0aa-4a1f-8c1d-5aaa3ebc6e3a",
                                                "sense_id": "e30ba573-502c-33a3-a571-6651a3562294",
                                                "text": "„Das Knotenknüpfen bildet daher auch einen nicht unwichtigen Theil der Matrosenarbeit, und bei dem Matrosen schätzt man die Fertigkeit nicht gering, schnell, fest und dabei wieder leicht auflösbare Knoten zu knüpfen.“"
                                            },
                                            {
                                                "example_id": "54926837-3ea8-4a15-8037-e3aa56037800",
                                                "sense_id": "e30ba573-502c-33a3-a571-6651a3562294",
                                                "text": "übertragen: „Nur dadurch, daß dieser Knoten überhaupt nicht aufgelöst werden kann, wird er auflösbar.“"
                                            },
                                            {
                                                "example_id": "5f4a4b6e-83f8-4ea8-a8a6-e98aa1d55964",
                                                "sense_id": "e30ba573-502c-33a3-a571-6651a3562294",
                                                "text": "übertragen: „Der Widerspruch als solcher bzw. das Paradox erscheint ihnen als ein logisch nicht mehr auflösbarer Knoten.“"
                                            },
                                            {
                                                "example_id": "bc3c2100-cdd0-441c-88ba-1b1cf3015e26",
                                                "sense_id": "e30ba573-502c-33a3-a571-6651a3562294",
                                                "text": "übertragen: „In der Sprache kann die Spannung dieser Grunddifferenz nur als nicht auflösbarer semantischer Konflikt (Paradox) und im Sprachgebrauch nur als nicht vermeidbarer pragmatischer Konflikt (Kult) zur Darstellung kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "74a0da00-dad2-3183-bc9f-506c0a070a8a",
                                        "entry_id": "78c40d2f-5274-3df2-b692-1c80dffa7e2f",
                                        "glosses": [
                                            "in den Zustand (zurück) versetzbar, nicht geschlossen worden zu sein"
                                        ],
                                        "tags": [
                                            "Rechtswissenschaften",
                                            "über einen Vertrag, einen Rechtsakt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb5bb63e-f809-4f7a-9d70-c4e3a6aa4772",
                                                "sense_id": "74a0da00-dad2-3183-bc9f-506c0a070a8a",
                                                "text": "„Der Belegarztvertrag wird grundsätzlich auf unbestimmte Zeit abgeschlossen und ist durch ordentliche Kündigung mit angemessener Frist auflösbar.“"
                                            },
                                            {
                                                "example_id": "5d871cd5-961a-44f0-8e05-f7b86e61afe7",
                                                "sense_id": "74a0da00-dad2-3183-bc9f-506c0a070a8a",
                                                "text": "„Da jeder Vertrag auflösbar ist und aufgelöst wird durch die entgegengesetzte Absicht beider Parteien, so ist auch die E. [= Ehe] auflösbar und wird wirklich aufgelöst, wenn beide Ehegatten darin übereinstimmen, sie auflösen zu wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c9338379-7155-334e-99d2-86db8e41f225",
                                        "entry_id": "78c40d2f-5274-3df2-b692-1c80dffa7e2f",
                                        "glosses": [
                                            "in Untergruppen zerlegbar, die gewissen Kriterien folgen müssen"
                                        ],
                                        "tags": [
                                            "Gruppentheorie",
                                            "über eine Gruppe, Reihe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a21f26bb-08be-4ee9-83f0-59edb7f38010",
                                                "sense_id": "c9338379-7155-334e-99d2-86db8e41f225",
                                                "text": "„Die verbreitetste Definition lautet: Eine Gruppe ist auflösbar, falls sie eine Subnormalreihe mit abelschen Faktorgruppen hat.“"
                                            },
                                            {
                                                "example_id": "2be17406-4f3c-4e77-b1f7-9eeabc8a201b",
                                                "sense_id": "c9338379-7155-334e-99d2-86db8e41f225",
                                                "text": "„In § 1 sind einfache Eigenschaften von n-auflösbaren und auflösbaren Gruppen zusammengestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "09579b65-edae-3823-bd71-a5ccc1c82cff",
                                        "entry_id": "78c40d2f-5274-3df2-b692-1c80dffa7e2f",
                                        "glosses": [
                                            "in Einzelobjekte trennbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a8d48d3-814e-4855-a8e6-43ff22a99688",
                                                "sense_id": "09579b65-edae-3823-bd71-a5ccc1c82cff",
                                                "text": "„Da nur bei bedeckungsveränderlichen Sternen die Bahnneigung eines optisch nicht in seine Komponenten auflösbaren Doppelsternsystems bestimmt werden kann, sind sie die wichtigste Quelle zur Bestimmung von Sternmassen.“"
                                            },
                                            {
                                                "example_id": "18b02b94-a155-4ff3-ab52-a22fc138a24c",
                                                "sense_id": "09579b65-edae-3823-bd71-a5ccc1c82cff",
                                                "text": "„Galaxien sind am Himmel auch mit den modernsten Teleskopen nicht in ihre einzelnen Sterne auflösbar, dafür sind sie alle zu weit entfernt und enthalten zu viele Sterne.“"
                                            },
                                            {
                                                "example_id": "bca462e5-0780-48df-86b4-dd1f4e47e8f2",
                                                "sense_id": "09579b65-edae-3823-bd71-a5ccc1c82cff",
                                                "text": "„Ersterer ist schon mit freien Augen bemerkbar, doppelkegelförmig gestaltet, nicht in Sterne auflösbar, denn die darin stehenden Sterne scheinen wohl nicht zu ihm selbst zu gehören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "5ec17337-f643-31c0-8762-c806c5fe6752",
                                        "entry_id": "78c40d2f-5274-3df2-b692-1c80dffa7e2f",
                                        "glosses": [
                                            "derart beeinflussbar, dass etwas nicht mehr vorhanden ist (sich auflöst)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77b60cd4-68c5-4967-a71b-a38a59f055e9",
                                                "sense_id": "5ec17337-f643-31c0-8762-c806c5fe6752",
                                                "text": "„Diese Spannung ist nicht auflösbar.“"
                                            },
                                            {
                                                "example_id": "38a17ff2-3f92-4aa6-9cc4-c15e85992eb4",
                                                "sense_id": "5ec17337-f643-31c0-8762-c806c5fe6752",
                                                "text": "„Das jüdische Ghetto der Mittelmeerinsel Kephallenia wird in einen Innenraum der okzidentalen Stadt projiziert, wobei zwischen beiden Städten eine Spannung besteht, die als nicht auflösbar dargestellt wird.“"
                                            },
                                            {
                                                "example_id": "339433de-569e-40ea-a30a-8b367f2e24a9",
                                                "sense_id": "5ec17337-f643-31c0-8762-c806c5fe6752",
                                                "text": "„Ein Rätsel, das nur noch für den Fragenden auflösbar ist, gilt als unlösbar.“"
                                            },
                                            {
                                                "example_id": "0a54f6bf-de35-4627-b192-50aa2a87be71",
                                                "sense_id": "5ec17337-f643-31c0-8762-c806c5fe6752",
                                                "text": "„Die auflösbaren Pasten […] entfalten auf Grund ihrer Depotwirkung nur für begrenzte Zeit ihren Zweck und lösen sich dabei auf, sie sind als Dauerfüllmaterial ungeeignet und müssen immer wieder erneuert oder durch ein anderes, nicht auflösbares Material ersetzt werden.“"
                                            },
                                            {
                                                "example_id": "ce46ca66-a2e7-42b5-a96b-c84ab2274885",
                                                "sense_id": "5ec17337-f643-31c0-8762-c806c5fe6752",
                                                "text": "„So soll die Steinbildung eine Folge eines Vitamin-D3-Mangels und eines Kalziummangels oder aber eines Vitamin-A Mangels sein; auch nicht auflösbares Nahtmaterial wurde als Auslöser vermutet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99397320-2038-4716-ade0-c1005000e11e",
                        "source_entry_id": "5e6dc39a-d9b7-3c91-9ec6-fc367b8ade4d",
