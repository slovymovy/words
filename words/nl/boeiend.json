                    "sense_id": "9989cead-5f97-3ff4-b6ac-8a4888702c2a",
                    "sense_definition": "iets wat de aandacht sterk vasthoudt en erg interessant is",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "interessant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij vertelde een <w>boeiend</w> verhaal over zijn verre reizen.",
                            "target_lang_translations": {
                                "en": "He told a <w>fascinating</w> story about his distant travels.",
                                "ru": "Он рассказал <w>увлекательную</w> историю о своих далеких путешествиях.",
                                "fr": "Il a raconté une histoire <w>passionnante</w> sur ses voyages lointains."
                            }
                        },
                        {
                            "text": "Ik vind deze documentaire over de natuur erg <w>boeiend</w> om te zien.",
                            "target_lang_translations": {
                                "en": "I find this documentary about nature very <w>engaging</w> to watch.",
                                "ru": "Мне кажется, этот документальный фильм о природе очень <w>интересно</w> смотреть.",
                                "fr": "Je trouve ce documentaire sur la nature très <w>captivant</w> à regarder."
                            }
