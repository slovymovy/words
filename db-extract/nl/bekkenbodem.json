                                    {
                                        "sense_id": "b4c2cab1-27c4-3838-bc6b-9d76f6728d62",
                                        "entry_id": "730d7ccf-eabb-3b79-b74c-bf36c2dbc80d",
                                        "glosses": [
                                            "unterer Bereich der Beckenhöhle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d90a1bbe-0004-4c95-8a9d-cedaf4de5722",
                                                "sense_id": "b4c2cab1-27c4-3838-bc6b-9d76f6728d62",
                                                "text": "„Der Beckenboden ist mit seiner Muskulatur der untere Abschluss des Beckens. Er besteht aus drei Schichten, die aus mehreren Muskeln und Bindegewebsschichten zusammengesetzt sind.“"
                                            },
                                            {
                                                "example_id": "6ca773b4-ce53-4010-a5d9-a96599e458d4",
                                                "sense_id": "b4c2cab1-27c4-3838-bc6b-9d76f6728d62",
                                                "text": "„Der Beckenboden verschließt das Becken nach unten, stützt die inneren Organe und ermöglicht so unsere aufrechte Haltung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c08d8fb8-7b65-33ab-bc47-530e38201090",
                                        "entry_id": "730d7ccf-eabb-3b79-b74c-bf36c2dbc80d",
                                        "glosses": [
                                            "Grund eines Bauwerks, das mit Wasser gefüllt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a09fa102-788f-48b8-ae28-6bb9aef7caf2",
                                                "sense_id": "c08d8fb8-7b65-33ab-bc47-530e38201090",
                                                "text": "„Am tiefen Ende gab es eine Leiter, die zum Beckenboden hinunterführte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5006b131-3481-4bee-be38-e54a6eb6c883",
