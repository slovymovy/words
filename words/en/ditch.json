{
    "word_family": [
        "ditcher",
        "ditching"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "61511834-8c8d-3a4a-ac6e-32cc9df78653",
                    "sense_definition": "A long, narrow trench dug in the ground, usually used for drainage or irrigation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "trench_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The truck skidded off the icy road and landed in a <w>ditch</w>.",
                            "target_lang_translations": {
                                "ru": "Грузовик занесло на обледенелой дороге, и он угодил в <w>кювет</w>.",
                                "zh": "卡车在结冰的路面上打滑，冲出公路，掉进了<w>沟</w>里。"
                            }
                        },
                        {
                            "text": "Farmers dug a deep <w>ditch</w> along the edge of the field to improve water drainage.",
                            "target_lang_translations": {
                                "ru": "Фермеры вырыли глубокую <w>канаву</w> вдоль края поля, чтобы улучшить отвод воды.",
                                "zh": "农民们在田边挖了一条很深的<w>沟渠</w>，以改善排水。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drainage ditch",
                        "irrigation ditch",
                        "roadside ditch",
                        "dig a ditch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная узкая траншея в земле, обычно используемая для дренажа или орошения.",
                        "zh": "地面上挖出的细长沟槽，通常用于排水或灌溉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канава",
                                "target_lang_sense_clarification": "общее значение; для стока воды"
                            },
                            {
                                "target_lang_word": "кювет",
                                "target_lang_sense_clarification": "вдоль дороги"
                            },
                            {
                                "target_lang_word": "ров",
                                "target_lang_sense_clarification": "глубокий, часто оборонительный"
                            },
                            {
                                "target_lang_word": "траншея",
                                "target_lang_sense_clarification": "техническое/военное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沟",
                                "target_lang_sense_clarification": "一般说法，指地上挖出的细长沟"
                            },
                            {
                                "target_lang_word": "沟渠",
                                "target_lang_sense_clarification": "较正式，常指排水或灌溉用"
                            },
                            {
                                "target_lang_word": "排水沟",
                                "target_lang_sense_clarification": "道路旁或排水用的沟"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf37634e-8c4d-34e7-8ebc-f4a116122d19",
                    "sense_definition": "A raised bank of earth, often with a hedgerow growing on top.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "bank_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this region, a <w>ditch</w> refers to the raised earth bank rather than the trench beside it.",
                            "target_lang_translations": {
                                "ru": "В этом регионе слово ditch относится к земляной <w>насыпи</w>, а не к траншее рядом с ней.",
                                "zh": "在这个地区，<w>ditch</w>指的是隆起的<w>土埂</w>，而不是旁边的沟。"
                            }
                        },
                        {
                            "text": "Sheep grazed peacefully near the grassy <w>ditch</w> that separated the two pastures.",
                            "target_lang_translations": {
                                "ru": "Овцы мирно паслись возле поросшего травой <w>вала</w>, разделявшего два пастбища.",
                                "zh": "羊群安静地在那道长满草、分隔两块牧场的<w>土埂</w>旁吃草。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Ireland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Земляная насыпь или вал, часто с живой изгородью наверху (региональное значение).",
                        "zh": "隆起的土堤或土埂，上面常长有树篱一类植物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насыпь",
                                "target_lang_sense_clarification": "земляной вал"
                            },
                            {
                                "target_lang_word": "вал",
                                "target_lang_sense_clarification": "возвышение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "土埂",
                                "target_lang_sense_clarification": "地区用法，指隆起的土堆或田埂"
                            },
                            {
                                "target_lang_word": "土堤",
                                "target_lang_sense_clarification": "较宽的土质堤状隆起"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bb606391-6622-30ca-8072-2708b2202264",
                    "sense_definition": "To get rid of someone or something that is no longer wanted or needed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abandon_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>ditch</w> the old furniture and buy a modern set instead.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>выбросить</w> старую мебель и купить вместо нее современный гарнитур.",
                                "zh": "我们决定<w>扔掉</w>旧家具，另外买一套现代的。"
                            }
                        },
                        {
                            "text": "He had to <w>ditch</w> the plan at the last minute because it was too expensive.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>отказаться от</w> плана в последнюю минуту, потому что это было слишком дорого.",
                                "zh": "因为费用太高，他最后一刻只好<w>放弃</w>那个计划。"
                            }
                        }
                    ],
                    "synonyms": [
                        "abandon",
                        "discard",
                        "dump",
                        "shed",
                        "jettison"
                    ],
                    "antonyms": [
                        "keep",
                        "retain"
                    ],
                    "common_phrases": [
                        "ditch the plan",
                        "ditch a boyfriend",
                        "ditch the car"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Избавиться от кого-то или чего-то, что больше не нужно или нежелательно.",
                        "zh": "把不再想要或不再需要的人或东西甩开、丢掉或放弃。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросить",
                                "target_lang_sense_clarification": "оставить кого-то или что-то"
                            },
                            {
                                "target_lang_word": "избавиться",
                                "target_lang_sense_clarification": "выкинуть, устранить"
                            },
                            {
                                "target_lang_word": "кинуть",
                                "target_lang_sense_clarification": "сленг; бросить кого-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丢掉",
                                "target_lang_sense_clarification": "把不再需要的东西扔掉"
                            },
                            {
                                "target_lang_word": "甩掉",
                                "target_lang_sense_clarification": "扔开、甩掉；也可用于人"
                            },
                            {
                                "target_lang_word": "放弃",
                                "target_lang_sense_clarification": "对计划、想法等不再继续"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13883e54-b68a-3280-a899-d53c513c90e1",
                    "sense_definition": "To stay away from school or a class without permission.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "skip_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher called her parents after she tried to <w>ditch</w> class with her friends.",
                            "target_lang_translations": {
                                "ru": "Учитель позвонил её родителям после того, как она попыталась <w>прогулять</w> урок с друзьями.",
                                "zh": "她想和朋友一起<w>逃课</w>后，老师给她父母打了电话。"
                            }
                        },
                        {
                            "text": "He used to <w>ditch</w> school to go to the arcade, but he eventually got caught.",
                            "target_lang_translations": {
                                "ru": "Раньше он <w>прогуливал</w> школу, чтобы ходить в зал игровых автоматов, но в конце концов попался.",
                                "zh": "他以前常常<w>逃学</w>去游戏厅，不过最后还是被发现了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "attend"
                    ],
                    "common_phrases": [
                        "ditch school",
                        "ditch class"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пропускать занятия в школе или учебном заведении без разрешения.",
                        "zh": "未经允许而不去上学或不上某节课。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогуливать",
                                "target_lang_sense_clarification": "пропускать уроки"
                            },
                            {
                                "target_lang_word": "сбежать",
                                "target_lang_sense_clarification": "уйти с урока"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逃课",
                                "target_lang_sense_clarification": "不经允许不上课"
                            },
                            {
                                "target_lang_word": "翘课",
                                "target_lang_sense_clarification": "口语，指故意不去上课"
                            },
                            {
                                "target_lang_word": "逃学",
                                "target_lang_sense_clarification": "指不去学校"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1fd3785-1a57-32e8-879c-4491dc165091",
                    "sense_definition": "To make a forced landing of an aircraft on water.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "crash_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the engines failed, the pilot had no choice but to <w>ditch</w> in the ocean.",
                            "target_lang_translations": {
                                "ru": "Когда двигатели отказали, у пилота не было выбора, кроме как <w>приводниться</w> в океане.",
                                "zh": "发动机失灵时，飞行员别无选择，只能在海上<w>迫降</w>。"
                            }
                        },
                        {
                            "text": "The crew was trained on how to safely <w>ditch</w> the aircraft in case of an emergency over water.",
                            "target_lang_translations": {
                                "ru": "Экипаж был обучен тому, как безопасно <w>посадить</w> самолет <w>на воду</w> в случае чрезвычайной ситуации.",
                                "zh": "机组人员接受过训练，学习在水上发生紧急情况时如何让飞机安全<w>迫降</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "forced to ditch",
                        "ditch in the sea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершить вынужденную посадку самолета на воду.",
                        "zh": "指飞机在水面上进行紧急迫降。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приводниться",
                                "target_lang_sense_clarification": "сесть на воду"
                            },
                            {
                                "target_lang_word": "сажать на воду",
                                "target_lang_sense_clarification": "о пилоте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迫降",
                                "target_lang_sense_clarification": "指飞机在水面上进行紧急降落"
                            },
                            {
                                "target_lang_word": "水上迫降",
                                "target_lang_sense_clarification": "较明确说法，强调降在水面"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f133d153-e37d-354b-bea8-267aa2646a5a",
                    "sense_definition": "A nickname for the city of Calcutta (Kolkata).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "calcutta_name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Old sailors sometimes referred to the busy port city as the <w>Ditch</w>.",
                            "target_lang_translations": {
                                "ru": "Старые моряки иногда называли этот оживленный портовый город «<w>Канавой</w>».",
                                "zh": "老水手有时把这座繁忙的港口城市称作<w>迪奇</w>。"
                            }
                        },
                        {
                            "text": "Stories from the colonial era often mention life in the <w>Ditch</w>.",
                            "target_lang_translations": {
                                "ru": "Истории колониальной эпохи часто упоминают жизнь в «<w>Канаве</w>».",
                                "zh": "殖民时期的故事里常常提到在<w>迪奇</w>的生活。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шутливое прозвище города Калькутта (Колката).",
                        "zh": "加尔各答（今称加尔各答/ Kolkata）的一个旧时绰号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Канава",
                                "target_lang_sense_clarification": "прозвище"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迪奇",
                                "target_lang_sense_clarification": "加尔各答的旧绰号，带口语和旧时色彩"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}