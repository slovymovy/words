                                "target_senses": [
                                    {
                                        "sense_id": "cd84b8e6-bda4-34f0-ade9-fea0326ed3df",
                                        "entry_id": "0b3a56fa-333c-3319-9cd1-7aaa1ff91f19",
                                        "glosses": [
                                            "Not specifically religious; lay or civil, as opposed to clerical; profane."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3e09dfd-8d98-30bd-8953-4c4f1a2a9fe9",
                                        "entry_id": "0b3a56fa-333c-3319-9cd1-7aaa1ff91f19",
                                        "glosses": [
                                            "Temporal; worldly, or otherwise not based on something timeless."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b56b1727-7836-34b1-98eb-cc8561ebc460",
                                        "entry_id": "0b3a56fa-333c-3319-9cd1-7aaa1ff91f19",
                                        "glosses": [
                                            "Not bound by the vows of a monastic order."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e7bcb41-bb17-4cad-87b2-468081129a27",
                                                "sense_id": "b56b1727-7836-34b1-98eb-cc8561ebc460",
                                                "text": "secular clergy in Catholicism"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c599b57f-0acc-36b2-b50f-1892778b10f7",
                                        "entry_id": "0b3a56fa-333c-3319-9cd1-7aaa1ff91f19",
                                        "glosses": [
                                            "Happening once in an age or century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c4bb54f-45d4-4449-9c12-66a81422daa5",
                                                "sense_id": "c599b57f-0acc-36b2-b50f-1892778b10f7",
                                                "text": "The secular games of ancient Rome were held to mark the end of a saeculum and the beginning of the next."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "749c0f26-398d-3791-951b-040c8c3446fb",
                                        "entry_id": "0b3a56fa-333c-3319-9cd1-7aaa1ff91f19",
                                        "glosses": [
                                            "Continuing over a long period of time, long-term."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95e10bbe-8230-42d1-af38-5f1832e22e6a",
                                                "sense_id": "749c0f26-398d-3791-951b-040c8c3446fb",
                                                "text": "The long-term growth in population and income accounts for most secular trends in economic phenomena."
                                            },
                                            {
                                                "example_id": "0fc8764e-fca1-4bb9-ab21-5d9b4bbb7ec3",
                                                "sense_id": "749c0f26-398d-3791-951b-040c8c3446fb",
                                                "text": "on a secular basis"
                                            },
                                            {
                                                "example_id": "d3ed911b-c732-4b41-9679-08a5ff1f3d60",
                                                "sense_id": "749c0f26-398d-3791-951b-040c8c3446fb",
                                                "text": "In this event, the s#92;phi(k) curve in Fig. 15.5 will be subject to a secular upward shift, resulting in successively higher intersections with the #92;lambdak ray and also in larger values of #92;bark."
                                            },
                                            {
                                                "example_id": "97fc48f9-1ded-400f-9dcd-bf444df3b117",
                                                "sense_id": "749c0f26-398d-3791-951b-040c8c3446fb",
                                                "text": "The skewed distribution of productivity gains is thus less a new phenomenon than a secular trend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffea76bb-af6b-3beb-974c-5aaee1834704",
                                        "entry_id": "0b3a56fa-333c-3319-9cd1-7aaa1ff91f19",
                                        "glosses": [
                                            "Centuries-old, ancient."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb7cb10e-9243-4b90-8227-9dece6425286",
                                                "sense_id": "ffea76bb-af6b-3beb-974c-5aaee1834704",
                                                "text": "The long reaches that were like one and the same reach, monotonous bends that were exactly alike, slipped past the steamer with their multitude of secular trees looking patiently after this grimy fragment of another world, the forerunner of change, of conquest, of trade, of massacres, of blessings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91aefbc9-197a-364d-92c3-2873ceaa8058",
                                        "entry_id": "0b3a56fa-333c-3319-9cd1-7aaa1ff91f19",
                                        "glosses": [
                                            "Relating to long-term non-periodic irregularities, especially in planetary motion or magnetic field."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98d2e9e2-4de6-4d4f-9486-318743ac4807",
                                                "sense_id": "91aefbc9-197a-364d-92c3-2873ceaa8058",
                                                "text": "Laplace (1749–1827) \"saved the world\" by using probability theory to estimate the parameters accurately enough to show that the drift of Jupiter was not secular after all; the observations at hand had covered only a fraction of a cycle of an oscillation with a period of about 880 years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eca3a02-af62-36c4-942d-ad14fbd8d086",
                                        "entry_id": "0b3a56fa-333c-3319-9cd1-7aaa1ff91f19",
                                        "glosses": [
                                            "Unperturbed over time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "352c371e-35fc-4e06-a210-4bcedf845d7d",
                                                "sense_id": "9eca3a02-af62-36c4-942d-ad14fbd8d086",
                                                "text": "The secular A and nonsecular B parts of hyperfine interaction for any particular frequencies ν_α and ν_β are derived from eqn.(21) by ..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "secular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dca03e9c-dd8d-3255-a757-b7ad2d1db43a",
                                        "entry_id": "6bf98be8-7563-3a97-adf9-11f2a01840e8",
                                        "glosses": [
                                            "A secular ecclesiastic, or one not bound by monastic rules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb2cd648-8f82-439f-8aff-33ba3d51a8dd",
                                                "sense_id": "dca03e9c-dd8d-3255-a757-b7ad2d1db43a",
                                                "text": "On further examination, I found the clergy, in general, persons of moderate minds and decorous manners : I include the seculars, and the regulars of both sexes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae2f8768-83f5-3d81-a739-e95095941666",
                                        "entry_id": "6bf98be8-7563-3a97-adf9-11f2a01840e8",
                                        "glosses": [
                                            "A church official whose functions are confined to the vocal department of the choir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee4ab3e3-3faf-3af7-b496-eebb76f12047",
                                        "entry_id": "6bf98be8-7563-3a97-adf9-11f2a01840e8",
                                        "glosses": [
                                            "A layman, as distinguished from a clergyman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
