                                        "sense_id": "7433905d-e377-3592-8ce0-53cc4c11683a",
                                        "entry_id": "1c3b0e65-497d-3c3b-9045-4b53f8d2bdc3",
                                        "glosses": [
                                            "A backset; a countercurrent; an eddy."
