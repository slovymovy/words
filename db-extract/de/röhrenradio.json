                "senses": [
                    {
                        "sense_id": "2f8bdc68-1227-3ecf-9226-6f1284dd8af9",
                        "entry_id": "77185149-a15d-3413-8c65-2803d051aee1",
                        "glosses": [
                            "Radiogerät, das mit Elektronenröhren aufgebaut ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74c1ce2e-ed97-4f8f-9e14-a4b90f189fec",
                                "sense_id": "2f8bdc68-1227-3ecf-9226-6f1284dd8af9",
                                "text": "„Ende der 1920er Jahre wurden dank neuer Fertigungsmethoden besonders Röhrenradios deutlich preiswerter angeboten.“"
                            },
                            {
                                "example_id": "53eb4791-d800-4feb-a89d-683f89c0b48b",
                                "sense_id": "2f8bdc68-1227-3ecf-9226-6f1284dd8af9",
                                "text": "„In den späten 1950er und frühen 1960er Jahren scharten sich bayerische Familien ums Röhrenradio, Fernsehgeräte hatten damals die wenigsten.“"
                            },
                            {
                                "example_id": "7e6c1146-5d8f-4c0b-a681-ed31be2281fc",
                                "sense_id": "2f8bdc68-1227-3ecf-9226-6f1284dd8af9",
                                "text": "„Ein wenig Geduld musste man beim Hören allerdings haben: So ein Röhrenradio brauchte gut und gerne fünf Minuten, bis es warmgelaufen war.“"
                            },
                            {
                                "example_id": "25a8fcf5-1bd4-40ea-ac2c-710a3c824ddc",
                                "sense_id": "2f8bdc68-1227-3ecf-9226-6f1284dd8af9",
                                "text": "„Das grüne „magische Auge“ zeigte beim Röhrenradio die Empfangsqualität an.“"
                            },
                            {
                                "example_id": "aa5bce26-cab7-4039-83d7-e61691e5dce8",
                                "sense_id": "2f8bdc68-1227-3ecf-9226-6f1284dd8af9",
                                "text": "„»Ein kleines Röhrenradio brauchte ungefähr fünf Minuten, bis der Sender warmgelaufen war. Und dann musste man drehen. Magisches Auge kam dann - je größer die grüne Fläche war, desto genauer war der Sender eingestellt«, so die Erinnerung eines damaligen Hörers.“"
                            },
                            {
                                "example_id": "527f3fbf-48fe-46bf-98ec-36628aaeb2fa",
                                "sense_id": "2f8bdc68-1227-3ecf-9226-6f1284dd8af9",
                                "text": "„Hinter der Bühne befindet sich ein Regal mit über vierzig alten Röhrenradios, Gerätschaften, aus denen sich übrigens mit etwas Fingerspitzengefühl Verstärker bauen lassen.“"
                            },
                            {
                                "example_id": "622480a5-5376-4591-b9e0-d45de6b4293c",
                                "sense_id": "2f8bdc68-1227-3ecf-9226-6f1284dd8af9",
                                "text": "„Gerd Wolf zeigt jedes Zimmer in seinem Haus. Stolz ist er auf seine Sammlung alter Röhrenradios, die im Arbeitsraum steht.“"
                            },
                            {
                                "example_id": "a8f7c642-54ca-42ee-a2fe-f85ca326fd13",
                                "sense_id": "2f8bdc68-1227-3ecf-9226-6f1284dd8af9",
                                "text": "„Der Gesang ist immer leicht angezerrt - so als käme er aus einem alten Röhrenradio, das man irgendwo auf einem Speicher gefunden hat.“"
                            },
                            {
                                "example_id": "9543d1a7-1c95-4cf4-808a-4a734dc5e5bf",
                                "sense_id": "2f8bdc68-1227-3ecf-9226-6f1284dd8af9",
                                "text": "„Das Heinzelmann-Radio war ein von Hans Eckstein im Auftrag von Max Grundig entwickelter und ab 1946 in Deutschland vertriebener Bausatz für ein Röhrenradio zum Zusammenbau durch den Käufer. Der Bausatz schuf den Grundstein für den Erfolg des Unternehmens Grundig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
