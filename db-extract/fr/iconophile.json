                        "glosses": [
                            "Qui aime les images, qui adore les icônes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6c9b4ec-d4bf-4c87-91d1-6aa42dddceb7",
                                "sense_id": "745c30b8-d256-384b-957e-c3da1652ae21",
                                "text": "Officiellement, le camp iconophile l'a emporté, et l'Église célèbre en l'image un « livre des illettrés » (liber idiotarum, selon une métaphore due à Saint Grégoire) investi de trois fonctions: didactique, mnémonique et dévotionnelle, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "555843dd-5f1c-3044-9a78-c4d75f6e5281",
                        "entry_id": "71df0bad-77fa-3a2a-b123-90ff4bfe9cb0",
                        "glosses": [
                            "Qui se connaît en fait d’estampes."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
