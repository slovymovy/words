                "senses": [
                    {
                        "sense_id": "bc506907-f9f9-37de-832b-4c5e637cf16c",
                        "entry_id": "ec30e89b-e92e-3dcf-8f93-6828aafe59e7",
                        "glosses": [
                            "Relatif aux Titans ; qui est démesuré, gigantesque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c975cd48-73b6-4521-80ff-cd9e0867c546",
                                "sense_id": "bc506907-f9f9-37de-832b-4c5e637cf16c",
                                "text": "Un orgueil titanique."
                            },
                            {
                                "example_id": "950504a6-4dba-41e7-a4d3-be214ea1e02c",
                                "sense_id": "bc506907-f9f9-37de-832b-4c5e637cf16c",
                                "text": "Figurez-vous une soutane noire, le manteau de même couleur, et pour couronner le tout, un immense, un prodigieux, un phénoménal, un hyperbolique et titanique chapeau, dont aucune épithète, pour boursouflée et gigantesque qu’elle soit, ne peut donner même une légère idée approximative."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff02f961-c9b1-320f-903c-699f19dd9ec2",
                        "entry_id": "ec30e89b-e92e-3dcf-8f93-6828aafe59e7",
                        "glosses": [
                            "Désigne les composés tétravalents du titane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f596caae-b51b-4d8a-8b57-c47a282274c4",
                                "sense_id": "ff02f961-c9b1-320f-903c-699f19dd9ec2",
                                "text": "Après élimination du sulfate de fer par filtration, on ajoute de l’eau, et le sulfate de titane se transforme en acide titanique (H₂TiO₃)."
                            }
                        ]
                    }
                ],
