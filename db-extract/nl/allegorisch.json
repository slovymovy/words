                "senses": [
                    {
                        "sense_id": "ab9096bd-fe1a-343a-b574-bcf3cd091c6d",
                        "entry_id": "75a1baf0-3be7-3082-b75b-7509ae2c30fd",
                        "glosses": [
                            "betrekking hebbend op het uitbeelden van een abstract begrip"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91f83975-aa9e-4b3b-982c-58b5d8852e66",
                                "sense_id": "ab9096bd-fe1a-343a-b574-bcf3cd091c6d",
                                "text": "Dat een allegorische optocht een bonte boel is heeft Borculo deze zaterdag weer bewezen. De fabeltjeskrant, een wagen vol Jamaicanen, smurfen, bakkers, brandweerwagens, gewone auto’s en de mooiste bloemstukken trekken aan het grote, enthousiaste publiek voorbij."
                            },
                            {
                                "example_id": "a0d72eb7-fc06-4971-be25-f7dda5b82f19",
                                "sense_id": "ab9096bd-fe1a-343a-b574-bcf3cd091c6d",
                                "text": "Op de ramen staan zijn glazen bevatten niet alleen bijbelse, maar ook allegorische onderwerpen en gebeurtenissen uit de vaderlandse geschiedenis."
                            },
                            {
                                "example_id": "6a159bff-a337-4c63-867f-cf3311e2813b",
                                "sense_id": "ab9096bd-fe1a-343a-b574-bcf3cd091c6d",
                                "text": "Na The return (2003), The banishment (2007) en Elena (2011) is ook Zvjagintsevs vierde film een allegorische aanklacht tegen het Rusland van nu."
                            },
                            {
                                "example_id": "4d816be5-adfb-4275-a5b6-73164b42d689",
                                "sense_id": "ab9096bd-fe1a-343a-b574-bcf3cd091c6d",
                                "text": "Ik begin niet over dit allegorische snippertje uit Huize Sugar omdat ik denk dat jullie persoonlijke en gezamenlijke strijd wat jullie vriendschap betreft net zo infantiel is als het gekift om een speeltje, maar omdat ik denk dat het instructief is om in essentiële termen na te denken over ons verlangen niet alleen te bezitten wat van ons is, maar ook wat van onze dierbaren is, en niet alleen omdat we die dingen voor onszelf willen, maar ook omdat we niet willen dat die ander ze heeft."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8da587d1-a52a-4b3a-bbbf-9a673ae22a00",
                        "source_entry_id": "75a1baf0-3be7-3082-b75b-7509ae2c30fd",
