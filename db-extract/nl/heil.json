                "senses": [
                    {
                        "sense_id": "cb9cba25-3a3a-335f-9e31-4beb215bdb13",
                        "entry_id": "850f97ae-3540-370f-8207-a959f1e1a017",
                        "glosses": [
                            "welzijn, voorspoed, redding, verlossing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "528e913a-1dab-47f1-9e6d-d5cbeb6df460",
                                "sense_id": "cb9cba25-3a3a-335f-9e31-4beb215bdb13",
                                "text": "Veel heil en zegen! (nieuwjaarswens)"
                            },
                            {
                                "example_id": "7d1eb91e-d2df-4bb0-a5bf-46875d334789",
                                "sense_id": "cb9cba25-3a3a-335f-9e31-4beb215bdb13",
                                "text": "Ze moesten ten eerste wat meer op de uitgaven gaan letten, ten tweede had het geen enkele zin dat hij als oude man alleen aan de ene kant van de Kâllvâgen in een groot en comfortabel huis zat terwijl zijn bijna even oude broer zijn heil moest zoeken in het Grand Hotel vijf minuten verderop? Zo waren ze dat overeengekomen."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa56f9f5-851f-3f56-addf-1246b1b6730f",
                        "entry_id": "850f97ae-3540-370f-8207-a959f1e1a017",
                        "glosses": [
                            "voordeel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9c86914-4773-40bf-a75d-26e6cb138743",
                                "sense_id": "aa56f9f5-851f-3f56-addf-1246b1b6730f",
                                "text": "Ik zie daar geen heil in."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc8e820b-ba06-4d49-82f1-59a2220b5913",
                        "source_entry_id": "850f97ae-3540-370f-8207-a959f1e1a017",
                        "source_sense_id": "cb9cba25-3a3a-335f-9e31-4beb215bdb13",
                        "source_sense_description": "voordeel",
                        "target_lang_word": "Segen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Segen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5510425f-7a77-35e0-a703-cbc001899cb0",
                                        "entry_id": "6e78108b-c42e-3014-bda0-e4b00d4e3924",
                                        "glosses": [
                                            "rituell geäußerter Wunsch um Gottes Gnade/Beistand für jemanden oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3dd3ea8-a0c8-4818-9312-1030d8a67d97",
                                                "sense_id": "5510425f-7a77-35e0-a703-cbc001899cb0",
                                                "text": "Vielen Katholiken ist der Segen des Papstes sehr wichtig."
                                            },
                                            {
                                                "example_id": "1205503f-83c7-4974-9574-ecf674d0e1b3",
                                                "sense_id": "5510425f-7a77-35e0-a703-cbc001899cb0",
                                                "text": "„Sie aber murmelte lächelnd ihre Wünsche für zehntausendfachen Segen und ließ sich dann seitlich an einem kleinen Tische nieder.“"
                                            },
                                            {
                                                "example_id": "ba99ce1a-4213-4265-a34e-d7f469306160",
                                                "sense_id": "5510425f-7a77-35e0-a703-cbc001899cb0",
                                                "text": "„Nach dem Segen aber habe ich dem lieben Gott noch für die wunderschöne Moselreise mit Papa gedankt, und ich habe dem lieben Gott versprochen, mit Hilfe all meiner Zettel, Karten und all meines Krimskrams ein ausführliches Reisetagebuch zu schreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3193ea3f-da3b-3061-b861-7889b3be4ea4",
                                        "entry_id": "6e78108b-c42e-3014-bda0-e4b00d4e3924",
                                        "glosses": [
                                            "Äußerung des Einverständnisses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a22e81d2-4b26-4ffb-a1f9-f2928ab17aea",
                                                "sense_id": "3193ea3f-da3b-3061-b861-7889b3be4ea4",
                                                "text": "Nach langen Auseinandersetzungen gaben meine Eltern mir endlich ihren Segen für meine Pläne."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bbec3630-8db0-3e2b-9d76-f0579e32e1aa",
                                        "entry_id": "6e78108b-c42e-3014-bda0-e4b00d4e3924",
                                        "glosses": [
                                            "Zustand des Glücks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40228a3c-5a78-4a7c-bdca-d42fb2f4f99f",
                                                "sense_id": "bbec3630-8db0-3e2b-9d76-f0579e32e1aa",
                                                "text": "Der Gewinn war ein Segen für uns, da damit alle Schulden getilgt werden konnten."
                                            },
                                            {
                                                "example_id": "1fb72d75-5ede-4464-afd5-c0d3c64ade74",
                                                "sense_id": "bbec3630-8db0-3e2b-9d76-f0579e32e1aa",
                                                "text": "„[…] dass mehr Menschen als früher über grundlegende naturwissenschaftliche Fakten unterrichtet sind, ist ein Segen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
