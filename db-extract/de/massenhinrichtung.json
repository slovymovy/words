                        "examples": [
                            {
                                "example_id": "48b095ea-79a4-4636-af67-1427568fd68f",
                                "sense_id": "5e0f84fc-43db-3de7-9cc9-147aee903a20",
                                "text": "„Der Iran hat die Massenhinrichtung von 20 Männern an einem Tag gegen internationale Kritik verteidigt.“"
                            },
                            {
                                "example_id": "2e7bc0bf-284c-47f9-bcf8-69f3a992a851",
                                "sense_id": "5e0f84fc-43db-3de7-9cc9-147aee903a20",
                                "text": "„Die Massenhinrichtungen von Schiiten in Gilgit-Baltistan und Belutschistan 2012 riefen bei weitem nicht so eine öffentliche Empörung hervor wie die US-Drohnenangriffe und die damit verbundenen Opferzahlen in den FATA.“"
                            },
                            {
                                "example_id": "b704bb04-cc85-428c-9229-5e104f511774",
                                "sense_id": "5e0f84fc-43db-3de7-9cc9-147aee903a20",
                                "text": "„Abu Jamil erinnerte sich, dass 125 Menschen bei Massenhinrichtungen getötet wurden.“"
                            }
                        ],
