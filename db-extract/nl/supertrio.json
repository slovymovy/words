                        "examples": [
                            {
                                "example_id": "0a7a3b65-c25a-4280-91e1-bbd6d92f36dc",
                                "sense_id": "a0b087cb-a79e-32e5-9ec5-844d6c9259fa",
                                "text": "Een coureur die in Monaco zegeviert, schiet meteen de autosportboeken in en verandert in een coureur van naam. Monaco hoort bij de 'grote drie': de 24 Uur van Le Mans, de 500 mijl van Indianapolis en de GP van Monaco vormen het supertrio van de autosport."
                            },
                            {
                                "example_id": "70251a14-159a-4b2f-ad04-24780f288af0",
                                "sense_id": "a0b087cb-a79e-32e5-9ec5-844d6c9259fa",
                                "text": "Het supertrio Messi-Neymar-Suárez heeft nu dit seizoen 102 keer gescoord (alle competities). Dat is twee doelpunten meer dan het oude Barça-record van Messi, Thierry Henry en Samuel Eto'o in het seizoen 2008/2009. In het seizoen 2011/2012 maakten Cristiano Ronaldo, Karim Benzema en Gonzalo Higuaín met z'n drieën 118 treffers voor Real Madrid."
                            }
                        ]
                    }
