                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "The windings of a river; the land along a winding stream."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e0f782b-3482-4b39-8033-04728fed7f0f",
                                                "sense_id": "e36eb72d-0163-3d86-ad25-aede2924d7e7",
                                                "text": "'Dame Foljambe,' said the old man, 'the march of thy tale is like the course of the Wye, seventeen miles of links and windings down a fair valley five miles long. […]'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adc4ffda-74ba-3c9b-94d0-0dcd9c2b9cf7",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "An introductory cue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "084a6a24-17a9-4bc1-afc4-c8dadc511aa5",
                                                "sense_id": "adc4ffda-74ba-3c9b-94d0-0dcd9c2b9cf7",
                                                "text": "Too much talk on a music-based station can cause listeners who tune in for the music to go elsewhere. […] 'Some people will say “your link has to be 45 seconds long” but I don't do that,' explains the programme controller of Trent FM, Dick Stone."
                                            }
                                        ]
                                    }
                                ]
                            },
