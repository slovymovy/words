                                            "South German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17ea7a31-55a6-4bfa-9d8e-3563f41602fb",
                                                "sense_id": "793873a1-db18-3d46-8969-180f153cee30",
                                                "text": "Ich bin auf der Staffel ausgerutscht."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "f3a7d7c7-ee67-30c8-a19e-6728d69ca7d2",
                                        "entry_id": "042cfcde-5f1e-3c8f-af28-95a5daabc272",
                                        "glosses": [
                                            "Formation bei einem Fahrverband"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "856295a5-1a44-42f0-a567-aae0677be168",
                                                "sense_id": "f3a7d7c7-ee67-30c8-a19e-6728d69ca7d2",
                                                "text": "Der Präsident wurde von einer Staffel der Polizei begleitet."
                                            },
                                            {
                                                "example_id": "6fd75e59-cf56-48d2-ac1b-d4a5004e1714",
                                                "sense_id": "f3a7d7c7-ee67-30c8-a19e-6728d69ca7d2",
                                                "text": "„Neulich allerdings hatte die Staffel eine Maschine verloren, weiß der Teufel, wo sie abgeblieben war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "a89cccec-580c-3115-9df2-84765d4d510d",
                                        "entry_id": "042cfcde-5f1e-3c8f-af28-95a5daabc272",
                                        "glosses": [
                                            "Stufe, Schwelle"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Staffel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54545d65-5d9b-3936-86fa-8e273faba695",
                                        "entry_id": "e40e7ff4-519f-3996-86df-cd304652f59f",
                                        "glosses": [
                                            "Türschwelle"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "316f2660-78b2-41f2-bf2e-cd9ef69a6e94",
                                                "sense_id": "54545d65-5d9b-3936-86fa-8e273faba695",
                                                "text": "Fall nicht über den Staffel!"
                                            },
                                            {
                                                "example_id": "4dd41d16-946f-4f0b-ab82-e20ce7c2765f",
                                                "sense_id": "54545d65-5d9b-3936-86fa-8e273faba695",
                                                "text": "„Manchmal lässt sich der Spalt vergrößern indem man den Staffel abschraubt oder die Türe mit einem Türheber oder mit einem aufblasbaren Luftkissen angehoben wird.“"
                                            },
                                            {
                                                "example_id": "0819c6a2-03e5-48f4-9d20-ee7aeb7b7e22",
                                                "sense_id": "54545d65-5d9b-3936-86fa-8e273faba695",
                                                "text": "„Tausende Kakerlaken machten sich nun auf den Weg in die Freiheit über den Staffel.“"
                                            },
                                            {
                                                "example_id": "c040513e-e44c-4fd3-a296-62e99d76ff79",
                                                "sense_id": "54545d65-5d9b-3936-86fa-8e273faba695",
                                                "text": "„Die Rinnen verlaufen gegen den Staffel zu leicht schräg nach unten und sind auffallend lang - länger als die lichte Weite des Portals bzw. der Mauerstärke (= Türnische).“"
                                            },
                                            {
                                                "example_id": "05896110-4c01-4e66-bd2b-db8c07a6a835",
                                                "sense_id": "54545d65-5d9b-3936-86fa-8e273faba695",
                                                "text": "„Halte die brennende Kerze zuerst hoch oben, nahe am Türstock; die Flamme schlägt hinaus. Unten am Staffel schlägt sie herein und in der Mitte brennt sie senkrecht.“"
                                            },
                                            {
                                                "example_id": "99622adb-86ba-4482-8ac7-bb10cce84035",
                                                "sense_id": "54545d65-5d9b-3936-86fa-8e273faba695",
                                                "text": "„Auf dem barrierefreien Zugangsweg sollen Spalten, Stufen und Staffeln vermieden werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
