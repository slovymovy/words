                    {
                        "sense_id": "e9d5f079-4995-3b9f-9e4c-71cb120a6132",
                        "entry_id": "10995fcd-0bbc-3da1-8f52-de2093252e40",
                        "glosses": [
                            "Beruf in der Textilproduktion: Person, die Stoffe walkt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71225b9b-c9e3-4597-b89c-574d3086e3ed",
                                "sense_id": "e9d5f079-4995-3b9f-9e4c-71cb120a6132",
                                "text": "Der Walker knetet und stampft das raue Wollgewebe unter Einwirkung von Feuchtigkeit, Seife und Soda in der Kurbel- oder Walzenwalke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6ef3f8f4-9157-3b09-b7fa-83127c64d3b0",
                        "entry_id": "10995fcd-0bbc-3da1-8f52-de2093252e40",
                        "glosses": [
                            "Nudelwalker, ein zylindrischer Gegenstand zum Walken (Flachdrücken und Ausbreiten) von Teigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc315e19-f1ab-4394-9fcf-bbd95b778dc2",
                                "sense_id": "6ef3f8f4-9157-3b09-b7fa-83127c64d3b0",
                                "text": "Walker wurden bis in die siebziger Jahre des zwanzigsten Jahrhunderts ausschließlich aus Laubholz gefertigt und hauptsächlich zum Flachdrücken von Teigen verwendet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "51d60133-74c7-379d-a537-19fcdeb546ff",
                        "entry_id": "10995fcd-0bbc-3da1-8f52-de2093252e40",
                        "glosses": [
                            "Lodenjoppe, Walkjanker, eine Art Jacke aus Filz (ursprünglich Hasenfilz)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc02885d-2e4a-482a-af7d-b0cb17390c62",
                                "sense_id": "51d60133-74c7-379d-a537-19fcdeb546ff",
                                "text": "Reich mir bitte den Walker, mir ist so kalt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "b3357592-45ee-391e-a247-bb94c783d5a2",
