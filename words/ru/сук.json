                {
                    "sense_id": "ce2d299a-9a2a-35ee-9deb-208fa07221a0",
                    "sense_definition": "Крупный, обычно толстый отросток, идущий от ствола дерева.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wood_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мальчик залез на дерево и сел на толстый <w>сук</w>.",
                            "target_lang_translations": {
                                "en": "The boy climbed the tree and sat on a thick <w>branch</w>.",
                                "fr": "Le garçon est monté sur l'arbre et s'est assis sur une grosse <w>branche</w>."
                            }
                        },
                        {
                            "text": "Сухой <сук> громко треснул под моей ногой.",
                            "target_lang_translations": {
                                "en": "A dry <limb> cracked loudly under my foot.",
                                "fr": "Une <w>branche</w> sèche a bruyamment craqué sous mon pied."
                            }
                        }
                    ],
                    "synonyms": [
                        "ветка"
                    ],
                    "common_phrases": [
                        "рубить сук",
                        "сидеть на суку",
                        "сухой сук"
                    ],
                    "target_lang_definitions": {
                        "en": "A large, usually thick outgrowth coming from the tree trunk.",
                        "fr": "Grande excroissance, généralement épaisse, partant du tronc d'un arbre."
