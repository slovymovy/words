                    }
                ],
                "senses": [
                    {
                        "sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
                        "entry_id": "cb9753f3-f0f7-36b3-bd26-437effac1726",
                        "glosses": [
                            "von Balletttänzerinnen getragener kurzer Rock, meist aus Tüll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b4f26d2-5e87-4cc8-a06e-e5b1812cd684",
                                "sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
                                "text": "Das Tutu ist das Standardkostüm einer klassischen Ballerina"
                            },
                            {
                                "example_id": "71bd91cd-bbb7-41ca-bfb4-3f4987bcaa7e",
                                "sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
                                "text": "Ein Tutu ist am weit abstehenden Rock deutlich erkennbar."
                            },
                            {
                                "example_id": "916c6a7b-808a-456b-ba8e-76a061983aa5",
                                "sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
                                "text": "Das Tragen eines Tutus war zu Anfangszeiten noch höchst umstritten."
                            },
                            {
                                "example_id": "cc7bc57f-8003-4843-99c0-954479833a32",
                                "sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
                                "text": "„Tante Mary hatte ein Tutu, ein Ballettröckchen, weil sie früher Ballett getanzt hatte.“"
                            },
                            {
                                "example_id": "da31d84e-2fb2-44a3-ae21-f4679472fdf6",
                                "sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
                                "text": "„Der rosafarbene Stoff spannt jetzt schon am Bauch, das Tutu steht im Neunzig-Grad-Winkel von ihrem kleinen runden Körper ab.“"
                            },
                            {
                                "example_id": "863b3b46-06f6-4300-b29b-ea432145cbf3",
                                "sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
                                "text": "„Helen schien jedenfalls auf ein Leben voller Leidenschaft zuzusteuern; sie und eine Freundin nahmen Ballettunterricht, und wenn Roth nachmittags von der Universität nach Hause kam, führten die beiden Mädchen ihm im Wohnzimmer ihre Tanzschritte vor, was gewöhnlich damit endete, dass Helen im Trikot und Tutu auf seinem Schoß landete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69f89efd-99e2-4a2d-9a6e-307d4091b053",
                        "source_entry_id": "cb9753f3-f0f7-36b3-bd26-437effac1726",
                        "source_sense_id": "0bb2c0ea-5bb0-385f-9997-fe67b0e96301",
