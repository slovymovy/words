                "senses": [
                    {
                        "sense_id": "cbf250c9-66ed-3cd0-b9ab-4f386cc1c07c",
                        "entry_id": "8a2aea3f-7df6-3476-a4a9-fc6c8ce055c1",
                        "glosses": [
                            "Sammelbezeichnung für die im Zwischenwirt (auch dem Menschen) nach Eiaufnahme durch Larven oder Finnen (ungeschlechtliche Zwischenstadien) von Bandwürmern erzeugte Krankheiten"
                        ],
                        "tags": [
                            "Veterinärmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "53ee7332-cfd7-4555-8c9a-8d79463616a4",
                                "sense_id": "cbf250c9-66ed-3cd0-b9ab-4f386cc1c07c",
                                "text": "„Bei dem Verkaufe von Schweinen muß für die Finnenkrankheit und auch für Trichinen Gewähr geleistet werden (§ 176).“"
                            },
                            {
                                "example_id": "9e19b5d4-1a2b-4772-a928-3ee67ab8569c",
                                "sense_id": "cbf250c9-66ed-3cd0-b9ab-4f386cc1c07c",
                                "text": "„Wird das Fleisch eines mit der Finnenkrankheit befallenen Tieres nicht ordentlich gekocht, oder zuvor für längere Zeit eingefroren, wird die Person, die dieses Fleisch isst von Bandwürmern befallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
