                                                "sense_id": "e0136bfe-8fcc-30aa-9110-5e8cef2f1af2",
                                                "text": "L’okapi se reconnaît à ses pattes rayées comme un zèbre et à son allure de girafe sans tache et au petit cou."
                                            }
                                        ]
                                    }
                                ]
                            }
