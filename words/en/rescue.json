{
    "word_family": [
        "rescuer",
        "rescuable",
        "unrescued"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f5536b8-951e-34db-9666-b85c4e69a92b",
                    "sense_definition": "To save someone or something from violence, danger, or evil.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "save_danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The firefighters managed to <w>rescue</w> the family from the burning building.",
                            "target_lang_translations": {
                                "ru": "Пожарным удалось <w>спасти</w> семью из горящего здания.",
                                "tr": "İtfaiyeciler aileyi yanan binadan <w>kurtarmayı</w> başardı."
                            }
                        },
                        {
                            "text": "He jumped into the river to <w>rescue</w> the drowning child.",
                            "target_lang_translations": {
                                "ru": "Он прыгнул в реку, чтобы <w>спасти</w> тонущего ребёнка.",
                                "tr": "Boğulmakta olan çocuğu <w>kurtarmak</w> için nehre atladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "save",
                        "free",
                        "liberate"
                    ],
                    "antonyms": [
                        "endanger",
                        "imperil"
                    ],
                    "common_phrases": [
                        "rescue from",
                        "come to rescue",
                        "rescue team"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спасти кого-то или что-то от насилия, опасности или зла.",
                        "tr": "Birini veya bir şeyi şiddet, tehlike veya kötülükten kurtarmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спасти",
                                "target_lang_sense_clarification": "уберечь от опасности"
                            },
                            {
                                "target_lang_word": "выручить",
                                "target_lang_sense_clarification": "помочь в беде"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kurtarmak",
                                "target_lang_sense_clarification": "tehlikeden veya tehlikeli durumdan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6225b5ec-f7dc-3327-9ef4-764079f8ffbb",
                    "sense_definition": "To adopt an animal, often from a shelter or bad living conditions.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adopt_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>rescue</w> a dog from the local shelter instead of buying one.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>взять</w> собаку из местного приюта, вместо того чтобы покупать.",
                                "tr": "Satın almak yerine yerel barınaktan bir köpek <w>sahiplenmeye</w> karar verdik."
                            }
                        },
                        {
                            "text": "She has <w>rescued</w> three cats and gave them a loving home.",
                            "target_lang_translations": {
                                "ru": "Она <w>спасла</w> трёх кошек и дала им любящий дом.",
                                "tr": "Üç kedi <w>kurtardı</w> ve onlara sevgi dolu bir yuva verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "save",
                        "adopt"
                    ],
                    "common_phrases": [
                        "rescue a dog",
                        "rescue a cat",
                        "rescue a pet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взять животное, часто из приюта или плохих условий содержания.",
                        "tr": "Genellikle bir barınaktan veya kötü yaşam koşullarından bir hayvanı sahiplenmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спасти",
                                "target_lang_sense_clarification": "животное от гибели"
                            },
                            {
                                "target_lang_word": "приютить",
                                "target_lang_sense_clarification": "дать дом"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kurtarmak",
                                "target_lang_sense_clarification": "kötü durumdaki bir hayvanı"
                            },
                            {
                                "target_lang_word": "sahiplenmek",
                                "target_lang_sense_clarification": "barınaktan hayvan almak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78328d03-ce98-38bc-b927-70bf3f434d9e",
                    "sense_definition": "To salvage and restore something that has been discarded or is in bad condition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restore_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I managed to <w>rescue</w> an old wooden chair from the trash and fix it up.",
                            "target_lang_translations": {
                                "ru": "Мне удалось <w>спасти</w> старый деревянный стул с помойки и починить его.",
                                "tr": "Çöpten eski ahşap bir sandalyeyi <w>kurtarıp</w> tamir etmeyi başardım."
                            }
                        },
                        {
                            "text": "She likes to visit junk shops to <w>rescue</w> vintage furniture.",
                            "target_lang_translations": {
                                "ru": "Она любит посещать магазины старьёвщиков, чтобы <w>спасать</w> винтажную мебель.",
                                "tr": "Bağkur/eskici dükkanlarını ziyaret edip vintage mobilyaları <w>kurtarmayı</w> sever."
                            }
                        }
                    ],
                    "synonyms": [
                        "save"
                    ],
                    "common_phrases": [
                        "rescue from the trash",
                        "rescue a project"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спасти и восстановить что-то, что было выброшено или находится в плохом состоянии.",
                        "tr": "Atılmış veya kötü durumda olan bir şeyi kurtarmak ve yenilemek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спасти",
                                "target_lang_sense_clarification": "от уничтожения или свалки"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kurtarmak",
                                "target_lang_sense_clarification": "atılmaktan veya çöpe gitmekten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abf702ae-fd3e-3476-a3d8-c08cd867c436",
                    "sense_definition": "To achieve a positive result or prevent failure under difficult conditions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_save",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker scored a late goal to <w>rescue</w> a point for his team.",
                            "target_lang_translations": {
                                "ru": "Нападающий забил поздний гол, чтобы <w>спасти</w> очко для своей команды.",
                                "tr": "Forvet oyuncusu, takımı adına bir puanı <w>kurtarmak</w> için son dakikalarda bir gol attı."
                            }
                        },
                        {
                            "text": "He tried to <w>rescue</w> the conversation after the awkward silence.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>спасти</w> разговор после неловкого молчания.",
                                "tr": "Garip sessizlikten sonra sohbeti <w>kurtarmaya</w> çalıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "save"
                    ],
                    "common_phrases": [
                        "rescue a situation",
                        "rescue a draw"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добиться положительного результата или предотвратить неудачу в трудных условиях.",
                        "tr": "Zor koşullar altında olumlu bir sonuç elde etmek veya başarısızlığı önlemek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спасти",
                                "target_lang_sense_clarification": "ситуацию"
                            },
                            {
                                "target_lang_word": "выручить",
                                "target_lang_sense_clarification": "команду или положение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kurtarmak",
                                "target_lang_sense_clarification": "durumu veya sonucu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d578c570-b7a1-3415-adbb-7325989e3508",
                    "sense_definition": "An act of saving someone or something from danger or harm.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "save_danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rescue</w> of the trapped miners took several days to complete.",
                            "target_lang_translations": {
                                "ru": "<w>Спасение</w> заблокированных шахтёров заняло несколько дней.",
                                "tr": "Mahsur kalan madencilerin <w>kurtarılması</w> birkaç gün sürdü."
                            }
                        },
                        {
                            "text": "The coast guard launched a daring <w>rescue</w> during the storm.",
                            "target_lang_translations": {
                                "ru": "Береговая охрана начала смелую операцию по <w>спасению</w> во время шторма.",
                                "tr": "Sahil güvenlik fırtına sırasında cesur bir <w>kurtarma</w> operasyonu başlattı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "search and rescue",
                        "come to the rescue",
                        "daring rescue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по спасению кого-либо или чего-либо от опасности или вреда.",
                        "tr": "Birini veya bir şeyi tehlike veya zarardan kurtarma eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спасение",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kurtarma",
                                "target_lang_sense_clarification": "kurtarma operasyonu veya eylemi"
                            },
                            {
                                "target_lang_word": "kurtarılma",
                                "target_lang_sense_clarification": "kurtarılma durumu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5aaf423a-cdf2-3a1d-a409-a1272211319d",
                    "sense_definition": "An animal that has been adopted from a shelter or rescued from a bad situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adopt_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My dog is a <w>rescue</w> that I found at the city pound.",
                            "target_lang_translations": {
                                "ru": "Моя собака — <w>из приюта</w>; я нашел её в городском питомнике.",
                                "tr": "Köpeğim şehir barınağında bulduğum bir <w>barınak köpeği</w>."
                            }
                        },
                        {
                            "text": "She prefers to adopt <w>rescues</w> rather than buying pets from breeders.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает брать <w>животных из приюта</w>, а не покупать питомцев у заводчиков.",
                                "tr": "Yetiştiricilerden evcil hayvan satın almak yerine <w>kurtarılmış hayvanları</w> sahiplenmeyi tercih ediyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "is a rescue"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used to refer to adopted pets."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Животное, которое взяли из приюта или спасли из плохой ситуации.",
                        "tr": "Barınaktan sahiplenilmiş veya kötü bir durumdan kurtarılmış hayvan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "животное из приюта",
                                "target_lang_sense_clarification": "питомец"
                            },
                            {
                                "target_lang_word": "спасённое животное",
                                "target_lang_sense_clarification": "буквальный перевод"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kurtarılmış hayvan",
                                "target_lang_sense_clarification": "genellikle barınaktan alınan evcil hayvan"
                            },
                            {
                                "target_lang_word": "barınak hayvanı",
                                "target_lang_sense_clarification": "sahiplenilmiş evcil hayvan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53c29822-0da6-35f6-982e-a713d4c9a5b2",
                    "sense_definition": "The forcible ending of a siege or liberation from military peril.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "military_save",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army planned the <w>rescue</w> of the city from the enemy forces.",
                            "target_lang_translations": {
                                "ru": "Армия спланировала <w>освобождение</w> города от вражеских войск.",
                                "tr": "Ordu, şehrin düşman kuvvetlerinden <w>kurtarılmasını</w> planladı."
                            }
                        },
                        {
                            "text": "History books describe the <w>rescue</w> of the besieged castle.",
                            "target_lang_translations": {
                                "ru": "В учебниках истории описывается <w>освобождение</w> осаждённого замка.",
                                "tr": "Tarih kitapları kuşatılan kalenin <w>kurtarılışını</w> anlatır."
                            }
                        }
                    ],
                    "antonyms": [
                        "capture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Насильственное прекращение осады или освобождение от военной угрозы.",
                        "tr": "Bir kuşatmanın zorla sona erdirilmesi veya askeri tehlikeden kurtarılma."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождение",
                                "target_lang_sense_clarification": "от осады"
                            },
                            {
                                "target_lang_word": "спасение",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kurtarma",
                                "target_lang_sense_clarification": "kuşatmayı kaldırma veya askeri kurtarış"
                            },
                            {
                                "target_lang_word": "kurtuluş",
                                "target_lang_sense_clarification": "tehlikeden veya işgalden özgürleşme"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
