        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "995bf9eb-201c-3025-b679-e4fa7216838e",
                    "sense_definition": "Sentiment de contentement ou de plaisir éprouvé lorsque les souhaits, les attentes ou les besoins sont comblés.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a souri avec <w>satisfaction</w> en découvrant ses excellents résultats d'examen."
                        },
                        {
                            "text": "Ce travail bien accompli lui procure une grande <w>satisfaction</w> personnelle au quotidien."
                        }
                    ],
                    "synonyms": [
                        "contentement",
                        "plaisir",
                        "plénitude"
                    ],
                    "antonyms": [
                        "insatisfaction"
                    ],
                    "common_phrases": [
                        "donner satisfaction",
                        "avec satisfaction",
                        "tirer une satisfaction"
                    ]
                },
                {
                    "sense_id": "7e34b488-dc35-3300-8e10-6ab64b895f1a",
                    "sense_definition": "Action de répondre favorablement ou d'apporter une solution adéquate à un besoin, une demande ou une obligation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accomplissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>satisfaction</w> des besoins essentiels de la population reste une priorité pour la commune."
                        },
                        {
                            "text": "Le client a dû insister pour obtenir enfin <w>satisfaction</w> auprès du service après-vente."
                        }
                    ],
                    "synonyms": [
                        "assouvissement"
                    ],
                    "common_phrases": [
                        "obtenir satisfaction",
                        "satisfaction des besoins"
                    ]
                },
                {
                    "sense_id": "6730d9c0-920f-3a5e-8158-4dd0a4486137",
                    "sense_definition": "Réparation accordée à une personne pour compenser une offense, un tort ou une injure subie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir été publiquement outragé, il a immédiatement exigé <w>satisfaction</w> auprès de son adversaire."
                        },
                        {
                            "text": "L'ambassadeur a demandé une <w>satisfaction</w> officielle suite à cet incident diplomatique majeur."
