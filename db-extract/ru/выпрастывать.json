                "senses": [
                    {
                        "sense_id": "96ec6a1d-b26a-3955-8182-aee67dcfe0a4",
                        "entry_id": "466f951e-b601-3632-99bd-f470c94536ea",
                        "glosses": [
                            "to pull out"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27b773a9-e99a-4da0-9a66-d4b7726919e0",
                                "sense_id": "96ec6a1d-b26a-3955-8182-aee67dcfe0a4",
                                "text": "— И чёрт его́ но́сит! — проговори́л про себя́ Лёвин, возвраща́ясь к завя́зшему экипа́жу. — Заче́м вы пое́хали? — су́хо сказа́л он ему́ и, кли́кнув ку́чера, принялся́ выпра́стывать лошаде́й.",
                                "translation": "\"Damn the fellow!\" Levin said to himself, as he went back to the carriage that had sunk in the mire. \"What did you drive in for?\" he said to him dryly, and calling the coachman, he began pulling the horses out.",
                                "english": "\"Damn the fellow!\" Levin said to himself, as he went back to the carriage that had sunk in the mire. \"What did you drive in for?\" he said to him dryly, and calling the coachman, he began pulling the horses out."
                            }
                        ]
                    }
