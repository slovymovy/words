                "translations": [
                    {
                        "translation_id": "0f795e3c-e782-4c6a-80e3-602acaffa5df",
                        "source_entry_id": "40ea4d5d-fc1e-36bb-84ef-58bf65b892e3",
                        "source_sense_id": "2c8cff48-18e6-3d7a-bd23-73e5b78fee99",
                        "target_lang_word": "toxoplasmosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toxoplasmosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dcd86c9-051f-3856-a639-99ef1ca85f84",
                                        "entry_id": "26187154-1092-3c92-bac1-1edac58abbed",
                                        "glosses": [
                                            "A disease, caused by the parasite Toxoplasma gondii, that primarily affects felids, but also other mammals including humans."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9514ca54-c671-4c36-a3ea-54fca8f43d07",
                                                "sense_id": "9dcd86c9-051f-3856-a639-99ef1ca85f84",
                                                "text": "Some profiles are particularly associated with severe toxoplasmoses, but this relationship is especially true for experimental infections in the murine model."
                                            },
                                            {
                                                "example_id": "a204341d-1cc1-4fd4-b932-75fc54a0e4e9",
                                                "sense_id": "9dcd86c9-051f-3856-a639-99ef1ca85f84",
                                                "text": "In a study of treatment of the infected mother during pregnancy with spiramycin, pyrimethamine, and sulfonamides there was a significant reduction in the severity of congenital toxoplasmosis."
                                            },
                                            {
                                                "example_id": "56802d8a-b472-4f30-8bb1-ce764332fd15",
                                                "sense_id": "9dcd86c9-051f-3856-a639-99ef1ca85f84",
                                                "text": "Like other Australian marsupial taxa, wombats appear particularly susceptible to toxoplasmosis due to exposure to the coccidian parasite Toxoplasma gondii."
                                            },
                                            {
                                                "example_id": "682a9d2b-e8b7-4ae6-b4d0-24ad0bebf63f",
                                                "sense_id": "9dcd86c9-051f-3856-a639-99ef1ca85f84",
                                                "text": "Well, yes, boss, it’s a parasite called toxoplasmosis. It can be transferred from cats to humans and bring about some complications."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e942793e-206f-4d29-8c13-93569dbc44bc",
