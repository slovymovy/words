        "fr-extract.jsonl": [
            {
                "entry_id": "50042c75-8693-3a0e-9b5f-4bf6d15d2317",
                "word": "saprophage",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0ddfcd7c-84d4-4d19-a3f9-ad4e6e747a7f",
                        "entry_id": "50042c75-8693-3a0e-9b5f-4bf6d15d2317",
