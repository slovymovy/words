                "senses": [
                    {
                        "sense_id": "f47ac579-1bb5-3f25-ba8d-70d7e9fe1435",
                        "entry_id": "9ec2ce8b-bf76-3e6e-8995-09fb13e738a2",
                        "glosses": [
                            "A game played on a lawn, in which players use mallets to drive balls through hoops (wickets)."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fbd3a4ab-fa07-36b2-8fd5-a668db8e0526",
                        "entry_id": "9ec2ce8b-bf76-3e6e-8995-09fb13e738a2",
                        "glosses": [
                            "A shot in this game in which the striker's ball and another ball are moved by hitting the striker's ball when they have been placed in contact following a roquet."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "67df9664-81a5-35f8-a5c7-691d6eaf677c",
                        "entry_id": "9ec2ce8b-bf76-3e6e-8995-09fb13e738a2",
                        "glosses": [
                            "A croquette."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24c6f125-8585-48cf-b72b-77ea74b9a6c1",
                        "source_entry_id": "9ec2ce8b-bf76-3e6e-8995-09fb13e738a2",
                        "source_sense_description": "game",
                        "target_lang_word": "croquet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "croquet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f450e2e0-88db-3d3a-a7ba-c1ae91d46023",
                                        "entry_id": "3e36edc7-1800-384d-96f3-14251462d7b2",
                                        "glosses": [
                                            "Jeu que l’on joue en poussant des boules de bois, avec un maillet, sous des arceaux dans un espace de terrain limité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8603734-a2d6-4d8c-a1a4-18e98dc3376f",
                                                "sense_id": "f450e2e0-88db-3d3a-a7ba-c1ae91d46023",
                                                "text": "Un jour nous allâmes en banlieue chez des amis de mes parents dont les enfants possédaient un jeu de croquet ; à La Grillère, c’était notre passe-temps favori ; pendant le goûter, pendant la promenade je ne cessai pas d’en parler. Je grillais d’impatience. Nos amis se plaignirent à ma sœur : « Elle est assommante avec son croquet ! » Quand le soir elle me répéta ces paroles, je les accueillis avec indifférence. Je ne pouvais être blessée par des enfants qui manifestaient leur infériorité en n’aimant pas le croquet aussi ardemment que je l’aimais."
                                            },
                                            {
                                                "example_id": "9d49e6af-a072-4876-ba57-c3594c93e4fc",
                                                "sense_id": "f450e2e0-88db-3d3a-a7ba-c1ae91d46023",
                                                "text": "Si le temps menaçait on ne quittait pas Bourbonne, et on jouait au croquet dans le jardin des Bains, avec de jeunes officiers venus pour une cure, qui mettaient tant de gaieté dans les bals, et dont les galons dorés sur l’avant-bras s’enroulaient en volutes."
                                            },
                                            {
                                                "example_id": "f92ba569-f2f5-4322-83b2-75aa4a899a24",
                                                "sense_id": "f450e2e0-88db-3d3a-a7ba-c1ae91d46023",
                                                "text": "Quand le temps le permettait, tout le monde se retrouvait dans le jardin pour jouer au croquet sur une grande pelouse derrière la maison."
                                            },
                                            {
                                                "example_id": "15fb3a31-e4ff-486a-9392-d00097f23d09",
                                                "sense_id": "f450e2e0-88db-3d3a-a7ba-c1ae91d46023",
                                                "text": "… tout ce beau monde aimablement papotait et se divertissait de la métaphysique au vieux jeu du croquet,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "croquet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "705fa54c-8def-3e78-bda4-de03ae4a6f83",
                                        "entry_id": "0d2670ed-3808-37d2-a59e-362f1e6f96f6",
                                        "glosses": [
                                            "Sorte de gâteau mince et sec, croquant."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cacb1bc-7e84-42f6-a8fb-47542ebe69d2",
                                                "sense_id": "705fa54c-8def-3e78-bda4-de03ae4a6f83",
                                                "text": "Puis, elle tint des gâteaux, des galettes, des tartes aux cerises, des croquets, des biscuits de maïs, épais et jaunes, sur des claies d’osier,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
