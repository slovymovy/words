                        "glosses": [
                            "Without ceasing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca32621d-aefa-428f-b462-58728806351c",
                                "sense_id": "5f211bc2-d63e-3361-baa7-494e97eabd2c",
                                "text": "So the woods are silent, still, and deserted, save by a stray rabbit among the thistles, and the grasshoppers ceaselessly leaping in the grass."
                            },
                            {
                                "example_id": "5556d113-b133-46e9-bac0-3ed9969fdee0",
                                "sense_id": "5f211bc2-d63e-3361-baa7-494e97eabd2c",
                                "text": "So we beat on, boats against the current, borne back ceaselessly into the past."
                            }
                        ]
                    }
                ],
