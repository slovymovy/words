                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the <w>Drain</w> family.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь семьи <w>Дрейн</w>."
