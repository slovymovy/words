                        ],
                        "form": "calendaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad3663c7-2f8b-3118-821e-3700a3fe1c84",
                        "entry_id": "b6657046-8201-3562-a82a-f45fa637411d",
                        "glosses": [
                            "Relatif au calendrier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77ebab63-edca-44f8-99a1-80f765ca1884",
                                "sense_id": "ad3663c7-2f8b-3118-821e-3700a3fe1c84",
                                "text": "Année calendaire, période commençant le premier janvier et se terminant le 31 décembre."
                            },
                            {
                                "example_id": "d194726b-0362-43b5-af94-70b6bf263427",
                                "sense_id": "ad3663c7-2f8b-3118-821e-3700a3fe1c84",
                                "text": "Journée calendaire, période de 24 heures allant de minuit à minuit."
                            },
                            {
                                "example_id": "ab529451-6647-4c73-823c-c1cce444fabc",
                                "sense_id": "ad3663c7-2f8b-3118-821e-3700a3fe1c84",
                                "text": "Jour calendaire, tout jour de l’année, qu’il soit ouvrable ou férié, ouvré ou chômé."
                            },
                            {
                                "example_id": "a25096bd-c4ee-4d4e-b145-9038c54b455b",
                                "sense_id": "ad3663c7-2f8b-3118-821e-3700a3fe1c84",
                                "text": "Ainsi, Ricœur introduit un « tiers-temps» qui prend sa pleine expression dans le temps calendaire, en référence au temps du calendrier."
                            },
                            {
                                "example_id": "39fac8a6-735a-4959-b895-e426b073a810",
                                "sense_id": "ad3663c7-2f8b-3118-821e-3700a3fe1c84",
                                "text": "La stratégie gouvernementale prétend réduire notre dépendance au soja d’Amérique du Sud, responsable de la disparition de millions d’hectares au Brésil et en Argentine, mais ne fixe aucun indicateur quantitatif ou calendaire et n’évoque pas la réduction de la consommation de viande et de produits laitiers, point pourtant indissociable de cette question."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de2e8bbe-ebc7-4282-9f61-bb8ebc0e1d46",
                        "source_entry_id": "b6657046-8201-3562-a82a-f45fa637411d",
                        "source_sense_id": "ad3663c7-2f8b-3118-821e-3700a3fe1c84",
                        "target_lang_word": "calendar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calendar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33ec2a76-1425-3fe0-8d40-4ae531a14faf",
                                        "entry_id": "aafa0d01-719f-3932-95d2-cc93fd371c83",
                                        "glosses": [
                                            "To set a date for a proceeding in court, usually done by a judge at a calendar call."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aec5ab3a-75b3-4efb-bd71-5acb74f0cfdd",
                                                "sense_id": "33ec2a76-1425-3fe0-8d40-4ae531a14faf",
                                                "text": "The judge agreed to calendar a hearing for pretrial motions for the week of May 15, but did not agree to calendar the trial itself on a specific date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ae54958-fa09-3594-807d-f4c3b3dd5cdd",
                                        "entry_id": "aafa0d01-719f-3932-95d2-cc93fd371c83",
                                        "glosses": [
                                            "To enter or write in a calendar; to register."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "761b36b1-59de-4ec2-a74b-2ac7fd88af2e",
                                                "sense_id": "7ae54958-fa09-3594-807d-f4c3b3dd5cdd",
                                                "text": "Wee are generally more apt to Kalender Saints then Sinners dayes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "calendar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4be0693f-9d10-3d2c-9f84-b360ea4946eb",
                                        "entry_id": "625b1e0f-cc50-3128-a6f1-9a9791dbcacf",
                                        "glosses": [
                                            "Any system by which time is divided into days, weeks, months, and years."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c56e6ed3-fa6f-4d22-88e5-acff17606c96",
                                                "sense_id": "4be0693f-9d10-3d2c-9f84-b360ea4946eb",
                                                "text": "The three principal calendars are the Gregorian, Jewish, and Islamic calendars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "559c659b-ac9f-3a59-b29b-2b4f24f8f3d8",
                                        "entry_id": "625b1e0f-cc50-3128-a6f1-9a9791dbcacf",
                                        "glosses": [
                                            "A means to determine the date consisting of a document containing dates and other temporal information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64ba3888-57d2-4e94-9bfb-b3a34741cc4b",
                                                "sense_id": "559c659b-ac9f-3a59-b29b-2b4f24f8f3d8",
                                                "text": "Write his birthday on the calendar hanging on the wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fb32751-2993-3c64-9305-3075b96c9858",
                                        "entry_id": "625b1e0f-cc50-3128-a6f1-9a9791dbcacf",
                                        "glosses": [
                                            "A list of planned events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0fd6e99-fc15-4814-82dc-8df7c00dc907",
                                                "sense_id": "6fb32751-2993-3c64-9305-3075b96c9858",
                                                "text": "The club has a busy calendar this year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d7bf039-9ceb-30fe-9c75-427681836b17",
                                        "entry_id": "625b1e0f-cc50-3128-a6f1-9a9791dbcacf",
                                        "glosses": [
                                            "An orderly list or enumeration of persons, things, or events; a schedule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9165c88b-9e0f-485d-8203-0ba6db2525a4",
                                                "sense_id": "6d7bf039-9ceb-30fe-9c75-427681836b17",
                                                "text": "a calendar of bills presented in a legislative assembly; a calendar of causes arranged for trial in court"
                                            },
                                            {
                                                "example_id": "b7fdf257-5ed9-48ae-a222-5a6b78572410",
                                                "sense_id": "6d7bf039-9ceb-30fe-9c75-427681836b17",
                                                "text": "Shepherds of People, had need know the Kalenders of Tempeſts in State; which are commonly greateſt, when Things grow to Equality; As naturall Tempeſts are greateſt about the Æquinoctia."
                                            },
                                            {
                                                "example_id": "943da780-220a-4050-a152-f9e9284ba28d",
                                                "sense_id": "6d7bf039-9ceb-30fe-9c75-427681836b17",
                                                "text": "The story struck the depressingly familiar note with which true stories ring in the tried ears of experienced policemen.[…]The second note, the high alarum, not so familiar and always important since it indicates the paramount sin in Man's private calendar, took most of them by surprise although they had been well prepared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60b8020f-3ea6-391b-9733-c37c5efc185f",
                                        "entry_id": "625b1e0f-cc50-3128-a6f1-9a9791dbcacf",
                                        "glosses": [
                                            "An appointment book (US), appointment diary (UK)"
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
