            "senses": [
                {
                    "sense_id": "4f7c9d43-53cd-3be3-929c-61e30653221a",
                    "sense_definition": "iets dat de voortgang van een proces of actie belemmert of vertraagt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obstakel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De grootste <w>hindernis</w> was het krijgen van de juiste rechten voor het project.",
                            "target_lang_translations": {
                                "en": "The biggest <w>obstacle</w> was obtaining the correct rights for the project."
                            }
                        },
                        {
                            "text": "Zonder enige <w>hindernis</w> kon de wielrenner de finishlijn passeren.",
                            "target_lang_translations": {
                                "en": "Without any <w>hindrance</w>, the cyclist was able to cross the finish line."
                            }
                        }
                    ],
                    "synonyms": [
                        "belemmering",
                        "obstakel",
                        "beletsel",
                        "barrière"
                    ],
                    "antonyms": [
                        "hulp",
                        "voordeel"
                    ],
                    "common_phrases": [
                        "enige hindernis",
                        "grootste hindernis",
                        "zonder hindernis"
                    ],
                    "target_lang_definitions": {
                        "en": "something that impedes or delays the progress of a process or action"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obstacle",
                                "target_lang_sense_clarification": "something that stands in the way of progress"
                            },
                            {
                                "target_lang_word": "barrier",
                                "target_lang_sense_clarification": "an abstract or physical impediment"
                            },
                            {
                                "target_lang_word": "hindrance",
                                "target_lang_sense_clarification": "something that makes a situation more difficult"
                            },
                            {
                                "target_lang_word": "impediment",
                                "target_lang_sense_clarification": "a formal term for something that slows progress"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a079573-4387-3642-b875-3271b47a52ab",
                    "sense_definition": "een fysiek object dat de weg blokkeert of waar men overheen moet springen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "obstakel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het paard sprong met gemak over de laatste <w>hindernis</w> van het parcours.",
                            "target_lang_translations": {
                                "en": "The horse jumped over the last <w>hurdle</w> of the course with ease."
                            }
                        },
                        {
                            "text": "Het is maar een kleine <w>hindernis</w> op de weg waar we omheen moeten rijden.",
                            "target_lang_translations": {
                                "en": "It is just a small <w>obstacle</w> on the road that we have to drive around."
                            }
                        }
                    ],
                    "synonyms": [
                        "obstakel",
                        "barrière",
                        "versperring"
                    ],
                    "common_phrases": [
                        "fysieke hindernis",
                        "over een hindernis springen"
                    ],
                    "target_lang_definitions": {
                        "en": "a physical object that blocks the way or that one must jump over"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obstacle",
                                "target_lang_sense_clarification": "a physical object blocking a path"
                            },
                            {
                                "target_lang_word": "hurdle",
                                "target_lang_sense_clarification": "a frame to be jumped over in a race"
                            },
                            {
                                "target_lang_word": "barrier",
                                "target_lang_sense_clarification": "a structure that bars passage"
                            }
                        ]
                    }
                }
            ]
        }
