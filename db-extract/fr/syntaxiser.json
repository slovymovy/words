                "senses": [
                    {
                        "sense_id": "0dae6513-b4bf-3272-a5ec-63216eb54004",
                        "entry_id": "e32affbe-a1f3-3866-8806-479231202ebd",
                        "glosses": [
                            "Analyser selon une syntaxe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ef5ec76-6b3a-484b-8a54-33e461b4034c",
                                "sense_id": "0dae6513-b4bf-3272-a5ec-63216eb54004",
                                "text": "L'ordinateur serait selon Searle dans la même situation que cet individu, c'est-à-dire que, par le moyen de programmes, il serait une machine qui syntaxise sans sémantiser, qui ne parlerait donc pas un langage et qui, bien qu'utile, ne pourrait pas être considérée comme intelligente."
                            },
                            {
                                "example_id": "bedb8d2a-270a-406d-b096-20e61deb045f",
                                "sense_id": "0dae6513-b4bf-3272-a5ec-63216eb54004",
                                "text": "Ce sera une caractéristique de la cuisine française que cette distinction analytique, et le choix d'une parataxe de présentation qui laisse au consommateur le soin de syntaxiser."
                            }
                        ]
                    }
