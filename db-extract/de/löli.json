                "senses": [
                    {
                        "sense_id": "9ff1da86-f498-3c43-b3f4-df876ba3c7cf",
                        "entry_id": "2f7907bc-8584-3830-973c-40b97e06aa2c",
                        "glosses": [
                            "synonym of Tollpatsch (“clumsy person; fool”)"
                        ],
                        "tags": [
                            "Switzerland",
                            "colloquial",
                            "derogatory",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "94ae45e3-f432-4065-bcdb-4c612c3cce41",
                                "sense_id": "9ff1da86-f498-3c43-b3f4-df876ba3c7cf",
                                "text": "Viele Innovationen der Informatik verdanken sich beherzten Interventionen von intelligenten jungen Menschen, die der Technik mit grosser Neugier, aber ohne Unterwürfigkeit gegenübertraten, die Computertechnik nicht als etwas Vorgegebenes, Respekt erheischendes betrachteten, sondern als Spielfeld der Kreativität nutzten. Durch die destruktiven Aktionen der Lulz-Löli droht diese ursprüngliche, ehrenvolle Mission der Hacker in Vergessenheit zu geraten."
                            }
                        ]
                    }
                ],
