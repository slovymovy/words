                        ],
                        "form": "tifs"
                    },
                    {
                        "form_id": "d3d1c256-e8b3-46e0-b06c-f6d065b1c7f1",
                        "entry_id": "d37bac2b-fc68-3d84-bfaa-fd53c6356df8",
                        "tags": [],
                        "form": "tiffe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85f727af-d455-31ad-9698-642e3984d5d6",
                        "entry_id": "d37bac2b-fc68-3d84-bfaa-fd53c6356df8",
                        "glosses": [
                            "Cheveu."
                        ],
                        "tags": [
                            "colloquial",
                            "slang"
                        ],
                        "note": "Ce terme est généralement utilisé au pluriel",
                        "examples": [
                            {
                                "example_id": "ee630fa3-566b-4aa4-a7ec-3b441588f315",
                                "sense_id": "85f727af-d455-31ad-9698-642e3984d5d6",
                                "text": "Elle s’est fait couper les tifs."
                            },
                            {
                                "example_id": "6aa676ff-7742-4133-86d2-d9bb0a13c9b7",
                                "sense_id": "85f727af-d455-31ad-9698-642e3984d5d6",
                                "text": "Le comte gratte ses tifs gras d'un ongle aussi noir qu'une grand-mère de l'île de Sein."
                            },
                            {
                                "example_id": "6a2d4bd3-83d1-4033-9965-2e8111f0bd1a",
                                "sense_id": "85f727af-d455-31ad-9698-642e3984d5d6",
                                "text": "Le temps était passé si vite. Du bac à la quarantaine, la vie d’Hélène avait pris le TGV pour l’abandonner un beau jour sur un quai dont il n’avait jamais été question, avec un corps changé, des valises sous les yeux, moins de tifs et plus de cul, des enfants à ses basques, un mec qui disait l’aimer et se défilait à chaque fois qu’il était question de faire une machine ou de garder les gosses pendant une grève scolaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2249dad0-b11c-4a63-92d2-144ece41e012",
                        "source_entry_id": "d37bac2b-fc68-3d84-bfaa-fd53c6356df8",
                        "source_sense_id": "85f727af-d455-31ad-9698-642e3984d5d6",
                        "target_lang_word": "hair",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7434a26-e753-3262-98c8-0f9d7d648ddd",
                                        "entry_id": "494279b4-1309-3e6e-aa6e-fe896681c5b4",
                                        "glosses": [
                                            "A pigmented filament of keratin which grows from a follicle on the skin of humans and other mammals."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69161660-1d24-41df-ad26-a01f0d34cdde",
                                                "sense_id": "d7434a26-e753-3262-98c8-0f9d7d648ddd",
                                                "text": "And draweth new delights with hoary hairs."
                                            },
                                            {
                                                "example_id": "1fb70297-9829-4fb0-9bd0-db3dcd6c136a",
                                                "sense_id": "d7434a26-e753-3262-98c8-0f9d7d648ddd",
                                                "text": "Threading its way out from among his grey hairs, and continuing right down one side of his tawny scorched face and neck, till it disappeared in his clothing, you saw a slender rod-like mark, lividly whitish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0f6b72d-6168-3773-89f5-094477feb6e0",
                                        "entry_id": "494279b4-1309-3e6e-aa6e-fe896681c5b4",
                                        "glosses": [
                                            "The collection or mass of such growths growing from the skin of humans and animals, and forming a covering for a part of the head or for any part or the whole body."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae160434-3d5f-4fbf-8554-5e0f78e70d6f",
                                                "sense_id": "b0f6b72d-6168-3773-89f5-094477feb6e0",
                                                "text": "In the western world, women usually have long hair while men usually have short hair."
                                            },
                                            {
                                                "example_id": "a5d05733-9f96-4c60-b680-3d521d74bff1",
                                                "sense_id": "b0f6b72d-6168-3773-89f5-094477feb6e0",
                                                "text": "Her abundant hair, of a dark and glossy brown, was neatly plaited and coiled above an ivory column that rose straight from a pair of gently sloping shoulders, clearly outlined beneath the light muslin frock that covered them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b7b11ef-86d8-3ae1-b470-fed4e2ffd650",
                                        "entry_id": "494279b4-1309-3e6e-aa6e-fe896681c5b4",
                                        "glosses": [
                                            "A slender outgrowth from the chitinous cuticle of insects, spiders, crustaceans, and other invertebrates. Such hairs are totally unlike those of vertebrates in structure, composition, and mode of growth."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6da54840-475c-3096-98fe-483445ebb1be",
                                        "entry_id": "494279b4-1309-3e6e-aa6e-fe896681c5b4",
                                        "glosses": [
                                            "A cellular outgrowth of the epidermis, consisting of one or of several cells, whether pointed, hooked, knobbed, or stellated."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcc28eea-3fd4-42f4-8f3b-1e7c9b7b8071",
                                                "sense_id": "6da54840-475c-3096-98fe-483445ebb1be",
                                                "text": "Internal hairs occur in the flower stalk of the yellow frog lily (Nuphar)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd1d90bc-0de5-381b-a659-b05247fb9270",
                                        "entry_id": "494279b4-1309-3e6e-aa6e-fe896681c5b4",
                                        "glosses": [
                                            "Any slender, flexible outgrowth, filament, or fiber growing or projecting from the surface of an object or organism."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c99fb236-4349-4a83-a002-f706edf2238a",
                                                "sense_id": "cd1d90bc-0de5-381b-a659-b05247fb9270",
                                                "text": "(uncountable, by extension) The collection or mass of such outgrowths, filaments, or fibers growing or projecting from the surface of an object or organism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d51465eb-c261-33c2-a835-f96e880f1e0f",
                                        "entry_id": "494279b4-1309-3e6e-aa6e-fe896681c5b4",
                                        "glosses": [
                                            "A locking spring or other safety device in the lock of a rifle, etc., capable of being released by a slight pressure on a hair-trigger."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79a54da1-da8f-3f29-87a1-aee36ca9bda9",
                                        "entry_id": "494279b4-1309-3e6e-aa6e-fe896681c5b4",
                                        "glosses": [
                                            "Any very small distance, or degree; a hairbreadth."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a30162e7-a6f2-4e1e-a308-fa0815474938",
                                                "sense_id": "79a54da1-da8f-3f29-87a1-aee36ca9bda9",
                                                "text": "Just a little louder please—turn that knob a hair to the right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4528e292-a1ae-326b-a5f3-7f8f75fbf1f3",
                                        "entry_id": "494279b4-1309-3e6e-aa6e-fe896681c5b4",
                                        "glosses": [
                                            "Complexity; difficulty; the quality of being hairy."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc761cde-ad43-4f98-b18c-02fd141ebb63",
                                                "sense_id": "4528e292-a1ae-326b-a5f3-7f8f75fbf1f3",
                                                "text": "January 2014, Barack Obama, quoted in \"Going the Distance\" by David Remnick, in The New Yorker\nHaving said all that, those who argue that legalizing marijuana is a panacea and it solves all these social problems I think are probably overstating the case. There is a lot of hair on that policy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2afc43bf-da6a-3cc0-81fb-072d71dc8622",
                                        "entry_id": "bd10c856-60cf-3db7-adc2-acd665d26ec5",
                                        "glosses": [
                                            "To remove the hair from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af9eae39-956d-474b-a1dc-ab54a0fffc7a",
                                                "sense_id": "2afc43bf-da6a-3cc0-81fb-072d71dc8622",
                                                "text": "Now know ye, that in compliance with the said proviso, we the said John Cant and John Millar do hereby declare that our said invention of a new method of tanning leather is described in the manner following : that our method of preparing hides and skins by liming, hairing, fleshing, and baiting, is the same as that in use by the most experienced tanners; that is to say: All leather that is to be dressed or curried, we use the operation of what tanners call baiting, for this reason; that the leather when curried should carry a sufficient quantity of oil, and dry a good colour."
                                            },
                                            {
                                                "example_id": "31779ab9-436f-4f26-8755-ff1401e0f13d",
                                                "sense_id": "2afc43bf-da6a-3cc0-81fb-072d71dc8622",
                                                "text": "By his method raw hides, after hairing and baiting, are converted into leather in less than thirty hours."
                                            },
                                            {
                                                "example_id": "f74e73ae-decd-450a-bd60-180f17c1fba8",
                                                "sense_id": "2afc43bf-da6a-3cc0-81fb-072d71dc8622",
                                                "text": "I took 25 hides out of the Lime with Stephens help I haired them and fleshed them"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e50aa0a-aba1-3091-99c6-75fbce15edc5",
                                        "entry_id": "bd10c856-60cf-3db7-adc2-acd665d26ec5",
                                        "glosses": [
                                            "To grow hair (where there was a bald spot)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d3f892-e221-47b1-b291-5ba0eae9967b",
                                                "sense_id": "0e50aa0a-aba1-3091-99c6-75fbce15edc5",
                                                "text": "He has haired up and healed over."
                                            },
                                            {
                                                "example_id": "282d3b7c-920b-4ea8-9ccd-d996fb4d9b00",
                                                "sense_id": "0e50aa0a-aba1-3091-99c6-75fbce15edc5",
                                                "text": "It has haired over nicely. There are no bad results from it in any way whatever that I can detect."
                                            },
                                            {
                                                "example_id": "bc5850ba-4daa-4e11-9e6b-0f22db15b93a",
                                                "sense_id": "0e50aa0a-aba1-3091-99c6-75fbce15edc5",
                                                "text": "The bald patch on his hip was hairing over and he no longer limped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50bb50ae-8d8f-3bd7-8fde-c11352bb34c8",
                                        "entry_id": "bd10c856-60cf-3db7-adc2-acd665d26ec5",
                                        "glosses": [
                                            "To cause to have or bear hair; to provide with hair"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ac9fa63-d443-4383-8c33-6a36ceb479b0",
                                                "sense_id": "50bb50ae-8d8f-3bd7-8fde-c11352bb34c8",
                                                "text": "THE following classes of fiber are employed for hairing dolls : human hair, mohair, cross-bred wool, horsehair, hog-bristle, unspun cotton. Human hair is only used for hairing dolls of an extremely expensive class."
                                            },
                                            {
                                                "example_id": "0fe422b2-ee30-4ede-82fe-5f137d086f2d",
                                                "sense_id": "50bb50ae-8d8f-3bd7-8fde-c11352bb34c8",
                                                "text": "So they did three different sculptures and then ran the masks and painted them, haired them, and sent them out to us."
                                            },
                                            {
                                                "example_id": "1f077418-17fb-4f5d-a2ed-bc4ff270f19e",
                                                "sense_id": "50bb50ae-8d8f-3bd7-8fde-c11352bb34c8",
                                                "text": "The winter had haired them like llamas, the sleet had worked no hardship, as a horse paws to the grass, and any concern for the outside saddle stock was needless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cda68d3-fc72-3336-98f5-247eaae983a0",
                                        "entry_id": "bd10c856-60cf-3db7-adc2-acd665d26ec5",
                                        "glosses": [
                                            "To string the bow for a violin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5975c981-9471-4167-ab12-682e177ff542",
                                                "sense_id": "8cda68d3-fc72-3336-98f5-247eaae983a0",
                                                "text": "The bow is now haired, and all that remains to make it ready for use is to rosin it."
                                            },
                                            {
                                                "example_id": "2771314e-4034-4c38-8b95-3b527fa31012",
                                                "sense_id": "8cda68d3-fc72-3336-98f5-247eaae983a0",
                                                "text": "The tools used for hairing a bow by various reparimen can be unlimited in their selection. A bowmaker has a different attitude toward hairing than a repairman and this I believe reflects the type of the finished job that is done."
                                            },
                                            {
                                                "example_id": "6a2d96e8-c46c-4971-bf29-f3b2149f79b2",
                                                "sense_id": "8cda68d3-fc72-3336-98f5-247eaae983a0",
                                                "text": "To hair a bow, a hank of horse hair (A) is selected and combed so that all hairs are parallel to each other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7a7da4c-3ab5-4e91-aac8-67fbfdc2ea4b",
                        "source_entry_id": "d37bac2b-fc68-3d84-bfaa-fd53c6356df8",
                        "source_sense_id": "85f727af-d455-31ad-9698-642e3984d5d6",
                        "target_lang_word": "barnet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barnet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d742488-a8e2-3070-a1f0-d7fd8420f916",
                                        "entry_id": "8bc88cbe-76c1-3151-a49b-c04f6be8fba6",
                                        "glosses": [
                                            "hair (on one's head)"
                                        ],
                                        "tags": [
                                            "Cockney",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "304befee-8827-4457-891a-d89b0427edc8",
                                                "sense_id": "1d742488-a8e2-3070-a1f0-d7fd8420f916",
                                                "text": "Boris [Johnson], it seems, is taking it in this spirit, joshing beneath his ever-redeeming barnet that Labour's opposition to military action in Syria is a fey stance that he, as GQ politician of the year, would never be guilty of."
                                            },
                                            {
                                                "example_id": "0ac8237c-7e00-4e6c-8bcc-52232d5161a0",
                                                "sense_id": "1d742488-a8e2-3070-a1f0-d7fd8420f916",
                                                "text": "Rather than banging on about my barnet, I’d ask friends about theirs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0164640e-dbc5-4c5a-bcb5-e2f09b18632b",
