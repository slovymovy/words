                "senses": [
                    {
                        "sense_id": "519f7628-0d15-3ca0-9480-46d8eb3cafb7",
                        "entry_id": "0c624ee7-d4cb-3450-97db-eed0dc1bbb04",
                        "glosses": [
                            "тот, кто почитает кого-либо, что-либо; поклонник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c5d14e5-1e99-44a0-88a9-d8b3ba809cfd",
                                "sense_id": "519f7628-0d15-3ca0-9480-46d8eb3cafb7",
                                "text": "В каждом порядочном человеке русской земли Щедрин имеет глубокого почитателя."
                            },
                            {
                                "example_id": "2b9fbe3a-feaa-466e-ab31-91e18011bd49",
                                "sense_id": "519f7628-0d15-3ca0-9480-46d8eb3cafb7",
                                "text": "Мне было двадцать три года, когда я, почитатель его «Разгрома», опубликовал в «Огоньке» стихотворение, посвящённое А. Фадееву."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11e542bf-0340-4c28-adff-32cee30da7d6",
                        "source_entry_id": "0c624ee7-d4cb-3450-97db-eed0dc1bbb04",
                        "source_sense_id": "519f7628-0d15-3ca0-9480-46d8eb3cafb7",
                        "target_lang_word": "admirateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "admirateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69f82d54-71e2-3744-b34b-c2c17884723d",
                                        "entry_id": "15369a17-9d45-3f59-b36f-7882acc9d1fd",
                                        "glosses": [
                                            "Celui qui admire, ou qui a coutume d’admirer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cf3a2fe-6038-4bba-adee-fe28aadc1456",
                                                "sense_id": "69f82d54-71e2-3744-b34b-c2c17884723d",
                                                "text": "Il est de vos admirateurs."
                                            },
                                            {
                                                "example_id": "9fae16ea-df9b-4fdf-89e6-4c621244148e",
                                                "sense_id": "69f82d54-71e2-3744-b34b-c2c17884723d",
                                                "text": "C’est un admirateur de l’antiquité."
                                            },
                                            {
                                                "example_id": "28bcd234-1c4c-406f-9ced-096e95168061",
                                                "sense_id": "69f82d54-71e2-3744-b34b-c2c17884723d",
                                                "text": "C’est un admirateur convaincu."
                                            },
                                            {
                                                "example_id": "bab9f117-5332-453a-ade6-bd962d22049e",
                                                "sense_id": "69f82d54-71e2-3744-b34b-c2c17884723d",
                                                "text": "La liberté de ton que prenait l'auteur irrita plus d'un admirateur du Roman de la rose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
