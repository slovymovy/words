                "senses": [
                    {
                        "sense_id": "d27e544c-ba3d-356e-a9e7-e892caecf01a",
                        "entry_id": "68c41e64-3c75-3399-bbaa-ca3c57471ad0",
                        "glosses": [
                            "Geschäftsbereich, der sich mit Finanzen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4f92186-aa30-4a98-8eb1-a51058554900",
                                "sense_id": "d27e544c-ba3d-356e-a9e7-e892caecf01a",
                                "text": "„Das sind grob geschätzt zweitausend Großbanken, die wiederum mehrere hunderte Bankzweige besitzen.“"
                            },
                            {
                                "example_id": "a378a7d3-2f10-43be-b9c5-4eed1ff30b10",
                                "sense_id": "d27e544c-ba3d-356e-a9e7-e892caecf01a",
                                "text": "„Die beiden hessen-nassauischen Banken betreiben auf Grund späterer Satzungsänderungen auch andere als Grundkreditgeschäfte, während in Hannover für diese anderen Bankzweige eine besondere Landesbank errichtet worden ist.“"
                            },
                            {
                                "example_id": "cc0ffc5f-7ae1-4f7f-9793-e8f454028157",
                                "sense_id": "d27e544c-ba3d-356e-a9e7-e892caecf01a",
                                "text": "„Im Jahr 1996 gründete die Citibank als erste westliche Bank einen islamischen Bankzweig und eröffnete eine Filiale in Bahrain.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
