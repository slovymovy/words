                    {
                        "sense_id": "7d525e1f-5079-306e-a8e9-75074efde750",
                        "entry_id": "a095227d-e3de-3be9-a6c3-c445dce6ef12",
                        "glosses": [
                            "À base de pommes de terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deefbe54-eaa8-4255-9461-1418f148144b",
                                "sense_id": "7d525e1f-5079-306e-a8e9-75074efde750",
                                "text": "Hachis parmentier, galette parmentière, hachis, galette de pommes de terre."
                            },
                            {
                                "example_id": "13dfaed8-0d06-4392-8617-8fd6c9a096f5",
                                "sense_id": "7d525e1f-5079-306e-a8e9-75074efde750",
                                "text": "POTAGE PARMENTIER. Faites une purée avec des pommes de terre bien farineuses ; mettez cette purée au feu avec du beurre frais, mouillez avec du bouillon en quantité suffisant pour le potage ; au moment de servir, ajoutez dans la soupière deux cuillerées de cerfeuil haché très-fin & des petits croûtons frits."
                            }
                        ]
                    }
                ],
