                    },
                    {
                        "translation_id": "e66ba94c-0a3a-4bf9-ba0f-ddf70f1ac4f6",
                        "source_entry_id": "b66dabec-8914-3add-a7c8-73faa08e9f9f",
                        "source_sense_id": "ce289c40-cb53-3236-97be-5c0e1ded52e1",
                        "target_lang_word": "mycoplasma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mycoplasma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f86c0ca-9f5d-3990-9581-17e403816e75",
                                        "entry_id": "212cca6c-aa1b-3bca-a0d1-86d26efe40e4",
                                        "glosses": [
                                            "Any infectious bacterium of the genus Mycoplasma, often specifically Mycoplasma pneumoniae"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c80bb37d-1bea-40bb-a80c-3ea0513bca66",
                                                "sense_id": "6f86c0ca-9f5d-3990-9581-17e403816e75",
                                                "text": "Officials are investigating whether the illness was caused by mycoplasma, a common bacteria known as walking pneumonia."
                                            },
                                            {
                                                "example_id": "6e8eab17-f05d-4b2d-a5c7-c1a84981c17f",
                                                "sense_id": "6f86c0ca-9f5d-3990-9581-17e403816e75",
                                                "text": "It is likely that the long evolutionary trajectory of Mycoplasma went from a reductive autotroph to oxidative heterotroph to a cell-wall–defective degenerate parasite. This evolutionary trajectory assumes the simplicity to complexity route of biogenesis, a point of view that is not universally accepted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
