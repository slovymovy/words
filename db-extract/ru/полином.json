                                        "sense_id": "8d884aa3-ae30-356f-9ac7-486ca34adb0e",
                                        "entry_id": "50cb74f6-95e2-3fe6-b223-66a23b8b9146",
                                        "glosses": [
                                            "An expression consisting of a sum of a finite number of terms, each term being the product of a constant coefficient and one or more variables raised to a non-negative integer power, such as a_nxⁿ+a_n-1xⁿ⁻¹+...+a_0x⁰."
                                        ],
                                        "tags": [
                                            "strict-sense"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28716ff0-7249-42d5-976a-90e3e44d6017",
                                                "sense_id": "8d884aa3-ae30-356f-9ac7-486ca34adb0e",
                                                "text": "Unfortunately, an analogous attack on the octic polynomial becomes exceedingly complicated."
                                            },
                                            {
                                                "example_id": "81b2585c-b7b6-4c2f-aa03-912f04190b74",
                                                "sense_id": "8d884aa3-ae30-356f-9ac7-486ca34adb0e",
                                                "text": "Our upper bound is the best possible, and it implies the existence of low-rank factorizations of positive semidefinite bivariate matrix polynomials and representations of biforms as sums of few squares."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "939c2b7e-1682-3174-9eee-393499e57480",
                                        "entry_id": "50cb74f6-95e2-3fe6-b223-66a23b8b9146",
                                        "glosses": [
                                            "A taxonomic designation (such as of a subspecies) consisting of more than two terms."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
