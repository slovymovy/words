                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4a184e44-7b9c-4c90-afbb-d08b44168ce0",
                        "source_entry_id": "9657db13-d234-3ec9-a55f-9acea311e741",
                        "source_sense_id": "12c94536-62eb-364b-8746-f7fbeb99054d",
                        "source_sense_description": "procession of cars",
                        "target_lang_word": "Autokolonne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autokolonne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e13eb5e-7ec6-3d13-a0ee-0ffbc161f0e9",
                                        "entry_id": "fa0c3ca2-3af1-3059-8960-9fd3ba655934",
                                        "glosses": [
                                            "Gruppe von Autos, die über längere Zeit hinweg in gleichem Tempo und Abstand fährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8c9007d-0969-4da9-8076-1b04e5c95d6f",
                                                "sense_id": "1e13eb5e-7ec6-3d13-a0ee-0ffbc161f0e9",
                                                "text": "„Es mußte ihr vielmehr schon als eine höchst ansehnliche Leistung angerechnet werden, daß die Heeresleitung von Mitte 1917 an mit einer monatlichen Fertigstellung von sechs Autokolonnen zu je 20 Lastkraftwagen — außer den für die Fliegerverbände erforderlichen Kraftfahrzeugen — rechnen konnte.“"
                                            },
                                            {
                                                "example_id": "83bb5b62-2cfe-490b-9c68-40e1faa4fb3d",
                                                "sense_id": "1e13eb5e-7ec6-3d13-a0ee-0ffbc161f0e9",
                                                "text": "„Die Autokolonnen, die sich durch die Straßen schlängelten, sahen von hier oben aus wie Goldkettchen auf schwarzem Samt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4c9ca03-a628-4e61-9721-0df29d709a84",
                        "source_entry_id": "9657db13-d234-3ec9-a55f-9acea311e741",
                        "source_sense_id": "12c94536-62eb-364b-8746-f7fbeb99054d",
                        "source_sense_description": "procession of cars",
                        "target_lang_word": "Wagenkolonne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wagenkolonne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16418f2a-f4bb-329c-ab27-fa2fe9734836",
                                        "entry_id": "a6bc6ca5-5850-3f13-8bb0-e96c30d2aa67",
                                        "glosses": [
                                            "Menge von Wagen, die in Reihe hintereinander stehen oder fahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d095ff64-307d-449f-b93b-927a39ef00e1",
                                                "sense_id": "16418f2a-f4bb-329c-ab27-fa2fe9734836",
                                                "text": "„Tagelang kamen solche Wagenkolonnen durch Jäglack, auf dem Hof des Rittergutes standen zeitweise 21 voll beladene Wagen.“"
                                            },
                                            {
                                                "example_id": "7d198b26-01fd-4c6a-b21a-5a12990f6628",
                                                "sense_id": "16418f2a-f4bb-329c-ab27-fa2fe9734836",
                                                "text": "„Aus dem östlichen Ostpreußen, aus dem Memelland, kommt eine lange Wagenkolonne an, mit Menschen ungewohnten Namens und mit sonderbar kleinen und struppigen, aber zähen Pferden bespannt.“"
                                            },
                                            {
                                                "example_id": "2f3ea176-27ea-44b8-ab15-eaf0e72e7a5b",
                                                "sense_id": "16418f2a-f4bb-329c-ab27-fa2fe9734836",
                                                "text": "„Bestochene Gendarmerieposten erblindeten schlichtweg zu vereinbarten Stunden, und dann fuhren direkt vor ihrer Nase und unter ihrem stillen Patronat ganze Wagenkolonnen durchs Gettotor, beladen mit Lebensmitteln, teuren Getränken, den luxuriösesten Leckerbissen, Tabak direkt aus Griechenland oder französischen Galanteriewaren und Kosmetika.“"
                                            },
                                            {
                                                "example_id": "23a80346-b595-4d1b-9d76-15aa61c53732",
                                                "sense_id": "16418f2a-f4bb-329c-ab27-fa2fe9734836",
                                                "text": "„Von allen Seiten strömten die Wagenkolonnen der Hauptstraße zu, die auf das Militärgelände führte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
