                                "sense_id": "cfdb9753-928d-3b54-aa05-0f7f8003c054",
                                "text": "Ik vree."
                            },
                            {
                                "example_id": "7fd3f42a-57a0-4b32-85d7-93ebd89d3fa8",
                                "sense_id": "cfdb9753-928d-3b54-aa05-0f7f8003c054",
                                "text": "Jij vree."
                            },
                            {
                                "example_id": "91d11ea9-7fe5-4c50-8e0d-be86fdee1bf6",
                                "sense_id": "cfdb9753-928d-3b54-aa05-0f7f8003c054",
                                "text": "Hij, zij, het vree."
                            },
                            {
                                "example_id": "26405d8e-72e3-43ec-98d4-6e4556b68454",
                                "sense_id": "cfdb9753-928d-3b54-aa05-0f7f8003c054",
                                "text": "Zijn antwoord was, dat hij vree met wie hij lustte, en dat de pastoors daar geen zaken mee hadden, en of dit kind wel van hem was?"
                            }
                        ]
                    }
