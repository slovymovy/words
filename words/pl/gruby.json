                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jezykoznawstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnym piśmiennictwie analizowano tak zwane <w>grube</w> spółgłoski języka polskiego.",
                            "target_lang_translations": {
                                "ru": "В старинных трудах анализировались так называемые <w>твёрдые</w> согласные польского языка."
