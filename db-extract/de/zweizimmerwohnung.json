                "senses": [
                    {
                        "sense_id": "4b795f9f-7702-3aca-b722-f2a1d919fcaf",
                        "entry_id": "fe4d8992-7873-38cf-8ec3-72260763d295",
                        "glosses": [
                            "Wohnung, die aus zwei Zimmern besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "595cb189-7273-4428-9acd-e662c877c1cc",
                                "sense_id": "4b795f9f-7702-3aca-b722-f2a1d919fcaf",
                                "text": "Die Zweizimmerwohnung ist sechzig Quadratmeter groß."
                            },
                            {
                                "example_id": "585fc621-90ba-4090-98dc-fc1bc663ce0b",
                                "sense_id": "4b795f9f-7702-3aca-b722-f2a1d919fcaf",
                                "text": "„Das Ehepaar Erber lebte in seiner Zweizimmerwohnung mit Küche am Ende der Lindenallee ohne höhere Ansprüche.“"
                            },
                            {
                                "example_id": "95a1dd7b-33db-40f1-836a-82f1881c2c6e",
                                "sense_id": "4b795f9f-7702-3aca-b722-f2a1d919fcaf",
                                "text": "„Hinterm Haus würde sich eine Zweizimmerwohnung für die Hausangestellten befinden.“"
                            },
                            {
                                "example_id": "a2d31b19-7545-4954-b8da-44934ca3e43a",
                                "sense_id": "4b795f9f-7702-3aca-b722-f2a1d919fcaf",
                                "text": "„Sie selbst wohnte ein Stockwerk tiefer allein in der gleichen Zweizimmerwohnung und empfand diese als beängstigend klein.“"
                            },
                            {
                                "example_id": "c0098b0d-8f70-42e0-8191-2d7d29be4ccc",
                                "sense_id": "4b795f9f-7702-3aca-b722-f2a1d919fcaf",
                                "text": "„In Midland bewohnte sie eine kleine Zweizimmerwohnung und lebte eher zurückgezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
