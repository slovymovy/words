                    {
                        "sense_id": "9c28f78d-6334-3aea-b52d-4f78acd4d2da",
                        "entry_id": "698462ce-3e38-3146-a808-8ba6d923f451",
                        "glosses": [
                            "een zeer smalle taille, een sterk geaccentueerde taille"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69db2299-41fd-4a4d-b479-196a87e3d496",
                                "sense_id": "9c28f78d-6334-3aea-b52d-4f78acd4d2da",
                                "text": "Ze hadden een brede ceintuur van elastiek om een wespentaille te krijgen, begonnen rond te waggelen op hoge hakken in het weekend en zagen eruit als danspoppen, dus echte Amerikaansen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd981afa-1325-4443-afbf-54bef3708cf2",
                        "source_entry_id": "698462ce-3e38-3146-a808-8ba6d923f451",
                        "source_sense_id": "9c28f78d-6334-3aea-b52d-4f78acd4d2da",
                        "source_sense_description": "een zeer smalle taille",
                        "target_lang_word": "Wespentaille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wespentaille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9261ec0d-e96b-39db-8417-521a2f5848fd",
                                        "entry_id": "b1fafa4f-eb52-3ea8-aaa1-85cb67cfb32f",
                                        "glosses": [
                                            "sehr schmale Taille"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a1235e7-f638-4024-afb3-bd349696fb3d",
                                                "sense_id": "9261ec0d-e96b-39db-8417-521a2f5848fd",
                                                "text": "„Dabei sah sie komisch aus, weil sie sehr klein ist, einen massigen Unterleib, aber eine Wespentaille und einen mageren Oberkörper hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b02fbfc-b96a-4692-a04f-3e9657a6edf7",
                        "source_entry_id": "698462ce-3e38-3146-a808-8ba6d923f451",
                        "source_sense_id": "9c28f78d-6334-3aea-b52d-4f78acd4d2da",
                        "source_sense_description": "een zeer smalle taille",
                        "target_lang_word": "wasp waist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wasp waist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e76a0aa2-b390-387c-989c-21d525478084",
                                        "entry_id": "72649d3e-0f96-3434-848f-2443efaf7bd3",
                                        "glosses": [
                                            "a very slim waist resembling that of a wasp, especially one attained by tightlacing (corseting)"
                                        ],
