                        "sense_id": "9413ad61-e686-35c3-a384-43d9c274253f",
                        "entry_id": "db0e3043-39fd-3064-88d5-16af7358d102",
                        "glosses": [
                            "referenziert einen Ort, der die Handlung umgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdd7bdfa-3968-4833-ac87-7d7e9cbbdf09",
                                "sense_id": "9413ad61-e686-35c3-a384-43d9c274253f",
                                "text": "Reich mir doch bitte den Karton. Darin sind noch ein paar Sachen von mir."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "af10dedc-9f8d-387c-9355-726a972dfb81",
                        "entry_id": "db0e3043-39fd-3064-88d5-16af7358d102",
                        "glosses": [
                            "referenziert einen Umstand, Zustand, Handlung oder Ereignis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df74b043-3c1c-42df-beee-a1a009624996",
                                "sense_id": "af10dedc-9f8d-387c-9355-726a972dfb81",
                                "text": "Der Unterschied zwischen den Fahrrädern liegt darin, dass das eine deutlich leichter ist."
                            },
                            {
                                "example_id": "732c529e-7f56-4486-896d-9a71c9624543",
                                "sense_id": "af10dedc-9f8d-387c-9355-726a972dfb81",
                                "text": "Ich mach das schon. Darin bin ich wirklich gut."
                            },
                            {
                                "example_id": "48496323-9bca-4e74-aef2-bebf70b01ff8",
                                "sense_id": "af10dedc-9f8d-387c-9355-726a972dfb81",
                                "text": "Darin sind wir uns doch alle hier ähnlich, oder?"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "571efcc9-8078-4a09-ae9a-de537911fced",
                        "source_entry_id": "db0e3043-39fd-3064-88d5-16af7358d102",
                        "source_sense_id": "9413ad61-e686-35c3-a384-43d9c274253f",
