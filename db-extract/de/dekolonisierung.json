                        "entry_id": "9c6f7aa6-ae0a-3fdc-81d2-f668d185dd2d",
                        "glosses": [
                            "Entlassung, Lossagung einer Kolonie von wirtschaftlicher, politischer, kultureller etc. Abhängigkeit, Einflussnahme der Kolonialmacht, die Abhängigkeit der Kolonie aufheben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ab1b3b1-dd9b-4125-b344-fc3cbbd62eef",
                                "sense_id": "5b3f6bf3-5ecf-3d0d-a6c5-60ee78fed5e2",
                                "text": "„Die Auslöser für die Dekolonisierung in Südostasien lagen im Zweiten Weltkrieg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4c74e69b-31c4-3de8-b76d-4277a9768cf3",
                        "entry_id": "9c6f7aa6-ae0a-3fdc-81d2-f668d185dd2d",
                        "glosses": [
                            "das Entfernen von bakteriellen Keimen von Haut, Schleimhäuten zur Vermeidung von Infektionen oder deren Verbreitung – v. a. i. V. m. Staphylococcus aureus in Gebrauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "907aeaa7-a71f-42ad-9ad6-e62356f0dc1d",
                                "sense_id": "4c74e69b-31c4-3de8-b76d-4277a9768cf3",
                                "text": "„Eine MRSA-Dekolonisierung (Sanierung) ist die Entfernung der MRSA-Keime von Haut und Schleimhäuten der besiedelten Patienten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
