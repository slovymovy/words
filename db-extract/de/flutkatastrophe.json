                        ],
                        "form": "die Flutkatastrophen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c71dc3ab-baf7-3609-a804-bb605505eaca",
                        "entry_id": "bcaa9e97-d035-3467-a6b7-51b15d76fb02",
                        "glosses": [
                            "verheerende Flut, die meist viele Todesopfer fordert und viel Schaden anrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e1cdf51-ae1a-4b1d-9df7-c80b9eb89477",
                                "sense_id": "c71dc3ab-baf7-3609-a804-bb605505eaca",
                                "text": "Für Flutkatastrophen muss man eine extra Versicherung abschließen, die in hochwassergefährdeten Gebieten teuer sein kann."
                            },
                            {
                                "example_id": "a0ea356d-6e14-4b4c-836f-8eb043346c80",
                                "sense_id": "c71dc3ab-baf7-3609-a804-bb605505eaca",
                                "text": "„Neue Herrschaftshäuser und Siedlungen wurden nun aus Sicherheitsgründen vor weiteren möglichen Flutkatastrophen oder von der See her kommenden Piraten auf küstenferneren Hügeln errichtet und von Mauern umgeben.“"
                            },
                            {
                                "example_id": "f79d6647-65eb-40ac-950b-39974d40e59a",
                                "sense_id": "c71dc3ab-baf7-3609-a804-bb605505eaca",
                                "text": "„Den Niedergang dieser Kultur sollen Flutkatastrophen oder die Abholzung der Wälder eingeleitet haben; so muss allein der Holzverbrauch für das Brennen von Ziegeln, aus denen die damaligen Häuser gebaut waren, enorm gewesen sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
