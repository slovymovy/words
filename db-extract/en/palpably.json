                            {
                                "example_id": "835432ed-d7fb-48f4-b900-8bb9e49b12d1",
                                "sense_id": "0d024743-8f70-3d08-b751-f2a0dbb287ed",
                                "text": "Mrs. Brown withdrawn, Phoebe came presently to bed to me, and what with the answers she drew from me, what with her own method of palpably satisfying herself",
                                "translation": "Fanny Hill",
                                "english": "Fanny Hill"
                            },
                            {
