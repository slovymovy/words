                "senses": [
                    {
                        "sense_id": "be78abbf-0728-3076-bcdb-1d99be3d067b",
                        "entry_id": "ea0ffb99-b437-3802-b783-c7d0f925d74b",
                        "glosses": [
                            "dorp waar veel vissers wonen of woonden; dorp met een vissershaven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb0b15ae-8b89-4ca4-85c2-7595bdba7cb0",
                                "sense_id": "be78abbf-0728-3076-bcdb-1d99be3d067b",
                                "text": "Bijna 30.000 mensen kwamen dit jaar aan op de Canarische Eilanden. Deze overtocht staat bekend als één van de gevaarlijkste migratieroutes ter wereld. De NOS bezocht het Senegalese vissersdorp Mbour, dat bekendstaat als springplank voor jonge migranten."
                            },
                            {
                                "example_id": "0252d794-99c5-404c-86d2-fbdf5eaf3132",
                                "sense_id": "be78abbf-0728-3076-bcdb-1d99be3d067b",
                                "text": "Naast alle bedrijvigheid omtrent de visserij verdwijnt ook het karakter van die vissersdorpen. Nederland kent zes visserijregio's van de Waddenkust tot Zeeland. Daar, in plaatsen als Urk, Katwijk en IJmuiden, zit de visserij diepgeworteld in de identiteit van de dorpen."
                            }
                        ]
                    }
