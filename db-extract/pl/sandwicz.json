                "translations": [
                    {
                        "translation_id": "0ece2457-d017-4a3a-9fad-8c716bc1f779",
                        "source_entry_id": "bfc7e250-c8b0-35ab-934c-1742041f3510",
                        "source_sense_id": "572a565e-df13-395b-9cba-552bfb0b418a",
                        "target_lang_word": "sandwich",
                        "target_lang_code": "en",
