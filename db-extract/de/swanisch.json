                ],
                "senses": [
                    {
                        "sense_id": "f4d482c8-c740-3e35-acda-c3c642bbfcb0",
                        "entry_id": "2bc73c7c-44d7-3571-9ba3-f3e07aefe858",
                        "glosses": [
                            "in Swanetien (Region in Georgien) gesprochene Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5707429-29f1-4974-88be-47ad277fbaa2",
                                "sense_id": "f4d482c8-c740-3e35-acda-c3c642bbfcb0",
                                "text": "Im Swanischen werden noch die Buchstaben ჴ (Q̕ar), ჶ (Fi) und ჷ (Šva) verwendet, die im Georgischen nicht mehr vorkommen."
                            },
                            {
                                "example_id": "a7df3fda-2a6b-4722-92b6-9129309edb74",
                                "sense_id": "f4d482c8-c740-3e35-acda-c3c642bbfcb0",
                                "text": "„Wie im Griechischen […] folgt das Präverbium im Swanischen »unmittelbar« dem Verb.“"
                            },
                            {
                                "example_id": "65848496-5c45-4f63-ab49-9bb9e12ed1a8",
                                "sense_id": "f4d482c8-c740-3e35-acda-c3c642bbfcb0",
                                "text": "„Megrelisch und Swanisch werden nach wie vor von den Megrelen und Swanen als Umgangssprache gepflegt.“"
                            },
                            {
                                "example_id": "651ea4e7-f3da-4bf8-b8ca-69a8b986b70d",
                                "sense_id": "f4d482c8-c740-3e35-acda-c3c642bbfcb0",
                                "text": "„Andererseits hat Klaproth die vier südkaukasischen Sprachen als zusammengehörig erkannt, obwohl ihm für das Swanische nur eine Wörterliste Güldenstädts zur Verfügung stand.“"
                            },
                            {
                                "example_id": "c42f672b-2104-428f-bad1-cb0ee5c2043c",
                                "sense_id": "f4d482c8-c740-3e35-acda-c3c642bbfcb0",
                                "text": "„Hinsichtlich des Südkaukasischen, das heißt des Kartwelischen, Swanischen, Mingrelischen und Lasischen, herrscht praktisch Gewissheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
