                    {
                        "sense_id": "3e87fd60-1629-3ce7-90f9-ee0f737ce679",
                        "entry_id": "9c903b2b-a113-31dc-916d-2673f9c6bf6d",
                        "glosses": [
                            "voor de zoveelste keer, bij herhaling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da0876eb-8047-404d-b6b9-b096bf2920d3",
                                "sense_id": "3e87fd60-1629-3ce7-90f9-ee0f737ce679",
                                "text": "Die site is misschien niet helemaal perfect, maar het verschil is wel twaalf miljoen euro. Plus, als er eerst nog een nieuwe school moet worden gebouwd, dan wordt dat misschien weeral tien, twintig jaar wachten. Dat geef ik op een blaadje. Nee, dat is niet werken voor de Brugse gemeenschap, maar voor het financieel voordeel van een school."
                            },
                            {
                                "example_id": "cae81dc8-391a-4460-9c21-3418d885dbd5",
                                "sense_id": "3e87fd60-1629-3ce7-90f9-ee0f737ce679",
                                "text": "Wat het publiek onthouden heeft: de economen zijn het weeral niet eens. Zoals wel vaker: volgens de een moet de overheid meer uitgeven om de groei aan te zwengelen. Volgens de ander net minder. Volgens de een moet de rente stijgen, volgens de ander net niet."
                            }
                        ]
                    }
