    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "618e84f9-35a3-364d-a4f1-fcebb01213ac",
                    "sense_definition": "Détruire ou réduire peu à peu à néant, en particulier par l'action du feu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les flammes violentes ont <w>consumé</w> tout le bâtiment en moins d'une heure."
                        },
                        {
                            "text": "Sur la table de nuit, la bougie se <w>consume</w> lentement dans le silence de la chambre."
                        }
                    ],
                    "common_phrases": [
                        "être consumé par le feu",
                        "se consumer lentement"
                    ]
                },
                {
                    "sense_id": "174357c5-27fd-3689-8948-a0fc4f712a13",
                    "sense_definition": "Tourmenter profondément ou faire dépérir quelqu'un, en parlant d'un sentiment violent ou d'un chagrin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "epuisement_moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un désir ardent de vengeance le <w>consume</w> depuis le jour où il a tout perdu."
                        },
                        {
                            "text": "Cette jalousie maladive finit par la <w>consumer</w> et gâche toutes ses relations amicales."
                        }
                    ],
                    "common_phrases": [
                        "se consumer de chagrin"
                    ]
                },
                {
                    "sense_id": "d4112637-ee03-3bc4-94e9-0220e5bfa04d",
                    "sense_definition": "Employer ou épuiser sans compter, en particulier du temps ou des ressources.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "depense_ressources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont <w>consumé</w> des mois entiers dans des débats stériles sans jamais trouver d'accord."
                        },
                        {
                            "text": "Il ne faut pas <w>consumer</w> inutilement votre énergie dans des querelles sans importance."
                        }
                    ],
                    "common_phrases": [
                        "consumer son temps",
                        "consumer ses forces"
                    ]
                }
            ]
        }
    ]
