                        "source_sense_id": "408b2737-47c9-3197-8d22-1783e1dfb583",
                        "source_sense_description": "act of buying or selling spiritual things",
                        "target_lang_word": "simonie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
