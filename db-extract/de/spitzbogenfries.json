                "senses": [
                    {
                        "sense_id": "7f305d38-42bb-3d87-a2f8-1200b0b57444",
                        "entry_id": "1a2f3275-3711-379f-83df-604e23f974ef",
                        "glosses": [
                            "aneinander gereihte spitze Blendbögen in der gotischen Außenarchitektur zur Gliederung oder zum Abschluss einer Fassade"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69cd4d07-2b9f-4ee1-83b4-de9caf189cba",
                                "sense_id": "7f305d38-42bb-3d87-a2f8-1200b0b57444",
                                "text": "„Aber die Baukunst entlehnt ihre Ornament-Formen auch aus ihrem eigenen Gebiete; ein Beispiel hatten wir oben im Rund- und Spitzbogenfries; […].“"
                            },
                            {
                                "example_id": "7441c4de-009f-4e06-9a73-d0101b177919",
                                "sense_id": "7f305d38-42bb-3d87-a2f8-1200b0b57444",
                                "text": "„Auch an den Chorkapellen streben die Pfeiler bis zur Dachtraufe auf, den in gleichen Formen wie am Hochchor gestalteten Spitzbogenfries zwischen sich lassend.“"
                            },
                            {
                                "example_id": "3beb290e-a6a9-436f-b61d-b003d163e197",
                                "sense_id": "7f305d38-42bb-3d87-a2f8-1200b0b57444",
                                "text": "„Im dritten Freigeschoß ist die Nordseite in nur zwei Felder mit einer Mittellisene und einem sechsteiligen Spitzbogenfries geteilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
