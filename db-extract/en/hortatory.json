                                        "examples": [
                                            {
                                                "example_id": "46bfac3b-55ca-4e3e-92c0-effe12a6c679",
                                                "sense_id": "61e83c47-069f-3800-9e99-fefd097d5ebd",
                                                "text": "Luid gejuich, aanmoedigend geschreeuw: ,,Kom op!’’ De Prinsenbeekse Janny Martels (47) loopt de finish over, ondersteund door twee EHBO-ers. Ze is officieel de allerlaatste die de eindstreep haalt. Bij de afmeldbalie barst ze in huilen uit als ze hoort dat ze het écht gehaald heeft."
                                            },
                                            {
                                                "example_id": "0bdb803e-39ba-459e-af0f-6e656090f336",
                                                "sense_id": "61e83c47-069f-3800-9e99-fefd097d5ebd",
                                                "text": "Met in het geval van de Eiberrun wel de plussen van extra sfeer door aanmoedigend publiek en contact onderweg."
                                            }
                                        ]
                                    }
                                ]
                            }
