                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "2f9c4029-8a2b-3f88-8f95-1be6166a05c5",
                                        "entry_id": "1b6a3a71-7b76-3d2c-89fb-46440d2c44d8",
                                        "glosses": [
                                            "płyta wykonana ze sklejonych i sprasowanych wiórów drzewnych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a521f98a-9df0-4326-ba93-97164fff6c0f",
                                                "sense_id": "2f9c4029-8a2b-3f88-8f95-1be6166a05c5",
                                                "text": "Jednak co jakiś czas przenosił wzrok z telewizora na równie ciekawą rzecz – na zupełnie nową meblościankę. Zrobiono ją z drewna sosnowego, a nie z płyty wiórowej. Składała się z pięciu elementów – szafy ubraniowej, bieliźniarki, przeszklonej witrynki na książki, szafki z półkami, zawierającej też dwie pojemne szuflady, i w końcu niewielkiej dwudrzwiowej komody, na której dumnie prezentował się lśniący telewizor"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b28074bc-0265-4cf0-ad3e-d3487f882f7a",
                        "source_entry_id": "a6831104-2d81-3fbe-bb1d-f3936b619cb6",
                        "source_sense_id": "d93c0b41-c4e9-324c-bb1d-f7b8f0542b65",
