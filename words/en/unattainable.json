{
    "word_family": [
        "attain",
        "attainment",
        "attainable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bae8ba22-af02-38b0-a83a-8923361b423b",
                    "sense_definition": "Impossible to achieve, reach, or obtain.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "impossible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goal of perfection is often <w>unattainable</w> for most people.",
                            "target_lang_translations": {
                                "pl": "Cel, jakim jest perfekcja, jest dla większości ludzi często <w>nieosiągalny</w>."
                            }
                        },
                        {
                            "text": "They set <w>unattainable</w> standards for their employees to follow.",
                            "target_lang_translations": {
                                "pl": "Ustalili dla swoich pracowników <w>nieosiągalne</w> standardy."
                            }
                        }
                    ],
                    "synonyms": [
                        "inaccessible",
                        "unobtainable",
                        "unapproachable"
                    ],
                    "antonyms": [
                        "attainable"
                    ],
                    "common_phrases": [
                        "unattainable goal",
                        "unattainable dream"
                    ],
                    "target_lang_definitions": {
                        "pl": "Niemożliwy do osiągnięcia, zdobycia lub zrealizowania."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nieosiągalny",
                                "target_lang_sense_clarification": "najbardziej powszechne określenie czegoś, czego nie da się zdobyć lub zrealizować"
                            },
                            {
                                "target_lang_word": "niedosiężny",
                                "target_lang_sense_clarification": "określenie literackie, odnoszące się do czegoś, czego nie można dosięgnąć lub osiągnąć"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab2402ef-3e33-335e-95fe-f66db9c65f97",
                    "sense_definition": "Something that cannot be achieved or reached.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "impossible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his life chasing <w>unattainables</w> instead of enjoying his reality.",
                            "target_lang_translations": {
                                "pl": "Spędził życie goniąc za <w>rzeczami nieosiągalnymi</w>, zamiast cieszyć się swoją rzeczywistością."
                            }
                        },
                        {
                            "text": "The list of <w>unattainables</w> grew longer as the project faced more delays.",
                            "target_lang_translations": {
                                "pl": "Lista <w>rzeczy nieosiągalnych</w> wydłużała się, w miarę jak projekt napotykał kolejne opóźnienia."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Coś, czego nie można osiągnąć lub zdobyć."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rzeczy nieosiągalne",
                                "target_lang_sense_clarification": "rzeczownikowe użycie przymiotnika w liczbie mnogiej"
                            }
                        ]
                    }
                }
            ]
        }
    ]
