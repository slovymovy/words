                        "glosses": [
                            "Zunahme der Größe einer Pflanze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbfc7532-6ef8-4d29-a077-caf65b8cf3a3",
                                "sense_id": "8d157164-6503-3a54-bc31-847a593b1bce",
                                "text": "„Schon sehr früh haben die Menschen entdeckt, dass Pflanzenwachstum vom Wasser abhängt.“"
                            },
                            {
                                "example_id": "c342c001-b585-4fa2-beb4-a997171b20ed",
                                "sense_id": "8d157164-6503-3a54-bc31-847a593b1bce",
                                "text": "„In warmen Ländern, in denen das Pflanzenwachstum ganzjährig andauert, kann man sogar mehr als eine Körnerernte im gleichen Jahre vom gleichen Feld gewinnen.“"
                            }
                        ],
