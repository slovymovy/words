                                                "sense_id": "425bd416-3e04-3a46-b624-9a16cb052a94",
                                                "text": "Ten dom, dzieci, to nasz udział ze spadku po babci."
                                            },
                                            {
                                                "example_id": "3e006296-68f6-439a-94ad-748bd1460d4e",
