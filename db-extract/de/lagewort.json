                                                "example_id": "a776505f-fc60-467d-a2ca-cb6513398ae5",
                                                "sense_id": "fef11061-3163-3a7d-b9eb-f8866ec9ad47",
                                                "text": "It is important to preposition the material before turning on the machine."
                                            }
