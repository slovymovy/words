                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc599864-8f8b-416c-b0ea-e775428611cd",
                                                "sense_id": "7838080c-aaba-3d21-b94d-16a3b379e438",
                                                "text": "There's time enough, I hope, To foot a measure with the bonnie bride,"
                                            },
                                            {
                                                "example_id": "4599e399-3e8f-4ad9-b2aa-a34b4bb71184",
                                                "sense_id": "7838080c-aaba-3d21-b94d-16a3b379e438",
                                                "text": "He saw a Quire of Ladies in a round,\nThat featly footing seem'd to skim the Ground"
                                            }
                                        ]
                                    },
