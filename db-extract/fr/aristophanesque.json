        "fr-extract.jsonl": [
            {
                "entry_id": "0e884ad1-57cc-3f9d-af70-fe6de3322f15",
                "word": "aristophanesque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "18c6880f-936a-47d0-a728-458c0f3a91a4",
                        "entry_id": "0e884ad1-57cc-3f9d-af70-fe6de3322f15",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "aristophanesques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b973958-873c-3e7a-be0e-f4e8a8755ad5",
                        "entry_id": "0e884ad1-57cc-3f9d-af70-fe6de3322f15",
                        "glosses": [
                            "Qui rappelle la manière des satires d'Aristophane, qui a le caractère de ses comédies où règne la fantaisie la plus hardie. Pour ce qui relève d'Aristophane, on utilise plutôt aristophanien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20cde60f-03e9-42f1-8feb-b9d50ef53bf1",
                                "sense_id": "5b973958-873c-3e7a-be0e-f4e8a8755ad5",
                                "text": "[L]a prose française [était] assez forte pour résister au commerce des génies les plus différents, [dont] la plaisanterie aristophanesque de Voltaire[.]"
                            },
                            {
                                "example_id": "46e29f9f-8e7e-4c19-b534-ddc94808e781",
                                "sense_id": "5b973958-873c-3e7a-be0e-f4e8a8755ad5",
                                "text": "[Il y a dans La philosophie positive de M. Auguste Comte], pour quelqu’un qui voudrait faire des charges au théâtre, dans le goût aristophanesque, sur les théories sociales, des californies de rire[.]"
                            },
                            {
                                "example_id": "bd07c9e5-44eb-410a-b2c4-e947fc597d86",
                                "sense_id": "5b973958-873c-3e7a-be0e-f4e8a8755ad5",
                                "text": "Ce caractère aristophanesque du Mariage de Figaro […]"
                            },
                            {
                                "example_id": "b23269bd-9acf-4565-94ff-b4560811d27f",
                                "sense_id": "5b973958-873c-3e7a-be0e-f4e8a8755ad5",
                                "text": "L’ensemble de la nation, hommes et femmes, devant les événements publics, est plus frivole encore que chez nous, où cependant règne une légèreté, une mobilité aristophanesque d’assemblées d’oiseaux. Mais l’Anglais est un oiseau migrateur, au lieu que la majorité des Français est sédentaire, attachée à son arbre intime, à son paysage familier."
                            },
                            {
                                "example_id": "c0e041b4-9dd1-4d54-b41b-baff6af48950",
                                "sense_id": "5b973958-873c-3e7a-be0e-f4e8a8755ad5",
                                "text": "[Nous sommes] prêts comme aucun temps ne le fut jamais […] à la raillerie aristophanesque de l'univers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1169ebd-916e-4967-8c1d-5fd2bc3db8a9",
                        "source_entry_id": "0e884ad1-57cc-3f9d-af70-fe6de3322f15",
                        "source_sense_id": "5b973958-873c-3e7a-be0e-f4e8a8755ad5",
                        "target_lang_word": "Aristophanic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aristophanic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00fc0f16-5360-3bb4-badd-613ce506154f",
                                        "entry_id": "c2225468-757f-3bfb-b126-f68bef85cc57",
                                        "glosses": [
                                            "Aristophanean"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7d29093-e7f5-4256-b24a-40827f016278",
                                                "sense_id": "00fc0f16-5360-3bb4-badd-613ce506154f",
                                                "text": "In sculpture and in the drama, in Aristophanic farce and in hieratic rituals, in pictorial art and in the stream of literature, the phallus is transcendent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
