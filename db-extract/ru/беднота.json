                        "examples": [
                            {
                                "example_id": "ef6c0272-5cfb-4e31-b02e-41d5a61ca291",
                                "sense_id": "71e54345-ca41-362b-b61d-30d84c6987a6",
                                "text": "Происходило это оттого, что деревьев не позволялось рубить и городская беднота подбирала весь валежник, хворост и обломанные сучья."
                            }
