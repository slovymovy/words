                "senses": [
                    {
                        "sense_id": "39f1bc6c-f4ac-3db8-8c47-ee16b54d35f2",
                        "entry_id": "c9e0c60d-208c-3bcb-9f05-e8438cd5d263",
                        "glosses": [
                            "Fußballspiel, bei dem die Fußballnationalmannschaften zweier Länder gegeneinander antreten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f36ef198-b893-49ad-a837-d739d1ccb661",
                                "sense_id": "39f1bc6c-f4ac-3db8-8c47-ee16b54d35f2",
                                "text": "„Ist das Fußballländerspiel gegen Brasilien am Sonntag das letzte ÖFB-Heimspiel im Happel-Stadion?“"
                            },
                            {
                                "example_id": "56efbe71-bafe-4c3e-bf36-161b15f5fdab",
                                "sense_id": "39f1bc6c-f4ac-3db8-8c47-ee16b54d35f2",
                                "text": "„Allerdings gibt es auch Situationen, in denen sie wirklich authentisch rüberkommt - zum Beispiel, wenn sie sich beim Fußballländerspiel über ein Tor von Deutschland freut und lustig die Arme hochreißt.“"
                            },
                            {
                                "example_id": "f9bf3d92-980a-49cc-a7e7-087eb69354b8",
                                "sense_id": "39f1bc6c-f4ac-3db8-8c47-ee16b54d35f2",
                                "text": "„Wie im November 2015, als das Fußballländerspiel Deutschland gegen die Niederlande in Hannover wegen einer Terrorwarnung abgesagt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
