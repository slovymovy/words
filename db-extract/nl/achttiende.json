                "senses": [
                    {
                        "sense_id": "e3663ea5-83c9-392b-b191-f51e786e3386",
                        "entry_id": "14d226d1-40f5-32dd-a2bb-a1f63d663ddd",
                        "glosses": [
                            "nummer achttien in een rij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d41811fe-bccd-4662-b83c-39625d462e7d",
                                "sense_id": "e3663ea5-83c9-392b-b191-f51e786e3386",
                                "text": "U bent de achttiende in de rij, er zijn dus nog 17 wachtenden voor u."
                            },
                            {
                                "example_id": "81af2ea1-6a09-49ef-9f0e-2d8c8b3ad2d1",
                                "sense_id": "e3663ea5-83c9-392b-b191-f51e786e3386",
                                "text": "'We leven niet meer in de achttiende eeuw.' Je had natuurlijk gelijk, Lawrie, we leefden niet meer in de achttiende eeuw."
                            }
                        ]
                    },
                    {
                        "sense_id": "037a9332-72ee-3c31-a49d-8e95967fc9ca",
                        "entry_id": "14d226d1-40f5-32dd-a2bb-a1f63d663ddd",
                        "glosses": [
                            "gedeeld door achttien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "971bb4a1-bcc0-40c5-bb79-3360e5609c87",
                                "sense_id": "037a9332-72ee-3c31-a49d-8e95967fc9ca",
                                "text": "Als je een taart eerlijk moet verdelen over 18 mensen krijgt iedereen een achttiende van de taart."
                            }
                        ]
                    },
                    {
                        "sense_id": "d16f7272-4af4-3416-b4f2-21d6ef3d5706",
                        "entry_id": "14d226d1-40f5-32dd-a2bb-a1f63d663ddd",
                        "glosses": [
                            "de leeftijd van 18 jaar bereikend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8e4f6b2-c5a5-4546-9d67-6cf6187d7930",
                                "sense_id": "d16f7272-4af4-3416-b4f2-21d6ef3d5706",
                                "text": "Op je achttiende mag je autorijden als je je rijbewijs hebt."
                            },
                            {
                                "example_id": "467121b3-441d-4552-ad6f-d8acfbc0ac68",
                                "sense_id": "d16f7272-4af4-3416-b4f2-21d6ef3d5706",
                                "text": "List woonde vanaf haar zevende jaar, na omzwervingen in weeshuizen, bij Jaap en Marie List op Vlieland. Uiteindelijk nam ze ook hun achternaam aan. Tot haar achttiende verbleef ze op het Waddeneiland, om vervolgens haar geluk te beproeven in Amsterdam, waar ze tot aan haar overlijden op 78-jarige leeftijd woonde."
                            }
                        ]
                    }
