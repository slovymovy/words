                                    {
                                        "sense_id": "7d96d037-7978-3986-94a9-d79565026710",
                                        "entry_id": "78bfb76b-dc8e-316e-83eb-8116998c53b8",
                                        "glosses": [
                                            "The process of manufacturing products on a large scale."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc11a610-bdc1-4f5e-ba6c-a2c45c3bae05",
                                                "sense_id": "7d96d037-7978-3986-94a9-d79565026710",
                                                "text": "After the war, the invaluable experience gained with mass production of the TP engines saw Davey Paxman in a favourable position to supply such units almost \"off the shelf\", a facility found to be of great value by oil companies engaged in well-drilling; [...]."
                                            },
                                            {
                                                "example_id": "bad6b7ec-99a2-47cf-984b-f85672da43b2",
                                                "sense_id": "7d96d037-7978-3986-94a9-d79565026710",
                                                "text": "They were ruled out as over-engineered and too expensive for mass production, and lost out to Class 141 and '142' railbuses, and then Class 150s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
