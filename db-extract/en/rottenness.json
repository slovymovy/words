                        "entry_id": "f6e95aa9-ca3e-358a-a668-a796ab4f1d2a",
                        "glosses": [
                            "The quality of being rotten."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8aacc912-18b6-40d4-a806-61e1fbb51020",
                                "sense_id": "22f3b1a5-c93b-36c1-be78-3b68f4292b0b",
                                "text": "The track was further weakened by the too wide spacing of the sleepers, most of which \"were in the last stage of rottenness.\""
                            },
                            {
                                "example_id": "d2637e5e-685c-48a9-a9b8-9efab0e596ed",
                                "sense_id": "22f3b1a5-c93b-36c1-be78-3b68f4292b0b",
                                "text": "Slowly Matilda sat down. Oh, the rottenness of it all! The unfairness! How dare they expel her for something she hadn't done!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6692b499-dcd8-4ad0-91d7-e8b5139cef8e",
                        "source_entry_id": "f6e95aa9-ca3e-358a-a668-a796ab4f1d2a",
                        "source_sense_id": "22f3b1a5-c93b-36c1-be78-3b68f4292b0b",
                        "source_sense_description": "the quality of being rotten",
                        "target_lang_word": "pourriture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
