                "senses": [
                    {
                        "sense_id": "a7800c68-bd72-379b-ad1c-83ee2e0d07ae",
                        "entry_id": "b7887577-b200-3165-9102-3d1fd2c06d17",
                        "glosses": [
                            "окончившийся, прошедший (о времени)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "012dbcfa-2443-4011-bff8-460c0ae9aaa8",
                                "sense_id": "a7800c68-bd72-379b-ad1c-83ee2e0d07ae",
                                "text": "Ночью капитан сделал сводку всех донесений о ходе работ за истекший день."
                            },
                            {
                                "example_id": "38519564-9d8e-4796-b1bb-a8ef14325376",
                                "sense_id": "a7800c68-bd72-379b-ad1c-83ee2e0d07ae",
                                "text": "Плетнёв прочёл свой отлично составленный отчёт за истекший год."
                            },
                            {
                                "example_id": "d0f44808-7ee1-4ba8-9d76-cde0c17e0436",
                                "sense_id": "a7800c68-bd72-379b-ad1c-83ee2e0d07ae",
                                "text": "Елисей не имел аппетита к питанию и поэтому худел в каждые истекшие сутки."
                            }
                        ]
                    }
