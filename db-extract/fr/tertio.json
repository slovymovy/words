                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3e88b74-4378-4b72-aaeb-b72c7c9e8886",
                                                "sense_id": "2dfbec6f-bfec-30e3-b08a-265eb3abaa7f",
                                                "text": "The play ended with Jones standing on third."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bd1bdbd-d36a-3a6b-8a35-77f138166feb",
