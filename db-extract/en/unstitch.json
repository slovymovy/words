                                                "sense_id": "6a31f7e9-d457-3237-8af0-3c2116062484",
                                                "text": "Alors Marguerite […] coupa rapidement le lacet qui fermait son pourpoint, tandis que Gillonne, avec une autre lame, décousait ou plutôt tranchait les manches de La Molle."
                                            },
                                            {
                                                "example_id": "c3ab22cf-d0cb-469c-809a-74a33e0a070f",
                                                "sense_id": "6a31f7e9-d457-3237-8af0-3c2116062484",
                                                "text": "Toute la famille du docteur, aidée par les clients, s’occupe à découdre les parachutes pour en faire des chemises, et des robes pour les gosses, on défait les cordons de soie pour tricoter des soquettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed2a5553-115a-3206-9721-d02350e3425a",
                                        "entry_id": "479837d1-a5e2-3dec-b3b9-4558834b26cf",
                                        "glosses": [
                                            "Déchirer le ventre d’une plaie en long, en parlant du sanglier ou du cerf. → voir éventrer"
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb50b783-470a-4b9e-8bc1-ff12841f79f1",
                                                "sense_id": "ed2a5553-115a-3206-9721-d02350e3425a",
                                                "text": "Alors, sire, dit Catherine, vos sujets les huguenots feront comme le sanglier à qui on ne met pas un épieu dans la gorge : ils découdront le trône."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0285704-26b4-3305-b8e6-2ba7691f04b7",
                                        "entry_id": "479837d1-a5e2-3dec-b3b9-4558834b26cf",
                                        "glosses": [
                                            "Se défaire en parlant de choses dont la couture s’ouvre."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11b0f4e0-dcbc-4817-a92c-d626ccb9a3e1",
                                                "sense_id": "d0285704-26b4-3305-b8e6-2ba7691f04b7",
                                                "text": "Sa robe commence à se découdre."
                                            },
                                            {
                                                "example_id": "a96a2abe-88fe-4e09-876a-0fe257918d6e",
                                                "sense_id": "d0285704-26b4-3305-b8e6-2ba7691f04b7",
                                                "text": "La doublure s’est décousue."
