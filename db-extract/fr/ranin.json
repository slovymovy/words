                                                "example_id": "bd71b62b-09b8-4587-8c49-ab3359ecd24f",
                                                "sense_id": "5aed4723-56be-3a80-b2db-eec8a0d01e0f",
                                                "text": "Now jump, if you still feel froggy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05a83a2a-df19-34df-8ae3-0c7a3edf7ef8",
                                        "entry_id": "523bcd30-5ff5-326f-86c1-db40c651e9fd",
                                        "glosses": [
                                            "Energetic or strong."
