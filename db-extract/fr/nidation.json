                        "entry_id": "0b752f58-471c-3f54-ab4b-c56a520fa968",
                        "glosses": [
                            "Implantation de l’embryon des mammifères placentaires dans la muqueuse utérine."
                        ],
                        "tags": [
                            "Gynécologie"
                        ],
                        "examples": [
                            {
                                "example_id": "fbc6db64-d460-45b6-a069-f2230593b5b6",
                                "sense_id": "9bb5e1ba-8a5f-3928-b36c-4258d0fdafb6",
                                "text": "La nidation permet à l'embryon de développer son placenta en compagnie de la muqueuse utérine de sa mère."
                            },
                            {
                                "example_id": "dcbc53cd-88ed-4f4b-8a3e-82a25039d542",
                                "sense_id": "9bb5e1ba-8a5f-3928-b36c-4258d0fdafb6",
                                "text": "Il existerait pour certains une grande similitude entre les phénomènes de nidation et ceux de l’invasion tumorale des tissus sains."
                            }
                        ]
                    }
                ],
