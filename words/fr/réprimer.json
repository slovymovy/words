{
    "word_family": [
        "répression",
        "répressif",
        "répressible",
        "irrépressible",
        "réprimeur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "598d5851-72e3-36d0-a057-9bba60ad2141",
                    "sense_definition": "Contenir ou retenir l'expression d'un sentiment, d'une émotion ou d'un réflexe involontaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a dû <w>réprimer</w> un sourire en voyant la maladresse de son collègue."
                        },
                        {
                            "text": "Il s'efforçait de <w>réprimer</w> sa colère pour éviter d'aggraver la dispute."
                        }
                    ],
                    "synonyms": [
                        "contenir",
                        "refréner",
                        "étouffer"
                    ],
                    "antonyms": [
                        "exprimer",
                        "manifester"
                    ],
                    "common_phrases": [
                        "réprimer un sourire",
                        "réprimer un bâillement",
                        "réprimer sa colère"
                    ]
                },
                {
                    "sense_id": "01d137a6-d1ef-367f-aba4-ca8b671a9d9f",
                    "sense_definition": "Empêcher par la force le développement ou l'action d'un mouvement d'opposition ou d'une révolte.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contrainte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a envoyé des troupes pour <w>réprimer</w> la manifestation dans la capitale."
                        },
                        {
                            "text": "Les forces de l'ordre ont rapidement <w>réprimé</w> l'émeute avant qu'elle ne s'étende."
                        }
                    ],
                    "synonyms": [
                        "écraser",
                        "étouffer",
                        "mater"
                    ],
                    "antonyms": [
                        "encourager",
                        "susciter"
                    ],
                    "common_phrases": [
                        "réprimer une révolte",
                        "réprimer une émeute",
                        "réprimer la contestation"
                    ]
                },
                {
                    "sense_id": "b0d72cae-2cf8-32f8-9cc5-b05c34e6cd47",
                    "sense_definition": "Sanctionner sévèrement par des mesures légales des infractions, des abus ou des crimes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le parlement a voté de nouvelles sanctions afin de <w>réprimer</w> les fraudes fiscales."
                        },
                        {
                            "text": "Ce dispositif judiciaire est spécialement conçu pour <w>réprimer</w> la cybercriminalité."
                        }
                    ],
                    "synonyms": [
                        "châtier",
                        "punir",
                        "sanctionner"
                    ],
                    "antonyms": [
                        "dépénaliser",
                        "tolérer"
                    ],
                    "common_phrases": [
                        "réprimer les abus",
                        "réprimer les fraudes",
                        "réprimer les délits"
                    ]
                }
            ]
        }
    ]
}