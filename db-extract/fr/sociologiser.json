                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e433b872-7e1e-452d-a40d-ffeec44d5993",
                                                "sense_id": "ec033516-0a1a-3495-b0ef-e177f25aa3ff",
                                                "text": "After all the sociologizing about family tradition, geography, religion, economic status, blue and red states, and clan influence, perhaps Gilbert and Sullivan came closest: “I often think it’s comical / How Nature always does contrive / That every boy and every gal / That’s born into the world alive / Is either a little Liberal / Or else a little Conservative!”"
                                            }
                                        ]
