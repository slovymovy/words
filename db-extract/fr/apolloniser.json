                "senses": [
                    {
                        "sense_id": "2f74c055-9e3b-3dc2-857b-f6c41fa845e5",
                        "entry_id": "9397f8b7-84ed-39a3-98a9-db94a2d47897",
                        "glosses": [
                            "Donner un caractère apollonique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b82f8daa-5aca-4e31-aaed-08c30e49096d",
                                "sense_id": "2f74c055-9e3b-3dc2-857b-f6c41fa845e5",
                                "text": "Un déni criard des réalités historiques du Maroc, de la part du pouvoir algérien ne cessant de \"s'apolloniser\" narcissiquement, s’imaginant toujours avoir le meilleur système politique."
                            },
                            {
                                "example_id": "f97599b8-4c83-4ae8-9eee-ec19afa047ff",
                                "sense_id": "2f74c055-9e3b-3dc2-857b-f6c41fa845e5",
                                "text": "Recourant au vocabulaire nietzschéen, ne pourrait-on dire que Platon invite ses disciples, sur le modèle de Socrate, à « apolloniser », en quelque sorte, le « dionysiaque » ?"
                            }
                        ]
                    }
