    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95571d88-c612-3e28-a3f9-00200f3327d5",
                    "sense_definition": "Disposition d'esprit portée à la plaisanterie taquine ou à l'espièglerie sans méchanceté.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "espièglerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On pouvait lire une vive <w>malice</w> dans ses yeux lorsqu'elle racontait cette anecdote."
                        },
                        {
                            "text": "L'enfant affichait un sourire plein de <w>malice</w> avant d'annoncer sa surprise."
                        }
                    ],
                    "synonyms": [
                        "espièglerie",
                        "taquinerie"
                    ],
                    "antonyms": [
                        "sérieux",
                        "gravité"
                    ],
                    "common_phrases": [
                        "regard plein de malice",
                        "sourire plein de malice"
                    ]
                },
                {
                    "sense_id": "5e97b6c1-298e-3010-8180-8085c484080e",
                    "sense_definition": "Penchant ou volonté délibérée de nuire à autrui ou de lui causer du tort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nuisance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a répandu cette fausse rumeur par pure <w>malice</w> pour salir la réputation de son collègue."
                        },
                        {
                            "text": "Cette remarque n'avait aucune mauvaise intention, elle a été faite absolument sans <w>malice</w>."
                        }
                    ],
                    "synonyms": [
                        "méchanceté",
                        "malignité",
                        "perfidie"
                    ],
                    "antonyms": [
                        "bienveillance",
                        "bonté"
                    ],
                    "common_phrases": [
                        "agir par pure malice",
                        "sans malice"
                    ]
                },
                {
                    "sense_id": "e6a59ae6-fc4f-3228-95e8-b5d01ff9a527",
                    "sense_definition": "Petite farce ou tour joué à quelqu'un dans l'intention de s'amuser sans lui faire de mal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "espièglerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves ont fait une petite <w>malice</w> à leur professeur pour détendre l'atmosphère."
                        },
                        {
                            "text": "Ne te fâche pas pour cette plaisanterie, ce n'était qu'une <w>malice</w> bien innocente."
                        }
                    ],
                    "synonyms": [
                        "farce",
                        "tour"
                    ],
                    "common_phrases": [
                        "faire une malice"
                    ]
                },
                {
                    "sense_id": "add219b0-2530-3d07-81ee-59e0f6e340a5",
                    "sense_definition": "Finesse d'esprit, ruse ingénieuse ou habileté subtile dans la manière d'agir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ruse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a su déjouer le piège de son adversaire avec beaucoup de <w>malice</w>."
                        },
                        {
                            "text": "Il a fallu user de <w>malice</w> pour convaincre ces diplomates réticents d'accepter le compromis."
                        }
                    ],
                    "synonyms": [
                        "finesse",
                        "subtilité",
                        "ruse",
                        "astuce"
                    ],
                    "antonyms": [
                        "naïveté",
                        "ingénuité"
                    ],
                    "common_phrases": [
                        "user de malice"
                    ]
                }
            ]
        }
    ]
