                            "comment": "common in spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An exclamation expressing horror, shock, or strong disapproval.",
                        "pl": "Wykrzyknik wyrażający przerażenie, oburzenie lub zaskoczenie czymś bardzo nieprzyjemnym."
                    },
                    "translations": {
                        "en": [
