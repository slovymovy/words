                ],
                "senses": [
                    {
                        "sense_id": "26c7e7df-02f2-371b-99cb-004a7f9207e7",
                        "entry_id": "29c81846-2cf1-3883-bdd9-242d7b552152",
                        "glosses": [
                            "Danser un peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61150b20-9889-4aae-b195-841858addfad",
                                "sense_id": "26c7e7df-02f2-371b-99cb-004a7f9207e7",
                                "text": "Le public – majoritairement féminin – ne s’y trompe pas et n’hésite pas à chantonner ou dansonner."
                            },
                            {
                                "example_id": "b6253f53-0979-4888-8232-371b74cef7a0",
                                "sense_id": "26c7e7df-02f2-371b-99cb-004a7f9207e7",
                                "text": "Non… mais une voix qui calcule les dimensions du désert dans lequel tu nous fais dansonner."
                            },
                            {
                                "example_id": "9d70a9e6-4bc5-4a8d-b086-f9884ef3ebac",
                                "sense_id": "26c7e7df-02f2-371b-99cb-004a7f9207e7",
                                "text": "Ou, si je puis me permettre, elle semble dansoter, comme on toussote ; ou dansiller, comme on sautille ; ou dansonner, comme on chantonne."
                            }
                        ]
                    }
                ],
