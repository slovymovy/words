                    {
                        "sense_id": "0e52259d-91f4-36fb-aee9-2e6ff4a6bde1",
                        "entry_id": "ea2796bc-8b4b-383e-8b5a-b522e7c18a65",
                        "glosses": [
                            "eine speziell für die elektrische Tonverstärkung konzipierte Gitarre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c09adb66-a3fc-4ed5-b097-e14937ece50f",
                                "sense_id": "0e52259d-91f4-36fb-aee9-2e6ff4a6bde1",
                                "text": "Ich hätte schon gerne eine E-Gitarre, man kann sie einfach besser hören als eine Akustikgitarre. Ohne Verstärkung geht eine Gitarre ja leicht im Stimmengewirr unter."
                            }
                        ],
