                ],
                "senses": [
                    {
                        "sense_id": "01df1a98-d355-3759-b242-633a953ddf8f",
                        "entry_id": "2d3513c6-4b28-3e83-bf38-f654be84160a",
                        "glosses": [
                            "een spiegel aan een auto of (motor)fiets waarmee men de situatie op de weg achter zich kan zien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51945ebf-4254-4b2b-97c8-e5e8a0e1acd7",
                                "sense_id": "01df1a98-d355-3759-b242-633a953ddf8f",
                                "text": "In de achteruitkijkspiegel zag de bestuurder een snelle auto aankomen."
                            },
                            {
                                "example_id": "fefa340a-75ec-423d-b94d-f3c56e6ba891",
                                "sense_id": "01df1a98-d355-3759-b242-633a953ddf8f",
                                "text": "In haar achteruitkijkspiegel zag ze Max gehaast ja knikken."
                            },
                            {
                                "example_id": "e47ff843-a2ca-4358-bf7c-2df959a6e8df",
                                "sense_id": "01df1a98-d355-3759-b242-633a953ddf8f",
                                "text": "Salma keek hem via de achteruitkijkspiegel aan en zei: 'Hij antwoordde dat het dan zo in evenwicht is, dat het op die manier even vervelend voor haar is als voor hem.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf998fa4-db28-41e6-9b35-4cb69ca81473",
                        "source_entry_id": "2d3513c6-4b28-3e83-bf38-f654be84160a",
                        "source_sense_id": "01df1a98-d355-3759-b242-633a953ddf8f",
                        "source_sense_description": "een spiegel aan een auto of motorfiets waarmee men de situatie op de weg achter zich kan zien",
                        "target_lang_word": "Rückspiegel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückspiegel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "46458da0-90d7-3519-912d-4699bbb1a16c",
                                        "entry_id": "2d796184-41bc-301f-b500-5c802b191290",
                                        "glosses": [
                                            "Auto: Der Spiegel im Auto, um das rückwärtige Verkehrsgeschehen zu beobachten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "711865dc-58be-426a-96a2-2a7043c79577",
                                                "sense_id": "46458da0-90d7-3519-912d-4699bbb1a16c",
                                                "text": "Du solltest öfter in den Rückspiegel schauen."
                                            },
                                            {
                                                "example_id": "c0687583-8728-46ec-abf4-b579479ed3a2",
                                                "sense_id": "46458da0-90d7-3519-912d-4699bbb1a16c",
                                                "text": "„Den ganzen Vormittag hat er dieses Gesicht im Rückspiegel ertragen.“"
                                            },
                                            {
                                                "example_id": "8899a4e0-6ba2-4833-be9a-7bab45f9af0a",
                                                "sense_id": "46458da0-90d7-3519-912d-4699bbb1a16c",
                                                "text": "„Durch den Rückspiegel wirft Eos dem Fahrer hinter ihr einen wütenden Blick zu und braust mit heulendem Motor davon.“"
                                            },
                                            {
                                                "example_id": "280a29f0-bd46-43c3-bb8b-2ec22935a9f8",
                                                "sense_id": "46458da0-90d7-3519-912d-4699bbb1a16c",
                                                "text": "„Am Rückspiegel war ein morsches Gummiband befestigt, an dem ein pelziges grünes Monster hing.“"
                                            },
                                            {
                                                "example_id": "6d577b04-998c-418e-93f5-a1c9421bdabc",
                                                "sense_id": "46458da0-90d7-3519-912d-4699bbb1a16c",
                                                "text": "„Er leugnete nicht, daß er auf der Fahrt nach Winterspelt immer wieder in den Rückspiegel geblickt hatte, und nicht der Straße wegen.“"
                                            },
                                            {
                                                "example_id": "d8728f44-dc57-4d11-af58-342d7e2352d9",
                                                "sense_id": "46458da0-90d7-3519-912d-4699bbb1a16c",
                                                "text": "„Nimm das Make-up-Täschchen und checke im Rückspiegel dein Make-up.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbf62fcc-a017-4700-bea6-5626f821c701",
                        "source_entry_id": "2d3513c6-4b28-3e83-bf38-f654be84160a",
