                "senses": [
                    {
                        "sense_id": "84e59550-6efe-3c35-bff6-2451cfc3bd6c",
                        "entry_id": "0d537020-463b-35a3-9590-48a045e0d38d",
                        "glosses": [
                            "feierlicher Eintritt von Jugendlichen ins Erwachsenenalter ohne religiösen Hintergrund"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1d4fada-ddb6-4ff8-8405-f0d05be7ca2e",
                                "sense_id": "84e59550-6efe-3c35-bff6-2451cfc3bd6c",
                                "text": "„Am 27. März findet die erste Jugendweihe in Ost-Berlin statt. Die Jugendweihe soll als sozialistisches Gegenstück die kirchliche Konfirmation/Firmung ablösen.“"
                            },
                            {
                                "example_id": "4e964df8-d511-4586-81ed-16e792278a3d",
                                "sense_id": "84e59550-6efe-3c35-bff6-2451cfc3bd6c",
                                "text": "„Die Jugendweihe war ursprünglich ein Ende des neunzehnten Jahrhunderts von freireligiösen Gruppen ins Leben gerufenes Ritual, das in Opposition zur Firmung oder Konfirmation der katholischen und evangelischen Kirche für ihre Kinder den Übergang vom Jugend- zum Erwachsenenalter markieren sollte.“"
                            },
                            {
                                "example_id": "dfafb6b6-799b-4421-8d6b-bb3d13923b15",
                                "sense_id": "84e59550-6efe-3c35-bff6-2451cfc3bd6c",
                                "text": "„Die katholische Kirche kennt nach der Erstkommunion noch die Firmung. Die Jugendweihe ist, etwas allgemeiner, eine Feier des Übergangs von der Kindheit zum Erwachsenwerden, ausdrücklich ohne religiösen Bezug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
