    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4a718c7-20ec-3ff2-af43-57190d9e99a8",
                    "sense_definition": "Lichte regen bestaande uit zeer kleine druppels",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de aanhoudende <w>motregen</w> werd het gras erg drassig.",
                            "target_lang_translations": {
                                "de": "Durch den anhaltenden <w>Nieselregen</w> wurde das Gras sehr matschig."
                            }
                        },
                        {
                            "text": "Tijdens de wandeling viel er een vervelende <w>motregen</w> uit de lucht.",
                            "target_lang_translations": {
                                "de": "Während des Spaziergangs fiel ein unangenehmer <w>Sprühregen</w> vom Himmel."
                            }
                        }
                    ],
                    "synonyms": [
                        "miezer",
                        "miezerregen"
                    ],
                    "common_phrases": [
                        "lichte motregen"
                    ],
                    "target_lang_definitions": {
                        "de": "Leichter Regen, der aus sehr kleinen Tröpfchen besteht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Nieselregen",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für feinen, leichten Regen."
                            },
                            {
                                "target_lang_word": "Sprühregen",
                                "target_lang_sense_clarification": "Synonym für Nieselregen, betont die feine Art des Regens."
                            },
                            {
                                "target_lang_word": "Niesel",
                                "target_lang_sense_clarification": "Kurzform für Nieselregen."
                            }
                        ]
                    }
                }
            ]
        },
