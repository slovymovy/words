                    "sense_id": "6fdb7d2c-4acd-3aa5-a5e1-f9227e13dc99",
                    "sense_definition": "door te graven grondstoffen of materialen uit de aarde halen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mijnbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In die streek wordt al eeuwenlang koper <w>gedolven</w>.",
                            "target_lang_translations": {
                                "en": "Copper has been <w>mined</w> in that region for centuries."
                            }
                        },
                        {
                            "text": "De arbeiders moesten diep in de grond <w>delven</w> om het goud te vinden.",
                            "target_lang_translations": {
                                "en": "The workers had to <w>dig</w> deep into the ground to find the gold."
                            }
                        }
                    ],
                    "synonyms": [
