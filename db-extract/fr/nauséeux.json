                                                "example_id": "79d18496-e5db-4902-b7b5-d06a3af4823f",
                                                "sense_id": "7c47b530-0ede-3038-9d82-c8cf7c7949a3",
                                                "text": "Thea is een beetje misselijk en zet het op een drafje om de grote passen van haar tante bij te houden."
                                            },
