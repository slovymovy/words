                                        "sense_id": "db475a61-5060-3f90-8951-f9ad9cda936f",
                                        "entry_id": "0ba7b75d-5bbc-377a-8d59-08178ae2d8ac",
                                        "glosses": [
                                            "coalitie van westerse landen die militair samenwerken om elkaars veiligheid te garanderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ed6017d-78f3-40a9-8163-e815129646dc",
                                                "sense_id": "db475a61-5060-3f90-8951-f9ad9cda936f",
                                                "text": "De NAVO stond er sinds de Koude Oorlog niet zo slecht voor als nu. De veiligheidsrisico's waren sinds het einde van dit conflict niet zo groot. Dat staat in het rapport De toekomst van de NAVO en de veiligheid van Europa van de Adviesraad Internationale Vraagstukken (AIV)"
                                            }
