                    {
                        "form_id": "ceff5205-edda-4b00-b5f6-dcb031767e72",
                        "entry_id": "393d55c8-08ee-3d3c-a4f1-0fcc3c338f59",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bahnübergänge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3af8f902-f02b-3c23-ab11-a5109d3f785a",
                        "entry_id": "393d55c8-08ee-3d3c-a4f1-0fcc3c338f59",
                        "glosses": [
                            "eine besonders gekennzeichnete und gesicherte Stelle, die das Überqueren einer Bahnstrecke ermöglicht."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b316c68c-f66d-4161-8b7f-0289529fa640",
                                "sense_id": "3af8f902-f02b-3c23-ab11-a5109d3f785a",
                                "text": "An Bahnübergängen geschehen viele Unfälle."
                            },
                            {
                                "example_id": "92d7857e-523e-428e-91f1-d93026b5572e",
                                "sense_id": "3af8f902-f02b-3c23-ab11-a5109d3f785a",
                                "text": "„Die Störungen der Bahnübergänge sind offensichtlich beseitigt.“"
                            },
                            {
                                "example_id": "a68f69f4-d8b4-4334-9727-c3e84337ba3e",
                                "sense_id": "3af8f902-f02b-3c23-ab11-a5109d3f785a",
                                "text": "„Also: Ich stehe an einer dunklen Landstraße, die aber gleichzeitig zu einem Gewirr von Gleisen und Bahnübergängen führt.“"
                            },
                            {
                                "example_id": "e213f00f-318d-438f-a1e2-ac756e9e5946",
                                "sense_id": "3af8f902-f02b-3c23-ab11-a5109d3f785a",
                                "text": "„Ich hatte das Wort irgendwo gelesen, an einen Bahnübergang auf die Schranke geschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f8ed65f-77ea-4b7c-b9ee-b047a2bb8400",
                        "source_entry_id": "393d55c8-08ee-3d3c-a4f1-0fcc3c338f59",
                        "source_sense_id": "3af8f902-f02b-3c23-ab11-a5109d3f785a",
                        "source_sense_description": "Stelle, die das Überqueren einer Bahnstrecke ermöglicht",
                        "target_lang_word": "level crossing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "level crossing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "015bd63a-3ff0-31c0-9914-41871176329f",
                                        "entry_id": "880dae68-7630-3e3c-8198-744f0c53c659",
                                        "glosses": [
                                            "An at-grade crossing between a railway line and an ordinary road, with rails and road at the same level."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d777f161-f48a-4777-9a04-69ff92afda34",
                                                "sense_id": "015bd63a-3ff0-31c0-9914-41871176329f",
                                                "text": "The aim is to secure up to £140 million for the combined road and rail improvements, including a new road bridge to replace a level crossing at Totton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b310d56-7575-40f7-a6d1-92f1577011b5",
                        "source_entry_id": "393d55c8-08ee-3d3c-a4f1-0fcc3c338f59",
                        "source_sense_id": "3af8f902-f02b-3c23-ab11-a5109d3f785a",
                        "source_sense_description": "Stelle, die das Überqueren einer Bahnstrecke ermöglicht",
                        "target_lang_word": "grade crossing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grade crossing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44359471-fb2a-35ad-b4fe-0fba492af2bf",
                                        "entry_id": "2f0c4f21-08d1-3685-9c64-f5323d73a888",
                                        "glosses": [
                                            "An at-grade crossing between a railroad line and an ordinary road, with tracks and road at the same level."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79a0193b-faba-4e94-b186-67aab288076f",
                                                "sense_id": "44359471-fb2a-35ad-b4fe-0fba492af2bf",
                                                "text": "In 1968 there were 1547 grade crossing fatalities. Two-thirds of the total fatalities associated with railroad operations occurred at grade crossings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c93f7586-0743-40b4-8df2-a49263dcfa2c",
                        "source_entry_id": "393d55c8-08ee-3d3c-a4f1-0fcc3c338f59",
                        "source_sense_id": "3af8f902-f02b-3c23-ab11-a5109d3f785a",
                        "source_sense_description": "Stelle, die das Überqueren einer Bahnstrecke ermöglicht",
                        "target_lang_word": "passage à niveau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passage à niveau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5af4c40-224b-351a-9e0f-a14a0c551434",
                                        "entry_id": "03c22bed-4508-371a-bd8d-cdacd843a315",
                                        "glosses": [
                                            "Endroit où une route et une voie ferrée se rencontrent à niveau, c’est-à-dire au même niveau, contrairement à un pont-route (la route passe au-dessus de la voie ferrée) ou à un pont-rail (la voie ferrée passe au-dessus de la route)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6916aad4-a4f9-48ca-842f-4a16f4982562",
                                                "sense_id": "c5af4c40-224b-351a-9e0f-a14a0c551434",
                                                "text": "Tandis que sa femme, et plus tard Flore, était chargée de la barrière du passage à niveau, on avait fait de Misard un stationnaire."
                                            },
                                            {
                                                "example_id": "98bf0a7d-feb6-4122-b55d-96dc6f43b892",
                                                "sense_id": "c5af4c40-224b-351a-9e0f-a14a0c551434",
                                                "text": "Cette grève surprise a démarré jeudi soir à la suite d'une collision survenue entre une rame de TER et un convoi exceptionnel, qui transportait une betteravière, dans les Ardennes. L'accident s'est produit à hauteur d'un passage à niveau à Saint-Pierre-sur-Vence. La préfecture fait état de onze blessés."
                                            },
                                            {
                                                "example_id": "3cfc60e5-9710-4d9d-b13c-4ea9b8f80a13",
                                                "sense_id": "c5af4c40-224b-351a-9e0f-a14a0c551434",
                                                "text": "Ne traversez la voie ferrée que si vous êtes absolument certain de pouvoir vous dégager rapidement du passage à niveau, en particulier si la route est encombrée. Ne vous arrêtez jamais sur la voie ferrée."
                                            },
                                            {
                                                "example_id": "4b773d6b-6639-4e4e-849c-6bcdeca273ca",
                                                "sense_id": "c5af4c40-224b-351a-9e0f-a14a0c551434",
                                                "text": "« Il y avait énormément de trafic automobile dans le secteur, la voiture avec une caravane attelée s’est engagée avant de se retrouver coincée sur le passage à niveau de Serres lorsque les barrières se sont refermées », résume un gendarme."
                                            }
                                        ]
                                    }
                                ]
                            }
