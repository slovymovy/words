                        "source_entry_id": "1b5f6cb3-0e2b-3a74-a317-3a9858bfb582",
                        "target_lang_word": "offspring",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "offspring",
