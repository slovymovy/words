                                            {
                                                "example_id": "ff776948-db15-4dd2-837f-87bc54bbd98f",
                                                "sense_id": "82685156-5617-3252-81a6-8c68a310dcb0",
                                                "text": "У меня есть заметки по поводу."
                                            },
                                            {
                                                "example_id": "199948e4-ebc4-4a76-a392-6a24cfa7fc73",
                                                "sense_id": "82685156-5617-3252-81a6-8c68a310dcb0",
                                                "text": "Но в этом и была особенность работ Уткина: их удуманностью и построением недосказанных ещё форм они вырывались за порядок этюда «по поводу» и делались самоценными."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c099c177-8090-3373-9388-e07cf557889e",
                                        "entry_id": "ed018eff-7893-36d7-8616-0ea5ac212c42",
                                        "glosses": [
