                        ],
                        "examples": [
                            {
                                "example_id": "7b4b8d20-ed35-4f15-97cd-a4f06f4511ec",
                                "sense_id": "8f93cd97-2874-3376-9d66-bedcee469d0f",
                                "text": "Uiteraard bood een laserpistool geen bedreiging voor de kooi van de ruimtelift of het vertrekkende ruimtevaartuig, maar in tegenstelling tot een traditioneel geweer kon er een groot aantal lasers worden gericht op één enkel punt."
                            },
                            {
                                "example_id": "5eaddfec-6ee6-4064-97b7-71606e52ce49",
                                "sense_id": "8f93cd97-2874-3376-9d66-bedcee469d0f",
                                "text": "De reisgenoot houdt iets heel anders vast, namelijk een laserpistool."
                            },
                            {
                                "example_id": "1d647cc6-5e8f-477a-a5e4-4586d43ebfe6",
                                "sense_id": "8f93cd97-2874-3376-9d66-bedcee469d0f",
                                "text": "\"Het is een mega-groot project\", zegt associate professor Stephanie Wehner van de TU Delft. \"Je moet je voorstellen dat je op een satelliet staat en met een laserpistool iets op aarde probeert te raken. Zo moeilijk is kwantumcommunicatie over lange afstanden.\""
                            }
                        ]
                    }
