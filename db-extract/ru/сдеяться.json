                "senses": [
                    {
                        "sense_id": "5dd9374e-c98d-3d0f-b898-cbc3e47b6489",
                        "entry_id": "0ee40ee3-1f43-34f5-b706-2d342081fc45",
                        "glosses": [
                            "устар., рег. сделаться; случиться; статься; сбыться, исполниться; свершиться; приключиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8166863-3bd0-49bc-99f2-d498d37f3cef",
                                "sense_id": "5dd9374e-c98d-3d0f-b898-cbc3e47b6489",
                                "text": "А что сдеяться могло? Чай, нигде не горит."
                            },
                            {
                                "example_id": "a6aa08ba-76c0-42e0-9eff-68be270cf2b5",
                                "sense_id": "5dd9374e-c98d-3d0f-b898-cbc3e47b6489",
                                "text": "Провозглашение брака ему казалось нелепостью: «Правда, с таким чудотворцем всё сдеется; для зла людям живёт.»"
                            },
                            {
                                "example_id": "93212c41-1584-484b-bd1d-3bb9855d297a",
                                "sense_id": "5dd9374e-c98d-3d0f-b898-cbc3e47b6489",
                                "text": "Да что ж, говорю, с ним сдеется, с хряком-то?"
                            }
                        ]
                    }
                ],
