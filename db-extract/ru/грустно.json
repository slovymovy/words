        "ru-extract.jsonl": [
            {
                "entry_id": "77aa13a1-91ce-30cc-b4bd-ef8b63b4e80d",
                "word": "грустно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1647a2f0-55a8-382e-9a8c-e27ab1a31896",
                        "entry_id": "77aa13a1-91ce-30cc-b4bd-ef8b63b4e80d",
                        "glosses": [
                            "наречие к грустный; испытывая или выражая грусть"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "cbfeac31-7f05-4da7-8760-620e75123ad1",
                                "sense_id": "1647a2f0-55a8-382e-9a8c-e27ab1a31896",
                                "text": "— Мне и грустно, и рад я, что еду, — продолжал он. — Отчего грустно, я не знаю."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcdff88d-bb9e-4650-98df-5bd418f51729",
                        "source_entry_id": "77aa13a1-91ce-30cc-b4bd-ef8b63b4e80d",
                        "source_sense_id": "1647a2f0-55a8-382e-9a8c-e27ab1a31896",
                        "source_sense_description": "нареч. к грустный",
                        "target_lang_word": "sadly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sadly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bdac360-dbee-34b6-982f-ff1d605331d5",
                                        "entry_id": "59460819-6f7c-3f2d-ae80-6569fc152079",
                                        "glosses": [
                                            "In a sad manner; sorrowfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "529f1844-2e6e-4fc6-af81-edb289395b38",
                                                "sense_id": "9bdac360-dbee-34b6-982f-ff1d605331d5",
                                                "text": "“Only when we climb up can we see it,” he said sadly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74575692-2332-325d-bc13-7b85f9e02e4c",
                                        "entry_id": "59460819-6f7c-3f2d-ae80-6569fc152079",
                                        "glosses": [
                                            "Unfortunately, sad to say."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e0964bd-27ae-4666-aca3-d3b7d7c36207",
                                                "sense_id": "74575692-2332-325d-bc13-7b85f9e02e4c",
                                                "text": "If you think you’re getting out of this place alive, you are sadly mistaken, my friend."
                                            },
                                            {
                                                "example_id": "b17756d0-749d-4bc4-94db-7bf904012daa",
                                                "sense_id": "74575692-2332-325d-bc13-7b85f9e02e4c",
                                                "text": "Sadly, the two were never to meet again."
                                            },
                                            {
                                                "example_id": "9f744ee0-d37f-4e15-aa05-6060b3696a8d",
                                                "sense_id": "74575692-2332-325d-bc13-7b85f9e02e4c",
                                                "text": "Before kick-off, a section of Chelsea's support sadly let themselves and their club down by noisily interrupting the silence held in memory of the Hillsborough disaster and for Livorno midfielder Piermario Morosini, who collapsed and died after suffering a heart attack during a Serie B game on Saturday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ce4f8f1-a94e-3c01-9c35-f16a6eb6ff23",
                                        "entry_id": "59460819-6f7c-3f2d-ae80-6569fc152079",
                                        "glosses": [
                                            "In a manner to cause sadness; badly; terribly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3b263d3-18b1-402b-8f1a-5c52c1e0f944",
                                                "sense_id": "4ce4f8f1-a94e-3c01-9c35-f16a6eb6ff23",
                                                "text": "The people of Ebeltoft were once sadly plagued by them, as they plundered their pantries in a most unconscionable manner; so they consulted a very wise and pious man and his advice was, that they should hang a bell in the steeple of the church."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "137725de-f8bd-36ac-b4bc-105465fbe964",
                                        "entry_id": "59460819-6f7c-3f2d-ae80-6569fc152079",
                                        "glosses": [
                                            "Very much (of a desire etc.); dearly; urgently."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86e7a445-8b43-4025-b3e1-a631670ef28e",
                                                "sense_id": "137725de-f8bd-36ac-b4bc-105465fbe964",
                                                "text": "\"Don't ask me: don't make me talk of it,\" she answered. \"I'm not fit now. I have been cruelly used and cruelly wronged. You will be kinder than ever, if you will walk on fast, and not speak to me. I sadly want to quiet myself, if I can.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc809da5-f620-364c-94cb-ce70f6cd066a",
                                        "entry_id": "59460819-6f7c-3f2d-ae80-6569fc152079",
                                        "glosses": [
                                            "Deeply, completely."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e242634e-fe64-471a-bceb-4c71f169fdc8",
                                                "sense_id": "cc809da5-f620-364c-94cb-ce70f6cd066a",
                                                "text": "By my feythe sayd syre launcelot in that pauelione wil I lodge alle this nyghte / and soo there he alyghte doune and tayed his hors to the pauelione / and there he vnarmed hym / and there he fond a bedde / and layd hym theryn / and felle on slepe sadly"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d97fa47e-48be-433e-a54e-de5652d80822",
                        "source_entry_id": "77aa13a1-91ce-30cc-b4bd-ef8b63b4e80d",
                        "source_sense_id": "1647a2f0-55a8-382e-9a8c-e27ab1a31896",
                        "source_sense_description": "нареч. к грустный",
                        "target_lang_word": "sorrowfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorrowfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3d835f4-a148-35ca-af9f-fb73174aa508",
                                        "entry_id": "73756503-4999-392b-bc1b-7400a022e532",
                                        "glosses": [
                                            "In a sorrowful manner; with sorrow and regret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee5c3983-77cf-483f-9e73-34b1a221f7aa",
                                                "sense_id": "a3d835f4-a148-35ca-af9f-fb73174aa508",
                                                "text": "They sent a pleasant and refreshing fragrance far around, and shook sorrowfully the leaves of their white flowers over the reflected picture of the landscape in the mirror of the lake, which on all sides was surrounded by pine trees and mossy cliffs."
                                            },
                                            {
                                                "example_id": "36fa13fe-390f-41af-a7b0-89b73242876d",
                                                "sense_id": "a3d835f4-a148-35ca-af9f-fb73174aa508",
                                                "text": "Sorrowfully Dorothy left the Throne Room and went back where the Lion and the Scarecrow and the Tin Woodman were waiting to hear what Oz had said to her. \"There is no hope for me,\" she said sadly, \"for Oz will not send me home until I have killed the Wicked Witch of the West; and that I can never do.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
