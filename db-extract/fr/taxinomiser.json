                "senses": [
                    {
                        "sense_id": "3faf10d9-7324-3b38-b7cb-0721f77d5091",
                        "entry_id": "4f91cfac-3f3e-33fa-a4d3-c21a362ac5af",
                        "glosses": [
                            "Classer dans une taxinomie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3c626e1-f988-4003-abab-5e0bd5064672",
                                "sense_id": "3faf10d9-7324-3b38-b7cb-0721f77d5091",
                                "text": "Parce qu'il ne \"générativise\" plus, un aphasique de Broca \"taxinomise\" trop ; il ne fait plus que cela."
                            },
                            {
                                "example_id": "ee219d4c-eeb5-45e8-8518-1b8cc91520b6",
                                "sense_id": "3faf10d9-7324-3b38-b7cb-0721f77d5091",
                                "text": "Sans aller aussi loin dans le mépris, on admettra que classer ou taxinomiser, c’est hiérarchiser"
                            },
                            {
                                "example_id": "5b418b0a-ed4a-4597-8abc-82bf35c35837",
                                "sense_id": "3faf10d9-7324-3b38-b7cb-0721f77d5091",
                                "text": "Après, les autorités ont fait que raffiner, ranger, taxinomiser les trucs que les ancêtres se refilaient de visu sans rien écrire, rien publier."
                            }
                        ]
                    }
