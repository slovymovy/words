                "senses": [
                    {
                        "sense_id": "57af521b-333d-395c-b9a9-70bdf9d80099",
                        "entry_id": "18f68419-b011-323f-b880-9b8fac4a6584",
                        "glosses": [
                            "een verboden, onwettige, criminele handeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70d79a3e-a209-44f2-a5bd-d0c2b574ea90",
                                "sense_id": "57af521b-333d-395c-b9a9-70bdf9d80099",
                                "text": "e commissie die het besluitvoorstel van deputaten voorbereidde, was „geschokt” door de „volstrekt onverantwoorde euveldaad” van de kerk van Zwolle."
                            },
                            {
                                "example_id": "329c1e77-95e2-400f-a9be-304de9da00ec",
                                "sense_id": "57af521b-333d-395c-b9a9-70bdf9d80099",
                                "text": "Mocht uit het onderzoek blijken dat sommige brandweerlui aan het filmpje hebben meegewerkt of de opname ervan hebben toegestaan, dreigt hen een zware straf wegens overtreding van hun gedragscode. Volgens de krant Los Angeles Times komen de euveldaden uit twee kazernes: Venice Beach en Hollywood."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca3c05d7-dece-492d-9456-fd64d43d38cd",
