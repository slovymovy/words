                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жеребёнок",
                                "target_lang_sense_clarification": "молодой конь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fc88080-6317-33c7-9635-8d8a6d2f54a2",
                    "sense_definition": "A male turkey; a turkeycock.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A large <w>stag</w> strutted across the farmyard, fanning its feathers.",
                            "target_lang_translations": {
                                "ru": "Крупный <w>индюк</w> важно расхаживал по птичьему двору, распушив перья."
                            }
                        },
                        {
                            "text": "The flock was led by an aggressive <w>stag</w> that chased visitors away.",
                            "target_lang_translations": {
                                "ru": "Стаю возглавлял агрессивный <w>индюк</w>, который отгонял посетителей."
                            }
