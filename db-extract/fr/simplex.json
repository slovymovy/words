            {
                "entry_id": "c254bbbc-ef33-31a2-81f5-7b004b78da6d",
                "word": "simplex",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d7c6d03b-aec5-3056-86ef-5d53c4b0c7ee",
                        "entry_id": "c254bbbc-ef33-31a2-81f5-7b004b78da6d",
                        "glosses": [
                            "Liaison qui transmet l’information dans un seul sens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdd88703-4171-48a8-976a-eb68dc0ddf01",
                                "sense_id": "d7c6d03b-aec5-3056-86ef-5d53c4b0c7ee",
                                "text": "Les téléscripteurs qui donnaient jadis les résultats des courses dans les bureaux de tabac assurant le service du pari mutuel urbain étaient alimentées par des liaisons simplex."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "173ae7d0-b9c4-4a6e-a020-af147fbcda8c",
                        "source_entry_id": "c254bbbc-ef33-31a2-81f5-7b004b78da6d",
                        "source_sense_id": "d7c6d03b-aec5-3056-86ef-5d53c4b0c7ee",
                        "target_lang_word": "Simplex",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Simplex",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76c1039c-7e38-3821-a9a3-cfec0119c2a9",
                                        "entry_id": "b079f51b-7930-3386-82b0-7c5f5bfda94e",
                                        "glosses": [
                                            "Wort, das nur aus einem Grundmorphem und bei Bedarf einem oder mehreren Flexionsmorphemen (Flexiven) besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "641c078a-3ef2-41ff-b783-7c80e88fd8af",
                                                "sense_id": "76c1039c-7e38-3821-a9a3-cfec0119c2a9",
                                                "text": "Aus Simplizia kann man Ableitungen und Komposita bilden."
                                            },
                                            {
                                                "example_id": "9b7eb7a3-e875-4f4d-8cf7-051b113e8faa",
                                                "sense_id": "76c1039c-7e38-3821-a9a3-cfec0119c2a9",
                                                "text": "„Auto“, „groß“, „Haus“, „schön“, „Tor“ sind einschließlich ihrer flektierten Formen Simplizia."
                                            },
                                            {
                                                "example_id": "8147ee95-ec51-4ec5-b9dd-0bc5d7393d5a",
                                                "sense_id": "76c1039c-7e38-3821-a9a3-cfec0119c2a9",
                                                "text": "„… bei der Komposition oder Präfigierung nennt man das einfache Grundwort Simplex.“"
                                            },
                                            {
                                                "example_id": "d7282131-9ab2-480f-a2b6-285c72d7b9b1",
                                                "sense_id": "76c1039c-7e38-3821-a9a3-cfec0119c2a9",
                                                "text": "„Es sind, wie die Simplizia, überwiegend naturräumliche Stellenbezeichnungen (-berg, -brook, -horst) und nur wenige Heim- / Haus-Synonyme (-stede, -bur).“"
                                            },
                                            {
                                                "example_id": "c9d806b7-eaaf-4ed4-8406-39aeb1308f57",
                                                "sense_id": "76c1039c-7e38-3821-a9a3-cfec0119c2a9",
                                                "text": "„Ähnlich wie bei den Gewässernamen lassen sich bei den ON verschiedene morphologische Strukturtypen beobachten, nämlich Simplicia, Derivata und Komposita (…).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "daafd722-2ee4-3c2a-91c1-03056d8f08a6",
                                        "entry_id": "b079f51b-7930-3386-82b0-7c5f5bfda94e",
                                        "glosses": [
                                            "auch n-Simplex, n-dimensionales Polytop mit n+1-Ecken"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc8af62a-e446-4a07-a073-780c0f7e9a4a",
                                                "sense_id": "daafd722-2ee4-3c2a-91c1-03056d8f08a6",
                                                "text": "„Dieser erste Körper war das Tetraeder, das Simplex des Raumes.“"
                                            },
                                            {
                                                "example_id": "5725c508-77ba-45c6-b5f3-1dcbaf77e306",
                                                "sense_id": "daafd722-2ee4-3c2a-91c1-03056d8f08a6",
                                                "text": "„Wir bemerken weiter: Die Simplexe von Z(T) sind ähnlich der zu T konjugierten.“"
                                            },
                                            {
                                                "example_id": "274ecc59-8452-4628-8f9a-f1647e50cdfe",
                                                "sense_id": "daafd722-2ee4-3c2a-91c1-03056d8f08a6",
                                                "text": "Ein Tetraeder ist ein 3-Simplex."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96695dde-3faa-3438-844e-c652edbe1b6e",
                                        "entry_id": "b079f51b-7930-3386-82b0-7c5f5bfda94e",
                                        "glosses": [
                                            "Informationstransfer über einen Kanal, der nur in einer Richtung erfolgen kann"
                                        ],
                                        "tags": [
                                            "Nachrichtentechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21aa0a4b-5570-432b-b3ad-473280f6af59",
                                                "sense_id": "96695dde-3faa-3438-844e-c652edbe1b6e",
                                                "text": "„Simplex bezeichnet eine Datenübertragung nur in einer Richtung (Beispiel Datenübertragung von einer Wetterstation zum Empfänger).“"
                                            },
                                            {
                                                "example_id": "1a70fa5d-a3ee-403b-b8de-8d5d2a72f29c",
                                                "sense_id": "96695dde-3faa-3438-844e-c652edbe1b6e",
                                                "text": "„Simplex bedeutet, das Daten in jeweils nur einer Richtung gleichzeitig übertragen werden können. Radio und TV verwenden Simplexübertragungen.“"
                                            },
                                            {
                                                "example_id": "4aa03950-b0a9-4979-b7c0-7198c01f6147",
                                                "sense_id": "96695dde-3faa-3438-844e-c652edbe1b6e",
                                                "text": "„Grundsätzlich unterscheidet man zwischen Simplex und Duplex.“"
                                            },
                                            {
                                                "example_id": "5b8bfe65-c3c9-42be-a2ce-20edc5373c24",
                                                "sense_id": "96695dde-3faa-3438-844e-c652edbe1b6e",
                                                "text": "„Die nichtöffentliche Mobilfunktechnik hat sich aus Kostengründen zunächst weitgehend auf die Betriebsarten Simplex und Semi- oder Halbduplex…“"
                                            },
                                            {
                                                "example_id": "b7e27657-712f-47cf-9555-76b6cb46d67f",
                                                "sense_id": "96695dde-3faa-3438-844e-c652edbe1b6e",
                                                "text": "„Simplex (SX) ist ein Einwegbetrieb in Bezug auf die Übertragungsart.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
