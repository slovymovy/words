                ],
                "senses": [
                    {
                        "sense_id": "35407439-4d28-35cd-afcc-a2473c5d8b97",
                        "entry_id": "ebce70ba-687d-3126-92df-1d39bdc50de7",
                        "glosses": [
                            "Person, die einen Putsch plant und/oder durchführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f4fb367-fe50-492c-9312-0449815038ae",
                                "sense_id": "35407439-4d28-35cd-afcc-a2473c5d8b97",
                                "text": "„Die Putschisten schlugen am 1. November los.“"
                            },
                            {
                                "example_id": "06c558ad-64df-40b2-9103-895119cc4eaa",
                                "sense_id": "35407439-4d28-35cd-afcc-a2473c5d8b97",
                                "text": "„Die Putschisten hatten den Flughafen geschlossen, das Telefonnetz der Stadt lahmgelegt, die Zentrale des Polizeihauptquartiers gestürmt, den Regierungssender besetzt und die Zentren der politischen Macht angegriffen.“"
                            },
                            {
                                "example_id": "b0b684f2-3ac6-4c16-a309-7bdde7f920d7",
                                "sense_id": "35407439-4d28-35cd-afcc-a2473c5d8b97",
                                "text": "„Nach drei Jahren auf dem Thron wird Iyasus 1916 von Putschisten abgesetzt, seine Truppen unterliegen in mehreren Schlachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46a3bf00-fe53-4133-9595-2b2ee2877442",
                        "source_entry_id": "ebce70ba-687d-3126-92df-1d39bdc50de7",
                        "source_sense_id": "35407439-4d28-35cd-afcc-a2473c5d8b97",
                        "source_sense_description": "Person, die einen Putsch plant und/oder durchführt",
                        "target_lang_word": "putschist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "putschist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84fb0c17-42be-3586-823e-7f7207e3fdfe",
                                        "entry_id": "394a84dd-4a0f-3c66-97da-9d98aabd9d83",
                                        "glosses": [
                                            "One who participates in a putsch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5993fff-12ab-498a-ada7-94e4dc2e2d4f",
                                                "sense_id": "84fb0c17-42be-3586-823e-7f7207e3fdfe",
                                                "text": "The Forum itself would always, henceforth, wield a strange kind of mesmeric fascination upon the mob demagogue or would-be putschist."
                                            },
                                            {
                                                "example_id": "ee9b61f9-977d-4f0b-a384-4111da70bd3c",
                                                "sense_id": "84fb0c17-42be-3586-823e-7f7207e3fdfe",
                                                "text": "The alleged putschists are said to have taken inspiration from the global QAnon movement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
