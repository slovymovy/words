                    "sense_id": "7123bc39-377d-3d10-91af-0693163ad15b",
                    "sense_definition": "het plotseling omlaag vallen of in elkaar zakken van een constructie of gebouw",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysiek bezwijken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het oude huis is volledig <w>ingestort</w> nadat het getroffen was door een zware wervelwind.",
                            "target_lang_translations": {
                                "en": "The old house completely <w>collapsed</w> after it was hit by a heavy whirlwind."
                            }
                        },
                        {
                            "text": "De brandweer waarschuwt dat de muren van de fabriek op <w>instorten</w> staan.",
                            "target_lang_translations": {
                                "en": "The fire department warns that the walls of the factory are on the verge of <w>collapsing</w>."
                            }
                        }
                    ],
                    "synonyms": [
