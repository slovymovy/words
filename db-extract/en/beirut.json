                                "target_senses": [
                                    {
                                        "sense_id": "99e7eafe-7790-36f6-bf14-9c26a7ac1587",
                                        "entry_id": "b11e7eb4-e8d4-3434-b9f3-1b25f9a5e728",
                                        "glosses": [
                                            "Ville et capitale du Liban."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bb412af-b50b-42c0-855f-eeb7d2e19e82",
                                                "sense_id": "99e7eafe-7790-36f6-bf14-9c26a7ac1587",
                                                "text": "Il avait notamment une vénération pour Marcel Cerdan auquel il s'était identifié. Ce dernier avait été élevé à Casablanca, lui à Beyrouth, tous deux étaient poids welters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9147d717-bf2b-3579-9853-ee85b268a7c6",
                                        "entry_id": "b11e7eb4-e8d4-3434-b9f3-1b25f9a5e728",
                                        "glosses": [
                                            "Le gouvernement libanais."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "891dfce6-1e28-3e80-985b-bbff9bbc8b86",
                                        "entry_id": "b11e7eb4-e8d4-3434-b9f3-1b25f9a5e728",
                                        "glosses": [
                                            "Le chaos."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "note": "Généralement urbain, en référence à la guerre du Liban (1975-1990). Son utilisation est jugée méprisante et anachronique par les Libanais",
                                        "examples": [
                                            {
                                                "example_id": "f147a403-6ada-4d15-8eae-6e94afd810b7",
                                                "sense_id": "891dfce6-1e28-3e80-985b-bbff9bbc8b86",
                                                "text": "Arrivé sur ce rondpoint en contrebas du périphérique, face au stade Charléty, « c’est Beyrouth », selon un policier. Des véhicules incendiés fument encore, d’autres sont abandonnés au milieu de la chaussée. Des douilles jonchent le sol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ebb6a12-ce72-459c-aad0-b6a67ee476c0",
                        "source_entry_id": "fc178395-4063-35fa-b6ba-4e1be7427636",
                        "source_sense_description": "capital and largest city of Lebanon",
                        "target_lang_word": "Beirut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beirut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "702acefb-171a-3dd9-bc4e-e579414db31f",
                                        "entry_id": "fa324aa0-3977-3965-9a14-bb54f48bc4d1",
                                        "glosses": [
                                            "Hauptstadt des Libanons"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2a53371-7a25-449d-b58a-63aa37d8a624",
                                                "sense_id": "702acefb-171a-3dd9-bc4e-e579414db31f",
                                                "text": "„In Beirut war eine Autobombe explodiert, und nun zeigten sie die zertrümmerten Häuser, die weinenden Augenzeugen, die zerrissenen Leichen.“"
                                            },
                                            {
                                                "example_id": "b455c09a-9b54-4607-a8e7-83705d9d2c57",
                                                "sense_id": "702acefb-171a-3dd9-bc4e-e579414db31f",
                                                "text": "„Diese Süßigkeiten da habe ich letzte Woche aus Beirut mitgebracht.“"
                                            },
                                            {
                                                "example_id": "eceb9374-c8fa-4e60-9966-b29f7ff0476d",
                                                "sense_id": "702acefb-171a-3dd9-bc4e-e579414db31f",
                                                "text": "„Einen ganzen Monat verbrachte ich in Beirut damit, durch die Stadt zu streifen, sie kennenzulernen.“"
                                            },
                                            {
                                                "example_id": "3824beae-c4b3-4d62-9b15-85b2f9336970",
                                                "sense_id": "702acefb-171a-3dd9-bc4e-e579414db31f",
                                                "text": "„Die jüngsten Turbulenzen in Beirut nähren aber offenbar so sehr die Furcht vor einer neuen bürgerkriegsartigen Eskalation, dass beide Führer sich entschlossen haben, in einer gemeinsamen Mission die Gemüter im Libanon zu beruhigen.“"
                                            },
                                            {
                                                "example_id": "b659d9c0-2793-4c88-ad7b-f0f6ff566f26",
                                                "sense_id": "702acefb-171a-3dd9-bc4e-e579414db31f",
                                                "text": "„Wenige Tage zuvor hatten der saudische König und der syrische Diktator Beirut besucht, um vor Abenteuern zu warnen.“"
                                            },
                                            {
                                                "example_id": "480e7df7-43b7-4ffa-a689-d5fa9047ef1b",
                                                "sense_id": "702acefb-171a-3dd9-bc4e-e579414db31f",
                                                "text": "„Der Kinofilm Caramel von Regisseurin und Hauptdarstellerin Nadine Labaki spielt in einem Beauty-Salon in Beirut und zeigt das Alltagsleben von fünf Frauen im Libanon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
