                        "form": "eurafricaines"
                    },
                    {
                        "form_id": "e31cb50e-66d3-43dc-a612-dab15fe93883",
                        "entry_id": "4f5dbcca-8a7f-3f95-8b04-3be6c6647d7e",
                        "tags": [
                            "orthographe traditionnelle"
                        ],
                        "form": "euro-africain"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f241d93e-ebdb-321e-abac-f34a2cb29eb9",
                        "entry_id": "4f5dbcca-8a7f-3f95-8b04-3be6c6647d7e",
                        "glosses": [
                            "Qui concerne à la fois l’Europe et l’Afrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13e69a6d-10d8-4872-8360-25a6d2d9c8f1",
                                "sense_id": "f241d93e-ebdb-321e-abac-f34a2cb29eb9",
                                "text": "Même si la construction monétaire européenne n’atteint pas rapidement ce point d’achèvement, l’existence de l’écu et la participation de plusieurs États de la Communauté au système monétaire européen ouvrent déjà des perspectives de coopération monétaire eurafricaine."
                            },
                            {
                                "example_id": "dc87c826-fd09-49d6-9013-4f13169da7f1",
                                "sense_id": "f241d93e-ebdb-321e-abac-f34a2cb29eb9",
                                "text": "On envisage de convoquer, dans le courant de l’année prochaine, une conférence inter-parlementaire eurafricaine où seraient discutées les modalités d’une aide plus substantielle et mieux coordonnée de l’Europe (des Six ?) à l’« Afrique »."
                            },
                            {
                                "example_id": "65b6a443-cd0e-433d-bcac-d36b12bc8001",
                                "sense_id": "f241d93e-ebdb-321e-abac-f34a2cb29eb9",
                                "text": "Il a reconnu sans surprise que les crânes étudiés par M. Fouquet présentent une étroite ressemblance avec ceux de l’époque pharaonique antique et avec ceux attribués à la race méditéranéenne ou eurafricaine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b12b9e1-0ff4-499c-8924-69d768cf4535",
                        "source_entry_id": "4f5dbcca-8a7f-3f95-8b04-3be6c6647d7e",
                        "source_sense_id": "f241d93e-ebdb-321e-abac-f34a2cb29eb9",
                        "target_lang_word": "Eurafrican",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eurafrican",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8409c83-347d-38d5-9864-3fc2f64acedc",
                                        "entry_id": "2fe6912d-0e19-32bc-8a47-ffdc1077a7b9",
                                        "glosses": [
                                            "Of or relating to the continents of, or countries in, both Europe and Africa; having both European and African characteristics."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b11c444a-4987-459b-a15b-d2035a6612cc",
                                                "sense_id": "e8409c83-347d-38d5-9864-3fc2f64acedc",
                                                "text": "The Eurafrican substrate [hypothesis] is based mainly on comparisons between Sardinian, Berber and Basque, as well as on comparanda from Gallo-Romance and Insular Celtic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1ae3cc6-eb54-32e3-a95c-19560148ec75",
                                        "entry_id": "2fe6912d-0e19-32bc-8a47-ffdc1077a7b9",
                                        "glosses": [
                                            "Of a person: of mixed European and African descent; (specifically, South Africa) synonym of colored (“belonging to a multiracial ethnic group or category, having ancestry from more than one of the racial groups of Southern Africa (black, white, and Asian)”)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e576494e-3745-3f41-bb01-3f5488b578c2",
                                        "entry_id": "2fe6912d-0e19-32bc-8a47-ffdc1077a7b9",
                                        "glosses": [
                                            "Of a person: from the parts of Europe and North Africa surrounding the Mediterranean Sea."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Eurafrican",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60bda708-d5c6-3f86-9d9d-83de468448e5",
                                        "entry_id": "439fd861-f6f7-32ba-b72a-be920343b9c7",
                                        "glosses": [
                                            "A person of mixed European and African descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "065dd2c5-d710-49e1-8085-7cbc8ab046f5",
                                                "sense_id": "60bda708-d5c6-3f86-9d9d-83de468448e5",
                                                "text": "Just how cosmopolitan the town was is clear from the fact that two different races are found buried in the graves: the dolichocephalic Eurafrican, and the brachycephalic Proto-Mediterranean."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee9d35b3-4f98-3caf-8cfd-f0d65fa27c78",
                                        "entry_id": "439fd861-f6f7-32ba-b72a-be920343b9c7",
                                        "glosses": [
                                            "A person of mixed European and African descent.",
                                            "An African person with European ancestors."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62d8fc61-040e-3154-a496-a92940f4b059",
                                        "entry_id": "439fd861-f6f7-32ba-b72a-be920343b9c7",
                                        "glosses": [
                                            "A person of mixed European and African descent.",
                                            "Synonym of colored (“a person having ancestry from more than one of the racial groups of Southern Africa (black, white, and Asian)”)."
                                        ],
                                        "tags": [
                                            "South-Africa"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
