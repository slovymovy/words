                                                "example_id": "39d6cac9-995b-4fa8-ab2e-808789378cfb",
                                                "sense_id": "db7939bd-a8a6-3009-80df-b6dca4bedce3",
                                                "text": "„Sümpfe bedecken rund 3 Prozent der weltweiten Landoberfläche […].“"
                                            },
