                "senses": [
                    {
                        "sense_id": "8061463d-3a48-3b02-bc30-01b9d476f683",
                        "entry_id": "ed03c21c-999f-3cd8-b6b9-e0c9d3895827",
                        "glosses": [
                            "so, dass es nicht verwischt werden kann"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "48db6a38-c580-4625-877b-e8d97f3f0973",
                                "sense_id": "8061463d-3a48-3b02-bc30-01b9d476f683",
                                "text": "„Will man eine derartige Zeichnung unverwischbar machen, so muss man jedes Körnchen an der Stelle, an der es sich befindet, festkleben. Dies geschieht durch Übergiessen oder Bespritzen mit irgend einem Klebstoff.“"
                            },
                            {
                                "example_id": "78bc24af-b413-4a4b-b4cf-a79d5fe0bbdd",
                                "sense_id": "8061463d-3a48-3b02-bc30-01b9d476f683",
                                "text": "„Aus meiner frühesten Kindheit hebt sich ein Ereignis ab, das sich mir, trotz der langen Jahre, die dazwischen liegen, in seinen einzelnen Zügen unverwischbar eingeprägt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79175e04-0126-44b1-9c7e-af46c0394d17",
                        "source_entry_id": "ed03c21c-999f-3cd8-b6b9-e0c9d3895827",
                        "source_sense_id": "8061463d-3a48-3b02-bc30-01b9d476f683",
                        "source_sense_description": "auch übertragen: so, dass es nicht verwischt werden kann",
                        "target_lang_word": "ineffaceable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ineffaceable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86c62226-3114-32a6-b45c-a83ba197a74a",
                                        "entry_id": "68f7b9a7-6196-3328-8050-5e3861eb1388",
                                        "glosses": [
                                            "Incapable of being effaced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eb47968-7902-4c6f-8744-7a438ede915e",
                                                "sense_id": "86c62226-3114-32a6-b45c-a83ba197a74a",
                                                "text": "Mr. Disbrowe was reclining on a well-worn horsehair-covered sofa, his frequent reclinings on which piece of furniture had stamped a deep and quite ineffaceable impression of his weighty form upon the cushion."
                                            },
                                            {
                                                "example_id": "a268682a-999f-446b-b3cc-b50db94ed010",
                                                "sense_id": "86c62226-3114-32a6-b45c-a83ba197a74a",
                                                "text": "[…] I am sure of one thing,—scars are plenty enough in Germany, among the young men; and very grim ones they are, too. They criss-cross the face in angry red welts, and are permanent and ineffaceable."
                                            },
                                            {
                                                "example_id": "032fb158-5192-4b2a-869a-97fe345fee4c",
                                                "sense_id": "86c62226-3114-32a6-b45c-a83ba197a74a",
                                                "text": "Although the country branch lines may pass, they leave with those who have known them so well an ineffaceable memory[,] and for those who will follow after[,] a memorial in the form of embankment, cutting and tunnel with here and there a station building or railway cottage that time does not destroy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
