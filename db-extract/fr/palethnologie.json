                "senses": [
                    {
                        "sense_id": "b57e9f4f-8d9e-3853-9158-2365a69275cc",
                        "entry_id": "c085febc-989b-32d4-bb54-a0d98d1f1fcc",
                        "glosses": [
                            "Branche de l’ethnologie qui étudie l'homme préhistorique d'après ses traces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06098e25-08bf-4a0b-87c9-32427a9406c3",
                                "sense_id": "b57e9f4f-8d9e-3853-9158-2365a69275cc",
                                "text": "La Palethnologie est une science, qui a pour but l'étude de l'Ноmme, envisagée au point de vue de son origine, de ses mœurs, de son industrie, depuis sa première apparition sur notre globe, jusqu'au jour où des documents écrits nous permettent de reconstituer l'Histoire proprement dite."
                            },
                            {
                                "example_id": "cc4c22fc-993e-48b4-985a-5fe1ec9b697c",
                                "sense_id": "b57e9f4f-8d9e-3853-9158-2365a69275cc",
                                "text": "Les trois royaumes scandinaves n'oublient pas les progrès qu'ils ont fait faire à la palethnologie à ses débuts, et l'activité scientifique ne s'y est pas ralentie depuis le congrès de Stockholm qui fut fécond en résultats."
                            }
                        ]
                    }
                ],
