                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement_past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он прошёл <w>мимо</w> и даже не посмотрел на нас.",
                            "target_lang_translations": {
                                "en": "He walked <w>past</w> and didn't even look at us.",
                                "nl": "Hij liep <w>voorbij</w> en keek niet eens naar ons.",
                                "pl": "Przeszedł <w>obok</w> i nawet na nas nie spojrzał.",
                                "de": "Er ging <w>vorbei</w> und sah uns nicht einmal an.",
                                "fr": "Il est passé <w>à côté</w> de nous sans même nous regarder.",
                                "it": "È passato <w>oltre</w> e non ci ha nemmeno guardato.",
                                "cs": "Prošel <w>kolem</w> a ani se na nás nepodíval.",
                                "tr": "Yanımızdan <w>geçip gitti</w> ve bize bakmadı bile.",
                                "es": "Él pasó <w>de largo</w> y ni siquiera nos miró.",
                                "zh": "他<w>经过</w>时甚至没看我们一眼。"
                            }
                        },
                        {
                            "text": "Поезд промчался <w>мимо</w> с огромной скоростью.",
                            "target_lang_translations": {
                                "en": "The train rushed <w>past</w> at huge speed.",
                                "nl": "De trein raasde met enorme snelheid <w>voorbij</w>.",
                                "pl": "Pociąg przejechał <w>obok</w> z ogromną prędkością.",
                                "de": "Der Zug raste mit hoher Geschwindigkeit <w>vorbei</w>.",
                                "fr": "Le train est passé <w>à toute vitesse</w>.",
                                "it": "Il treno è sfrecciato <w>oltre</w> a grande velocità.",
                                "cs": "Vlak projel <w>kolem</w> obrovskou rychlostí.",
                                "tr": "Tren büyük bir hızla <w>yanımızdan</w> geçti.",
                                "es": "El tren pasó <w>de largo</w> a gran velocidad.",
                                "zh": "火车高速<w>经过</w>。"
