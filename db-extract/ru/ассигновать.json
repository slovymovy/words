                "senses": [
                    {
                        "sense_id": "a9523999-16a6-33a5-b88e-24ae01ee0e5a",
                        "entry_id": "760f3063-c01d-3ca9-bb46-c529f2270ccf",
                        "glosses": [
                            "офиц., фин. включить (включать) в смету, назначить (назначать) выдачу известной суммы на какую-нибудь определённую цель"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9797ff6d-71be-413e-a82d-60cb684b6406",
                                "sense_id": "a9523999-16a6-33a5-b88e-24ae01ee0e5a",
                                "text": "На ремонт школы предполагается ассигновать 3000 рублей."
                            }
                        ]
                    },
                    {
                        "sense_id": "0dbe61c9-2b73-3f42-abc7-32356d8b4717",
                        "entry_id": "760f3063-c01d-3ca9-bb46-c529f2270ccf",
                        "glosses": [
                            "разг. наметить (намечать) к израсходованию, дать (давать) на расходы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87e3c2b9-267c-4fbf-8abe-d232899728ac",
                                "sense_id": "0dbe61c9-2b73-3f42-abc7-32356d8b4717",
                                "text": "На театр я могу ассигновать только 10 рублей в месяц."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62a9672b-8bcd-4751-ac89-56ddd14a8cba",
                        "source_entry_id": "760f3063-c01d-3ca9-bb46-c529f2270ccf",
                        "target_lang_word": "assegnare",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assegnare",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "ff530561-03af-34ac-88f5-7f629aaaa635",
