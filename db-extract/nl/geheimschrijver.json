                        "entry_id": "40f1cd6b-e8ba-3f15-9e3e-a2808bb335b8",
                        "glosses": [
                            "someone who conducts the confidential, or secret, correspondence of a high official; a (cryptography) cryptographer"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "454ae22d-3a2f-4845-93ac-76c2355351f1",
                                "sense_id": "20971327-574e-3dd2-aa2a-84cd467b1802",
                                "text": "Hij zag Oude Hare Hoogheid in het zwart met aan haar rechterhand De Back, voorheen secretaris van de Domeinraad maar dank zij de wende opgestegen tot 's Prinsen geheimschrijver en rekwestmeester voor de ambtenaren.",
                                "translation": "He saw Old Her Highness in black with De Back on her right hand, formerly secretary of the Domain Council, but thanks to the revolution, he had risen to become the prince's geheimschrijver and account manager for the officials.",
                                "english": "He saw Old Her Highness in black with De Back on her right hand, formerly secretary of the Domain Council, but thanks to the revolution, he had risen to become the prince's geheimschrijver and account manager for the officials."
                            },
                            {
                                "example_id": "1a3e77ad-0ac1-487f-8e02-b2a5582f0b75",
                                "sense_id": "20971327-574e-3dd2-aa2a-84cd467b1802",
                                "text": "Een van de aanvoerders van die troepen was Olivier Cromwell. Het parlement won, koning Karel I werd onthoofd en Cromwell werd Lord Protector van Engeland. De geleerde Milton werd zijn geheimschrijver.",
                                "translation": "One of the leaders of those troops was Oliver Cromwell. Parliament won, King Charles I was beheaded and Cromwell became Lord Protector of England. The scholar Milton became his geheimschrijver.",
                                "english": "One of the leaders of those troops was Oliver Cromwell. Parliament won, King Charles I was beheaded and Cromwell became Lord Protector of England. The scholar Milton became his geheimschrijver."
                            }
                        ]
