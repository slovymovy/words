    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "31ae00c1-0d43-3035-9e2b-43ac1d66ecb0",
                    "sense_definition": "Iets of iemand minder sterk maken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verzwakken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het weinige slapen zal hun weerstand <w>verzwakken</w>.",
                            "target_lang_translations": {
                                "en": "The lack of sleep will <w>weaken</w> their resistance."
                            }
                        },
                        {
                            "text": "Volgens hem heeft het stadsleven veel van onze zintuigen <w>verzwakt</w>.",
                            "target_lang_translations": {
                                "en": "According to him, city life has <w>weakened</w> many of our senses."
                            }
                        }
                    ],
                    "synonyms": [
                        "ondermijnen"
                    ],
                    "antonyms": [
                        "versterken"
                    ],
                    "common_phrases": [
                        "positie verzwakken",
                        "weerstand verzwakken"
                    ],
                    "target_lang_definitions": {
                        "en": "To make something or someone less strong."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "weaken",
                                "target_lang_sense_clarification": "transitive: to cause something to become less strong or effective"
                            },
                            {
                                "target_lang_word": "undermine",
                                "target_lang_sense_clarification": "to gradually weaken someone or something, often their authority or confidence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d42d133a-dec8-3e7b-bee2-7cace37c9321",
                    "sense_definition": "Minder sterk worden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verzwakken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>verzwakken</w> door een tekort aan slaap.",
                            "target_lang_translations": {
                                "en": "They are <w>weakening</w> due to a lack of sleep."
                            }
                        },
                        {
                            "text": "De storm zal in de loop van de nacht langzaam <w>verzwakken</w>.",
                            "target_lang_translations": {
                                "en": "The storm will slowly <w>weaken</w> during the night."
                            }
                        }
                    ],
                    "synonyms": [
                        "afnemen",
                        "verslappen"
                    ],
                    "antonyms": [
                        "versterken"
                    ],
                    "common_phrases": [
                        "storm verzwakt"
                    ],
                    "target_lang_definitions": {
                        "en": "To become less strong."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "weaken",
                                "target_lang_sense_clarification": "intransitive: to lose strength or intensity"
                            },
                            {
                                "target_lang_word": "fade",
                                "target_lang_sense_clarification": "to gradually lose strength, intensity, or clarity"
                            }
                        ]
                    }
                }
            ]
        }
    ]
