                    }
                ],
                "senses": [
                    {
                        "sense_id": "6fe05d33-8d8f-345f-9d1f-63b0cb626219",
                        "entry_id": "8e860b17-ac23-3d8e-bafa-054ad2ba7b7c",
                        "glosses": [
                            "In a random manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "705c4769-cfe6-4852-89ca-db421665512d",
                                "sense_id": "6fe05d33-8d8f-345f-9d1f-63b0cb626219",
                                "text": "It is easy to implement, is not cost-prohibitive, and provides unbiased randomly sampled data in an ethically acceptable manner."
                            },
                            {
                                "example_id": "4959182c-db48-4fad-9039-9a9d3a4c593c",
                                "sense_id": "6fe05d33-8d8f-345f-9d1f-63b0cb626219",
                                "text": "Every microgame lasts five seconds until it shifts to the next randomly selected ruleset."
                            },
                            {
                                "example_id": "63ec5c8e-1de7-4f9d-aa81-65b24ef0a3f0",
                                "sense_id": "6fe05d33-8d8f-345f-9d1f-63b0cb626219",
                                "text": "I just randomly remembered this dream from 2 years ago."
                            }
                        ]
                    },
                    {
                        "sense_id": "fab502c4-92f4-3c76-b042-b07a27cc0074",
                        "entry_id": "8e860b17-ac23-3d8e-bafa-054ad2ba7b7c",
                        "glosses": [
                            "By random access; at any point at a given time; not sequentially."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ccb4bb8-572e-41b0-821b-72e33db71486",
                                "sense_id": "fab502c4-92f4-3c76-b042-b07a27cc0074",
                                "text": "When a file is accessed randomly, the programmer must specify the relative record number."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cc54ca7-a9d0-4f83-80af-a54d5f2a9344",
                        "source_entry_id": "8e860b17-ac23-3d8e-bafa-054ad2ba7b7c",
                        "source_sense_description": "in a random way",
                        "target_lang_word": "en vrac",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en vrac",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "180fc38a-a321-3dff-8e1b-fe1a35752a93",
                                        "entry_id": "92574976-cff6-3a83-825f-05404b41efb0",
                                        "glosses": [
                                            "Sans être emballé, conditionné ou arrimé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a40b22c6-149f-486b-8c5f-7be190dc1eea",
                                                "sense_id": "180fc38a-a321-3dff-8e1b-fe1a35752a93",
                                                "text": "La vente en vrac ne supprime certes pas tous les emballages. Ces derniers restent nécessaires pour transporter le produit du lieu de production jusqu’au magasin, et de celui-ci jusque chez le consommateur, rappelle le Conseil national de l’emballage."
                                            },
                                            {
                                                "example_id": "de3ba22a-2114-4e94-9f2e-8f4bf9520c31",
                                                "sense_id": "180fc38a-a321-3dff-8e1b-fe1a35752a93",
                                                "text": "Des produits alimentaires (huiles végétales, jus de fruits) sont proches des produits dits chimiques, et leur transport en vrac nécessite des dispositions précises pour assurer leur maintien à la bonne température, faute de quoi leur qualité à la consommation humaine serait réduite ou détruite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7683a41-40d8-3430-b9d8-68ef400593ea",
                                        "entry_id": "92574976-cff6-3a83-825f-05404b41efb0",
                                        "glosses": [
                                            "Pêle-mêle, en désordre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d17453b7-39f4-4884-8518-a4b2bafb17e6",
                                                "sense_id": "e7683a41-40d8-3430-b9d8-68ef400593ea",
                                                "text": "Elle prit toutes les cravates et les jeta en vrac sur le linge, comme un nœud de serpents."
                                            },
                                            {
                                                "example_id": "883da781-301b-4337-8095-5fb4353af77d",
                                                "sense_id": "e7683a41-40d8-3430-b9d8-68ef400593ea",
                                                "text": "C’est un beau jeune homme brun, avec les cheveux un peu en vrac, une veste de jean toute neuve et des grands yeux de cocker pacifique."
                                            },
                                            {
                                                "example_id": "7404390d-15c9-4196-a952-c6dd98c53c88",
                                                "sense_id": "e7683a41-40d8-3430-b9d8-68ef400593ea",
                                                "text": "Il nous fallut les tuer avec de l’éther et les jeter au vide-ordures, la mort dans l’âme et l’estomac en vrac."
                                            },
                                            {
                                                "example_id": "02d460af-b789-4bd4-881c-c7a5bec60db0",
                                                "sense_id": "e7683a41-40d8-3430-b9d8-68ef400593ea",
                                                "text": "Après, nous avons, en vrac, les addicts au poker, aux jeux en ligne, au tchat, à Facebook. Et, pour finir, les addicts... au chocolat. Oui, au chocolat."
                                            },
                                            {
                                                "example_id": "89b85aa2-aaea-4aba-8493-9751380fe32c",
                                                "sense_id": "e7683a41-40d8-3430-b9d8-68ef400593ea",
                                                "text": "Quelle belle équipe à l'époque. Avec en vrac Hoogenboom, Henrotay, Dardenne, Dalving, Lubanski, Guy Hanssens, De Schrijver, Mommens, Somers..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f51d4f2c-9250-4506-900c-90ea61c586eb",
                        "source_entry_id": "8e860b17-ac23-3d8e-bafa-054ad2ba7b7c",
                        "source_sense_description": "in a random way",
                        "target_lang_word": "par hasard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "par hasard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68b6887b-ae68-3a7a-90fd-9450db6d5061",
                                        "entry_id": "cc398ba2-4c12-3c66-bfcf-921ba489fea8",
                                        "glosses": [
                                            "De manière fortuite, accidentelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b808509e-1eed-4389-a047-a75487960e15",
                                                "sense_id": "68b6887b-ae68-3a7a-90fd-9450db6d5061",
                                                "text": "Ça sert à si peu d’être généreux, bon, dévoué, reconnaissant et fidèle, – des faiblesses, tout au plus ! – et pour quelques êtres délicats et fins qu’on rencontre très par hasard, la vie est plutôt si pleine de mufles, de gens grossiers et d’imbéciles, à chaque instant."
                                            },
                                            {
                                                "example_id": "a6283f20-9ddf-451d-bd24-891c56db665f",
                                                "sense_id": "68b6887b-ae68-3a7a-90fd-9450db6d5061",
                                                "text": "Quand vous vous penchez vers votre fils pour l’embrasser ou pour le gronder, dites, pensez-vous à cet autre fils, retrouvé si par hasard, et qui vous aime comme un enfant et comme un homme, plus comme un homme, peut-être !…"
                                            },
                                            {
                                                "example_id": "ea7dba79-db90-4984-9122-d7f82437c677",
                                                "sense_id": "68b6887b-ae68-3a7a-90fd-9450db6d5061",
                                                "text": "En ce qui concerne la médecine, les observations nouvelles se font généralement par hasard : « Si un malade porteur d'une affection jusqu'alors inconnue vient consulter un médecin, c'est bien par hasard que le médecin rencontre ce malade. Mais c'est exactement de la même manière qu'un botaniste rencontre dans la campagne une plante qu'il ne connaissait pas, et c'est aussi par hasard qu'un astronome aperçoit dans le ciel une planète dont il ignorait l'existence …». ."
                                            },
                                            {
                                                "example_id": "8c6aaf90-23ea-4484-a48c-790f56fcfee4",
                                                "sense_id": "68b6887b-ae68-3a7a-90fd-9450db6d5061",
                                                "text": "Sur ces entrefaites elle a rencontré par hasard une de ses anciennes copines, une nommée Suzanne, une brune en minijupe, une sorte de grande sauterelle à la voix nasillarde."
                                            },
                                            {
                                                "example_id": "f623c77f-b25b-48bd-8043-0f5b961b9e10",
                                                "sense_id": "68b6887b-ae68-3a7a-90fd-9450db6d5061",
                                                "text": "La pénicilline fait partie de ces découvertes faites par hasard."
                                            },
                                            {
                                                "example_id": "8ba35d8e-7f3a-4bd6-bd5e-3c0b56488ad9",
                                                "sense_id": "68b6887b-ae68-3a7a-90fd-9450db6d5061",
                                                "text": "Toute cette histoire selon laquelle Jake avait la gâchette facile venait d’un tir remarquable réussi par pur hasard quand il était encore un gamin et qu’il venait d’entrer dans les rangers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22bdf266-1ebc-37ac-852d-9793854ff907",
                                        "entry_id": "cc398ba2-4c12-3c66-bfcf-921ba489fea8",
                                        "glosses": [
                                            "À l’occasion ; éventuellement."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58bbd907-858e-4368-95d0-2886d9657606",
                                                "sense_id": "22bdf266-1ebc-37ac-852d-9793854ff907",
                                                "text": "Çà, monsieur le comte, dit-il, tandis que l’on nous prépare notre chambre, dites-moi : est-ce que par hasard vous avez trouvé Paris une ville gaie, vous ?"
                                            },
                                            {
                                                "example_id": "82510939-8377-4020-8d25-0b3263c8b50f",
                                                "sense_id": "22bdf266-1ebc-37ac-852d-9793854ff907",
                                                "text": "Le général se dégoûtera bientôt de sa propriété, lui dit Gaubertin, et tu ne seras pas longtemps dehors, si par hasard il te renvoyait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad83615f-a113-47ee-a32c-2074edfd3786",
                        "source_entry_id": "8e860b17-ac23-3d8e-bafa-054ad2ba7b7c",
                        "source_sense_description": "in a random way",
                        "target_lang_word": "accidentellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accidentellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4463cf7b-1712-3916-b525-7d4057b3da8c",
                                        "entry_id": "9c8cee22-7371-3368-a5e7-a5f688bb9f1e",
                                        "glosses": [
                                            "D’une manière accidentelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbad5c54-4f83-401f-b227-0b808d634589",
                                                "sense_id": "4463cf7b-1712-3916-b525-7d4057b3da8c",
                                                "text": "Des scientifiques créent la pile du futur accidentellement. Souvent, les avancées scientifiques sont les résultats de plusieurs années de recherche… Mais certaines d’entre elles se découvrent accidentellement. Deux scientifiques de l’Université de Californie à Los Angeles ont inventé la pile du futur par total hasard. Chose assez surprenante nous direz-vous !"
                                            },
                                            {
                                                "example_id": "5c43a244-e257-4f30-9777-38247457a276",
                                                "sense_id": "4463cf7b-1712-3916-b525-7d4057b3da8c",
                                                "text": "[…] ; encore sa vie fut-elle accidentellement écourtée, puisqu’il périt « de langueur » un an après avoir été éborgné par un corbeau."
                                            },
                                            {
                                                "example_id": "dc01afd6-70b9-40a0-af6b-0d9b03b0e7f9",
                                                "sense_id": "4463cf7b-1712-3916-b525-7d4057b3da8c",
                                                "text": "Les courroies ont l’avantage de glisser sur la poulie lorsque l’action de l’outil devient accidentellement trop forte : ce glissement fait éviter la rupture de l’outil ou des appareils de tour."
                                            },
                                            {
                                                "example_id": "9ac4edea-57bb-4517-b2d7-758e391ed19e",
                                                "sense_id": "4463cf7b-1712-3916-b525-7d4057b3da8c",
                                                "text": "On sait que l’emploi du fer fut inconnu de toute l’Amérique avant l’arrivée de Colomb. […]. Parfois cependant le fer météorique est employé accidentellement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
