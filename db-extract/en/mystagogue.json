                                "target_senses": [
                                    {
                                        "sense_id": "81c2841a-7dbd-36ea-b5a7-2d9c321a5fa1",
                                        "entry_id": "c6ea32d9-75c8-3c77-9c9e-13cd9415b9e1",
                                        "glosses": [
                                            "jemand, der Mystagogie betreibt, insbesondere in einen (antiken) Mysterienkult oder (heute) in die christliche Glaubenswelt einführender Geistlicher"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc5d4fbf-b1d1-405b-8e55-cb06c6ac7b06",
                                                "sense_id": "81c2841a-7dbd-36ea-b5a7-2d9c321a5fa1",
                                                "text": "„Der Mystagoge spendet magisches Heil, und es fehlt ihm oder bildet doch nur ein untergeordnetes Anhängsel: die ethische Lehre. Statt dessen besitzt er eine vornehmlich erblich fortgepflanzte magische Kunstlehre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
