                "senses": [
                    {
                        "sense_id": "6caeccb2-682c-335b-9801-a4314efcf1df",
                        "entry_id": "420ce908-03b2-3c9d-9743-1db0fd7347c3",
                        "glosses": [
                            "Ausschuss eines Parlaments zur Schlichtung von Streitigkeiten, beispielsweise zwischen den Parlamentariern; er wird aus den älteren Mitgliedern dieses Parlaments gebildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee96d62c-f77b-44ae-9ea4-dbd485c018ae",
                                "sense_id": "6caeccb2-682c-335b-9801-a4314efcf1df",
                                "text": "„Der Ältestenausschuss des Parlaments befasst sich am Nachmittag mit dem Fall, doch zu einer Einigung im Streit zwischen Behörde und Parlament kam es nicht.“"
                            },
                            {
                                "example_id": "35e5f01c-37e2-4fcd-aa4c-b4a86c51355b",
                                "sense_id": "6caeccb2-682c-335b-9801-a4314efcf1df",
                                "text": "„Das weitere Vorgehen soll im Ältestenausschuss der Stadt Schweinfurt besprochen werden.“"
                            },
                            {
                                "example_id": "586048b5-7e61-4f31-afb3-f6baa86e1ddf",
                                "sense_id": "6caeccb2-682c-335b-9801-a4314efcf1df",
                                "text": "„In seiner Sitzung am Montag beschäftigte sich der Ältestenausschuss des Bayreuther Stadtrats mit den Zuschüssen an Körperschaften, Vereine und Verbände.“"
                            },
                            {
                                "example_id": "e7cd3b3d-dd14-4f62-be1a-c61cc830a28b",
                                "sense_id": "6caeccb2-682c-335b-9801-a4314efcf1df",
                                "text": "„Bundestagsabgeordnete müssen nach einer Vereinbarung im Ältestenausschuss des Bundestages von 1997 dienstlich erworbene Bonusmeilen für dienstliche Freiflüge nutzen.“"
                            },
                            {
                                "example_id": "9e85dba7-910d-4897-9f3e-c7e24402297e",
                                "sense_id": "6caeccb2-682c-335b-9801-a4314efcf1df",
                                "text": "„In der Sitzung des Ältestenausschusses dürfte es durchaus Debatten über die Neuerungen geben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
