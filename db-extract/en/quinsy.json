                                ]
                            },
                            {
                                "target_word": "жа́ба",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c612dbd8-6b3b-36d7-9e31-d1245fb78a8b",
                                        "entry_id": "d475df5a-ab23-3c86-9c87-d6d8e5b862fd",
                                        "glosses": [
                                            "зоол. хищное животное класса земноводных (Bufo)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0398191d-362f-436e-ad4a-60734e104dd3",
                                                "sense_id": "c612dbd8-6b3b-36d7-9e31-d1245fb78a8b",
                                                "text": "— Жаба, бабо. — Вона не кусае, тилько як на ногу скочить, то бородавка буде."
                                            },
                                            {
                                                "example_id": "fe99598b-b004-4cd6-b6b7-269aa0a9d8cc",
                                                "sense_id": "c612dbd8-6b3b-36d7-9e31-d1245fb78a8b",
                                                "text": "Жаба вылезла из своей норы задолго до заката и усиленно дышала."
                                            },
                                            {
                                                "example_id": "2e0dd8d6-c7aa-4ad6-a4c7-b908a95f7dd9",
                                                "sense_id": "c612dbd8-6b3b-36d7-9e31-d1245fb78a8b",
                                                "text": "Наиболее известна довольно крупная серая жаба (длина её тела — до 18 см). Питается серая жаба различными насекомыми, не гнушается пауками, иной раз схватывает зазевавшуюся пчелу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fa34121-d2f5-3c44-9be3-fe09de206106",
                                        "entry_id": "d475df5a-ab23-3c86-9c87-d6d8e5b862fd",
                                        "glosses": [
                                            "зоол., рег. (южн.) лягушка [Даль]"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "257b8bc6-3e44-3a04-80a3-3c8fcfa779c0",
                                        "entry_id": "d475df5a-ab23-3c86-9c87-d6d8e5b862fd",
                                        "glosses": [
                                            "перен. неприятный, злой, подлый человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fb9cb50-2fd2-44e5-a91b-e539d8cc1049",
                                                "sense_id": "257b8bc6-3e44-3a04-80a3-3c8fcfa779c0",
                                                "text": "— Я вас не задел по голове, Сергей Николаевич? Вы тут — главная лягушка; жаба! Всё знает — знает, как связать человека, курица ты дохлая, остолоп!"
                                            },
                                            {
                                                "example_id": "1478fd40-e726-49b8-a375-7620202186a9",
                                                "sense_id": "257b8bc6-3e44-3a04-80a3-3c8fcfa779c0",
                                                "text": "«Это жаба, хамелеон подлый, вы его бойтесь, он наушничает.»"
                                            },
                                            {
                                                "example_id": "3f72a63a-2cda-4e3b-9794-24bfc5fcc2ed",
                                                "sense_id": "257b8bc6-3e44-3a04-80a3-3c8fcfa779c0",
                                                "text": "Жаба, гнусная, безобразная, жирная, раздувающаяся… не отрывает от меня глаз, ползает по кровати, задыхается от счастья завоевателя… зверь, поймавший жертву… он истаскан, иначе ночь для меня была бы смертельной… рассвета всё нет… тогда в особняке в полузабытьи было легче…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6bd4731-e95b-3f99-b215-eec15cc4d37d",
                                        "entry_id": "d475df5a-ab23-3c86-9c87-d6d8e5b862fd",
                                        "glosses": [
                                            "перен., разг. некрасивая женщина"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "460b4e99-5194-331f-a85e-944c5bce354a",
                                        "entry_id": "d475df5a-ab23-3c86-9c87-d6d8e5b862fd",
                                        "glosses": [
                                            "перен. злая баба [Даль]"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6ecc2d2-d9d6-37a2-a19a-9d8ac7f1c28c",
                                        "entry_id": "d475df5a-ab23-3c86-9c87-d6d8e5b862fd",
                                        "glosses": [
                                            "перен., рег. (пенз.) неотвязный, докучливый человек [Даль]"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2ad3cd7-ff0f-33fb-bf4d-f9006e5d38e7",
                                        "entry_id": "d475df5a-ab23-3c86-9c87-d6d8e5b862fd",
                                        "glosses": [
                                            "перен. злое дитя [Даль]"
                                        ],
                                        "tags": [],
