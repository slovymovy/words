                                                "sense_id": "877ab097-4822-3aef-b9d4-d4f49ff5c65c",
                                                "text": "Near-synonym: named (verb)"
                                            },
                                            {
                                                "example_id": "adba6f5f-324f-4177-bb12-78570b2a4b13",
                                                "sense_id": "877ab097-4822-3aef-b9d4-d4f49ff5c65c",
                                                "text": "Her dog is called Lucky."
