                "senses": [
                    {
                        "sense_id": "6cc38c8c-323f-3cf4-9039-b58c617621f4",
                        "entry_id": "f7cc3a25-fcc0-339f-988b-295c681f83b6",
                        "glosses": [
                            "A diminutive of the female given names Linda, Lindsay, or Linnet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f039325-8106-4819-acf0-c96b440c6ee4",
                                "sense_id": "6cc38c8c-323f-3cf4-9039-b58c617621f4",
                                "text": "Lindy herself hated the name Lindy. She said it sounded like a girl in pink gingham. At the beginning of this school year she'd started making all the teachers address her by her full name, Linnet."
                            }
                        ]
                    },
                    {
                        "sense_id": "1473332c-cc4b-398d-9502-1f891abd3459",
                        "entry_id": "f7cc3a25-fcc0-339f-988b-295c681f83b6",
                        "glosses": [
                            "A unisex given name."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "de8f4abc-4502-393d-bd1d-725ff5018ca4",
                        "entry_id": "f7cc3a25-fcc0-339f-988b-295c681f83b6",
                        "glosses": [
                            "Nickname of US aviator Charles Lindbergh (1902–1974)."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ab44e6d0-dc48-4c82-9147-300baf1207bc",
                                "sense_id": "de8f4abc-4502-393d-bd1d-725ff5018ca4",
                                "text": "It seems a fair enough deduction, since it is known that Corrigan was working at the Ryan Airplane factory while Lindy's plane, \"Spirit of St. Louis,\" was being built there and he was one of those who helped put together that famous craft."
                            }
                        ]
                    }
