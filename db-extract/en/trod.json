                "senses": [
                    {
                        "sense_id": "2ec09119-737b-3a6d-a31d-cf2d53cb5cb3",
                        "entry_id": "f3195a5f-b9cf-3026-8ae2-854f2a51e2ad",
                        "glosses": [
                            "A track or pathway."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c8e51c-2f96-4836-9e6f-5b401a8dde52",
                                "sense_id": "2ec09119-737b-3a6d-a31d-cf2d53cb5cb3",
                                "text": "In many ways this process replicates the stone trods or pannierways which date from the mediaeval period and are a feature of many parts of the North York Moors."
                            }
                        ]
                    }
                ],
                "translations": [],
