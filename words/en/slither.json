{
    "word_family": [
        "slithery"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d223bd31-856b-3074-9420-86dcaa8fcd85",
                    "sense_definition": "To move smoothly with a twisting, sliding motion, typical of snakes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long green snake began to <w>slither</w> quietly through the tall grass.",
                            "target_lang_translations": {
                                "ru": "Длинная зеленая змея тихо <w>поползла</w> сквозь высокую траву."
                            }
                        },
                        {
                            "text": "We watched the reptile <w>slither</w> across the garden path and disappear into the bushes.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как рептилия <w>переползает</w> садовую дорожку и исчезает в кустах."
                            }
                        }
                    ],
                    "synonyms": [
                        "glide",
                        "crawl"
                    ],
                    "common_phrases": [
                        "slither across",
                        "slither away",
                        "slither through"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плавно скользить, извиваясь всем телом (характерно для змей)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ползти",
                                "target_lang_sense_clarification": "передвигаться ползком, извиваясь"
                            },
                            {
                                "target_lang_word": "скользить",
                                "target_lang_sense_clarification": "плавно двигаться по поверхности"
                            },
                            {
                                "target_lang_word": "проползать",
                                "target_lang_sense_clarification": "перемещаться ползком через или мимо чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9222c668-333a-3a5d-9434-73498a45cd7c",
                    "sense_definition": "To slide or slip unsteadily down or along a surface.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hiker lost his footing and started to <w>slither</w> down the muddy bank.",
                            "target_lang_translations": {
                                "ru": "Турист оступился и начал <w>соскальзывать</w> вниз по глинистому склону."
                            }
                        },
                        {
                            "text": "Large sheets of melting snow would <w>slither</w> down the steep roof in the afternoon.",
                            "target_lang_translations": {
                                "ru": "Днем большие пласты тающего снега со звуком <w>сползали</w> с крутой крыши."
                            }
                        }
                    ],
                    "synonyms": [
                        "slide",
                        "slip"
                    ],
                    "common_phrases": [
                        "slither down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неуверенно или неуклюже соскальзывать, съезжать вниз по наклонной поверхности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соскальзывать",
                                "target_lang_sense_clarification": "случайно или плавно съезжать вниз"
                            },
                            {
                                "target_lang_word": "сползать",
                                "target_lang_sense_clarification": "медленно съезжать вниз по склону или поверхности"
                            },
                            {
                                "target_lang_word": "съезжать",
                                "target_lang_sense_clarification": "скатываться, скользить под уклон"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "67b0270c-939a-3c48-a268-66515b22cc47",
                    "sense_definition": "A small, thin piece cut or split off; a <w>sliver</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He removed a tiny <w>slither</w> of glass from the sole of his shoe.",
                            "target_lang_translations": {
                                "ru": "Он вытащил крошечный <w>осколок</w> стекла из подошвы своего ботинка."
                            }
                        },
                        {
                            "text": "Only a slender <w>slither</w> of light came through the partially open door.",
                            "target_lang_translations": {
                                "ru": "Лишь тонкая <w>полоска</w> света пробивалась сквозь приоткрытую дверь."
                            }
                        }
                    ],
                    "synonyms": [
                        "sliver",
                        "splinter"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "variant of sliver"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий осколок, щепка или узкая полоска (диалектный вариант слова sliver)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осколок",
                                "target_lang_sense_clarification": "мелкий тонкий фрагмент твердого материала"
                            },
                            {
                                "target_lang_word": "щепка",
                                "target_lang_sense_clarification": "тонкая отколовшаяся частица"
                            },
                            {
                                "target_lang_word": "полоска",
                                "target_lang_sense_clarification": "узкий просвет или узкая полоса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9340261-d0d6-3016-b847-8ba43b5f1626",
                    "sense_definition": "Loose limestone rubble or scree on a hillside.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The walkers found it difficult to climb across the steep slope of loose <w>slither</w>.",
                            "target_lang_translations": {
                                "ru": "Путникам было трудно подниматься по крутому склону из рыхлой <w>осыпи</w>."
                            }
                        },
                        {
                            "text": "A sheet of shifting <w>slither</w> covered the path, causing stones to roll downward.",
                            "target_lang_translations": {
                                "ru": "Слой подвижного <w>щебня</w> покрывал тропу, из-за чего камни скатывались вниз."
                            }
                        }
                    ],
                    "synonyms": [
                        "scree",
                        "rubble"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used dialectally for scree or loose rubble"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Каменная осыпь или щебень на склоне холма (диалектное)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осыпь",
                                "target_lang_sense_clarification": "скопление мелких камней на склоне"
                            },
                            {
                                "target_lang_word": "щебень",
                                "target_lang_sense_clarification": "мелкие обломки горной породы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a2514d5b-1a17-3c3b-ae7d-fbd66e007b5e",
                    "sense_definition": "Slippery or slick.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surface",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wet rocks by the river were far too <w>slither</w> to climb safely.",
                            "target_lang_translations": {
                                "ru": "Мокрые камни у реки были слишком <w>скользкими</w>, чтобы безопасно по ним карабкаться."
                            }
                        },
                        {
                            "text": "Careful footsteps were necessary because the wooden bridge was wet and <w>slither</w>.",
                            "target_lang_translations": {
                                "ru": "Нужно было ступать осторожно, потому что деревянный мостик был мокрым и <w>скользким</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "slippery",
                        "slithery"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "chiefly regional or archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скользкий (диалектное или устаревшее)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скользкий",
                                "target_lang_sense_clarification": "обладающий гладкой, вызывающей скольжение поверхностью"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}