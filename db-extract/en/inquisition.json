        "de-extract.jsonl": [
            {
                "entry_id": "ebf7f317-891c-38d0-a148-9181368b6c35",
                "word": "inquisition",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7b91c89a-7147-3317-adb0-5b0f7be68d12",
                        "entry_id": "ebf7f317-891c-38d0-a148-9181368b6c35",
                        "glosses": [
                            "die Untersuchung, die Inquisition"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3118aab-1ee9-4d5e-a251-24d8e32d4133",
                                "sense_id": "7b91c89a-7147-3317-adb0-5b0f7be68d12",
                                "text": "\"Nobody expects the Spanish Inquisition!\"",
                                "translation": "Niemand erwartet die Spanische Inquisition! (Monty Python)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4daa42d-a097-4507-bad1-bd331bb2f95d",
                        "source_entry_id": "ebf7f317-891c-38d0-a148-9181368b6c35",
                        "source_sense_id": "7b91c89a-7147-3317-adb0-5b0f7be68d12",
                        "source_sense_description": "sdü",
                        "target_lang_word": "Untersuchung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Untersuchung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "400c0456-b7e8-327d-9b63-62ab89153ffa",
                                        "entry_id": "640bd353-a76c-3cff-9b6b-24c9a80334d4",
                                        "glosses": [
                                            "die genauere Betrachtung, Beobachtung oder das Betasten zur Bestimmung eines Sachverhalts oder Objektes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e90942c1-635e-4c31-86a0-c55bd56aa259",
                                                "sense_id": "400c0456-b7e8-327d-9b63-62ab89153ffa",
                                                "text": "Die Untersuchung ergab, dass es sich um eine Entzündung handelt, die dringend behandelt werden muss."
                                            },
                                            {
                                                "example_id": "c365b6e3-55a7-493b-b052-16516fdaaf07",
                                                "sense_id": "400c0456-b7e8-327d-9b63-62ab89153ffa",
                                                "text": "„Diese Untersuchung greift auf eine vergleichsweise breite Literaturauswahl sowie auf bislang unveröffentlichtes Archivmaterial zurück.“"
                                            },
                                            {
                                                "example_id": "b197f9a2-352e-44b4-9c79-ebaf0cdb2112",
                                                "sense_id": "400c0456-b7e8-327d-9b63-62ab89153ffa",
                                                "text": "„Die Untersuchung von Holzkohle aus vorgeschichtlichen Feuerstellen erfaßt die Veränderungen der Vegetation ungefähr während der letzten 500000 Jahre – seit der Mensch nach Entdeckung des Feuers erste Feuerstellen anlegte.“"
                                            },
                                            {
                                                "example_id": "3b50ef86-cadf-4d5c-8804-c741c6982df0",
                                                "sense_id": "400c0456-b7e8-327d-9b63-62ab89153ffa",
                                                "text": "„Nach einer Untersuchung bei seinem Hausarzt wartet der sexuell akive Junggeselle auf das Ergebnis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91c19f25-94d4-4744-a45b-83bb6df54a91",
                        "source_entry_id": "ebf7f317-891c-38d0-a148-9181368b6c35",
                        "source_sense_id": "7b91c89a-7147-3317-adb0-5b0f7be68d12",
                        "source_sense_description": "sdü",
                        "target_lang_word": "Inquisition",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inquisition",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                        "entry_id": "efc6103c-ee54-39da-ad1e-dfb6fc7bbe06",
                                        "glosses": [
                                            "Gericht der Kirche gegen Abtrünnige und solche, die Glaubenslehren ablehnten"
                                        ],
                                        "tags": [
                                            "zwischen dem 12. und dem 18. Jahrhundert"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21cc4acc-b459-4602-a22d-426ba73b8a9b",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "Anna Schwegelin wurde nicht durch die Inquisition, sondern durch ein weltliches Gericht zum Tode verurteilt."
                                            },
                                            {
                                                "example_id": "035b0f31-15e2-4cac-98ad-de2aff91c338",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "Giordano Bruno entging der Inquisition nicht."
                                            },
                                            {
                                                "example_id": "98329778-2ae6-4218-87db-b59d33847f08",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„In manchen Kreisen hält sich hartnäckig das Gerücht, dies sei die moderne Variante der Inquisition.“"
                                            },
                                            {
                                                "example_id": "69a2836c-29f4-4773-9e22-412dd3034ea5",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„Aber die Inquisition hatte zumindest keinen Hehl aus ihrem Tun gemacht.“"
                                            },
                                            {
                                                "example_id": "4a53ef48-b7e1-4ebf-956e-7973210e5fd3",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„Ich wurde ein gewisses Angstgefühl der Inquisition gegenüber nicht los, und mir schien, als seien mir bereits einige Spitzel auf den Fersen.“"
                                            },
                                            {
                                                "example_id": "cb3474b3-0fd6-4336-ad67-3f1c57b72514",
                                                "sense_id": "0dddb184-a9f2-32c5-9dbe-6d307c568387",
                                                "text": "„Durch nichts hat das Christentum sich selbst, seiner eigenen Substanz nach so verraten und geschädigt wie mit den von der Inquisition entfesselten Verfolgungen, Folterungen und grausamen Hinrichtungen von Tausenden christlicher Menschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
