                "word": "antiguerre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "77007859-e520-32eb-93d0-f90b3dca1e93",
                        "entry_id": "7d919eae-059c-3535-8654-c2cf3e13c035",
                        "glosses": [
                            "Person, die gegen den Krieg ist; Kriegsgegner"
                        ],
                        "tags": [],
