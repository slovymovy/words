                        ],
                        "examples": [
                            {
                                "example_id": "b7f1170d-5b56-474f-928b-637a8952adef",
                                "sense_id": "96dc6893-7979-3a63-b45b-2b695393d8ae",
                                "text": "Soo gaet, in waerdicheidt, het heerelijcke loven / De schrandre schamperheit van 't lasteren te boven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
