                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ca7f8fe1-d63c-3f4e-9b37-ddad461818ed",
                        "entry_id": "81dec70b-d392-3907-a10c-5eb94402d85e",
                        "glosses": [
                            "Her firokeyekê."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "6032c894-b63f-49cf-8b3f-e692fe6856df",
                                "sense_id": "ca7f8fe1-d63c-3f4e-9b37-ddad461818ed",
                                "text": "On weekends, I liked to spend my time at the airport watching the various airships take off and land.",
                                "translation": "Di dawiya hefteyê de, min hez dikir ku wextê xwe li balafirgehê bi seyrkirina keştiyên hewayê yên cihêreng derbas bikim ku radibin û dadikevin."
                            }
                        ]
                    },
                    {
                        "sense_id": "94138074-c654-3b86-8c41-90898b4140f8",
