                        "entry_id": "1c6767b8-9354-3503-a7c5-d94411d8cfc6",
                        "glosses": [
                            "Scandinavian/Northern European seafarers, most familiarly raiders and pirates during the Viking age."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
