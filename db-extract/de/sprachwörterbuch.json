                "senses": [
                    {
                        "sense_id": "95a7e484-12c4-3b61-afaf-6914c161f0bb",
                        "entry_id": "a508941e-de03-39fd-a9a5-658a10817409",
                        "glosses": [
                            "Wörterbuch, dessen Schwerpunkt sprachliche Informationen zum Wortschatz sind. Man kann zwischen ein- und mehrsprachigen Sprachwörterbüchern unterscheiden. Statt einer Sprache insgesamt können auch einzelne Varietäten ihr Gegenstand sein. (Gelegentlich wird \\\"Sprachwörterbuch\\\" einfach mit \\\"Wörterbuch\\\" gleichsetzt; in diesem Fall wäre es nur eine verdeutlichende Bezeichnung.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f65cbcc7-6ded-4ecd-8b4f-ec130998c845",
                                "sense_id": "95a7e484-12c4-3b61-afaf-6914c161f0bb",
                                "text": "In einem Sprachwörterbuch kann man sich über die sprachlichen Eigenschaften des Wortschatzes der behandelten Sprache oder Sprachen bzw. ihrer Varietät(en) informieren."
                            },
                            {
                                "example_id": "6b402675-d018-42e7-849b-d3e7846130d1",
                                "sense_id": "95a7e484-12c4-3b61-afaf-6914c161f0bb",
                                "text": "„Im Sprachwörterbuch lernt man bei vielen Wörtern, zum Beispiel bei Zebra, online oder Eschatologie, automatisch etwas über die Welt, in der wir leben, wenn wir lernen, wie man dieses Wort gebraucht und umgekehrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
