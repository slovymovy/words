                "senses": [
                    {
                        "sense_id": "c1bfe23f-0a98-37da-8a5b-90220b5e40bc",
                        "entry_id": "54ae9b2b-b36f-3010-a2d1-991791654cfc",
                        "glosses": [
                            "Câlin tendre sans intention sexuelle ; les baisers sont tendres et les caresses peu appuyées."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "36990b94-a873-4a55-be80-c4bbd03295c6",
                                "sense_id": "c1bfe23f-0a98-37da-8a5b-90220b5e40bc",
                                "text": "Quand tu étais petit, tu parlais de ces traces d’amour présentes au corps. Tu disais souvent : « Maman, j’aime bien ton odeur quand je fais câlinou contre toi. »"
                            },
                            {
                                "example_id": "3071cedc-66f7-4e61-969f-ef678bba38b2",
                                "sense_id": "c1bfe23f-0a98-37da-8a5b-90220b5e40bc",
                                "text": "Certaines formes simples d’altruisme réchauffent le cœur facilement, par exemple faire un câlinou ou effectuer un don, mais cela n’exige pas beaucoup de temps ni de sacrifice."
                            },
                            {
                                "example_id": "eb13823b-1798-4a16-851d-c878aaf5abec",
                                "sense_id": "c1bfe23f-0a98-37da-8a5b-90220b5e40bc",
                                "text": "– Tu veux que je te fasse des petits calinous sur la tête ?\nOui, bon d'accord, les calinous sur la tête n'étaient pas une proposition top glamour mais c'était la seule chose qui m'était venue à l'esprit à ce moment-là."
                            }
                        ]
                    }
