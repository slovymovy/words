                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8576a1ef-f892-4649-82ea-40fee7ab248e",
                                                "sense_id": "443b11a1-b2a9-3e4d-acb8-3071c3954698",
                                                "text": "W tym samym domu zakupili mieszkanie dla matki Nicolasa, którą przez jakiś czas Dorothy się opiekowała, ale ciągle cała w pretensjach i trochę nieznośna"
                                            }
