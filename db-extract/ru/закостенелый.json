                "senses": [
                    {
                        "sense_id": "9c0d1506-4737-3856-95c5-7ee07981e121",
                        "entry_id": "a9736caa-cdcc-31e6-be15-fd2c021e7155",
                        "glosses": [
                            "утративший подвижность, гибкость, находящийся в омертвелом состоянии"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0abd0ba1-03a8-39b2-8593-403cf76eba17",
                        "entry_id": "a9736caa-cdcc-31e6-be15-fd2c021e7155",
                        "glosses": [
                            "перен. потерявший способность к дальнейшему развитию, совершенствованию"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "295a2809-8de7-4688-af1e-9f5e2556169e",
                                "sense_id": "0abd0ba1-03a8-39b2-8593-403cf76eba17",
                                "text": "И действительно, есть какой-то сатанинский умысел судьбы в том, чтобы от такой тупой, закостенелой натуры потребовать решения, имеющего определяющий смысл для всего столетия, чтобы человека, склонного к созерцательной жизни, поставить перед лицом ужасной мировой катастрофы."
                            }
                        ]
                    }
