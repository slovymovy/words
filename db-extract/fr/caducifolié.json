                                        "entry_id": "8f8d3b97-207d-372a-8ea8-fd0d65c018a4",
                                        "glosses": [
                                            "nur während der sommerlichen Vegetationszeit Blätter tragend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84df8578-72ea-4426-a40f-b559e0f18aa8",
                                                "sense_id": "7a56b696-0427-3a30-9ce7-1200e10e0920",
                                                "text": "Die Linde ist ein sommergrüner Baum, denn sie verliert im Winter all ihre Blätter."
                                            },
                                            {
                                                "example_id": "9ed70f4c-0d93-4732-85ec-d5c2b7e88e1b",
                                                "sense_id": "7a56b696-0427-3a30-9ce7-1200e10e0920",
                                                "text": "„In den ozeanisch geprägten Teilen der kühlgemäßigten Breiten sind sommergrüne Laubwälder weit verbreitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4379d266-8c30-4050-bb61-ceba8accc88e",
