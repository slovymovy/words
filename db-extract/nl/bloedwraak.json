                        "form": "bloedwraken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "31556b2a-b9c6-3419-a204-d68a28f36c02",
                        "entry_id": "8fa7c0a7-b849-33e1-a8ab-20e8af23c311",
                        "glosses": [
                            "een vorm van eigenrichting waarin de familie of stam van een dode het recht (en de plicht) heeft die te wreken op de schuldige, ook als de dood het gevolg was van een ongeval met verlies van de maatschappelijke eer indien dit niet zou gebeuren"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2a4e1b7-c639-4874-85fa-6903aeddb0c4",
                        "source_entry_id": "8fa7c0a7-b849-33e1-a8ab-20e8af23c311",
                        "source_sense_id": "31556b2a-b9c6-3419-a204-d68a28f36c02",
                        "target_lang_word": "Blutrache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutrache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff3d9b0e-9450-3882-ad4e-b239fc919d5e",
                                        "entry_id": "5d2c9c84-f457-30fa-b29e-f0a060ed62f8",
                                        "glosses": [
                                            "Racheakt an dem Täter für die Ermordung eines Verwandten, indem man den Täter ermordet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88c9f5b5-49a0-4f28-8dc7-50faf1c67140",
                                                "sense_id": "ff3d9b0e-9450-3882-ad4e-b239fc919d5e",
                                                "text": "Die Blutrache spielt auf dem Balkan immer noch eine Rolle."
                                            },
                                            {
                                                "example_id": "1fe4fd21-50cc-48d2-b366-22a50831ece1",
                                                "sense_id": "ff3d9b0e-9450-3882-ad4e-b239fc919d5e",
                                                "text": "„Man wusste über ihn nur, dass er vor vierzig Jahren aus Südägypten vor der Blutrache geflohen war und alle paar Jahre den Ort wechselte.“"
                                            },
                                            {
                                                "example_id": "918c84a7-b892-495a-8ddc-bad78fbd9706",
                                                "sense_id": "ff3d9b0e-9450-3882-ad4e-b239fc919d5e",
                                                "text": "„So eine Blutrache konnte sich durchaus über mehrere Generationen hinziehen und führte nicht wenige Familien an den Rand der Ausrottung.“"
                                            },
                                            {
                                                "example_id": "79972c28-f4b6-4131-ab94-c5bf5cb8b9c0",
                                                "sense_id": "ff3d9b0e-9450-3882-ad4e-b239fc919d5e",
                                                "text": "„Das römische Recht hinderte die Germanen, alte Gewohnheiten auszuleben wie Blutrache und Beutezüge.“"
                                            },
                                            {
                                                "example_id": "fea722d9-61c2-4b85-803e-a9b5948b6ceb",
                                                "sense_id": "ff3d9b0e-9450-3882-ad4e-b239fc919d5e",
                                                "text": "„So führen sie die Tradition der Blutrache fort und legen fest, dass die Familie eines Ermordeten den Täter töten darf.“"
                                            },
                                            {
                                                "example_id": "000ff723-f43f-4c86-88d8-6204a9b90852",
                                                "sense_id": "ff3d9b0e-9450-3882-ad4e-b239fc919d5e",
                                                "text": "„Wird eine Verletzung der moralischen Integrität vermutet, muss diese sanktioniert werden, was immer wieder in Akte der Blutrache ((«Ehrenmorde») mündet.“"
                                            },
                                            {
                                                "example_id": "fac25c26-d1f9-4c37-9fbe-7d45c402e388",
                                                "sense_id": "ff3d9b0e-9450-3882-ad4e-b239fc919d5e",
                                                "text": "„Die Verdrängung der Frau aus dem öffentlichen Leben, die Steinigung von «befleckten» Frauen und die Aufnahme der Blutrache in ihr Rechtssystem entsprachen Ehr- und Rechtsvorstellungen des paschtunwali, die einer strengen Auslegung der Scharia sogar widersprachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f423fa10-b33e-4502-b66f-420b41d89a34",
                        "source_entry_id": "8fa7c0a7-b849-33e1-a8ab-20e8af23c311",
                        "source_sense_id": "31556b2a-b9c6-3419-a204-d68a28f36c02",
                        "target_lang_word": "blood feud",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blood feud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "907b832a-e8f4-3220-9158-3dc52cb483ee",
                                        "entry_id": "cce12ae6-9144-3dc9-b625-8001f85da565",
                                        "glosses": [
                                            "A protracted and bitter violent feud between clans, families, factions, etc.; a vendetta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bff65506-e28d-4bf3-8603-017e0294aeb5",
                                                "sense_id": "907b832a-e8f4-3220-9158-3dc52cb483ee",
                                                "text": "\"I should have remembered that these people have long memories for blood-feuds, and have been more upon my guard.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8049a4d0-8fc2-4a06-ac17-ed065f386c8c",
                        "source_entry_id": "8fa7c0a7-b849-33e1-a8ab-20e8af23c311",
                        "source_sense_id": "31556b2a-b9c6-3419-a204-d68a28f36c02",
                        "target_lang_word": "vendetta",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vendetta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e9f53d0-29d4-3dd7-bb07-698751a5a627",
                                        "entry_id": "51442aa0-6f80-3903-807f-b6ea60c5d879",
                                        "glosses": [
                                            "Revenge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88a22709-19fb-3db1-a1d8-4f1550f11ed2",
                                        "entry_id": "51442aa0-6f80-3903-807f-b6ea60c5d879",
                                        "glosses": [
                                            "A bitter, destructive feud, normally between two families, clans, or factions, in which each injury or slaying is revenged: a blood feud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "710f766c-4d1e-40b2-a0d9-8d2a869150cc",
                                                "sense_id": "88a22709-19fb-3db1-a1d8-4f1550f11ed2",
                                                "text": "The families had been locked in a bitter vendetta for generations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44c88993-626e-32dd-96a8-5c881613025e",
                                        "entry_id": "51442aa0-6f80-3903-807f-b6ea60c5d879",
                                        "glosses": [
                                            "A motivational grudge against a person or faction, which may or may not be reciprocated; the state of having it in for someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d97a9e45-2c53-44c8-b7b2-0285ee8e4436",
                                                "sense_id": "44c88993-626e-32dd-96a8-5c881613025e",
                                                "text": "personal vendetta"
                                            },
                                            {
                                                "example_id": "e8d0facc-3d6f-43ad-8105-d24e773caadb",
                                                "sense_id": "44c88993-626e-32dd-96a8-5c881613025e",
                                                "text": "blood vendetta"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc926635-4fcb-407b-993c-652faca142bb",
                        "source_entry_id": "8fa7c0a7-b849-33e1-a8ab-20e8af23c311",
                        "source_sense_id": "31556b2a-b9c6-3419-a204-d68a28f36c02",
                        "target_lang_word": "vendetta",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vendetta",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ad5656c-74f1-3434-a95e-6d4f261b1215",
                                        "entry_id": "bb357c63-c7c6-3c37-8763-f4dc46fe09bf",
                                        "glosses": [
                                            "Haine, hostilité qui existe dans le bassin méditerranéen et dans les Balkans entre deux familles, et qui cause souvent des meurtres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c0c747a-c84f-4e6d-8be5-3460189f2fb6",
                                                "sense_id": "3ad5656c-74f1-3434-a95e-6d4f261b1215",
                                                "text": "Il ne semble pas qu'au temps où la vendetta fonctionnait régulièrement en Corse, pour compléter ou corriger l'action d'une justice trop boiteuse, la population eût une moindre moralité qu'aujourd'hui."
                                            },
                                            {
                                                "example_id": "fa996f89-d3fc-4317-b5a6-f1cb36792c96",
                                                "sense_id": "3ad5656c-74f1-3434-a95e-6d4f261b1215",
                                                "text": "Le mobile de ces crimes a toujours été uniquement la vengeance, la vendetta : vendetta pour une injure reçue, ou vendetta pour violation du grand principe de l’omerta. Le Sicilien, en général, aime à se faire justice par lui-même : […]."
                                            },
                                            {
                                                "example_id": "166eabb9-b5d4-4c5e-9049-988ad82586db",
                                                "sense_id": "3ad5656c-74f1-3434-a95e-6d4f261b1215",
                                                "text": "Il se rappelle que lorsqu'il avait douze ans, et qu'il était berger dans la montagne, il a pris part à la razzia d'un village voisin ; haine et représailles de village à village, vendetta : la vieille Abkhasie peut, sous cet angle, se comparer à la Corse ou à la Sicile."
                                            },
                                            {
                                                "example_id": "60edab59-c8fe-48ae-9dce-c3ee85a4093d",
                                                "sense_id": "3ad5656c-74f1-3434-a95e-6d4f261b1215",
                                                "text": "Chez lui, ses amis et parents n'auraient guère tardé pour faire vendetta ; ces gens du nord, eux, ont la placidité des vaches."
                                            },
                                            {
                                                "example_id": "44d917b3-b572-4346-97ec-13bc1bf2009c",
                                                "sense_id": "3ad5656c-74f1-3434-a95e-6d4f261b1215",
                                                "text": "Basilia ne doutait pas un instant que Dieu n’approuvât la vendetta déclenchée par ses soins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f6d21fe-0274-3733-bdcd-08e5f0e8dd36",
                                        "entry_id": "bb357c63-c7c6-3c37-8763-f4dc46fe09bf",
                                        "glosses": [
                                            "Vengeance, revanche personnelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edc18a52-6216-488b-a701-4c2cb2e05a22",
                                                "sense_id": "7f6d21fe-0274-3733-bdcd-08e5f0e8dd36",
                                                "text": "La Russie demeurait par force une puissance pacifique, divisée au-dedans, déchirée entre les révolutionnaires et les réactionnaires également incapables de reconstruction sociale, et elle s’enlisait dans un désordre tragique de vendetta politique à retours chroniques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b5dcbd9-0a44-46ac-85d4-f11004905c96",
                        "source_entry_id": "8fa7c0a7-b849-33e1-a8ab-20e8af23c311",
                        "source_sense_id": "31556b2a-b9c6-3419-a204-d68a28f36c02",
                        "target_lang_word": "vendetta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vendetta",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "8664ccca-c8c0-31da-9674-bac51b9d5594",
                                        "entry_id": "4664e12f-0af8-3ec1-9949-47dc0040ab55",
                                        "glosses": [
                                            "Venganza."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "290b04d9-a40b-4efb-95f2-81faacf6892f",
                                                "sense_id": "8664ccca-c8c0-31da-9674-bac51b9d5594",
                                                "text": "No hicimos vendetta con los militares. Cualquiera podría meterle un tiro a un torturador en la cabeza cuando la democracia volvió. Nadie lo hizo. Nosotros (no) lo hicimos. Somos el único país en el mundo que (no) lo hizo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
