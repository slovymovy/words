                ],
                "senses": [
                    {
                        "sense_id": "6cc31aef-6303-31f3-8cbf-3ecfceb76f85",
                        "entry_id": "069c16db-dc6f-3482-8dfd-dd7afed33793",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a230e501-f6d7-4f0a-9656-0534e0eee0e0",
                                "sense_id": "6cc31aef-6303-31f3-8cbf-3ecfceb76f85",
                                "text": "Frau Leibbrand ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "064c33f0-159f-41db-849a-71c7f64857bb",
                                "sense_id": "6cc31aef-6303-31f3-8cbf-3ecfceb76f85",
                                "text": "Herr Leibbrand wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b987cbaa-6496-45f6-bb30-5c26d66c053f",
                                "sense_id": "6cc31aef-6303-31f3-8cbf-3ecfceb76f85",
                                "text": "Die Leibbrands fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8d6a8ef8-e5cc-448e-b505-1461bb557fe4",
                                "sense_id": "6cc31aef-6303-31f3-8cbf-3ecfceb76f85",
                                "text": "Der Leibbrand trägt nie die Schals, die die Leibbrand ihm strickt."
                            },
                            {
                                "example_id": "4fb7c4fa-db24-4425-b6fa-efc33694b4ab",
                                "sense_id": "6cc31aef-6303-31f3-8cbf-3ecfceb76f85",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Leibbrand kommt, geht der Herr Leibbrand.“"
                            },
                            {
                                "example_id": "e0631ba6-169e-48e0-9564-470a3154fe20",
                                "sense_id": "6cc31aef-6303-31f3-8cbf-3ecfceb76f85",
                                "text": "Leibbrand kommt und geht."
                            },
                            {
                                "example_id": "2de4f187-06d9-4189-9da5-ea48824a808a",
                                "sense_id": "6cc31aef-6303-31f3-8cbf-3ecfceb76f85",
                                "text": "Leibbrands kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
