                "senses": [
                    {
                        "sense_id": "92f9274f-c115-3a64-bc35-0660da64de3d",
                        "entry_id": "e89f100c-c3f7-350c-88fc-2571d593ab16",
                        "glosses": [
                            "Form oder Methode des Trainings"
                        ],
                        "tags": [
                            "insbesondere"
                        ],
                        "examples": [
                            {
                                "example_id": "19925883-71bc-4f57-8176-efcfbfc6277f",
                                "sense_id": "92f9274f-c115-3a64-bc35-0660da64de3d",
                                "text": "„Zudem sei diese Trainingsart relativ teuer und könne zudem nicht immer just in time eingesetzt werden.“"
                            },
                            {
                                "example_id": "bcd3cf46-4cfb-43eb-ad1f-a901e4067e23",
                                "sense_id": "92f9274f-c115-3a64-bc35-0660da64de3d",
                                "text": "„Der Pacer unterstützt eine Vielzahl von Trainingsarten, aber der Schwerpunkt liegt auf dem Laufen, mit GPS-Tracking und einem Laufindex nach dem Training, das Sie über Ihre Leistung in einer Vielzahl von Messgrößen informiert.“"
                            },
                            {
                                "example_id": "e7c65368-e37a-4599-b514-1be6b0d3d064",
                                "sense_id": "92f9274f-c115-3a64-bc35-0660da64de3d",
                                "text": "„Gibt es eigentlich erste Urteile über die Trainingsart, die Schmidt anwendet?“"
                            },
                            {
                                "example_id": "7d06ddb0-051d-423b-86dd-6f92cb98ca4a",
                                "sense_id": "92f9274f-c115-3a64-bc35-0660da64de3d",
                                "text": "„Jedoch sind es dann auch die Spieler die ein härteres und forderndes Training haben wollen, ergo sollte diese Trainingsart generell für alle gelten.“"
                            },
                            {
                                "example_id": "bb2a94a3-ee5f-4e80-868b-38679cbdf592",
                                "sense_id": "92f9274f-c115-3a64-bc35-0660da64de3d",
                                "text": "„Mit elf professionellen und 85 benutzerdefinierten Trainingsarten kann nahezu jeder Trainingsfortschritt und alle Trainingsdaten in Echtzeit aufgezeichnet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
