                    "sense_definition": "odległość ogniska układu optycznego od soczewki lub głównego punktu układu optycznego",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten aparat fotograficzny posiada obiektyw o <w>ogniskowej</w> pięćdziesięciu milimetrów.",
                            "target_lang_translations": {
                                "ru": "У этого фотоаппарата объектив с <w>фокусным расстоянием</w> пятьдесят миллиметров."
                            }
                        },
                        {
                            "text": "Większa <w>ogniskowa</w> pozwala na fotografowanie obiektów znajdujących się w dużej odległości.",
                            "target_lang_translations": {
                                "ru": "Большее <w>фокусное расстояние</w> позволяет фотографировать объекты, находящиеся на большом расстоянии."
                            }
                        }
                    ],
                    "common_phrases": [
