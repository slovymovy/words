                "senses": [
                    {
                        "sense_id": "9a45a2ac-69c2-3a0f-b411-67b358be4977",
                        "entry_id": "ee4495e0-0eaa-33e6-8a1b-c102422b717b",
                        "glosses": [
                            "Pantalon."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e17969d3-5668-48bd-a3f2-84ba76db66de",
                                "sense_id": "9a45a2ac-69c2-3a0f-b411-67b358be4977",
                                "text": "C’est dans mon phalzar que ça se tient, décréta-t-il… Ils font leurs œufs dans la couture… Faut que je fasse bouillir mon grimpant…"
                            },
                            {
                                "example_id": "dffb073b-e03d-45e6-9e5b-37ebf19b9f42",
                                "sense_id": "9a45a2ac-69c2-3a0f-b411-67b358be4977",
                                "text": "Le flacon fatal dans ma pocket pèse une tonne et me brûle la peau à travers l’étoffe de mon grimpant."
                            },
                            {
                                "example_id": "f58635ae-7b46-4f7b-bed4-03eb7b94f409",
                                "sense_id": "9a45a2ac-69c2-3a0f-b411-67b358be4977",
                                "text": "Depuis que les langoustines se faisaient tatouer comme des matafs et que les branlotins dansaient le pogo avec le fond du grimpant au niveau des genoux, … Larouche avait une fâcheuse tendance à prendre les jeunes pour des cons."
                            }
                        ]
                    }
                ],
