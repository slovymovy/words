                                        "examples": [
                                            {
                                                "example_id": "f33ebaf6-69e5-4707-8b32-753b209c5189",
                                                "sense_id": "99977656-fc2f-3b66-91d4-731fa75fcc69",
                                                "text": "Ну, блудница, ну, согрешила, ну что ж?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab6821e4-4f5e-35a2-a8b1-fafbf1cb2fb2",
                                        "entry_id": "dcd6f158-a2f9-3b66-86a5-696bfa1b09f4",
                                        "glosses": [
                                            "устар. проститутка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3e74dd9-e733-42e3-a120-a06f1ab6b402",
                                                "sense_id": "ab6821e4-4f5e-35a2-a8b1-fafbf1cb2fb2",
                                                "text": "Последняя мужняя раба лучше, чем дешевая блудница (это о России царской и советской сказал некто)."
                                            }
