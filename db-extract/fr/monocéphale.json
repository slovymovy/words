                        "examples": [
                            {
                                "example_id": "bd4363d6-4d95-4d6f-95f6-ee2478f727f2",
                                "sense_id": "9bd12dae-3360-3d04-862d-85d4de3e9f5d",
                                "text": "L’aigle héraldique est soit monocéphale au vol abaissé, soit bicéphale au vol éployé."
                            },
                            {
                                "example_id": "f865cc64-c50e-484e-bac7-91c515dcbddc",
                                "sense_id": "9bd12dae-3360-3d04-862d-85d4de3e9f5d",
                                "text": "Le bizarre, cause de rire, apparaît l’un des premiers : l’enfant rira d’un aigle à deux têtes comme l’empereur François-Joseph riait, dit-on, d’un aigle monocéphale : enfance et vieillesse se rejoignent ainsi."
                            }
                        ]
