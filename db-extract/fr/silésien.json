            {
                "entry_id": "c9f31948-b984-3cb0-98ee-cb3551aa74af",
                "word": "silésien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8a9f08b4-2b24-3c55-a40d-4f316758851c",
                        "entry_id": "c9f31948-b984-3cb0-98ee-cb3551aa74af",
                        "glosses": [
                            "Langue slaves parlée par une partie de la population de Haute-Silésie, en Pologne."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "577f9ca8-7366-4aee-8642-3b3f950f4b38",
                        "source_entry_id": "c9f31948-b984-3cb0-98ee-cb3551aa74af",
                        "source_sense_id": "8a9f08b4-2b24-3c55-a40d-4f316758851c",
                        "target_lang_word": "Schlesisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlesisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e539278-817a-32dc-980c-349a2cb0ebc5",
                                        "entry_id": "f99da4f8-2ed5-3fb4-a561-f5efb6c9e0a4",
                                        "glosses": [
                                            "ein deutscher Dialekt des Ostmitteldeutschen, der vereinzelt in Oberschlesien oder der Oberlausitz gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7cf094e-ed0d-4761-b8cf-7e153375d0f5",
                                                "sense_id": "8e539278-817a-32dc-980c-349a2cb0ebc5",
                                                "text": "„Das Schlesische und das Lausitzische bildeten, ähnlich dem Thüringisch-Obersächsischen, eine gemeinsame Dialektgruppe innerhalb des Ostmitteldeutschen.“"
                                            },
                                            {
                                                "example_id": "cc809de7-9d83-49f6-a707-02877f923c74",
                                                "sense_id": "8e539278-817a-32dc-980c-349a2cb0ebc5",
                                                "text": "„Ihre erste Sprache, die sie als Kind lernte, die »tiefste, dem Herzen nächste«, ist »Paurisch«. Eine mitteldeutsche Mundart, die dem Oberlausitzischen zugeordnet wird, dem Schlesischen nahe verwandt, welche im Bezirk Gablonz, bevor die Deutschen vertreiben wurden, noch in Gebrauch war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "732eb631-2981-3f11-a0bf-5f3f73a807a8",
                                        "entry_id": "f99da4f8-2ed5-3fb4-a561-f5efb6c9e0a4",
                                        "glosses": [
                                            "ein polnischer Dialekt, der in Oberschlesien sowie in Tschechisch-Schlesien gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20f07b96-673e-492f-ac9e-f08a2bc8d581",
                                                "sense_id": "732eb631-2981-3f11-a0bf-5f3f73a807a8",
                                                "text": "„Es gab auch Musikgruppen, die Schlesisch sangen, Kabaretts, oder Radio- und Fernsehsendungen, die ebenfalls auf Schlesisch abgehalten wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
