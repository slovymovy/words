                        "translation_id": "1319c3dd-0927-42e2-8b34-4b2a7ce8b3a0",
                        "source_entry_id": "39d21423-b0bc-32ed-9039-406af893419c",
                        "source_sense_id": "b4e6a010-3e60-38f3-80d9-604e720911c1",
                        "target_lang_word": "squeezer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "squeezer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0ee46e2-fba4-34f8-a1f3-2ab654b1bb21",
                                        "entry_id": "fa5436f9-92c6-3c6d-9097-5c93cc550f70",
                                        "glosses": [
                                            "Someone or something that squeezes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4438747c-9c4c-4f72-b073-8227fc963325",
                                                "sense_id": "e0ee46e2-fba4-34f8-a1f3-2ab654b1bb21",
                                                "text": "I made juice with a lemon squeezer."
                                            },
                                            {
                                                "example_id": "d7a9e5ac-ea5e-46c3-a989-8d001fa00262",
                                                "sense_id": "e0ee46e2-fba4-34f8-a1f3-2ab654b1bb21",
                                                "text": "Although it is possible to argue that the ogler's, pincher's, or squeezer's sexual misconduct is coercive, it is difficult."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20322b44-f9c4-35c5-910b-32a4a1776b58",
                                        "entry_id": "fa5436f9-92c6-3c6d-9097-5c93cc550f70",
                                        "glosses": [
                                            "A piece of foundry apparatus for shaping a ball of puddled iron."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83a6b58b-c870-38e9-ba20-8cd77a29e468",
                                        "entry_id": "fa5436f9-92c6-3c6d-9097-5c93cc550f70",
                                        "glosses": [
                                            "A playing card that has its value shown in a corner such that a closely arranged hand may be studied (originally designed for poker but now standard)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdc6bd60-b8e7-342a-a6da-6d7d2ce58ca1",
                                        "entry_id": "fa5436f9-92c6-3c6d-9097-5c93cc550f70",
                                        "glosses": [
                                            "Someone or something that coerces; one who puts the squeeze on someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be7baf4a-c616-4a95-a88c-22b98f7bcf3b",
                                                "sense_id": "fdc6bd60-b8e7-342a-a6da-6d7d2ce58ca1",
                                                "text": "Upstairs the stakes are higher. [The vagina] can be used as a come-on for financial, marital, or other entrapments, as a squeezer by women who want to swindle a man out of his semen for dishonest or desperate impregnation, and as an impotent constrictor by those who want to deprive a man of his virile organ by violence, instead of caressing it into humility as an honest trophy-thief would do."
                                            },
                                            {
                                                "example_id": "bffd90b6-ee14-40ae-942e-3eb8153798ba",
                                                "sense_id": "fdc6bd60-b8e7-342a-a6da-6d7d2ce58ca1",
                                                "text": "Not all squeeze tactics rely on overt coercion, of course, as a squeezer's scheme sometimes can be achieved by lulling his squeezee into a false sense of security."
                                            },
                                            {
                                                "example_id": "58ca8272-a909-4823-8f79-be0e1683aa0f",
                                                "sense_id": "fdc6bd60-b8e7-342a-a6da-6d7d2ce58ca1",
                                                "text": "A narrative often hear during short squeezes is that short sellers represent the Wall Street Establishment, while the squeezers represent feisty entrepreneurs and Main Street ordinary folks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9369183c-f54f-394e-9f9e-83874a2f6d73",
                                        "entry_id": "fa5436f9-92c6-3c6d-9097-5c93cc550f70",
                                        "glosses": [
                                            "A hand job, an instance of male masturbation, or manual sex performed on a man."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fced753-787f-482d-93bc-0035a7e83a03",
                                                "sense_id": "9369183c-f54f-394e-9f9e-83874a2f6d73",
                                                "text": "You were playing Buckhunter at the bar last night and your game was so tight a gal offered to give you a squeezer in the parking lot."
                                            },
                                            {
                                                "example_id": "5bc9e208-433c-46ec-ac7d-5e5487026810",
                                                "sense_id": "9369183c-f54f-394e-9f9e-83874a2f6d73",
                                                "text": "Twenty-five one-armed squeezers sounds like a lot of unnecessary strain on the heart."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
