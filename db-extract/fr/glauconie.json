                        "entry_id": "26c14886-cc1c-321c-9c01-8cf54d0a6eb3",
                        "glosses": [
                            "Association de minéraux argileux du groupe des smectites et de micas comme la glauconite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a6b1d0e-b4f0-413b-ac71-c263c2e52c03",
                                "sense_id": "8be3da0f-e17b-3121-9270-9f7c3a5d6390",
                                "text": "La glauconie est très abondante dans les sables du Néogène en Campine dans la région d'Anvers en Belgique."
                            },
                            {
                                "example_id": "e3268ba6-24b3-4e91-818e-e6f8ec9f584b",
                                "sense_id": "8be3da0f-e17b-3121-9270-9f7c3a5d6390",
                                "text": "La glauconie est un association de minéraux phylliteux riches en fer ferrique, de couleur vert foncé épinard qui se forme en milieu marin et se présente fréquemment sous la forme de grains arrondis de la taille des sables (0,1 à 2 mm)."
                            }
                        ]
                    }
