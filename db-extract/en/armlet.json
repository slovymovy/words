                    },
                    {
                        "sense_id": "7acf946f-1a1e-3b62-bdf0-93a8a51a8d94",
                        "entry_id": "7d13cf1c-486a-3017-8c0f-227868ac3014",
                        "glosses": [
                            "A small arm."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "537ebeae-b3f0-4d9a-9248-cf975ccb6fe6",
                                "sense_id": "7acf946f-1a1e-3b62-bdf0-93a8a51a8d94",
