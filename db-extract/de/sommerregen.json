                "senses": [
                    {
                        "sense_id": "21f9136d-3256-3aba-a116-adf78fe8e41e",
                        "entry_id": "5abac7ac-379a-3524-87e3-138baab07b51",
                        "glosses": [
                            "Regen, der im Sommer fällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "385719da-0c35-4cb5-afed-30696fe0c74a",
                                "sense_id": "21f9136d-3256-3aba-a116-adf78fe8e41e",
                                "text": "„Auf Frankreich geht ein großer Sommerregen nieder, er schlägt in die Bäume, läßt das Laub klingeln wie Blech.“"
                            },
                            {
                                "example_id": "b937d046-e5a1-4139-8ea3-7ddccaed0a29",
                                "sense_id": "21f9136d-3256-3aba-a116-adf78fe8e41e",
                                "text": "„Minutenlang ließ ich mir wie ein im Sommerregen vergessener Gelähmter das Wasser über den Kopf regnen, es war wohltuend, dass das innere Kribbeln durch die prasselnden Tropfen übertönt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52a76ccf-2e8f-4746-9425-95be162660b0",
                        "source_entry_id": "5abac7ac-379a-3524-87e3-138baab07b51",
                        "source_sense_id": "21f9136d-3256-3aba-a116-adf78fe8e41e",
                        "source_sense_description": "Regen, der im Sommer fällt",
                        "target_lang_word": "summer rain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c79c8b49-3ae5-4fd2-914c-d43ea1790fa8",
                        "source_entry_id": "5abac7ac-379a-3524-87e3-138baab07b51",
                        "source_sense_id": "21f9136d-3256-3aba-a116-adf78fe8e41e",
                        "source_sense_description": "Regen, der im Sommer fällt",
                        "target_lang_word": "pluie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pluie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c90ecaa-313f-3407-a5eb-2a15bd46c98c",
                                        "entry_id": "6646bce5-d967-3579-bb43-f5ef62d7bbb4",
                                        "glosses": [
                                            "Ensemble de gouttes d’eau dues à la condensation de la vapeur d’eau de l’atmosphère, qui tombent du ciel sur la terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "110447b1-77b2-44c4-aee4-31c6b0236e5c",
                                                "sense_id": "2c90ecaa-313f-3407-a5eb-2a15bd46c98c",
                                                "text": "La condensation des vapeurs ou nuages donne lieu à la pluie ou à la neige, suivant les températures."
                                            },
                                            {
                                                "example_id": "3b347d70-11a2-4b97-933d-79b5b9731b2e",
                                                "sense_id": "2c90ecaa-313f-3407-a5eb-2a15bd46c98c",
                                                "text": "Des pluies éparses ou violentes, des épisodes cévenols, une tornade en Corse : après la vague des canicules et des grands incendies, la France connaît un « retour à la normale » chaotique."
                                            },
                                            {
                                                "example_id": "33440e6d-a056-46c2-8685-f0c65bf51f05",
                                                "sense_id": "2c90ecaa-313f-3407-a5eb-2a15bd46c98c",
                                                "text": "L’atmosphère avait été lourde pendant toute la journée, et le soir un orage terrible se déclara. Les coups de tonnerre se succédaient sans interruption ; la pluie tombait, torrentielle."
                                            },
                                            {
                                                "example_id": "5fa3cc10-4700-4952-8d8b-88228ccdd4ad",
                                                "sense_id": "2c90ecaa-313f-3407-a5eb-2a15bd46c98c",
                                                "text": "Les Aztèques éventraient couramment, qu’on raconte, dans leurs temples du soleil, quatre-vingt mille croyants par semaine, les offrant ainsi au Dieu des nuages, afin qu’il leur envoie la pluie."
                                            },
                                            {
                                                "example_id": "718250c4-51ee-423e-b301-bc36c1a72856",
                                                "sense_id": "2c90ecaa-313f-3407-a5eb-2a15bd46c98c",
                                                "text": "Une petite pluie froide faisait furtivement briller la couverture d’un appentis et tinter sur le zinc, à de rares intervalles, de pesantes gouttes d’eau qui s’échappaient d’une chanlatte percée."
                                            },
                                            {
                                                "example_id": "3bfda984-8f48-4907-b5b5-b95feaf17042",
                                                "sense_id": "2c90ecaa-313f-3407-a5eb-2a15bd46c98c",
                                                "text": "Une petite pluie mince et tenace dégoulinait sans arrêt depuis la veille et les passants, recroquevillés sous leurs riflards, les yeux rivés sur le pavé en larmes, glissant peureusement parmi les files des voitures serrées, lui fournissaient l’impression vague de spectres titubants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbaaa205-ea3b-3514-8401-1286c5e43081",
                                        "entry_id": "6646bce5-d967-3579-bb43-f5ef62d7bbb4",
                                        "glosses": [
                                            "Tout ce qui semble tomber du ciel comme la pluie."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a85709c4-f49c-4d30-8818-2c7d75660afd",
                                                "sense_id": "cbaaa205-ea3b-3514-8401-1286c5e43081",
                                                "text": "Il y avait deux longues heures que nous marchions, dans les champs, sous le soleil qui tombait du ciel comme une pluie de feu ; […]."
                                            },
                                            {
                                                "example_id": "f002cd7a-8747-4395-8238-757cfea80853",
                                                "sense_id": "cbaaa205-ea3b-3514-8401-1286c5e43081",
                                                "text": "Et, sous cette pluie de projectiles, on voit les bataillons des brigades Blondlat et Moussy, accrochés aux pentes dénudées du terrain, progresser lentement, courageusement, sûrement, vers Bertoncourt. Le sentiment général est que ce magnifique effort aboutira."
                                            },
                                            {
                                                "example_id": "1bc1253d-77c4-4b95-ae15-e0480494d19f",
                                                "sense_id": "cbaaa205-ea3b-3514-8401-1286c5e43081",
                                                "text": "C’est alors qu’une pluie de lacrymogènes s’est abattue sur la place, faisant suffoquer tout le quartier, y compris les clients des restaurants et des hôtels de luxe, ainsi que les passagers du métro, évacué en urgence."
                                            },
                                            {
                                                "example_id": "06af26c8-30ed-417a-9087-04b26867cb53",
                                                "sense_id": "cbaaa205-ea3b-3514-8401-1286c5e43081",
                                                "text": "Une pluie d’étoiles filantes."
                                            },
                                            {
                                                "example_id": "36d94a29-bb5d-4595-8f97-ea1254059bed",
                                                "sense_id": "cbaaa205-ea3b-3514-8401-1286c5e43081",
                                                "text": "Dans le voisinage des volcans, il se produit parfois des pluies de cendres et de soufre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a645c01-997b-3317-9665-c66dd7c6f32c",
                                        "entry_id": "6646bce5-d967-3579-bb43-f5ef62d7bbb4",
                                        "glosses": [
                                            "Chose qui arrive en abondance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fc8634b-5f9d-46e1-b337-944ff2bcd562",
                                                "sense_id": "4a645c01-997b-3317-9665-c66dd7c6f32c",
                                                "text": "Qu’es-tu devenue maintenant\nSous cette pluie de fer\nDe feu d’acier de sang"
                                            },
                                            {
                                                "example_id": "01371f10-f2ab-447f-b3a3-2e795d2aa58c",
                                                "sense_id": "4a645c01-997b-3317-9665-c66dd7c6f32c",
                                                "text": "Quoiqu’un peu gêné par cette pluie de compliments dont j’étais le seul à connaître le caractère fallacieux, je jouai la comédie de l’élève studieux qui trompe son monde ([…]) mais qu’il convient de ne pas juger […]."
                                            },
                                            {
                                                "example_id": "0a28efa4-6555-429a-a59f-f325aa9c5343",
                                                "sense_id": "4a645c01-997b-3317-9665-c66dd7c6f32c",
                                                "text": "Persécution, menaces physiques, pluie d’amendes : depuis des années, Memorial, avec ses 63 branches régionales (et 7 hors de Russie) était dans le collimateur de Poutine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d227cb1-6411-3759-8fb2-70388be4774e",
                                        "entry_id": "6646bce5-d967-3579-bb43-f5ef62d7bbb4",
                                        "glosses": [
                                            "Chute d’un grand nombre d’étincelles produites par une certaine composition de matières inflammables."
                                        ],
                                        "tags": [
                                            "Feux d’artifice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22cbf8be-812c-4837-8ff0-cb99001551a8",
                                                "sense_id": "8d227cb1-6411-3759-8fb2-70388be4774e",
                                                "text": "Pluies de feu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "614fd26f-5d09-44fa-9799-eb1cef4d4fb8",
                        "source_entry_id": "5abac7ac-379a-3524-87e3-138baab07b51",
                        "source_sense_id": "21f9136d-3256-3aba-a116-adf78fe8e41e",
                        "source_sense_description": "Regen, der im Sommer fällt",
                        "target_lang_word": "été",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "été",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4d37d6b-01e7-3869-92ee-fb246f91031e",
                                        "entry_id": "3f84d295-cf96-3a1c-a6d2-d2cc46c0fb1f",
                                        "glosses": [
                                            "La plus chaude des quatre saisons de l’année. Dans l’hémisphère nord, l’été astronomique s’étend du 7 mai au 7 août, le solstice d’été représentant le milieu de l’été. L’été météorologique, qui comprend les mois les plus chauds de l’année, comprend les mois de juin, juillet et août. L’été calendaire français, enfin, s’étend du 21 juin (solstice d’été) au 22 septembre (équinoxe d’automne). Dans l’hémisphère sud, ce découpage correspond à la saison d’hiver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d84cb99a-40c7-4eda-acd0-e48fbb991394",
                                                "sense_id": "d4d37d6b-01e7-3869-92ee-fb246f91031e",
                                                "text": "Seuls, dans un des versants caillouteux de la forêt, deux ou trois vieux hêtres accusaient, par quelques feuilles roussies prématurément, l’arrivée prochaine de l’automne et la mort de l’été."
                                            },
                                            {
                                                "example_id": "5cc956ff-e677-4af4-826c-42595422e807",
                                                "sense_id": "d4d37d6b-01e7-3869-92ee-fb246f91031e",
                                                "text": "C’était l’été austral ; le jeudi 19 novembre, je passai exactement sous le soleil à midi par un ciel sans nuages, sur un océan sans rides."
                                            },
                                            {
                                                "example_id": "9113fdb0-12ea-42ac-bb3a-d5e950dea869",
                                                "sense_id": "d4d37d6b-01e7-3869-92ee-fb246f91031e",
                                                "text": "Parmi les facteurs locaux, nous citerons d’abord la dégradation des pâturages causée par les abus de la transhumance, d’immenses troupeaux ayant été amenés des pays du Sud pour y trouver, pendant l’été, leur pâture."
                                            },
                                            {
                                                "example_id": "266fe55c-4258-4f54-88c9-0414dd158303",
                                                "sense_id": "d4d37d6b-01e7-3869-92ee-fb246f91031e",
                                                "text": "Il était entièrement vêtu de casimir noir, ainsi qu’il convient à un notaire. Mais comme on se trouvait au plus fort de l’été, M. Bernard avait cru pouvoir égayer sa tenue sévère d’une ombrelle d’alpaga blanc."
                                            },
                                            {
                                                "example_id": "cce0822a-edea-432d-b5cd-1c0579f30a12",
                                                "sense_id": "d4d37d6b-01e7-3869-92ee-fb246f91031e",
                                                "text": "Gasbieha et sa mère passaient le printemps au Caire, l’été à Alexandrie, et suivaient fréquemment le Pacha à Hélouan, où il soignait ses rhumatismes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "été",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4194ea1c-59c8-33a8-b671-c485ede7ee88",
                                        "entry_id": "3e7ba721-886b-3149-a7c1-7fd21cbb6fce",
                                        "glosses": [
                                            "Participe passé du verbe être (utilisable comme verbe auxiliaire)."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7714500-3b9d-4d4d-8ea1-49066723bf65",
                                                "sense_id": "4194ea1c-59c8-33a8-b671-c485ede7ee88",
                                                "text": "Nous avons été heureux de vous connaître."
                                            },
                                            {
                                                "example_id": "b03b2df8-d316-4572-a8f3-71871ed76d37",
                                                "sense_id": "4194ea1c-59c8-33a8-b671-c485ede7ee88",
                                                "text": "Toutes ces peines sont les mêmes que celles qui avaient été prévues par la loi du 13 août 1986."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ade64ed5-167d-4198-9170-997666a98566",
                        "source_entry_id": "5abac7ac-379a-3524-87e3-138baab07b51",
                        "source_sense_id": "21f9136d-3256-3aba-a116-adf78fe8e41e",
                        "source_sense_description": "Regen, der im Sommer fällt",
                        "target_lang_word": "orage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9e1ac8a-0fab-31fa-8f2c-d439d3909dbe",
                                        "entry_id": "dcdf05c6-9c0c-3fcd-9a5c-01b5eff96300",
                                        "glosses": [
                                            "Perturbation atmosphérique, ordinairement de peu de durée, qui se manifeste par un vent impétueux, de la pluie ou de la grêle, des éclairs et du tonnerre ou une tornade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c06f6f5-c825-4fe6-a659-6d53f592688a",
                                                "sense_id": "b9e1ac8a-0fab-31fa-8f2c-d439d3909dbe",
                                                "text": "J’entends sous le feuillage\nL’eau qui tombe à grand bruit,\nVoici, venir l’orage\nVoilà l’éclair qui luit.\nEntends-tu le tonnerre ?\nIl roule en approchant, …"
                                            },
                                            {
                                                "example_id": "af56ef0f-9dd6-4599-ad4a-edf669fe1105",
                                                "sense_id": "b9e1ac8a-0fab-31fa-8f2c-d439d3909dbe",
                                                "text": "La Verse ou le versage des blés, et de beaucoup de plantes céréales, est un accident occasionné, ou par de grands vents, des orages, de fortes pluies, ou par le trop d'embonpoint que prennent les plantes dans les temps chauds et humides."
                                            },
                                            {
                                                "example_id": "218e9fa1-eb01-4d8c-99cf-d1d5f363c890",
                                                "sense_id": "b9e1ac8a-0fab-31fa-8f2c-d439d3909dbe",
                                                "text": "On entendait incessamment sur le parc de Neuilly grêler les balles à travers les branches avec ce bruit des orages d'été que nous connaissons si bien."
                                            },
                                            {
                                                "example_id": "24a0f293-c133-4328-9dca-93d059e90472",
                                                "sense_id": "b9e1ac8a-0fab-31fa-8f2c-d439d3909dbe",
                                                "text": "L’atmosphère avait été lourde pendant toute la journée, et le soir un orage terrible se déclara. Les coups de tonnerre se succédaient sans interruption ; la pluie tombait, torrentielle."
                                            },
                                            {
                                                "example_id": "d33d1703-cae5-4317-b7a3-dd66ef86e5d2",
                                                "sense_id": "b9e1ac8a-0fab-31fa-8f2c-d439d3909dbe",
                                                "text": "Les violents orages de grêle qui ont touché la Dordogne, lundi 20 juin, notamment en Ribéracois, ont laissé des traces."
                                            },
                                            {
                                                "example_id": "74b27c62-9898-4fe2-adfb-667e217ca306",
                                                "sense_id": "b9e1ac8a-0fab-31fa-8f2c-d439d3909dbe",
                                                "text": "Le canon grondait en avant de nous, comme un orage lointain ; nous entendions cela depuis Toul ; ce n'était pour moi qu'une sorte d'éloquence. Nul parmi nous ne savait rien de la guerre ; […]."
                                            },
                                            {
                                                "example_id": "3b4b778a-7b71-4a36-916f-f16a5fd44ac4",
                                                "sense_id": "b9e1ac8a-0fab-31fa-8f2c-d439d3909dbe",
                                                "text": "Une tornade se forme lors d’orage violent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cf0297e-f610-362c-bb60-27fa84d13bd9",
                                        "entry_id": "dcdf05c6-9c0c-3fcd-9a5c-01b5eff96300",
                                        "glosses": [
                                            "Malheurs dont on est menacé ; disgrâces qui surviennent tout à coup, soit dans les affaires publiques, soit dans la fortune des particuliers."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9042a296-2b48-406e-8e14-b293bb2b4a13",
                                                "sense_id": "1cf0297e-f610-362c-bb60-27fa84d13bd9",
                                                "text": "[…] ; il me semble n’y avoir vu encore que des visages effarouchés ou rébarbatifs. Peut-être aussi les Parisiens ont-ils peur de l’orage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce2cc034-033e-339a-9868-58ff1ef1ecb7",
                                        "entry_id": "dcdf05c6-9c0c-3fcd-9a5c-01b5eff96300",
                                        "glosses": [
                                            "Désaccord violent qui se produit entre deux ou plusieurs personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "815b7716-43a1-482c-8dd0-e45cf7ebb671",
                                                "sense_id": "ce2cc034-033e-339a-9868-58ff1ef1ecb7",
                                                "text": "[…] ; et je me prépare à lui répondre par ma première épître aux Turgotins ».\nCe mot pouvait soulever un orage, car plusieurs des convives étaient d’anciens amis de Turgot."
                                            },
                                            {
                                                "example_id": "987c93a0-0573-45b3-89f5-1d8fcf62167a",
                                                "sense_id": "ce2cc034-033e-339a-9868-58ff1ef1ecb7",
                                                "text": "Même s’ils sont obligés de négocier, les gouvernements ont vu qu’ils pouvaient laisser passer l’orage. Résultat : les contestations ritualisées n’obtiennent quasiment plus de résultats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f611598a-009f-39c1-be56-d89376a16841",
                                        "entry_id": "dcdf05c6-9c0c-3fcd-9a5c-01b5eff96300",
                                        "glosses": [
                                            "Ce qui vient troubler la paix de l’âme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17379f9d-4b9a-4c8d-8e1f-5bd3f0db30f0",
                                                "sense_id": "f611598a-009f-39c1-be56-d89376a16841",
                                                "text": "Les orages des passions. - Les orages du cœur."
                                            }
                                        ]
                                    }
                                ]
                            },
