                ],
                "senses": [
                    {
                        "sense_id": "6c3a86e1-4032-3ee4-a2d0-13bdda867892",
                        "entry_id": "9cc92938-9915-3d94-b45a-70d2ff425f70",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30af3b69-102c-4f9c-93db-94ca2715d2c5",
                                "sense_id": "6c3a86e1-4032-3ee4-a2d0-13bdda867892",
                                "text": "Jahns kamen, sahen und siegten."
                            },
                            {
                                "example_id": "dc15c763-7903-48dc-9928-cafb82016b98",
                                "sense_id": "6c3a86e1-4032-3ee4-a2d0-13bdda867892",
                                "text": "Frau Jahn ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "00287d22-f492-4f70-8694-add53117831d",
                                "sense_id": "6c3a86e1-4032-3ee4-a2d0-13bdda867892",
                                "text": "Herr Jahn wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "75651946-26c7-4463-8955-9398178f055d",
                                "sense_id": "6c3a86e1-4032-3ee4-a2d0-13bdda867892",
                                "text": "Die Jahns fahren heute nach Dortmund."
                            },
                            {
                                "example_id": "d8814b87-a74e-4342-b867-f8de2fe68929",
                                "sense_id": "6c3a86e1-4032-3ee4-a2d0-13bdda867892",
                                "text": "Der Jahn trägt nie die Pullover, die die Jahn ihm strickt."
                            },
                            {
                                "example_id": "a11854cc-d02d-4af5-9214-6d11cd590cfa",
                                "sense_id": "6c3a86e1-4032-3ee4-a2d0-13bdda867892",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jahn kommt, geht der Herr Jahn.“"
                            },
                            {
                                "example_id": "00d19905-b692-4594-bf81-47b40b10accf",
                                "sense_id": "6c3a86e1-4032-3ee4-a2d0-13bdda867892",
                                "text": "Jahn kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
