{
    "word_family": [
        "haak",
        "haken",
        "ophanghaakje",
        "vishaakje"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "53a8c01c-a6df-3c49-8b15-b2ff279ef43d",
                    "sense_definition": "verkleinwoord van <w>haak</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "haak_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik hang mijn jas aan het kleine <w>haakje</w> achter de deur.",
                            "target_lang_translations": {
                                "en": "I hang my coat on the small <w>hook</w> behind the door."
                            }
                        },
                        {
                            "text": "Gedesillusioneerd rolde ik mijn vislijn weer op en borg het <w>haakje</w> weer veilig weg.",
                            "target_lang_translations": {
                                "en": "Disillusioned, I rolled up my fishing line and safely stored the <w>hook</w> away again."
                            }
                        }
                    ],
                    "common_phrases": [
                        "haakje aan de muur",
                        "klein haakje"
                    ],
                    "target_lang_definitions": {
                        "en": "diminutive of 'haak' (hook); a small curved or angular piece of metal or other material used for catching, pulling, or hanging things"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hook",
                                "target_lang_sense_clarification": "a small curved object for hanging or catching things"
                            },
                            {
                                "target_lang_word": "fishhook",
                                "target_lang_sense_clarification": "a small hook used for catching fish"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "725805fc-2f2d-3190-b99a-95dea8b8d1d7",
                    "sense_definition": "elk van de leestekens, rond of met hoeken, om woorden of getallen af te zonderen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "leesteken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de extra informatie tussen <w>haakjes</w> zetten.",
                            "target_lang_translations": {
                                "en": "You should put the extra information in <w>brackets</w>."
                            }
                        },
                        {
                            "text": "Het gebruik van ronde <w>haakjes</w> is in deze zin noodzakelijk.",
                            "target_lang_translations": {
                                "en": "The use of round <w>parentheses</w> is necessary in this sentence."
                            }
                        }
                    ],
                    "synonyms": [
                        "parenthese"
                    ],
                    "common_phrases": [
                        "tussen haakjes",
                        "ronde haakjes",
                        "vierkante haakjes"
                    ],
                    "target_lang_definitions": {
                        "en": "each of the punctuation marks, round or square, used to enclose and set off words or numbers"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bracket",
                                "target_lang_sense_clarification": "a punctuation mark used in pairs to enclose text"
                            },
                            {
                                "target_lang_word": "parenthesis",
                                "target_lang_sense_clarification": "specifically a round bracket ( )"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}