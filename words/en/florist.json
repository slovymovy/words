                },
                {
                    "sense_id": "d8413858-e1c4-39a8-aad0-7d247230ade5",
                    "sense_definition": "A person who cultivates or grows flowers, especially for commercial purposes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "flower_professionals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professional <w>florist</w> spent years developing a new variety of tulip.",
                            "target_lang_translations": {
                                "ru": "Профессиональный <w>цветовод</w> потратил годы на выведение нового сорта тюльпана.",
                                "zh": "这位专业的<w>花卉种植者</w>花了多年时间培育出一种新的郁金香品种。"
                            }
                        },
                        {
                            "text": "As a dedicated <w>florist</w>, he spends most of his time in the greenhouse.",
                            "target_lang_translations": {
                                "ru": "Как преданный своему делу <w>цветовод</w>, он проводит большую часть времени в оранжерее.",
                                "zh": "作为一名敬业的<w>花农</w>，他大部分时间都待在温室里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flower grower",
                        "cultivator"
                    ],
                    "common_phrases": [
                        "professional florist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который выращивает цветы, особенно для коммерческих целей.",
                        "zh": "专门从事花卉种植的人，通常以商业为目的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цветовод",
                                "target_lang_sense_clarification": "специалист по выращиванию цветов"
