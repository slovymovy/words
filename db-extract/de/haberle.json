                ],
                "senses": [
                    {
                        "sense_id": "738624dd-5852-3d25-b95d-cce462b3c354",
                        "entry_id": "53d6b1b4-9f9d-389d-aa7d-c836d6a6c03e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3d9da4c-d73f-4f48-b78d-f9a2695b328d",
                                "sense_id": "738624dd-5852-3d25-b95d-cce462b3c354",
                                "text": "Frau Haberle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f94adabb-a46f-47d8-a263-119bca335349",
                                "sense_id": "738624dd-5852-3d25-b95d-cce462b3c354",
                                "text": "Herr Haberle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7420f379-5345-48d1-8e1b-3c05af34b74f",
                                "sense_id": "738624dd-5852-3d25-b95d-cce462b3c354",
                                "text": "Die Haberles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "d58c1d5d-7ce9-42ca-b299-2b1198e2510c",
                                "sense_id": "738624dd-5852-3d25-b95d-cce462b3c354",
                                "text": "Der Haberle trägt nie die Pullover, die die Haberle ihm strickt."
                            },
                            {
                                "example_id": "93566b1f-cd4f-4c45-ac19-9cd31326016e",
                                "sense_id": "738624dd-5852-3d25-b95d-cce462b3c354",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Haberle kommt, geht der Herr Haberle.“"
                            },
                            {
                                "example_id": "04b51c09-5790-40a5-a36f-5b2d965234b0",
                                "sense_id": "738624dd-5852-3d25-b95d-cce462b3c354",
                                "text": "Haberle kommt und geht."
                            },
                            {
                                "example_id": "bfbeefd4-5796-413b-a55b-57e6ef732f29",
                                "sense_id": "738624dd-5852-3d25-b95d-cce462b3c354",
                                "text": "Haberles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
