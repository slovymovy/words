                        "examples": [
                            {
                                "example_id": "54604794-0013-412a-ba62-78dd03fb6995",
                                "sense_id": "dfe54afa-04a9-33a1-935d-35ca3062f0a7",
                                "text": "― Наша Луна ― это просяное зернышко в 3½ миллиметра, отстоящее от Земли на 38 сантиметров."
                            },
                            {
                                "example_id": "9a16764b-b793-4614-b9b6-b0f29b7a9ec9",
                                "sense_id": "dfe54afa-04a9-33a1-935d-35ca3062f0a7",
                                "text": "В пробку с двумя отверстиями, отстоящими друг от друга на 1 ― 1½ см, вставляют две стеклянные трубки〈…〉"
                            }
                        ]
