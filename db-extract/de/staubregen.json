                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7dee707-f8b6-4c82-9b16-dd2e2ae71312",
                        "source_entry_id": "b89ee2c3-95a5-3a56-82fe-ec54a4a0f532",
                        "source_sense_id": "b42184fd-61a5-3d1f-90df-68436c763c7a",
                        "source_sense_description": "Meteorologie: Regen, der in Form von ganz feinen Regentropfen niedergeht",
                        "target_lang_word": "crachin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crachin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6aef2a8-0cf0-36a8-bef2-cc844789c69d",
                                        "entry_id": "8580408c-b70e-3168-a7c1-41cfc3c2aff3",
                                        "glosses": [
                                            "Bruine ; petite pluie fine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a378a03-1476-44db-bd87-b3d53202b83e",
                                                "sense_id": "d6aef2a8-0cf0-36a8-bef2-cc844789c69d",
                                                "text": "La pluie giclait par les joints à demi arrachés des portières – cet air de ne pas y toucher du crachin qui, sur la distance, trempe aussi sûrement qu’une averse."
                                            },
                                            {
                                                "example_id": "d6058bc8-3c70-41d8-bfd8-ccb9676d5ebd",
                                                "sense_id": "d6aef2a8-0cf0-36a8-bef2-cc844789c69d",
                                                "text": "Malgré l’heure et le crachin, des bandes infatigables montaient et descendaient la rue Crébillon, braillant des chansons à boire et à forniquer."
                                            },
                                            {
                                                "example_id": "a4dbfbbc-041c-4ed0-86b5-b0ae3bbafc72",
                                                "sense_id": "d6aef2a8-0cf0-36a8-bef2-cc844789c69d",
                                                "text": "Un matin du mois de Juin, il mousine un petit crachin froid. Un gros camion vient de quitter le Champ du Trou : il emporte nos meubles."
                                            },
                                            {
                                                "example_id": "06c88602-8975-4345-888b-bb7032c475b2",
                                                "sense_id": "d6aef2a8-0cf0-36a8-bef2-cc844789c69d",
                                                "text": "Quand je dit pluie, je devrais dire crachin breton ! C'est le genre de perturbation qui n'arrose pas votre jardin, et qui ne lubrifie pas suffisamment le pare-brise pour que les essuie-glaces fonctionnent correctement."
                                            },
                                            {
                                                "example_id": "543ccc9b-76ce-4518-a3df-2af09ce7170f",
                                                "sense_id": "d6aef2a8-0cf0-36a8-bef2-cc844789c69d",
                                                "text": "Et puis, nous nous aimions encore, je crois, et cela nous rassurait. Nous gardions les yeux ouverts sur nos impatiences, nos désillusions, nos tiédeurs. Il n'y avait pas d'urgence, ce n'était pas un cataclysme qui menaçait, même pas un orage, mais plutôt un brouillard, un crachin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "888266c4-1ce4-4a80-9a33-a8fa838113eb",
                        "source_entry_id": "b89ee2c3-95a5-3a56-82fe-ec54a4a0f532",
                        "source_sense_id": "b42184fd-61a5-3d1f-90df-68436c763c7a",
                        "source_sense_description": "Meteorologie: Regen, der in Form von ganz feinen Regentropfen niedergeht",
                        "target_lang_word": "bruine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bruine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cef4fa9-25e7-37d0-b838-cb63fbc5f4e7",
                                        "entry_id": "cd4bc2df-95e9-39b3-8e5d-7cfb93468f37",
                                        "glosses": [
                                            "Petite pluie très fine et ordinairement froide qui tombe lentement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d75f392d-a8d0-4497-8ebf-7d6ffb47a77d",
                                                "sense_id": "3cef4fa9-25e7-37d0-b838-cb63fbc5f4e7",
                                                "text": "La pluie ou la bruine ont été les compagnes fidèles de presque toutes mes courses."
                                            },
                                            {
                                                "example_id": "4aa20f77-feb2-4ee2-8747-39ef1b7e81d4",
                                                "sense_id": "3cef4fa9-25e7-37d0-b838-cb63fbc5f4e7",
                                                "text": "D’abord on la prenait pour une simple bruine, un vague crachin que balayerait le premier coup de vent puis, au bout de quelques mètres, on se sentait pénétré d’une humidité froide et collante qui faisait regretter d’avoir renoncé au parapluie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bdbe302-de90-31ba-a2c6-1af9fa4d2d0d",
                                        "entry_id": "cd4bc2df-95e9-39b3-8e5d-7cfb93468f37",
                                        "glosses": [
                                            "Toute pluie de matériaux fins tombant lentement dans l'atmosphère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81f4f3fb-1c87-4fbb-ac23-8f97a71b8377",
                                                "sense_id": "4bdbe302-de90-31ba-a2c6-1af9fa4d2d0d",
                                                "text": "Associée à cette pluie de météorites, il faut ajouter une « bruine » quasi permanente de micrométéorites, de petits grains interplanétaires arrivant tous les jours sur la Terre. Actuellement, cette « bruine » correspond à environ 50 à 100 tonnes de grains par jour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bruine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "619981e9-224e-3b15-9e6f-df7c38501fd5",
                                        "entry_id": "cbad38c8-a46b-355d-a536-685563106ffa",
                                        "glosses": [
                                            "Nielle des blés, que ce soit celle de l’anguillule ou du charbon nu, voire la carie."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "980b892d-de09-43ea-aec4-fa1fb499d11d",
                                                "sense_id": "619981e9-224e-3b15-9e6f-df7c38501fd5",
                                                "text": "Les Laboureurs n’ignorent pas que l’abondance de la récolte dépend de la bonté du grain qu’ils emploient pour les semailles. Mais cette attention est sur-tout nécessaire pour le bled. La nielle, bruine, érourure, bosse, charbon, carie, &c., leur font bien connoître que l'intérieur du froment est converti en une poudre noire comme du charbon."
                                            },
                                            {
                                                "example_id": "7e440c5d-982d-4071-8350-c3096536964f",
                                                "sense_id": "619981e9-224e-3b15-9e6f-df7c38501fd5",
                                                "text": "La carie, que l'on nomme souvent aussi charbon ou bruine, produit sur le blé des désastres dont les résultats sont effrayants."
                                            },
                                            {
                                                "example_id": "c78c324b-dffd-479c-bf9f-f57ee9a8a719",
                                                "sense_id": "619981e9-224e-3b15-9e6f-df7c38501fd5",
                                                "text": "Il soulevait les gerbes et les ameulonnait en dizeaux tous les quarante pas. Les épis cariés, atteints de bruine et de charbon laissaient échapper une poudre noire quand il les secouait."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bruine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa9700f3-3eb3-3a01-93dd-d4d8ae709c40",
                                        "entry_id": "d8b42fc2-6d4f-3835-bd54-6894217b2eba",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de bruiner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38fe3f02-df85-300b-95bf-3a4fb9ab761d",
                                        "entry_id": "d8b42fc2-6d4f-3835-bd54-6894217b2eba",
                                        "glosses": [
                                            "Troisième personne du singulier du subjonctif présent de bruiner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f76a3ec2-b673-46ec-a120-d5d6fdb5475b",
                                                "sense_id": "38fe3f02-df85-300b-95bf-3a4fb9ab761d",
                                                "text": "Qu'il tombe des cordes ou qu'il bruine, qu'il drache ou qu'il gouttine, ça mouille !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
