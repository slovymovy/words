                "senses": [
                    {
                        "sense_id": "334d6b25-03ee-3dd1-a8fb-396d04ae6001",
                        "entry_id": "0857dc42-6ec3-351a-8493-cddd2d39db32",
                        "glosses": [
                            "teilweises oder totales Verschwinden der Fähigkeit, die eigene Sprache zu verwenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a373f03a-ff45-414e-8a0e-6c162a32b292",
                                "sense_id": "334d6b25-03ee-3dd1-a8fb-396d04ae6001",
                                "text": "Sprachverlust tritt oft als Folge eines Schlaganfalls auf."
                            },
                            {
                                "example_id": "855edc10-4845-4bc6-84d3-5a7e1766b7c9",
                                "sense_id": "334d6b25-03ee-3dd1-a8fb-396d04ae6001",
                                "text": "„Störungen der corticalen Sprachfelder führen zu Sprachverlust im engeren Sinn, zu Störungen der Fähigkeit, mit sich und anderen mit uns im System der Sprache umzugehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0e4d266c-accd-3008-b4f6-0620528dc054",
                        "entry_id": "0857dc42-6ec3-351a-8493-cddd2d39db32",
                        "glosses": [
                            "Aufgabe der eigenen Sprache zugunsten einer anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f287dd6-4ae7-4252-8930-4876677a94ca",
                                "sense_id": "0e4d266c-accd-3008-b4f6-0620528dc054",
                                "text": "Zu Sprachverlust infolge von Migration: „Langdauernder Aufenthalt führt schließlich zu Sprachwechsel…, was mitunter in Sprachverlust (Verlust der früheren S 1) einmündet.“"
                            },
                            {
                                "example_id": "aff28b5f-04ec-4a56-bf0c-abc64266726c",
                                "sense_id": "0e4d266c-accd-3008-b4f6-0620528dc054",
                                "text": "„Sein Sohn, ebenfalls Journalist, ist der deutschen Sprache hingegen schon nicht mehr mächtig. Dieser Sprachverlust ist symptomatisch für die jüngere Generation.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
