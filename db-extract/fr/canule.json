                                        "sense_id": "dc31b20a-274c-389b-a39b-54ca45bab33a",
                                        "entry_id": "c853b7e4-cb65-3728-90c2-c2831dc4f54e",
                                        "glosses": [
                                            "sehr dünnes Rohr, das an einem Ende oft sehr spitz ist und mit dem man Flüssigkeiten unter die Haut, in ein Blutgefäß oder ein Gewebe einbringen und daraus entfernen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88696197-498c-4e6c-a38d-417449bc7075",
                                                "sense_id": "dc31b20a-274c-389b-a39b-54ca45bab33a",
                                                "text": "Die Schwester setzte die Kanüle auf die Injektionsspritze und reichte sie dem Chirurgen."
                                            },
                                            {
                                                "example_id": "a0643407-fb08-4cc1-bea3-399c781fe7aa",
                                                "sense_id": "dc31b20a-274c-389b-a39b-54ca45bab33a",
                                                "text": "Etwa vier Zentimeter oberhalb der ersten Einstichstelle piekst der Pfleger ein zweites Mal für eine weitere Kanüle."
                                            },
                                            {
                                                "example_id": "ba5de915-c720-488c-b89b-1d16f82584bd",
                                                "sense_id": "dc31b20a-274c-389b-a39b-54ca45bab33a",
                                                "text": "„Die Kanüle sticht durch ihre Haut und die Zuckerlösung strömt in ihre Adern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
