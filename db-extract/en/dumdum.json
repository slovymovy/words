                        "entry_id": "35f69da4-a721-358f-8acf-40859e4ad7ae",
                        "glosses": [
                            "A soft-nosed bullet that expands on impact to cause a gaping wound."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed74bfd6-221d-4de7-a329-b10f00209701",
                                "sense_id": "91a77dd9-c3aa-3152-9ba4-b94334e96696",
                                "text": "He related to us how the savages make bullets from the heart of a very hard wood cured by a special process. These bullets are only effectual when fired from a short range, and when they lodge in the flesh they explode like dumdum bullets."
                            }
                        ]
                    }
