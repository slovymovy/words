                                    },
                                    {
                                        "sense_id": "18a93ad3-405e-376f-842e-5105997f9912",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "A ball that moves sideways in the air, or off the pitch, because it has been cut."
                                        ],
                                        "tags": [],
