                "senses": [
                    {
                        "sense_id": "2e43c51f-1b36-3b19-8c74-898e48ff9bf1",
                        "entry_id": "f201a211-331c-388d-83d4-07daeafaccf2",
                        "glosses": [
                            "zur Straße zeigende Ecke, welche sich auf einer befestigten Reihe von Steinen befindet, welche den Bürgersteig von der Straße abtrennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "813142d0-723f-4565-a72d-b2c75dea9455",
                                "sense_id": "2e43c51f-1b36-3b19-8c74-898e48ff9bf1",
                                "text": "Der Kopf knallte gegen die Bordsteinkante."
                            },
                            {
                                "example_id": "52ca85a1-c28a-4433-89a6-131962501566",
                                "sense_id": "2e43c51f-1b36-3b19-8c74-898e48ff9bf1",
                                "text": "„Und wo ist es jetzt, das Schöne, hätte ich schreien mögen, aber die Pillen dämpften meine Empörung zu einem unwilligen Kick gegen die Bordsteinkante in den Arkaden.“"
                            },
                            {
                                "example_id": "35cc87a1-1af8-4496-9ff8-36fc51dd6327",
                                "sense_id": "2e43c51f-1b36-3b19-8c74-898e48ff9bf1",
                                "text": "„Schon nach wenigen Schritten stellte ich überrascht fest, nicht mehr Herr meiner Beine zu sein, kam beim Versuch, eine Bordsteinkante zu nehmen, mit den Füßen völlig durcheinander und stürzte plump auf die Straße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
