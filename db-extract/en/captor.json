                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a318375-cbec-3e3d-819d-a3e26373991d",
                                        "entry_id": "2ae46888-a6c7-346d-9e6e-c3345c5504d8",
                                        "glosses": [
                                            "Person (oder Sache), die etwas fängt, auf- oder abfängt"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d5ac7fa-02d0-484f-a06c-b3fbdd75fe36",
                                                "sense_id": "3a318375-cbec-3e3d-819d-a3e26373991d",
                                                "text": "Der Fänger kam nach zwei Wochen wieder an Land."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6fca8a63-9cdb-3316-bdaf-b7e8cfb27d3d",
                                        "entry_id": "2ae46888-a6c7-346d-9e6e-c3345c5504d8",
                                        "glosses": [
                                            "die Person oder das Werkzeug, das dem Wild den Fang, also den schnellen Tod bringt"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e8997de-2fc1-4833-a324-5aeff4f44fad",
                                                "sense_id": "6fca8a63-9cdb-3316-bdaf-b7e8cfb27d3d",
                                                "text": "„Als gute Nachrichten eintreffen, müssen sie die Straße räumen: Ein Elefant sei gefangen, die Fänger bereits auf dem Weg. Nach ein paar Minuten biegt ein Lkw im Schritttempo um die Kurve, auf seiner Ladefläche liegt ein betäubter Elefantenbulle.“"
                                            },
                                            {
                                                "example_id": "0906fbb3-604d-411f-8119-01d4fd326ea2",
                                                "sense_id": "6fca8a63-9cdb-3316-bdaf-b7e8cfb27d3d",
                                                "text": "„Beiläufig die Hälfte war mit Musketen und Stutzen bewaffnet, alle aber hatten Lanzen, ein langes Schlachtmesser oder vielmehr Fänger und den Tomahawk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
