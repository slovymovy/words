                ],
                "senses": [
                    {
                        "sense_id": "2b5eda4d-7b43-32ff-917f-7bf468f652e8",
                        "entry_id": "cb4b9a5d-8e04-3787-9ed9-e19c37231083",
                        "glosses": [
                            "Se caractériser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "463065d9-f94e-438e-90a9-fe5df755de87",
                                "sense_id": "2b5eda4d-7b43-32ff-917f-7bf468f652e8",
                                "text": "L’identité s’affiche donc à tout instant pour caractériser autrui, s’auto-caractériser et lier des droits et des obligations à ces actes catégoriels."
                            },
                            {
                                "example_id": "d23518d2-8950-4e52-b8d9-9c3b20790d7f",
                                "sense_id": "2b5eda4d-7b43-32ff-917f-7bf468f652e8",
                                "text": "Andreas Beyer. Vous affirmez que le XXe siècle est trop jeune pour être vraiment caractérisé, mais il y a eu un moment, un épisode, où ce siècle s’est auto-caractérisé : le postmodernisme, du moins pour l’architecture."
                            }
                        ]
                    }
