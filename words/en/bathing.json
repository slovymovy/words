                {
                    "sense_id": "24e78525-2002-3a29-bdcb-61fc6153c50b",
                    "sense_definition": "The act of swimming or spending time in water for pleasure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "swimming_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no <w>bathing</w> allowed at this beach due to strong currents.",
                            "target_lang_translations": {
                                "ru": "<w>Купание</w> на этом пляже запрещено из-за сильного течения.",
                                "zh": "由于水流湍急，该海滩禁止<w>游泳</w>。"
                            }
                        },
                        {
                            "text": "She bought a new <w>bathing</w> suit for her holiday.",
                            "target_lang_translations": {
                                "ru": "Она купила новый <w>купальный</w> костюм для отпуска.",
                                "zh": "她为假期买了一套新的<w>泳衣</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "swimming"
                    ],
                    "common_phrases": [
                        "bathing suit",
                        "bathing cap",
                        "no bathing",
                        "bathing beauty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, связанное с плаванием или пребыванием в воде ради удовольствия.",
                        "zh": "指为了娱乐而在水中游泳或停留的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "купание",
                                "target_lang_sense_clarification": "плавание, отдых на воде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "游泳",
                                "target_lang_sense_clarification": "在水中游动"
                            },
                            {
                                "target_lang_word": "戏水",
                                "target_lang_sense_clarification": "在水中玩耍"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf411f6a-236c-3022-a69a-414f774044f8",
                    "sense_definition": "The act of washing oneself or another person in a bath.",
