                    {
                        "form_id": "e44e8f54-87fb-4fe2-a678-dd179b0545e1",
                        "entry_id": "aaeaaec0-f565-39cb-9d03-2a2408027c7e",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Schachfigur"
                    },
                    {
                        "form_id": "16ba9bfb-8622-4402-a898-448469a808f7",
                        "entry_id": "aaeaaec0-f565-39cb-9d03-2a2408027c7e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schachfiguren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b899e2b7-32dc-38be-9992-fc9a253ebc22",
                        "entry_id": "aaeaaec0-f565-39cb-9d03-2a2408027c7e",
                        "glosses": [
                            "Spielfigur beim Schachspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d7b12b9-b473-41fd-b926-bd286d1dab7d",
                                "sense_id": "b899e2b7-32dc-38be-9992-fc9a253ebc22",
                                "text": "Ich ziehe mit der Schachfigur."
                            },
                            {
                                "example_id": "1cb1f97f-85d6-4518-b178-90ecbe0406d3",
                                "sense_id": "b899e2b7-32dc-38be-9992-fc9a253ebc22",
                                "text": "Du machst einen Zug mit der Schachfigur."
                            },
                            {
                                "example_id": "3f933270-9224-44c1-a582-d53f5177a4a5",
                                "sense_id": "b899e2b7-32dc-38be-9992-fc9a253ebc22",
                                "text": "„Das ahnungslose Bereitstellen von Freilichtplätzen mit kindergroßen Schachfiguren in zahlreichen Großstadtparks lässt vermuten, dass das Wissen um die einstige blutige Praxis des Adelsspiels verlorengegangen ist.“"
                            },
                            {
                                "example_id": "18b774ab-7a8c-494a-a952-742415f0c86d",
                                "sense_id": "b899e2b7-32dc-38be-9992-fc9a253ebc22",
                                "text": "„Ich sage mit allem Nachdruck, der mir zu Gebote steht, daß die Deutschen unter allen Umständen vermeiden müssen, die Rolle einer Schachfigur im einen oder anderen Lager zu spielen.“"
                            },
                            {
                                "example_id": "4e4d6780-c598-44f0-996d-adef1dfedc9f",
                                "sense_id": "b899e2b7-32dc-38be-9992-fc9a253ebc22",
                                "text": "„Dort beugte sie sich über den Schachtisch und spielte mit den Schachfiguren.“"
                            },
                            {
                                "example_id": "69d74ea2-8dd1-42da-a3e8-9668a6098d96",
                                "sense_id": "b899e2b7-32dc-38be-9992-fc9a253ebc22",
                                "text": "„Boris war aufgestanden, um Rostow entgegenzugehen, hatte aber beim Aufstehen nicht vergessen, einige umgefallene Schachfiguren wieder auf ihre Plätze zu stellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d43bb77a-fb6e-4d2d-987b-b8a95e8ac3df",
