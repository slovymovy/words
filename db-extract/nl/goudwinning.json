                        "examples": [
                            {
                                "example_id": "82cf1399-6ef6-44d9-8383-a8b43b6c94f5",
                                "sense_id": "0d697863-a3d6-3c13-adff-8715fa9b8ca5",
                                "text": "De reden: goudwinning. Dat is niet nieuw in het gebied, maar onder de vorige president Bolsonaro is het aantal goudzoekers explosief gestegen. De afgelopen vier jaar zijn zeker 570 kinderen overleden aan ondervoeding."
                            },
                            {
                                "example_id": "9774b2eb-9630-4349-8dcf-7fe3ab140364",
                                "sense_id": "0d697863-a3d6-3c13-adff-8715fa9b8ca5",
                                "text": "Ook twee bedrijven die banden hebben met de rivaliserende paramilitaire Rapid Support Forces (RSF) staan op de sanctielijst. Zij zijn betrokken bij goudwinning en worden geleid door de leider van de RSF-militie, generaal Hemedti."
                            },
                            {
                                "example_id": "87e01d8c-ffdf-465d-8571-ad40e53fc90f",
                                "sense_id": "0d697863-a3d6-3c13-adff-8715fa9b8ca5",
                                "text": "De Amazone-landen hebben verschillende economische belangen bij het regenwoud. Knelpunten waren de aanpak van illegale goudwinning en het al dan niet toestaan van nieuwe olie- en gasboringen in het gebied."
                            }
                        ]
                    }
