                        "form": "den Energieverbrauch"
                    },
                    {
                        "form_id": "9d0bddcf-15b2-442f-9e33-e4a1a76982bb",
                        "entry_id": "f64d4a31-a19e-3761-b026-71b41f5e0801",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Energieverbräuche"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a86b38bf-9bd9-3b6b-8141-70dde4e4d9ab",
                        "entry_id": "f64d4a31-a19e-3761-b026-71b41f5e0801",
                        "glosses": [
                            "die Menge an Energie (insbesondere pro Zeit oder Strecke), die bei einem Vorgang der Verwendung von Energie in nutzbarer Form (siehe Bedeutung [2]) eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d205902-e33d-49d6-8ff2-c615d43ac467",
                                "sense_id": "a86b38bf-9bd9-3b6b-8141-70dde4e4d9ab",
                                "text": "Der Energieverbrauch steigt an, wenn man schneller fährt."
                            },
                            {
                                "example_id": "5a4e48a1-a46f-4858-97b1-d108a2ad843c",
                                "sense_id": "a86b38bf-9bd9-3b6b-8141-70dde4e4d9ab",
                                "text": "„Das Entscheidende ist, dass es ohne eine Umlage der tatsächlichen Kosten des Energieverbrauchs auf die Bevölkerung keine Veränderung des Verbraucherverhaltens geben wird.“"
                            },
                            {
                                "example_id": "b5be8a0d-b34c-4cfd-81b8-30f255d59968",
                                "sense_id": "a86b38bf-9bd9-3b6b-8141-70dde4e4d9ab",
                                "text": "„Der Energieverbrauch der Schweiz betrug rund 794 Petajoule (PJ) im Jahr 2021.“"
                            },
                            {
                                "example_id": "fb291993-f172-4dc6-9517-8da275a8cf29",
                                "sense_id": "a86b38bf-9bd9-3b6b-8141-70dde4e4d9ab",
                                "text": "„Indien hat weltweit den drittgrößten Energieverbrauch hinter China und den USA.“"
                            },
                            {
                                "example_id": "97394470-4e6d-4e00-b51e-b9ca66451a7e",
                                "sense_id": "a86b38bf-9bd9-3b6b-8141-70dde4e4d9ab",
                                "text": "[Frankreich:] „22 Prozent des Energieverbrauches wird von Erdgas abgedeckt, vor allem im Wohnbereich und in der Industrie.“"
                            },
                            {
                                "example_id": "3461b736-b266-4507-8003-ceeb7bf8b567",
                                "sense_id": "a86b38bf-9bd9-3b6b-8141-70dde4e4d9ab",
                                "text": "Der Energieverbrauch sinkt, die Emissionen nicht. Deutschland hat 2022 fast genauso viel CO₂ ausgestoßen wie im Jahr zuvor."
                            },
                            {
                                "example_id": "3b0d7ace-4c0a-4fab-aeb9-8f20828fa5f9",
                                "sense_id": "a86b38bf-9bd9-3b6b-8141-70dde4e4d9ab",
                                "text": "„Schließlich hat die österreichische Bundesregierung kürzlich im Rahmen der \"Mission 11\" die Bevölkerung aufgerufen, ihren Energieverbrauch um elf Prozent zu senken.“"
                            },
                            {
                                "example_id": "8b4f89be-e94c-4add-8d86-f81e69c40b78",
                                "sense_id": "a86b38bf-9bd9-3b6b-8141-70dde4e4d9ab",
                                "text": "[Afrika:] „Bis 2040 wird sich der Energieverbrauch auf dem Kontinent voraussichtlich verdoppeln.“"
                            },
                            {
                                "example_id": "bc7040ec-589b-4033-8ce1-e1696924ea14",
                                "sense_id": "a86b38bf-9bd9-3b6b-8141-70dde4e4d9ab",
                                "text": "„Damit sank der Energieverbrauch in der gesamten Fabrik um 20 Prozent, 170 Tonnen CO₂-Emmissionen werden pro Jahr gespart.“"
                            },
                            {
                                "example_id": "0f8878c8-aa49-4c0d-986c-36de99abe528",
                                "sense_id": "a86b38bf-9bd9-3b6b-8141-70dde4e4d9ab",
                                "text": "„Seit 2016 reduziert das Museum“ […] „seinen Energieverbrauch. Der Museums-Altbau wurde energetisch saniert, die nächtliche Außenbeleuchtung ausgeschaltet, Lampen mit stromsparenden Leuchtdioden bestückt, das Warmwasser für die Belegschaft abgestellt.“"
                            },
                            {
                                "example_id": "27dc6c4e-c6a8-4282-9e58-bf74b62381d6",
                                "sense_id": "a86b38bf-9bd9-3b6b-8141-70dde4e4d9ab",
                                "text": "„In punkto Energieverbrauch sind die privaten Haushalte in Deutschland alles andere als sparsam.“"
                            },
                            {
                                "example_id": "b0300a14-1923-40d3-b76f-cd70f8446817",
                                "sense_id": "a86b38bf-9bd9-3b6b-8141-70dde4e4d9ab",
                                "text": "„Der Energieverbrauch beim Waschen ist in erster Linie von der Waschtemperatur abhängig, da das Aufheizen des Wassers deutlich mehr Energie verbraucht als die Trommelbewegung.“"
                            },
                            {
                                "example_id": "099c8c47-7255-40d6-811c-e5f0e57fe6e5",
                                "sense_id": "a86b38bf-9bd9-3b6b-8141-70dde4e4d9ab",
                                "text": "Manche Haushalte haben einen übermäßigen Energieverbrauch."
                            },
                            {
                                "example_id": "d4f78e8d-b1db-4a2e-9284-afccff2b91da",
                                "sense_id": "a86b38bf-9bd9-3b6b-8141-70dde4e4d9ab",
                                "text": "„Dem Anstieg der Heizkosten steht […] ein geringerer Energieverbrauch gegenüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "66f19a7d-5f43-3c7d-8207-63b14a889469",
                        "entry_id": "f64d4a31-a19e-3761-b026-71b41f5e0801",
                        "glosses": [
                            "der Vorgang der Verwendung von Energie in nutzbarer Form (wobei diese in eine nicht nutzbare Form – oft in die Umwelt entweichende Abwärme – umgewandelt wird)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3084bda5-10f9-4758-ab66-594ce6cdb040",
                                "sense_id": "66f19a7d-5f43-3c7d-8207-63b14a889469",
                                "text": "„Blockheizkraftwerke sind kleinere modulare Kraft-Wärme-Kopplungsanlagen, die im Regelfall am Ort des Energieverbrauchs betrieben werden.“"
                            },
                            {
                                "example_id": "9955fb2a-6302-4374-b0e7-142287110dc3",
                                "sense_id": "66f19a7d-5f43-3c7d-8207-63b14a889469",
                                "text": "„Am Ort des Energieverbrauchs wird die ‚Transport‘-Hochspannung wieder auf niedrigere Verteilungsspannungen umgespannt.“"
                            },
                            {
                                "example_id": "eb79e271-e6b2-4ac3-85c9-fd698bb7cc31",
                                "sense_id": "66f19a7d-5f43-3c7d-8207-63b14a889469",
                                "text": "„Innerhalb der jeweiligen Produktkategorien gibt es darüber hinaus weitere Einteilungen. Dies betrifft die Art des Energieverbrauchs sowie die Geräteart.“"
                            },
                            {
                                "example_id": "de9ddf7c-cd8b-4d91-9f81-7199d8579216",
                                "sense_id": "66f19a7d-5f43-3c7d-8207-63b14a889469",
                                "text": "„Eine vorausgesagte Alternative der Art des Energieverbrauchs im Jahre 2000 setzt eine vollelektrische Wirtschaft voraus, in der direkter Verbrauch von Brennstoffen auf einem Mindestmaß gehalten wird und die Energie, wo immer das möglich ist, in der Form der Elektrizität verwendet wird.“"
                            },
                            {
                                "example_id": "2224f901-9483-48f2-8820-2f12b7a867fa",
                                "sense_id": "66f19a7d-5f43-3c7d-8207-63b14a889469",
                                "text": "„Die gegenüber der Energieerzeugung und -verteilung erhobenen Forderungen des Umweltschutzes werden aber in gleicher Weise auch am Ort des Energieverbrauchs, insbesondere gegenüber dem Straßenfahrzeug, erhoben und sprechen dort für den Ersatz des Mineralöles durch die Elektrizität.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
