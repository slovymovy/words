                "senses": [
                    {
                        "sense_id": "55351fae-9fbb-3abc-9e9c-efc8ac6e521c",
                        "entry_id": "40d12ea4-b0fa-32de-aa7e-54b42c334b22",
                        "glosses": [
                            "meist nichtreligiöse Feier zur Geburt eines Kindes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72e01971-2f2c-4f4a-90a2-e1c7bb93a87e",
                                "sense_id": "55351fae-9fbb-3abc-9e9c-efc8ac6e521c",
                                "text": "„Als Alternative hat sich inzwischen das Kinderwillkommensfest etabliert, eine frei gestaltete, private Familienfeier, in der das Kind ‚offiziell‘ begrüßt wird.“"
                            },
                            {
                                "example_id": "d9caca68-910b-49f9-b683-2939523162b5",
                                "sense_id": "55351fae-9fbb-3abc-9e9c-efc8ac6e521c",
                                "text": "„Das Kinderwillkommensfest oder auch Kinderwillkommensfeier bezeichnet die Begrüßungszeremonie für Kinder durch den Freien Redner, die anstelle der Taufe initiiert wird.“"
                            },
                            {
                                "example_id": "85ae0261-2419-4c0e-bc2b-e6ba8dfbe6bd",
                                "sense_id": "55351fae-9fbb-3abc-9e9c-efc8ac6e521c",
                                "text": "„Manchmal wird es auch Lebensfeier, Willkommensfest, Willkommensfeier, Geburtsfest oder Geburtsfeier genannt. Den Begriff freie Taufe oder zivile Taufe verwenden auch einige. Die Expertin, mit der wir zu diesem Thema gesprochen haben, sagt nur kurz und knapp: ‚KiWi‘ – also kurz für Kinderwillkommensfest.“"
                            },
                            {
                                "example_id": "13c54e97-ee0e-4eb8-bce2-e0a59e1d0bbf",
                                "sense_id": "55351fae-9fbb-3abc-9e9c-efc8ac6e521c",
                                "text": "„Neben Ideen für das Kinderwillkommensfest möchten wir Ihnen auch Rituale und Möglichkeiten zur Patenschaft vorstellen.“"
                            },
                            {
                                "example_id": "502925d6-fa9f-4d28-8db0-da0b0960faad",
                                "sense_id": "55351fae-9fbb-3abc-9e9c-efc8ac6e521c",
                                "text": "„Das Kinderwillkommensfest, auch Lebensbegrüßungsfest genannt, ist die Alternative zur kirchlichen Taufe und wird in Deutschland immer beliebter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
