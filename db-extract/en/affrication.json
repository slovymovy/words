                    {
                        "sense_id": "d7751118-e797-315c-9118-2dda3efebbe2",
                        "entry_id": "422831ea-0fe8-391d-b299-4e3427ff7d4a",
                        "glosses": [
                            "Le phénomène d’affrication."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7ad16a7e-defa-4ff0-869e-42eccfa5dbe3",
                                "sense_id": "d7751118-e797-315c-9118-2dda3efebbe2",
                                "text": "The affrication of [t-] and sometimes of [d-] appears, for example, in the speech of many university students from middle class families."
                            },
                            {
                                "example_id": "2b071d43-a4b1-4685-abc6-847c3ccaf374",
                                "sense_id": "d7751118-e797-315c-9118-2dda3efebbe2",
                                "text": "[…] an inspection of the Atlas materials reveals that affrication of the palato-dental stops [t’ d’] is widespread from North Galway northwards, being particularly common around the north west coast of Mayo."
                            }
                        ]
                    },
                    {
                        "sense_id": "e31433fa-42a9-346b-932f-f8b86d3a3962",
                        "entry_id": "422831ea-0fe8-391d-b299-4e3427ff7d4a",
                        "glosses": [
                            "Une occurrence de ce phénomène."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "ebd39b7c-7b14-4406-b435-f28c985feca3",
                                "sense_id": "e31433fa-42a9-346b-932f-f8b86d3a3962",
                                "text": "[…] in southern Alberta, as early as 1860 — where a French Metis was known to the anglophones of the area as Butcheesh […], the spelling tch denoting here an affrication in the name Baptiste."
                            }
                        ]
                    }
