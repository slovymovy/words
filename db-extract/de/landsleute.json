                "senses": [
                    {
                        "sense_id": "6e492e2f-1720-3cc3-8f4f-3e548f4b8c35",
                        "entry_id": "878d2f0d-e2b6-3714-b8ee-9c141ba183b7",
                        "glosses": [
                            "Menschen, die aus dem gleichen Land kommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f91e7d4-59cd-46f6-983d-be811615aab7",
                                "sense_id": "6e492e2f-1720-3cc3-8f4f-3e548f4b8c35",
                                "text": "Im Urlaub bin ich froh, wenn ich irgendwo Landsleute finde, denen ich mich anschließen kann."
                            },
                            {
                                "example_id": "a2f81a59-8932-462b-b022-897a66e4e5ed",
                                "sense_id": "6e492e2f-1720-3cc3-8f4f-3e548f4b8c35",
                                "text": "„Aufständische wurden von den USA unterstützt, sie hielten ständigen Kontakt zu Landsleuten in New York und Miami.“"
                            },
                            {
                                "example_id": "6801f5b5-b5a6-4f61-bb92-432ba35c9442",
                                "sense_id": "6e492e2f-1720-3cc3-8f4f-3e548f4b8c35",
                                "text": "„Mit seinen Landsleuten wird Janosch manches Mal gnadenlos abrechnen.“"
                            },
                            {
                                "example_id": "023fa742-3e09-4d97-aa9e-e1f5396d9cce",
                                "sense_id": "6e492e2f-1720-3cc3-8f4f-3e548f4b8c35",
                                "text": "„Wohl um seine Position zu festigen, sagt der neue König seinen aufgebrachten Landsleuten eine konstitutionelle Monarchie zu.“"
                            },
                            {
                                "example_id": "1c4d8841-64b4-4210-bea6-cbba0e23f752",
                                "sense_id": "6e492e2f-1720-3cc3-8f4f-3e548f4b8c35",
                                "text": "„Am Ende wurden Jakschs Landsleute vertreiben.“"
                            },
                            {
                                "example_id": "0da2e7f5-75e5-483f-8afe-2814d85993c0",
                                "sense_id": "6e492e2f-1720-3cc3-8f4f-3e548f4b8c35",
                                "text": "„Gabriel Matabili war also keine Ausnahme, und er integrierte sich wie viele seiner Landsleute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
