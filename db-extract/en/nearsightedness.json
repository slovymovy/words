                    {
                        "translation_id": "b72b7112-e725-4b4c-9dfb-dad4db915a4a",
                        "source_entry_id": "343c1c62-b467-3978-abc8-57125c5a6a85",
                        "source_sense_id": "35360379-84e4-3ca1-a7f0-ff6ea3a5efb3",
                        "source_sense_description": "property of being nearsighted",
                        "target_lang_word": "myopie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myopie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e9a0d57-7d6e-32cf-8470-42586cccde21",
                                        "entry_id": "cbc1c287-2979-3fc9-8a71-7f9913fd8f3d",
                                        "glosses": [
                                            "État de ceux qui sont myopes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc857db6-f874-410a-afcd-a6f8e61f0711",
                                                "sense_id": "5e9a0d57-7d6e-32cf-8470-42586cccde21",
                                                "text": "La connexion qui existe entre la myopie binoculaire et le strabisme divergent n'a pas non plus passé inaperçue autrefois."
                                            },
                                            {
                                                "example_id": "120b33a1-d559-4e68-bfb9-1096a38dc065",
                                                "sense_id": "5e9a0d57-7d6e-32cf-8470-42586cccde21",
                                                "text": "Ferdinand trottait derrière nous, avec cet air un peu égaré que lui donnait, que lui donne toujours sa myopie."
                                            },
                                            {
                                                "example_id": "8b71fa79-0931-4560-bd9a-2e05436f3220",
                                                "sense_id": "5e9a0d57-7d6e-32cf-8470-42586cccde21",
                                                "text": "Ma myopie renforçait encore l’impression d’irréel, de cauchemar que je ressentais et contre laquelle je m’efforçais de lutter, dans la crainte de voir se briser ma volonté."
                                            },
                                            {
                                                "example_id": "defb0e4c-9665-4f9c-b191-969a65da09fc",
                                                "sense_id": "5e9a0d57-7d6e-32cf-8470-42586cccde21",
                                                "text": "En fait il conduisait sa voiture avec beaucoup de prudence, à cause d’une légère myopie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9ed64c2-b379-39b6-8496-0cd479197de9",
                                        "entry_id": "cbc1c287-2979-3fc9-8a71-7f9913fd8f3d",
                                        "glosses": [
                                            "Incapacité de bien distinguer une situation, un problème, une perspective."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30c941e8-daaa-42b1-ac64-02952e9aa2ec",
                                                "sense_id": "e9ed64c2-b379-39b6-8496-0cd479197de9",
                                                "text": "Une voix implacable et sérieuse penche à votre oreille pour vous dire que nos passions sont des menteuses, que c’est notre myopie qui fait les beaux visages et notre ignorance les belles âmes, et qu’il vient nécessairement un jour où l’idole, pour le regard plus clairvoyant, n’est plus qu’un objet, non pas de haine, mais de mépris et d’étonnement !"
                                            },
                                            {
                                                "example_id": "0bbcce67-3aef-4c00-8b41-73823c2b79c3",
                                                "sense_id": "e9ed64c2-b379-39b6-8496-0cd479197de9",
                                                "text": "Pourquoi cette myopie sur soi au nom de la lucidité sur l’autre que soi ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75582823-5330-3820-adfe-91e3908dc3ec",
                                        "entry_id": "cbc1c287-2979-3fc9-8a71-7f9913fd8f3d",
                                        "glosses": [
                                            "Incapacité de voir à long terme."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa9dc0ab-661a-4a84-93d7-73028a6fffb2",
                                                "sense_id": "75582823-5330-3820-adfe-91e3908dc3ec",
                                                "text": "Dans l’imaginaire collectif américain, l’idée de séparation, de sécession, est associée à celles de régression, de tragédie, de myopie politique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d7e33ec-fe52-49f8-ab1e-1aaa0c684e4e",
                        "source_entry_id": "343c1c62-b467-3978-abc8-57125c5a6a85",
                        "source_sense_id": "35360379-84e4-3ca1-a7f0-ff6ea3a5efb3",
                        "source_sense_description": "property of being nearsighted",
                        "target_lang_word": "Kurzsichtigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurzsichtigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1c79737-f3b3-3dd3-9c62-e4138400a3fe",
                                        "entry_id": "748ccaef-ebe3-3d9d-b29e-d764050a98ac",
                                        "glosses": [
                                            "häufiger Sehfehler, bei dem nur Objekte in der Nähe scharf gesehen werden können, weiter entfernte Objekte werden verschwommen wahrgenommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17681ed6-b287-440c-9895-e04636b77dce",
                                                "sense_id": "d1c79737-f3b3-3dd3-9c62-e4138400a3fe",
                                                "text": "Kurzsichtigkeit lässt sich durch eine Brille leicht ausgleichen."
                                            },
                                            {
                                                "example_id": "9e47feaa-ca50-42e7-bb77-92be78ede5d9",
                                                "sense_id": "d1c79737-f3b3-3dd3-9c62-e4138400a3fe",
                                                "text": "„Emma Bertini ließ sich dank ihrer Kurzsichtigkeit durch die wilde Bewegung nicht stören.“"
                                            },
                                            {
                                                "example_id": "257080f3-30da-4dc0-aa41-a9ea104afc5a",
                                                "sense_id": "d1c79737-f3b3-3dd3-9c62-e4138400a3fe",
                                                "text": "„Wegen starker Kurzsichtigkeit von der Bundeswehr befreit, hatte er die Hälfte seines Chemiestudiums schon hinter sich und war seinen Studienkollegen weit voraus, eben weil er seine Freizeit kaum anders als in der Universität verbrachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ed142a89-a531-3a4f-849d-d74a76d307e9",
                                        "entry_id": "748ccaef-ebe3-3d9d-b29e-d764050a98ac",
                                        "glosses": [
                                            "Mangel an Weitblick, Unfähigkeit spätere Konsequenzen seines Handelns abschätzen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e4b4692-62ec-4da8-aa2a-3417fb08d4a1",
                                                "sense_id": "ed142a89-a531-3a4f-849d-d74a76d307e9",
                                                "text": "Die Beschlüsse der Regierung sind an Kurzsichtigkeit nicht zu überbieten."
                                            },
                                            {
                                                "example_id": "3d38d3e5-453f-4a72-9473-0bb137db4eee",
                                                "sense_id": "ed142a89-a531-3a4f-849d-d74a76d307e9",
                                                "text": "„Dieser Fehler spiegelt nicht nur die Kurzsichtigkeit des Literaturkritikers wider, mit der er sich selbst zum Gespött der französischen Literaturwelt machte, sondern auch, wie mühelos sich das Buch ohne diesen Buchstaben liest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
