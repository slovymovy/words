                                "sense_id": "beb3465b-e309-3af4-9b02-247154977a72",
                                "text": "The Gulf of Thailand became more overfished than ever, causing acrimonious conflicts between domestic artisanal and large-scale fishers."
                            },
                            {
                                "example_id": "0966e5e3-dd50-48ea-8527-50e4881d6bd1",
                                "sense_id": "beb3465b-e309-3af4-9b02-247154977a72",
                                "text": "It is the most overfished of any hole that I know, this Nine Mile Hole."
                            }
