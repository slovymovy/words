                "senses": [
                    {
                        "sense_id": "cd0b3efb-e5d0-39f3-b253-caccf8d62e7b",
                        "entry_id": "70c7031d-84bb-3186-825e-d612e76df9ab",
                        "glosses": [
                            "Donner un caractère nymphomane à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41d014c5-8a65-43a7-afc6-3909840699ea",
                                "sense_id": "cd0b3efb-e5d0-39f3-b253-caccf8d62e7b",
                                "text": "Une Maiwenn qui, décidément, me confirme que je la préfère en tant que réalisatrice et une Sara Forestier dont le rôle reste sans grand intérêt car les deux premières suffisaient à nymphiser voire nymphomaniser les puissances féminines en présence."
                            },
                            {
                                "example_id": "6282f5a5-dcf0-47de-902b-20d04cd000f9",
                                "sense_id": "cd0b3efb-e5d0-39f3-b253-caccf8d62e7b",
                                "text": "C'est donc qu'il faut pousser l'érotisation fantasmatique de son psychisme. La nymphomaniser quoi !"
                            }
                        ]
                    },
                    {
                        "sense_id": "11506f51-f86e-393a-9014-602763b2a58c",
                        "entry_id": "70c7031d-84bb-3186-825e-d612e76df9ab",
                        "glosses": [
                            "Avoir un comportement nymphomane."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fc41c962-421e-43bd-9da3-6f77d64792e6",
                                "sense_id": "11506f51-f86e-393a-9014-602763b2a58c",
                                "text": "On pourra nymphomaniser ensemble et tout."
                            }
                        ]
                    }
