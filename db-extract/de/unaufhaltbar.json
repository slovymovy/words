                "senses": [
                    {
                        "sense_id": "e420373e-eeeb-311b-bf65-0007029508ca",
                        "entry_id": "d1d280d2-d7e0-34c4-a27b-2b075270b06d",
                        "glosses": [
                            "so, dass es nicht aufgehalten werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a392c40-ff2e-4841-b9e4-37d6e3e9bd0d",
                                "sense_id": "e420373e-eeeb-311b-bf65-0007029508ca",
                                "text": "„Ananas, Erdbeeren, Pfirsiche, die ersten Äpfel … meine Hand geht schreibend weiter, unaufhaltbar, und mit ihr meine Erinnerung. Ich entfliehe ihr nicht. Ich entrinne mir nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87c67706-a790-4b26-8e39-d73645e5592a",
                        "source_entry_id": "d1d280d2-d7e0-34c4-a27b-2b075270b06d",
                        "source_sense_id": "e420373e-eeeb-311b-bf65-0007029508ca",
                        "source_sense_description": "so, dass es nicht aufgehalten werden kann",
                        "target_lang_word": "unstoppable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unstoppable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fa2a19f-76f2-3004-8520-46c738905f8c",
                                        "entry_id": "d52897ee-1f2e-359f-9a15-bfe9bc4238ca",
                                        "glosses": [
                                            "Unable to be stopped."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "087e0ab7-614d-4611-820b-d010934c91e1",
                                                "sense_id": "2fa2a19f-76f2-3004-8520-46c738905f8c",
                                                "text": "Their \"greatly unstoppable fight\" against the cause was a joke."
                                            },
                                            {
                                                "example_id": "162aead1-59c4-4e01-a674-14d6cc39fa93",
                                                "sense_id": "2fa2a19f-76f2-3004-8520-46c738905f8c",
                                                "text": "In these early days of silent pictures, the accent was chiefly on thrills and danger as provided by supposedly unstoppable locomotives with crooks or maniacs on the footplate."
                                            },
                                            {
                                                "example_id": "77d75dd2-0210-4443-852a-b8e96b66ac17",
                                                "sense_id": "2fa2a19f-76f2-3004-8520-46c738905f8c",
                                                "text": "However Russian Pavlyuchenko stunned his compatriots with an unstoppable 25-yard drive into the top corner."
                                            },
                                            {
                                                "example_id": "8de8c845-2eab-45b5-a930-23070b56aca1",
                                                "sense_id": "2fa2a19f-76f2-3004-8520-46c738905f8c",
                                                "text": "I'm so powerful / I don't need batteries to play / I'm so confident / Yeah, I'm unstoppable today"
                                            },
                                            {
                                                "example_id": "ec603c51-5806-4a4a-9ab1-c851a054f616",
                                                "sense_id": "2fa2a19f-76f2-3004-8520-46c738905f8c",
                                                "text": "20 January 2017, Donald Trump, Inauguration Speech\nWhen America is united, America is totally unstoppable."
                                            },
                                            {
                                                "example_id": "93db8a2c-6796-4f64-9f87-7a401aa5bdc9",
                                                "sense_id": "2fa2a19f-76f2-3004-8520-46c738905f8c",
                                                "text": "These trains were ordered years before the pandemic, commissioned to tackle a problem that has (for now) gone away. Passenger numbers are no longer increasing at an unstoppable rate, driven by rising central London employment. The extra capacity is not currently needed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
