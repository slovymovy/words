                                    {
                                        "sense_id": "204943f0-2630-39ee-99f9-21cff43a1a20",
                                        "entry_id": "b65603a4-b205-35a5-85ba-637f70e599e0",
                                        "glosses": [
                                            "Gestell einer Brille, in das die Brillengläser eingepasst sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c24acc2a-75d7-4328-aa08-b82b12e6423e",
                                                "sense_id": "204943f0-2630-39ee-99f9-21cff43a1a20",
                                                "text": "„Jedes zweite irgendwo in der Welt eingesetzte Brillenglas sowie jede vierte Brillenfassung stammen von dem Konzern.“"
                                            },
                                            {
                                                "example_id": "5ae04043-7e42-4745-9dd7-eda038e93501",
                                                "sense_id": "204943f0-2630-39ee-99f9-21cff43a1a20",
                                                "text": "„Eine Brillenfassung aus purem, 18-karätigem Gold gehört zu den Attraktionen der Fachmesse opti ab Freitag in München.“"
                                            },
                                            {
                                                "example_id": "6e4524cb-645f-4915-b2ef-7b9a8039dab3",
                                                "sense_id": "204943f0-2630-39ee-99f9-21cff43a1a20",
                                                "text": "„Durch Zukäufe etwa von Marchon Eyewear, einem bedeutenden Hersteller von Brillenfassungen, hat VSP Vision Care internationales Aufsehen erlangt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc1eafff-3f1f-4ee4-a6b1-daf3eb95747f",
