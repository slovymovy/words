    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b3fb6135-baed-31be-9d95-998ea37113b3",
                    "sense_definition": "Characterized by simplicity and an absence of luxury or comfort; plain and bare.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rigorous_lifestyle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student accommodation had only <w>spartan</w> furnishings, providing merely a desk, a lamp, and a narrow bed.",
                            "target_lang_translations": {
                                "nl": "Het studentenverblijf had slechts een <w>spartaans</w> meubilair en bood enkel een bureau, een lamp en een smal bed."
                            }
                        },
                        {
                            "text": "He chose to live in a <w>spartan</w> room with almost no decoration so he could focus entirely on his writing.",
                            "target_lang_translations": {
                                "nl": "Hij koos ervoor om in een <w>spartaanse</w> kamer met nauwelijks enige decoratie te wonen, zodat hij zich volledig op zijn schrijven kon richten."
                            }
                        }
                    ],
                    "synonyms": [
                        "austere",
                        "bare",
                        "plain",
                        "simple",
                        "unadorned"
                    ],
                    "antonyms": [
                        "luxurious"
                    ],
                    "common_phrases": [
                        "spartan conditions",
                        "spartan lifestyle",
                        "spartan surroundings"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gekenmerkt door eenvoud en een gebrek aan luxe of comfort; kaal en sober."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "spartaans",
                                "target_lang_sense_clarification": "zeer sober, zonder comfort"
                            },
                            {
                                "target_lang_word": "sober",
                                "target_lang_sense_clarification": "eenvoudig en zonder overbodige luxe"
                            },
                            {
                                "target_lang_word": "kaal",
                                "target_lang_sense_clarification": "zonder versiering of meubilair"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a216c036-d47c-3ba3-b496-3923bda0a6e8",
                    "sense_definition": "Marked by strict discipline, frugality, or self-denial.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rigorous_lifestyle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athletic coach enforced a <w>spartan</w> regime that involved early morning runs and a very restricted diet.",
                            "target_lang_translations": {
                                "nl": "De atletiekcoach legde een <w>spartaans</w> regime op dat bestond uit hardlopen in de vroege ochtend en een zeer strikt dieet."
                            }
                        },
                        {
                            "text": "Living under such <w>spartan</w> discipline taught the young recruits how to endure long periods of hardship.",
                            "target_lang_translations": {
                                "nl": "Het leven onder zo'n <w>spartaanse</w> discipline leerde de jonge rekruten om lange periodes van tegenspoed te doorstaan."
                            }
                        }
                    ],
                    "synonyms": [
                        "austere",
                        "severe"
                    ],
                    "antonyms": [
                        "indulgent"
                    ],
                    "common_phrases": [
                        "spartan existence",
                        "spartan regime"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gekenmerkt door een strikte discipline, soberheid of zelfopoffering."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "spartaans",
                                "target_lang_sense_clarification": "streng en vol ontberingen"
                            },
                            {
                                "target_lang_word": "streng",
                                "target_lang_sense_clarification": "strikt qua regels of discipline"
                            },
                            {
                                "target_lang_word": "rigoureus",
                                "target_lang_sense_clarification": "onverbiddelijk strikt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a0e2ff4-89b4-31e5-983a-fa2130fa5ca1",
                    "sense_definition": "Showing great courage, endurance, or resolve in the face of danger or adversity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite suffering multiple injuries during the storm, the sailors maintained a <w>spartan</w> resolve until help arrived.",
                            "target_lang_translations": {
                                "nl": "Ondanks dat ze tijdens de storm meerdere verwondingen opliepen, behielden de zeelieden een <w>spartaanse</w> vastberadenheid totdat er hulp arriveerde."
                            }
                        },
                        {
                            "text": "Her <w>spartan</w> courage inspired the rest of the team to keep moving forward despite freezing conditions.",
                            "target_lang_translations": {
                                "nl": "Haar <w>spartaanse</w> moed inspireerde de rest van het team om door te blijven gaan ondanks de ijskoude omstandigheden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spartan courage",
                        "spartan resolve"
                    ],
                    "target_lang_definitions": {
                        "nl": "Blijk gevend van grote moed, uithoudingsvermogen of vastberadenheid bij gevaar of tegenspoed."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "spartaans",
                                "target_lang_sense_clarification": "moedig en volhardend onder ontberingen"
                            },
                            {
                                "target_lang_word": "heldhaftig",
                                "target_lang_sense_clarification": "grote dapperheid tonend"
                            },
                            {
                                "target_lang_word": "onverschrokken",
                                "target_lang_sense_clarification": "zonder angst bij tegenslag"
                            }
                        ]
                    }
                }
            ]
        }
    ]
