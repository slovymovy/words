                "senses": [
                    {
                        "sense_id": "34fb75bb-6fe3-3dc1-bda0-521bdda86b54",
                        "entry_id": "69a6ab34-4cc9-3f0c-983a-7a563af0f6ea",
                        "glosses": [
                            "Racler une planche de liège pour en enlever le bois qui y est resté fixé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54f15e26-d46a-4574-8e3f-808ebb1ee6ec",
                                "sense_id": "34fb75bb-6fe3-3dc1-bda0-521bdda86b54",
                                "text": "Lorsque le rusquier a mis le liége en pile, il s’occupe de le démérer."
                            },
                            {
                                "example_id": "847ba7d1-3fee-4a6d-8c9c-b4e0e03c69c7",
                                "sense_id": "34fb75bb-6fe3-3dc1-bda0-521bdda86b54",
                                "text": "Les planches de liège subissent, avant d’être livrées au commerce, une préparation qui a pour but de les débarrasser de leur croûte extérieure. On appelle cela démérer."
                            }
                        ]
                    }
