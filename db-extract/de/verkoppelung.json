                ],
                "senses": [
                    {
                        "sense_id": "2f2b2cc6-423c-3155-843a-0891ccb12382",
                        "entry_id": "d2a8af68-54b5-3f4b-8669-1f591112e0d5",
                        "glosses": [
                            "das Verbinden, Zusammenführen von verschiedenen Dingen; das Herstellen, Bestehen eines Zusammenhanges, einer Abhängigkeit voneinander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "563d6c40-e891-4bce-9d55-b24963f8b380",
                                "sense_id": "2f2b2cc6-423c-3155-843a-0891ccb12382",
                                "text": "„Die unmittelbare Wirkung der Verkoppelung aber war ein weiteres Verschwinden von Kleinbetrieben.“"
                            },
                            {
                                "example_id": "508384bf-2d7e-4097-aafe-c6fdc712a9bb",
                                "sense_id": "2f2b2cc6-423c-3155-843a-0891ccb12382",
                                "text": "„Dann kam die Separation (Verkoppelung, Zusammenlegung von Grundstücken), die jede Handbreit Boden unter den Pflug genommen sehen wollte.“"
                            },
                            {
                                "example_id": "64b80142-1d57-462a-bf90-19ececdfa75f",
                                "sense_id": "2f2b2cc6-423c-3155-843a-0891ccb12382",
                                "text": "„Als Beispiel für eine solche maschinelle Verkoppelung dient die Beziehung Brust der Mutter und Mund des Kindes.“"
                            },
                            {
                                "example_id": "ddc69d8b-8f60-4790-8eb4-5e078210bc30",
                                "sense_id": "2f2b2cc6-423c-3155-843a-0891ccb12382",
                                "text": "„Die Verkoppelung zweier Stromkreise über das magnetische Feld ist die physikalische Basis induktiv gekoppelter RFID-Systeme.“"
                            },
                            {
                                "example_id": "3ef09fb2-9080-42a1-8547-993af222d38e",
                                "sense_id": "2f2b2cc6-423c-3155-843a-0891ccb12382",
                                "text": "„Die Verkoppelung des Risikos zwischen Amerika und Europa bleibt Voraussetzung funktionierender Sicherheit für beide.“"
                            },
                            {
                                "example_id": "61a1277d-9740-49d7-a7cb-59b5e93fe31b",
                                "sense_id": "2f2b2cc6-423c-3155-843a-0891ccb12382",
                                "text": "„Durch die Verkoppelung der Mindestlöhne mit dem Index der Lebenskosten, die alle drei Monate zu automatischen Anpassungen führt, wurde seit der Wollhausse die Inflation wesentlich beschleunigt.“"
                            },
                            {
                                "example_id": "73760039-95be-4a7e-a14f-b2cdfeb365e8",
                                "sense_id": "2f2b2cc6-423c-3155-843a-0891ccb12382",
                                "text": "„Wir haben dort große Deckenhöhen in den Tiefgaragen, so dass auch eine Verkoppelung mit dem Busbahnhof denkbar wäre.“"
                            },
                            {
                                "example_id": "c17df03c-4f61-4c75-80f2-17241dde6cfa",
                                "sense_id": "2f2b2cc6-423c-3155-843a-0891ccb12382",
                                "text": "„Dank ihrer vertrackten Verkoppelung von Wirklichkeit, artifiziellem Glanz und kulturkritischem Kommentar, von Wahrheit und Scheinbild, parodistischer Überspitzung und Täuschung finden ihre Werke rasch den Beifall der kunsttheoretischen Vordenker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
