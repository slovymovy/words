                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proprioception",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fa4dbe4-7b55-3992-a424-3c62fa9c489a",
                                        "entry_id": "22de9136-59bb-3a04-8cf8-71157e30be66",
                                        "glosses": [
                                            "The sense of the position of parts of the body, relative to other neighbouring parts of the body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c5968f2-4637-4898-a11e-4523d10dc3e6",
                                                "sense_id": "1fa4dbe4-7b55-3992-a424-3c62fa9c489a",
                                                "text": "[…] it is achieved through a neuromuscular feedback system known as proprioception or kinaesthetic awareness, as well as through an auditory control system in which the ear monitors the sound and makes […]"
                                            },
                                            {
                                                "example_id": "248d2a87-b50a-4aee-89af-22560a32a67f",
                                                "sense_id": "1fa4dbe4-7b55-3992-a424-3c62fa9c489a",
                                                "text": "Sometimes referred to as our sixth sense, proprioception is what helps high-level athletes take a penalty without looking at the ball, or orient themselves in the air while doing a twisting somersault."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
