                "senses": [
                    {
                        "sense_id": "d1f8e209-9c40-3fe6-9145-240d635aa8c0",
                        "entry_id": "08fe903d-9a78-3ce9-a852-8c97bc6e9ac7",
                        "glosses": [
                            "North Vietnam (a former Communist country in Southeast Asia that governed northern Vietnam from 1945 to 1975)"
                        ],
                        "tags": [
                            "historical",
                            "neuter",
                            "proper-noun"
                        ],
                        "examples": [
                            {
                                "example_id": "22e8001e-5eaa-4d4c-8f11-bcfdc4727cba",
                                "sense_id": "d1f8e209-9c40-3fe6-9145-240d635aa8c0",
                                "text": "Das kommunistische Regime in Nordvietnam lag zwar nicht an der Hauptfront des Kalten Krieges, entzog sich aber dennoch den Möglichkeiten eines Stellvertreterkrieges, wie er zwischen West und Ost in vielen Ländern der Dritten Welt geführt wurde.",
                                "translation": "The communist regime in North Vietnam was not on the main front of the Cold War, but it still took advantage of the possibilities of a proxy war, just like it was fought between West and East in many countries of the Third World.",
                                "english": "The communist regime in North Vietnam was not on the main front of the Cold War, but it still took advantage of the possibilities of a proxy war, just like it was fought between West and East in many countries of the Third World."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d448923-27d3-396e-93b4-2e2fb8be21fa",
                        "entry_id": "08fe903d-9a78-3ce9-a852-8c97bc6e9ac7",
                        "glosses": [
                            "northern Vietnam (a geographic region in northern Vietnam)"
                        ],
                        "tags": [
                            "neuter",
                            "proper-noun"
                        ],
                        "examples": [
                            {
                                "example_id": "ad102e75-b90b-406a-8ea8-35e9031c0004",
                                "sense_id": "9d448923-27d3-396e-93b4-2e2fb8be21fa",
                                "text": "Um jedoch in die malerische Naturkulisse Nordvietnams und das ursprüngliche Leben der hier ansässigen Minderheiten eintauchen zu können, muss man in die Wanderschuhe schlüpfen, Sa Pa hinter sich lassen und Mama Lili in die Reisterrassen folgen.",
                                "translation": "To immerse oneself in the picturesque natural scenery of northern Vietnam and the original life of the indigenous minority communities living here, one must lace up one's hiking boots, leave Sa Pa behind, and follow Mama Lili to the rice terraces.",
                                "english": "To immerse oneself in the picturesque natural scenery of northern Vietnam and the original life of the indigenous minority communities living here, one must lace up one's hiking boots, leave Sa Pa behind, and follow Mama Lili to the rice terraces."
                            }
                        ]
                    }
