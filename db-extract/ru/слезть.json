                        "tags": [],
                        "examples": [
                            {
                                "example_id": "480f9e81-303a-403d-a929-d9e642e13fa5",
                                "sense_id": "8819fae2-8cb1-3bd4-9a29-e9240a3c7689",
                                "text": "Слезть с чердака. Слезь со стула."
                            }
                        ]
                    },
                    {
                        "sense_id": "905dd74d-8b58-3d6c-a5b0-4f14c6797a9d",
                        "entry_id": "812523c1-a8b1-3afb-a63e-56d0ba38638c",
                        "glosses": [
                            "прост. доехав до определенного места, выйти (о пассажире)"
                        ],
                        "tags": [],
                        "examples": [
                            {
