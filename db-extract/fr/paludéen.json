                    {
                        "form_id": "9985a6cf-d2ea-4387-9839-dd7974557a38",
                        "entry_id": "23dcb6b5-901e-3119-a03b-4f50bd9f9e5e",
                        "tags": [
                            "feminine"
                        ],
                        "form": "paludéenne"
