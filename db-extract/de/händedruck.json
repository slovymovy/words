                "senses": [
                    {
                        "sense_id": "aecf3e89-fe2b-3495-86ea-6f31f4c5af56",
                        "entry_id": "af69cb41-d84c-3573-9599-aedcea44b0a6",
                        "glosses": [
                            "Action par laquelle deux personnes se prennent la main en signe d'accord ou de salutation amicale, poignée de main."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5aa78ee-a7c7-43a7-90d2-9c5384b446a3",
                                "sense_id": "aecf3e89-fe2b-3495-86ea-6f31f4c5af56",
                                "text": "Mit einem langen Händedruck vor den Kameras im Innenhof des Elysée-Palastes hat Emmanuel Macron dem saudischen Kronprinzen Muhammad Bin Salman am Donnerstagabend einen ungewöhnlich herzlichen Empfang bereitet.",
                                "translation": "Emmanuel Macron a réservé un accueil inhabituellement chaleureux au prince héritier saoudien Mohammed Ben Salmane, jeudi soir, en lui serrant longuement la main devant les caméras dans la cour de l'Élysée."
                            },
                            {
                                "example_id": "bde24c65-51d2-492e-958f-c0ea54fac8f5",
                                "sense_id": "aecf3e89-fe2b-3495-86ea-6f31f4c5af56",
                                "text": "In dem spartanischen Büro mit geschlossenen Vorhängen, in das man mich schließlich führt, steht er da, in Jeans und schwarzem Pullover. Ein Händedruck, kein Lächeln. Er ist auf der Hut.",
                                "translation": "Dans le bureau spartiate, rideaux tirés, où on me fait finalement entrer, il se tient debout, en jean et pull noirs. Poignée de main, pas de sourire. Aux aguets."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a9b55bb-c7d8-3aa4-b345-081b2c0cc7d7",
                        "entry_id": "af69cb41-d84c-3573-9599-aedcea44b0a6",
                        "glosses": [
                            "Pression que l’on crée en serrant la main."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
