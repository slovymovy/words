                            "text": "Le professeur <w>explique</w> la nouvelle règle de grammaire aux élèves.",
                            "target_lang_translations": {
                                "en": "The teacher <w>explains</w> the new grammar rule to the students.",
                                "ru": "Учитель <w>объясняет</w> ученикам новое правило грамматики.",
                                "nl": "De leraar <w>legt</w> de nieuwe grammaticaregel aan de leerlingen <w>uit</w>.",
                                "de": "Der Lehrer <w>erklärt</w> den Schülern die neue Grammatikregel.",
                                "pl": "Nauczyciel <w>tłumaczy</w> uczniom nową regułę gramatyczną.",
                                "it": "Il professore <w>spiega</w> la nuova regola grammaticale agli studenti.",
                                "cs": "Profesor <w>vysvětluje</w> žákům nové gramatické pravidlo.",
                                "tr": "Öğretmen öğrencilere yeni dilbilgisi kuralını <w>açıklıyor</w>.",
                                "es": "El profesor <w>explica</w> a los alumnos la nueva regla de gramática.",
                                "zh": "老师向学生<w>解释</w>新的语法规则。"
                            }
                        },
                        {
                            "text": "Pouvez-vous m'<w>expliquer</w> comment fonctionne cet appareil dans le bureau ?",
                            "target_lang_translations": {
                                "en": "Could you <w>explain</w> to me how this device works in the office?",
                                "ru": "Не могли бы вы мне <w>объяснить</w>, как работает этот прибор в офисе?",
                                "nl": "Kunt u mij <w>uitleggen</w> hoe dit apparaat op kantoor werkt?",
                                "de": "Können Sie mir <w>erklären</w>, wie dieses Gerät im Büro funktioniert?",
                                "pl": "Czy mógłby mi Pan <w>wyjaśnić</w>, jak działa to urządzenie w biurze?",
                                "it": "Potrebbe <w>spiegarmi</w> come funziona questo apparecchio in ufficio?",
                                "cs": "Můžete mi <w>vysvětlit</w>, jak tenhle přístroj v kanceláři funguje?",
                                "tr": "Ofiste bu cihazın nasıl çalıştığını bana <w>açıklar</w> mısınız?",
                                "es": "¿Podría <w>explicarme</w> cómo funciona este aparato en la oficina?",
                                "zh": "您能给我<w>讲解</w>一下这台设备在办公室里是怎么运作的吗？"
                            }
                        }
