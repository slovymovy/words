                                    {
                                        "sense_id": "0092a435-e5dd-39f5-9a3b-89bca55d47ce",
                                        "entry_id": "aca7c12d-d4d7-382f-b826-c632452f5ac3",
                                        "glosses": [
                                            "Staat in Westafrika"
                                        ],
