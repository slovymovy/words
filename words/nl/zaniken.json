            "senses": [
                {
                    "sense_id": "0edcd693-3edd-313b-8449-bdb64c1b41d0",
                    "sense_definition": "op een vervelende manier blijven klagen over onbelangrijke zaken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "klagen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>zanikte</w> de hele dag over dat kleine krasje op zijn nieuwe auto.",
                            "target_lang_translations": {
                                "en": "He <w>nagged</w> all day about that tiny scratch on his new car."
                            }
                        },
                        {
                            "text": "Je moet niet zo <w>zaniken</w> over het weer, want we kunnen er niets aan veranderen.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>whine</w> so much about the weather, because we can't change it anyway."
                            }
                        }
                    ],
                    "synonyms": [
                        "zeuren",
                        "jengelen",
                        "mekkeren",
                        "dreinen"
                    ],
                    "common_phrases": [
                        "niet zo zaniken",
                        "blijven zaniken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to keep complaining in an annoying way about unimportant matters"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nag",
                                "target_lang_sense_clarification": "to repeatedly complain or remind someone about something"
                            },
                            {
