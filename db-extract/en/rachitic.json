                        "translation_id": "a858ca77-8a86-4a8c-b915-ab822d2252c6",
                        "source_entry_id": "78712cef-2095-35fb-b347-6594c414f80f",
                        "source_sense_description": "of or pertaining to, or affected by, rickets",
                        "target_lang_word": "rachitique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rachitique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0bbc5ae5-9f5a-32c7-842a-97c27481524c",
                                        "entry_id": "dd64b9d8-3db8-3a7b-8962-4628927fb71b",
                                        "glosses": [
                                            "Qui est affecté de rachitisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30bf2333-b4f0-4c6f-b0e0-643c8acc45fb",
                                                "sense_id": "0bbc5ae5-9f5a-32c7-842a-97c27481524c",
                                                "text": "Nous trouverions sans doute la malheureuse dans quelque attitude pauvre, rabougrie et rachitique comme ces prisonniers des plombs de Venise qui vieillissaient ployés en deux."
                                            },
                                            {
                                                "example_id": "a6074c7b-5952-4403-bb78-bf58af61dab9",
                                                "sense_id": "0bbc5ae5-9f5a-32c7-842a-97c27481524c",
                                                "text": "Le vieillard devait avoir soixante-dix ans, […]. On devinait dans ce corps rachitique une effrayante usure de tous les rouages organiques."
                                            },
                                            {
                                                "example_id": "b3e1efdc-3be0-4654-8fe0-f8f67233f5a8",
                                                "sense_id": "0bbc5ae5-9f5a-32c7-842a-97c27481524c",
                                                "text": "Même le petit Germain qui peinait devant lui à soutenir la bannière alourdie par le vent, le dégoûtait avec sa nuque creuse et sa calotte de travers sur une tignasse hirsute, avec ses épaules rachitiques, ses jambes tortes à la peau grenue, tachée de crasse et zèbrée de grafignures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86dab6c4-5e01-3998-a9d9-e6db933e0e47",
                                        "entry_id": "dd64b9d8-3db8-3a7b-8962-4628927fb71b",
                                        "glosses": [
                                            "Qualifie une affection qui tient du rachitisme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fa4500a-f2f3-3e5b-abea-b2d2049aab83",
                                        "entry_id": "dd64b9d8-3db8-3a7b-8962-4628927fb71b",
                                        "glosses": [
                                            "Qualifie des plantes avortées ou qui se développent mal."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c6bd158-1840-400a-91f9-fc3c9a1baea8",
                                                "sense_id": "6fa4500a-f2f3-3e5b-abea-b2d2049aab83",
                                                "text": "Des blés rachitiques. — Des arbres rachitiques."
                                            },
                                            {
                                                "example_id": "bdfdcf5a-61b2-4210-92bf-e839207adb6e",
                                                "sense_id": "6fa4500a-f2f3-3e5b-abea-b2d2049aab83",
                                                "text": "On appelle ainsi chez la Mère Cadet le feuillage clair-semé de deux ou trois arbres rachitiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50ce8353-e677-34c1-b93e-57d78a2ba549",
                                        "entry_id": "dd64b9d8-3db8-3a7b-8962-4628927fb71b",
                                        "glosses": [
                                            "Qui est peu développé."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5656a09a-62b3-417d-9de0-94c0b28cb69c",
                                                "sense_id": "50ce8353-e677-34c1-b93e-57d78a2ba549",
                                                "text": "C'est ce qui explique à la fois le caractère rachitique du secteur commercial créé par les petits colporteurs et boutiquiers chinois, et son développement à pas de tortue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rachitique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09f0cd1e-ef97-3e18-b234-3bac86685d31",
                                        "entry_id": "2c880596-3c71-30b6-8917-a2f0b16499d7",
                                        "glosses": [
                                            "Malade atteint de rachitisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "801b0d62-1256-4e0a-8eb9-bca33a785226",
                                                "sense_id": "09f0cd1e-ef97-3e18-b234-3bac86685d31",
                                                "text": "Un bossu, un rachitique , créés ainsi par Dieu, ne sont plus dignes de lui."
                                            },
                                            {
                                                "example_id": "b0703d46-d01f-47ba-a3fe-92bd0d825b7c",
                                                "sense_id": "09f0cd1e-ef97-3e18-b234-3bac86685d31",
                                                "text": "De plus en plus nombreux étaient les malheureux qui demandaient des soins et de la nourriture. C'était un défilé ininterrompu de clopineux, d’idiots de naissance, de rachitiques, d’épileptiques, d’ulcéreux, de variqueux perdus […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e380613e-739d-4cd8-bf20-b489f3baf322",
                        "source_entry_id": "78712cef-2095-35fb-b347-6594c414f80f",
                        "source_sense_description": "of or pertaining to, or affected by, rickets",
                        "target_lang_word": "rachitisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rachitisch",
