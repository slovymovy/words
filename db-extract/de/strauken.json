                "senses": [
                    {
                        "sense_id": "6fa7aaaa-02c9-3179-afda-db0db48953c1",
                        "entry_id": "788997ea-b930-34d9-80a2-b4110f4a12f1",
                        "glosses": [
                            "krankheitsbedingte Verstopfung der Nase"
                        ],
                        "tags": [
                            "Austrian German",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "c776bfe5-26ac-4ada-936f-1722c5ccb9c0",
                                "sense_id": "6fa7aaaa-02c9-3179-afda-db0db48953c1",
                                "text": "„Er hat halt eine verschlagene Strauken, und so wie bei ein anderen Menschen dadurch eine Krankheit weggeht, so schaut er nur, daß er die G'sunden dran kriegt.“"
                            },
                            {
                                "example_id": "e1c91328-f5ba-4bfd-acf4-8512a0231803",
                                "sense_id": "6fa7aaaa-02c9-3179-afda-db0db48953c1",
                                "text": "„Die Nachtluft ist gar g'fährlich, sie könnten die Strauken kriegen.“"
                            },
                            {
                                "example_id": "9fb7f3b5-5a62-416a-a307-c347e2d2ab88",
                                "sense_id": "6fa7aaaa-02c9-3179-afda-db0db48953c1",
                                "text": "„Weinen ist sehr gesund für ein Frauenzimmer, es erleichtert die Brustbeklemmungen, mildert den Herzkrampf, und befördert den Fortgang der Strauken.“"
                            },
                            {
                                "example_id": "b1134278-a5bb-4104-8494-73481687bcb3",
                                "sense_id": "6fa7aaaa-02c9-3179-afda-db0db48953c1",
                                "text": "„Der Wenzel hat eine Strauken?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
