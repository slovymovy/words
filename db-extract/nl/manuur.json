                "senses": [
                    {
                        "sense_id": "2b25d924-eebe-3464-80eb-458b306642bc",
                        "entry_id": "2737d1c1-de80-3ce2-ae73-8cdbc69fd6c2",
                        "glosses": [
                            "hoeveelheid werk die één persoon in één uur kan verrichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b47b100-b818-4e07-b16c-2b8214385460",
                                "sense_id": "2b25d924-eebe-3464-80eb-458b306642bc",
                                "text": "Later werd het bittere ernst en moesten 35 agenten de zaak uitspitten. In de jaren na de moord werden 50.000 manuren geïnvesteerd in de zoektocht naar de moordenaar. Maar geen van de 375 mensen die verhoord werden, bleek de dader te zijn. Ook al bleken meerdere leiders op het kamp een verleden van seksuele delinquentie mee te slepen. De vele ‘ophelderingsbrieven’ deden meer kwaad dan goed."
                            },
                            {
                                "example_id": "f43c5296-2cda-485c-80a6-9a1c9c4d8443",
                                "sense_id": "2b25d924-eebe-3464-80eb-458b306642bc",
                                "text": "Almelo loopt met de strengere aanpak voorop, maar Gerritsen zou graag zien dat deze binnenkort in heel Twente wordt toegepast. \"Dan moet wel overal de bestuurlijke capaciteit beschikbaar zijn om dit te doen, want een pand sluiten kost veel manuren. Daarom kijken we met de gemeentes of we dit ook gezamenlijk kunnen aanpakken.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "932a5f6b-c24f-45f1-abd4-21b3da124144",
                        "source_entry_id": "2737d1c1-de80-3ce2-ae73-8cdbc69fd6c2",
                        "source_sense_id": "2b25d924-eebe-3464-80eb-458b306642bc",
                        "source_sense_description": "hoeveelheid werk die één persoon in één uur kan verrichten",
                        "target_lang_word": "man-hour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "man-hour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8906743a-214d-38a7-9d94-054bcb4f07f8",
                                        "entry_id": "c61b8328-20a2-39b9-bf6f-fdeec4c26ab4",
                                        "glosses": [
                                            "Synonym of person-hour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4808376f-c84a-43ad-880a-5432792b3f30",
                                                "sense_id": "8906743a-214d-38a7-9d94-054bcb4f07f8",
                                                "text": "Ten workers for two days—that's 160 man-hours."
                                            },
                                            {
                                                "example_id": "6b9d4347-d84f-4346-a6d4-84ffd0b204a0",
                                                "sense_id": "8906743a-214d-38a7-9d94-054bcb4f07f8",
                                                "text": "[...] every man has tools and amenities always within one minute's walk; thus non-productive man-hours are kept to a minimum."
                                            },
                                            {
                                                "example_id": "5b6453ff-680f-46db-9ee1-b43b252c556c",
                                                "sense_id": "8906743a-214d-38a7-9d94-054bcb4f07f8",
                                                "text": "Since 1950 our agricultural output per man-hour has actually doubled!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
