                "senses": [
                    {
                        "sense_id": "6e411902-13bf-3a3a-a167-1e9cf2025ba8",
                        "entry_id": "e36c71ce-fed1-3a61-8223-b7ec12800275",
                        "glosses": [
                            "allgemein: Bezeichnung für die Varietäten des Deutschen, die Arbeitsmigranten/(Gastarbeiter) bei ihrem oft unvollkommenen Versuch, Deutsch zu beherrschen, verwenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab70b402-f82c-4b15-b40d-2ec6daa40634",
                                "sense_id": "6e411902-13bf-3a3a-a167-1e9cf2025ba8",
                                "text": "Im Gastarbeiterdeutsch werden Flexionsformen oft vereinfacht oder ausgelassen."
                            },
                            {
                                "example_id": "1b409c34-0cf1-47cd-98b9-e335e7403f14",
                                "sense_id": "6e411902-13bf-3a3a-a167-1e9cf2025ba8",
                                "text": "„Sein Ergebnis läßt sich vor allem an Arbeitsmigranten beobachten, die früher euphemistisch »Gastarbeiter« genannt wurden (Gastarbeiterdeutsch).“"
                            },
                            {
                                "example_id": "24b005db-5e62-4e85-a86d-eb526fd6de94",
                                "sense_id": "6e411902-13bf-3a3a-a167-1e9cf2025ba8",
                                "text": "„Einige verbreitete Annahmen über charakteristische Merkmale des Gastarbeiterdeutsch hat Meisel (1977: 192 ff.) zusammengestellt.“"
                            },
                            {
                                "example_id": "d99aace4-1650-450b-90cc-bffb3223fac1",
                                "sense_id": "6e411902-13bf-3a3a-a167-1e9cf2025ba8",
                                "text": "„Dieses »Gastarbeiterdeutsch« reicht dazu aus, elementare Kommunikation zu ermöglichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
