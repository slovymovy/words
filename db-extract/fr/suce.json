                "senses": [
                    {
                        "sense_id": "49583fa5-fbc2-380b-8647-9e8260b5267e",
                        "entry_id": "8de905ca-374f-3abb-b0e8-b4ffbc541c5b",
                        "glosses": [
                            "Petit objet doté d’une pièce en caoutchouc et servant de succédané de biberon afin d’occuper un petit enfant."
                        ],
                        "tags": [
                            "Canada",
                            "Puériculture"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a401d346-f78f-4020-b6a8-c1a4f2745c94",
                        "source_entry_id": "8de905ca-374f-3abb-b0e8-b4ffbc541c5b",
                        "source_sense_id": "49583fa5-fbc2-380b-8647-9e8260b5267e",
                        "target_lang_word": "Nuckel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nuckel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f65056d-9077-33ad-b05c-dadd4a70a77a",
                                        "entry_id": "c1a2c2be-dce7-3ce6-85ae-9b6b90662dde",
                                        "glosses": [
                                            "Gegenstand aus teils Latex oder Silikon, teils Gummi oder Kunststoff, an dem Babys oder Kleinkinder saugen, um ihr Saugbedürfnis zu stillen (und sie damit zu beruhigen)"
                                        ],
                                        "tags": [
                                            "familiär",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca28d29b-76d4-406b-9645-963772c9e0b0",
                                                "sense_id": "5f65056d-9077-33ad-b05c-dadd4a70a77a",
                                                "text": "„Nach spätestens drei Monaten sollte der Nuckel durch einen Neuen ersetzt werden.“"
                                            },
                                            {
                                                "example_id": "83e2ede8-dfc5-4fea-8bcf-2fcf97b545c2",
                                                "sense_id": "5f65056d-9077-33ad-b05c-dadd4a70a77a",
                                                "text": "„Mein Bruder Tinko ist vierjährig und hat erst vor kurzem seinen Nuckel abgelegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "09286dcd-2dc7-3e4e-ad83-6873a49ad869",
                                        "entry_id": "c1a2c2be-dce7-3ce6-85ae-9b6b90662dde",
                                        "glosses": [
                                            "die mütterliche Brustwarze nachahmender Aufsatz aus Latex oder Silikon mit einem Loch, der auf eine Flaschenkopf gestülpt oder geschraubt wird, damit Säuglinge und Kleinkinder aus der Flasche ihr Trinken (vor allem Milch) saugen können"
                                        ],
                                        "tags": [
                                            "familiär",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e633978-fa8c-47e3-8428-d8d7683dc757",
                                                "sense_id": "09286dcd-2dc7-3e4e-ad83-6873a49ad869",
                                                "text": "„Laserstrahlen brennen die Löcher in Lagersteine von Uhren und in Nuckel von Babyflaschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "19cbd250-7b8f-30a5-957e-7d2572f80e61",
                                        "entry_id": "c1a2c2be-dce7-3ce6-85ae-9b6b90662dde",
                                        "glosses": [
                                            "Mann, der regelmäßig alkoholische Getränke in größeren Mengen zu sich nimmt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
