                "senses": [
                    {
                        "sense_id": "66e7cbe8-2600-3037-ac67-9b234ffd5a27",
                        "entry_id": "1f0ac45e-0fbe-33d7-a1a8-f179842865fc",
                        "glosses": [
                            "kobieta, która naciąga, wykorzystuje (zazwyczaj finansowo); wyzyskiwaczka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff81677-537e-4868-aa59-193bf137544e",
                                "sense_id": "66e7cbe8-2600-3037-ac67-9b234ffd5a27",
                                "text": "A co przyniesie przyszłość? Czego się spodziewać? Co mnie czeka za rogiem ulicy? Nigdy nie starałam się zgadywać przyszłości. Nigdy nie poszłam do wróżki. Uważałam je za naciągaczki"
                            },
                            {
                                "example_id": "494931de-c57e-48fe-8e28-6f6ba5e99edb",
                                "sense_id": "66e7cbe8-2600-3037-ac67-9b234ffd5a27",
                                "text": "Niektóre kobiety to naciągaczki. Pragną cię wyłącznie dla pieniędzy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15031568-dc9d-4e60-ae4b-5cd2cc61039b",
                        "source_entry_id": "1f0ac45e-0fbe-33d7-a1a8-f179842865fc",
                        "source_sense_id": "66e7cbe8-2600-3037-ac67-9b234ffd5a27",
                        "target_lang_word": "tapeuse",
                        "target_lang_code": "fr",
