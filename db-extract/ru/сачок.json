                                "target_senses": [
                                    {
                                        "sense_id": "2ffc1167-d196-3d95-aa9c-91d2de8d7651",
                                        "entry_id": "6073e7da-4f54-323f-aca4-aadf5e1650aa",
                                        "glosses": [
                                            "jemand, der nichts tut und dem Müßiggang frönt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9c79cd6-a412-4215-81f5-3075ff39d666",
                                                "sense_id": "2ffc1167-d196-3d95-aa9c-91d2de8d7651",
                                                "text": "Dein Untermieter scheint mir ein ausgemachter Tagedieb zu sein."
                                            },
                                            {
                                                "example_id": "ecf73e6a-fc13-4648-abae-eb15536f69a9",
                                                "sense_id": "2ffc1167-d196-3d95-aa9c-91d2de8d7651",
                                                "text": "„Jedenfalls, den rheinischen Schmitzen, Rademacher und Felten macht es nicht das geringste aus, sich mit den beiden flapsigen Tagedieben zu identifizieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
