                "translations": [
                    {
                        "translation_id": "7f01e7fe-b992-4d20-ab46-0ecb2fb4c66d",
                        "source_entry_id": "d584339f-3667-3c44-b1e2-59e991b0967d",
                        "source_sense_id": "69234709-7bbc-37c5-b085-2b95883145c2",
                        "source_sense_description": "wanneer het voor een zelfstandig naamwoord geplaatst wordt",
                        "target_lang_word": "attributiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attributiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ffee3aaa-da86-3cc9-82fc-0f698b4862c0",
                                        "entry_id": "837e3c3a-6c42-3fc8-9940-3d129e5b2498",
                                        "glosses": [
                                            "in der Form eines Attributs (verwendet); als Attribut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e61f38d7-836d-4e89-9a33-bd5b2a023bdf",
                                                "sense_id": "ffee3aaa-da86-3cc9-82fc-0f698b4862c0",
                                                "text": "Einige Adjektive können nur attributiv verwendet werden."
                                            },
                                            {
                                                "example_id": "85c278d4-fb6f-4c88-b2c6-0101c190ce93",
                                                "sense_id": "ffee3aaa-da86-3cc9-82fc-0f698b4862c0",
                                                "text": "Nur in attributiver Verwendung werden Adjektive nämlich flektiert, bekommen also Endungen, die Genus, Numerus und Kasus anzeigen."
                                            },
                                            {
                                                "example_id": "4b9c0ab7-1edc-4816-8a01-1a67141f265c",
                                                "sense_id": "ffee3aaa-da86-3cc9-82fc-0f698b4862c0",
                                                "text": "„Man kann die Adjektive prädikativ, adverbial und attributiv verwenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53e0f533-0b88-42de-9619-641cd65e29c6",
                        "source_entry_id": "d584339f-3667-3c44-b1e2-59e991b0967d",
                        "source_sense_id": "69234709-7bbc-37c5-b085-2b95883145c2",
                        "source_sense_description": "wanneer het voor een zelfstandig naamwoord geplaatst wordt",
                        "target_lang_word": "attributive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attributive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccd4f809-a8bb-37be-9c05-b408332e3764",
                                        "entry_id": "97f4bb31-f802-3004-9c4b-d9a1708589c3",
                                        "glosses": [
                                            "Modifying another word, typically a noun, while in the same phrase."
                                        ],
                                        "tags": [
                                            "of a word or phrase"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb934854-6475-450c-9cd9-d28489879a4a",
                                                "sense_id": "ccd4f809-a8bb-37be-9c05-b408332e3764",
                                                "text": "In \"this big house\", \"big\" is attributive, whereas in \"this house is big\", it is predicative."
                                            },
                                            {
                                                "example_id": "897f7ad2-8106-4e69-ae17-dc7b8b63cde8",
                                                "sense_id": "ccd4f809-a8bb-37be-9c05-b408332e3764",
                                                "text": "In \"this tiger is a man-eater,\" \"man\" is an attributive noun."
                                            },
                                            {
                                                "example_id": "9f43f4f3-3a69-45b6-928f-0d4bc28d2aaa",
                                                "sense_id": "ccd4f809-a8bb-37be-9c05-b408332e3764",
                                                "text": "Since both Attributes and Adjuncts recursively expand N-bar into N-bar, it seems clear that the two have essentially the same function, so that Attributes are simply pronominal Adjuncts (though we shall continue to follow tradition and refer to attributive premodifiers as Attributes rather than Adjuncts)."
                                            },
                                            {
                                                "example_id": "5bd77219-2b4d-4caa-8b99-d3012ac16367",
                                                "sense_id": "ccd4f809-a8bb-37be-9c05-b408332e3764",
                                                "text": "ATTRIBUTIVE NOUN. A noun that modifies another noun: steel in steel bridge; London in London house."
                                            },
                                            {
                                                "example_id": "47b92e53-4a5a-4092-ab8c-ec6474f60676",
                                                "sense_id": "ccd4f809-a8bb-37be-9c05-b408332e3764",
                                                "text": "Grammatically, three ways of using adjectives can be distinguished: the attributive use, the predicative use and the adverbial use. We will only deal with the attributive and the predicative use here. In the attributive use, the adjective, within an NP, is attached to the head noun, e.g. a dubious company, a red balloon, the stupid driver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed3284d8-8f93-3699-a47a-44e021ca936e",
                                        "entry_id": "97f4bb31-f802-3004-9c4b-d9a1708589c3",
                                        "glosses": [
                                            "Attributing; characterized by attributing; effecting attribution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a988c3b-c0c1-4d3f-9e82-913cd31fd10b",
                                                "sense_id": "ed3284d8-8f93-3699-a47a-44e021ca936e",
                                                "text": "To hate, &c.] Or thus, To be affected with hatred and horrour at. For abhor, though arranged in our dictionaries among verbs active, attributes an affection rather than an act of the mind. As the mind however is an active principle, all verbs attributive of what passes in the mind, even those we call neuter, attribute at the same time some mental act or operation. To grieve is reckoned a verb neuter; yet in grieving at some misfortune, the mind is not less active than it is in abhorring or loathing an object; which latter verbs are called verbs active."
                                            },
                                            {
                                                "example_id": "3a36a650-0c99-4546-b38e-67f61abfe010",
                                                "sense_id": "ed3284d8-8f93-3699-a47a-44e021ca936e",
                                                "text": "* 947 आल and आट put after वाक् Speech, with it form adjectives attributive of much bad or improper speaking; as वाचाल, or वाचाट Who utters much bad language.\n* 948 […] affixed to nouns, with them form adjectives attributive of detraction,[…]"
                                            },
                                            {
                                                "example_id": "f719525e-b0fc-4e3f-b1d7-ff148153fd19",
                                                "sense_id": "ed3284d8-8f93-3699-a47a-44e021ca936e",
                                                "text": "Notably, along with being attributive of color, some of those adjectives are used to characterize sound or intensity of sensation (e.g. pain may behele 'shrill' or tume 'dull'), cognitive abilities (such as hearing, vision and acumen),[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "attributive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f54a0d33-0eb2-3936-8dec-6a7aed72c341",
                                        "entry_id": "bd482943-4074-369f-b270-e5897dbaf414",
                                        "glosses": [
                                            "An attributive word or phrase (see above), contrasted with predicative or substantive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56a5ffba-bb89-4451-90fb-50cc095cdd5f",
                                                "sense_id": "f54a0d33-0eb2-3936-8dec-6a7aed72c341",
                                                "text": "In \"this big house,\" \"big\" is an attributive, while in \"this house is big,\" it is a predicative."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "418c436b-4037-4724-ac57-04dc1454cb4a",
                        "source_entry_id": "d584339f-3667-3c44-b1e2-59e991b0967d",
                        "source_sense_id": "69234709-7bbc-37c5-b085-2b95883145c2",
                        "source_sense_description": "wanneer het voor een zelfstandig naamwoord geplaatst wordt",
                        "target_lang_word": "épithète",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épithète",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c5b2f3b-6dbb-3979-b6e1-5d6e0360f430",
                                        "entry_id": "5fd56d50-c541-3053-9da1-f799851de7aa",
                                        "glosses": [
                                            "Fonction de l'adjectif (ou de la locution adjectivale) situé directement avant ou après le nom qu’elle qualifie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1323a9e-47eb-427c-b6bd-88a69314075b",
                                                "sense_id": "0c5b2f3b-6dbb-3979-b6e1-5d6e0360f430",
                                                "text": "La caractérisation au moyen de l'épithète n'est pas, comme celle de l'attribut, médiatisée par un verbe qui lui impose des limitations temporelles, aspectuelles ou modales. Elle s'opère à l'intérieur du groupe nominal, où l'apport d'information véhiculé par l'épithète contribue à la construction d'une expression descriptive"
                                            },
                                            {
                                                "example_id": "b608eddc-1b88-4744-b01b-f45841ddbf55",
                                                "sense_id": "0c5b2f3b-6dbb-3979-b6e1-5d6e0360f430",
                                                "text": "L’eau, par exemple, est indifférente à tel ou tel état : aussi, sans aucune sorte d’harmonie par elle-même, elle en acquiert au besoin par le concours des épithètes et des verbes : l’eau turbulente frémit, l’eau paisible coule."
                                            },
                                            {
                                                "example_id": "5a846aca-5091-4ef3-86e0-19c93a37c9b0",
                                                "sense_id": "0c5b2f3b-6dbb-3979-b6e1-5d6e0360f430",
                                                "text": "L’épithète morale et métaphysique a souvent sa magie que des milliers d’adjectifs chatoyants ne produiraient pas."
                                            },
                                            {
                                                "example_id": "cfeb2739-0c32-4781-93f9-cc4b31b9cd31",
                                                "sense_id": "0c5b2f3b-6dbb-3979-b6e1-5d6e0360f430",
                                                "text": "Au contraire des romanciers de son groupe, Flaubert n’a pas trop cherché l’épithète rare et n’a pas abusé des adjectifs."
                                            },
                                            {
                                                "example_id": "cb396e75-5172-4942-80a0-a35d8a5bed17",
                                                "sense_id": "0c5b2f3b-6dbb-3979-b6e1-5d6e0360f430",
                                                "text": "Elle honnit le carton-pâte et l’ornement en staff, l’orviétan des charlatans littéraires, le tarabiscotage des épithètes, qui sont trop souvent l’essentiel d’un livre consacré aux splendeurs factices d’un climat africain."
                                            },
                                            {
                                                "example_id": "804e573f-c014-4def-90ca-063933564568",
                                                "sense_id": "0c5b2f3b-6dbb-3979-b6e1-5d6e0360f430",
                                                "text": "Alors que j'aurais juré posséder un vocabulaire étendu, ce sont toujours les mêmes tristes épithètes qui jaillissent sous ma plume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9ae3f91-c838-3058-88b0-df8133943f83",
                                        "entry_id": "5fd56d50-c541-3053-9da1-f799851de7aa",
                                        "glosses": [
                                            "Qualification d’une personne en bien ou en mal."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28430e18-00ee-468f-bc31-afe0595bc792",
                                                "sense_id": "b9ae3f91-c838-3058-88b0-df8133943f83",
                                                "text": "Ce diable de marquis s’en est donné à cœur joie. Après le soufflet, sont venues les injures et une kyrielle d’épithètes, dont s… est la plus gracieuse."
                                            },
                                            {
                                                "example_id": "79350443-b0f7-40d9-9b36-ce774e884b68",
                                                "sense_id": "b9ae3f91-c838-3058-88b0-df8133943f83",
                                                "text": "J’offre cinq cents francs de récompense à celui qui trouvera une épithète injurieuse ou infamante qui n’ait été appliquée à M. Thiers dans le Cri du peuple ou dans la Franchise."
                                            },
                                            {
                                                "example_id": "a5daa829-a07a-455e-bb97-da0b03c9b7c9",
                                                "sense_id": "b9ae3f91-c838-3058-88b0-df8133943f83",
                                                "text": "Pour l’attaquer, tous les moyens avaient été bons, l’injure publique aussi bien que la calomnie hypocrite, et, pendant six mois, il avait eu le chagrin de se voir bafoué et insulté dans les mêmes journaux qui, quelques mois auparavant, ne citaient jamais son nom sans l’accompagner d’une épithète louangeuse."
                                            },
                                            {
                                                "example_id": "015e6886-0f5d-44f3-ac9a-bde8086f5a96",
                                                "sense_id": "b9ae3f91-c838-3058-88b0-df8133943f83",
                                                "text": "Il n’avait pas son pareil pour accoler une épithète vengeresse au nom d’un confrère déloyal."
                                            },
                                            {
                                                "example_id": "ff4eaaf8-faf0-4d59-8424-b1ac57d65e6d",
                                                "sense_id": "b9ae3f91-c838-3058-88b0-df8133943f83",
                                                "text": "Euphorique n'est pas précisément l’épithète que l'on peut impunément accoler aux personnages houellebecquiens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43f2baab-6361-3e9e-9827-a85c88975b75",
                                        "entry_id": "5fd56d50-c541-3053-9da1-f799851de7aa",
                                        "glosses": [
                                            "Épithète spécifique."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0ba39d3-20cc-453d-9834-3a227fb954c2",
                                                "sense_id": "43f2baab-6361-3e9e-9827-a85c88975b75",
                                                "text": "L’espèce la plus courante, Centaurium erythraea, doit son épithète, qui signifie « rouge » en grec, à ses fleurs d’un beau rose vif."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épithète",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aeca883d-368b-3fb8-aeb8-a69e9d26300e",
                                        "entry_id": "d62a083a-0b0d-39b8-aba4-e5404e0f8381",
                                        "glosses": [
