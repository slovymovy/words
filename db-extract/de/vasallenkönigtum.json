                "senses": [
                    {
                        "sense_id": "72239b0c-71fc-3bfc-aab8-67f7297b0f05",
                        "entry_id": "a4fbb347-886a-3484-a473-93d54181e85d",
                        "glosses": [
                            "von einem anderen Reich/Staat abhängiges, unsouveränes Königtum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75ccbdc7-e5c3-467e-90ff-7c03056fc6f9",
                                "sense_id": "72239b0c-71fc-3bfc-aab8-67f7297b0f05",
                                "text": "„An der Westküste Kleinasiens hatte sich zuvor ein Cluster hethitischer Vasallenkönigtümer befunden, von denen offenbar wieder einzelne Stadtherrschaften abhängig gewesen waren.“"
                            },
                            {
                                "example_id": "5053ad29-6c57-4fd5-9f69-0673fd83a632",
                                "sense_id": "72239b0c-71fc-3bfc-aab8-67f7297b0f05",
                                "text": "„Während etwa die in der Perserzeit prosperierenden phönizischen Küstenstädte, in denen ein Vasallenkönigtum etabliert ist, durch die Außenhandelsbeziehungen das Steueraufkommen leichter aufbringen können, führt die Abgabenlast in Palästina aufgrund der überwiegend subsistenzwirtschaftlichen Struktur zunehmend zur Überschuldung und infolgedessen zur Verarmung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
