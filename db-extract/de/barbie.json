                                        "glosses": [
                                            "A diminutive of the female given name Barbara."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Barbie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02118309-2513-3fb5-8267-55a6e5322694",
                                        "entry_id": "e81e5bdc-68de-37d6-a554-907dc3cd3ebf",
                                        "glosses": [
                                            "A tall, slender female fashion doll."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7629cc7-2a59-4a96-bb93-a1a5d431c815",
                                                "sense_id": "02118309-2513-3fb5-8267-55a6e5322694",
                                                "text": "They discourage their young children from engaging in rough-and-tumble play. One mother said, “I like Hai-Mei quiet. I like her playing Barbies, writing, and singing.”"
                                            },
                                            {
                                                "example_id": "1b2dc67c-58fe-4e5d-b35e-7d8a880453ee",
                                                "sense_id": "02118309-2513-3fb5-8267-55a6e5322694",
                                                "text": "Everything short of the toe-to-toe Truth and Love that comes from real confrontation of individual consciousness is just playing with Barbie dolls."
                                            },
                                            {
                                                "example_id": "10c6aff4-2d65-4338-a185-9caee82a7a0a",
                                                "sense_id": "02118309-2513-3fb5-8267-55a6e5322694",
                                                "text": "Sarah, who is ten, says she doesn’t play with Barbies anymore, although she takes a certain scientific interest[…]."
                                            },
                                            {
                                                "example_id": "bc965b5f-ad5e-4c25-8847-05367185da34",
                                                "sense_id": "02118309-2513-3fb5-8267-55a6e5322694",
                                                "text": "Many of my feminist friends hate Barbie because they feel that she sends a terrible message to girls […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83b62ba0-6d2e-3553-8297-235826ec7c43",
                                        "entry_id": "e81e5bdc-68de-37d6-a554-907dc3cd3ebf",
                                        "glosses": [
                                            "A beautiful but stupid or shallow young woman."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
