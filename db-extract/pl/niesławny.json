                "translations": [
                    {
                        "translation_id": "4a68c5e2-49bc-46f8-89a3-cb2237fa2418",
                        "source_entry_id": "0e995e2c-b8ef-3bbf-999a-2e78b076cb0b",
                        "source_sense_id": "59e718c0-5685-3423-b09d-e4a10f633136",
                        "target_lang_word": "infamous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infamous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf730dcd-cd60-3899-84fa-d8a317223ad6",
                                        "entry_id": "489fb079-e037-3ab9-9d27-6e5be2fbc35b",
                                        "glosses": [
                                            "Having a bad reputation; disreputable; notorious; unpleasant or evil; widely known, especially for something scornful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2b5edbd-0019-4fce-8ec7-ade587392f6e",
                                                "sense_id": "cf730dcd-cd60-3899-84fa-d8a317223ad6",
                                                "text": "He was an infamous traitor."
                                            },
                                            {
                                                "example_id": "de6e93d8-5806-489b-8438-c9e8a805496e",
                                                "sense_id": "cf730dcd-cd60-3899-84fa-d8a317223ad6",
                                                "text": "She is infamous for perjury."
                                            },
                                            {
                                                "example_id": "3d8b3f08-23e4-4d89-a8ea-534f3f5345d5",
                                                "sense_id": "cf730dcd-cd60-3899-84fa-d8a317223ad6",
                                                "text": "Soon we arrived at the Beijing Hotel—within shouting distance of the now infamous Tienanmen Square."
                                            },
                                            {
                                                "example_id": "da3a1c6a-e84a-47fc-873a-f4a01500a861",
                                                "sense_id": "cf730dcd-cd60-3899-84fa-d8a317223ad6",
                                                "text": "These infamous little green men appeared during the decisive seizures or buildings and facilities, only to disappear when associated militias and local troops arrived to consolidate the gains. In this way they provided a measure of deniability—however superficial or implausible—for Moscow.⁴⁰"
                                            },
                                            {
                                                "example_id": "72d3bb79-a713-4b86-b009-3a7054f5e80d",
                                                "sense_id": "cf730dcd-cd60-3899-84fa-d8a317223ad6",
                                                "text": "Despite the line proving to be a useful strategic route for men and supplies to the British naval fleets stationed at Scapa Flow in both world wars, the Duke's legacy looked to have passed into history when it was listed for closure in the infamous Beeching report."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a640466b-714e-38c8-b422-96d5a8c35475",
                                        "entry_id": "489fb079-e037-3ab9-9d27-6e5be2fbc35b",
                                        "glosses": [
                                            "Causing infamy; disgraceful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "857a40a3-567d-4c09-8a5f-b1b397fb83e8",
                                                "sense_id": "a640466b-714e-38c8-b422-96d5a8c35475",
                                                "text": "This infamous deed tarnishes all involved."
                                            },
                                            {
                                                "example_id": "3ea915f0-c9ab-445b-bdd2-eb7074512f9e",
                                                "sense_id": "a640466b-714e-38c8-b422-96d5a8c35475",
                                                "text": "Yes, Virginia, now Santa's doin' time\nIn a Federal prison for his infamous crime"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bef36cb5-b1dc-3e08-8d5d-054a1f33273c",
                                        "entry_id": "489fb079-e037-3ab9-9d27-6e5be2fbc35b",
                                        "glosses": [
                                            "Subject to a judicial punishment depriving (the person) of certain rights (e.g. the rights to hold public office, exercise the franchise, receive a public pension, serve on a jury, or give testimony in a court of law)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8c2c682-fc6b-363b-9595-8ad78fb4d318",
                                        "entry_id": "489fb079-e037-3ab9-9d27-6e5be2fbc35b",
                                        "glosses": [
                                            "Punishable by death or imprisonment."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5423b4b1-0088-4b7e-92a3-f039bf580043",
                                                "sense_id": "e8c2c682-fc6b-363b-9595-8ad78fb4d318",
                                                "text": "No person shall be held to answer for a capital, or otherwise infamous crime, unless on a presentment or indictment of a Grand Jury, except in cases arising in the land or naval forces, or in the Militia, when in actual service in time of war or public danger […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86ba6974-df8d-45ec-be0f-f1d70e997dbf",
                        "source_entry_id": "0e995e2c-b8ef-3bbf-999a-2e78b076cb0b",
                        "source_sense_id": "59e718c0-5685-3423-b09d-e4a10f633136",
                        "target_lang_word": "бесславный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бесславный",
