                                                "sense_id": "921bb5fc-722a-3a2f-9bea-a7394edbd008",
                                                "text": "I got a grant from the government to study archeology in Egypt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a46faa9b-43b8-3f52-bfee-8a94f8e8aaac",
                                        "entry_id": "2f356967-332c-3cc9-a3e4-000b26aafe90",
                                        "glosses": [
