                        "examples": [
                            {
                                "example_id": "b34f3712-6f1b-4d99-a0fd-eea8ad908a61",
                                "sense_id": "3c0cc653-6d43-34e7-8ae0-4fe596b10b67",
                                "text": "Bijna honderd zelfstandige woningen, een verzorgingscentrum en een recreatiecentrum vormen samen dit dorp."
                            },
                            {
                                "example_id": "a2bdb01d-865b-4524-902a-bc6f42438373",
                                "sense_id": "3c0cc653-6d43-34e7-8ae0-4fe596b10b67",
                                "text": "Binnen werd op een groot voetbalscherm de finale van de Champions League getoond. Real Madrid tegen Atlético Madrid had meer dan duizend jongeren naar het recreatiecentrum getrokken, moslims en christenen."
                            },
                            {
                                "example_id": "4ae85f83-a39b-41ca-af97-b691ff62a29c",
                                "sense_id": "3c0cc653-6d43-34e7-8ae0-4fe596b10b67",
                                "text": "Als kind werd ik in het recreatiecentrum gevormd door kunst-, dans- en muzieklessen."
                            }
                        ]
