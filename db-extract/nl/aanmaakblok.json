                    {
                        "sense_id": "2d00df4d-b063-3f75-ae39-43ede735a33d",
                        "entry_id": "1dbcf92e-d5b3-31f8-91a6-7d58863c9141",
                        "glosses": [
                            "gemakkelijk brandbaar materiaal dat men gebruikt om een vuur te beginnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92a96c9c-e703-46df-9b59-0cadf989ce8b",
                                "sense_id": "2d00df4d-b063-3f75-ae39-43ede735a33d",
                                "text": "Ze draaide de kachel in de keuken hoog en wierp een aanmaakblok in de open haard in de woonkamer."
                            },
                            {
                                "example_id": "d59c643e-3cb9-41ff-ae01-78fbe0dc2fb4",
                                "sense_id": "2d00df4d-b063-3f75-ae39-43ede735a33d",
                                "text": "De stichting raadt het gebruik van brandbare vloeistoffen af bij het aansteken van bijvoorbeeld een BBQ. Dat moet altijd met aanmaakblokjes. In geen geval mogen brandbare vloeistoffen op een open vuurbron worden gespoten, aldus de stichting."
                            },
                            {
                                "example_id": "a8915b69-bd57-4410-a9ad-7e7c093c2819",
                                "sense_id": "2d00df4d-b063-3f75-ae39-43ede735a33d",
                                "text": "De man werd vorig jaar juli aangehouden na de vondst van zes tassen met drugs in de kantine. Hij beweerde toen dat er aanmaakblokjes voor de barbecue in de tassen zaten, maar het bleek te gaan om 100 kilo MDMA, de werkzame stof in xtc."
                            }
                        ]
                    }
