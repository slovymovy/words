                "senses": [
                    {
                        "sense_id": "fc001ee5-8f4c-34a9-b320-3453a2443b7b",
                        "entry_id": "c09399c2-cfd9-317b-ac8f-e6f44f61b686",
                        "glosses": [
                            "Verringerung oder Befreiung von auftreffendem Regenwasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28bb8f36-12e0-4936-9994-4c398ff49130",
                                "sense_id": "fc001ee5-8f4c-34a9-b320-3453a2443b7b",
                                "text": "„Es gibt zwei Arten der Dachentwässerung, die beide nach dem Prinzip der Schwerkraftentwässerung funktionieren: die Freispiegelentwässerung (auch Freigefälleentwässerung genannt), bei der das Rohrleitungssystem im Gefälle verlegt wird und die Unterdruckentwässerung.“"
                            },
                            {
                                "example_id": "821cebe9-8fde-4664-9942-41aad0d13a04",
                                "sense_id": "fc001ee5-8f4c-34a9-b320-3453a2443b7b",
                                "text": "„Bei vielen Flachdachkonstruktionen ist heute die sichere Dachentwässerung mit Druckströmung möglich.“"
                            },
                            {
                                "example_id": "ce8ba4f7-1a9a-483d-9e5a-3f73e6243b93",
                                "sense_id": "fc001ee5-8f4c-34a9-b320-3453a2443b7b",
                                "text": "„Freispiegelentwässerungen und Dachentwässerungen mit Druckströmung funktionieren nach dem Schwerkraftprinzip, das heißt, sie benötigen keine Fremdenergie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
