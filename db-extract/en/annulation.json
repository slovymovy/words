                                        "sense_id": "b981a7ff-5f66-3730-885b-91f8d394622b",
                                        "entry_id": "a4a9c37d-3441-30a4-a3b6-2a6c7a6aa0d2",
                                        "glosses": [
                                            "Mitteilung, dass etwas Geplantes nicht zustande kommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d18422f-e2ff-4704-9e7d-7673d5d3ab65",
                                                "sense_id": "b981a7ff-5f66-3730-885b-91f8d394622b",
                                                "text": "Zu unserer geplanten Reise muss ich dir leider eine Absage erteilen."
                                            },
                                            {
                                                "example_id": "a6ebcbe6-0baa-4542-8d73-308b425229f9",
                                                "sense_id": "b981a7ff-5f66-3730-885b-91f8d394622b",
                                                "text": "„Für die Organisatoren, die Vortragenden aber auch für die Besucher dürfte die Absage der Chemnitzer Linux-Tage schmerzlich sein.“"
                                            },
                                            {
                                                "example_id": "e4ab3585-a217-4e25-ad0e-55510b4a09f6",
                                                "sense_id": "b981a7ff-5f66-3730-885b-91f8d394622b",
                                                "text": "„Für Fenerbahce wäre João Pedro der fünfte Neuzugang in der Offensive und für Galatasaray die vierte Absage in wenigen Wochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a9ef81d-5aaf-3a66-ae2a-d2f55b88bd79",
                                        "entry_id": "a4a9c37d-3441-30a4-a3b6-2a6c7a6aa0d2",
                                        "glosses": [
                                            "Schlusswort bei einer Veranstaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dae27781-2374-4d02-86cc-9a6722068446",
                                                "sense_id": "7a9ef81d-5aaf-3a66-ae2a-d2f55b88bd79",
                                                "text": "Der Sprecher gab sich mit der Absage keine besondere Mühe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96140ec9-fb90-3417-a65b-40bbdb6bca5c",
                                        "entry_id": "a4a9c37d-3441-30a4-a3b6-2a6c7a6aa0d2",
                                        "glosses": [
                                            "Weigerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "833f6ea2-4d48-4111-9612-783a5205c87b",
                                                "sense_id": "96140ec9-fb90-3417-a65b-40bbdb6bca5c",
                                                "text": "„Seine Absage schien von Wehmut überlagert; er wirkte erschrocken über die Entschiedenheit, mit der er den Riegel vor meine Idee geschoben hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
