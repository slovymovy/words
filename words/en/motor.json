    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aba47057-364c-3c8f-a8a7-36ced113aea8",
                    "sense_definition": "A machine or device that converts other energy forms into mechanical energy, or imparts motion.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mechanical_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The electric <w>motor</w> powers the fan quietly.",
                            "target_lang_translations": {
                                "ru": "Электрический <w>мотор</w> тихо вращает вентилятор.",
                                "zh": "电<w>动机</w>安静地驱动着风扇。"
                            }
                        },
                        {
                            "text": "He repaired the small <w>motor</w> inside the toy car.",
                            "target_lang_translations": {
                                "ru": "Он починил маленький <w>моторчик</w> внутри игрушечной машинки.",
                                "zh": "他修好了玩具车里的小<w>马达</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "engine"
                    ],
                    "common_phrases": [
                        "electric motor",
                        "outboard motor",
                        "starter motor",
                        "motor vehicle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Машина или устройство, которое преобразует другие формы энергии в механическую энергию или создает движение.",
                        "zh": "将其他形式的能量转换为机械能，或使物体运动的机器或装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двигатель",
                                "target_lang_sense_clarification": "техническое устройство"
                            },
                            {
                                "target_lang_word": "мотор",
                                "target_lang_sense_clarification": "разговорное или для небольших устройств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发动机",
                                "target_lang_sense_clarification": "一般技术用语，指把其他形式的能量转化为机械能的装置"
                            },
                            {
                                "target_lang_word": "马达",
                                "target_lang_sense_clarification": "常用于较小装置或口语，如电器、玩具等"
                            },
                            {
                                "target_lang_word": "电动机",
                                "target_lang_sense_clarification": "特指以电力驱动的电机"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28b29c29-9667-3326-8e4c-a004c60aa8cd",
                    "sense_definition": "A motor car or automobile.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a used <w>motor</w> for a very low price.",
                            "target_lang_translations": {
                                "ru": "Он купил подержанную <w>тачку</w> по очень низкой цене.",
                                "zh": "他以很低的价格买了一辆二手<w>汽车</w>。"
                            }
                        },
                        {
                            "text": "That is a very nice <w>motor</w> you are driving.",
                            "target_lang_translations": {
                                "ru": "Ты водишь очень классную <w>тачку</w>.",
                                "zh": "你开的那辆<w>车</w>真不错。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nice motor"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легковой автомобиль или машина (часто в разговорном контексте).",
                        "zh": "汽车，机动车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тачка",
                                "target_lang_sense_clarification": "разговорное, сленг"
                            },
                            {
                                "target_lang_word": "автомобиль",
                                "target_lang_sense_clarification": "нейтральное"
                            },
                            {
                                "target_lang_word": "мотор",
                                "target_lang_sense_clarification": "устаревшее или сленг (такси)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "汽车",
                                "target_lang_sense_clarification": "正式、通用说法"
                            },
                            {
                                "target_lang_word": "车",
                                "target_lang_sense_clarification": "口语中常说"
                            },
                            {
                                "target_lang_word": "车子",
                                "target_lang_sense_clarification": "英式口语里带随意语气"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61bfd684-e272-3d74-91a9-f1a8a225da3e",
                    "sense_definition": "A source of power for something; an inspiration or driving force.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Curiosity is the <w>motor</w> of scientific discovery.",
                            "target_lang_translations": {
                                "ru": "Любопытство — это <w>двигатель</w> научных открытий.",
                                "zh": "好奇心是科学发现的<w>动力</w>。"
                            }
                        },
                        {
                            "text": "Economic growth serves as the <w>motor</w> for social improvement.",
                            "target_lang_translations": {
                                "ru": "Экономический рост служит <w>движущей силой</w> социальных улучшений.",
                                "zh": "经济增长是社会进步的<w>推动力</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Источник силы для чего-либо; вдохновение или движущая сила.",
                        "zh": "某事物的力量来源；激励因素或推动力量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двигатель",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "движущая сила",
                                "target_lang_sense_clarification": "фактор развития"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动力",
                                "target_lang_sense_clarification": "比喻事物发展的主要力量"
                            },
                            {
                                "target_lang_word": "推动力",
                                "target_lang_sense_clarification": "强调促使进展或变化的力量"
                            },
                            {
                                "target_lang_word": "驱动力",
                                "target_lang_sense_clarification": "较书面，指促成发展的核心因素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b0d6b0a-b9ad-3646-82dd-c5d237ee2263",
                    "sense_definition": "Any protein capable of converting chemical energy into mechanical work.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Myosin is a molecular <w>motor</w> found in muscle cells.",
                            "target_lang_translations": {
                                "ru": "Миозин — это молекулярный <w>мотор</w>, находящийся в мышечных клетках.",
                                "zh": "肌球蛋白是存在于肌肉细胞中的分子<w>马达</w>。"
                            }
                        },
                        {
                            "text": "Scientists study how the protein <w>motor</w> moves along filaments.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают, как белковый <w>мотор</w> движется вдоль нитей.",
                                "zh": "科学家研究这种蛋白质<w>马达</w>如何沿着细丝移动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "molecular motor"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context (biology)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой белок, способный преобразовывать химическую энергию в механическую работу.",
                        "zh": "任何能够把化学能转化为机械功的蛋白质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мотор",
                                "target_lang_sense_clarification": "биологический термин (молекулярный мотор)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马达",
                                "target_lang_sense_clarification": "生物学术语，如“分子马达”"
                            },
                            {
                                "target_lang_word": "发动机",
                                "target_lang_sense_clarification": "用于术语“分子发动机”等较书面表达"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7f14ba45-e54f-3c3f-9e02-a335fba7950d",
                    "sense_definition": "Relating to the ability to move or control muscle movement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "movement_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child is developing fine <w>motor</w> skills.",
                            "target_lang_translations": {
                                "ru": "У ребенка развивается мелкая <w>моторика</w>.",
                                "zh": "这个孩子正在发展精细<w>动作</w>技能。"
                            }
                        },
                        {
                            "text": "Damage to the brain can affect <w>motor</w> functions.",
                            "target_lang_translations": {
                                "ru": "Повреждение мозга может повлиять на <w>двигательные</w> функции.",
                                "zh": "脑损伤会影响<w>运动</w>功能。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "motor skills",
                        "fine motor skills",
                        "motor neuron",
                        "motor function"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к способности двигаться или управлять мышечными движениями.",
                        "zh": "与移动能力或对肌肉运动的控制有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моторный",
                                "target_lang_sense_clarification": "связанный с моторикой"
                            },
                            {
                                "target_lang_word": "двигательный",
                                "target_lang_sense_clarification": "связанный с движением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运动",
                                "target_lang_sense_clarification": "用于“运动功能、运动神经”等医学或生理学语境"
                            },
                            {
                                "target_lang_word": "动作",
                                "target_lang_sense_clarification": "用于“动作技能、精细动作”等发育和康复语境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ebaf7ee-83d0-3acd-a8af-bc2c2a568cee",
                    "sense_definition": "Propelled by an internal combustion engine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "powered_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We rented a small <w>motor</w> boat for the afternoon.",
                            "target_lang_translations": {
                                "ru": "Мы арендовали небольшую <w>моторную</w> лодку на вторую половину дня.",
                                "zh": "我们租了一条小<w>机动</w>船过一下午。"
                            }
                        },
                        {
                            "text": "There is a lot of <w>motor</w> traffic on the highway today.",
                            "target_lang_translations": {
                                "ru": "Сегодня на шоссе очень плотное <w>автомобильное</w> движение.",
                                "zh": "今天高速公路上的<w>机动车</w>交通很多。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "motor vehicle",
                        "motor boat",
                        "motor racing",
                        "motor oil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводимый в движение двигателем внутреннего сгорания.",
                        "zh": "由内燃机驱动的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моторный",
                                "target_lang_sense_clarification": "о лодках, масле, видах спорта"
                            },
                            {
                                "target_lang_word": "автомобильный",
                                "target_lang_sense_clarification": "о транспорте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机动",
                                "target_lang_sense_clarification": "指由发动机驱动，如机动船"
                            },
                            {
                                "target_lang_word": "机动车",
                                "target_lang_sense_clarification": "用于交通、车辆类别等语境"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f327b9cb-b586-3f1f-9ddd-8de399dafc0f",
                    "sense_definition": "To make a journey by motor vehicle; to drive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "travel_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>motored</w> through the countryside on Sunday.",
                            "target_lang_translations": {
                                "ru": "В воскресенье они <w>прокатились</w> на машине по сельской местности.",
                                "zh": "星期天他们<w>开车</w>穿过了乡间。"
                            }
                        },
                        {
                            "text": "We decided to <w>motor</w> down to the coast for the weekend.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>съездить</w> на машине на побережье на выходные.",
                                "zh": "我们决定周末<w>开车</w>去海边。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать поездку на автомобиле; ехать за рулем.",
                        "zh": "乘坐机动车出行；开车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ехать на автомобиле",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "катить",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开车",
                                "target_lang_sense_clarification": "一般说法，指乘汽车出行"
                            },
                            {
                                "target_lang_word": "驾车",
                                "target_lang_sense_clarification": "较书面，强调驾车前往某处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6774f3d-945c-379d-b84f-0f2efb75d82f",
                    "sense_definition": "To progress at a brisk pace.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "progress_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new project is really <w>motoring</w> along now.",
                            "target_lang_translations": {
                                "ru": "Новый проект сейчас действительно <w>набирает обороты</w>.",
                                "zh": "这个新项目现在确实在<w>快速推进</w>。"
                            }
                        },
                        {
                            "text": "Sales were slow at first, but now the business is <w>motoring</w>.",
                            "target_lang_translations": {
                                "ru": "Сначала продажи шли медленно, но теперь бизнес <w>пошел в гору</w>.",
                                "zh": "起初销量很慢，但现在生意正<w>迅速发展</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продвигаться в быстром темпе.",
                        "zh": "迅速进展。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набирать обороты",
                                "target_lang_sense_clarification": "идиома"
                            },
                            {
                                "target_lang_word": "нестись",
                                "target_lang_sense_clarification": "быстро двигаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "快速推进",
                                "target_lang_sense_clarification": "指事情进展速度快"
                            },
                            {
                                "target_lang_word": "迅速发展",
                                "target_lang_sense_clarification": "指事业、项目等发展势头强"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ac9241e1-e4c3-305c-8c7e-d049719b231e",
                    "sense_definition": "Alternative form of <w>Mator</w> (a Samoyedic language).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "language_name",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "The <w>Motor</w> language is now extinct.",
                            "target_lang_translations": {
                                "ru": "<w>Маторский</w> язык сейчас считается вымершим.",
                                "zh": "<w>马托尔语</w>现已灭绝。"
                            }
                        },
                        {
                            "text": "Linguists study <w>Motor</w> to understand the history of the region.",
                            "target_lang_translations": {
