                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a74e583-e790-4d67-9514-9e2de2a7171b",
                                "sense_id": "6f3118a8-ebeb-3053-9163-ffff429b341a",
                                "text": "As we stepped out into the awesome half-daylight of this monstrous cylinder-bottom—fifty million years old, and without doubt the most primally ancient structure ever to meet our eyes—we saw that the ramp-traversed sides stretched dizzily up to a height of fully sixty feet."
                            },
                            {
                                "example_id": "bcd32aff-8e97-41f2-be1f-5fbf9f3ebc91",
                                "sense_id": "6f3118a8-ebeb-3053-9163-ffff429b341a",
                                "text": "The discrepancy is striking and cannot be explained by size, as the smallest are the most massive, and if all were primally of like constitution, should be the least compressed."
                            }
                        ]
                    }
