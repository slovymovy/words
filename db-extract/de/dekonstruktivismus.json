                "senses": [
                    {
                        "sense_id": "739ab4d2-e094-3d6b-9f67-332450ff23e3",
                        "entry_id": "b27ccc14-e33c-3bde-b657-1d86ae8c9f63",
                        "glosses": [
                            "kritisches Hinterfragen und Auflösen eines Textes im weiteren Sinn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e50860fd-ac93-4eea-a8f4-84624c487e11",
                                "sense_id": "739ab4d2-e094-3d6b-9f67-332450ff23e3",
                                "text": "„Neben Formalismus und Ideologiekritik betont auch der Dekonstruktivismus, dass Texte generell keinen Erkenntnisanspruch erheben können, weil sich Sprache als ein in sich geschlossenes System nicht auf die Welt beziehen könne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5f77c010-2f92-3272-b809-6aa54679d088",
                        "entry_id": "b27ccc14-e33c-3bde-b657-1d86ae8c9f63",
                        "glosses": [
                            "eine architektonische Stilrichtung, die den Anspruch einer Ablösung der Postmoderne erhebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00035168-6d09-4ec7-9a7d-845b16631dd4",
                                "sense_id": "5f77c010-2f92-3272-b809-6aa54679d088",
                                "text": "„Der Dekonstruktivismus ist in seinen Intentionen und Wirkungen auf die Betrachter und Benutzer entsprechender Gebäude schwer einzuordnen; eindeutige zeittypische, gesellschaftskritische und sozialphilosophische Verortungen sind daher kaum möglich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
