                "senses": [
                    {
                        "sense_id": "4e59c943-30c0-31a4-a501-385495a82b75",
                        "entry_id": "f864bd72-fc56-3f64-82c3-1ab4480d622c",
                        "glosses": [
                            "Markenname der Firma Kettler für Tretautos mit Kettenantrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c2eb016-0d70-4378-9c11-bffbccd85b4d",
                                "sense_id": "4e59c943-30c0-31a4-a501-385495a82b75",
                                "text": "Die ersten Kettcars wurden durch Kettler im Jahre 1962 verkauft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aca60131-d1bb-350f-98b5-7a89e7435aba",
                        "entry_id": "f864bd72-fc56-3f64-82c3-1ab4480d622c",
                        "glosses": [
                            "Spielgerät mit vier Rädern, das per Pedale und Muskelkraft angetrieben wird"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "3a05fa8b-c964-4687-9443-f8c5293e95ca",
                                "sense_id": "aca60131-d1bb-350f-98b5-7a89e7435aba",
                                "text": "Durch den Kettenantrieb ist ein Kettcar deutlich bequemer zu fahren, als ein Tretauto mit Pedalstange und Frontantrieb."
                            },
                            {
                                "example_id": "3fc37417-ca52-4d79-a0d6-5b72b62855ab",
                                "sense_id": "aca60131-d1bb-350f-98b5-7a89e7435aba",
                                "text": "„Der Name \"Kettcar\" wurde sogar zum Synonym für alle Kindertretautos. \"Das ist das Beste, was einer Firma passieren kann\", sagt Kröger. “"
                            },
                            {
                                "example_id": "60fe7a86-33ab-432c-bda6-6293e0cc2828",
                                "sense_id": "aca60131-d1bb-350f-98b5-7a89e7435aba",
                                "text": "„Als ich mein Kettcar wiederhatte, tauschte ich das bei Wilfried und Günter Potthoff gegen deren Fahrrad ein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
