                "senses": [
                    {
                        "sense_id": "238e0e2e-87c9-3009-ac73-d4a9a7c348c8",
                        "entry_id": "d842e29c-561d-3035-87e2-93e557bb0bf2",
                        "glosses": [
                            "großer Behälter zur Aufbewahrung von Kartoffeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b06bda6-d3f1-4b75-962a-6bd81cd86009",
                                "sense_id": "238e0e2e-87c9-3009-ac73-d4a9a7c348c8",
                                "text": "„All dies habe ich gesehen, und die alte Frau in der Kartoffelkiste hatte mir ebenfalls erzählt, der General sei kurz vor unserer Landung im Haus gewesen.“"
                            },
                            {
                                "example_id": "2cde7dc1-ae2c-4ba3-9cdc-d99d961166b3",
                                "sense_id": "238e0e2e-87c9-3009-ac73-d4a9a7c348c8",
                                "text": "„Während er die Säcke zur Kartoffelkiste in den Keller schafft, bringt sie Eimer und Spatengabel in den Schuppen, hängt die Strickjacke und den Gartenkittel an den Haken und tauscht die Gummistiefel gegen die Pantoffeln ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
