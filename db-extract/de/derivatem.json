                "senses": [
                    {
                        "sense_id": "ae7ec3b3-2252-31e0-aae5-c8914489f70c",
                        "entry_id": "39cd6f24-4d8c-3bf7-b64e-1c1716133592",
                        "glosses": [
                            "grammatisches Morphem, das der Derivation (Ableitung) von Wörtern dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ef0fd0f-5a02-4146-9120-d52a4355fb4c",
                                "sense_id": "ae7ec3b3-2252-31e0-aae5-c8914489f70c",
                                "text": "„-lich“ ist ein häufig verwendetes Derivatem bei Adjektiven: z. B. „fröhlich“, „sommerlich“."
                            },
                            {
                                "example_id": "9c0d8272-0496-43d5-a4fc-6c4af846ccd9",
                                "sense_id": "ae7ec3b3-2252-31e0-aae5-c8914489f70c",
                                "text": "Gross unterscheidet die gebundenen Morpheme in Flexeme und Derivateme."
                            },
                            {
                                "example_id": "abf7d6cc-9890-42aa-95e2-b4ed8e411c87",
                                "sense_id": "ae7ec3b3-2252-31e0-aae5-c8914489f70c",
                                "text": "„Die beiden UK (unmittelbare Konstituenten) werden unterschieden als Derivationsbasis und Derivationsaffix (oder Derivatem).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
