                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c862bfc6-9e29-41ed-ba3b-67848336b848",
                                "sense_id": "8f430f7b-8e4a-3970-bda6-ec680dc57fd1",
                                "text": "Эта фотография татуированной женщины ― скажут, это эскимоска или чукчанка, они ведь в жилищах ходят также раздетыми и татуируются, а тип у них такой же."
                            },
                            {
                                "example_id": "32e5f640-fac0-404d-9ce9-bd037c9d5ca9",
                                "sense_id": "8f430f7b-8e4a-3970-bda6-ec680dc57fd1",
                                "text": "― Да, ― сказал я, ― женятся на русских, чукчанках, украинках, эстонках, казашках ― на тех, кого любят."
                            }
                        ]
                    }
