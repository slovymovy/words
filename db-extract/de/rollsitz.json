                "senses": [
                    {
                        "sense_id": "ba3a62bc-e012-321c-a24b-bfe812a6f410",
                        "entry_id": "784f7e46-fdb8-33fe-9394-a18f9b64f5aa",
                        "glosses": [
                            "auf Schienen und Rollen gelagerter Teil eines Ruderbootes/Ruderergometers, auf dem der Ruderer sitzend bei jedem Zug hin- und hergleitet"
                        ],
                        "tags": [
                            "Rudern"
                        ],
                        "examples": [
                            {
                                "example_id": "792ddd2a-542e-48e6-b0ac-0d39a4033926",
                                "sense_id": "ba3a62bc-e012-321c-a24b-bfe812a6f410",
                                "text": "Schon legt der 17-Jährige Athlet los: Hannes Stolze zieht am Griff des Ruderergometers, presst die Füße gegen das Stemmbrett und gleitet mit dem Rollsitz nach hinten."
                            },
                            {
                                "example_id": "e7642a16-abd5-4f9a-95f7-fc4fad42d64f",
                                "sense_id": "ba3a62bc-e012-321c-a24b-bfe812a6f410",
                                "text": "Vom Steg sicher auf den Rollsitz eines der schmalen Einsitzerboote zu gelangen, sieht für Ungeübte zunächst nach einer ziemlich wackligen Angelegenheit aus."
                            },
                            {
                                "example_id": "da598edd-6231-4d45-8ff2-b9045b059245",
                                "sense_id": "ba3a62bc-e012-321c-a24b-bfe812a6f410",
                                "text": "[…] der Berliner Wäscherei- und Färbereiunternehmer Karl Spindler [brachte] im Frühjahr 1878 von einer Geschäftstour zwei Ruder-Rennboote [aus England] mit. Es handelte sich um den letzten sportlichen Schrei: Boote mit Rollsitz und Ruder-Ausleger!"
                            },
                            {
                                "example_id": "230c0357-8c5c-4499-bd63-e0a799e24a47",
                                "sense_id": "ba3a62bc-e012-321c-a24b-bfe812a6f410",
                                "text": "Nach der Zieldurchfahrt lagen sich die vier deutschen Modellathleten überglücklich in den Armen, während die geschlagene Konkurrenz vollkommen fertig auf ihren Rollsitzen hockte."
                            },
                            {
                                "example_id": "3d9f635f-eb5d-4d88-b332-f5f5df42428e",
                                "sense_id": "ba3a62bc-e012-321c-a24b-bfe812a6f410",
                                "text": "Der Gleichklang der Körper, die auf ihren Rollsitzen vor- und zurückgleiten, die Perfektion beim zeitgleichen Eintauchen der Blätter, das alles täuscht eine Harmonie [unter den acht Sportlern] vor, die es nicht gibt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
