                                                "example_id": "f99da15d-2678-4666-aa61-34d6b224fbff",
                                                "sense_id": "e1cbc30d-4839-398a-8f0f-285bdd4caa6a",
                                                "text": "I have placed my program under copyleft."
                                            },
                                            {
                                                "example_id": "053eaf6b-138b-47ec-905e-e03d6d15745c",
                                                "sense_id": "e1cbc30d-4839-398a-8f0f-285bdd4caa6a",
                                                "text": "The GNU General Public License is a copyleft licence."
                                            }
                                        ]
                                    }
                                ]
                            },
