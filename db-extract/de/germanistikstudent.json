                "senses": [
                    {
                        "sense_id": "2dacaa43-3cf0-3f7e-b26b-ab0523099e4e",
                        "entry_id": "713b9f5f-ba39-3d44-8b4d-a0e7705ae7b9",
                        "glosses": [
                            "Person, die das Fach Germanistik studiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6befd9f3-08f3-43f4-8224-d67027e871a0",
                                "sense_id": "2dacaa43-3cf0-3f7e-b26b-ab0523099e4e",
                                "text": "„Auf eines muss sich ein angehender Germanistikstudent aber gefasst machen: jede Menge Bücher.“"
                            },
                            {
                                "example_id": "be0d5fd0-5233-4228-aee2-791986a7a6f9",
                                "sense_id": "2dacaa43-3cf0-3f7e-b26b-ab0523099e4e",
                                "text": "„Der Medizinstudent wird Arzt, der Justudent Rechtsanwalt und der Philosophie- oder Germanistikstudent? Lektor oder Taxifahrer.“"
                            },
                            {
                                "example_id": "a69a55ad-6d67-43ff-b2ef-f42c02550fe2",
                                "sense_id": "2dacaa43-3cf0-3f7e-b26b-ab0523099e4e",
                                "text": "„Auf dem Programm standen die Besichtigung der neuen Mosaikfenster im Dom, ein historischer Stadtspaziergang, Gespräche mit Germanistikstudenten, auch ein Abstecher zu den Ostseebädern und zu Manns Sommerhaus in Nidden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
