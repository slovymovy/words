                "senses": [
                    {
                        "sense_id": "5a7cbc38-4aa7-308c-ba54-148acd966ae5",
                        "entry_id": "b8f98664-5c64-36aa-b709-5ec162248ffa",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a5448a3-f1c9-4126-ba68-28bea61f9daf",
                                "sense_id": "5a7cbc38-4aa7-308c-ba54-148acd966ae5",
                                "text": "Frau Rapolder ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2cd5241a-674c-428c-b9ee-613b59e87ed3",
                                "sense_id": "5a7cbc38-4aa7-308c-ba54-148acd966ae5",
                                "text": "Herr Rapolder wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "95b535a9-71e0-4248-bf21-ff49160ad6f0",
                                "sense_id": "5a7cbc38-4aa7-308c-ba54-148acd966ae5",
                                "text": "Die Rapolders fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3c3d8f1d-d907-4e57-9bec-a35fa840fe53",
                                "sense_id": "5a7cbc38-4aa7-308c-ba54-148acd966ae5",
                                "text": "Der Rapolder trägt nie die Schals, die die Rapolder ihm strickt."
                            },
                            {
                                "example_id": "70e4e621-cfe2-4f68-b49b-0f45c8db20ab",
                                "sense_id": "5a7cbc38-4aa7-308c-ba54-148acd966ae5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rapolder kommt, geht der Herr Rapolder.“"
                            },
                            {
                                "example_id": "611dd2db-c3fd-4789-8a25-243ca288df37",
                                "sense_id": "5a7cbc38-4aa7-308c-ba54-148acd966ae5",
                                "text": "Rapolder kommt und geht."
                            },
                            {
                                "example_id": "f3f43af4-7d8b-425c-bc29-1b95e8c11006",
                                "sense_id": "5a7cbc38-4aa7-308c-ba54-148acd966ae5",
                                "text": "Rapolders kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
