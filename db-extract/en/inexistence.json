    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b624a1cd-7fee-3dbe-a560-468c9b8cca54",
                "word": "inexistence",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "aebc0ffa-271c-4348-bae4-97dfbb46612b",
                        "entry_id": "b624a1cd-7fee-3dbe-a560-468c9b8cca54",
                        "tags": [
                            "plural"
                        ],
                        "form": "inexistences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8bb26289-0489-3760-8ab1-ba9e053f8cf6",
                        "entry_id": "b624a1cd-7fee-3dbe-a560-468c9b8cca54",
                        "glosses": [
                            "The state of not being, not existing, or not being perceptible."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "2b28c864-77fc-4cef-a300-4dbe7ecfd501",
                                "sense_id": "8bb26289-0489-3760-8ab1-ba9e053f8cf6",
                                "text": "Our inexistence indeed was a condition, wherein nothing in us was capable of being a motive of God's love; but our enmity proceeded further, and made us worthy of his detestation; […]"
                            },
                            {
                                "example_id": "393be8c0-4e50-4c56-ab5d-382cdfe9f8ee",
                                "sense_id": "8bb26289-0489-3760-8ab1-ba9e053f8cf6",
                                "text": "In order to prove the inexistence of God, he challenged Him to strike him down in five minutes while timing himself with a watch."
                            },
                            {
                                "example_id": "3d9be6c2-5a1b-431b-bb4a-b3c5ad80f25b",
                                "sense_id": "8bb26289-0489-3760-8ab1-ba9e053f8cf6",
                                "text": "Axiomatics (namely, that everything that will be used for the purposes of a demonstration is explained) does nothing more than formalizing this wiping clean — in other words, inexistence is posed as the condition for necessity to emerge."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d9a6ff0-79f8-30f1-a631-b73f6356ec16",
                        "entry_id": "b624a1cd-7fee-3dbe-a560-468c9b8cca54",
                        "glosses": [
                            "The state of existing in something"
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "b96e646c-4baf-40eb-a53f-a523b74baacf",
                                "sense_id": "0d9a6ff0-79f8-30f1-a631-b73f6356ec16",
                                "text": "that there is a mutual inexistence of one in all, and all in one; […]"
                            },
                            {
                                "example_id": "07c691b7-3167-46fd-a2d1-75a731c039b2",
                                "sense_id": "0d9a6ff0-79f8-30f1-a631-b73f6356ec16",
                                "text": "She distinguished as to this, the inexistence in God from eternity, and the figurative manifestation in time."
                            },
                            {
                                "example_id": "dcecbb1d-2816-4c9e-81e9-a1de261e7268",
                                "sense_id": "0d9a6ff0-79f8-30f1-a631-b73f6356ec16",
                                "text": "Berkeley's theory of the creature's permanent inexistence in God evoked a suspicion of pantheism."
                            }
                        ]
                    },
                    {
                        "sense_id": "72209c9f-2fbb-35f5-94f1-b551f5f2b661",
                        "entry_id": "b624a1cd-7fee-3dbe-a560-468c9b8cca54",
                        "glosses": [
                            "That which exists within; a constituent."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "8d077fd2-5f50-4dca-8c5b-9ce3589f71c9",
                                "sense_id": "72209c9f-2fbb-35f5-94f1-b551f5f2b661",
                                "text": "1768-1777, Abraham Tucker, The Light of Nature Pursued\nwhere could they find such receptacle for their inexistence"
                            }
                        ]
                    }
                ],
