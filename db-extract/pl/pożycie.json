                    {
                        "translation_id": "c714b035-6ea6-4f87-858e-7d30124ae57d",
                        "source_entry_id": "5e4dad99-07e2-3a38-a000-1cafa30d3edd",
                        "source_sense_id": "8cf2b438-3764-34b3-87c5-e5bca464237b",
