                            },
                            {
                                "target_word": "dying",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17a84eaf-f971-351b-b867-f64a9fa5c442",
                                        "entry_id": "8911762a-26b5-31bf-a614-356d0d975b8a",
                                        "glosses": [
                                            "Approaching death; about to die; moribund."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0906afcd-af59-4728-9064-fe0c76558b7f",
                                                "sense_id": "17a84eaf-f971-351b-b867-f64a9fa5c442",
                                                "text": "The dying dog was put out of his misery with a single shot!"
                                            },
                                            {
                                                "example_id": "9e0e59a0-230d-4758-b37b-d512ba357b64",
                                                "sense_id": "17a84eaf-f971-351b-b867-f64a9fa5c442",
                                                "text": "a dying fire"
                                            },
                                            {
                                                "example_id": "f66b559b-300b-46eb-a13c-420f4a818b78",
                                                "sense_id": "17a84eaf-f971-351b-b867-f64a9fa5c442",
                                                "text": "The battlefield was littered with the dead and dying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1065d510-6f98-361a-aaca-1cb39a955eba",
                                        "entry_id": "8911762a-26b5-31bf-a614-356d0d975b8a",
                                        "glosses": [
                                            "Declining, terminal, or drawing to an end."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da94c973-550b-4f31-b017-6eb57d40cf36",
                                                "sense_id": "1065d510-6f98-361a-aaca-1cb39a955eba",
                                                "text": "In the dying moments of daylight I glimpsed a sail on the horizon."
                                            },
                                            {
                                                "example_id": "fcc7f997-da95-4ece-ab01-83e691a807e7",
                                                "sense_id": "1065d510-6f98-361a-aaca-1cb39a955eba",
                                                "text": "The dieselisation of this line has not been, as is sometimes the case, a means of reviving a dying branch, but an improving hand to a healthy service."
                                            },
                                            {
                                                "example_id": "353b6546-7d32-40cc-9574-27ffc69b0ecd",
                                                "sense_id": "1065d510-6f98-361a-aaca-1cb39a955eba",
                                                "text": "Just as with other recent reports by various bodies on HS2 and the ticket office closures, the National Audit Office's effort on the rail reform process is a devastating exposé of the failings and floundering of a dying administration that has failed to understand the value of having an efficient rail network."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bca7c4f-ba0a-3ed3-8718-a4ef0aa85c8e",
                                        "entry_id": "8911762a-26b5-31bf-a614-356d0d975b8a",
                                        "glosses": [
                                            "Pertaining to death, or the moments before death."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c9271d4-fd5e-44ee-84af-c6ff2afb7098",
                                                "sense_id": "0bca7c4f-ba0a-3ed3-8718-a4ef0aa85c8e",
                                                "text": "His dying words were of his mother."
                                            },
                                            {
                                                "example_id": "e1c4220e-d6fc-441f-9fe7-5c4ae365eb82",
                                                "sense_id": "0bca7c4f-ba0a-3ed3-8718-a4ef0aa85c8e",
                                                "text": "until my dying day"
                                            },
                                            {
                                                "example_id": "a00afced-719b-4089-8751-9ea233e0a498",
                                                "sense_id": "0bca7c4f-ba0a-3ed3-8718-a4ef0aa85c8e",
                                                "text": "his dying bed"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dying",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b5b7b22-7a3a-3b7c-9ebc-c024fc501a02",
                                        "entry_id": "09552a4b-cc43-3173-8f12-fdb21878982b",
                                        "glosses": [
                                            "The process of approaching death; loss of life; death."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62173ea5-b693-4ebc-a2bb-8bb894c8bd32",
                                                "sense_id": "8b5b7b22-7a3a-3b7c-9ebc-c024fc501a02",
                                                "text": "“I'm looking forward to the most fascinating experience in life, which is dying,” he said. “You've got to approach your dying the way you live your life—with curiosity, with hope, with fascination, with courage and with the help of your friends.”"
                                            }
                                        ]
                                    }
                                ]
