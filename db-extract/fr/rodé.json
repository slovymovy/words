                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5a7a71e-3687-4699-9dde-8c29c04e7993",
                                "sense_id": "c4e1482d-c2f5-38e4-8ac0-8d57be32b284",
                                "text": "Un bouchon rodé."
                            },
                            {
                                "example_id": "2ff40645-3f46-4537-b5f3-37e357a44e77",
                                "sense_id": "c4e1482d-c2f5-38e4-8ac0-8d57be32b284",
                                "text": "Le triporteur, rodé, ne faisait à présent guère plus de bruit qu’une batteuse en activité."
                            }
                        ]
                    },
                    {
                        "sense_id": "b899be44-b9fa-3a1d-b341-501f6ad8f3f4",
                        "entry_id": "0142ad47-4210-3d33-abcf-385a12e53a8e",
                        "glosses": [
                            "Au point, qui fonctionne sans souci."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b71e49cf-4534-4d20-9149-8ae830092235",
                                "sense_id": "b899be44-b9fa-3a1d-b341-501f6ad8f3f4",
                                "text": "C’est une technique bien rodée."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa623434-951d-304a-93c5-16162a86c6b2",
                        "entry_id": "0142ad47-4210-3d33-abcf-385a12e53a8e",
                        "glosses": [
                            "Qui a tellement l’habitude de quelque chose qu’il n’y a plus aucune difficulté."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "655db0ec-29da-475f-86e7-2cbaed2daa48",
                                "sense_id": "aa623434-951d-304a-93c5-16162a86c6b2",
                                "text": "Il est rodé à ce genre de travail."
                            },
                            {
                                "example_id": "af3cff40-18c8-4c24-9fd2-666867bbfc25",
                                "sense_id": "aa623434-951d-304a-93c5-16162a86c6b2",
                                "text": "De sa voix assurée, Nasima démarre un discours bien rodé et attire rapidement l'attention.."
                            },
                            {
                                "example_id": "0287c143-5bf4-4a9c-9ab6-f2aff2b0d761",
                                "sense_id": "aa623434-951d-304a-93c5-16162a86c6b2",
                                "text": "Brian Riemer est rodé depuis bien longtemps aux critiques et se délecte à les faire taire par les résultats. Les Mauves sont quoi qu’on en dise au rendez-vous en ce début de championnat : trois victoires et deux partages en cinq matches."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d8e7fca-bafa-3016-a8f6-5b4689f5e06b",
                        "entry_id": "0142ad47-4210-3d33-abcf-385a12e53a8e",
                        "glosses": [
                            "Usé, rongé."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e6a1874f-adc4-44e0-9992-b9d714a5ca21",
                                "sense_id": "0d8e7fca-bafa-3016-a8f6-5b4689f5e06b",
                                "text": "Il entre aussi, par la porte sans serrure, sans loquet, une femme albinos, à peau translucide, aux yeux rouges, aux lèvres comme rodées."
                            }
                        ]
                    }
