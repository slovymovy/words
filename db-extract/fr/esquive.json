        "fr-extract.jsonl": [
            {
                "entry_id": "f6c0345a-a51f-36ed-a68a-33ba6db3cf4f",
                "word": "esquive",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a820cc38-9559-4f50-8680-f6fb9b364745",
                        "entry_id": "f6c0345a-a51f-36ed-a68a-33ba6db3cf4f",
                        "tags": [
