                        "entry_id": "d0d95769-338f-3207-8a74-efad9f671066",
                        "glosses": [
                            "Trouble de la vue se manifestant par une différence d’acuité visuelle entre les deux yeux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5734de0b-cc9f-4ff8-b3ff-29933379d9a2",
                                "sense_id": "ba848d01-7f59-340d-9d07-2b831369cf0e",
                                "text": "L’amblyopie fonctionnelle ne s’opère pas et ne se traite que par rééducation."
                            },
                            {
                                "example_id": "e9d0b5aa-36b3-4f97-8b65-75c0a1564941",
                                "sense_id": "ba848d01-7f59-340d-9d07-2b831369cf0e",
                                "text": "Uhthoff expose assez longuement les observations quʼil a pu faire dans sa clientèle privée sur lʼamblyopie par strabisme."
                            }
                        ]
                    }
                ],
