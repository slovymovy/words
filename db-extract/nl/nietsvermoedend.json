                ],
                "senses": [
                    {
                        "sense_id": "820fe823-fa5b-3689-9742-754d35204e8b",
                        "entry_id": "264ab884-cedd-3140-b17e-827023943090",
                        "glosses": [
                            "zonder argwaan, argeloos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "982903e4-327a-46a5-ab2a-34e69a03da42",
                                "sense_id": "820fe823-fa5b-3689-9742-754d35204e8b",
                                "text": "‘De meeste giftige mix op de camping is de mix van vaste bewoners en toeristen. Ruzie en toestanden krijg je daarvan. Sommige vaste bewoners zitten al zolang op dezelfde camping dat ze halve burgemeesters worden. Dan ga je ’s morgens nietsvermoedend naar de wc, komt iemand je vertellen dat je niet op zijn toilet mag gaan. “Hey, dat is mijne wc!” En dat dan liefst tegen een Nederlander! Campingbazen kennen het probleem. Daarom proberen ze beide kampeerders zo veel mogelijk uit ­elkaar te houden. Campingmensen zijn best sociaal, maar ook niet zo ­sociaal. Denken dat mensen gaan kamperen om volop nieuwe vrienden te maken, is een misverstand. Ze drinken weleens koffie met de buren en ze helpen elkaar graag uit de nood. Maar in principe hebben kampeerders genoeg aan hun eigen gezelschap. Campings waar iedereen iedereen uitnodigt voor sangria, zijn campings voor in een serie op tv. De sfeer van één groot zomerkamp is niet de realiteit.’"
                            },
                            {
                                "example_id": "e8ed7119-ff22-4f4c-b174-b1672f28f348",
                                "sense_id": "820fe823-fa5b-3689-9742-754d35204e8b",
                                "text": "Nietsvermoedend fietst Luc Schatorje in de nacht van maandag op dinsdag in Doetinchem naar huis. Kwart over een. Zijn werk bij Mexicaans restaurant Gringo's aan de Grutstraat zit er op. Plotseling hoort hij honderd meter voor hem een paar keiharde knallen. Grote koplampen van auto's zetten de Hamburgerstraat in het licht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b077aed-d4bb-407f-8cc4-44c90b891848",
                        "source_entry_id": "264ab884-cedd-3140-b17e-827023943090",
                        "source_sense_id": "820fe823-fa5b-3689-9742-754d35204e8b",
                        "source_sense_description": "zonder argwaan, argeloos",
                        "target_lang_word": "unsuspecting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsuspecting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95708eea-4808-3347-8a33-33d275c08b7c",
                                        "entry_id": "5aa8b522-9648-3ec2-8022-60323c5e5e7b",
                                        "glosses": [
                                            "Not suspecting; without any suspicion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e918dcbe-d634-4bb3-b17b-5c9b7738bbb3",
                                                "sense_id": "95708eea-4808-3347-8a33-33d275c08b7c",
                                                "text": "He easily shot the unsuspecting target."
                                            },
                                            {
                                                "example_id": "fc9c52f1-0998-4fe0-a7dd-0e63b2bc1f37",
                                                "sense_id": "95708eea-4808-3347-8a33-33d275c08b7c",
                                                "text": "One by one grotesque forms emerged from the jungle to creep stealthily upon the unsuspecting woman."
                                            },
                                            {
                                                "example_id": "6523ecdb-205a-4de9-b182-dbe4b5680f05",
                                                "sense_id": "95708eea-4808-3347-8a33-33d275c08b7c",
                                                "text": "To unsuspecting eyes these mongoose relatives can seem eminently pettable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
