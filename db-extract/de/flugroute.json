                                        "entry_id": "07186c3d-ab8b-3a75-8624-9295c6b5076e",
                                        "glosses": [
                                            "Itinéraire couramment emprunté par un avion ou un hélicoptère entre deux aéroports ou héliports."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09535400-53c4-46b7-a420-8b8737ab1b22",
                                                "sense_id": "62fa8c1d-73e3-3a96-82c4-7d4f971f9790",
                                                "text": "Si toutefois on observe les flux, il apparaît qu’un petit nombre de lignes aériennes concentrent l’essentiel du trafic : ce sont les lignes reliant Paris aux grandes villes du Midi (Nice, Marseille, Toulouse, Bordeaux, Montpellier et Toulon) et à …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3f77278-a248-39c2-ade8-58d81fab4af5",
                                        "entry_id": "07186c3d-ab8b-3a75-8624-9295c6b5076e",
                                        "glosses": [
                                            "Câble conducteur d’électricité soutenu en hauteur par des poteaux ou d’autres supports."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db655ab4-abe5-4049-83f3-dbf71d0a6216",
                                                "sense_id": "b3f77278-a248-39c2-ade8-58d81fab4af5",
                                                "text": "L’électricité est transportée depuis les centrales électriques jusqu’aux usagers avant tout à l’aide de lignes aériennes."
                                            }
                                        ]
                                    }
                                ]
