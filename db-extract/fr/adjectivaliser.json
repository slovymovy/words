                ],
                "senses": [
                    {
                        "sense_id": "a70cb626-eaca-3c8d-928d-ab562e426ca1",
                        "entry_id": "49fa8bff-39a8-3b83-81f1-f85617ec29ae",
                        "glosses": [
                            "Transformer en adjectif, utiliser comme adjectif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5b425a9-6f70-444d-82d9-3c6a41889441",
                                "sense_id": "a70cb626-eaca-3c8d-928d-ab562e426ca1",
                                "text": "Ces FL servent respectivement à nominaliser, verbaliser, adjectivaliser et adverbialiser une unité lexicale."
                            },
                            {
                                "example_id": "53a39699-181d-4865-b83d-31f55a824cae",
                                "sense_id": "a70cb626-eaca-3c8d-928d-ab562e426ca1",
                                "text": "Par ailleurs, ces deux verbes peuvent aussi être suivis d'un nom adjectivalisé."
                            },
                            {
                                "example_id": "2a3b5ff8-b17e-4ddf-a6f3-20f4cfd3dda5",
                                "sense_id": "a70cb626-eaca-3c8d-928d-ab562e426ca1",
                                "text": "Il s'agit des cas où le prédicat est clairement verbal, plutôt qu'adjectival ou adjectivalisé, puis éventuellement implicitement nominalisé, comme dans hi baino ohoratuago bat (Luc 14,8), '[quelqu']un de plus honoré que toi'."
                            }
                        ]
                    }
                ],
