{
    "word_family": [
        "pikey",
        "turnpike",
        "pickaxe",
        "haycock"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c2830ca-89f5-31a7-83ef-95238afae939",
                    "sense_definition": "Any carnivorous freshwater fish of the genus Esox, especially the northern pike, Esox lucius.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman was thrilled to catch a massive <w>pike</w> in the lake this morning.",
                            "target_lang_translations": {
                                "zh": "今天早上，渔夫在湖里钓到一条巨大的<w>狗鱼</w>，兴奋极了。"
                            }
                        },
                        {
                            "text": "You should use a wire leader when you fish for <w>pike</w> because their teeth are very sharp.",
                            "target_lang_translations": {
                                "zh": "钓<w>狗鱼</w>时你应该用钢丝前导线，因为它们的牙齿非常锋利。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ged",
                        "northern pike"
                    ],
                    "common_phrases": [
                        "fish for pike",
                        "giant pike"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种狗鱼属的食肉淡水鱼，尤指北方狗鱼。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "狗鱼",
                                "target_lang_sense_clarification": "指狗鱼属的食肉淡水鱼，尤指北方狗鱼"
                            },
                            {
                                "target_lang_word": "狗鱼属鱼类",
                                "target_lang_sense_clarification": "较书面或用于生物分类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de70308f-2efe-31bc-b1db-76d4e2f7c604",
                    "sense_definition": "A shortened form of <w>turnpike</w>, referring to a main road or highway, often one that requires a toll.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "road",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is heavy traffic on the <w>pike</w> today due to the holiday weekend.",
                            "target_lang_translations": {
                                "zh": "因为赶上节假日周末，今天这条<w>收费公路</w>上交通十分拥堵。"
                            }
                        },
                        {
                            "text": "We need to see what new technology is coming down the <w>pike</w> in the next few years.",
                            "target_lang_translations": {
                                "zh": "我们得看看未来几年会出现哪些新技术。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "down the pike",
                        "mass pike",
                        "on the pike"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in the Northeastern United States"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a clipping"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "turnpike 的简称，指主干道路或高速公路，通常是收费的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "收费公路",
                                "target_lang_sense_clarification": "口语中对收费公路或主干高速路的简称"
                            },
                            {
                                "target_lang_word": "高速公路",
                                "target_lang_sense_clarification": "泛指主干高速道路"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0696933-cb48-3fd7-bbe0-151f061e9a55",
                    "sense_definition": "A body position in sports like diving or gymnastics where the knees are straight and the body is folded tightly at the hips.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diver performed a perfect back dive in <w>pike</w> position to win the gold medal.",
                            "target_lang_translations": {
                                "zh": "那名跳水运动员以完美的<w>屈体</w>姿势完成了向后跳水，赢得了金牌。"
                            }
                        },
                        {
                            "text": "She managed to keep her legs perfectly straight while holding the <w>pike</w> during her routine.",
                            "target_lang_translations": {
                                "zh": "她在整套动作中保持<w>屈体</w>时，双腿始终绷得笔直。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pike position",
                        "pike jump",
                        "in a pike"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Technical term in sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在跳水、体操等运动中，双膝伸直、身体从髋部紧折的姿势。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "屈体",
                                "target_lang_sense_clarification": "跳水、体操等项目中双膝伸直、从髋部折叠的姿势"
                            },
                            {
                                "target_lang_word": "屈体姿势",
                                "target_lang_sense_clarification": "完整说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7cdc4c1-c766-3599-a91a-de8b11ca6952",
                    "sense_definition": "A very long spear used by infantry soldiers in historical warfare to defend against cavalry or attack foot soldiers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The infantry formed a wall of <w>pikes</w> to stop the charging horses.",
                            "target_lang_translations": {
                                "zh": "步兵列成一堵<w>长矛</w>墙，以阻挡冲锋的战马。"
                            }
                        },
                        {
                            "text": "Each soldier carried a long <w>pike</w> that measured over fourteen feet in length.",
                            "target_lang_translations": {
                                "zh": "每名士兵都携带一支超过十四英尺长的<w>长矛</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "long pike",
                        "pike formation",
                        "armed with pikes"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical weapon"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "历史战争中步兵使用的一种很长的矛，用于抵御骑兵或攻击步兵。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "长矛",
                                "target_lang_sense_clarification": "历史上步兵使用的很长的矛"
                            },
                            {
                                "target_lang_word": "长枪",
                                "target_lang_sense_clarification": "强调其极长、用于方阵作战"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55855cb1-804d-37cc-967c-47caef106a6a",
                    "sense_definition": "A hill or mountain, especially one with a sharp or pointed peak.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the entire afternoon hiking to the top of the <w>pike</w> to see the view.",
                            "target_lang_translations": {
                                "zh": "我们整个下午都在徒步登上那座<w>尖峰</w>的顶端看风景。"
                            }
                        },
                        {
                            "text": "Scafell <w>Pike</w> is known as the highest mountain in England.",
                            "target_lang_translations": {
                                "zh": "斯科费尔<w>峰</w>被认为是英格兰最高的山。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mountain pike",
                        "sharp pike"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in Northern England place names"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "山丘或山峰，尤指峰顶尖锐突出的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尖峰",
                                "target_lang_sense_clarification": "尤指尖耸的山峰或山丘"
                            },
                            {
                                "target_lang_word": "峰",
                                "target_lang_sense_clarification": "用于地名释义时可译为峰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c18c1a54-52d0-3ff8-b0bb-f3f75857b0be",
                    "sense_definition": "A sharp, pointed staff or implement used for various tasks.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers used a sharp <w>pike</w> to move the heavy blocks of ice.",
                            "target_lang_translations": {
                                "zh": "工人们用一根尖利的<w>尖杆</w>搬动沉重的冰块。"
                            }
                        },
                        {
                            "text": "The heads of the traitors were displayed on <w>pikes</w> as a warning to the public.",
                            "target_lang_translations": {
                                "zh": "叛徒的头颅被插在<w>尖桩</w>上示众，以儆效尤。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sharp pike",
                        "iron pike"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种尖锐的杆子或工具，可用于多种用途。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尖杆",
                                "target_lang_sense_clarification": "一般指尖锐的杆状工具或棍棒"
                            },
                            {
                                "target_lang_word": "尖桩",
                                "target_lang_sense_clarification": "指用来插刺或示众的尖木桩、铁桩"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff613727-18ef-3377-9bca-7b74bef67c2b",
                    "sense_definition": "A long, pointed extrusion at the toe of a shoe, fashionable in the 14th and 15th centuries.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fashion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Medieval fashion included shoes with <w>pikes</w> so long they had to be tied to the knees.",
                            "target_lang_translations": {
                                "zh": "中世纪流行一种鞋，鞋头的<w>尖头</w>长到必须绑在膝盖上。"
                            }
                        },
                        {
                            "text": "The law restricted the length of the <w>pike</w> on a gentleman's boot to two inches.",
                            "target_lang_translations": {
                                "zh": "法律把绅士靴子上<w>尖头</w>的长度限制在两英寸以内。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shoe pike"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical fashion term"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "14至15世纪流行的一种鞋尖前端细长突出的部分。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尖头",
                                "target_lang_sense_clarification": "中世纪鞋尖前部细长突出的部分"
                            },
                            {
                                "target_lang_word": "鞋尖",
                                "target_lang_sense_clarification": "更具体地指鞋子的尖长鞋头"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bfe43c6-36c8-3269-bd53-dcf47d788bbc",
                    "sense_definition": "A slang term for the penis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old play contained many double meanings regarding the soldier and his <w>pike</w>.",
                            "target_lang_translations": {
                                "zh": "那部古老戏剧里有很多关于士兵和他的<w>阴茎</w>的双关意味。"
                            }
                        },
                        {
                            "text": "He stood there boastfully, gesturing toward his <w>pike</w> in a vulgar manner.",
                            "target_lang_translations": {
                                "zh": "他傲慢地站在那里，粗俗地朝自己的<w>阴茎</w>比划着。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Vulgar or literary double entendre"
                        },
                        {
                            "trait_type": "obsolete",
                            "comment": "Mainly found in early modern literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "俚语，指阴茎。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阴茎",
                                "target_lang_sense_clarification": "粗俗俚语，指男性生殖器"
                            },
                            {
                                "target_lang_word": "鸡巴",
                                "target_lang_sense_clarification": "更口语、粗俗"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b790e8e1-83e6-33c7-b3e1-a5d14a6b6f75",
                    "sense_definition": "To quit, back out, or fail to fulfill a promise or commitment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I really hope you don't <w>pike</w> out on our plans at the last minute again.",
                            "target_lang_translations": {
                                "zh": "我真希望你这次别又在最后一刻对我们的计划<w>爽约</w>。"
                            }
                        },
                        {
                            "text": "He promised to help us move, but he <w>piked</w> on me like he did last time.",
                            "target_lang_translations": {
                                "zh": "他答应帮我们搬家，可又像上次一样对我<w>失约</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pike out",
                        "pike on someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in Australia and New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "退出、反悔，或没有履行承诺。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "爽约",
                                "target_lang_sense_clarification": "口语，指临时退出、反悔或不履行承诺"
                            },
                            {
                                "target_lang_word": "失约",
                                "target_lang_sense_clarification": "指没有兑现答应别人的事"
                            },
                            {
                                "target_lang_word": "临阵退出",
                                "target_lang_sense_clarification": "较宽泛，指中途退出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "066a505d-fb6c-3d0f-8883-390660ebf0d1",
                    "sense_definition": "To move the body into a pike position while performing a dive or gymnastic move.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gymnast <w>pikes</w> her legs perfectly during the upward swing of the routine.",
                            "target_lang_translations": {
                                "zh": "这名体操运动员在动作上摆时把双腿完美地<w>屈体</w>。"
                            }
                        },
                        {
                            "text": "As she reached the peak of her jump, she began <w>piking</w> to increase her rotation speed.",
                            "target_lang_translations": {
                                "zh": "当她跳到最高点时，便开始<w>屈体</w>以加快旋转速度。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "piking the legs"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Technical sports usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在跳水或体操动作中使身体进入屈体姿势。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "屈体",
                                "target_lang_sense_clarification": "在跳水或体操动作中使身体进入屈体姿势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "917483a4-0552-3ea0-b831-e77bf6916942",
                    "sense_definition": "To attack, prod, or kill someone using a pike.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry mob threatened to <w>pike</w> the prisoner if he was not released to them.",
                            "target_lang_translations": {
                                "zh": "愤怒的暴民威胁说，如果不把囚犯交给他们，就要用长矛把他<w>刺死</w>。"
                            }
                        },
                        {
                            "text": "Historical accounts describe how the rebels would <w>pike</w> their enemies during the uprising.",
                            "target_lang_translations": {
                                "zh": "历史记载描述了叛乱期间反叛者如何用长矛<w>刺杀</w>敌人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical combat"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用长矛攻击、刺戳或杀死某人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "刺死",
                                "target_lang_sense_clarification": "用长矛刺击并杀死"
                            },
                            {
                                "target_lang_word": "刺杀",
                                "target_lang_sense_clarification": "强调用长矛这类武器攻击"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a872d7f2-c665-3a76-9e4f-e5f253f8ec36",
                    "sense_definition": "To gamble or bet using only very small amounts of money.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gambling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He didn't want to lose much, so he just <w>piked</w> along at the ten-cent table.",
                            "target_lang_translations": {
                                "zh": "他不想输太多，所以只是在一角钱的赌桌上<w>小额下注</w>。"
                            }
                        },
                        {
                            "text": "She spent the evening <w>piking</w> by placing small bets on the roulette board.",
                            "target_lang_translations": {
                                "zh": "她整个晚上都在轮盘赌桌上<w>小额下注</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pike along"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Old-fashioned gambling slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "赌博时只用很小的金额下注。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小额下注",
                                "target_lang_sense_clarification": "赌博时只下很小的赌注"
                            },
                            {
                                "target_lang_word": "小赌",
                                "target_lang_sense_clarification": "强调赌注下得很小"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d1b23d25-26a6-3ed5-926d-f7848b4fa5cb",
                    "sense_definition": "An English <w>surname</w> derived from Middle English.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Pike</w> has lived in this small village for over forty years.",
                            "target_lang_translations": {
                                "zh": "<w>派克</w>先生已经在这个小村庄住了四十多年。"
                            }
                        },
                        {
                            "text": "The local library was named after a prominent citizen with the surname <w>Pike</w>.",
                            "target_lang_translations": {
                                "zh": "当地的图书馆是以一位姓<w>派克</w>的知名市民名字命名的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一个源自中古英语的英国姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "派克",
                                "target_lang_sense_clarification": "英语姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fc98249-e4c5-38f4-b1d5-13c8978c72e2",
                    "sense_definition": "The name of several places in the United States, such as a town in New York.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to stop for lunch while driving through the small town of <w>Pike</w>.",
                            "target_lang_translations": {
                                "zh": "他们开车经过<w>派克</w>镇时，决定停下来吃午饭。"
                            }
