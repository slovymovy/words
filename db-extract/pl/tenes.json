                                "target_senses": [
                                    {
                                        "sense_id": "67cf37c6-73da-3443-b4ee-6a2c572853ae",
                                        "entry_id": "9cfcf9d3-47b4-37ea-bdff-29158267668e",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 117"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cdf85ca-a577-421d-af21-dbb5001e35c1",
                                                "sense_id": "67cf37c6-73da-3443-b4ee-6a2c572853ae",
                                                "text": "„Das Element Tennessine (Ts) wird auf Deutsch TENNESS heißen.“"
                                            },
                                            {
                                                "example_id": "8ab184eb-b103-4f9c-bd39-032392396bb8",
                                                "sense_id": "67cf37c6-73da-3443-b4ee-6a2c572853ae",
                                                "text": "„Offen ist, ob sich dafür im deutschen Sprachgebrauch die Bezeichnung Tennessin, Tennessine oder gar Tenness durchsetzen wird.“"
                                            },
                                            {
                                                "example_id": "d0a2c212-46be-477c-a0cd-8f745172c042",
                                                "sense_id": "67cf37c6-73da-3443-b4ee-6a2c572853ae",
                                                "text": "„Die Expertenrunde beschloss daher für das Element 117 den deutschen Namen Tenness (abgeleitet vom Namen des amerikanischen Bundesstaates Tennessee, daher Betonung auf der ersten Silbe, vgl. „Tennis“) mit dem Elementsymbol Ts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
