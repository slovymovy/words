    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3dedb21f-a125-3ff7-88b2-15fded98a355",
                "word": "charism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "78ef54a7-f48c-4839-87f7-ab9ff04e7bc3",
                        "entry_id": "3dedb21f-a125-3ff7-88b2-15fded98a355",
                        "tags": [
                            "plural"
                        ],
                        "form": "charisms"
                    },
                    {
                        "form_id": "59fb9699-e2ac-4cf6-8685-5af84b1da037",
                        "entry_id": "3dedb21f-a125-3ff7-88b2-15fded98a355",
                        "tags": [
                            "plural"
                        ],
                        "form": "charismata"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f23ad758-4164-3436-af2a-22f3be48b2f5",
                        "entry_id": "3dedb21f-a125-3ff7-88b2-15fded98a355",
                        "glosses": [
                            "A power or authority, generally of a spiritual nature, believed to be a freely given gift by the Grace of God."
                        ],
                        "tags": [
                            "countable",
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4d07d83b-4fad-4738-a534-4f26c7e1d424",
                                "sense_id": "f23ad758-4164-3436-af2a-22f3be48b2f5",
                                "text": "Reviewing the prudential warnings and moral qualms issued by the United States Conference of Catholic Bishops, “it is hard not to conclude,” the editors write, “that the bishops’ charism, rather than the president’s, has better served the nation.”"
                            },
                            {
                                "example_id": "421f1d4a-76c4-4bb2-b0e7-a941b249d325",
                                "sense_id": "f23ad758-4164-3436-af2a-22f3be48b2f5",
                                "text": "The Roman Catholic Church has as its named charism the unity of a truly catholic gathered people. Unfortunately, that very ethos is challenged by division and factionalism that could put protestants to shame."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1bd66d84-7e1a-4b3c-a542-83422012f6d7",
                        "source_entry_id": "3dedb21f-a125-3ff7-88b2-15fded98a355",
                        "source_sense_id": "f23ad758-4164-3436-af2a-22f3be48b2f5",
                        "source_sense_description": "extraordinary power granted by the Holy Spirit",
                        "target_lang_word": "charisma",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charisma",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "748e8a0e-1bb7-38a3-9a5c-1f43f673c5db",
                                        "entry_id": "85064e4f-e804-33d1-a445-c8c15c8a1e4d",
                                        "glosses": [
                                            "persoonlijke uitstraling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a35ecdb-5e1a-47af-b0fd-22556fe409f7",
                                                "sense_id": "748e8a0e-1bb7-38a3-9a5c-1f43f673c5db",
                                                "text": "Bij de presidentiële verkiezingen bleek charisma het te winnen van ervaring."
                                            },
                                            {
                                                "example_id": "c7b60869-df32-4448-900b-ad2c13046d74",
                                                "sense_id": "748e8a0e-1bb7-38a3-9a5c-1f43f673c5db",
                                                "text": "Deze ‘Pogue Mahone’ (‘kiss my arse’ in Gaelic) leek sprekend op de ‘The Dude’ uit de film ‘The Big Lebowski’ met zijn relaxte houding en opvallende charisma."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be6ce505-3fde-423a-a2f1-aaf7efd1795e",
                        "source_entry_id": "3dedb21f-a125-3ff7-88b2-15fded98a355",
                        "source_sense_id": "f23ad758-4164-3436-af2a-22f3be48b2f5",
                        "source_sense_description": "extraordinary power granted by the Holy Spirit",
                        "target_lang_word": "charisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ec39015-a897-3bf6-a3d0-a5b8981d4654",
                                        "entry_id": "b1975365-203a-33c9-a607-3667e31e9afc",
                                        "glosses": [
                                            "Don exceptionnel ou grâce, accordé par Dieu à une ou plusieurs personnes, comme le don de guérison, l'aptitude à « parler plusieurs langues », etc., non pour le bien de soi, mais pour le bien de tous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be7687b1-1436-4cff-86bd-7e35add68fba",
                                                "sense_id": "8ec39015-a897-3bf6-a3d0-a5b8981d4654",
                                                "text": "Chacun possède son charisme. C’est la forme particulière que prend le Saint-Esprit dans les divers individus."
                                            },
                                            {
                                                "example_id": "2f88acde-43c3-4bf2-8559-833fdde58382",
                                                "sense_id": "8ec39015-a897-3bf6-a3d0-a5b8981d4654",
                                                "text": "La translation du corps de l’évêque myroblyte, de Myre à Bari où il repose depuis le 9 mai 1087, n'a pas interrompu le précieux charisme, le tombeau de saint Nicolas n'a point cessé d'être glorieux, et, comme tout pèlerin de Bari peut le voir de ses yeux, la « manne » ou liqueur miraculeuse continue à découler de ses ossements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "531f8ecd-283c-30c0-ac5e-22c1935e2777",
                                        "entry_id": "b1975365-203a-33c9-a607-3667e31e9afc",
                                        "glosses": [
                                            "Depuis 1971, désigne le caractère collectif de cette qualité appliquée à un institut, une communauté ou une congrégation religieuse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49e9dc0e-7cfe-4639-ad9f-5f2edf11e101",
                                                "sense_id": "531f8ecd-283c-30c0-ac5e-22c1935e2777",
                                                "text": "Terme de plus en plus utilisé dans le vocabulaire de l'Église depuis le concile de Vatican II, le charisme désigne le caractère propre d'un institut ou d'une congrégation."
                                            },
                                            {
                                                "example_id": "f876d0f0-7e41-45b1-ab8c-f69a2cc8161b",
                                                "sense_id": "531f8ecd-283c-30c0-ac5e-22c1935e2777",
                                                "text": "En ce sens, le charisme peut-être défini comme un moyen pour s'approcher d'un groupe social particulier, complète le dominicain Jean-Claude Lavigne. Ce moyen peut-être l'école, l'hôpital ou la présence dans les quartiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55916c80-c2ea-3666-8543-3a79dec5dcf2",
                                        "entry_id": "b1975365-203a-33c9-a607-3667e31e9afc",
                                        "glosses": [
                                            "Aura indéfinissable, talent que semble posséder quelqu’un, souvent lié à sa prestance, qui est capable de susciter l’adhésion, la fascination d’un grand nombre de personnes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aef80bb-f485-449d-b5d4-fb3429105260",
                                                "sense_id": "55916c80-c2ea-3666-8543-3a79dec5dcf2",
                                                "text": "La force du charlatan, c’est son charisme, ce qui le rapproche à la fois du sorcier et du prophète mais il se compare mieux au premier qu’au second."
                                            },
                                            {
                                                "example_id": "2273578e-5317-4ef0-9805-521d7554e8ce",
                                                "sense_id": "55916c80-c2ea-3666-8543-3a79dec5dcf2",
                                                "text": "On ne présente plus le pur-sang arabe. Sa beauté, son charisme et toutes les légendes qui s'y rattachent en font un cheval à part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02124e59-01e6-3f6e-a62f-555dd7ff9274",
                                        "entry_id": "b1975365-203a-33c9-a607-3667e31e9afc",
                                        "glosses": [
                                            "À Donjons & Dragons, et d’autres jeux de rôle, caractéristique (valeur chiffrée) représentant la capacité d’un personnage à influencer les autres, à les mettre en confiance, par son éloquence et son comportement."
                                        ],
                                        "tags": [
                                            "Jeux de rôle"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3aa73023-487e-48e3-92d9-325743140e4e",
                        "source_entry_id": "3dedb21f-a125-3ff7-88b2-15fded98a355",
                        "source_sense_id": "f23ad758-4164-3436-af2a-22f3be48b2f5",
                        "source_sense_description": "extraordinary power granted by the Holy Spirit",
                        "target_lang_word": "Charisma",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Charisma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4cef6abd-5c05-3c37-ae1d-025b603a58e2",
                                        "entry_id": "1366c43e-601e-3098-aed5-3472d21bca40",
                                        "glosses": [
                                            "die Gabe, Offenbarungen, Inspirationen und Erleuchtungen empfangen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09dd7f5d-5309-45e5-a3cb-0ba25d621f5a",
                                                "sense_id": "4cef6abd-5c05-3c37-ae1d-025b603a58e2",
                                                "text": "Im Neuen Testament wird erwähnt, dass die Charismen die Gaben des Heiligen Geistes sind."
                                            },
                                            {
                                                "example_id": "a796406f-d7e7-453c-a37a-03966e2f4421",
                                                "sense_id": "4cef6abd-5c05-3c37-ae1d-025b603a58e2",
                                                "text": "„Und mit seinem Charisma und dem internationalen Hintergrund entspricht natürlich niemand dem Bild vom Antichrist so genau wie Präsident Barack Obama.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "efcc7aa3-928f-38ab-a98d-7c579563c802",
                                        "entry_id": "1366c43e-601e-3098-aed5-3472d21bca40",
                                        "glosses": [
                                            "besondere Ausstrahlung einer Person"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d472dcef-b832-44ad-be97-34d1fb4d942f",
                                                "sense_id": "efcc7aa3-928f-38ab-a98d-7c579563c802",
                                                "text": "Dieser Moderator hat Charisma."
                                            },
                                            {
                                                "example_id": "739bfcd8-a87c-4561-8822-20d0a6f4181e",
                                                "sense_id": "efcc7aa3-928f-38ab-a98d-7c579563c802",
                                                "text": "„Als habe jemand einen Schalter umgelegt, war es wieder da, das Charisma, das er schon in Chicago ausgestrahlt hatte.“"
                                            },
                                            {
                                                "example_id": "f710765c-c4ae-404d-948c-77bee05ab1b0",
                                                "sense_id": "efcc7aa3-928f-38ab-a98d-7c579563c802",
                                                "text": "Als jüngster jemals gewählter US-Präsident verkörperte John Fitzgerald Kennedy mit seinem strahlenden Charisma für viele Zeitgenossen den Aufbruch in eine hellere Zukunft."
                                            },
                                            {
                                                "example_id": "c50a0132-eeed-48a2-afb2-f43fe260c2a9",
                                                "sense_id": "efcc7aa3-928f-38ab-a98d-7c579563c802",
                                                "text": "Insbesondere der außeralltägliche Charismatiker ist nicht nur rar, sondern sein Charisma ist auch besonders unbeständig - er weckt große Hoffnungen, die Menschen setzen hohe Erwartungen in ihn, trauen ihm besonders viel zu und wenn sich im \"Realitätstest\" diese hohen Erwartungen nicht erfüllen lassen, dann wenden sie sich enttäuscht von ihm ab, siehe Barack Obama."
                                            },
                                            {
                                                "example_id": "dedadd3b-5de7-451d-b300-d413be72738b",
                                                "sense_id": "efcc7aa3-928f-38ab-a98d-7c579563c802",
                                                "text": "„An Chomskys Charisma war nichts elegant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "81ecda80-3417-3672-b03e-7ebfd723b62e",
                                        "entry_id": "1366c43e-601e-3098-aed5-3472d21bca40",
                                        "glosses": [
                                            "Kurzform für charismatische Herrschaft"
                                        ],
                                        "tags": [
                                            "Soziologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c48fdea9-50df-4d4a-a4fd-c586c76174fa",
                                                "sense_id": "81ecda80-3417-3672-b03e-7ebfd723b62e",
                                                "text": "Nach Max Weber ist das Charisma eine der drei Herrschaften."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
