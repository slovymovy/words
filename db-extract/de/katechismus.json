                                    },
                                    {
                                        "sense_id": "46a2acb7-f7ec-329c-aa50-05e324b854e9",
                                        "entry_id": "794fa1ff-c53d-37cd-9828-ed718bc3cc74",
                                        "glosses": [
                                            "A basic manual in some subject."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b1cfd38-22d9-32e6-9051-52bb3f65b65f",
                                        "entry_id": "794fa1ff-c53d-37cd-9828-ed718bc3cc74",
                                        "glosses": [
                                            "A set of questions designed to determine knowledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "759d1afe-de1b-4bda-a5c1-d9ea4d2f9d67",
                                                "sense_id": "5b1cfd38-22d9-32e6-9051-52bb3f65b65f",
                                                "text": "...the walls were covered with paper, whose original colour and pattern had long since merged in a dingy brown; over this were hung up some unframed drawings, and some shelves on which were ranged all the old school books, grammars, Pinnock's catechisms, and one or two French novels that had belonged to a former governess."
                                            },
                                            {
                                                "example_id": "050a2cab-ab2d-4792-b96f-38a393520626",
                                                "sense_id": "5b1cfd38-22d9-32e6-9051-52bb3f65b65f",
                                                "text": "Inscrutable His ways are, and immune\nTo catechism by a mind too strewn\nWith petty cares to slightly understand\nWhat awful brain compels His awful hand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
