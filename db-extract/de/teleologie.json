                        ],
                        "form": "die Teleologie"
                    },
                    {
                        "form_id": "c562aba8-b8aa-4b32-a044-141e3144ff52",
                        "entry_id": "763e1934-c1a3-3e12-b03e-6ff8db3d902f",
