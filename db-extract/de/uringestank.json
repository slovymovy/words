                ],
                "senses": [
                    {
                        "sense_id": "2ec3fa21-4b29-3630-9910-fd3cf0b8aeb7",
                        "entry_id": "59b3f7e9-0b8c-3348-94c5-f6186966bae7",
                        "glosses": [
                            "Gestank nach Urin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95ecea0d-3312-4719-b626-c0aa169f0a13",
                                "sense_id": "2ec3fa21-4b29-3630-9910-fd3cf0b8aeb7",
                                "text": "„Nicht dass das Haus verwahrlost wäre. Kein Uringestank schlägt einem entgegen, wenn man das Gebäude betritt.“"
                            },
                            {
                                "example_id": "13e2ab49-af2a-43f1-9bf2-93e0917970a1",
                                "sense_id": "2ec3fa21-4b29-3630-9910-fd3cf0b8aeb7",
                                "text": "„Der Uringestank war wie ein Schlag ins Gesicht; sie musste durch den Mund atmen.“"
                            },
                            {
                                "example_id": "ad0218c2-1dab-4f89-be5b-75fa36e98cf5",
                                "sense_id": "2ec3fa21-4b29-3630-9910-fd3cf0b8aeb7",
                                "text": "„Der Raum roch nach altem Bratfett und abgestandenem Holzrauch vom Ofen, und über allem lag ein leichter Uringestank.“"
                            },
                            {
                                "example_id": "42485dcb-49aa-4cea-a1a8-a366b1f170b8",
                                "sense_id": "2ec3fa21-4b29-3630-9910-fd3cf0b8aeb7",
                                "text": "„Ich wartete in einem Flur im zweiten Stock auf ihn, neben einem Treppenhaus, aus dem gelegentlich ein Schwall beißenden Uringestanks aufstieg.“"
                            },
                            {
                                "example_id": "6599d4b9-9fff-4fb3-a0cc-a81aabda6b31",
                                "sense_id": "2ec3fa21-4b29-3630-9910-fd3cf0b8aeb7",
                                "text": "„Graham schob sich in die Seitengasse, lief durch Müll und Uringestank zum Notausgang von Carters Kirche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
