                        "entry_id": "c02313d1-59f0-349b-af74-1c30efc11d00",
                        "glosses": [
                            "Haute école spécialisée."
                        ],
                        "tags": [],
                        "note": "Cette appellation correspond mieux au sens de Fachhochschule dans les pays germanophones",
