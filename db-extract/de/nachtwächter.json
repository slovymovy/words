                                        "entry_id": "055f3cfb-32a5-3c7f-abe9-332f82bb7917",
                                        "glosses": [
                                            "A person who guards (usually at a building) at night."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab1de983-fba6-4ace-a45b-d5452bdbb582",
                                                "sense_id": "914175c5-c33a-3b08-b143-ae2ed23b91c6",
                                                "text": "We can hear the night watchman click his flashlight / Ask himself if it's him or them that's insane"
                                            }
                                        ]
                                    },
