                                            {
                                                "example_id": "7d3df954-acb1-4b4e-9a91-959ea075b47c",
                                                "sense_id": "cea89fa1-565f-30e3-8cb2-c481bf45efee",
                                                "text": "Ani na jotę nie zmienił się jej wygląd rodowitej bostonki: rumiana twarz, gęste brwi, prosty nos i ciemne oczy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "1b165bc1-912e-34fa-a463-3173729c3263",
                                        "entry_id": "9ec1e842-600d-32a2-960c-112881d019c5",
                                        "glosses": [
                                            "rodzaj ręcznej maszyny drukarskiej do drukowania małych nakładów"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8c1676f-b8fb-4d9a-a56d-cbdcd080e38a",
                                                "sense_id": "1b165bc1-912e-34fa-a463-3173729c3263",
                                                "text": "Pod koniec lat dwudziestych wyposażenie drukarni stanowiły cztery maszyny pośpieszne, trzy pedałówki, bostonka, maszyna do perforowania, dwie maszyny do krajania papieru, kompletna maszyna do stereotypii"
                                            }
                                        ],
