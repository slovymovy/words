                "senses": [
                    {
                        "sense_id": "bb485db2-606f-3502-98de-ce3a0a583471",
                        "entry_id": "2afa014d-ca60-3e34-af96-bb021cf48009",
                        "glosses": [
                            "männliche Person, die für die Pflege von Hotelzimmern beschäftigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65e0bdfa-c155-47f9-9ddf-b78f73ea081e",
                                "sense_id": "bb485db2-606f-3502-98de-ce3a0a583471",
                                "text": "„Beispielsweise werden sowohl von ‚Zimmermädchen/Roomboys‘ als auch von einem ‚Fremdsprachensekretär (m/w)‘ sehr gute Deutschkenntnisse verlangt.“"
                            },
                            {
                                "example_id": "243160c6-ca91-4a39-a4d3-67a3b1ce1b2b",
                                "sense_id": "bb485db2-606f-3502-98de-ce3a0a583471",
                                "text": "„Sein erster Job war der eines Zimmermädchens, pardon Roomboys.“"
                            },
                            {
                                "example_id": "a4e5a6fd-050d-40f2-a927-8e74555562fe",
                                "sense_id": "bb485db2-606f-3502-98de-ce3a0a583471",
                                "text": "„Sie muss den Dienstplan der Zimmermädchen und Roomboys erstellen.“"
                            },
                            {
                                "example_id": "405f7761-5967-4410-af90-4ab25364259b",
                                "sense_id": "bb485db2-606f-3502-98de-ce3a0a583471",
                                "text": "„Der Roomboy bekam ein üppiges Trinkgeld.“"
                            },
                            {
                                "example_id": "cb8f1ca3-06fe-4339-b7f3-07116e9aeeb0",
                                "sense_id": "bb485db2-606f-3502-98de-ce3a0a583471",
                                "text": "„Er ist vermutlich die Reinigungskraft, oder wie nennt man ihn, vielleicht Roomboy.“"
                            },
                            {
                                "example_id": "b2e709e9-40cf-40d7-9cf1-3727c91f2814",
                                "sense_id": "bb485db2-606f-3502-98de-ce3a0a583471",
                                "text": "„Zimmermädchen und Roomboys sind oft Einzelpersonen, die unabhängig arbeiten können, sich an strenge Zeitpläne halten und detailorientierte Zeitmanager sind, die im Umgang mit allen Arten von Reinigungsgeräten und -zubehör bewandert sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
