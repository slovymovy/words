                "senses": [
                    {
                        "sense_id": "60772372-2173-3687-955e-0cd9f6325917",
                        "entry_id": "4571040d-6efe-3a2d-afcf-4bd69c52cf42",
                        "glosses": [
                            "Artiste qui combine différentes sources sonores, particulièrement des disques en vinyle ou compacts, en vue de produire une création originale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50dfcf89-4f2b-4ee5-988a-00f51992eddc",
                                "sense_id": "60772372-2173-3687-955e-0cd9f6325917",
                                "text": "Historiquement parlant, le platiniste est le plus fervent représentant de la représentation live, même si aujourd’hui, un live d’un artiste est un travail de composition directe avec l’utilisation de machines d’où sort directement la musique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91846212-ffe8-4866-89b9-ea17483c0540",
                        "source_entry_id": "4571040d-6efe-3a2d-afcf-4bd69c52cf42",
                        "source_sense_id": "60772372-2173-3687-955e-0cd9f6325917",
                        "target_lang_word": "deejay",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deejay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d49265e0-0388-305a-818b-ce7b08cc0153",
                                        "entry_id": "351b1e3c-04ab-36bb-a74b-06218f841936",
                                        "glosses": [
                                            "A disc jockey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8e843d1-a914-415e-9bd3-1eed5a516d94",
                                                "sense_id": "d49265e0-0388-305a-818b-ce7b08cc0153",
                                                "text": "Sasa, a deejay who owned a mobile disco, took him on for lifting and handling."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "deejay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a69f61f-2d51-389d-8874-948f383ee2c3",
                                        "entry_id": "cbe9111a-ae07-3725-86e9-ca28defa33c7",
                                        "glosses": [
                                            "To perform as a disc jockey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0006843f-915e-4346-8399-1f32c01fca9d",
                                                "sense_id": "6a69f61f-2d51-389d-8874-948f383ee2c3",
                                                "text": "Isaac soon found out that deejaying was a trade that attracted transient, laid-back but arrogant people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae58fb6b-4262-3747-ba1c-ba4ac8ad4750",
                                        "entry_id": "cbe9111a-ae07-3725-86e9-ca28defa33c7",
                                        "glosses": [
                                            "To play music as a disc jockey."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d11c22b7-1ff2-4eb3-a7ea-15f06cec80bc",
                        "source_entry_id": "4571040d-6efe-3a2d-afcf-4bd69c52cf42",
                        "source_sense_id": "60772372-2173-3687-955e-0cd9f6325917",
                        "target_lang_word": "disc jockey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disc jockey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "967958ba-a77e-38ca-bbaa-2743b1d7e4fe",
                                        "entry_id": "eb130297-893d-30da-8e14-158a024cfd0b",
                                        "glosses": [
                                            "A person who conducts a radio program of recorded music combined with talk, news, commercials, weather, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ba7ec38-67f3-40f4-a67e-6ed58a5a585c",
                                                "sense_id": "967958ba-a77e-38ca-bbaa-2743b1d7e4fe",
                                                "text": "The show he produced first aired on WJMR, a white-owned New Orleans radio station. The show's disc jockey used the name “Poppa Stoppa” and played what would then be called “race music,” the term given to any music produced by African American artists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cf6e2b7-6fdd-318f-9add-3ff605db3512",
                                        "entry_id": "eb130297-893d-30da-8e14-158a024cfd0b",
                                        "glosses": [
                                            "A person who plays, and sometimes mixes, recorded music at nightclubs, dances, parties, or some other social event; and/or as a backup musician for spoken word, or hip hop performers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f69648d-f19e-4618-97e2-d73325187fa3",
                                                "sense_id": "6cf6e2b7-6fdd-318f-9add-3ff605db3512",
                                                "text": "The disc jockey played brilliant music at the party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b51c7cd-d65d-4d39-822d-7a1416999ae8",
                        "source_entry_id": "4571040d-6efe-3a2d-afcf-4bd69c52cf42",
                        "source_sense_id": "60772372-2173-3687-955e-0cd9f6325917",
                        "target_lang_word": "DJ",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "DJ",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11380dbd-2355-38d1-9ad3-3915e9d85a43",
                                        "entry_id": "29e300b8-1557-3ef7-aed8-31bfcf63f51e",
                                        "glosses": [
                                            "Initialism of disc jockey."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f0a3a54-83ef-45c0-a598-db1a6b86db87",
                                                "sense_id": "11380dbd-2355-38d1-9ad3-3915e9d85a43",
                                                "text": "Last night a DJ saved my life / Last night a DJ saved my life from a broken heart"
                                            },
                                            {
                                                "example_id": "13c821ce-8dcd-4495-b59e-aabc95ba400f",
                                                "sense_id": "11380dbd-2355-38d1-9ad3-3915e9d85a43",
                                                "text": "Burn down the disco / Hang the blessed DJ / Because the music that they constantly play / It says nothing to me about my life"
                                            },
                                            {
                                                "example_id": "04acc2d0-99dc-4730-a7cb-2786c686e29c",
                                                "sense_id": "11380dbd-2355-38d1-9ad3-3915e9d85a43",
                                                "text": "Three MC's and one DJ / We be getting down with no delay"
                                            },
                                            {
                                                "example_id": "64710337-a5cf-4d03-aea4-3189e86c0104",
                                                "sense_id": "11380dbd-2355-38d1-9ad3-3915e9d85a43",
                                                "text": "“I like to put it simply,” says Randy “R Dub!” Williams, a late-night “slow jams” DJ from San Diego who’s also known as “the Sultan of Slowjamastan.” “I ran out of countries, so I created my own.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5041dbf9-03b6-3914-bbdc-b01998a82423",
                                        "entry_id": "29e300b8-1557-3ef7-aed8-31bfcf63f51e",
