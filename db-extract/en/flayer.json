                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8598550a-814a-4635-b6d6-149aec06f954",
                                                "sense_id": "5019c816-3be4-3af0-a6d6-560af92f123b",
                                                "text": "Dans les mains de ces écorcheurs, il dut avouer."
                                            }
                                        ]
                                    }
                                ]
