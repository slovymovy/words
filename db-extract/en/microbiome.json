                                        "glosses": [
                                            "Lebensgemeinschaft aller Mikroorganismen, die ein Lebewesen besiedeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f19e690c-4c19-43fd-a31f-19638c8d1c31",
                                                "sense_id": "d60b3b4c-eb3a-3995-b302-988cf95e6f3b",
                                                "text": "„Es ist schon länger bekannt, dass das Mikrobiom die Entstehung von Allergien oder Übergewicht beeinflussen kann.“"
                                            }
