                        "entry_id": "c0f61e4d-a5cf-3012-a9a4-a7588236a570",
                        "glosses": [
                            "The vertical edge of a sail that is closest to the direction of the wind."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "488e7652-8aea-4875-aeaf-8d61a1d945bc",
                                "sense_id": "ef44499e-3a06-3f9c-b273-49dd1f154f49",
                                "text": "By easing the halyard, the luff of the sail was made to sag to leeward."
                            },
                            {
                                "example_id": "c057d08c-6399-44d5-86ed-9877e6e21768",
                                "sense_id": "ef44499e-3a06-3f9c-b273-49dd1f154f49",
                                "text": "\"The man at the helm was watching the luff of the sail and whistling away gently to himself.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "f7e0faed-85e5-3acd-8840-f0a48246312b",
                        "entry_id": "c0f61e4d-a5cf-3012-a9a4-a7588236a570",
                        "glosses": [
