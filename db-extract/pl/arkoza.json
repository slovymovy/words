                    {
                        "translation_id": "346f1854-fdee-479b-82f7-6dfd8a6bc0a9",
                        "source_entry_id": "76eb8175-b2c2-340e-8d81-d991e552d0fb",
                        "source_sense_id": "6ea67fbd-b0b8-34f6-abf0-51f59120be31",
                        "target_lang_word": "arkose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arkose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ef00aed-d283-3551-9611-06ccbe6016c1",
                                        "entry_id": "ce151967-f7bc-3b61-b572-9af93fb7bb00",
                                        "glosses": [
                                            "Grès grossier et friable ayant l'aspect du granite ou de la granulite, composée d’éléments analogues (quartz, feldspath, mica) mais friable. Les éléments rocheux sont roulés et agglutinés par un ciment d'argile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20b41b54-3fd1-48c7-aab6-e29b89b826e4",
                                                "sense_id": "9ef00aed-d283-3551-9611-06ccbe6016c1",
                                                "text": "Elle en aimait la pierre d’arkose claire mélangée aux touches sombres de la lave extraite des volcans tout proches."
                                            },
                                            {
                                                "example_id": "7f6edea4-34fc-4be3-ad22-9434e879f2fe",
                                                "sense_id": "9ef00aed-d283-3551-9611-06ccbe6016c1",
                                                "text": "De hauteur modeste, les montagnes encadrant la baie présentent néanmoins des contours très nets. Elles se composent en majeure partie de granit gris, de porphyre quartzique, de grès, de cornéenne, d’arkose et de jaspe à fines veinules de quartz."
                                            },
                                            {
                                                "example_id": "ccbb1f91-cb63-4de9-b57b-c15bfaf83ea0",
                                                "sense_id": "9ef00aed-d283-3551-9611-06ccbe6016c1",
                                                "text": "L’arkose est d'origine détritique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdaa379f-06b7-4ae5-8d48-611644fbf70b",
                        "source_entry_id": "76eb8175-b2c2-340e-8d81-d991e552d0fb",
