                        "target_lang_word": "Milchmädchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Milchmädchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd7b4ce7-45df-36e4-aae5-35c4f9e00a8c",
                                        "entry_id": "98949ad5-1770-3ffc-ace6-2c33d618963f",
                                        "glosses": [
                                            "Berufsbezeichnung für junge Frauen, die Kühe melken, Milch verarbeiten und verkaufen"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9469b7f8-a728-4464-a0a1-ca88b7ef7bdd",
                                                "sense_id": "dd7b4ce7-45df-36e4-aae5-35c4f9e00a8c",
                                                "text": "Den Milchmädchen kam in der historischen Milchindustrie eine wichtige Rolle zu."
                                            },
                                            {
                                                "example_id": "927fabb5-3b20-4576-aea2-6d574308f523",
                                                "sense_id": "dd7b4ce7-45df-36e4-aae5-35c4f9e00a8c",
                                                "text": "„Und so erhielten die Veteranen und Kriegsversehrten in diesem Jahrzehnt Gesellschaft von ehemaligen Verkäuferinnen, früheren Milchmädchen, einstigen Arbeiterinnen und entlassenen Dienstmädchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac2d1ae0-27a4-4b75-93fe-26504959bf20",
                        "source_entry_id": "eda63463-38a1-3397-841d-67531f650892",
                        "source_sense_id": "9aa006c2-c00e-3b1d-ab44-13f7354a46a9",
                        "source_sense_description": "woman who works in a dairy",
                        "target_lang_word": "Sennerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sennerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20b8fe81-ad17-3d2f-871c-41ee70fbcadf",
                                        "entry_id": "2bac211c-f17f-3489-b846-d6c0dc18b39a",
                                        "glosses": [
                                            "weibliche Person, die in den Alpen auf einer Alm Milchwirtschaft betreibt, also Käse oder Butter herstellt"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24c7efe6-6e3f-43d3-9d7b-601acb861b34",
                                                "sense_id": "20b8fe81-ad17-3d2f-871c-41ee70fbcadf",
                                                "text": "Die Sennerin ist zuständig für das Zusammentreiben und Melken der Kühe und ggf. zur Herstellung von Milchprodukten (Butter, Käse); sie betreibt Almwirtschaft üblicherweise in Alleinregie im Auftrag des Bauern."
                                            },
                                            {
                                                "example_id": "e65dae08-691e-4914-b03e-ec256efdbd2d",
                                                "sense_id": "20b8fe81-ad17-3d2f-871c-41ee70fbcadf",
                                                "text": "„Da gab's dann bald mehr Diskos als Kühe in den Dörfern, in den Landgasthöfen sprudelten die Whirlpools, und die Sennerinnen wurden mit dem Paragleiter auf die Alm geflogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
