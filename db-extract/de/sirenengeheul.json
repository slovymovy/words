                "senses": [
                    {
                        "sense_id": "26f06a29-a57f-3426-92b4-ff0f06b377c8",
                        "entry_id": "f36dce25-4895-30c7-bf9b-118bf67fe72f",
                        "glosses": [
                            "von Sirenen ausgehendes lautes Geräusch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "658fed5a-97e1-4124-a173-ac51f28281e0",
                                "sense_id": "26f06a29-a57f-3426-92b4-ff0f06b377c8",
                                "text": "„Der Drei-Sterne-Konvoi setzt sich unter Sirenengeheul und von den Dächern gebrüllten Befehlen in Bewegung.“"
                            },
                            {
                                "example_id": "ed63d74e-cb69-4626-9b38-27db37607784",
                                "sense_id": "26f06a29-a57f-3426-92b4-ff0f06b377c8",
                                "text": "„Aus dem Dorf vernahm er Sirenengeheul.“"
                            },
                            {
                                "example_id": "a2a47ced-031d-414f-bccb-74770c506708",
                                "sense_id": "26f06a29-a57f-3426-92b4-ff0f06b377c8",
                                "text": "„Die Welle der Fahrzeuge tauchte mit Sirenengeheul und eingeschalteten Scheinwerfern aus der Dunkelheit auf und fuhr geradewegs auf den Knäuel der Feiernden zu.“"
                            },
                            {
                                "example_id": "c4e62291-4bcf-4d5d-840a-3ed357149fd4",
                                "sense_id": "26f06a29-a57f-3426-92b4-ff0f06b377c8",
                                "text": "„Das Sirenengeheul wurde lauter und verstummte dann abrupt; ich hörte Wagentüren zuschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
