                ],
                "senses": [
                    {
                        "sense_id": "499ab9e8-82b7-3b6b-8887-333440b4b0e6",
                        "entry_id": "0365f1f5-4ec8-3f8f-9a37-72594a96fcae",
                        "glosses": [
                            "een take tijdens film-, radio-, podium- of televisieopnames en voorstellingen die verknoeid wordt door onvoorziene omstandigheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9bac057-2d33-44ab-bebe-f5aca1cf6225",
                                "sense_id": "499ab9e8-82b7-3b6b-8887-333440b4b0e6",
                                "text": "Omroep AVROTROS meldde eerder al dat De Luizenmoeder een tweede seizoen krijgt. Komende zondag volgt ook nog een bonusaflevering met de bloopers tijdens de opnames."
                            },
                            {
                                "example_id": "fbbf3b59-b7df-4d86-8e06-333208aa860d",
                                "sense_id": "499ab9e8-82b7-3b6b-8887-333440b4b0e6",
                                "text": "Het programma draait om privé bloopers en pijnlijke thuisvideo's uit binnen- en buitenland."
                            }
                        ]
                    },
                    {
                        "sense_id": "76d5476b-4606-3a65-9db6-654e15d748dc",
                        "entry_id": "0365f1f5-4ec8-3f8f-9a37-72594a96fcae",
                        "glosses": [
                            "stomme fout in het algemeen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d2d2443-d9d5-49be-9f8a-fbd1e1302718",
                                "sense_id": "76d5476b-4606-3a65-9db6-654e15d748dc",
                                "text": "„Daar is geen studievisum voor nodig”, zei Bleker over deze oplossing, daarmee verwijzend naar het compromis dat is gevonden voor de jonge asielzoeker Mauro. „Ik vind het een trieste verwijzing”, oordeelt de parlementariër. „Hij maakt steeds grapjes over de rug van Mauro, nadat hij eerder al in Pauw & Witteman een briefje had geschreven waarin hij Mauro uitnodigde mee te gaan naar een voetbalwedstrijd. Dit is weer zo’n blooper.”"
                            }
                        ]
                    }
                ],
                "translations": [
