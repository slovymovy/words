                        ],
                        "form": "die Dienstwägen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "922cbc36-81ed-3d1c-b917-80ccbad0d05d",
                        "entry_id": "0841e00b-544b-3a83-9048-8b568646f889",
                        "glosses": [
                            "Fuhrwerk, das der Fronpflicht gemäß dem Fronherrn für Transporte zur Verfügung zu stellen war"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "9777d9c7-f858-42ce-b1e2-6960bd2496df",
                                "sense_id": "922cbc36-81ed-3d1c-b917-80ccbad0d05d",
                                "text": "Wir müssen stets einen Dienstwagen mitsamt vier Pferden bereithalten, damit die Herrschaft allzeit darauf zugreifen kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "55d473f1-75e0-35ca-8127-1f13b3797cc3",
                        "entry_id": "0841e00b-544b-3a83-9048-8b568646f889",
                        "glosses": [
                            "Pkw, der einem Arbeitnehmer vom Arbeitgeber für dienstliche Fahrten zur Verfügung gestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72c515c2-7152-40ec-8588-2ce235822a31",
                                "sense_id": "55d473f1-75e0-35ca-8127-1f13b3797cc3",
                                "text": "Ausgerechnet gestern, als ich einen wichtigen Kunden besuchen wollte, war der Dienstwagen in der Werkstatt."
                            },
                            {
                                "example_id": "d4fabe10-d9cb-4baf-83fa-f489abe288f6",
                                "sense_id": "55d473f1-75e0-35ca-8127-1f13b3797cc3",
                                "text": "„Vielleicht werde ihr die Firma einen Dienstwagen stellen, möglicherweise mit Chauffeur, mutmaßte der Vater.“"
                            },
                            {
                                "example_id": "6be395d5-9f1f-48d5-9690-520ee241b34a",
                                "sense_id": "55d473f1-75e0-35ca-8127-1f13b3797cc3",
                                "text": "„Als Küchenpsychologe könnte man dies einen Fall übersteigerter Verdrängung nennen, denn beide saßen natürlich wirklich in Zeesen, und vermutlich war Gründgen's Dienstwagen auf dem Kiesweg geparkt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa92b515-9c22-46fd-b619-39137fa2c3d5",
                        "source_entry_id": "0841e00b-544b-3a83-9048-8b568646f889",
                        "source_sense_id": "55d473f1-75e0-35ca-8127-1f13b3797cc3",
                        "source_sense_description": "Fahrzeug für dienstliche Fahrten",
                        "target_lang_word": "voiture de fonction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voiture de fonction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ffb489e-a2d7-3dc5-9ab8-ba7c574286b4",
                                        "entry_id": "dffbf391-a91d-3a85-a732-c3e7d54a8b54",
                                        "glosses": [
                                            "Véhicule mis à disposition d’un salarié ou d’un fonctionnaire dans le cadre de sa fonction."
                                        ],
                                        "tags": [
                                            "Travail"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "780c0d43-2e86-4ac3-b239-0a7f32eaf6ba",
                                                "sense_id": "0ffb489e-a2d7-3dc5-9ab8-ba7c574286b4",
                                                "text": "Pour mes déplacements, le gouvernement militaire m’avait attribué une voiture de fonction, une Coccinelle, une Volkswagen, la « voiture du peuple » qu’avait voulue Hitler en 1934."
                                            },
                                            {
                                                "example_id": "71a269b0-90f0-4f00-b1e8-677d5fd77172",
                                                "sense_id": "0ffb489e-a2d7-3dc5-9ab8-ba7c574286b4",
                                                "text": "Il démarchait des entreprises pour vendre des serrures, des portes blindées et des systèmes d’alarme. Il roulait en voiture de fonction, portait des costumes chics et une gourmette en or au poignet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
