                "translations": [
                    {
                        "translation_id": "d49dc872-5d35-4f65-9c4d-acc4e22fc693",
                        "source_entry_id": "af5da54d-6f0a-3840-bd21-fe331e3edbce",
                        "source_sense_description": "release from a yoke",
                        "target_lang_word": "dételer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dételer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66952e08-aa16-33da-acba-40b5d228f94f",
                                        "entry_id": "15f503b2-7e1e-36a1-a4a6-aaac3d7f2c42",
                                        "glosses": [
                                            "Détacher une bête de trait d’une voiture, d’une charrue ou de tout autre engin à traction animale à laquelle elle était attelée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9eb34c6-a250-4b9c-beb7-5d46b6ff44d5",
                                                "sense_id": "66952e08-aa16-33da-acba-40b5d228f94f",
                                                "text": "Peu à peu les canots regagnèrent la plage, les charrettes furent dételées, les bêtes de somme renfermées dans les parcs, […]."
                                            },
                                            {
                                                "example_id": "bd329e8e-1176-4696-b813-5371a24dc569",
                                                "sense_id": "66952e08-aa16-33da-acba-40b5d228f94f",
                                                "text": "Il fut un peu surpris de voir, stationnant sur la grande route, un immense break, dont les chevaux avaient été dételés et emmenés."
                                            },
                                            {
                                                "example_id": "eeb177da-cba1-4790-b497-11fe1a1ca916",
                                                "sense_id": "66952e08-aa16-33da-acba-40b5d228f94f",
                                                "text": "Le même après-midi, à l’heure où l’on dételait les bœufs de la charrue, douze femmes sortirent de la maison du fiancé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0eb4111-5b94-3ae0-844a-1cf60ee9bcb5",
                                        "entry_id": "15f503b2-7e1e-36a1-a4a6-aaac3d7f2c42",
                                        "glosses": [
                                            "Cesser un travail, une occupation (intellectuelle ou manuelle)."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7da1709c-22b4-45dc-8420-0dd55b09c40c",
                                                "sense_id": "a0eb4111-5b94-3ae0-844a-1cf60ee9bcb5",
                                                "text": "Bon, assez travaillé, maintenant on va dételer !"
                                            },
                                            {
                                                "example_id": "ec88c171-64d2-484b-b4ef-8404cb8a65c1",
                                                "sense_id": "a0eb4111-5b94-3ae0-844a-1cf60ee9bcb5",
                                                "text": "Il est l’heure, il faut dételer !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59738551-189e-38ad-95d1-821b293c2a6f",
                                        "entry_id": "15f503b2-7e1e-36a1-a4a6-aaac3d7f2c42",
                                        "glosses": [
                                            "Renoncer à une activité malhonnête, renoncer à certains plaisirs."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f929ee4-4588-4481-9455-a41087691ed9",
                                                "sense_id": "59738551-189e-38ad-95d1-821b293c2a6f",
                                                "text": "Environ trois ans après le mariage d’Hortense, en 1841, le baron Hulot d’Ervy passait pour s’être rangé, pour avoir dételé, selon l’expression du premier chirurgien de Louis XV, et madame Marneffe lui coûtait cependant deux fois plus que ne lui avait coûté Josépha."
                                            },
                                            {
                                                "example_id": "268d2e65-9805-4498-b2cb-a0846c82cf90",
                                                "sense_id": "59738551-189e-38ad-95d1-821b293c2a6f",
                                                "text": "– Mais enfin, pourquoi ?… Une femme de mon tempérament n’a pas encore dételé, à cinquante-quatre ans.\n– Detélé ! Quelle expression ! Si Riquet vous entendait…"
                                            },
                                            {
                                                "example_id": "caa1e86e-19d1-40bf-a30c-98804baa6c52",
                                                "sense_id": "59738551-189e-38ad-95d1-821b293c2a6f",
                                                "text": "Je n'en veux pas à mon oncle, seulement je trouve drôle que mon conseil de famille, qui s'est toujours montré si sévère pour moi, soit composé précisément des parents qui ont le plus fait la bombe, à commencer par le plus noceur de tous, mon oncle Charlus, qui est mon subrogé tuteur, qui a eu autant de femmes que don Juan et qui à son âge ne dételle pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
