                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maroquinerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f889d886-c31b-381b-9c29-a544cc3a6937",
                                        "entry_id": "14ba8f7c-9e54-32ef-9e53-efb4b1dfaf0c",
                                        "glosses": [
                                            "Industrie du maroquin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ca4137c-2c39-3737-b14b-651d42b76e6a",
                                        "entry_id": "14ba8f7c-9e54-32ef-9e53-efb4b1dfaf0c",
                                        "glosses": [
                                            "Fabrication artisanale ou industrielle d’objets en maroquin ou en autre cuir fin."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec96c2ae-9c8f-4325-b52e-6b775a6d3832",
                                                "sense_id": "7ca4137c-2c39-3737-b14b-651d42b76e6a",
                                                "text": "La maroquinerie parisienne sait parfaitement approprier ses productions aux nécessités de l’usage des objets. Elle sait joindre l’utilité pratique au confortable. C’est grâce à elle que la France excelle dans la garniture des nécessaires de tout genre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8d41fb6-fda6-3ea5-9026-a37275902c57",
                                        "entry_id": "14ba8f7c-9e54-32ef-9e53-efb4b1dfaf0c",
                                        "glosses": [
                                            "Magasin où l’on vend toutes sortes d’objets en cuir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da93fdc9-1fc1-4058-ad77-9df8947c5cd6",
                                                "sense_id": "b8d41fb6-fda6-3ea5-9026-a37275902c57",
                                                "text": "Elle travaille dans quatre commerces: une maroquinerie, un magasin de vêtements de luxe, un restaurant de cuisine grecque et une petite agence de voyages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
