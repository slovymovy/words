                        ]
                    },
                    {
                        "translation_id": "cb07fdb9-d7ea-4baa-9167-afb44485e4fe",
                        "source_entry_id": "19bb6cdb-9e66-38fc-a99f-26b80a6aec38",
                        "source_sense_id": "c95cadf1-acef-313d-a8a4-668a99b86005",
                        "target_lang_word": "photocopieur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photocopieur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e147ae83-4d49-39a5-b1de-d2cc9d955479",
                                        "entry_id": "8730c3bb-7ab0-3b7d-a651-6a3162f1ed2c",
                                        "glosses": [
                                            "Appareil utilisant un procédé xérographique qui est une technique d'électrophotographie et permettant de reproduire un document rapidement et à bon marché lorsque le nombre d'exemplaires à reproduire est relativement peu élevé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba8ee5f5-ae46-4ea5-b712-7c753e926d6f",
                                                "sense_id": "e147ae83-4d49-39a5-b1de-d2cc9d955479",
                                                "text": "Le photocopieur est constitué d’un cylindre métallique nommé tambour ou photoconducteur recouvert d’une couche de matériau semi-conducteur."
                                            },
                                            {
                                                "example_id": "8fe1c5c9-2858-4969-ac4a-a9cb59bcee93",
                                                "sense_id": "e147ae83-4d49-39a5-b1de-d2cc9d955479",
                                                "text": "On lui a demandé de faire des photocopies. Elle dit: a) Le photocopieur, c’est où? b) Pourriez-vous me dire où se trouve le photocopieur? c) Je dois faire des photocopies. Qu’est-ce que je fais?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51e6653e-b26c-4ee2-9d45-8a17cfb77cbf",
                        "source_entry_id": "19bb6cdb-9e66-38fc-a99f-26b80a6aec38",
                        "source_sense_id": "c95cadf1-acef-313d-a8a4-668a99b86005",
                        "target_lang_word": "photocopieuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photocopieuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "336db314-c951-3211-828a-6c4be736f91c",
                                        "entry_id": "cd0d5d7a-dbdf-35ac-b342-7f18e3b305d1",
                                        "glosses": [
                                            "Appareil utilisant un procédé xérographique qui est une technique d'électrophotographie et permettant de reproduire un document rapidement et à bon marché lorsque le nombre d'exemplaires à reproduire est relativement peu élevé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49931164-9d79-4c59-851d-adfe434d90c4",
                                                "sense_id": "336db314-c951-3211-828a-6c4be736f91c",
                                                "text": "Je retournai à la photocopieuse en pensant que j’avais dû mal placer les pages dans l’avaleuse."
                                            },
                                            {
                                                "example_id": "41f239cc-cc86-48e5-ba47-fce914f5666e",
                                                "sense_id": "336db314-c951-3211-828a-6c4be736f91c",
                                                "text": "La chambre noire est-elle un simple moyen d’atteindre une esthétique, en créant une image entièrement fabriquée par toutes sortes de techniques (jusqu’à la photocopieuse couleurs) ?"
                                            }
                                        ]
                                    }
                                ]
                            }
