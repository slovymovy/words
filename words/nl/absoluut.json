                },
                {
                    "sense_id": "7ef73fd3-a32a-3a94-9a70-96c6400f6323",
                    "sense_definition": "met grote zekerheid en zonder twijfel",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zekerheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik vind spruitjes <w>absoluut</w> niet lekker en eet ze nooit.",
                            "target_lang_translations": {
                                "en": "I <w>absolutely</w> do not like Brussels sprouts and never eat them."
                            }
                        },
                        {
                            "text": "Zij is de <w>absolute</w> topfavoriet om de wedstrijd morgen te winnen.",
                            "target_lang_translations": {
                                "en": "She is the <w>absolute</w> top favorite to win the match tomorrow."
                            }
