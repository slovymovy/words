                            {
                                "example_id": "8d75bb89-a1b7-42df-8994-64be53f9fb6c",
                                "sense_id": "3f2bafab-914f-351c-91d0-a1446683154f",
                                "text": "You shall bring and lay in our hands tne product of your activity: we will divide it into two parts — the one shall be ours; it shall be sacred; you shall call it tithe; we will foretake it [...]"
                            },
                            {
                                "example_id": "7ecf10cc-91df-4595-a2bc-d03d6bb7131e",
                                "sense_id": "3f2bafab-914f-351c-91d0-a1446683154f",
                                "text": "Enraptures a man to foretake his pleasure, And capture a woman to partake her treasure."
                            },
                            {
                                "example_id": "52570645-56fb-4c02-8cfa-ff5ab392e379",
                                "sense_id": "3f2bafab-914f-351c-91d0-a1446683154f",
                                "text": "Upon entering, she showed me to the bedroom. I got undressed and laid on the bed, thinking of the course of action I had to foretake as I lay there."
                            }
