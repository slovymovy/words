        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf83069a-cc24-35f7-ac31-205d0a51156a",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>puren</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>puur</w> veel kracht uit de gesprekken die ik met mijn vrienden voer.",
                            "target_lang_translations": {
                                "en": "I <w>derive</w> a lot of strength from the conversations I have with my friends.",
                                "ru": "Я <w>черпаю</w> много сил из разговоров, которые веду со своими друзьями."
                            }
                        },
                        {
                            "text": "Elke dag <w>puur</w> ik inspiratie uit de natuur om mij heen.",
                            "target_lang_translations": {
                                "en": "Every day I <w>draw</w> inspiration from the nature around me.",
                                "ru": "Каждый день я <w>извлекаю</w> вдохновение из окружающей меня природы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first person singular present tense of 'puren' (to extract or derive)",
                        "ru": "форма первого лица единственного числа настоящего времени глагола 'puren' (извлекать или черпать)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "derive",
                                "target_lang_sense_clarification": "to obtain from a source"
                            },
                            {
                                "target_lang_word": "draw",
                                "target_lang_sense_clarification": "to extract or pull from"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "черпать",
                                "target_lang_sense_clarification": "получать что-либо из источника"
                            },
                            {
                                "target_lang_word": "извлекать",
                                "target_lang_sense_clarification": "добывать пользу или смысл"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0513fb29-14e9-341a-88f3-0c801df9ed43",
                    "sense_definition": "gebiedende wijs van <w>puren</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Puur</w> de essentie uit dit ingewikkelde verhaal voor de samenvatting.",
                            "target_lang_translations": {
                                "en": "<w>Extract</w> the essence from this complicated story for the summary.",
                                "ru": "<w>Извлеки</w> самую суть из этой запутанной истории для краткого изложения."
                            }
                        },
                        {
                            "text": "<w>Puur</w> alle voordelen uit deze situatie nu het nog kan.",
                            "target_lang_translations": {
                                "en": "<w>Distill</w> all the benefits from this situation while you still can.",
                                "ru": "<w>Черпай</w> все выгоды из этой ситуации, пока это еще есть возможность."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative mood of 'puren' (to extract or derive)",
                        "ru": "повелительное наклонение глагола 'puren' (извлекать или черпать)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "extract",
                                "target_lang_sense_clarification": "to remove or take out by effort"
                            },
                            {
                                "target_lang_word": "distill",
                                "target_lang_sense_clarification": "to extract the essential meaning or most important aspects"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "извлекай",
