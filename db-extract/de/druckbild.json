                "senses": [
                    {
                        "sense_id": "b633ba6d-b04b-31bf-a0db-00acc3c9c490",
                        "entry_id": "8121b6bc-60e6-3689-b632-192ab2c4bca7",
                        "glosses": [
                            "durch ein Druckverfahren erzeugte Wiedergabe einer Vorlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caa6aa10-5a4b-4ab2-ba7f-e02ad7d5025f",
                                "sense_id": "b633ba6d-b04b-31bf-a0db-00acc3c9c490",
                                "text": "„Mit der Entwicklung des Offsetdrucks, bei dem ein Gummituchzylinder das Druckbild von der Form auf das Papier überträgt, wurde diese Technologie auch für den Hochdruck entdeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bf8f23c-d9b7-4415-9e0d-32da12192761",
                        "source_entry_id": "8121b6bc-60e6-3689-b632-192ab2c4bca7",
                        "source_sense_id": "b633ba6d-b04b-31bf-a0db-00acc3c9c490",
                        "source_sense_description": "durch ein Druckverfahren erzeugte Wiedergabe einer Vorlage",
                        "target_lang_word": "отпечаток",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "отпечаток",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "15c18f71-1a7d-3dc5-b7d1-af534b747dc1",
                                        "entry_id": "1437d17a-f781-3382-951f-394297277c9f",
                                        "glosses": [
                                            "изображение, оставшееся на чём-либо от надавливания другого предмета; след"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96ab8cec-ef41-446c-bc9c-da9936ab3931",
                                                "sense_id": "15c18f71-1a7d-3dc5-b7d1-af534b747dc1",
                                                "text": "С каждым шагом всё яснее становились отпечатки лап медведя."
                                            },
                                            {
                                                "example_id": "214d7d42-ac0b-45db-ae09-9872c438e486",
                                                "sense_id": "15c18f71-1a7d-3dc5-b7d1-af534b747dc1",
                                                "text": "Копировальная бумага не вечна: чем больше копий сделано с её помощью, тем меньше остается на ней краски и тем более бледным становится отпечаток."
                                            },
                                            {
                                                "example_id": "ab974c25-0913-49ab-ab0a-12800a739f8b",
                                                "sense_id": "15c18f71-1a7d-3dc5-b7d1-af534b747dc1",
                                                "text": "― Ой, у тебя на щеке отпечаток подушки!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34aedf1e-4e02-309c-bab2-a67f3941c37e",
                                        "entry_id": "1437d17a-f781-3382-951f-394297277c9f",
                                        "glosses": [
                                            "фотографический снимок, полученный посредством печати с негатива"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7100958-ffd1-46bf-baa0-5086f1e2f271",
                                                "sense_id": "34aedf1e-4e02-309c-bab2-a67f3941c37e",
                                                "text": "Наиболее простой путь расцвечивания снимков состоит в переводе черно-белого негатива в цветной отпечаток методом тоноразделения."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "497e2159-1930-3191-b2f4-8d1ab4ed5d7e",
                                        "entry_id": "1437d17a-f781-3382-951f-394297277c9f",
                                        "glosses": [
                                            "перен. признак как результат влияния какой-либо среды, событий и т. п."
                                        ],
                                        "tags": [
                                            "чего или какой."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c14ffd3-9bfe-4352-ae5e-86844ebb8cd2",
                                                "sense_id": "497e2159-1930-3191-b2f4-8d1ab4ed5d7e",
                                                "text": "На ней лежал отпечаток той школы, в которой она довершила светское воспитание, того круга, в котором жила с малолетства."
                                            },
                                            {
                                                "example_id": "dc8c7742-11f7-4d1f-b161-54b070281540",
                                                "sense_id": "497e2159-1930-3191-b2f4-8d1ab4ed5d7e",
                                                "text": "Зато нравом он походил на отца; и несхожее с отцовским лицо носило отпечаток отцовского выражения, и руки имел он узловатые, и впалую грудь, как старик Аратов, которого, впрочем, едва ли следует называть стариком, так как он и до пятидесяти лет не дотянул."
                                            },
                                            {
                                                "example_id": "37eb1ea5-2b8c-4544-bd69-a07a05525c99",
                                                "sense_id": "497e2159-1930-3191-b2f4-8d1ab4ed5d7e",
                                                "text": "Хотя он из старой дворянской семьи, но его узкая профессия наложила на него некоторый отпечаток."
                                            },
                                            {
                                                "example_id": "c67d1c23-1629-4bb2-92b0-b769cca688ff",
                                                "sense_id": "497e2159-1930-3191-b2f4-8d1ab4ed5d7e",
                                                "text": "Как и ожидалось, послание носило на себе отпечаток того обстоятельства, что оно произносилось в год выборов в Думу и за год до президентских выборов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
