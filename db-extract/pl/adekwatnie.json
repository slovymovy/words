                                                "sense_id": "da098bd4-5cd8-3023-983a-dae71d2da2f4",
                                                "text": "Man sollte ihm keinen Vorwurf machen, denn er handelte nur entsprechend seiner Weisung."
                                            },
                                            {
                                                "example_id": "94db5f69-fdb2-4b98-a61c-36deadacf466",
                                                "sense_id": "da098bd4-5cd8-3023-983a-dae71d2da2f4",
                                                "text": "Man sollte ihm keinen Vorwurf machen, denn er handelte nur seiner Weisung entsprechend."
                                            },
                                            {
                                                "example_id": "fdd22f04-0f0c-43e0-b3e1-a90fa739fe95",
                                                "sense_id": "da098bd4-5cd8-3023-983a-dae71d2da2f4",
