                        "glosses": [
                            "twee samenwerkende clowns die samen één act hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bee9149-7876-4a40-896c-f69efce5d102",
                                "sense_id": "62888586-da86-37c1-9246-f9c0a9b09b39",
                                "text": "Met Remery vormde hij vanaf 1991 het clownsduo Urkie Purkie. 'Peter en ik maakten verschillende shows. Onder meer Hoedje af, Retteket, Zomertoeren, Rollebollen en Hi5 klinken ongetwijfeld bekend in de oren bij veel kinderen."
                            },
                            {
                                "example_id": "80c1cf4d-b5f6-4948-af17-daa271c2f20f",
                                "sense_id": "62888586-da86-37c1-9246-f9c0a9b09b39",
                                "text": "Samen vormen ze nu het succesvolle clownsduo Bonbon & Tiina. Hun act als badmintonspelers is in de circuswereld een begrip. Ze werkten er mee in beroemde circussen als Krone, Benneweis en Merano."
                            },
                            {
                                "example_id": "a5d48fb3-659f-4401-bc4b-0ce6dbad6e58",
                                "sense_id": "62888586-da86-37c1-9246-f9c0a9b09b39",
                                "text": "Dimitri Leue en Bruno Vanden Broecke als clownsduo: dat klinkt al op voorhand als de hit van het jaar."
                            }
                        ]
                    }
