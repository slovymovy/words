                        "glosses": [
                            "Socially disorganized, disoriented or alienated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf4290df-cb05-42c3-b049-3a088cf6162c",
                                "sense_id": "ee35bd45-ccb2-3fb5-9c17-41eab5ca6ef4",
                                "text": "Anglo-Indians (Eurasians) ceased to be counted as a separate category although we know from other evidence that many of that community, beleaguered and anomic as they often felt themselves to be, remained in railroad service (Bear, 2007)."
                            }
                        ]
                    }
                ],
