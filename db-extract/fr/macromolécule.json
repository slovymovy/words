                "forms": [
                    {
                        "form_id": "d6c5d28e-9ea0-40e5-b4e3-59c9fc68c523",
                        "entry_id": "b64e2a4b-897b-3b91-886b-7a50bd470b48",
                        "tags": [
                            "plural"
                        ],
                        "form": "macromolécules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7cb20c6d-0d0f-3185-b163-8c4481e61f1c",
                        "entry_id": "b64e2a4b-897b-3b91-886b-7a50bd470b48",
                        "glosses": [
                            "Molécule de masse moléculaire élevée, généralement constituée par la répétition en grand nombre d’atomes ou de groupes d’atomes, appelés unités constitutives et dérivant de molécules de faible masse moléculaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c8efd65-f842-43e1-87f4-ed593c2d87fb",
                                "sense_id": "7cb20c6d-0d0f-3185-b163-8c4481e61f1c",
                                "text": "Un polymère est en effet une macromolécule obtenue par la répétition d’une unité constitutive, encore appelée unité de répétition, comportant un groupe d’atomes liés par des liaisons covalentes."
                            },
                            {
                                "example_id": "afe86257-6e85-4bc6-9165-38f4e29e0762",
                                "sense_id": "7cb20c6d-0d0f-3185-b163-8c4481e61f1c",
                                "text": "Ce qui change, c’est la présence de macromolécules atypiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60c44c73-848d-47da-aa30-2891c458cef8",
                        "source_entry_id": "b64e2a4b-897b-3b91-886b-7a50bd470b48",
                        "source_sense_id": "7cb20c6d-0d0f-3185-b163-8c4481e61f1c",
                        "target_lang_word": "Makromolekül",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Makromolekül",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0cf65c9b-4de1-34f7-905e-b97649ca86cd",
                                        "entry_id": "5a850e8f-5ab6-3583-b68d-eff088ab9b09",
                                        "glosses": [
                                            "Molekül, das aus sehr vielen Atomen besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad086876-8f37-4988-bfec-11d969f398db",
                                                "sense_id": "0cf65c9b-4de1-34f7-905e-b97649ca86cd",
                                                "text": "„Der makroskopischen Anatomie, die ohne optische Hilfsmittel arbeitet, steht die Lupe, Licht-Mikroskop und Elektronenmikroskop einsetzende mikroskopische Anatomie gegenüber, die den Feinbau der Organe, Gewebe und Zellen bis zu den Makromolekülen hinunter erforscht und den Anschluß an die Biochemie knüpft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab892a5d-9c3b-4758-9006-3139a73c1a85",
                        "source_entry_id": "b64e2a4b-897b-3b91-886b-7a50bd470b48",
