                "word": "paraison",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ffc1f3fa-e8a2-4fbd-8350-7d709f2ac9af",
                        "entry_id": "36d07a9d-98ce-3c32-948b-a64c2f10f4cb",
                        "tags": [
                            "plural"
