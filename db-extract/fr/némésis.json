            {
                "entry_id": "98e0be44-bd40-3e15-8f45-06be24232be9",
                "word": "Némésis",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2e5ec6e6-2f84-3242-a9ec-516e273ec12f",
                        "entry_id": "98e0be44-bd40-3e15-8f45-06be24232be9",
                        "glosses": [
                            "Déesse grecque de la vengeance, plus particulièrement la vengeance divine, considérée comme une océanide par certains auteurs."
                        ],
                        "tags": [
                            "Divinité"
                        ],
                        "examples": [
                            {
                                "example_id": "5fba232e-a04f-4335-8525-a5d6632edbfa",
                                "sense_id": "2e5ec6e6-2f84-3242-a9ec-516e273ec12f",
                                "text": "La Grande Némésis, déesse de la juste colère, entendit sa plainte et l’exauça !"
                            },
                            {
                                "example_id": "0998fd6f-4fb8-4e30-bda8-82638d72cc0f",
                                "sense_id": "2e5ec6e6-2f84-3242-a9ec-516e273ec12f",
                                "text": "Si la venue d’étrangers était la Némésis souvent décrite, comment des pays comme l’Amérique ou l’Australie auraient-ils pu bâtir leur prospérité ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "6dcbd175-67b0-34b4-b134-2193901b3122",
                        "entry_id": "98e0be44-bd40-3e15-8f45-06be24232be9",
                        "glosses": [
                            "Nom d’une étoile hypothétique qui formerait une étoile double avec le Soleil."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7f809d2-a42c-4af6-8ceb-d8cd4c2762c9",
                        "source_entry_id": "98e0be44-bd40-3e15-8f45-06be24232be9",
                        "target_lang_word": "Nemesis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nemesis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ca94096-1546-3967-8224-8bcc5091eac2",
                                        "entry_id": "7b5bc06e-562e-37c7-9940-cad5a7f9bda1",
                                        "glosses": [
                                            "Göttin in der griechischen Mythologie: „Göttin des Gleichmaßes und der ausgleichenden Gerechtigkeit“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82dd959c-03b0-4d0a-b1fd-a90820f07abf",
                                                "sense_id": "0ca94096-1546-3967-8224-8bcc5091eac2",
                                                "text": "„Noch lässt der literarische Niederschlag der neotragischen Nemesis auf sich warten, aber bekanntlich beginnen die Eulen der Minerva erst in der Dämmerung ihren Flug. “"
                                            },
                                            {
                                                "example_id": "e5ab3f7c-5879-41e0-9686-9f07b72a450c",
                                                "sense_id": "0ca94096-1546-3967-8224-8bcc5091eac2",
                                                "text": "„In der Pause kam es schließlich zur Konfrontation mit unserer Nemesis Tatiana, sie war die Herrscherin des Schulhofs wie Shakespeares Feenkönigin, von der sie nur wenige Buchstaben trennten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1708d5f4-fe73-3638-a8e9-38f3946a3fa1",
                                        "entry_id": "7b5bc06e-562e-37c7-9940-cad5a7f9bda1",
                                        "glosses": [
                                            "ausgleichende Gerechtigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7a4b63e-5410-43a0-8b42-406d0b393943",
                                                "sense_id": "1708d5f4-fe73-3638-a8e9-38f3946a3fa1",
                                                "text": "„Und dann, mit triefenden Augen und klappernden Zähnen, ganz und gar nicht das Bild eines Mannes, dessen Nemesis nicht mehr existiert und der endlich wieder sein eigener Herr und Meister ist, wandte ich mit um zu Susan, die noch immer auf dem Stuhl saß, in ihrem Mantel zusammengekauert und, wie ich betroffen feststellte, noch immer so hilflos wie an dem Tag, als ich sie kennengelernt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
