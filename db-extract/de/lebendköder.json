                        "glosses": [
                            "Tier, das lebendig als Köder verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "462981d7-0989-4323-a713-14d0fc86a9bc",
                                "sense_id": "53dc490d-882f-3b78-afea-20f8a37724f0",
                                "text": "„Das Fischen mit Angelleine und Lebendköder hat auf den Malediven Tradition und wird auch heute noch fast ausschließlich betrieben.“"
                            },
                            {
                                "example_id": "4d92c96e-f2e9-4400-a7cd-970bd1259aaf",
                                "sense_id": "53dc490d-882f-3b78-afea-20f8a37724f0",
                                "text": "„Wegen der raschen Vermehrung sind sie als Lebendköder beim Angeln auf Hecht und Zander gebräuchlich und werden von Fischern so in neue Gewässer eingeschleppt.“"
                            }
                        ],
