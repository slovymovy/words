{
    "word_family": [
        "definition",
        "definitive",
        "definitely",
        "definable",
        "indefinite",
        "redefine",
        "undefined"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "47567b43-d6db-3946-bbf0-7bb86e2830b9",
                    "sense_definition": "To state or explain the precise meaning of a word, phrase, or concept.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher asked the student to <w>define</w> the difficult word for the class.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил ученика <w>дать определение</w> сложному слову перед классом.",
                                "zh": "老师让学生为全班同学<w>定义</w>那个生词。"
                            }
                        },
                        {
                            "text": "Dictionaries <w>define</w> words so that we can understand them clearly.",
                            "target_lang_translations": {
                                "ru": "Словари <w>определяют</w> значения слов, чтобы мы могли ясно их понимать.",
                                "zh": "词典<w>定义</w>词汇，以便我们能清楚地理解它们。"
                            }
                        }
                    ],
                    "synonyms": [
                        "explain",
                        "interpret",
                        "describe"
                    ],
                    "common_phrases": [
                        "define a word",
                        "define the term",
                        "clearly define"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать точное объяснение значения слова, фразы или понятия.",
                        "zh": "说明或解释词语、短语或概念的确切含义。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определять",
                                "target_lang_sense_clarification": "раскрывать значение"
                            },
                            {
                                "target_lang_word": "давать определение",
                                "target_lang_sense_clarification": "формулировать значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "定义",
                                "target_lang_sense_clarification": "阐明含义"
                            },
                            {
                                "target_lang_word": "解释",
                                "target_lang_sense_clarification": "说明意思"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1de6ca78-ddc1-37a6-97bd-b615c1bf32a2",
                    "sense_definition": "To show or describe the essential character or nature of someone or something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your past mistakes do not <w>define</w> who you are today.",
                            "target_lang_translations": {
                                "ru": "Твои прошлые ошибки не <w>определяют</w>, кто ты есть сегодня.",
                                "zh": "你过去的错误并不能<w>定义</w>今天的你。"
                            }
                        },
                        {
                            "text": "This single moment of bravery will <w>define</w> his career forever.",
                            "target_lang_translations": {
                                "ru": "Этот единственный момент храбрости навсегда <w>определит</w> его карьеру.",
                                "zh": "这一个勇敢的瞬间将永远<w>定义</w>他的职业生涯。"
                            }
                        }
                    ],
                    "synonyms": [
                        "characterize"
                    ],
                    "common_phrases": [
                        "define yourself",
                        "define a generation",
                        "define who you are"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскрывать или описывать сущность или характер кого-либо или чего-либо.",
                        "zh": "揭示或描述某人或某事物的本质或特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определять",
                                "target_lang_sense_clarification": "обуславливать сущность"
                            },
                            {
                                "target_lang_word": "характеризовать",
                                "target_lang_sense_clarification": "описывать свойства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "决定",
                                "target_lang_sense_clarification": "起决定性作用"
                            },
                            {
                                "target_lang_word": "刻画",
                                "target_lang_sense_clarification": "描述特征"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79221f1d-0a91-39e6-bacc-efb226916b5c",
                    "sense_definition": "To establish or mark the limits, scope, or boundaries of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "boundaries",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>define</w> the scope of the project before we start working.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>определить</w> масштаб проекта, прежде чем мы начнем работать.",
                                "zh": "在开始工作之前，我们需要<w>确定</w>项目的范围。"
                            }
                        },
                        {
                            "text": "The river <w>defines</w> the border between the two neighboring countries.",
                            "target_lang_translations": {
                                "ru": "Река <w>обозначает</w> границу между двумя соседними странами.",
                                "zh": "这条河<w>划定</w>了两个邻国之间的边界。"
                            }
                        }
                    ],
                    "synonyms": [
                        "delimit",
                        "demarcate",
                        "outline"
                    ],
                    "common_phrases": [
                        "define the boundaries",
                        "define the scope",
                        "define limits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устанавливать или обозначать пределы, рамки или границы чего-либо.",
                        "zh": "建立或标明某事物的范围、界限或边界。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "определять",
                                "target_lang_sense_clarification": "устанавливать границы"
                            },
                            {
                                "target_lang_word": "обозначать",
                                "target_lang_sense_clarification": "помечать пределы"
                            },
                            {
                                "target_lang_word": "устанавливать",
                                "target_lang_sense_clarification": "назначать рамки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "确定",
                                "target_lang_sense_clarification": "设定范围"
                            },
                            {
                                "target_lang_word": "划定",
                                "target_lang_sense_clarification": "标明边界"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66a4713c-0f11-3a00-a814-df02d5f0f6a0",
                    "sense_definition": "To show the shape, form, or outline of something clearly and distinctly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "visual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright lamp light <w>defined</w> her silhouette against the dark wall.",
                            "target_lang_translations": {
                                "ru": "Яркий свет лампы четко <w>очертил</w> её силуэт на фоне темной стены.",
                                "zh": "明亮的灯光在暗墙上<w>勾勒</w>出了她的剪影。"
                            }
                        },
                        {
                            "text": "Years of physical training helped to <w>define</w> his muscles.",
                            "target_lang_translations": {
                                "ru": "Годы физических тренировок помогли <w>прорисовать</w> его мышцы.",
                                "zh": "多年的体育锻炼帮助他<w>凸显</w>了肌肉线条。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outline"
                    ],
                    "antonyms": [
                        "blur",
                        "obscure"
                    ],
                    "common_phrases": [
                        "well-defined"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ясно и отчетливо показывать форму, очертания или контуры чего-либо.",
                        "zh": "清晰且明确地显示某事物的形状、轮廓或外形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очерчивать",
                                "target_lang_sense_clarification": "выделять контур"
                            },
                            {
                                "target_lang_word": "вырисовывать",
                                "target_lang_sense_clarification": "делать отчетливым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勾勒",
                                "target_lang_sense_clarification": "描绘轮廓"
                            },
                            {
                                "target_lang_word": "凸显",
                                "target_lang_sense_clarification": "使轮廓清晰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "508f6cf6-5274-39a5-81a1-c3b1387c649d",
                    "sense_definition": "To settle or decide an argument or conflict.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "settle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient king sought to <w>define</w> the dispute between the two nobles.",
                            "target_lang_translations": {
                                "ru": "Древний король стремился <w>разрешить</w> спор между двумя дворянами.",
                                "zh": "古代国王试图<w>解决</w>两位贵族之间的争端。"
                            }
                        },
                        {
                            "text": "They gathered on the field to <w>define</w> the challenge through combat.",
                            "target_lang_translations": {
                                "ru": "Они собрались на поле, чтобы <w>решить</w> спор поединком.",
                                "zh": "他们聚集在场地上，试图通过战斗来<w>裁决</w>这场挑战。"
                            }
                        }
                    ],
                    "synonyms": [
                        "settle",
                        "resolve",
                        "decide"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Улаживать или решать спор или конфликт.",
                        "zh": "解决或平息争端或冲突。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрешать",
                                "target_lang_sense_clarification": "улаживать конфликт"
                            },
                            {
                                "target_lang_word": "решать",
                                "target_lang_sense_clarification": "принимать решение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "解决",
                                "target_lang_sense_clarification": "平息争端"
                            },
                            {
                                "target_lang_word": "裁决",
                                "target_lang_sense_clarification": "决定胜负"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0aeb093e-49ba-33e8-a3a6-1103cd5fae63",
                    "sense_definition": "A command in computer code that replaces a specific text string with another value.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer used a <w>define</w> to set the constant value for the array size.",
                            "target_lang_translations": {
                                "ru": "Программист использовал <w>директиву define</w>, чтобы задать постоянное значение для размера массива.",
                                "zh": "程序员使用了一个<w>宏</w>来设定数组大小的常量值。"
                            }
                        },
                        {
                            "text": "Using too many complex <w>defines</w> can make the source code difficult to read.",
                            "target_lang_translations": {
                                "ru": "Использование слишком большого количества сложных <w>макросов</w> может затруднить чтение исходного кода.",
                                "zh": "使用过多的复杂<w>宏</w>会使源代码难以阅读。"
                            }
                        }
                    ],
                    "synonyms": [
                        "macro"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical (computing)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Команда в программном коде, заменяющая определенную текстовую строку другим значением.",
                        "zh": "计算机代码中的一种指令，用于将特定的文本字符串替换为另一个值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "макрос",
                                "target_lang_sense_clarification": "программная подстановка"
                            },
                            {
                                "target_lang_word": "директива define",
                                "target_lang_sense_clarification": "термин программирования"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宏",
                                "target_lang_sense_clarification": "程序替换指令"
                            },
                            {
                                "target_lang_word": "定义指令",
                                "target_lang_sense_clarification": "编程术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}