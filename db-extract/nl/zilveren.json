                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01f838ab-8f08-3a14-86dd-aa9d17a72eaa",
                                        "entry_id": "b4ec4e71-cd5e-3117-8695-f062bcd331a6",
                                        "glosses": [
                                            "Anything resembling silver; something shiny and white."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f82f7e24-a819-45d4-90b7-7f2f8aff2f28",
                                                "sense_id": "01f838ab-8f08-3a14-86dd-aa9d17a72eaa",
                                                "text": "And next morning they found him dead, with his neck broken, in the bottom of the stone pit, with his beautiful clothes a little bloody, and foul and stained with the duckweed from the pond. But his face was a face of such happiness that, had you seen it, you would have understood indeed how that he had died happy, never knowing that cool and streaming silver for the duckweed in the pond."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "silver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf371af6-88ad-33eb-ada9-f4df0adc1e34",
                                        "entry_id": "db175ae8-27d6-30ff-b46b-f9799647248a",
                                        "glosses": [
                                            "Made from silver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a5387d6-5eba-4daf-b961-dc75faf084d0",
                                                "sense_id": "cf371af6-88ad-33eb-ada9-f4df0adc1e34",
                                                "text": "He looked round the poor room, at the distempered walls, and the bad engravings in meretricious frames, the crinkly paper and wax flowers on the chiffonier; and he thought of a room like Father Bryan's, with panelling, with cut glass, with tulips in silver pots, such a room as he had hoped to have for his own."
                                            },
                                            {
                                                "example_id": "6cf5c415-16f5-4c05-94ce-1f70bad77e58",
                                                "sense_id": "cf371af6-88ad-33eb-ada9-f4df0adc1e34",
                                                "text": "But Richmond[…]appeared to lose himself in his own reflections. Some pickled crab, which he had not touched, had been removed with a damson pie; and his sister saw, peeping around the massive silver epergne that almost obscured him from her view, that he had eaten no more than a spoonful of that either."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2260a27-1821-321d-9a6e-115e78a67f2a",
                                        "entry_id": "db175ae8-27d6-30ff-b46b-f9799647248a",
                                        "glosses": [
                                            "Made from another white metal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a46d49e5-ba03-3eef-a60b-3c26e9d391cb",
                                        "entry_id": "db175ae8-27d6-30ff-b46b-f9799647248a",
                                        "glosses": [
                                            "Having a color like silver: a shiny gray."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8dde442e-d3f0-30f9-983b-7e7442a99db2",
                                        "entry_id": "db175ae8-27d6-30ff-b46b-f9799647248a",
                                        "glosses": [
                                            "Denoting the twenty-fifth anniversary, especially of a wedding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a1f38d7-1ab4-4e86-9201-14982f84ec4c",
                                                "sense_id": "8dde442e-d3f0-30f9-983b-7e7442a99db2",
                                                "text": "Mostly, these have been relationships of 10 or less years. However, one respondent has celebrated her silver wedding anniversary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1ce3f6d-e047-37ca-9a31-55958c0445ff",
                                        "entry_id": "db175ae8-27d6-30ff-b46b-f9799647248a",
