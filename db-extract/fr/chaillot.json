                                "example_id": "478b77bc-bdfc-4f05-8741-69fb305f197e",
                                "sense_id": "cc8dcb66-ab89-389b-9075-42903e2c21b4",
                                "text": "La Folle de Chaillot est une pièce de théâtre de Jean Giraudoux."
                            },
                            {
                                "example_id": "50bd6065-6652-415e-95b3-d76646d31314",
                                "sense_id": "cc8dcb66-ab89-389b-9075-42903e2c21b4",
                                "text": "« Promenez-vous, lui disait-on, mercredi prochain, de six à sept heures du soir, sur la route de Chaillot, et regardez avec soin dans les carosses qui passeront."
                            },
                            {
                                "example_id": "30fca420-1425-492c-a2e2-c9a62de59bdc",
                                "sense_id": "cc8dcb66-ab89-389b-9075-42903e2c21b4",
                                "text": "Entrer dans les profondeurs du George-V, c’est descendre dans les anciennes carrières du village de Chaillot d’où fut extraite la pierre qui servit à édifier l’Arc de Triomphe."
                            }
                        ]
                    }
