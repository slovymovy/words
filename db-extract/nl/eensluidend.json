                "senses": [
                    {
                        "sense_id": "72efee10-f144-34d7-a42e-cf7bb0d77880",
                        "entry_id": "5e8369e7-178a-3f60-92fa-73bc954a7374",
                        "glosses": [
                            "een gelijke inhoud hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "420661cf-19d0-437b-80e4-e17e3f1ea19d",
                                "sense_id": "72efee10-f144-34d7-a42e-cf7bb0d77880",
                                "text": "Vrijdagmiddag signeerde hij bij een boekhandel in de Leidsestraat en ’s avonds laat haalde Baldwin in de Koninklijke Schouwburg in Den Haag samen met de toegejuichte Claudia McNeil en haar collega’s een langdurig applaus. De recensies waren eensluidend: een intrigerend beeld van negers, maar toch een zwak stuk rond een magistrale hoofdrolspeelster. Ben Stroman noemde The Amen Corner in het Algemeen Handelsblad een „brok zuiver volkstoneel” en vergeleek „het sektarische negerkerkje” in „de negerachterbuurt Harlem” met de sekte van „onze Lou de Palingboer”."
                            },
                            {
                                "example_id": "093a7614-78b1-42fd-a1bb-15db07cf6d64",
                                "sense_id": "72efee10-f144-34d7-a42e-cf7bb0d77880",
                                "text": "Zo moeilijk het de achterliggende maanden voor actievoerende studenten was om duidelijk te maken waarom het hun precies te doen was, zo moeilijk is het voor de Haagse politiek om een eensluidend antwoord op het protest te formuleren. Studenten en personeel moeten meer zeggenschap krijgen - daarover zijn de meeste partijen het wel zo'n beetje eens. Maar de partijen verschillen van mening over de vraag waarmee studenten en docenten zich precies zouden moeten bemoeien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f43d758c-3ad3-4181-b557-ed10b13ac7cb",
                        "source_entry_id": "5e8369e7-178a-3f60-92fa-73bc954a7374",
                        "source_sense_id": "72efee10-f144-34d7-a42e-cf7bb0d77880",
                        "source_sense_description": "een gelijke inhoud hebbend",
                        "target_lang_word": "identical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "identical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "573f9f14-39d1-3100-82e1-de05065eae8d",
                                        "entry_id": "a667eed7-e82f-36b1-9f44-68dd7e73991a",
                                        "glosses": [
                                            "Bearing full likeness by having precisely the same set of characteristics; indistinguishable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "759e9153-eea3-4ea4-bd8f-5b0c0610aebc",
                                                "sense_id": "573f9f14-39d1-3100-82e1-de05065eae8d",
                                                "text": "My car is identical with the one my mom has just bought."
                                            },
                                            {
                                                "example_id": "5326e85b-522f-43c4-9ff1-86b18a4298cc",
                                                "sense_id": "573f9f14-39d1-3100-82e1-de05065eae8d",
                                                "text": "By this means as many absolutely identical plates can be produced as may be required, and being hardened they will yield a very large number of prints without any appreciable deterioration."
                                            },
                                            {
                                                "example_id": "9187ea5b-60b0-4298-9a91-6b5ad54fa580",
                                                "sense_id": "573f9f14-39d1-3100-82e1-de05065eae8d",
                                                "text": "For example, assume that 10000 identical chairs were produced through incurring the following costs:..."
                                            },
                                            {
                                                "example_id": "ea4b9050-c9ee-4211-87f5-e6591d576627",
                                                "sense_id": "573f9f14-39d1-3100-82e1-de05065eae8d",
                                                "text": "The zygote soon divides into two identical cells."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1eb89ac2-445e-3e13-a484-11dc1696c7a6",
                                        "entry_id": "a667eed7-e82f-36b1-9f44-68dd7e73991a",
                                        "glosses": [
                                            "Not different or other; not another or others; not different as regards self; selfsame; numerically identical."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7c9cfa8-0c65-4140-a95f-6e354d23dbc8",
                                                "sense_id": "1eb89ac2-445e-3e13-a484-11dc1696c7a6",
                                                "text": "The best of the joke, too, is, that the very coal-merchant who is loudest in his complaints against the person who defrauded him, is the identical man who sat in the centre of the very front row of the pit last night and laughed the most boisterously at this very same thing,--and not so well done either."
                                            },
                                            {
                                                "example_id": "fca45437-26f7-4d7e-b5d2-8deec64ea094",
                                                "sense_id": "1eb89ac2-445e-3e13-a484-11dc1696c7a6",
                                                "text": "These men were grandsons of a certain Guntram, who, according to some authorities, is identical with a Count Guntram who flourished during the reign of the emperor Otto the Great, and whose ancestry can be traced back to the time of the Merovingian kings."
                                            },
                                            {
                                                "example_id": "7accd01e-b67f-4342-8232-6943c5888b59",
                                                "sense_id": "1eb89ac2-445e-3e13-a484-11dc1696c7a6",
                                                "text": "Nor could I myself look upon this man without some emotion, for he seemed to be the identical person who had picked up the ragged tunic in the lonely wood, and, as a matter of fact, he was!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20ef3dd6-c674-3546-87bc-88cb1b907aa3",
                                        "entry_id": "a667eed7-e82f-36b1-9f44-68dd7e73991a",
                                        "glosses": [
                                            "Of twins, sharing the same genetic code."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6abf9f80-0ac3-3823-a6de-a2acddc1df33",
                                        "entry_id": "a667eed7-e82f-36b1-9f44-68dd7e73991a",
                                        "glosses": [
                                            "Exactly equivalent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6710685a-7a54-36e2-b4ee-72ae4e5df4af",
                                        "entry_id": "a667eed7-e82f-36b1-9f44-68dd7e73991a",
                                        "glosses": [
                                            "Approximating or approaching exact equivalence."
                                        ],
                                        "tags": [
                                            "comparable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c0e825-095c-4cab-af97-3a8e2b84cb32",
                                                "sense_id": "6710685a-7a54-36e2-b4ee-72ae4e5df4af",
                                                "text": "The terms of Article 8th are still more identical."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "identical",
