                    "frequency": "High",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le président a posé un geste <w>symbolique</w> en plantant un arbre de la paix."
                        },
                        {
                            "text": "Cette victoire importante a une portée <w>symbolique</w> majeure pour toute la communauté."
                        }
