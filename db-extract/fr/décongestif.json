                        "entry_id": "3061e9f8-eba1-36d9-89c5-aa2f52f0ea79",
                        "glosses": [
                            "Qui lutte contre la congestion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a31d457-236d-4d88-941d-47e932d2117a",
                                "sense_id": "d4e64be2-0968-39c7-a256-91d7d8668781",
                                "text": "Dans l’œdème du poumon elle [= la saignée] exerce son double rôle décongestif et antitoxique."
                            },
                            {
                                "example_id": "6c32f473-57ba-4c79-a1e7-5d553452356c",
                                "sense_id": "d4e64be2-0968-39c7-a256-91d7d8668781",
                                "text": "Il n’est pas douteux qu’en raison de ses propriétés vaso-constrictives l’émétine est douée d'un pouvoir décongestif …."
                            },
                            {
                                "example_id": "916e30c6-6add-488e-9fe2-d1214a57c4c4",
                                "sense_id": "d4e64be2-0968-39c7-a256-91d7d8668781",
                                "text": "D’autres effets de cette plante médicinale ont été rapportés: anti-inflammatoire, antispasmodique, antibactérien, décongestif et antitumoral."
                            }
                        ]
                    }
                ],
