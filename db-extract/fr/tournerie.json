                ],
                "senses": [
                    {
                        "sense_id": "86df5ad2-cfcc-355e-b7f4-7d405ea1589d",
                        "entry_id": "f7d59a64-af2c-3a41-8d67-808c78f690e4",
                        "glosses": [
                            "Atelier où l’on tourne le bois, le marbre."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "45fab251-46d7-377d-8ea6-5c8be1f3732f",
                        "entry_id": "f7d59a64-af2c-3a41-8d67-808c78f690e4",
                        "glosses": [
                            "Industrie du tournage du bois."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "00dcc96b-b7ed-4d43-a234-24f24bf8878e",
                                "sense_id": "45fab251-46d7-377d-8ea6-5c8be1f3732f",
                                "text": "De petites industries comme celles de saboterie et de la tonnellerie continuent leur déclin. La tournerie n'est pas très brillante et de nombreux petits emplois du bois (porte-manteaux, sèche-serviettes, tableaux d'appareillage électrique, jouets, canettes, bobines, etc...) disparaissent progressivement au profit des matières plastiques."
                            },
                            {
                                "example_id": "97f56a79-fc25-4bb8-af5a-a5f1c7e7afed",
                                "sense_id": "45fab251-46d7-377d-8ea6-5c8be1f3732f",
                                "text": "— Le service que tu pourrais nous rendre, dit le père, c’est de nous faire apporter quelques sacs de bois, si un jour tu as un camion qui monte dans la montagne. Dans les tourneries, ça doit encore se trouver, des déchets de scie."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd0f0b54-681b-3002-b168-2269f651a345",
                        "entry_id": "f7d59a64-af2c-3a41-8d67-808c78f690e4",
                        "glosses": [
                            "Séquence mélodique, harmonique ou rythmique, se répétant en boucle dans une œuvre musicale."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2d2ed618-0e73-3570-98f1-3d9a311e5343",
                        "entry_id": "f7d59a64-af2c-3a41-8d67-808c78f690e4",
                        "glosses": [
                            "Grille d’accords comportant peu de mesures et peu d’accords."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba309699-0e14-4e27-a570-83aaa545f765",
                        "source_entry_id": "f7d59a64-af2c-3a41-8d67-808c78f690e4",
                        "source_sense_id": "86df5ad2-cfcc-355e-b7f4-7d405ea1589d",
