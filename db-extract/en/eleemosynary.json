    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "bfaa0c55-4ef4-3f26-828f-56ae74ea6414",
                "word": "eleemosynary",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ef192e0f-43a0-48b6-8b94-d4c3e8c7ed42",
                        "entry_id": "bfaa0c55-4ef4-3f26-828f-56ae74ea6414",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more eleemosynary"
                    },
                    {
                        "form_id": "d96b16ba-e1b7-4c5a-b820-8d63fba883d7",
                        "entry_id": "bfaa0c55-4ef4-3f26-828f-56ae74ea6414",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most eleemosynary"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dbb277f6-d3bf-33ef-86a2-3f6321ea73fa",
                        "entry_id": "bfaa0c55-4ef4-3f26-828f-56ae74ea6414",
                        "glosses": [
                            "Relating to charity, alms, or almsgiving."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d892bf8-8c10-44ec-a404-3e69e6a2b582",
                                "sense_id": "dbb277f6-d3bf-33ef-86a2-3f6321ea73fa",
                                "text": "I am bound to say he didn't criticise his benefactors, though practically he got tired of them; she, however, had the highest standards about eleemosynary forms."
                            },
                            {
                                "example_id": "56bc7eaf-467d-4067-9302-0280364a4be0",
                                "sense_id": "dbb277f6-d3bf-33ef-86a2-3f6321ea73fa",
                                "text": "He did some work for the New York Public Library . . . and also dabbled in eleemosynary science for the Russell Sage Foundation."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2cb89a3-dd6f-3bc4-9c69-5920deeccece",
                        "entry_id": "bfaa0c55-4ef4-3f26-828f-56ae74ea6414",
                        "glosses": [
                            "Given in charity or alms; having the nature of alms"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c08f84b-89b3-47fb-ade1-fb4718683a4f",
                                "sense_id": "c2cb89a3-dd6f-3bc4-9c69-5920deeccece",
                                "text": "An author ought to consider himself, not as a gentleman who gives a private or eleemosynary treat, but rather as one who keeps a public ordinary, at which all persons are welcome for their money."
                            },
                            {
                                "example_id": "d1dd32ee-2382-4f3a-80d5-1d595dc3061f",
                                "sense_id": "c2cb89a3-dd6f-3bc4-9c69-5920deeccece",
                                "text": "His spirited refusal of an eleemosynary supply of shoes, arose, no doubt, from a proper pride."
                            },
                            {
                                "example_id": "53ed8c43-4a74-4637-98f5-7100dee0c4c8",
                                "sense_id": "c2cb89a3-dd6f-3bc4-9c69-5920deeccece",
                                "text": "Crouch low thy neck to eleemosynary gifts."
                            }
                        ]
                    },
                    {
                        "sense_id": "13acb130-bb60-3751-97f9-b4212913cce1",
                        "entry_id": "bfaa0c55-4ef4-3f26-828f-56ae74ea6414",
                        "glosses": [
                            "Supported by charity"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f9406dd-0c24-45ce-9ca7-f10fae68ad8c",
                                "sense_id": "13acb130-bb60-3751-97f9-b4212913cce1",
                                "text": "... it is also true that the policy of nations, or the bounty of individuals, formerly did much to counteract the effect of this limitation of competition, by offering eleemosynary instruction to a much larger class of persons than could have obtained the same advantages by paying their price."
                            },
                            {
                                "example_id": "1431d3aa-0133-4dcc-bcb2-8c08e63c3d28",
                                "sense_id": "13acb130-bb60-3751-97f9-b4212913cce1",
                                "text": "[The Sixteenth Amendment to the United States Constitution] set the State up as the largest eleemosynary institution in the history of the world."
                            },
                            {
                                "example_id": "cad50881-e6c4-4253-b7d4-4429f38dc0e4",
                                "sense_id": "13acb130-bb60-3751-97f9-b4212913cce1",
                                "text": "Amidst all this, the legal business, the acquiring of land, the construction of the Montgomery Block, Billings had generosity and time to support the founding of the University of California and a half dozen churches, schools, orphan asylums and other eleemosynary institutions."
                            }
                        ]
                    }
                ],
