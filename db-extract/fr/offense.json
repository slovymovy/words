                "senses": [
                    {
                        "sense_id": "60f930be-73b3-3d66-9fd0-13752d09a883",
                        "entry_id": "d6db5227-9990-33d1-904e-34f42836a49e",
                        "glosses": [
                            "Injure de fait ou de parole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6fb8380-bb19-4c59-909c-0bfe6dd60660",
                                "sense_id": "60f930be-73b3-3d66-9fd0-13752d09a883",
                                "text": "Elle n’avait jamais franchi la porte close de l’indécence car ses parents la répudieraient pour cette offense."
                            },
                            {
                                "example_id": "689b4b95-405a-4507-93ac-41544e7071fc",
                                "sense_id": "60f930be-73b3-3d66-9fd0-13752d09a883",
                                "text": "Il m’a fait une offense irréparable."
                            },
                            {
                                "example_id": "ed110b5d-a394-41f0-a0f2-1a21fed6826a",
                                "sense_id": "60f930be-73b3-3d66-9fd0-13752d09a883",
                                "text": "Subir une offense."
                            },
                            {
                                "example_id": "31bfb477-cc6b-4919-bf46-3f442fe4a9f5",
                                "sense_id": "60f930be-73b3-3d66-9fd0-13752d09a883",
                                "text": "Demander réparation d’une offense."
                            },
                            {
                                "example_id": "894f82c8-abb7-48da-b5f8-d82e173bc9a1",
                                "sense_id": "60f930be-73b3-3d66-9fd0-13752d09a883",
                                "text": "Oublier, pardonner les offenses."
                            },
                            {
                                "example_id": "eb35472f-7ccd-4ab1-936b-ac24676a2c24",
                                "sense_id": "60f930be-73b3-3d66-9fd0-13752d09a883",
                                "text": "Il ne se souvient point des offenses qu’il a reçues."
                            },
                            {
                                "example_id": "d08ac636-b36d-4ab2-ba40-3c5cf1d8bdf9",
                                "sense_id": "60f930be-73b3-3d66-9fd0-13752d09a883",
                                "text": "Venger une offense."
                            },
                            {
                                "example_id": "720ba190-94ca-4f32-a13a-8fd5a914f62b",
                                "sense_id": "60f930be-73b3-3d66-9fd0-13752d09a883",
                                "text": "Soit dit sans offense, Permettez de dire sans vouloir offenser."
                            }
                        ]
                    },
                    {
