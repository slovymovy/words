                        "examples": [
                            {
                                "example_id": "ad516fd5-fae0-4933-aa94-ae918af2d395",
                                "sense_id": "c6cfae0e-0be0-38b9-b47b-c3b9e24bacbe",
                                "text": "De man was alleen in de woning. Hij is meegenomen voor verhoor. Alle bewoners van de Acacialaan in Putten mochten rond 01.30 uur terug naar huis."
                            },
                            {
                                "example_id": "64b9c698-57e7-4b4d-96c6-aed5dd45e078",
                                "sense_id": "c6cfae0e-0be0-38b9-b47b-c3b9e24bacbe",
                                "text": "In Kraainem is dinsdagnamiddag een man overleden nadat hij op de Acacialaan was aangereden. Dat meldt RingTV en het parket Halle-Vilvoorde bevestigt het nieuws woensdag."
                            }
                        ]
