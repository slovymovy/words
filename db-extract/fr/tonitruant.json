                    {
                        "form_id": "ec75629e-9214-45e0-8d6c-8ab004feed5b",
                        "entry_id": "e48f1ee4-83af-3878-8b94-c2fb87a0f7b0",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "tonitruantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4fdc0d75-51ce-3823-8b59-7a0faa2f6d27",
                        "entry_id": "e48f1ee4-83af-3878-8b94-c2fb87a0f7b0",
                        "glosses": [
                            "Qui fait un bruit comparable à celui du tonnerre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0b226bf-cf9a-4e93-9568-8ff0b2c91004",
                                "sense_id": "4fdc0d75-51ce-3823-8b59-7a0faa2f6d27",
                                "text": "Le Carcan rentrait des champs ; il fut mis au courant de l’affaire et bientôt mêla son organe tonitruant aux glapissements de sa conjointe."
                            },
                            {
                                "example_id": "d6dc6453-2f12-4c08-8285-06967a1ad529",
                                "sense_id": "4fdc0d75-51ce-3823-8b59-7a0faa2f6d27",
                                "text": "Le châssis grinça encore, puis, dans un crissement horripilant, le levier joua et la roue trembla et retomba dans l'eau dans un fracas tonitruant."
                            }
                        ]
                    },
                    {
                        "sense_id": "53962a10-d0d4-3104-a460-8b87817c9f53",
                        "entry_id": "e48f1ee4-83af-3878-8b94-c2fb87a0f7b0",
                        "glosses": [
                            "Qui occasionne un bruit retentissant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "966b90e1-677a-47c2-8491-415e47a2cfbe",
                                "sense_id": "53962a10-d0d4-3104-a460-8b87817c9f53",
                                "text": "À la vue d'Alger, de l'aéroport Houari Boumédiene, je me décontracte, le voyageur devant aussi, avec un lâcher de pets tonitruants."
                            },
                            {
                                "example_id": "ba68fd5e-ca96-473b-baa1-4a62c2af8056",
                                "sense_id": "53962a10-d0d4-3104-a460-8b87817c9f53",
                                "text": "L’écrivain considère que les parents d’aujourd’hui “n’aiment plus être autoritaires” et que cette attitude a tendance à rendre les enfants “abjects, tonitruants, malpolis et surtout tyranniques”."
                            }
                        ]
                    },
                    {
                        "sense_id": "29565198-61cc-370d-b91b-62e8d1790c2c",
                        "entry_id": "e48f1ee4-83af-3878-8b94-c2fb87a0f7b0",
                        "glosses": [
                            "Dont la voix ou les propos sont retentissants."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "559e3368-86b8-4298-a527-5d2ed4c76608",
                                "sense_id": "29565198-61cc-370d-b91b-62e8d1790c2c",
                                "text": "Au nom de la bien-pensance, des groupes et des partis politiques instillent des interdits qui chamboulent notre démocratie alors que la voix des minorités devient plus tonitruante que celle de la majorité."
                            },
                            {
                                "example_id": "c7049b52-c5cc-44ac-8f77-cda38cc04ab6",
                                "sense_id": "29565198-61cc-370d-b91b-62e8d1790c2c",
                                "text": "Du 9 au 12 janvier, une semaine avant de vider les lieux, il a multiplié les annonces tonitruantes, voire provocatrices, concernant l’Iran, la guerre au Yémen, les relations avec Cuba ou encore avec Taïwan."
                            }
                        ]
                    }
