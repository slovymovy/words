                        "glosses": [
                            "Badelatsche der Marke \\\"Adidas\\"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f02c693-2b36-4946-b327-504b9862d969",
                                "sense_id": "68b594a9-58d6-3fdb-a136-e5356ed89cf6",
                                "text": "\"Exit-Strategie! Fußpflege scheint mir eine vielversprechende Exit-Strategie zu sein. Nicht, weil ich Füße besonders mag. Im Gegenteil. Sondern weil sich völlig unvermittelt ein konsequent unterschätztes Accessoire aus den Untiefen der Fitnessstudiospinde aufmacht, zum nächsten großen Modetrend zu werden: die Adilette.\""
                            },
                            {
                                "example_id": "d4b525a8-0cd3-4a08-bade-76aa9adb22c8",
                                "sense_id": "68b594a9-58d6-3fdb-a136-e5356ed89cf6",
                                "text": "„Meine Ergotherapeutin sah aus wie eine Erleuchtete, ein Medium in Adiletten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
