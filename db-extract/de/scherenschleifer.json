                ],
                "senses": [
                    {
                        "sense_id": "a56d0a94-059f-3c20-ad98-eda807daa665",
                        "entry_id": "97dc6e93-da8d-3d06-8172-c52b2bef00f6",
                        "glosses": [
                            "Person, die beruflich mit geeignetem Gerät Scheren und andere Gerätschaften durch Schleifen schärft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75b28a1d-1fc6-44aa-8821-f720b20704ed",
                                "sense_id": "a56d0a94-059f-3c20-ad98-eda807daa665",
                                "text": "„Noch niemals hatte Laura Leonore einen Scherenschleifer bei der Arbeit gesehen und war fasziniert.“"
                            },
                            {
                                "example_id": "2e0b6d66-4b40-4954-9c7c-6842fa27f91b",
                                "sense_id": "a56d0a94-059f-3c20-ad98-eda807daa665",
                                "text": "„Der Scherenschleifer Rudies traf bei seinen Wanderungen eine Pferdeherde, die nahe Ragnit über den Fluss getrieben wurde.“"
                            },
                            {
                                "example_id": "d5c173fe-f270-4a33-8da9-859bf667b74d",
                                "sense_id": "a56d0a94-059f-3c20-ad98-eda807daa665",
                                "text": "„Später am Morgen, als der Gemüsehändler von dem Ausrufen seiner Waren im Hof heiser geworden, der Bürstenbinder sichtlich betrunken, und der Scherenschleifer aus dem Geschlecht des Lumpengesindels mit seinem Schleifstein von Haustür zu Haustür zog, ging ein Mann durch Kopenhagens Straßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
