                        "examples": [
                            {
                                "example_id": "ce0305a5-687c-45e0-84be-816d34d4ffbc",
                                "sense_id": "d43b62bd-3f4c-3bee-958b-4715553d377d",
                                "text": "Jerry Lewis wordt er geteisterd door opdringende gezichten waaraan geen ontkomen mogelijk is, door een man die onverstoord de sigarenrook in zijn gezicht blaast, door een jonge vrouw met slechte adem, die bobbelgum in zijn gelaat doet uiteenspatten."
                            },
                            {
                                "example_id": "909ec720-e6fb-4cfd-bbcc-45faf9a39d6e",
                                "sense_id": "d43b62bd-3f4c-3bee-958b-4715553d377d",
                                "text": "Bobbelgum schijnt door idealistische fabrikanten bedoeld te zijn, als opwekkende versnapering, die de adem fris houdt en de tanden blank. Dit is theorie, want de attractie zit niet in deze positieve eigenschappen, maar in het onbenullige knalletje, dat in de praktijk de jeugd tot het bobbelgum heeft gedreven."
                            }
                        ]
                    }
