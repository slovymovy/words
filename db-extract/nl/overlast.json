                "entry_id": "79d07a76-d45a-3c09-8fcd-34bc97043d20",
                "word": "overlast",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ed166f31-dbf8-3def-9641-0cfe71417e6b",
                        "entry_id": "79d07a76-d45a-3c09-8fcd-34bc97043d20",
                        "glosses": [
                            "hinder op een onacceptabel niveau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e0664c4-9fdd-4de6-93d3-603d02899289",
                                "sense_id": "ed166f31-dbf8-3def-9641-0cfe71417e6b",
                                "text": "Wateroverlast is een verzamelnaam voor situaties waarin mensen overlast hebben als gevolg van te veel water."
                            },
                            {
                                "example_id": "6e6072dc-1c3c-4ab9-9fb1-67c841d55ebf",
                                "sense_id": "ed166f31-dbf8-3def-9641-0cfe71417e6b",
                                "text": "Geniet nog maar even van de zon vandaag: aan het eind van de middag krijgen Overijssel en Gelderland de volle laag van een onweersstorm. Ook de provincies Brabant en en Limburg liggen in de vuurlinie van zware onweersbuien. ProRail waarschuwt alvast voor overlast doordat bijvoorbeeld omvallende bomen en blikseminslag het treinverkeer verstoren."
                            },
                            {
                                "example_id": "492c0e99-aebd-46ca-bc6b-11f2efd638a2",
                                "sense_id": "ed166f31-dbf8-3def-9641-0cfe71417e6b",
                                "text": "Vandaag wordt bij verschillende Nederlandse vliegvelden gedemonstreerd door mensen die vinden dat de overlast en de vervuiling door de luchtvaart de spuigaten uit loopt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39ab79e6-7a62-48b3-9528-1bf441b27434",
                        "source_entry_id": "79d07a76-d45a-3c09-8fcd-34bc97043d20",
                        "source_sense_id": "ed166f31-dbf8-3def-9641-0cfe71417e6b",
