                "senses": [
                    {
                        "sense_id": "29a96e50-6557-3843-a3c2-cd7d00a750e6",
                        "entry_id": "42052e9e-6b16-3ded-98fe-4bfd28e6d786",
                        "glosses": [
                            "To play a power chord on an electric guitar."
                        ],
                        "tags": [
                            "informal",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "04c86b0b-3dbe-4c4c-b1be-84201bbc951d",
                                "sense_id": "29a96e50-6557-3843-a3c2-cd7d00a750e6",
                                "text": "One of the best moments came during the flashpot blasts in \"Closer to the Heart,\" when the whole crowd came alight, sixteen thousand faces hanging open as Alex, in his fringed monk's robe, kerranged a D-major chord[…]"
                            },
                            {
                                "example_id": "9581e2f7-61ba-44c2-980d-d3c9939507e2",
                                "sense_id": "29a96e50-6557-3843-a3c2-cd7d00a750e6",
                                "text": "Meanwhile, with Brain Stew, Green Day do some serious kerranging on their electric guitars, which they have mixed in with Godzilla vocals (!), to provide a tune of migraine-inducing proportions."
                            },
                            {
                                "example_id": "bab39b1f-0bf0-4378-975c-8dc596025e51",
                                "sense_id": "29a96e50-6557-3843-a3c2-cd7d00a750e6",
                                "text": "[…] he stretched his cordless guitar's reach to the limit (and possibly into the realm of apocrypha) by leaving the building mid-solo, taking a cab to a local radio station, and kerranging all the way up to its fiftieth-floor studio."
                            }
                        ]
                    }
