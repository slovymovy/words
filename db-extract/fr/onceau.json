                            {
                                "target_word": "ounce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9edc47c-db06-3c16-bc64-fa14c965f86f",
                                        "entry_id": "e259463e-3e65-3d7d-aa31-2dd4fd6f88be",
                                        "glosses": [
                                            "A large wild feline, such as a lynx or cougar."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87e53bf2-5ce2-4022-b823-26bf9eccdb91",
                                                "sense_id": "f9edc47c-db06-3c16-bc64-fa14c965f86f",
                                                "text": "The Ounce or the vvilde Cat, is as big as a mungrell dog, this creature is by nature feirce, and more dangerous to bee met vvithall than any other creature, not fearing eyther dogge or man; […]"
                                            },
                                            {
                                                "example_id": "7f3b7660-8043-4b09-984d-260678aa1ff7",
                                                "sense_id": "f9edc47c-db06-3c16-bc64-fa14c965f86f",
                                                "text": "Halloa! another prey,\nThe nimble Antelope!\nThe ounce is freed; one spring,\nAnd his talons are sheath’d in her shoulders,\nAnd his teeth are red in her gore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e499352c-d71c-3daa-8780-45c2d5402ea7",
                                        "entry_id": "e259463e-3e65-3d7d-aa31-2dd4fd6f88be",
                                        "glosses": [
                                            "Synonym of snow leopard, Panthera uncia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21fdd45d-bf5c-3fa5-a584-a9a7788edd73",
                                        "entry_id": "e259463e-3e65-3d7d-aa31-2dd4fd6f88be",
                                        "glosses": [
                                            "Synonym of onza, a particularly aggressive cougar or jaguarundi in Mexican folklore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a1cdfcb-dc23-435d-8adf-5ec7ab37bebf",
                                                "sense_id": "21fdd45d-bf5c-3fa5-a584-a9a7788edd73",
                                                "text": "The ounce, a leopard-like creature, is dreaded for its depredations by the Indians of Brazil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
