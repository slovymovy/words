                        ]
                    },
                    {
                        "translation_id": "e8a6043b-701d-4702-a58c-8f027667cbeb",
                        "source_entry_id": "fc08ddb4-a883-3763-b2b7-f6741e36158d",
                        "source_sense_id": "3e2c4aa6-62a7-3366-8249-2b7dadb202bd",
                        "target_lang_word": "эндокринолог",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "эндокринолог",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b62a7754-a27c-3e0f-9588-5e791b66c47a",
                                        "entry_id": "6ab94a3f-eb08-36b9-9cc7-0c1f397cd60e",
                                        "glosses": [
                                            "врач, специалист в области эндокринологии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e125de0a-64be-4224-882c-471eb7fe0fb3",
                                                "sense_id": "b62a7754-a27c-3e0f-9588-5e791b66c47a",
                                                "text": "При разных заболеваниях щитовидка ведёт себя по-разному. Скажем, при одних ей требуются препараты с йодом, а при других йод категорически противопоказан. Определить это может только врач-эндокринолог после ультразвукового исследования железы и анализа крови на щитовидные гормоны."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
