                "senses": [
                    {
                        "sense_id": "da100126-5f56-35bb-9082-2cbae1079908",
                        "entry_id": "a060fc09-e805-32ff-96df-a51743633361",
                        "glosses": [
                            "der (etwas größere) räumliche Bereich um etwas herum; Umfeld oder Umland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc733847-a1ef-497d-b07c-2447716cb7d8",
                                "sense_id": "da100126-5f56-35bb-9082-2cbae1079908",
                                "text": "„Ein stattlicher Jüngling begleitete sie; er soll bereits ihr Verlobter und der Sohn eines wohlhabenden Fabrikherrn aus der Umgegend sein.“"
                            },
                            {
                                "example_id": "65b25ca8-fc4b-408c-99f3-7836250bd1f6",
                                "sense_id": "da100126-5f56-35bb-9082-2cbae1079908",
                                "text": "„Er kam zu den Kosaken, erkundigte sich, wo er sein dem Korps Platow angehörendes Regiment finden könnte, und gelangte gegen Abend zu seinem Herrn Nikolai Rostow, der in Jankowo im Quartier lag und gerade in den Sattel gestiegen war, um mit Iljin einen Spazierritt durch die Dörfer der Umgegend zu machen.“"
                            },
                            {
                                "example_id": "85c93bfb-183b-4a4f-b440-3aaf6caf610c",
                                "sense_id": "da100126-5f56-35bb-9082-2cbae1079908",
                                "text": "Sie handelten mit Wein aus der Umgegend von Mendoza."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
