                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ephemeralness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "440efb54-b58d-3340-a640-368a11871bbe",
                                        "entry_id": "e3b17f3a-a9fc-3a46-8ce7-1fd1ef339070",
                                        "glosses": [
                                            "The quality of being ephemeral or transitory."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbfda2db-e10c-4b12-aa74-c6bd801e2533",
                                                "sense_id": "440efb54-b58d-3340-a640-368a11871bbe",
                                                "text": "Material culture researchers have often failed to acknowledge the ephemeralness of much of their data."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51b5bc88-dada-4666-8813-b1c6377682f3",
                        "source_entry_id": "40ea4d50-8b57-33fc-81c6-a629a74794d7",
                        "source_sense_id": "4c071621-94cd-38c9-9ade-75eef533429c",
                        "target_lang_word": "evanescence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evanescence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d447966c-c664-3ac7-be8f-d4f3869e2bf4",
                                        "entry_id": "42e335c4-df8e-3640-9463-4737db586241",
                                        "glosses": [
                                            "The act or state of vanishing away; disappearance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4697069f-19c8-4d5e-9e24-427f7e8ec03c",
                                                "sense_id": "d447966c-c664-3ac7-be8f-d4f3869e2bf4",
                                                "text": "We suffer equal pain from the pertinacious adhesion of unwelcome images, as from the evanescence of those which are pleasing and useful"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9131414-1f69-31ee-984f-fb6e03daff7e",
                                        "entry_id": "42e335c4-df8e-3640-9463-4737db586241",
                                        "glosses": [
                                            "The event of fading and gradually vanishing from sight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "609eebac-6023-4e77-be0d-e49227f9c47a",
                                                "sense_id": "e9131414-1f69-31ee-984f-fb6e03daff7e",
                                                "text": "the evanescence of the morning mist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8ac1bba-6b8f-4587-a29a-554d9e74405a",
                        "source_entry_id": "40ea4d50-8b57-33fc-81c6-a629a74794d7",
                        "source_sense_id": "4c071621-94cd-38c9-9ade-75eef533429c",
                        "target_lang_word": "éphémérité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éphémérité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "780b7005-9a65-3344-aaa7-61a91f788739",
                                        "entry_id": "2438501f-6cf3-3ef7-9ed4-80fe64a537fd",
                                        "glosses": [
                                            "Nature, qualité d’être éphémère."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f2ffc93-2ff1-46fa-b108-a517f331e620",
                                                "sense_id": "780b7005-9a65-3344-aaa7-61a91f788739",
                                                "text": "Ceci, ou cette éphémérité du plaisir, est-il la conséquence de l'imperfection de notre forme terrestre et de la grossièreté et du peu d’union des élémens qui la composent ?"
                                            },
                                            {
                                                "example_id": "1c927692-be8e-47fc-833f-372c697daf1c",
                                                "sense_id": "780b7005-9a65-3344-aaa7-61a91f788739",
                                                "text": "Comme l’éphémérité de la constitution de 48 et la longévité de l'institution de Fontevrault confirment triomphalement en mode inverse et en mode direct la formule du gerfaut !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdf05d2f-0eb2-46a4-8dfd-9a090ee5a7b6",
                        "source_entry_id": "40ea4d50-8b57-33fc-81c6-a629a74794d7",
                        "source_sense_id": "4c071621-94cd-38c9-9ade-75eef533429c",
                        "target_lang_word": "éphéméréité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éphéméréité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8976d3b6-0195-30fb-b139-63c9bfbe94bf",
                                        "entry_id": "11f0ba76-73ef-3b05-b0df-99ebff390300",
                                        "glosses": [
                                            "Variante de éphémérité. Caractère de ce qui ne dure pas, de ce qui est éphémère."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f52c559e-a35a-4019-a54d-23871e2a71d5",
                                                "sense_id": "8976d3b6-0195-30fb-b139-63c9bfbe94bf",
                                                "text": "Tout bonheur couvre un malheur ; défions-nous de même de la santé trop florissante, elle ne revêt souvent la fraîcheur de la fleur que pour en prendre aussi l’éphéméréité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "798802dd-e2fc-44ef-981d-8d8fbe3c63bb",
                        "source_entry_id": "40ea4d50-8b57-33fc-81c6-a629a74794d7",
                        "source_sense_id": "4c071621-94cd-38c9-9ade-75eef533429c",
                        "target_lang_word": "Kurzlebigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurzlebigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f4d9f99-a138-3530-a6fe-a1bf25d34bce",
                                        "entry_id": "32681df7-9172-3e1b-8b4b-fc0d155246b6",
                                        "glosses": [
                                            "Eigenschaft, ein kurzes Leben zu haben beziehungsweise nur über einen kurzen Zeitraum zu überdauern oder zu funktionieren"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70e34684-a67c-4d06-ba23-b3e7a06f7633",
                                                "sense_id": "8f4d9f99-a138-3530-a6fe-a1bf25d34bce",
                                                "text": "„Das rasche Wachstum und die schnelle Generationenfolge lassen auf große Kurzlebigkeit dieser Tiere schließen.“"
                                            },
                                            {
                                                "example_id": "2a18f9ec-d448-48b0-8f98-e5a60a0b55c3",
                                                "sense_id": "8f4d9f99-a138-3530-a6fe-a1bf25d34bce",
                                                "text": "„Frühere Versuche, Rotklee im Lockyer Valley (Quensland) anzupflanzen, scheiterten wegen der Kurzlebigkeit der Pflanzen.“"
                                            },
                                            {
                                                "example_id": "05ce50e1-e1e9-448c-ac1f-792bfbdf6aaa",
                                                "sense_id": "8f4d9f99-a138-3530-a6fe-a1bf25d34bce",
                                                "text": "„In dem Moment, in dem mir die Kurzlebigkeit der massenproduzierten Dinge klar wurde, wurden sie für mich zu den neuen Verdammten dieser Erde.“"
                                            },
                                            {
                                                "example_id": "80d0b063-f4d4-4fb4-acc1-f587c6daef8b",
                                                "sense_id": "8f4d9f99-a138-3530-a6fe-a1bf25d34bce",
                                                "text": "„Snapchat nutzt auch den Vorteil, dass, durch die Kurzlebigkeit, Storys verschickt werden, die in anderen Medien niemals verschickt werden würden.“"
                                            },
                                            {
                                                "example_id": "47d6b3c8-bc09-4a32-ba03-9d06be313b40",
                                                "sense_id": "8f4d9f99-a138-3530-a6fe-a1bf25d34bce",
                                                "text": "„Die Kurzlebigkeit von Produkten führt damit in der Regel zu einem Risiko für die Umwelt.“"
                                            },
                                            {
                                                "example_id": "0ac9b094-e8dc-44bd-8bb9-bb5da557ab2b",
                                                "sense_id": "8f4d9f99-a138-3530-a6fe-a1bf25d34bce",
                                                "text": "„Bei aller Kurzlebigkeit digitaler Produkte ist dabei zu berücksichtigen, dass Basiskompetenzen eine erhebliche Lebensdauer aufweisen.“"
                                            },
                                            {
                                                "example_id": "59ec6bc3-2e7f-4d77-9166-05b45d1d697d",
                                                "sense_id": "8f4d9f99-a138-3530-a6fe-a1bf25d34bce",
                                                "text": "„Dies demonstriert die Kurzlebigkeit von Strukturen und Aufbausystemen in Organisationen und Abteilungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8fd07f45-855b-31a1-be65-333ee8e22976",
                                        "entry_id": "32681df7-9172-3e1b-8b4b-fc0d155246b6",
                                        "glosses": [
                                            "etwas, das kurzlebig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f58cade-1328-41aa-9b8c-de7d563b87e6",
                                                "sense_id": "8fd07f45-855b-31a1-be65-333ee8e22976",
                                                "text": "„Nach materiellen Gütern streben, größere und bessere Gebäude bauen, den Segen der Zivilisation verbreiten – warum soll man sich mit solchen Kurzlebigkeiten beschäftigen, wenn nur die geistige Wahrheit ewig andauert?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1b5cfd3-de60-482b-b35a-d1d888f1b6b0",
                        "source_entry_id": "40ea4d50-8b57-33fc-81c6-a629a74794d7",
                        "source_sense_id": "4c071621-94cd-38c9-9ade-75eef533429c",
                        "target_lang_word": "Vergänglichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vergänglichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ec73c25-d6b5-3355-9fcd-29eb2753a593",
                                        "entry_id": "2366b9c5-d367-3379-b678-b3d69a9e9ae4",
                                        "glosses": [
                                            "das nicht ewige Bestehen eines Zustandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d891b95-a87e-4c25-b0be-65a5de6aea4a",
                                                "sense_id": "5ec73c25-d6b5-3355-9fcd-29eb2753a593",
                                                "text": "Die Menschen sind sich ihrer Vergänglichkeit bewusst."
                                            },
                                            {
                                                "example_id": "574bbbce-435d-4d62-b689-c27231b06048",
                                                "sense_id": "5ec73c25-d6b5-3355-9fcd-29eb2753a593",
                                                "text": "„Die meisten Menschen verdrängen die eigene Vergänglichkeit.“"
                                            },
                                            {
                                                "example_id": "8eeec7a3-6a46-4bce-aa35-a7f22d803823",
                                                "sense_id": "5ec73c25-d6b5-3355-9fcd-29eb2753a593",
                                                "text": "„So handeln Witze von der Vergänglichkeit und dem Vergessen in der Veränderung.“"
                                            },
                                            {
                                                "example_id": "20e20947-0a86-4d79-97ef-16ba04a4055e",
                                                "sense_id": "5ec73c25-d6b5-3355-9fcd-29eb2753a593",
                                                "text": "„Der Mensch ist wahrscheinlich das einzige Lebewesen, das sich seiner Vergänglichkeit bewusst ist.“"
                                            },
                                            {
                                                "example_id": "a5675025-adc1-499a-9b39-2170f52d16f5",
                                                "sense_id": "5ec73c25-d6b5-3355-9fcd-29eb2753a593",
                                                "text": "„Ich begann ein Gespräch über die Vergänglichkeit alles Irdischen und hoffte, ihn dadurch melancholisch und weich zu machen.“"
                                            },
                                            {
                                                "example_id": "c9a69ffa-5562-4c27-8cec-042843612bf8",
                                                "sense_id": "5ec73c25-d6b5-3355-9fcd-29eb2753a593",
                                                "text": "„DIE VERGÄNGLICHKEIT ist das Thema von Hans Martin Erhardt, dessen Spätwerk bis 30. Januar im Markgrafenschloss in Emmendingen zu sehen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
