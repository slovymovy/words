                                    {
                                        "sense_id": "e456452c-1233-3ccc-9015-5d09e3a1be14",
                                        "entry_id": "904d8d72-d282-3144-9960-4673fc173ea6",
                                        "glosses": [
                                            "Aufzeichnung aller für bedeutsam gehaltenen Ereignisse"
                                        ],
                                        "tags": [
                                            "urpsrünglich Schifffahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82f6611e-ca22-4516-996f-faf12d03883a",
                                                "sense_id": "e456452c-1233-3ccc-9015-5d09e3a1be14",
                                                "text": "Aus einem Logbuch kann man alle wesentlichen Ereignisse einer Fahrt erfahren."
                                            },
                                            {
                                                "example_id": "6b4fcc30-32c3-4bb2-a968-c531c63365d5",
                                                "sense_id": "e456452c-1233-3ccc-9015-5d09e3a1be14",
                                                "text": "„Ich vermag hier nichts darüber zu sagen, wie unsere Reise verlief, denn ich führte, wie gesagt, kein Logbuch […]“"
                                            },
                                            {
                                                "example_id": "6182634c-f2cd-43bc-b9a1-4786e6eb6646",
                                                "sense_id": "e456452c-1233-3ccc-9015-5d09e3a1be14",
                                                "text": "„Seine Eintragungen im Logbuch entsprachen, was Rechtschreibung und die Zeichensetzung betraf, nicht den Regeln, doch das gilt für viele schriftliche Zeugnisse der damaligen Zeit.“"
                                            },
                                            {
                                                "example_id": "cd9c006f-1ee3-4248-b57e-cc8a8c990af3",
                                                "sense_id": "e456452c-1233-3ccc-9015-5d09e3a1be14",
                                                "text": "„Sein Logbuch aus diesen Tagen liest sich ein wenig wie das von Banks über Tahiti: der übersättigte Bericht eines eingefleischten Salonlöwen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
