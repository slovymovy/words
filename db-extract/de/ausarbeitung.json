                        "entry_id": "6fdb958b-9421-31bf-b8af-d76cd8561412",
                        "glosses": [
                            "ein Schriftstück, welches sich empirisch mit einer Sache auseinandersetzt und diese analysiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "976b4214-db91-4cf2-ae91-c41f14958cb4",
                                "sense_id": "65057a29-2441-3b99-a6f2-f55fb39e00fb",
                                "text": "„Sie fragte sich, wer die Ausarbeitung fertiggestellt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f25918d7-5a49-3010-935b-186d399d01c3",
                        "entry_id": "6fdb958b-9421-31bf-b8af-d76cd8561412",
                        "glosses": [
                            "die Tätigkeit der Entwicklung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0507b5e4-29d9-454c-a9ae-69d53eb82569",
                                "sense_id": "f25918d7-5a49-3010-935b-186d399d01c3",
                                "text": "Die Ausarbeitung einer funktionsfähigen Dampfmaschine war einer der wichtigsten Fortschritte des 19. Jahrhunderts"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
