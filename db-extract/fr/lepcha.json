                    }
                ],
                "translations": [
                    {
                        "translation_id": "c186bc06-4627-44df-9f6a-22393b344ea2",
                        "source_entry_id": "64a24119-8b0b-372f-ab0d-d3e282eb5118",
                        "source_sense_id": "de2cc740-ac06-36ec-ac7d-b31b95cc7e36",
                        "target_lang_word": "Lepcha",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lepcha",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76a19324-9c55-336a-a178-767ff8b00861",
                                        "entry_id": "a2b1e583-5b7f-354e-9024-23666a5edba7",
                                        "glosses": [
                                            "die Sprache des gleichnamigen Volks im östlichen Himalaja"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f025fee-7e33-45c5-8328-9c3771d44ee0",
                                                "sense_id": "76a19324-9c55-336a-a178-767ff8b00861",
                                                "text": "„Im Lepcha nun ergibt sich eine Verschiebung: der bilabiale Nasal ist hier der am häufigsten bei Ableitungen auftretende Nasal.“"
                                            },
                                            {
                                                "example_id": "4e99f667-d7d2-47c7-94ee-c7c421c443a8",
                                                "sense_id": "76a19324-9c55-336a-a178-767ff8b00861",
                                                "text": "„Sikkim ist ein vielsprachiges Land. Im Zentrum ist die Landessprache Lepcha oder Rong.“"
                                            },
                                            {
                                                "example_id": "371e95fa-3858-4d7b-9d52-54232ad573f9",
                                                "sense_id": "76a19324-9c55-336a-a178-767ff8b00861",
                                                "text": "„Auch die Arbeit von Yasuda (1976), der die Urheimat der Japaner im Himalaya-Gebiet ansetzte und das Lepcha neben das Japanische stellte, gehört in dieselbe Kategorie sprachgenetischer Versuche.“"
                                            },
                                            {
                                                "example_id": "1883f8c1-4853-4f80-a8df-15d41fdcdfc7",
                                                "sense_id": "76a19324-9c55-336a-a178-767ff8b00861",
                                                "text": "„Oft mögen es Fremdwörter sein, die für ehrerbietiger gelten, als die einheimischen Ausdrücke, zuweilen sind es wohl auch zierliche Umschreibungen; meist aber ist das für gemein geltende Wort das ursprünglichere. So im Lepcha lōm, Strasse gegenüber ta-mo, a-mik, Auge, gegenüber čan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Lepcha",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1419f760-9af4-3977-aa97-85d58f2065c4",
                                        "entry_id": "02cf2537-fe83-3b53-91c9-81af50e7beaa",
                                        "glosses": [
                                            "ein Volk, das im östlichen Himalaja in Indien, Bhutan sowie Nepal lebt"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "084c824d-8fe2-4812-a0d9-9cc64503bf19",
                                                "sense_id": "1419f760-9af4-3977-aa97-85d58f2065c4",
                                                "text": "„Das ist um so auffallender, weil diese Ahnen den Lepcha die Sämereien vermittelten und die Anweisungen zum Pflanzen gaben, welches ja vorwiegend Frauenarbeit ist.“"
                                            },
                                            {
                                                "example_id": "8aec5f36-b4d4-4211-8584-f3eac76284f6",
                                                "sense_id": "1419f760-9af4-3977-aa97-85d58f2065c4",
                                                "text": "„Die an die Lepcha grenzenden Kumpa Rong oder Kumpa Lepcha kamen (mit dem Raja von Sikhim) aus Tibet.“"
                                            },
                                            {
                                                "example_id": "cb361ab1-472e-4250-b599-0df6fb47a9f6",
                                                "sense_id": "1419f760-9af4-3977-aa97-85d58f2065c4",
                                                "text": "„Die mit Kupferdraht umwickelten Versteifungshölzer am Griff findet man häufig bei Bogen der Lepcha, die Kugeln verschossen oder zum Zielschießen verwendet wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4227071-0bdd-3e98-90ea-a5d23bb97704",
                                        "entry_id": "02cf2537-fe83-3b53-91c9-81af50e7beaa",
                                        "glosses": [
                                            "Angehöriger des gleichnamigen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ea5c129-d955-4c75-895b-b1865bc1cf43",
                                                "sense_id": "e4227071-0bdd-3e98-90ea-a5d23bb97704",
                                                "text": "„So erzählte ein Lepcha: »Das Urelternpaar hieß Ti-gung-a-thik und Ni-gung-a-ngal. […]«“"
                                            },
                                            {
                                                "example_id": "32fd459b-ef26-4ac4-ae67-8b0352072570",
                                                "sense_id": "e4227071-0bdd-3e98-90ea-a5d23bb97704",
                                                "text": "„Ein Lepcha geht mit einer Last von 140 Pfund auf dem Rücken langsam und sicher, ohne alle Furcht darüber hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
