                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ee4d2dc0-361d-48ae-8100-7bc6177359e4",
                        "entry_id": "2bebe4a2-9ffd-390a-af9b-f42b38a7f57e",
                        "tags": [
                            "plural"
                        ],
                        "form": "expiations"
