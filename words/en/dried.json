{
    "word_family": [
        "dry",
        "dryer",
        "dryness",
        "dryly",
        "undried",
        "air-dry",
        "blow-dry",
        "drier"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ad16b5dd-c01d-3629-82bb-7fcd3378d082",
                    "sense_definition": "Preserved or cured by removing moisture, typically used for food items.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "preserved food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought some <w>dried</w> fruit to eat as a healthy snack during our long hike.",
                            "target_lang_translations": {
                                "ru": "Мы купили <w>сушёных</w> фруктов, чтобы перекусить во время долгого похода.",
                                "zh": "我们买了一些<w>干</w>果，作为长途徒步时的健康零食。"
                            }
                        },
                        {
                            "text": "The recipe calls for <w>dried</w> fish to add a salty flavor to the traditional soup.",
                            "target_lang_translations": {
                                "ru": "По рецепту требуется <w>вяленая</w> рыба, чтобы придать традиционному супу соленый вкус.",
                                "zh": "食谱要求加入<w>腌制</w>鱼，为传统汤品增添咸味。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dehydrated"
                    ],
                    "common_phrases": [
                        "dried fruit",
                        "dried fish",
                        "dried herbs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сохраненный или законсервированный путем удаления влаги, обычно о продуктах питания.",
                        "zh": "通过去除水分来保存或腌制的食物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сушёный",
                                "target_lang_sense_clarification": "о фруктах, грибах, овощах"
                            },
                            {
                                "target_lang_word": "вяленый",
                                "target_lang_sense_clarification": "о мясе или рыбе, высушенных на воздухе"
                            },
                            {
                                "target_lang_word": "высушенный",
                                "target_lang_sense_clarification": "общий термин для обезвоженных продуктов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "干",
                                "target_lang_sense_clarification": "指脱水处理过的食物"
                            },
                            {
                                "target_lang_word": "腌制",
                                "target_lang_sense_clarification": "指通过腌制或风干处理的肉类或鱼类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f85898b8-f092-38b9-a9bd-21edf3e20d8c",
                    "sense_definition": "Having had all water or moisture removed after previously being wet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "moisture state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dried</w> mud on his boots was very difficult to scrub off after the rain stopped.",
                            "target_lang_translations": {
                                "ru": "<w>Засохшую</w> грязь на его ботинках было очень трудно отчистить после того, как дождь закончился.",
                                "zh": "雨停后，他靴子上那层<w>干</w>泥很难刷掉。"
                            }
                        },
                        {
                            "text": "She collected <w>dried</w> leaves from the garden to use for her autumn art project.",
                            "target_lang_translations": {
                                "ru": "Она собрала в саду <w>сухие</w> листья для своего осеннего арт-проекта.",
                                "zh": "她从花园里收集了<w>干枯</w>的叶子，用于她的秋季艺术项目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "anhydrous",
                        "desiccated"
                    ],
                    "common_phrases": [
                        "dried mud",
                        "dried leaves",
                        "dried paint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный воды или влаги после того, как предмет был мокрым.",
                        "zh": "指物体在湿润后水分被去除的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засохший",
                                "target_lang_sense_clarification": "о грязи, краске или листьях"
                            },
                            {
                                "target_lang_word": "сухой",
                                "target_lang_sense_clarification": "не содержащий влаги"
                            },
                            {
                                "target_lang_word": "высушенный",
                                "target_lang_sense_clarification": "подвергшийся процессу сушки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "干",
                                "target_lang_sense_clarification": "指失去水分的状态"
                            },
                            {
                                "target_lang_word": "干枯",
                                "target_lang_sense_clarification": "指植物或叶子失去水分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4811803b-9cb9-3494-9523-3c2b4af47914",
                    "sense_definition": "Sold in a raw, unprocessed, and moisture-free state, requiring rehydration or cooking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is much cheaper to buy <w>dried</w> lentils in bulk than to buy them in cans.",
                            "target_lang_translations": {
                                "ru": "Гораздо дешевле покупать <w>сухую</w> чечевицу оптом, чем в консервных банках.",
                                "zh": "批量购买<w>干</w>扁豆比买罐装的要便宜得多。"
                            }
                        },
                        {
                            "text": "You need to soak the <w>dried</w> beans overnight before you can cook them for dinner.",
                            "target_lang_translations": {
                                "ru": "Вам нужно замочить <w>сушёную</w> фасоль на ночь, прежде чем готовить её на ужин.",
                                "zh": "你需要把<w>干</w>豆子浸泡一晚，才能在晚餐时烹饪。"
                            }
                        }
                    ],
                    "antonyms": [
                        "canned",
                        "tinned"
                    ],
                    "common_phrases": [
                        "dried lentils",
                        "dried beans",
                        "dried pasta"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продается в сыром, необработанном и обезвоженном виде, требует замачивания или варки.",
                        "zh": "以原始、未加工且无水分的状态出售，烹饪前通常需要浸泡。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сухой",
                                "target_lang_sense_clarification": "о бобовых, макаронах или крупах"
                            },
                            {
                                "target_lang_word": "сушёный",
                                "target_lang_sense_clarification": "о заготовленных впрок продуктах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "干",
                                "target_lang_sense_clarification": "指未浸泡的豆类或谷物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "871de9e9-e830-36bc-a283-94ae3d4f0527",
                    "sense_definition": "Simple past and past participle of <w>dry</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>dried</w> his hands on a clean towel after washing them in the sink.",
                            "target_lang_translations": {
                                "ru": "Он <w>вытер</w> руки чистым полотенцем после того, как помыл их в раковине.",
                                "zh": "他在水槽洗完手后，用干净的毛巾把手<w>擦干</w>了。"
                            }
                        },
                        {
                            "text": "The sun has <w>dried</w> the clothes quickly on the line this afternoon.",
                            "target_lang_translations": {
                                "ru": "Сегодня днем солнце быстро <w>высушило</w> одежду на веревке.",
                                "zh": "今天下午阳光很快就把晾衣绳上的衣服<w>晒干</w>了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «сушить» или «вытирать».",
                        "zh": "动词 dry 的过去式和过去分词，意为使干燥或擦干。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытер",
                                "target_lang_sense_clarification": "о руках или поверхностях"
                            },
                            {
                                "target_lang_word": "высушил",
                                "target_lang_sense_clarification": "сделал сухим"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦干",
                                "target_lang_sense_clarification": "用毛巾等物去除表面水分"
                            },
                            {
                                "target_lang_word": "晾干",
                                "target_lang_sense_clarification": "通过自然风干或阳光使物体变干"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}