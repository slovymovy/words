                "senses": [
                    {
                        "sense_id": "9f4ad047-d896-33fd-b683-e95e78c0f00b",
                        "entry_id": "4fa9c644-bb41-3418-a6e0-1b3e7af49fb6",
                        "glosses": [
                            "Anzug"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34bb931a-4c05-4878-a7e6-2923df86d9fc",
                        "source_entry_id": "4fa9c644-bb41-3418-a6e0-1b3e7af49fb6",
                        "source_sense_id": "9f4ad047-d896-33fd-b683-e95e78c0f00b",
                        "source_sense_description": "umgangssprachlich, Kleidung: Anzug",
                        "target_lang_word": "Anzug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anzug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5f1db22-1c9a-38b5-b76e-545dc3121aa2",
                                        "entry_id": "7dbee412-bf68-37fa-8896-a0569994b8ad",
                                        "glosses": [
                                            "das Heranziehen, Heranziehen, Heranrücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74ed04ee-9f12-49a4-931b-4693040ed90b",
                                                "sense_id": "d5f1db22-1c9a-38b5-b76e-545dc3121aa2",
                                                "text": "Der Anzug des Gewitters kündigte sich mit dunklen Wolken und aufkommendem Wind an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "16397a70-00b2-3c62-b93c-8a285f171e95",
                                        "entry_id": "7dbee412-bf68-37fa-8896-a0569994b8ad",
                                        "glosses": [
                                            "der erste Zug bei Brettspielen, das erste Ausspielen, Aufdecken, Nehmen bei Kartenspielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42b84e14-129e-41a7-b74d-6a28eaa9cdd4",
                                                "sense_id": "16397a70-00b2-3c62-b93c-8a285f171e95",
                                                "text": "„Verteidigungen im Anzug sind ja bekanntlich Schwarze Systeme, die von Weiß gespielt werden, allerdings mit einem Tempo Vorsprung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8a7dad94-2da1-39b7-9747-e42f3d7c974e",
                                        "entry_id": "7dbee412-bf68-37fa-8896-a0569994b8ad",
                                        "glosses": [
                                            "die Art und Weise, wie man sich anzieht, angezogen ist, die Art der Bekleidung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cfd8964-bd27-459d-b8ef-8e90d739e75b",
                                                "sense_id": "8a7dad94-2da1-39b7-9747-e42f3d7c974e",
                                                "text": "„Bei dem als Bodyflying bezeichneten Sport begibt sich der Sportler, mit Helm, Brille, Mundschutz, Handschuhen und vor allem einem speziellen Anzug ausgestattet, in einen Luftstrom, der durch ein Gitter hindurch senkrecht in die Höhe strebt.“"
                                            },
                                            {
                                                "example_id": "23ca8ef3-7a7a-4997-84d2-e0ad114f2ebf",
                                                "sense_id": "8a7dad94-2da1-39b7-9747-e42f3d7c974e",
                                                "text": "Wie sieht denn dein Anzug heute aus?"
                                            },
                                            {
                                                "example_id": "6cd0c081-1a02-48c1-b1c3-eccbaf6bb930",
                                                "sense_id": "8a7dad94-2da1-39b7-9747-e42f3d7c974e",
                                                "text": "„Aber eine lose, flausartige Joppe, hoch geschlossen, so daß es keiner Krawatte dazu bedurfte, getragen zu irgendwelcher ebenfalls weiten, ungebügelten, klein gewürfelten Hose, war um diese Zeit sein ständiger Anzug, in dem er auch die gewohnten und unentbehrlichen lungenweitenden Spaziergänge machte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7fdc0b58-7cfb-376c-8958-a7e3876d4016",
                                        "entry_id": "7dbee412-bf68-37fa-8896-a0569994b8ad",
                                        "glosses": [
                                            "zweiteilige (Jacke und Hose) oder dreiteilige (Jacke, Hose und Weste) Bekleidung für Herren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6d5c582-48fd-4634-89ed-e959bb535f7d",
                                                "sense_id": "7fdc0b58-7cfb-376c-8958-a7e3876d4016",
                                                "text": "Für manchen Herren reicht alle zehn Jahre ein neuer Anzug."
                                            },
                                            {
                                                "example_id": "c6d57306-2712-4747-aeba-7f42cf3c15c3",
                                                "sense_id": "7fdc0b58-7cfb-376c-8958-a7e3876d4016",
                                                "text": "„Die Wege des Blaus sind unergründlich. Vielleicht kann ein Ausriss aus einer Modezeitschrift weiterhelfen: Ein Mann im blauen Anzug ist zu sehen, fotografiert von schräg unten, mit einem knallblauen Himmel als Hintergrund. Das ist ein wunderschönes Foto, aber hilft das weiter?“"
                                            },
                                            {
                                                "example_id": "eec1951d-7b36-40f8-ada5-67c8cd55abfb",
                                                "sense_id": "7fdc0b58-7cfb-376c-8958-a7e3876d4016",
                                                "text": "„Es war die Zeit, als sich die Jugend an der Universität noch siezte, als Studenten Anzüge und Krawatten trugen und ihre Kommilitoninnen Kleider mit weißen Kragen oder Perlenketten.“"
                                            },
                                            {
                                                "example_id": "920c4d70-0a2c-4d92-8243-bac7406a8261",
                                                "sense_id": "7fdc0b58-7cfb-376c-8958-a7e3876d4016",
                                                "text": "„Wenn Sie das erste Loch im Ärmel bemerken, dann wissen Sie, es ist höchste Zeit, sich um einen neuen Anzug zu kümmern.“"
                                            },
                                            {
                                                "example_id": "9950d0fc-5816-4c6a-843d-d836725f76c6",
                                                "sense_id": "7fdc0b58-7cfb-376c-8958-a7e3876d4016",
                                                "text": "„Die meisten aber sind im dunklen Anzug erschienen.“"
                                            },
                                            {
                                                "example_id": "9d9b76b5-a631-4dd5-bb78-260911beca84",
                                                "sense_id": "7fdc0b58-7cfb-376c-8958-a7e3876d4016",
                                                "text": "„Und der Frost, von ihm her, dringt mich an, schneidend, daß ich mich schutzlos und bloß fühle davor in meinem leichten Anzug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "09fe45f0-f006-3a36-b2c1-10ac7f5ced7c",
                                        "entry_id": "7dbee412-bf68-37fa-8896-a0569994b8ad",
                                        "glosses": [
                                            "(Kissen-, Bett-)Bezug, Überzug"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6c86f76-9ef0-4e45-bb94-23e37dd7e5b9",
                                                "sense_id": "09fe45f0-f006-3a36-b2c1-10ac7f5ced7c",
                                                "text": "„Dralon-Flachdecken extra leicht, mit fast gewichtslosen bügelfreien Anzügen.“"
                                            },
                                            {
                                                "example_id": "0adcbf8f-f49d-4fe6-8c30-9c357a444654",
                                                "sense_id": "09fe45f0-f006-3a36-b2c1-10ac7f5ced7c",
                                                "text": "„›Liebs Grosi, Urgrosi, schlaf guet, träum süess‹, steht auf dem Anzug des Kissens, auf das sie ihren Kopf legt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "e16c1d92-c157-395f-80ef-87e854e4d823",
                                        "entry_id": "7dbee412-bf68-37fa-8896-a0569994b8ad",
                                        "glosses": [
                                            "schriftlich eingereichte Anregung im Großen Rat (Kantonsparlament) zu Händen der Regierung, Postulat"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "270b6dcb-6b7e-43a8-a2df-2f54789398d9",
                                                "sense_id": "e16c1d92-c157-395f-80ef-87e854e4d823",
                                                "text": "„Der Anzug ist das am häufigsten gewählte parlamentarische Instrument. Per Anzug (der dem Postulat beim Bund und den meisten Kantone entspricht) kann jedes Ratsmitglied oder eine ständige Kommission dem Regierungsrat oder dem Grossen Rat Anregungen zur Änderung der Verfassung, zu Gesetzen oder Beschlüssen oder zu Massnahmen der Verwaltung vorlegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "8b105bcf-d241-3665-9303-38c40e062bd8",
                                        "entry_id": "7dbee412-bf68-37fa-8896-a0569994b8ad",
                                        "glosses": [
                                            "eine Schräge an einem Bauteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a55548b0-5c1f-4512-8b1b-f9d8f79456fe",
                                                "sense_id": "8b105bcf-d241-3665-9303-38c40e062bd8",
                                                "text": "Der Anzug von 2° an diesem Bauteil wurde mithilfe eines Gesenkfräsers hergestellt."
