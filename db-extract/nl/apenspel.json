                    {
                        "sense_id": "34780b85-14ed-341b-b3ca-9294f3481ab2",
                        "entry_id": "23e3fa8c-c60c-3519-852e-a1285320d5b4",
                        "glosses": [
                            "een kluchige, dwaze, onzinnige vertoning"
