                ],
                "senses": [
                    {
                        "sense_id": "9f9c4201-5318-3b35-8042-ac3a312a3ad6",
                        "entry_id": "addc9ebc-c063-3bf6-bc86-c7d54b132bfb",
                        "glosses": [
                            "letzter Zeitabschnitt des Herbstes vor Beginn des Winters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53dbc162-33a8-4c98-8e2f-33d4144ebd24",
                                "sense_id": "9f9c4201-5318-3b35-8042-ac3a312a3ad6",
                                "text": "„Vater kam dann erst im Spätherbst nach Hause.“"
                            },
                            {
                                "example_id": "29268722-ee39-4a19-a2f2-1eb4e563e0e2",
                                "sense_id": "9f9c4201-5318-3b35-8042-ac3a312a3ad6",
                                "text": "„Der Herbst jedoch ist eine prachtvolle Jahreszeit in dieser paradiesischen Gegend und besonders jener Spätherbst, der indianische Sommer genannt, der auch im Norden der großen Republik gleich dem Abschiedslächeln einer holden Schönen mit Wonne empfangen wird.“"
                            },
                            {
                                "example_id": "5c1e3a6c-c7bc-4dbc-8354-ea667e30cbf1",
                                "sense_id": "9f9c4201-5318-3b35-8042-ac3a312a3ad6",
                                "text": "„Im Spätherbst wird sogar ein Theaterstück am Théâtre Molière aufgeführt und der Autor, der überaus dicke Citoyen Sade, vom Publikum mit Beifall bedacht.“"
                            },
                            {
                                "example_id": "05290048-a983-42a4-960e-8f96e71a1800",
                                "sense_id": "9f9c4201-5318-3b35-8042-ac3a312a3ad6",
                                "text": "„An einem Tag im Spätherbst sollte der Leichnam in einem speziell für diesen Zweck von Hoffmann eingerichteten Kühlraum unter dem nördlichen Parkplatz der CIA-Zentrale eingekleidet werden.“"
                            },
                            {
                                "example_id": "c460effd-5553-4a25-8421-73fb29b0a621",
                                "sense_id": "9f9c4201-5318-3b35-8042-ac3a312a3ad6",
                                "text": "„Die Luft war kalt, der Himmel aber klar und die letzten Blätter des Spätherbsts wirbelten über die breiten Straßen und Plätze der Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
