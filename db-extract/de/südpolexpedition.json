                "senses": [
                    {
                        "sense_id": "0eaf35be-9a66-3c10-aa61-d5a311dc10e2",
                        "entry_id": "9cd39470-52c4-3c40-b7c0-57873a929cf9",
                        "glosses": [
                            "(Forschungs-)Reise zum südlichsten Punkt der Erde (Südpol)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca7ab2d8-e092-4547-9272-dbe08af84250",
                                "sense_id": "0eaf35be-9a66-3c10-aa61-d5a311dc10e2",
                                "text": "„Das Pub wurde 1920 von Polarforscher Thomas Crean gegründet, der an den Südpolexpeditionen unter Robert Falcon Scott und Ernest Shackleton teilnahm.“"
                            },
                            {
                                "example_id": "f82fb785-2df8-4651-ab61-ded43e3f6560",
                                "sense_id": "0eaf35be-9a66-3c10-aa61-d5a311dc10e2",
                                "text": "„Ludwig und sein Namensvetter Helmer hatten zuletzt auf Amundsens Südpolexpedition ihre Vaterstadt Tromsö ehrenvoll vertreten.“"
                            },
                            {
                                "example_id": "c42b0b93-1e80-43d9-bb79-a230ba115e79",
                                "sense_id": "0eaf35be-9a66-3c10-aa61-d5a311dc10e2",
                                "text": "„Aber die Schiffsmannschaften hatten Angst; es ging ins unbekannte, nie befahrene Meer, unheimlich wie die heutigen Südpolexpeditionen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
