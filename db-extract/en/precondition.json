                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d453622-23cc-365c-94ea-6ba5fe2d4cef",
                        "entry_id": "0ecbad87-0722-3759-82a8-afbcb17f436b",
                        "glosses": [
                            "A condition that requires satisfaction before taking a course of action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66d07897-3f03-4e04-bea9-0c1e03323806",
                                "sense_id": "2d453622-23cc-365c-94ea-6ba5fe2d4cef",
                                "text": "A marriage licence is a precondition for a wedding."
                            },
                            {
                                "example_id": "a540fedd-1e9b-4fe1-b802-3a1d2c7cae56",
                                "sense_id": "2d453622-23cc-365c-94ea-6ba5fe2d4cef",
                                "text": "Presidential adviser Bouthaina Shaaban told Russia Today TV on Tuesday that the government would attend without preconditions and with the goal of stopping violence and terrorism in the country, SANA reported."
                            },
                            {
                                "example_id": "a6dea152-24ec-4cb0-8055-ff00dc3315f7",
                                "sense_id": "2d453622-23cc-365c-94ea-6ba5fe2d4cef",
                                "text": "“The Office will refuse to register works entirely generated by AI,” says Robert Kasunic of the USCO. “Human authorship is a precondition to copyrightability.”"
                            },
                            {
                                "example_id": "957a53fd-8b32-4b45-827d-e74a8d69a9a2",
                                "sense_id": "2d453622-23cc-365c-94ea-6ba5fe2d4cef",
                                "text": "After a failed attempt by ministers to bounce the union into an agreement by announcing its terms (which included all sorts of union red lines such as drivers having to pay for their own training) in the media rather than over the negotiation table, there is an understandable reluctance on the part of the unions to engage in any discussions unless there are no preconditions."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ec30281-8171-3003-a14c-fcc48bee600f",
                        "entry_id": "0ecbad87-0722-3759-82a8-afbcb17f436b",
                        "glosses": [
                            "A medical illness, ailment, or adverse condition that exists before an insurance policy takes effect."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5626094-9808-4caa-a650-c45158a115c0",
                        "source_entry_id": "0ecbad87-0722-3759-82a8-afbcb17f436b",
                        "source_sense_description": "preexisting requirement",
                        "target_lang_word": "voorwaarde",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voorwaarde",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6d47b4a0-0897-328b-88af-dc47f41aa330",
                                        "entry_id": "ee88f802-a5ac-3ff5-9fd0-8c17422708f1",
                                        "glosses": [
                                            "omstandigheid die noodzakelijk is of gemaakt wordt wil iets anders plaats of geldigheid hebben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9114139-6c07-4ba7-b927-81a21acb8ef3",
                                                "sense_id": "6d47b4a0-0897-328b-88af-dc47f41aa330",
                                                "text": "Hij stelde daar een aantal belangrijke voorwaarden aan."
                                            },
                                            {
                                                "example_id": "d492b204-8653-4d33-b274-8afe783fbc70",
                                                "sense_id": "6d47b4a0-0897-328b-88af-dc47f41aa330",
                                                "text": "In 2009 steunt hij de club opnieuw met een lening, op voorwaarde dat hij de overige aandelen ook in handen krijgt als de club niet aan zijn betalingsplicht voldoet. Dat blijkt in 2010 aan de orde, waardoor Schouten voor 99 procent eigenaar wordt van Vitesse."
                                            },
                                            {
                                                "example_id": "936080fd-8e47-4ca0-9074-98eb3603fe1d",
                                                "sense_id": "6d47b4a0-0897-328b-88af-dc47f41aa330",
                                                "text": "Het STAP-budget is bedoeld om werkenden en werkzoekenden te stimuleren zich te laten om- of bijscholen. Wie aan de voorwaarden voldoet, kan een tegemoetkoming in de studiekosten ontvangen van maximaal 1.000 euro per jaar. Voorwaarde is wel dat de opleiding is gericht op huidig of toekomstig werk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
