                "senses": [
                    {
                        "sense_id": "8d1e5975-0764-3db3-a7a0-8594102fbb06",
                        "entry_id": "e42450bc-26f6-38c2-8900-9e76f47b131a",
                        "glosses": [
                            "vertrek bestemd om griezelige dingen te laten zien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6e61bb3-a676-469b-8bc8-1a9c3a84e6c6",
                                "sense_id": "8d1e5975-0764-3db3-a7a0-8594102fbb06",
                                "text": "We gingen met de tram naar Zeebrugge. Daar was een oorlogsmuseum. Niet kinderachtig aangepakt. In een betrekkelijk schemerige kelder was een loopgraaf nagebouwd, in de toestand na een stormaanval. Op een soort bankjes, kisten, kratten zaten de natuurgetrouwe poppen van de verdedigers. In het prikkeldraad voor de loopgraaf hingen een paar dode aanvallers, Duitsers natuurlijk, met gescheurd uniform en bebloed hoofd. Op de kermis, denk ik nu, was het een mooie gruwelkamer geweest. Maar dit was echt, het was geschiedenis."
                            },
                            {
                                "example_id": "ecf26a5a-8806-42c7-8028-89b892f8f0dd",
                                "sense_id": "8d1e5975-0764-3db3-a7a0-8594102fbb06",
                                "text": "Denk maar aan het moordlied, het wassenbeeldenmuseum en de gruwelkamers uit de negentiende eeuw: ook in die tijd wilden mensen graag geïnformeerd worden over waargebeurde misdaden, het liefst in een melodramatische vorm."
                            },
                            {
                                "example_id": "00f30eda-e8e6-47f3-b760-f599129ae7bf",
                                "sense_id": "8d1e5975-0764-3db3-a7a0-8594102fbb06",
                                "text": "Er zijn een aantal cellen in de bewuste gevangenis tot, ik zou haast willen zeggen, gruwelkamertjes ingericht."
                            }
                        ]
                    },
                    {
                        "sense_id": "334fef08-2b24-326e-81a4-9a68880bce69",
                        "entry_id": "e42450bc-26f6-38c2-8900-9e76f47b131a",
                        "glosses": [
                            "plaats waar vreselijke dingen gebeuren"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "893a00a5-646f-45d3-b603-73f471fa0e28",
                                "sense_id": "334fef08-2b24-326e-81a4-9a68880bce69",
                                "text": "Zo beweerde in Nova Marie-Jeanne van Heeswijck, co-auteur van De X-dossiers, dat er DNA-sporen van tot op heden onbekenden in Dutroux's gruwelkamers waren gevonden."
                            },
                            {
                                "example_id": "84f84271-8155-4a69-a175-cbd5b55d6bc6",
                                "sense_id": "334fef08-2b24-326e-81a4-9a68880bce69",
                                "text": "Het boek is dun geschreven, scherp, met heldere zinnen die de waarnemingen en gedachten van het kind bijna koel weergeven. Geen opsomming van verschrikkelijke gebeurtenissen, niet de gruwelkamer van een pijnlijke jeugd. Het is veel ingrijpender en aangrijpender, juist door die zuinige manier van schrijven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "597849d1-e107-428d-a2e7-77c963530394",
                        "source_entry_id": "e42450bc-26f6-38c2-8900-9e76f47b131a",
