                            }
                        ]
                    },
                    {
                        "translation_id": "7aa31e8b-c954-4b02-b2a8-19a54ce43b17",
                        "source_entry_id": "c32aecb7-f52b-3dbd-87fe-22b9dfaae3e0",
                        "source_sense_id": "99319a9e-386a-3089-a349-9bb730b30809",
                        "target_lang_word": "kirsch",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kirsch",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "161ecb26-6a2b-3e05-b837-a972e7ab959e",
                                        "entry_id": "5868dd96-5de2-3494-b3db-871c9ddc774a",
                                        "glosses": [
                                            "Espèce d’eau-de-vie obtenue par distillation du suc des cerises sauvages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02da6acb-9fb4-4a51-8f09-ad6c46eff36d",
                                                "sense_id": "161ecb26-6a2b-3e05-b837-a972e7ab959e",
                                                "text": "Alors il chercha l'oubli tour à tour dans le cidre normand, le poiré manceau, l’hydromel gaulois, le cognac français, le genièvre hollandais, le gin anglais, le wiskey écossais, le kirsch germain."
                                            },
                                            {
                                                "example_id": "062dcc50-3059-4c21-86b8-d427b19c8438",
                                                "sense_id": "161ecb26-6a2b-3e05-b837-a972e7ab959e",
                                                "text": "— Je pense bien que Mme Silvert nous donnera bientôt l’occasion de sucer quelques dragées. Pour ma part, j’en commanderai au kirsch, ne pouvant les avaler qu’au kirsch."
                                            },
                                            {
                                                "example_id": "b15111bb-207a-4ae5-a308-933513228954",
                                                "sense_id": "161ecb26-6a2b-3e05-b837-a972e7ab959e",
                                                "text": "J'y ai aperçu des amis qui ne demandent qu'à me régaler d'un punch au kirsch et j'ai soif."
                                            },
                                            {
                                                "example_id": "0087ede3-b36f-4a13-8cd5-26ff65fdaff7",
                                                "sense_id": "161ecb26-6a2b-3e05-b837-a972e7ab959e",
                                                "text": "Dans les cantons riches en arbres fruitiers, comme ceux de Tourteron et de Novion, on fait du kirsch avec des cerises, auxquelles on ajoute quelquefois des prunes ou même quelques pommes."
                                            },
                                            {
                                                "example_id": "8578b810-f1a7-4162-9bbd-1a7a239f86b6",
                                                "sense_id": "161ecb26-6a2b-3e05-b837-a972e7ab959e",
                                                "text": "[…] ; nous étions soutenus par une sorte d'espérance et aussi par un flacon de kirsch."
                                            },
                                            {
                                                "example_id": "b9f10cb9-962a-4b60-8283-ece72b565453",
                                                "sense_id": "161ecb26-6a2b-3e05-b837-a972e7ab959e",
                                                "text": "[…] ils découvrirent tout un lit de bouteilles pleines, soigneusement cachetées. C’était du vin rouge et blanc, même un alcool trop transparent et fluide pour être du marc et qui était sans doute du kirsch."
                                            },
                                            {
                                                "example_id": "4564afa1-4b41-4db7-93a6-6c3ae165f137",
                                                "sense_id": "161ecb26-6a2b-3e05-b837-a972e7ab959e",
                                                "text": "Et lui qui buvait rarement et fort peu prit coup sur coup deux pleins verres de kirsch, de notre kirsch qui fait dans les soixante et qui vous met le feu aux veines pour une grande journée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43cba157-1239-4dfb-bf8d-59c6a9cf3d6e",
                        "source_entry_id": "c32aecb7-f52b-3dbd-87fe-22b9dfaae3e0",
                        "source_sense_id": "99319a9e-386a-3089-a349-9bb730b30809",
                        "target_lang_word": "Kirschwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kirschwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f41dc346-dea9-3d09-a36d-94a86921585a",
                                        "entry_id": "b4e3783d-cfb6-37e8-bae5-06b6624e6d72",
                                        "glosses": [
                                            "alkoholisches Getränk, das aus Kirschen hergestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaa168a1-9637-4a59-be2f-b1a358556a0f",
                                                "sense_id": "f41dc346-dea9-3d09-a36d-94a86921585a",
                                                "text": "Im Winter trinke ich gerne ein Kirschwasser."
                                            },
                                            {
                                                "example_id": "dc8fab4a-5602-4c63-bbea-ca06e1b4d8e5",
                                                "sense_id": "f41dc346-dea9-3d09-a36d-94a86921585a",
                                                "text": "„Die kleineren Vorräte für die Kajüte wurden an Bord gebracht, und Dan McCoy überredete mich, von einer Flasche Kirschwasser zu kosten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
