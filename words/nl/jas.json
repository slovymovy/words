                },
                {
                    "sense_id": "ecc9b514-321e-3e33-8d87-3cb87cc3ec28",
                    "sense_definition": "De troefboer in kaartspellen zoals klaverjassen; de hoogste troefkaart.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "card_game_jack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je de <w>jas</w> hebt, sta je er goed voor in het spel.",
                            "target_lang_translations": {
                                "en": "If you have the <w>jack</w>, you are in a good position in the game.",
                                "ru": "Если у тебя есть <w>валет</w>, у тебя хорошая позиция в игре.",
                                "zh": "如果你手里有<w>杰克</w>，你在游戏中就占优势。",
                                "pl": "Jeśli masz <w>waleta</w>, jesteś w dobrej sytuacji w grze."
                            }
                        },
                        {
                            "text": "Zij speelde de <w>jas</w> om zeker te zijn van de slag.",
                            "target_lang_translations": {
                                "en": "She played the <w>jack</w> to be sure of the trick.",
                                "ru": "Она сыграла <w>валетом</w>, чтобы наверняка взять взятку.",
                                "zh": "她打出了<w>杰克</w>以确保赢得这一轮。",
                                "pl": "Zagrała <w>waletem</w>, żeby mieć pewność, że weźmie lewę."
                            }
                        }
                    ],
                    "synonyms": [
                        "troefboer",
                        "troefzot"
                    ],
                    "common_phrases": [
                        "de jas en de nel"
                    ],
                    "target_lang_definitions": {
                        "en": "The jack of trumps in card games like klaberjass; the highest trump card.",
                        "ru": "Козырный валет в карточных играх, таких как клаверъяс; старшая козырная карта.",
                        "zh": "在某些纸牌游戏中（如克拉伯牌）的王牌杰克；最高级别的王牌。",
                        "pl": "Walet atutowy w grach karcianych takich jak klaberjass; najwyższa karta atutowa."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jack",
                                "target_lang_sense_clarification": "playing card"
                            },
                            {
                                "target_lang_word": "jack of trumps",
                                "target_lang_sense_clarification": "card game role"
                            }
                        ],
                        "ru": [
