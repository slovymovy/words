                "senses": [
                    {
                        "sense_id": "03505225-7f3c-37fd-96d9-0b64ca5fa50d",
                        "entry_id": "7fc18cd3-3172-3947-8d0c-f24253e7736b",
                        "glosses": [
                            "Guérir d’une addiction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f6838d6-3e2c-49c5-a3bc-53d7c7c596fa",
                                "sense_id": "03505225-7f3c-37fd-96d9-0b64ca5fa50d",
                                "text": "Mohammad me parle également des soirées « NK » qui seraient organisées par des groupes de gays conservateurs pour se « dé-addicter » de l’homosexualité et devenir hétérosexuels, mais il ne m’a pas été possible de vérifier cette information."
                            },
                            {
                                "example_id": "83d03c8a-e382-4674-b442-937a45dfa197",
                                "sense_id": "03505225-7f3c-37fd-96d9-0b64ca5fa50d",
                                "text": "Nan mais sérieux, tu es sérieux là, a vouloir nous dé-addicter du PC?"
                            },
                            {
                                "example_id": "164d10bd-35c8-4114-9a6a-36444a9b9e49",
                                "sense_id": "03505225-7f3c-37fd-96d9-0b64ca5fa50d",
                                "text": "Est-ce que le fait de se \"dé-addicter\" permet de retrouver une liberté?"
                            },
                            {
                                "example_id": "ba549aa6-ba73-4b8b-891a-3c3cf4e0b3fd",
                                "sense_id": "03505225-7f3c-37fd-96d9-0b64ca5fa50d",
                                "text": "bon courage pour te dé-addicter du jeu, parce que là c’est quand même du lourd !"
                            }
                        ]
                    }
