{
    "word_family": [
        "contagion",
        "contagiosité"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "78c2a4b0-a46b-3604-a203-58243ab0bef1",
                    "sense_definition": "Qui se transmet d'un individu à un autre par contagion, en parlant d'une maladie ou d'un germe.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "médical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La grippe est une maladie <w>contagieuse</w> qui se propage très vite en hiver."
                        },
                        {
                            "text": "Ce nouveau virus <w>contagieux</w> a poussé les autorités à fermer temporairement les écoles."
                        }
                    ],
                    "synonyms": [
                        "infectieux",
                        "transmissible"
                    ],
                    "antonyms": [
                        "non transmissible"
                    ],
                    "common_phrases": [
                        "maladie contagieuse",
                        "virus contagieux"
                    ]
                },
                {
                    "sense_id": "f4700369-85bf-34f1-97a1-97098ec92a2d",
                    "sense_definition": "Qui est porteur d'une maladie infectieuse et capable de la transmettre à autrui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "médical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin m'a conseillé de rester chez moi car je suis encore <w>contagieux</w>."
                        },
                        {
                            "text": "Il faut éviter d'approcher cet animal tant qu'il reste <w>contagieux</w>."
                        }
                    ],
                    "common_phrases": [
                        "être contagieux",
                        "rester contagieux"
                    ]
                },
                {
                    "sense_id": "e8f60bc2-6b49-31ca-83f6-8311b9f094b9",
                    "sense_definition": "Qui se transmet facilement et spontanément à autrui par l'exemple, le contact ou l'influence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a un rire si <w>contagieux</w> que tout le monde dans la pièce se met à rire."
                        },
                        {
                            "text": "L'enthousiasme <w>contagieux</w> du professeur donne envie à tous les élèves de s'investir."
                        }
                    ],
                    "synonyms": [
                        "communicatif"
                    ],
                    "common_phrases": [
                        "rire contagieux",
                        "enthousiasme contagieux",
                        "bâillement contagieux"
                    ]
                },
                {
                    "sense_id": "ba5d1a64-deed-36f9-a343-2305c7e09b4b",
                    "sense_definition": "Qui favorise ou propage la contagion, en parlant d'un milieu ou d'un principe physique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "médical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Autrefois, on croyait que respirer un air <w>contagieux</w> suffisait à transmettre les épidémies."
                        },
                        {
                            "text": "Les médecins cherchaient à purifier les lieux exposés à ce souffle <w>contagieux</w>."
                        }
                    ],
                    "common_phrases": [
                        "air contagieux"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Usage vieilli pour désigner ce qui sert de vecteur ou favorise une épidémie"
                        }
                    ]
                }
            ]
        }
    ]
}