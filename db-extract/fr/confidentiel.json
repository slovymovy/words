                    {
                        "form_id": "269f5260-9098-41d5-983b-15487c616dac",
                        "entry_id": "9743abd9-889f-3ebd-a3c6-9bd673f469bb",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "confidentielles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "694fd1f4-53a5-300e-91a0-12e07d9895cf",
                        "entry_id": "9743abd9-889f-3ebd-a3c6-9bd673f469bb",
                        "glosses": [
                            "Qui se fait en confidence, et qui est donc réservé à un nombre restreint de destinataires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cd6d05a-c868-4ef5-93b0-6d8e73607705",
                                "sense_id": "694fd1f4-53a5-300e-91a0-12e07d9895cf",
                                "text": "L'usage voulait, pour certaines correspondances véhiculant des informations confidentielles, que l'on cryptât celles-ci en recourant à des lettres ou à des chiffres qui s'apparentaient à des signes cabalistiques."
                            },
                            {
                                "example_id": "ce9188a8-5a06-4c65-a4fd-4603ff0f55ac",
                                "sense_id": "694fd1f4-53a5-300e-91a0-12e07d9895cf",
                                "text": "Marc devient de plus en plus gênant, dis-je d’une voix murmurante, confidentielle, tandis que je souris avec la niaiserie convenant à ce qui doit passer pour une banalité de salon."
                            },
                            {
                                "example_id": "70ef20de-5f7a-4d37-a527-51d370d98dd2",
                                "sense_id": "694fd1f4-53a5-300e-91a0-12e07d9895cf",
                                "text": "D’après ce tableau confidentiel, produit par l’Agence de l’environnement et de la maîtrise de l’énergie (Ademe), plus de la moitié des intercommunalités collectent de quoi financer largement plus de 100 % du coût réel de la collecte et du traitement des déchets ménagers."
                            }
                        ]
                    },
                    {
                        "sense_id": "4baa57ff-c2f8-3210-978e-88fb18f1b47f",
                        "entry_id": "9743abd9-889f-3ebd-a3c6-9bd673f469bb",
                        "glosses": [
                            "Par opposition à officiel."
                        ],
                        "tags": [
                            "Administration",
                            "Négociation"
                        ],
                        "examples": [
                            {
                                "example_id": "5613bcab-40ac-404f-8bec-284a428ab2a8",
                                "sense_id": "4baa57ff-c2f8-3210-978e-88fb18f1b47f",
                                "text": "Avis confidentiel."
                            },
                            {
                                "example_id": "6ee6e9d9-b0de-4738-ba3a-908c84b58d9e",
                                "sense_id": "4baa57ff-c2f8-3210-978e-88fb18f1b47f",
                                "text": "Note confidentielle."
                            },
                            {
                                "example_id": "abfa322a-e519-428b-891b-96fa3821d206",
                                "sense_id": "4baa57ff-c2f8-3210-978e-88fb18f1b47f",
                                "text": "Au vu de la « gravité des faits constatés », explique la ministre du Logement, Emmanuelle Cosse, dans un courrier confidentiel daté de février, Yerres devra s’acquitter d’une amende de 129,000 euros."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db816977-8e46-4946-929e-91f432b52beb",
                        "source_entry_id": "9743abd9-889f-3ebd-a3c6-9bd673f469bb",
                        "target_lang_word": "vertraulich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vertraulich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73d4024b-2cce-37eb-b94a-bbd50e500743",
                                        "entry_id": "7b5b3d77-499a-3285-bdac-3fb4f5d5220e",
                                        "glosses": [
                                            "für einen eingeschränkten Empfängerkreis vorgesehen; nicht für Fremde bestimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e920b40d-76ce-4199-a274-00c28bc703c3",
                                                "sense_id": "73d4024b-2cce-37eb-b94a-bbd50e500743",
                                                "text": "Behandeln Sie diese Informationen bitte vertraulich."
                                            },
                                            {
                                                "example_id": "f20d0776-ce7a-4fae-9717-025ebd170bd8",
                                                "sense_id": "73d4024b-2cce-37eb-b94a-bbd50e500743",
                                                "text": "Sie führten ein vertrauliches Gespräch unter vier Augen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d7bce19-a5e3-4bfc-b075-9be95030992b",
                        "source_entry_id": "9743abd9-889f-3ebd-a3c6-9bd673f469bb",
                        "target_lang_word": "confidential",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confidential",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28ae5888-1029-32d2-866b-9154b5e63b47",
                                        "entry_id": "9be2ae1d-f6df-3202-aaee-458f7bbd934c",
                                        "glosses": [
                                            "Kept, or meant to be kept, secret within a certain circle of persons; not intended to be known publicly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c051972d-1fbd-4305-9db6-7ba920b46fdf",
                                                "sense_id": "28ae5888-1029-32d2-866b-9154b5e63b47",
                                                "text": "The newspaper claims a leaked confidential report by the government admits to problems with corrupt MPs."
                                            },
                                            {
                                                "example_id": "1aa1d8d0-16b9-4157-b654-7469abefbc60",
                                                "sense_id": "28ae5888-1029-32d2-866b-9154b5e63b47",
                                                "text": "[…] I have a communication of a very private—indeed, I will say, of a sacredly confidential nature, which I desire to make to you."
                                            },
                                            {
                                                "example_id": "550d1ae9-360a-46c8-a9a7-16d0b9b32095",
                                                "sense_id": "28ae5888-1029-32d2-866b-9154b5e63b47",
                                                "text": "It would tell against your reputation, losing a confidential document, wouldn’t it? Why didn’t you keep it confidential if it was confidential?"
                                            },
                                            {
                                                "example_id": "cb5d4dfc-6527-4799-a203-0e8a24de05c0",
                                                "sense_id": "28ae5888-1029-32d2-866b-9154b5e63b47",
                                                "text": "“One of the things that I think parents would tell you, and that students and victims and patients would tell you, is that we have a legal responsibility, but I think more importantly a moral responsibility, to hold their information confidential and private,” Blanton said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9173393-e536-370d-a01f-27068701d9ce",
                                        "entry_id": "9be2ae1d-f6df-3202-aaee-458f7bbd934c",
                                        "glosses": [
                                            "Inclined to share confidences; (of things) making people inclined to share confidences; involving the sharing of confidences."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e7bae6b-4c0c-4516-8fe2-15a95f2360ee",
                                                "sense_id": "e9173393-e536-370d-a01f-27068701d9ce",
                                                "text": "Sitting in front of the fire, they became quite confidential, and began to gossip."
                                            },
                                            {
                                                "example_id": "d4996997-2fe9-4df9-8444-0b498c81b10f",
                                                "sense_id": "e9173393-e536-370d-a01f-27068701d9ce",
                                                "text": "Long, long would it be ere Miss Crawford’s name passed his lips again, or she could hope for a renewal of such confidential intercourse as had been."
                                            },
                                            {
                                                "example_id": "0a55b91b-8064-497c-907e-5ad48ee8b4da",
                                                "sense_id": "e9173393-e536-370d-a01f-27068701d9ce",
                                                "text": "I was only alive to the condensed confidential comfortableness of sharing a pipe and a blanket with a real friend."
                                            },
                                            {
                                                "example_id": "dcabe8a4-ab6b-4998-bc74-8aec444d7394",
                                                "sense_id": "e9173393-e536-370d-a01f-27068701d9ce",
                                                "text": "She and Bertha had never been on confidential terms, but at such a crisis the barriers of reserve must surely fall:"
                                            },
                                            {
                                                "example_id": "a2fddcf8-0012-4502-88d5-742dea7574f3",
                                                "sense_id": "e9173393-e536-370d-a01f-27068701d9ce",
                                                "text": "Miss Raste was encouraged to be entirely confidential, to withhold nothing even about herself, by the confidence-inspiring and kindly aspect of Elsie’s face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b04d78ec-3aab-3d45-9cb8-c2555cfd01c2",
                                        "entry_id": "9be2ae1d-f6df-3202-aaee-458f7bbd934c",
                                        "glosses": [
                                            "Having someone's confidence or trust; having a position requiring trust; worthy of being trusted with confidences."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4962e7e6-eeee-4e00-a999-32b794fa90f7",
                                                "sense_id": "b04d78ec-3aab-3d45-9cb8-c2555cfd01c2",
                                                "text": "a confidential agent; a confidential servant; a confidential whisper"
                                            },
                                            {
                                                "example_id": "c7660066-ae69-4659-b88e-54e3d42d7515",
                                                "sense_id": "b04d78ec-3aab-3d45-9cb8-c2555cfd01c2",
                                                "text": "Now, they want me to send up a confidential person with some writings."
                                            },
                                            {
                                                "example_id": "2e804fe0-8627-4347-9714-ebc614988220",
                                                "sense_id": "b04d78ec-3aab-3d45-9cb8-c2555cfd01c2",
                                                "text": "This paper will serve instead of a confidential friend into whose ear I might pour forth the overflowings of my heart."
                                            },
                                            {
                                                "example_id": "e2c51ac9-7340-4cd0-93d5-77739992f95e",
                                                "sense_id": "b04d78ec-3aab-3d45-9cb8-c2555cfd01c2",
                                                "text": "[…] perhaps the confidential bachelor clerks in Tellson’s Bank were principally occupied with the cares of other people;"
                                            },
                                            {
                                                "example_id": "c5617ad7-8aa7-4fb9-b9e2-8666454990a2",
                                                "sense_id": "b04d78ec-3aab-3d45-9cb8-c2555cfd01c2",
                                                "text": "I repeated the instruction by letter and I kept a copy of the letter witnessed by my confidential maid."
                                            },
                                            {
                                                "example_id": "52a25768-6e9b-45c1-8ebe-ff21cf4d542f",
                                                "sense_id": "b04d78ec-3aab-3d45-9cb8-c2555cfd01c2",
                                                "text": "“He said he was a confidential messenger,” shouted a man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
