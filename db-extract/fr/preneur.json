                        "form_id": "07f45954-2f46-4c65-a9b3-4f6c38a2ae80",
                        "entry_id": "895a7e16-02f3-34a8-9766-5a24e23d7f42",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "preneuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb424d06-045c-347e-81fa-e202b607bf83",
                        "entry_id": "895a7e16-02f3-34a8-9766-5a24e23d7f42",
                        "glosses": [
                            "Qui fait une prise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cfdc5d0-5007-4eb0-beb0-f0e27b3e036f",
                                "sense_id": "eb424d06-045c-347e-81fa-e202b607bf83",
                                "text": "Bâtiment preneur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21cb6fda-414c-4835-81a2-48f29a22d887",
                        "source_entry_id": "895a7e16-02f3-34a8-9766-5a24e23d7f42",
                        "source_sense_id": "eb424d06-045c-347e-81fa-e202b607bf83",
                        "target_lang_word": "taker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "672721af-b2ed-3847-83a0-7e2529f9e982",
                                        "entry_id": "a012220a-6020-32ac-8b5c-cbd3f43f44b9",
                                        "glosses": [
                                            "One who takes something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92ca629f-7e31-4a18-aa6e-e14d4af9a109",
                                                "sense_id": "672721af-b2ed-3847-83a0-7e2529f9e982",
                                                "text": "She is known as quite a risk taker."
                                            },
                                            {
                                                "example_id": "46c16c23-d1d0-4a2c-a073-d339f3ec94c2",
                                                "sense_id": "672721af-b2ed-3847-83a0-7e2529f9e982",
                                                "text": "The hostage taker decided to surrender to the police."
                                            },
                                            {
                                                "example_id": "50f3caf6-9540-45d8-a4a4-3e3977ebcdb5",
                                                "sense_id": "672721af-b2ed-3847-83a0-7e2529f9e982",
                                                "text": "The study could not confirm the real percentage of drug takers in the country."
                                            },
                                            {
                                                "example_id": "8b35cfd4-cee2-4026-aec3-5ae07dd0b58f",
                                                "sense_id": "672721af-b2ed-3847-83a0-7e2529f9e982",
                                                "text": "An athletic kid from New Jersey, Fischer was known as a bold risk taker — they called him “the fallingest man in climbing” — until an old-school cragger taught him the Zen of controlled ascent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cfc33ee-05c2-3b14-9362-469e02b79813",
                                        "entry_id": "a012220a-6020-32ac-8b5c-cbd3f43f44b9",
                                        "glosses": [
                                            "A person or thing that takes or receives, often more than he or she gives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e7aaf4f-bc11-4288-8620-a58d3bc8c277",
                                                "sense_id": "1cfc33ee-05c2-3b14-9362-469e02b79813",
                                                "text": "I don't want to be a relationship with you anymore - you are too much of a taker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea7b7f9a-f18e-3651-b0b9-599909bf4933",
                                        "entry_id": "a012220a-6020-32ac-8b5c-cbd3f43f44b9",
                                        "glosses": [
                                            "One who is willing to participate in, or buy, something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "747b6dd7-8062-4ff4-bbfc-7fc2272b8fdc",
                                                "sense_id": "ea7b7f9a-f18e-3651-b0b9-599909bf4933",
                                                "text": "Are there any takers for helping me clean the garage this weekend?"
                                            },
                                            {
                                                "example_id": "ecb98b7d-5031-4d48-ae0a-dff2d7028f1b",
                                                "sense_id": "ea7b7f9a-f18e-3651-b0b9-599909bf4933",
                                                "text": "I'm selling handmade postcards—any takers?"
                                            },
                                            {
                                                "example_id": "202caf10-b88c-42bf-bf52-f0222592d302",
                                                "sense_id": "ea7b7f9a-f18e-3651-b0b9-599909bf4933",
                                                "text": "Barely a decade ago, the notion that land should be managed in order to ensure planetary wellbeing had few takers among farmers whose raison d'etre was to fill human bellies at the lowest possible cost. But this is the proposition that is now poised to determine the future of farming."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5329198-3478-3199-8371-f3f6589abf04",
                                        "entry_id": "a012220a-6020-32ac-8b5c-cbd3f43f44b9",
                                        "glosses": [
                                            "A nipper or claw of a scorpion."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6428ac7f-4215-465b-9ce5-799fffc98881",
                                                "sense_id": "c5329198-3478-3199-8371-f3f6589abf04",
                                                "text": "The ſixt is like a Crabbe, & this is called by Elianus a flamant Scorpion, it is of a great body, and hath tonges and takers very ſolid and ſtrong, like the Gramuell or Creuiſh, & is therefore thought to take the beginning from that fiſh."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7834dd27-12c7-4f96-a7bd-5f2ef95b155c",
                        "source_entry_id": "895a7e16-02f3-34a8-9766-5a24e23d7f42",
                        "source_sense_id": "eb424d06-045c-347e-81fa-e202b607bf83",
                        "target_lang_word": "λήπτης",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "λήπτης",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "d5aeed60-eaff-3077-96a5-ed30f9500f16",
                                        "entry_id": "e6c416e5-3871-3ac8-a7af-00f684474238",
                                        "glosses": [
                                            "αυτός που λαμβάνει κάτι"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "757cb7da-3497-3beb-96d4-27aea8e03305",
                "word": "preneur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7d7e83f2-2c57-461d-9558-9d08ff2a65cd",
                        "entry_id": "757cb7da-3497-3beb-96d4-27aea8e03305",
                        "tags": [
                            "plural"
                        ],
                        "form": "preneurs"
                    },
                    {
                        "form_id": "f076427c-0e53-405b-a9fa-5bf1f11bab48",
                        "entry_id": "757cb7da-3497-3beb-96d4-27aea8e03305",
                        "tags": [
                            "feminine"
                        ],
                        "form": "preneuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4680cf91-e1e7-3921-99c5-6805c1261a10",
                        "entry_id": "757cb7da-3497-3beb-96d4-27aea8e03305",
                        "glosses": [
                            "Celui qui prend, qui a coutume de prendre. Se dit des personnes qui usent habituellement de certaines choses."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3cc14b36-a605-478b-94a4-086f167c8051",
                                "sense_id": "4680cf91-e1e7-3921-99c5-6805c1261a10",
                                "text": "Dix minutes après, les verres remplis circulaient à travers la foule, et trouvaient toujours preneurs, comme des rentes dans un mouvement de hausse."
                            },
                            {
                                "example_id": "e0b2dbff-1db6-4907-b5b8-0724b640978b",
                                "sense_id": "4680cf91-e1e7-3921-99c5-6805c1261a10",
                                "text": "Vous n’ignorez pas qu’il n’y a que deux sortes d’êtres : les donneurs et les preneurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "1feacefa-2b96-3256-a29a-1bfac163bcd4",
                        "entry_id": "757cb7da-3497-3beb-96d4-27aea8e03305",
                        "glosses": [
                            "Celui qui prend des animaux à certaines chasses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca8303f1-ffa8-4cce-ba20-52d261bf4d2c",
                                "sense_id": "1feacefa-2b96-3256-a29a-1bfac163bcd4",
                                "text": "Preneur de taupes. Preneur d’oiseaux à la pipée. Preneur d’alouettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1a7538a-4dbb-3163-8b1f-4f57af88b9f0",
                        "entry_id": "757cb7da-3497-3beb-96d4-27aea8e03305",
                        "glosses": [
                            "Celui qui prend une maison à loyer, une terre à ferme, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85d7d244-62d8-4868-a59b-31cf5174b354",
                                "sense_id": "c1a7538a-4dbb-3163-8b1f-4f57af88b9f0",
                                "text": "Le bail à construction confère notamment au preneur un droit réel immobilier : libre hypothèque, libre cession, la possibilité de consentir à certaines servitudes."
                            },
                            {
                                "example_id": "d94a0288-a032-4d22-8316-835b31f04342",
                                "sense_id": "c1a7538a-4dbb-3163-8b1f-4f57af88b9f0",
                                "text": "Il est également prévu que les bailleurs et preneurs puissent déléguer tout ou partie de la transmission de leurs consommations d’énergie, soit entre eux, soit à leurs prestataires ou aux gestionnaires de réseau de distribution d’énergie."
                            },
                            {
                                "example_id": "d5f4a15a-99c6-45a8-bea4-d57325bd28e6",
                                "sense_id": "c1a7538a-4dbb-3163-8b1f-4f57af88b9f0",
                                "text": "Le preneur, la preneuse s’engage à… Le bailleur et le preneur. Il y a preneur. Cette maison a trouvé preneur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bc4c27d-d130-4f7d-bab2-b7e4398ad33e",
                        "source_entry_id": "757cb7da-3497-3beb-96d4-27aea8e03305",
