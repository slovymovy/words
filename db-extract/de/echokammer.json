                ],
                "senses": [
                    {
                        "sense_id": "e188b77d-1575-3d30-98ca-b93ff5e1b7ca",
                        "entry_id": "1fcc526d-4f82-3f24-8f1a-5a1ccec227e2",
                        "glosses": [
                            "Räumlichkeit, in der der Nachhall eines Tones verstärkt wird"
                        ],
                        "tags": [
                            "Tonstudio"
                        ],
                        "examples": [
                            {
                                "example_id": "203e9d87-02b7-49f5-828f-90dd762e38ac",
                                "sense_id": "e188b77d-1575-3d30-98ca-b93ff5e1b7ca",
                                "text": "„Der berühmte Warp Sound aus der Fernsehserie Star Trek (1966) basiert auf einer Musiknote, die mit einem Oszillator erzeugt, durch eine Echokammer geschickt und mit allerlei Summen und Verzerrung nachbearbeitet wurde.“"
                            },
                            {
                                "example_id": "300bb483-89c1-486f-831a-14db43c7fae0",
                                "sense_id": "e188b77d-1575-3d30-98ca-b93ff5e1b7ca",
                                "text": "„Die schweren Metallplatten, die er an seine Schuhe geschnallt hatte, klickten und klackerten auf dem Zement und hallten von den alten Häusern wider, als wäre er in einer Echokammer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cead9b58-ba9c-387b-b0f0-e1a77072acfb",
                        "entry_id": "1fcc526d-4f82-3f24-8f1a-5a1ccec227e2",
                        "glosses": [
                            "Umfeld, in dem man nur noch Informationen angeboten bekommt/aufnimmt, die den eigenen Vorlieben entsprechen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "8fca99f9-8d50-455b-ba25-6092b732054b",
                                "sense_id": "cead9b58-ba9c-387b-b0f0-e1a77072acfb",
                                "text": "„Um zu überprüfen, wie es um diese Befürchtung im Deutschland der Gegenwart steht, müssen wir zunächst besser verstehen, wie eine Echokammer funktioniert.“"
                            },
                            {
                                "example_id": "946052c4-abf1-4c95-b5bd-456f1fb5503c",
                                "sense_id": "cead9b58-ba9c-387b-b0f0-e1a77072acfb",
                                "text": "„Noch lag die Gründung von Fox News, jenem Sender, der maßgeblich zur Entstehung einer konservativen Echokammer beigetragen hat, zwei Jahrzehnte in der Zukunft“"
                            },
                            {
                                "example_id": "db5cd8cd-83c4-4afd-9605-5d4704747c47",
                                "sense_id": "cead9b58-ba9c-387b-b0f0-e1a77072acfb",
                                "text": "„Mit Echokammer wird dabei das Phänomen beschrieben, dass viele Menschen in den sozialen Netzwerken dazu neigen, sich mit Gleichgesinnten zu umgeben und sich dabei gegenseitig in der eigenen Position zu verstärken.“"
                            },
                            {
                                "example_id": "f7ddb40e-996c-4a85-afd5-c7ab0422dea6",
                                "sense_id": "cead9b58-ba9c-387b-b0f0-e1a77072acfb",
                                "text": "„Häufig fällt in Frankfurt der Begriff der „Echokammer“. Dahinter steckt die Vorstellung, dass, wer keine traditionellen Tageszeitungen oder Magazine mehr liest, sondern sich seine Informationen im Internet über soziale Netzwerke zusammensucht, irgendwann nur noch das erfährt, was seine ohnehin schon bestehende Meinung bestätigt.“"
                            },
                            {
                                "example_id": "46f03e44-bd0d-4d90-8396-b509f3ff2d19",
                                "sense_id": "cead9b58-ba9c-387b-b0f0-e1a77072acfb",
                                "text": "„Auf die Frage, wer oder was dafür verantwortlich sein könnte, dass die radikalen Programme der Populisten plötzlich wieder eine derartige Resonanz in der Wahlbevölkerung erzeugen, ist oft rasch eine Hauptverdächtige identifiziert: die digitale Echokammer.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a1fee6a-c993-445d-95d6-14013907c491",
                        "source_entry_id": "1fcc526d-4f82-3f24-8f1a-5a1ccec227e2",
                        "source_sense_id": "e188b77d-1575-3d30-98ca-b93ff5e1b7ca",
                        "source_sense_description": "Tonstudio: Räumlichkeit, in der der Nachhall eines Tones verstärkt wird",
                        "target_lang_word": "echo chamber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "echo chamber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc8569ed-d956-3343-936a-4d6fd5f9fc13",
                                        "entry_id": "3b3218c9-407b-3b53-9ff5-e80cb2be9270",
                                        "glosses": [
                                            "A room or other enclosed space that is highly conducive to the production of echoes, particularly one that has been designed and built for this purpose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ee64ecf-8790-341b-bfe3-b0bb8e8f6cfc",
                                        "entry_id": "3b3218c9-407b-3b53-9ff5-e80cb2be9270",
                                        "glosses": [
                                            "A sound effect that may be applied to live or recorded sounds through a sound editing process, which creates the impression that the sounds originated in an enclosed space which was conducive to producing echoes or echoing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04a3a561-15e0-392b-8625-4d23ad3e4e51",
                                        "entry_id": "3b3218c9-407b-3b53-9ff5-e80cb2be9270",
                                        "glosses": [
                                            "An environment in which a person is exposed to only those beliefs and opinions that agree with their own, so that their existing views are magnified and reinforced while alternative ideas are not expressed or considered."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdf9817b-a0af-45bb-a268-1a6c46779a87",
                                                "sense_id": "04a3a561-15e0-392b-8625-4d23ad3e4e51",
                                                "text": "But it would resound in the conservative media's echo chamber."
                                            },
                                            {
                                                "example_id": "42710bb6-e08e-4fa2-9c9e-481ccc5f1f5a",
                                                "sense_id": "04a3a561-15e0-392b-8625-4d23ad3e4e51",
                                                "text": "“What you’re going to end up doing is amplifying within an echo chamber, which is really different from what the movement wants,” said Dana Fisher, a professor of sociology at the University of Maryland whose research focuses on activism."
                                            },
                                            {
                                                "example_id": "58411964-2660-4167-81aa-479f3504fbdf",
                                                "sense_id": "04a3a561-15e0-392b-8625-4d23ad3e4e51",
                                                "text": "The videos were tailored for the “echo chamber” that is often created by social media networks like YouTube. To keep you watching, YouTube serves up videos similar to those you have watched before."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
