        "fr-extract.jsonl": [
            {
                "entry_id": "cbd1ed52-a808-31e8-8b25-f50a1af7594a",
                "word": "giberne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9cff5021-4a33-4b82-b9d4-4b931165a730",
                        "entry_id": "cbd1ed52-a808-31e8-8b25-f50a1af7594a",
                        "tags": [
