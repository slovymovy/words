                ],
                "senses": [
                    {
                        "sense_id": "f379735a-9165-3959-9a50-2399d1ec47cd",
                        "entry_id": "b97f80c5-61f8-33ae-8c5f-5ebec54fe3e1",
                        "glosses": [
                            "To shield around or about; protect; defend."
                        ],
                        "tags": [
                            "archaic",
                            "reflexive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3f5fbabc-21c2-43d5-af85-b1c32d0a39d6",
                                "sense_id": "f379735a-9165-3959-9a50-2399d1ec47cd",
                                "text": "Beshield thee with thy troops; find out at will Fresh instruments of war, and unknown gear; For thou shalt not scape death from this my hand, O slayer of the dames, so brave and grand."
                            },
                            {
                                "example_id": "09c115bd-15ef-491e-877e-78447f59eac0",
                                "sense_id": "f379735a-9165-3959-9a50-2399d1ec47cd",
                                "text": "[…]that in that same night Olympia might behold the god Hamon lying beside her, and saying to her thereafter, 'Woman, thou hast conceived him who shall beshield thee."
                            },
                            {
                                "example_id": "ebea8522-ae9e-4210-a005-50b310d3a3b6",
                                "sense_id": "f379735a-9165-3959-9a50-2399d1ec47cd",
                                "text": "Of course I was frightened — frightened of being struck, or beshamed, during the next tone-show — so cast about for someone to beshield me."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9c706ca-1c8e-359c-a6c3-5e815e5af9b0",
                        "entry_id": "b97f80c5-61f8-33ae-8c5f-5ebec54fe3e1",
                        "glosses": [
                            "To provide or outfit with a shield."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "44ceb4d6-7e70-483b-9f6a-f66b4f1bfc6c",
                                "sense_id": "d9c706ca-1c8e-359c-a6c3-5e815e5af9b0",
                                "text": "Our bearers now began to call themselves Natal Kafirs, fearing to say they were Zulus before the young Amaswazi warriors, beplumed, beshielded, bespeared, perched about here and there in picturesque unconsciousness of their picturesqueness."
                            }
                        ]
                    }
