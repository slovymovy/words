{
    "word_family": [
        "access",
        "accessibility",
        "inaccessible",
        "inaccessibility",
        "accessibly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b37af978-4d58-367b-b274-02a3e8d951ed",
                    "sense_definition": "Easy to reach, enter, or approach.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The remote village is only <w>accessible</w> by boat during the summer.",
                            "target_lang_translations": {
                                "ru": "Эта отдаленная деревня <w>доступна</w> только на лодке в летнее время.",
                                "zh": "夏天时，这座偏远的村庄只能乘船<w>到达</w>。",
                                "pl": "Ta odległa wioska jest latem <w>dostępna</w> tylko łodzią."
                            }
                        },
                        {
                            "text": "We chose a hotel that is easily <w>accessible</w> from the main train station.",
                            "target_lang_translations": {
                                "ru": "Мы выбрали отель, который легко <w>доступен</w> от главного железнодорожного вокзала.",
                                "zh": "我们选了一家从火车站去非常<w>方便</w>的酒店。",
                                "pl": "Wybraliśmy hotel, który jest łatwo <w>dostępny</w> z głównego dworca kolejowego."
                            }
                        }
                    ],
                    "synonyms": [
                        "approachable"
                    ],
                    "antonyms": [
                        "inaccessible"
                    ],
                    "common_phrases": [
                        "easily accessible",
                        "accessible by car",
                        "accessible location",
                        "accessible to the public"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий для достижения, входа или приближения.",
                        "zh": "容易到达、进入或接近的。",
                        "pl": "Łatwy do dotarcia, wejścia lub zbliżenia się."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "досту́пный",
                                "target_lang_sense_clarification": "о месте или объекте"
                            },
                            {
                                "target_lang_word": "достижи́мый",
                                "target_lang_sense_clarification": "до которого можно добраться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可到达的",
                                "target_lang_sense_clarification": "指地理位置或场所"
                            },
                            {
                                "target_lang_word": "易于接近的",
                                "target_lang_sense_clarification": "指物理上的便利性"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dostępny",
                                "target_lang_sense_clarification": "o miejscu lub obiekcie, do którego można łatwo dotrzeć"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e41c0ef-89dd-3aba-97ca-4a8d08179844",
                    "sense_definition": "Built or designed to be usable by people with disabilities.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new library entrance is fully <w>accessible</w> to wheelchair users.",
                            "target_lang_translations": {
                                "ru": "Новый вход в библиотеку полностью <w>доступен</w> для пользователей инвалидных колясок.",
                                "zh": "新图书馆的入口对轮椅使用者完全<w>无障碍</w>。",
                                "pl": "Nowe wejście do biblioteki jest w pełni <w>dostępne</w> dla osób poruszających się na wózkach inwalidzkich."
                            }
                        },
                        {
                            "text": "They are working to make the company website <w>accessible</w> for visually impaired people.",
                            "target_lang_translations": {
                                "ru": "Они работают над тем, чтобы сделать сайт компании <w>доступным</w> для людей с нарушениями зрения.",
                                "zh": "他们正致力于让公司网站对视障人士实现<w>无障碍</w>访问。",
                                "pl": "Pracują nad tym, aby strona internetowa firmy była <w>dostępna</w> dla osób niedowidzących."
                            }
                        }
                    ],
                    "antonyms": [
                        "inaccessible"
                    ],
                    "common_phrases": [
                        "wheelchair accessible",
                        "accessible bathroom",
                        "accessible facilities",
                        "accessible design"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приспособленный для использования людьми с ограниченными возможностями.",
                        "zh": "为残障人士设计或改造，使其能够使用的。",
                        "pl": "Zaprojektowany lub przystosowany do użytku przez osoby z niepełnosprawnościami."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "досту́пный",
                                "target_lang_sense_clarification": "безбарьерный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无障碍的",
                                "target_lang_sense_clarification": "指设施或环境对残障人士友好"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dostępny",
                                "target_lang_sense_clarification": "bez barier architektonicznych"
                            },
                            {
                                "target_lang_word": "przystosowany",
                                "target_lang_sense_clarification": "dla osób z niepełnosprawnościami"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "930526b8-6b3c-3552-88f2-416e8cbac1f0",
                    "sense_definition": "Able to be obtained, used, or seen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These confidential documents are not <w>accessible</w> to the general public.",
                            "target_lang_translations": {
                                "ru": "Эти конфиденциальные документы не <w>доступны</w> широкой публике.",
                                "zh": "这些机密文件公众无法<w>获取</w>。",
                                "pl": "Te poufne dokumenty nie są <w>dostępne</w> dla ogółu społeczeństwa."
                            }
                        },
                        {
                            "text": "Information about the project is readily <w>accessible</w> on the internet.",
                            "target_lang_translations": {
                                "ru": "Информация о проекте легко <w>доступна</w> в интернете.",
                                "zh": "关于该项目的信息在网上很容易<w>查到</w>。",
                                "pl": "Informacje o projekcie są łatwo <w>dostępne</w> w internecie."
                            }
                        }
                    ],
                    "antonyms": [
                        "inaccessible"
                    ],
                    "common_phrases": [
                        "readily accessible",
                        "freely accessible",
                        "accessible information",
                        "accessible data"
                    ],
                    "target_lang_definitions": {
                        "ru": "Такой, который можно получить, использовать или увидеть.",
                        "zh": "可以获得、使用或看到的。",
                        "pl": "Taki, który można uzyskać, wykorzystać lub zobaczyć."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "досту́пный",
                                "target_lang_sense_clarification": "имеющийся в наличии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可获取的",
                                "target_lang_sense_clarification": "指信息或资源"
                            },
                            {
                                "target_lang_word": "可利用的",
                                "target_lang_sense_clarification": "指资源或数据"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dostępny",
                                "target_lang_sense_clarification": "będący w zasięgu lub posiadaniu"
                            },
                            {
                                "target_lang_word": "osiągalny",
                                "target_lang_sense_clarification": "możliwy do zdobycia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66de9cae-1bb2-321b-b471-0e8910eea171",
                    "sense_definition": "Easy to understand or appreciate.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor wrote a book to make physics <w>accessible</w> to ordinary readers.",
                            "target_lang_translations": {
                                "ru": "Профессор написал книгу, чтобы сделать физику <w>доступной</w> для обычных читателей.",
                                "zh": "教授写了一本书，旨在让普通读者也能<w>读懂</w>物理学。",
                                "pl": "Profesor napisał książkę, aby uczynić fizykę <w>przystępną</w> dla zwykłych czytelników."
                            }
                        },
                        {
                            "text": "Her poetry is complex but still <w>accessible</w> enough for students to enjoy.",
                            "target_lang_translations": {
                                "ru": "Ее поэзия сложна, но все же достаточно <w>понятна</w>, чтобы студенты могли получить от нее удовольствие.",
                                "zh": "她的诗歌虽然复杂，但依然足够<w>易懂</w>，学生们也能欣赏。",
                                "pl": "Jej poezja jest złożona, ale wciąż wystarczająco <w>przystępna</w>, by studenci mogli czerpać z niej przyjemność."
                            }
                        }
                    ],
                    "synonyms": [
                        "approachable"
                    ],
                    "antonyms": [
                        "inaccessible"
                    ],
                    "common_phrases": [
                        "accessible language",
                        "accessible style",
                        "accessible art",
                        "accessible to beginners"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий для понимания или восприятия.",
                        "zh": "容易理解或欣赏的。",
                        "pl": "Łatwy do zrozumienia lub docenienia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "досту́пный",
                                "target_lang_sense_clarification": "простой для понимания"
                            },
                            {
                                "target_lang_word": "поня́тный",
                                "target_lang_sense_clarification": "ясный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "易懂的",
                                "target_lang_sense_clarification": "指内容或风格"
                            },
                            {
                                "target_lang_word": "通俗易懂的",
                                "target_lang_sense_clarification": "指知识或艺术作品"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przystępny",
                                "target_lang_sense_clarification": "łatwy do zrozumienia, jasny"
                            },
                            {
                                "target_lang_word": "zrozumiały",
                                "target_lang_sense_clarification": "jasny w odbiorze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd386699-cff1-39e0-a49c-eae6211536e6",
                    "sense_definition": "Friendly and easy to talk to.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite his fame, the actor remained <w>accessible</w> and kind to his fans.",
                            "target_lang_translations": {
                                "ru": "Несмотря на свою славу, актер оставался <w>доступным</w> и добрым к своим поклонникам.",
                                "zh": "尽管很有名，这位演员对粉丝依然保持<w>平易近人</w>且友善。",
                                "pl": "Mimo swojej sławy aktor pozostał <w>przystępny</w> i życzliwy dla swoich fanów."
                            }
                        },
                        {
                            "text": "She is a very <w>accessible</w> manager who always listens to her staff.",
                            "target_lang_translations": {
                                "ru": "Она очень <w>открытый</w> менеджер, который всегда выслушивает своих сотрудников.",
                                "zh": "她是一位非常<w>亲切</w>的经理，总是愿意倾听员工的心声。",
                                "pl": "Jest bardzo <w>otwartą</w> menedżerką, która zawsze słucha swoich pracowników."
                            }
                        }
                    ],
                    "synonyms": [
                        "approachable",
                        "easy-going",
                        "friendly",
                        "welcoming"
                    ],
                    "common_phrases": [
                        "accessible personality",
                        "accessible manner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дружелюбный и легкий в общении.",
                        "zh": "友善且容易交谈的。",
                        "pl": "Przyjazny i łatwy w kontakcie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "досту́пный",
                                "target_lang_sense_clarification": "открытый в общении"
                            },
                            {
                                "target_lang_word": "демократи́чный",
                                "target_lang_sense_clarification": "простой в обращении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "平易近人的",
                                "target_lang_sense_clarification": "指人的性格"
                            },
                            {
                                "target_lang_word": "亲切的",
                                "target_lang_sense_clarification": "指待人态度"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "otwarty",
                                "target_lang_sense_clarification": "łatwy w nawiązywaniu kontaktu"
                            },
                            {
                                "target_lang_word": "przystępny",
                                "target_lang_sense_clarification": "o człowieku, z którym łatwo porozmawiać"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "858c93ec-0518-3203-9e54-83262ecaf48f",
                    "sense_definition": "Open to being influenced or affected by something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was so angry that he was not <w>accessible</w> to reason.",
                            "target_lang_translations": {
                                "ru": "Он был так зол, что был не <w>доступен</w> доводам рассудка.",
                                "zh": "他太生气了，根本<w>听不进</w>任何道理。",
                                "pl": "Był tak zły, że nie był <w>podatny</w> na argumenty."
                            }
                        },
                        {
                            "text": "A mind <w>accessible</w> to new ideas is essential for personal growth.",
                            "target_lang_translations": {
                                "ru": "Разум, <w>восприимчивый</w> к новым идеям, необходим для личностного роста.",
                                "zh": "一个能够<w>接受</w>新思想的头脑对于个人成长至关重要。",
                                "pl": "Umysł <w>otwarty</w> na nowe pomysły jest niezbędny do rozwoju osobistego."
                            }
                        }
                    ],
                    "common_phrases": [
                        "accessible to reason",
                        "accessible to pity"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Открытый для влияния или воздействия чего-либо.",
                        "zh": "容易受到某种事物影响或感动的。",
                        "pl": "Otwarty na wpływ lub oddziaływanie czegoś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восприи́мчивый",
                                "target_lang_sense_clarification": "к идеям или доводам"
                            },
                            {
                                "target_lang_word": "поддаю́щийся",
                                "target_lang_sense_clarification": "влиянию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "易受影响的",
                                "target_lang_sense_clarification": "指思想或态度"
                            },
                            {
                                "target_lang_word": "善于接受的",
                                "target_lang_sense_clarification": "指对新观念的态度"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "podatny",
                                "target_lang_sense_clarification": "na wpływy lub argumenty"
                            },
                            {
                                "target_lang_word": "otwarty",
                                "target_lang_sense_clarification": "na nowe idee lub argumenty"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}