{
    "word_family": [
        "lot",
        "lottery",
        "allot",
        "allotment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "54c258e9-e65d-301b-bf49-da7cecb58ed4",
                    "sense_definition": "A large number or amount; a great deal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_large_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She made <w>lots</w> of new friends during her trip to Spain.",
                            "target_lang_translations": {
                                "ru": "Она завела <w>много</w> новых друзей во время поездки в Испанию.",
                                "zh": "她在西班牙旅行期间交了<w>许多</w>新朋友。"
                            }
                        },
                        {
                            "text": "Don't worry about the bill because my family has <w>lots</w> of money.",
                            "target_lang_translations": {
                                "ru": "Не беспокойся о счете, потому что у моей семьи <w>куча</w> денег.",
                                "zh": "别担心账单，因为我家有<w>大量</w>资金。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plenty",
                        "loads",
                        "heaps",
                        "tons",
                        "many"
                    ],
                    "antonyms": [
                        "little",
                        "few"
                    ],
                    "common_phrases": [
                        "lots of",
                        "lots to do",
                        "lots and lots"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in spoken and informal English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество или объем; очень много.",
                        "zh": "指代大量或许多。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "много",
                                "target_lang_sense_clarification": "большое количество"
                            },
                            {
                                "target_lang_word": "куча",
                                "target_lang_sense_clarification": "разговорное; очень много"
                            },
                            {
                                "target_lang_word": "масса",
                                "target_lang_sense_clarification": "множество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "许多",
                                "target_lang_sense_clarification": "表示数量多"
                            },
                            {
                                "target_lang_word": "大量",
                                "target_lang_sense_clarification": "表示数量或规模大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1114371c-6df3-3244-ba2c-384e3e6724f7",
                    "sense_definition": "Plural of <w>lot</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction company purchased two empty <w>lots</w> to build new houses.",
                            "target_lang_translations": {
                                "ru": "Строительная компания купила два пустых <w>участка</w> для постройки новых домов.",
                                "zh": "建筑公司购买了两个空<w>地块</w>来建造新房。"
                            }
                        },
                        {
                            "text": "The auctioneer sold several <w>lots</w> of antique furniture to the highest bidders.",
                            "target_lang_translations": {
                                "ru": "Аукционист продал несколько <w>лотов</w> антикварной мебели тем, кто предложил самую высокую цену.",
                                "zh": "拍卖师将几<w>批</w>古董家具卖给了出价最高的人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число слова «lot» (земельный участок, лот на аукционе, партия товара).",
                        "zh": "指土地的划分区域，或拍卖会中成组出售的商品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "участки",
                                "target_lang_sense_clarification": "земли"
                            },
                            {
                                "target_lang_word": "лоты",
                                "target_lang_sense_clarification": "на аукционе"
                            },
                            {
                                "target_lang_word": "партии",
                                "target_lang_sense_clarification": "товара"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地块",
                                "target_lang_sense_clarification": "指土地的划分区域"
                            },
                            {
                                "target_lang_word": "拍品",
                                "target_lang_sense_clarification": "指拍卖会中的成组商品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c5d9bfb8-0226-3704-b847-1e79913f67f7",
                    "sense_definition": "A great deal; very much.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_large_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I feel <w>lots</w> better about the situation now that we have talked.",
                            "target_lang_translations": {
                                "ru": "Я чувствую себя <w>намного</w> лучше по поводу ситуации теперь, когда мы поговорили.",
                                "zh": "既然我们谈过了，我对现在的情况感觉好<w>得多</w>了。"
                            }
                        },
                        {
                            "text": "He cares <w>lots</w> about the welfare of the animals in the shelter.",
                            "target_lang_translations": {
                                "ru": "Он <w>очень</w> заботится о благополучии животных в приюте.",
                                "zh": "他<w>非常</w>关心收容所里动物的福利。"
                            }
                        }
                    ],
                    "synonyms": [
                        "much",
                        "a lot",
                        "way",
                        "heaps",
                        "significantly"
                    ],
                    "antonyms": [
                        "little"
                    ],
                    "common_phrases": [
                        "lots better",
                        "lots more"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal intensifier"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Значительно; очень сильно (обычно используется для усиления сравнения).",
                        "zh": "表示程度深，非常。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намного",
                                "target_lang_sense_clarification": "перед сравнительной степенью"
                            },
                            {
                                "target_lang_word": "гораздо",
                                "target_lang_sense_clarification": "синоним «намного»"
                            },
                            {
                                "target_lang_word": "очень",
                                "target_lang_sense_clarification": "сильно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "程度副词"
                            },
                            {
                                "target_lang_word": "得多",
                                "target_lang_sense_clarification": "用于比较级后表示程度差异大"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "007fef0a-96ed-38cb-84f7-ead983367034",
                    "sense_definition": "Third-person singular simple present indicative of <w>lot</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The auction house <w>lots</w> the items carefully before the catalogue is published.",
                            "target_lang_translations": {
                                "ru": "Аукционный дом тщательно <w>разбивает на лоты</w> предметы перед публикацией каталога.",
                                "zh": "拍卖行在目录发布前会仔细地将物品<w>分批</w>。"
                            }
                        },
                        {
                            "text": "She <w>lots</w> the goods into different categories for the sale.",
                            "target_lang_translations": {
                                "ru": "Она <w>сортирует</w> товары по разным категориям для распродажи.",
                                "zh": "她为了促销将商品按不同类别进行<w>分类</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Третье лицо единственного числа настоящего времени глагола «lot» (разбивать на лоты, сортировать).",
                        "zh": "将物品分类或编组，通常用于拍卖或销售。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбивает на лоты",
                                "target_lang_sense_clarification": "аукционные предметы"
                            },
                            {
                                "target_lang_word": "сортирует",
                                "target_lang_sense_clarification": "распределяет по группам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分批",
                                "target_lang_sense_clarification": "将物品分成若干批次"
                            },
                            {
                                "target_lang_word": "分类",
                                "target_lang_sense_clarification": "按类别整理"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}