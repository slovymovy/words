                            {
                                "example_id": "815aa6d8-7d42-473d-bdb5-dd2d98027029",
                                "sense_id": "009073b4-f693-3657-93eb-505580de7370",
                                "text": "Par conséquent, même si les « grandes fêtes » des villages vallespiriens ont une origine religieuse, les populations locales y ajoutent des activités profanes, dont la plus traditionnelle demeure la danse de la sardane."
                            }
                        ]
                    },
