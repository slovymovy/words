                ],
                "senses": [
                    {
                        "sense_id": "eada4f9e-a3a6-3f4c-b93b-7935cc7aa8b0",
                        "entry_id": "39e3f9b9-c667-3d2e-b893-7f7ba7e69481",
                        "glosses": [
                            "onlosmakelijk met elkaar verbonden; niet in twee of meer afzonderlijke zaken te scheiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1afcb4db-a76d-437a-a298-68b6dc3e8448",
                                "sense_id": "eada4f9e-a3a6-3f4c-b93b-7935cc7aa8b0",
                                "text": "Leven en werk zijn onscheidbaar, concludeert Passage dan ook. 'Zijn leven wàs primair: schrijven.' Niettemin besteedt hij ook volop aandacht aan het rommelige liefdesleven dat Van der Kallen er op na moet hebben gehouden, aan de vele vriendinnen die in de boeken min of meer herkenbaar werden opgevoerd en aan de bijbehorende gevoelens die er eveneens in kunnen worden nagelezen."
                            },
                            {
                                "example_id": "47cbed59-ee35-4753-949f-a70a35d3314d",
                                "sense_id": "eada4f9e-a3a6-3f4c-b93b-7935cc7aa8b0",
                                "text": "De rechtse kranten stonden vol met ontboezemingen over het thema dat schoonheid en geschiedenis onscheidbare grootheden waren en dat een gebouw dat mooi gevonden wilde worden symbool moest staan voor de eeuwige waarden, moest herinneren aan een trots en geestrijker verleden en dat platte daken bovendien on-Duits waren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09c06754-908e-4394-b425-eef492652200",
                        "source_entry_id": "39e3f9b9-c667-3d2e-b893-7f7ba7e69481",
                        "source_sense_id": "eada4f9e-a3a6-3f4c-b93b-7935cc7aa8b0",
                        "source_sense_description": "als twee of meer verschillende zaken niet meer uit elkaar gehaald kunnen worden na menging",
                        "target_lang_word": "untrennbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "untrennbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eafd4676-f17a-30c2-b270-06ebd76f3bd4",
                                        "entry_id": "717b2547-d753-31f2-acf5-eaa3f231d82c",
                                        "glosses": [
                                            "nicht voneinander zu trennen"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64e468c5-4f4b-4ec2-ae6c-dcbb9247a06f",
                                                "sense_id": "eafd4676-f17a-30c2-b270-06ebd76f3bd4",
                                                "text": "Sie bilden eine untrennbare Einheit."
                                            },
                                            {
                                                "example_id": "74e8808e-275e-4f27-bbad-886c644b56b7",
                                                "sense_id": "eafd4676-f17a-30c2-b270-06ebd76f3bd4",
                                                "text": "„Gegen Ende des 19. Jahrhunderts war die Degenerationslehre in Westeuropa (und teilweise in Nordamerika) untrennbar verknüpft mit dem Sozialdarwinismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
