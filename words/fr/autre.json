    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9996968b-9f93-313f-96e7-e3559bb45139",
                    "sense_definition": "Qui est distinct, différent de la personne ou de la chose dont il s'agit.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous pouvons choisir un <w>autre</w> chemin pour éviter les embouteillages ce matin."
                        },
                        {
                            "text": "Elle a décidé de visiter une <w>autre</w> ville pendant ses vacances d'été."
                        }
                    ],
                    "synonyms": [
                        "distinct"
                    ],
                    "antonyms": [
                        "même"
                    ],
                    "common_phrases": [
                        "un autre jour",
                        "une autre fois",
                        "d'autres personnes"
                    ]
                },
                {
                    "sense_id": "82c973a2-187e-3973-a540-2ff18ff8e94c",
                    "sense_definition": "Qui ressemble fortement à quelqu'un ou à quelque chose, au point d'en être l'équivalent.",
