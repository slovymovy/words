                                    {
                                        "sense_id": "29b81189-4084-359c-a633-dd7d13e49a4f",
                                        "entry_id": "a6325815-b718-3316-a9c5-cb68773ee0ed",
                                        "glosses": [
                                            "Having undergone decay, rotted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbc5d6b9-b2fa-46e2-ba6a-a56765e35b7d",
                                                "sense_id": "29b81189-4084-359c-a633-dd7d13e49a4f",
                                                "text": "The decayed remains of the pilot's shirt showed where the plane had been shot down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23ff1b8e-3c72-3d57-90ce-739cad424498",
