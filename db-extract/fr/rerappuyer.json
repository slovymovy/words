                "senses": [
                    {
                        "sense_id": "81515ff9-c22c-3b1d-9c13-fa8ae7edc52d",
                        "entry_id": "84830b3e-b1cd-3d17-9f7e-9f7c90a43ede",
                        "glosses": [
                            "Rappuyer une nouvelle fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1256f8da-0ccd-4f81-bd93-23112b6c7109",
                                "sense_id": "81515ff9-c22c-3b1d-9c13-fa8ae7edc52d",
                                "text": "Il suffit de garder le pied appuyé sur la pédale, relâcher, rerappuyer en gardant le pied, rerelâcher …"
                            },
                            {
                                "example_id": "26f7c10e-e051-4328-80e8-726226a4f674",
                                "sense_id": "81515ff9-c22c-3b1d-9c13-fa8ae7edc52d",
                                "text": "Je prépare le petit déjeuner en regardant mes mails sur mon AIRIS 740, je rerappuie sur le Snooze de mon réveil sans m’en rendre compte puisque je suis encore et toujours en plein sommeil"
                            },
                            {
                                "example_id": "5ae1d8fd-3992-4407-9ae4-8e05bb7ea49b",
                                "sense_id": "81515ff9-c22c-3b1d-9c13-fa8ae7edc52d",
                                "text": "(Cas énervant classique: Homeplayer rame → je suis pas sûr d’avoir bien appuyé donc je rappuie → Homeplayer rame encore plus → je rerappuie → plantage)."
                            }
                        ]
                    }
