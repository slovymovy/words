                "senses": [
                    {
                        "sense_id": "46ef5cd8-0247-3119-93fb-20dd1fc721dc",
                        "entry_id": "db79621f-a3e2-3ae0-9668-e10d21c59dde",
                        "glosses": [
                            "kultura towarzyska, dobre maniery, umiejętność właściwego zachowania się"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e11c492c-f5c7-40de-be78-e889fe527e85",
                                "sense_id": "46ef5cd8-0247-3119-93fb-20dd1fc721dc",
                                "text": "I rozjarzam się na mgnienie w uśmiechu z tych, co to trzeba mieć ten polor we krwi, żeby zmieścić bez pośpiechu pozdrowienie, mimo energicznego pośpiechu przecież."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1abc6a86-9aea-3f6f-8011-7332e2c90bc5",
                        "entry_id": "db79621f-a3e2-3ae0-9668-e10d21c59dde",
                        "glosses": [
                            "cecha tego, co jest wykwintne i wytworne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e162077f-5ded-4f33-9a6e-28b3b3803e74",
                                "sense_id": "1abc6a86-9aea-3f6f-8011-7332e2c90bc5",
                                "text": "Ja mówię, że poezji nie ma bez poloru, a polor być nie może tam, gdzie nie ma dworu."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
