                "senses": [
                    {
                        "sense_id": "46feb3a8-f4d8-3b50-9639-452c9a673555",
                        "entry_id": "ad9c3cc0-b773-3a72-a97a-39cf76d14828",
                        "glosses": [
                            "kleiner Fuß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7f2c2b4-42f6-4c40-a932-0457fd8cb11f",
                                "sense_id": "46feb3a8-f4d8-3b50-9639-452c9a673555",
                                "text": "Die Mutter zog dem Baby Söckchen über die Füßchen."
                            },
                            {
                                "example_id": "b4705fd0-e0e4-4e57-ac8d-451c61dc8b65",
                                "sense_id": "46feb3a8-f4d8-3b50-9639-452c9a673555",
                                "text": "„Ich nahm sie in der folgenden Nacht wieder auf und erblickte die vier Füßchen bis zum Knöchel.“"
                            },
                            {
                                "example_id": "7633ae69-385b-484a-87f5-d8cbb13b4117",
                                "sense_id": "46feb3a8-f4d8-3b50-9639-452c9a673555",
                                "text": "„Sie saßen auf Acrylstühlen für Erwachsene, so dass ihre Füßchen in den glänzenden Schuhen über dem Fußboden baumelten.“"
                            },
                            {
                                "example_id": "0fee216d-7d26-4644-8cf4-a306deb897d6",
                                "sense_id": "46feb3a8-f4d8-3b50-9639-452c9a673555",
                                "text": "„Blumenschmuck umrahmte ihr gepudertes Antlitz, und unter dem Rocke im Hunan-Schnitte schauten rote Füßchen, winzig wie Mandarinenenten, hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0aa1ad0-5732-4ca2-880a-e28fa1da33ba",
                        "source_entry_id": "ad9c3cc0-b773-3a72-a97a-39cf76d14828",
                        "source_sense_id": "46feb3a8-f4d8-3b50-9639-452c9a673555",
                        "source_sense_description": "kleiner Fuß",
                        "target_lang_word": "tootsie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tootsie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "591accc2-020b-30e8-bd1c-4c678794a35c",
                                        "entry_id": "77223cab-8d94-3c3f-8a2a-c2af6e0ece2b",
                                        "glosses": [
                                            "A young woman."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4c3fa2f-0d01-3e47-bde7-3ca444ac8650",
                                        "entry_id": "77223cab-8d94-3c3f-8a2a-c2af6e0ece2b",
                                        "glosses": [
                                            "A toe."
                                        ],
                                        "tags": [
                                            "childish",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31f8e07c-13c2-4911-b8d3-2071d5760e79",
                                                "sense_id": "d4c3fa2f-0d01-3e47-bde7-3ca444ac8650",
                                                "text": "And a hoofer by the name of Buck Wing was gettin' ready to shake his tootsies!"
                                            },
                                            {
                                                "example_id": "05d9ada0-f71f-40be-9143-a3cc6111e312",
                                                "sense_id": "d4c3fa2f-0d01-3e47-bde7-3ca444ac8650",
                                                "text": "Swedish massage techniques applied to your feet have reflexology effects, too, and give those tootsies the break they need."
                                            },
                                            {
                                                "example_id": "64768e11-f200-4fec-a141-c517b527a9fa",
                                                "sense_id": "d4c3fa2f-0d01-3e47-bde7-3ca444ac8650",
                                                "text": "2006, James W. Brann, MD, Women's Healthcare Topics.com, Surviving the Joy of Pregnancy, James Brann →ISBN\nSwollen tootsies can be very uncomfortable, not to mention you may not like looking at them. Toes that look like sausages? That's attractive for babies, but you aren't looking at baby's tootsies."
                                            },
                                            {
                                                "example_id": "92c7f7af-2a87-4782-ad71-f2baf23e966b",
                                                "sense_id": "d4c3fa2f-0d01-3e47-bde7-3ca444ac8650",
                                                "text": "Babies are fascinated with their toes. Take advantage of this interest. Join in your baby's fun. Ten Little Tootsies (to “Ten Little Indians”) One little, two little, three little tootsies."
                                            },
                                            {
                                                "example_id": "0511bfda-172a-4106-a06c-0beedd33418e",
                                                "sense_id": "d4c3fa2f-0d01-3e47-bde7-3ca444ac8650",
                                                "text": "So what's a gal to do when she's rushing about town in pointy-toe stilettos with no time to rest her weary tootsies?"
                                            },
                                            {
                                                "example_id": "6753bf91-a867-4a29-a8bb-31a5a8974d57",
                                                "sense_id": "d4c3fa2f-0d01-3e47-bde7-3ca444ac8650",
                                                "text": "Take off your shoes and give those tootsies a break!"
                                            },
                                            {
                                                "example_id": "3220192c-ce3d-4b64-ae64-3f01441472c5",
                                                "sense_id": "d4c3fa2f-0d01-3e47-bde7-3ca444ac8650",
                                                "text": "You forgot your toe warmers this morning. ... Can't have my girl's tootsies cold.\" \"Don't say aw again,\" Eve ordered, anticipating. \"And never say tootsies. You're wearing badges, for God's sake"
                                            },
                                            {
                                                "example_id": "2b5e7572-80ca-478e-8573-7cbf883ecf49",
                                                "sense_id": "d4c3fa2f-0d01-3e47-bde7-3ca444ac8650",
                                                "text": "Weymouth is the place for us to paddle our tootsies like George III, but first we need somewhere to stay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4c5d61a-240d-3084-b8fa-c0bc641048a2",
                                        "entry_id": "77223cab-8d94-3c3f-8a2a-c2af6e0ece2b",
                                        "glosses": [
                                            "A foot, especially that of a woman or child."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
