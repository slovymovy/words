                                    {
                                        "sense_id": "7c53b526-02e1-38e2-b4f7-eb6dd0aba58f",
                                        "entry_id": "c9d3bcac-a685-3285-9649-ff925bfd952d",
                                        "glosses": [
                                            "The function or duty of an ambassador."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "652d3fa9-bf60-4803-aeeb-a9e8a7905d65",
                                                "sense_id": "7c53b526-02e1-38e2-b4f7-eb6dd0aba58f",
                                                "text": "The King told me, […] That I ſhould have the Character of Ambaſſador Extraordinary, and the ſame Allovvance I ſhou'd have had in Spain: Upon this Offer I made no Demurr, but immediately accepted it, and ſo my Ambaſſy vvas declar'd in May 1674."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c80bc8f-069a-3814-b2b7-ce0d0f0d9872",
                                        "entry_id": "c9d3bcac-a685-3285-9649-ff925bfd952d",
                                        "glosses": [
                                            "An organization or group of officials who permanently represent a sovereign state in a second sovereign state or with respect to an international organization such as the United Nations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb0bfb09-79ed-48ed-84e5-bafedde6e530",
                                                "sense_id": "4c80bc8f-069a-3814-b2b7-ce0d0f0d9872",
                                                "text": "The American embassy to France is located in Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bc72c80-5c76-3a74-855e-dcb0ce1e0982",
                                        "entry_id": "c9d3bcac-a685-3285-9649-ff925bfd952d",
                                        "glosses": [
                                            "A temporary mission representing a sovereign state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23f29f35-495a-4267-aa10-9476d846b286",
                                                "sense_id": "7bc72c80-5c76-3a74-855e-dcb0ce1e0982",
                                                "text": "The Japanese embassy to the United States traveled to Washington, D.C., where it was received by James Buchanan, before continuing on to New York and then returning to Japan, making several stops on the way."
                                            },
                                            {
                                                "example_id": "02533be5-58a5-4d56-82d8-6e8d95471211",
                                                "sense_id": "7bc72c80-5c76-3a74-855e-dcb0ce1e0982",
                                                "text": "Then go we in to know his embassy;\nWhich I could with a ready guess declare\nBefore the Frenchman speak a word of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e685861d-cbaa-3adf-84ed-f65c659d3167",
                                        "entry_id": "c9d3bcac-a685-3285-9649-ff925bfd952d",
                                        "glosses": [
                                            "The official residence of such a group, or of an ambassador."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19000d44-2a85-3721-94f3-74c57849d16c",
                                        "entry_id": "c9d3bcac-a685-3285-9649-ff925bfd952d",
                                        "glosses": [
                                            "A written account as to an embassy."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94c71f1d-ef84-441e-ac7a-18c44ac9184d",
                                                "sense_id": "19000d44-2a85-3721-94f3-74c57849d16c",
                                                "text": "By the various Relations, Embaſſies and Voyages of Siam that have been publiſht within theſe laſt Four Years […]"
                                            }
                                        ]
                                    }
                                ]
