                "senses": [
                    {
                        "sense_id": "644e1adb-a4c7-3f3d-a59b-c45254a8f9b1",
                        "entry_id": "9cae35e5-5aee-3488-9764-4ae3b5aae5a3",
                        "glosses": [
                            "Enlever son caractère anatomique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "303a6a2f-c5aa-4440-94fe-c28aa48e9fd4",
                                "sense_id": "644e1adb-a4c7-3f3d-a59b-c45254a8f9b1",
                                "text": "Ça désanatomise la localisation sexuelle du plaisir, au point qu’en effet…"
                            },
                            {
                                "example_id": "84b54c44-b5f8-476d-9a0f-9100423f06a3",
                                "sense_id": "644e1adb-a4c7-3f3d-a59b-c45254a8f9b1",
                                "text": "Plus question d’aire, de bornage, de biffure : l’enclos se produit au grand air, all over the place la figure post-anatomique, désanatomisée qui se promène dans le fragment, l’intervalle : le jeu des perles de verre à l’état premier."
                            },
                            {
                                "example_id": "2dda5605-57ed-45b7-af53-e369de45d262",
                                "sense_id": "644e1adb-a4c7-3f3d-a59b-c45254a8f9b1",
                                "text": "Je ne vais peut-être pas détailler, mais les personnages sont tout d’un coup désanatomisés et posés un peu n’importe comment."
                            }
                        ]
                    }
                ],
