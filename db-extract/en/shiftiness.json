                                "example_id": "2aeb63b8-137b-4867-a93d-bbb3b95f115c",
                                "sense_id": "657c53a7-9120-3187-93ca-6649533f1b25",
                                "text": "Mr. Henderson's chief trouble seems to be that he cannot forget his old shiftiness of views and his pendulum-like swingings between Liberalism and Independent Labourism[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "ebad8f1d-1303-3829-a80f-72a70d7f9971",
                        "entry_id": "9312fe4e-de9b-38cf-b5fa-e7888915fea5",
                        "glosses": [
                            "The result or product of being shifty."
                        ],
                        "tags": [
                            "countable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "190a3bc1-8bd0-413b-ab2a-b6cc5d2b87be",
                                "sense_id": "ebad8f1d-1303-3829-a80f-72a70d7f9971",
                                "text": "I had the grace or humility sometimes to see myself as a mass of shiftinesses; a few dogmas might help to steady me."
