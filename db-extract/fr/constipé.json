                "senses": [
                    {
                        "sense_id": "667ac01f-c916-3afa-8032-067549b93f6b",
                        "entry_id": "d6593782-59dd-3ca4-b3cf-52cef2e59fe5",
                        "glosses": [
                            "Personne atteinte de constipation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee3a5cfe-a098-4097-a6f6-b9242c847807",
                                "sense_id": "667ac01f-c916-3afa-8032-067549b93f6b",
                                "text": "Nous préciserons seulement quelques notions générales indispensables à connaître pour traiter un constipé."
                            },
                            {
                                "example_id": "c44ee34a-3db9-41f3-b8b5-dad97414229d",
                                "sense_id": "667ac01f-c916-3afa-8032-067549b93f6b",
                                "text": "Ceux-là feuillettent avidement quelques conseils sexuels pour la jeunesse ou les Dix Commandements du Constipé, en ayant l’air de s’intéresser au Voyage en Orient, de Gérard de Nerval."
                            }
                        ]
                    },
                    {
                        "sense_id": "a192e56b-c24c-3ccd-bd6a-79686c790d25",
                        "entry_id": "d6593782-59dd-3ca4-b3cf-52cef2e59fe5",
                        "glosses": [
                            "Personne embarrassée, contrainte, qui reste sur sa réserve."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "99ae8425-4f99-460b-949b-a85abc444aa3",
                                "sense_id": "a192e56b-c24c-3ccd-bd6a-79686c790d25",
                                "text": "En septembre 2008, Siné, l’ennemi héréditaire des constipés de la pensée, était évacué de Charlie Hebdo par un rédacteur en chef déflatulé."
                            }
                        ]
                    }
