                    },
                    {
                        "translation_id": "3bf52d91-f820-4a02-a14d-701bce6255e2",
                        "source_entry_id": "6da2e993-b4fd-39bf-b922-c15d59f1498a",
                        "source_sense_description": "Celle qui assiste à un spectacle, etc.",
                        "target_lang_word": "Zuschauerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuschauerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d4658ee-7480-343b-8fb2-5a23462d3941",
                                        "entry_id": "9d8d46d1-a0a3-3511-bccd-85b8644f820e",
                                        "glosses": [
                                            "weibliche Person, die sich eine Vorführung oder Veranstaltung ansieht (zum Beispiel ein Theaterstück, ein Film, eine Fernsehsendung, eine Sportveranstaltung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce3dfd6-5900-475f-a393-17a3093e3404",
                                                "sense_id": "1d4658ee-7480-343b-8fb2-5a23462d3941",
                                                "text": "Die zahlreichen Zuschauerinnen freuten sich lautstark über den Boxkampf, was ihn befremdete."
                                            },
                                            {
                                                "example_id": "61b7f9db-28e4-4e8d-bf4e-6cf2d52e0e4c",
                                                "sense_id": "1d4658ee-7480-343b-8fb2-5a23462d3941",
                                                "text": "„Durch einen Zufall, und weil sie nichts zu tun hatte, geriet sie als Zuschauerin in einen Prozeß in einen Gerichtssaal in Frankfurt.“"
                                            },
                                            {
                                                "example_id": "3bbcdb91-f194-413d-9132-c5c11adb7a50",
                                                "sense_id": "1d4658ee-7480-343b-8fb2-5a23462d3941",
                                                "text": "„Sie saß da wie eine Zuschauerin in einer Theateraufführung.“"
                                            },
                                            {
                                                "example_id": "faca24ee-7ba7-4d54-ab89-d148a34fcf4d",
                                                "sense_id": "1d4658ee-7480-343b-8fb2-5a23462d3941",
                                                "text": "„Ich erblickte die schönsten Damen von Turin, die sich in ihrer Eigenschaft als Zuschauerinnen einbilden konnten, man gebe den Ball nur für sie.“"
                                            },
                                            {
                                                "example_id": "0d7d99f4-e677-4734-96d3-82c64aae7b7e",
                                                "sense_id": "1d4658ee-7480-343b-8fb2-5a23462d3941",
                                                "text": "„Als ich vor einiger Zeit ein Gastspiel in Köln gab, kam ich während der Pause mit einer Zuschauerin ins Gespräch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d22d56dd-032d-4eab-bef5-b9729f1d75b0",
                        "source_entry_id": "6da2e993-b4fd-39bf-b922-c15d59f1498a",
                        "source_sense_description": "Celle qui assiste à un spectacle, etc.",
                        "target_lang_word": "spectator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spectator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f730e29-3f0f-3406-86bc-07dc39652b40",
                                        "entry_id": "e5cfde1e-618c-3cd1-af5c-7248bd8a941a",
                                        "glosses": [
                                            "One who watches an event; especially, an event held outdoors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f280f02-d3c9-42b8-84bd-1b8e20d45fe6",
                                                "sense_id": "0f730e29-3f0f-3406-86bc-07dc39652b40",
                                                "text": "The cheering spectators watched the fireworks."
                                            },
                                            {
                                                "example_id": "5afc0e61-20f3-4c3c-a38e-738a23592965",
                                                "sense_id": "0f730e29-3f0f-3406-86bc-07dc39652b40",
                                                "text": "Bart spies an opportunity to make a quick buck so he channels his inner carny and posits his sinking house as a natural wonder of the world and its inhabitants as freaks, barking to dazzled spectators, “Behold the horrors of the Slanty Shanty! See the twisted creatures that dwell within! Meet Cue-Ball, the man with no hair!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8068c67a-9cfd-38d8-aa8d-f521a4239ee7",
                                        "entry_id": "e5cfde1e-618c-3cd1-af5c-7248bd8a941a",
                                        "glosses": [
                                            "One who observes, sees, or views something; an observer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52d82f65-6963-4698-bd82-9187a40da04f",
                                                "sense_id": "8068c67a-9cfd-38d8-aa8d-f521a4239ee7",
                                                "text": "The ſpring diſplaying her elegant taſte, the proud walk of the gold-feathered pheaſant, the light tread of the ſmall-hoofed hind, and the dancing of the ſtar-trained peacock, infuſed joy into the ſoul of the ſpectator of the aſtoniſhing works of the Creator."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02b7cedd-c1be-43b6-95b9-5108e8b6f01c",
                        "source_entry_id": "6da2e993-b4fd-39bf-b922-c15d59f1498a",
