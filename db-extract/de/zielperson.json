                ],
                "senses": [
                    {
                        "sense_id": "d2e1f066-6ec7-3931-a44f-467930acf179",
                        "entry_id": "49db4fa6-1d49-3ec0-b155-bfbd8a0fb537",
                        "glosses": [
                            "Person, welche das Ziel einer Aktion ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12e61542-3699-4987-a539-4714c4545215",
                                "sense_id": "d2e1f066-6ec7-3931-a44f-467930acf179",
                                "text": "„Die Zielperson war zu Hause, aber das war nicht weiter verwunderlich.“"
                            },
                            {
                                "example_id": "8cdb2abf-b2f4-4755-80b7-ef28a6388da2",
                                "sense_id": "d2e1f066-6ec7-3931-a44f-467930acf179",
                                "text": "„Andere Bewaffnete, erklärte er, würden sich um die Leibwächter kümmern, die den Kandidaten umringten, der Attentäter brauche sich nur auf die eigentliche Zielperson zu konzentrieren.“"
                            },
                            {
                                "example_id": "84823776-dbbb-4b40-b4b9-c1555b3c005f",
                                "sense_id": "d2e1f066-6ec7-3931-a44f-467930acf179",
                                "text": "„Wir haben noch circa sechzehn Stunden bis zum Beginn der Operation. Bis die Killer und die Anderen aus ihrem Bau kriechen und ihre Zielpersonen abknallen.“"
                            },
                            {
                                "example_id": "d3419367-8aa2-4e19-99dc-eb17fb079850",
                                "sense_id": "d2e1f066-6ec7-3931-a44f-467930acf179",
                                "text": "„Wenn er an die Zielpersonen dachte, die er zur Strecke gebracht hatte, diese begrabenen und ihm gutgeschriebenen Leute, dann lenkte ein gewisses Grausen schon seine Gedanken in diese schulderfüllte Richtung.“"
                            },
                            {
                                "example_id": "425caa3c-2370-4fe4-98b4-47ac4d8bbd81",
                                "sense_id": "d2e1f066-6ec7-3931-a44f-467930acf179",
                                "text": "„Es ist nicht einfach, jemanden zu verfolgen, den man kennt, besonders, wenn die Zielperson weiß, dass man ein Detektiv ist und am selben Fall arbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
