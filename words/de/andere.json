            "senses": [
                {
                    "sense_id": "0415cce3-e4d2-31ba-a30a-e69ffce5ec4d",
                    "sense_definition": "Nicht dieselbe oder derselbe; bezeichnet eine zweite, zusätzliche oder unterschiedliche Person oder Sache (Form von <w>anderer</w>).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich möchte lieber die <w>andere</w> Jacke kaufen, weil sie viel wärmer ist."
                        },
                        {
                            "text": "Viele <w>andere</w> Gäste sind bereits vor dem Beginn des Konzerts im Saal angekommen."
                        }
                    ],
                    "synonyms": [
                        "weitere",
                        "übrige"
                    ],
                    "antonyms": [
                        "gleiche",
                        "selbe"
                    ],
                    "common_phrases": [
                        "die andere Seite",
                        "das andere Geschlecht",
                        "alle anderen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba4eb6b8-2a77-39c3-8363-487a2f8b3a48",
                    "sense_definition": "Eine zusätzliche oder fremde weibliche Person, die nicht mit der bereits genannten identisch ist.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die eine Schwester wollte Ärztin werden, während die <w>Andere</w> lieber Musik studieren wollte."
                        },
                        {
                            "text": "Er hat seine Partnerin verlassen, weil er sich in eine <w>Andere</w> verliebt hat."
                        }
                    ],
                    "common_phrases": []
                },
                {
                    "sense_id": "9499145f-cacd-31bc-a265-2c2efc15902a",
                    "sense_definition": "Pluralform von <w>Anderer</w>; bezeichnet Mitmenschen oder mehrere nicht näher bestimmte Personen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Manche Kollegen machten sofort Feierabend, doch viele <w>Andere</w> arbeiteten noch bis spät in die Nacht."
                        },
                        {
                            "text": "Wir sollten nicht nur an uns selbst denken, sondern stets Rücksicht auf <w>Andere</w> nehmen."
                        }
                    ],
                    "synonyms": [
                        "Mitmenschen"
                    ],
                    "common_phrases": [
                        "Rücksicht auf Andere"
                    ]
                }
            ]
        }
