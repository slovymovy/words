{
    "word_family": [
        "entreaty",
        "entreating"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3d888aed-ab51-3ab7-9a6d-76cf5517b6ff",
                    "sense_definition": "An earnest request or plea.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plea",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ignored his repeated <w>entreats</w> to stay and left the room in silence.",
                            "target_lang_translations": {
                                "cs": "Ignorovala jeho opakované <w>prosby</w>, aby zůstala, a v tichosti opustila místnost.",
                                "ru": "Она проигнорировала его неоднократные <w>мольбы</w> остаться и молча покинула комнату."
                            }
                        },
                        {
                            "text": "Despite his desperate <w>entreats</w> for mercy, the judge remained unmoved by his story.",
                            "target_lang_translations": {
                                "cs": "Navzdory jeho zoufalým <w>úpěnlivým prosbám</w> o milost zůstal soudce jeho příběhem nedotčen.",
                                "ru": "Несмотря на его отчаянные <w>мольбы</w> о пощаде, судья остался равнодушен к его истории."
                            }
                        }
                    ],
                    "synonyms": [
                        "entreaty"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This noun form is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Naléhavá nebo vroucí prosba či žádost.",
                        "ru": "Горячая, настоятельная просьба или мольба."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "prosba",
                                "target_lang_sense_clarification": "naléhavá žádost"
                            },
                            {
                                "target_lang_word": "úpěnlivá prosba",
                                "target_lang_sense_clarification": "zoufale naléhavá prosba"
                            },
                            {
                                "target_lang_word": "žádost",
                                "target_lang_sense_clarification": "formálnější prosba"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мольба",
                                "target_lang_sense_clarification": "страстная, горячая просьба"
                            },
                            {
                                "target_lang_word": "умоляющая просьба",
                                "target_lang_sense_clarification": "настоятельное прошение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f2670293-8c3f-3e10-bd31-c8820354f8ae",
                    "sense_definition": "To ask someone earnestly or beg them to do something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plea",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>entreat</w> you to reconsider your decision before it is too late for everyone.",
                            "target_lang_translations": {
                                "cs": "<w>Úpěnlivě vás prosím</w>, abyste své rozhodnutí přehodnotil, než bude pro všechny příliš pozdě.",
                                "ru": "Я <w>умоляю</w> вас пересмотреть свое решение, пока не стало слишком поздно для всех."
                            }
                        },
                        {
                            "text": "The mother continued to <w>entreat</w> the officials to release her son from custody.",
                            "target_lang_translations": {
                                "cs": "Matka dál <w>zapřísahala</w> úředníky, aby jejího syna propustili z vazby.",
                                "ru": "Мать продолжала <w>молить</w> чиновников отпустить ее сына из-под стражи."
                            }
                        }
                    ],
                    "synonyms": [
                        "supplicate"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vroucně někoho žádat nebo úpěnlivě prosit o vykonání něčeho.",
                        "ru": "Горячо, убедительно просить или умолять кого-либо сделать что-либо."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "úpěnlivě prosit",
                                "target_lang_sense_clarification": "naléhavě a vroucně žádat"
                            },
                            {
                                "target_lang_word": "zapřísahat",
                                "target_lang_sense_clarification": "naléhavě dovolávat se, prosit"
                            },
                            {
                                "target_lang_word": "žádat",
                                "target_lang_sense_clarification": "vroucně či naléhavě prosit"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "умолять",
                                "target_lang_sense_clarification": "горячо просить о милости или помощи"
                            },
                            {
                                "target_lang_word": "молить",
                                "target_lang_sense_clarification": "страстно просить"
                            },
                            {
                                "target_lang_word": "заклинать",
                                "target_lang_sense_clarification": "настоятельно, с мольбой призывать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4d8f876-94c0-39e5-b8a4-38fd1eb784fb",
                    "sense_definition": "To treat or handle someone or something in a specific way.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deal_with",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoners were <w>entreated</w> with great cruelty by their captors during the war.",
                            "target_lang_translations": {
                                "cs": "Během války bylo se zajatci ze strany jejich věznitelů <w>nakládáno</w> s nesmírnou krutostí.",
                                "ru": "Во время войны захватчики <w>обращались</w> с пленными с чрезвычайной жестокостью."
                            }
                        },
                        {
                            "text": "He was <w>entreated</w> kindly by his hosts, who provided him with food and shelter.",
                            "target_lang_translations": {
                                "cs": "Hostitelé s ním <w>jednali</w> laskavě a poskytli mu jídlo i přístřeší.",
                                "ru": "Хозяева <w>обошлись</w> с ним доброжелательно, предоставив ему пищу и кров."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely restricted to historical or literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Knižně či zastarale: zacházet s někým nebo něčím určitým způsobem.",
                        "ru": "Устаревшее значение: обращаться с кем-либо или обходиться определенным образом."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nakládat",
                                "target_lang_sense_clarification": "zacházet s někým (zastaralé)"
                            },
                            {
                                "target_lang_word": "zacházet",
                                "target_lang_sense_clarification": "jednat s někým (zastaralé)"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "обращаться",
                                "target_lang_sense_clarification": "обходиться с кем-либо (устаревшее)"
                            },
                            {
                                "target_lang_word": "обходиться",
                                "target_lang_sense_clarification": "вести себя по отношению к кому-либо (устаревшее)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
