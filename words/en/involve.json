{
    "word_family": [
        "involvement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32850684-bcb0-35f2-ace3-7aca87619a7b",
                    "sense_definition": "To have something as a necessary part or result.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "inclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My job <w>involves</w> forecasting economic trends.",
                            "target_lang_translations": {
                                "ru": "Моя работа <w>предполагает</w> прогнозирование экономических тенденций.",
                                "tr": "Benim işim ekonomik eğilimleri tahmin etmeyi <w>gerektiriyor</w>."
                            }
                        },
                        {
                            "text": "Renovating the old house will <w>involve</w> a lot of hard work.",
                            "target_lang_translations": {
                                "ru": "Ремонт старого дома <w>потребует</w> много тяжелой работы.",
                                "tr": "Eski evi restore etmek çok fazla sert çalışma <w>gerektirecek</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "include",
                        "require"
                    ],
                    "antonyms": [
                        "exclude"
                    ],
                    "common_phrases": [
                        "involve a lot of work",
                        "involve risk",
                        "involve changes",
                        "involve costs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Включать в себя как необходимую часть или результат; предполагать наличие чего-либо.",
                        "tr": "Gerekli bir parça veya sonuç olarak bir şeyi içermek, gerektirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "включать (в себя)",
                                "target_lang_sense_clarification": "содержать как составную часть"
                            },
                            {
                                "target_lang_word": "предполагать",
                                "target_lang_sense_clarification": "иметь условием или следствием"
                            },
                            {
                                "target_lang_word": "влечь за собой",
                                "target_lang_sense_clarification": "иметь своим результатом"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gerektirmek",
                                "target_lang_sense_clarification": "bir şeyin zorunlu sonucu olmak"
                            },
                            {
                                "target_lang_word": "içermek",
                                "target_lang_sense_clarification": "kapsamına almak veya dahil etmek"
                            },
                            {
                                "target_lang_word": "kapsamak",
                                "target_lang_sense_clarification": "içine almak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f70dcc3-c660-30ae-ac06-a9ba78e5acf4",
                    "sense_definition": "To cause someone to participate in an activity or situation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "participation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are always trying to <w>involve</w> new technology in our products.",
                            "target_lang_translations": {
                                "ru": "Мы всегда стараемся <w>задействовать</w> новые технологии в наших продуктах.",
                                "tr": "Ürünlerimize her zaman yeni teknolojileri <w>dahil etmeye</w> çalışıyoruz."
                            }
                        },
                        {
                            "text": "The school wants to <w>involve</w> parents in the decision-making process.",
                            "target_lang_translations": {
                                "ru": "Школа хочет <w>привлечь</w> родителей к процессу принятия решений.",
                                "tr": "Okul, velileri karar alma sürecine <w>katmak</w> istiyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "include"
                    ],
                    "antonyms": [
                        "exclude"
                    ],
                    "common_phrases": [
                        "involve the community",
                        "involve students",
                        "involve parents",
                        "involve the audience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекать кого-либо к участию в деятельности или ситуации.",
                        "tr": "Birini bir etkinliğe veya duruma katılmaya yöneltmek, dahil etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вовлекать",
                                "target_lang_sense_clarification": "побуждать к участию в чем-либо"
                            },
                            {
                                "target_lang_word": "привлекать",
                                "target_lang_sense_clarification": "приглашать к участию в деле"
                            },
                            {
                                "target_lang_word": "задействовать",
                                "target_lang_sense_clarification": "использовать или вводить в действие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dahil etmek",
                                "target_lang_sense_clarification": "bir işe veya gruba katmak"
                            },
                            {
                                "target_lang_word": "katmak",
                                "target_lang_sense_clarification": "sürece veya etkinliğe eklemek"
                            },
                            {
                                "target_lang_word": "olaya çekmek",
                                "target_lang_sense_clarification": "bir sürece katılımını sağlamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b80048bc-9a1d-38d3-813f-84d36db5813b",
                    "sense_definition": "To connect someone to a difficult situation or a crime.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "implication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not want to <w>involve</w> him in my personal affairs.",
                            "target_lang_translations": {
                                "ru": "Я не хочу <w>впутывать</w> его в свои личные дела.",
                                "tr": "Onu kişisel işlerime <w>karıştırmak</w> istemiyorum."
                            }
                        },
                        {
                            "text": "The new evidence seemed to <w>involve</w> the manager in the theft.",
                            "target_lang_translations": {
                                "ru": "Новые улики, казалось, <w>уличали</w> менеджера в краже.",
                                "tr": "Yeni kanıtlar müdürü hırsızlığa <w>bulaştırıyor</w> gibi görünüyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "implicate"
                    ],
                    "common_phrases": [
                        "involve in a scandal",
                        "involve in a crime",
                        "involve in debt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Впутывать или замешивать кого-либо в неприятную ситуацию или преступление.",
                        "tr": "Birini zor bir duruma veya suça bulaştırmak, ilişkilendirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впутывать",
                                "target_lang_sense_clarification": "вовлекать в неприятное или сложное дело"
                            },
                            {
                                "target_lang_word": "замешивать",
                                "target_lang_sense_clarification": "делать соучастником чего-либо предосудительного"
                            },
                            {
                                "target_lang_word": "запутывать",
                                "target_lang_sense_clarification": "сбивать с толку или вовлекать в неприятности"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bulaştırmak",
                                "target_lang_sense_clarification": "kötü bir işin içine sokmak"
                            },
                            {
                                "target_lang_word": "karıştırmak",
                                "target_lang_sense_clarification": "bir suça veya olumsuz duruma ortak etmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}