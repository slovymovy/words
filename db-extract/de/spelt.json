                        "examples": [
                            {
                                "example_id": "51832a7d-0bf3-4457-8a85-14f0f985398b",
                                "sense_id": "eb8876dc-746e-375b-80e0-89c36afc8979",
                                "text": "Ziemlich gleich kommt dem Weizen der Spelt, auch Dinkel genannt, der in kälteren Gegenden leichter gedeiht, an Nährgehalt hinter dem Weizen kaum zurücksteht und, wie vielfach behauptet wird, zu Mehlspeisen in mancher Beziehung noch geeigneter ist als das Weizenmehl."
                            }
                        ]
                    }
