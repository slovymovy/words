                                        "glosses": [
                                            "een kredietinstelling waar leningen afgesloten kunnen worden tegen een onderpand van roerende goederen, waarbij die goederen bij niet terugbetalen door de lommerd worden verkocht."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd58c76-5919-4296-ba21-3cdcb0122892",
                                                "sense_id": "b1686533-8f7c-36d5-84ab-b5712fc40a0d",
                                                "text": "Bij de lommerd kunnen juwelen, zilverwerk, kunst- en siervoorwerpen en boeken als onderpand gebruikt worden als lening."
                                            }
