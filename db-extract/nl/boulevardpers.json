        "nl-extract.jsonl": [
            {
                "entry_id": "8e4f3f03-c49b-3f11-9e01-fd2ea81fe23e",
                "word": "boulevardpers",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "df4e1733-c18f-3524-960b-e850e929cbc2",
                        "entry_id": "8e4f3f03-c49b-3f11-9e01-fd2ea81fe23e",
                        "glosses": [
                            "een krant waarin zeer veel aandacht gaat naar sport, roddel, (seks)schandalen van beroemdheden, de \\\"sterren\\\", het (tv-)amusement en sensationele verhalen over extreme en vaak ook zeer gewelddadige moorden, verkrachtingen en berovingen"
                        ],
                        "tags": [
                            "media"
                        ],
                        "examples": [
                            {
                                "example_id": "8272c260-8fa6-45a1-8ca1-54eeda94f87e",
                                "sense_id": "df4e1733-c18f-3524-960b-e850e929cbc2",
                                "text": "De foto was aangeboden aan de Britse boulevardpers, maar die weigerde ze. Britse tabloids zijn huiverig voor het plaatsen van dit soort voyeuristische foto's na het fotoschandaal van vorig jaar. William en Kate klaagden toen roddelbladen aan nadat er topless foto's waren geplaatst."
                            },
                            {
                                "example_id": "412d18a2-73d4-49df-924c-a366c630f4b4",
                                "sense_id": "df4e1733-c18f-3524-960b-e850e929cbc2",
                                "text": "Klopp heeft volgens de Duitse boulevardpers een buitenechtelijke verhouding gehad met een spelersvrouw, is door zijn eigen vrouw de deur uitgezet en neemt om die reden na dit seizoen afscheid bij Dortmund."
                            }
                        ]
                    }
