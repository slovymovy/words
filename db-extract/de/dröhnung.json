                ],
                "senses": [
                    {
                        "sense_id": "bc4d5e61-ce32-33c2-a7df-9960bef2d755",
                        "entry_id": "c31b25d4-193a-3557-af1e-67a74cded24b",
                        "glosses": [
                            "gewisse Menge, eine Portion, an Rauschmittel (Alkohol, Drogen), die geeignet ist, einen Rauschzustand zu bewirken"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5619ad00-ffdb-4074-92c5-bfe0912ad82a",
                                "sense_id": "bc4d5e61-ce32-33c2-a7df-9960bef2d755",
                                "text": "Nun gib mir mal eine ordentliche Dröhnung, zwei Fingerbreit Rum gehören schon in einen richtigen Grog. Mindestens."
                            },
                            {
                                "example_id": "54ef9c88-3368-4097-bd95-af133f3aaf46",
                                "sense_id": "bc4d5e61-ce32-33c2-a7df-9960bef2d755",
                                "text": "„Und jetzt kommen die Leute her, und bringen ihre Dröhnung mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0bb6d1d7-ea7e-3054-98d2-88aad7428edf",
                        "entry_id": "c31b25d4-193a-3557-af1e-67a74cded24b",
                        "glosses": [
                            "durch Rauschmittel ausgelöster Rauschzustand"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "bcbc1a11-4e2b-4fbe-b6e4-d3c56300d178",
                                "sense_id": "0bb6d1d7-ea7e-3054-98d2-88aad7428edf",
                                "text": "„Das Elixier ist extrem beliebt, da es geraucht, getrunken, als Zusatz im Keksteig genutzt werden kann oder auch, so wird behauptet, um damit Würstchen zu braten für das himmlische Genusserlebnis einer Dröhnung mit gleichzeitiger Stillung des daraus resultierenden Heißhungers.“"
                            },
                            {
                                "example_id": "97aca0f0-69a4-47d2-ad67-d6ffc3dc246b",
                                "sense_id": "0bb6d1d7-ea7e-3054-98d2-88aad7428edf",
                                "text": "„Mit voller Dröhnung kann sie ihn bestimmt besser ertragen. Als sie an der Hütte ankommen, einem voll spießigen Schrebergartenhäuschen mit Hollywoodschaukel, Gartenzwergen und Deutschlandfahne, ist sie schon ziemlich high.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d3fd377f-086b-35bd-91d6-dcbf35ce6e0d",
                        "entry_id": "c31b25d4-193a-3557-af1e-67a74cded24b",
                        "glosses": [
                            "volle Lautstärke"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "d622ce88-3d19-4860-a871-fe199b36ba15",
                                "sense_id": "d3fd377f-086b-35bd-91d6-dcbf35ce6e0d",
                                "text": "Dreh auf! Das muss man einfach mal richtig laut hören! Los! Mit voller Dröhnung! Ich will die Bässe fühlen!"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
