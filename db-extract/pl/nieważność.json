                ],
                "translations": [
                    {
                        "translation_id": "c3ee07d0-3176-4b95-8a41-752523f14ca8",
                        "source_entry_id": "ccd80646-7bd7-3b86-9bd7-3133188f5f38",
                        "source_sense_id": "66807ce3-59c0-302f-95c9-d44a635afd0a",
                        "target_lang_word": "Unwichtigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unwichtigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14da6f32-512c-3767-a2fd-c407d3eaacd5",
                                        "entry_id": "ee08ddb2-2a75-38cf-a3e3-fd9ee74265c1",
                                        "glosses": [
                                            "Eigenschaft, keine Bedeutung/Relevanz zu haben; etwas ohne Bedeutung/Relevanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd063b14-6e8c-490e-8d5f-113bd15f0024",
                                                "sense_id": "14da6f32-512c-3767-a2fd-c407d3eaacd5",
                                                "text": "„Es gibt ein Problem, das aus den Zeitungen und Fernsehnachrichten seit geraumer Zeit abgetaucht ist. Dieses Abtauchen allerdings ist kein Indiz für Unwichtigkeit, sondern im Gegenteil ein Hinweis auf die Gefährlichkeit des Problems.“"
                                            },
                                            {
                                                "example_id": "c51934f5-49e4-48e2-b42a-3eecd9cfc61b",
                                                "sense_id": "14da6f32-512c-3767-a2fd-c407d3eaacd5",
                                                "text": "„Ein gutes Training, um sein Gefühl für die Wichtigkeit oder Unwichtigkeit von Farben zu schulen, ist das Fotografieren im Schwarz-Weiß-Modus der Kamera, rät der Photoindustrie-Verband.“"
                                            },
                                            {
                                                "example_id": "785e9f9e-c9ea-4f45-ab94-604610a21219",
                                                "sense_id": "14da6f32-512c-3767-a2fd-c407d3eaacd5",
                                                "text": "„Die Benachrichtigungen sollte man bei Xing einfach abstellen. So wird man dann weniger durch Unwichtigkeiten bei der Arbeit und privat nach Feierabend genervt.“"
                                            },
                                            {
                                                "example_id": "34c480f0-6691-4da2-9109-8e1bbd092ea4",
                                                "sense_id": "14da6f32-512c-3767-a2fd-c407d3eaacd5",
                                                "text": "„Vergessen scheint Ziemiaks offene Attacke noch vor wenigen Wochen, als er die große Koalition nur als ‚großes Chaos‘ bezeichnete und auch der CDU vorwarf, sich in Unwichtigkeiten zu verzetteln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
