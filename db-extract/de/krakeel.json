                                    },
                                    {
                                        "sense_id": "ef3a2729-9f55-3ff3-bb38-267bafb4b915",
                                        "entry_id": "155fe3a5-d1d6-3c3b-957e-3a7a8a0d5aa8",
                                        "glosses": [
                                            "Alternative form of branle (“dance of French origin dating from the 16th century, performed by couples in a circle or a line; the music for this dance”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e678249e-fea6-4949-a017-a8dde801701d",
                                                "sense_id": "ef3a2729-9f55-3ff3-bb38-267bafb4b915",
                                                "text": "Boy. Maiſter, will you win your loue with a french braule? / Brag[gart]. How meaneſt thou? brawling in French. / Boy. No my complet Maiſter, but to Iigge off a tune at the tongues ende, canarie to it with your feete, humour it with turning vp your eylids, ſigh a note and ſing a note ſomtime through the throate, if you ſwallowed loue with ſinging loue [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cbaa5e4-260a-4d08-8bd9-cbacae484b8e",
                        "source_entry_id": "268c3d10-961c-3c33-abba-7de7a3b86732",
                        "source_sense_id": "85feab63-0433-3749-89d7-06b40c478f89",
                        "source_sense_description": "lärmendes Verhalten, lautstarke Auseinandersetzung",
                        "target_lang_word": "grabuge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grabuge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d0113e6-0012-3c9b-addd-29179d040008",
                                        "entry_id": "93d5049c-1d46-37c5-94be-ebab3f405c60",
                                        "glosses": [
                                            "Querelle bruyante entraînant du désordre."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "745bcebf-5a56-48ad-b5cc-70a5ad283270",
                                                "sense_id": "8d0113e6-0012-3c9b-addd-29179d040008",
                                                "text": "Non, il y a du grabuge, répondit Rigou en touchant de son index droit la main que lui tendait Soudry; […]."
                                            },
                                            {
                                                "example_id": "0548d288-4f58-4732-836d-f04f4def6f7e",
                                                "sense_id": "8d0113e6-0012-3c9b-addd-29179d040008",
                                                "text": "Allons, il y a du grabuge ; je parie que c’est encore François qui se rebiffe."
                                            },
                                            {
                                                "example_id": "9ef41f5f-2cc8-4b39-b915-2cf71a911110",
                                                "sense_id": "8d0113e6-0012-3c9b-addd-29179d040008",
                                                "text": "Mais ils n’ont osé arrêter personne, trop heureux qu’hier il n’y ait pas eu de grabuge."
                                            },
                                            {
                                                "example_id": "635efeeb-ade4-4391-be14-c4c9b2d90e05",
                                                "sense_id": "8d0113e6-0012-3c9b-addd-29179d040008",
                                                "text": "À l’heure où nous en sommes, il y avait précisément du grabuge au château, et l’on échangeait à table, ou après dîner, dans les coins, des expressions très peu propres à former l'oreille d'une enfant."
                                            },
                                            {
                                                "example_id": "95aa1a0e-762e-4873-832d-3bf9d9b34dc5",
                                                "sense_id": "8d0113e6-0012-3c9b-addd-29179d040008",
                                                "text": "Après, j’ai l’intention de rester dans les parages pendant une semaine ou deux avant de repartir, c’est-à-dire, à moins qu’il n’y ait du grabuge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
