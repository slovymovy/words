                                "target_senses": [
                                    {
                                        "sense_id": "3579405b-a353-3809-949f-ec7518728582",
                                        "entry_id": "2a0af6dd-52d2-3020-83d4-3fe30c1de778",
                                        "glosses": [
                                            "A dark reddish-brown colour, often used to describe hair colour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "auburn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b126f33-61dd-3684-9f17-b5f979546fc9",
                                        "entry_id": "53d5348e-0419-3d26-b1f3-95873cd901eb",
                                        "glosses": [
                                            "Of a reddish-brown colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e3575d4-9642-428c-8998-7ae76b0f451e",
                                                "sense_id": "4b126f33-61dd-3684-9f17-b5f979546fc9",
                                                "text": "All were watching somebody in the garden with deep interest, their three faces close together: a jovial and round one, a pale one with dark hair, and a fair one whose tresses were auburn. “Don’t push! You can see as well as I,” said Retty, the auburn-haired and youngest girl, without removing her eyes from the window."
                                            },
                                            {
                                                "example_id": "ab71e06a-0deb-4fad-b7a6-f69482f779a0",
                                                "sense_id": "4b126f33-61dd-3684-9f17-b5f979546fc9",
                                                "text": "[…]; nor was Miss Wilkinson the ideal: he had often pictured to himself the great violet eyes and the alabaster skin of some lovely girl, and he had thought of himself burying his face in the rippling masses of her auburn hair."
                                            },
                                            {
                                                "example_id": "da3d8897-6885-429d-ab29-b74885cff4d8",
                                                "sense_id": "4b126f33-61dd-3684-9f17-b5f979546fc9",
                                                "text": "I never thought I'd meet a girl like you / Meet a girl like you / With auburn hair and tawny eyes"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
