                    }
                ],
                "senses": [
                    {
                        "sense_id": "a55aff37-009f-37f8-aa9b-8a9b92a13216",
                        "entry_id": "c15519f9-e4f3-32c7-a2b3-2fe86092d73c",
                        "glosses": [
                            "lustige theaterische Darstellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93aaeb5d-1ef4-4adb-b14d-a50113ff6591",
                                "sense_id": "a55aff37-009f-37f8-aa9b-8a9b92a13216",
                                "text": "Das Theaterstück „Wie es euch gefällt“ von William Shakespeare ist ein Lustspiel."
                            },
                            {
                                "example_id": "89e1d66a-6cfe-4c93-8557-f8e1979ea106",
                                "sense_id": "a55aff37-009f-37f8-aa9b-8a9b92a13216",
                                "text": "„Es war eines jener schwankartigen Lustspiele, bei denen auch der unerfahrenste Theaterbesucher von der ersten Minute an weiß, daß das Liebespaar sich kriegen wird, so finster manchmal auch der Himmel dräuen mag.“"
                            },
                            {
                                "example_id": "d594d452-c811-4ef9-a523-1776c6cd45eb",
                                "sense_id": "a55aff37-009f-37f8-aa9b-8a9b92a13216",
                                "text": "„Ein Lustspiel aus dem achtzehnten Jahrhundert wurde gespielt.“"
                            },
                            {
                                "example_id": "22fb772c-34cf-4f20-923a-5d651fcdad5e",
                                "sense_id": "a55aff37-009f-37f8-aa9b-8a9b92a13216",
                                "text": "„Er reicht jetzt dasselbe Lustspiel in Versen mit den verlangten Änderungen ein und verzichtet auf alle Rechte und die Autorenentschädigung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
