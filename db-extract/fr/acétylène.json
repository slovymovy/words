                    {
                        "translation_id": "d2f4d211-e2d8-453b-9c63-aeeeaef7f4f3",
                        "source_entry_id": "b99fb642-f610-3943-a5a4-7d2959e7cde8",
                        "source_sense_id": "508f8254-43ef-32d5-8c7e-d9226e94e7ee",
                        "target_lang_word": "ацетилен",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ацетилен",
