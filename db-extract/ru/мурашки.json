                                        "entry_id": "caf197d3-7013-3ff6-8f2b-7219eb3e1666",
                                        "glosses": [
                                            "Pluriel de fourmillement."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcd04b43-2795-420f-a0e0-671755d082d4",
                                                "sense_id": "5020209a-f88c-3fb9-a677-0f727f8fe786",
                                                "text": "Il agita ses jambes comme pour les débarrasser des fourmillements qui les parcouraient."
