                ],
                "senses": [
                    {
                        "sense_id": "7f18d57d-52d1-38bb-9b78-c50b7f16c3cc",
                        "entry_id": "37b31907-3974-3b69-9f67-5cf751471acf",
                        "glosses": [
                            "eine baulich verschieden ausgestaltete regelbare Öffnung in einem Raum, deren hauptsächliche Funktion darin besteht, bedarfsgerecht den Raum zu lüften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d50dd8-ad2f-40de-bcf9-1a69a8cd1e34",
                                "sense_id": "7f18d57d-52d1-38bb-9b78-c50b7f16c3cc",
                                "text": "„Das schicke Sonnendach mit Lüftungsfenstern lässt auch in großer Hitze genügend Luft durch – dafür sorgt die feine Netzstruktur.“"
                            },
                            {
                                "example_id": "b5ac14a0-f444-4768-a6b6-cc619314871b",
                                "sense_id": "7f18d57d-52d1-38bb-9b78-c50b7f16c3cc",
                                "text": "„Gemäss LSV muss der Nachweis erbracht werden, dass der IGW in der Mitte des Lüftungsfensters der lärmempfindlichen Räume eingehalten werden kann.“"
                            },
                            {
                                "example_id": "31c58bb8-a073-40a2-8710-89f67d1f5c09",
                                "sense_id": "7f18d57d-52d1-38bb-9b78-c50b7f16c3cc",
                                "text": "„Die maßgefertigten Lamellen- und Filtersysteme passen auf Venlo-Lüftungsfenster und durchgehende Lüftungsfenster und können sowohl in bestehenden als auch in neu gebauten Gewächshäusern eingesetzt werden.“"
                            },
                            {
                                "example_id": "9f824978-e13a-4f37-8b89-fb33e0567267",
                                "sense_id": "7f18d57d-52d1-38bb-9b78-c50b7f16c3cc",
                                "text": "„Das neuentwickelte Lüftungssystem von Kömmerling besteht aus einem nach neuesten Erkenntnissen bei Lüftungsfenstern entwickelten Standardsystem für einen exakt kalkulierten Luftaustausch zwischen Außen- und Raumluft sowie einer innovativen \"KöClimat\" Lüfterleiste, mit der eine gleichbleibende Frischluftzufuhr witterungsunabhängig vollautomatisch geregelt wird.“"
                            },
                            {
                                "example_id": "b89cf57c-5708-48db-8a0f-60ab7827707a",
                                "sense_id": "7f18d57d-52d1-38bb-9b78-c50b7f16c3cc",
                                "text": "„Diese Lüftungsfenster laufen über die ganze Länge des Daches.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
