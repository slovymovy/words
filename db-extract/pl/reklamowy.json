                        "examples": [
                            {
                                "example_id": "b7bd9d64-b95e-4da7-b09a-845a8cbe8152",
                                "sense_id": "397cf6a3-4740-330c-9ba5-4f1da27fbacb",
                                "text": "Słup reklamowy jest słupem, na którym znajdują się reklamy."
                            },
                            {
                                "example_id": "79c9210d-3b78-4e86-b643-5bac5339f596",
                                "sense_id": "397cf6a3-4740-330c-9ba5-4f1da27fbacb",
                                "text": "Najbardziej rażące i łatwe do zauważenia są zawieszki w tekstach reklamowych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
