                "senses": [
                    {
                        "sense_id": "51ea7cef-9c9f-3465-bd51-f837edcac345",
                        "entry_id": "c4469193-b399-388f-a9c1-27398ffc0feb",
                        "glosses": [
                            "Donner un caractère cristallin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b11fa9de-3bfe-4da6-a410-66b7ffcc8fe3",
                                "sense_id": "51ea7cef-9c9f-3465-bd51-f837edcac345",
                                "text": "Il observe cependant que le traitement à la soude permet de cristalliniser la surface des fibres, de même que Govin [GOV 04]."
                            },
                            {
                                "example_id": "6e88b4e7-33be-4b67-a711-aea5c338ae39",
                                "sense_id": "51ea7cef-9c9f-3465-bd51-f837edcac345",
                                "text": "J'ai mis un produit pour cristalliniser l'eau, et fait fonctionner la filtration un peu avant de mettre les poissons."
                            },
                            {
                                "example_id": "0ee56105-7048-44ab-8cb8-52b2410046dc",
                                "sense_id": "51ea7cef-9c9f-3465-bd51-f837edcac345",
                                "text": "Mémorisez bien que que dématérialiser veut dire cristalliniser ce corps et élever sa fréquence vibratoire, qui est son taux d'amour."
                            }
                        ]
                    }
