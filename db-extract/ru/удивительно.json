        "ru-extract.jsonl": [
            {
                "entry_id": "aabb5f66-a58f-39c8-98b1-d6880f0cb20a",
                "word": "удивительно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0ee0bdb2-1235-32bc-8879-01b4773699d6",
                        "entry_id": "aabb5f66-a58f-39c8-98b1-d6880f0cb20a",
                        "glosses": [
                            "наречие к удивительный; вызывая удивление, очень, необычайно"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "6702d692-cd5a-4056-810b-52650f7e3a94",
                                "sense_id": "0ee0bdb2-1235-32bc-8879-01b4773699d6",
                                "text": "Он удивительно похож на свою мать."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c9f09fb-10a4-3822-ade1-4b4617b92509",
                        "entry_id": "aabb5f66-a58f-39c8-98b1-d6880f0cb20a",
                        "glosses": [
                            "вызывает удивление"
                        ],
                        "tags": [
                            "в знач. сказуемого"
                        ],
                        "examples": [
                            {
                                "example_id": "a3177d44-f42f-4cad-aacb-4e85383491d4",
                                "sense_id": "9c9f09fb-10a4-3822-ade1-4b4617b92509",
                                "text": "Удивительно, как я раньше этого не замечал."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4e3cc74-5395-31fe-8739-67e72bf33583",
                        "entry_id": "aabb5f66-a58f-39c8-98b1-d6880f0cb20a",
                        "glosses": [
                            "наречие к для указания степени то же, что очень"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "f9127804-73cc-4197-a304-95cab34ecba6",
                                "sense_id": "c4e3cc74-5395-31fe-8739-67e72bf33583",
                                "text": "Удивительно много."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "697a9631-19e0-4966-82db-8c3d422a14da",
                        "source_entry_id": "aabb5f66-a58f-39c8-98b1-d6880f0cb20a",
                        "source_sense_description": "качественное наречие",
                        "target_lang_word": "extremely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extremely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "735dbaf9-ff44-38d1-825e-8aeb3f3e87e4",
                                        "entry_id": "e5bf5b87-4cf8-366d-9216-d93d791e806f",
                                        "glosses": [
                                            "To an extreme degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b11ba7-cbeb-4ade-a797-8de651f7a86b",
                                                "sense_id": "735dbaf9-ff44-38d1-825e-8aeb3f3e87e4",
                                                "text": "The National Center for Health Statistics' latest data indicate that quintuplets are extremely rare, with 66 reported sets of five or more babies in 2013."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edf4d079-4e42-4dcf-9e69-8c80e2c5b89b",
                        "source_entry_id": "aabb5f66-a58f-39c8-98b1-d6880f0cb20a",
                        "source_sense_description": "качественное наречие",
                        "target_lang_word": "astonishingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astonishingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3fc3131-7a84-302f-bd62-8187485fd6fd",
                                        "entry_id": "48409df0-6680-361c-b2e3-4006b9841ca7",
                                        "glosses": [
                                            "In an astonishing manner; so as to surprise or astonish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "181df71b-081a-416c-840f-bee8f6f8f0e9",
                                                "sense_id": "b3fc3131-7a84-302f-bd62-8187485fd6fd",
                                                "text": "Famous hotels, for instance, are astonishingly commonplace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9967b92d-9d18-342e-97d4-bbc498d42375",
                                        "entry_id": "48409df0-6680-361c-b2e3-4006b9841ca7",
                                        "glosses": [
                                            "Very; remarkably used as an intensifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e7a91c8-d97c-448a-89d6-92c798190688",
                                                "sense_id": "9967b92d-9d18-342e-97d4-bbc498d42375",
                                                "text": "The advertisements made the place look promising, but the food was astonishingly bad."
                                            },
                                            {
                                                "example_id": "c1d5e70d-f793-43dc-a729-a53791e0fa3d",
                                                "sense_id": "9967b92d-9d18-342e-97d4-bbc498d42375",
                                                "text": "“Republican frontrunner Donald Trump used a campaign stop in Michigan on Monday to make astonishingly sexist attacks against Democratic frontrunner Hillary Clinton,” the left-leaning ThinkProgress wrote."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f6e4edf-fc81-4e06-917b-1cc977e6a430",
                        "source_entry_id": "aabb5f66-a58f-39c8-98b1-d6880f0cb20a",
                        "source_sense_description": "качественное наречие",
                        "target_lang_word": "surprisingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surprisingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bec13c8f-b2cd-3aa5-abda-d604a2a55d67",
                                        "entry_id": "0ffa2eb6-15c2-3ab1-a61d-65011c8c1930",
                                        "glosses": [
                                            "In a way that causes surprise because it is unexpected, or unusual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48a9a95a-415e-4522-b89d-3f954ea96d74",
                                                "sense_id": "bec13c8f-b2cd-3aa5-abda-d604a2a55d67",
                                                "text": "Near-synonyms: unexpectedly, unusually"
                                            },
                                            {
                                                "example_id": "12b5eb65-ba4c-4816-a58d-1133dd322e45",
                                                "sense_id": "bec13c8f-b2cd-3aa5-abda-d604a2a55d67",
                                                "text": "The house was surprisingly small for such a numerous family."
                                            },
                                            {
                                                "example_id": "50f2806e-e94d-456e-a8dd-524fe9ba988f",
                                                "sense_id": "bec13c8f-b2cd-3aa5-abda-d604a2a55d67",
                                                "text": "Not surprisingly, the electrician didn't come at the time he had said."
                                            },
                                            {
                                                "example_id": "383b7574-0c09-4927-8cbb-c4421accf0ab",
                                                "sense_id": "bec13c8f-b2cd-3aa5-abda-d604a2a55d67",
                                                "text": "Chema'd, surprisingly, paid for everything."
                                            },
                                            {
                                                "example_id": "e7e00a25-6645-414a-80b4-f93b0a55550a",
                                                "sense_id": "bec13c8f-b2cd-3aa5-abda-d604a2a55d67",
                                                "text": "François Hollande has moved a step closer to becoming the first Socialist president of France in a generation by beating the incumbent, Nicolas Sarkozy, in the first round of elections. But the surprisingly high vote for the extreme-right candidate, Marine Le Pen, boosted the overall figures for the right and meant that the final runoff vote on 6 May remains on a knife edge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
