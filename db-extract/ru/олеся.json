                                        "entry_id": "ed5693c8-da5d-3420-9d95-fabd4e969e58",
                                        "glosses": [
                                            "A city, the county seat of Jim Wells County, Texas."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
