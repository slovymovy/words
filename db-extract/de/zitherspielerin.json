                                "target_senses": [
                                    {
                                        "sense_id": "8bea5948-9344-3c4a-afce-139e33798c9d",
                                        "entry_id": "91f07696-4c27-36e8-a56e-68ba53135955",
                                        "glosses": [
                                            "Joueur de cithare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b464bae7-c96f-47b1-a17b-644c7498526a",
                                                "sense_id": "8bea5948-9344-3c4a-afce-139e33798c9d",
                                                "text": "C’est l’exemple, toujours cité par Luther, du cithariste qui ne devient cithariste qu’en jouant de la cithare."
                                            }
