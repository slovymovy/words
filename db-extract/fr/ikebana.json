                                                "sense_id": "ed7ac706-4dd6-34f2-88d0-cea525240247",
                                                "text": "Ikebana ist eine meditative Kunst."
                                            },
                                            {
                                                "example_id": "6352a296-9612-44fd-819c-b6d932c29f4e",
                                                "sense_id": "ed7ac706-4dd6-34f2-88d0-cea525240247",
                                                "text": "Sie beherrschte die hohe Kunst des Ikebana."
