                "senses": [
                    {
                        "sense_id": "8ce552f5-ea72-3822-9868-4c0ef79ad47d",
                        "entry_id": "9b593551-867b-3c49-bde7-f362ddc67b4f",
                        "glosses": [
                            "(hypothetisches) nicht von der Erde stammendes Lebewesen (meist für intelligente Lebewesen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a36090a-7c13-48e6-8d2e-1447f22f806b",
                                "sense_id": "8ce552f5-ea72-3822-9868-4c0ef79ad47d",
                                "text": "„Stellen Sie sich vor, dass irgendein intelligentes Weltraumwesen von einem anderen Planeten die Erde besucht und herausfinden möchte, wie Gott ist.“"
                            },
                            {
                                "example_id": "445c9071-b855-4ede-b219-5815c86d7944",
                                "sense_id": "8ce552f5-ea72-3822-9868-4c0ef79ad47d",
                                "text": "„Du glaubst, einmal flüchtig ein solches Weltraumwesen gesehen zu haben, als ein fahles Leuchten, das sich wellenförmig dahinbewegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
