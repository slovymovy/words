                        "glosses": [
                            "druktechniek waarbij de inkt in verdiepingen van de printplaat aanwezig is en later op papier wordt overgebracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6808bc4-a825-49fb-9abe-40292c3305d4",
                                "sense_id": "67081163-b284-3f2a-a4cd-c0aecefb25ae",
                                "text": "Diepdruk is een hoogwaardig procédé, waarbij meer inkt wordt gebruikt dan bij offset-druk. Daardoor is het ook duurder dan offset."
                            },
                            {
                                "example_id": "cf4b1002-2cc1-4786-96c8-2da45aba3e08",
                                "sense_id": "67081163-b284-3f2a-a4cd-c0aecefb25ae",
                                "text": "De verkeerscontrole werd gehouden aan de Industrieweg, onder de overkapping van het voormalige terrein van Roto Smeets. Daar is geen bedrijvigheid meer sinds het faillissement van de diepdruk."
                            },
                            {
                                "example_id": "3e2000ba-6491-409b-9bb6-829719911968",
                                "sense_id": "67081163-b284-3f2a-a4cd-c0aecefb25ae",
                                "text": "Ruil werkdruk in voor vlakdruk, diepdruk of hoogdruk"
                            }
                        ]
