                "entry_id": "af98a6fa-808a-3b05-bc46-7a94f1f565ba",
                "word": "enthalpy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dbf13ee0-8a15-42c3-a8be-966700bc488b",
                        "entry_id": "af98a6fa-808a-3b05-bc46-7a94f1f565ba",
                        "tags": [
                            "plural"
                        ],
                        "form": "enthalpies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3e390c0-8f86-3612-8aff-efc4130242c0",
                        "entry_id": "af98a6fa-808a-3b05-bc46-7a94f1f565ba",
                        "glosses": [
                            "A measure of the heat content of a chemical or physical system."
                        ],
                        "tags": [
                            "countable",
                            "physical",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cfd1571d-8231-4dc3-af0a-dc3603153ed4",
                                "sense_id": "c3e390c0-8f86-3612-8aff-efc4130242c0",
                                "text": "H=U+pV, where H is enthalpy, U is internal energy, p is pressure, and V is volume."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2d8f594-d148-40e6-9f6f-ef099682e952",
                        "source_entry_id": "af98a6fa-808a-3b05-bc46-7a94f1f565ba",
                        "source_sense_id": "c3e390c0-8f86-3612-8aff-efc4130242c0",
                        "source_sense_description": "a measure of the heat content",
                        "target_lang_word": "enthalpie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enthalpie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45b84060-1c51-3040-aae2-20d72237d7a7",
                                        "entry_id": "524b6222-94bf-305b-bb87-0ecf78efab61",
                                        "glosses": [
                                            "Mesure thermodynamique de la variation de la quantité de chaleur contenue dans un système physique ou chimique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de075355-308d-44af-bffb-d2d7d7aed88b",
                                                "sense_id": "45b84060-1c51-3040-aae2-20d72237d7a7",
                                                "text": "La nouvelle fonction thermodynamique (…), qui reçut de Kamerlingh Onnes le nom d'« enthalpie », joue, pour les transformations à pression constante, le rôle que joue l'énergie interne pour les transformations à volume constant."
                                            },
                                            {
                                                "example_id": "fa426c00-b4ce-4e3b-a59d-aa83828eaf82",
                                                "sense_id": "45b84060-1c51-3040-aae2-20d72237d7a7",
                                                "text": "Cette technique permettra de déterminer la température de fusion T_f et de cristallisation T_c, l’enthalpie de fusion DH_f et de cristallisation DH_c et le taux de cristallinité χ_c."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee23c44f-7aff-446d-ae87-c7e40e39bf8a",
                        "source_entry_id": "af98a6fa-808a-3b05-bc46-7a94f1f565ba",
                        "source_sense_id": "c3e390c0-8f86-3612-8aff-efc4130242c0",
                        "source_sense_description": "a measure of the heat content",
