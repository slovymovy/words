                        "entry_id": "63b71399-723c-3661-bcb6-f507e7515c84",
                        "glosses": [
                            "One who fishes by surfcasting."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22e54c82-7af2-4edc-a73c-a2d9e2179af4",
                                "sense_id": "32543cdb-e1a2-337d-8588-6bb1d167efef",
                                "text": "Ron is a dyed-in-the-wool surfcaster, the sort of man who speaks about the mystical beauty of long nights as a lone sentry beside the sea waiting for the fish to arrive."
                            },
                            {
                                "example_id": "a788d4cf-0ef1-4254-9b7c-4bf11db2bfc2",
                                "sense_id": "32543cdb-e1a2-337d-8588-6bb1d167efef",
                                "text": "Even the most weathered and experienced surfcaster will tell you that there are always innovative ways to fish the mighty Atlantic."
                            },
                            {
                                "example_id": "b0bf25de-c2ec-496f-81ba-e57a9e55a2b9",
                                "sense_id": "32543cdb-e1a2-337d-8588-6bb1d167efef",
                                "text": "For any Garden State surfcaster, all the pent-up wintertime anxiety comes to a head, from being locked inside, a slave to only eight hours of daylight, freezing and snow-blind through blizzards and massive nor'easter snowdrifts covering the house."
                            },
                            {
                                "example_id": "9521082f-ef06-410b-ae2a-634cd733cb02",
                                "sense_id": "32543cdb-e1a2-337d-8588-6bb1d167efef",
                                "text": "A born pier fisherman was a totally different kind of breed from a surfcaster or a boat fisherman."
                            }
                        ]
                    }
