                "senses": [
                    {
                        "sense_id": "f0a4663f-d1df-39b9-99f5-f1f26b633dd3",
                        "entry_id": "27f964e2-dcb4-311c-9e54-91da16ae376a",
                        "glosses": [
                            "Donner un caractère ontique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f85818a-c191-4eb5-bc42-70025e1c8997",
                                "sense_id": "f0a4663f-d1df-39b9-99f5-f1f26b633dd3",
                                "text": "En définitive, pouvons-nous même parler d'un pôle ontologique de la différence sans onticiser irrémédiablement toute la problématique, jusqu'à un point tel que soit lui-même oblitéré ce que la conception de la différence ontologique était destinée à clarifier ?"
                            },
                            {
                                "example_id": "374031e0-6e99-452e-a25e-cd262e74dbf2",
                                "sense_id": "f0a4663f-d1df-39b9-99f5-f1f26b633dd3",
                                "text": "L’une va s’onticiser et l’autre se méontologiser (présenter la révolution comme un moment constitutif)."
                            }
                        ]
                    }
