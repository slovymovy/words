                        "entry_id": "7d9c1368-163c-3328-84cd-e257b1b24aab",
                        "glosses": [
                            "Volume de sang supérieur à la normale dans le système sanguin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bee072a-4697-4d4f-9c7b-a4af1a40796f",
                                "sense_id": "d4b55fd3-b895-3a5d-aa1c-fc93a9d3c9f6",
                                "text": "L’hypervolémie survient lorsque la sécrétion d’aldostérone est soumise à une stimulation chronique."
                            },
                            {
                                "example_id": "9bb46deb-cbff-4364-af06-4f2acfea64ec",
                                "sense_id": "d4b55fd3-b895-3a5d-aa1c-fc93a9d3c9f6",
                                "text": "L’hypervolémie obtenue par l’administration de solutés cristalloïdes et colloïdes permet l’amélioration du débit cardiaque."
                            },
                            {
                                "example_id": "2a201482-bbf2-4305-aa6e-194baf1cc063",
                                "sense_id": "d4b55fd3-b895-3a5d-aa1c-fc93a9d3c9f6",
                                "text": "L’hypoxie va également provoquer une polyglobulie, une hypervolémie et une augmentation cardiaque, qui toues contribueront à augmenter la surcharge ventriculaire droite."
                            }
                        ]
                    }
                ],
