                        "sense_id": "133e9a37-a9a7-3d28-a3b9-91a62b3beeff",
                        "entry_id": "e882faa0-c2bb-3ad4-a72d-e497f7e2c0c8",
                        "glosses": [
                            "Chabot commun, poisson des rivières et lacs bien oxygénés."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "36899fd9-9cf7-4332-8d02-a366b5dc4313",
                                "sense_id": "133e9a37-a9a7-3d28-a3b9-91a62b3beeff",
                                "text": "Le chavot vit caché au fond des ruisseaux, au milieu des pierres car il ne possède pas de vessie natatoire."
                            },
                            {
                                "example_id": "40171e75-f5fe-4d91-bf89-f07216575e59",
                                "sense_id": "133e9a37-a9a7-3d28-a3b9-91a62b3beeff",
                                "text": "Le Pêcheur de Chavots (le chavot est un terme franc-comtois qui évoque un petit poisson à grosse tête) est une statue créée par Gustave Courbet lui-même, en 1862 à Paris. Elle fut installée à Ornans par la suite."
                            }
                        ]
                    }
