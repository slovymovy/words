                                    {
                                        "sense_id": "de7948e5-719e-3ea5-9682-bb6b0b8382eb",
                                        "entry_id": "bf41e0bf-a952-36b1-81ca-11ff9e0c5e71",
                                        "glosses": [
                                            "Relatif ou propre à Bangkok ou à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c118aa5-1597-42d6-afed-bd507deac8ec",
                                                "sense_id": "de7948e5-719e-3ea5-9682-bb6b0b8382eb",
                                                "text": "Du monastère royal au Siam Center (gigantesque temple de la consommation), des canaux paisibles où barbotent des varans au marché bondé de Chatuchak, la reporter explore avec application les quartiers, et les contradictions qu’ils révèlent de la société bangkokoise."
                                            },
                                            {
                                                "example_id": "a695d5e5-8580-4864-b7e9-27326381c049",
                                                "sense_id": "de7948e5-719e-3ea5-9682-bb6b0b8382eb",
                                                "text": "Pour commencer : soupe poulet ou crevette, nem végétarien, beignets de poissons et, surtout, des salades parfumées dignes de la street food bangkokoise (riz croustillant et saucisse à la citronnelle, bœuf à la citronnelle)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
