                        "sense_id": "30a1fe08-23ed-3176-a69d-f4a8247077af",
                        "entry_id": "b455bc4d-2356-3da2-82e4-f49b697301d5",
                        "glosses": [
                            "Qui ne se reproduit pas souvent."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1cd2c2a8-88c8-4c46-bbf0-da0e285ad503",
                                "sense_id": "30a1fe08-23ed-3176-a69d-f4a8247077af",
                                "text": "Il eût été contraire à son code de lire les lettres, d'ailleurs infréquentes que s'adressaient les deux femmes."
                            },
                            {
                                "example_id": "9869acd2-0602-4cd7-8e80-6c764753c4bf",
                                "sense_id": "30a1fe08-23ed-3176-a69d-f4a8247077af",
                                "text": "En premier lieu, il n’est pas infréquent qu’un dérivé construit avec ce suffixe renvoie non pas à une collection d’entités mais à une entité singulière."
                            }
                        ]
                    }
                ],
