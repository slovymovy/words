                "senses": [
                    {
                        "sense_id": "393d2acd-28a4-3997-8f76-38085817c7a9",
                        "entry_id": "0c2f20ef-4861-3b0e-b3f9-1718f950f221",
                        "glosses": [
                            "ein Gips- oder Wachsabdruck von dem Gesicht eines Verstorbenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a930a95c-a481-4bb0-8231-e3f96ff57175",
                                "sense_id": "393d2acd-28a4-3997-8f76-38085817c7a9",
                                "text": "Man hat Totenmasken von vielen Berühmtheiten angefertigt."
                            },
                            {
                                "example_id": "a880c4c3-c9ea-4fb4-83f6-7ae16684d06d",
                                "sense_id": "393d2acd-28a4-3997-8f76-38085817c7a9",
                                "text": "„Ich hatte noch nie Totenmasken gesehen, sie waren etwas vollkommen Neues für mich.“"
                            },
                            {
                                "example_id": "380f26be-c9e0-42c0-87e9-1262878a9aaa",
                                "sense_id": "393d2acd-28a4-3997-8f76-38085817c7a9",
                                "text": "„An den Wänden hängen die Totenmasken Nietzsches, Beethovens und Wagners.“"
                            },
                            {
                                "example_id": "9808443a-4932-45f3-ab6d-e4189331dfa3",
                                "sense_id": "393d2acd-28a4-3997-8f76-38085817c7a9",
                                "text": "„Früher hatte er manchmal die Totenmaske von Humperdinck nachgemacht, sich zurückgelehnt, Augen zu, Mund auf.“"
                            },
                            {
                                "example_id": "f4ca748a-70d2-4795-a0d3-a52c359e1bf1",
                                "sense_id": "393d2acd-28a4-3997-8f76-38085817c7a9",
                                "text": "„Die Totenmaske des Kindkönigs, der im 14. Jahrhundert vor Christus mit rund 9 Jahren den Thron bestieg und schon mit 18 oder 19 verstarb, ist nicht nur das wichtigste Exponat des Museums.“"
                            },
                            {
                                "example_id": "8b32039a-1c16-4690-82b7-3c7bce0beded",
                                "sense_id": "393d2acd-28a4-3997-8f76-38085817c7a9",
                                "text": "„Die Totenmaske zeigt tatsächlich einen Schlafenden mit wenig Sterbezeichen im Gesicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
