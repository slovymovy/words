{
    "word_family": [
        "vouch"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "08cb115f-bf93-362b-ba27-9134c9b15322",
                    "sense_definition": "A document or token that can be exchanged for goods, services, or a discount.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The customer used a <w>voucher</w> to get a discount on her groceries.",
                            "target_lang_translations": {
                                "zh": "顾客用一张<w>优惠券</w>在购买杂货时获得了折扣。"
                            }
                        },
                        {
                            "text": "Please present your <w>voucher</w> at the front desk to receive your free meal.",
                            "target_lang_translations": {
                                "zh": "请在前台出示您的<w>代金券</w>以领取免费餐点。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coupon"
                    ],
                    "common_phrases": [
                        "gift voucher",
                        "discount voucher"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种可以兑换商品、服务或折扣的凭证或代金券。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "代金券",
                                "target_lang_sense_clarification": "用于抵扣部分金额的凭证"
                            },
                            {
                                "target_lang_word": "优惠券",
                                "target_lang_sense_clarification": "用于获取折扣的凭证"
                            },
                            {
                                "target_lang_word": "凭证",
                                "target_lang_sense_clarification": "通用的兑换凭据"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "703da960-84e9-33cf-97a0-e5b6c43be5f2",
                    "sense_definition": "A written record or receipt confirming a transaction.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant requested a <w>voucher</w> for every business expense.",
                            "target_lang_translations": {
                                "zh": "会计要求每一笔业务支出都要有相应的<w>凭单</w>。"
                            }
                        },
                        {
                            "text": "Keep the payment <w>voucher</w> as proof of your purchase.",
                            "target_lang_translations": {
                                "zh": "请保留好付款<w>收据</w>作为购买证明。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "确认交易的书面记录或收据。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "凭单",
                                "target_lang_sense_clarification": "会计或财务中用于记录支出的单据"
                            },
                            {
                                "target_lang_word": "收据",
                                "target_lang_sense_clarification": "证明付款的凭证"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e918bbd-59d2-32ea-942e-91ef4e29f3b5",
                    "sense_definition": "A person or thing that provides evidence or support for a claim.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her long history of success serves as a <w>voucher</w> for her professional reputation.",
                            "target_lang_translations": {
                                "zh": "她长期的成功经历是她职业声誉的有力<w>证明</w>。"
                            }
                        },
                        {
                            "text": "The witness acted as a <w>voucher</w> for the defendant's character.",
                            "target_lang_translations": {
                                "zh": "证人充当了被告品行的<w>担保人</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "为某项主张提供证据或支持的人或事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "证明",
                                "target_lang_sense_clarification": "作为证据的事物"
                            },
                            {
                                "target_lang_word": "担保人",
                                "target_lang_sense_clarification": "为他人品行或主张作保的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67f3f795-4128-3fb3-a0cd-620e93979881",
                    "sense_definition": "To issue a document or token to someone that allows them to receive goods or services.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity will <w>voucher</w> families in need for school supplies.",
                            "target_lang_translations": {
                                "zh": "慈善机构将为贫困家庭<w>发放</w>学习用品代金券。"
                            }
                        },
                        {
                            "text": "They decided to <w>voucher</w> all employees for their travel expenses.",
                            "target_lang_translations": {
                                "zh": "他们决定为所有员工的差旅费<w>发放</w>报销凭单。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "向某人发放凭证，使其能够获得商品或服务。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发放代金券",
                                "target_lang_sense_clarification": "向他人提供可兑换的凭证"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}