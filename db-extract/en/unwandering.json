                        "examples": [
                            {
                                "example_id": "9d710905-840b-4427-adf7-c55643a75d9c",
                                "sense_id": "1252aada-50dd-30b7-84ed-997c0d23c03a",
                                "text": "When they are permitted to reach any height from which to look down, the terrible craving appears to be temporarily appeased; and they become kind, and even generous, to all who look up with willing, unwandering gaze."
                            },
                            {
                                "example_id": "9b8b9ace-2ecf-4894-90d9-b42724b09408",
                                "sense_id": "1252aada-50dd-30b7-84ed-997c0d23c03a",
                                "text": "Dawson--lean and keen, tough and brown of skin, and so carelessly dressed that he looked as if he slept in his clothes--listened with the sympathetic, unwandering attention which men give only him who comes telling where and how they can make money."
                            }
                        ]
                    }
