                        "sense_id": "2e6dafc9-b264-3291-8f75-1886ac62a5ac",
                        "entry_id": "950c4b65-a156-3d46-8980-704e970732ea",
                        "glosses": [
                            "не являющийся изменённым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3054a02-d5c2-4ead-b5f5-a259d6530c55",
                                "sense_id": "2e6dafc9-b264-3291-8f75-1886ac62a5ac",
                                "text": "В неизменённой молочной железе строма представлена нежноволокнистой рыхлой соединительной тканью в небольшом количестве, которая равномерно распределена в железистой ткани."
                            }
                        ]
                    }
                ],
                "translations": [
