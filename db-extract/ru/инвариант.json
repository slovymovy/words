                "senses": [
                    {
                        "sense_id": "6db6a934-5c19-3cf8-b92b-ec262d8f7423",
                        "entry_id": "b9c0d426-53eb-361b-8570-49a8fcc555ef",
                        "glosses": [
                            "матем. свойство некоторого класса (множества) математических объектов оставаться неизменными при преобразованиях определённого типа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "608624a9-6c8b-4212-9bd9-12f36e51d91d",
                                "sense_id": "6db6a934-5c19-3cf8-b92b-ec262d8f7423",
                                "text": "Орбиты, инварианты и коварианты для действий редуктивных алгебраических групп на аффинных многообразиях."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8eeff32-8acf-4f47-9628-a1d0ad9b948b",
                        "source_entry_id": "b9c0d426-53eb-361b-8570-49a8fcc555ef",
                        "source_sense_id": "6db6a934-5c19-3cf8-b92b-ec262d8f7423",
                        "target_lang_word": "invariant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
