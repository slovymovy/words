                    {
                        "translation_id": "a8d6d4e9-e8ca-44f1-8409-a4774db1ac1a",
                        "source_entry_id": "6a3a697e-a220-339f-946e-3c1303eed3b3",
                        "source_sense_id": "7cf6efd2-63de-315d-883a-83b31b2c61cd",
