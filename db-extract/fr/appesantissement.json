            {
                "entry_id": "4577212a-2a59-3f88-be5f-efadc9f28b04",
                "word": "appesantissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "22776ad5-d50f-4c41-9522-f9bfe3be21e9",
                        "entry_id": "4577212a-2a59-3f88-be5f-efadc9f28b04",
                        "tags": [
                            "plural"
                        ],
                        "form": "appesantissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "18a4e1dd-778f-3541-bbec-3244b5946bbf",
                        "entry_id": "4577212a-2a59-3f88-be5f-efadc9f28b04",
                        "glosses": [
                            "État d’une personne appesantie, soit de corps, soit d’esprit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfc0331c-7a66-40e3-9b5f-7b2c88f16a77",
                                "sense_id": "18a4e1dd-778f-3541-bbec-3244b5946bbf",
                                "text": "Il est sujet à un appesantissement après chaque repas."
                            },
                            {
                                "example_id": "b8561a0d-ef2b-4f02-9edf-faaed07fa66c",
                                "sense_id": "18a4e1dd-778f-3541-bbec-3244b5946bbf",
                                "text": "Appesantissement d’esprit."
                            },
                            {
                                "example_id": "e81356df-f73a-44cd-bcc4-f6ede5bd36a6",
                                "sense_id": "18a4e1dd-778f-3541-bbec-3244b5946bbf",
                                "text": "Saint Augustin se comparait à un homme endormi qui se réveille, et qui voudrait se lever, mais que l’appesantissement où il est replonge aussitôt dans son premier sommeil."
                            }
                        ]
                    },
                    {
                        "sense_id": "02d49813-ac12-319c-b62b-c4c4426153ee",
                        "entry_id": "4577212a-2a59-3f88-be5f-efadc9f28b04",
                        "glosses": [
                            "Action d’appesantir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c01f946-fd68-40da-bf35-4af21c9ec21c",
                                "sense_id": "02d49813-ac12-319c-b62b-c4c4426153ee",
                                "text": "C'est un appesantissement de la main de Dieu."
                            },
                            {
                                "example_id": "627fc68d-f4d3-45b5-bce5-60b8ce5c0b07",
                                "sense_id": "02d49813-ac12-319c-b62b-c4c4426153ee",
                                "text": "L’appesantissement de la main de Dieu."
                            },
                            {
                                "example_id": "a3fedc8e-3b0d-4cf2-9d32-ac8223334d81",
                                "sense_id": "02d49813-ac12-319c-b62b-c4c4426153ee",
                                "text": "L’appesantissement graduel du corps se fait sentir dans l’homme depuis l’âge de soixante ans."
                            }
                        ]
                    }
                ],
