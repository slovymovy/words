{
    "word_family": [
        "marooner"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04770e41-f1b1-33aa-90cd-228e0014ae6d",
                    "sense_definition": "A rich dark red, somewhat brownish, color.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a beautiful <w>maroon</w> dress to the winter party.",
                            "target_lang_translations": {
                                "de": "Sie trug ein wunderschönes <w>weinrotes</w> Kleid zur Winterparty."
                            }
                        },
                        {
                            "text": "The walls of the library were painted a deep <w>maroon</w> color.",
                            "target_lang_translations": {
                                "de": "Die Wände der Bibliothek waren in einem tiefen <w>Bordeauxrot</w> gestrichen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dark maroon",
                        "maroon color"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine satte, dunkelrote, leicht bräunliche Farbe."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "weinrot",
                                "target_lang_sense_clarification": "Dunkelrot mit einem leichten bläulichen Stich."
                            },
                            {
                                "target_lang_word": "bordeauxrot",
                                "target_lang_sense_clarification": "Ein dunkler Rotton, der leicht ins Violette übergeht."
                            },
                            {
                                "target_lang_word": "kastanienbraun",
                                "target_lang_sense_clarification": "Mittel- bis dunkelbraun mit einem rötlichen Schimmer."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8bff6a4-4dad-3277-b729-da5acf0dcacc",
                    "sense_definition": "An escaped black slave of the Caribbean and the Americas or a descendant of such a person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "historical_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Maroon</w> communities in Jamaica fought for their independence for many years.",
                            "target_lang_translations": {
                                "de": "Die <w>Maroon</w>-Gemeinschaften auf Jamaika kämpften viele Jahre lang für ihre Unabhängigkeit."
                            }
                        },
                        {
                            "text": "Many traditions were preserved by the <w>Maroon</w> people who lived in the mountains.",
                            "target_lang_translations": {
                                "de": "Viele Traditionen wurden von den <w>Maroon</w>-Leuten bewahrt, die in den Bergen lebten."
                            }
                        }
                    ],
                    "synonyms": [
                        "Bush Negro"
                    ],
                    "common_phrases": [
                        "Maroon community"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein entflohener Sklave in der Karibik oder Amerika oder ein Nachkomme einer solchen Person."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Maroon",
                                "target_lang_sense_clarification": "Bezeichnung für Angehörige der Maroon-Kultur."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a313fdbf-df55-3340-962f-44448d6cac71",
                    "sense_definition": "A castaway; a person who has been marooned.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "castaway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lone <w>maroon</w> survived on the island by catching fish.",
                            "target_lang_translations": {
                                "de": "Der einsame <w>Ausgesetzte</w> überlebte auf der Insel, indem er Fische fing."
                            }
                        },
                        {
                            "text": "After the shipwreck, the <w>maroon</w> waited for a passing ship to rescue him.",
                            "target_lang_translations": {
                                "de": "Nach dem Schiffbruch wartete der <w>Ausgesetzte</w> auf ein vorbeifahrendes Schiff, um ihn zu retten."
                            }
                        }
                    ],
                    "synonyms": [
                        "castaway"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Schiffbrüchiger oder eine Person, die auf einer einsamen Insel ausgesetzt wurde."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Ausgesetzter",
                                "target_lang_sense_clarification": "Jemand, der absichtlich an einem einsamen Ort zurückgelassen wurde."
                            },
                            {
                                "target_lang_word": "Schiffbrüchiger",
                                "target_lang_sense_clarification": "Jemand, der nach einem Schiffsunglück gestrandet ist."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73fe547e-b3f8-333c-9cc7-61e7053ed3ef",
                    "sense_definition": "An idiot; a fool.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot believe that <w>maroon</w> forgot his keys again.",
                            "target_lang_translations": {
                                "de": "Ich kann nicht glauben, dass dieser <w>Idiot</w> schon wieder seine Schlüssel vergessen hat."
                            }
                        },
                        {
                            "text": "Do not listen to that <w>maroon</w> because he does not know what he is talking about.",
                            "target_lang_translations": {
                                "de": "Hör nicht auf diesen <w>Dummkopf</w>, denn er weiß nicht, wovon er redet."
                            }
                        }
                    ],
                    "synonyms": [
                        "idiot",
                        "fool",
                        "moron"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and derogatory."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Idiot oder Dummkopf."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Idiot",
                                "target_lang_sense_clarification": "Beleidigende Bezeichnung für eine dumme Person."
                            },
                            {
                                "target_lang_word": "Dummkopf",
                                "target_lang_sense_clarification": "Informelle Bezeichnung für jemanden, der sich unklug verhält."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6110118-723c-3c21-8906-4fd7fc5e99f1",
                    "sense_definition": "A rocket-propelled firework or skyrocket, often one used as a signal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "signal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rescue team fired a <w>maroon</w> to signal their location to the ship.",
                            "target_lang_translations": {
                                "de": "Das Rettungsteam feuerte eine <w>Signalrakete</w> ab, um dem Schiff ihren Standort mitzuteilen."
                            }
                        },
                        {
                            "text": "The loud bang of the <w>maroon</w> echoed across the dark harbor.",
                            "target_lang_translations": {
                                "de": "Der laute Knall der <w>Signalrakete</w> hallte über den dunklen Hafen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "warning maroon"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical usage for signaling."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein raketenbetriebener Feuerwerkskörper, der oft als Signal verwendet wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Signalrakete",
                                "target_lang_sense_clarification": "Ein pyrotechnisches Signalmittel."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "971c3079-16f1-302c-a631-3180b49a7af2",
                    "sense_definition": "To abandon in a remote, desolate place, as on a desert island.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "abandon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pirates decided to <w>maroon</w> the captain on a small island.",
                            "target_lang_translations": {
                                "de": "Die Piraten beschlossen, den Kapitän auf einer kleinen Insel <w>auszusetzen</w>."
                            }
                        },
                        {
                            "text": "The heavy snowstorm <w>marooned</w> the travelers in the mountain cabin.",
                            "target_lang_translations": {
                                "de": "Der schwere Schneesturm <w>ließ</w> die Reisenden in der Berghütte <w>stranden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "abandon",
                        "strand"
                    ],
                    "common_phrases": [
                        "marooned on an island"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden an einem abgelegenen, einsamen Ort zurücklassen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "aussetzen",
                                "target_lang_sense_clarification": "Jemanden hilflos an einem Ort zurücklassen."
                            },
                            {
                                "target_lang_word": "stranden lassen",
                                "target_lang_sense_clarification": "Jemanden unfreiwillig an einem Ort festsetzen."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "15277145-022f-3bac-b09c-435f85c2cc79",
                    "sense_definition": "Of a maroon color.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a <w>maroon</w> sweater for the autumn season.",
                            "target_lang_translations": {
                                "de": "Sie kaufte einen <w>weinroten</w> Pullover für die Herbstsaison."
                            }
                        },
                        {
                            "text": "The team wore <w>maroon</w> jerseys during the championship game.",
                            "target_lang_translations": {
                                "de": "Das Team trug während des Meisterschaftsspiels <w>bordeauxrote</w> Trikots."
                            }
                        }
                    ],
                    "common_phrases": [
                        "maroon sweater",
                        "maroon jersey"
                    ],
                    "target_lang_definitions": {
                        "de": "Von der Farbe Maroon."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "weinrot",
                                "target_lang_sense_clarification": "Adjektiv für die Farbe."
                            },
                            {
                                "target_lang_word": "bordeauxrot",
                                "target_lang_sense_clarification": "Adjektiv für die Farbe."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}