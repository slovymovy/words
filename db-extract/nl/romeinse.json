                        ],
                        "examples": [
                            {
                                "example_id": "a7861c19-6a29-4644-ac7e-b8794e1f1e22",
                                "sense_id": "e85a562a-e3fe-3253-8bab-a47b11b095a7",
                                "text": "In de Romeinse keizertijd vormden ze ook de centrale spil in een netwerk van atletische festivals dat vrijwel het gehele mediterrane gebied bestreek."
                            },
                            {
                                "example_id": "24a43149-985a-4ed6-9a49-78952d13bb86",
                                "sense_id": "e85a562a-e3fe-3253-8bab-a47b11b095a7",
                                "text": "Zijn Olympia, dat is Olymp-Speelen der Grieken nagebootst van den Romeinen, uit oude Griekse en Romeinse schryvers opgehaelt werd gemotiveerd met de verwachting dat de bestudering kon dienen om 'de glans van de majesteit van de hoogwaardige Godtlyke Openbaring op te luisteren'."
                            },
                            {
                                "example_id": "93b1f9b6-8568-4ca9-8d87-866c0519b431",
                                "sense_id": "e85a562a-e3fe-3253-8bab-a47b11b095a7",
                                "text": "De Romeinse keizer kocht sociale vrede door brood en spelen en ook in de koloniale en multinationale rijken in (vroeg)modern Europa had sport een belangrijke politieke en onderdrukkende functie."
                            }
                        ]
                    }
