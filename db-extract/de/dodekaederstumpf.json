                        "translation_id": "d85d123b-5306-4872-b8a3-e16b444b21fe",
                        "source_entry_id": "73f771ac-d18a-32ad-94e7-2fc2876a9f77",
                        "source_sense_id": "c4b2deff-8496-3ba8-9370-9fe442bda42b",
                        "source_sense_description": "Geometrie: Polyeder, das durch Abstumpfung der Ecken eines Dodekaeders entsteht",
                        "target_lang_word": "truncated dodecahedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truncated dodecahedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6ad1d0c-b748-3b2a-91e3-2b2524dd4114",
                                        "entry_id": "a41d55ed-1911-3024-a3e9-fe0dee3a450f",
                                        "glosses": [
                                            "An Archimedean solid with thirty-two regular faces (twelve decagons and twenty triangles) and ninety edges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c49c12e1-7c0f-406a-b271-8c8f0990a724",
                                                "sense_id": "f6ad1d0c-b748-3b2a-91e3-2b2524dd4114",
                                                "text": "1813, Spinell, entry in John Mason Good, Olinthus Gregory, Newton Bosworth (editors), Pantologia: A New Cyclopaedia, Volume XI: SPA — TZE, unnumbered page,\nThis, which may be regarded as a brown garnet or schoerl in truncated dodecahedrons of Rome de Lisle, was originally found in the island of Ceylon, among tourmalines and other crystalline substances, with which it was confounded."
                                            },
                                            {
                                                "example_id": "f1e8d864-efa2-4893-823a-2436195f3bc9",
                                                "sense_id": "f6ad1d0c-b748-3b2a-91e3-2b2524dd4114",
                                                "text": "The morphologies commonly observed in bcc materials include truncated dodecahedrons with {110} faces and {100} truncations and cubes with {100} faces."
                                            },
                                            {
                                                "example_id": "1d20dc87-23ad-4974-89da-dd1f9017a6c5",
                                                "sense_id": "f6ad1d0c-b748-3b2a-91e3-2b2524dd4114",
                                                "text": "Void shapes were found to be generally truncated dodecahedra with {011} faces and {001} truncations."
                                            },
                                            {
                                                "example_id": "ae1aef06-7ee3-4dbf-b28e-4fa06275884f",
                                                "sense_id": "f6ad1d0c-b748-3b2a-91e3-2b2524dd4114",
                                                "text": "1996, T. A. Fournelle, K. W. Weston, Generalizations of Steinberg Groups, World Scientific Publishing, Series in Algebra, Volume 4, page 176,\nThe edges of the linkages lie on the edges of a truncated dodecahedron. Note that the group of orientation preserving symmetries of a truncated dodecahedron is precisely A₅."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
