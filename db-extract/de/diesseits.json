                    },
                    {
                        "form_id": "fac266e6-f7d0-4884-9eae-c3962e424ff8",
                        "entry_id": "3e80a4f4-d48c-3451-9c30-fae028440377",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Diesseits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "23e36ce6-842e-379d-a6b3-c92063c5c88d",
                        "entry_id": "3e80a4f4-d48c-3451-9c30-fae028440377",
                        "glosses": [
                            "irdisches Leben, materielle Welt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f919bc-867a-43d8-9559-10cfe2757564",
                                "sense_id": "23e36ce6-842e-379d-a6b3-c92063c5c88d",
                                "text": "„Dieses lineare Verständnis von Zeit bedeutet, dass die Gläubigen im Diesseits nach den von ihrer Gottheit geforderten Regeln leben, um den Lohn dafür in einer späteren Zeit zu erhalten, wobei Gott auch im Diesseits schon wirken kann.“"
                            },
                            {
                                "example_id": "7b4250c0-9c46-4b55-b787-ac3c24acd0e6",
                                "sense_id": "23e36ce6-842e-379d-a6b3-c92063c5c88d",
                                "text": "„Er, der das Paradies im Diesseits nicht gefunden hatte, griff nun mit der ihm eigenen Maßlosigkeit nach dem Jenseits.“"
                            },
                            {
                                "example_id": "c93406c3-dded-40f6-8231-6cbf061c7f8f",
                                "sense_id": "23e36ce6-842e-379d-a6b3-c92063c5c88d",
                                "text": "„Schon Jahre zuvor hat sich Klee der Eindeutigkeit des Diesseits entzogen.“"
                            },
                            {
                                "example_id": "5cccc8f5-36a9-4c9c-aac1-461d4e78870f",
                                "sense_id": "23e36ce6-842e-379d-a6b3-c92063c5c88d",
                                "text": "„Man schließt quasi eine Versicherung im Diesseits gegen Feuer im Jenseits ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
