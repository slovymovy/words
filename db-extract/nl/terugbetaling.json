                        "translation_id": "284b527e-297e-4f3e-bca2-147c0ef2fe33",
                        "source_entry_id": "30d55bd1-c21b-3a25-b2cf-d3010683b672",
                        "source_sense_id": "5303bc0a-8022-3909-916f-1e9f2b24d789",
                        "target_lang_word": "Rückzahlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückzahlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d25ea39-e483-3767-afb0-f7713df81523",
                                        "entry_id": "bb6bec62-4225-3a69-b778-703826992f83",
                                        "glosses": [
                                            "Erstattung geliehenen oder zu Unrecht erhaltenen Geldes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a7a081b-cf15-4554-86dc-a072a433a4d8",
                                                "sense_id": "6d25ea39-e483-3767-afb0-f7713df81523",
                                                "text": "Die Rückzahlung ist für den nächsten Ersten vereinbart."
                                            },
                                            {
                                                "example_id": "352c8273-86e7-4429-bdf5-6ea9eaef04c4",
                                                "sense_id": "6d25ea39-e483-3767-afb0-f7713df81523",
                                                "text": "„Im schlimmsten Fall drohen dem Staatskonzern Rückzahlungen in Höhe von mehreren hundert Millionen Euro.“"
                                            },
                                            {
                                                "example_id": "e4fdcfba-c4c8-40a2-96fe-df0f7093fd71",
                                                "sense_id": "6d25ea39-e483-3767-afb0-f7713df81523",
                                                "text": "„Diese Ueberzeugung dass in ihm so fest, dass sie sich auch den anderen Menschen mitteilte und sie ihm weder diese überragende Stellung in der Gesellschaft noch die Geldsummen vorenthalten konnte, die er sich immer vom ersten besten geben liess, ohne je an Rückzahlung zu denken.“"
                                            },
                                            {
                                                "example_id": "86d4d754-7020-478a-80f9-4e8718129680",
                                                "sense_id": "6d25ea39-e483-3767-afb0-f7713df81523",
                                                "text": "„Zehn Minuten später brachte er mir ein Blatt Papier, auf dem er seine Schuld anerkannte und sich zur Rückzahlung innerhalb einer bestimmten Frist verpflichtete.“"
                                            },
                                            {
                                                "example_id": "62ee6abe-ccaa-4dc6-9d8b-48b3ebb9a7e3",
                                                "sense_id": "6d25ea39-e483-3767-afb0-f7713df81523",
                                                "text": "„Sie kam gerade so über die Runden, aber von einer Rückzahlung an ihre Mutter war sie noch meilenweit entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
