                    }
                ],
                "senses": [
                    {
                        "sense_id": "585147d8-781a-3dc5-abc2-3667f8de53ea",
                        "entry_id": "cbf8c7a8-25bd-3ab1-af08-ac07737034d7",
                        "glosses": [
                            "Remontée mécanique composée de plusieurs sièges permettant de remonter les pistes de ski."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d62743ca-51d4-4f74-8af0-f3b4de147dcf",
                                "sense_id": "585147d8-781a-3dc5-abc2-3667f8de53ea",
                                "text": "Un autre jour encore, pendant plusieurs minutes, Liane était restée suspendue au-dessus du vide, vaguement accrochée au télésiège dont elle avait raté la montée, et sur lequel Manon et Antoine, son mari, tous les deux terrorisés, essayaient de la hisser."
                            },
                            {
                                "example_id": "d62de188-76bb-4202-8edf-ccfbfb50fa3d",
                                "sense_id": "585147d8-781a-3dc5-abc2-3667f8de53ea",
                                "text": "1ᵉʳ mars 1987: La rupture du dernier pylône d’un télésiège à Luz-Ardiden (Hautes-Pyrénées, France) entraîne la chute d’une cinquantaine de nacelles transportant ce jour-là près de 200 skieurs: 6 morts et une centaine de blessés dont 38 graves."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47f2689d-b1d1-4f94-a0db-4592779f57d8",
                        "source_entry_id": "cbf8c7a8-25bd-3ab1-af08-ac07737034d7",
                        "source_sense_id": "585147d8-781a-3dc5-abc2-3667f8de53ea",
                        "target_lang_word": "Sesselbahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sesselbahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "838e386b-0937-3bcf-81c3-57b76841e9d4",
                                        "entry_id": "39b4c582-ce2f-304b-b46d-51f29ec6d592",
                                        "glosses": [
                                            "Seilbahn, bei der Personen in offenen Sitzen (ohne Wetterschutz) befördert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7359344d-dd6a-48fd-a1f7-2a5201709aeb",
                                                "sense_id": "838e386b-0937-3bcf-81c3-57b76841e9d4",
                                                "text": "„In der Sesselbahn bei Boppard durfte ich neben Tante Dagmar sitzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11b8cb15-0454-4184-9022-a38a4cb09f6a",
                        "source_entry_id": "cbf8c7a8-25bd-3ab1-af08-ac07737034d7",
                        "source_sense_id": "585147d8-781a-3dc5-abc2-3667f8de53ea",
                        "target_lang_word": "Sessellift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sessellift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91b3b21f-b724-3394-8cd5-2300b60bb7a2",
                                        "entry_id": "a7c5f7ac-f672-3cb1-8d4c-063b7ad5a068",
                                        "glosses": [
                                            "Seilbahn, bei der Personen in offenen Sitzen (ohne Wetterschutz) befördert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8cf6453-7d9a-4e52-8f3b-a8c70d11edc7",
                                                "sense_id": "91b3b21f-b724-3394-8cd5-2300b60bb7a2",
                                                "text": "„Damit ich aber einen guten Eindruck von Cochem erhalte, würden wir nach dem Gottesdienst mit dem Sessellift hinauf auf die Höhe über Cochem fahren.“"
                                            },
                                            {
                                                "example_id": "5e879289-197f-42af-a5a7-b1506b2d1bf0",
                                                "sense_id": "91b3b21f-b724-3394-8cd5-2300b60bb7a2",
                                                "text": "„Gemeinsam fuhren sie mit dem Sessellift zu einem Trainingshang, der den Rennfahrerinnen zum Aufwärmen dient.“"
                                            },
                                            {
                                                "example_id": "ef921944-fdf6-4085-89f1-5f1e7b2518e8",
                                                "sense_id": "91b3b21f-b724-3394-8cd5-2300b60bb7a2",
                                                "text": "„Die meisten Gäste sind Tagestouristen, die für einige Stunden die Weinstuben bevölkern oder mit dem Sessellift zum Niederwald-Denkmal hinauffahren.“"
                                            },
                                            {
                                                "example_id": "5e592f59-6307-4c6d-a26e-4446e379250e",
                                                "sense_id": "91b3b21f-b724-3394-8cd5-2300b60bb7a2",
                                                "text": "„Damit ich aber einen guten Eindruck von Cochem erhalte, würden wir nach dem Gottesdienst mit dem Sessellift hinauf auf die Höhe über Cochem fahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
