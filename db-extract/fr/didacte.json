                        "examples": [
                            {
                                "example_id": "e0608c7c-39c7-4803-b122-1edf5a13179e",
                                "sense_id": "1effc7c6-ada8-363d-bea1-d263c72885a7",
                                "text": "Rien de moins vague, en effet, que ces préceptes émanant d'un didacte doublé d'un fin observateur."
                            },
                            {
                                "example_id": "dc9c7d1a-5cde-4115-9a73-7ce4775d4d1e",
                                "sense_id": "1effc7c6-ada8-363d-bea1-d263c72885a7",
                                "text": "Et enfin, Menn est un didacte : c'est un docteur. Il tient école, et son influence est puissante ; il dirige dans des voies hardies et sûres ... Comme tout cela est genevois, j'allais dire calviniste !"
                            },
                            {
                                "example_id": "65d04481-be55-4492-a925-d79669588718",
                                "sense_id": "1effc7c6-ada8-363d-bea1-d263c72885a7",
                                "text": "Saint François n'est pas un didacte de la plume."
                            },
                            {
                                "example_id": "e7249783-cdf2-44cf-9632-ea3e314125b1",
                                "sense_id": "1effc7c6-ada8-363d-bea1-d263c72885a7",
                                "text": "Le poète n'est pas un faiseur, un technicien, un didacte […]"
                            },
                            {
                                "example_id": "9dc42688-4f1d-4e98-a74e-291315636ef1",
                                "sense_id": "1effc7c6-ada8-363d-bea1-d263c72885a7",
                                "text": "D'ailleurs c'était un économiste, un didacte, nullement un poète."
                            }
                        ]
                    }
                ],
