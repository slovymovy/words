                    {
                        "translation_id": "cfb2866c-c222-4e33-9eff-37ca1dcea3b3",
                        "source_entry_id": "4ea756f3-fd46-3f96-9b34-beeda9bc2283",
                        "source_sense_id": "236332ab-5e70-350c-8b34-dbc3ab68aaf0",
                        "target_lang_word": "Wäsche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wäsche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a9d33cc-2f90-36ab-9481-47c30d53191b",
                                        "entry_id": "c1dbcff4-0244-36bf-b23b-eb474b475cdd",
                                        "glosses": [
                                            "Gesamtheit mehrerer Kleidungs- und Textilstücke, die kürzlich gewaschen wurden oder gewaschen werden sollen"
                                        ],
                                        "tags": [
                                            "Plural ungebräuchlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c7d838f-5ef7-4d03-8a73-57ca2c1e1ff6",
                                                "sense_id": "5a9d33cc-2f90-36ab-9481-47c30d53191b",
                                                "text": "Ich muss noch die Wäsche bügeln."
                                            },
                                            {
                                                "example_id": "e43bf5ae-0eee-4d33-bbaf-b8bf4b3fb64a",
                                                "sense_id": "5a9d33cc-2f90-36ab-9481-47c30d53191b",
                                                "text": "„Am nächsten Morgen führte Claimont ein hochgewachsenes Mädchen in mein Zimmer, das mich an die Jüdin Lia erinnerte und schön war wie sie, aber weniger dünkelhaft; denn sie kam nur, um sich meiner Wäsche und meiner Spitzen anzunehmen.“"
                                            },
                                            {
                                                "example_id": "5167e3a5-a1b4-4dac-bb42-8ef31b28ba25",
                                                "sense_id": "5a9d33cc-2f90-36ab-9481-47c30d53191b",
                                                "text": "„Seine Wäsche gibt Papa Mostmann in die Wäscherei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cee99d3b-5ef1-3cb7-b65f-407be34846e5",
                                        "entry_id": "c1dbcff4-0244-36bf-b23b-eb474b475cdd",
                                        "glosses": [
                                            "der Vorgang des Waschens von ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "231e0f14-210e-4a88-87a7-f555feb1d025",
                                                "sense_id": "cee99d3b-5ef1-3cb7-b65f-407be34846e5",
                                                "text": "Ich gebe die Hose in die Wäsche."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "30c13d33-1f3d-3cae-8020-7105e58f6bc2",
                                        "entry_id": "c1dbcff4-0244-36bf-b23b-eb474b475cdd",
                                        "glosses": [
                                            "meist im Ausland stattfindende Vorgehensweise, Geld so anzulegen, dass seine Herkunft aus kriminellen Machenschaften nicht mehr nachweisbar ist"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f27d67fb-6797-41c5-8069-8d24208fa05b",
                                                "sense_id": "30c13d33-1f3d-3cae-8020-7105e58f6bc2",
                                                "text": "Er wurde wegen der Wäsche des Geldes angeklagt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1c701343-ef8a-3fb5-b371-110fb7663a78",
                                        "entry_id": "c1dbcff4-0244-36bf-b23b-eb474b475cdd",
                                        "glosses": [
                                            "(Damen-)Unterwäsche"
                                        ],
                                        "tags": [
                                            "einschränkend für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f53031d2-a19f-490e-a359-b7f13632944e",
                                                "sense_id": "1c701343-ef8a-3fb5-b371-110fb7663a78",
                                                "text": "Sie verdiente ihr Geld damit, auf Modenschauen Wäsche vorzuführen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f85bf8d3-9fe4-400b-ab91-5050286ac0e5",
                        "source_entry_id": "4ea756f3-fd46-3f96-9b34-beeda9bc2283",
                        "source_sense_id": "236332ab-5e70-350c-8b34-dbc3ab68aaf0",
                        "target_lang_word": "Waschen",
