                        "entry_id": "09de232f-d6e8-3ca5-8c91-f5a547f685e4",
                        "glosses": [
                            "großer, flacher Stein, der so weit aus dem Wasser oder aus dem Boden herausragt, dass man darübergehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17868bdd-c0d1-4673-8ff1-9a81448bd6aa",
                                "sense_id": "f503f527-fcf4-3d66-a1bd-c0397125b126",
                                "text": "An der Furt waren auch Trittsteine in den Bach gelegt, so dass man ihn trockenen Fußes überqueren kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afbc8f5e-9ec2-46aa-89ad-b5364e592c29",
                        "source_entry_id": "09de232f-d6e8-3ca5-8c91-f5a547f685e4",
                        "source_sense_id": "f503f527-fcf4-3d66-a1bd-c0397125b126",
                        "target_lang_word": "stepping stone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stepping stone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "536bbd9c-fc3d-3329-9b43-a60b60de1549",
                                        "entry_id": "929939f3-d30b-311b-9a82-a937e19dcf3c",
                                        "glosses": [
                                            "A stone that can be stepped on in crossing something, especially a marsh or creek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db41592f-3657-4dbd-88ac-22ccba472841",
                                                "sense_id": "536bbd9c-fc3d-3329-9b43-a60b60de1549",
                                                "text": "Falling—her veriest stepping-stone\nShall form the pedestal of a throne— […]"
                                            },
                                            {
                                                "example_id": "88b992f9-4d6b-46da-995d-3e7843f668f2",
                                                "sense_id": "536bbd9c-fc3d-3329-9b43-a60b60de1549",
                                                "text": "Pretty stone cottages overlook the river's northern bank, and a short footpath 200 yds beyond the post office leads to stepping-stones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5d5fe82-181c-320e-8f89-4416fd1fddd2",
                                        "entry_id": "929939f3-d30b-311b-9a82-a937e19dcf3c",
                                        "glosses": [
                                            "Something used as a way to progress to something or somewhere else."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2134fba6-d85c-4de6-ba4f-66b6fd999315",
                                                "sense_id": "e5d5fe82-181c-320e-8f89-4416fd1fddd2",
                                                "text": "He was full of ambition, and force, and life, intending all sorts of great things, and meaning to make his position a stepping stone to all that was excellent in public life."
                                            },
                                            {
                                                "example_id": "c9680dca-5317-4caa-ba77-a27c7a8d7b29",
                                                "sense_id": "e5d5fe82-181c-320e-8f89-4416fd1fddd2",
                                                "text": "Esperanto can make a good stepping stone language to Latin, which may be difficult for amateur linguists."
                                            },
                                            {
                                                "example_id": "f3c5e615-d895-400d-9be5-06aadd4d7410",
                                                "sense_id": "e5d5fe82-181c-320e-8f89-4416fd1fddd2",
                                                "text": "I held it truth, with him who sings\n⁠To one clear harp in divers tones,\n⁠That men may rise on stepping-stones\nOf their dead selves to higher things."
                                            },
                                            {
                                                "example_id": "fe9ae223-c895-4ff0-85d5-879aee6f488b",
                                                "sense_id": "e5d5fe82-181c-320e-8f89-4416fd1fddd2",
                                                "text": "It has already been shown that the Manchester South Junction & Altrincham (itself the joint property of the London & North Western and and the Manchester, Sheffield & Lincolnshire Railways) served as a stepping stone by which the M.S.L.R. and G.N.R. extended their services from Manchester to Liverpool, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
