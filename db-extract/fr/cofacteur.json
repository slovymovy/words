                "senses": [
                    {
                        "sense_id": "6650824c-232f-3b01-b83d-05f81560398d",
                        "entry_id": "c3c5b379-f267-3848-aac3-4a74d5853c91",
                        "glosses": [
                            "Une « molécule d’assistance », une substance chimique non protéique, mais qui est liée à une protéine, et qui est nécessaire à l’activé biologique de cette protéine, laquelle est souvent un enzyme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffa3b8e9-31cc-466c-b791-67ea5cff7bb7",
                                "sense_id": "6650824c-232f-3b01-b83d-05f81560398d",
                                "text": "Il est probable que la machinerie biologique qui garantit la fixation du cofacteur adéquat à la protéine correcte, au moment où l’organisme vivant en a besoin, est prépondérante dans l'ensemble du monde vivant."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e2caa7b-96fc-350a-b405-9e0367d901d6",
                        "entry_id": "c3c5b379-f267-3848-aac3-4a74d5853c91",
                        "glosses": [
                            "Coefficient d’une comatrice."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
