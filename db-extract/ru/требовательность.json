                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "990615b8-6980-34e3-bdb3-9dbd10550df5",
                                        "entry_id": "bafd4a41-2bd0-3bcb-b3bb-1c820b4c9fc6",
