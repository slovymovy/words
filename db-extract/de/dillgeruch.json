                    {
                        "sense_id": "f1c62977-0211-3d84-adba-b120ea0fa50d",
                        "entry_id": "f9fa34d4-cab6-3299-be16-0ed5a630be77",
                        "glosses": [
                            "Wahrnehmung von Geruch in der Luft oder an sich selbst, der von Dill stammt; explizite Zuordnung eines natürlichen Geruchsstoffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2dddbba-735c-4dcf-8777-98d4829ddb23",
                                "sense_id": "f1c62977-0211-3d84-adba-b120ea0fa50d",
                                "text": "„Die ganze Pflanze verströmt den typischen stark würzigen Dillgeruch.“"
                            },
                            {
                                "example_id": "d8c1510f-b4bd-42e8-aca2-d7f3344c7dcb",
                                "sense_id": "f1c62977-0211-3d84-adba-b120ea0fa50d",
                                "text": "„Dillgeruch hängt in der Luft.“"
                            },
                            {
                                "example_id": "9fb03445-b5d9-4630-9581-16b4ae69b8c6",
                                "sense_id": "f1c62977-0211-3d84-adba-b120ea0fa50d",
                                "text": "„Die Hauptsubstanzen im Öl sind Dillether und Phellandren, sie bestimmen den typischen Dillgeruch.“"
                            }
                        ],
