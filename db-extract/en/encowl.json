                        "sense_id": "089f4c26-54c3-3638-922d-10140b6e2ecd",
                        "entry_id": "4c03d5b9-eb1f-3b9d-87d0-e6a59616faed",
                        "glosses": [
                            "To clothe (as) in a cowl; to make (someone) a monk."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1a016e3a-ad36-49ad-9ec7-7499ba281d12",
                                "sense_id": "089f4c26-54c3-3638-922d-10140b6e2ecd",
                                "text": "King Alfred that his Christ he might more surely hold,\nLeft his Northumbrian Crowne, and soone became encould,"
                            },
                            {
                                "example_id": "f29b8e46-9928-4cd9-9857-9dc9fe7fef0f",
                                "sense_id": "089f4c26-54c3-3638-922d-10140b6e2ecd",
                                "text": "1655, anonymous poem from the collection The Marrow of Compliments, in A. H. Bullen (ed.), Speculum Amantis, London, 1889, p. 98,\nAnd is’t not brave when summer’s robes\nHave all the fields encowled\nTo have a green gown on the grass\nAnd wear it uncontroul’d?"
                            }
                        ]
                    }
