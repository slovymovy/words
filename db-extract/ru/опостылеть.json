                                        "entry_id": "38847210-2525-3f2e-83e3-425ba93cf3a5",
                                        "glosses": [
                                            "One who inspires boredom or lack of interest; an uninteresting person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d660f34-fa54-4682-8a43-ba35427a43c4",
                                                "sense_id": "3f0f1ba0-4f37-3379-8ee1-54bd0fe0875a",
                                                "text": "My neighbour is such a bore when he talks about his coin collection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64d215ac-ef69-3661-93b0-1cdea9981328",
                                        "entry_id": "38847210-2525-3f2e-83e3-425ba93cf3a5",
                                        "glosses": [
                                            "Something dull or uninteresting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48b53d96-f5ce-465a-ba97-60a5a89748ef",
                                                "sense_id": "64d215ac-ef69-3661-93b0-1cdea9981328",
                                                "text": "What a bore that movie was! There was no action, and the dialogue was totally uncreative."
                                            },
                                            {
                                                "example_id": "037b3256-da35-496f-9804-91e12537e532",
                                                "sense_id": "64d215ac-ef69-3661-93b0-1cdea9981328",
                                                "text": "It is as great a bore as to hear a poet read his own verses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "513ff40d-a615-3939-9d2d-9ceb2c797090",
                                        "entry_id": "38847210-2525-3f2e-83e3-425ba93cf3a5",
                                        "glosses": [
                                            "Calibre; importance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a47d7e5c-5c9b-4bda-bdef-c74a3c1a1db7",
                                                "sense_id": "513ff40d-a615-3939-9d2d-9ceb2c797090",
                                                "text": "Yet are they much too light for the bore of the matter."
                                            }
                                        ]
                                    }
                                ]
                            },
