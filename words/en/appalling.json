    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "19b03695-25fb-3683-ae83-809acc1de0b7",
                    "sense_definition": "Causing shock or horror.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negative_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That was an <w>appalling</w> waste of money.",
                            "target_lang_translations": {
                                "nl": "Dat was een <w>afschuwelijke</w> verspilling van geld."
                            }
                        },
                        {
                            "text": "The conditions in the prison were truly <w>appalling</w>.",
                            "target_lang_translations": {
                                "nl": "De omstandigheden in de gevangenis waren werkelijk <w>afschuwelijk</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "horrid",
                        "terrible"
                    ],
                    "common_phrases": [
                        "appalling conditions",
                        "appalling waste"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets dat schokkend of afschuwelijk is."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afschuwelijk",
                                "target_lang_sense_clarification": "Iets dat gevoelens van afkeer of afschuw oproept."
                            },
                            {
                                "target_lang_word": "ontzettend",
                                "target_lang_sense_clarification": "Iets dat schokkend is of angst inboezemt."
                            },
                            {
                                "target_lang_word": "verschrikkelijk",
                                "target_lang_sense_clarification": "Iets dat zeer erg of schokkend is."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e3503e4-7379-38ef-bc04-7c80eb086b30",
                    "sense_definition": "Extremely bad or poor in quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negative_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their behavior on the train was <w>appalling</w>.",
                            "target_lang_translations": {
                                "nl": "Hun gedrag in de trein was <w>zeer slecht</w>."
                            }
                        },
                        {
                            "text": "The team played an <w>appalling</w> game yesterday.",
                            "target_lang_translations": {
                                "nl": "Het team speelde gisteren een <w>beroerde</w> wedstrijd."
                            }
                        }
                    ],
                    "synonyms": [
                        "awful",
                        "terrible"
                    ],
                    "common_phrases": [
                        "appalling behavior",
                        "appalling performance"
                    ],
                    "target_lang_definitions": {
                        "nl": "Van zeer slechte kwaliteit of zeer gebrekkig."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zeer slecht",
                                "target_lang_sense_clarification": "Iets dat van een zeer lage kwaliteit is."
                            },
                            {
                                "target_lang_word": "beroerd",
                                "target_lang_sense_clarification": "Iets dat erg slecht of onvoldoende is."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b3a20ec-519d-33e6-80ae-cb1d935d1bb4",
