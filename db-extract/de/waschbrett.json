                                "target_senses": [
                                    {
                                        "sense_id": "29cf6c0e-2c06-3f93-89a8-9407669a25e0",
                                        "entry_id": "110dfcbd-39ce-311f-a802-9a45b0279281",
                                        "glosses": [
                                            "A board with a corrugated surface against which laundry may be rubbed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b23fa170-8f2c-365c-91ae-78ff00cfe955",
                                        "entry_id": "110dfcbd-39ce-311f-a802-9a45b0279281",
                                        "glosses": [
                                            "Such a board used as a simple percussion instrument."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cea2b607-525e-3b12-90b4-f19f11a91703",
                                        "entry_id": "110dfcbd-39ce-311f-a802-9a45b0279281",
                                        "glosses": [
                                            "A board fastened along a ship's gunwale to prevent splashing; a splashboard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3623630-9faf-38a8-970d-9032275a9d37",
                                        "entry_id": "110dfcbd-39ce-311f-a802-9a45b0279281",
                                        "glosses": [
                                            "A stretch of ripples or bumps on a dirt or gravel road caused by interaction between traffic and road surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4e0d8a7-52cf-417a-9fcd-c89b9197aad5",
                                                "sense_id": "a3623630-9faf-38a8-970d-9032275a9d37",
                                                "text": "washboard road"
                                            },
                                            {
                                                "example_id": "c9999d99-89d7-409d-be25-9488a3ba88d0",
                                                "sense_id": "a3623630-9faf-38a8-970d-9032275a9d37",
                                                "text": "Franklin is beside himself, revving up the engine in the pickup. As I jump in, he spins out and takes off up the road in the direction the plane came from, bouncing dangerously over washboards and ruts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9f1fbeb-1638-3d8b-a73d-aaf7f59be03d",
                                        "entry_id": "110dfcbd-39ce-311f-a802-9a45b0279281",
                                        "glosses": [
                                            "Ellipsis of washboard abs."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "colloquial",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce5f725d-9c24-3e06-a287-edc4833f3c32",
                                        "entry_id": "110dfcbd-39ce-311f-a802-9a45b0279281",
                                        "glosses": [
                                            "Baseboard; skirting board."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "washboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bf947f0-4558-3ee5-97c4-274ebd963ccf",
                                        "entry_id": "afbd2f80-7b81-347e-90c6-896613bdc941",
                                        "glosses": [
                                            "To produce a rippled texture on a surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ed3954b-0a4d-451b-b53b-2eebd69b2e3e",
                                                "sense_id": "7bf947f0-4558-3ee5-97c4-274ebd963ccf",
                                                "text": "Doug came up with a half-guilty smile and washboarded his forehead at her."
                                            },
                                            {
                                                "example_id": "6ba9139d-2620-4fbc-8eb2-b6cc449c85df",
                                                "sense_id": "7bf947f0-4558-3ee5-97c4-274ebd963ccf",
                                                "text": "The rip that was generated by each change of tide had scoured the bottom white and washboarded the sand where it was still layered over the hardpan coral floor."
                                            },
                                            {
                                                "example_id": "da43a4a0-1699-4426-8c45-ffd4e79a2d1b",
                                                "sense_id": "7bf947f0-4558-3ee5-97c4-274ebd963ccf",
                                                "text": "The low bass brruummmp of 20-mm slugs going out washboarded the bulkheads."
                                            },
                                            {
                                                "example_id": "7b1ca852-ab0c-4223-9d95-fbe410f246fc",
                                                "sense_id": "7bf947f0-4558-3ee5-97c4-274ebd963ccf",
                                                "text": "She drove as fast as she dared, braking for the frost heaves that washboarded the blacktop and on her dirt road, bouncing in and out of the clay ruts cut by the flow of runoff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0451849e-13ca-32ff-916a-c2abef576991",
                                        "entry_id": "afbd2f80-7b81-347e-90c6-896613bdc941",
                                        "glosses": [
                                            "To play a washboard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d0a146-4d97-4dcd-849b-227d09ee96a8",
                                                "sense_id": "0451849e-13ca-32ff-916a-c2abef576991",
                                                "text": "It's almost as if the urge to washboard is intrinsically human."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e10aca7-bbae-3577-a571-ca3b14d69da6",
                                        "entry_id": "afbd2f80-7b81-347e-90c6-896613bdc941",
                                        "glosses": [
                                            "To move up and down or back and forth across the surface of a hive, possibly to lay down a layer of propolis and wax."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79757d10-2ad3-4e52-9fac-bfed8aff5884",
                                                "sense_id": "7e10aca7-bbae-3577-a571-ca3b14d69da6",
                                                "text": "Individual bees have been observed washboarding on the inside glass of an observation hive."
                                            },
                                            {
                                                "example_id": "95e1d7bb-1101-4a8f-9e88-fad02c810d1a",
                                                "sense_id": "7e10aca7-bbae-3577-a571-ca3b14d69da6",
                                                "text": "This behaviour is believed to be associated with general cleaning activities but under what circumstances workers washboard is not known."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42865b17-e89e-45c3-b1c0-df6ae71e101c",
                        "source_entry_id": "97086db7-2f59-358a-88f3-d616ba8b26f4",
                        "source_sense_id": "33e02100-8c19-37dc-bfd8-38aba76ff084",
                        "source_sense_description": "geriffelte Platte aus Holz oder Blech, die zum Waschen von Textilien verwendet wurde",
                        "target_lang_word": "planche à laver",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "planche à laver",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22ba2c12-1671-3b31-800b-4d9450fa4079",
                                        "entry_id": "c83425be-eccb-3f44-b344-a5366e5c63ce",
                                        "glosses": [
                                            "Planche avec des indentations pour mieux frotter le linge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c04bbd8-b305-4a29-a26f-60ca4a687b8c",
                                                "sense_id": "22ba2c12-1671-3b31-800b-4d9450fa4079",
                                                "text": "Le premier qui me dit que c’était mieux avant, je lui fais laver son linge à la brosse à chiendent sur la planche à laver, à genoux dans le baquet, les mains dans l’eau glacée du lavoir, par moins dix degrés dehors, et sans gants Mappa, ça n’existait pas !"
                                            },
                                            {
                                                "example_id": "d0d07568-37c8-4121-8b12-cac5fd83d39f",
                                                "sense_id": "22ba2c12-1671-3b31-800b-4d9450fa4079",
                                                "text": "Quand l'électroménager était encore trop cher pour la plupart des ménages, on trouvait une planche à laver dans chaque foyer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0ee8836-f15e-3d9c-ae58-638e2f3af074",
                                        "entry_id": "c83425be-eccb-3f44-b344-a5366e5c63ce",
                                        "glosses": [
                                            "Instrument de musique, plaque de métal avec des indentations pour servir de percussion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de91ca7a-3f11-4beb-ab48-27265096c78a",
                                                "sense_id": "b0ee8836-f15e-3d9c-ae58-638e2f3af074",
                                                "text": "Ensuite, un retour à cette joyeuse formation que fut l’orchestre dit « de washboard », une planche à laver additionnée d’instruments hétéroclites – Gus Wallez y gratte une authentique planche à laver sur l’air de Tiger rag."
                                            },
                                            {
                                                "example_id": "418bf988-fce4-4103-bd31-2fa45f883d01",
                                                "sense_id": "b0ee8836-f15e-3d9c-ae58-638e2f3af074",
                                                "text": "Sa particularité est d’utiliser des instruments bricolés à partir d’ustensiles ménagers : la batterie est remplacée par une planche à laver; la contrebasse, par un baquet à lessive (ou une caisse à thé) associé à un manche à balai, auquel est accrochée l’unique corde …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
