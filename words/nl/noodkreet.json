                    "semantic_group_id": "hulpvraag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De burgemeester slaakte een <w>noodkreet</w> omdat er te weinig geld was voor de opvang van vluchtelingen.",
                            "target_lang_translations": {
                                "en": "The mayor issued a <w>cry for help</w> because there was too little money for the reception of refugees."
                            }
                        },
                        {
                            "text": "Toen het schip begon te zinken, hoorden de reddwerkers een wanhopige <w>noodkreet</w> over de radio.",
                            "target_lang_translations": {
                                "en": "When the ship began to sink, the rescuers heard a desperate <w>distress call</w> over the radio."
                            }
                        }
                    ],
