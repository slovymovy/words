                                                "example_id": "4d995be6-0d92-4a25-80c4-d9f6f4d68d5f",
                                                "sense_id": "40ea3203-be93-3ee1-893b-91149d5126f2",
                                                "text": "Het kind lacht om de grappige clown."
                                            },
                                            {
                                                "example_id": "4017d123-780e-4970-a37b-78851ce55783",
                                                "sense_id": "40ea3203-be93-3ee1-893b-91149d5126f2",
                                                "text": "'Ik weet niet waarom je dat grappig vindt."
                                            },
                                            {
                                                "example_id": "f0dfb0de-5e9d-4d85-aba8-cd7aba13665c",
                                                "sense_id": "40ea3203-be93-3ee1-893b-91149d5126f2",
                                                "text": "Pierewiet. Pierewiet. Het lied met pierewiet gaat over een merel in de lente. Dat mag best, nu de lente in het jasje van de herfst is gaan wonen. Samuel heeft geregeld muziektherapie en voor woorden als pierewiet, zeker bij herhaling uitgesproken, kun je hem wakker maken. Mooie, grappige klank. De herhaling van de ie, de rollende r. Hij lacht uitbundig bij een gezongen pierewiet. Nog een keer, dat refrein. En nog eens."
                                            },
                                            {
                                                "example_id": "7c5ff98e-f125-4edd-bfb7-3836f3c4b249",
                                                "sense_id": "40ea3203-be93-3ee1-893b-91149d5126f2",
                                                "text": "Grappig vond ik zijn opmerking over het motief van mijn reis: ‘Wat is het nut van je wandeling? Je bereikt en verdient er niks mee.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37928c4c-e4e5-4794-9c67-043181838f1e",
                        "source_entry_id": "ff7e343f-9871-3755-85f0-d023a2403ff4",
                        "source_sense_id": "960a3717-437a-31d2-949a-9c8091e06026",
                        "target_lang_word": "komisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "komisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7bcf5f1e-9889-3f56-a7ec-60377277907d",
                                        "entry_id": "18869606-7a30-3688-90cd-78a376aefbdc",
                                        "glosses": [
                                            "de lachlust opwekkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e22cc3b-ec23-4e5a-9fd8-dff727473d0c",
                                                "sense_id": "7bcf5f1e-9889-3f56-a7ec-60377277907d",
                                                "text": "Haar komische timing is waanzinnig, de kwetsbaarheid die ze eronder legt is zo mogelijk nog indrukwekkender. Haar koningin Anne is als de film zelf: verschrikkelijk grappig en oneindig tragisch. Wereldvreemd, en daarmee juist zo menselijk."
                                            },
                                            {
                                                "example_id": "e44e7ca4-110a-465e-8bc4-be5ae89e5c1a",
                                                "sense_id": "7bcf5f1e-9889-3f56-a7ec-60377277907d",
                                                "text": "En hij had zich voorzien van een taalgebruik dat bijna komisch elegant klonk in de mond van een achttienjarige."
                                            },
                                            {
                                                "example_id": "f92f5757-6765-480c-a0a6-c0e076b7f5a5",
                                                "sense_id": "7bcf5f1e-9889-3f56-a7ec-60377277907d",
                                                "text": "Op een bepaalde manier was het bijna komisch dat je terugkeerde naar de techniek van een andere tijd, van voor het beton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44a878e7-b01e-43b8-a668-49aa33c3c335",
                        "source_entry_id": "ff7e343f-9871-3755-85f0-d023a2403ff4",
                        "source_sense_id": "960a3717-437a-31d2-949a-9c8091e06026",
