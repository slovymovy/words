                        "examples": [
                            {
                                "example_id": "4719f652-e7e7-402a-9fa9-e6c5f9736eac",
                                "sense_id": "1776c35a-db31-3614-8b9d-c9a6bf75efae",
                                "text": "„Die Hebamme hieß Frau Rassmann und wohnte in Mathesdorf, fünf Straßenbahnstationen vom Haus der Eckerts entfernt.“"
                            },
                            {
                                "example_id": "67c8c46f-f2cb-4688-a7e2-ccf924de0ed7",
                                "sense_id": "1776c35a-db31-3614-8b9d-c9a6bf75efae",
                                "text": "„Neulich, sieben Jahre nach dieser Zeit im Lehrlingsheim, sah ich Frau Wietzel an einer Straßenbahnstation stehen, und ich stoppte meinen Wagen, stieg aus und bot ihr an, sie in die Stadt zu bringen.“"
                            }
                        ],
