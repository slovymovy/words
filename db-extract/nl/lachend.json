                        "examples": [
                            {
                                "example_id": "faae5771-ab2a-4052-9bfb-a3940c6c010b",
                                "sense_id": "0d07e0d2-3940-3986-b556-a875321bfc85",
                                "text": "'Hè?' 'Uw sigaretten!' De vorige avond had hij verkondigd dat hij naar Malaga moest om sigaretten te kopen en bij een kunstenaar te gaan kijken - misschien ontdek ik wel de nieuwe Picasso, had hij lachend gezegd, alsof de bliksem inderdaad tweemaal op dezelfde plaats zou inslaan."
                            },
                            {
                                "example_id": "d4b31c11-0c10-4025-aa6a-fe81e428a358",
                                "sense_id": "0d07e0d2-3940-3986-b556-a875321bfc85",
                                "text": "'Hè?' 'Uw sigarettenl' De vorige avond had hij verkondigd dat hij naar Malaga moest om sigaretten te kopen en bij een kunstenaar te gaan kijken - misschien ontdek ik wel de nieuwe Picasso, had hij lachend gezegd, alsof de bliksem inderdaad tweemaal op dezelfde plaats zou inslaan."
                            },
                            {
                                "example_id": "259e90fd-b180-4c07-b956-46946d76715f",
                                "sense_id": "0d07e0d2-3940-3986-b556-a875321bfc85",
                                "text": "'Ik denk niet dat u gek wordt,' zei Teresa, en Olive gaf haar lachend een duwtje tegen haar schouder."
                            }
                        ]
                    }
