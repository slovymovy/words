                                            {
                                                "example_id": "f4573fa0-490b-46e7-ab65-c99c4b97a2f0",
                                                "sense_id": "6efc315c-9155-35e6-98a3-e5b455cc7d29",
                                                "text": "The word \"face\" is a holonym of the word \"eye\", which is a holonym of the word \"retina\"."
