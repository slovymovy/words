                        "cross_references": []
                    },
                    {
                        "translation_id": "e003e1fd-c327-4059-83c3-6367de5ee294",
                        "source_entry_id": "040d0a69-6261-33c4-a91b-10184a06f263",
                        "source_sense_id": "ebad0f6f-f830-309c-8fd9-bbefcb41213f",
