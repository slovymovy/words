            "senses": [
                {
                    "sense_id": "78442a1a-ccf2-308c-a38f-07e67452224a",
                    "sense_definition": "Qui donne une fausse impression ou induit facilement en erreur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "erreur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas se fier à ce calme <w>trompeur</w>, car la tempête va bientôt arriver."
                        },
                        {
                            "text": "Ces premiers symptômes sont très <w>trompeurs</w> et ressemblent à ceux d'une simple grippe."
                        }
                    ],
                    "synonyms": [
                        "illusoire",
                        "fallacieux"
                    ],
                    "antonyms": [
                        "évident",
                        "clair"
                    ],
                    "common_phrases": [
