                "senses": [
                    {
                        "sense_id": "a0986773-d2b2-3424-8858-b74b04fa87e8",
                        "entry_id": "eda909ec-cafd-33a8-9a7c-fb1dcf361758",
                        "glosses": [
                            "Person, die bei Filmen Regie führt, als Regisseur von Filmen tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b7cab01-19f6-4a08-9e4e-24d40a7f893e",
                                "sense_id": "a0986773-d2b2-3424-8858-b74b04fa87e8",
                                "text": "„Mein Freund, Luis Buñuel, ist Filmregisseur.“"
                            },
                            {
                                "example_id": "d2be5451-d8a5-4b57-a000-cf6b3462cef8",
                                "sense_id": "a0986773-d2b2-3424-8858-b74b04fa87e8",
                                "text": "„Sofern Giyoungs Erinnerung stimmte, hatte dieses Vorbereitungstraining stattgefunden, kurz bevor Südkoreas bekanntester Filmregisseur zusammen mit seiner Frau zurück nach Südkorea geflohen war.“"
                            },
                            {
                                "example_id": "d1314769-10ab-4ec3-8f6f-bea75cf714d9",
                                "sense_id": "a0986773-d2b2-3424-8858-b74b04fa87e8",
                                "text": "„Weitere Recherchen ergaben, dass die Schauspielerin mit einem iranischen Filmregisseur verheiratet war und deshalb nicht die Frau von Doktor Ali sein konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
