                        "entry_id": "bd25d7f7-178f-35fd-b798-42a492e1ac67",
                        "glosses": [
                            "Grand oiseau noir de l’ordre des Échassiers, dont la tête est ornée d’une espèce de casque et dont les ailes sont armées d’éperons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1881d81-6f6c-434f-ac4e-6e52a160954f",
                                "sense_id": "817037ad-5d04-361b-8914-cc4962bb3d56",
                                "text": "Le kamichi habite dans les marécages de la Guyane et du Brésil."
                            },
                            {
                                "example_id": "62c0eb32-48a7-4761-a2e6-db343111ab90",
                                "sense_id": "817037ad-5d04-361b-8914-cc4962bb3d56",
                                "text": "D’après Buffon, cet oiseau était appelé kamichi par les peuples de Guyane et anhima par ceux du Brésil."
                            }
                        ]
                    }
                ],
