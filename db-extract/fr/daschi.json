                        "entry_id": "f649b94b-f06e-3e7b-ac94-da297faf00f7",
                        "glosses": [
                            "Espèce arborescente qui végète dans les brousses africaines. (Commiphora africana)."
                        ],
                        "tags": [
                            "Niger"
                        ],
                        "examples": [
                            {
                                "example_id": "b40e91da-3b08-4293-9153-ba6a17bbd5f7",
                                "sense_id": "a4097622-0dc7-3914-999e-64abf346445f",
                                "text": "Une maigre brousse arborescente hérisse les parties basses du terrain — bouquets de daschi et de candili garnis de plus d'épines que de feuilles."
                            },
                            {
                                "example_id": "1bc3b24a-1af6-4174-8c53-21813f32b1fe",
                                "sense_id": "a4097622-0dc7-3914-999e-64abf346445f",
                                "text": "On rencontre fréquemment dans les brousses isolées autour des daschi (Commiphora africana), dont l'ombre est suffisante, des sortes de manèges circulaires, piste d'environ 50 cm. de large, piétinée comme si un ou plusieurs animaux avaient passé des jours à trotter en rond."
                            }
                        ]
                    }
