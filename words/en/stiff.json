{
    "word_family": [
        "stiffen",
        "stiffly",
        "stiffness",
        "stiffener",
        "stiff-necked"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "38c5aa4f-d39b-3146-9225-c6224d86d85a",
                    "sense_definition": "Rigid; hard to bend or move; not flexible.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_rigidity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new boots are very <w>stiff</w> and hurt my feet.",
                            "target_lang_translations": {
                                "ru": "Новые ботинки очень <w>жёсткие</w> и натирают мне ноги.",
                                "zh": "这双新靴子很<w>硬</w>，把我的脚磨疼了。"
                            }
                        },
                        {
                            "text": "Use a <w>stiff</w> brush to clean the dried mud off your shoes.",
                            "target_lang_translations": {
                                "ru": "Используйте <w>жёсткую</w> щётку, чтобы счистить засохшую грязь с обуви.",
                                "zh": "用<w>硬</w>毛刷把鞋上的干泥刷掉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rigid",
                        "hard",
                        "firm",
                        "inflexible",
                        "unbending"
                    ],
                    "antonyms": [
                        "flexible",
                        "soft",
                        "malleable"
                    ],
                    "common_phrases": [
                        "stiff cardboard",
                        "stiff brush",
                        "stiff collar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жёсткий; трудно сгибаемый или подвижный; негибкий.",
                        "zh": "坚硬的；难以弯曲或移动的；不柔软的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёсткий",
                                "target_lang_sense_clarification": "о материале или предмете"
                            },
                            {
                                "target_lang_word": "твёрдый",
                                "target_lang_sense_clarification": "плотный, не мягкий"
                            },
                            {
                                "target_lang_word": "негибкий",
                                "target_lang_sense_clarification": "плохо гнущийся"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "硬",
                                "target_lang_sense_clarification": "指物体、材料等坚硬不易弯曲"
                            },
                            {
                                "target_lang_word": "僵硬的",
                                "target_lang_sense_clarification": "指不柔软、缺乏弹性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6986c17b-fc86-3178-8314-8d0edf438353",
                    "sense_definition": "Painful or difficult to move due to tension, injury, or excessive exercise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I woke up with a <w>stiff</w> neck because I slept in a bad position.",
                            "target_lang_translations": {
                                "ru": "Я проснулся с <w>затёкшей</w> шеей, потому что спал в неудобной позе.",
                                "zh": "我醒来时脖子很<w>僵硬</w>，因为睡姿不好。"
                            }
                        },
                        {
                            "text": "His legs felt <w>stiff</w> the day after running the marathon.",
                            "target_lang_translations": {
                                "ru": "На следующий день после марафона его ноги казались <w>негнущимися</w>.",
                                "zh": "跑完马拉松的第二天，他觉得双腿很<w>僵硬</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tight",
                        "sore",
                        "aching",
                        "rigid"
                    ],
                    "antonyms": [
                        "flexible",
                        "loose"
                    ],
                    "common_phrases": [
                        "stiff neck",
                        "stiff muscles",
                        "stiff back",
                        "stiff legs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Болезненный или затруднённый в движении из-за напряжения, травмы или чрезмерной нагрузки.",
                        "zh": "因紧张、受伤或过度运动而疼痛或活动困难的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затёкший",
                                "target_lang_sense_clarification": "онемевший от неподвижности"
                            },
                            {
                                "target_lang_word": "скованный",
                                "target_lang_sense_clarification": "ограниченный в движении"
                            },
                            {
                                "target_lang_word": "одеревенелый",
                                "target_lang_sense_clarification": "потерявший чувствительность и гибкость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "僵硬",
                                "target_lang_sense_clarification": "因紧张、劳损等而难活动"
                            },
                            {
                                "target_lang_word": "发僵",
                                "target_lang_sense_clarification": "身体部位发紧、不灵活"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1495541e-b311-356e-b650-e6326bbc327d",
                    "sense_definition": "Having a dense consistency; thick and not flowing easily.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_rigidity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dough should be <w>stiff</w> enough to roll out without sticking.",
                            "target_lang_translations": {
                                "ru": "Тесто должно быть достаточно <w>крутым</w>, чтобы его можно было раскатать, и оно не прилипало.",
                                "zh": "面团要够<w>硬</w>，这样擀开时才不会粘。"
                            }
                        },
                        {
                            "text": "You must beat the egg whites until they form <w>stiff</w> peaks.",
                            "target_lang_translations": {
                                "ru": "Вы должны взбивать яичные белки до образования <w>устойчивых</w> пиков.",
                                "zh": "你必须把蛋白打到能形成<w>硬性</w>发泡的程度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thick",
                        "firm",
                        "viscous"
                    ],
                    "antonyms": [
                        "soft"
                    ],
                    "common_phrases": [
                        "stiff dough",
                        "stiff mixture",
                        "beat until stiff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий плотную консистенцию; густой и не текучий.",
                        "zh": "质地稠厚的；不易流动的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "о тесте: плотный"
                            },
                            {
                                "target_lang_word": "густой",
                                "target_lang_sense_clarification": "о консистенции смеси"
                            },
                            {
                                "target_lang_word": "устойчивый",
                                "target_lang_sense_clarification": "о взбитой пене (пиках)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "硬",
                                "target_lang_sense_clarification": "指面团等稠厚结实"
                            },
                            {
                                "target_lang_word": "硬性",
                                "target_lang_sense_clarification": "指打发后的蛋白、奶油等能立起来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d5dc33c-34a9-338a-8189-8fc538fdd398",
                    "sense_definition": "Strong, harsh, or severe in degree or effect.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge gave the criminal a <w>stiff</w> sentence for his crimes.",
                            "target_lang_translations": {
                                "ru": "Судья вынес преступнику <w>суровый</w> приговор за его преступления.",
                                "zh": "法官因其罪行判了他一个很<w>重</w>的刑。"
                            }
                        },
                        {
                            "text": "We faced <w>stiff</w> competition from the other teams in the tournament.",
                            "target_lang_translations": {
                                "ru": "Мы столкнулись с <w>жёсткой</w> конкуренцией со стороны других команд на турнире.",
                                "zh": "我们在比赛中面临其他队伍的<w>激烈</w>竞争。"
                            }
                        }
                    ],
                    "synonyms": [
                        "severe",
                        "harsh",
                        "strong",
                        "heavy"
                    ],
                    "antonyms": [
                        "soft"
                    ],
                    "common_phrases": [
                        "stiff competition",
                        "stiff penalty",
                        "stiff fine",
                        "stiff breeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный, суровый или жёсткий по степени или воздействию.",
                        "zh": "程度或影响很强的；严厉的；激烈的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "о наказании или приговоре"
                            },
                            {
                                "target_lang_word": "жёсткий",
                                "target_lang_sense_clarification": "о конкуренции или требованиях"
                            },
                            {
                                "target_lang_word": "сильный",
                                "target_lang_sense_clarification": "о ветре или сопротивлении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重",
                                "target_lang_sense_clarification": "指刑罚、处罚等严厉"
                            },
                            {
                                "target_lang_word": "激烈",
                                "target_lang_sense_clarification": "指竞争、阻力等强而难对付"
                            },
                            {
                                "target_lang_word": "强劲",
                                "target_lang_sense_clarification": "指风等强劲"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5e5270a-f0a4-39ef-ac9f-d5e317ed256f",
                    "sense_definition": "Potent; containing a large amount of alcohol.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He poured himself a <w>stiff</w> drink to calm his nerves.",
                            "target_lang_translations": {
                                "ru": "Он налил себе <w>крепкий</w> напиток, чтобы успокоить нервы.",
                                "zh": "他给自己倒了一杯很<w>烈</w>的酒来压压惊。"
                            }
                        },
                        {
                            "text": "After the bad news, she felt she needed a <w>stiff</w> whisky.",
                            "target_lang_translations": {
                                "ru": "После плохих новостей она почувствовала, что ей нужен <w>крепкий</w> виски.",
                                "zh": "听到那个坏消息后，她觉得自己需要来一杯<w>烈</w>威士忌。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strong",
                        "potent"
                    ],
                    "common_phrases": [
                        "stiff drink",
                        "stiff whisky",
                        "stiff dose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крепкий; содержащий большое количество алкоголя.",
                        "zh": "酒劲很大的；含酒精较多的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крепкий",
                                "target_lang_sense_clarification": "об алкогольных напитках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烈",
                                "target_lang_sense_clarification": "指酒精含量高"
                            },
                            {
                                "target_lang_word": "很烈",
                                "target_lang_sense_clarification": "指酒很浓很冲"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "778a820c-3daa-3881-bccc-821297682a8a",
                    "sense_definition": "Formal in behavior; not relaxed or friendly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her greeting was polite but rather <w>stiff</w> and cold.",
                            "target_lang_translations": {
                                "ru": "Её приветствие было вежливым, но довольно <w>натянутым</w> и холодным.",
                                "zh": "她的问候虽然礼貌，却相当<w>拘谨</w>而冷淡。"
                            }
                        },
                        {
                            "text": "He maintained a <w>stiff</w> manner throughout the interview.",
                            "target_lang_translations": {
                                "ru": "Он сохранял <w>чопорную</w> манеру поведения на протяжении всего интервью.",
                                "zh": "他在整个面试过程中始终保持着<w>拘谨</w>的举止。"
                            }
                        }
                    ],
                    "synonyms": [
                        "formal",
                        "unrelaxed",
                        "wooden"
                    ],
                    "common_phrases": [
                        "stiff manner",
                        "stiff upper lip",
                        "stiff smile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальный в поведении; не расслабленный и не дружелюбный.",
                        "zh": "行为举止正式拘束的；不放松、不亲切的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натянутый",
                                "target_lang_sense_clarification": "неестественный, напряжённый"
                            },
                            {
                                "target_lang_word": "чопорный",
                                "target_lang_sense_clarification": "излишне строгий и формальный"
                            },
                            {
                                "target_lang_word": "холодный",
                                "target_lang_sense_clarification": "недружелюбный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拘谨",
                                "target_lang_sense_clarification": "指举止过于正式、不自然"
                            },
                            {
                                "target_lang_word": "生硬",
                                "target_lang_sense_clarification": "指态度不放松、显得生硬"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd87a70e-83a6-3ee7-9fcf-ecc8046034ff",
                    "sense_definition": "Expensive or higher than expected in price.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entrance fee was a bit <w>stiff</w>, so we decided not to go in.",
                            "target_lang_translations": {
                                "ru": "Входная плата была немного <w>высоковатой</w>, поэтому мы решили не входить.",
                                "zh": "门票有点<w>贵</w>，所以我们决定不进去了。"
                            }
                        },
                        {
                            "text": "Paying fifty dollars for a sandwich seems pretty <w>stiff</w> to me.",
                            "target_lang_translations": {
                                "ru": "Платить пятьдесят долларов за сэндвич кажется мне довольно <w>чрезмерным</w>.",
                                "zh": "花五十美元买一个三明治，我觉得也太<w>贵</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expensive",
                        "pricey",
                        "steep"
                    ],
                    "common_phrases": [
                        "bit stiff",
                        "pretty stiff"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дорогой или выше ожидаемой цены.",
                        "zh": "价格昂贵的；比预想中更高的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокий",
                                "target_lang_sense_clarification": "о цене или плате"
                            },
                            {
                                "target_lang_word": "чрезмерный",
                                "target_lang_sense_clarification": "слишком дорогой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贵",
                                "target_lang_sense_clarification": "口语，指价格偏高"
                            },
                            {
                                "target_lang_word": "太贵",
                                "target_lang_sense_clarification": "指收费高得超出预期"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a2b3aae-a160-3b58-a51c-9f8ab149c049",
                    "sense_definition": "To fail to pay someone money that is owed, especially a tip.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "transaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't <w>stiff</w> the waiter just because the service was a little slow.",
                            "target_lang_translations": {
                                "ru": "Не стоит <w>оставлять без чаевых</w> официанта только из-за того, что обслуживание было немного медленным.",
                                "zh": "别因为服务有点慢就<w>不给</w>服务员小费。"
                            }
                        },
                        {
                            "text": "He <w>stiffed</w> the taxi driver and ran away before paying the fare.",
                            "target_lang_translations": {
                                "ru": "Он <w>кинул</w> таксиста и убежал, не заплатив за проезд.",
                                "zh": "他<w>赖掉</w>了出租车司机的车费，没付钱就跑了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cheat"
                    ],
                    "common_phrases": [
                        "stiff the waiter",
                        "stiff someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не заплатить кому-либо причитающиеся деньги, особенно чаевые.",
                        "zh": "不给某人应得的钱，尤指不给小费。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кинуть",
                                "target_lang_sense_clarification": "сленг: обмануть с оплатой"
                            },
                            {
                                "target_lang_word": "обделить",
                                "target_lang_sense_clarification": "не дать должного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不给",
                                "target_lang_sense_clarification": "尤其指不给应付的小费"
                            },
                            {
                                "target_lang_word": "赖掉",
                                "target_lang_sense_clarification": "口语，指赖掉应付的钱"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7826e172-3d91-3671-83e1-6aac96512022",
                    "sense_definition": "A dead body.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "body_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective looked down at the <w>stiff</w> lying in the alley.",
                            "target_lang_translations": {
                                "ru": "Детектив посмотрел вниз на <w>жмурика</w>, лежащего в переулке.",
                                "zh": "侦探低头看着躺在小巷里的<w>尸体</w>。"
                            }
                        },
                        {
                            "text": "They carried the <w>stiff</w> out of the building on a stretcher.",
                            "target_lang_translations": {
                                "ru": "Они вынесли <w>труп</w> из здания на носилках.",
                                "zh": "他们用担架把那具<w>尸体</w>抬出了大楼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "corpse",
                        "cadaver",
                        "body"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мёртвое тело.",
                        "zh": "尸体；死人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жмурик",
                                "target_lang_sense_clarification": "сленг: покойник"
                            },
                            {
                                "target_lang_word": "труп",
                                "target_lang_sense_clarification": "мёртвое тело"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尸体",
                                "target_lang_sense_clarification": "较中性，指死人的身体"
                            },
                            {
                                "target_lang_word": "死尸",
                                "target_lang_sense_clarification": "较口语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "983a2030-5b03-3dc2-b131-7360c3eda9c9",
                    "sense_definition": "An ordinary person, often one who works hard; sometimes used to describe a lucky or unlucky person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is just a regular working <w>stiff</w> trying to pay his bills.",
