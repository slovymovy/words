                "senses": [
                    {
                        "sense_id": "51396769-436d-331b-aaf4-3c6ce0de2d9d",
                        "entry_id": "e706edc0-3c0e-3985-9138-f1155046d288",
                        "glosses": [
                            "A male given name from the Germanic languages."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3e397462-2247-4f18-a915-e0bd3d46328d",
                                "sense_id": "51396769-436d-331b-aaf4-3c6ce0de2d9d",
                                "text": "An uncle of mine whose name was Cecil Jeffery Courtenay obtained a post of great emolument simply by virtue of his 'pretty' name. Mine, I think, is quite as effective, though it depends upon but one Christian name, Raymond. I am Raymond Courtenay."
                            },
                            {
                                "example_id": "d75cd576-c26c-4b9a-8161-92e9d98514fe",
                                "sense_id": "51396769-436d-331b-aaf4-3c6ce0de2d9d",
                                "text": "What splendid names for boys there are! / There's Carol like a rolling car, / And Martin like a flying bird, / And Adam like the Lord's First Word, / And Raymond like the Harvest Moon,"
                            },
                            {
                                "example_id": "96b10794-aea0-4766-a94d-c4a9f0f29ea8",
                                "sense_id": "51396769-436d-331b-aaf4-3c6ce0de2d9d",
                                "text": "I thought the name Raymond sounded respectable. Good name for a lawyer."
                            },
                            {
                                "example_id": "eca3cd38-5833-40f0-8041-c0280f6ddaa8",
                                "sense_id": "51396769-436d-331b-aaf4-3c6ce0de2d9d",
                                "text": "A spokesperson for the families of Drs. Mortimer and Raymond Sackler, the late founders of the company, issued this statement:"
                            }
                        ]
