                        "entry_id": "300999a4-38cb-3d7c-b8f0-34a67a08ac69",
                        "glosses": [
                            "Teilgebiet der Zoologie, das sich mit der Erforschung der Schmetterlinge beschäftigt"
                        ],
                        "tags": [
                            "Wissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "1c70dbeb-39ed-4918-b8af-f753866ca4f7",
                                "sense_id": "a3912c89-8231-3268-bb43-6fcb1feea212",
                                "text": "„Bald wurde er denn für diejenigen unter ihnen, die für diesen Zweig der Schmetterlingskunde Interesse zeigten, eine unbestrittene Autorität.“"
                            },
                            {
                                "example_id": "09590710-6d48-4c97-ac7b-8277b5e58533",
                                "sense_id": "a3912c89-8231-3268-bb43-6fcb1feea212",
                                "text": "„Neben seinen amtlichen Beschäftigungen war es das Studium der Naturwissenschaften, welches ihn anzog, und namentlich die Entomologie, speciell die Schmetterlingskunde.“"
                            }
                        ],
