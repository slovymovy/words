                "senses": [
                    {
                        "sense_id": "fd292948-7f7e-3d0d-9c16-db1a83762197",
                        "entry_id": "24551963-657f-3963-9da6-228f2ec64360",
                        "glosses": [
                            "The state or quality of being tardy."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1b1d8167-8e93-4018-b6e5-10662f4fc18e",
                                "sense_id": "fd292948-7f7e-3d0d-9c16-db1a83762197",
                                "text": "Some ten years ago, an evening excursion train from the Walsall area to Manchester, when travelling well over the heavily-graded Walsall-Rugeley line, was brought to a stand at a level crossing at Hednesford by the tardiness of a gatekeeper, who was pottering about in his garden instead of attending to his duties."
                            }
                        ]
                    },
                    {
                        "sense_id": "54e5994a-1e63-31cd-b2ad-3c56e6e34c15",
                        "entry_id": "24551963-657f-3963-9da6-228f2ec64360",
                        "glosses": [
                            "The result or product of being tardy."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6cf6512-5eb3-4c7f-bbc1-234667816ef3",
                        "source_entry_id": "24551963-657f-3963-9da6-228f2ec64360",
                        "source_sense_description": "the state of being late",
                        "target_lang_word": "Unpünktlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unpünktlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7f3d862-49b6-3117-8338-914025718ed9",
                                        "entry_id": "0f725262-ddea-3d66-94ef-7825a1e4b0ec",
                                        "glosses": [
                                            "Nichteinhaltung eines festgesetzten Termins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aec8116-31c7-40f9-ba9f-96eb352673c0",
                                                "sense_id": "c7f3d862-49b6-3117-8338-914025718ed9",
                                                "text": "Wegen seiner Unpünktlichkeit verpasste er sein Vorstellungsgespräch."
                                            },
                                            {
                                                "example_id": "af69494f-9135-46a4-bb0d-8801965af3ac",
                                                "sense_id": "c7f3d862-49b6-3117-8338-914025718ed9",
                                                "text": "„Ebenso sehr wie die Pünktlichkeit ist es eine Tugend, von der Unpünktlichkeit seiner Mitmenschen kein Aufhebens zu machen.“"
                                            },
                                            {
                                                "example_id": "44ce8a05-04d0-46ad-a717-ba526b4de469",
                                                "sense_id": "c7f3d862-49b6-3117-8338-914025718ed9",
                                                "text": "„Unpünktlichkeit der Gäste erregte seinen Unwillen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7203c0b6-ee33-400b-8516-f1e14a471b35",
                        "source_entry_id": "24551963-657f-3963-9da6-228f2ec64360",
                        "source_sense_description": "the state of being late",
                        "target_lang_word": "Verspätung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verspätung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07ba4caa-d392-3b5b-a638-1297f313f357",
                                        "entry_id": "74b06372-517c-3dab-816c-b6e0a76bd26b",
                                        "glosses": [
                                            "die Tatsache, dass ein Ereignis später als geplant eintritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ab14fc1-14d1-418a-b0d2-6460fe0c1e82",
                                                "sense_id": "07ba4caa-d392-3b5b-a638-1297f313f357",
                                                "text": "Der Flieger nach Berlin hat schon wieder Verspätung."
                                            },
                                            {
                                                "example_id": "57607296-ad4c-4e68-92fc-8345e0dca89e",
                                                "sense_id": "07ba4caa-d392-3b5b-a638-1297f313f357",
                                                "text": "„Aufgrund der Verspätung würde der Flieger erst mitten in der Nacht abheben, und sie stellte ihren Koffer in ein Gepäckfach und ging auf die Besucherterrasse.“"
                                            },
                                            {
                                                "example_id": "43316fc1-1913-4629-aa9d-7d0d84e25782",
                                                "sense_id": "07ba4caa-d392-3b5b-a638-1297f313f357",
                                                "text": "„Der ICE nach Basel hat auch Verspätung.“"
                                            },
                                            {
                                                "example_id": "d16c258b-8dc2-4494-a2db-c44faf39cf52",
                                                "sense_id": "07ba4caa-d392-3b5b-a638-1297f313f357",
                                                "text": "[Eisenbahnunglück von Amagasaki, 2005:] „Damals hatte der 23-jährige Lokführer eine Verspätung von ein bis zwei Minuten. Er wollte die wieder aufholen, fuhr zu schnell in die Kurve, der Zug entgleiste, mehr als 100 Menschen starben, mehr als 500 wurden verletzt.“"
                                            },
                                            {
                                                "example_id": "99a42e8e-39e8-4649-bc3a-d0cfb4eac99a",
                                                "sense_id": "07ba4caa-d392-3b5b-a638-1297f313f357",
                                                "text": "„Im Rauchsalon sangen sie noch immer, als das Schiff mit ganz geringer Verspätung im Hafen von Dover einlief.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4f9c9482-6e9b-30b5-bfcf-a135be92776c",
                                        "entry_id": "74b06372-517c-3dab-816c-b6e0a76bd26b",
                                        "glosses": [
                                            "die Länge des Zeitintervalls, um das ein Ereignis später als geplant eintritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c1e1f4c-6330-44db-8084-dc11eccaabc1",
                                                "sense_id": "4f9c9482-6e9b-30b5-bfcf-a135be92776c",
                                                "text": "Wieviel Verspätung hattet ihr denn? — Mindestens zwanzig Minuten!"
                                            },
                                            {
                                                "example_id": "6e437d31-6bfa-4edf-a603-8cd84ff2437f",
                                                "sense_id": "4f9c9482-6e9b-30b5-bfcf-a135be92776c",
                                                "text": "„Die Partie hatte bereits mit zwölfminütiger Verspätung begonnen, da die Fanlager beider Vereine ihren pyromanischen Neigungen nachgehen mussten.“"
                                            },
                                            {
                                                "example_id": "9e92d6f9-d022-4e83-86b7-e91adf48700d",
                                                "sense_id": "4f9c9482-6e9b-30b5-bfcf-a135be92776c",
                                                "text": "„Das Bier wurde mit fünfzehnminütiger Verspätung serviert.“"
                                            },
                                            {
                                                "example_id": "8f828cb2-9158-4b42-8a32-a5113abaf174",
                                                "sense_id": "4f9c9482-6e9b-30b5-bfcf-a135be92776c",
                                                "text": "„Auch der Zeppelin erschien in Mainz, wenn auch mit etwas Verspätung, auf dem ersten Flug, der ihn vom Bodensee bis fast zur Nordsee hätte führen sollen.“"
                                            },
                                            {
                                                "example_id": "dfb40720-9047-4400-9dba-8e84d8a8d8d9",
                                                "sense_id": "4f9c9482-6e9b-30b5-bfcf-a135be92776c",
                                                "text": "„Wenige Wochen später kam ich mit einem Nachtzug aus München mit zwei Stunden Verspätung in Frankfurt an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
