                "senses": [
                    {
                        "sense_id": "22b73160-6aac-3b41-a6d2-cb0295f9e9bc",
                        "entry_id": "6898f1ec-d1ee-3f7b-865d-b3c172484321",
                        "glosses": [
                            "Limonade, die aus ökologischer Landwirtschaft und umweltfreundlicher Herstellung stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dce0926f-bdd3-4ba1-b108-0e78a97db1fc",
                                "sense_id": "22b73160-6aac-3b41-a6d2-cb0295f9e9bc",
                                "text": "„Die in kleine Flaschen abgefüllte Bio-Limonade galt lange als Kultgetränk in städtischen Clubs und Cafés, verlor zuletzt aber deutlich an Marktanteilen, wegen Nachahmerprodukten und einer offensichtlich verfehlten Vermarktungsstrategie des bisherigen Besitzers.“"
                            },
                            {
                                "example_id": "f6004b16-4631-47c6-8c0f-f1f09ea668a8",
                                "sense_id": "22b73160-6aac-3b41-a6d2-cb0295f9e9bc",
                                "text": "„Wie zu Beginn in Deutschland soll die gegorene Bio-Limonade zunächst in trendigen Clubs und Bars europäischer Metropolen angeboten werden.“"
                            },
                            {
                                "example_id": "699edd70-3ade-4d32-b0c2-5ea0a5f8040b",
                                "sense_id": "22b73160-6aac-3b41-a6d2-cb0295f9e9bc",
                                "text": "„Wer gestern Abend mit leisem Stolz auf die Tarte au Chocolat zum Dessert verzichtet und sich mit einem asketischen Rohkostteller begnügte, wer statt der Cola eine Bio-Limonade getrunken hat, der muss nun stark sein: Auch diese vermeintlich so gesunden Alternativen können Ihrem Körper schaden.“"
                            },
                            {
                                "example_id": "0cc07fd7-681f-495c-ae4a-796aea7c7060",
                                "sense_id": "22b73160-6aac-3b41-a6d2-cb0295f9e9bc",
                                "text": "„Im Streit um die Etikettengestaltung ihres neuen Erfrischungsgetränkes will sich die Duisburger Getränkegruppe Rheinfelsquellen-Hövelmann rasch mit dem Hersteller des erfolgreichen Softdrinks Bionade einigen, um von dem derzeitigen Nachfrageboom nach Bio-Limonaden profitieren zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
