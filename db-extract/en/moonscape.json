    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b8f35520-e6c9-3630-bf28-b3fb58d02bc3",
                "word": "moonscape",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5dda0458-138b-4f2e-8ad8-93d15b0e14b8",
                        "entry_id": "b8f35520-e6c9-3630-bf28-b3fb58d02bc3",
                        "tags": [
                            "plural"
                        ],
                        "form": "moonscapes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37db1ff1-c982-3b97-8dc3-ad07a7cae351",
                        "entry_id": "b8f35520-e6c9-3630-bf28-b3fb58d02bc3",
                        "glosses": [
                            "A view of an area of the Moon."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b48942f5-fa90-322f-99e1-cb6ad4fb740e",
                        "entry_id": "b8f35520-e6c9-3630-bf28-b3fb58d02bc3",
                        "glosses": [
                            "A desolate or devastated landscape."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2a347472-90de-4a60-8fc5-e447d4dad932",
                                "sense_id": "b48942f5-fa90-322f-99e1-cb6ad4fb740e",
                                "text": "In the Australian outback, industrial activity — notably open-pit coal mining — has turned verdant areas into moonscapes seemingly overnight, and the suicide rate in the region has skyrocketed."
                            },
                            {
                                "example_id": "f9b195e7-e546-4575-84ac-d7185d2d0ca7",
                                "sense_id": "b48942f5-fa90-322f-99e1-cb6ad4fb740e",
                                "text": "Looking across the recently flattened, desolate moonscape of this former 52-acre Great Western depot and industrial area, south of Willesden Junction in west London, it's hard to imagine it will be home to the UK's largest, busiest and best-connected new railway station since Victorian times."
                            },
                            {
                                "example_id": "0e1185dd-2c13-487c-8d95-d638370891e8",
                                "sense_id": "b48942f5-fa90-322f-99e1-cb6ad4fb740e",
                                "text": "They made their way to a geological formation called Kap Kobenhavn, a series of bare hills as desolate as a moonscape."
                            },
                            {
                                "example_id": "5ca7c929-3403-45cc-b84f-672700b0540f",
                                "sense_id": "b48942f5-fa90-322f-99e1-cb6ad4fb740e",
                                "text": "They had never managed to host many events on their property, in part because some of the surrounding area remained a moonscape. The cork oak where Phillip wanted his ashes spread had burned down in the last fire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "198baca7-7591-41f5-8735-baaee2fdd2d6",
                        "source_entry_id": "b8f35520-e6c9-3630-bf28-b3fb58d02bc3",
                        "source_sense_description": "view of an area of the Moon",
                        "target_lang_word": "Mondlandschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mondlandschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6af7935e-1a93-3334-966d-86390e029583",
                                        "entry_id": "2e01bd03-66df-3b73-bcdc-f89643f1f411",
                                        "glosses": [
                                            "Landschaft auf dem Mond"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ac9d314-aea3-4807-b12e-6449d002cb41",
                                                "sense_id": "6af7935e-1a93-3334-966d-86390e029583",
                                                "text": "Mondlandschaften kennt man infolge der Weltraumforschung durch eine Vielzahl von Fotos."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c815f42b-9f32-3e43-b7e1-3ac2472d5fc2",
                                        "entry_id": "2e01bd03-66df-3b73-bcdc-f89643f1f411",
                                        "glosses": [
                                            "Landschaft, die nur aus Staub und Fels besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de17ef0e-86bb-49f8-b5c6-253fcc31f4fe",
                                                "sense_id": "c815f42b-9f32-3e43-b7e1-3ac2472d5fc2",
                                                "text": "„Dann sägt das Wasser in nur wenigen Tagen tonnenschwere Brocken aus dem Kalkstein, schleift die Überhänge ab und schmirgelt sie glatt. Zurück bleibt eine neue Mondlandschaft.“"
                                            },
                                            {
                                                "example_id": "9f5d1b01-7e85-4e3c-9362-9de8217b81b9",
                                                "sense_id": "c815f42b-9f32-3e43-b7e1-3ac2472d5fc2",
                                                "text": "„Helgoland war da nicht mehr als eine Mondlandschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "25a7ed67-dc1a-3ec3-b238-8cd84e2df57a",
                                        "entry_id": "2e01bd03-66df-3b73-bcdc-f89643f1f411",
                                        "glosses": [
                                            "Landschaft im Mondlicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63ce8c04-faa7-4651-8cdd-58a008df4112",
                                                "sense_id": "25a7ed67-dc1a-3ec3-b238-8cd84e2df57a",
                                                "text": "Bei Vollmond kann man nachts schöne Mondlandschaften erleben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
