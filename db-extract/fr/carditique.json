                        "examples": [
                            {
                                "example_id": "4c5b427a-668c-48f2-b86c-91c4062a835c",
                                "sense_id": "178dbaf0-9fdb-3e51-9de9-98674e2d3986",
                                "text": "M. Coutanceau a décrit sous le nom de fièvre carditique une variété de l’intermittente pernicieuse observée par lui-même, dans laquelle le malade éprouvait des palpitations violentes et une sorte d'érosion qui déterminait la syncope."
                            },
                            {
                                "example_id": "7ad89050-2696-4be9-a79e-adf1dc3beea8",
                                "sense_id": "178dbaf0-9fdb-3e51-9de9-98674e2d3986",
                                "text": "Au nombre des pernicieuses, nous n’avons pas rangé les formes pneumonique, dysentérique, carditique, pleurétique, etc., admises par un certain nombre d’auteurs."
                            }
                        ]
                    }
