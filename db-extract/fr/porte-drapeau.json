                                        "entry_id": "7b9888bb-7857-35e9-9f80-352289c7d6be",
                                        "glosses": [
                                            "One who carries a flag, especially at a ceremony."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62296f63-8710-4f07-8672-10b7e76188fb",
                                                "sense_id": "eb698853-fef0-33d6-8741-cc1b24aed5ee",
                                                "text": "Abramenko, a top aerialist in freestyle skiing, a five-time Olympian and the country’s flag-bearer for the opening ceremony, garnered more attention after the event, when a photograph of his hug with a Russian rival was widely circulated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ad2293b-fc4d-3da0-8e06-419ee9dad2ab",
                                        "entry_id": "7b9888bb-7857-35e9-9f80-352289c7d6be",
                                        "glosses": [
                                            "One who openly promotes an idea or value and becomes symbolic for it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b53c9e7-1a5d-456c-b2d9-286ca7761cfb",
                                                "sense_id": "9ad2293b-fc4d-3da0-8e06-419ee9dad2ab",
                                                "text": "The Guardian’s editor, Alan Rusbridger, has been a flag-bearer for “open journalism”, which invites input from readers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
