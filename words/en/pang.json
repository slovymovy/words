                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surnames",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local gallery is currently hosting an exhibition featuring the latest works by Mr. <w>Pang</w>.",
                            "target_lang_translations": {
                                "ru": "В местной галерее сейчас проходит выставка последних работ господина <w>Панга</w>.",
                                "cs": "V místní galerii právě probíhá výstava nejnovějších děl pana <w>Panga</w>."
                            }
                        },
                        {
                            "text": "Many families with the surname <w>Pang</w> can trace their ancestry back to southern China.",
                            "target_lang_translations": {
                                "ru": "Многие семьи с фамилией <w>Панг</w> могут проследить свою родословную до южного Китая.",
                                "cs": "Mnoho rodin s příjmením <w>Pang</w> může vystopovat své předky až do jižní Číny."
                            }
                        }
                    ],
                    "traits": [
