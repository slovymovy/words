                        "examples": [
                            {
                                "example_id": "2aea6b9f-0c74-44de-9502-8475d7d635da",
                                "sense_id": "58863839-df6f-3999-9a10-c0846859e64e",
                                "text": "In De Kaperkapitein van Gustave Aimard (= Olivier Gloux, 1818-1883) laat de auteur zijn hoofdpersoon opmerken: 'Toen ik Dolores voor de eerste maal zag, was zij nauwelijks tien jaar oud, een blond kind, vrolijk en onbezorgd; ik voelde mij onweerstaanbaar tot haar aangetrokken."
                            },
                            {
                                "example_id": "ec31cec5-83e7-4e84-8336-af8af01216f8",
                                "sense_id": "58863839-df6f-3999-9a10-c0846859e64e",
                                "text": "Jaume de Vilagarut was een typische vertegenwoordiger van het ras van kaperkapiteins die in die tijd bij alle mogelijke krijgsverrichtingen betrokken waren."
                            }
                        ]
                    }
