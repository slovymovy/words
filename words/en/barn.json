                {
                    "sense_id": "7c83cfdc-3115-3ae4-9f59-7b25ffc2ea15",
                    "sense_definition": "A unit of surface area equal to 10⁻²⁸ square metres, used in nuclear physics.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cross-section of the nucleus is measured in <w>barns</w>.",
                            "target_lang_translations": {
                                "ru": "Поперечное сечение ядра измеряется в <w>барнах</w>.",
                                "zh": "原子核的截面是用<w>靶恩</w>来测量的。",
                                "cs": "Průřez jádra se měří v <w>barnech</w>."
                            }
                        },
                        {
                            "text": "Physicists use the <w>barn</w> to calculate reaction probabilities.",
