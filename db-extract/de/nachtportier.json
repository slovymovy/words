                    }
                ],
                "senses": [
                    {
                        "sense_id": "1dee86a7-ce2c-362b-87fa-a86c8ec9a4df",
                        "entry_id": "3426e88b-0456-35c5-93fa-f4c9b21283c4",
                        "glosses": [
                            "(männliche^☆) Person, die während der Nachtstunden (beispielsweise an einer Rezeption in einem Hotel) Gäste in Empfang nimmt (= als Portier tätig ist)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd6a7b50-addf-4421-953d-0e6872fe1fd0",
                                "sense_id": "1dee86a7-ce2c-362b-87fa-a86c8ec9a4df",
                                "text": "„Und das Wetter in Nordvietnam war wieder gut genug für Bombenangriffe, und das Pentagon läßt durchblicken, daß die ja ihre eigenen Maschinen in China verstecken, und gestern morgen überfielen drei Männer das Schuyler Arms Hotel in der 98. Straße, schossen den Nachtportier an und entkamen mit 68 Dollar.“"
                            },
                            {
                                "example_id": "27f860de-a380-4951-a1fe-38166dcb6b7c",
                                "sense_id": "1dee86a7-ce2c-362b-87fa-a86c8ec9a4df",
                                "text": "„Unter den Leuten, die seinen Tod beschlossen hatten, war auch einer der beiden Nachtportiers.“"
                            },
                            {
                                "example_id": "67096595-7b20-48fc-be7d-8a3e651800f6",
                                "sense_id": "1dee86a7-ce2c-362b-87fa-a86c8ec9a4df",
                                "text": "„Aber der Nachtportier, ein verständnisvoller älterer Pole, nahm die Stühle von einem Tisch und brachte zwei Flaschen Bier.“"
                            },
                            {
                                "example_id": "7ff82c3b-b3cd-4b56-acd1-2400b6e23634",
                                "sense_id": "1dee86a7-ce2c-362b-87fa-a86c8ec9a4df",
                                "text": "„Nach Dienstschluss übergeben sie die Portierloge entweder den Nachtportieren oder sorgen für die ordentliche Versperrung der Gebäude.“"
                            },
                            {
                                "example_id": "03eaa55c-cd6a-4c41-a46d-225cdb458404",
                                "sense_id": "1dee86a7-ce2c-362b-87fa-a86c8ec9a4df",
                                "text": "„Der Schmierlappen von Nachtportier gab uns ein Zimmer, das ich nüchtern sofort wieder verlassen hätte.“"
                            },
                            {
                                "example_id": "11a55f08-9bbd-4e63-bc4c-604c49ba44ec",
                                "sense_id": "1dee86a7-ce2c-362b-87fa-a86c8ec9a4df",
                                "text": "„Der Nachtportier, ein Algerier namens Abderrahmane Ouatiki, 39, öffnet ihnen, obwohl sie Gesichtsmasken tragen.“"
                            },
                            {
                                "example_id": "b9a34d86-26d0-451a-820b-eb178df2c92c",
                                "sense_id": "1dee86a7-ce2c-362b-87fa-a86c8ec9a4df",
                                "text": "„Hinter der Theke saß der Nachtportier, ein alter Schwarzer mit einem grauen Spitzbart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
