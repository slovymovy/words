{
    "word_family": [
        "scarf"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fab6a7fe-0d97-3f77-b5ff-854d6b0815d7",
                    "sense_definition": "To cover someone or oneself with a <w>scarf</w> or a similar piece of fabric.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cover with fabric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>scarved</w> her head like a gypsy in a tie-dyed rag with a long fringe.",
                            "target_lang_translations": {
                                "ru": "Она <w>повязала</w> голову, как цыганка, пестрым лоскутом с длинной бахромой."
                            }
                        },
                        {
                            "text": "Before going out into the snow, she <w>scarved</w> her shoulders to stay warm.",
                            "target_lang_translations": {
                                "ru": "Перед тем как выйти на снег, она <w>закутала</w> плечи, чтобы не замерзнуть."
                            }
                        }
                    ],
                    "synonyms": [
                        "wrap",
                        "drape"
                    ],
                    "common_phrases": [
                        "scarved her shoulders",
                        "scarved her head"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling of scarf"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать кого-либо или себя шарфом или подобным куском ткани."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повязывать шарф",
                                "target_lang_sense_clarification": "на голову или шею"
                            },
                            {
                                "target_lang_word": "закутывать",
                                "target_lang_sense_clarification": "в шарф или платок"
                            },
                            {
                                "target_lang_word": "накидывать",
                                "target_lang_sense_clarification": "шаль или платок на плечи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e90276f-a2cd-3d8e-96af-7812d3126ba4",
                    "sense_definition": "To wrap around or cover something in a way that resembles a <w>scarf</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cover with fabric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A thick layer of opal clouds <w>scarved</w> the sky as the sun began to set.",
                            "target_lang_translations": {
                                "ru": "Плотный слой опаловых облаков <w>окутал</w> небо, когда солнце начало садиться."
                            }
                        },
                        {
                            "text": "The morning mist <w>scarved</w> the hills, hiding the small village from view.",
                            "target_lang_translations": {
                                "ru": "Утренний туман <w>опоясал</w> холмы, скрывая из виду маленькую деревушку."
                            }
                        }
                    ],
                    "synonyms": [
                        "envelop",
                        "shroud",
                        "wreathe"
                    ],
                    "common_phrases": [
                        "scarved the sky",
                        "scarved the hills"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling of scarf"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Окутывать или покрывать что-либо подобно шарфу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окутывать",
                                "target_lang_sense_clarification": "о тумане или облаках"
                            },
                            {
                                "target_lang_word": "опоясывать",
                                "target_lang_sense_clarification": "длинной полосой чего-либо"
                            },
                            {
                                "target_lang_word": "застилать",
                                "target_lang_sense_clarification": "покрывать слоем"
                            }
                        ]
                    }
                }
            ]
        }
    ]
