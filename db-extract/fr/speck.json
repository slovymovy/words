                                                "sense_id": "c2116c3c-bb50-3fa4-8965-c2ecd9395201",
                                                "text": "Die Specks fahren heute nach Chemnitz."
                                            },
                                            {
                                                "example_id": "b657115a-959d-4daa-a1bc-6a0aa8f1a949",
                                                "sense_id": "c2116c3c-bb50-3fa4-8965-c2ecd9395201",
                                                "text": "Der Speck trägt nie die Pullover, die die Speck ihm strickt."
                                            },
                                            {
                                                "example_id": "442c6d17-41f9-479a-9c6f-c783b4da251b",
                                                "sense_id": "c2116c3c-bb50-3fa4-8965-c2ecd9395201",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Speck kommt, geht der Herr Speck.“"
                                            },
                                            {
                                                "example_id": "bb5898fc-976c-48a8-bb8a-fed40b2585ba",
                                                "sense_id": "c2116c3c-bb50-3fa4-8965-c2ecd9395201",
                                                "text": "Speck kommt und geht."
                                            },
                                            {
                                                "example_id": "2920b9ff-2396-454f-a223-cc90e61e8817",
                                                "sense_id": "c2116c3c-bb50-3fa4-8965-c2ecd9395201",
                                                "text": "Specks kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
