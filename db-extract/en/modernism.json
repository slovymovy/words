                    },
                    {
                        "sense_id": "1f566cdb-7cca-3f4b-9ad0-10ca9986a15a",
                        "entry_id": "df5f5c8c-a298-3bef-b686-67c34951f916",
                        "glosses": [
                            "Any of several styles of art, architecture, literature, philosophy, etc., that flourished in the 20th century."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dcdd3e67-53b8-493a-82f7-c4c19d0fe4d5",
                                "sense_id": "1f566cdb-7cca-3f4b-9ad0-10ca9986a15a",
                                "text": "Penrod is so referential as to be almost a work of postmodernism—assuming Tarkington could have imagined such a thing with modernism itself just beginning to steamroll over him."
                            }
                        ]
                    },
                    {
                        "sense_id": "53a21ccb-1644-3932-9821-e67c75b1275d",
                        "entry_id": "df5f5c8c-a298-3bef-b686-67c34951f916",
                        "glosses": [
                            "A religious movement in the early 20th century, condemned as heretical by Pope Pius X, which tried to reconcile Roman Catholic dogma with modern science and philosophy."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "631f4f3c-e38d-46d5-b7da-6ba9212ff806",
                        "source_entry_id": "df5f5c8c-a298-3bef-b686-67c34951f916",
                        "source_sense_description": "any of several styles of art, architecture, literature, philosophy, etc., that flourished in the 20th century",
                        "target_lang_word": "modernisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modernisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2594ff86-cb77-3099-925c-7c29a7ddb92f",
                                        "entry_id": "f446cb25-d6c9-3f99-ba22-a212cd083788",
                                        "glosses": [
                                            "vernieuwende stroming binnen allerlei deelgebieden van de kunst die aan het begin van de 20e eeuw opkwam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1a2d731-f2db-4744-b2f6-b848cd66675c",
                                                "sense_id": "2594ff86-cb77-3099-925c-7c29a7ddb92f",
                                                "text": "Het modernisme kwam begin deze eeuw opzetten. Na de Eerste Wereldoorlog was er weer geloof in de toekomst en in technologische vooruitgang."
                                            },
                                            {
                                                "example_id": "c38280e8-d8c5-46fc-b58d-165b7d15e8ec",
                                                "sense_id": "2594ff86-cb77-3099-925c-7c29a7ddb92f",
                                                "text": "Dus rechts had heel goed door dat het modernisme een tegenstander van het conservatisme was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "befe877e-77da-4c40-a05f-1af7dd5551cc",
                        "source_entry_id": "df5f5c8c-a298-3bef-b686-67c34951f916",
                        "source_sense_description": "any of several styles of art, architecture, literature, philosophy, etc., that flourished in the 20th century",
                        "target_lang_word": "modernisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modernisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a7806f9-5bef-3f0a-a463-646ed5613a68",
                                        "entry_id": "5cbd6005-51e2-3638-968b-ccfa5fbfd2bb",
                                        "glosses": [
                                            "Tendance à se détacher de la tradition pour adopter des idées modernes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e3c4f01-e505-4056-9366-0dec82fd7ce4",
                                                "sense_id": "5a7806f9-5bef-3f0a-a463-646ed5613a68",
                                                "text": "Toutes ces vieilles coutumes ajoutent une note pittoresque à la vie de Santa-Cruz; mais elles finiront probablement bientôt par disparaître, emportées par le modernisme niveleur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3938c3f1-cbc7-39a3-816c-3e540916356a",
                                        "entry_id": "5cbd6005-51e2-3638-968b-ccfa5fbfd2bb",
                                        "glosses": [
                                            "Gout de ce qui est moderne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "702579b0-11d8-4fba-b788-d24e73b95ff3",
                                                "sense_id": "3938c3f1-cbc7-39a3-816c-3e540916356a",
                                                "text": "Tu ne vas pas faire une secte mormone ou amishe ? Bannir voiture, téléphone, le modernisme, quoi. Compte pas sur moi pour venir en chariot."
                                            },
                                            {
                                                "example_id": "85db3772-ca03-4ef5-bd93-34de863a5754",
                                                "sense_id": "3938c3f1-cbc7-39a3-816c-3e540916356a",
                                                "text": "Modernisme artistique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "671d751f-6b70-3281-bcaf-8a39709d6ba9",
                                        "entry_id": "5cbd6005-51e2-3638-968b-ccfa5fbfd2bb",
                                        "glosses": [
                                            "Mouvement chrétien préconisant une nouvelle interprétation des croyances et des doctrines traditionnelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "611f1d1d-267c-42d2-b1b5-faebc62d2a5a",
                                                "sense_id": "671d751f-6b70-3281-bcaf-8a39709d6ba9",
                                                "text": "— Bien entendu, Simon, il faudra vous mettre au courant de l’erreur que vous devrez combattre, du modernisme. Connaissez-vous, si peu que ce soit, Newman, Maurice Blondel, Le Roy, Loisy, Laberthonnière…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16ebfba7-12d4-476a-83dd-10e4c02de228",
                        "source_entry_id": "df5f5c8c-a298-3bef-b686-67c34951f916",
                        "source_sense_description": "any of several styles of art, architecture, literature, philosophy, etc., that flourished in the 20th century",
                        "target_lang_word": "Modernismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Modernismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "beafb763-b546-3b99-8ead-b781afce67fc",
                                        "entry_id": "c2a140b4-1a30-3f1f-a323-e13343dc0b8e",
                                        "glosses": [
                                            "Betonung des Modernen, Streben nach dem, was modern, neu, aktuell ist; Ausrichtung auf die Modernität"
                                        ],
                                        "tags": [
                                            "especially",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c155115-9ebd-40e2-8dd5-e3e022d4466a",
                                                "sense_id": "beafb763-b546-3b99-8ead-b781afce67fc",
                                                "text": "„Ab 1933 wurde der Modernismus in der Kunst in Deutschland politisch verfolgt.” Wieder in New York Als Jackson […]“"
                                            },
                                            {
                                                "example_id": "799af657-57d8-44ee-9e25-fe5600608c65",
                                                "sense_id": "beafb763-b546-3b99-8ead-b781afce67fc",
                                                "text": "„Der literarische Modernismus der 1960er Jahre ist die jüngste Epoche, die sich die Mitglieder der Kanonkommissionen mehrheitlich als abgeschlossen und kanonisierbar vorstellen.“"
                                            },
                                            {
                                                "example_id": "11780eea-6498-4abd-b396-7edfaf0f1217",
                                                "sense_id": "beafb763-b546-3b99-8ead-b781afce67fc",
                                                "text": "„Dort, wo der kleine Janosch seine ersten Lebenstage verbrachte, regierten die roten Backsteine der ärmlichen Mietskasernen, doch die neu erbauten Gebäude und Siedlungen der expandierenden Stadt entstanden bereits im Geiste des Modernismus und Funktionalismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "00f67c01-11c8-3300-9232-87f64e052ec5",
                                        "entry_id": "c2a140b4-1a30-3f1f-a323-e13343dc0b8e",
                                        "glosses": [
                                            "Strömung innerhalb der römisch-katholischen Kirche im 19. und 20. Jahrhundert, welche die moderne Wissenschaft und Philosophie mit den theologischen Lehren zu vereinen suchte"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6115e4fa-5d7c-4243-9e81-713f97539d01",
                                                "sense_id": "00f67c01-11c8-3300-9232-87f64e052ec5",
                                                "text": "„In der katholischen Kirche trat der Modernismus überwiegend in Frankreich, England und Italien auf; auch hatte er an den katholisch-theologischen Fakultäten der deutscher Universitäten eine Reihe von Befürwortern.“"
                                            },
                                            {
                                                "example_id": "6e08ac79-e5b4-48b9-b6d0-8d8b84b33d88",
                                                "sense_id": "00f67c01-11c8-3300-9232-87f64e052ec5",
                                                "text": "„Pius X. führte 1910 den Antimodernisteneid ein, mit dem jeder Kleriker dem Modernismus abschwören musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3e3e4f86-2be7-316e-a008-938044770ce9",
                                        "entry_id": "c2a140b4-1a30-3f1f-a323-e13343dc0b8e",
                                        "glosses": [
                                            "modernes stilistisches Element; Phänomen, das als typisch für die Moderne erachtet wird"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft",
                                            "Stilkunde",
                                            "Kunstwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e91bfd2-2588-4737-b88a-efc105704e15",
                                                "sense_id": "3e3e4f86-2be7-316e-a008-938044770ce9",
                                                "text": "„Seine Typographie war ein Modernismus mit archaisierender Tendenz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
