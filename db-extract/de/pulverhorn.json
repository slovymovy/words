                "senses": [
                    {
                        "sense_id": "f284d904-a732-397a-b1d0-70ddfd25c04e",
                        "entry_id": "8de0f6e2-c129-30f9-aa6d-0df98be26438",
                        "glosses": [
                            "Horn für Aufbewahrung und Transport von Schießpulver"
                        ],
                        "tags": [
                            "Waffe"
                        ],
                        "examples": [
                            {
                                "example_id": "65cf26b9-d24e-446b-b3a0-8819768ed908",
                                "sense_id": "f284d904-a732-397a-b1d0-70ddfd25c04e",
                                "text": "„Kroch nach der weggeprellten Büchse, nach Kugelbeutel und Pulverhorn, das erste; das zweite, daß er die Waffe, Mündung und Pfanne, Hahn, Flint und Kolben sorgfältig abtastete und im Dunkel nach geübtem Gefühle lud.“"
                            },
                            {
                                "example_id": "fead06a8-dd99-4f13-adf8-0fc1d5faf54f",
                                "sense_id": "f284d904-a732-397a-b1d0-70ddfd25c04e",
                                "text": "„An den Wänden lehnten überall Büchsen, an allen Nägeln oder vielmehr Pflöcken – denn an Eisen war im ganzen Gebäude kein großer Überfluß – hingen Kugeltaschen und Pulverhörner, und teils auf Decken, teils auf den rauhen Dielen hingestreckt, lagen mehrere der Hinterwäldler und unterhielten sich höchst angelegentlich über Weiden, Wild, und eine kürzlich in den Fourche la fave-Bergen angeblich entdeckte Goldmine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
