                "senses": [
                    {
                        "sense_id": "38815468-c82d-3b05-8f1a-8a0cff82e429",
                        "entry_id": "208929d4-5744-3870-ae4a-1cf1eacef30f",
                        "glosses": [
                            "Sortir d’un séquestre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09a74bf4-9c97-441a-9a6c-5791700fac31",
                                "sense_id": "38815468-c82d-3b05-8f1a-8a0cff82e429",
                                "text": "Le premier moyen de recours dont disposent les propriétaires belges de biens à déséquestrer est de soumettre le différend qui les oppose au Séquestre au Ministre compétent en l’occurrence."
                            },
                            {
                                "example_id": "8342e9c8-bb93-44cf-b3bc-ecb6b9d94c14",
                                "sense_id": "38815468-c82d-3b05-8f1a-8a0cff82e429",
                                "text": "Les résultats de l’administration d’acides aminés sur les taux circulants de GH ont conduit à la notion de sécrétagogues, c’est-à-dire de « cocktails » d’acides aminés et de substances naturelles capables de déséquestrer l’hormone et de la rediriger vers ses récepteurs."
                            }
                        ]
                    }
