                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shield featured a red cross <w>throughout</w> on a silver background.",
                            "target_lang_translations": {
                                "ru": "На щите был изображен красный крест <w>до краев</w> на серебряном фоне.",
                                "tr": "Kalkan, gümüş zemin üzerine <w>uçtan uca</w> uzanan kırmızı bir haç içeriyordu.",
                                "zh": "盾徽上有一个在银色背景上<w>延伸至边缘</w>的红色十字。"
                            }
