                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Benjamin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcb960f6-b85a-3c6a-b4b6-2741e82c67c7",
                                        "entry_id": "a2d4c40b-401a-326c-9375-00c6b9597ef4",
                                        "glosses": [
                                            "A $100 bill, which bears a portrait of Benjamin Franklin."
                                        ],
                                        "tags": [
                                            "US",
                                            "in-plural",
                                            "often",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ddd718-738a-4ebb-9312-106afc07b1bb",
                                                "sense_id": "fcb960f6-b85a-3c6a-b4b6-2741e82c67c7",
                                                "text": "Fuck the past, let's dwell on the 500SL, the E&J and ginger ale / The way my pockets swell to the rims with Benjamins"
                                            },
                                            {
                                                "example_id": "c5a23d70-6aac-4e8c-9868-8d8ec5f26f65",
                                                "sense_id": "fcb960f6-b85a-3c6a-b4b6-2741e82c67c7",
                                                "text": "Swimmin' in women wit they own condominiums / Five plus fives, who drive millenniums / It's all about the Benjamins, what?"
                                            },
                                            {
                                                "example_id": "ffee86de-25c0-42a2-ad94-1426a4d3c5f1",
                                                "sense_id": "fcb960f6-b85a-3c6a-b4b6-2741e82c67c7",
                                                "text": "Health Care: It's All About the Benjamins [title]"
                                            },
                                            {
                                                "example_id": "9a9b8127-6aba-47b6-afa1-ff6351ac398d",
                                                "sense_id": "fcb960f6-b85a-3c6a-b4b6-2741e82c67c7",
                                                "text": "Sneering through gold grillz, inked to the neck in bad tattoos and representing my area code, Franco leads the spring breakers through a stylized, mtv version of thug life, replete with drugs, guns, Benjamins and booty call."
                                            },
                                            {
                                                "example_id": "6dc77626-dc28-4dba-80ef-f3024e4b75ec",
                                                "sense_id": "fcb960f6-b85a-3c6a-b4b6-2741e82c67c7",
                                                "text": "He pursed his lips, went to the cash register, and opened it. He pulled out two Benjamins and a US Grant, which he set down on the glass case before me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d697c63d-b94e-4ed4-ba94-14712295684b",
                        "source_entry_id": "4933c9b3-5ff9-34f8-97c5-6ff5c835984d",
