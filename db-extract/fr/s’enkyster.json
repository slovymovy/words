                        "sense_id": "758d1ea8-36e7-3e19-a9f5-dc63054dca07",
                        "entry_id": "440ea80d-348c-390e-a83b-a7c2b3726221",
                        "glosses": [
                            "Se figer dans une situation malsaine."
                        ],
