                ],
                "senses": [
                    {
                        "sense_id": "8e809eaa-78e7-3548-ad3e-e8e8625f8d03",
                        "entry_id": "5a05223c-de47-32b3-9918-76f06ca19846",
                        "glosses": [
                            "Vertreter aus der Gruppe aller Arten amerikanischer Wildreben, die in Europa vor allen Dingen wegen ihrer Reblausresistenz als Pfropfunterlage für europäische Rebsorten Verbreitung gefunden hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adeb0bf5-bf9d-465a-a931-cd59dcc9fd17",
                                "sense_id": "8e809eaa-78e7-3548-ad3e-e8e8625f8d03",
                                "text": "Die Amerikanerrebe mit ihren reblausresistenten Wurzeln wird oft als Pfropfunterlage für andere Rebarten benutzt."
                            },
                            {
                                "example_id": "f4147504-a767-472f-a5a5-d42c07de3690",
                                "sense_id": "8e809eaa-78e7-3548-ad3e-e8e8625f8d03",
                                "text": "Das Anpflanzen der Amerikanerreben oder ihrer Samenbastarde mit Europäerreben ist wegen der zu erwartenden schlechten Weinqualitäten verboten."
                            },
                            {
                                "example_id": "baffe3b9-da07-49f6-b9fa-88a3ffa2e14f",
                                "sense_id": "8e809eaa-78e7-3548-ad3e-e8e8625f8d03",
                                "text": "„Bei Unterlagsreben handelt es sich üblicherweise um Amerikanerreben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
