                "senses": [
                    {
                        "sense_id": "bd3ef11e-b828-3c30-8443-9b1a4d376f55",
                        "entry_id": "e2ec9250-6150-38e1-a39c-802e64683cda",
                        "glosses": [
                            "intensives Bombardement, das auf einen Zielort niedergeht"
