                "senses": [
                    {
                        "sense_id": "f85cf97b-e530-3aee-a5ae-eb0b9c5b65e5",
                        "entry_id": "c7e8060e-e1f7-3f9d-af9b-75ec03aa3a18",
                        "glosses": [
                            "Se comporter comme un bélître, mendier au lieu de travailler."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c7fc8dbd-0b06-431a-9d8c-7b0ea29746dc",
                                "sense_id": "f85cf97b-e530-3aee-a5ae-eb0b9c5b65e5",
                                "text": "Sous Henri III, on menace d’enfermer aux Petites Maisons ceux «qui aiment mieux bélitrer que gagner leurs vies ou travailler, ne se contentant de l’aumône ordinaire, laquelle ils veulent prendre par forme de prébende et vivre sans rien faire»."
                            },
                            {
                                "example_id": "38fa8e6c-7a6d-42a0-a742-2bd344b89ffe",
                                "sense_id": "f85cf97b-e530-3aee-a5ae-eb0b9c5b65e5",
                                "text": "après quoi, il s’empressa de revenir en Dauphiné, comme simple conseiller, n’étant pas de ceux qui vont « bélitrer en Cour le loyer de leur vertu. »"
                            }
                        ]
                    }
