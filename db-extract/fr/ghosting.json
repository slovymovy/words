                                                "example_id": "57515298-a679-4447-a29e-2fa14b8a54ea",
                                                "sense_id": "edc5c702-f0c0-3011-8f3a-69ab80ec6074",
                                                "text": "Examine your matrix map, and make sure that no three keystrokes form a rectangle with a fourth keystroke that will cause you problems. This prevents both ghosting and blocking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fca16e8-6e9e-3ddc-9a1a-5fed39e49ef1",
                                        "entry_id": "0df385c7-54b9-3920-b127-47e5e483dfcc",
                                        "glosses": [
                                            "A method of ending a personal relationship by stopping any contact with the other party and not providing an explanation."
                                        ],
                                        "tags": [
                                            "colloquial",
