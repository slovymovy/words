                                                "example_id": "0e8704e4-242a-4848-878d-50fc6748fcd3",
                                                "sense_id": "5ed68b4d-29fe-3b26-a354-97c08ddfba86",
                                                "text": "Für den Kongress sind aufwendige Vorbereitungen erforderlich."
                                            },
                                            {
                                                "example_id": "eed2922a-1070-4fd1-8b10-34947566d890",
                                                "sense_id": "5ed68b4d-29fe-3b26-a354-97c08ddfba86",
                                                "text": "Am Wochenende hatte die neue, aufwendige Inszenierung der Zauberflöte Premiere."
                                            },
                                            {
                                                "example_id": "08a3f3ae-5422-4a88-baca-0be9c9e058be",
                                                "sense_id": "5ed68b4d-29fe-3b26-a354-97c08ddfba86",
                                                "text": "Er leistete sich einen aufwendigen Lebensstil."
                                            },
                                            {
                                                "example_id": "7083d431-a97e-4f81-a809-f09c6b699258",
