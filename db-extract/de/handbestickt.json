                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfe6df08-bfa0-4db1-99cf-76f01797fdee",
                                "sense_id": "6c3f284a-9953-3be0-89ea-509a683da290",
                                "text": "„Heraldische Banner, vielfarbig aus leuchtendem handbesticktem Samt, knatterten fröhlich im Wind.“"
                            },
                            {
                                "example_id": "7bbae062-a065-43da-983d-c8a147a5a113",
                                "sense_id": "6c3f284a-9953-3be0-89ea-509a683da290",
                                "text": "„Buzz hatte sein Blatt mit den Wettberechnungen beiseitegelegt und die ›Starken Männer‹ beim Essen beobachtet; er hatte sechs zu eins gesetzt, dass Howard an die Decke ginge, wenn er sähe, wie seine handbestickten Uniformen mit Senf und Sauerkraut bekleckert wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
