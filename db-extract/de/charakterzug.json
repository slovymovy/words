                        ],
                        "form": "die Charakterzüge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "abadc9f8-9fde-358a-9da9-9df8e691b2cd",
                        "entry_id": "4da0990f-26d6-3d41-abff-2ff62fa0b70e",
                        "glosses": [
                            "eine bestimmte Eigenschaft/ein bestimmtes Merkmal eines Charakters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b625e74c-68bd-48bc-94ae-9b85e14e01db",
                                "sense_id": "abadc9f8-9fde-358a-9da9-9df8e691b2cd",
                                "text": "„Heute weiß Gudrun Baumann, dass das Nichthinsehen, das ihr offenbar während des Luftkriegs antrainiert worden war, zu einem Charakterzug wurde, gegen den sie dann ihr Leben lang ankämpfte.“"
                            },
                            {
                                "example_id": "d9aefd47-bc31-4dec-8e2c-816b0a5b6e67",
                                "sense_id": "abadc9f8-9fde-358a-9da9-9df8e691b2cd",
                                "text": "„Gemütlichkeit, behaupten gerade die Ungemütlichen, ist ein Charakterzug des gründlichen Deutschen, der tagsüber tüchtig und fortschrittlich ist und abends gemütlich wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49aae1ac-33f6-4e75-9978-e2438b245d49",
                        "source_entry_id": "4da0990f-26d6-3d41-abff-2ff62fa0b70e",
                        "source_sense_id": "abadc9f8-9fde-358a-9da9-9df8e691b2cd",
                        "source_sense_description": "eine bestimmte Eigenschaft/ein bestimmtes Merkmal eines Charakters",
                        "target_lang_word": "trait de caractère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trait de caractère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78be6192-31dd-3da3-beac-827875ecc7ea",
                                        "entry_id": "d62b81d6-15c0-309d-8d59-6cf0ca45b885",
                                        "glosses": [
                                            "Comportements et personnalité relevant de l'acquis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e968e75-11d3-4067-bdbc-46c1e160a34f",
                                                "sense_id": "78be6192-31dd-3da3-beac-827875ecc7ea",
                                                "text": "Les traits de caractère et les traits de tempérament définissent notre personnalité et nos comportements."
                                            },
                                            {
                                                "example_id": "4bd0891a-564a-427e-976f-2fea612ff1be",
                                                "sense_id": "78be6192-31dd-3da3-beac-827875ecc7ea",
                                                "text": "Les traits de caractère varient pendant la vie d'un individu, en fonction des expériences et des situations rencontrées."
                                            },
                                            {
                                                "example_id": "b32809de-1bed-41e4-8782-7c88ab4f057d",
                                                "sense_id": "78be6192-31dd-3da3-beac-827875ecc7ea",
                                                "text": "Je sentais que chaque fois que je posais une question, cela l’embarrassait et la contrariait - un trait de caractère commun avec ma mère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
