    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "906dfc82-a71a-3518-be32-bfb7b48b4de1",
                    "sense_definition": "A part of the body that has a specific vital function, such as the heart or liver.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heart is a vital <w>organ</w> that pumps blood throughout the entire body.",
                            "target_lang_translations": {
                                "ru": "Сердце — это жизненно важный <w>орган</w>, который перекачивает кровь по всему телу.",
                                "zh": "心脏是向全身输送血液的生命<w>器官</w>。"
                            }
                        },
                        {
                            "text": "Doctors are concerned about how the medication might affect his internal <w>organs</w> over time.",
                            "target_lang_translations": {
                                "ru": "Врачи обеспокоены тем, как лекарство может со временем повлиять на его внутренние <w>органы</w>.",
                                "zh": "医生们担心这种药物长期服用会影响他的内<w>器官</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "vital organ",
                        "internal organ",
                        "organ donor",
                        "organ transplant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть тела, выполняющая определенную жизненно важную функцию, например, сердце или печень.",
                        "zh": "身体中具有特定生命功能的部位，如心脏或肝脏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "орган",
                                "target_lang_sense_clarification": "биологический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "器官",
                                "target_lang_sense_clarification": "生物学上的身体部位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a731384-44f2-324c-adef-94ab0141e637",
                    "sense_definition": "A large musical instrument having rows of pipes supplied with air from bellows and played using a keyboard.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church <w>organ</w> produced a powerful sound that filled the entire cathedral.",
                            "target_lang_translations": {
                                "ru": "Церковный <w>орган</w> издавал мощный звук, наполнявший весь собор.",
                                "zh": "教堂里的<w>管风琴</w>发出了震撼的声音，回荡在整个大教堂中。"
                            }
                        },
                        {
                            "text": "She has been practicing the <w>organ</w> for years and now plays for the local choir.",
                            "target_lang_translations": {
                                "ru": "Она годами упражнялась в игре на <w>органе</w> и теперь играет для местного хора.",
                                "zh": "她练习<w>管风琴</w>多年，现在为当地唱诗班伴奏。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pipe organ",
                        "church organ",
                        "electric organ",
                        "play the organ"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой музыкальный инструмент с рядами труб, в которые подается воздух, управляемый с помощью клавиатуры.",
                        "zh": "一种大型键盘乐器，通过风箱供气使管子发声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "орган",
                                "target_lang_sense_clarification": "музыкальный инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "管风琴",
                                "target_lang_sense_clarification": "大型键盘乐器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46c4e088-8f1f-31cd-9831-b3972038c784",
                    "sense_definition": "An official department or agency that is part of a larger government or organization.",
