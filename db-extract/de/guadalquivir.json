                "senses": [
                    {
                        "sense_id": "869c9b42-8f9b-3eba-89c7-0b74f5c96c73",
                        "entry_id": "b569faa0-3f79-3a11-9b8a-9df1febba253",
                        "glosses": [
                            "Hauptfluss Andalusiens und einer der sechs größeren Flüsse der Iberischen Halbinsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e53073c0-c7f2-4bfe-88b4-90db43082aa0",
                                "sense_id": "869c9b42-8f9b-3eba-89c7-0b74f5c96c73",
                                "text": "Der Guadalquivir entspringt in der Sierra de Segura."
                            },
                            {
                                "example_id": "241fd01c-ff93-4e0e-bd1f-6904f9cc625f",
                                "sense_id": "869c9b42-8f9b-3eba-89c7-0b74f5c96c73",
                                "text": "„Ein trüber Weißwein aus Kastilien löste ihre Gemüter; dann saßen sie trunken in einem Ruderboot und schaukelten auf dem nachtschwarzen Wasser des Guadalquivir.“"
                            },
                            {
                                "example_id": "a4d1c1f2-4129-4aa0-99e6-3d402d2ca12a",
                                "sense_id": "869c9b42-8f9b-3eba-89c7-0b74f5c96c73",
                                "text": "„Das gesamte Baumaterial muß mit einer Fähre über den 1,2 Kilometer breiten Guadalquivir transportiert werden.“"
                            },
                            {
                                "example_id": "f408c8f4-8bfd-433e-99bb-d0b03fa915cd",
                                "sense_id": "869c9b42-8f9b-3eba-89c7-0b74f5c96c73",
                                "text": "«Im Naturpark Cazorla entspringt der Guadalquivir, die berühmte Flussader, die an Sevilla, Córdoba und anderen Städten vorbeifliesst.»"
                            },
                            {
                                "example_id": "b7a9a748-d12b-4fb6-9aad-6882d2e84698",
                                "sense_id": "869c9b42-8f9b-3eba-89c7-0b74f5c96c73",
                                "text": "„Doch das Berauschende ist das Land dazwischen, das Land weiter nach Norden bis zum Guadalquivir und noch weiter bis Baeza und Úbeda: Olivenbäume, soweit das Auge reicht.“"
                            },
                            {
                                "example_id": "29c7cd4a-6a9a-43d8-a25b-dd89749e6239",
                                "sense_id": "869c9b42-8f9b-3eba-89c7-0b74f5c96c73",
                                "text": "„Wer die Stille jenseits spanischen Temperamentes bevorzugt, dem sind die prärieartigen Halbwüsten bei Almeria oder das fruchtbare Mündungsdelta des Guadalquivirs empfohlen, einem der größten europäischen Vogelreservate.“"
                            },
                            {
                                "example_id": "1d1d3a10-b3ea-4bb2-949d-f211cca91101",
                                "sense_id": "869c9b42-8f9b-3eba-89c7-0b74f5c96c73",
                                "text": "„Neben Sevilla mit seinem Hafen und Andujar mit seiner Keramik ist die einstige Hauptstadt von Al-Andalus Córdoba eine der drei Städte am Guadalquivir, die unter den arabischen Herrschern zur Blüte gelangten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
