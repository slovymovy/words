{
    "word_family": [
        "axeman",
        "axle"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15e9e9de-4fd4-3584-a27d-febd7685618d",
                    "sense_definition": "A tool for felling trees or chopping wood, consisting of a heavy head with a blade and a handle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lumberjack used a sharp <w>axe</w> to cut down the old oak tree.",
                            "target_lang_translations": {
                                "zh": "伐木工用一把锋利的<w>斧头</w>砍倒了那棵老橡树。"
                            }
                        },
                        {
                            "text": "He grabbed his <w>axe</w> to chop some wood for the fireplace.",
                            "target_lang_translations": {
                                "zh": "他拿起<w>斧子</w>去为壁炉劈些木柴。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hatchet"
                    ],
                    "common_phrases": [
                        "sharp axe"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种用于砍伐树木或劈木头的工具，由沉重的刃部和手柄组成。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斧头",
                                "target_lang_sense_clarification": "通用的砍伐工具。"
                            },
                            {
                                "target_lang_word": "斧子",
                                "target_lang_sense_clarification": "口语中常用的称呼。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "274b33e3-4f20-3c4d-b956-4dd71e9fea14",
                    "sense_definition": "An ancient weapon consisting of a head with one or two blades and a long handle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval soldier carried a heavy battle <w>axe</w> into the fight.",
                            "target_lang_translations": {
                                "zh": "中世纪的士兵带着一把沉重的战<w>斧</w>参加了战斗。"
                            }
                        },
                        {
                            "text": "Museums often display an ancient <w>axe</w> found in historical burial sites.",
                            "target_lang_translations": {
                                "zh": "博物馆经常展出在历史墓葬中发现的古代<w>斧</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "battle axe"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种古代武器，通常带有单刃或双刃以及长柄。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斧",
                                "target_lang_sense_clarification": "指代武器时常用于书面语或复合词。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4552ae0-ae80-3ad4-a29b-037f9cc23d8e",
                    "sense_definition": "A dismissal or rejection from a job or position.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dismissal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the company lost money, many employees were given the <w>axe</w>.",
                            "target_lang_translations": {
                                "zh": "公司亏损后，许多员工被<w>解雇</w>了。"
                            }
                        },
                        {
                            "text": "He feared he would get the <w>axe</w> after the project failed.",
                            "target_lang_translations": {
                                "zh": "他担心项目失败后自己会被<w>炒鱿鱼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pink slip",
                        "sack"
                    ],
                    "common_phrases": [
                        "get the axe"
                    ],
                    "target_lang_definitions": {
                        "zh": "指被解雇或从职位上被撤职。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "解雇",
                                "target_lang_sense_clarification": "指失去工作。"
                            },
                            {
                                "target_lang_word": "炒鱿鱼",
                                "target_lang_sense_clarification": "非正式用语，指被解雇。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60f15909-e631-341c-a9ad-ba6f56b40cdc",
                    "sense_definition": "A drastic reduction or cutback in funding or services.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dismissal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local library is facing the <w>axe</w> due to budget cuts.",
                            "target_lang_translations": {
                                "zh": "由于预算<w>削减</w>，当地图书馆正面临被砍掉的风险。"
                            }
                        },
                        {
                            "text": "Many public programs were put to the <w>axe</w> this year.",
                            "target_lang_translations": {
                                "zh": "今年许多公共项目都被<w>削减</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "face the axe"
                    ],
                    "target_lang_definitions": {
                        "zh": "指对资金或服务进行大幅度的削减。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "削减",
                                "target_lang_sense_clarification": "指经费或预算的减少。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a73ee6e-94ba-37b9-aa4f-49963677bda4",
                    "sense_definition": "A musician's particular instrument, especially a guitar or saxophone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guitarist picked up his <w>axe</w> and started a blues solo.",
                            "target_lang_translations": {
                                "zh": "吉他手拿起他的<w>乐器</w>，开始了一段蓝调独奏。"
                            }
                        },
                        {
                            "text": "He has been playing that same <w>axe</w> for over twenty years.",
                            "target_lang_translations": {
                                "zh": "他弹奏那把<w>乐器</w>已经超过二十年了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used by musicians."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "音乐家所使用的特定乐器，尤指吉他或萨克斯风。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "乐器",
                                "target_lang_sense_clarification": "指代音乐家使用的工具。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e73e2bb-35d3-3523-9877-cce0ec84ff4b",
                    "sense_definition": "To fell or chop something using an axe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had to <w>axe</w> the dead tree before it fell on the house.",
                            "target_lang_translations": {
                                "zh": "他们必须在枯树倒在房子上之前将其<w>砍</w>掉。"
                            }
                        },
                        {
                            "text": "He began to <w>axe</w> the thick logs into smaller pieces.",
                            "target_lang_translations": {
                                "zh": "他开始把粗木头<w>砍</w>成小块。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chop"
                    ],
                    "common_phrases": [
                        "axe down"
                    ],
                    "target_lang_definitions": {
                        "zh": "用斧头砍伐或劈开某物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "砍",
                                "target_lang_sense_clarification": "指用利器劈砍。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbaed36f-6809-334b-b50d-05ad16389d3d",
                    "sense_definition": "To terminate, lay off, or cancel something in a ruthless manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dismissal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The network decided to <w>axe</w> the popular show after only one season.",
                            "target_lang_translations": {
                                "zh": "电视台决定在仅播出一季后就<w>砍掉</w>了这个热门节目。"
                            }
                        },
                        {
                            "text": "The government had to <w>axe</w> public spending to balance the budget.",
                            "target_lang_translations": {
                                "zh": "政府不得不<w>削减</w>公共开支以平衡预算。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fire",
                        "dismiss",
                        "terminate"
                    ],
                    "common_phrases": [
                        "axe a program"
                    ],
                    "target_lang_definitions": {
                        "zh": "以冷酷的方式终止、解雇或取消某事。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "砍掉",
                                "target_lang_sense_clarification": "指取消项目或削减预算。"
                            },
                            {
                                "target_lang_word": "裁撤",
                                "target_lang_sense_clarification": "指解雇人员或撤销部门。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "913f9764-b08f-3cab-ad57-42d6723f3417",
                    "sense_definition": "A river in England flowing into Lyme Bay.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The river <w>Axe</w> flows through the beautiful countryside of Dorset.",
                            "target_lang_translations": {
                                "zh": "<w>阿克斯河</w>流经多塞特郡美丽的乡村。"
                            }
                        },
                        {
                            "text": "Many tourists visit the mouth of the <w>Axe</w> near Seaton.",
                            "target_lang_translations": {
                                "zh": "许多游客会去西顿附近的<w>阿克斯河</w>入海口参观。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "英国的一条河流，流入莱姆湾。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阿克斯河",
                                "target_lang_sense_clarification": "地理名称。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}