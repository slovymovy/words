                "senses": [
                    {
                        "sense_id": "cddb8f10-c27a-3143-af37-765a7622dfd1",
                        "entry_id": "89b3c964-27a8-3eea-ac26-ed0472dd93f3",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6815b475-6975-4f6f-b33d-9a0252fd5718",
                                "sense_id": "cddb8f10-c27a-3143-af37-765a7622dfd1",
                                "text": "Rodzice Saula mieszkają w Beer Szewie od 2000 roku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "379cce40-1177-308e-a9f1-cc05f6bcbc36",
                        "entry_id": "89b3c964-27a8-3eea-ac26-ed0472dd93f3",
                        "glosses": [
                            "postać biblijna, król Izraela"
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "e4bfb1e2-252f-4c3e-88db-9e3590791ce0",
                                "sense_id": "379cce40-1177-308e-a9f1-cc05f6bcbc36",
                                "text": "Widać to choćby w specyficznym obciążaniu Saula, który z charyzmatycznego przywódcy przemienił się w szaleńca i bezbożnika."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e3fa6be-2654-4d9e-bdc5-b3a7aa296a13",
                        "source_entry_id": "89b3c964-27a8-3eea-ac26-ed0472dd93f3",
                        "source_sense_id": "cddb8f10-c27a-3143-af37-765a7622dfd1",
                        "target_lang_word": "Saul",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saul",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57b1f61f-9f7f-3cc2-bfa8-88486f1950e9",
                                        "entry_id": "f2152611-6db5-3906-b0ef-0a94bd864dbd",
                                        "glosses": [
                                            "The first king of Israel in the Old Testament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5192739a-51d9-4128-8eac-bdbcfc844d87",
                                                "sense_id": "57b1f61f-9f7f-3cc2-bfa8-88486f1950e9",
                                                "text": "And it came to paſſe, when the euill ſpirit from God was vpon Saul, that Dauid tooke an harpe, and played with his hand: So Saul was refreſhed, and was well, and the euill ſpirit departed from him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3665e2cd-2e10-3357-9136-ba03efe7d571",
                                        "entry_id": "f2152611-6db5-3906-b0ef-0a94bd864dbd",
                                        "glosses": [
                                            "The Hebrew name of Apostle Paul in the New Testament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c6cdccd-7156-4fd9-a279-207dccf5b544",
                                                "sense_id": "3665e2cd-2e10-3357-9136-ba03efe7d571",
                                                "text": "Then Saul (who alſo is called Paul) filled with the holy Ghoſt, ſet his eyes on him"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf7c0e52-ae16-32d2-a196-bdac30b86c18",
                                        "entry_id": "f2152611-6db5-3906-b0ef-0a94bd864dbd",
                                        "glosses": [
                                            "A male given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a02921e3-0ccf-4104-ba61-b6b456d22256",
                                                "sense_id": "cf7c0e52-ae16-32d2-a196-bdac30b86c18",
                                                "text": "“You got an uncle named Saul?” “I never mentioned him?” “What are you saying —you got some Jewish guy for an uncle?” “He's not Jewish. It's just a name they have back in the old country.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21d6038c-a45a-3c22-bc92-885596d50b4e",
                                        "entry_id": "f2152611-6db5-3906-b0ef-0a94bd864dbd",
                                        "glosses": [
                                            "A surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a93fded-e240-3295-a8cb-e959a714bf9e",
                                        "entry_id": "f2152611-6db5-3906-b0ef-0a94bd864dbd",
                                        "glosses": [
