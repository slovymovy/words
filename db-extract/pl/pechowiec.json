                                "target_senses": [
                                    {
                                        "sense_id": "cbfbe34c-41fd-3bc0-bc67-e461a5ffd186",
                                        "entry_id": "85a8b6a9-7b46-3d40-a92a-56b5296abab6",
                                        "glosses": [
                                            "To cast a spell on."
