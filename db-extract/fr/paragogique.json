                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24d6d7de-cee2-4b8a-a159-53470a94d018",
                                "sense_id": "5b7f8292-0917-39cf-8c98-f795a1b06d1c",
                                "text": "Lettre paragogique."
                            },
                            {
                                "example_id": "c556f0f4-0167-4938-afdb-e00e8917b985",
                                "sense_id": "5b7f8292-0917-39cf-8c98-f795a1b06d1c",
                                "text": "Syllabe paragogique."
                            },
                            {
                                "example_id": "5604db63-53be-4741-96f7-bb3920e8ae42",
                                "sense_id": "5b7f8292-0917-39cf-8c98-f795a1b06d1c",
                                "text": "De son côté l'italien, obéissant à la même impulsion, ce qui montre bien qu'il n'y eut pas simple coïncidence, fit anzi, tardi, etc. ; il eut l'i paragogique comme nous eûmes l's."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a02f9c21-795e-4c7f-b028-57760f7f4b1e",
                        "source_entry_id": "02f62c62-9efd-38f0-b3f2-c05e1c0c6961",
                        "source_sense_id": "5b7f8292-0917-39cf-8c98-f795a1b06d1c",
                        "source_sense_description": "(Grammaire) Ajouté à l’extrémité d’un mot",
                        "target_lang_word": "paragogic",
