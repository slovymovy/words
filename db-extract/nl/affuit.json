                "translations": [
                    {
                        "translation_id": "d859b070-b95e-4a9d-b652-f36b22a8b47b",
                        "source_entry_id": "3cda0969-1594-37bc-b9fd-7517c2fc1fdb",
                        "source_sense_id": "421cd18a-fb65-3800-96ba-7c71f3cf62ee",
                        "target_lang_word": "Lafette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lafette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf5b3a8c-3311-3d7f-9fa8-f59dff167c72",
                                        "entry_id": "50b24143-ca40-3f2d-bb25-64a16e6f033b",
                                        "glosses": [
                                            "fahrbares Untergestell, auf dem ein Geschütz (eine Waffe, eine Kanone) montiert werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac183c80-da86-49dd-8858-89548c8dc3df",
                                                "sense_id": "bf5b3a8c-3311-3d7f-9fa8-f59dff167c72",
                                                "text": "„Das QF 4 inch (102 mm) war ein britisches Schiffsgeschütz aus dem Ersten Weltkrieg, das mit geeigneten Lafetten an die Verwendung als schweres Flugzeugabwehrgeschütz an Land und zur See angepasst wurde.“"
                                            },
                                            {
                                                "example_id": "60dc64a3-fcdb-4df1-a954-cbaccd5378f6",
                                                "sense_id": "bf5b3a8c-3311-3d7f-9fa8-f59dff167c72",
                                                "text": "„Jetzt wurde der Sarg auf der Lafette abgestellt.“"
                                            },
                                            {
                                                "example_id": "820a1428-155e-4692-94a0-b9689145b441",
                                                "sense_id": "bf5b3a8c-3311-3d7f-9fa8-f59dff167c72",
                                                "text": "„Unsere Backbordkanonen wurden an Land gebracht und in einem Blockhaus untergestellt, während die Steuerbordkanonen auf ihren Lafetten stehen blieben.“"
                                            },
                                            {
                                                "example_id": "76db75b9-e255-473c-be45-0c10ad005f5c",
                                                "sense_id": "bf5b3a8c-3311-3d7f-9fa8-f59dff167c72",
                                                "text": "„Martins Kanoniere waren insofern im Vorteil, als sie ihre Habseligkeiten an die Lafetten hängen oder in die Munitionswagen geben konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d54e297e-e2bf-4288-8d71-233b20c69cd8",
                        "source_entry_id": "3cda0969-1594-37bc-b9fd-7517c2fc1fdb",
                        "source_sense_id": "421cd18a-fb65-3800-96ba-7c71f3cf62ee",
                        "target_lang_word": "gun carriage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gun carriage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62d3b1b7-fb62-3359-bdcb-bf8ef650813f",
                                        "entry_id": "3802c0cd-3673-305c-ac5b-440776fa090c",
                                        "glosses": [
                                            "A metal or wooden frame on which a piece of ordnance is mounted for firing or transportation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "221dcfd7-51e2-4712-bf5b-02c0059c1571",
                                                "sense_id": "62d3b1b7-fb62-3359-bdcb-bf8ef650813f",
                                                "text": "But then I had the [massive] flintlock by me for protection. ¶[…]The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window at the old mare feeding in the meadow below by the brook, and a 'bead' could be drawn upon Molly, the dairymaid, kissing the fogger behind the hedge, little dreaming that the deadly tube was levelled at them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "957f0a2d-2df6-49b7-8b78-7aa37efc0313",
                        "source_entry_id": "3cda0969-1594-37bc-b9fd-7517c2fc1fdb",
                        "source_sense_id": "421cd18a-fb65-3800-96ba-7c71f3cf62ee",
                        "target_lang_word": "affût",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affût",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "092e364a-84cf-3e8d-8cb0-fe9a843e8739",
                                        "entry_id": "72ccba93-d7a9-3d64-9a44-9f3843083445",
                                        "glosses": [
                                            "Machine de bois ou de métal servant à supporter ou à transporter une pièce d’artillerie."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "917b0bd5-39e2-4785-9028-1c93098f55c3",
                                                "sense_id": "092e364a-84cf-3e8d-8cb0-fe9a843e8739",
                                                "text": "Les 4 Servans de l’affût s'y portent alors : ils ôtent la chevrette et la mettent sur le traîneau avec le reste des armemens ; […]."
                                            },
                                            {
                                                "example_id": "80098345-db95-41af-819e-032cc60d1d3e",
                                                "sense_id": "092e364a-84cf-3e8d-8cb0-fe9a843e8739",
                                                "text": "Le ministre, soutenu par quatre hommes de sa suite, descendit de cheval péniblement et en jetant quelques cris involontaires que lui arrachaient ses douleurs ; mais il les dompta et s’assit sur l’affût d’un canon."
                                            },
                                            {
                                                "example_id": "2d8afdd5-2729-4ccd-9969-69ef5676e14a",
                                                "sense_id": "092e364a-84cf-3e8d-8cb0-fe9a843e8739",
                                                "text": "Une découverte militaire importante révolutionne la conception des villes et surtout des remparts : les frères Bureau inventent, aux alentours de 1450, l’affût à roues, ce qui assure la mobilité de l’artillerie."
                                            },
                                            {
                                                "example_id": "95751139-1458-45f9-9563-93d6ec0f967d",
                                                "sense_id": "092e364a-84cf-3e8d-8cb0-fe9a843e8739",
                                                "text": "Par ailleurs, pour des raisons budgétaires, le même canon est monté sur un affût tracté pour équiper les divisions d'infanterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c80ed72-8bbf-3f87-a5f3-a075be7664eb",
                                        "entry_id": "72ccba93-d7a9-3d64-9a44-9f3843083445",
                                        "glosses": [
                                            "Châssis de bois qui formait le moule pour puiser les feuilles de papier."
                                        ],
                                        "tags": [
                                            "Papeterie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7085b706-a6b6-3a00-b036-2383d72aad8a",
                                        "entry_id": "72ccba93-d7a9-3d64-9a44-9f3843083445",
                                        "glosses": [
                                            "Meuble représentant un support de canon dans les armoiries. Il n’est quasiment jamais séparé du fût de canon. Il est généralement représenté sous une forme ancienne dont la couleur peut différer de celle du fût du canon, on dit alors que le canon est affûté d’une certaine couleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "411920fd-4806-4454-804e-278a1db2136a",
                                                "sense_id": "7085b706-a6b6-3a00-b036-2383d72aad8a",
                                                "text": "D’or à la pièce de canon de sable tournée à senestre, montée sur un affût de gueules et posée sur une montagne d’azur mouvant de la pointe, qui est de Montfort-sur-Argens → voir illustration « armoiries avec un canon sur son affût »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e2fe2d8-1be2-3ce0-85b8-39cf9689cc79",
                                        "entry_id": "72ccba93-d7a9-3d64-9a44-9f3843083445",
                                        "glosses": [
                                            "Manche d'un outil tranchant. (Note :pour un rabot on dit fût)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "affût",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dcc693a1-dd74-365f-a7de-80953a5ca0b4",
                                        "entry_id": "ad5e1a6a-a41a-309e-b6b5-43ea4a691a20",
                                        "glosses": [
                                            "Endroit où on se poste pour attendre le gibier à la sortie du bois ou à la rentrée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74d7bd77-2f7a-47de-8289-0c354d803d11",
                                                "sense_id": "dcc693a1-dd74-365f-a7de-80953a5ca0b4",
                                                "text": "Le Chasseur français, édité par la Manufacture française d’Armes et Cycles de Saint-Étienne, était pour moi tout parfumé d’affûts au cœur des fourrés."
                                            },
                                            {
                                                "example_id": "2decc4a0-bfea-49fa-9f91-40d0ea153379",
                                                "sense_id": "dcc693a1-dd74-365f-a7de-80953a5ca0b4",
                                                "text": "Un affût au sol - fait de branchages ou recouvert d’un filet de camouflage - vous permettra d'attendre discrètement et confortablement les oiseaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49272090-e448-384a-b9db-913af15b7f27",
                                        "entry_id": "ad5e1a6a-a41a-309e-b6b5-43ea4a691a20",
                                        "glosses": [
                                            "Chasse à l’affût, type de chasse où l’on se poste dans un affût pour attendre le gibier."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c91d8755-ec02-49d5-93a0-998cabb487d8",
                                                "sense_id": "49272090-e448-384a-b9db-913af15b7f27",
                                                "text": "L’affût est la chasse individuelle la plus pratiquée."
                                            },
                                            {
                                                "example_id": "68241d47-bf01-43de-a2a3-571f6ac8d104",
                                                "sense_id": "49272090-e448-384a-b9db-913af15b7f27",
                                                "text": "L’affût ne se déroulait qu’en période de lune cachée, bien sûr, lors de ces nuits farouches où le moindre vent peuple les frondaisons d'une chiée de gnomes hideux et venimeux …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "568e2194-1232-3375-83c3-fc7f18de9c95",
                                        "entry_id": "ad5e1a6a-a41a-309e-b6b5-43ea4a691a20",
                                        "glosses": [
                                            "Période d’attente vigilante permettant d’observer un événement, un objet, un être vivant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c14057b0-4ce8-4b7a-afcb-0667bbbf3100",
                                                "sense_id": "568e2194-1232-3375-83c3-fc7f18de9c95",
                                                "text": "Cet affût que je dois maintenir pour capter ce qui se murmure à l’intime du magma."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "affût",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2543ccf5-44e4-37d2-8bf9-42981d85ab28",
                                        "entry_id": "4816fc2a-ae90-3517-b70c-97c45e5241f4",
                                        "glosses": [
                                            "Tranchant en forme de biseau d’un outil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a2ff9dd-4c92-43dc-910c-9aa6f78227dc",
                                                "sense_id": "2543ccf5-44e4-37d2-8bf9-42981d85ab28",
                                                "text": "[…] le premier est formé par la réunion de deux biseaux courts formant un angle obtus servant en général pour débiter rapidement de grandes quantités de matière par un travail grossier, et à cet effet, ayant besoin d’offrir une grande résistance ; c’est l’affût des haches, des burins à buriner, etc."
                                            },
                                            {
                                                "example_id": "67d0a0c6-3fc8-42dd-9c1b-982791ddd294",
                                                "sense_id": "2543ccf5-44e4-37d2-8bf9-42981d85ab28",
                                                "text": "Il faut avoir soin, dans ce mode de procéder, de donner à l’outil la même inclinaison, sans cela l’affût est convexe au lieu d’être droit, l’angle du biseau devient moins aigu et le tranchant pénètre moins dans le bois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6ed7640-0eaf-4b3b-a7cc-0008ca627027",
                        "source_entry_id": "3cda0969-1594-37bc-b9fd-7517c2fc1fdb",
                        "source_sense_id": "421cd18a-fb65-3800-96ba-7c71f3cf62ee",
                        "target_lang_word": "fût",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fût",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fce0fd9-ce33-39cc-ac53-992084e7fb01",
                                        "entry_id": "9f32dd09-bf9e-392a-9efb-17cc9a75758f",
                                        "glosses": [
                                            "Troisième personne du singulier de l’imparfait du subjonctif de être."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ba86c19-42b8-4793-be35-72ebb1c25972",
                                                "sense_id": "4fce0fd9-ce33-39cc-ac53-992084e7fb01",
                                                "text": "Il n’y avait dans la maison qu’un jeune garçon de douze ou treize ans, neveu de Kermelle, que celui-ci avait recueilli, et auquel le vicaire, digne homme s’il en fût, apprenait ce qu’il savait : le latin."
                                            },
                                            {
                                                "example_id": "42796a45-893b-4283-aa84-1d4c8fc80d4f",
                                                "sense_id": "4fce0fd9-ce33-39cc-ac53-992084e7fb01",
                                                "text": "Il aurait eu beaucoup d’esprit s’il se fût permis d’en avoir."
                                            },
                                            {
                                                "example_id": "6ec9ddc0-1aec-4217-b326-cdb643300c43",
                                                "sense_id": "4fce0fd9-ce33-39cc-ac53-992084e7fb01",
                                                "text": "— On dit que votre mari est nommé ministre. Est-ce que c’est vrai ?\nElle savait qu’on le disait, mais elle ne croyait pas que rien fût fait encore."
                                            },
                                            {
                                                "example_id": "b4b0a8c3-304c-46dc-894b-91a41b3e3867",
                                                "sense_id": "4fce0fd9-ce33-39cc-ac53-992084e7fb01",
                                                "text": "Les dernières semaines, quand elle se mit à grossir rapidement, elle se réjouit qu’André fût loin d’elle, craignant qu’il ne la trouvât enlaidie : l’ovale de son visage s’était empâté un peu, donnant une maturité plus chaude à sa beauté."
                                            },
                                            {
                                                "example_id": "a4d4b820-7777-4292-b922-e6892bd87902",
                                                "sense_id": "4fce0fd9-ce33-39cc-ac53-992084e7fb01",
                                                "text": "La Grande Sophie faisait profession d’être malade. Avait-elle fini par douter qu’elle le fût ? Il lui était si avantageux de le paraître qu’elle ne changeait rien à ses habitudes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fût",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f40c28f-c1e4-368f-9377-ba4ccf23a9dc",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Bois sur lequel est monté le canon d’un fusil, d’une arquebuse, d’un pistolet, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8fc1886-c3ec-3738-896c-2c4fa58317ba",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Partie en bois d'un objet."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4f6781c-66b0-45db-8050-0b5b8d326b15",
                                                "sense_id": "f8fc1886-c3ec-3738-896c-2c4fa58317ba",
                                                "text": "Le fût d’un rabot, d’une scie, d’une charrue."
                                            },
                                            {
                                                "example_id": "d3d9aba1-7802-4779-9c0c-fe9b530f7eac",
                                                "sense_id": "f8fc1886-c3ec-3738-896c-2c4fa58317ba",
                                                "text": "Le fût d’une raquette, d’un archet de violon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "732e828a-d8ec-393c-a721-8a131282d2fc",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Partie du tronc d’un arbre comprise entre le sol et les premiers rameaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e14af1e2-0da8-4fc9-9cea-cf6e656d7699",
                                                "sense_id": "732e828a-d8ec-393c-a721-8a131282d2fc",
                                                "text": "On traverse fréquemment des régions incendiées où les fûts carbonisés portent encore, comme de grosses houppes de tabac, leur ancien feuillage."
                                            },
                                            {
                                                "example_id": "197e6ab5-7ab6-44c9-a1cf-200a57edf2cc",
                                                "sense_id": "732e828a-d8ec-393c-a721-8a131282d2fc",
                                                "text": "La qualification correspond à la formation de la bille de pied recherchée, un fût net de nœuds, et précède la phase d’expansion durant laquelle le forestier favorise le développement des houppiers des tiges sélectionnées (arbres objectif)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "132bb3d4-3638-37b6-88f8-94f32d2be994",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Tige de la colonne, partie qui est entre la base et le chapiteau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfe8e370-7bbd-4fbb-aaba-745ac0cb74e4",
                                                "sense_id": "132bb3d4-3638-37b6-88f8-94f32d2be994",
                                                "text": "Les fonts de Bertoncourt, près de Rethel, sont postérieurs à ceux dont nous venons de parler; […]. La cuve, octogone, repose sur un fût cylindrique dont la base est ornée d'un tore aplati, avec fleurs de lis aux angles."
                                            },
                                            {
                                                "example_id": "e5fbf79d-84bf-4f96-8fe5-1bea3ab9d14a",
                                                "sense_id": "132bb3d4-3638-37b6-88f8-94f32d2be994",
                                                "text": "Le fût de la colonne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27e08d5b-49d2-39bd-be4b-5253d5ab9017",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Colonne d’un candélabre ou d'un bougeoir."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84785e0e-02fa-4423-a08c-82d0a39cc1a5",
                                                "sense_id": "27e08d5b-49d2-39bd-be4b-5253d5ab9017",
                                                "text": "Paire de flambeaux portant une coquille sur le binet, un ornement rocaille sur le fût, et des canaux tournants sur la cloche."
                                            },
                                            {
                                                "example_id": "3f5aab07-5262-4d20-8b7a-c5b617fb9486",
                                                "sense_id": "27e08d5b-49d2-39bd-be4b-5253d5ab9017",
                                                "text": "Ensemble de signaux mécaniques unifiés. Avertissement sur fût raccourci, signal surélevé présentant le Carré et le Rappel de Ralentissement 30. L’ensemble est à commande funiculaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8923815a-78c1-3e85-a4b0-8d601a69ff15",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Trait vertical principal d’un caractère, aussi appelé hampe, haste ou montant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dee5585-bfe9-4f35-b9aa-c79d84d5b231",
                                                "sense_id": "8923815a-78c1-3e85-a4b0-8d601a69ff15",
                                                "text": "Le fût du T, du L"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55697c00-3778-3e29-bf75-0f63b55c033c",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Tonneau où l’on met le vin ou un autre liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57c74363-bbe4-4a9b-8c9a-c1d9206360e9",
                                                "sense_id": "55697c00-3778-3e29-bf75-0f63b55c033c",
                                                "text": "On utilise sans vergogne l’arrière-pays, du moins sa partie non protégée, non mise en réserve pour accueillir des décharges intempestives, les fûts toxiques, les activités polluantes et les ayatollahs de l'écologie."
                                            },
                                            {
                                                "example_id": "8e060e05-4649-4bdb-95d3-5589c0cd932e",
                                                "sense_id": "55697c00-3778-3e29-bf75-0f63b55c033c",
                                                "text": "Trois fûts de cent litres d’essence avaient été renversés dans le faux-pont."
                                            },
                                            {
                                                "example_id": "f81d8bcf-f44c-46fb-928a-c36e84477947",
                                                "sense_id": "55697c00-3778-3e29-bf75-0f63b55c033c",
                                                "text": "Comme le veut la tradition, le maire de Munich, Dieter Reiter, a donné le coup d’envoi des festivités en perçant à coup de marteau le premier fût de bière."
                                            },
                                            {
                                                "example_id": "b9a7ae66-cf57-437e-a903-e02eaf56b42d",
                                                "sense_id": "55697c00-3778-3e29-bf75-0f63b55c033c",
                                                "text": "Double fût : Fût renfermé dans un autre qui est ordinairement en bois plus léger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cc47c64-bfd7-3180-8c73-eabf66de1eef",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Partie de la queue faisant office de manche."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4eb3da74-9f2b-317e-b712-facf2aa36eb5",
                                        "entry_id": "3bddcfde-0c5b-3918-8fc7-a924bc732ed3",
                                        "glosses": [
                                            "Partie généralement cylindrique d'un tambour sur laquelle une ou deux peaux sont tendues"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
