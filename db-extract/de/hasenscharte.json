                    {
                        "translation_id": "3d8d1b6e-fa51-47e1-acc7-e26da7df6a55",
                        "source_entry_id": "20f949c6-0743-3907-b2ff-cfbc1d2e1657",
                        "source_sense_id": "c86af99d-e538-3ba2-ab6a-1af6798ef509",
                        "source_sense_description": "teilweise abwertend: angeborene Fehlbildung der Oberlippe, Lippenspalte",
                        "target_lang_word": "bec-de-lièvre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bec-de-lièvre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec16bbcf-70db-31d5-8e5e-63243f1c6810",
                                        "entry_id": "cac639c8-6f6b-3f01-bf49-eda52c69532e",
                                        "glosses": [
                                            "Difformité congénitale qui consiste à avoir la lèvre supérieure fendue, avec parfois prolongation jusqu’au palais. Fente labio-palatine."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3764d3c-3e72-487b-ad4c-eb1472248659",
                                                "sense_id": "ec16bbcf-70db-31d5-8e5e-63243f1c6810",
                                                "text": "Avoir un bec-de-lièvre."
                                            },
                                            {
                                                "example_id": "36e26b24-9576-48b0-9159-d78115c48c7d",
                                                "sense_id": "ec16bbcf-70db-31d5-8e5e-63243f1c6810",
                                                "text": "Son bec-de-lièvre salivait, sans qu’une goutte de sueur mouillât sa peau dure."
                                            },
                                            {
                                                "example_id": "f0061713-108b-4107-a8bc-07686f0935bd",
                                                "sense_id": "ec16bbcf-70db-31d5-8e5e-63243f1c6810",
                                                "text": "Elle fait la comparaison avec l’opération correctrice d’un bec-de-lièvre ou de doigts fusionnés, acceptée socialement."
                                            },
                                            {
                                                "example_id": "7540504a-1abd-463e-a43b-e4e096fa8275",
                                                "sense_id": "ec16bbcf-70db-31d5-8e5e-63243f1c6810",
                                                "text": "Naît-on pied-bot, hydrocéphale, avec un bec-de-lièvre, une arthrogrypose, des mains syndactyles, une scoliose ou des jambes arquées ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8be51b76-29e6-3682-b080-621b8858a97a",
                                        "entry_id": "cac639c8-6f6b-3f01-bf49-eda52c69532e",
                                        "glosses": [
                                            "Personne affligée de cette difformité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c86c457c-e8da-4f00-98e3-5c8a67f855d1",
                                                "sense_id": "8be51b76-29e6-3682-b080-621b8858a97a",
                                                "text": "Nous connaissons sur le pont de Stamboul toutes les échoppes, tous les passants, même tous les mendiants, la collection complète des estropiés, aveugles, manchots, becs-de-lièvre et culs-de-jatte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
