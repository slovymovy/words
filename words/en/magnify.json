{
    "word_family": [
        "magnification",
        "magnifier",
        "magnificence",
        "magnificent",
        "magnitude"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36bf266f-d448-356a-8fd6-b0a1ca3cb7d7",
                    "sense_definition": "To make something appear larger than it actually is by using a lens or a microscope.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "enlarge_view",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist used a powerful microscope to <w>magnify</w> the tiny bacteria for better observation.",
                            "target_lang_translations": {
                                "ru": "Ученый использовал мощный микроскоп, чтобы <w>увеличить</w> крошечные бактерии для лучшего наблюдения."
                            }
                        },
                        {
                            "text": "You can use a <w>magnifying</w> glass to see the intricate details on the surface of the stamp.",
                            "target_lang_translations": {
                                "ru": "Вы можете использовать <w>увеличительное</w> стекло, чтобы рассмотреть сложные детали на поверхности марки."
                            }
                        }
                    ],
                    "synonyms": [
                        "enlarge",
                        "zoom in"
                    ],
                    "antonyms": [
                        "minify",
                        "shrink"
                    ],
                    "common_phrases": [
                        "magnifying glass",
                        "magnify the image",
                        "magnify the object"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо визуально крупнее, чем оно есть на самом деле, с помощью линзы или микроскопа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увеличивать",
                                "target_lang_sense_clarification": "делать изображение больше"
                            },
                            {
                                "target_lang_word": "укрупнять",
                                "target_lang_sense_clarification": "делать более крупным для рассмотрения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a5bf2d0-8d7b-32bb-ae04-8199dbe19b23",
                    "sense_definition": "To make a problem, feeling, or situation seem more important or intense than it really is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The silence in the empty house seemed to <w>magnify</w> her feelings of loneliness and despair.",
                            "target_lang_translations": {
                                "ru": "Тишина в пустом доме, казалось, <w>усиливала</w> её чувство одиночества и отчаяния."
                            }
                        },
                        {
                            "text": "Social media can often <w>magnify</w> the problem by spreading rumors much faster than the truth.",
                            "target_lang_translations": {
                                "ru": "Социальные сети часто могут <w>раздуть</w> проблему, распространяя слухи гораздо быстрее, чем правду."
                            }
                        }
                    ],
                    "synonyms": [
                        "exaggerate",
                        "intensify",
                        "amplify",
                        "heighten"
                    ],
                    "antonyms": [
                        "downplay",
                        "understate",
                        "minimize"
                    ],
                    "common_phrases": [
                        "magnify the problem",
                        "magnify the effect",
                        "magnify the importance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представлять проблему, чувство или ситуацию более важными или интенсивными, чем они есть на самом деле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преувеличивать",
                                "target_lang_sense_clarification": "придавать излишнее значение"
                            },
                            {
                                "target_lang_word": "усиливать",
                                "target_lang_sense_clarification": "делать чувство или эффект мощнее"
                            },
                            {
                                "target_lang_word": "раздувать",
                                "target_lang_sense_clarification": "делать проблему масштабнее (перен.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb4760d3-efc0-3aa8-8949-048ba1ce2950",
                    "sense_definition": "To praise or glorify someone or something, especially in a religious context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The congregation gathered together in the cathedral to <w>magnify</w> the Lord through hymns and prayers.",
                            "target_lang_translations": {
                                "ru": "Прихожане собрались в соборе, чтобы <w>величать</w> Господа в гимнах и молитвах."
                            }
                        },
                        {
                            "text": "Ancient texts often contain verses that <w>magnify</w> the deeds of great kings and deities.",
                            "target_lang_translations": {
                                "ru": "Древние тексты часто содержат стихи, которые <w>превозносят</w> деяния великих царей и божеств."
                            }
                        }
                    ],
                    "synonyms": [
                        "glorify",
                        "exalt",
                        "extol",
                        "praise"
                    ],
                    "antonyms": [
                        "belittle",
                        "debase"
                    ],
                    "common_phrases": [
                        "magnify the Lord",
                        "magnify his name"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in religious or formal literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восхвалять или прославлять кого-либо или что-либо, особенно в религиозном контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "величать",
                                "target_lang_sense_clarification": "торжественно прославлять"
                            },
                            {
                                "target_lang_word": "превозносить",
                                "target_lang_sense_clarification": "высоко оценивать, славить"
                            },
                            {
                                "target_lang_word": "восхвалять",
                                "target_lang_sense_clarification": "говорить с похвалой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ee8f07a-e268-367f-94fa-cef3ed369119",
                    "sense_definition": "To have an effect or to be of significance or importance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "significance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small errors in the calculation did not <w>magnify</w> much in the final outcome of the project.",
                            "target_lang_translations": {
                                "ru": "Небольшие ошибки в расчетах не <w>имели</w> большого <w>значения</w> для конечного результата проекта."
                            }
                        },
                        {
                            "text": "His opinion used to <w>magnify</w> greatly with the board, but now they rarely listen to him.",
                            "target_lang_translations": {
                                "ru": "Его мнение раньше <w>играло большую роль</w> для совета директоров, но теперь они редко к нему прислушиваются."
                            }
                        }
                    ],
                    "synonyms": [
                        "matter",
                        "count"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This intransitive usage is no longer common in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь эффект или обладать значимостью или важностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иметь значение",
                                "target_lang_sense_clarification": "быть важным"
                            },
                            {
                                "target_lang_word": "играть роль",
                                "target_lang_sense_clarification": "влиять на результат"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}