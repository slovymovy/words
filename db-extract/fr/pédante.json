                    {
                        "sense_id": "dd9ef14f-5381-3e71-aeb7-2e74681eb9ec",
                        "entry_id": "457d3962-6868-3544-894d-c032a2c1e5bf",
                        "glosses": [
                            "Femme pédante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf906a59-71a2-410b-b932-4d56adcf19db",
                                "sense_id": "dd9ef14f-5381-3e71-aeb7-2e74681eb9ec",
                                "text": "Lorenzo.– Je lui demanderai, si vous voulez, mais je vous avertis que c’est une pédante ; elle parle latin.\nLe Duc.– Bon ! elle ne fait pas l’amour en latin."
                            },
                            {
                                "example_id": "6a887488-cd76-44af-b1b5-f8149b1e340c",
                                "sense_id": "dd9ef14f-5381-3e71-aeb7-2e74681eb9ec",
                                "text": "Cette pédante n’a jamais fait que comprimer notre initiative et, si nous devons vous être utile, c’est à la condition de l’inviter poliment à passer son chemin et à s’englutiner dans ses abstractions et ses rêveries."
                            }
                        ]
                    }
