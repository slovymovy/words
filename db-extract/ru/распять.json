                "translations": [
                    {
                        "translation_id": "4a981919-62cb-4755-8398-fc9ebe34734d",
                        "source_entry_id": "8bdc4507-fe02-3ab9-9a44-732b282ffe3a",
                        "target_lang_word": "crucify",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crucify",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "372a8963-a93d-31c5-b284-f8242d83cb7d",
                                        "entry_id": "c5749edf-2755-3381-8087-cb86a083563c",
                                        "glosses": [
                                            "To execute (a person) by nailing to a cross."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cda8fa6a-8c27-3136-95de-1778f9ca5ddb",
                                        "entry_id": "c5749edf-2755-3381-8087-cb86a083563c",
                                        "glosses": [
                                            "To punish or otherwise express extreme anger at, especially as a scapegoat or target of outrage."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f18d95f-141e-4468-9af1-19cf08444fb0",
                                                "sense_id": "cda8fa6a-8c27-3136-95de-1778f9ca5ddb",
                                                "text": "After his public gaffe, he was crucified in the media."
                                            },
                                            {
                                                "example_id": "6a97aac6-075c-46e9-ac24-5ef438161e9d",
                                                "sense_id": "cda8fa6a-8c27-3136-95de-1778f9ca5ddb",
                                                "text": "Having behind us the commercial interests and the laboring interests and all the toiling masses, we shall answer their demands for a gold standard by saying to them, you shall not press down upon the brow of labor this crown of thorns. You shall not crucify mankind upon a cross of gold."
                                            },
                                            {
                                                "example_id": "98a49d92-a481-4ccd-a9f6-dd81cef46969",
                                                "sense_id": "cda8fa6a-8c27-3136-95de-1778f9ca5ddb",
                                                "text": "I crucify myself, nothing I do is good enough for you / I crucify myself every day"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4080f236-44dc-35be-941c-906e244b13c4",
                                        "entry_id": "c5749edf-2755-3381-8087-cb86a083563c",
                                        "glosses": [
                                            "To thoroughly beat at a sport or game."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33419078-9799-4c15-ab40-97191d38c356",
                                                "sense_id": "4080f236-44dc-35be-941c-906e244b13c4",
                                                "text": "West Ham beat Manchester City five nil–they crucified them!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2081a40a-dd9f-4a09-ac7c-387e64f78ee4",
                        "source_entry_id": "8bdc4507-fe02-3ab9-9a44-732b282ffe3a",
                        "target_lang_word": "crucifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crucifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fef3e25a-8e13-3ff8-99f0-dab711cf8170",
                                        "entry_id": "a6138492-d223-35b8-ba84-46e253dc4c6f",
                                        "glosses": [
                                            "Mettre en croix pour faire mourir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48d0a56c-cfdf-47d7-8287-be2d848181e7",
                                                "sense_id": "fef3e25a-8e13-3ff8-99f0-dab711cf8170",
                                                "text": "Les Romains crucifièrent Jésus."
                                            },
                                            {
                                                "example_id": "e6da2a51-faab-4e05-b3c1-00a3a9667960",
                                                "sense_id": "fef3e25a-8e13-3ff8-99f0-dab711cf8170",
                                                "text": "J'entre parfois avec étonnement, comme un étranger chez ce peuple qui cruciﬁe Dieu au-dessus des miroirs de sa salle à manger et dans le fond de son lit."
                                            },
                                            {
                                                "example_id": "fd20b506-60c0-4516-8916-67f1b6ed6ec9",
                                                "sense_id": "fef3e25a-8e13-3ff8-99f0-dab711cf8170",
                                                "text": "Dans les prochaines semaines, a rappelé Martin Schulz, un autre jeune Ali Mohammed Al-Nimr, condamné à mort pour avoir participé à une manifestation contre le régime [saoudien] alors qu'il avait 17 ans, doit être crucifié. Oui, crucifié."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "debdb966-0ba2-3974-887c-00b58234dd45",
                                        "entry_id": "a6138492-d223-35b8-ba84-46e253dc4c6f",
                                        "glosses": [
                                            "Imposer des actes de mortification en vue de se purifier de ses péchés."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e06a773f-acf5-448d-b469-ee22918dcd20",
                                                "sense_id": "debdb966-0ba2-3974-887c-00b58234dd45",
                                                "text": "Crucifier sa chair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18b17911-68ce-397f-8776-ae2cb722d613",
                                        "entry_id": "a6138492-d223-35b8-ba84-46e253dc4c6f",
                                        "glosses": [
                                            "Vouer aux gémonies, chercher à démolir publiquement."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f480d68a-8b24-4a54-9c0b-a6b9ccd20180",
                                                "sense_id": "18b17911-68ce-397f-8776-ae2cb722d613",
                                                "text": "Aujourd'hui, nous sommes dans une période où les risques sont énormes parce qu'il y a des sujets qui sont devenus très sensibles, pour ne pas dire tabous : il y a de plus en plus de sujets qu'on ne peut plus aborder sans se faire crucifier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dfe54a4-9448-3126-a08d-44c0ed894910",
                                        "entry_id": "a6138492-d223-35b8-ba84-46e253dc4c6f",
                                        "glosses": [
                                            "Tirer de telle manière que le gardien de but ne peut réagir pour arrêter le ballon et empêcher le but."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9114f049-81f6-46ac-b5bf-eea2979a5689",
                                                "sense_id": "1dfe54a4-9448-3126-a08d-44c0ed894910",
                                                "text": "Plein de sang-froid, il a crucifié Leno pour permettre aux siens de prendre l'avantage dans ce match (2-1, 34e)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
