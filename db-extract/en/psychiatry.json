                    {
                        "translation_id": "cf654aa2-d9a0-400f-a693-58fe7372d9e6",
                        "source_entry_id": "46641114-9a52-32f8-b635-9d35df3e1e0a",
                        "source_sense_id": "2f48fd41-acd4-334f-90f8-5b89d18b9fc3",
