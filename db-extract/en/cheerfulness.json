                                    {
                                        "sense_id": "5e27cc69-b09e-3782-861d-5fb2ebd87613",
                                        "entry_id": "c69f86ee-9764-323d-b93a-acd6835ca224",
                                        "glosses": [
                                            "pocit štěstí vyvolaný pozitivně vnímanou událostí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11491258-4d1e-4d5f-8dfa-c1100d8dab27",
                                                "sense_id": "5e27cc69-b09e-3782-861d-5fb2ebd87613",
                                                "text": "Jeho úspěch v mezinárodní soutěži nám všem udělal velkou radost."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35ae3792-7253-45ed-8c1e-e9ffb0dbeb15",
                        "source_entry_id": "22992355-ca5c-36ce-8567-edbb80c94af2",
                        "source_sense_id": "86438433-9995-312b-a425-48f481e9554e",
                        "source_sense_description": "the state of being cheerful; joy",
                        "target_lang_word": "štěstí",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "štěstí",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "a9f70a8d-d8ea-3a86-abb2-6cc39163b052",
                                        "entry_id": "b0b50ab8-749b-34a0-abc2-119804d982ea",
                                        "glosses": [
                                            "duševní rozpoložení, hluboký vnitřní, celou bytost prostupující, pocit souznění se stávající životní situací; pocit uvědomované či neuvědomované vděčnosti za „dary osudu“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61b8fc0d-1356-4446-85c5-e27972a4ad2e",
                                                "sense_id": "a9f70a8d-d8ea-3a86-abb2-6cc39163b052",
                                                "text": "Do nového roku vám přejeme hodně štěstí."
                                            },
                                            {
                                                "example_id": "7aaa7cb2-0db3-4c5d-97c4-d6ad27d63c00",
                                                "sense_id": "a9f70a8d-d8ea-3a86-abb2-6cc39163b052",
                                                "text": "Když jsem ji uviděl, živou a zdravou, zaplavily mě pocity štěstí."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7adb57dd-056b-3899-beff-f37dba917aa6",
                                        "entry_id": "b0b50ab8-749b-34a0-abc2-119804d982ea",
                                        "glosses": [
                                            "situace, kdy je člověk bez svého vlastního přičinění vystaven či opakovaně vystavován pro něj příznivým okolnostem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73283ec4-3094-4416-95e9-b8a583a1b797",
                                                "sense_id": "7adb57dd-056b-3899-beff-f37dba917aa6",
                                                "text": "Měl jsem štěstí – ten kámen padající ze skály mě těsně minul."
                                            },
                                            {
                                                "example_id": "da835e8a-fe8a-4681-89c7-d00b7a407828",
                                                "sense_id": "7adb57dd-056b-3899-beff-f37dba917aa6",
                                                "text": "Všem, kteří s námi soutěží, přejeme hodně štěstí!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "štěstí",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "42497b2b-2d91-3ee6-b6ec-da39593e0d47",
