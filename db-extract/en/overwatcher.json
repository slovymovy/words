            {
                "entry_id": "d81fa21f-bf4b-3f2b-a5ce-db6763844443",
                "word": "Overwatcher",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a37b768b-9d3d-4a6e-a772-de1fc5f11b0d",
                        "entry_id": "d81fa21f-bf4b-3f2b-a5ce-db6763844443",
                        "tags": [
                            "plural"
                        ],
