                "senses": [
                    {
                        "sense_id": "6bfadf77-24c1-3ede-8acd-e2db3758c391",
                        "entry_id": "6a53d235-39e7-3d30-bfaf-cbed35ae3c8a",
                        "glosses": [
                            "podjęcie działalności gospodarczej przez osobę fizyczną na własny rachunek i odpowiedzialność"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63ec920b-9014-49d3-a5bc-73d737309460",
                                "sense_id": "6bfadf77-24c1-3ede-8acd-e2db3758c391",
                                "text": "Własna działalność gospodarcza nazywana bywa czasem „samozatrudnieniem”, chociaż polskie prawo nie zawiera definicji tego pojęcia. W praktyce mianem tym określa się jednoosobową działalność gospodarczą, jednoosobową firmę czy przedsiębiorstwo, przy czym osoba podejmująca tego rodzaju działalność czyni to na własny rachunek i ryzyko."
                            },
                            {
                                "example_id": "92d159e9-48d8-4f93-9db7-10abc832bc38",
                                "sense_id": "6bfadf77-24c1-3ede-8acd-e2db3758c391",
                                "text": "Samozatrudnienie jako dobry pomysł na swoje życie upatruje już 26,5 proc. ankietowanych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
