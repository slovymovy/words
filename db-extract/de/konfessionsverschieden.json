                "senses": [
                    {
                        "sense_id": "f5b4d820-48d9-3e0b-b023-612602318459",
                        "entry_id": "a2e5f53f-1fea-39bf-91cb-306b413b3833",
                        "glosses": [
                            "verschiedenen religiösen Bekenntnissen (Konfessionen) angehörend beziehungsweise zugeordnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93ea273f-d12d-4597-b896-66488408dfcb",
                                "sense_id": "f5b4d820-48d9-3e0b-b023-612602318459",
                                "text": "„Die Befugnis, zum Abschluss einer konfessionsverschiedenen Ehe die Erlaubnis zu erteilen, hat jeder Geistliche mit allgemeiner Traubefugnis […]“"
                            },
                            {
                                "example_id": "a96ce928-d584-4a0c-bf6a-3ba92b143e1d",
                                "sense_id": "f5b4d820-48d9-3e0b-b023-612602318459",
                                "text": "„Diese geistliche Basis ermöglicht auch gemeinsames Handeln der orthodoxen und evangelischen Kirche in Deutschland bei konfessionsverschiedenen Ehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
