                        ]
                    },
                    {
                        "translation_id": "9edfd7de-4289-4df1-8a5b-7fca3ac493c5",
                        "source_entry_id": "c1ca45b0-95db-33c0-a8b5-137e04b8071a",
                        "source_sense_id": "7b67f640-a8fa-3930-8dcb-cc07f2b41cd3",
                        "source_sense_description": "nicht integriertes Schloss, das einfache Verschlüsse mit einem festgestellten Bügel verschließt",
                        "target_lang_word": "cadenas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cadenas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "733cb32c-0d64-302c-b3dd-125c8e38931a",
                                        "entry_id": "4671eb50-a70c-3422-8519-1b841f25f854",
                                        "glosses": [
                                            "Serrure mobile qui sert à fermer une porte, une caisse, etc., au moyen d’un anneau passé soit dans un autre anneau, soit dans deux pitons."
                                        ],
                                        "tags": [
                                            "Serrurerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a94ed29-9055-4968-bcf0-c7a0eef32576",
                                                "sense_id": "733cb32c-0d64-302c-b3dd-125c8e38931a",
                                                "text": "Parmi les peuples européens , les premières serrures un peu artistement faites ne remontent guère en deçà du seizième siècle. C'est à cette époque que furent imaginés les cadenas à combinaison, qui ne peuvent être ouverts que quand on a la connaissance du mot sous lequel ils ont été établis."
                                            },
                                            {
                                                "example_id": "e96a9058-a1a8-4664-8348-59daca22b80d",
                                                "sense_id": "733cb32c-0d64-302c-b3dd-125c8e38931a",
                                                "text": "Une seconde porte apparut, fermée par un cadenas syllabique, du genre de ceux qui servent pour les coffres-forts. Herr Schultze forma le mot et ouvrit le lourd battant de fer, qui était intérieurement armé d’un appareil compliqué d’engins explosibles, que Marcel, sans doute par curiosité professionnelle, aurait bien voulu examiner. Mais son guide ne lui en laissa pas le temps."
                                            },
                                            {
                                                "example_id": "9f39c651-e499-4cec-8c4a-8130f763526c",
                                                "sense_id": "733cb32c-0d64-302c-b3dd-125c8e38931a",
                                                "text": "Le piqueur a la charge des explosifs qu'il transporte dans une boite fermée au cadenas dont le boutefeu seul a la clef."
                                            },
                                            {
                                                "example_id": "a962eb33-354d-42ab-9793-5576907ecffb",
                                                "sense_id": "733cb32c-0d64-302c-b3dd-125c8e38931a",
                                                "text": "Depuis trois jours, je suis aux prises avec un cadenas dont j'ai perdu la clef. Un cadenas de taille moyenne et de type courant, avec un corps cuivré et un anneau en acier."
                                            },
                                            {
                                                "example_id": "a72faa5d-7f55-4f25-affd-18a60c56ea87",
                                                "sense_id": "733cb32c-0d64-302c-b3dd-125c8e38931a",
                                                "text": "Le cadenas sur un plan symbolique cadenasse quelque chose de précieux que l'on a peur de perdre ! Ainsi va-t-on le retrouver dans de nombreuses traditions comme talisman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a891add-516e-3489-8e8e-232ca8331893",
                                        "entry_id": "4671eb50-a70c-3422-8519-1b841f25f854",
                                        "glosses": [
                                            "Coffret d'or où l'on mettait le couteau, la cuillère, etc. ^([2])"
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7b30f04-8ccb-4ab7-8fe0-a4856bbf44b7",
                                                "sense_id": "2a891add-516e-3489-8e8e-232ca8331893",
                                                "text": "Le couvert de l'empereur était placé à droite, celui de l'impératrice à gauche; la nef et le cadenas de l'empereur à droite de son couvert; la nef et le cadenas de l'impératrice, à la gauche de son couvert, sur la table même."
                                            },
                                            {
                                                "example_id": "9da600f8-cefc-4b10-9bc3-8fb784739ad7",
                                                "sense_id": "2a891add-516e-3489-8e8e-232ca8331893",
                                                "text": "Madame la duchesse de Villars est la duchesse nommée pour accompagner mademoiselle de Valois en Italie, et on dit qu'elle aura un cadenas à table comme la princesse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
