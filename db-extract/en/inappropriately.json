                        "cross_references": [
                            {
                                "target_word": "unangebracht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a97c7e4c-7721-31a1-96d2-d1bf1a43b50c",
                                        "entry_id": "14096811-4f80-328b-bea5-6edad40b4f7f",
                                        "glosses": [
                                            "in einem bestimmten Zusammenhang ungeeignet, unangemessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b4791fd-1f7b-4b23-bff7-b3cb4d0d5b78",
                                                "sense_id": "a97c7e4c-7721-31a1-96d2-d1bf1a43b50c",
                                                "text": "„Zwischen die positiven Kommentare ihrer Fans mischen sich auch immer wieder gemeine und unangebrachte Worte.“"
                                            },
                                            {
                                                "example_id": "9db939f3-a944-42a3-b234-bc19e6ff6ba5",
                                                "sense_id": "a97c7e4c-7721-31a1-96d2-d1bf1a43b50c",
                                                "text": "„Er habe ‚unangebrachte‘ Bemerkungen gemacht und eine Reihe von Kunden hätten sich beschwert.“"
                                            },
                                            {
                                                "example_id": "b4681f24-e585-4218-93d3-eb18ce563a78",
                                                "sense_id": "a97c7e4c-7721-31a1-96d2-d1bf1a43b50c",
                                                "text": "„In Kanada muss sich ein Bundesrichter vor Gericht für unangebrachte Äußerungen gegenüber einem Vergewaltigungsopfer verantworten.“"
                                            },
                                            {
                                                "example_id": "1c164482-4fd3-4e97-a3c8-a0bb6cd2aeba",
                                                "sense_id": "a97c7e4c-7721-31a1-96d2-d1bf1a43b50c",
                                                "text": "„Anlass war, dass nach einem vermeintlich ‚unangebrachten Verhalten‘ von Jugendlichen in der Metrostation vergangene Woche ein Schild angebracht worden war mit der Aufforderung, sich ‚der moralischen Ordnung nach angemessen zu verhalten‘.“"
                                            },
                                            {
                                                "example_id": "25827024-7727-48fd-b97b-d0ab80449501",
                                                "sense_id": "a97c7e4c-7721-31a1-96d2-d1bf1a43b50c",
                                                "text": "„Im Halle-Prozess sorgt der Angeklagte oft für Fassungslosigkeit bei Beteiligten und Beobachtern, weil er an den unangebrachtesten Stellen lacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
