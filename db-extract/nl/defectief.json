                "senses": [
                    {
                        "sense_id": "60b3cbb8-ada3-32d9-b068-f412e139da2b",
                        "entry_id": "ae7356ba-0c20-31fe-b058-d6cfb6987478",
                        "glosses": [
                            "van iets dat het gebreken vertoont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e0205ca-361a-42f1-a24a-df649c1f8a52",
                                "sense_id": "60b3cbb8-ada3-32d9-b068-f412e139da2b",
                                "text": "„De bereidheid tot het opbrengen van financiële solidariteit legt het af tegen de prikkels om zoveel mogelijk nut uit de overheidsregelingen te halen,” zo werd gemeld. „Om het hoofd te bieden aan de verslechterende moraal van de calculerende burger zouden de socialeverzekeringsregelingen zodanig moeten worden ingericht dat zij niet uitlokken tot defectief maar tot gewenst gedrag”, aldus de nota."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe013114-af13-46c4-a15c-f1f8ac8107b6",
                        "source_entry_id": "ae7356ba-0c20-31fe-b058-d6cfb6987478",
                        "source_sense_id": "60b3cbb8-ada3-32d9-b068-f412e139da2b",
                        "source_sense_description": "van iets dat het gebreken vertoont",
                        "target_lang_word": "defective",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
