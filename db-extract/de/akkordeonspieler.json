                ],
                "senses": [
                    {
                        "sense_id": "f4f46442-078e-3cdd-be48-abc116d9a8dd",
                        "entry_id": "d2abb5e2-b05b-3706-920c-e96232c745c7",
                        "glosses": [
                            "(männliche) Person, die Akkordeon spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2d8df00-af29-4eb8-8152-14ea17e47988",
                                "sense_id": "f4f46442-078e-3cdd-be48-abc116d9a8dd",
                                "text": "Aus einem Aufenthalt in Rio de Janeiro entstand 1987 das Album Let’s Vamos (Sonet) mit dem brasilianischen Akkordeonspieler Sivuca."
                            },
                            {
                                "example_id": "982f9662-b6c2-4cfd-a99c-194aee1d0376",
                                "sense_id": "f4f46442-078e-3cdd-be48-abc116d9a8dd",
                                "text": "„Mit Chris Strachwitz vom Label Arhoolie und dem Filmemacher Les Blank flog er nach San Antonio und traf den Akkordeonspieler Flaco Jiménez, eine Freundschaft entstand.“"
                            },
                            {
                                "example_id": "cd5968b8-f111-464c-bf84-0da10eaefb20",
                                "sense_id": "f4f46442-078e-3cdd-be48-abc116d9a8dd",
                                "text": "„Für die rund 250 Abgesandten aus der ganzen Deutschschweiz, die 103 Vereine und etwa 1900 Akkordeonspieler vertreten, müssen die Räumlichkeiten zur Verfügung gestellt und das Mittagessen organisiert werden. Ein Konzert dürfen die Kreuzlinger Akkordeonspieler im Dreispitz-Saal auch noch geben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa3831f4-3bc6-45f5-b75f-f7517b547ae1",
                        "source_entry_id": "d2abb5e2-b05b-3706-920c-e96232c745c7",
                        "source_sense_id": "f4f46442-078e-3cdd-be48-abc116d9a8dd",
                        "source_sense_description": "(männliche) Person, die Akkordeon spielt",
                        "target_lang_word": "accordionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accordionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc48c0f9-b1fd-3904-a873-b67f81fbcfda",
                                        "entry_id": "4fd3dbf6-d051-3a19-b82b-c6f26a0a488f",
                                        "glosses": [
                                            "Someone who plays the accordion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cb4685d-9dc4-41b7-8ce2-dfb8b3ada565",
                        "source_entry_id": "d2abb5e2-b05b-3706-920c-e96232c745c7",
                        "source_sense_id": "f4f46442-078e-3cdd-be48-abc116d9a8dd",
                        "source_sense_description": "(männliche) Person, die Akkordeon spielt",
                        "target_lang_word": "accordéoniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accordéoniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "beb384d1-b7ed-3185-b5e7-85d2472e9507",
                                        "entry_id": "d901d603-a461-30b1-86d9-83a2e0319ed0",
                                        "glosses": [
                                            "Personne jouant de l’accordéon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a3cf879-b2fb-4f46-b6a5-e701c1a1772b",
                                                "sense_id": "beb384d1-b7ed-3185-b5e7-85d2472e9507",
                                                "text": "Il y avait, paraît-il, rue des Martyrs à Montmartre, un accordéoniste d’origine roumaine, qui jouait à merveille des tangos argentins et des valses musette, dans un cabaret à la mode, fréquenté par des artistes."
                                            },
                                            {
                                                "example_id": "d72d04fe-1a6a-453d-a8e6-dc52cd9a9fa9",
                                                "sense_id": "beb384d1-b7ed-3185-b5e7-85d2472e9507",
                                                "text": "Dans le cadre des animations d’été à l’Ehpad Saint-Vincent Lannouchen, mercredi, l’heure était à la musique, et on peut dire qu’il était difficile de résister à l’énergie et au tonus communicatifs de l’accordéoniste Jean-Luc Prat, venu de Trégastel (22), pour animer l’après-midi en chansons."
                                            },
                                            {
                                                "example_id": "1073ddc1-5fa0-45c4-aed8-a710db95446b",
                                                "sense_id": "beb384d1-b7ed-3185-b5e7-85d2472e9507",
                                                "text": "Le concert sur la plage des Nonnes samedi 2 septembre de la trompettiste Lucienne Renaudin Vary et de l’accordéoniste Félicien Brut, devrait prolonger en douceur l’été michelais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
