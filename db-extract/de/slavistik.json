                "senses": [
                    {
                        "sense_id": "1d8acf12-981f-3fd6-a07b-919d3f693ffa",
                        "entry_id": "dd150b5e-6c4e-3e85-986e-ff89e481468c",
                        "glosses": [
                            "alternative form of Slawistik"
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
