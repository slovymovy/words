                "senses": [
                    {
                        "sense_id": "b5779b91-005c-3856-a802-489404a5890b",
                        "entry_id": "eb192428-6309-3bee-8a5f-696edccb3104",
                        "glosses": [
                            "Débarrasser de la vermine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ddf2550-fe2e-4a81-b03a-f13b151c79f7",
                                "sense_id": "b5779b91-005c-3856-a802-489404a5890b",
                                "text": "Pour ces raisons et vu la nécessité de déverminiser rapidement un grand nombre d’hommes, j’ai cherché un procédé d’application facile sur le front."
                            },
                            {
                                "example_id": "0e060612-6d96-46ce-8bbe-1c468c13dbfa",
                                "sense_id": "b5779b91-005c-3856-a802-489404a5890b",
                                "text": "Un système de crochets et de cordes est aménagé à la partie inférieure du couvercle et sur la paroi interne du tonneau pour y déposer les objets à stériliser ou à déverminiser ; on bouche les interstices avec de la glaise, du feutre mouillé ou des chiffons mouillés."
                            }
                        ]
                    }
