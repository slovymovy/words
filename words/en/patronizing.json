{
    "word_family": [
        "patron",
        "patronage",
        "patronize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "803dbc26-2fb9-39c4-8cbf-1ecf1b83b492",
                    "sense_definition": "Showing an offensively superior attitude toward others, as if they are less intelligent or capable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a <w>patronizing</w> smile when I asked a simple question about the software.",
                            "target_lang_translations": {
                                "zh": "当我问了一个关于软件的简单问题时，他露出了<w>居高临下</w>的微笑。"
                            }
                        },
                        {
                            "text": "It is <w>patronizing</w> to speak to adults as if they were small children.",
                            "target_lang_translations": {
                                "zh": "像对待小孩一样跟成年人说话是非常<w>屈尊俯就</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "condescending"
                    ],
                    "common_phrases": [
                        "patronizing tone",
                        "patronizing attitude"
                    ],
                    "target_lang_definitions": {
                        "zh": "表现出一种令人反感的优越感，仿佛对方不如自己聪明或有能力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "屈尊俯就的",
                                "target_lang_sense_clarification": "形容态度傲慢，自认为高人一等。"
                            },
                            {
                                "target_lang_word": "居高临下的",
                                "target_lang_sense_clarification": "形容说话或做事时带有俯视他人的傲慢感。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e2865ee-9921-38ab-bfb0-494b1465c029",
                    "sense_definition": "Present participle and gerund of <w>patronize</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>patronizing</w> her employees by explaining basic tasks they had mastered years ago.",
                            "target_lang_translations": {
                                "zh": "她向员工解释他们多年前就已经掌握的基本任务，这简直是在<w>居高临下地对待</w>他们。"
                            }
                        },
                        {
                            "text": "The constant <w>patronizing</w> of the local staff made the new manager very unpopular.",
                            "target_lang_translations": {
                                "zh": "新经理总是<w>以屈尊俯就的态度对待</w>当地员工，这让他非常不受欢迎。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is the present participle and gerund form of the verb."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 patronize 的现在分词或动名词形式，指以傲慢的态度对待他人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "以屈尊俯就的态度对待",
                                "target_lang_sense_clarification": "指通过言行表现出对他人的轻视。"
                            },
                            {
                                "target_lang_word": "居高临下地对待",
                                "target_lang_sense_clarification": "指在互动中表现出优越感。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}