                ],
                "senses": [
                    {
                        "sense_id": "e236fa5a-93c6-38b3-ab5b-7efded1864e1",
                        "entry_id": "8001d64d-18d5-3a9c-a755-0fa2e6e108bb",
                        "glosses": [
                            "Einstellung/Gefühl des Bedauerns"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd595078-a1ca-4023-8732-7d874e56d029",
                                "sense_id": "e236fa5a-93c6-38b3-ab5b-7efded1864e1",
                                "text": "Zu meinem großen Leidwesen ist die Sache ziemlich misslungen."
                            },
                            {
                                "example_id": "1964f81b-77f6-4575-a6f4-1c6a6677d043",
                                "sense_id": "e236fa5a-93c6-38b3-ab5b-7efded1864e1",
                                "text": "„Das taten sie zu meinem Leidwesen sehr lange, weil Mama in weiser Voraussicht Schuhe immer gleich zwei Nummern größer kaufte.“"
                            },
                            {
                                "example_id": "12177467-1c8d-4647-8f42-cb350558235e",
                                "sense_id": "e236fa5a-93c6-38b3-ab5b-7efded1864e1",
                                "text": "„Zum Leidwesen der beiden Zimmerleute lassen sich die Diebe die ganze Woche nicht blicken.“"
                            },
                            {
                                "example_id": "55acf2ea-418d-4f62-944f-6073a0b02b44",
                                "sense_id": "e236fa5a-93c6-38b3-ab5b-7efded1864e1",
                                "text": "„Ihrem Schüler erzählte sie weinend von einem kaiserlichen Offizier, der sie geheiratet hätte, wenn er zu ihrem Leidwesen nicht im Krieg gefallen wäre.“"
                            },
                            {
                                "example_id": "7da2a5b8-8a44-4369-bb54-c04cf1ab5e32",
                                "sense_id": "e236fa5a-93c6-38b3-ab5b-7efded1864e1",
                                "text": "„Aber sie konnte – zu ihrem Leidwesen – zunächst nichts Verdächtiges entdecken.“"
                            },
                            {
                                "example_id": "f76d61a8-a0b9-49ef-aedb-b7dcae4598e9",
                                "sense_id": "e236fa5a-93c6-38b3-ab5b-7efded1864e1",
                                "text": "„Der lustige Irländer wurde in seinen Familienbekenntnissen zum Leidwesen der Männer von Opelousas, wie es schien, durch zwei Milizen unterbrochen, die Gewehr in Arm nun von dem Wachthause ankamen, um ihn mit seinen zwei Gefährten in Empfang zu nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
