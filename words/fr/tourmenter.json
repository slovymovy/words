                {
                    "sense_id": "747e287d-616d-33f9-9b83-c58a7c55b18d",
                    "sense_definition": "Importuner, harceler ou agacer sans cesse par des demandes ou des reproches.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "harcèlement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants ne cessent de <w>tourmenter</w> leur camarade avec des plaisanteries cruelles.",
                            "target_lang_translations": {
                                "en": "The children never stop <w>tormenting</w> their classmate with cruel jokes.",
                                "ru": "Дети не перестают <w>донимать</w> своего одноклассника жестокими шутками.",
                                "de": "Die Kinder hören nicht auf, ihren Klassenkameraden mit grausamen Scherzen zu <w>piesacken</w>.",
                                "es": "Los niños no dejan de <w>acosar</w> a su compañero de clase con bromas crueles.",
                                "zh": "孩子们不停地用残忍的玩笑<w>骚扰</w>同学。"
                            }
                        },
                        {
                            "text": "Je vous demande de cesser de <w>tourmenter</w> ce témoin avec vos questions insistantes.",
                            "target_lang_translations": {
                                "en": "I ask you to stop <w>pestering</w> this witness with your persistent questions.",
                                "ru": "Прошу вас прекратить <w>донимать</w> этого свидетеля своими настойчивыми вопросами.",
                                "de": "Ich bitte Sie, damit aufzuhören, diesen Zeugen mit Ihren beharrlichen Fragen zu <w>belästigen</w>.",
                                "es": "Le pido que deje de <w>importunar</w> a este testigo con sus preguntas insistentes.",
                                "zh": "我请您不要再用这些步步紧逼的问题<w>纠缠</w>这位证人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "harceler"
                    ],
                    "target_lang_definitions": {
                        "en": "To pester or harass someone constantly with demands or reproaches.",
                        "ru": "Постоянно донимать кого-либо просьбами или упрёками.",
                        "de": "Jemanden ständig mit Bitten, Vorwürfen oder Forderungen bedrängen und ärgern.",
                        "es": "Importunar o acosar a alguien sin cesar con peticiones o reproches.",
                        "zh": "不断地用请求或指责纠缠、烦扰某人。"
                    },
                    "translations": {
