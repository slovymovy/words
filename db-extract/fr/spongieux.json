                    },
                    {
                        "translation_id": "4f1dc661-e139-4587-b7a1-3c5a6facf4f7",
                        "source_entry_id": "7bae724c-a9f3-35e4-b185-1793c72c36be",
                        "target_lang_word": "schwammig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schwammig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2de7bbe9-78d9-3604-b29a-6d461c6c292f",
                                        "entry_id": "cd32afcd-be4d-3aa1-922e-2d4c5f6de593",
                                        "glosses": [
                                            "sehr unkonkret und im Grenzbereich individuell auszulegen; vielseitig interpretierbar (im negativen Sinne)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4efabb7c-5418-4862-9dd0-427ed0928063",
                                                "sense_id": "2de7bbe9-78d9-3604-b29a-6d461c6c292f",
                                                "text": "Er drückt sich leider ziemlich schwammig aus, deshalb konnte ihm auch später nie ein konkreter Vorwurf gemacht werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d059ad75-75b1-360a-b7b7-c5ff05eec4e0",
                                        "entry_id": "cd32afcd-be4d-3aa1-922e-2d4c5f6de593",
                                        "glosses": [
                                            "die Konsistenz eines Schwammes habend; wie ein Schwamm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9940bf7-7947-4258-8977-c15d5805007f",
                                                "sense_id": "d059ad75-75b1-360a-b7b7-c5ff05eec4e0",
                                                "text": "Das in Kräuteressig eingelegte Rührei hatte den Eigengeschmack verloren und die Konsistenz war unangenehm schwammig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0b5ee5b-747f-462a-9eaf-81c08850030d",
                        "source_entry_id": "7bae724c-a9f3-35e4-b185-1793c72c36be",
                        "target_lang_word": "schwammartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schwammartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62318521-a139-338b-a15c-f3736d900851",
                                        "entry_id": "30bdb92c-4848-3236-bcce-52c6507205d4",
                                        "glosses": [
                                            "einem Schwamm ähnelnd, an einen Schwamm erinnernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa10073d-34b5-446d-b725-cddd7c76c1fb",
                                                "sense_id": "62318521-a139-338b-a15c-f3736d900851",
                                                "text": "„Der ovale Kopf saß direkt auf dem Rumpf und hatte keine Augen, sondern etwa in der Mitte ein abscheuliches, schwammartiges, kreisrundes Organ; darüber wucherte etwas, das auf grässliche Weise an ein Spinnennetz erinnerte.“"
                                            },
                                            {
                                                "example_id": "889f9ccc-bbc5-47b3-b486-7507353749c4",
                                                "sense_id": "62318521-a139-338b-a15c-f3736d900851",
                                                "text": "„An einigen Stellen waren die Wände über die Türen gewachsen, und auch der Eingang zu Ians Büro war schon fast ganz von schwammartigen Gebilden verdeckt, aber Jim und Ian schafften es, hindurchzukriechen.“"
                                            },
                                            {
                                                "example_id": "cfad2354-9f63-4c68-b6cb-ae6ff6e9ad62",
                                                "sense_id": "62318521-a139-338b-a15c-f3736d900851",
                                                "text": "„Howard hatte die Pflanze mit dem schwammartigen Zweig eines abgestorbenen Buschs angestupst und sich gefragt, wie er sie klassifizieren sollte, als er aufblickte und sich von den merkurianischen Wilden umringt fand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "072c9e81-68cc-4aca-a1fd-38317d4042d4",
                        "source_entry_id": "7bae724c-a9f3-35e4-b185-1793c72c36be",
