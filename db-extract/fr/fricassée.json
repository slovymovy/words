                                    {
                                        "sense_id": "1d0deab4-0d55-3e39-b79c-d26908224f01",
                                        "entry_id": "44d7da7f-4151-35e9-b370-296ad14f1dc8",
                                        "glosses": [
                                            "vielfaches Küssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1f8e7f3-dd68-4fd2-885f-0169c4ba7189",
                                                "sense_id": "1d0deab4-0d55-3e39-b79c-d26908224f01",
                                                "text": "„Als wir uns vom Tisch erhoben,kam es zu einer allgemeinen Küsserei; doch konnte die Contessa ihr Lachen nicht verbeißen, als sie den Schneider umarmen mußte.“"
                                            },
                                            {
                                                "example_id": "6d0f63fa-b5f5-479a-b35b-1fdf9670bd3e",
                                                "sense_id": "1d0deab4-0d55-3e39-b79c-d26908224f01",
                                                "text": "„Ich machte kehrt und malte mir das Geflüster und die fade Küsserei aus, die hinter meinem Rücken aufs neue begann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98a4aae5-f5c1-4299-97b0-a2829a45c405",
                        "source_entry_id": "e9af7608-03c2-32ed-a239-3ef9b41a838b",
