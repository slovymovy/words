                    {
                        "sense_id": "9609963d-fa3f-3b3a-b84a-d97eb698e861",
                        "entry_id": "1baebbf2-56ae-347c-8728-ab7c2c359d69",
                        "glosses": [
                            "een van beide organen in de onderrug die het bloed zuiveren van afvalstoffen en deze uitscheiden in de urine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44c66021-7cd9-4e24-87b8-3512d9946838",
                                "sense_id": "9609963d-fa3f-3b3a-b84a-d97eb698e861",
                                "text": "De meeste mensen bezitten twee nieren en kunnen er daarvan één missen. Zelfs als reserveonderdeel is die extra nier niet nodig."
                            }
                        ]
                    },
                    {
                        "sense_id": "577a0341-c3b6-35a8-81ba-1b4db17a7603",
                        "entry_id": "1baebbf2-56ae-347c-8728-ab7c2c359d69",
                        "glosses": [
                            "gerecht bereid uit dierlijke organen die het bloed zuiveren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "003f98b5-c26a-4b8a-9909-91c64321a352",
                                "sense_id": "577a0341-c3b6-35a8-81ba-1b4db17a7603",
                                "text": "Als Joyces Leopold Bloom, terug van de slager, een nier bakt en in de werveling van geuren staat, sist de nier in de pan, stijgen de aroma’s om hem op (…)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d6e3d59-9dc0-4013-a312-adf948e52c10",
                        "source_entry_id": "1baebbf2-56ae-347c-8728-ab7c2c359d69",
                        "source_sense_id": "9609963d-fa3f-3b3a-b84a-d97eb698e861",
                        "source_sense_description": "een van beide organen in de onderrug die het bloed zuiveren van afvalstoffen en deze uitscheiden in de urine.",
                        "target_lang_word": "Niere",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niere",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a8654a9-9b23-30dc-aa01-eb431ed2a6ec",
                                        "entry_id": "6a480c57-1ea4-360c-b3be-55dfef51e8c7",
                                        "glosses": [
                                            "paarig angelegtes bohnenförmiges Ausscheidungsorgan, das durch Bildung von Harn Gifte und Endprodukte des Stoffwechsels ausscheidet (beim Menschen etwa: 4 × 7 × 11 cm)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d77a23ce-d0f3-4fdd-95cc-47302a73eda6",
                                                "sense_id": "6a8654a9-9b23-30dc-aa01-eb431ed2a6ec",
                                                "text": "Meine Nieren sind entzündet."
                                            },
                                            {
                                                "example_id": "56464017-ef7f-4102-9363-6768a6caa0bc",
                                                "sense_id": "6a8654a9-9b23-30dc-aa01-eb431ed2a6ec",
                                                "text": "„Montags stellt er sich plötzlich vor ein Mikrofon in Berlin und sagt, dass seine Frau eine Niere brauche und er sie ihr spenden werde.“"
                                            },
                                            {
                                                "example_id": "a0b89f79-9b51-4548-b3c6-fb11625cedb6",
                                                "sense_id": "6a8654a9-9b23-30dc-aa01-eb431ed2a6ec",
                                                "text": "„Dann hoben sie den Brustkorb ab und sahen die beiden Lungen, zwei Schwämmen gleich, das Herz, das wie ein großes Ei aussah, in wenig nach links hinten gerückt, das Zwerchfell, die Nieren, die ganze Masse der Eingeweide.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c990a5a8-d25d-3951-851b-041f95a7cc9f",
                                        "entry_id": "6a480c57-1ea4-360c-b3be-55dfef51e8c7",
                                        "glosses": [
                                            "unter ^([1]) beschriebenes Organ von bestimmten Tieren, das als Nahrung dient"
                                        ],
                                        "tags": [
                                            "plural",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d60575c-26ce-4dc7-9889-4151d4565d92",
                                                "sense_id": "c990a5a8-d25d-3951-851b-041f95a7cc9f",
                                                "text": "Heute gibt es Nieren süß-sauer mit Kartoffelpüree zum Mittagessen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b1f53d7-9333-479e-be8d-3a8b4b8eac5c",
                        "source_entry_id": "1baebbf2-56ae-347c-8728-ab7c2c359d69",
                        "source_sense_id": "9609963d-fa3f-3b3a-b84a-d97eb698e861",
                        "source_sense_description": "een van beide organen in de onderrug die het bloed zuiveren van afvalstoffen en deze uitscheiden in de urine.",
                        "target_lang_word": "kidney",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kidney",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8982d0e5-12c4-30d8-a4bf-bb992fd17a42",
                                        "entry_id": "9ad041f8-018e-349d-abcc-58746ee7eee2",
                                        "glosses": [
                                            "An organ in the body that filters the blood, producing urine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e422ed4-2b24-4db0-a2dd-732fc0d7ff86",
                                                "sense_id": "8982d0e5-12c4-30d8-a4bf-bb992fd17a42",
                                                "text": "The liver and the kidneys of animals have long been gastronomically popular for their aphrodisiac properties."
                                            },
                                            {
                                                "example_id": "9bc39b1a-e94d-43d3-b741-b0f77c80ca51",
                                                "sense_id": "8982d0e5-12c4-30d8-a4bf-bb992fd17a42",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic the way real kidneys cleanse blood and eject impurities and surplus water as urine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "468b1578-4b26-3818-b3ce-63ad9830083f",
                                        "entry_id": "9ad041f8-018e-349d-abcc-58746ee7eee2",
                                        "glosses": [
                                            "This organ (of an animal) cooked as food."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6fb830b5-1f43-3dc0-93f5-94f4445b84da",
                                        "entry_id": "9ad041f8-018e-349d-abcc-58746ee7eee2",
                                        "glosses": [
                                            "Constitution, temperament, nature, type, character, disposition. (usually used of people)"
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4ae452b-2752-4888-b156-a3a2f917bf01",
                                                "sense_id": "6fb830b5-1f43-3dc0-93f5-94f4445b84da",
                                                "text": "[…] think of that, – a man of my kidney, – think of that, […]"
                                            },
                                            {
                                                "example_id": "7f59d930-398a-4153-8909-7e07f685590e",
                                                "sense_id": "6fb830b5-1f43-3dc0-93f5-94f4445b84da",
                                                "text": "Millions in the World of this Man's Kidney"
                                            },
                                            {
                                                "example_id": "c7c965a7-bd81-4ba7-ba99-f74ea001ee22",
                                                "sense_id": "6fb830b5-1f43-3dc0-93f5-94f4445b84da",
                                                "text": "30th June, 1788, Robert Burns, letter to Mr Robert Ainslie\nYour poets, spendthrifts, and other fools of that kidney, pretend, forsooth, to crack their jokes on prudence."
                                            },
                                            {
                                                "example_id": "1861e761-bbcb-43cb-851f-f17cdf40c70e",
                                                "sense_id": "6fb830b5-1f43-3dc0-93f5-94f4445b84da",
                                                "text": "I shall not want Honour in Heaven\n For I shall meet Sir Philip Sidney\nAnd have talk with Coriolanus\n And other heroes of that kidney."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0a1a4db-920a-335a-aa1b-ace71aa3be81",
                                        "entry_id": "9ad041f8-018e-349d-abcc-58746ee7eee2",
                                        "glosses": [
                                            "A waiter."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "697afd2b-da10-47c4-93b1-f376e0370703",
                                                "sense_id": "e0a1a4db-920a-335a-aa1b-ace71aa3be81",
                                                "text": "I once more desire my readers to consider that as I cannot keep an ingenious man to go daily to Will's under twopence each day merely for his charges, to White's under sixpence, nor to the Grecian without allowing him some plain Spanish, to be as able as others at the learned table; and that a good observer cannot speak with even Kidney at St. James's without clean linen; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3922a37a-426d-4f44-bd97-a6cc69783598",
                        "source_entry_id": "1baebbf2-56ae-347c-8728-ab7c2c359d69",
                        "source_sense_id": "9609963d-fa3f-3b3a-b84a-d97eb698e861",
                        "source_sense_description": "een van beide organen in de onderrug die het bloed zuiveren van afvalstoffen en deze uitscheiden in de urine.",
                        "target_lang_word": "rein",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rein",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efa89a75-5a3b-3d3b-87e4-3570b70270b9",
                                        "entry_id": "1a3edece-060c-3ffb-9def-569c578f1e3c",
                                        "glosses": [
                                            "Organe pair, situé dans l’abdomen, en arrière du péritoine, au niveau de la douzième paire de côtes (flottantes), qui assure, par filtration et excrétion d’urine, l’élimination des toxiques et l’équilibre hydroélectrolytique du sang et de l’organisme en général."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b7cf03d-422a-4216-aa96-501c609fa59d",
                                                "sense_id": "efa89a75-5a3b-3d3b-87e4-3570b70270b9",
                                                "text": "Les reins filtrent les substances toxiques du sang. Ce sont des substances chimiques qui proviennent souvent de la dégradation des aliments digérés. L’urée provient de la digestion des protéines."
                                            },
                                            {
                                                "example_id": "55a2663d-a22c-4e58-87a9-4d2fa8ab9c5f",
                                                "sense_id": "efa89a75-5a3b-3d3b-87e4-3570b70270b9",
                                                "text": "Le rein est le principal organe excréteur de l’organisme et il élimine les déchets d’origine métabolique. Le plus important déchet du métabolisme des protéines est l’urée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44c8dead-86de-3a5c-b175-68a7361b9333",
                                        "entry_id": "1a3edece-060c-3ffb-9def-569c578f1e3c",
                                        "glosses": [
                                            "Lombes, bas de l’épine dorsale et la région voisine."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea02f330-5d76-42a0-b034-091c4d5281f7",
                                                "sense_id": "44c8dead-86de-3a5c-b175-68a7361b9333",
                                                "text": "Fend-l’Air ruait, se dressait, pointait, exécutait des tête-à-queue fantastiques, semblant pris de folie. Brusquement, d’un dernier coup de reins, il envoya Montreval à dix pieds en l’air […]"
                                            },
                                            {
                                                "example_id": "f32f2a23-0c3d-4fef-85c7-7e714fc42cb9",
                                                "sense_id": "44c8dead-86de-3a5c-b175-68a7361b9333",
                                                "text": "Enfin elle se retrouva en position assise, un peu avachie, adossée à la tête de lit, les bras écartés en l’air, les reins calés contre l’oreiller trempé de sueur dans sa taie de coton froissée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ac295a0-a098-3487-b2f2-8885ad069249",
                                        "entry_id": "1a3edece-060c-3ffb-9def-569c578f1e3c",
                                        "glosses": [
                                            "Siège de la force, des sentiments."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a17e63a0-8a9d-4c89-8855-11a3951903ae",
                                                "sense_id": "2ac295a0-a098-3487-b2f2-8885ad069249",
                                                "text": "Sonder les cœurs et les reins, c’est l’apanage de Dieu, qui seul connait les pensées secrètes, les sentiments profonds de l’homme."
                                            },
                                            {
                                                "example_id": "e638151a-43c8-4353-882e-5a1ba843357d",
                                                "sense_id": "2ac295a0-a098-3487-b2f2-8885ad069249",
                                                "text": "Il a les reins solides se dit d’un homme assez riche, assez hardi, ou assez puissant pour se risquer dans une entreprise difficile."
                                            },
                                            {
                                                "example_id": "9d9a5661-edb6-4970-8477-af9ff51b247c",
                                                "sense_id": "2ac295a0-a098-3487-b2f2-8885ad069249",
                                                "text": "Demain, la machine répondra à tous nos désirs instantanément, elle pourra sonder nos reins et lire dans nos pensées au moment où nous les éprouvons. Et même avant !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6f14c28-c7bb-32b2-92f4-96e850893170",
                                        "entry_id": "1a3edece-060c-3ffb-9def-569c578f1e3c",
                                        "glosses": [
                                            "Partie d’une voûte ou d’un arc comprise entre la portée et le sommet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0180a2f2-9029-4886-90b5-d9d8c83ed286",
                                                "sense_id": "a6f14c28-c7bb-32b2-92f4-96e850893170",
                                                "text": "Les reins d’une voûte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
