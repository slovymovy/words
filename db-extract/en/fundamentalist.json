                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c98bf9f6-b7ac-44d7-98ac-d77c12762420",
                        "source_entry_id": "483c3ca0-297b-3a4f-bebb-9d5a2b52d621",
                        "source_sense_description": "one who reduces religion to strict interpretation of core or original texts",
                        "target_lang_word": "fondamentaliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fondamentaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "305715c2-76eb-3d9a-81da-e691ee4096cc",
                                        "entry_id": "f4e3ccc2-e685-3ec2-a331-c59415b8f5e5",
                                        "glosses": [
                                            "Partisan du fondamentalisme, du retour aux fondements de la religion, d’un principe, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb7c3e82-dc6f-4092-8d77-ad9f4130fa9b",
                                                "sense_id": "305715c2-76eb-3d9a-81da-e691ee4096cc",
                                                "text": "Si vous êtes un chrétien fondamentaliste, probablement protesterez-vous que chaque mot de la Bible est littéralement vrai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa002f7f-3624-368d-8d0a-d7685abfb044",
                                        "entry_id": "f4e3ccc2-e685-3ec2-a331-c59415b8f5e5",
                                        "glosses": [
                                            "Partisan d'un retour à une vision originelle de la foi et de la doctrine chez les catholiques."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89ed40c7-718b-42ee-a299-d0aef0c3d59d",
                                                "sense_id": "fa002f7f-3624-368d-8d0a-d7685abfb044",
                                                "text": "D'une certaine façon, le fondamentaliste nie la médiation d'une autorité religieuse – clergé, Église, docteurs de la loi – qui interpose habituellement une clé d'interprétation entre le croyant et le texte révélé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f613c32e-5e81-3c9a-94b8-002de52106ab",
                                        "entry_id": "f4e3ccc2-e685-3ec2-a331-c59415b8f5e5",
                                        "glosses": [
                                            "Partisan de la vision traditionnelle de la religion chez les musulmans."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3c35dd6-5152-4886-850a-57b8a99d88e7",
                                                "sense_id": "f613c32e-5e81-3c9a-94b8-002de52106ab",
                                                "text": "Ces croyants, qui pensent que les traditions d’autrefois sont plus « pures » que celles d’aujourd’hui, sont appelés « ultraorthodoxes » chez les juifs, « intégristes » chez les catholiques et « fondamentalistes » chez les musulmans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fondamentaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25c784fb-81ba-3319-b57e-9254de7d3440",
                                        "entry_id": "3c29a8a7-6b2f-30c1-b346-2c7c2f89a3ce",
                                        "glosses": [
                                            "Relatif au fondamentalisme, au retour aux fondements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "522faf64-7e1b-4e4c-a595-78865c3427bd",
                                                "sense_id": "25c784fb-81ba-3319-b57e-9254de7d3440",
                                                "text": "Le monde fondamentaliste est un monde polarisé : bien ou mal, vérité ou mensonge, position vaine ou situation authentique, nous ou eux, un de nous ou l’ennemi."
                                            },
                                            {
                                                "example_id": "ddfb07a4-658e-4a0d-b133-74397ac26244",
                                                "sense_id": "25c784fb-81ba-3319-b57e-9254de7d3440",
                                                "text": "D'une façon intéressante, les néoconservateurs, poursuivant une quête digne de Moby Dick pour trouver un monstre à occire — […] — sont, de par leur tempérament et leur point de vue philosophique, bien plus « fondamentalistes » que ceux qu'ils perçoivent comme leurs ennemis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72a8f258-dd07-4240-afee-98fbca1be8cd",
                        "source_entry_id": "483c3ca0-297b-3a4f-bebb-9d5a2b52d621",
                        "source_sense_description": "one who reduces religion to strict interpretation of core or original texts",
                        "target_lang_word": "intégriste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intégriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11ecd42a-0640-3894-993b-f01df03d8d50",
                                        "entry_id": "7c48db3f-d777-3faf-a1fd-dfcaafee06d4",
                                        "glosses": [
                                            "Relatif à l'intégrisme, au maintien, à l'intégrité de la tradition religieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99cad2cb-f097-4c8a-a78c-1de3bb2dd2f8",
                                                "sense_id": "11ecd42a-0640-3894-993b-f01df03d8d50",
                                                "text": "Bref, les frontières entre catholiques « observants », « traditionalistes » et « intégristes » semblent poreuses dans l’entre-soi versaillais."
                                            },
                                            {
                                                "example_id": "77d31c33-44ca-4e14-b1c7-0576fe7242eb",
                                                "sense_id": "11ecd42a-0640-3894-993b-f01df03d8d50",
                                                "text": "Dans la convention intégriste, il mérite le même sort que son père. On a égorgé pas mal de gosses simplement parce qu’ils avaient des parents soldats ou policiers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intégriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2843ab41-4359-3aab-ab62-9380625da59f",
                                        "entry_id": "8313e106-5354-3cf4-b802-a5851bd9d1a4",
                                        "glosses": [
                                            "Partisan de l'intégrisme², du maintien, de l'intégrité de la tradition religieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6808263c-2de9-46af-9461-b1f5e9a8b491",
                                                "sense_id": "2843ab41-4359-3aab-ab62-9380625da59f",
                                                "text": "Un intégriste passionné."
                                            },
                                            {
                                                "example_id": "3927a378-04a2-4bfc-9adc-187115235be5",
                                                "sense_id": "2843ab41-4359-3aab-ab62-9380625da59f",
                                                "text": "Ni les religions et leurs intégristes, ni les idéologies et leurs militants, ni les bien-pensants et leurs préjugés ne doivent pouvoir entraver le droit à la caricature, fût-elle excessive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d927cba-2bd8-31da-87d1-d14cf83a1f92",
                                        "entry_id": "8313e106-5354-3cf4-b802-a5851bd9d1a4",
                                        "glosses": [
                                            "Adepte de l'intégrisme chez les catholiques."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac764663-2a8c-4e0f-bb07-d6c4847a0557",
                                                "sense_id": "7d927cba-2bd8-31da-87d1-d14cf83a1f92",
                                                "text": "Dans le contexte du catholicisme, l'intégriste est celui qui se réclame de « la tradition », c'est-à-dire d'un vaste corpus incluant à la fois les Écritures et leur interprétation fixée avec autorité par les pères et les docteurs de l'Église, les conciles et les papes. On pourrait dire que l'intégrisme fige, à un moment déterminé, l'interprétation de la Révélation. Au contraire, il y a dans le fondamentalisme une volonté de retour aux sources, à une pureté originelle de la foi qui se trouverait dans les Écritures, débarrassées des repeints de la tradition."
                                            },
                                            {
                                                "example_id": "18f6e237-551d-4861-80d7-88cd102f15a2",
                                                "sense_id": "7d927cba-2bd8-31da-87d1-d14cf83a1f92",
                                                "text": "Ces croyants, qui pensent que les traditions d'autrefois sont plus « pures » que celles d'aujourd'hui, sont appelés « ultraorthodoxes » chez les juifs, « intégristes » chez les catholiques et « fondamentalistes » chez les musulmans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc10ba40-9d8e-3dfb-9c06-427138307917",
                                        "entry_id": "8313e106-5354-3cf4-b802-a5851bd9d1a4",
                                        "glosses": [
                                            "Adepte de l’intégrisme chez les musulmans."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9665fe65-2002-4427-8a98-7a4ed0f3f6da",
                                                "sense_id": "cc10ba40-9d8e-3dfb-9c06-427138307917",
                                                "text": "Elle revint habillée d’un tailleur noir, hyper-sexy, la veste bâillant sur une poitrine à damner un intégriste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73a1c301-be25-395c-ae00-73c61a21dd91",
                                        "entry_id": "8313e106-5354-3cf4-b802-a5851bd9d1a4",
                                        "glosses": [
                                            "Personne aux avis fermés ou définitifs, qui les affirme comme des dogmes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a03ec8e0-8698-4963-b706-d52fdaff27a0",
                                                "sense_id": "73a1c301-be25-395c-ae00-73c61a21dd91",
                                                "text": "[T]on blog est lu par des intégristes qui s’entretuent pour savoir dans quel sens il faut découper le persil ou touiller la béchamel !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "364f30a2-06c3-483e-8eac-5f0fa0788743",
