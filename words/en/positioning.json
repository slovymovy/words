{
    "word_family": [
        "position",
        "positional",
        "reposition",
        "positioner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "08f34ac8-e2ce-3ff9-9d38-67e10942c8ba",
                    "sense_definition": "Present participle and gerund of <w>position</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photographer is <w>positioning</w> the model to get the best lighting for the shot.",
                            "target_lang_translations": {
                                "ru": "Фотограф <w>располагает</w> модель, чтобы получить лучшее освещение для снимка.",
                                "zh": "摄影师正在<w>安排</w>模特的位置，以获得最佳的拍摄光线。"
                            }
                        },
                        {
                            "text": "We spent the afternoon <w>positioning</w> the furniture in the new office.",
                            "target_lang_translations": {
                                "ru": "Мы провели день, <w>расставляя</w> мебель в новом офисе.",
                                "zh": "我们花了一下午的时间在办公室里<w>摆放</w>家具。"
                            }
                        }
                    ],
                    "synonyms": [
                        "placing",
                        "arranging",
                        "locating"
                    ],
                    "common_phrases": [
                        "positioning yourself",
                        "positioning the camera"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола position (размещать, располагать).",
                        "zh": "动词 position 的现在分词和动名词形式，指放置或安排某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размещение",
                                "target_lang_sense_clarification": "процесс установки на место"
                            },
                            {
                                "target_lang_word": "расположение",
                                "target_lang_sense_clarification": "процесс выбора места"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放置",
                                "target_lang_sense_clarification": "指将物体安置在特定位置"
                            },
                            {
                                "target_lang_word": "安排",
                                "target_lang_sense_clarification": "指对位置或布局进行规划"
                            },
                            {
                                "target_lang_word": "摆放",
                                "target_lang_sense_clarification": "摆放物品、家具"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "86d91291-6020-3d7e-a88c-bae2390fd85d",
                    "sense_definition": "The act of placing or arranging something in a particular way or location.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strategic <w>positioning</w> of the brand helped it gain a large market share.",
                            "target_lang_translations": {
                                "ru": "Стратегическое <w>позиционирование</w> бренда помогло ему завоевать большую долю рынка.",
                                "zh": "该品牌战略性的<w>定位</w>帮助它获得了巨大的市场份额。"
                            }
                        },
                        {
                            "text": "Careful <w>positioning</w> of the mirrors made the small room appear much larger.",
                            "target_lang_translations": {
                                "ru": "Тщательное <w>размещение</w> зеркал сделало маленькую комнату визуально намного больше.",
                                "zh": "对镜子进行精心的<w>布置</w>，让这个小房间看起来宽敞多了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "placement",
                        "arrangement",
                        "location"
                    ],
                    "common_phrases": [
                        "product positioning",
                        "market positioning",
                        "global positioning system"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по размещению или расположению чего-либо определенным образом или в определенном месте.",
                        "zh": "将某物以特定方式或在特定地点进行安置或排列的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "позиционирование",
                                "target_lang_sense_clarification": "стратегическое или маркетинговое"
                            },
                            {
                                "target_lang_word": "размещение",
                                "target_lang_sense_clarification": "физическое нахождение объекта"
                            },
                            {
                                "target_lang_word": "расположение",
                                "target_lang_sense_clarification": "порядок расстановки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "定位",
                                "target_lang_sense_clarification": "指在市场或战略层面的位置设定"
                            },
                            {
                                "target_lang_word": "布置",
                                "target_lang_sense_clarification": "指对空间内物品的摆放安排"
                            },
                            {
                                "target_lang_word": "安置",
                                "target_lang_sense_clarification": "指将某物妥善放置在某处"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}