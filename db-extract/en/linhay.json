                        "glosses": [
                            "A shed or other outbuilding, originally open-fronted with a hay loft."
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "aad565d2-c784-4a16-a5fe-12945cf3d7eb",
                                "sense_id": "036d275c-3482-3720-aa4c-163e22d3df65",
                                "text": "Home-side of the linhay, and under the ashen hedge-row, where father taught me to catch blackbirds, all at once my heart went down, and all my breast was hollow."
                            },
                            {
                                "example_id": "0187a6ac-bb58-4700-ab38-f36893847e4b",
                                "sense_id": "036d275c-3482-3720-aa4c-163e22d3df65",
                                "text": "[S]he went to the linhay, or lean-to shed, which formed the root-store of their dwelling."
                            },
                            {
                                "example_id": "feeacd58-a64c-45bf-9c5d-adc68006379b",
                                "sense_id": "036d275c-3482-3720-aa4c-163e22d3df65",
                                "text": "While they stood there close to the old linhay a bird came flying round them in wide circles, uttering shrill cries."
                            }
                        ]
                    }
