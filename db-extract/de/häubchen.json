                ],
                "senses": [
                    {
                        "sense_id": "8f57f8c9-d32e-38b7-92cb-d88f5ad09970",
                        "entry_id": "8d18164c-c4a8-3f07-9406-b44cd8bbb179",
                        "glosses": [
                            "kleine Haube"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae73a2cc-c6c8-4633-8818-2a710cda79f1",
                                "sense_id": "8f57f8c9-d32e-38b7-92cb-d88f5ad09970",
                                "text": "„Die kleine Fürstin lag mit einem weissen Häubchen auf dem Kopf in den Kissen.“"
                            },
                            {
                                "example_id": "43b60fca-f9e4-4784-87d1-30b658abefd2",
                                "sense_id": "8f57f8c9-d32e-38b7-92cb-d88f5ad09970",
                                "text": "„Sie hatten ein Foto von dem Säugling dazugelegt, mit Häubchen und in eine Decke gewickelt, sodass man nur ein zerknautschtes Gesicht mit geschlossenen Augen sehen konnte.“"
                            },
                            {
                                "example_id": "061b60aa-bb90-4360-87ab-f28ff759be7f",
                                "sense_id": "8f57f8c9-d32e-38b7-92cb-d88f5ad09970",
                                "text": "„Das gescheitelte, strohblonde Haar quoll ihr unter einem Häubchen aus grauer Leinwand hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
