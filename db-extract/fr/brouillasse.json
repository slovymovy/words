                "senses": [
                    {
                        "sense_id": "577e668b-d9a4-3050-a46d-de7cc7ca611d",
                        "entry_id": "68dcfa30-bf3b-3956-876a-8b77fcd01e66",
                        "glosses": [
                            "Sorte de brouillard qui tombe en pluie très fine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4cb326b-30e1-4401-bc97-7e49770a74a4",
                                "sense_id": "577e668b-d9a4-3050-a46d-de7cc7ca611d",
                                "text": "Le voyage a été fort bon, même le golfe de Gascogne s’est montré aimable pour le capitaine Bates et ses passagers, mais à peine le feu du cap Saint-Mathieu s’est-il vissé sur l’horizon, qu'une forte houle a accouru de l'Atlantique, et qu’une vilaine brouillasse a empaqueté le cargo, comme dans de l'étoupe humide."
                            },
                            {
                                "example_id": "d6973ac5-bc7a-4682-a7cc-c5cf26f5f935",
                                "sense_id": "577e668b-d9a4-3050-a46d-de7cc7ca611d",
                                "text": "Tristesse redoublée par ce ciel livide ou plombé qui vous plonge du cœur du printemps dans une brouillasse glauque et transperçante de Toussaint."
                            }
                        ]
                    }
                ],
