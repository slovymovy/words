                        "entry_id": "524fd967-d5c0-3076-a521-e6bcf8c781d5",
                        "glosses": [
                            "die Hauptschlagader (auch die große Körperschlagader genannt), ein Blutgefäß, das direkt auf der linken Seite des Herzens entspringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd160f19-79d0-4c82-8a75-68c8e97620d8",
                                "sense_id": "6b455fd9-3890-3d97-bb24-94f22f5fc4e9",
                                "text": "„Beim erwachsenen Menschen hat die Aorta in der Regel einen Durchmesser von etwa 2,5–3,5 cm und eine Länge von 30–40 cm.„"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34bb40cb-138f-45cc-8c14-3a370ddf605a",
