    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "97ecc754-c775-3d69-98a8-1193bb140772",
                    "sense_definition": "iets officieel rapporteren of bekendmaken aan een instantie of persoon",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De medewerker <w>meldde</w> de fraude anoniem bij de politie.",
                            "target_lang_translations": {
                                "en": "The employee <w>reported</w> the fraud anonymously to the police.",
                                "ru": "Сотрудник анонимно <w>сообщил</w> о мошенничестве в полицию."
                            }
                        },
                        {
                            "text": "Je moet een diefstal altijd direct bij de verzekering <w>melden</w>.",
                            "target_lang_translations": {
                                "en": "You must always <w>report</w> a theft to the insurance company immediately.",
                                "ru": "О краже всегда нужно немедленно <w>заявлять</w> в страховую компанию."
                            }
                        }
                    ],
                    "synonyms": [
                        "meedelen",
                        "aangeven",
                        "rapporteren"
                    ],
                    "common_phrases": [
                        "bij de politie melden",
                        "een probleem melden"
                    ],
                    "target_lang_definitions": {
                        "en": "To officially report or announce something to an authority or person.",
                        "ru": "Официально сообщать или заявлять о чем-либо в орган власти или лицу"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "report",
                                "target_lang_sense_clarification": "to notify authorities about an incident or crime"
                            },
                            {
                                "target_lang_word": "notify",
                                "target_lang_sense_clarification": "to formally inform an organization or person"
                            },
                            {
                                "target_lang_word": "file a report",
                                "target_lang_sense_clarification": "to submit an official statement about a problem"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сообщать",
                                "target_lang_sense_clarification": "официально уведомлять о происшествии"
                            },
                            {
                                "target_lang_word": "заявлять",
                                "target_lang_sense_clarification": "подавать официальное заявление, например, в полицию"
                            },
                            {
                                "target_lang_word": "докладывать",
                                "target_lang_sense_clarification": "рапортовать о ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f97e181f-6d2f-3263-a585-6f493931cc03",
                    "sense_definition": "iemand op de hoogte stellen of een update geven over een situatie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Meld</w> me even als je vanavond wilt gaan.",
                            "target_lang_translations": {
                                "en": "Just <w>let me know</w> if you want to go tonight.",
                                "ru": "<w>Дай</w> мне <w>знать</w>, если захочешь пойти сегодня вечером."
                            }
                        },
                        {
                            "text": "De krant <w>meldt</w> dat de stakingen morgen voorbij zijn.",
                            "target_lang_translations": {
                                "en": "The newspaper <w>reports</w> that the strikes will be over tomorrow.",
                                "ru": "Газета <w>сообщает</w>, что забастовки закончатся завтра."
                            }
                        }
                    ],
                    "synonyms": [
                        "meedelen",
                        "laten weten",
                        "berichten"
                    ],
                    "common_phrases": [
                        "laat het me melden",
                        "even melden"
                    ],
                    "target_lang_definitions": {
                        "en": "To inform someone or provide an update about a situation.",
                        "ru": "Информировать кого-либо или предоставлять обновленную информацию о ситуации"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "let someone know",
                                "target_lang_sense_clarification": "to inform someone informally"
                            },
                            {
                                "target_lang_word": "report",
                                "target_lang_sense_clarification": "to state or announce information, often in news"
                            },
                            {
                                "target_lang_word": "mention",
                                "target_lang_sense_clarification": "to briefly state or bring up a topic"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сообщать",
                                "target_lang_sense_clarification": "передавать информацию или новости"
                            },
                            {
                                "target_lang_word": "давать знать",
                                "target_lang_sense_clarification": "информировать в неформальном контексте"
                            },
                            {
                                "target_lang_word": "уведомлять",
                                "target_lang_sense_clarification": "ставить в известность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4aef92dc-b548-384d-a008-90d8ebc5e5e7",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>melde</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "planten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de oude tuin groeiden verschillende soorten <w>melden</w> tussen het onkruid.",
                            "target_lang_translations": {
                                "en": "In the old garden, various types of <w>oraches</w> grew among the weeds.",
                                "ru": "В старом саду среди сорняков росли разные виды <w>лебеды</w>."
                            }
                        },
                        {
                            "text": "De botanicus bestudeerde de bloeiwijze van de <w>melden</w> in het veld.",
                            "target_lang_translations": {
                                "en": "The botanist studied the inflorescence of the <w>oraches</w> in the field.",
                                "ru": "Ботаник изучал соцветия <w>лебеды</w> в поле."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the noun 'melde' (orache), a type of plant.",
                        "ru": "Множественное число существительного 'лебеда' (растение)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oraches",
                                "target_lang_sense_clarification": "plural of the plant genus Atriplex"
                            },
                            {
                                "target_lang_word": "saltbushes",
                                "target_lang_sense_clarification": "another name for plants in the orache family"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лебеда",
                                "target_lang_sense_clarification": "растение рода Atriplex (мн. ч.)"
                            }
                        ]
                    }
                }
            ]
        }
