                                        "glosses": [
                                            "Insel im östlichen Mittelmeer, die geografisch zu Asien gehört, mit Europa jedoch kulturell und politisch sehr eng verbunden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeb0159e-8dc1-4285-bdca-24fbc0fd4ef0",
                                                "sense_id": "63ed2c49-1a9b-3515-b689-33fe48979853",
                                                "text": "Auf Zypern herrscht mediterranes Klima mit deutlich kontinentaler Ausprägung."
                                            },
                                            {
                                                "example_id": "8e7cbed6-9244-4f57-ad9d-b1835187f346",
                                                "sense_id": "63ed2c49-1a9b-3515-b689-33fe48979853",
                                                "text": "Wer gerne Vögel beobachtet, sollte Zypern besuchen. Dort sind über 300 Arten zu beobachten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
