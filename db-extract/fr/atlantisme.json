                        "entry_id": "57471444-2a94-3259-aa9e-69611c41c37e",
                        "glosses": [
                            "Doctrine prônant une forte coopération entre les pays de l’Organisation du traité de l’Atlantique Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17dd4489-321e-49b3-bb88-0da1aa7a1ea1",
                                "sense_id": "2f9d2a61-1632-3ce4-81f7-cf94515a9968",
                                "text": "Malgré ses accents gaulliens passés, il fait dorénavant montre d’un atlantisme militant."
                            },
                            {
                                "example_id": "4a312701-c906-4085-af18-f014307b8cf9",
                                "sense_id": "2f9d2a61-1632-3ce4-81f7-cf94515a9968",
                                "text": "L’atlantisme, c’est une préférence pour l’ordre du monde tel qu’il existe, parce qu’il existe."
                            }
                        ]
                    }
                ],
