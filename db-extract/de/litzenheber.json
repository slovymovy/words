                "senses": [
                    {
                        "sense_id": "39ff279d-d298-3e93-9bf5-3e73064f9e7e",
                        "entry_id": "9c210535-51d1-33e3-9b50-c57dd837fc4b",
                        "glosses": [
                            "hydraulisches Gerät zum Verschieben oder Heben von schweren Lasten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f88eaea-7488-47c7-b6ce-81ae5debdfef",
                                "sense_id": "39ff279d-d298-3e93-9bf5-3e73064f9e7e",
                                "text": "„Der Bau der Brücke erfolgte im Freivorbau. Die beinahe 400 Tonnen schweren Segmente des mittleren Feldes wurden auf dem Wasser angeliefert und zur Montage durch Bockkräne mittels Litzenheber auf die Höhe des Brückenträgers angehoben.“"
                            },
                            {
                                "example_id": "cabf14a4-5cea-4992-a39c-52f82a541900",
                                "sense_id": "39ff279d-d298-3e93-9bf5-3e73064f9e7e",
                                "text": "„Für den Verschub waren vom Widerlager bis zum Brückenende auf dem Montageplatz Litzen horizontal gespannt, die durch Hohlkolbenpressen und Litzenheber gezogen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
