                ],
                "senses": [
                    {
                        "sense_id": "7c3d1d87-d51b-3b63-9269-815bd72bbe55",
                        "entry_id": "4bf92050-4b05-3ce6-9c77-e2bd4b6ba0ab",
                        "glosses": [
                            "Lernspiel mit versuchsweisem Herantasten an die Anforderungen eines anspruchsvollen, komplexen Regelspiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c51bccb8-8164-4d2f-a8c5-13829e74fd75",
                                "sense_id": "7c3d1d87-d51b-3b63-9269-815bd72bbe55",
                                "text": "„Bei schwierigen Spielen ist es notwendig, die Regeln schrittweise zu vermitteln und zunächst in einem Probespiel anwenden zu lassen.“"
                            },
                            {
                                "example_id": "bdd15734-6a21-428d-bd2c-d6dd2b762040",
                                "sense_id": "7c3d1d87-d51b-3b63-9269-815bd72bbe55",
                                "text": "„Der wollte ein Probespiel ablegen für seine Finger!“"
                            },
                            {
                                "example_id": "df4019cc-d24b-4d74-8696-86eadff39cf6",
                                "sense_id": "7c3d1d87-d51b-3b63-9269-815bd72bbe55",
                                "text": "„Über zweieinhalb Jahre nach seiner Schließung fallen in Rios legendärem Maracanã-Stadion wieder Tore: Den ersten Treffer im Neuen Maracanã erzielte bei einem Probespiel der brasilianische Ex-Nationalspieler Washington, der nach seinem Treffer den Rasen küsste.“"
                            },
                            {
                                "example_id": "a34be975-483c-4c82-8107-8efa2b15d49c",
                                "sense_id": "7c3d1d87-d51b-3b63-9269-815bd72bbe55",
                                "text": "„So mag der Bundestrainer zwar zu Recht das schöne Dortmunder Probespiel loben – doch Außenstürmer fehlen ihm auch weiterhin.“"
                            },
                            {
                                "example_id": "ae8b65ad-15cd-4481-824c-f82ae5261695",
                                "sense_id": "7c3d1d87-d51b-3b63-9269-815bd72bbe55",
                                "text": "„Die deutsche Fußball-Nationalelf gewann ihr letztes Probespiel vor der Weltmeisterschaft gegen Jugoslawien 2:0.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6368b451-fa8f-3018-ac77-7f3e94c0db55",
                        "entry_id": "4bf92050-4b05-3ce6-9c77-e2bd4b6ba0ab",
                        "glosses": [
                            "Testspiel zur Erfassung der Qualifizierung eines Bewerbers, etwa zur Aufnahme in ein Ensemble, ein Orchester oder eine Ligamannschaft"
                        ],
                        "tags": [
                            "Musik",
                            "Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "c1ef1fbf-ee6e-4dc4-8853-b9e55d5b4270",
                                "sense_id": "6368b451-fa8f-3018-ac77-7f3e94c0db55",
                                "text": "„In Paris wurde die Lehre mit einem Probespiel und einer Diplomverleihung abgeschlossen.“"
                            },
                            {
                                "example_id": "000c7d04-f69e-4a32-92a8-90e6696c4e37",
                                "sense_id": "6368b451-fa8f-3018-ac77-7f3e94c0db55",
                                "text": "„In Januar 1981 kam die 21-Jährige zum Probespiel für eine vakante Klarinettenstelle nach Berlin und wurde mit ausdrücklicher Billigung von Herbert von Karajan aushilfsweise vom Orchester angestellt – als erste Frau überhaupt.“"
                            },
                            {
                                "example_id": "78d2b0e8-d763-4651-9f9b-9400c97acd19",
                                "sense_id": "6368b451-fa8f-3018-ac77-7f3e94c0db55",
                                "text": "„Es kommt bei Probespielen nicht nur darauf an, gut zu sein, sondern auch auf den Klang des Instruments, das der Kandidat mitbringt.“"
                            },
                            {
                                "example_id": "234bb9f9-ed77-4373-90c1-a2326b476922",
                                "sense_id": "6368b451-fa8f-3018-ac77-7f3e94c0db55",
                                "text": "„Und der Cellist Alban Gerhardt schlägt vor, einfach mal die mörderischen Probespiele abzuschaffen.“"
                            },
                            {
                                "example_id": "a27a977e-d9ce-49bd-8c48-4ed129966169",
                                "sense_id": "6368b451-fa8f-3018-ac77-7f3e94c0db55",
                                "text": "„In ihrem Sprachgebrauch wird ein Probespiel nicht erfolgreich absolviert, sondern es wird gewonnen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
