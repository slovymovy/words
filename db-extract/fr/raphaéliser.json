                ],
                "senses": [
                    {
                        "sense_id": "412be7f3-9c3f-3108-943b-c608530a4d5b",
                        "entry_id": "9821e53f-df29-3117-9125-0538557151af",
                        "glosses": [
                            "Peindre à la manière de Raphaël."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c3e7a976-99cc-4537-9890-82dfb774eb8b",
                                "sense_id": "412be7f3-9c3f-3108-943b-c608530a4d5b",
                                "text": "Il a un peu caravagé pour les scènes de genre, beaucoup raphaélisé quand les commandes portaient sur une vierge à l'enfant."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0402a1a-b380-31ff-ad01-6e1698a15379",
                        "entry_id": "9821e53f-df29-3117-9125-0538557151af",
                        "glosses": [
                            "Peindre ou montrer à la manière de Raphaël."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "39a889bf-bbe3-4a93-a21e-51a7e95a2b6b",
                                "sense_id": "d0402a1a-b380-31ff-ad01-6e1698a15379",
                                "text": "PPP avoue lui une tendance à \"raphaéliser\" les femmes, à exprimer leur côté angélique."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2a1a13f-800c-3f46-b850-3d02ecff6c09",
                        "entry_id": "9821e53f-df29-3117-9125-0538557151af",
                        "glosses": [
                            "Donner à quelque chose ou quelqu’un des caractéristiques rappelant Raphaël."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cd1b8e91-0809-4637-9563-a06c01143418",
                                "sense_id": "f2a1a13f-800c-3f46-b850-3d02ecff6c09",
                                "text": "Mais aussi leçon de sociologie et de politologie fondamentales, comme seule la comédie (maintenant archimédisée, raphaélisée) le permettait."
                            },
                            {
                                "example_id": "f91bc469-43f3-4b22-9093-b5c817a2fe07",
                                "sense_id": "f2a1a13f-800c-3f46-b850-3d02ecff6c09",
                                "text": "Le même geste drape les quatre sœurs, le même sourire et la même coiffure les raphaélisent — hélas! — et j’irai même jusqu’à dire que le petit amour est leur frère Benjamin…"
                            }
                        ]
                    },
                    {
                        "sense_id": "003721d9-6e79-3513-aaf1-88e2be180bcb",
                        "entry_id": "9821e53f-df29-3117-9125-0538557151af",
                        "glosses": [
                            "Prendre des caractéristiques rappelant Raphaël."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "6834c864-c046-40b6-87b1-c57ff6efeadb",
                                "sense_id": "003721d9-6e79-3513-aaf1-88e2be180bcb",
                                "text": "Vous ne chevauchez pas dans les sentiers abrupts de l’inspiration… vous ne planez pas dans les régions éthérées, où la pensée se revêt d’azur, et où les formes se raphaélisent! vous suivez votre petit bonhomme de chemin sur le banal trottoir de la vie."
                            },
                            {
                                "example_id": "13dea273-3e1b-4d59-b657-7fae285f589b",
                                "sense_id": "003721d9-6e79-3513-aaf1-88e2be180bcb",
                                "text": "II était très jeune, d’une figure intelligente, fine, un peu trop artiste peut-être, à cause de longs cheveux bouclés avec lesquels il se raphaélisait;"
                            }
                        ]
                    }
                ],
