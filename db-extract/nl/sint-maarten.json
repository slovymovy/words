                        "sense_id": "d4049779-5d62-39f4-8f12-e20685864109",
                        "entry_id": "66a7157c-1618-3f70-8ed5-9618fc7275a7",
                        "glosses": [
                            "heilige Martinus van Tours, gestorven 8 november 397, die gezien wordt als degene die Gallië het christendom gebracht heeft"
                        ],
                        "tags": [
                            "rooms-katholiek"
                        ],
                        "examples": [
                            {
                                "example_id": "a90c83f8-f16a-41ea-bc6d-6c81c470a2ba",
                                "sense_id": "d4049779-5d62-39f4-8f12-e20685864109",
                                "text": "Sint-Maarten was van geboorte een Romein."
                            }
                        ]
                    },
                    {
                        "sense_id": "888f84f0-1992-3c1d-8596-b4a7344168dd",
                        "entry_id": "66a7157c-1618-3f70-8ed5-9618fc7275a7",
                        "glosses": [
                            "feestdag op 11 november, gewijd aan Martinus van Tours"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3f8e645-5352-4871-a829-364958dce81f",
                        "source_entry_id": "66a7157c-1618-3f70-8ed5-9618fc7275a7",
                        "source_sense_id": "888f84f0-1992-3c1d-8596-b4a7344168dd",
