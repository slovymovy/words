                        "glosses": [
                            "The act of reviving, or the state of being revived; renewal of life."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3aac7370-615b-4c83-b537-3cc075f3d108",
                                "sense_id": "cc8d0038-13a8-3c81-bbb1-4c2560aa59c3",
                                "text": "25 June, 1830, Samuel Taylor Coleridge, Table Talk\nIn this age we have a sort of reviviscence, not, I fear, of the power, but of a taste for the power, of the early times."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e227be5-90a5-361b-8b88-8eb8fd64df03",
                        "entry_id": "28079474-39ef-367c-bbc9-d7e7e0a95a09",
                        "glosses": [
                            "Revival; renewal of force, validity, or effect."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "758377fb-70cc-4a55-986c-f90058c05ce3",
                                "sense_id": "8e227be5-90a5-361b-8b88-8eb8fd64df03",
                                "text": "But, what is still more serious, it goes apparently against the theological doctrine of the reviviscence of the Sacraments."
                            },
                            {
                                "example_id": "b464e680-72f4-4aff-bc94-20dd1a2fd741",
                                "sense_id": "8e227be5-90a5-361b-8b88-8eb8fd64df03",
                                "text": "Reviviscence means that, when this person converts and abandons sin, he will receive the special grace of the sacrament that was conferred."
                            }
                        ]
                    }
