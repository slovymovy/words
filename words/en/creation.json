                        "artistic creation",
                        "culinary creation",
                        "fashion creation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-либо созданное, например, изобретение или произведение искусства",
                        "zh": "被创造出来的东西，如发明、艺术品或作品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "творение",
