    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cb6f6dfb-ae02-36ce-adfc-32ca22da4978",
                "word": "zipline",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4b531f99-fc37-4b5b-b8ff-e0c4095ecf89",
                        "entry_id": "cb6f6dfb-ae02-36ce-adfc-32ca22da4978",
                        "tags": [
                            "plural"
                        ],
                        "form": "ziplines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "684bb31c-d6d7-39e5-aaff-5669478aeb2a",
                        "entry_id": "cb6f6dfb-ae02-36ce-adfc-32ca22da4978",
                        "glosses": [
                            "A pulley suspended on a cable mounted on an incline, designed to enable a user to travel from one point to another by means of gravity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5affc856-de9a-4133-b594-a2540bbe4898",
                                "sense_id": "684bb31c-d6d7-39e5-aaff-5669478aeb2a",
                                "text": "Outside the county towns of Lushui, Fugong, and Gongshan, few bridges span the Nu River Gorge, and most villagers cross the river by zipline cables or suspended footbridges to transport their crops or livestock to market. It is not uncommon to see sheep or cattle nervously thrashing about as they ride a zipline from one river bank to the other."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e900175-3ba2-3be3-8f90-eb0f7bb3d06b",
                        "entry_id": "cb6f6dfb-ae02-36ce-adfc-32ca22da4978",
                        "glosses": [
                            "A trip on a zipline."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0412f762-c5f0-47cb-aec0-bf18e002e7ec",
