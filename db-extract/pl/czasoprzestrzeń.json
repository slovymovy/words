                "senses": [
                    {
                        "sense_id": "da50ad1a-9ad6-35d4-a9f1-b638e3773c9f",
                        "entry_id": "5c8dcb13-6c26-38bb-aa49-ad6c3e4fc8a2",
                        "glosses": [
                            "matematyczny model opisujący czas i przestrzeń zgodnie z postulatami teorii względności"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eed0670d-c75d-4307-b8f5-95680b16ee9c",
                                "sense_id": "da50ad1a-9ad6-35d4-a9f1-b638e3773c9f",
                                "text": "Grawitacja jest konsekwencją krzywizny czasoprzestrzeni."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66ac056e-0204-47c6-829c-2ac06a56f93b",
                        "source_entry_id": "5c8dcb13-6c26-38bb-aa49-ad6c3e4fc8a2",
                        "source_sense_id": "da50ad1a-9ad6-35d4-a9f1-b638e3773c9f",
                        "target_lang_word": "spacetime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spacetime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16e69b8b-56e5-3e3b-af6c-6d41d8a16a83",
                                        "entry_id": "78db9c86-f4a2-3bfb-946b-29691be826c5",
                                        "glosses": [
                                            "The four-dimensional continuum of the three spatial dimensions plus time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7efebab4-cbec-449e-b404-1922421a8c42",
                                                "sense_id": "16e69b8b-56e5-3e3b-af6c-6d41d8a16a83",
                                                "text": "An event is a point in spacetime, specified by the coordinates x, y, z, and t."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efa421e4-a776-3251-a3cd-c8bb81b1d013",
                                        "entry_id": "78db9c86-f4a2-3bfb-946b-29691be826c5",
                                        "glosses": [
                                            "An n-dimensional continuum consisting of dimensions of both space and time. Normally spacetime is considered as having 4 dimensions (x, y, z, t), but higher-dimensional spacetimes are often encountered in theoretical physics, e.g. the 5-dimensional spacetime of Kaluza-Klein theory or the 11 dimensions of spacetime in M-theory."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "449834e5-d90b-4dec-9dd6-f49bbd03ff84",
                                                "sense_id": "efa421e4-a776-3251-a3cd-c8bb81b1d013",
                                                "text": "a Minkowski spacetime"
                                            },
                                            {
                                                "example_id": "19c21672-6a07-494e-9bc9-46f5323605ce",
                                                "sense_id": "efa421e4-a776-3251-a3cd-c8bb81b1d013",
                                                "text": "a 5-dimensional spacetime"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3e1a226-deda-30cf-af7c-be6646b5986e",
                                        "entry_id": "78db9c86-f4a2-3bfb-946b-29691be826c5",
                                        "glosses": [
                                            "A specific region of the universe with mathematically different properties than the surrounding spacetime. Synonymous with \\\"metric\\\" within the context of general relativity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ddca0af-1816-4592-b5a0-c9f59a4baa9c",
                                                "sense_id": "f3e1a226-deda-30cf-af7c-be6646b5986e",
                                                "text": "a Schwarzschild spacetime"
                                            },
                                            {
                                                "example_id": "23689b37-c434-4c81-8e00-92b84bbf842f",
                                                "sense_id": "f3e1a226-deda-30cf-af7c-be6646b5986e",
                                                "text": "a Reissner-Nordström spacetime"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "115d0b56-6cbf-4e28-9aa0-c57a451b50af",
                        "source_entry_id": "5c8dcb13-6c26-38bb-aa49-ad6c3e4fc8a2",
                        "source_sense_id": "da50ad1a-9ad6-35d4-a9f1-b638e3773c9f",
                        "target_lang_word": "space-time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "space-time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cee089b4-b1ce-3895-ba28-2df9d3d91b15",
                                        "entry_id": "b23b4838-612f-3a53-b42c-c74761d0b749",
                                        "glosses": [
                                            "Alternative form of spacetime."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3726fd3-a88c-4161-8ea9-c9a8de0b5bfc",
                                                "sense_id": "cee089b4-b1ce-3895-ba28-2df9d3d91b15",
                                                "text": "A mass effect drive core decreases the mass of a bubble of space-time around a ship. This gives the ship the potential to move quickly, but does not apply any motive power."
                                            },
                                            {
                                                "example_id": "9716e5b7-0e6f-4c6b-a6bb-edcb4d10d136",
                                                "sense_id": "cee089b4-b1ce-3895-ba28-2df9d3d91b15",
                                                "text": "Scientists have detected ripples in space-time from the violent collision of two massive black holes that spiralled into one another far beyond the distant edge of the Milky Way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bd370fa-a5a4-4e0c-87db-f095e3b66ad7",
                        "source_entry_id": "5c8dcb13-6c26-38bb-aa49-ad6c3e4fc8a2",
                        "source_sense_id": "da50ad1a-9ad6-35d4-a9f1-b638e3773c9f",
                        "target_lang_word": "space time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "98d52fb9-9a99-4678-9908-02babac538f5",
                        "source_entry_id": "5c8dcb13-6c26-38bb-aa49-ad6c3e4fc8a2",
                        "source_sense_id": "da50ad1a-9ad6-35d4-a9f1-b638e3773c9f",
                        "target_lang_word": "space-time continuum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fc25b771-6d80-4e07-a550-796d7567af89",
                        "source_entry_id": "5c8dcb13-6c26-38bb-aa49-ad6c3e4fc8a2",
                        "source_sense_id": "da50ad1a-9ad6-35d4-a9f1-b638e3773c9f",
                        "target_lang_word": "espace-temps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "espace-temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5740c5ce-c627-3681-85b4-4daeef76f8a2",
                                        "entry_id": "56a61278-523d-3eec-85c6-23e5d43a5fb9",
                                        "glosses": [
                                            "Continuum physique qui combine les trois dimensions de l’espace et le temps dans un même modèle topologique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecc7b59e-ac15-4979-992a-1d548313fb6f",
                                                "sense_id": "5740c5ce-c627-3681-85b4-4daeef76f8a2",
                                                "text": "De même les infortunés chrononautes de Temps mort (G. Langelaan) vieillissent en quelques minutes de plusieurs dizaines d'années : tel est le risque d’accident temporel qui attend les pionniers de l’espace-temps."
                                            },
                                            {
                                                "example_id": "c328b142-cc7c-480e-b6c1-0a4c07d6c6a9",
                                                "sense_id": "5740c5ce-c627-3681-85b4-4daeef76f8a2",
                                                "text": "L’espace-temps de la théorie de la relativité générale est un espace à quatre dimensions."
                                            },
                                            {
                                                "example_id": "cbddbcc5-cb45-4928-81b1-ac2a8dda793d",
                                                "sense_id": "5740c5ce-c627-3681-85b4-4daeef76f8a2",
                                                "text": "Ses pieds nus martelèrent le tapis de feu qui rougissait là, sautaient, revenaient chercher la brûlure au rythme des tambours et des chœurs déchirant l’espace-temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86133175-4a68-4635-99a6-46e2eeb9e743",
                        "source_entry_id": "5c8dcb13-6c26-38bb-aa49-ad6c3e4fc8a2",
                        "source_sense_id": "da50ad1a-9ad6-35d4-a9f1-b638e3773c9f",
                        "target_lang_word": "espacio-tiempo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "74d9f5df-74bc-4c1a-81b5-1c35ead9a71f",
                        "source_entry_id": "5c8dcb13-6c26-38bb-aa49-ad6c3e4fc8a2",
                        "source_sense_id": "da50ad1a-9ad6-35d4-a9f1-b638e3773c9f",
                        "target_lang_word": "Raumzeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raumzeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4276d78-ea58-3383-ae85-37f4e640fbd1",
                                        "entry_id": "6ddc32cb-e0af-3c65-9981-5bda6c245987",
                                        "glosses": [
                                            "durch die Relativitätstheorie vorhergesagte Vereinigung von Raum und Zeit in einer einheitlichen vierdimensionalen Struktur"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9be33d93-05e5-42c0-8090-a13c356b9228",
                                                "sense_id": "a4276d78-ea58-3383-ae85-37f4e640fbd1",
                                                "text": "„Doch als Einstein 1912 nach Zürich zurückkehrte, hatte er den glücklichen Einfall, dass die Äquivalenz gültig bliebe, wenn die Geometrie der Raumzeit nicht flach, wie bislang angenommen, sondern gekrümmt wäre. Er stellte sich vor, Masse und Energie verzerrten die Raumzeit in irgendeiner Weise, die es noch zu bestimmen galt. Unter dieser Prämisse würden Objekte wie Äpfel oder Planeten versuchen, sich in geradestmöglicher Weise durch die Raumzeit zu bewegen, doch schiene ihre Bahn ähnlich wie in Anwesenheit eines Newtonschen Gravitationsfeldes verbogen zu werden, weil die Raumzeit gekrümmt wäre (Abb.1.12).“"
                                            },
                                            {
                                                "example_id": "09ad3ad7-6cf8-450d-a77d-2d6cb393582b",
                                                "sense_id": "a4276d78-ea58-3383-ae85-37f4e640fbd1",
                                                "text": "„Die verlorene Zeit aber konnte sie nicht mehr aufholen. Einstein sei Dank: Mit Ringlasern lässt sich die Raumzeit verändern »Diese Uhr ist wie ein Zeitreisender aus der Vergangenheit, der zu uns in die Zukunft gekommen ist«, sagt Mallett. Einstein hatte also recht, allein die Richtung war falsch.“"
                                            },
                                            {
                                                "example_id": "b765cfc0-08ef-416e-a249-79093c5217c8",
                                                "sense_id": "a4276d78-ea58-3383-ae85-37f4e640fbd1",
                                                "text": "„Seine Theorie lässt sich folgendermaßen beschreiben: Alles im Universum bewegt sich durch die Raumzeit mit einer gleichen absoluten Geschwindigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
