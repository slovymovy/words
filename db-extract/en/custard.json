                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90da593d-219d-3615-97eb-6beb21f2dd8a",
                                        "entry_id": "0b353d4d-71d4-39a2-a215-ea781d076bd6",
                                        "glosses": [
                                            "Préparation onctueuse utilisée en pâtisserie à base de farine, de sucre, d'œuf et de lait."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d477847a-5126-4ff2-a8c4-39605e4953a0",
                                                "sense_id": "90da593d-219d-3615-97eb-6beb21f2dd8a",
                                                "text": "Et la vanille Bourbon, à la puissance aromatique enivrante, d’anoblir flans, macarons, riz au lait, tartes aux pommes, gaufres, crèmes pâtissières et autres vanillades."
                                            },
                                            {
                                                "example_id": "0e34967a-11ff-44cd-8ee9-96223eec59d8",
                                                "sense_id": "90da593d-219d-3615-97eb-6beb21f2dd8a",
                                                "text": "L’élément qui donnera le parfum est mélangé à un appareil de type béchamel, crème pâtissière ou purée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffb7d5de-d6ea-4745-9ca2-cb4d4edac3b1",
