                "senses": [
                    {
                        "sense_id": "4c5e87b8-d1b2-39aa-aa95-c598374f81cb",
                        "entry_id": "1d0de7dc-7dc1-3feb-bdda-6bde9491e46f",
                        "glosses": [
                            "lockere Masse aus kleinen Gasbläschen auf einem frisch eingeschenkten Bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c0557c5-d2e0-47cc-a673-46343ea31c49",
                                "sense_id": "4c5e87b8-d1b2-39aa-aa95-c598374f81cb",
                                "text": "Ich ließ das Bier zurückgehen, denn es war lauwarm und der Bierschaum war bereits zusammengefallen."
                            },
                            {
                                "example_id": "549f42f2-002a-490f-9d25-ce35b40b8725",
                                "sense_id": "4c5e87b8-d1b2-39aa-aa95-c598374f81cb",
                                "text": "„Jetzt verbrachte er den Tag damit, die für die Kurgäste bestimmten Getränke zu konsumieren. Er hatte einen gewaltigen Wachtmeister-Schnurrbart, an dem von früh bis abends der Bierschaum hing oder die süße Fettigkeit der Schnäpse.“"
                            },
                            {
                                "example_id": "6550702f-569c-486c-9531-fd9ece45f065",
                                "sense_id": "4c5e87b8-d1b2-39aa-aa95-c598374f81cb",
                                "text": "„Das Personal zeigt zwar im Moment noch die eine oder andere Unsicherheit bei urbayrischen Standards wie dem Bierschaum, aber solche Marginalien werden wohl bis zur offiziellen Eröffnung am morgigen Mittwoch wohl leicht zu beheben sein.“"
                            },
                            {
                                "example_id": "d854c4ec-cf51-4ff9-8303-5ade3914eaf7",
                                "sense_id": "4c5e87b8-d1b2-39aa-aa95-c598374f81cb",
                                "text": "„Er leckte sich nach jedem Schluck den Bierschaum von den Lippen, sah mich an, als wollte er mich jeden Augenblick ansprechen.“"
                            },
                            {
                                "example_id": "c9153549-ce86-422a-94eb-85b759bca932",
                                "sense_id": "4c5e87b8-d1b2-39aa-aa95-c598374f81cb",
                                "text": "„Der Bierschaum blieb auf dem Oberlippenbart hängen, und Elma verspürte einen starken Drang, sich nach vorne zu beugen und ihn mit dem Daumen wegzuwischen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
