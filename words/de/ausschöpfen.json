                        "leerschöpfen"
                    ],
                    "antonyms": [
                        "einfüllen",
                        "einschöpfen",
                        "hineingießen",
                        "hineinschöpfen"
                    ],
                    "common_phrases": [
                        "das Boot ausschöpfen",
                        "Wasser ausschöpfen"
                    ]
                }
            ]
