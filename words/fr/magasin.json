                    "frequency": "Middle",
                    "semantic_group_id": "stockage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le commerçant garde les produits en surplus dans son <w>magasin</w> de stockage."
                        },
                        {
                            "text": "Les cartons de pièces détachées restent dans le <w>magasin</w> jusqu'à la livraison."
