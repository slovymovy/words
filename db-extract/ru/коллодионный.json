                "senses": [
                    {
                        "sense_id": "77fa1d75-3b5d-3651-b0eb-ead5a57a859f",
                        "entry_id": "a0a67648-cc18-3479-9775-d6edb5c4f302",
                        "glosses": [
                            "хим. изготовленный на основе коллодия, либо имеющий к этому раствору иное непосредственное отношение; то же что коллодиальный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf4af2f3-7782-4602-bfed-3d8707e5e58d",
                                "sense_id": "77fa1d75-3b5d-3651-b0eb-ead5a57a859f",
                                "text": "Коллодионный процесс."
                            },
                            {
                                "example_id": "d3cf63d6-f948-410d-8604-c94964b46954",
                                "sense_id": "77fa1d75-3b5d-3651-b0eb-ead5a57a859f",
                                "text": "Коллодионный позитив."
                            },
                            {
                                "example_id": "65bf5b72-4372-401b-9858-764ff5902b1f",
                                "sense_id": "77fa1d75-3b5d-3651-b0eb-ead5a57a859f",
                                "text": "Коллодионная эмульсия не проявляется в сухом состоянии, поэтому съемку и обработку производят сразу после изготовления коллодионной фотопластинки."
                            }
                        ]
                    }
                ],
