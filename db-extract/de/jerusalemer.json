                "senses": [
                    {
                        "sense_id": "cf753cfa-f875-3709-8416-6fae661df4e1",
                        "entry_id": "d262f685-6ed3-3f06-88e2-4d23f15bed9f",
                        "glosses": [
                            "Einwohner von Jerusalem, in Jerusalem geborene Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53d21a3e-f4d5-464d-8eda-fe9ef0722d75",
                                "sense_id": "cf753cfa-f875-3709-8416-6fae661df4e1",
                                "text": "„Nachdem die Kommission ihr Büro in der Jerusalemer Jaffa Street eröffnet hatte, verwendeten die Mitglieder anfangs einen Großteil ihrer Energie auf die Bearbeitung der zahllosen Anfragen, mit denen die Juden, insbesondere die Jerusalemer, sie überschwemmten.“"
                            },
                            {
                                "example_id": "63b6aade-1d0e-42a2-b8a4-7b19729bfe48",
                                "sense_id": "cf753cfa-f875-3709-8416-6fae661df4e1",
                                "text": "„Beschlagnahmung von Land, Zerstörung von Häusern und Vertreibung von Jerusalemern, die nach israelischen Willkürentscheidungen ihren Wohnsitz verloren hatten, wurden immer häufiger.“"
                            },
                            {
                                "example_id": "72cb0935-48b0-40d3-8313-80be2f5da8c4",
                                "sense_id": "cf753cfa-f875-3709-8416-6fae661df4e1",
                                "text": "„1953 wurde in Jerusalem eine Flugschrift verbreitet, die gegen Kastner die schlimmsten Vorwürfe erhob. Verfasser war ein Malkiel Grünwald, ein älterer, allein zurückgebliebener Jerusalemer und mürrischer religiöser Extremist.“"
                            },
                            {
                                "example_id": "bab0f276-f54e-4921-b571-e4dc92a76d65",
                                "sense_id": "cf753cfa-f875-3709-8416-6fae661df4e1",
                                "text": "„Auch brachte der jordanische Staat ostentativ zum Ausdruck, dass auf die mit der besonderen Heiligkeit des Tempelbergs verbundenen Traditionen der palästinensischen Jerusalemer Rücksicht genommen werde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
