                "senses": [
                    {
                        "sense_id": "eaea8f18-2589-3f83-9280-953ef4add2ad",
                        "entry_id": "210051de-6c1a-30b0-825b-b9bb4f76d38d",
                        "glosses": [
                            "Verwaltungsakt, mit dem von 2005 bis 2022 in Deutschland eine Grundsicherungsleistung für erwerbsfähige Leistungsberechtigte (Arbeitslosengeld II) bewilligt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "575834d0-4d58-4757-8588-350620277e87",
                                "sense_id": "eaea8f18-2589-3f83-9280-953ef4add2ad",
                                "text": "„Folgende Unterlagen müssen Sie mit dem Antrag einreichen: • Bescheinigung ALG-II-Leistungsbescheid oder • beglaubigte Kopie über die Zahlung von Sozialhilfe oder • Bestätigung auf dem Befreiungsantrag.“"
                            },
                            {
                                "example_id": "9b358bde-1599-42e5-aed2-e896ea85985b",
                                "sense_id": "eaea8f18-2589-3f83-9280-953ef4add2ad",
                                "text": "„Eltern müssten vor den Ferien mit einem ALG-II-Leistungsbescheid zum jeweiligen Schulsekretariat kommen, wo die Bücher bestellt werden.“"
                            },
                            {
                                "example_id": "4f2231b0-4b69-4d23-9030-5214a06903a5",
                                "sense_id": "eaea8f18-2589-3f83-9280-953ef4add2ad",
                                "text": "„Als Bestätigung ist eine Bescheinigung, die Sie ab Juli 2009 zusammen mit dem ALG-II-Leistungsbescheid erhalten, einzureichen.“"
                            },
                            {
                                "example_id": "89f5138d-efd1-4885-adfa-9409c00491d3",
                                "sense_id": "eaea8f18-2589-3f83-9280-953ef4add2ad",
                                "text": "„Die GEZ benötigt jetzt nicht mehr den ALG-II-Leistungsbescheid zur Rundfunkgebührenbefreiung.“"
                            },
                            {
                                "example_id": "1805043d-d4f8-45a6-9076-a000ed216d8c",
                                "sense_id": "eaea8f18-2589-3f83-9280-953ef4add2ad",
                                "text": "„Es sind folgende Unterlagen bei der Antragstellung einzureichen: […] ALG-II-Leistungsbescheid mit Berechnungsbogen, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
