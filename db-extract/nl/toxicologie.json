                                        "entry_id": "6470322d-9200-331c-a3ee-31fc78c766da",
                                        "glosses": [
                                            "Wissenschaft, die sich mit der Wirkung von Giftstoffen und der Behandlung von Vergiftungen beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
