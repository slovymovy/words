                "senses": [
                    {
                        "sense_id": "cf3911eb-1ed8-37d4-a6d8-2dba5fa69b16",
                        "entry_id": "476cf629-0b75-32ae-a9b1-dc53021a26d3",
                        "glosses": [
                            "Person, die sich zur Kur in einem Ort aufhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be6857a8-950d-4421-9320-b770a4ee37e3",
                                "sense_id": "cf3911eb-1ed8-37d4-a6d8-2dba5fa69b16",
                                "text": "Die Kurgäste warteten auf den Beginn des Konzets."
                            },
                            {
                                "example_id": "b31da9bf-5ef2-420f-b78e-1d7c7b18e674",
                                "sense_id": "cf3911eb-1ed8-37d4-a6d8-2dba5fa69b16",
                                "text": "„Am Ende verwarf sie die Briefe und beschloss, an beide das gleiche Kärtchen zu schicken, in dem sie über die anderen Kurgäste spottete, die bei jeder Wolke gleich Regen fürchteten, die Salzwasser lobten, als sei es Champagner, und so unglaublich auf Äußerlichkeiten achteten, alle Stunde müsse man sein Kleid wechseln.“"
                            },
                            {
                                "example_id": "1a458f6d-6669-40db-8a3a-ec8226549bd1",
                                "sense_id": "cf3911eb-1ed8-37d4-a6d8-2dba5fa69b16",
                                "text": "„Um sechs Uhr morgens begannen die Kurgäste ihre Spaziergänge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
