                "forms": [
                    {
                        "form_id": "ca0a6482-0ff5-47db-9ee0-131656284b1f",
                        "entry_id": "73969ade-9efc-3fb2-aa60-46a1df6d7ed3",
                        "tags": [
                            "plural"
                        ],
                        "form": "feedbacks"
                    },
                    {
                        "form_id": "f74461a4-81dd-4d53-8be2-efbf41c0417f",
                        "entry_id": "73969ade-9efc-3fb2-aa60-46a1df6d7ed3",
                        "tags": [],
                        "form": "feed-back"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "30d6e8ca-cc78-30a7-a809-9be25a507333",
                        "entry_id": "73969ade-9efc-3fb2-aa60-46a1df6d7ed3",
                        "glosses": [
                            "Mécanisme par lequel une partie de la sortie d’un système est réinjectée à l’entrée pour influer sur son comportement (stabilisation, correction d’erreur, etc.)."
                        ],
                        "tags": [
                            "Automatique",
                            "Sciences de l’ingénieur"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ea16e275-c8fa-3591-a316-1b8671a6b04e",
                        "entry_id": "73969ade-9efc-3fb2-aa60-46a1df6d7ed3",
                        "glosses": [
                            "Retour adressé à une personne ou à un groupe sur une action, une production ou un comportement (commentaire, évaluation, signal de confirmation)."
                        ],
                        "tags": [
                            "Communication",
                            "Expérience d’usage"
                        ],
                        "examples": [
                            {
                                "example_id": "3517c644-3661-4948-ae3f-8dcea0b35380",
                                "sense_id": "ea16e275-c8fa-3591-a316-1b8671a6b04e",
                                "text": "La palette est très large. Mais pour chacun d’entre vous, tout doit être clair. Nous voulons donc tout simplifier. Et c’est pour cela que vos feedbacks sont hyper précieux."
                            },
                            {
                                "example_id": "ac64727d-6278-48eb-9e58-efd1131bdf2c",
                                "sense_id": "ea16e275-c8fa-3591-a316-1b8671a6b04e",
                                "text": "Un feedback honnête et bienveillant peut transformer un bon baiser en un moment inoubliable."
                            }
                        ]
                    },
                    {
                        "sense_id": "433833d1-4856-3c32-b2c6-d107d2d26efa",
                        "entry_id": "73969ade-9efc-3fb2-aa60-46a1df6d7ed3",
                        "glosses": [
                            "Réinjection du son amplifié dans le micro, produisant un sifflement."
                        ],
                        "tags": [
                            "Acoustique",
                            "Sonorisation"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fd69a8de-57bb-3950-852d-b48e22391555",
                        "entry_id": "73969ade-9efc-3fb2-aa60-46a1df6d7ed3",
                        "glosses": [
                            "Mécanisme de régulation où un produit d’une voie physiologique module l’activité de cette même voie."
                        ],
                        "tags": [
                            "Endocrinologie"
                        ],
                        "examples": [
                            {
                                "example_id": "89376af0-8d31-46a0-b426-4b8fb3b88e4d",
                                "sense_id": "fd69a8de-57bb-3950-852d-b48e22391555",
                                "text": "Ce feedback est la base de la contraception, les pilules augmentant les taux sanguins d'œstrogènes ou d'œstrogènes et progestérone, et freine les GnRH en bloquant la production de FSH et LH, et donc celle des œstrogènes et de la progestérone, inhibant l'ovulation sans répercussion sur l’endomètre qui reste stimulé par les stéroïdes même de la pilule."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9900aa2-adf7-49b8-b5ca-02eb4bc3ff75",
                        "source_entry_id": "73969ade-9efc-3fb2-aa60-46a1df6d7ed3",
                        "target_lang_word": "Feedback",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feedback",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8334e2ab-8994-3ae9-97ba-955ac4840ab6",
                                        "entry_id": "b014da7c-9542-3790-a790-280374a8212b",
                                        "glosses": [
                                            "Bekanntgabe einer Wahrnehmung oder die Beurteilung von etwas, die wiederum zur Veränderung bzw. Verbesserung dieser Sache genutzt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b72b744-7f70-4ad2-8634-9a232a4f6b4f",
                                                "sense_id": "8334e2ab-8994-3ae9-97ba-955ac4840ab6",
                                                "text": "Neuerdings haben die Wiktionary-Nutzer eine einfache Möglichkeit, den Wiktionary-Mitarbeitern ein Feedback zu den Einträgen zu geben."
                                            },
                                            {
                                                "example_id": "9c52726a-8e68-4061-846f-47606e8df8b8",
                                                "sense_id": "8334e2ab-8994-3ae9-97ba-955ac4840ab6",
                                                "text": "„Während sich eine Korrektur oft auf die Alternative richtig versus falsch (in Bezug auf die normierte Standardsprache) bezieht, dient ein Feedback der Hilfe zur Selbsthilfe.“"
                                            },
                                            {
                                                "example_id": "95a0d4fb-cc9a-4c41-aedd-d18d4b6ce0ad",
                                                "sense_id": "8334e2ab-8994-3ae9-97ba-955ac4840ab6",
                                                "text": "„Die anwesenden Kolleginnen und Kollegen gaben intensives Feedback, das wiederum in die zweite Auflage einfloss.“"
                                            },
                                            {
                                                "example_id": "57a26415-0595-46bc-bb99-2637450a7814",
                                                "sense_id": "8334e2ab-8994-3ae9-97ba-955ac4840ab6",
                                                "text": "„Auf diese Weise hatten wir ein schönes Feedback und lösten die Einseitigkeit des Witzeerzählens von der Bühne herab zu einer Art kommunikativem Stammtisch auf, jedenfalls in Ansätzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05234362-c9f3-44e1-9be5-72f2c821b70b",
                        "source_entry_id": "73969ade-9efc-3fb2-aa60-46a1df6d7ed3",
                        "target_lang_word": "feedback",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
