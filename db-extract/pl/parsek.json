                                "target_senses": [
                                    {
                                        "sense_id": "2d41dcf7-3be7-3d77-89a7-947b08dd49b9",
                                        "entry_id": "d7351811-b327-3da6-a77b-fbec49cdfa06",
                                        "glosses": [
                                            "Syllabic abbreviation of parallax second."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1493a8e3-a196-408e-b707-ac479441a8d0",
                                                "sense_id": "2d41dcf7-3be7-3d77-89a7-947b08dd49b9",
                                                "text": "Han Solo: Fast ship? You've never heard of the Millennium Falcon?\nObi-Wan \"Ben\" Kenobi: Should I have?\nHan Solo: It's the ship that made the Kessel Run in less than twelve parsecs. I've outrun Imperial starships. Not the local bulk cruisers mind you, I'm talking about the big Corellian ships now. She's fast enough for you old man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f631e297-3c80-4744-8284-9f86f79166db",
                        "source_entry_id": "f5f3b936-9fbe-334b-bc3a-7506fc1c1d77",
                        "source_sense_id": "8568ba5f-3f00-37a3-ae54-63ecc6c5e05e",
                        "target_lang_word": "pársec",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pársec",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "212d8612-9010-3ad8-9ed8-21acbe78aa9a",
                                        "entry_id": "5c097676-bf3d-3bed-aaa1-749f09aa0c6c",
                                        "glosses": [
                                            "Unidad de longitud, definida como la distancia a la que una unidad astronómica (ua) subtiende un ángulo de un segundo de arco (1″), 1 pársec = 206.265 ua = 3,2616 años luz = 30,857 × 10¹⁶ m."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4fd366e-5e9d-4603-93e1-5131dfd3b290",
                                                "sense_id": "212d8612-9010-3ad8-9ed8-21acbe78aa9a",
                                                "text": "Debido al movimiento de traslación de la Tierra podemos ver un movimiento en las estrellas más cercanas. A ese movimiento se le llama paralaje. A una distancia de un pársec el ángulo que formaría la estrella respecto a los meses de enero y julio es de 2 segundos de arco"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2dfbdcd-cea6-448f-b9b4-6ee764c4e91d",
                        "source_entry_id": "f5f3b936-9fbe-334b-bc3a-7506fc1c1d77",
                        "source_sense_id": "8568ba5f-3f00-37a3-ae54-63ecc6c5e05e",
