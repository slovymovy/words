                                            "Polizei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0934d42-7102-450c-9bbf-8cdc192a197f",
                                                "sense_id": "811366d0-dc9c-3575-9a86-ef11a551cd4c",
                                                "text": "„Ein Wachtmeister scheuchte die Wartenden auf den Gehsteig zurück.“"
                                            },
                                            {
                                                "example_id": "f5c15912-f8d0-47d8-879d-0a160534cc57",
                                                "sense_id": "811366d0-dc9c-3575-9a86-ef11a551cd4c",
                                                "text": "„Unschlüssig steckt der Wachtmeister den Notizblock wieder weg.“"
                                            }
