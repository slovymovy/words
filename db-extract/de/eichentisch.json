                "senses": [
                    {
                        "sense_id": "a2b25568-1c2a-3b1d-8ac8-5bd2d22a6bdf",
                        "entry_id": "f14a3bd8-8129-34ad-bd91-613db6d11b76",
                        "glosses": [
                            "Tisch, hergestellt aus Eichenholz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d645813-139a-44a5-8858-6af8f5c2d0ee",
                                "sense_id": "a2b25568-1c2a-3b1d-8ac8-5bd2d22a6bdf",
                                "text": "Gemeinsam trugen wir den schweren Eichentisch in die Wohnung."
                            },
                            {
                                "example_id": "5854a6dc-11d6-4bb7-8fbb-dfa40da79653",
                                "sense_id": "a2b25568-1c2a-3b1d-8ac8-5bd2d22a6bdf",
                                "text": "„Es handelt sich um einen massiven, zentnerschweren Eichentisch.“"
                            },
                            {
                                "example_id": "60f1121a-0972-42ef-97bc-44d4bd95dba1",
                                "sense_id": "a2b25568-1c2a-3b1d-8ac8-5bd2d22a6bdf",
                                "text": "„Sie gingen zusammen in ein großes Gasthaus, wo man vor mächtigen Eichentischen saß, die meisten in Uniform, und viel trank.“"
                            },
                            {
                                "example_id": "d1ccb8e7-ec3a-4a14-a4eb-d5775a6a3b4b",
                                "sense_id": "a2b25568-1c2a-3b1d-8ac8-5bd2d22a6bdf",
                                "text": "„In sentimentalen Momenten spricht mein Vater gerne von dem langen Eichentisch, an dem seiner kindlichen Erinnerung nach stets unzählige Erwachsene saßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
