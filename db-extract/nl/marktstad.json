                        "glosses": [
                            "een stad die volgens de wet marktrechten had"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "852c57b9-0e84-4dc2-93d8-9fbcf5abba89",
                                "sense_id": "8e1bc9b1-416c-3aea-b755-381d960ca858",
                                "text": "Recent waren we op bezoek in Dumfries, een marktstadje net over de Schotse grens. Daar trok een tamelijk berooide Burns op jonge leeftijd naar toe. Hij kocht een boerderijtje en trachtte zijn leven in het gareel te krijgen. Dat lukte niet. Hij boerde er slecht en was vaker in de kroeg te vinden dan op zijn stukje land."
                            },
                            {
                                "example_id": "b5e90ea8-3e18-4643-9b64-6b358f61d624",
                                "sense_id": "8e1bc9b1-416c-3aea-b755-381d960ca858",
                                "text": "Ook met Chinezen was het nog nooit zo druk. Met haar regionale centrumfunctie is Schagen, van oudsher een marktstad met levendig hart, voor veel fietsers een logisch vertrek- en eindpunt."
                            }
                        ]
                    }
