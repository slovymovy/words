                ],
                "senses": [
                    {
                        "sense_id": "6440efc4-577c-365a-881b-989d3a3607df",
                        "entry_id": "9280094e-be72-3e70-9cca-8ddc8f4c7b59",
                        "glosses": [
                            "Bischof, der zugleich Fürst (Landesherr) war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "252f3331-c64c-4a75-87a3-88272fe6445b",
                                "sense_id": "6440efc4-577c-365a-881b-989d3a3607df",
                                "text": "„Mit unerhörtem Freimut redet hier ein einfacher Ordensgeistlicher den Kurfürsten, Fürstbischöfen und ihren Beichtvätern ins Gewissen.“"
                            },
                            {
                                "example_id": "45a63be9-b5ee-4d51-b1c5-77fb1c25f2da",
                                "sense_id": "6440efc4-577c-365a-881b-989d3a3607df",
                                "text": "„Vielleicht ist dieser Lampe nicht nur ein Mitarbeiter Kants, argwöhnt er, sondern auch beauftragt vom hiesigen Fürstbischof zu überprüfen, ob er, Papin, mit den Geldern auch angemessen umgehe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9f89c68-05d8-4003-87c2-580c47d222e4",
                        "source_entry_id": "9280094e-be72-3e70-9cca-8ddc8f4c7b59",
                        "source_sense_id": "6440efc4-577c-365a-881b-989d3a3607df",
