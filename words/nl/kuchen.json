    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "314e51d9-e6a5-331f-ad51-21af5588667b",
                    "sense_definition": "Kort en zacht hoesten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>kuchte</w> even discreet om de aandacht te trekken.",
                            "target_lang_translations": {
                                "en": "He <w>coughed</w> quietly to attract attention."
                            }
                        },
                        {
                            "text": "Door de stoffige lucht moest iedereen in de zaal <w>kuchen</w>.",
                            "target_lang_translations": {
                                "en": "Because of the dusty air, everyone in the hall had to <w>cough</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoesten"
                    ],
                    "common_phrases": [
                        "discreet kuchen",
                        "zachtjes kuchen"
                    ],
                    "target_lang_definitions": {
                        "en": "To cough briefly and softly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cough quietly",
                                "target_lang_sense_clarification": "to clear one's throat or cough softly"
                            },
                            {
                                "target_lang_word": "cough",
                                "target_lang_sense_clarification": "to expel air briefly from the lungs"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "816f0381-2162-34b2-86be-374fa8d533cc",
                    "sense_definition": "Meervoud van <w>kuch</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten kregen enkele droge <w>kuchen</w> als maaltijd.",
                            "target_lang_translations": {
                                "en": "The soldiers received a few dry <w>loaves of bread</w> as a meal."
                            }
                        },
                        {
                            "text": "Er lagen nog een paar oude <w>kuchen</w> in de kast.",
                            "target_lang_translations": {
                                "en": "There were still a few old <w>army loaves</w> lying in the cupboard."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of 'kuch' (hard dry bread or army bread; or a cough)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "loaves of hard army bread",
                                "target_lang_sense_clarification": "plural of 'kuch', referring to dry ration bread"
                            }
                        ]
                    }
                }
            ]
        }
    ]
