                "senses": [
                    {
                        "sense_id": "bff7812e-9908-34c5-bab6-b7ea77df6630",
                        "entry_id": "ebba2c0d-37de-3259-97b9-5c5384baac55",
                        "glosses": [
                            "Person, die Mitglied einer Sprachgemeinschaft ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "985e015e-6a37-4262-8457-dcc061b7b795",
                                "sense_id": "bff7812e-9908-34c5-bab6-b7ea77df6630",
                                "text": "„Irgendwie ist klar, daß wir unsere Botschaften sprachlich kodieren müssen, damit die anderen Sprachteilnehmer sie überhaupt erfahren können.“"
                            },
                            {
                                "example_id": "2330925a-8b83-4c9c-95f2-e8979a6e1ea7",
                                "sense_id": "bff7812e-9908-34c5-bab6-b7ea77df6630",
                                "text": "„Welches ist die Einstellung der Sprachteilnehmer gegenüber Transferenzen im Sinne einer Sprachloyalität zur Muttersprache oder zur Fremdsprache?“"
                            },
                            {
                                "example_id": "2dcd5ec9-edeb-4ca3-bb3e-52273904718d",
                                "sense_id": "bff7812e-9908-34c5-bab6-b7ea77df6630",
                                "text": "„Aber auch dann können die Absichten der Sprachteilnehmer in konkreten Situationen mit den oben beschriebenen Methoden nicht erfasst werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
