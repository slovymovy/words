                "senses": [
                    {
                        "sense_id": "60b979d2-ed03-31c3-8a02-ba752251bc2d",
                        "entry_id": "b241d2ad-2fa6-388c-8440-685111d5a6e8",
                        "glosses": [
                            "to become tipsy"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "747fa61d-de68-4d19-9d90-313a73b41f2e",
                                "sense_id": "60b979d2-ed03-31c3-8a02-ba752251bc2d",
                                "text": "Оттого́, что он мно́го пил и посолове́л, и, быть мо́жет, оттого́, что он ра́за два был уличё́н во лжи, мужики́ не обраща́ли на него́ никако́го внима́ния и да́же переста́ли отвеча́ть на его́ вопро́сы.",
                                "translation": "Either because he had drunk a great deal and was a little tipsy, or perhaps because he had twice been detected in a lie, the peasants took not the slightest notice of him, and even left off answering his questions.",
                                "english": "Either because he had drunk a great deal and was a little tipsy, or perhaps because he had twice been detected in a lie, the peasants took not the slightest notice of him, and even left off answering his questions."
                            }
                        ]
                    }
