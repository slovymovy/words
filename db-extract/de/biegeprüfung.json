                "senses": [
                    {
                        "sense_id": "174bc310-56fd-3e86-b8f4-71b1926e7427",
                        "entry_id": "64db5d2d-dde5-3ccd-9c4b-c54e4e83a1de",
                        "glosses": [
                            "Prüfung, bei der ein Prüfkörper einer Biegebeanspruchung ausgesetzt wird"
                        ],
                        "tags": [
                            "Werkstoffprüfung"
                        ],
                        "examples": [
                            {
                                "example_id": "d124dc38-6a76-4a24-ba01-0b90b4fb23e2",
                                "sense_id": "174bc310-56fd-3e86-b8f4-71b1926e7427",
                                "text": "Die Biegeprüfung gehört zu den zerstörenden Werkstoffprüfungen."
                            },
                            {
                                "example_id": "a1a7d53b-05fe-4f7d-9c9d-9715cb5f5356",
                                "sense_id": "174bc310-56fd-3e86-b8f4-71b1926e7427",
                                "text": "„Zur Qualitätssicherung des sortierten Holzes ist eine Biegeprüfung mit einer einfachen Biegeprüfvorrichtung vorgesehen, wie sie in Holzleimbaubetrieben zur routinemäßigen Prüfung von Keilzinkenverbindungen bereits verwendet wird.“"
                            },
                            {
                                "example_id": "8136d208-9c30-4f96-90e6-f3116d721591",
                                "sense_id": "174bc310-56fd-3e86-b8f4-71b1926e7427",
                                "text": "„Bisher bekannte Verfahren zur Prüfung von Masten mittels Biegeprüfung haben sich in der Praxis kaum bewährt, da sie zu keinen einheitlichen Aussagen über den Zustand der Standsicherheit von Mastsystemen geführt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
