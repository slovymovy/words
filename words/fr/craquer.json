                    ]
                },
                {
                    "sense_id": "cf4bc001-652d-3a5b-a873-6f79b794201d",
                    "sense_definition": "Forcer ou fracturer une porte ou un coffre avec brutalité lors d'une effraction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "argot_cambriolage",
                    "name_type": "no",
                    "examples": [
