                        "entry_id": "88b5ffaf-002a-3bb0-be68-001b9183d1ea",
                        "glosses": [
                            "Of a dog, to bark."
                        ],
                        "tags": [
                            "Internet",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "517c65c3-1b5e-4e9e-9240-89d7b7a7ad12",
                                "sense_id": "ca7188bc-9890-32c6-8d2e-c5f24329837d",
                                "text": "And now, a Doge can bork — Tumblr doggo slang for barking or being aggressive."
                            },
                            {
                                "example_id": "45a5f5d4-5be3-4d35-8eba-27f536c91dd1",
                                "sense_id": "ca7188bc-9890-32c6-8d2e-c5f24329837d",
                                "text": "Dogs become “doggo”, “floofs” and “puppers” and they “bork” rather than bark."
                            }
                        ]
                    }
                ],
