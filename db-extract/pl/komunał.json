                    {
                        "translation_id": "378a14ed-bc9a-4a7e-9b73-30b8fa4650ca",
                        "source_entry_id": "6d3da717-c801-305e-bb91-dd226b387055",
                        "source_sense_id": "a54f8077-aa12-3727-999b-7a43454c3a57",
                        "target_lang_word": "cliché",
                        "target_lang_code": "en",
