                    {
                        "sense_id": "0a5ee334-54c3-39d0-bfbb-4095fb8b8ad4",
                        "entry_id": "8fb8f28a-574c-3672-97dc-941f3ece37e6",
                        "glosses": [
                            "The state or quality of being red."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "22253dd2-13b9-4de8-9d4b-24db4cb4743a",
                                "sense_id": "0a5ee334-54c3-39d0-bfbb-4095fb8b8ad4",
                                "text": "Nancy Reagan is famous for the redness of her wardrobe."
                            }
                        ]
                    },
                    {
                        "sense_id": "659b6dd9-9529-3343-b6b8-95255ad12b01",
                        "entry_id": "8fb8f28a-574c-3672-97dc-941f3ece37e6",
                        "glosses": [
                            "A red discoloration, especially of skin."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c6cc7084-60c3-47c7-a50b-8ed514cc0c71",
                                "sense_id": "659b6dd9-9529-3343-b6b8-95255ad12b01",
                                "text": "Redness and swelling are associated with certain superficial infections."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b80e24c-a026-4643-b400-9b9b2cc57845",
                        "source_entry_id": "8fb8f28a-574c-3672-97dc-941f3ece37e6",
                        "source_sense_description": "quality of being red",
                        "target_lang_word": "roodheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roodheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "92cd2eb0-a69f-324d-b21a-aa0fb7e35544",
                                        "entry_id": "30637911-5b35-3c6b-90f7-2ce5c39b4b38",
                                        "glosses": [
                                            "rode kleurverandering van de huid, ontstaan als gevolg van vaatverwijding"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2f3c6d5-602c-4b6b-b367-23a22ff443ac",
                                                "sense_id": "92cd2eb0-a69f-324d-b21a-aa0fb7e35544",
                                                "text": "De komende dagen ligt de zonkracht in Amsterdam waarschijnlijk rond de vijf, waarbij de huid al na twintig minuten kan verbranden. Bij zonkracht drie kan een ongewende huid na 35 minuten in de zon verbranden. De roodheid en pijn ontstaan echter pas uren later."
                                            },
                                            {
                                                "example_id": "a291df97-12f2-4e5c-9baa-2166351989a2",
                                                "sense_id": "92cd2eb0-a69f-324d-b21a-aa0fb7e35544",
                                                "text": "Om goed te kunnen onderzoeken hoe de huid er 'van binnen' uitziet is er een soort van digitaal fototoestel waar je met het hoofd in gaat. Op het scherm wordt dan heel schematisch en confronterend zichtbaar waar de roodheid (couperose) zit, hoe het met de UV-vlekken gesteld is (sproeten, pigmentvlekken), rimpels en nog zo wat ontnuchterende zaken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a04ab92-8f27-4090-aafa-c244f1bd1e30",
                        "source_entry_id": "8fb8f28a-574c-3672-97dc-941f3ece37e6",
                        "source_sense_description": "quality of being red",
                        "target_lang_word": "rougeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rougeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "224530c7-1962-3d50-9a2d-583441250cd6",
                                        "entry_id": "77c96cf1-c55a-3049-8761-10339700351c",
                                        "glosses": [
                                            "Couleur rouge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f78e829-797b-427b-a7ce-36cb0deb2612",
                                                "sense_id": "224530c7-1962-3d50-9a2d-583441250cd6",
                                                "text": "Elle rougit positivement et une flamme brilla dans ses grands yeux bleus.\nLa rougeur passa vite et la flamme s'éteignit aussitôt."
                                            },
                                            {
                                                "example_id": "3151dfc6-c1fd-4ff9-b8a2-ffd496fdc38f",
                                                "sense_id": "224530c7-1962-3d50-9a2d-583441250cd6",
                                                "text": "Après avoir dépassé Mazerny, les véhicules avaient emprunté les chemins de terre et les bois. Le bruit du canon se rapprochait de plus en plus et au loin, Malétras apercevait des rougeurs et des fusées."
                                            },
                                            {
                                                "example_id": "aa811596-f200-45aa-b6ae-c3cdbb12fd1d",
                                                "sense_id": "224530c7-1962-3d50-9a2d-583441250cd6",
                                                "text": "La rougeur des joues, des lèvres."
                                            },
                                            {
                                                "example_id": "102e8ac0-14bf-4e74-8da8-16554c1f84ef",
                                                "sense_id": "224530c7-1962-3d50-9a2d-583441250cd6",
                                                "text": "La rougeur lui est montée au visage."
                                            },
                                            {
                                                "example_id": "0706d63d-0eb1-41e9-9d22-1833bd4e77d3",
                                                "sense_id": "224530c7-1962-3d50-9a2d-583441250cd6",
                                                "text": "La rougeur du ciel, quand le soleil se couche ou se lève."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8f70037-92ee-3146-bf00-c2599afafa13",
                                        "entry_id": "77c96cf1-c55a-3049-8761-10339700351c",
                                        "glosses": [
                                            "Taches rouges qui viennent au visage et en général sur la peau."
                                        ],
                                        "tags": [
                                            "Surtout au pluriel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38223435-746a-4d57-9851-330130468010",
                                                "sense_id": "f8f70037-92ee-3146-bf00-c2599afafa13",
                                                "text": "Il lui est venu des rougeurs au front."
                                            },
                                            {
                                                "example_id": "ea7125b2-8bac-417a-89b0-e3891c7182b1",
                                                "sense_id": "f8f70037-92ee-3146-bf00-c2599afafa13",
                                                "text": "Elle a des rougeurs au visage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f7e40b3-ea3a-485a-9e4a-9561f06ce358",
                        "source_entry_id": "8fb8f28a-574c-3672-97dc-941f3ece37e6",
                        "source_sense_description": "quality of being red",
                        "target_lang_word": "Röte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Röte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93fc005d-7d5c-38d2-a58f-f9b9a5580a73",
                                        "entry_id": "cc3ee2ac-9758-39a5-b007-55ab65d3b183",
                                        "glosses": [
                                            "rote Färbung, die rote Farbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88369fc5-941c-4284-8adc-6d4418b6e872",
                                                "sense_id": "93fc005d-7d5c-38d2-a58f-f9b9a5580a73",
                                                "text": "Die Röte ist aber ein recht stabiles Merkmal dieser Pflanzen, deren Sämlinge ebenfalls oft Rot sind (Johnson 1973)."
                                            },
                                            {
                                                "example_id": "e6f14530-93db-40f2-8655-33461dd84d10",
                                                "sense_id": "93fc005d-7d5c-38d2-a58f-f9b9a5580a73",
                                                "text": "Bei manchen Personen tritt nach dem Essen, vor allem nach dem reichlichen Genuss von Speisen, eine starke Röte im Gesicht auf."
                                            },
                                            {
                                                "example_id": "766c1911-09dc-4e37-b383-39d3caf76972",
                                                "sense_id": "93fc005d-7d5c-38d2-a58f-f9b9a5580a73",
                                                "text": "„Die Nacht war hell vom ersten Schneefall des Winters, und die fleckige Röte, die an den Wangen der Mama hochstieg, war gut zu erkennen.“"
                                            },
                                            {
                                                "example_id": "900b3085-4f2a-4fd6-a23e-da3630ffde8d",
                                                "sense_id": "93fc005d-7d5c-38d2-a58f-f9b9a5580a73",
                                                "text": "„Als aber am Sonntag nach dem Hochamt der Diener im Salon meldete, Graf Rostow sei da, liess die Prinzessin sich doch keine Verwirrung oder Verlegenheit anmerken; nur eine leichte Röte trat ihr auf die Wangen, und ihre Augen gewannen einen neuen, leuchtenden Glanz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e2b7b7d0-adb5-3a0f-8373-770f754de82d",
                                        "entry_id": "cc3ee2ac-9758-39a5-b007-55ab65d3b183",
                                        "glosses": [
                                            "als Kraut wachsendes Rötegewächs mit grünlich gelben Blüten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9df05741-4626-4abf-9d64-1301375cbe09",
                                                "sense_id": "e2b7b7d0-adb5-3a0f-8373-770f754de82d",
                                                "text": "Zu den Rötegewächsen gehören Nutz- und Kulturpflanzen, u. a. Kaffeestrauch, Brechwurzel, Chinarindenbaum, Yohimbinbaum sowie Gambir und Röte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
