{
    "word_family": [
        "segregate",
        "segregation",
        "segregationist",
        "desegregate",
        "desegregation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "96aad2c7-cbc1-3798-8617-f4694966c003",
                    "sense_definition": "Characterized by enforced separation of different groups of people, especially based on race, religion, or gender.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country ended its policy of maintaining <w>segregated</w> schools in the late twentieth century.",
                            "target_lang_translations": {
                                "nl": "Het land beëindigde eind twintigste eeuw het beleid van <w>gesegregeerde</w> scholen."
                            }
                        },
                        {
                            "text": "They grew up in a heavily <w>segregated</w> society with limited interactions between communities.",
                            "target_lang_translations": {
                                "nl": "Ze groeiden op in een sterk <w>gesegregeerde</w> samenleving met weinig interactie tussen gemeenschappen."
                            }
                        }
                    ],
                    "synonyms": [
                        "divided"
                    ],
                    "antonyms": [
                        "integrated",
                        "desegregated"
                    ],
                    "common_phrases": [
                        "segregated schools",
                        "segregated society",
                        "racially segregated"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gekenmerkt door het gedwongen gescheiden houden van verschillende bevolkingsgroepen, met name op basis van ras, religie of geslacht."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gesegregeerd",
                                "target_lang_sense_clarification": "gekenmerkt door rassenscheiding of sociale scheiding"
                            },
                            {
                                "target_lang_word": "gescheiden",
                                "target_lang_sense_clarification": "uit elkaar gehouden van bevolkingsgroepen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "378ce1d5-3fac-3330-838c-bf280b267dc1",
                    "sense_definition": "Separated, set apart, or isolated from others or from a general group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city established a <w>segregated</w> cycle lane to keep cyclists safe from traffic.",
                            "target_lang_translations": {
                                "nl": "De stad legde een <w>vrijliggend</w> fietspad aan om fietsers te beschermen tegen het verkeer."
                            }
                        },
                        {
                            "text": "Hazardous materials must be kept in a completely <w>segregated</w> storage area.",
                            "target_lang_translations": {
                                "nl": "Gevaarlijke stoffen moeten in een volledig <w>gescheiden</w> opslagruimte worden bewaard."
                            }
                        }
                    ],
                    "synonyms": [
                        "separated",
                        "isolated"
                    ],
                    "antonyms": [
                        "integrated",
                        "combined"
                    ],
                    "common_phrases": [
                        "segregated accounts",
                        "segregated funds",
                        "segregated bike lane"
                    ],
                    "target_lang_definitions": {
                        "nl": "Afgezonderd, apart gehouden of geïsoleerd van andere zaken of van het geheel."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gescheiden",
                                "target_lang_sense_clarification": "fysiek of functioneel apart gehouden"
                            },
                            {
                                "target_lang_word": "afgezonderd",
                                "target_lang_sense_clarification": "geïsoleerd van de rest"
                            },
                            {
                                "target_lang_word": "vrijliggend",
                                "target_lang_sense_clarification": "van fietspaden of banen, fysiek los van het verkeer"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22ff84a9-5242-3910-a60a-6540dc46c93a",
                    "sense_definition": "Simple past and past participle of <w>segregate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clinic <w>segregated</w> infectious patients from the rest of the waiting room.",
                            "target_lang_translations": {
                                "nl": "De kliniek <w>zonderde</w> besmettelijke patiënten <w>af</w> van de rest van de wachtkamer."
                            }
                        },
                        {
                            "text": "Past policies <w>segregated</w> the population into distinct geographic areas.",
                            "target_lang_translations": {
                                "nl": "Vroeger beleid <w>scheidde</w> de bevolking in verschillende geografische gebieden."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd of voltooid deelwoord van 'segregate' (segregeren, scheiden of afzonderen)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "scheidde",
                                "target_lang_sense_clarification": "verleden tijd van scheiden"
                            },
                            {
                                "target_lang_word": "zonderde af",
                                "target_lang_sense_clarification": "verleden tijd van afzonderen"
                            },
                            {
                                "target_lang_word": "gesegregeerd",
                                "target_lang_sense_clarification": "voltooid deelwoord van segregeren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}