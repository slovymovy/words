{
    "word_family": [
        "gebeuren",
        "gebeurtenis"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "40778610-ad9e-384b-9dbf-c405d6b53983",
                    "sense_definition": "Enkelvoud verleden tijd van <w>gebeuren</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verleden_tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niemand wist precies wat er die avond <w>gebeurde</w> in het oude huis.",
                            "target_lang_translations": {
                                "en": "Nobody knew exactly what <w>happened</w> that night in the old house."
                            }
                        },
                        {
                            "text": "Het <w>gebeurde</w> plotseling toen we rustig op de bus stonden te wachten.",
                            "target_lang_translations": {
                                "en": "It <w>happened</w> suddenly while we were quietly waiting for the bus."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wat er gebeurde",
                        "het gebeurde plotseling"
                    ],
                    "target_lang_definitions": {
                        "en": "Singular past tense of 'gebeuren' (to happen, occur)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "happened",
                                "target_lang_sense_clarification": "took place in the past"
                            },
                            {
                                "target_lang_word": "occurred",
                                "target_lang_sense_clarification": "took place, especially unexpectedly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd3a126e-8324-34a5-a2a8-7bd2539a97e3",
                    "sense_definition": "Aanvoegende wijs van de verleden tijd van <w>gebeuren</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aanvoegende_wijs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "God verhoede dat er zoiets vreselijks nogmaals <w>gebeurde</w>.",
                            "target_lang_translations": {
                                "en": "God forbid that something so terrible <w>should happen</w> again."
                            }
                        },
                        {
                            "text": "Het ware te wensen dat dit vaker <w>gebeurde</w> in onze samenleving.",
                            "target_lang_translations": {
                                "en": "It were to be wished that this <w>happened</w> more often in our society."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "De aanvoegende wijs (conjunctief) is in het modern Nederlands zeer zeldzaam."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Subjunctive mood of the past tense of 'gebeuren' (to happen)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "should happen",
                                "target_lang_sense_clarification": "expressing a hypothetical or desired event in the past subjunctive"
                            },
                            {
                                "target_lang_word": "were to happen",
                                "target_lang_sense_clarification": "expressing a hypothetical condition"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "998dc76c-d118-3924-907f-fef99e47e0c5",
                    "sense_definition": "Datgene wat gebeurd is; een voorval of gebeurtenis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gebeurtenis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>gebeurde</w> heeft diepe indruk achtergelaten op de hele familie.",
                            "target_lang_translations": {
                                "en": "<w>What happened</w> left a deep impression on the whole family."
                            }
                        },
                        {
                            "text": "We moeten praten over het <w>gebeurde</w> om het een plekje te kunnen geven.",
                            "target_lang_translations": {
                                "en": "We need to talk about <w>what happened</w> in order to come to terms with it."
                            }
                        }
                    ],
                    "synonyms": [
                        "gebeurtenis",
                        "voorval"
                    ],
                    "common_phrases": [
                        "het gebeurde bespreken",
                        "na het gebeurde"
                    ],
                    "target_lang_definitions": {
                        "en": "That which has happened; an event, occurrence, or incident."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "what happened",
                                "target_lang_sense_clarification": "the events that took place"
                            },
                            {
                                "target_lang_word": "occurrence",
                                "target_lang_sense_clarification": "an incident or event"
                            },
                            {
                                "target_lang_word": "event",
                                "target_lang_sense_clarification": "something that happens, especially of importance"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}