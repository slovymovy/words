                                        "sense_id": "595c9917-bae4-3870-973b-e07de0fcb51b",
                                        "entry_id": "4587d73f-a7d8-39ee-a390-6791bf9b5093",
                                        "glosses": [
                                            "Person, die an einem Puppenspiel mitwirkt, indem sie die Spielfiguren bewegt und ihre Texte spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9590933b-ef61-4522-b508-613c2121fe9a",
                                                "sense_id": "595c9917-bae4-3870-973b-e07de0fcb51b",
                                                "text": "„Die jungen Puppenspieler am anderen Ende der Leitung waren hocherfreut und terminlich hochflexibel.“"
                                            }
