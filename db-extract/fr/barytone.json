                        "examples": [
                            {
                                "example_id": "2878b04f-ca9d-4959-9cb0-6996cedf3be9",
                                "sense_id": "d25ac980-87c3-30f9-9ecc-814dba105b98",
                                "text": "L’accompagnateur admonesté reçoit une convocation pour une nouvelle séance, il est exact cette fois; le soprano à son tour n’a garde de paraître. Pas de répétition possible; le baryton n’a pu être convoqué, la barytone étant toujours malade; ni le ténor, qui est toujours fatigué."
                            },
                            {
