                "entry_id": "ca71f20f-0728-3fd9-b290-5795efccf005",
                "word": "multidimensionality",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2e0e9812-3102-41ac-81a8-3f3c6bc15772",
                        "entry_id": "ca71f20f-0728-3fd9-b290-5795efccf005",
                        "tags": [
                            "plural"
                        ],
                        "form": "multidimensionalities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a1bf3d9-19ad-34dd-acdd-adfcdc3b7419",
                        "entry_id": "ca71f20f-0728-3fd9-b290-5795efccf005",
                        "glosses": [
                            "The property or state of being multidimensional."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "bcb5901d-8a02-468b-a87c-5522e05e7458",
                                "sense_id": "7a1bf3d9-19ad-34dd-acdd-adfcdc3b7419",
                                "text": "In reality, the multidimensionality of language contact in multilingual environments ensures no such neat compartmentalisation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ec2b4b3-1e8c-40cb-8775-481685ca446c",
                        "source_entry_id": "ca71f20f-0728-3fd9-b290-5795efccf005",
                        "source_sense_id": "7a1bf3d9-19ad-34dd-acdd-adfcdc3b7419",
                        "source_sense_description": "the property of being multidimensional",
                        "target_lang_word": "Mehrdimensionalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mehrdimensionalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23b71352-3fe3-3a05-9a1a-cea0909bf42a",
                                        "entry_id": "48c9efb2-6dc8-370c-aaef-dd2dbe659344",
                                        "glosses": [
                                            "Eigenschaft, sich in mehrere Richtungen (Dimensionen) zu erstrecken, mehrere Teilbereiche/Facetten zu haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dabc9b1f-4267-4ac2-ba6c-3caacdbebc32",
                                                "sense_id": "23b71352-3fe3-3a05-9a1a-cea0909bf42a",
                                                "text": "„Die Mehrdimensionalität drückt sich darin aus, daß ein Konsument über mehrere Verhaltensmuster verfügen kann: „In einem Konsumenten leben viele Konsumenten\".“"
                                            },
                                            {
                                                "example_id": "213d3dc6-d70d-4583-bd52-9fc5b4bc7f8a",
                                                "sense_id": "23b71352-3fe3-3a05-9a1a-cea0909bf42a",
                                                "text": "„Soll über die Mehrdimensionalitäten und Gleichzeitigkeiten der Welt gesprochen werden, müssen diese linearisiert und gewissermaßen entgleichzeitigt, d.h. von einer mehrdimensionalen in eine lineare Form übersetzt werden.“"
                                            },
                                            {
                                                "example_id": "e79f8be2-d5e2-4a06-8a65-d1b214d9cdc4",
                                                "sense_id": "23b71352-3fe3-3a05-9a1a-cea0909bf42a",
                                                "text": "„Der Mehrdimensionalität der Sachaspekte und Fachperspektiven müssen auf Seiten des Lehrers entsprechende Kompetenzen gegenüberstehen.“"
                                            },
                                            {
                                                "example_id": "a363f105-e3e3-4061-a8f3-cb0a6716fd8e",
                                                "sense_id": "23b71352-3fe3-3a05-9a1a-cea0909bf42a",
                                                "text": "„Gestützt wird die Mehrdimensionalität des individuellen Systems der Interkulturellen Kompetenz zudem über die Erkenntnisse der Faktorenanalysen, die im Rahmen der Beantwortung der Forschungsfrage 3.3 zur Dimensionalität des individuellen Systems der Interkulturellen Kompetenz durchgeführt wurden.“"
                                            },
                                            {
                                                "example_id": "82c087fb-3a3f-4a55-a5ea-7edf8b6fb5de",
                                                "sense_id": "23b71352-3fe3-3a05-9a1a-cea0909bf42a",
                                                "text": "„Die Frage nach der Mehrdimensionalität zielerreichenden Lernens steht im Mittelpunkt dieses Buches.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a13ed9dc-11e1-4816-82d3-dab7b3d21101",
                        "source_entry_id": "ca71f20f-0728-3fd9-b290-5795efccf005",
                        "source_sense_id": "7a1bf3d9-19ad-34dd-acdd-adfcdc3b7419",
                        "source_sense_description": "the property of being multidimensional",
                        "target_lang_word": "Multidimensionalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Multidimensionalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e95afc3-04b1-372b-a5c3-ddea48f94daa",
                                        "entry_id": "56ea7c79-cb67-3d86-9591-b8f71c3e51ef",
                                        "glosses": [
                                            "Eigenschaft, mehr als einen Aspekt (Dimension) zu haben, unter verschiedensten Winkeln erfahren und betrachtet werden zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef2fe076-29fe-411a-8830-45271baac444",
                                                "sense_id": "9e95afc3-04b1-372b-a5c3-ddea48f94daa",
                                                "text": "„Anders als Herausgehobenheit ist die Multidimensionalität von Erlebnissen bedeutsam, um eine umfassende subjektive Einbindung des Rezipienten zu erzeugen.“"
                                            },
                                            {
                                                "example_id": "4dd32ddd-2330-4522-912e-81bf4b7ca1ba",
                                                "sense_id": "9e95afc3-04b1-372b-a5c3-ddea48f94daa",
                                                "text": "„Die Multidimensionalität von Armut wird dabei in zwei Stufen eingefangen (vgl. Abbildung 11): Primär und für die weitere Analyse zentral ist das Verhältnis der zwei Dimensionen ‚Einkommensarmut‘ und ‚Lebenslagenarmut‘ (Multidimensionalität II).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c36599ae-a48a-4c7d-a9b0-58dec29f182f",
