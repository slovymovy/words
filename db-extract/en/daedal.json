                        "examples": [
                            {
                                "example_id": "c0788670-2ad9-4a2b-83ed-9e2fc8744955",
                                "sense_id": "8a21c4a9-1686-33e3-a25f-df9c50712eec",
                                "text": "His daedale hand would faile, and greatly faint, / And her perfections with his error taint […]"
                            },
                            {
                                "example_id": "6a92d673-a7e2-488c-b5e5-374b17abe5be",
                                "sense_id": "8a21c4a9-1686-33e3-a25f-df9c50712eec",
                                "text": "The daedal hand of Nature."
                            },
                            {
                                "example_id": "8a83a0d5-dcb9-4ffd-83f9-95aba019c799",
                                "sense_id": "8a21c4a9-1686-33e3-a25f-df9c50712eec",
                                "text": "Barquentine went into a form of a trance, the well-heads of his eyes appearing to cloud over and become opaque like miniature sargassos, of dull chalky-blue – the cataract veil – for it seemed that he was trying to remember the daedal days of his adolescence."
                            }
                        ]
                    }
