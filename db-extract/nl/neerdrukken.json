                                "target_senses": [
                                    {
                                        "sense_id": "a95ec149-7765-3dda-ae3c-9eb0530ebeb1",
                                        "entry_id": "2df53dee-22fb-3871-b8a3-724cbe56133b",
                                        "glosses": [
                                            "To press down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af4c3f74-2966-42c5-bdf6-e25644c31d71",
                                                "sense_id": "a95ec149-7765-3dda-ae3c-9eb0530ebeb1",
                                                "text": "Depress the upper lever to start the machine."
                                            },
                                            {
                                                "example_id": "92826584-739b-4026-8792-c1640b47f193",
                                                "sense_id": "a95ec149-7765-3dda-ae3c-9eb0530ebeb1",
                                                "text": "As to the fireman, the sight of him at work, swinging round with his shovelful of coal and at the same moment lightly depressing his right heel and so working the pedal which causes the steam-operated firedoors to open like magic in front of the shovel, was always a pleasure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fe46f76-d146-3d3c-8dfc-d9c78c74cdd8",
                                        "entry_id": "2df53dee-22fb-3871-b8a3-724cbe56133b",
                                        "glosses": [
                                            "To make depressed, sad or bored."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c924e326-5909-4071-b198-ecb1c822c8b2",
                                                "sense_id": "0fe46f76-d146-3d3c-8dfc-d9c78c74cdd8",
                                                "text": "Winter depresses me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adbab6ea-7c1e-33f6-932d-006577ddfdab",
                                        "entry_id": "2df53dee-22fb-3871-b8a3-724cbe56133b",
                                        "glosses": [
                                            "To cause a depression or a decrease in parts of the economy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c703d43-ab5f-4b16-8e0c-2861a76d9295",
                                                "sense_id": "adbab6ea-7c1e-33f6-932d-006577ddfdab",
                                                "text": "Lower productivity will eventually depress wages."
                                            },
                                            {
                                                "example_id": "328b067c-5ed7-489a-bf0b-71935d4bfc97",
                                                "sense_id": "adbab6ea-7c1e-33f6-932d-006577ddfdab",
                                                "text": "Russia claims the proportion of the grain that went to the very poorest countries was less than 4%, but this ignores the fact that even if wealthier countries were buying the wheat, the extra supply was depressing the general price all countries were paying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e5f05ee-a423-3727-8813-f1949e4dd180",
                                        "entry_id": "2df53dee-22fb-3871-b8a3-724cbe56133b",
