                            {
                                "target_word": "vernederend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "64e96c38-f723-317c-91b8-6dbc5937b68b",
                                        "entry_id": "e64ad171-0866-3092-9559-1665a3f5df04",
                                        "glosses": [
                                            "van iets dat het je eer aantast"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86d6d3e5-a044-4777-8091-a57aa10f5675",
                                                "sense_id": "64e96c38-f723-317c-91b8-6dbc5937b68b",
                                                "text": "Naar schatting 13 op de 1.000 kinderen in Nederland worden mishandeld. Dat kan met lichamelijk geweld, maar ook door verwaarlozing, vernedering of het eisen van onhaalbare prestaties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79c0fc38-7d48-3047-8d53-16a062d887eb",
                                        "entry_id": "e64ad171-0866-3092-9559-1665a3f5df04",
                                        "glosses": [
                                            "van iets dat je er klein en minderwaardig door wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3821c5c3-a4f3-4156-86b9-1825262c32fe",
                                                "sense_id": "79c0fc38-7d48-3047-8d53-16a062d887eb",
                                                "text": "Hun huis werd na „vernederende onderhandelingen” met gaswinner NAM gesloopt en nu wachten ze in een kapotte huurwoning op vervangende nieuwbouw."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02c20cf8-904d-466d-95ba-9b534e8a8da5",
                        "source_entry_id": "fe092266-33e9-3a88-b70a-ad03c8927368",
                        "source_sense_id": "8f53210a-5f79-34eb-9070-e43936c102da",
                        "source_sense_description": "liable to humiliate",
                        "target_lang_word": "humiliant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humiliant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43dedb4d-4e0b-3c54-91c4-be103d315f99",
                                        "entry_id": "d638f427-4f0c-3555-bd89-10264e5d6387",
                                        "glosses": [
                                            "Qui humilie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb42b085-9b72-4e1a-b467-9c188be2e64d",
                                                "sense_id": "43dedb4d-4e0b-3c54-91c4-be103d315f99",
                                                "text": "J’ai horreur de me voir à l’improviste dans une glace car, faute de m’y être préparé, je me trouve à chaque fois d’une laideur humiliante."
                                            },
                                            {
                                                "example_id": "be5cc52e-ba27-4e4c-bf24-e9c0ed9077d4",
                                                "sense_id": "43dedb4d-4e0b-3c54-91c4-be103d315f99",
                                                "text": "Agressif ou flatteur, impromptu ou acharné, le dragueur égrène tout au long de son infructueuse quête sa concupiscente litanie. On presse alors le pas, tête baissée, découragée et battue, tristement ramenée à son humiliante condition de femme dans le décor flamboyant de la capitale."
                                            },
                                            {
                                                "example_id": "33f96831-a336-46bd-af7d-bd8da0551723",
                                                "sense_id": "43dedb4d-4e0b-3c54-91c4-be103d315f99",
                                                "text": "C’est une chose bien humiliante pour son amour-propre."
                                            },
                                            {
                                                "example_id": "c569649b-eacd-4079-b4fc-00b12719ddfb",
                                                "sense_id": "43dedb4d-4e0b-3c54-91c4-be103d315f99",
                                                "text": "C’est une chose bien humiliante d’être… que d’être… Il est bien humiliant d’être… Il lui fit des reproches humiliants, une réprimande humiliante."
                                            }
                                        ]
                                    }
                                ]
                            },
