{
    "word_family": [
        "confiscation",
        "confiscable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9cebbcb-5612-3ac0-9842-164121932a6b",
                    "sense_definition": "Prendre et retenir un objet appartenant à autrui en faisant usage de son autorité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "saisie_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a décidé de <w>confisquer</w> un téléphone qui sonnait pendant le cours."
                        },
                        {
                            "text": "La douane a <w>confisqué</w> ces marchandises illégales dès leur arrivée à l'aéroport."
                        }
                    ],
                    "synonyms": [
                        "saisir",
                        "prendre"
                    ],
                    "antonyms": [
                        "rendre",
                        "restituer"
                    ],
                    "common_phrases": [
                        "confisquer un téléphone",
                        "confisquer un objet"
                    ]
                },
                {
                    "sense_id": "9a90d7cc-c103-3cdc-ab55-c2b7c4390bf7",
                    "sense_definition": "Saisir des biens ou des avoirs au profit de l'État en vertu d'une décision légale ou judiciaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "saisie_juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a ordonné de <w>confisquer</w> des biens acquis frauduleusement par les accusés."
                        },
                        {
                            "text": "La justice a fait <w>confisquer</w> les comptes bancaires liés à cette fraude fiscale."
                        }
                    ],
                    "synonyms": [
                        "saisir"
                    ],
                    "antonyms": [
                        "restituer"
                    ],
                    "common_phrases": [
                        "confisquer des biens",
                        "confisquer des avoirs"
                    ]
                },
                {
                    "sense_id": "440c3339-949e-3815-ace7-07b1d60867d1",
                    "sense_definition": "Accaparer entièrement une personne, la parole ou le pouvoir en privant les autres de liberté.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "accaparement_figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet orateur a tendance à <w>confisquer</w> la parole lors de chaque réunion de travail."
                        },
                        {
                            "text": "Le général a rapidement <w>confisqué</w> le pouvoir après la démission du gouvernement civil."
                        }
                    ],
                    "synonyms": [
                        "accaparer",
                        "monopoliser"
                    ],
                    "antonyms": [
                        "partager"
                    ],
                    "common_phrases": [
                        "confisquer la parole",
                        "confisquer le pouvoir"
                    ]
                }
            ]
        }
    ]
}