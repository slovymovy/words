            "senses": [
                {
                    "sense_id": "1e00553d-957b-37f1-90a8-48b47a855fa7",
                    "sense_definition": "Voorzien van een binnenlaag van stof, vaak voor extra warmte of stevigheid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de koude winterdagen draag ik graag mijn dikke, <w>gevoerde</w> jas.",
                            "target_lang_translations": {
                                "en": "During the cold winter days, I like to wear my thick, <w>lined</w> coat.",
                                "ru": "В холодные зимние дни я люблю носить свою толстую куртку <w>на подкладке</w>.",
                                "fr": "Pendant les froides journées d'hiver, j'aime porter mon manteau épais <w>doublé</w>."
                            }
                        },
                        {
                            "text": "Deze <w>gevoerde</w> laarzen houden je voeten zelfs in de sneeuw warm.",
                            "target_lang_translations": {
                                "en": "These <w>lined</w> boots keep your feet warm even in the snow.",
                                "ru": "Эти <w>утепленные</w> сапоги сохраняют ноги в тепле даже на снегу.",
                                "fr": "Ces bottes <w>doublées</w> gardent vos pieds au chaud même dans la neige."
                            }
                        }
                    ],
