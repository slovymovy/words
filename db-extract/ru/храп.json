                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "6fc02131-dccf-4ac4-a153-63a354314432",
                                "sense_id": "f83990b0-96d8-3efc-9871-215316c5b5ab",
                                "text": "А но́чью псы цепя́ми по кана́там гремя́т, и во всех о́кнах — «лампа́д и сия́ние», гро́мкий храп и чьи́-нибудь жгу́чие слёзы.",
                                "translation": "And by night, watchdogs on cables clanked their chains, and in all the windows it was “icon lamps and brightness,” loud snoring, and someone’s hot tears.",
                                "english": "And by night, watchdogs on cables clanked their chains, and in all the windows it was “icon lamps and brightness,” loud snoring, and someone’s hot tears."
                            }
                        ]
                    }
                ],
