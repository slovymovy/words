                "senses": [
                    {
                        "sense_id": "e49b104c-f305-3a51-b01b-90b040271b99",
                        "entry_id": "8244e2c2-7c45-34e9-9134-0568f6c35264",
                        "glosses": [
                            "Petit louve, mot tendre, souvent adressé aux enfants."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "860afad1-3f18-4d5e-ac92-aed114c2f50d",
                                "sense_id": "e49b104c-f305-3a51-b01b-90b040271b99",
                                "text": "Quand j’étais petite, ma mère m’appelait sa louloute et j’adorais ça jusqu’au jour où quelqu’un s’est moqué de moi à l’école."
                            }
                        ]
                    },
                    {
                        "sense_id": "da24246c-3c71-38d5-8bd3-73ee5c92bf82",
                        "entry_id": "8244e2c2-7c45-34e9-9134-0568f6c35264",
                        "glosses": [
                            "Enfant, jeune fille."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9c0e9d85-f969-4558-bfb4-5b2c21f7f929",
                                "sense_id": "da24246c-3c71-38d5-8bd3-73ee5c92bf82",
                                "text": "Lenglumé. — T’en offrirai-je, ma louloute ?"
                            },
                            {
                                "example_id": "1eaccd3c-4983-4943-ab27-5dcf00aeb27d",
                                "sense_id": "da24246c-3c71-38d5-8bd3-73ee5c92bf82",
                                "text": "Lilly eut juste le temps de sortir de la voiture pour la réceptionner dans ses bras et la couvrir de baisers fiévreux.\n— Comment va ma louloute !\nLa petite projeta sa tête en arrière avec un rire claironnant.\n— Je ne suis pas une louloute, je suis une fille.\n— Tu es une louloute, ma princesse de louloute.\nLilly sangla sa petite fille dans le siège enfant, attacha les ceintures de sécurité, et reprit le volant, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "40db20aa-9cf2-3c69-9b1f-4ce9746d1d17",
                        "entry_id": "8244e2c2-7c45-34e9-9134-0568f6c35264",
                        "glosses": [
                            "Femme, typesse, méquesse."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c41f21d9-eeda-4897-81b8-e70e193945f6",
                                "sense_id": "40db20aa-9cf2-3c69-9b1f-4ce9746d1d17",
                                "text": "Durant ces années, tu t’imagines, j'ai vécu tous les cas de figure possibles. Les louloutes qui s’éloignent sans un mot, celles qui se retournent brusquement et vous fusillent du regard. Celles qui vous traitent calmement de vieux salaud."
                            }
                        ]
                    }
