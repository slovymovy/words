                    {
                        "sense_id": "53e4aae0-22f1-3aad-b0b2-958ca8869713",
                        "entry_id": "c8af69e3-693c-336b-a776-9e80dfa19006",
                        "glosses": [
                            "Musikstil oder Besetzung, bei dem/der ausschließlich oder überwiegend Blasinstrumente und Schlagzeug zum Einsatz kommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4e7ecd7-1df3-4bf5-95e0-27599a26195d",
                                "sense_id": "53e4aae0-22f1-3aad-b0b2-958ca8869713",
                                "text": "Die Blasmusik ist in weiten Teilen der Bevölkerung verpönt, gleichzeitig aber eine der größten Laienmusikbewegungen der Welt."
                            },
                            {
                                "example_id": "92cb6920-500a-4f44-9cc8-574c2cd3e9cc",
                                "sense_id": "53e4aae0-22f1-3aad-b0b2-958ca8869713",
                                "text": "„Als sie sich am verabredeten Ort einfanden, war es ein deutsches Lokal mit Blasmusik und Dirndl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
