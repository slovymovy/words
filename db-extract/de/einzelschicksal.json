                "senses": [
                    {
                        "sense_id": "914e83a9-f31a-3fd3-9128-0b590018b274",
                        "entry_id": "92b173fc-92e2-3e8c-b6b4-85b8837b70cd",
                        "glosses": [
                            "besondere Lebensumstände einer bestimmten Person, die sich von denen anderer Personen deutlich unterscheiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85032594-7262-4396-96d7-c3421ca6ec3b",
                                "sense_id": "914e83a9-f31a-3fd3-9128-0b590018b274",
                                "text": "„Es war jedoch kein Einzelschicksal, denn die Kinder hatten damals nur eine einzige Pflicht: Gehorsam.“"
                            },
                            {
                                "example_id": "0db45773-5276-40e4-bb3e-9cb093f71c27",
                                "sense_id": "914e83a9-f31a-3fd3-9128-0b590018b274",
                                "text": "„Es ging bei seinem Aufenthalt in dieser Stadt wohl um mehr als um das Einzelschicksal.“"
                            },
                            {
                                "example_id": "9ed0bd24-8083-4392-b6a6-363695bc8913",
                                "sense_id": "914e83a9-f31a-3fd3-9128-0b590018b274",
                                "text": "„Dass solche Einzelschicksale erzählt werden, ist wichtig, weil sie das an sich unermessliche Grauen der NS-Zeit einigermaßen begreiflich machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
