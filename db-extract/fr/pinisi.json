                "word": "pinisi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "42c2bb87-8930-4c74-b11d-88e79c10f3c3",
                        "entry_id": "87673cba-a759-3004-801a-c6031a103083",
