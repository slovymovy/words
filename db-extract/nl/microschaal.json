                        "examples": [
                            {
                                "example_id": "e3ad19fd-2905-4efc-b97c-d989368cf239",
                                "sense_id": "c6d525d7-967f-3b4a-abb9-c35ee1072a6e",
                                "text": "Vanaf dat moment besefte ik dat ik een speciaal talent had: schalen en werkelijkheden die de grenzen van de menselijke zintuiglijke waarneming verre overschreden - zowel op macro- als microschaal en die alleen maar abstracte getallen schenen voor anderen, konden concrete vorm aannemen in mijn hoofd."
                            },
                            {
                                "example_id": "38710e23-cfc7-4717-868a-b3f7be7c42ca",
                                "sense_id": "c6d525d7-967f-3b4a-abb9-c35ee1072a6e",
                                "text": "‘Zelfs dingen die op de schaal van onze planeet gebeuren, worden uiteindelijk bepaald door wat er op microschaal gebeurt’, zegt Wordsworth."
                            }
                        ]
                    }
