                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8713503-212f-4589-b797-d70c0397eb50",
                        "source_entry_id": "2f9256a8-a014-337f-9026-4a987926e0e7",
                        "source_sense_id": "103ee58a-661e-3890-980b-a718f0d178fb",
                        "target_lang_word": "soucoupe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soucoupe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22f29d1a-5c18-35d5-8243-c95646b09f31",
                                        "entry_id": "ab6cee8b-cb00-3155-8c3d-222bc3436f72",
                                        "glosses": [
                                            "Sorte de petite assiette qui se place ordinairement sous une tasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c59d7e-a983-4a96-92d3-a2b0af3a6bb0",
                                                "sense_id": "22f29d1a-5c18-35d5-8243-c95646b09f31",
                                                "text": "Une bonne, qui portait une vieille robe jaune et un foulard décoloré autour du cou, entra dans la pièce, apportant une soucoupe de lait qu’elle déposa devant la petite bête."
                                            },
                                            {
                                                "example_id": "3e02a707-5ce3-4b67-bae4-39748f6dc919",
                                                "sense_id": "22f29d1a-5c18-35d5-8243-c95646b09f31",
                                                "text": "Mme Corney se leva pour prendre dans l'armoire une tasse et une soucoupe."
                                            },
                                            {
                                                "example_id": "c03280a1-408b-4693-bef6-679b64c36e88",
                                                "sense_id": "22f29d1a-5c18-35d5-8243-c95646b09f31",
                                                "text": "Un doux murmure de causeries, un petit cliquetis de cuillères, le bruit harmonieux des tasses et des soucoupes, tout se fondit en une rêverie délicieuse"
                                            },
                                            {
                                                "example_id": "a7152206-fd89-49e1-861d-dd9f3e73399f",
                                                "sense_id": "22f29d1a-5c18-35d5-8243-c95646b09f31",
                                                "text": "[…] elle me permet de coller à l’aide d’un petit bout de coton trempé dans un peu d’eau au fond d’une soucoupe, juste au milieu de chaque livre, de chaque cahier une grande étiquette blanche bordée d’un liséré bleu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9857c572-b12e-3fda-b0e3-a1170827a943",
                                        "entry_id": "ab6cee8b-cb00-3155-8c3d-222bc3436f72",
                                        "glosses": [
                                            "Cette sorte de petite assiette utilisée dans un café pour présenter la note à régler pour une consommation, et qui restait sur la table jusqu’au paiement."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e84f6830-76e4-48a4-8a87-ad9e561cce73",
                                                "sense_id": "9857c572-b12e-3fda-b0e3-a1170827a943",
                                                "text": "Carmant leurs soucoupes en gentleman, et sans un regard pour la tarderie agressive, il a fait aux deux frangines la bonne surprise de les emballer dans sa charrette."
                                            },
                                            {
                                                "example_id": "b63a69e3-1f8e-4542-a456-427bbd9b91eb",
                                                "sense_id": "9857c572-b12e-3fda-b0e3-a1170827a943",
                                                "text": "Revenons à mon éducateur… que je vous l’oublie pas en quelque arrière-salle de bistrot, attablé devant les soucoupes empilées. […] Quand il vous filait rencart, le Professeur, jamais il était en retard… une heure, parfois deux à l’avance, au fin fond du troquet à faire monter les soucoupes, s’arsouiller sérieux la glotte"
                                            },
                                            {
                                                "example_id": "360d2a64-728f-4908-aa89-aad9dd4f45ad",
                                                "sense_id": "9857c572-b12e-3fda-b0e3-a1170827a943",
                                                "text": "La petite bonne fourbissait son comptoir ; M. Larbre surveillait les soucoupes lorsque, tout à coup, nous fîmes irruption dans ce petit bistrot paisible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d368c631-3b7b-3b09-9c4b-1b53aca519fb",
                                        "entry_id": "ab6cee8b-cb00-3155-8c3d-222bc3436f72",
                                        "glosses": [
                                            "Sorte d'assiette avec un pied sur laquelle on pose les verres et la carafe."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef4fbf3e-69a8-48f1-a469-69c269700dd1",
                                                "sense_id": "d368c631-3b7b-3b09-9c4b-1b53aca519fb",
                                                "text": "Sa. Majesté, vient au buffet prendre des mains du chef d'échansannerie-bouche la soucoupe d'or garnie du verre couvert et de deux carafes de cristal, pleines de vin et d'eau;…"
                                            },
                                            {
                                                "example_id": "70c17e82-4d54-4941-8c8c-b374c33a1127",
                                                "sense_id": "d368c631-3b7b-3b09-9c4b-1b53aca519fb",
                                                "text": "nous vimes paraître une vieille servante qui apportait au docteur une soucoupe, sur laquelle il y avait un petit pain mollet, un verre avec deux carafes,…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbb4ffaa-10d1-3457-a16a-fb8186fbfaee",
                                        "entry_id": "ab6cee8b-cb00-3155-8c3d-222bc3436f72",
                                        "glosses": [
                                            "Soucoupe volante."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "519d5c6c-7e78-495e-ac13-0f5e5363ad67",
                                                "sense_id": "cbb4ffaa-10d1-3457-a16a-fb8186fbfaee",
                                                "text": "En 1947, au tout début des apparitions d’ovnis, une soucoupe se serait écrasée à Roswell, au Nouveau-Mexique. On aurait trouvé des extraterrestres humanoïdes morts à bord et des médecins militaires les auraient autopsiés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92b13388-ca98-3cbd-b865-a647752e0492",
                                        "entry_id": "ab6cee8b-cb00-3155-8c3d-222bc3436f72",
                                        "glosses": [
                                            "Soucoupe commune."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eb90f31-ba06-49a1-93e0-2668a365c8f1",
                                                "sense_id": "92b13388-ca98-3cbd-b865-a647752e0492",
                                                "text": "La Soucoupe n’est active que par temps humide et a une préférence pour les habitats ombragés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
