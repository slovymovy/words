                "senses": [
                    {
                        "sense_id": "2de7350c-1711-31dd-8257-89353a132875",
                        "entry_id": "90ff18da-1154-3e82-8374-0e0d11d28703",
                        "glosses": [
                            "Verinnerlichung von äußeren Anforderungen, sodass man bei der Vernachlässigung dieser Pflichten Scham- und Schuldgefühle empfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b32aa8be-1f91-4f19-9c92-f0e364ed1ce0",
                                "sense_id": "2de7350c-1711-31dd-8257-89353a132875",
                                "text": "Die Introjektion gilt als eine Vorstufe der reiferen Identifikation, als deren Vorläufer sie betrachtet wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b10696d1-6fa3-4985-ab87-5fbb102e5a05",
                        "source_entry_id": "90ff18da-1154-3e82-8374-0e0d11d28703",
