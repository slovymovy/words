                        "glosses": [
                            "kleine openbare weg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "445991d2-660d-420e-8d98-9152e71feb5e",
                                "sense_id": "7d9dd676-4f3b-3d5a-ba2c-2985b820b5d4",
                                "text": "Grimbergen en omliggende Vlaamse gemeenten vrezen dat het nieuwe stadion veel verkeersdruk met zich meebrengt. Gisteravond besloot de gemeente Grimbergen daarom een buurtweg die over de bouwsite loopt, in stand te houden. Daardoor kan er voorlopig niet gebouwd worden."
                            },
                            {
                                "example_id": "17602af5-280e-4c8e-9aa2-465d02f6e877",
                                "sense_id": "7d9dd676-4f3b-3d5a-ba2c-2985b820b5d4",
                                "text": "De automobilist bleef ongedeerd. De auto raakte bij het ongeval licht beschadigd. De buurtweg was enige tijd afgesloten voor auto's. Fietsers konden wel passeren."
                            }
                        ]
                    }
