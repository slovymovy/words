                },
                {
                    "sense_id": "c3fcd032-7d12-3b10-949e-0b2f6a398723",
                    "sense_definition": "Remplacer un fichier ou des données informatiques en effaçant définitivement le contenu antérieur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu enregistres cette version sous le même nom, tu vas <w>écraser</w> un fichier important."
                        },
                        {
                            "text": "Le système a malencontreusement <w>écrasé</w> les données de sauvegarde lors de la mise à jour."
