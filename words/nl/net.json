                        "ru": [
                            {
                                "target_lang_word": "как",
                                "target_lang_sense_clarification": "подобно чему-то"
                            },
                            {
                                "target_lang_word": "точно так же",
                                "target_lang_sense_clarification": "идентично"
                            },
                            {
                                "target_lang_word": "словно",
                                "target_lang_sense_clarification": "как будто"
                            }
                        ]
                    }
