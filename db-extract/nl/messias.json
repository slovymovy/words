                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "94cf483d-2b30-3c48-a26b-dbfef470ea8b",
                        "entry_id": "cae81544-0c1a-3097-96aa-f2c5302738b5",
                        "glosses": [
                            "Christus, Heiland"
                        ],
                        "tags": [],
