                "senses": [
                    {
                        "sense_id": "d3084bb7-df98-3f49-bfba-e301827101ca",
                        "entry_id": "47ded940-d22f-3bdb-a1d9-13a948d7fd9d",
                        "glosses": [
                            "meervoud verleden tijd van afvragen"
                        ],
                        "tags": [
                            "obsolete",
                            "with-subordinate-clause"
                        ],
                        "examples": [
                            {
                                "example_id": "ffb9dca9-ab17-48a3-9e2e-f9a00a563aaf",
                                "sense_id": "d3084bb7-df98-3f49-bfba-e301827101ca",
                                "text": "...waarover hunne Edel Mogenheden mij mijn gevoelen afvraagden."
                            },
                            {
                                "example_id": "e1bda6bd-4748-4eeb-b3d7-69f5245587f7",
                                "sense_id": "d3084bb7-df98-3f49-bfba-e301827101ca",
                                "text": "Gij vraagt, wat wij ons zelven afvraagden; waartoe werd voor deze mannen door dit volk een eereteeken opgericht?"
                            },
                            {
                                "example_id": "30b8e622-f154-4d22-aceb-d63a59c8fbd8",
                                "sense_id": "d3084bb7-df98-3f49-bfba-e301827101ca",
                                "text": "Daarop kleedden de knapen zich weder aan, borgen hunne zonderlinge wapenrusting weder op en gingen naar huis, vol spijt dat zij geene wezenlijke roovers waren, terwijl zij zich verbaasd afvraagden, in welk opzicht toch de moderne beschaving het verlies van de roovers vergoedde."
                            }
                        ]
                    }
