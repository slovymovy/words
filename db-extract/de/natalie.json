                    {
                        "translation_id": "a62d85fa-aa4c-48b0-80f5-2cf7f70d8cda",
                        "source_entry_id": "65ce9442-ae93-36df-b761-9c66df3d26a0",
                        "source_sense_id": "cac15f30-c40b-398b-8961-799f9094d592",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Natalie",
