{
    "word_family": [
        "rob",
        "robbery"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dbb5059c-cc85-3826-8c0a-0e1ae8f3ce20",
                    "sense_definition": "A person who commits robbery or steals from someone using force or threats.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The masked <w>robber</w> demanded all the money from the cash register.",
                            "target_lang_translations": {
                                "ru": "<w>Грабитель</w> в маске потребовал все деньги из кассы."
                            }
                        },
                        {
                            "text": "Police quickly arrested the bank <w>robber</w> as he tried to escape.",
                            "target_lang_translations": {
                                "ru": "Полиция быстро арестовала банковского <w>грабителя</w>, когда тот пытался сбежать."
                            }
                        }
                    ],
                    "synonyms": [
                        "thief",
                        "mugger",
                        "bandit"
                    ],
                    "common_phrases": [
                        "bank robber",
                        "armed robber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, совершающий ограбление или похищающий чужое имущество с применением силы или угроз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грабитель",
                                "target_lang_sense_clarification": "тот, кто совершает грабёж или налёт"
                            },
                            {
                                "target_lang_word": "разбойник",
                                "target_lang_sense_clarification": "вооружённый грабитель, бандит"
                            },
                            {
                                "target_lang_word": "грабительница",
                                "target_lang_sense_clarification": "женщина, совершающая грабёж"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5968df03-d139-30c6-80d0-6f43f041c071",
                    "sense_definition": "An animal that steals food or resources from other animals or humans.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magpie is known as a persistent <w>robber</w> of nests in early spring.",
                            "target_lang_translations": {
                                "ru": "Сорока известна как упорный <w>разоритель</w> гнёзд ранней весной."
                            }
                        },
                        {
                            "text": "The cunning animal acted as a nocturnal <w>robber</w>, raiding garbage cans every night.",
                            "target_lang_translations": {
                                "ru": "Хитрый зверь вёл себя как ночной <w>разбойник</w>, каждую ночь совершая набеги на мусорные баки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "robber of nests"
                    ],
                    "target_lang_definitions": {
                        "ru": "Животное или птица, разоряющие чужие гнёзда или крадущие пищу у других животных либо людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разоритель",
                                "target_lang_sense_clarification": "о животном, опустошающем гнёзда или запасы"
                            },
                            {
                                "target_lang_word": "вор",
                                "target_lang_sense_clarification": "о животном, ворующем еду"
                            },
                            {
                                "target_lang_word": "разбойник",
                                "target_lang_sense_clarification": "переносно, о дерзком животном-хищнике"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}