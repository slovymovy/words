                "senses": [
                    {
                        "sense_id": "bb3d45ed-1291-331e-9683-20985fa49a46",
                        "entry_id": "e11177e6-06cc-343b-94eb-e0bd5e89900c",
                        "glosses": [
                            "Spielgerät zum Cricketspielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fbe3462-5c99-4057-b080-b51770aa0c0e",
                                "sense_id": "bb3d45ed-1291-331e-9683-20985fa49a46",
                                "text": "„Dann überlegt er es sich anders und legt die linke um den Mast, sodass der Daumen in Noors Richtung zeigt, der das Gewehr am Lauf hält und es wie einen Cricketschläger schwingt.“"
                            },
                            {
                                "example_id": "57f6ca0f-a57c-422d-949a-8e19f7722732",
                                "sense_id": "bb3d45ed-1291-331e-9683-20985fa49a46",
                                "text": "„Als ich unten ankam und mit dem Knie gegen die Tür stieß, die sich daraufhin öffnete, fühlte ich mich, als habe mich jemand mit einem Cricketschläger zusammengeschlagen.“"
                            },
                            {
                                "example_id": "ff0a4dfc-ae62-4937-a8f2-a2788206799d",
                                "sense_id": "bb3d45ed-1291-331e-9683-20985fa49a46",
                                "text": "„Er steig ein wenig unbeholfen aus dem Wagen, denn er hält einen Cricketschläger hinter dem Rücken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
