                "senses": [
                    {
                        "sense_id": "b6bdf612-3599-38f6-b869-52cea6d452fd",
                        "entry_id": "33e059ab-5c0a-334d-a112-b7238bf6403f",
                        "glosses": [
                            "durch den Bergbau zustande kommendes Absinken des Landes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfebdb05-b5fe-46de-93a3-d6f99df58150",
                                "sense_id": "b6bdf612-3599-38f6-b869-52cea6d452fd",
                                "text": "„Die Gefahr einer Bergsenkung beruht indessen nicht auf dem Deponiebetrieb, sondern auf der vorangegangenen bergbaulichen Nutzung.“"
                            },
                            {
                                "example_id": "e33a957d-0373-4ef7-9e08-babe89bd8553",
                                "sense_id": "b6bdf612-3599-38f6-b869-52cea6d452fd",
                                "text": "„Er hat sich infolge einer bis zu neun Meter tiefen Bergsenkung gebildet, die in den 1960er-Jahren entstand und sich mit Grundwasser füllte.“"
                            },
                            {
                                "example_id": "2c0fde5f-e280-4868-859c-453aa79bc258",
                                "sense_id": "b6bdf612-3599-38f6-b869-52cea6d452fd",
                                "text": "„Dazu gehören Bergsenkungen und die andauernde Notwendigkeit, weiter Grubenwasser abzupumpen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
