                                    {
                                        "sense_id": "dbee28f4-7684-3451-a74e-4d969feb8efa",
                                        "entry_id": "93dcd7dd-4d9d-3f3c-b522-c915f3f4cf0c",
                                        "glosses": [
                                            "Obliged, when called upon, to answer (for one’s deeds); answerable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "564ddf9c-f479-4bfa-a8cd-59da5c747cc0",
                                                "sense_id": "dbee28f4-7684-3451-a74e-4d969feb8efa",
                                                "text": "Everyone is accountable to God for their conduct."
                                            },
                                            {
                                                "example_id": "5af6a14d-d7cf-40b0-8c72-6dbde13ec27b",
                                                "sense_id": "dbee28f4-7684-3451-a74e-4d969feb8efa",
                                                "text": "You will be held accountable for your misdemeanors."
                                            },
                                            {
                                                "example_id": "37a770eb-8f71-47f7-bf83-5a490f1558d7",
                                                "sense_id": "dbee28f4-7684-3451-a74e-4d969feb8efa",
                                                "text": "\"Because the railway is economically and socially vital, it receives large amounts of public money and must therefore ultimately be accountable to government. [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6111ac0-bf21-3ecb-9cf0-e71283f52e9a",
                                        "entry_id": "93dcd7dd-4d9d-3f3c-b522-c915f3f4cf0c",
                                        "glosses": [
                                            "Obliged to keep accurate records (of property or funds)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2f6c9d3-179d-3d16-84a1-464be448469c",
                                        "entry_id": "93dcd7dd-4d9d-3f3c-b522-c915f3f4cf0c",
                                        "glosses": [
                                            "Liable to be called on to render an account."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e57be70-a56d-3324-982d-0aa9ef37a4f9",
                                        "entry_id": "93dcd7dd-4d9d-3f3c-b522-c915f3f4cf0c",
                                        "glosses": [
                                            "Capable of being accounted for; explicable; explainable."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e541c5b-6c3d-4054-a7c5-cd7c4d276f17",
                                                "sense_id": "3e57be70-a56d-3324-982d-0aa9ef37a4f9",
                                                "text": "True religion . . . intelligible, rational, and accountable, -- not a burden but a privilege."
                                            }
