                        "sense_id": "5bbac4dc-dfed-3760-9fca-4bc7ce206e76",
                        "entry_id": "596ca70e-fb11-364a-9f6b-adbd51cc1d1e",
                        "glosses": [
                            "Beamy; radiant; luminous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9816d1db-55b7-440f-91ce-a16cd7c2a335",
                                "sense_id": "5bbac4dc-dfed-3760-9fca-4bc7ce206e76",
                                "text": "Let each succeeding page Still boast those charms, and luminate the age; So shall thy beamful fires with light divine, Rise to the sphere, and there triumphant shine."
                            },
                            {
                                "example_id": "0d395937-6e9a-4aef-8bf4-00388a395b36",
                                "sense_id": "5bbac4dc-dfed-3760-9fca-4bc7ce206e76",
                                "text": "And Monsieur Le Donkey's pleased beam is twice as beamful as it was over the stage business with the sauce."
                            },
                            {
                                "example_id": "c83cb8ce-2ea7-4d56-b8ff-39bac8a8e75a",
                                "sense_id": "5bbac4dc-dfed-3760-9fca-4bc7ce206e76",
                                "text": "I can recall the tall, slender man-boy, with the large beamful eyes, soft brown beard and moustache, long swinging stride, careless dress, lounging habits, and incessant oratory."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "20ba0cf8-723f-3b6f-8858-402aed2df260",
