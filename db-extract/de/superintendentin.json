                                    },
                                    {
                                        "sense_id": "b7ae4874-c85a-37b8-822f-9ce54deefeaf",
                                        "entry_id": "459874e3-047f-39dc-83da-21007777c074",
                                        "glosses": [
                                            "A police rank used in Commonwealth countries, ranking above chief inspector, and below chief superintendent."
                                        ],
                                        "tags": [
                                            "Commonwealth"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "802e93f5-e9d7-4b8b-9c98-62e062944161",
                                                "sense_id": "b7ae4874-c85a-37b8-822f-9ce54deefeaf",
                                                "text": "“No, don't,” replied the superintendent; “in fact, I'd rather you made yourself conspicuous elsewhere. Go down to the landing stage and cross to New Brighton or Wallasey—doesn't matter which—and come back. No doubt you will be seen, and reported to have gone across.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e59e4d47-452d-30e9-b51a-4de11ff40429",
                                        "entry_id": "459874e3-047f-39dc-83da-21007777c074",
                                        "glosses": [
                                            "The manager of a building, usually a communal residence, who is responsible for keeping the facilities functional and often collecting rent or similar payments, either as also the building's landlord or on behalf of same. Often abbreviated \\\"super\\\"."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
