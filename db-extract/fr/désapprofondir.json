                ],
                "senses": [
                    {
                        "sense_id": "2e1f9e89-3bd5-31c8-8d4a-ebecdb8c090d",
                        "entry_id": "0f79524e-db1e-35ca-8717-ed29ba73df64",
                        "glosses": [
                            "Rendre moins profond, ou moins approfondi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a0ce07f-678b-4057-b647-d4f7c70b338c",
                                "sense_id": "2e1f9e89-3bd5-31c8-8d4a-ebecdb8c090d",
                                "text": "Mais, malgré les efforts du chevalier blanc, la nature, opiniâtre, avait une furieuse tendance à gagner un peu plus chaque année et le Trou à se désapprofondir et à se rétrécir inexorablement."
                            },
                            {
                                "example_id": "54116f1d-572a-4f5d-bb18-7f11e7744a20",
                                "sense_id": "2e1f9e89-3bd5-31c8-8d4a-ebecdb8c090d",
                                "text": "La mise-en-commun peut ainsi s’approfondir à son rythme, ou, à l’inverse, se désapprofondir à son rythme, jusqu’à, parfois, une dissolution du « nous » commun."
                            },
                            {
                                "example_id": "56992685-71b4-4079-a3a5-433f55d2e373",
                                "sense_id": "2e1f9e89-3bd5-31c8-8d4a-ebecdb8c090d",
                                "text": "ça \"désapprofondit\" à partir du moment où les possibilités offertes donnent un avantage incontrable de la part d’un ou plusieurs personnages (cf Jungle kongo et luigi’s mansion)."
                            }
                        ]
                    }
                ],
