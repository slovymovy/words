            {
                "entry_id": "197be838-7a20-3cdd-9908-723ad5156356",
                "word": "punching-ball",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "aad9eb48-8a01-4bad-bfcd-dbf5d51965f7",
                        "entry_id": "197be838-7a20-3cdd-9908-723ad5156356",
