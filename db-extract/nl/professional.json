                    {
                        "translation_id": "b02b5602-db3b-4aba-a0df-d36af39711e4",
                        "source_entry_id": "f4584576-8740-36bd-b821-0059e717eb1e",
                        "source_sense_id": "49c09aec-2c09-391a-9cb6-ca6193f103f7",
