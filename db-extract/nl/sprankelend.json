                                ]
                            },
                            {
                                "target_word": "sparkling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "378847d1-bdd6-3b55-a7bd-35353986c4da",
                                        "entry_id": "36efd0ac-1966-3c3c-86e7-07c6da14e406",
                                        "glosses": [
                                            "Of an object, reflecting light as if giving off tiny sparks or flashes of light."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74b22b48-c0ae-4c84-af20-210ae6f48c39",
                                                "sense_id": "378847d1-bdd6-3b55-a7bd-35353986c4da",
                                                "text": "\"Methinks 't were sweet once more to see\nOur native forest shade,\nAnd the wild streamlet leaping free\nAlong the sparkling glade,..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c00523e0-a453-37ec-b22c-82267bed420b",
                                        "entry_id": "36efd0ac-1966-3c3c-86e7-07c6da14e406",
                                        "glosses": [
                                            "Of a beverage, especially an alcoholic beverage, containing dissolved carbon dioxide (either naturally or that has been added) that comes out of solution in the form of many tiny bubbles."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "654310f8-b2db-3063-ac01-da3e3fd183e2",
                                        "entry_id": "36efd0ac-1966-3c3c-86e7-07c6da14e406",
                                        "glosses": [
                                            "Brilliant and vivacious."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cebbf992-4784-4e79-ba08-ededd4b2800f",
                                                "sense_id": "654310f8-b2db-3063-ac01-da3e3fd183e2",
                                                "text": "The outstanding train on the L.M.S. route was the 6.20 p.m. from Birmingham, which reached Euston in two hours after intermediate stops at Coventry, Rugby and Watford Junction, and evoked some sparkling performances from \"Patriot\" and \"Jubilee\" 4-6-0s."
                                            },
                                            {
                                                "example_id": "0a5a092d-1550-45d5-bab7-45ef9ea70e0e",
                                                "sense_id": "654310f8-b2db-3063-ac01-da3e3fd183e2",
                                                "text": "While we know – because the script tells us so – that the people we are watching are in love and in pain and in trouble, they never come across as more than dispensers of sparkling aperçus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sparkling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9aceeea6-8fb4-3238-a6bb-e50e98080ae3",
                                        "entry_id": "eed10837-91fa-3b6c-b99b-ffcc0c2b7c67",
                                        "glosses": [
                                            "Act or appearance of something that sparkles; a sparkle; a gleam."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de43c653-de93-4442-b1ff-3210eca9b17f",
                                                "sense_id": "9aceeea6-8fb4-3238-a6bb-e50e98080ae3",
                                                "text": "Bright are the sparklings that beam from the dew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1da5ab19-6440-309d-b96f-d09b33648c27",
                                        "entry_id": "eed10837-91fa-3b6c-b99b-ffcc0c2b7c67",
                                        "glosses": [
                                            "A sparkling wine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efe63ea4-d7f7-43e7-892e-33ed68fda330",
                                                "sense_id": "1da5ab19-6440-309d-b96f-d09b33648c27",
                                                "text": "Wines like this struggle to stand out on the show circuit, where the judges are more likely to be searching for sparklings designed in the classic Champagne mould."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "423c9ed4-c921-34a1-a33a-3a3bd74df740",
                                        "entry_id": "eed10837-91fa-3b6c-b99b-ffcc0c2b7c67",
                                        "glosses": [
                                            "Ellipsis of sparkling water (“fizzy drinking water”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
