    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "80f68638-221e-3c64-bd35-cf9a64f2d031",
                "word": "fortune-telling",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "941a4091-3eeb-31f8-80de-d16d27475ba1",
                        "entry_id": "80f68638-221e-3c64-bd35-cf9a64f2d031",
                        "glosses": [
                            "The act or practice of predicting the future (especially for money), as by using a crystal ball, reading palms, reading tea leaves in a cup, etc.; prediction of future events, especially those of a personal nature."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ad387a7a-cd21-4d30-bf9a-85ff2c24b33a",
                                "sense_id": "941a4091-3eeb-31f8-80de-d16d27475ba1",
                                "text": "Fortune-telling has been in all countries a gift of the sea-people."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93e39f1b-4646-4234-a668-4cdc62cba38e",
                        "source_entry_id": "80f68638-221e-3c64-bd35-cf9a64f2d031",
                        "source_sense_id": "941a4091-3eeb-31f8-80de-d16d27475ba1",
                        "source_sense_description": "fortunetelling, predicting one's future",
                        "target_lang_word": "bonne aventure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bonne aventure",
