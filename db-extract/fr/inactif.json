                                    {
                                        "sense_id": "5a4428ea-6086-30cf-9d6d-5948bf1ba4a6",
                                        "entry_id": "27abdfe4-e995-3126-843a-5450fb0743b5",
                                        "glosses": [
                                            "No longer in use or active, nor expected to be again."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "862efd6c-cd41-4660-a946-2a328a2a387a",
                                                "sense_id": "5a4428ea-6086-30cf-9d6d-5948bf1ba4a6",
                                                "text": "[T]he engineer must solve the mysteries of boiler accidents by studying defunct structures of many different types."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "905027f7-71da-3ae0-b35a-b3bc6f060755",
                                        "entry_id": "27abdfe4-e995-3126-843a-5450fb0743b5",
                                        "glosses": [
                                            "No longer in use or active, nor expected to be again.",
                                            "No longer in business or service, nor expected to be again; out of business."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52161bb6-febb-32a2-aba0-089a498dc6da",
                                        "entry_id": "27abdfe4-e995-3126-843a-5450fb0743b5",
                                        "glosses": [
                                            "Specifically, of a process: having terminated but not having been reaped (by its parent or an inheritor), and thus still occupying a process slot. See also zombie, zombie process."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48862d41-84b8-3ad3-bd40-b35cd111cb74",
                                        "entry_id": "27abdfe4-e995-3126-843a-5450fb0743b5",
                                        "glosses": [
                                            "(of a language) No longer spoken."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dec101e-c623-471c-9983-7153606926ca",
                                                "sense_id": "48862d41-84b8-3ad3-bd40-b35cd111cb74",
                                                "text": "When a language dies members of the culture of which that language was once a part may attempt to hold on to their linguistic heritage, if not by the use of the defunct language itself, at least by the preservation of its script."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4860307b-2ff3-3197-8d28-524d17a7cba7",
                                        "entry_id": "27abdfe4-e995-3126-843a-5450fb0743b5",
                                        "glosses": [
                                            "Deceased, dead."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33d285c7-6c69-4c18-82be-4a5ec6c8b178",
                                                "sense_id": "4860307b-2ff3-3197-8d28-524d17a7cba7",
                                                "text": "The organs, though defunct and dead before, / Break up their drowsy grave and newly move"
                                            },
                                            {
                                                "example_id": "9b8a70c2-5eec-4c4b-8989-1db98b1ea62a",
                                                "sense_id": "4860307b-2ff3-3197-8d28-524d17a7cba7",
                                                "text": "Morgante at a venture shot an arrow, / Which pierced a pig precisely in the ear, / And passed unto the other side quite through; / So that the boar, defunct, lay tripped up near."
                                            }
                                        ]
                                    }
                                ]
                            },
