                "senses": [
                    {
                        "sense_id": "068ca5bb-66ee-37db-87e3-4dd7b5477bf4",
                        "entry_id": "82396c08-5606-33ef-ad61-71deb6999a15",
                        "glosses": [
                            "Buch, das Märchen enthält"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "ee4f79ab-46ea-4b1a-8963-4591834593d2",
                                "sense_id": "068ca5bb-66ee-37db-87e3-4dd7b5477bf4",
                                "text": "Dieses Märchenbuch enthält die Märchen der Gebrüder Grimm."
                            },
                            {
                                "example_id": "f42657e4-c861-4fe5-9fe5-bfe86d934598",
                                "sense_id": "068ca5bb-66ee-37db-87e3-4dd7b5477bf4",
                                "text": "Unsere Oma hat uns Kindern oft Geschichten aus dem Märchenbuch vorgelesen."
                            },
                            {
                                "example_id": "dd199798-1310-4190-92d1-8ad4a4dc4cbf",
                                "sense_id": "068ca5bb-66ee-37db-87e3-4dd7b5477bf4",
                                "text": "„Die Theorien und Ideologien, die seinem Märchenbuch zugeschrieben wurden, waren nicht seine Intention.“"
                            },
                            {
                                "example_id": "bea109fd-ade6-4995-96f1-b51ca76e9238",
                                "sense_id": "068ca5bb-66ee-37db-87e3-4dd7b5477bf4",
                                "text": "„Um die Angst zu vertreiben, las sie im Märchenbuch, bis der Schrecken abnahm und der Schlaf zurückkehrte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
