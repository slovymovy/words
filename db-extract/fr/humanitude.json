                        "glosses": [
                            "Capacité d’un être humain à prendre conscience de son appartenance à l’espèce humaine comme membre à part entière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42f30ba4-dc44-440d-b212-7e7fa0d093d6",
                                "sense_id": "350b89bb-b0ff-31f6-806e-8f53aeff52df",
                                "text": "Mieux connaître les caractéristiques des êtres humains, les éléments de l’humanitude, ne peut conduire à définir ce qu’est un homme."
                            },
                            {
                                "example_id": "87ed9de2-8d18-4f86-a4d6-5766de8868dd",
                                "sense_id": "350b89bb-b0ff-31f6-806e-8f53aeff52df",
                                "text": "Dans cette perspective, celui qui tolère nie à l'autre son humanitude, sa perspectivilité."
                            }
                        ]
                    }
