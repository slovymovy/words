                "senses": [
                    {
                        "sense_id": "830ab930-92ae-35ab-bb4c-915ea8a5e3b3",
                        "entry_id": "45b4ab33-bba7-3d32-b074-5ef3f71a3eda",
                        "glosses": [
                            "Amasser des revenus pour constituer un trésor, thésauriser."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "07b60add-7062-4ae3-a9bf-35a35cc77e1f",
                                "sense_id": "830ab930-92ae-35ab-bb4c-915ea8a5e3b3",
                                "text": "J’ai trésorisé par ce moyen, mais secrètement, et j’ai une somme considérable pour commencer un établissement : tu seras d'abord mon prête-nom, ensuite, mon associé."
                            },
                            {
                                "example_id": "cf6e137f-68ad-4f3a-a9b7-098046a01fbc",
                                "sense_id": "830ab930-92ae-35ab-bb4c-915ea8a5e3b3",
                                "text": "Avec Castor, le poète veut « trésoriser » une part de la richesse de la langue québécoise."
                            },
                            {
                                "example_id": "5153916f-9973-4b19-9ac6-e3cf6037a301",
                                "sense_id": "830ab930-92ae-35ab-bb4c-915ea8a5e3b3",
                                "text": "Et que feront des hommes universellement déréglés et corrompus, tous attachés à cultiver et trésoriser sur les épines d’une terre maudite ?"
                            }
                        ]
                    }
