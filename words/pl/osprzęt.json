                    "sense_definition": "ogół lin, bloków, żagli i innych elementów wyposażenia żaglowca; takielunek",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zeglarstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wypłynięciem w rejs załoga dokładnie sprawdziła cały <w>osprzęt</w> jachtu.",
                            "target_lang_translations": {
                                "ru": "Перед выходом в рейс экипаж тщательно проверил весь <w>такелаж</w> яхты."
                            }
                        },
                        {
                            "text": "Silny sztorm poważnie uszkodził <w>osprzęt</w> i połamał jeden z głównych masztów jednostki.",
                            "target_lang_translations": {
                                "ru": "Сильный шторм серьёзно повредил <w>оснастку</w> и сломал одну из главных мачт судна."
                            }
