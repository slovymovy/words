                        "translation_id": "0a141e40-82ba-4805-8df3-4dbd224628cf",
                        "source_entry_id": "6489c8c6-3db8-31fc-a502-2f31caf04c88",
                        "source_sense_id": "20028446-8a59-3f21-9965-2525fea83b2d",
