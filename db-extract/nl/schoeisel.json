                    {
                        "translation_id": "6abf6587-e11b-4d47-a7a8-071580dd3bc3",
                        "source_entry_id": "458d0235-a04d-340f-b31c-85cfca1c91a7",
                        "source_sense_id": "dbfad6c6-5380-3746-a9f5-711319d7173d",
                        "source_sense_description": "alles wat men om de voeten heen kan dragen, zoals schoenen en laarzen",
                        "target_lang_word": "chaussure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chaussure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e44842a-2103-3606-9f19-40a982db40bd",
                                        "entry_id": "d3e108b9-1dd4-36cf-9542-79893408282a",
                                        "glosses": [
                                            "Ce que l’on met au pied pour se chausser. — Note d’usage : Souvent au pluriel en référant à une paire de chaussures pour les deux pieds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb71d2f3-1e97-418a-af00-b795e5bfb6a6",
                                                "sense_id": "6e44842a-2103-3606-9f19-40a982db40bd",
                                                "text": "Le seul moyen de se garantir d’oignons, & même de toute incommodité aux pieds, c'est d'être absolument en garde contre les chaussures trop courtes; […]."
                                            },
                                            {
                                                "example_id": "8c052fba-40da-4571-a507-69560bc656cf",
                                                "sense_id": "6e44842a-2103-3606-9f19-40a982db40bd",
                                                "text": "Le parfait gentleman qu’est mon vieil ami Jacques arborait ce soir-là une suave écharpe de soie, d’impeccables chaussures vernies, un pardessus du bon faiseur et un chapeau d'au moins vingt louis."
                                            },
                                            {
                                                "example_id": "f8cc8633-da36-421b-a779-c285f55cf5b9",
                                                "sense_id": "6e44842a-2103-3606-9f19-40a982db40bd",
                                                "text": "Les travailleurs chargés de l’oxycoupage et leurs aides découpent jour et nuit des plaques d’acier sans masques, vêtements, gants ou chaussures de protection."
                                            },
                                            {
                                                "example_id": "549a33ec-5b4e-4ae3-b4dd-4d70022c7316",
                                                "sense_id": "6e44842a-2103-3606-9f19-40a982db40bd",
                                                "text": "Il allongeait sa jambe, sèche comme un échalas, qui flottait dans une molletière trop large et sans couleur, pour montrer fièrement sa chaussure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a44e1f9-781b-3bb7-ba9a-6cea3053571c",
                                        "entry_id": "d3e108b9-1dd4-36cf-9542-79893408282a",
                                        "glosses": [
                                            "Domaine de la fabrication et de la vente des chaussures."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fe7fc0a-5aa0-4ac1-87ae-b30e3a36b274",
                                                "sense_id": "5a44e1f9-781b-3bb7-ba9a-6cea3053571c",
                                                "text": "Il est dans la chaussure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ce9bbab-2bfe-3aa3-b33c-af1f7be96b45",
                                        "entry_id": "d3e108b9-1dd4-36cf-9542-79893408282a",
                                        "glosses": [
                                            "Ferrure d'un cheval."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b95a4db5-be0a-3617-8213-a07ef3abe501",
                                        "entry_id": "d3e108b9-1dd4-36cf-9542-79893408282a",
                                        "glosses": [
                                            "Meuble représentant le vêtement du même nom dans les armoiries. Elle est généralement présentée de profil la pointe vers dextre, le talon à senestre. À rapprocher de houseau, jambière, poulaine, sabot et soulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c78b663-7c94-4b87-baa4-7da8b102342a",
                                                "sense_id": "b95a4db5-be0a-3617-8213-a07ef3abe501",
                                                "text": "Écartelé au 1) burelé d’argent et de gueules au lion de sable brochant sur le tout, au 2) d’azur aux trois chaussures cousues de sable, au 3) d’argent aux trois marteaux de gueules, au 4) d'azur aux trois têtes d’aigle d’argent, qui est de la commune de Lammerville en Seine-Maritime → voir illustration « armoiries avec 3 chaussures »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
