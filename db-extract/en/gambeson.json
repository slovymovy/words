                ],
                "senses": [
                    {
                        "sense_id": "af40fbb1-6f7d-3f7c-abbf-3932de8ced64",
                        "entry_id": "a2eeb62e-cf00-3260-b027-8106059796f3",
                        "glosses": [
                            "A defensive garment formerly in use for the body, made of cloth stuffed and quilted, often worn as padding under armor."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "84ad9c21-4c1f-4a7c-b94b-bab7226bb1f1",
                                "sense_id": "af40fbb1-6f7d-3f7c-abbf-3932de8ced64",
                                "text": "Although the gambeson was chiefly worn under the coat of mail, to protect the body from being bruised by the strokes of the sword or lance, a circumstance that might happen without a division of the mail, the verses quoted in the Siege of Karleverok, shew that it was sometimes worn as a fur coat, and ornamented with rich decorations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbb0fee9-bfd7-4dcf-8220-3db299105f99",
                        "source_entry_id": "a2eeb62e-cf00-3260-b027-8106059796f3",
                        "source_sense_id": "af40fbb1-6f7d-3f7c-abbf-3932de8ced64",
                        "source_sense_description": "armor",
                        "target_lang_word": "wambuis",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wambuis",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "48789ed1-5e5e-391e-aa99-521c40067c5f",
                                        "entry_id": "1a233363-2092-3d82-9ded-40cba9229869",
                                        "glosses": [
                                            "vooral in vroeger tijden veel gedragen gewatteerd vest, vaak gemaakt van lagen linnen, in banen gestikt, met een opvulling van wol, katoen en haren, dat het lichaam van de hals tot op het middel bedekt"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a87590a7-0b1a-4168-94ff-2c790eb10afc",
                                                "sense_id": "48789ed1-5e5e-391e-aa99-521c40067c5f",
                                                "text": "Het hek zwaaide ineens open, en er verschenen een man en een jongen. Omdat ik onderweg helemaal niemand was tegengekomen, was ik blij mensen te zien. Ze droegen allebei eenvoudige wambuizen en hadden een pet op waardoor hun gezichten grotendeels bedekt werden, en de jongen had een kleine zeis achter zijn riem gestoken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efcacd17-2199-4826-b8ee-0e8039a648b0",
                        "source_entry_id": "a2eeb62e-cf00-3260-b027-8106059796f3",
                        "source_sense_id": "af40fbb1-6f7d-3f7c-abbf-3932de8ced64",
