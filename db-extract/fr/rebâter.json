                        "tags": [],
                        "examples": [
                            {
                                "example_id": "212f8887-fe5c-4cd2-a45d-0a297430a1a1",
                                "sense_id": "6d9dadcd-d4e6-3726-a5ca-ae006cc1561d",
                                "text": "Sur l’humble place villageoise, ombragée de vautours en quête de charognes, M. de Penafiel pouvait apercevoir ses askaris occupés à rebâter leurs mulets."
                            },
                            {
                                "example_id": "2e3ca804-6e70-4b05-890d-3a1be53b0f48",
                                "sense_id": "6d9dadcd-d4e6-3726-a5ca-ae006cc1561d",
                                "text": "Il s’arrêtera de même si un bout de son paquetage vient à tomber, attendant patiemment qu’on veuille bien le rebâter correctement."
                            }
                        ]
                    }
