                },
                {
                    "sense_id": "ccf46636-43b4-3379-9061-2c3ca231e4d3",
                    "sense_definition": "To insert or inlay a piece of material into a surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The woodworker chose to <w>inlet</w> pieces of mother-of-pearl along the border of the table.",
                            "target_lang_translations": {
                                "ru": "Столяр решил <w>инкрустировать</w> перламутровые пластинки по краю стола."
                            }
