                    {
                        "sense_id": "23752e5c-bdde-381c-a29a-3853d0ea04b6",
                        "entry_id": "ee6db3a5-ccc9-322a-8e85-afe1f06d7cc2",
                        "glosses": [
                            "Qui a rapport, qui appartient à la luette, à l’uvule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa4d03cc-c657-4003-a604-bdf6d5c67fea",
                                "sense_id": "23752e5c-bdde-381c-a29a-3853d0ea04b6",
                                "text": "— Sans doute, répondit le docteur, en faisant place à sa réponse par un vigoureux effort des muscles staphylins."
                            },
                            {
                                "example_id": "0699c38b-b47a-46c5-bd7b-08f153f00e9e",
                                "sense_id": "23752e5c-bdde-381c-a29a-3853d0ea04b6",
                                "text": "Cette pratique aurait des avantages, si, comme dans le cas de M. Foucher, les lèvres de la plaie staphyline saignaient abondamment."
                            },
                            {
                                "example_id": "bcee0bf7-07a7-4af3-9406-2e6c6470faac",
                                "sense_id": "23752e5c-bdde-381c-a29a-3853d0ea04b6",
                                "text": "Le sang est apporté au palais par l’artère pharyngienne et la staphyline."
                            }
                        ]
                    }
                ],
