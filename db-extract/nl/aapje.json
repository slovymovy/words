                        ],
                        "examples": [
                            {
                                "example_id": "55a8c5a8-75b3-4b40-96b0-a0d23550afd3",
                                "sense_id": "5513f98a-babe-38a4-aa26-b8d827f4c172",
                                "text": "Hij beweerde dat als de omstandigheden goed waren, als het aapje rustig was en de teugels goed aangereikt kreeg, het kon paardrijden op de Deense dog."
                            }
                        ]
                    },
