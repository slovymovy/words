                    "frequency": "High",
                    "semantic_group_id": "pronom_personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Et <w>toi</w>, comment vas-tu depuis notre dernière rencontre au café ?"
                        },
                        {
                            "text": "Je préfère partir en vacances avec <w>toi</w> cet été."
                        }
                    ],
                    "synonyms": [
                        "tézigue"
                    ],
                    "common_phrases": [
