            "senses": [
                {
                    "sense_id": "914c1fbc-f13d-31d3-a7fb-ab7ba4fe5b7c",
                    "sense_definition": "Se distinguer des autres par une originalité ou une qualité particulière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise cherche une idée originale pour se <w>démarquer</w> de tous ses concurrents."
                        },
                        {
                            "text": "Grâce à son talent exceptionnel, cet artiste a su se <w>démarquer</w> très rapidement."
                        }
                    ],
                    "synonyms": [
