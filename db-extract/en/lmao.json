                                "sense_id": "83189349-ca83-32ba-becd-97bd5f3e5ea8",
                                "text": "Reading this website will have you ROFLing, LMAOing, and LOLing every time you read it."
                            },
                            {
                                "example_id": "dd2ba25b-88f3-4d3f-860a-394c773aae77",
                                "sense_id": "83189349-ca83-32ba-becd-97bd5f3e5ea8",
                                "text": "Even if you don’t win, this slumber party quiz will have you LOL, ROFL, and LMAOing with your friends all the way into the night while you do everything you can to show them ALL that YOU are the ultimate Taylor Swift fan!"
                            },
                            {
                                "example_id": "07e502b2-3e61-4000-8ffb-a50d6109dcba",
                                "sense_id": "83189349-ca83-32ba-becd-97bd5f3e5ea8",
                                "text": "You’re girls. Whatever it is you want to kill each other over now, you’ll be LMAOing about on group chat in two hours. Trust me."
                            }
                        ]
                    }
