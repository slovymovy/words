        "fr-extract.jsonl": [
            {
                "entry_id": "9aa62b3a-116f-3f2c-87db-283878973203",
                "word": "zootechnie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "34fad1b8-25f7-4013-8adf-332675ca92f4",
                        "entry_id": "9aa62b3a-116f-3f2c-87db-283878973203",
                        "tags": [
                            "plural"
                        ],
                        "form": "zootechnies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70964220-3da8-329c-abcf-b614ed9f9c28",
                        "entry_id": "9aa62b3a-116f-3f2c-87db-283878973203",
                        "glosses": [
                            "Discipline scientifique étudiant les conditions et les méthodes d’élevage et de reproduction des animaux domestiques ainsi que l’amélioration de leurs races."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "f55cc44b-26bb-4b25-9c04-1d99113e95c1",
                                "sense_id": "70964220-3da8-329c-abcf-b614ed9f9c28",
                                "text": "Ne faisons donc pas de la science de caprice ou de fantaisie, mais établissons les principes de la zootechnie d’après les règles du bon sens et les enseignements de l’expérience."
                            },
                            {
                                "example_id": "b7bfd1d3-6dce-4160-a60c-aa1b2380f3b4",
                                "sense_id": "70964220-3da8-329c-abcf-b614ed9f9c28",
                                "text": "— Et vous vous en avez eu des poux ?\nTurellement, qu’ils répondent.\n— J’en ai même élevé, dit Jacques. Je voulais en obtenir des très grands, des très gros et des très forts. Avant de faire du cinéma je me suis occupé de zootechnie."
                            },
                            {
                                "example_id": "42767096-7a84-4a62-8c8d-24b42985aa33",
                                "sense_id": "70964220-3da8-329c-abcf-b614ed9f9c28",
                                "text": "À la fin de la deuxième année, je m’attendais à ce qu’Aymeric choisisse comme moi une spécialisation bidon, genre sociologie rurale ou écologie, mais au contraire il s’inscrivit en zootechnie, considérée comme une filière de bosseurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "63788eb5-ccc7-3d4e-94ff-891c4a4f7fd7",
                        "entry_id": "9aa62b3a-116f-3f2c-87db-283878973203",
                        "glosses": [
                            "Technique relative à la conception et à l'utilisation des bâtiments et des enclos pour les animaux sauvages dans un zoo."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
