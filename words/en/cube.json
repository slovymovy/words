{
    "word_family": [
        "cubic",
        "cubical",
        "cuboid",
        "cubism",
        "cubist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eed37bc9-f015-38fd-b4b8-5c0625db5fd4",
                    "sense_definition": "Any object more or less in the form of a cube.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "shape_geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She put an ice <w>cube</w> in her glass to keep the drink cold.",
                            "target_lang_translations": {
                                "ru": "Она положила <w>кубик</w> льда в стакан, чтобы напиток оставался холодным.",
                                "zh": "她往杯子里放了一<w>块</w>冰，好让饮料保持冰凉。"
                            }
                        },
                        {
                            "text": "Do you take one sugar <w>cube</w> or two with your tea?",
                            "target_lang_translations": {
                                "ru": "Вы кладете в чай один <w>кубик</w> сахара или два?",
                                "zh": "你喝茶时加一<w>块</w>方糖还是两块？"
                            }
                        }
                    ],
                    "synonyms": [
                        "block"
                    ],
                    "common_phrases": [
                        "ice cube",
                        "sugar cube",
                        "stock cube"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой предмет, имеющий форму куба (часто о небольших предметах).",
                        "zh": "指任何形状接近立方体的物体，常用于描述小件物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кубик",
                                "target_lang_sense_clarification": "маленький предмет (льда, сахара)"
                            },
                            {
                                "target_lang_word": "куб",
                                "target_lang_sense_clarification": "форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小方块",
                                "target_lang_sense_clarification": "指冰块、糖块等小物体"
                            },
                            {
                                "target_lang_word": "立方体",
                                "target_lang_sense_clarification": "指形状"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f05e7d6-48ec-3fc0-8186-160723d1790e",
                    "sense_definition": "A regular polyhedron having six identical square faces.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "shape_geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher showed us a wooden <w>cube</w> to explain the concept of volume.",
                            "target_lang_translations": {
                                "ru": "Учитель показал нам деревянный <w>куб</w>, чтобы объяснить понятие объема.",
                                "zh": "老师给我们展示了一个木制<w>立方体</w>来讲解体积的概念。"
                            }
                        },
                        {
                            "text": "A perfect <w>cube</w> has twelve edges of equal length.",
                            "target_lang_translations": {
                                "ru": "Идеальный <w>куб</w> имеет двенадцать ребер равной длины.",
                                "zh": "一个完美的<w>立方体</w>有十二条等长的棱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "regular hexahedron",
                        "block"
                    ],
                    "target_lang_definitions": {
                        "ru": "Правильный многогранник с шестью одинаковыми квадратными гранями.",
                        "zh": "具有六个相同正方形面的正多面体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куб",
                                "target_lang_sense_clarification": "геометрическое тело"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "立方体",
                                "target_lang_sense_clarification": "几何体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6d880b7-4c22-39ca-8260-d3b2d8d65775",
                    "sense_definition": "The third power of a number, value, term, or expression.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cube</w> of two is eight.",
                            "target_lang_translations": {
                                "ru": "<w>Куб</w> двух равен восьми.",
                                "zh": "二的<w>立方</w>是八。"
                            }
                        },
                        {
                            "text": "Students learned how to calculate the <w>cube</w> of large integers.",
                            "target_lang_translations": {
                                "ru": "Студенты учились вычислять <w>куб</w> больших целых чисел.",
                                "zh": "学生们学习了如何计算大整数的<w>三次方</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "third power"
                    ],
                    "antonyms": [
                        "cube root"
                    ],
                    "target_lang_definitions": {
                        "ru": "Третья степень числа; результат умножения числа на само себя дважды.",
                        "zh": "一个数、项或表达式的第三次幂。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куб",
                                "target_lang_sense_clarification": "математика"
                            },
                            {
                                "target_lang_word": "третья степень",
                                "target_lang_sense_clarification": "синоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "立方",
                                "target_lang_sense_clarification": "数学运算"
                            },
                            {
                                "target_lang_word": "三次方",
                                "target_lang_sense_clarification": "数学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "692e1c9b-6a7a-3db8-b0ae-32e4edfbc3e6",
                    "sense_definition": "A Rubik's cube style puzzle, not necessarily in the shape of a cube.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "puzzle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He can solve the puzzle <w>cube</w> in less than a minute.",
                            "target_lang_translations": {
                                "ru": "Он может собрать <w>кубик</w>-головоломку меньше чем за минуту.",
                                "zh": "他能在不到一分钟的时间内还原这个<w>魔方</w>。"
                            }
                        },
                        {
                            "text": "She bought a new speed <w>cube</w> for the competition.",
                            "target_lang_translations": {
                                "ru": "Она купила новый скоростной <w>кубик</w> для соревнований.",
                                "zh": "她为比赛买了一个新的竞速<w>魔方</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Rubik's cube"
                    ],
                    "target_lang_definitions": {
                        "ru": "Головоломка типа кубика Рубика.",
                        "zh": "类似魔方的益智玩具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кубик Рубика",
                                "target_lang_sense_clarification": "головоломка"
                            },
                            {
                                "target_lang_word": "кубик",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "魔方",
                                "target_lang_sense_clarification": "益智玩具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "935e032a-094b-3eac-8735-bed1bd50adc3",
                    "sense_definition": "A cubicle, especially one of those found in offices.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "office",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will be working in my <w>cube</w> all afternoon if you need me.",
                            "target_lang_translations": {
                                "ru": "Я буду работать в своей <w>кабинке</w> весь день, если я понадоблюсь.",
                                "zh": "如果你需要我，我整个下午都会在我的<w>隔间</w>里工作。"
                            }
                        },
                        {
                            "text": "He decorated the walls of his <w>cube</w> with pictures of his dog.",
                            "target_lang_translations": {
                                "ru": "Он украсил стены своей <w>кабинки</w> фотографиями своей собаки.",
                                "zh": "他用他家狗的照片装饰了<w>隔间</w>的墙壁。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for cubicle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рабочее место в офисе, отгороженное перегородками.",
                        "zh": "办公室中用隔板围成的个人工作区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кабинка",
                                "target_lang_sense_clarification": "рабочее место"
                            },
                            {
                                "target_lang_word": "кубик",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "隔间",
                                "target_lang_sense_clarification": "办公区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d6eecb4-7031-386c-92d8-f68be55cd9f2",
                    "sense_definition": "A data structure consisting of a three-dimensional array.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The analyst queried the data <w>cube</w> to extract sales figures for the year.",
                            "target_lang_translations": {
                                "ru": "Аналитик сделал запрос к <w>кубу</w> данных, чтобы извлечь показатели продаж за год.",
                                "zh": "分析师查询了<w>数据立方体</w>以提取年度销售数据。"
                            }
                        },
                        {
                            "text": "We organized the information into a multidimensional <w>cube</w> for better reporting.",
                            "target_lang_translations": {
                                "ru": "Мы организовали информацию в многомерный <w>куб</w> для лучшей отчетности.",
                                "zh": "为了更好地生成报告，我们将信息组织成了一个多维<w>立方体</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "data cube"
                    ],
                    "target_lang_definitions": {
                        "ru": "Структура данных в виде трехмерного массива.",
                        "zh": "一种三维数组形式的数据结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куб",
                                "target_lang_sense_clarification": "базы данных"
                            },
                            {
                                "target_lang_word": "OLAP-куб",
                                "target_lang_sense_clarification": "термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "数据立方体",
                                "target_lang_sense_clarification": "数据库术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac34cc91-f44f-38d9-bc75-00128f08c8c3",
                    "sense_definition": "Clipping of cubic inch(es).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "engine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic bored out the engine to increase the number of <w>cubes</w>.",
                            "target_lang_translations": {
                                "ru": "Механик расточил двигатель, чтобы увеличить количество <w>кубиков</w>.",
                                "zh": "技工扩缸以增加发动机的<w>排量</w>。"
                            }
                        },
                        {
                            "text": "That classic car has a massive engine with plenty of <w>cubes</w>.",
                            "target_lang_translations": {
                                "ru": "У этого классического автомобиля огромный двигатель с большим количеством <w>кубиков</w>.",
                                "zh": "那辆经典款汽车拥有一个<w>排量</w>巨大的发动机。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "automotive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное название объема двигателя (обычно в кубических дюймах).",
                        "zh": "指发动机排量（通常以立方英寸为单位）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кубики",
                                "target_lang_sense_clarification": "сленг, объем двигателя"
                            },
                            {
                                "target_lang_word": "кубические дюймы",
                                "target_lang_sense_clarification": "единица измерения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排量",
                                "target_lang_sense_clarification": "汽车术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3574d9e1-7b0b-3f83-b45c-fe3ac79e67ab",
                    "sense_definition": "To cut into cubes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>cube</w> the potatoes before adding them to the boiling water.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>нарежь кубиками</w> картофель перед тем, как добавить его в кипящую воду.",
                                "zh": "请把土豆<w>切成丁</w>后再放入沸水中。"
                            }
                        },
                        {
                            "text": "You should <w>cube</w> the cheese into small bite-sized pieces.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>нарезать кубиками</w> сыр на маленькие кусочки на один укус.",
                                "zh": "你应该把奶酪<w>切成</w>一口大小的方块。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cube the meat",
                        "cube the vegetables"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарезать продукты кубиками.",
                        "zh": "将食物切成小立方体形状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резать кубиками",
                                "target_lang_sense_clarification": "кулинария"
                            },
                            {
                                "target_lang_word": "нарезать кубиками",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "切成丁",
                                "target_lang_sense_clarification": "烹饪动作"
                            },
                            {
                                "target_lang_word": "切块",
                                "target_lang_sense_clarification": "烹饪动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2efffc92-1834-3d5b-9444-27045803bc1d",
                    "sense_definition": "To raise to the third power; to determine the result of multiplying by itself twice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>cube</w> the number three, you get twenty-seven.",
                            "target_lang_translations": {
                                "ru": "Если <w>возвести в куб</w> число три, получится двадцать семь.",
                                "zh": "如果你把三<w>求立方</w>，结果就是二十七。"
                            }
                        },
                        {
                            "text": "The student had to <w>cube</w> several values to solve the equation.",
                            "target_lang_translations": {
                                "ru": "Студенту пришлось <w>возвести в куб</w> несколько значений, чтобы решить уравнение.",
                                "zh": "学生必须将几个数值<w>进行三次方</w>运算才能解出方程。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возводить число в третью степень.",
                        "zh": "将一个数自乘两次，即求其三次方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возводить в куб",
                                "target_lang_sense_clarification": "математика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "求立方",
                                "target_lang_sense_clarification": "数学运算"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "370e462f-dd7d-3121-8fe2-c018cdbca363",
                    "sense_definition": "To form into the shape of a cube.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shape_geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine is designed to <w>cube</w> the scrap metal for easier transport.",
                            "target_lang_translations": {
                                "ru": "Машина предназначена для того, чтобы <w>прессовать в кубы</w> металлолом для облегчения транспортировки.",
                                "zh": "这台机器旨在将废金属<w>压成方块</w>以便运输。"
                            }
                        },
                        {
                            "text": "They <w>cube</w> the butter for packaging.",
                            "target_lang_translations": {
                                "ru": "Они <w>формуют в кубы</w> масло для упаковки.",
                                "zh": "他们将黄油<w>切成方块</w>进行包装。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать чему-либо форму куба.",
                        "zh": "使物体形成立方体形状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прессовать в кубы",
                                "target_lang_sense_clarification": "о материалах"
                            },
                            {
                                "target_lang_word": "формовать в кубики",
                                "target_lang_sense_clarification": "о пищевых продуктах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "压成方块",
                                "target_lang_sense_clarification": "加工处理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdfef0b9-78f4-3d3e-b44b-026f949dae60",
                    "sense_definition": "To use a Rubik's cube.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "puzzle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He likes to <w>cube</w> whenever he has a spare moment.",
                            "target_lang_translations": {
                                "ru": "Ему нравится <w>собирать кубик</w>, когда выдается свободная минутка.",
                                "zh": "他一有空就喜欢<w>玩魔方</w>。"
                            }
                        },
                        {
                            "text": "She learned to <w>cube</w> competitively last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году она научилась <w>собирать кубик</w> на скорость.",
                                "zh": "她去年学会了参加<w>魔方</w>竞速比赛。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься сборкой кубика Рубика.",
                        "zh": "玩魔方或进行魔方还原活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собирать кубик",
                                "target_lang_sense_clarification": "головоломка"
                            },
                            {
                                "target_lang_word": "спидкубить",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "玩魔方",
                                "target_lang_sense_clarification": "益智活动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "77b22a2e-ba4a-3bbc-b460-0273500aef7f",
                    "sense_definition": "Used to describe a volume formed by multiplying a unit of length by itself twice.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small box is exactly six inches <w>cube</w>.",
                            "target_lang_translations": {
                                "ru": "Маленькая коробка имеет размер ровно шесть дюймов <w>в кубе</w>.",
                                "zh": "这个小盒子正好是六英寸<w>立方</w>。"
                            }
                        },
                        {
                            "text": "We need a container that measures ten centimeters <w>cube</w>.",
                            "target_lang_translations": {
                                "ru": "Нам нужен контейнер размером десять сантиметров <w>в кубе</w>.",
                                "zh": "我们需要一个十厘米<w>立方</w>的容器。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обозначение объема или размеров кубического объекта.",
                        "zh": "用于描述立方体的尺寸或体积。"
                    },
