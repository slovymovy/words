                "senses": [
                    {
                        "sense_id": "e23bc8c9-f4e2-3d1c-b283-fa7010dabfe8",
                        "entry_id": "ff2d03fd-0582-34a3-a77b-cd68300ae3a1",
                        "glosses": [
                            "auf dem Rücken befindliche Seite"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c7486b2-b160-4835-95cf-b6a6074f27dc",
                                "sense_id": "e23bc8c9-f4e2-3d1c-b283-fa7010dabfe8",
                                "text": "Adulte Männchen der Nominatform sind von der Stirn bis zum Nacken braunschwarz, die Ohrdecken und die Halsseiten sind braun, der obere Rücken ist kräftig rot, die Rückenseiten und der untere Rücken sind dunkelgrün."
                            },
                            {
                                "example_id": "cdc958e2-1a80-4e1b-beff-bd42868ea0c9",
                                "sense_id": "e23bc8c9-f4e2-3d1c-b283-fa7010dabfe8",
                                "text": "Auch an der Bauchseite sind davon mehrere Längsreihen vorhanden und die Schuppen sind dort nur geringfügig kleiner als auf der Rückenseite."
                            },
                            {
                                "example_id": "e9df4083-85d8-42fb-8c4f-c55b6663b6ec",
                                "sense_id": "e23bc8c9-f4e2-3d1c-b283-fa7010dabfe8",
                                "text": "An den Seiten finden sich oft vier bis sechs dunkle Längsstreifen, die wiederum miteinander verschmelzen können, und die eine farbliche Trennung zwischen der Rückenseite und den Flanken bewirken."
                            },
                            {
                                "example_id": "fb021736-b310-4674-8a72-468f5b133a7c",
                                "sense_id": "e23bc8c9-f4e2-3d1c-b283-fa7010dabfe8",
                                "text": "Wenn die Biene ihren Hinterleib nach unten krümmt - die einzig mögliche Richtung -, dehnt sich diese Membran auf der Rückenseite aus und zieht sich im Bauchbereich zusammen, sodass die oberen Platten auseinander- und die unteren ineinandergleiten."
                            },
                            {
                                "example_id": "c7978f30-5a0a-4b3c-b3f7-aee313f5d2be",
                                "sense_id": "e23bc8c9-f4e2-3d1c-b283-fa7010dabfe8",
                                "text": "An der Puppe war auf der Brust- und Rückenseite jeweils ein gelber Davidstern in einer Größe von 25 Zentimetern mit der Aufschrift »Jude« angebracht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
