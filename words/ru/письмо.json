    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13c3aea6-6822-357c-8d03-5b30598860a5",
                    "sense_definition": "Текст, написанный или отправленный кому-либо для сообщения информации (на бумаге или в электронном виде).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я вчера получил долгожданное <письмо> от своего старого друга.",
                            "target_lang_translations": {
                                "en": "Yesterday I received a long-awaited <letter> from my old friend.",
                                "zh": "我昨天收到了老朋友寄来的那封期待已久的<信>。"
                            }
                        },
                        {
                            "text": "Тебе нужно срочно отправить это заказное <письмо> по почте.",
                            "target_lang_translations": {
                                "en": "You need to send this registered <letter> by mail immediately.",
                                "zh": "你需要尽快把这封挂号<信>寄出去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "послание",
                        "сообщение"
                    ],
                    "common_phrases": [
                        "написать письмо",
                        "отправить письмо",
                        "получить письмо",
                        "электронное письмо",
                        "заказное письмо"
                    ],
                    "target_lang_definitions": {
                        "en": "A written message sent to someone, either on paper or electronically.",
                        "zh": "发送给某人的书面信息，可以是纸质的或电子的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "letter",
                                "target_lang_sense_clarification": "written message"
                            },
                            {
                                "target_lang_word": "email",
                                "target_lang_sense_clarification": "electronic message"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "信",
                                "target_lang_sense_clarification": "书面信息"
                            },
                            {
                                "target_lang_word": "电子邮件",
                                "target_lang_sense_clarification": "电子信息"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c39e1e3-5cbd-3e07-8422-6984683abac9",
                    "sense_definition": "Система графических знаков, принятая для фиксации речи в каком-либо языке.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Древнее иероглифическое <письмо> было очень сложным для изучения.",
                            "target_lang_translations": {
                                "en": "Ancient hieroglyphic <writing> was very difficult to learn.",
                                "zh": "古代的象形<文字>非常难学。"
                            }
                        },
                        {
                            "text": "Славянское <письмо> развивалось на протяжении многих веков.",
                            "target_lang_translations": {
                                "en": "Slavic <script> developed over many centuries.",
                                "zh": "斯拉夫<书写系统>经历了几个世纪的发展。"
                            }
                        }
                    ],
                    "synonyms": [
                        "пи́сьменность",
                        "письмена́"
                    ],
                    "common_phrases": [
                        "иероглифическое письмо",
                        "узелковое письмо",
                        "предметное письмо",
                        "русское письмо"
                    ],
                    "target_lang_definitions": {
                        "en": "A system of graphic symbols used to represent speech in a language.",
                        "zh": "用于记录语言的图形符号系统。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "writing",
                                "target_lang_sense_clarification": "system of recording language"
                            },
                            {
                                "target_lang_word": "script",
                                "target_lang_sense_clarification": "specific system of characters"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "文字",
                                "target_lang_sense_clarification": "记录语言的系统"
                            },
                            {
                                "target_lang_word": "书写系统",
                                "target_lang_sense_clarification": "特定的字符系统"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "facac364-b7b2-3dc9-90c3-e7205de41d73",
                    "sense_definition": "Умение писать, а также сам процесс написания текста.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В первом классе дети осваивают чтение и <письмо>.",
                            "target_lang_translations": {
                                "en": "In the first grade, children master reading and <writing>.",
                                "zh": "一年级的孩子开始学习阅读和<书写>。"
                            }
                        },
                        {
                            "text": "Обучение <письму> требует от учеников много времени и терпения.",
                            "target_lang_translations": {
                                "en": "Learning <writing> requires a lot of time and patience from students.",
                                "zh": "学习<写作>需要学生投入大量的时间和耐心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "грамота"
                    ],
                    "common_phrases": [
                        "обучение письму",
                        "навыки письма",
                        "чтение и письмо",
                        "урок письма"
                    ],
                    "target_lang_definitions": {
                        "en": "The skill of writing or the act of writing text.",
                        "zh": "书写的技能或书写文字的过程。"
                    },
                    "translations": {
