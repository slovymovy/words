                    "frequency": "VeryLow",
                    "semantic_group_id": "candle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room smelled of the <w>snuff</w> left on the candle after it was blown out."
                        },
                        {
                            "text": "He used a tool to remove the black <w>snuff</w> from the wick."
                        }
                    ]
