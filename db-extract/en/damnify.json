                        "examples": [
                            {
                                "example_id": "ef61a9f4-8d25-4817-a8c9-57909c516631",
                                "sense_id": "fe58300d-0804-3a4b-9f4f-3fe7bb91776e",
                                "text": "he saw himselfe so freshly reare, / As if late fight had nought him damnifyde […]"
                            },
                            {
                                "example_id": "5f3fc986-aaae-46c0-b317-9c2d3e0e496e",
                                "sense_id": "fe58300d-0804-3a4b-9f4f-3fe7bb91776e",
                                "text": "The infectious raines most damnifying the poore saylers, who must be upon the decks to hand in their sailes, abiding the brunt […]"
                            },
                            {
                                "example_id": "7fa84516-7755-45bb-bf73-500a1988b854",
                                "sense_id": "fe58300d-0804-3a4b-9f4f-3fe7bb91776e",
                                "text": "The High Tide at Bristol spoil'd or damnify'd 1500 Hogsheds of Sugars and Tobaccoes, besides great quantities of other Goods."
                            }
                        ]
