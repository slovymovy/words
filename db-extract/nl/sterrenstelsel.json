                    {
                        "sense_id": "85858900-9894-351b-96f0-7d898b70a5d1",
                        "entry_id": "7c3b48fa-7e26-36b3-a8ec-396b194c67cc",
                        "glosses": [
                            "een grote verzameling sterren die zich op relatief geringe onderlinge afstand bevinden. Het systeem wordt bij elkaar gehouden door de eigen zwaartekracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf80e19c-2a7a-4cf0-a5f7-35346c57a8db",
                                "sense_id": "85858900-9894-351b-96f0-7d898b70a5d1",
                                "text": "De melkweg, ons sterrenstelsel, is bij nacht op een donkere locatie met het blote oog waarneembaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97bd5a97-f232-4ba9-9211-be0e772a1e3d",
                        "source_entry_id": "7c3b48fa-7e26-36b3-a8ec-396b194c67cc",
                        "source_sense_id": "85858900-9894-351b-96f0-7d898b70a5d1",
                        "target_lang_word": "Galaxie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Galaxie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20933ab1-67de-3e9e-98f1-8ed72fbbb632",
                                        "entry_id": "3f949dc0-6e3c-3d82-a44e-2e158359192b",
                                        "glosses": [
                                            "große Ansammlung von Sternen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04e081c0-b0cb-4582-b9f5-a451ad0e5089",
                                                "sense_id": "20933ab1-67de-3e9e-98f1-8ed72fbbb632",
                                                "text": "‚Galaxy Zoo‘ ist ein Projekt, bei dem jeder Internetbenutzer Galaxien klassifizieren kann."
                                            },
                                            {
                                                "example_id": "72394ced-e241-4dfc-b31a-532ab023e718",
                                                "sense_id": "20933ab1-67de-3e9e-98f1-8ed72fbbb632",
                                                "text": "„Beim Aufspüren von Exoplaneten, fernen Galaxien oder einem Spiralnebel liefern Sternwarten immer wieder bombastische Farbbilder - obwohl das Weltall das Leuchten der Sterne verschluckt und die Astronomen bei ihren Entdeckungen nur trockenes Datenmaterial produzieren.“"
                                            },
                                            {
                                                "example_id": "c265ca80-23ee-4371-ada4-fa679620ea76",
                                                "sense_id": "20933ab1-67de-3e9e-98f1-8ed72fbbb632",
                                                "text": "„Allmählich habe sich das Wissen jedoch erweitert, und vor einem Jahrhundert seien sich die bedeutendsten Wissenschaftler einig gewesen, dass unser Sonnensystem nur ein kleiner Teil einer riesengroßen Galaxie sei und diese das Universum darstelle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
