                "senses": [
                    {
                        "sense_id": "ede3664c-6e23-3e61-a340-d13aadffb4fa",
                        "entry_id": "008598b5-e835-3aeb-8c81-a3a529c449b1",
                        "glosses": [
                            "Person, die sich noch ohne Verkehrserfahrung im Verkehrsbereich bewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20c9f612-b3de-4fa1-85c9-dc540e17208d",
                                "sense_id": "ede3664c-6e23-3e61-a340-d13aadffb4fa",
                                "text": "„Von heute an sind wieder eine Menge Verkehrsanfänger unterwegs.“"
                            },
                            {
                                "example_id": "b99aa7e0-655c-4cb9-8730-fba9ca19faed",
                                "sense_id": "ede3664c-6e23-3e61-a340-d13aadffb4fa",
                                "text": "„Zuerst mal haben wir bei uns nur 3 Polizeibeamte abgestellt, die die paar tausend Verkehrsanfänger in Schulen, bei Post, Bahn und Bundeswehr zweiradmündig machen.“"
                            },
                            {
                                "example_id": "941fda42-dd68-4ebb-8089-d8b1745ef0cd",
                                "sense_id": "ede3664c-6e23-3e61-a340-d13aadffb4fa",
                                "text": "„Das nachfolgende Beispielstück eignet sich für Verkehrsanfänger. Es setzt keine Verkehrserfahrungen voraus.“"
                            },
                            {
                                "example_id": "959a6370-1998-4c4e-a7f0-77d60135de2d",
                                "sense_id": "ede3664c-6e23-3e61-a340-d13aadffb4fa",
                                "text": "„Im Benjamin-Blümchen-Verkehrslernspiel ‚Sicher zur Schule’ tun sie das freiwillig und mit großem Vergnügen (von Schmidt Spiele, für 2 bis 4 Verkehrsanfänger ab 5 Jahren, ca. 35 Mark).“"
                            },
                            {
                                "example_id": "df947bd8-87ca-41b0-96aa-a787891edfa2",
                                "sense_id": "ede3664c-6e23-3e61-a340-d13aadffb4fa",
                                "text": "„Auch Radfahrer oder parkende Autos könnten die Kinder schnell übersehen, appellierte man an die Verkehrsanfänger, auch jenseits der Hauptstraßen vorsichtig zu sein,“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
