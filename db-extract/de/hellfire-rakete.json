                ],
                "senses": [
                    {
                        "sense_id": "429aa0d1-a138-3d49-9263-4febd38e8ada",
                        "entry_id": "a3becdf1-1caf-3676-a80f-3a0dbfe398a0",
                        "glosses": [
                            "US-amerikanischer Luft-Boden-Raketentyp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70f1a5c9-3d8d-416c-8d31-df07e5f07f25",
                                "sense_id": "429aa0d1-a138-3d49-9263-4febd38e8ada",
                                "text": "„Auch sie starrten jetzt auf ihre eigenen Bildschirme, bereit, eine Hellfire-Rakete abzufeuern, falls aus dem Dunkel der Höhle ein hochgewachsener, hagerer Mann nach draußen treten sollte.“"
                            },
                            {
                                "example_id": "f8e35ee6-441f-4a9a-961a-13a169e56cda",
                                "sense_id": "429aa0d1-a138-3d49-9263-4febd38e8ada",
                                "text": "„Und bei entsprechender Ausrüstung und entsprechendem Befehl konnte sie die Hellfire-Raketen abfeuern, die an den Flächenträgern ihres Reaper-Jagdflugzeugs hingen.“"
                            },
                            {
                                "example_id": "2c90c249-b26e-418f-a763-9bce0d97f400",
                                "sense_id": "429aa0d1-a138-3d49-9263-4febd38e8ada",
                                "text": "„Das Spektrum der eingesetzten Waffen reichte von bewaffneten Drohnen und amerikanischen Apache-Hubschraubern, die Hellfire-Raketen aus US-amerikanischer Produktion abfeuerten, bis hin zu amerikanischen F-16- und F-15-Kampfbombern mit 900-Kilo-Bomben.“"
                            },
                            {
                                "example_id": "5d896a9d-ecf7-4948-ba89-0058dfd198ea",
                                "sense_id": "429aa0d1-a138-3d49-9263-4febd38e8ada",
                                "text": "„Doyle nahm an, dass eine Hellfire-Rakete bei einem Eselkarren mindestens so effektiven Schaden anrichtete wie bei einem Pick-up-Truck - daher entzog sich seinem Verständnis, welchen Sinn diese spezielle List hatte.“"
                            },
                            {
                                "example_id": "b26ff7ad-c386-48ac-b7b0-595c37b0a58f",
                                "sense_id": "429aa0d1-a138-3d49-9263-4febd38e8ada",
                                "text": "„Die verantwortlichen Schützen, die um sich schießen - oder Sprengfallen platzieren, den Einsatz von Nervengas genehmigen, eine Drohne mit einer Hellfire-Rakete entsenden und das falsche Ziel treffen -, vergießen darüber keine Träne und bezeichnen die jungen Opfer bloß als ›Kollateralschaden‹, sofern überhaupt Notiz von ihnen genommen wird.“"
                            },
                            {
                                "example_id": "4f6a80a7-5999-46c8-af34-a98d3ebd7b66",
                                "sense_id": "429aa0d1-a138-3d49-9263-4febd38e8ada",
                                "text": "„Es handelte sich um eine MQ-9 Reaper, die mit Hellfire-Raketen bestückt war und derzeit geräuschlos durch den Himmel über Islamabad flog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
