                    {
                        "form_id": "53263e2a-bd71-4627-ba80-ba65e714b555",
                        "entry_id": "cb4c8d58-9cce-3242-89a5-79a012f0eafe",
                        "tags": [
                            "accusative",
                            "definite",
                            "plural"
                        ],
                        "form": "Halle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5aaf2d7d-76c2-3805-b3b3-42d07b1fef55",
                        "entry_id": "cb4c8d58-9cce-3242-89a5-79a012f0eafe",
                        "glosses": [
                            "echo, resonance, reverberation"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "d416b703-a096-46e3-9f0d-35d1cccf85bb",
                                "sense_id": "5aaf2d7d-76c2-3805-b3b3-42d07b1fef55",
                                "text": "Mehrere Halle können zugleich entstehen, da mehr als eine jener Schallwellen eine solche Hemmung erleiden kann."
                            },
                            {
                                "example_id": "cc689353-c428-4c4c-95f6-28de440e3595",
                                "sense_id": "5aaf2d7d-76c2-3805-b3b3-42d07b1fef55",
                                "text": "„Ei,“ dachte ich, „es befindet sich ein Nachtwandler wie ich selbst auf der Chaussee, und die Stille der Nacht führt den Hall seiner Schritte zu mir herüber.“ Indeß die Stärke und die Deutlichkeit dieses Halles standen offenbar in keinem Verhältnisse zu einer solchen Entfernung."
                            },
                            {
                                "example_id": "0e6d4921-e2c1-41d4-a9ea-017647b53627",
                                "sense_id": "5aaf2d7d-76c2-3805-b3b3-42d07b1fef55",
                                "text": "Ebenso klar und deutlich, wie man den Hall der Klapper beim Anschlag des Klöppels vor dem Auspumpen hören konnte […]",
                                "translation": "Just as clearly as it was possible to hear the echo of the rattle when the clapper struck before being pumped out […]",
                                "english": "Just as clearly as it was possible to hear the echo of the rattle when the clapper struck before being pumped out […]"
                            },
                            {
                                "example_id": "cbf6c2ce-7211-4808-a28b-82b703051930",
                                "sense_id": "5aaf2d7d-76c2-3805-b3b3-42d07b1fef55",
                                "text": "In unserem Fall erscheint der Ton als Echo eines Halles, der schon einmal ergangen scheint."
                            },
                            {
                                "example_id": "06c82df1-cafb-4f9f-9871-52e8d6bf1480",
                                "sense_id": "5aaf2d7d-76c2-3805-b3b3-42d07b1fef55",
                                "text": "Dann erklang das seltsamste Geräusch, das Seramis je vernommen hatte. Ein ohrenbetäubender Donner, lauter als alles was sie je gehört hatte, doch der Hall blieb aus. Donner ohne Hall.",
                                "translation": "Then came the sound of the most peculiar noise Seramis had ever perceived. Deafening thunder, louder than anything she had ever heard, but there was no echo. Thunder without an echo.",
                                "english": "Then came the sound of the most peculiar noise Seramis had ever perceived. Deafening thunder, louder than anything she had ever heard, but there was no echo. Thunder without an echo."
                            },
                            {
                                "example_id": "edc0e202-4df3-43b4-84a2-3872636db8c2",
                                "sense_id": "5aaf2d7d-76c2-3805-b3b3-42d07b1fef55",
                                "text": "Wenn alle Mädchen in den Nachtkammern der Fabrik lagen, ging die Tür zum Keller mit einem Hall zu.",
                                "translation": "When all the girls were lying in the factory's night chambers, the door to the cellar closed with an echo.",
                                "english": "When all the girls were lying in the factory's night chambers, the door to the cellar closed with an echo."
                            }
                        ]
                    }
                ],
