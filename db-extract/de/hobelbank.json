                "senses": [
                    {
                        "sense_id": "e4190db3-413e-326d-82b0-d9fee242eadb",
                        "entry_id": "c9aba33d-8e1c-3083-bd2f-38bbf252adc5",
                        "glosses": [
                            "Werkbank eines Tischlers zum Hobeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fee33d36-3111-4122-8895-d02ca428dedb",
                                "sense_id": "e4190db3-413e-326d-82b0-d9fee242eadb",
                                "text": "Der Schraubstock an seiner Hobelbank ist beschädigt."
                            },
                            {
                                "example_id": "5a0624df-f904-44d3-913a-b73dd55bda19",
                                "sense_id": "e4190db3-413e-326d-82b0-d9fee242eadb",
                                "text": "„Dort gab es eine Hobelbank, die mir als Schreibtisch diente.“"
                            },
                            {
                                "example_id": "ebdf70b4-006a-4e3f-a6b3-42bd67a5e2a3",
                                "sense_id": "e4190db3-413e-326d-82b0-d9fee242eadb",
                                "text": "„Man sollte es nicht glauben, aber er fürchtet sich dann vor Gespenstern, und der Kanarienvogel, den er in einem Papageienkäfig über seiner Hobelbank hängen hat, ist um diese Zeit nicht genug Gesellschaft für ihn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83d72199-a62f-48c3-b68c-32a1a353a1d3",
                        "source_entry_id": "c9aba33d-8e1c-3083-bd2f-38bbf252adc5",
                        "source_sense_id": "e4190db3-413e-326d-82b0-d9fee242eadb",
