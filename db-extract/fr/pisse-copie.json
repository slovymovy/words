                        "sense_id": "19f94044-9d97-37e3-807b-b35804bd390f",
                        "entry_id": "3720bb58-acba-3a5c-baa7-688de8ef2213",
                        "glosses": [
                            "Écrivain ou journaliste très fécond, qui fait passer la quantité devant la qualité."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a69302a4-2e12-4c13-b06d-343e0bf08d84",
                                "sense_id": "19f94044-9d97-37e3-807b-b35804bd390f",
                                "text": "C’est bien connu, les journalistes sont des paresseux, des fouille-merdes, des pisse-copies, des retranscriveux de communiqués et des propagandistes à la solde de la pub."
                            },
                            {
                                "example_id": "82e718f0-9703-41a7-a270-e1a73f354093",
                                "sense_id": "19f94044-9d97-37e3-807b-b35804bd390f",
                                "text": "Tout cela par la faute d’un petit pisse-copie de basse-fosse trop heureux d’échapper pour une fois à ses chiens écrasés quotidiens !"
                            },
                            {
                                "example_id": "0aba800d-54b6-4d5b-bc7b-c6802aaa58b7",
                                "sense_id": "19f94044-9d97-37e3-807b-b35804bd390f",
                                "text": "Et le voilà, ce satané pisse-copie, ses yeux armés sur mes fesses, en train de faire mumuse avec son panier pour entamer la conversation."
                            }
                        ]
                    }
                ],
