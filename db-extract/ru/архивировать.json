                                                "example_id": "54ba64a7-5798-4b8d-b429-0c8c134c4a2b",
                                                "sense_id": "be290e24-72e1-33a0-bf6c-9a2c5ec2bb0c",
                                                "text": "His archive of Old High German texts is the most extensive in Britain."
                                            }
