                ],
                "senses": [
                    {
                        "sense_id": "eb60d963-36c1-37aa-9820-ef31cd63b20a",
                        "entry_id": "e58b1c91-9176-3046-8f7f-52f5a4d1429d",
                        "glosses": [
                            "erstmalige Einschreibung zu Lehrveranstaltungen an einer Universität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "988c411d-76f0-4897-90d4-8b92dd5fb7c9",
                                "sense_id": "eb60d963-36c1-37aa-9820-ef31cd63b20a",
                                "text": "„Die Erstinskription ist die erstmalige Anmeldung an der Universität.“"
                            },
                            {
                                "example_id": "986ff1dc-a4ec-47cb-be5a-da7f94c40751",
                                "sense_id": "eb60d963-36c1-37aa-9820-ef31cd63b20a",
                                "text": "„Der Umfang des Studiums ist in der Studien- und Prüfungsordnung festgehalten, die anlässlich der Erstinskription dem/der Studierenden ausgefolgt und von dieser/diesem mit seiner/ihrer Unterschrift zur Kenntnis genommen wird.“"
                            },
                            {
                                "example_id": "6ff86b3a-c113-4c6b-80fb-cf8e0a5daf2b",
                                "sense_id": "eb60d963-36c1-37aa-9820-ef31cd63b20a",
                                "text": "„Nur in begründeten Fällen ist eine verspätete Erstinskription möglich.“"
                            },
                            {
                                "example_id": "edb2c3e3-59ab-4d8b-94a7-7354fffd4929",
                                "sense_id": "eb60d963-36c1-37aa-9820-ef31cd63b20a",
                                "text": "„Im übrigen ist nicht erkennbar, warum der Beschwerdeführer, der - unter Außerachtlassung der im Gesetz enthaltenen, oben beschriebenen Beweisregel - die Auffassung vertritt, auch bei ordentlichen Hörern des ersten Studienabschnittes könne man sich ohne Beibringung der im Gesetz geforderten Nachweise darauf berufen, das Studium werde ernsthaft und zielstrebig betrieben, der Meinung ist, sein Sohn, der seit der Erstinskription an der Universität Wien keine einzige Prüfung absolviert hat, habe das ordentliche Studium ernsthaft und zielstrebig betrieben.“"
                            },
                            {
                                "example_id": "cae21c00-879d-409e-bd21-7e6b3dc10db2",
                                "sense_id": "eb60d963-36c1-37aa-9820-ef31cd63b20a",
                                "text": "„Darauf, ob in einem solchen Fall (nämlich bei einer Nichtinskription nach bereits erfolgter Erstinskription) auch die Möglichkeit einer Zulassung zu Prüfungen besteht, und insofern ein ‚aktives‘ Studium möglich ist, kommt es zufolge der formalen Anknüpfung des § 12 Abs. 3 lit. f AlVG nicht an (…).“"
                            },
                            {
                                "example_id": "1e5e6ca5-e4db-4f5d-9fff-cbe8a5a36a5d",
                                "sense_id": "eb60d963-36c1-37aa-9820-ef31cd63b20a",
                                "text": "„Tragen Sie auch das Semester der Erstinskription ein.“"
                            },
                            {
                                "example_id": "f2526b5c-fc16-48dc-bdda-174198dfd334",
                                "sense_id": "eb60d963-36c1-37aa-9820-ef31cd63b20a",
                                "text": "„Für die Erstinskription sind folgende Dokumente mitzubringen: …“"
                            },
                            {
                                "example_id": "e267d036-2a93-4773-8d96-4c244d962946",
                                "sense_id": "eb60d963-36c1-37aa-9820-ef31cd63b20a",
                                "text": "„Die Einlösung dieses Schecks sollte im Rahmen der Erstinskription erfolgen; das wäre auch bürokratisch leichter zu bewerkstelligen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
