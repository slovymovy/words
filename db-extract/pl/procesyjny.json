                "senses": [
                    {
                        "sense_id": "50d7dab6-79c9-3b82-93c1-66f75346828e",
                        "entry_id": "057f846e-6752-3579-9d8d-e2678bbbc73b",
                        "glosses": [
                            "związany z procesją, dotyczący procesji"
                        ],
                        "tags": [],
