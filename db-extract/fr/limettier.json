                "senses": [
                    {
                        "sense_id": "0e194084-faec-3ab4-9be2-01c041673455",
                        "entry_id": "4fdd0b7b-f13e-37f5-a65b-f37bbb2ebac3",
                        "glosses": [
                            "Nom usuel du limettier doux Citrus limettioides et Citrus limetta dont les fruits sont nommés citron doux ou limette douce et parfois lime douce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf4adc32-c7e9-44db-8605-8d825b53ebdf",
                                "sense_id": "0e194084-faec-3ab4-9be2-01c041673455",
                                "text": "Sans doute un jardin. Non pas un jardin d’agrément - existait-il dans ce pays quelque chose qui fût d’agrément ? Plutôt un espace d’utilité, où mon père avait planté des fruitiers, manguiers, goyaviers, papayers, et pour servir de haie devant la varangue, des orangers et des limettiers dont les fourmis avaient cousu la plupart des feuilles pour faire leurs nids aériens, débordant d’une sorte de duvet cotonneux qui abritait leurs œufs."
                            },
                            {
                                "example_id": "eec73c0c-e693-464c-87c7-a0a77e98665a",
                                "sense_id": "0e194084-faec-3ab4-9be2-01c041673455",
                                "text": "Appartenant à la famille des rutacées, le genre citrus, né en Sud-Est asiatique, est à l’origine des quatre espèces (mandariniers, pamplemoussiers, cédratiers et un papeda) les plus courantes sur nos étals : orangers, citronniers, limettiers et pomelos."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b702256-063a-38b8-b48c-9cdf196ea490",
                        "entry_id": "4fdd0b7b-f13e-37f5-a65b-f37bbb2ebac3",
                        "glosses": [
                            "Nom usuel du limettier acide, Citrus aurantiifolia nommé aussi limettier mexicain, limettier des Antilles ou citronnier gallet et dont le fruit est le citron vert ou lime ou citron gallet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e2eb21d-3321-4791-a073-227d1d475b05",
                                "sense_id": "9b702256-063a-38b8-b48c-9cdf196ea490",
                                "text": "Le limettier ou lime, est un arbre de taille moyenne, au feuillage comparable à celui du citronnier, aux fleurs blanches, portant des fruits limoniformes, mamelonnés au sommet, piriformes, avec une peau fine et amère, une pulpe jaune ou verte."
                            }
                        ]
                    }
