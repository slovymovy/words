{
    "word_family": [
        "fathomable",
        "unfathomable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "319ccdf9-4bc3-3a8e-9355-85942a309f06",
                    "sense_definition": "To deeply understand or comprehend something complex.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "understand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is hard to <w>fathom</w> why they decided to cancel the project so suddenly.",
                            "target_lang_translations": {
                                "de": "Es ist schwer zu <w>begreifen</w>, warum sie sich so plötzlich dazu entschieden haben, das Projekt abzusagen."
                            }
                        },
                        {
                            "text": "Scientists are still trying to <w>fathom</w> out the mysteries of the deep ocean.",
                            "target_lang_translations": {
                                "de": "Wissenschaftler versuchen immer noch, die Geheimnisse der Tiefsee zu <w>ergründen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "figure out",
                        "puzzle out",
                        "work out"
                    ],
                    "common_phrases": [
                        "fathom out"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas Komplexes tiefgehend verstehen oder begreifen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "begreifen",
                                "target_lang_sense_clarification": "etwas mit dem Verstand erfassen"
                            },
                            {
                                "target_lang_word": "ergründen",
                                "target_lang_sense_clarification": "den Grund oder die Ursache für etwas herausfinden"
                            },
                            {
                                "target_lang_word": "verstehen",
                                "target_lang_sense_clarification": "den Sinngehalt oder die Bedeutung von etwas erfassen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd2acde5-b8a5-366a-8923-9b7b697fcbab",
                    "sense_definition": "To measure the depth of water.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors used a weighted line to <w>fathom</w> the depth of the harbor.",
                            "target_lang_translations": {
                                "de": "Die Seeleute benutzten eine beschwerte Leine, um die Tiefe des Hafens zu <w>auszuloten</w>."
                            }
                        },
                        {
                            "text": "They needed to <w>fathom</w> the channel before the large ship could safely enter.",
                            "target_lang_translations": {
                                "de": "Sie mussten die Fahrrinne <w>loten</w>, bevor das große Schiff sicher einfahren konnte."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die Wassertiefe messen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ausloten",
                                "target_lang_sense_clarification": "die Wassertiefe bestimmen"
                            },
                            {
                                "target_lang_word": "loten",
                                "target_lang_sense_clarification": "die Wassertiefe mit einem Lot bestimmen"
                            },
                            {
                                "target_lang_word": "sondieren",
                                "target_lang_sense_clarification": "die Wassertiefe messen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d73d2a81-5499-371e-baf7-f6243da3968c",
                    "sense_definition": "A unit of length equal to six feet, used for measuring the depth of water.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shipwreck lies at a depth of fifty <w>fathoms</w> below the surface.",
                            "target_lang_translations": {
                                "de": "Das Schiffswrack liegt in einer Tiefe von fünfzig <w>Faden</w> unter der Oberfläche."
                            }
                        },
                        {
                            "text": "The old map marked the water depth in <w>fathoms</w> rather than meters.",
                            "target_lang_translations": {
                                "de": "Die alte Karte gab die Wassertiefe in <w>Klaftern</w> statt in Metern an."
                            }
                        }
                    ],
                    "synonyms": [
                        "brace"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Längeneinheit von etwa 1,8 Metern, die zur Messung der Wassertiefe verwendet wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Faden",
                                "target_lang_sense_clarification": "Längeneinheit zur Angabe der Wassertiefe"
                            },
                            {
                                "target_lang_word": "Klafter",
                                "target_lang_sense_clarification": "maritimes Tiefenmaß"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}