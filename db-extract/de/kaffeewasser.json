                        "examples": [
                            {
                                "example_id": "490491eb-3b73-4df1-be28-5f396c1c6db0",
                                "sense_id": "73f0772e-78b5-3775-afa7-c27d3eeb1afe",
                                "text": "„Aufgrund der Nummernangabe wußte sie, wie viele Stühle sie noch hinstellen und wieviel Kaffeewasser sie aufsetzen mußte.“"
                            },
                            {
                                "example_id": "a4fcbfe8-0466-4c99-a947-6a04f8e5266a",
                                "sense_id": "73f0772e-78b5-3775-afa7-c27d3eeb1afe",
                                "text": "„Kaum sind wir im Haus, kaum hat Marie das Kaffeewasser aufgesetzt, klopft es an die Tür.“"
                            },
                            {
                                "example_id": "2a0cddf3-5212-48e3-8e34-dd9445798d66",
                                "sense_id": "73f0772e-78b5-3775-afa7-c27d3eeb1afe",
                                "text": "„Der Papa erwartet sie oben an der Straße, um sie auf den Platz einzuwinken, und die Mama rückt im Wohnwagen alles schön zurecht und setzt Kaffeewasser auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
