            {
                "entry_id": "d27cc225-debc-3a45-9367-bc880989b67c",
                "word": "libyque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f2731be4-84c3-3327-88bc-73785fff945f",
                        "entry_id": "d27cc225-debc-3a45-9367-bc880989b67c",
                        "glosses": [
                            "Langue ancestrale au berbère actuel, autrefois parlée en Libye antique par les anciens Libyens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3ef7588-2bab-450b-8b93-b313b7634a3f",
                                "sense_id": "f2731be4-84c3-3327-88bc-73785fff945f",
                                "text": "Le libyque (parfois appelé paléoberbère voire berbère ancien) est un ensemble de langues, déclinées en plusieurs dialectes, autrefois parlées par les populations de la Libye antique en Afrique du Nord et dont descend le berbère moderne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a26589a5-b41d-4c2e-ae79-6bb3815daeef",
                        "source_entry_id": "d27cc225-debc-3a45-9367-bc880989b67c",
                        "source_sense_id": "f2731be4-84c3-3327-88bc-73785fff945f",
                        "target_lang_word": "Libyan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
