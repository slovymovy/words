                ],
                "senses": [
                    {
                        "sense_id": "811fa069-b75f-3890-921f-dc29e50bc923",
                        "entry_id": "c46cd16e-0e5d-3ddf-8d36-967fa0368a1a",
                        "glosses": [
                            "technisches Gerät das Luft aufbereitet und bewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3db3ebff-5436-45a7-a8fb-3485c5f013c9",
                                "sense_id": "811fa069-b75f-3890-921f-dc29e50bc923",
                                "text": "„Dafür wurde ein komplettes Fassadenelement entwickelt, das aus einem Oberlicht und einem Drehkippfenster besteht, die sich automatisiert öffnen lassen, sowie einem dezentralen Lüftungsgerät mit einer integrierten Wärmerückgewinnung im Brüstungsbereich.“"
                            },
                            {
                                "example_id": "9f407cbd-9870-42ff-8d7c-bd128473acce",
                                "sense_id": "811fa069-b75f-3890-921f-dc29e50bc923",
                                "text": "„Die Lüftungsgeräte sind mit hocheffektiven Gegenstromtauschern ausgestattet, die dazu optimiert sind, eine sehr hohe Wirkungsgrad und gleichzeitig einen niedrigen Druckverlust zu sichern, was insgesamt den spezifischen Energiebedarf (SELWert) der ganzen Einheit so niedrig wie möglich hält.“"
                            },
                            {
                                "example_id": "51ce9851-fabc-44b4-abd6-7e9cf879ff58",
                                "sense_id": "811fa069-b75f-3890-921f-dc29e50bc923",
                                "text": "„Das neue Lüftungsgerät bietet Luftvolumenstromleistungen von 890 bis 1.000 m³/h und lässt sich damit in allen relevanten Anwendungsbereichen wie Ladengeschäften, Kanzleien, Praxen und Büros einsetzen.“"
                            },
                            {
                                "example_id": "772c9b1a-e197-467d-9d1e-cf2b5d8b2ecf",
                                "sense_id": "811fa069-b75f-3890-921f-dc29e50bc923",
                                "text": "„Ein kompakter, hocheffizienter Doppelschalldämpfer schließt das Lüftungsgerät raumseitig ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
