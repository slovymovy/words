                ],
                "senses": [
                    {
                        "sense_id": "6302ee05-f05c-3a47-9ff1-7cd0a390987c",
                        "entry_id": "64722367-dd5f-302d-9748-be02ca4e78b3",
                        "glosses": [
                            "The contents of a full truck or lorry."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "155193e5-5581-4af0-ad0e-fb602e941609",
                                "sense_id": "6302ee05-f05c-3a47-9ff1-7cd0a390987c",
                                "text": "A task force of 1,000 gas-masked, ready-to-shoot state troopers and sheriff’s deputies, backed in reserve by 70 truckloads of New York National Guardsmen, liberated 29 other hostages, 25 of whom were injured."
                            }
                        ]
                    },
                    {
                        "sense_id": "146f31b0-2726-3c07-91c7-28f2c11fe66f",
                        "entry_id": "64722367-dd5f-302d-9748-be02ca4e78b3",
                        "glosses": [
                            "A large number."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f5eac480-8a15-4112-a5b7-f595ffb41664",
                                "sense_id": "146f31b0-2726-3c07-91c7-28f2c11fe66f",
                                "text": "We were expecting just a handful of people to come to the festival, but then a truckload of revellers started arriving at the festival gates."
                            },
                            {
                                "example_id": "714d9fc7-e6bb-4327-8d14-7d10926d91cc",
                                "sense_id": "146f31b0-2726-3c07-91c7-28f2c11fe66f",
                                "text": "Another meme shows an empty van. “Excellent news,” it reads. “The first truckload of your thoughts and prayers has just arrived.”"
                            }
                        ]
                    }
                ],
