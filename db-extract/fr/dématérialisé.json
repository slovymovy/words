                                    {
                                        "sense_id": "e8a39e5a-241a-38c6-bf4d-538f2caa4b57",
                                        "entry_id": "8c365728-08f2-3c6c-9147-f226963afbde",
                                        "glosses": [
                                            "Without paper."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb3a36f9-c992-409f-9db2-45ddb6ef8276",
                                                "sense_id": "e8a39e5a-241a-38c6-bf4d-538f2caa4b57",
                                                "text": "The paperless walls of the bedroom looked grey and cheerless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4300e84c-e463-3a90-8b8a-bf9eae12a42a",
                                        "entry_id": "8c365728-08f2-3c6c-9147-f226963afbde",
                                        "glosses": [
                                            "Relating to or involving the communication or storage of information electronically, rather than with paper."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3153f08-b2b5-4bc0-9b18-07a6dd1f88e4",
                                                "sense_id": "4300e84c-e463-3a90-8b8a-bf9eae12a42a",
                                                "text": "Many banks are now offering paperless billing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "875beddd-d6f5-35f1-9a71-014c264526f4",
                                        "entry_id": "8c365728-08f2-3c6c-9147-f226963afbde",
                                        "glosses": [
                                            "Lacking official documentation or evidence of identity."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d528813-e457-4552-8747-a3ce7b6fdaac",
                                                "sense_id": "875beddd-d6f5-35f1-9a71-014c264526f4",
                                                "text": "The government will aim to identify paperless refugees."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c9f56a1-339d-47c9-9218-0b1b5fe11079",
                        "source_entry_id": "f977d332-b17b-349e-8670-b777ec6c2522",
                        "source_sense_id": "703fcea6-e2df-305d-8ab6-582112b4ca5a",
                        "source_sense_description": "dont la valeur ou les données contenues sont conservées sur un support électronique plutôt que sur papier",
                        "target_lang_word": "virtual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virtual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27de31e2-a70d-3660-844e-dbaaeb40b4c0",
                                        "entry_id": "d38765aa-2ccf-30ad-a90d-3d6c0b02a2be",
                                        "glosses": [
                                            "In effect or essence, rather than in fact or reality; also, imitated, simulated."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b80a6752-32ab-4178-8861-a9026f3bd1e4",
                                                "sense_id": "27de31e2-a70d-3660-844e-dbaaeb40b4c0",
                                                "text": "In fact a defeat on the battlefield, Tet was a virtual victory for the North, owing to its effect on public opinion."
                                            },
                                            {
                                                "example_id": "8ce7db51-03a8-45c0-8f80-83d9074a93a6",
                                                "sense_id": "27de31e2-a70d-3660-844e-dbaaeb40b4c0",
                                                "text": "Virtual addressing allows computer applications to believe that there is much more physical memory than actually exists."
                                            },
                                            {
                                                "example_id": "3cdf3c96-28a0-4437-94ae-e06ae8cdc962",
                                                "sense_id": "27de31e2-a70d-3660-844e-dbaaeb40b4c0",
                                                "text": "[W]e affirm, that Christ is really taken by faith, by the Spirit, to all real effects of his passion; they say, he is taken by the mouth, and that the spiritual and the virtual taking him, in virtue or effect, is not sufficient, though done also in the sacrament."
                                            },
                                            {
                                                "example_id": "8576a1af-1bb7-444c-b0f0-1656f043a6dd",
                                                "sense_id": "27de31e2-a70d-3660-844e-dbaaeb40b4c0",
                                                "text": "And the true art for such popular display is to contrive the best forms for appearing to say something new, when in reality you are but echoing yourself; to break up massy chords into running variations; and to mask, by slight differences in the manner, a virtual identity in the substance."
                                            },
                                            {
                                                "example_id": "519ea871-5075-4c32-939c-f91c1976a1ad",
                                                "sense_id": "27de31e2-a70d-3660-844e-dbaaeb40b4c0",
                                                "text": "VIRTUAL is opposed to actual.— […] A thing has a virtual existence when it has all the conditions necessary to its actual existence. The statue exists virtually in the brass or iron, the oak in the acorn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "415ca317-928f-3201-a302-2d22db6a8093",
                                        "entry_id": "d38765aa-2ccf-30ad-a90d-3d6c0b02a2be",
                                        "glosses": [
                                            "For practical purposes, though not technically; almost complete, very near."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8dfa987-f8e0-4993-b118-44110b9144f5",
                                                "sense_id": "415ca317-928f-3201-a302-2d22db6a8093",
                                                "text": "The angry peasants were a virtual army as they attacked the castle."
                                            },
                                            {
                                                "example_id": "0b2c2691-f15c-4fa2-b073-52406453f96d",
                                                "sense_id": "415ca317-928f-3201-a302-2d22db6a8093",
                                                "text": "But it vvas plain, that the general reaſonings vvhich vvere employed againſt that povver, vvent directly to our vvhole legiſlative right; and one part of it could not be yielded to ſuch arguments, vvithout a virtual ſurrender of all the reſt."
                                            },
                                            {
                                                "example_id": "7ef835c4-ec94-4133-98c6-846aa320d249",
                                                "sense_id": "415ca317-928f-3201-a302-2d22db6a8093",
                                                "text": "The Chelsea captain [John Terry] was a virtual spectator as he was treated to his side's biggest win for almost two years as Stamford Bridge serenaded him with chants of \"there's only one England captain,\" some 48 hours after he announced his retirement from international football."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e22939c1-c5b4-3f10-8b6e-ff50dcb701ac",
                                        "entry_id": "d38765aa-2ccf-30ad-a90d-3d6c0b02a2be",
                                        "glosses": [
                                            "Operating using a computer and/or online rather than physically present."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc2e3ac-d98b-43d1-8458-910472bef757",
                                                "sense_id": "e22939c1-c5b4-3f10-8b6e-ff50dcb701ac",
                                                "text": "a virtual assistant    a virtual personal trainer"
                                            },
                                            {
                                                "example_id": "6a59e43e-73bc-48c5-8bbd-b376b8340d00",
                                                "sense_id": "e22939c1-c5b4-3f10-8b6e-ff50dcb701ac",
                                                "text": "In recent months, hospitals around the country, looking for ways to free up beds for coronavirus patients, began expanding their virtual offerings, launching video doctors' visits and virtual therapy sessions, and rolling out programs to remotely monitor vulnerable patients, like those in nursing homes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "537bb555-612a-3526-898a-901acdca6882",
                                        "entry_id": "d38765aa-2ccf-30ad-a90d-3d6c0b02a2be",
                                        "glosses": [
                                            "Simulated in a computer and/or online."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "633fab01-7fac-46d1-ae49-788b62294954",
                                                "sense_id": "537bb555-612a-3526-898a-901acdca6882",
                                                "text": "virtual machine    virtual memory    virtual private network"
                                            },
                                            {
                                                "example_id": "b45169aa-ac75-464e-b0a9-78fd69605379",
                                                "sense_id": "537bb555-612a-3526-898a-901acdca6882",
                                                "text": "The virtual world of his computer game allowed character interaction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2946925a-7b57-3f14-80ec-6e7b7114b2fa",
                                        "entry_id": "d38765aa-2ccf-30ad-a90d-3d6c0b02a2be",
                                        "glosses": [
                                            "Of a class member: capable of being overridden with a different implementation in a subclass."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d9f9ce5-4ab1-33d9-8999-811bff830182",
                                        "entry_id": "d38765aa-2ccf-30ad-a90d-3d6c0b02a2be",
                                        "glosses": [
                                            "Pertaining to a theoretical infinitesimal velocity in a mechanical system that does not violate the system's constraints; also, of other physical quantities: resulting from such a velocity."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceb98c69-9999-4092-9c1f-587693d82a2e",
                                                "sense_id": "3d9f9ce5-4ab1-33d9-8999-811bff830182",
                                                "text": "virtual displacement    virtual work"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd506226-d17f-35ae-87d4-6802762c6b55",
                                        "entry_id": "d38765aa-2ccf-30ad-a90d-3d6c0b02a2be",
                                        "glosses": [
                                            "Pertaining to a theoretical quality of something which would produce an observable effect if counteracting factors such as friction are disregarded; specifically, of a head of water: producing a certain pressure if friction, etc., is disregarded."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e81f13bc-9209-3646-b341-a0b4b1efb604",
                                        "entry_id": "d38765aa-2ccf-30ad-a90d-3d6c0b02a2be",
                                        "glosses": [
                                            "Chiefly in virtual focus: of a focus or point: from which light or other radiation apparently emanates; also, of an image: produced by light that appears to diverge from a point beyond the reflecting or refracting surface."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1e44296-624e-3497-8559-022b994bc1c2",
                                        "entry_id": "d38765aa-2ccf-30ad-a90d-3d6c0b02a2be",
                                        "glosses": [
                                            "Pertaining to particles in temporary existence due to the Heisenberg uncertainty principle."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "particle"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "024215cd-e8e5-3621-8e8e-be8c89e776eb",
                                        "entry_id": "d38765aa-2ccf-30ad-a90d-3d6c0b02a2be",
                                        "glosses": [
                                            "Of a quantum state: having an intermediate, short-lived, and unobservable nature."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5c1cf40-4dbe-36c4-9db6-615dece85ade",
                                        "entry_id": "d38765aa-2ccf-30ad-a90d-3d6c0b02a2be",
                                        "glosses": [
                                            "Having efficacy or power due to some natural qualities."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12c25cf3-1c86-495e-ad8d-f468504f5c67",
                                                "sense_id": "f5c1cf40-4dbe-36c4-9db6-615dece85ade",
                                                "text": "[H]is ſenſes flame / Flovv'd from his parts, vvith force ſo virtuall, / It fir'd vvith ſence things meere inſenſuall."
                                            },
                                            {
                                                "example_id": "24c63392-c9d5-49cc-9587-b4e7df0a3d58",
                                                "sense_id": "f5c1cf40-4dbe-36c4-9db6-615dece85ade",
                                                "text": "Take an Apple, &c. and pricke it vvith a Pin full of Holes, not deepe, and ſmeare it a little vvith Sacke, or Cinnamon vvater, or Spirit of vvine, euery day for ten dayes, to ſee if the Virtuall Heat of the VVine, or Strong VVaters, vvill not Mature it."
                                            },
                                            {
                                                "example_id": "3a0e82cc-4611-4e4c-803a-70a66088aed0",
                                                "sense_id": "f5c1cf40-4dbe-36c4-9db6-615dece85ade",
                                                "text": "[H]is [God's] Omnipreſence fills / Land, Sea, and Aire, and every kinde that lives, / Fomented by his virtual power and warmd: […]"
                                            },
                                            {
                                                "example_id": "60d90954-4cbc-47c4-8683-7808fce5deea",
                                                "sense_id": "f5c1cf40-4dbe-36c4-9db6-615dece85ade",
                                                "text": "RAIN is generally accounted to be a crude Vapour of the Earth, but more eſpecially of the Sea, dravvn up from thence by the attractive Povver of the Sun, or carry'd thithervvard by Pulſion, and vvafted by the VVinds into the Aerial Region; by vvhich Sublimation and Rarefaction, and the virtual Qualities of the Sun and Air, it is form'd into Clouds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12575d1a-c777-3bc8-92d5-2e2dbea4a00d",
                                        "entry_id": "d38765aa-2ccf-30ad-a90d-3d6c0b02a2be",
                                        "glosses": [
                                            "Having efficacy or power due to some natural qualities.",
                                            "Of a plant or other thing: having strong healing powers; virtuous."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "not-comparable",
                                            "obsolete",
                                            "specifically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "588f9473-d792-3679-b130-7981b7695373",
                                        "entry_id": "d38765aa-2ccf-30ad-a90d-3d6c0b02a2be",
                                        "glosses": [
                                            "Having the power of acting without the agency of some material or measurable thing; possessing invisible efficacy."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a88abd5-c9c2-4492-84dc-2d39c314133f",
                                                "sense_id": "588f9473-d792-3679-b130-7981b7695373",
                                                "text": "VVater, being contiguous vvith Aire, Cooleth it, but Moiſteneth it not, except it Vapour. The Cauſe is, for that Heat, and Cold haue a Virtuall Tranſition, vvithout Communication of Subſtance; but Moiſture not: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1db95d7-8350-3b73-8a8c-7337ff382849",
                                        "entry_id": "d38765aa-2ccf-30ad-a90d-3d6c0b02a2be",
                                        "glosses": [
                                            "Producing, or able to produce, some result; effective, efficacious."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be57b1b5-6fe4-4695-b8e8-3ddcf4a5778f",
                                                "sense_id": "b1db95d7-8350-3b73-8a8c-7337ff382849",
                                                "text": "For Dr. [John] Dee, in his Mathematical Preface to Euclids Elements of Geometrie, hath vvorthily taken pains to make Architecture a Mathematical Science; and as a vertual Proof of his ovvn Learned Plea, quotes tvvo Authentique Authors, viz. Vitruvius and Leo Baptiſta [i.e., Leon Battista Alberti], […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5de6f4ac-6b8d-3492-993c-0c508755e05b",
                                        "entry_id": "d38765aa-2ccf-30ad-a90d-3d6c0b02a2be",
                                        "glosses": [
                                            "Synonym of virtuous (“full of virtue; having excellent moral character”)."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9fcf268-32a1-45fe-96d8-dc386620cb06",
                                                "sense_id": "5de6f4ac-6b8d-3492-993c-0c508755e05b",
                                                "text": "The moſt in ſoule deiected; the moſt baſe, / And moſt vnſeruiceable weede, vnles / You by your heauenly Influence change his vilenes / Into a vertuall habit fit for vſe."
                                            },
                                            {
                                                "example_id": "9dd0bc91-9264-4dd3-bcc1-b1b31a911e28",
                                                "sense_id": "5de6f4ac-6b8d-3492-993c-0c508755e05b",
                                                "text": "Her the grim conqueror's iron might / Avengeing clutched, distrusting rent; / […] / Not virtual France, the France benevolent, / The chivalrous, the many-stringed, sublime / At intervals, and oft in sweetest chime; […]"
                                            }
