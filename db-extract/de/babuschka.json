                ],
                "senses": [
                    {
                        "sense_id": "af1181d1-b646-33aa-ad92-8ac247d7a8cf",
                        "entry_id": "1b0e4a6c-e7d4-3246-8d92-5fff45c49700",
                        "glosses": [
                            "Großmutter beziehungsweise eine ältere Frau, die nicht die eigene Großmutter ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c21606b-557d-43a9-ad9f-0b2aa619376e",
                                "sense_id": "af1181d1-b646-33aa-ad92-8ac247d7a8cf",
                                "text": "„Er ließ sich von der Babuschka hinterm Familienofen frisches Wasser geben und wischte dem Bewußtlosen das Blut aus dem Gesicht.“"
                            },
                            {
                                "example_id": "63e2e9d8-eba1-49af-8700-cb5ab50eb496",
                                "sense_id": "af1181d1-b646-33aa-ad92-8ac247d7a8cf",
                                "text": "„Das erinnert an russische Babuschkas, aus denen man immer noch eine kleinere Babuschka herausholen kann.“"
                            },
                            {
                                "example_id": "ef08aace-6636-47b3-b826-ef09b6bcacd4",
                                "sense_id": "af1181d1-b646-33aa-ad92-8ac247d7a8cf",
                                "text": "„Seit dem Ende des Zweiten Weltkriegs wohnt hier Tamara Worobjowa, eine rüstige 78-Jährige, mit wachen Augen, so wie man sich eine echte russische Babuschka vorstellt.“"
                            },
                            {
                                "example_id": "070c9c80-7c51-407f-ac0e-c231fb701dd7",
                                "sense_id": "af1181d1-b646-33aa-ad92-8ac247d7a8cf",
                                "text": "„Jedesmal wenn der Zeiger eines uns unbekannten Messgeräts anschlug, ging Babuschka hinunter zur Bäckerei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e755b65a-895f-4fd7-a1ac-734add491ba4",
                        "source_entry_id": "1b0e4a6c-e7d4-3246-8d92-5fff45c49700",
                        "source_sense_id": "af1181d1-b646-33aa-ad92-8ac247d7a8cf",
                        "source_sense_description": "Großmutter beziehungsweise eine ältere Frau, die nicht die eigene Großmutter ist",
                        "target_lang_word": "бабушка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бабушка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "707f9f13-f34c-3c54-9455-5f3747b2b4c3",
                                        "entry_id": "741a6c3b-c226-383b-8afb-87f657881f8e",
                                        "glosses": [
                                            "мать отца или матери"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "944533a9-56ea-469e-a0f5-0d93f26333eb",
                                                "sense_id": "707f9f13-f34c-3c54-9455-5f3747b2b4c3",
                                                "text": "Эта чашка была немногим моложе его: бабушка Миля подарила внуку к пятилетнему юбилею и сказала, что надо выпивать все молоко до капли, иначе медвежонок на дне захлебнется."
                                            },
                                            {
                                                "example_id": "4648fec1-e775-48d0-8bb7-fd1cc9650cab",
                                                "sense_id": "707f9f13-f34c-3c54-9455-5f3747b2b4c3",
                                                "text": "Я писала к моей бабушке в Москву, изобразила ей несчастное мое положение, но не получила ответа."
                                            },
                                            {
                                                "example_id": "dadc7668-7d7d-4307-a5fa-f4c6aa9f7b86",
                                                "sense_id": "707f9f13-f34c-3c54-9455-5f3747b2b4c3",
                                                "text": "Почтительно подошел он к своей бабушке, поцеловал у нее руку и справился о здоровье."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b71d8400-0356-3c1b-a473-271eb3764b6d",
                                        "entry_id": "741a6c3b-c226-383b-8afb-87f657881f8e",
                                        "glosses": [
                                            "разг. старая женщина"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "118e4670-6e91-4a2c-a1fa-a80964debac6",
                                                "sense_id": "b71d8400-0356-3c1b-a473-271eb3764b6d",
                                                "text": "Внутренне настроив себя на спокойный и конструктивный разговор, она вышла из кабинета, прервав разговор бабушек, которые появлению доктора очень удивились."
                                            },
                                            {
                                                "example_id": "bfbb0830-fba7-406d-bb29-814f478df52b",
                                                "sense_id": "b71d8400-0356-3c1b-a473-271eb3764b6d",
                                                "text": "Сзади подошли пожилые люди, я сразу хотела уступить место бабушке в бальном платье."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
