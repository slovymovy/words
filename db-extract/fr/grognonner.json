                "senses": [
                    {
                        "sense_id": "da0fd113-422f-3fba-87dc-cce70a781025",
                        "entry_id": "89b0593b-86d6-38f6-924d-783ed06f095a",
                        "glosses": [
                            "Variante expressive de grogner (pour une personne)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd10e0dc-0364-47e6-9c74-358b5ddbd956",
                                "sense_id": "da0fd113-422f-3fba-87dc-cce70a781025",
                                "text": "Vlan ! dans l’œil ! C’est la moustache du voisin qui m’aveugle pour la quatrième fois. Seulement, ce coup-ci, j’ai compris ce qu’il me grognonne aux oreilles depuis un bon quart d’heure."
                            },
                            {
                                "example_id": "eb5047ab-5112-48f5-a3a6-19094885e35f",
                                "sense_id": "da0fd113-422f-3fba-87dc-cce70a781025",
                                "text": "Les assiettes en s’entrechoquant dans le baquet faisaient du bruit, l’homme grognonnait des choses ;"
                            }
                        ]
                    }
                ],
