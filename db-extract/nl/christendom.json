                                "target_senses": [
                                    {
                                        "sense_id": "8421d7df-5bdf-31ca-9dc1-9f039c4c5adc",
                                        "entry_id": "2a612d82-9b27-3e98-84d0-274eacdffcc2",
                                        "glosses": [
                                            "An Abrahamic religion originating from the community of the followers of Jesus Christ."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eee1c012-6905-4621-9269-2946b04259f9",
                                                "sense_id": "8421d7df-5bdf-31ca-9dc1-9f039c4c5adc",
                                                "text": "By some paradoxical evolution rancour and intolerance have been established in the vanguard of primitive Christianity. Mrs. Spoker, in common with many of the stricter disciples of righteousness, was as inclement in demeanour as she was cadaverous in aspect."
                                            },
                                            {
                                                "example_id": "96841403-1134-418a-893d-3e8199128ce7",
                                                "sense_id": "8421d7df-5bdf-31ca-9dc1-9f039c4c5adc",
                                                "text": "As a result, Christianity developed as a separate religion from Judaism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "379ca398-f7d5-3c4e-bb07-fd38b0ff4f2f",
