                "senses": [
                    {
                        "sense_id": "6a879032-5ec7-3f32-b8ff-7b23fa7a1b87",
                        "entry_id": "3a4d9498-605e-32c9-8234-666b204173fc",
                        "glosses": [
                            "Droit féodal que des meuniers payaient à un seigneur qui a droit de moulin banal, pour avoir permission de « chasser » c’est à dire de quêter le grain puis de le moudre dans l'étendue de sa terre."
                        ],
                        "tags": [
                            "Meunerie",
                            "Anjou",
                            "Poitou"
                        ],
                        "examples": [
                            {
                                "example_id": "386d7de7-e2f4-44f5-b695-dde1df45149c",
                                "sense_id": "6a879032-5ec7-3f32-b8ff-7b23fa7a1b87",
                                "text": "Moyennant une certaine redevance, le seigneur permettait aux meuniers qui n’étaient pas de son fief de chercher le blé de ses sujets pour le moudre, c’était une suite du droit de chasserenderie"
                            },
                            {
                                "example_id": "664a7fc8-df60-45d0-a37a-6c0b2f5115da",
                                "sense_id": "6a879032-5ec7-3f32-b8ff-7b23fa7a1b87",
                                "text": "Moyennant une redevance annuelle la duchesse de Montpensier donne le droit de chasseranderie au meunier du commandeur d’Ozon"
                            }
                        ]
                    }
