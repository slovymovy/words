        "fr-extract.jsonl": [
            {
                "entry_id": "5480e7f0-667f-3467-aca3-ccf3b4c3693b",
                "word": "scarole",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f24425df-3e23-4327-8f52-42cd4d54b5ad",
                        "entry_id": "5480e7f0-667f-3467-aca3-ccf3b4c3693b",
                        "tags": [
