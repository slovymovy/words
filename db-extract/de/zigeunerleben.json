                "senses": [
                    {
                        "sense_id": "ee4c0104-c9cf-3f2c-aa77-c4d86d81698e",
                        "entry_id": "1c73277d-a686-3716-b048-ee734c838b05",
                        "glosses": [
                            "eine angeblich typische Lebensweise von Zigeunern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96c666da-0529-4eab-8327-fad004ad6d94",
                                "sense_id": "ee4c0104-c9cf-3f2c-aa77-c4d86d81698e",
                                "text": "Lustig ist das Zigeunerleben. (Deutsches Volkslied)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "43f8cdf8-407a-32ac-a6d7-d7bc5b93ea7a",
                        "entry_id": "1c73277d-a686-3716-b048-ee734c838b05",
                        "glosses": [
                            "ein unstetes \\\"Nomadenleben\\\" ohne feste Ortsbindung"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "f4df0c64-c0a6-45af-841b-5ddc8d2899cd",
                                "sense_id": "43f8cdf8-407a-32ac-a6d7-d7bc5b93ea7a",
                                "text": "Mit dem Zigeunerleben ist jetzt endgültig Schluss!"
                            },
                            {
                                "example_id": "d41dc93b-ecd9-4b8f-bd0b-93abfe5fe7ea",
                                "sense_id": "43f8cdf8-407a-32ac-a6d7-d7bc5b93ea7a",
                                "text": "Was die Schauspielerwelt angeht, so hat sie gewiß noch heut wie stets ihren starken Anteil am Zigeunerleben. Aber die Zeit, wo der Komödiant der Außergesellschaftliche, der Zigeuner par excellence war, ist doch längst vorüber."
                            },
                            {
                                "example_id": "15c9cc58-bc32-42a5-ba13-3666616e370d",
                                "sense_id": "43f8cdf8-407a-32ac-a6d7-d7bc5b93ea7a",
                                "text": "„Ich und meine Familie hatten immer weniger Lust auf ein Zigeunerleben. Ich wünschte mir ein bisschen mehr Stabilität.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
