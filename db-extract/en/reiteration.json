                        "cross_references": [
                            {
                                "target_word": "повторе́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b0e365d8-bad8-3c1f-b99e-81c09b8eef0a",
                                        "entry_id": "c152e7bf-58f9-385d-a38f-f8fbf555ea64",
                                        "glosses": [
                                            "действие по значению гл. повторять"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fd9c95f-94d5-401f-ac54-dae7ce0643a5",
                                                "sense_id": "b0e365d8-bad8-3c1f-b99e-81c09b8eef0a",
                                                "text": "Повторение вычисления, как и повторение физического эксперимента, должно давать один и тот же результат"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "511743d8-7aa3-3049-90ea-83b09e75f85b",
                                        "entry_id": "c152e7bf-58f9-385d-a38f-f8fbf555ea64",
                                        "glosses": [
                                            "повторяющееся место; встречающийся где-либо более одного раза фрагмент текста, мелодии и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca5a4011-0b40-43a0-b2db-ec92f0cd8b1a",
                                                "sense_id": "511743d8-7aa3-3049-90ea-83b09e75f85b",
                                                "text": "В самом деле, если летопись действительно содержит такое повторение, т. е. длительности правления соответствующих друг другу правителей из двух разных «династических потоков» совпадают и между соответственными царствованиями имеется какое-то хотя бы примерное сходство (в характеристике правителя, его судьбе, происходивших при нём крупнейших событиях), то перед историками, конечно, возникает серьёзная проблема: как это объяснить."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "553c9b79-f20a-3e5d-899d-5bd911b8eaf1",
                                        "entry_id": "c152e7bf-58f9-385d-a38f-f8fbf555ea64",
                                        "glosses": [
                                            "устар. копия чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a47a0121-81d2-45f5-88fc-85a55478733c",
                                                "sense_id": "553c9b79-f20a-3e5d-899d-5bd911b8eaf1",
                                                "text": "Ужин представляет собой повторение обеда, за исключением пирожного, которое не подается"
                                            }
                                        ]
                                    }
                                ]
                            }
