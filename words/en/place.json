    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "44d10500-5069-36f0-a8fa-cb118c669383",
                    "sense_definition": "A particular location or position in space.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is a very quiet <w>place</w> to study during the weekends.",
                            "target_lang_translations": {
                                "ru": "Это очень тихое <w>место</w> для учебы по выходным."
                            }
                        },
                        {
                            "text": "I cannot find a good <w>place</w> to park my car near the office.",
                            "target_lang_translations": {
                                "ru": "Я не могу найти хорошее <w>место</w>, чтобы припарковать машину рядом с офисом."
                            }
                        }
                    ],
                    "synonyms": [
                        "location",
                        "position",
                        "spot"
                    ],
                    "common_phrases": [
                        "quiet place",
                        "safe place",
                        "right place"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенное местоположение или позиция в пространстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "место",
                                "target_lang_sense_clarification": "точка или область в пространстве"
                            },
                            {
                                "target_lang_word": "пункт",
                                "target_lang_sense_clarification": "конкретная точка на карте или маршруте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e5b0f60-0652-3dc9-8e44-0f101c49f295",
                    "sense_definition": "The area where one lives; one's home.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "residence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you want to come over to my <w>place</w> for dinner tonight?",
                            "target_lang_translations": {
                                "ru": "Хочешь зайти ко <w>мне</w> на ужин сегодня вечером?"
                            }
                        },
                        {
                            "text": "We are having a small party at our <w>place</w> this Saturday.",
                            "target_lang_translations": {
                                "ru": "В эту субботу мы устраиваем небольшую вечеринку у <w>нас</w> дома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "at my place",
                        "your place",
                        "nice place"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used to refer to a house or apartment"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где человек живет; чей-то дом или квартира."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дом",
                                "target_lang_sense_clarification": "жилище"
                            },
                            {
                                "target_lang_word": "в гости",
                                "target_lang_sense_clarification": "используется в контексте приглашения к себе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81136b0e-87d4-3fa9-be8a-232ca4a7d132",
                    "sense_definition": "An inhabited area such as a village, town, or city.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "settlement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "London is an interesting <w>place</w> with a lot of history.",
                            "target_lang_translations": {
                                "ru": "Лондон — интересное <w>место</w> с богатой историей."
                            }
                        },
                        {
                            "text": "He grew up in a small <w>place</w> in the countryside.",
                            "target_lang_translations": {
                                "ru": "Он вырос в небольшом <w>городке</w> в сельской местности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "native place",
                        "small place",
                        "busy place"
                    ],
                    "target_lang_definitions": {
                        "ru": "Населенная территория, такая как деревня, городок или город."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "населённый пункт",
                                "target_lang_sense_clarification": "официальный термин для города или села"
                            },
                            {
                                "target_lang_word": "местечко",
                                "target_lang_sense_clarification": "небольшой населенный пункт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5d3ca74-db14-372a-95ef-48befaef2afc",
                    "sense_definition": "The specific area one occupies, especially a seat.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "seating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We asked the restaurant to give us a table with three <w>places</w>.",
                            "target_lang_translations": {
                                "ru": "Мы попросили в ресторане столик на три <w>места</w>."
                            }
                        },
                        {
                            "text": "Is this <w>place</w> taken or can I sit here?",
                            "target_lang_translations": {
                                "ru": "Это <w>место</w> занято или я могу здесь сесть?"
                            }
                        }
                    ],
                    "synonyms": [
                        "seat"
                    ],
                    "common_phrases": [
                        "save a place",
                        "take a place"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное пространство, которое кто-то занимает, особенно сиденье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "место",
                                "target_lang_sense_clarification": "сиденье в транспорте или заведении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b633219-1af9-34d3-b077-cde25fd6c99f",
                    "sense_definition": "The position of a contestant in a competition.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "ranking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We thought we would win but only ended up in fourth <w>place</w>.",
                            "target_lang_translations": {
                                "ru": "Мы думали, что победим, но в итоге заняли лишь четвертое <w>место</w>."
                            }
                        },
                        {
                            "text": "She was very happy to finish the race in first <w>place</w>.",
                            "target_lang_translations": {
                                "ru": "Она была очень счастлива закончить гонку на первом <w>месте</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "position"
                    ],
                    "common_phrases": [
                        "first place",
                        "second place",
                        "take place"
                    ],
                    "target_lang_definitions": {
                        "ru": "Позиция участника в соревновании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "место",
                                "target_lang_sense_clarification": "результат в соревновании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3526ceb6-0ac8-3ebb-9681-3e92f5163435",
                    "sense_definition": "A particular location in a book or document, especially where a reader stopped.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "document_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I lost my <w>place</w> in the book when the phone rang.",
                            "target_lang_translations": {
                                "ru": "Я потерял <w>место</w>, на котором читал, когда зазвонил телефон."
                            }
                        },
                        {
                            "text": "Please mark your <w>place</w> before you close the file.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, отметьте <w>место</w>, где вы остановились, прежде чем закрыть файл."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lose one's place",
                        "find one's place"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенное место в книге или документе, особенно там, где читатель остановился."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "место",
                                "target_lang_sense_clarification": "отрывок или точка в тексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6bb3201-d5ce-340c-9001-9579fb2297ed",
                    "sense_definition": "An open space in a town, such as a city square or courtyard.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "urban_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The market <w>place</w> was crowded with people buying fresh vegetables.",
                            "target_lang_translations": {
                                "ru": "Рыночная <w>площадь</w> была заполнена людьми, покупающими свежие овощи."
                            }
                        },
                        {
                            "text": "The statue stands in the center of the public <w>place</w>.",
                            "target_lang_translations": {
                                "ru": "Статуя стоит в центре общественного <w>места</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "square",
                        "plaza",
                        "piazza",
                        "courtyard"
                    ],
                    "common_phrases": [
                        "market place",
                        "public place"
                    ],
                    "target_lang_definitions": {
                        "ru": "Открытое пространство в городе, такое как площадь или внутренний двор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "площадь",
                                "target_lang_sense_clarification": "городская площадь"
                            },
                            {
                                "target_lang_word": "сквер",
                                "target_lang_sense_clarification": "небольшой общественный сад"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2ec75c4-ac0b-34e0-a771-fb6278f38926",
                    "sense_definition": "A role, purpose, or social station; a responsibility.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is really not my <w>place</w> to say what is right and wrong in this case.",
                            "target_lang_translations": {
                                "ru": "Это не в моей <w>компетенции</w> говорить, что правильно, а что нет в данном случае."
                            }
                        },
                        {
                            "text": "He finally felt like he had found his <w>place</w> in the world.",
                            "target_lang_translations": {
                                "ru": "Он наконец почувствовал, что нашел свое <w>место</w> в мире."
                            }
                        }
                    ],
                    "synonyms": [
                        "situation"
                    ],
                    "common_phrases": [
                        "know one's place",
                        "not my place"
                    ],
                    "target_lang_definitions": {
                        "ru": "Роль, цель или социальное положение; ответственность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дело",
                                "target_lang_sense_clarification": "в значении 'не моё дело'"
                            },
                            {
                                "target_lang_word": "роль",
                                "target_lang_sense_clarification": "функция в обществе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98d0c458-7a62-35e8-9197-99b12f640ed7",
                    "sense_definition": "Position in a sequence or order of proceeding.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That is exactly what I said in the first <w>place</w>!",
                            "target_lang_translations": {
                                "ru": "Это именно то, что я сказал с самого <w>начала</w>!"
                            }
                        },
                        {
                            "text": "In the second <w>place</w>, we do not have enough money for this project.",
                            "target_lang_translations": {
                                "ru": "Во-<w>вторых</w>, у нас недостаточно денег для этого проекта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the first place",
                        "in the second place"
                    ],
                    "target_lang_definitions": {
                        "ru": "Позиция в последовательности или порядке действий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очередь",
                                "target_lang_sense_clarification": "порядок следования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f993967-4c2c-3e03-9680-8e9f9a520837",
                    "sense_definition": "A state of mind or emotional condition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am in a strange <w>place</w> at the moment and need some time alone.",
                            "target_lang_translations": {
                                "ru": "Я сейчас в странном <w>состоянии</w> и мне нужно побыть одной."
                            }
                        },
                        {
                            "text": "After the therapy, she felt she was in a much better <w>place</w> mentally.",
                            "target_lang_translations": {
                                "ru": "После терапии она почувствовала, что ее ментальное <w>состояние</w> стало намного лучше."
                            }
                        }
                    ],
                    "synonyms": [
                        "mindset",
                        "mood"
                    ],
                    "common_phrases": [
                        "better place",
                        "dark place"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in psychological contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Душевное состояние или эмоциональное условие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состояние",
                                "target_lang_sense_clarification": "эмоциональный настрой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6dbc42f-6569-36f3-a8c2-223f1498fc70",
                    "sense_definition": "In mathematics, the column counting a certain quantity, such as decimals.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please round the final answer to two decimal <w>places</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, округлите окончательный ответ до двух десятичных <w>знаков</w>."
                            }
                        },
                        {
                            "text": "The digit in the hundreds <w>place</w> is a five.",
                            "target_lang_translations": {
                                "ru": "Цифра в <w>разряде</w> сотен — пятерка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "decimal place",
                        "hundreds place"
                    ],
                    "target_lang_definitions": {
                        "ru": "В математике — разряд числа, например, десятичный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разряд",
                                "target_lang_sense_clarification": "позиция цифры в числе"
                            },
                            {
                                "target_lang_word": "знак",
                                "target_lang_sense_clarification": "цифра после запятой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13dfe7b1-6028-3088-adf0-01432344a664",
                    "sense_definition": "A polite or euphemistic way to refer to a toilet or lavatory.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "euphemism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I guess I will take this opportunity to go to the <w>place</w>.",
                            "target_lang_translations": {
                                "ru": "Думаю, я воспользуюсь возможностью зайти в <w>уборную</w>."
                            }
                        },
                        {
                            "text": "She asked where the <w>place</w> was so she could wash her hands.",
                            "target_lang_translations": {
                                "ru": "Она спросила, где находится <w>туалет</w>, чтобы помыть руки."
                            }
                        }
                    ],
                    "synonyms": [
                        "bathroom"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Euphemistic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливый или эвфемистичный способ обозначения туалета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дамская комната",
                                "target_lang_sense_clarification": "вежливое обозначение туалета"
                            },
                            {
                                "target_lang_word": "уборная",
                                "target_lang_sense_clarification": "устаревшее вежливое название"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ded332cb-d14d-31d5-ad59-9f7b8c218dde",
                    "sense_definition": "To put someone or something in a specific location.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "positioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>placed</w> the glass carefully on the wooden table.",
                            "target_lang_translations": {
                                "ru": "Он осторожно <w>поставил</w> стакан на деревянный стол."
                            }
                        },
                        {
                            "text": "Please <w>place</w> your bags in the overhead compartment.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>разместите</w> свои сумки в верхнем отделении."
                            }
                        }
                    ],
                    "synonyms": [
                        "set",
                        "deposit",
                        "lay"
                    ],
                    "common_phrases": [
                        "place on",
                        "place inside"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поместить кого-либо или что-либо в определенное место."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положить",
                                "target_lang_sense_clarification": "горизонтально"
                            },
                            {
                                "target_lang_word": "поставить",
                                "target_lang_sense_clarification": "вертикально"
                            },
                            {
                                "target_lang_word": "разместить",
                                "target_lang_sense_clarification": "найти место"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53125b94-25c9-3706-a698-145cc2662fdf",
                    "sense_definition": "To perform an action like making a call, an order, or a bet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>place</w> an order for more office supplies today.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>сделать</w> заказ на канцтовары сегодня."
                            }
                        },
                        {
                            "text": "The secretary is <w>placing</w> a call to the manager right now.",
                            "target_lang_translations": {
                                "ru": "Секретарь как раз сейчас <w>совершает</w> звонок менеджеру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "place an order",
                        "place a call",
                        "place a bet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнить действие, такое как звонок, заказ или ставка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сделать",
                                "target_lang_sense_clarification": "совершить действие (заказ, ставку)"
                            },
                            {
                                "target_lang_word": "разместить",
                                "target_lang_sense_clarification": "оформить заказ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea8de04a-f5a9-3803-88ae-8138ee8c9ccf",
                    "sense_definition": "To earn a specific rank or spot in a competition.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ranking_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local team <w>placed</w> third in the national league this year.",
                            "target_lang_translations": {
                                "ru": "Местная команда <w>заняла</w> третье место в национальной лиге в этом году."
                            }
                        },
                        {
                            "text": "She was disappointed that she didn't <w>place</w> in the top ten.",
                            "target_lang_translations": {
                                "ru": "Она была разочарована тем, что не <w>попала</w> в первую десятку."
                            }
                        }
                    ],
                    "synonyms": [
                        "achieve",
                        "reach"
                    ],
                    "common_phrases": [
                        "place third",
                        "place first"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занять определенное место или ранг в соревновании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "занять",
                                "target_lang_sense_clarification": "получить место в рейтинге"
                            }
                        ]
                    }
                },
