{
    "word_family": [
        "spinać",
        "spiąć",
        "spięcie",
        "spięty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d7c0c9bf-1a8b-3358-a4a2-df2e18eb0b5b",
                    "sense_definition": "niewielki, często ozdobny przedmiot służący do łączenia lub przytrzymywania czegoś, na przykład włosów, mankietów czy krawata",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "element_spinajacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wyjściem na uroczystość zgubił elegancką <w>spinkę</w> od koszuli.",
                            "target_lang_translations": {
                                "ru": "Перед выходом на торжество он потерял элегантную <w>запонку</w> от рубашки."
                            }
                        },
                        {
                            "text": "Dziewczynka miała we włosach kolorową <w>spinkę</w> w kształcie motyla.",
                            "target_lang_translations": {
                                "ru": "У девочки в волосах была цветная <w>заколка</w> в форме бабочки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spinki do mankietów",
                        "spinka do włosów",
                        "spinka do krawata"
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшой, часто декоративный предмет, служащий для скрепления или удержания чего-либо, например волос, манжет или галстука"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заколка",
                                "target_lang_sense_clarification": "для волос или галстука"
                            },
                            {
                                "target_lang_word": "запонка",
                                "target_lang_sense_clarification": "для манжет рубашки"
                            },
                            {
                                "target_lang_word": "зажим",
                                "target_lang_sense_clarification": "для галстука или волос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53af80d8-b2e8-3471-a67e-f6abe513bcd4",
                    "sense_definition": "stan zdenerwowania, napięcia emocjonalnego lub przesadnego przejmowania się",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie rozumiem, skąd u ciebie taka wielka <w>spinka</w> przed zwykłym egzaminem.",
                            "target_lang_translations": {
                                "ru": "Не понимаю, откуда у тебя такой сильный <w>напряг</w> перед обычным экзаменом."
                            }
                        },
                        {
                            "text": "W naszej pracy niepotrzebna <w>spinka</w> tylko utrudnia podejmowanie dobrych decyzji.",
                            "target_lang_translations": {
                                "ru": "В нашей работе лишняя <w>нервозность</w> только мешает принимать правильные решения."
                            }
                        }
                    ],
                    "synonyms": [
                        "napięcie",
                        "nerwowość",
                        "stres"
                    ],
                    "antonyms": [
                        "odprężenie",
                        "wyluzowanie"
                    ],
                    "common_phrases": [
                        "niepotrzebna spinka"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie stanu napięcia psychicznego"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "разг. состояние нервозности, сильного эмоционального напряжения или чрезмерного беспокойства; зажатость"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напряг",
                                "target_lang_sense_clarification": "разговорное напряжение, стресс"
                            },
                            {
                                "target_lang_word": "загон",
                                "target_lang_sense_clarification": "беспокойство, переживание"
                            },
                            {
                                "target_lang_word": "нервозность",
                                "target_lang_sense_clarification": "эмоциональное напряжение"
                            },
                            {
                                "target_lang_word": "зажатость",
                                "target_lang_sense_clarification": "внутреннее напряжение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3c4a3bf-141c-31f6-83cb-a44122201e32",
                    "sense_definition": "poziomy element konstrukcyjny, belka łącząca i usztywniająca konstrukcję drewnianą",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "budownictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cieśla wymienił uszkodzoną <w>spinkę</w> w konstrukcji zabytkowego dachu.",
                            "target_lang_translations": {
                                "ru": "Плотник заменил повреждённую <w>схватку</w> в конструкции старинной крыши."
                            }
                        },
                        {
                            "text": "Solidna drewniana <w>spinka</w> stabilizowała całe wiązanie więźby dachowej.",
                            "target_lang_translations": {
                                "ru": "Массивная деревянная <w>стяжка</w> стабилизировала всю стропильную ферму."
                            }
                        }
                    ],
                    "synonyms": [
                        "płatew"
                    ],
                    "target_lang_definitions": {
                        "ru": "горизонтальный конструктивный элемент, брус или схватка, соединяющая и укрепляющая деревянную конструкцию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схватка",
                                "target_lang_sense_clarification": "в стропильной системе"
                            },
                            {
                                "target_lang_word": "ригель",
                                "target_lang_sense_clarification": "соединительная деревянная балка"
                            },
                            {
                                "target_lang_word": "стяжка",
                                "target_lang_sense_clarification": "элемент жесткости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}