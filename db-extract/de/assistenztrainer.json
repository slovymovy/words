                "senses": [
                    {
                        "sense_id": "49de0780-7ad7-3b05-a054-d72b0ec4f23a",
                        "entry_id": "8d453ec9-0914-3675-a58a-2202864987f5",
                        "glosses": [
                            "unterstützender, dem verantwortlichen Cheftrainer nachgeordneter Trainer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29d7ce2e-2c0b-464d-9190-c3eb5680de4b",
                                "sense_id": "49de0780-7ad7-3b05-a054-d72b0ec4f23a",
                                "text": "„Ich war einige Jahre sehr engagiert im Training, legte einige Graduierungen ab und machte schließlich auch eine Prüfung zum Assistenztrainer.“"
                            },
                            {
                                "example_id": "8d3731c9-53c6-4b7a-830b-651c5bf4beec",
                                "sense_id": "49de0780-7ad7-3b05-a054-d72b0ec4f23a",
                                "text": "„Er war froh, dass Justin um den Busdienst gebettelt hatte, indem er seinen Assistenztrainer bat, mit dem Team mitzufahren.“"
                            },
                            {
                                "example_id": "4807c183-4b0d-43ed-bf9b-fcd11543d643",
                                "sense_id": "49de0780-7ad7-3b05-a054-d72b0ec4f23a",
                                "text": "„Zu Gast beim Spiel ist Jack McMahon, Assistenztrainer bei den Philadelphia 76ers.“"
                            },
                            {
                                "example_id": "1e1600f2-fe03-4f33-a652-c06a63ef6857",
                                "sense_id": "49de0780-7ad7-3b05-a054-d72b0ec4f23a",
                                "text": "„Als Assistenztrainer bei den Portland Trail Blazers, die für ihre rasante Run-and- Gun-Taktik berüchtigt waren, hatte er 1979 den Titel geholt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
