    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de5fa7c8-85e0-3837-be59-fa40e0f81bf6",
                    "sense_definition": "A phantom, apparition, or ghostlike figure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spectral_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A pale <w>eidolon</w> seemed to drift silently down the dark hallway before vanishing into the wall.",
                            "target_lang_translations": {
                                "ru": "Казалось, бледный <w>призрак</w> беззвучно плыл по тёмному коридору, пока не исчез в стене."
                            }
                        },
                        {
                            "text": "The frightened villagers claimed to see an <w>eidolon</w> wandering through the ruins of the castle.",
                            "target_lang_translations": {
                                "ru": "Напуганные деревенские жители утверждали, что видели <w>привидение</w>, бродившее среди руин замка."
                            }
                        }
                    ],
                    "synonyms": [
                        "apparition",
                        "phantom",
                        "spectre",
                        "wraith"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фантом, видение, призрак или бестелесный образ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "призрак",
                                "target_lang_sense_clarification": "бестелесный дух, видение"
                            },
                            {
                                "target_lang_word": "привидение",
                                "target_lang_sense_clarification": "дух умершего или фантастическое видение"
                            },
                            {
                                "target_lang_word": "фантом",
                                "target_lang_sense_clarification": "иллюзорный или призрачный образ"
                            },
                            {
                                "target_lang_word": "эйдолон",
                                "target_lang_sense_clarification": "книжный или мифологический призрак, дух-двойник"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebe95992-752f-32e7-b301-5c8e07302ae8",
                    "sense_definition": "An idealized mental image, representation, or personification of a concept.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ideal_image",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fierce warrior stood as the very <w>eidolon</w> of war, striking terror into the hearts of his enemies.",
                            "target_lang_translations": {
                                "ru": "Свирепый воин стоял как само <w>воплощение</w> войны, вселяя ужас в сердца своих врагов."
                            }
                        },
                        {
                            "text": "In his lonely thoughts, he worshipped a perfect <w>eidolon</w> of love that no real person could ever match.",
                            "target_lang_translations": {
                                "ru": "В своих одиноких размышлениях он поклонялся безупречному <w>идеальному образу</w> любви, с которым не сравнился бы ни один реальный человек."
                            }
                        }
                    ],
                    "synonyms": [
                        "embodiment",
                        "epitome",
                        "personification"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary or philosophical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Идеализированный мысленный образ, совершенное олицетворение или воплощение идеи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воплощение",
                                "target_lang_sense_clarification": "живое или наглядное выражение идеи, идеала"
                            },
                            {
                                "target_lang_word": "олицетворение",
                                "target_lang_sense_clarification": "персонификация понятия или качества"
                            },
                            {
                                "target_lang_word": "идеальный образ",
                                "target_lang_sense_clarification": "умозрительное, совершенное представление"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}