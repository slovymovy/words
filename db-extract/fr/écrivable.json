                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5ab61e13-d186-40bc-9bd4-e299660a9efe",
                        "entry_id": "32886284-37a5-3cc9-a316-3108dad168c7",
                        "tags": [
                            "plural"
                        ],
                        "form": "écrivables"
