                    {
                        "sense_id": "f4c64537-6274-3932-9d8a-5d1f66ad2453",
                        "entry_id": "68b200cc-e206-3e27-88f7-786f5cd67168",
                        "glosses": [
                            "Café issu des grains du caféier d’Arabie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d118ae1-bf79-4d58-87a5-aa80e4dfafc7",
                                "sense_id": "f4c64537-6274-3932-9d8a-5d1f66ad2453",
                                "text": "Je préfère l’arabica au robusta."
                            },
                            {
                                "example_id": "cc3e33cf-9db2-4702-a7f3-f1debd911a8e",
                                "sense_id": "f4c64537-6274-3932-9d8a-5d1f66ad2453",
                                "text": "La subtile union de deux arabicas en provenance des flancs volcaniques des deux plus hautes montagnes africaines, le Kilimandjaro et le Mont Kenya."
                            },
                            {
                                "example_id": "d6e6df49-d476-42fe-81ce-f776be9b9b43",
                                "sense_id": "f4c64537-6274-3932-9d8a-5d1f66ad2453",
                                "text": "D'un côté l'arôme familial d'un arabica feutré, de l'autre le remugle oppressant du graillon des faubourgs de Birmingham.\nD'un côté le bon goût français, de l'autre l’empiffrerie britannique."
                            }
                        ]
                    }
                ],
