{
    "word_family": [
        "detail",
        "detailer",
        "detailing"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "deec41fb-8a22-3bfe-b1f0-913ec3da5e75",
                    "sense_definition": "Characterized by attention to detail and thoroughness of treatment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "thoroughness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect provided a <w>detailed</w> plan of the new building.",
                            "target_lang_translations": {
                                "ru": "Архитектор предоставил <w>подробный</w> план нового здания."
                            }
                        },
                        {
                            "text": "She gave a <w>detailed</w> explanation of how the machine works.",
                            "target_lang_translations": {
                                "ru": "Она дала <w>детальное</w> объяснение того, как работает машина."
                            }
                        }
                    ],
                    "synonyms": [
                        "thorough",
                        "comprehensive",
                        "elaborate",
                        "exhaustive"
                    ],
                    "antonyms": [
                        "vague",
                        "brief",
                        "superficial"
                    ],
                    "common_phrases": [
                        "detailed report",
                        "detailed explanation",
                        "highly detailed",
                        "detailed analysis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся вниманием к деталям и тщательностью проработки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подробный",
                                "target_lang_sense_clarification": "содержащий много деталей"
                            },
                            {
                                "target_lang_word": "детальный",
                                "target_lang_sense_clarification": "основанный на тщательном изучении подробностей"
                            },
                            {
                                "target_lang_word": "обстоятельный",
                                "target_lang_sense_clarification": "очень тщательный и полный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b2b475e6-f821-38ba-b6b4-54082f6e5b55",
                    "sense_definition": "Simple past and past participle of <w>detail</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report <w>detailed</w> every step of the investigation.",
                            "target_lang_translations": {
                                "ru": "В отчете был <w>подробно изложен</w> каждый шаг расследования."
                            }
                        },
                        {
                            "text": "He <w>detailed</w> his car until it looked brand new.",
                            "target_lang_translations": {
                                "ru": "Он <w>отполировал</w> свою машину до блеска, пока она не стала выглядеть как новая."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола detail (подробно излагать или проводить детейлинг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подробно изложил",
                                "target_lang_sense_clarification": "описал во всех деталях"
                            },
                            {
                                "target_lang_word": "детализировал",
                                "target_lang_sense_clarification": "сделал более подробным"
                            },
                            {
                                "target_lang_word": "отполировал",
                                "target_lang_sense_clarification": "провел тщательную чистку и полировку автомобиля"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e9f66a2d-8da3-3b9c-b047-0c9572a7a184",
                    "sense_definition": "The 41st sura (chapter) of the Qur'an.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_texts",
                    "name_type": "work_of_art_name",
                    "examples": [
                        {
                            "text": "The scholar spent years studying the verses of the <w>Detailed</w> sura.",
                            "target_lang_translations": {
                                "ru": "Ученый провел годы, изучая аяты суры «<w>Разъяснены</w>»."
                            }
                        },
                        {
                            "text": "In some translations, the forty-first chapter is referred to as the <w>Detailed</w>.",
                            "target_lang_translations": {
                                "ru": "В некоторых переводах сорок первая глава упоминается как «<w>Разъясненная</w>»."
                            }
                        }
                    ],
                    "synonyms": [
                        "Fussilat"
                    ],
                    "target_lang_definitions": {
                        "ru": "41-я сура (глава) Корана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Разъяснены",
                                "target_lang_sense_clarification": "перевод названия суры Фуссилат"
                            },
                            {
                                "target_lang_word": "Фуссилат",
                                "target_lang_sense_clarification": "оригинальное арабское название суры"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}