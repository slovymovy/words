                        {
                            "text": "His explanation was <w>curt</w> but managed to cover all the essential points.",
                            "target_lang_translations": {
                                "ru": "Его объяснение было <w>кратким</w>, но в нем удалось отразить все основные моменты."
                            }
                        }
                    ],
                    "synonyms": [
                        "short"
                    ],
                    "common_phrases": [
                        "curt summary"
                    ],
                    "target_lang_definitions": {
