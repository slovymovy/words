                ],
                "senses": [
                    {
                        "sense_id": "2add5504-96f1-32a4-8227-b48a3e556242",
                        "entry_id": "3a49912f-0188-310d-aa56-83921d9122bf",
                        "glosses": [
                            "исправление в написанном тексте, сделанное от руки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c3bcabb-717f-40c1-a851-3a9fa20b22d3",
                                "sense_id": "2add5504-96f1-32a4-8227-b48a3e556242",
                                "text": "На вырванном из блокнота листе она без помарок быстро и крупно карандашом написала записку…"
                            },
                            {
                                "example_id": "c2b71886-728d-4273-b10a-a2b068cc3a15",
                                "sense_id": "2add5504-96f1-32a4-8227-b48a3e556242",
                                "text": "При всей наружной легкости этих прелестных произведений, или именно для такой легкости, он мучился над ними по часам, и в каждом стихе, почти в каждом слове было бесчисленное множество помарок."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b67ec9d-c0a0-3376-b2de-f48266c50842",
                        "entry_id": "3a49912f-0188-310d-aa56-83921d9122bf",
                        "glosses": [
                            "перен. ошибка, промах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aba6e15d-8b85-4d46-afcc-23d6df7078bf",
                                "sense_id": "7b67ec9d-c0a0-3376-b2de-f48266c50842",
                                "text": "Игра как-то не шла, и даже хорошие партии не удалось сыграть без помарок."
                            }
                        ]
                    }
                ],
