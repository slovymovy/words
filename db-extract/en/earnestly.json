                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "25309db4-6fe0-45ca-8e27-fd3f3e60e95d",
                        "entry_id": "97606482-81b9-3c54-b2d4-3d4adebfe2a9",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more earnestly"
                    },
                    {
                        "form_id": "2484aceb-4a58-48e7-9cef-498c747df17c",
                        "entry_id": "97606482-81b9-3c54-b2d4-3d4adebfe2a9",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most earnestly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "40f65f4b-b675-397d-824b-5e1729f24f40",
                        "entry_id": "97606482-81b9-3c54-b2d4-3d4adebfe2a9",
                        "glosses": [
                            "In an earnest manner; being very sincere; putting forth genuine effort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78eca465-92e8-4693-bec5-55a7bfac8c9d",
                                "sense_id": "40f65f4b-b675-397d-824b-5e1729f24f40",
                                "text": "The Scarecrow and the Tin Woodman and the Lion now thanked the Good Witch earnestly for her kindness, […]"
                            },
                            {
                                "example_id": "d8421591-0458-4be7-a595-a37dbf24609a",
                                "sense_id": "40f65f4b-b675-397d-824b-5e1729f24f40",
                                "text": "One thing, however, I do most earnestly beg and entreat of you: […]"
                            },
                            {
                                "example_id": "d6b74344-d967-4745-922e-4eec088f22da",
                                "sense_id": "40f65f4b-b675-397d-824b-5e1729f24f40",
                                "text": "“This the only seat y’all got?” [Dank] Demoss, who also goes by Dajua Blanding, asks earnestly."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f531ee2-2d0e-48e8-b7d5-e3b302e8a0fc",
                        "source_entry_id": "97606482-81b9-3c54-b2d4-3d4adebfe2a9",
                        "source_sense_id": "40f65f4b-b675-397d-824b-5e1729f24f40",
                        "source_sense_description": "in an earnest manner",
                        "target_lang_word": "sérieusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sérieusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03641fd3-9b01-3cb3-b36b-42f0619fae2e",
                                        "entry_id": "f9ceb8ae-6e7a-33d9-8742-dcfa7ab57494",
                                        "glosses": [
                                            "D’une manière sérieuse, grave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d788aa70-ee58-4e8f-b861-504352150199",
                                                "sense_id": "03641fd3-9b01-3cb3-b36b-42f0619fae2e",
                                                "text": "Si on n'est pas obligé de parler du culte d’autrui avec révérence, on est obligé d’en parler sérieusement,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ff138e0-120a-38a2-8273-8b7b23f7780c",
                                        "entry_id": "f9ceb8ae-6e7a-33d9-8742-dcfa7ab57494",
                                        "glosses": [
                                            "Sans plaisanterie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "036922c1-77dd-43c7-bc38-bf1d8081bdc7",
                                                "sense_id": "6ff138e0-120a-38a2-8273-8b7b23f7780c",
                                                "text": "Mais, sérieusement, que voulez-vous qu’on fasse ?"
                                            },
                                            {
                                                "example_id": "8e3c9faa-1b8e-406c-b530-57a07b2f80c9",
                                                "sense_id": "6ff138e0-120a-38a2-8273-8b7b23f7780c",
                                                "text": "Dites-moi pourquoi vous faites ça, sérieusement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02aba4ae-486b-3323-9da3-a2f563333305",
                                        "entry_id": "f9ceb8ae-6e7a-33d9-8742-dcfa7ab57494",
                                        "glosses": [
                                            "Froidement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f54c96-908d-44f5-972c-8432abd1a440",
                                                "sense_id": "02aba4ae-486b-3323-9da3-a2f563333305",
                                                "text": "[…] le père d’Elvire vient , de partir pour Paris : nous nous sommes quittés assez sérieusement : il m’a paru fort refroidi pour vous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "851634d0-769d-3780-91ba-0a41ac7c41b8",
                                        "entry_id": "f9ceb8ae-6e7a-33d9-8742-dcfa7ab57494",
                                        "glosses": [
                                            "Véritablement, avec application, avec ardeur, tout de bon, d’une façon déterminée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abf9b3aa-b566-4d0b-a3b4-3d221a1560ad",
                                                "sense_id": "851634d0-769d-3780-91ba-0a41ac7c41b8",
                                                "text": "Réaumur, plus observateur et moins métaphysicien que son disciple, fut beaucoup plus embarrassé. Il proposa plusieurs hypothèses, sans s’arrêter sérieusement à aucune. L’une d’elles est au moins ingénieuse."
                                            },
                                            {
                                                "example_id": "4958f909-5685-4868-8fb4-6c82b9bd12b6",
                                                "sense_id": "851634d0-769d-3780-91ba-0a41ac7c41b8",
                                                "text": "Un soir Julien songeait sérieusement à se donner la mort."
                                            },
                                            {
                                                "example_id": "dd0773cb-8862-4917-8732-ab93bfb224d8",
                                                "sense_id": "851634d0-769d-3780-91ba-0a41ac7c41b8",
                                                "text": "Je déjeunai au Voltaire avec un écrivain qui envisageait très sérieusement de s’installer en Afrique du Sud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bba05a4-46a4-34eb-b021-dc0d56f3b9de",
                                        "entry_id": "f9ceb8ae-6e7a-33d9-8742-dcfa7ab57494",
                                        "glosses": [
                                            "Au sens superlatif : très, fortement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9665c21b-833b-4b2c-9301-b6e88adc2130",
                                                "sense_id": "9bba05a4-46a4-34eb-b021-dc0d56f3b9de",
                                                "text": "J’ai l’intention de « farnienter » sérieusement cet été, répondit ce dernier, et j’ai pris, pour cela, toutes mes dispositions."
                                            },
                                            {
                                                "example_id": "9d60effa-d13b-4be4-bc52-df1465d0714a",
                                                "sense_id": "9bba05a4-46a4-34eb-b021-dc0d56f3b9de",
                                                "text": "Certains de vos proches ont-ils été sérieusement malades ?"
                                            },
                                            {
                                                "example_id": "a63573ac-5423-487e-a4a5-98108a038165",
                                                "sense_id": "9bba05a4-46a4-34eb-b021-dc0d56f3b9de",
                                                "text": "Un Rospordinois sérieusement blessé dans un parc d’attractions"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52f40430-d0cc-45cc-aaf6-a2ab7d386eec",
                        "source_entry_id": "97606482-81b9-3c54-b2d4-3d4adebfe2a9",
                        "source_sense_id": "40f65f4b-b675-397d-824b-5e1729f24f40",
                        "source_sense_description": "in an earnest manner",
                        "target_lang_word": "ernsthaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ernsthaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1fbe1e96-583b-33c4-a273-dec45f5c3276",
                                        "entry_id": "56f137bc-d955-33be-b7ac-0124c5155955",
                                        "glosses": [
                                            "nicht heiter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54383891-b208-4b5f-9db6-b2a108f062b4",
                                                "sense_id": "1fbe1e96-583b-33c4-a273-dec45f5c3276",
                                                "text": "Mit ernsthafter Mine begann er seine Rede."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9d0f9290-9b2e-3df5-83ef-17605c2d9b7a",
                                        "entry_id": "56f137bc-d955-33be-b7ac-0124c5155955",
                                        "glosses": [
                                            "eindringlich, gewichtig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1158ac9c-30f2-493b-92e1-c613fe58a911",
                                                "sense_id": "9d0f9290-9b2e-3df5-83ef-17605c2d9b7a",
                                                "text": "Er scheint ernsthaft bemüht zu sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5d2ab417-53c4-312b-9ec7-1afb3ba285af",
                                        "entry_id": "56f137bc-d955-33be-b7ac-0124c5155955",
                                        "glosses": [
                                            "aufrichtig, tatsächlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42f5a432-819f-42bb-bed8-0efd7ff1e2ef",
                                                "sense_id": "5d2ab417-53c4-312b-9ec7-1afb3ba285af",
                                                "text": "An diese Wende habe ich ernsthaft nicht mehr gedacht."
                                            },
                                            {
                                                "example_id": "652eed10-2d0e-4517-b830-507be7afda09",
                                                "sense_id": "5d2ab417-53c4-312b-9ec7-1afb3ba285af",
                                                "text": "„Und er schmunzelte, wenn er dergleichen sagte, seine Hörer jedesmal in Zweifel darüber lassend, ob er’s ernsthaft oder scherzhaft gemeint habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "11e58782-f72d-303f-b97d-3b2b1eb06028",
                                        "entry_id": "56f137bc-d955-33be-b7ac-0124c5155955",
                                        "glosses": [
                                            "gefährlich, schlimm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5c27271-2c3d-468a-a296-9d07dc811827",
                                                "sense_id": "11e58782-f72d-303f-b97d-3b2b1eb06028",
                                                "text": "Die Verletzungen waren ernsthafter Natur."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
