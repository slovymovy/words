                "senses": [
                    {
                        "sense_id": "fce7d56a-5815-3138-9242-5c5baa6ca7ac",
                        "entry_id": "8e3dd23d-756b-378d-a97e-c763809f028f",
                        "glosses": [
                            "Küste, die am Pazifischen Ozean liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d57db602-18b7-4884-8570-08f9edbb6e9b",
                                "sense_id": "fce7d56a-5815-3138-9242-5c5baa6ca7ac",
                                "text": "„Nach Angaben der nationalen Wetteragentur könnten in der Nacht zum Samstag (Ortszeit) Tsunamiwellen von bis zu einem Meter Höhe die Pazifikküste der Präfekturen Fukushima, Iwate und Miyagi treffen.“"
                            },
                            {
                                "example_id": "93d9ff8c-fe1e-4e31-9727-fd1bb0f81f43",
                                "sense_id": "fce7d56a-5815-3138-9242-5c5baa6ca7ac",
                                "text": "„Noch niemand hatte dieses riesige Land von Osten bis zur Pazifikküste durchquert.“"
                            },
                            {
                                "example_id": "5d06bc35-02bc-49a1-aa67-368e31ae5496",
                                "sense_id": "fce7d56a-5815-3138-9242-5c5baa6ca7ac",
                                "text": "„Das war nur durch künstliche Bewässerung möglich, denn Peru besitzt gerade zur Pazifikküste große wüstenartige Trockengebiete.“"
                            },
                            {
                                "example_id": "41e0e4d7-2a69-42ce-b8a9-313863a0d911",
                                "sense_id": "fce7d56a-5815-3138-9242-5c5baa6ca7ac",
                                "text": "„In den Nadelwäldern an der kanadischen Pazifikküste wiederum stießen Forscher aus Vancouver auf ungewöhnliche Inseln der Vielfalt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
