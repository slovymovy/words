                                "target_senses": [
                                    {
                                        "sense_id": "e31e0cfb-f2a0-367c-8ed8-6153a5698812",
                                        "entry_id": "d8e0d622-c1bf-32d2-b892-df317df2cb91",
                                        "glosses": [
                                            "państwo w Afryce"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b8ba08-9b15-4926-b71b-1fb498d58964",
                                                "sense_id": "e31e0cfb-f2a0-367c-8ed8-6153a5698812",
                                                "text": "Tunezja położona jest w Afryce Północnej i zajmuje powierzchnię wielkości połowy Polski."
                                            },
                                            {
                                                "example_id": "c90e62b6-3a9d-40a7-8ffe-c9b1f10e25cb",
                                                "sense_id": "e31e0cfb-f2a0-367c-8ed8-6153a5698812",
                                                "text": "Zachodnim sąsiadem Tunezji był paszałyk algierski, który — podobnie jak pozostałe kraje Maghrebu — tylko formalnie należał do imperium, zainteresowanego głównie regularnym płaceniem podatków."
                                            },
                                            {
                                                "example_id": "f5dcb35e-745a-4193-b21e-86391a507d93",
                                                "sense_id": "e31e0cfb-f2a0-367c-8ed8-6153a5698812",
                                                "text": "Od 1981 r. kobiety w Tunezji mają zakaz noszenia islamskiego ubioru, włącznie z chustami, w szkołach i urzędach państwowych. (…) Policja zatrzymywała kobiety na ulicy i prosiła je o zdjęcie chusty; prezydent opisał chustę jako \"sekciarski rodzaj ubioru, który nieproszony przyszedł do Tunezji\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
