                "senses": [
                    {
                        "sense_id": "ee11449c-23f6-3b01-9003-62fe85fa490a",
                        "entry_id": "d202683f-cdcc-3d66-b4a6-ed0bafe3ba76",
                        "glosses": [
                            "Vorhaben, eine Person aus einem anderen Arbeitsverhältnis herauszuholen und selbst zu beschäftigen; Versuch, jemanden abzuwerben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "509c2d15-08d8-426b-9da1-b2d41427f9b8",
                                "sense_id": "ee11449c-23f6-3b01-9003-62fe85fa490a",
                                "text": "„Abwerbungsversuche bei einzelnen Spielern hat es gegeben; sie wurden aber durch die gefestigten Mannschaften abgewiesen.““"
                            },
                            {
                                "example_id": "21b30241-2f9d-48d3-9b3e-fd7c6affb434",
                                "sense_id": "ee11449c-23f6-3b01-9003-62fe85fa490a",
                                "text": "„Ferner kann es angebracht sein, den Mandanten vorsichtig auf eventuelle Abwerbungsversuche von Kollegen oder Mitgefangenen hinzuweisen.“"
                            },
                            {
                                "example_id": "c7f00a64-a579-4989-be39-30d2a9cf6a34",
                                "sense_id": "ee11449c-23f6-3b01-9003-62fe85fa490a",
                                "text": "„Zudem wurde die Abwanderung nach Westen als Folge gezielter Abwerbungsversuche seitens westdeutscher Unternehmen verstanden.“"
                            }
                        ],
