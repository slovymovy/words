                ],
                "senses": [
                    {
                        "sense_id": "5a0b2030-8301-34e1-a126-9006e04d3787",
                        "entry_id": "2628971f-0733-3ae6-a0a2-517b43ab77eb",
                        "glosses": [
                            "Rendre uniforme."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ea51c88d-64bc-48ac-8795-82b570aeee1d",
                                "sense_id": "5a0b2030-8301-34e1-a126-9006e04d3787",
                                "text": "En sortant du liquide amniotique où il a séjourné longtemps, et dont une température égale uniformait la vie intra-utérine, l'homme subit, en naissant sans abri, sans transition ménagée, l'impression d'une température nouvelle; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "f832e686-8ff9-3a3d-8388-b05d263e29d3",
                        "entry_id": "2628971f-0733-3ae6-a0a2-517b43ab77eb",
                        "glosses": [
                            "Vêtir d'un uniforme."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9b7686e4-baa8-4654-888a-5444ece21881",
                                "sense_id": "f832e686-8ff9-3a3d-8388-b05d263e29d3",
                                "text": "Les vêtements par exemple, devront servir à uniformer les troupes, l'argent n'être qu'un subside, les chevaux servir à remonter la cavalerie, […]."
                            },
                            {
                                "example_id": "2a092d2f-0d37-49d9-b30e-9fc10466d850",
                                "sense_id": "f832e686-8ff9-3a3d-8388-b05d263e29d3",
                                "text": "Les canonniers (tobdjiya) sont uniformés et organisés comme les troupes de l'asker."
                            }
                        ]
                    },
                    {
                        "sense_id": "9052f374-8bac-3b06-8eb0-538d0541e076",
                        "entry_id": "2628971f-0733-3ae6-a0a2-517b43ab77eb",
                        "glosses": [
                            "Devenir uniforme."
                        ],
                        "tags": [
                            "pronominal",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a99bdfb6-e9ab-4e36-ae0a-290aad69a11b",
                                "sense_id": "9052f374-8bac-3b06-8eb0-538d0541e076",
                                "text": "Soit la Convention française comme celle de Belgique et celle d’Allemagne contiennent des règles qui s’uniforment au principe de la loi du 7 Mai 1925 établissant l’imposition là seulement où l'entreprise de navigation a son siège."
                            }
                        ]
                    }
                ],
