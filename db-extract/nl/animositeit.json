        "nl-extract.jsonl": [
            {
                "entry_id": "503a8cc3-eb3e-3709-b4b8-55ed7c2c298b",
                "word": "animositeit",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "8a909adc-8cf1-43e7-a26a-a9cd77ecdd3c",
                        "entry_id": "503a8cc3-eb3e-3709-b4b8-55ed7c2c298b",
                        "tags": [
                            "plural"
                        ],
                        "form": "animositeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc90f3bb-20e4-31aa-ad0b-701da2e6e4d9",
                        "entry_id": "503a8cc3-eb3e-3709-b4b8-55ed7c2c298b",
                        "glosses": [
                            "vijandigheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "057fa2ee-5b90-4899-bf62-b4e036597ca5",
                                "sense_id": "bc90f3bb-20e4-31aa-ad0b-701da2e6e4d9",
                                "text": "De rechter in Hawaï, Derrick Watson, liet in zijn vonnis merken dat hij het nieuwe inreisverbod ziet als een discriminerende maatregel tegen moslims. Watson haalde tal van uitspraken aan van Trump en zijn getrouwen, die „onweerlegbaar” bewijzen dat de bedoeling achter het inreisverbod „religieuze animositeit” is. „Iedere redelijke, neutrale toeschouwer” zou het decreet zien als een poging „een zekere religie te benadelen, ongeacht het officiële, neutrale oogmerk”."
                            },
                            {
                                "example_id": "62d8cd4f-63ef-4b56-8117-0747fd9b1bd4",
                                "sense_id": "bc90f3bb-20e4-31aa-ad0b-701da2e6e4d9",
                                "text": "Ik zou iets van de animositeit tot uitdrukkig brengen die ik voor hem voelde."
                            },
                            {
                                "example_id": "26b7a54b-f87d-4d1b-9a36-da9e74c5e363",
                                "sense_id": "bc90f3bb-20e4-31aa-ad0b-701da2e6e4d9",
                                "text": "Wist je dat een van de vliegtuigen geen raampjes had?' Ook elders bij de militairen bespeur ik een zekere animositeit ten opzichte van de Amerikanen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aeaa997f-df97-4165-8e2d-59d536cdb301",
                        "source_entry_id": "503a8cc3-eb3e-3709-b4b8-55ed7c2c298b",
                        "source_sense_id": "bc90f3bb-20e4-31aa-ad0b-701da2e6e4d9",
                        "source_sense_description": "vijandigheid",
                        "target_lang_word": "enmity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enmity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8dc9c99e-f98b-3375-bbe6-b4670834b158",
                                        "entry_id": "12fd08e1-9d6f-3973-92f8-3e0f3685a9df",
                                        "glosses": [
                                            "The quality of being an enemy; hostile or unfriendly disposition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9184aa39-fb49-4168-a0c3-480b397201b2",
                                                "sense_id": "8dc9c99e-f98b-3375-bbe6-b4670834b158",
                                                "text": "We know from their literature that to our Saxon ancestors waste places of moor and forest and marshes were the resort of a host of supernatural creatures at enmity with mankind."
                                            },
                                            {
                                                "example_id": "aaf74400-f5de-4982-8d98-43819a3e1a9d",
                                                "sense_id": "8dc9c99e-f98b-3375-bbe6-b4670834b158",
                                                "text": "Some later Muses from Ionia and Sicily reckoned it safest to weave together both versions and say that that which is both many and one, held together by both enmity and amity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f12af84-c875-35e7-a158-5ac920fa8c08",
                                        "entry_id": "12fd08e1-9d6f-3973-92f8-3e0f3685a9df",
                                        "glosses": [
                                            "A state or feeling of opposition, hostility, hatred or animosity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c668352-700d-4673-8941-f90d62a22d20",
                                                "sense_id": "0f12af84-c875-35e7-a158-5ac920fa8c08",
                                                "text": "I merely repeat, remember always your duty of enmity towards Man and all his ways."
                                            },
                                            {
                                                "example_id": "91b2cad2-b6de-4ed9-b458-b18fc579aed9",
                                                "sense_id": "0f12af84-c875-35e7-a158-5ac920fa8c08",
                                                "text": "Maybe only a system that can contain the deep enmity between people who spell the metal aluminum and those who spell it aluminium is up to the task of preserving our fragile democratic institutions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ec9c46a-4e0a-4565-b074-3131f440b2ae",
                        "source_entry_id": "503a8cc3-eb3e-3709-b4b8-55ed7c2c298b",
                        "source_sense_id": "bc90f3bb-20e4-31aa-ad0b-701da2e6e4d9",
                        "source_sense_description": "vijandigheid",
                        "target_lang_word": "animosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "animosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad36a7f-df8f-3fa0-a877-71ca2f42a42c",
                                        "entry_id": "1fff440d-a476-39f8-b47d-6f2f8f4d89f7",
                                        "glosses": [
                                            "Disposition persistante de malveillance qui porte à nuire à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5238c04-50cc-407b-a200-0042b6a4680d",
                                                "sense_id": "5ad36a7f-df8f-3fa0-a877-71ca2f42a42c",
                                                "text": "Ils se cherchèrent plus d’une fois, stimulés par une animosité mutuelle, sachant bien que la chute de l’un ou de l’autre déterminerait la victoire."
                                            },
                                            {
                                                "example_id": "622926b7-4553-49e3-8b98-03d9cf6a07ea",
                                                "sense_id": "5ad36a7f-df8f-3fa0-a877-71ca2f42a42c",
                                                "text": "— C'est bon, tu as fini de faire des cochonneries avec ton crush numéro 1 ? rigola Lila au téléphone, sans un soupçon d’animosité, de jalousie ou de malveillance."
                                            },
                                            {
                                                "example_id": "2300c09d-d2b8-477c-a126-39ba07b74566",
                                                "sense_id": "5ad36a7f-df8f-3fa0-a877-71ca2f42a42c",
                                                "text": "Je déteste le comportement actuel des supporters plus \"anti ceci cela\" que pro-mon club. C'était du temps ou les supporters des deux clubs wallons se côtoyaient dans les tribunes sans aucune animosité. Qu'est-ce que je regrette ce temps !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02eb7bd7-2d22-3e58-b16f-81ef898f84ea",
                                        "entry_id": "1fff440d-a476-39f8-b47d-6f2f8f4d89f7",
                                        "glosses": [
                                            "Chaleur excessive, d’une certaine violence dans un débat, dans une discussion verbale, dans une querelle de plume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cd085b4-0298-4fb2-a3bd-9aea1ca431c7",
                                                "sense_id": "02eb7bd7-2d22-3e58-b16f-81ef898f84ea",
                                                "text": "Clemenceau par ces procédés […] suscite de vives animosités qui vont en se multipliant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
