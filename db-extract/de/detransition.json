                "senses": [
                    {
                        "sense_id": "8fd38b22-63f8-3e24-b2e3-8784827ff2a4",
                        "entry_id": "4d00c24d-1e54-372d-905a-4f0e0a088f34",
                        "glosses": [
                            "Prozess der Rückkehr in die frühere Geschlechtsrolle nach einer geschlechtlichen Transition"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17349127-eb8c-429f-94d9-774d2015c96f",
                                "sense_id": "8fd38b22-63f8-3e24-b2e3-8784827ff2a4",
                                "text": "„Wer eine Geschlechtsangleichung hat durchführen lassen und dann merkt, dass es doch nicht die richtige Entscheidung war, kann sich in den Prozess der Detransition begeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "807c07de-3a38-4ec2-a325-2749507ba3a2",
                        "source_entry_id": "4d00c24d-1e54-372d-905a-4f0e0a088f34",
                        "source_sense_id": "8fd38b22-63f8-3e24-b2e3-8784827ff2a4",
                        "source_sense_description": "Rückkehr in die frühere Geschlechtsrolle",
                        "target_lang_word": "detransition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "detransition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af0c91a2-926d-3c5e-9019-2d5fa8bd4d06",
                                        "entry_id": "5d248da9-69b6-3d1f-89d2-b58ce78f6d8b",
                                        "glosses": [
                                            "To revert to one's original gender presentation, role, or identity."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f159e1c4-bee1-4399-9eed-52ccaa8a9a77",
                                                "sense_id": "af0c91a2-926d-3c5e-9019-2d5fa8bd4d06",
                                                "text": "People detransition because they may find it difficult to get jobs, or because of social ostracism, not passing in their target gender, family responsibilities, and so on."
                                            },
                                            {
                                                "example_id": "e749b975-37b3-46d1-85df-cedfa5bb6d24",
                                                "sense_id": "af0c91a2-926d-3c5e-9019-2d5fa8bd4d06",
                                                "text": "I recently had an encounter in which I was asked if I was detransitioning simply because I was wearing a pair of jeans!"
                                            },
                                            {
                                                "example_id": "b6d5b729-6ffc-475a-a679-6db01d42a97d",
                                                "sense_id": "af0c91a2-926d-3c5e-9019-2d5fa8bd4d06",
                                                "text": "“I wish there had been more open conversations,” Powell, now 23 and detransitioned, told me. “But I was told there is one cure and one thing to do if this is your problem, and this will help you.” […] As one detransitioned man, now in a gay relationship, put it, “I was a gay man pumped up to look like a woman and dated a lesbian who was pumped up to look like a man."
                                            },
                                            {
                                                "example_id": "ae679fd9-7b01-4ec8-8183-d13c47aa42b8",
                                                "sense_id": "af0c91a2-926d-3c5e-9019-2d5fa8bd4d06",
                                                "text": "Thus, “[t]he number of people who detransition or discontinue gender treatments is not precisely known.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "detransition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "233851d1-4caa-306a-9873-78b30851371f",
                                        "entry_id": "0881fd3d-35d2-31be-9fa5-fc790496227e",
                                        "glosses": [
                                            "The act of one who detransitions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "309d6bb2-2785-4258-beba-119a20433450",
                                                "sense_id": "233851d1-4caa-306a-9873-78b30851371f",
                                                "text": "But in 2020, after coming across detransition videos online, she began to doubt the gender-affirming model."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46fa2c4f-2f8e-4186-9e60-494a033a900d",
                        "source_entry_id": "4d00c24d-1e54-372d-905a-4f0e0a088f34",
                        "source_sense_id": "8fd38b22-63f8-3e24-b2e3-8784827ff2a4",
                        "source_sense_description": "Rückkehr in die frühere Geschlechtsrolle",
                        "target_lang_word": "détransition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détransition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "950a52e9-0f7f-3a2d-8c8d-629a0745cf05",
                                        "entry_id": "793958d4-25e4-3ccc-b48a-f303d42f7198",
                                        "glosses": [
                                            "Retour au genre initial, en parlant d’une personne transgenre."
                                        ],
                                        "tags": [
                                            "Transitude"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b08ecd12-bb45-40d7-bde7-7bbf2e5251aa",
                                                "sense_id": "950a52e9-0f7f-3a2d-8c8d-629a0745cf05",
                                                "text": "[…], je me suis distraite de ma situation sinistre et calamiteuse en lisant un livre, un roman LGBT sur un homme qui fait sa transition pour devenir une femme, puis décide de redevenir un homme. J'aimais bien les histoires sur les gens qui changeaient d'avis et causaient ainsi leur propre perte même si, en l'occurrence, la détransition était certainement un cas assez rare, […]."
                                            },
                                            {
                                                "example_id": "716ab7a2-0fc9-44c0-9553-8cd1848f65ca",
                                                "sense_id": "950a52e9-0f7f-3a2d-8c8d-629a0745cf05",
                                                "text": "Quant aux demandes de « détransition », il est impossible pour l'instant des les chiffrer. Le développement de la visibilité des questions trans dans les médias est une bonne chose. Reste que les parcours de détransition ne doivent pas non plus être tabous."
                                            },
                                            {
                                                "example_id": "0f01a3e3-ea14-41c6-9497-1fd552671a2f",
                                                "sense_id": "950a52e9-0f7f-3a2d-8c8d-629a0745cf05",
                                                "text": "Elle vient de publier un article dans le Journal of Medical Ethics qui propose d’abandonner carrément les évaluations psychologiques, […]. « Les évaluations ne vont pas aider à prévenir les détransitions. On ne peut pas prédire l’évolution du genre. Les évaluations sont très stéréotypées, basées sur des comportements clichés, binaires. Elles découragent une exploration libre et honnête », dit-elle."
                                            },
                                            {
                                                "example_id": "0c93e795-226c-4cec-8e3f-e4181fa52d69",
                                                "sense_id": "950a52e9-0f7f-3a2d-8c8d-629a0745cf05",
                                                "text": "Le terme retransition est parfois préféré à celui de détransition pour mettre en avant l’idée que l’on ne cherche pas à « annuler » la transition mais que celle-ci fait partie de notre parcours."
                                            },
                                            {
                                                "example_id": "57a2a480-8f87-486a-aeba-3d5bf86607ea",
                                                "sense_id": "950a52e9-0f7f-3a2d-8c8d-629a0745cf05",
                                                "text": "La détransition peut avoir des composantes sociales, médicales ou juridiques. Elle peut être entreprise en raison d’un changement d’identité de genre ou non. La détransition de certaines personnes est motivée par des facteurs externes qui peuvent être liés à la sécurité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
