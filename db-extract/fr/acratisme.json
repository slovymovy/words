                            {
                                "example_id": "a07a3500-5228-42e7-a589-7a72bff150bd",
                                "sense_id": "2d0a84a4-bf20-311a-aebb-c4081e55a8d3",
                                "text": "ACRATISME, s. m. (Hist. an.) Les Grecs faisoient quatre repas ; le déjeuner, qu’ils appelloient acratisma, ou dianestismos ; le dîner, ariston ou dorpiston : un petit repas entre le dîner & le souper, hesperisma, ce qu’on appelle en Latin merenda ; & le souper, dipnon, & quelquefois epidorpis."
                            }
                        ]
                    }
