                                    },
                                    {
                                        "sense_id": "5b7c5325-873b-300a-ae32-9a1698757418",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "A violent, aggressive, or truculent person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8d99ec1-f55b-4fc8-a96e-646084400c62",
                                                "sense_id": "5b7c5325-873b-300a-ae32-9a1698757418",
                                                "text": "They call you a land of license—free but to thug and thief."
                                            },
                                            {
                                                "example_id": "4465883e-47d2-4334-a9ff-ff9d1371b2eb",
                                                "sense_id": "5b7c5325-873b-300a-ae32-9a1698757418",
                                                "text": "I pushed up out of my chaise and headed for the miniten court. Leah handed me her thug as I walked past her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f50a1b71-f34d-3d72-96f4-341442249f63",
                                        "entry_id": "f2765403-cc2f-3155-8b1f-30fe3579ebef",
                                        "glosses": [
                                            "A criminal that extorts people."
