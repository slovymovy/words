                        "glosses": [
                            "Zeitraum, für den eine Person, ein Gremium oder ein Parlament gewählt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb99acca-bc23-4c66-9bb9-eac51744acc0",
                                "sense_id": "c277b581-bff3-3500-a015-fbba8183d669",
                                "text": "„Niedriger war der Frauenanteil zuletzt in der Wahlperiode von 1994 bis 1998 mit 26,2 Prozent.“"
                            },
                            {
                                "example_id": "ed5ba7b2-e987-410d-a404-a7dd998259ae",
                                "sense_id": "c277b581-bff3-3500-a015-fbba8183d669",
                                "text": "„Für eine Wahlperiode saß sie sogar für die Fortschrittspartei im Parlament, und lange war sie Kolumnistin im Zweiten Programm.“"
                            }
                        ],
