                        "glosses": [
                            "Donner un caractère géorgien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2834a824-0e08-4ba2-aa85-90f240e7ffd2",
                                "sense_id": "548f8d03-980b-3525-bf25-449ef3a0dc07",
                                "text": "Z. Gamsakourdia veut géorgiser la Géorgie."
                            },
                            {
                                "example_id": "7b619171-9233-4d8b-8802-dcec228b7c12",
                                "sense_id": "548f8d03-980b-3525-bf25-449ef3a0dc07",
                                "text": "Pétrie était un monastère, fondé en 1083 en Macédoine, par un membre d’une famille arménienne géorgisée, Grégoire Bakurian, pour les Géorgiens, et qui excluait les Grecs."
                            },
                            {
                                "example_id": "a2593963-b7d0-4825-9f91-9bc5efb8d812",
                                "sense_id": "548f8d03-980b-3525-bf25-449ef3a0dc07",
                                "text": "après un certain temps elle finit par s'unir à l'Eglise Géorgienne et se géorgisa."
                            }
                        ]
                    }
