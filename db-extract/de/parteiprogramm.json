                "senses": [
                    {
                        "sense_id": "14ac6ab1-3261-3ad0-951f-cd0aa5a6c204",
                        "entry_id": "b4893a72-9287-384d-ad89-929b28965715",
                        "glosses": [
                            "Papier, in dem eine politische Partei ihre grundsätzlichen Positionen und Ziele darlegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b4955ac-2998-45ed-9a86-ab3ae79796e5",
                                "sense_id": "14ac6ab1-3261-3ad0-951f-cd0aa5a6c204",
                                "text": "Der Piratenpartei wurde oft vorgehalten, sie hätte noch kein vernünftiges Parteiprogramm."
                            },
                            {
                                "example_id": "0c69006f-da6a-482b-97be-e76df7fa1d20",
                                "sense_id": "14ac6ab1-3261-3ad0-951f-cd0aa5a6c204",
                                "text": "„Wahlkämpfe werden mit den Images von Spitzenpolitikern statt mit Parteiprogrammen geführt, Parteitage sollen Fernsehbilder liefern statt programmatische Diskussionen ermöglichen.“"
                            },
                            {
                                "example_id": "2e7ced9f-48aa-4f77-b8ec-db91f6779b34",
                                "sense_id": "14ac6ab1-3261-3ad0-951f-cd0aa5a6c204",
                                "text": "„Erst 1905 wurde die Forderung nach einer nationalen und kulturellen Autonomie in aller Form in das Parteiprogramm aufgenommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
