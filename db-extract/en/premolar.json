                "senses": [
                    {
                        "sense_id": "795c5bb9-64d0-3ba9-ae5f-5cfc6945afc4",
                        "entry_id": "bdfdd728-fd99-39ae-8275-7e88f83cad39",
                        "glosses": [
                            "A tooth situated in front of the molar teeth; especially a tooth in humans with two cusps which is between the canines and the molars (Latin: singular dens premolaris, plural dentes premolares)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be2e6686-836d-4532-9ec7-8f85828bc184",
                                "sense_id": "795c5bb9-64d0-3ba9-ae5f-5cfc6945afc4",
                                "text": "He opened and let out a hogo of medicinal rum and beer. The bad tooth was a premolar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e66ce1e-b0f3-4fbc-acfe-f19b23cc13df",
                        "source_entry_id": "bdfdd728-fd99-39ae-8275-7e88f83cad39",
                        "source_sense_id": "795c5bb9-64d0-3ba9-ae5f-5cfc6945afc4",
