                "senses": [
                    {
                        "sense_id": "90ee3bd6-b06c-35e0-89e8-a82b340dff35",
                        "entry_id": "33a1e536-0f32-3d36-9ba5-a3a0085ed84e",
                        "glosses": [
                            "Espèce de marmotte utilisée pour la fabrication d’article en fourrure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eae9c347-a657-40f3-aa08-60cf8f488d00",
                                "sense_id": "90ee3bd6-b06c-35e0-89e8-a82b340dff35",
                                "text": "Le Murmel, encore appelé Marmotte ou Chien de Chine (Arctomys baïbacina), est un Rongeur asiatique dont la fourrure est employée aux imitations."
                            },
                            {
                                "example_id": "19920346-0a3c-4602-9133-c6d323dbfa67",
                                "sense_id": "90ee3bd6-b06c-35e0-89e8-a82b340dff35",
                                "text": "En Asie, la partie Nord, qui tout entière appartient à l’URSS, nous envoie les zibelines, les hermines, les gloutons, les blaireaux, les loups, les renards, le tigre, le lynx, l’ours, les murmels, le lièvre blanc, le petit-gris, les poulains, les agneaux caraculs, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "626f776a-98b3-3b92-8feb-e5b390067978",
                        "entry_id": "33a1e536-0f32-3d36-9ba5-a3a0085ed84e",
                        "glosses": [
                            "Fourrure de cet animal, souvent teintée."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "bc244ca2-aca9-4190-95a5-8e7d664a04a9",
                                "sense_id": "626f776a-98b3-3b92-8feb-e5b390067978",
                                "text": "Ce n’était pas en tout cas le manteau sombre de murmel avec lequel elle était partie le matin pour la capitale rejoindre son mari."
                            }
                        ]
                    }
                ],
