                        "form_id": "f54b3f20-7b4b-4828-acea-85a7987bd01c",
                        "entry_id": "1a63478a-f1be-350b-8687-baa3b80c38e9",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "accélérationnistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "31a006ee-199c-305f-9bb1-e5d94a929563",
                        "entry_id": "1a63478a-f1be-350b-8687-baa3b80c38e9",
                        "glosses": [
                            "Partisan·e de l’accélérationnisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f7cba2d-698a-458f-9f3a-70d2b9636898",
                                "sense_id": "31a006ee-199c-305f-9bb1-e5d94a929563",
                                "text": "Les accélérationnistes reconnaissent uniquement la menace de l’effondrement planétaire pour présenter leur projet comme seule solution au désastre, alors même qu’ils défendent une intensification de la logique marchande qui nous a conduit jusque là."
                            },
                            {
                                "example_id": "6d75fa41-dc88-4620-abf0-9088b14bf04a",
                                "sense_id": "31a006ee-199c-305f-9bb1-e5d94a929563",
                                "text": "Les accélérationnistes veulent de leur côté hâter la guerre raciale."
                            },
                            {
                                "example_id": "94855a36-39a7-40cf-b47b-5058114e8f44",
                                "sense_id": "31a006ee-199c-305f-9bb1-e5d94a929563",
                                "text": "Les accélérationnistes, courant terroriste d’ultra droite ayant ensanglanté les États-Unis et la Nouvelle Zélande et dont plusieurs attaques ont été déjouées en France, ont d’ailleurs pour bible théorique un livre intitulé Siege et désignent leur vision du monde comme la « siege culture »."
                            }
                        ]
                    }
