                    "frequency": "High",
                    "semantic_group_id": "einwilligen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach einer langen Diskussion <w>gab</w> der Vater schließlich <w>nach</w> und kaufte das Spielzeug."
                        },
                        {
                            "text": "In einem heftigen Streit ist es oft besser, wenn man rechtzeitig <w>nachgibt</w>."
                        }
                    ],
                    "synonyms": [
