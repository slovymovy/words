                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dbad0b0-3ce3-4eb9-ad40-81a1dac82107",
                                "sense_id": "0bf55602-0a5d-3961-8f12-08b70348937b",
                                "text": "„So hielten sie schon allein ein ungewohnter furchtbarer Motorenlärm und die lauten, nahen Stimmen später Fußgänger wach.“"
                            },
                            {
                                "example_id": "6c5db8a6-48df-4cdf-ad3c-1bc536f409d1",
                                "sense_id": "0bf55602-0a5d-3961-8f12-08b70348937b",
                                "text": "„Motorenlärm rattert herüber von dem kahlen Stück Boden, das gerade noch ein Fenster in die Vergangenheit war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
