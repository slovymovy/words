                        "glosses": [
                            "dziedziczna skłonność organizmu do nadmiernej reakcji alergicznej na powszechnie występujące czynniki środowiskowe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc07dd38-6b7d-4fe2-a432-104d297cb2b0",
                                "sense_id": "ce06fce9-0992-373b-9b73-8ef9af979627",
                                "text": "Atopia jest częstą przyczyną występowania astmy i egzemy u dzieci."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
