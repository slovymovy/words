                        "form": "guyanaises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "43974049-02cc-3231-aeb5-fa3212aaf1a2",
                        "entry_id": "74a956dc-418a-3a93-a373-9fa0949d2ac2",
                        "glosses": [
                            "Relatif à la Guyane."
                        ],
                        "tags": [],
                        "note": "À ne pas confondre avec guyanien",
                        "examples": [
                            {
                                "example_id": "75baee10-aac3-4736-9ec4-1b4b8a18febd",
                                "sense_id": "43974049-02cc-3231-aeb5-fa3212aaf1a2",
                                "text": "Il se réveillait 5 à 6 fois par nuit, baigné de sueurs froides, en proie à d'affreux cauchemards où il voyait dolmare perdu dans la forêt guyanaise, maigre, sans cheveux, sans dents, cherchant désespérément la route de la Guadeloupe […]."
                            },
                            {
                                "example_id": "91cad3b0-764a-4d41-890e-0dc8a14aa59e",
                                "sense_id": "43974049-02cc-3231-aeb5-fa3212aaf1a2",
                                "text": "Cette étude confirme tout d’abord que des agriculteurs précolombiens ont édifié ces vastes complexes de champs surélevés au sein des savanes guyanaises."
                            },
                            {
                                "example_id": "b1c1cbe6-6b0b-4f96-8bdb-c5ecc46cb85e",
                                "sense_id": "43974049-02cc-3231-aeb5-fa3212aaf1a2",
                                "text": "L’intégration de langues autochtones dans la musique contemporaine participe de la fierté de jeunes Amérindiens. Dub kali’na, R’n’B teko, reggae wayana… comptent aujourd’hui parmi les tubes guyanais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03c1b6f4-c048-4506-9220-e3b36fc364ce",
                        "source_entry_id": "74a956dc-418a-3a93-a373-9fa0949d2ac2",
                        "source_sense_id": "43974049-02cc-3231-aeb5-fa3212aaf1a2",
                        "target_lang_word": "guyanisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guyanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e0c1e98-b67e-339f-8ac0-db6efafba8a0",
                                        "entry_id": "59fbc98c-ab36-3cf3-9c74-ef375d443233",
                                        "glosses": [
                                            "Guyana betreffend, aus Guyana kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51875666-3dee-441e-aafd-eac27f083c38",
                                                "sense_id": "1e0c1e98-b67e-339f-8ac0-db6efafba8a0",
                                                "text": "„Die guyanische Fußballnationalmannschaft ist die Fußballnationalmannschaft des südamerikanischen Staates Guyana.“"
                                            },
                                            {
                                                "example_id": "d9105f1f-d7c0-4386-b6dd-48103c26a8d2",
                                                "sense_id": "1e0c1e98-b67e-339f-8ac0-db6efafba8a0",
                                                "text": "Wir suchten nach einem Internetzugang und einem Geldautomat, fanden beides nicht und verließen die Stadt schnell wieder Richtung guyanischer Grenze."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
