{
    "word_family": [
        "signe",
        "signification",
        "significatif",
        "signifiant",
        "signifié",
        "insignifiant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4107c7c6-3e93-3348-ab66-d8eea7556735",
                    "sense_definition": "Avoir pour sens ou pour définition, en parlant d'un mot, d'un symbole ou d'une phrase.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sens_linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne comprends pas ce que <w>signifie</w> cette phrase dans le texte."
                        },
                        {
                            "text": "Que <w>signifie</w> ce symbole rouge affiché sur la porte d'entrée ?"
                        }
                    ],
                    "synonyms": [
                        "vouloir dire"
                    ],
                    "common_phrases": [
                        "que signifie",
                        "signifier quelque chose"
                    ]
                },
                {
                    "sense_id": "0697aef5-d8ee-31d2-b2e6-02efe4866237",
                    "sense_definition": "Être l'indice ou la marque de quelque chose ; donner à penser.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sens_linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ciel sombre ne <w>signifie</w> pas forcément qu'il va pleuvoir aujourd'hui."
                        },
                        {
                            "text": "Son silence prolongé <w>signifie</w> sans doute qu'il n'est pas d'accord."
                        }
                    ],
                    "synonyms": [
                        "indiquer"
                    ],
                    "common_phrases": [
                        "cela ne signifie pas",
                        "ne rien signifier"
                    ]
                },
                {
                    "sense_id": "d4644613-5f7c-36f4-8613-6b871977e550",
                    "sense_definition": "Faire connaître nettement et formellement sa volonté ou une décision à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication_formelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction lui a rapidement <w>signifié</w> la fin de son contrat."
                        },
                        {
                            "text": "Il a voulu <w>signifier</w> son désaccord avant que la réunion ne commence."
                        }
                    ],
                    "common_phrases": [
                        "signifier son refus",
                        "signifier son désaccord"
                    ]
                },
                {
                    "sense_id": "61e1cca9-7240-3bda-ad3c-42d084e09f89",
                    "sense_definition": "Notifier un acte juridique ou une décision de justice par l'intermédiaire d'un huissier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "communication_formelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'huissier est venu lui <w>signifier</w> le jugement rendu par le tribunal."
                        },
                        {
                            "text": "L'avocat a fait <w>signifier</w> la décision officielle à la partie adverse."
                        }
                    ],
                    "common_phrases": [
                        "signifier un jugement",
                        "faire signifier un acte"
                    ]
                }
            ]
        }
    ]
}