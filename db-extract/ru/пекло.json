                    {
                        "form_id": "65f0d229-85eb-4b7c-a47c-5abee735f3e5",
                        "entry_id": "0303db43-af43-30ff-9329-68a1e8de1c89",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "пе́клах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e707cfc-c288-334a-af81-522ff02322f2",
                        "entry_id": "0303db43-af43-30ff-9329-68a1e8de1c89",
                        "glosses": [
                            "место, где сосредоточен сильный огонь, пламя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a9e6a6c-8d5a-4e6f-8f77-61f47299b389",
                                "sense_id": "0e707cfc-c288-334a-af81-522ff02322f2",
                                "text": "Но на настоящем пожаре этим ребятам придётся лезть и не в такое пекло."
                            }
                        ]
                    },
                    {
                        "sense_id": "85063a0e-aa0e-3ea4-83ff-d8f033eeb797",
                        "entry_id": "0303db43-af43-30ff-9329-68a1e8de1c89",
                        "glosses": [
                            "неисч., разг. сильный зной, жар"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "801f632e-eba9-413f-a66c-c9227c0a6173",
                                "sense_id": "85063a0e-aa0e-3ea4-83ff-d8f033eeb797",
                                "text": "Оступились на спусках опенённые кони: ведь целый день, гонкою, вверх, вниз по камню, по пеклу, не кормя, не расседлывали…"
                            }
                        ]
                    },
                    {
                        "sense_id": "1634f8cb-2611-3b54-a238-df3abc8fdd23",
                        "entry_id": "0303db43-af43-30ff-9329-68a1e8de1c89",
                        "glosses": [
                            "неисч., перен., разг. ад; адский огонь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a40e8bf2-cde3-41ca-a2b8-21225fbaa599",
                                "sense_id": "1634f8cb-2611-3b54-a238-df3abc8fdd23",
                                "text": "Странствуя вдоль необъятной родины нашей, издали ты увидишь красной крови пятно, вставшее в темноцветную ночь; ты испуганно скажешь: «Не есть ли там местонахождение гееннского пекла?»."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0720fe0-c17b-3e40-b1a5-6ce53929520a",
                        "entry_id": "0303db43-af43-30ff-9329-68a1e8de1c89",
                        "glosses": [
                            "перен., разг. место, где происходит жаркий бой, где происходящее грозит опасностью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "412cf9f0-aa12-43cc-8ba9-10e60adca63b",
                                "sense_id": "a0720fe0-c17b-3e40-b1a5-6ce53929520a",
                                "text": "Откровенно признаться, стало жутко при мысли, что следующим потребуют в пекло наш полк."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c348879-821e-4977-ab11-867e19f33f60",
                        "source_entry_id": "0303db43-af43-30ff-9329-68a1e8de1c89",
                        "target_lang_word": "peklo",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peklo",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "091fd7c7-2327-344e-9cf9-8980717c0727",
                                        "entry_id": "2b349019-23ab-3b59-afb0-5b7a6871771f",
                                        "glosses": [
                                            "útrpné místo hříšných duší"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7097387-d8d0-3649-9478-f29102f8ae9e",
                                        "entry_id": "2b349019-23ab-3b59-afb0-5b7a6871771f",
                                        "glosses": [
                                            "trápení; utrpení"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd3eb9f6-3b43-3820-a73e-915aef0d2cba",
                                        "entry_id": "2b349019-23ab-3b59-afb0-5b7a6871771f",
                                        "glosses": [
                                            "místo, kde člověk trpí; kde zažívá něco nesnesitelného; zdroj tohoto trápení, utrpení"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0553b82-5dfb-434d-adf4-dad14ef6262d",
                                                "sense_id": "dd3eb9f6-3b43-3820-a73e-915aef0d2cba",
                                                "text": "Pak, po šestnácti dnech pekla abstinenčních příznaků, s narkotiky skutečně přestala."
                                            },
                                            {
                                                "example_id": "9d658158-0e9d-4cb1-898e-d2ea8541bd21",
                                                "sense_id": "dd3eb9f6-3b43-3820-a73e-915aef0d2cba",
                                                "text": "„Učit azylanty je často víc než peklo,“ přímočaře popisuje Rusínová. Většina držitelů azylu totiž k výuce jazyka své nové vlasti přistupuje liknavě."
                                            },
                                            {
                                                "example_id": "a46136f9-6c75-4182-aace-541f9022d7db",
                                                "sense_id": "dd3eb9f6-3b43-3820-a73e-915aef0d2cba",
                                                "text": "Vyspělé státy mají nyní na vybranou: buď začít šetřit a zažít výrazné zpomalení svých ekonomik, nebo zažít peklo státního bankrotu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peklo",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "09aec0bf-e363-393a-85c1-90cfe89910aa",
                                        "entry_id": "d341bd36-90b2-3d6a-8f18-c5981da9e6b2",
                                        "glosses": [
                                            "příčestí minulé jednotného čísla středního rodu slovesa péct"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "380f79d8-e789-4bf9-8259-c68b8018bf5a",
                                                "sense_id": "09aec0bf-e363-393a-85c1-90cfe89910aa",
                                                "text": "Kuchyň byla ještě dlouho do noci vyhřátá, jak se v ní celý den peklo cukroví."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
