    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "013c6203-f628-3ef7-a915-f353fd6542e6",
                    "sense_definition": "the sport or activity of firing a gun or other weapon such as a bow",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "firearms_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spends most of his weekends <w>shooting</w> at the local archery club.",
                            "target_lang_translations": {
                                "ru": "Большую часть выходных он проводит, <w>стреляя</w> в местном клубе стрельбы из лука."
                            }
                        },
                        {
                            "text": "The Olympic Games include several different <w>shooting</w> events for athletes.",
                            "target_lang_translations": {
                                "ru": "Олимпийские игры включают несколько различных дисциплин по <w>стрельбе</w> для спортсменов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "target shooting",
                        "clay pigeon shooting"
                    ],
                    "target_lang_definitions": {
                        "ru": "вид спорта или деятельность, связанная с использованием огнестрельного или иного оружия, например лука"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стрельба",
                                "target_lang_sense_clarification": "как вид спорта или занятие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6e7e065-3585-3396-9db8-0c5ed676c5e4",
                    "sense_definition": "an instance or event where a person is shot with a gun",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "firearms_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are still investigating the <w>shooting</w> that occurred downtown last night.",
                            "target_lang_translations": {
                                "ru": "Полиция все еще расследует <w>стрельбу</w>, произошедшую в центре города вчера вечером."
                            }
                        },
                        {
                            "text": "Witnesses reported hearing several loud bangs during the <w>shooting</w> incident.",
                            "target_lang_translations": {
                                "ru": "Очевидцы сообщили, что слышали несколько громких хлопков во время инцидента со <w>стрельбой</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mass shooting",
                        "drive-by shooting",
                        "fatal shooting"
                    ],
                    "target_lang_definitions": {
                        "ru": "случай или происшествие, при котором в человека стреляют из огнестрельного оружия"
                    },
                    "translations": {
                        "ru": [
                            {
