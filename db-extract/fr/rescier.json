                "senses": [
                    {
                        "sense_id": "98a369a4-f0d6-3b52-835c-d68dcafcdec7",
                        "entry_id": "fa294053-0f15-3363-be01-525d2001a2e7",
                        "glosses": [
                            "Scier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "816e3358-b0de-495c-bd53-b948b69b9631",
                                "sense_id": "98a369a4-f0d6-3b52-835c-d68dcafcdec7",
                                "text": "Pour ma part, j'ai déjà été, deux ou trois fois, obligé de rescier des os qui, pour la raison que je viens d'indiquer, dépassaient le point où ils devraient être coupés ;"
                            },
                            {
                                "example_id": "86a19448-1735-4bc5-a352-2be0636de941",
                                "sense_id": "98a369a4-f0d6-3b52-835c-d68dcafcdec7",
                                "text": "J'ai essayé d'intercepter, par une ligature fortement serrée, le cours des liqueurs nourricières sur la partie de l'os à rescier."
                            }
                        ]
                    }
