                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d3a3596-2b29-34da-a802-da91eabbdbef",
                        "entry_id": "f029c65a-f0dc-3a82-a235-bf2abf31e1d0",
                        "glosses": [
                            "The act by which something is bonded or joined together."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e587480b-84a2-43d3-95b7-142f46e7a6b5",
                                "sense_id": "6d3a3596-2b29-34da-a802-da91eabbdbef",
                                "text": "A systems view of reality allows one to see that it is made of successive layers of bonded elements, each layer with properties emergent from the previous one: atoms are particular bondings of more elementary particles[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "b3d967f0-96ac-33c3-8b4c-ede9f9e17bd3",
                        "entry_id": "f029c65a-f0dc-3a82-a235-bf2abf31e1d0",
                        "glosses": [
                            "A relationship between a parent and offspring that establishes the basis for an ongoing mutual attachment."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3dc01035-4e4d-31b1-b4ac-3170f5f7efbb",
                        "entry_id": "f029c65a-f0dc-3a82-a235-bf2abf31e1d0",
                        "glosses": [
                            "A close friendship that develops between adults, often as a result of intense experiences, as those shared in military combat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd35ffff-ec8a-47ff-834b-590008f46cd2",
                                "sense_id": "3dc01035-4e4d-31b1-b4ac-3170f5f7efbb",
                                "text": "a work bonding session"
                            },
                            {
                                "example_id": "11e40579-790f-4229-829e-a543adc8433b",
                                "sense_id": "3dc01035-4e4d-31b1-b4ac-3170f5f7efbb",
                                "text": "sibling bonding"
                            }
                        ]
                    },
                    {
                        "sense_id": "42301d9c-f389-3c9f-af21-1b087f58bd2b",
                        "entry_id": "f029c65a-f0dc-3a82-a235-bf2abf31e1d0",
                        "glosses": [
                            "A method of aggregating multiple network interfaces on a computer into a single logical interface"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a033b46b-868f-3f45-b623-78db71c294ee",
                        "entry_id": "f029c65a-f0dc-3a82-a235-bf2abf31e1d0",
                        "glosses": [
                            "An arrangement by which goods remain in the customs warehouses until the duties are paid."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9d70353-1251-4384-b591-31194f1162ae",
                        "source_entry_id": "f029c65a-f0dc-3a82-a235-bf2abf31e1d0",
                        "source_sense_description": "act by which something is bonded",
                        "target_lang_word": "lien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3065a18-d945-3c1a-a136-9db866e071ee",
                                        "entry_id": "8cd2892c-63b0-3244-ac7b-0200f3c4e2d5",
                                        "glosses": [
                                            "Ce qui sert à lier, à attacher des objets ou des parties ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da049de5-0252-4af4-be59-6b0a1d98a220",
                                                "sense_id": "b3065a18-d945-3c1a-a136-9db866e071ee",
                                                "text": "— L’attaque de nerfs a tordu madame comme un lien de fagot, ça l’a prise après avoir écrit."
                                            },
                                            {
                                                "example_id": "040084ab-372f-4827-97e2-d1612aef301b",
                                                "sense_id": "b3065a18-d945-3c1a-a136-9db866e071ee",
                                                "text": "Et ensuite, je préparerai des liens à fagots, et j’aiguiserai ma serpe."
                                            },
                                            {
                                                "example_id": "5fd5ba21-d12c-42e8-a384-a535603f83ea",
                                                "sense_id": "b3065a18-d945-3c1a-a136-9db866e071ee",
                                                "text": "Pour certains êtres, de mauvais liens valent mieux que pas de liens du tout. Libérés des chaînes, ils tombent dans le vide."
                                            },
                                            {
                                                "example_id": "d8d2424a-d833-4e6e-983b-594df913513c",
                                                "sense_id": "b3065a18-d945-3c1a-a136-9db866e071ee",
                                                "text": "Un lien de paille, de jonc, d’osier."
                                            },
                                            {
                                                "example_id": "46a7e5fa-cafb-4fc6-a1d6-1b75fded8448",
                                                "sense_id": "b3065a18-d945-3c1a-a136-9db866e071ee",
                                                "text": "Un lien de fer."
                                            },
                                            {
                                                "example_id": "60b492a7-6a34-40d1-aded-0d25416cca8c",
                                                "sense_id": "b3065a18-d945-3c1a-a136-9db866e071ee",
                                                "text": "Le lien d’une gerbe, d’un fagot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f39078b6-9954-3ca7-8a76-1e3981a6b904",
                                        "entry_id": "8cd2892c-63b0-3244-ac7b-0200f3c4e2d5",
                                        "glosses": [
                                            "Corde ou chaîne qui sert à attacher un prisonnier. En ce sens, il se met ordinairement au pluriel."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48f896a2-09ca-48ee-be9b-07a9ee62b34d",
                                                "sense_id": "f39078b6-9954-3ca7-8a76-1e3981a6b904",
                                                "text": "Il était dans les liens."
                                            },
                                            {
                                                "example_id": "4b54e1f6-aa6f-4846-8b60-c04d2adec3ac",
                                                "sense_id": "f39078b6-9954-3ca7-8a76-1e3981a6b904",
                                                "text": "La fête de saint Pierre aux liens."
                                            },
                                            {
                                                "example_id": "9d447688-66a0-4137-a13e-31de8dbc48f5",
                                                "sense_id": "f39078b6-9954-3ca7-8a76-1e3981a6b904",
                                                "text": "Briser, rompre ses liens."
                                            },
                                            {
                                                "example_id": "a9c8bd2a-f1ca-4489-a9ee-76fd2b1a9b18",
                                                "sense_id": "f39078b6-9954-3ca7-8a76-1e3981a6b904",
                                                "text": "Être dans les liens d’un décret, d’un mandat d’arrêt : Se dit d’une personne contre laquelle un décret, un mandat d’arrêt a été décerné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f17a1007-d3bc-3198-aa2f-db73f7022c22",
                                        "entry_id": "8cd2892c-63b0-3244-ac7b-0200f3c4e2d5",
                                        "glosses": [
                                            "Engagement ; contrat ; attache ; union."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "055f7e39-5fdb-4980-ac61-c0d54a2106d2",
                                                "sense_id": "f17a1007-d3bc-3198-aa2f-db73f7022c22",
                                                "text": "Le relâchement du lien vassalitique est une des causes de la défaite finale du Midi et de son suzerain, le comte de Toulouse."
                                            },
                                            {
                                                "example_id": "3d4b4631-fdf0-459e-92f6-3ff9cd53ae2d",
                                                "sense_id": "f17a1007-d3bc-3198-aa2f-db73f7022c22",
                                                "text": "Le bouddhisme lamaïque a créé depuis le XIIIᵉ siècle des liens étroits entre le Tibet et la Mongolie."
                                            },
                                            {
                                                "example_id": "5018c0b2-745d-4e7d-bf68-9f4898669f6c",
                                                "sense_id": "f17a1007-d3bc-3198-aa2f-db73f7022c22",
                                                "text": "Je puis forcer le pape à briser les liens du mariage qui m’unissent à Léonora."
                                            },
                                            {
                                                "example_id": "0cf9ca79-cba8-4fd4-8349-5688c5bf742e",
                                                "sense_id": "f17a1007-d3bc-3198-aa2f-db73f7022c22",
                                                "text": "Etre confronté à la mort, avec cette idée que la santé de chacun dépend de la santé de tous, est aussi un puissant vecteur de lien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b5dc9f7-dde2-3e68-aad7-65d86faa8473",
                                        "entry_id": "8cd2892c-63b0-3244-ac7b-0200f3c4e2d5",
                                        "glosses": [
                                            "Élément qui rattache deux ou plusieurs choses entre elles, assure leur relation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62787639-9c47-49d3-8df6-30658cd5c2c2",
                                                "sense_id": "3b5dc9f7-dde2-3e68-aad7-65d86faa8473",
                                                "text": "Le lien qui rattache les diverses parties de cet ouvrage est bien mince."
                                            },
                                            {
                                                "example_id": "32d832f3-5008-4b5a-a932-72a8fdd93008",
                                                "sense_id": "3b5dc9f7-dde2-3e68-aad7-65d86faa8473",
                                                "text": "Je n’aperçois aucun lien entre ces événements, entre ces idées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2332f1bf-d0a0-3633-a8ba-e5adc78e417d",
                                        "entry_id": "8cd2892c-63b0-3244-ac7b-0200f3c4e2d5",
                                        "glosses": [
                                            "Dépendance dans laquelle une femme tient un homme en dehors du mariage."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0a3446d-3e54-4370-97a7-0681cb58a646",
                                                "sense_id": "2332f1bf-d0a0-3633-a8ba-e5adc78e417d",
                                                "text": "Il a rompu ses liens."
                                            },
                                            {
                                                "example_id": "24c74f41-717d-426f-a863-181ccb364de8",
                                                "sense_id": "2332f1bf-d0a0-3633-a8ba-e5adc78e417d",
                                                "text": "Des liens honteux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24fe1a05-ac19-3e83-8b08-c7a0b2a5a168",
                                        "entry_id": "8cd2892c-63b0-3244-ac7b-0200f3c4e2d5",
                                        "glosses": [
                                            "Les barres horizontales ou obliques réunissant plusieurs figures de notes à crochets successives."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b5de75c-4ed9-356a-aa21-c92eacfaf07f",
                                        "entry_id": "8cd2892c-63b0-3244-ac7b-0200f3c4e2d5",
                                        "glosses": [
                                            "Moyen hypertexte de transfert vers une source du Web."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ccb9aeb-9c58-4896-8a69-7994fcee538d",
                                                "sense_id": "7b5de75c-4ed9-356a-aa21-c92eacfaf07f",
                                                "text": "Ajouter un lien. Faire la référence à un autre objet informatique utilisant un langage informatique."
                                            },
                                            {
                                                "example_id": "0892cd45-99f2-498d-b5dc-8bafdb696f90",
                                                "sense_id": "7b5de75c-4ed9-356a-aa21-c92eacfaf07f",
                                                "text": "Utiliser, suivre un lien automatique par cliquer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90bac37e-b98a-3436-9116-ef014a46101d",
                                        "entry_id": "8cd2892c-63b0-3244-ac7b-0200f3c4e2d5",
                                        "glosses": [
                                            "Référence à un fichier ou répertoire apparaissant elle-même comme un fichier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a90f969-8481-3186-84eb-16f7095d4b6f",
                                        "entry_id": "8cd2892c-63b0-3244-ac7b-0200f3c4e2d5",
                                        "glosses": [
                                            "Connexion prévue par le concepteur d’une application informatique pour relier des programmes, des parties de programmes, des données, des documents, des sites ou des pages sur la toile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
