                                        "entry_id": "e1d30173-3b0d-331d-8f44-c3d2e7d3c0f1",
                                        "glosses": [
                                            "Sammlung von Lehrbüchern der altindischen Medizin, die aus der brahmanischen Epoche stammen"
                                        ],
                                        "tags": [
