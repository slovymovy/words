{
    "word_family": [
        "affirm",
        "affirmative",
        "affirmatively"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62e1a551-aca9-358f-949a-7512f8d53566",
                    "sense_definition": "A statement or declaration that something is true.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "declaration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her success was an <w>affirmation</w> of all her hard work.",
                            "target_lang_translations": {
                                "ru": "Её успех стал <w>подтверждением</w> всего её упорного труда."
                            }
                        },
                        {
                            "text": "The ceremony included an <w>affirmation</w> of loyalty.",
                            "target_lang_translations": {
                                "ru": "Церемония включала в себя <w>подтверждение</w> верности."
                            }
                        }
                    ],
                    "synonyms": [
                        "assertion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявление или подтверждение того, что что-либо является истинным или верным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтверждение",
                                "target_lang_sense_clarification": "свидетельство истинности или факта"
                            },
                            {
                                "target_lang_word": "утверждение",
                                "target_lang_sense_clarification": "заявление, констатация факта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "661d771e-d95d-36d6-a74f-2e93fcdbab69",
                    "sense_definition": "A positive statement repeated to oneself to improve self-confidence or mental state.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Daily positive <w>affirmations</w> can improve self-confidence.",
                            "target_lang_translations": {
                                "ru": "Ежедневные позитивные <w>аффирмации</w> могут повысить уверенность в себе."
                            }
                        },
                        {
                            "text": "She writes down a daily <w>affirmation</w> to stay focused.",
                            "target_lang_translations": {
                                "ru": "Она записывает ежедневную <w>аффирмацию</w>, чтобы сохранять концентрацию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "positive affirmation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Позитивная фраза или формулировка, повторяемая для повышения уверенности в себе или улучшения эмоционального состояния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аффирмация",
                                "target_lang_sense_clarification": "психологическая позитивная установка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c14eb8a-12d8-3aa4-8b86-6325759cff92",
                    "sense_definition": "A formal, non-religious promise to tell the truth in a legal setting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness made a solemn <w>affirmation</w> instead of taking an oath.",
                            "target_lang_translations": {
                                "ru": "Свидетель сделал <w>торжественное заявление</w> вместо принесения религиозной присяги."
                            }
                        },
                        {
                            "text": "He gave an <w>affirmation</w> to tell the truth in court.",
                            "target_lang_translations": {
                                "ru": "Он дал <w>торжественное заверение</w> говорить правду в суде."
                            }
                        }
                    ],
                    "synonyms": [
                        "solemn affirmation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное нерелигиозное торжественное обещание говорить правду в суде взамен религиозной присяги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торжественное заявление",
                                "target_lang_sense_clarification": "юридическое заверение без религиозной клятвы"
                            },
                            {
                                "target_lang_word": "клятвенное заверение",
                                "target_lang_sense_clarification": "официальное обещание говорить правду"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}