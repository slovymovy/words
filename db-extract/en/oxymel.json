                        "sense_id": "923d432a-4832-3e6b-9b4f-3a273328befb",
                        "entry_id": "4c40c717-eee4-3233-87df-1fd2ec23c3f1",
                        "glosses": [
                            "A mixture of honey, water, and vinegar, boiled to a syrup, sometimes mixed with herbs or spices."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1dad5674-ca6d-4ecd-8f3f-0e85b3bb59fe",
                                "sense_id": "923d432a-4832-3e6b-9b4f-3a273328befb",
                                "text": "If it long continue, vomits may be taken after meat, or otherwise gently procured with warm water, oxymel, etc., now and then."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b872cc0-9259-46e0-a50f-c96da9110da6",
                        "source_entry_id": "4c40c717-eee4-3233-87df-1fd2ec23c3f1",
