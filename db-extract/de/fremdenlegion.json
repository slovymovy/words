                ],
                "senses": [
                    {
                        "sense_id": "4da44ed5-d4e7-3a27-914e-427c899b2acf",
                        "entry_id": "a76a2f81-ef99-3ef1-be0c-ec7765fac489",
                        "glosses": [
                            "französische Streitkraft, die aus freiwilligen Soldaten besteht und weltweit eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ede2fb7-ac56-45f2-bf5b-c0a67ce5ad58",
                                "sense_id": "4da44ed5-d4e7-3a27-914e-427c899b2acf",
                                "text": "Im Interesse von Frankreich wird die Fremdenlegion weltweit eingesetzt."
                            },
                            {
                                "example_id": "11128656-1e36-4e8d-a1e2-05e0a706af6f",
                                "sense_id": "4da44ed5-d4e7-3a27-914e-427c899b2acf",
                                "text": "Die Fremdenlegion gehört zum französischen Heer."
                            },
                            {
                                "example_id": "996e44d0-8375-44f4-9e8f-e339a833e119",
                                "sense_id": "4da44ed5-d4e7-3a27-914e-427c899b2acf",
                                "text": "In der Fremdenlegion werden keine Frauen zugelassen."
                            },
                            {
                                "example_id": "82ba5a34-8ba6-408a-b4d3-7f2f9ff27519",
                                "sense_id": "4da44ed5-d4e7-3a27-914e-427c899b2acf",
                                "text": "„Im Speisesaal treffe ich einen jungen Deutschen, der in die Fremdenlegion eintreten will.“"
                            },
                            {
                                "example_id": "486db821-55ad-47b1-b863-85ca3dd5685c",
                                "sense_id": "4da44ed5-d4e7-3a27-914e-427c899b2acf",
                                "text": "„In einem Weinhause, wo lustige Mädchen bedienten, wurde ihm irgendein Gift in das Glas gegossen, so daß er von Sinnen kam, und als er wieder bei sich war, wurde ihm seine Unterschrift auf einem Werbeschein für die französische Fremdenlegion vorgehalten; er war Werbern in die Finger gefallen.“"
                            },
                            {
                                "example_id": "8b198af3-6e1f-446b-a45a-752efdf39d00",
                                "sense_id": "4da44ed5-d4e7-3a27-914e-427c899b2acf",
                                "text": "„Aber auch die Fremdenlegion gehörte schließlich nicht zu den dunklen Mächten, die man nur an den nächsten Kreuzweg zu zitieren braucht, wenn man mit ihnen zu paktieren gedenkt.“"
                            },
                            {
                                "example_id": "02932f41-1612-4985-931b-1da597b08f08",
                                "sense_id": "4da44ed5-d4e7-3a27-914e-427c899b2acf",
                                "text": "„Die Route von Theresa und Florence führte sie durch Kolonien, die von Frankreich, Belgien und England verwaltet wurden, und Soldaten der Fremdenlegion oder Colonels in Safari-Outfits begrüßten sie an jedem Grenzposten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
