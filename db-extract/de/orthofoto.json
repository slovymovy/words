                                "target_senses": [
                                    {
                                        "sense_id": "2c5ffad1-b18c-3622-9321-668c7650054d",
                                        "entry_id": "de09807e-f047-3a2c-9b93-3976a21f11a9",
                                        "glosses": [
                                            "An aerial photograph that has been geometrically corrected (orthorectified) such that the scale of the photograph is uniform, meaning that the photo can be considered equivalent to a map."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e97553-232c-4433-a108-a4d1ceb71709",
                                                "sense_id": "2c5ffad1-b18c-3622-9321-668c7650054d",
                                                "text": "Orthophotos or orthophoto mosaics enhanced by additional symbolized, planimetric information are called orthophoto plans. An orthophoto plan with added contour lines is a modern mapping product, called an orthophoto map."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
