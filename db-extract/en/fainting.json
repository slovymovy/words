                    },
                    {
                        "translation_id": "95ad35ba-c0c0-4e40-b112-068a6512a1ed",
                        "source_entry_id": "19734fa5-15c2-320e-8eac-8d94f6a85fe0",
                        "source_sense_id": "82761623-59a9-3a47-85a1-f57aa0a62208",
                        "source_sense_description": "an act of collapsing to a state of temporary unconsciousness",
                        "target_lang_word": "о́бморок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "о́бморок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "55060736-f572-3f95-82f9-e4cda0377dca",
                                        "entry_id": "e9d70f3f-b3c0-368f-83ee-9805fe61065d",
                                        "glosses": [
                                            "внезапная кратковременная потеря сознания из-за временного нарушения мозгового кровотока вследствие болезненного состояния, душевного потрясения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75bb3392-bb2b-4cfd-a667-ac356b8eeda9",
                                                "sense_id": "55060736-f572-3f95-82f9-e4cda0377dca",
                                                "text": "одно это слово, так ужаснуло его, что от одной этой кровавой мысли он раза три едва не обеспамятел, но его спасло именно отдаление всякой помощи: упав в обморок, он также боялся умереть."
                                            },
                                            {
                                                "example_id": "bc5d645a-2c88-400d-aee1-5239cb5c58c7",
                                                "sense_id": "55060736-f572-3f95-82f9-e4cda0377dca",
                                                "text": "На дворе с ним сделался легкий обморок, но он преодолел себя и в тот же день выехал в Москву."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d5ef0c6-6cc1-345c-84f7-3ba7c2264772",
                                        "entry_id": "e9d70f3f-b3c0-368f-83ee-9805fe61065d",
                                        "glosses": [
                                            "бессознательное состояние в результате такой потери"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "458edaf5-fa9e-40c6-a8b7-d0cecf230743",
                                                "sense_id": "3d5ef0c6-6cc1-345c-84f7-3ba7c2264772",
                                                "text": "Амвросий поднял брошенный одним из них факел и хотел помочь девушке встать, но она была в обмороке."
                                            },
                                            {
                                                "example_id": "81a2a34f-5f4f-4fe6-8066-a8675cc47b81",
                                                "sense_id": "3d5ef0c6-6cc1-345c-84f7-3ba7c2264772",
                                                "text": "Она с изумлением смотрела на меня, осматриваясь кругом, припоминая, что с нею сталось, и вдруг она вспрянула с криком: «Матушка, матушка!» ― и упала в объятия к матери, которая и сама едва лишь тогда приходила в себя после долгого обморока."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
