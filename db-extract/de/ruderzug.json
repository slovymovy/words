                "senses": [
                    {
                        "sense_id": "27e47dfa-d5c8-3d6b-b08f-c9df588f73c7",
                        "entry_id": "ca125032-de12-310e-b630-a7aa4c1052cf",
                        "glosses": [
                            "der Zug an einem Ruder während des Ruderbootfahrens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20cd5c5b-3848-4461-989e-9820f47fe7a0",
                                "sense_id": "27e47dfa-d5c8-3d6b-b08f-c9df588f73c7",
                                "text": "„Er ist in den andern Kahn hinübergesprungen, sie packt ihn an und rauft mit ihm, ein schnellender Ruck und das hexenhafte Weib ist beiseite geschleudert, fällt in's Wasser, Arthur hebt mit der Sicherheit gewandter Kraft den Verwundeten in seinen Kahn und fährt mit pfeilschnellen Ruderzügen hinweg.“"
                            },
                            {
                                "example_id": "4695b2a4-aafa-476b-bdb5-af65bcee286a",
                                "sense_id": "27e47dfa-d5c8-3d6b-b08f-c9df588f73c7",
                                "text": "„Die Belege über das sportliche Rudern im alten Ägypten sind bislang nicht sehr informativ. Dennoch wurde bezüglich der damaligen Technik des Ruderzuges bereits einiges herausgefunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cd600618-8578-3ff5-8c26-4075afd7e04f",
                        "entry_id": "ca125032-de12-310e-b630-a7aa4c1052cf",
                        "glosses": [
                            "an einem Trainingsgerät im Fitnesscenter nachgestellte Übung des Bewegungsablaufes von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e82bafab-1552-4e28-9c31-ecacf09df975",
                                "sense_id": "cd600618-8578-3ff5-8c26-4075afd7e04f",
                                "text": "„Dabei erfahren wir, welche Körperteile beispielsweise trainiert werden, wenn man sich an der Schrägbank oder dem Ruderzug ‚schafft‘.“"
                            },
                            {
                                "example_id": "17989005-da0a-43d6-b26b-d2cf9c1dae90",
                                "sense_id": "cd600618-8578-3ff5-8c26-4075afd7e04f",
                                "text": "„Ich bin ihm zum ersten Mal an einem Freitagabend begegnet, ich am Ruderzug, er an der multi-station, rechts von uns der Freihantelbereich, links an einer Stange die Matten für die Bauchmuskelübungen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
