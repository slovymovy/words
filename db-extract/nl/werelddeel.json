                    {
                        "sense_id": "2128d8d2-cd45-3f26-8c3c-265710e06fac",
                        "entry_id": "d464b38a-9886-30fe-8395-1313f1bbfe0f",
                        "glosses": [
                            "een zeer groot boven de zee uitstekend stuk droog land en de omringende eilanden die op hetzelfde continentale plat liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2024324-9f4a-49d9-9e7d-3fd469b6d70a",
                                "sense_id": "2128d8d2-cd45-3f26-8c3c-265710e06fac",
                                "text": "De CDT noch de AT stonden hoog op mijn lijst, met als voornaamste reden dat ik graag in een ander werelddeel zou willen lopen om diverse culturen mee te maken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc9d1458-58a2-4333-882a-2b03f559fab5",
                        "source_entry_id": "d464b38a-9886-30fe-8395-1313f1bbfe0f",
                        "source_sense_id": "2128d8d2-cd45-3f26-8c3c-265710e06fac",
                        "source_sense_description": "een groot boven de zee uitstekend stuk droog land en de omringende eilanden die op hetzelfde continentale plat liggen",
                        "target_lang_word": "Erdteil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erdteil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b09bd8ba-bd06-3a2c-98c0-1d70aba09eab",
                                        "entry_id": "33c845f4-3a5f-37c8-b66a-b30bdcc01132",
                                        "glosses": [
                                            "Kontinent; fester, abgetrennter; meist größerer Teil der Erdoberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4638bd2-47c4-4571-ab54-54b22e40ab55",
                                                "sense_id": "b09bd8ba-bd06-3a2c-98c0-1d70aba09eab",
                                                "text": "Europa ist ein Erdteil."
                                            },
                                            {
                                                "example_id": "9ea36a61-aa7f-48a9-aaf9-1e65b92a31f2",
                                                "sense_id": "b09bd8ba-bd06-3a2c-98c0-1d70aba09eab",
                                                "text": "„Kein anderer Erdteil wurde aus europäischer Perspektive so eng mit einem einzigen Topos verbunden.“"
                                            },
                                            {
                                                "example_id": "f3ffddcf-eb1b-44b8-9808-b28953b0eaeb",
                                                "sense_id": "b09bd8ba-bd06-3a2c-98c0-1d70aba09eab",
                                                "text": "„Menschen in anderen Landesteilen, sogar in anderen Erdteilen schneiden sich gegen Bezahlung je ihr Stück ab, um sich darein zu kleiden.“"
                                            },
                                            {
                                                "example_id": "f68b899b-d5a0-437e-b003-1f7159ad6705",
                                                "sense_id": "b09bd8ba-bd06-3a2c-98c0-1d70aba09eab",
                                                "text": "„Indien ist sein eigener Erdteil.“"
                                            },
                                            {
                                                "example_id": "ad2a0b18-22e4-4d5a-8ae6-0090212a8a52",
                                                "sense_id": "b09bd8ba-bd06-3a2c-98c0-1d70aba09eab",
                                                "text": "„Die Menschen, die diesen Erdteil verlassen wollten, hätten jede Woche eine gigantische Flotte bemannen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
