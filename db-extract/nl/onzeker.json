                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e9048ae-14a1-3336-bb31-808183d47350",
                        "entry_id": "0c32ad0b-9945-3e16-a3aa-412561145266",
                        "glosses": [
                            "waarvan de afloop niet vaststaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19314217-f0a7-472e-84d0-c0f20fc82949",
                                "sense_id": "6e9048ae-14a1-3336-bb31-808183d47350",
                                "text": "Door de acties van de Europese Centrale Bank is de financiële wereld een stuk minder onzeker geworden."
                            },
                            {
                                "example_id": "ed3a8f95-54da-4298-9f11-fe046bc9233a",
                                "sense_id": "6e9048ae-14a1-3336-bb31-808183d47350",
                                "text": "Maar als ik onzeker was, bijvoorbeeld tijdens onweer of bij steile afdalingen, probeerde ik anderen op te zoeken om het onheil niet alleen tegemoet te hoeven treden."
                            },
                            {
                                "example_id": "34abbdc1-8cb2-47a1-b9cc-2f7bd0e5ba33",
                                "sense_id": "6e9048ae-14a1-3336-bb31-808183d47350",
                                "text": "Ruim een jaar geleden riep het WAG-bestuur de leden al op goed na te denken of ze willen doorgaan met de collectieve zaak tegen de NAM, nadat ze hadden beseft dat een gang naar de rechtbank onzekerder is dan een aanvraag bij het IMG."
                            }
                        ]
                    },
                    {
                        "sense_id": "6978f93c-299f-3ece-9194-ae81140c88ca",
                        "entry_id": "0c32ad0b-9945-3e16-a3aa-412561145266",
                        "glosses": [
                            "van iets dat het niet helemaal duidelijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "133ba99d-9bc6-42f6-85e5-e65a452913b7",
                                "sense_id": "6978f93c-299f-3ece-9194-ae81140c88ca",
                                "text": "Dit was wel het laatste waar ik op dit moment op zat te wachten in mijn huidige, onzekere staat."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
