                                                "text": "emotional crisis"
                                            },
                                            {
                                                "example_id": "fe1bac62-448e-4dbe-90b7-2ae8eb48e939",
                                                "sense_id": "da38d6f7-5123-3d4e-8e63-46d2bda1966f",
                                                "text": "emotional lift"
                                            },
                                            {
                                                "example_id": "0b2a0b45-bc5a-42dd-a8a5-cadbae072f5e",
                                                "sense_id": "da38d6f7-5123-3d4e-8e63-46d2bda1966f",
                                                "text": "One of the biggest shifts is that much of the conversation about emotional labor has left its original sphere of the workplace and moved to the home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b52d7f3a-c8e6-3ea9-919e-c1b842da33be",
                                        "entry_id": "8c3441bc-28a0-3159-ac63-eb50af42889a",
                                        "glosses": [
                                            "Characterized by emotion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb9a3d74-cd46-36fd-86f9-f3692a4add42",
                                        "entry_id": "8c3441bc-28a0-3159-ac63-eb50af42889a",
                                        "glosses": [
                                            "Determined by strong emotion rather than purely logical reasoning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1af2ff4c-a4db-481f-b58e-22aca402a5dc",
                                                "sense_id": "cb9a3d74-cd46-36fd-86f9-f3692a4add42",
                                                "text": "emotional decision"
                                            },
                                            {
                                                "example_id": "6fd32086-367e-435d-baa8-ba45cf42def5",
                                                "sense_id": "cb9a3d74-cd46-36fd-86f9-f3692a4add42",
                                                "text": "The 'movement' was simultaneously emotional and motoric, and essentially autonomous (thus distinguishing it from passive jerkings and other pathology)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3dc7630-fc5e-350a-954b-046ec83f5200",
                                        "entry_id": "8c3441bc-28a0-3159-ac63-eb50af42889a",
                                        "glosses": [
                                            "Appealing to or arousing emotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a1ab35c-d290-4a61-b2ca-16328854d08a",
                                                "sense_id": "c3dc7630-fc5e-350a-954b-046ec83f5200",
                                                "text": "emotional speech"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e33b01c1-e135-3ab6-896b-908771457aef",
                                        "entry_id": "8c3441bc-28a0-3159-ac63-eb50af42889a",
                                        "glosses": [
                                            "Easily affected by emotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f152af1e-87f1-4226-a90e-4184b9f153c7",
                                                "sense_id": "e33b01c1-e135-3ab6-896b-908771457aef",
                                                "text": "She’s an emotional person."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8c845ca-4b46-3b34-8fc1-fb1c6caac2b6",
                                        "entry_id": "8c3441bc-28a0-3159-ac63-eb50af42889a",
                                        "glosses": [
                                            "Readily displaying emotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "474b4760-5a32-417a-81b2-801f9a6c04a4",
                                                "sense_id": "d8c845ca-4b46-3b34-8fc1-fb1c6caac2b6",
                                                "text": "emotional greeting"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09f25ac4-3d65-38d6-8cd7-41f5317aa9aa",
                                        "entry_id": "8c3441bc-28a0-3159-ac63-eb50af42889a",
                                        "glosses": [
                                            "Overwhelmed by mixed emotions, moved, almost tearful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ff8c71-a51d-402b-8e4f-2be26c13a198",
                                                "sense_id": "09f25ac4-3d65-38d6-8cd7-41f5317aa9aa",
                                                "text": "She became emotional hearing about the passing of her mother."
                                            },
                                            {
                                                "example_id": "24a58dba-76fe-49df-bdaa-be529d868985",
                                                "sense_id": "09f25ac4-3d65-38d6-8cd7-41f5317aa9aa",
                                                "text": "I felt so emotional seeing my three-legged poodle win first prize."
                                            }
