                {
                    "sense_id": "9bd9b9e3-ac93-304f-8d1b-cfa15b14f875",
                    "sense_definition": "Nog nooit gebruikt en daardoor nog in nieuwstaat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "staat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iedereen heeft thuis wel <w>ongebruikt</w> speelgoed liggen waar een ander kind blij van wordt.",
                            "target_lang_translations": {
                                "ru": "У каждого дома найдутся <w>неиспользованные</w> игрушки, которые порадуют другого ребенка."
                            }
                        },
                        {
                            "text": "De winkel verkoopt alleen <w>ongebruikt</w> gereedschap in de originele verpakking.",
                            "target_lang_translations": {
                                "ru": "Магазин продает только <w>неиспользованные</w> инструменты в оригинальной упаковке."
                            }
                        }
                    ],
                    "synonyms": [
                        "nieuw",
                        "ongeopend",
                        "onaangeroerd"
                    ],
                    "common_phrases": [
                        "ongebruikt speelgoed",
                        "ongebruikt materiaal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Никогда не использовавшийся, находящийся в состоянии нового."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неиспользованный",
                                "target_lang_sense_clarification": "предмет, который не был в употреблении"
                            },
                            {
                                "target_lang_word": "новый",
                                "target_lang_sense_clarification": "в значении состояния вещи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "720c6df0-1b9f-30a9-8a7f-89e4ba8b0f0b",
                    "sense_definition": "Niet benut terwijl het wel nuttig zou kunnen zijn.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "staat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het land heeft veel <w>ongebruikt</w> potentieel voor duurzame energie.",
                            "target_lang_translations": {
                                "ru": "У страны есть большой <w>неиспользованный</w> потенциал в области возобновляемой энергии."
                            }
                        },
                        {
                            "text": "Er ligt veel <w>ongebruikt</w> talent op de arbeidsmarkt dat kansen verdient.",
                            "target_lang_translations": {
                                "ru": "На рынке труда много <w>незадействованных</w> талантов, которые заслуживают шанса."
                            }
                        }
                    ],
                    "synonyms": [
                        "braak"
                    ],
                    "common_phrases": [
                        "ongebruikt potentieel",
                        "ongebruikt talent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не задействованный, хотя мог бы принести пользу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неиспользуемый",
                                "target_lang_sense_clarification": "то, что не применяется в данный момент"
                            },
                            {
                                "target_lang_word": "незадействованный",
                                "target_lang_sense_clarification": "ресурсы или потенциал, которые не применяются"
