                "senses": [
                    {
                        "sense_id": "42cb17f9-75fa-317f-a4be-9775b04ed4ad",
                        "entry_id": "3a040551-9fbd-3f86-83b8-7876791f11ea",
                        "glosses": [
                            "von frühen Kulturen gemaltes Bild an Felsen, Felsüberhängen (Abris)"
                        ],
                        "tags": [
                            "Archäologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e454efd3-e13e-480e-bd95-586846ea355e",
                                "sense_id": "42cb17f9-75fa-317f-a4be-9775b04ed4ad",
                                "text": "„Die vielleicht berühmteste Fundstätte paläolithischer Felsmalereien ist die 1940 entdeckte Höhle von Lascaux im französischen Département Dordogne.“"
                            },
                            {
                                "example_id": "15bd9b38-b10f-4ed2-a8f3-2286cb418eb6",
                                "sense_id": "42cb17f9-75fa-317f-a4be-9775b04ed4ad",
                                "text": "„Sicher ist indes, daß die ebenso berühmten wie eigenartigen und mysteriösen Felsmalereien der australischen Ureinwohner mindestens so alt sind wie die steinzeitlichen Höhlenmalereien in den französischen und spanischen Höhlen von Chauvet, Cosquer, Niaux und Altamira.“"
                            },
                            {
                                "example_id": "dc924345-e877-4ae7-9ab8-3f6003f01b8b",
                                "sense_id": "42cb17f9-75fa-317f-a4be-9775b04ed4ad",
                                "text": "„Wir fuhren weiter die Straße Richtung Windhoek entlang, zurück nach Usakos, dann zur Spitzkoppe, und wanderten zu Fuß zu den Felsmalereien hinauf.“"
                            },
                            {
                                "example_id": "4e5d3fef-2fe2-4c43-a2f2-a2c6adb85231",
                                "sense_id": "42cb17f9-75fa-317f-a4be-9775b04ed4ad",
                                "text": "„Mein Ziel waren die Felsmalereien bei Hossa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
