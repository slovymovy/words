                "senses": [
                    {
                        "sense_id": "b8bf81c3-cc73-363c-8503-cdd1169f17a2",
                        "entry_id": "305e845c-b97e-3650-891c-acca7559bd07",
                        "glosses": [
                            "Supercontinent qui se sépara du reste de la Pangée (appelé dès lors Gondwana) durant le Mésozoïque, et se divisa à son tour en Eurasie et Amérique du Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99fcb6e2-b52c-4e40-880f-82cefd5fcc79",
                                "sense_id": "b8bf81c3-cc73-363c-8503-cdd1169f17a2",
                                "text": "La formation de la Téthys au Trias sépare la Laurasie au Nord et le Gondwana au Sud."
                            },
                            {
                                "example_id": "f3663b10-8530-4c94-8897-3a7e321b367c",
                                "sense_id": "b8bf81c3-cc73-363c-8503-cdd1169f17a2",
                                "text": "Les Antilles se sont formées après la dislocation de la Pangée (−210 MA, fin du Trias), qui donna au nord la Laurasie et au sud le Gondwana."
                            }
                        ]
                    }
                ],
                "translations": [
