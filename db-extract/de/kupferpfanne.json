                "senses": [
                    {
                        "sense_id": "23ff8fef-3f54-3b8c-9625-1db8b66636f7",
                        "entry_id": "a6890c30-8ef4-331d-949c-3e66d2b17295",
                        "glosses": [
                            "Pfanne aus Kupfer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98ba86d9-2b0c-409a-8af6-026ce75734d1",
                                "sense_id": "23ff8fef-3f54-3b8c-9625-1db8b66636f7",
                                "text": "„Küchenjungen, bis zur Hüfte nackt, fachten die Feuer an und schrubbten die großen Kupferpfannen mit Sand aus.“"
                            },
                            {
                                "example_id": "10e7fb51-fa27-4891-9e65-110a2b5d60e3",
                                "sense_id": "23ff8fef-3f54-3b8c-9625-1db8b66636f7",
                                "text": "„Einer Schale entnahm er eingemachte Kirschen, legte sie in eine kleine Kupferpfanne und erhitzte sie auf der Spiritusflamme.“"
                            },
                            {
                                "example_id": "15990062-28bd-4828-8ca6-15f50e9f844b",
                                "sense_id": "23ff8fef-3f54-3b8c-9625-1db8b66636f7",
                                "text": "„Zur Dinnerzeit hielten sie wieder vor einem Hotel, wo im Gastzimmer Kupferpfannen an den Wänden hingen und Miss Runcibles Beinkleider allgemeines Gekicher auslösten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
