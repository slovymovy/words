    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "93e3668a-28fa-3dbb-8e60-7830aa36c6bd",
                "word": "songbook",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b209dbe5-5855-44b2-93fe-9829b545b73b",
                        "entry_id": "93e3668a-28fa-3dbb-8e60-7830aa36c6bd",
                        "tags": [
                            "plural"
                        ],
                        "form": "songbooks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d733f541-e3be-3efe-8bac-2e4bab83bea0",
                        "entry_id": "93e3668a-28fa-3dbb-8e60-7830aa36c6bd",
                        "glosses": [
                            "A book containing songs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c7a8953-ba69-4a27-92fe-d71180832bf9",
                                "sense_id": "d733f541-e3be-3efe-8bac-2e4bab83bea0",
                                "text": "Some of the young folks asked Mrs. Long could they have a sing at her home that Sunday afternoon; she readily agreed, telling them to come early, bring their songbooks, and have a good sing."
                            },
                            {
                                "example_id": "790b76f4-262d-4aeb-acea-33d83b0c718e",
                                "sense_id": "d733f541-e3be-3efe-8bac-2e4bab83bea0",
                                "text": "In uncritical homage to the heyday of Hollywood musicals, Branagh sets the action in a kind of soundstagey Oxbridge (wittily designed by Tim Harvey) and at crucial moments has his cast spin on their heels and croon American songbook standards by Porter, Kern, Gershwin and company instead of launching into sonnets and masques."
                            },
                            {
                                "example_id": "80343da1-04a2-427f-b264-21def2ba598d",
                                "sense_id": "d733f541-e3be-3efe-8bac-2e4bab83bea0",
                                "text": "Wondering how else he passed his time, Winifred surveyed the room again, this time without regard for the monetary value of the things she saw. A box of lutestrings. Five songbooks. But no lute."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edab7a0a-1ea7-466d-b6c4-ef38323963ff",
                        "source_entry_id": "93e3668a-28fa-3dbb-8e60-7830aa36c6bd",
                        "source_sense_id": "d733f541-e3be-3efe-8bac-2e4bab83bea0",
                        "source_sense_description": "book",
                        "target_lang_word": "chansonnier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chansonnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f844a273-1c71-3536-b1a4-70e360c5cd5b",
                                        "entry_id": "dde92a7e-868c-3c20-93f9-a802774cab0c",
                                        "glosses": [
                                            "Chanteur de chansons, par opposition au parolier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac6ed0a-738a-496f-90a3-b2fd8ac921a8",
                                                "sense_id": "f844a273-1c71-3536-b1a4-70e360c5cd5b",
                                                "text": "Les bons chansonniers sont rares."
                                            },
                                            {
                                                "example_id": "28169044-b42e-4b76-8b29-59c126b86fa7",
                                                "sense_id": "f844a273-1c71-3536-b1a4-70e360c5cd5b",
                                                "text": "C’est un chansonnier fort spirituel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03392218-f83c-3314-aa43-e2d41f9dff6a",
                                        "entry_id": "dde92a7e-868c-3c20-93f9-a802774cab0c",
                                        "glosses": [
                                            "Se dit d’un artiste auteur-compositeur-interprète."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40b4d547-75f1-3dd6-96af-40323a699d11",
                                        "entry_id": "dde92a7e-868c-3c20-93f9-a802774cab0c",
                                        "glosses": [
                                            "Artiste de cabaret qui présente des spectacles musicaux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ff2c420-8ec3-45fe-a380-d6ac02697396",
                                                "sense_id": "40b4d547-75f1-3dd6-96af-40323a699d11",
                                                "text": "La Belote figure parmi les jeux les plus populaires de notre temps. […]. Elle inspira même chansonniers et revuistes, et l'extraordinaire faveur dont elle jouit ne paraît guère prête de s’éteindre."
                                            },
                                            {
                                                "example_id": "ba7912a1-92d9-4eae-aa2d-ec54adbd294c",
                                                "sense_id": "40b4d547-75f1-3dd6-96af-40323a699d11",
                                                "text": "Durant quatre ans, Vigneault assume le rôle d’animateur de cette boîte qui accueille les premiers chansonniers québécois dont Raoul Roy, Clémence Desrochers, Pauline Julien, Hervé Brousseau, Jean-Pierre Ferland, Claude Gauthier, […]."
                                            },
                                            {
                                                "example_id": "8b0d6dc9-8c54-4623-863b-5e1cdba8985e",
                                                "sense_id": "40b4d547-75f1-3dd6-96af-40323a699d11",
                                                "text": "...la soirée d'hier commença en mode mineur au cabaret du Caveau des roches avant que l'alcool n'embue progressivement mon cerveau. Et ce matin, je n'arrive même plus à me souvenir des chansonniers qui se sont succédés sur scène."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chansonnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10fb3dd9-f2a4-34c5-bee3-4af520ace95e",
                                        "entry_id": "d5159a1d-4db0-3bab-8878-644edd3b6f17",
                                        "glosses": [
                                            "Recueil de chansons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa909030-bd00-4ce8-9592-8e0ff87f5d59",
                                                "sense_id": "10fb3dd9-f2a4-34c5-bee3-4af520ace95e",
                                                "text": "De nombreux chansonniers du Tour de France furent publiés au siècle dernier par leurs auteurs. Celui notamment dédié aux Enfants de Maître Jacques et du Père Soubise restés fidèles au devoir, par Agenais Marche Sans Peur, Compagnon maréchal-ferrant, publié en 1897, est révélateur de ce moyen d'expression et de communication. Ce recueil rassemble 28 chansons qui racontent, parfois en détail, le déroulement des banquets, des rencontres, des réunions […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "564e03d0-ce1f-3fe8-b7a5-f245e05544fd",
                                        "entry_id": "d5159a1d-4db0-3bab-8878-644edd3b6f17",
                                        "glosses": [
                                            "Recueil de pièces lyriques des trouvères et des troubadours."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8802023-a94a-4229-8d33-a44479438328",
                                                "sense_id": "564e03d0-ce1f-3fe8-b7a5-f245e05544fd",
                                                "text": "Le chansonnier a du Vatican, apparenté de près à celui d'Arras, a été d'un secours efficace dans le travail de reconstitution de M. Jeanroy, exposé dans le ch. II."
                                            },
                                            {
                                                "example_id": "15231ace-555c-4519-b4d4-43848004ef38",
                                                "sense_id": "564e03d0-ce1f-3fe8-b7a5-f245e05544fd",
                                                "text": "Vu l'organisation particulière du chansonnier C, qui groupe les chansons par ordre alphabétique des incipit, l’Index sommaire des trouvères aurait simplement reproduit la dispersion de l’Index I."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chansonnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5cf81e5d-c35b-3c9d-a156-5348df77d55f",
                                        "entry_id": "e21a3435-146c-3881-8fb4-ee8fe986d366",
                                        "glosses": [
                                            "Qui aime à chansonner, à tourner en dérision"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af7d35d9-bb29-461e-9e53-8a50f8b6ebd1",
                                                "sense_id": "5cf81e5d-c35b-3c9d-a156-5348df77d55f",
                                                "text": "Il s’intéresse à tout, et rien ne l’intéresse. Moqueur et chansonnier, aimant en apparence tous les partis, il est généralement patriote au fond de l’âme."
                                            },
                                            {
                                                "example_id": "6ccc1296-8f39-4375-8841-2b198679cde5",
                                                "sense_id": "5cf81e5d-c35b-3c9d-a156-5348df77d55f",
                                                "text": "La cabaret Don Camilo, qui a vu défiler la plupart des grands noms de l’humour chansonnier, va fermer ses portes, a affirmé vendredi l’un des fils de son fondateur, Richard Vergnes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd3357d9-c20f-44e4-b486-856ca8bccbed",
                        "source_entry_id": "93e3668a-28fa-3dbb-8e60-7830aa36c6bd",
                        "source_sense_id": "d733f541-e3be-3efe-8bac-2e4bab83bea0",
