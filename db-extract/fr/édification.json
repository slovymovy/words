                    },
                    {
                        "form_id": "3ab4018d-0cf8-4e89-934f-9a6c88c66f8e",
                        "entry_id": "cd4e398b-629f-3846-8030-006cb0a4dea3",
                        "tags": [],
                        "form": "ædification"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8b06375-46dd-3372-a334-2bd9e29b71ff",
                        "entry_id": "cd4e398b-629f-3846-8030-006cb0a4dea3",
                        "glosses": [
                            "Action de construire. Il ne se dit guère au propre qu’en parlant des temples."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "748a2be2-8046-4f3b-9a6c-177074d74bfe",
                                "sense_id": "a8b06375-46dd-3372-a334-2bd9e29b71ff",
                                "text": "L’édification du temple de Jérusalem fut réservée à Salomon."
                            },
                            {
                                "example_id": "31e2d6f5-9150-4f76-b347-a71429ac4b08",
                                "sense_id": "a8b06375-46dd-3372-a334-2bd9e29b71ff",
                                "text": "Jésus aurait-il annoncé l’édification prochaine d’un nouveau temple ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "758027fb-2ae1-35cd-bf87-ea281d2b1f5f",
                        "entry_id": "cd4e398b-629f-3846-8030-006cb0a4dea3",
                        "glosses": [
                            "Action d’édifier, de porter à la vertu, à la piété."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fa2f28d1-f7b4-439d-9fe6-e0a44e7f8ea0",
                                "sense_id": "758027fb-2ae1-35cd-bf87-ea281d2b1f5f",
                                "text": "Il mène une vie pleine d’édification."
                            },
                            {
                                "example_id": "5ce989f6-4c19-49e8-b9d6-b34d43e156fc",
                                "sense_id": "758027fb-2ae1-35cd-bf87-ea281d2b1f5f",
                                "text": "Faire les choses pour la gloire de Dieu et pour l’édification du prochain."
                            }
                        ]
                    },
                    {
                        "sense_id": "06fc366b-640a-30d8-98e8-b1d819380e57",
                        "entry_id": "cd4e398b-629f-3846-8030-006cb0a4dea3",
                        "glosses": [
                            "État d’une personne mise en mesure d’apprécier une autre personne, une affaire, une situation."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "47dfcca3-25e5-42c6-a66e-902aaf47fe0d",
                                "sense_id": "06fc366b-640a-30d8-98e8-b1d819380e57",
                                "text": "Vous saurez, pour votre édification, que…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5fb6e4b-763e-4bc2-8d0c-b5ed5bbbe6c9",
                        "source_entry_id": "cd4e398b-629f-3846-8030-006cb0a4dea3",
