                    {
                        "translation_id": "9e20b3a6-1de9-40b9-8219-6c3adee0bb88",
                        "source_entry_id": "35e574a8-ca19-3f06-88d0-01b2fb6f4703",
                        "source_sense_description": "before industry",
                        "target_lang_word": "préindustriel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "préindustriel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aea79e94-7dba-3b78-a38a-7b6cca72a01f",
                                        "entry_id": "5294f385-b626-3125-bcc2-487f6a7e981e",
                                        "glosses": [
                                            "Relatif à la société, à la culture qui existait avant l’industrialisation, dont le secteur primaire occupe la majorité des individus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bce42f67-f845-4ed2-82a8-3d2f1038fe3b",
                                                "sense_id": "aea79e94-7dba-3b78-a38a-7b6cca72a01f",
                                                "text": "Ils ont ainsi étudié les Amérindiens Tsimané d’aujourd’hui, un peuple d’Amazonie ayant encore un mode de vie préindustriel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "034ff6a4-af72-4f70-a749-b6f6b56e516b",
                        "source_entry_id": "35e574a8-ca19-3f06-88d0-01b2fb6f4703",
                        "source_sense_description": "before industry",
                        "target_lang_word": "vorindustriell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorindustriell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66bd1829-4df6-3dd8-8bb6-a4ad81999530",
                                        "entry_id": "8b273540-8890-3e2f-ad1b-4bd31f54b53e",
                                        "glosses": [
                                            "das Zeitalter vor Beginn der Industrialisierung betreffend (in England vor 1765, in Deutschland vor 1820); die Wirtschaften der Staaten waren dabei stark agrarisch geprägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab32e094-4085-482b-a5d4-fc25c5c57202",
                                                "sense_id": "66bd1829-4df6-3dd8-8bb6-a4ad81999530",
                                                "text": "[Industriegeschichte in Franken:] „In vorindustrieller Zeit waren Bergbau, Handwerk und Landwirtschaft dominierend.“"
                                            },
                                            {
                                                "example_id": "f1a51c5c-4656-4b7f-8d4d-e53c108f1654",
                                                "sense_id": "66bd1829-4df6-3dd8-8bb6-a4ad81999530",
                                                "text": "[Schwerter:] Wie bei allen Blankwaffen vorindustrieller Produktion treten auch bei den Zweihändern verschiedene Varianten auf, die sich mitunter stark voneinander unterscheiden."
                                            },
                                            {
                                                "example_id": "44708751-5792-463d-a370-cdf75b0f4add",
                                                "sense_id": "66bd1829-4df6-3dd8-8bb6-a4ad81999530",
                                                "text": "„Im Vergleich zu vielen älteren Glocken aus vorindustrieller Zeit tragen die Glocken nebst Schmuck nur noch kurze, prägnante Inschriften wie «Ehre sei Gott in der Höhe» oder «Friede sei mit euch».“"
                                            },
                                            {
                                                "example_id": "a4dfc6d6-a137-4319-b0f7-5d4191206da8",
                                                "sense_id": "66bd1829-4df6-3dd8-8bb6-a4ad81999530",
                                                "text": "Pauperismus war eine Massenarmut, die im vorindustriellen Deutschland zwischen 1750 und 1850 herrschte als eine Folge des Wandels von einer Agrar- zu einer Industriegesellschaft."
                                            },
                                            {
                                                "example_id": "a4144cc3-c069-4d08-823c-42db575b8f7b",
                                                "sense_id": "66bd1829-4df6-3dd8-8bb6-a4ad81999530",
                                                "text": "„Schon jetzt sind Perioden extremer Trockenheit viel wahrscheinlicher als zu vorindustrieller Zeit.“"
                                            },
                                            {
                                                "example_id": "ec22297b-8f1c-459b-be16-480d95fbab34",
                                                "sense_id": "66bd1829-4df6-3dd8-8bb6-a4ad81999530",
                                                "text": "[Schweiz:] „Die Jahresdurchschnittstemperatur ist seit der vorindustriellen Zeit um 1864 um rund 2,1 °C (Stand: August 2022) angestiegen.“"
                                            },
                                            {
                                                "example_id": "4dc1b177-5a36-4f67-b96c-691e4a72317b",
                                                "sense_id": "66bd1829-4df6-3dd8-8bb6-a4ad81999530",
                                                "text": "[…] „die Klimaverhandlungen scheitern normalerweise nicht an Beteuerungen der Regierungen, man müsse der Erderhitzung Einhalt gebieten und das möglichst bei 1,5 Grad gegenüber vorindustriellen Zeiten. Das ist mittlerweile Konsens. Die wirklich schwierigen Knackpunkte sind finanzieller Art.“"
                                            },
                                            {
                                                "example_id": "53dcd9f4-8284-4ddc-b0d9-915f31be3ddc",
                                                "sense_id": "66bd1829-4df6-3dd8-8bb6-a4ad81999530",
                                                "text": "„Wenn die Erderhitzung gegenüber dem vorindustriellem Niveau bei 1,5 Grad stoppen soll, müssen sich die weltweiten Treibhausgasemissionen laut Weltklimarat IPCC bis 2030 praktisch halbieren, um bis 2050 auf null zu sinken.“"
                                            },
                                            {
                                                "example_id": "03654424-d9aa-40ac-a569-d6f3977abd68",
                                                "sense_id": "66bd1829-4df6-3dd8-8bb6-a4ad81999530",
                                                "text": "[Kohlenstoffdioxid in der Atmosphäre:] „Abschließend zeigen die Daten für 2017 mit 405,5 ppm ein neues Rekordhoch, welches 46 Prozent über dem vorindustriellen Wert liegt.“"
                                            },
                                            {
                                                "example_id": "df3ce6b6-d945-4139-9670-a5da0a70c894",
                                                "sense_id": "66bd1829-4df6-3dd8-8bb6-a4ad81999530",
                                                "text": "„Die IPCC-Prognosen für die Zukunft lesen sich düster: Sollte sich die Erde um vier Grad Celsius über die vorindustriellen Temperaturen hinaus erwärmen, würden Hitzewellen, die früher einmal alle 50 Jahre aufgetreten seien, 39 Mal häufiger auftreten.“"
                                            },
                                            {
                                                "example_id": "c83a89b1-f0bd-4093-95a4-8e70ccaac4ec",
                                                "sense_id": "66bd1829-4df6-3dd8-8bb6-a4ad81999530",
                                                "text": "„Die Naturwissenschaften“ […] „veränderten kaum die Lebensbedingungen im vorindustriellen Europa.“"
                                            },
                                            {
                                                "example_id": "d9771415-a607-4f7c-9048-fa1af528e80e",
                                                "sense_id": "66bd1829-4df6-3dd8-8bb6-a4ad81999530",
                                                "text": "[Gießen:] „Aufgrund der verheerenden Zerstörungen durch die Luftangriffe des Zweiten Weltkriegs und die Stadtplanung der Nachkriegszeit gibt es im eigentlichen Zentrum kaum noch Bauwerke der vorindustriellen Epoche.“"
                                            },
                                            {
                                                "example_id": "1973ab7e-96d6-4fd0-83c0-d29297373791",
                                                "sense_id": "66bd1829-4df6-3dd8-8bb6-a4ad81999530",
                                                "text": "„Die globale Jahresmitteltemperatur hat im Jahr 2024 laut dem Copernicus Climate Change Service erstmals eine Marke von mehr als 1,5 Grad über dem vorindustriellen Niveau erreicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
