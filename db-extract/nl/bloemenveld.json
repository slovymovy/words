                        "examples": [
                            {
                                "example_id": "1882734f-4ad8-499c-8a90-34d35b2b9f54",
                                "sense_id": "c6eb62d2-e7cf-37f6-9c41-e32f069703a1",
                                "text": "Alsof hij door een manshoog bloemenveld dwaalde, zo gleed hij langs al die volanten, falbala's en voiles van tarlatan, en met zoveel zwirrelende waaiers was het of er op elke bloem een vlinder zat."
                            },
                            {
                                "example_id": "07b4124d-65d6-4edc-ab2f-582af09f56d6",
                                "sense_id": "c6eb62d2-e7cf-37f6-9c41-e32f069703a1",
                                "text": "Lang waren ze bezig geweest. De grond omploegen, zaaien en het bloemenveld onderhouden. En vandaag zouden de kinderen bloemen gaan plukken."
                            }
                        ]
                    }
