                    }
                ],
                "senses": [
                    {
                        "sense_id": "2beb69b9-8d72-34d3-bc38-d214234afb22",
                        "entry_id": "08178fb0-9db9-3046-aced-6bd71794b5ef",
                        "glosses": [
                            "in staat van faillissement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e8173fd-7e06-4b1d-803e-567f91d72983",
                                "sense_id": "2beb69b9-8d72-34d3-bc38-d214234afb22",
                                "text": "Het failliete bedrijf kon zijn schulden niet meer aflossen."
                            },
                            {
                                "example_id": "48e6e2a5-b3a0-41d9-899c-d6eb3be87115",
                                "sense_id": "2beb69b9-8d72-34d3-bc38-d214234afb22",
                                "text": "‘Er staat bijvoorbeeld dat we failliet gaan’, zegt Atasoy. ‘Dat is aantoonbaar onjuist. We hebben de rechter ook laten zien dat het niet klopt. Dan moet dat toch uit het rapport geschrapt worden?’"
                            },
                            {
                                "example_id": "2ad206b4-da4d-4403-99ea-02f332e39986",
                                "sense_id": "2beb69b9-8d72-34d3-bc38-d214234afb22",
                                "text": "De Jonge Socialisten (JS), de jongerenafdeling van de PvdA, is zo goed als failliet door financieel wanbeheer, meldt NRC. Meer dan een ton aan uitgaven door twee voormalige penningmeesters is niet verantwoord, zegt het huidige JS-bestuur. De twee penningmeesters worden mogelijk juridisch vervolgd omdat niet duidelijk is waar meer dan een ton aan is uitgegeven, aldus de krant."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
