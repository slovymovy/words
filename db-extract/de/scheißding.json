                "senses": [
                    {
                        "sense_id": "6bce9368-6b97-3128-909e-8505edee21a9",
                        "entry_id": "9468ad4f-1bfe-3cd0-afdb-0999b45cd1e6",
                        "glosses": [
                            "grob abwertend: etwas, das nichts taugt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40338712-d539-4fbe-88e2-cf7e873bbb70",
                                "sense_id": "6bce9368-6b97-3128-909e-8505edee21a9",
                                "text": "„Papa fluchte über das Scheißding von mechanischem Rasenmäher, weil bei dem in einem fort die Walze klemmte.“"
                            },
                            {
                                "example_id": "4be23920-2d16-4b78-b8a4-cebbae51e281",
                                "sense_id": "6bce9368-6b97-3128-909e-8505edee21a9",
                                "text": "„Wenn man sich schlecht fühlt, wirds mit dem Scheißding nur noch schlimmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c0465ae-f10c-4042-b3ac-72a700b126da",
                        "source_entry_id": "9468ad4f-1bfe-3cd0-afdb-0999b45cd1e6",
                        "source_sense_id": "6bce9368-6b97-3128-909e-8505edee21a9",
                        "source_sense_description": "grob abwertend: etwas, das nichts taugt",
                        "target_lang_word": "saloperie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saloperie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1cca38a-aa3f-321b-bc33-6c1190df74ec",
                                        "entry_id": "b79a995e-90ea-3ac8-a905-8ba3e03a643c",
                                        "glosses": [
                                            "Saleté, grande malpropreté."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "239ecbd5-687a-4257-875f-a48783ab9f23",
                                                "sense_id": "d1cca38a-aa3f-321b-bc33-6c1190df74ec",
                                                "text": "Tu nettoieras tes saloperies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5deb05b-2f9c-3eb2-8e3e-1832667692bf",
                                        "entry_id": "b79a995e-90ea-3ac8-a905-8ba3e03a643c",
                                        "glosses": [
                                            "Propos ordurier."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4498ceed-1fe8-4a05-acd5-2819b2a0cc24",
                                                "sense_id": "b5deb05b-2f9c-3eb2-8e3e-1832667692bf",
                                                "text": "Malheureusement, si le désir l’avait poussée à « dire des saloperies » comme elle m’en avait prévenu, ces mêmes saloperies avaient refroidi le désir qu’elle m’inspirait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "678285b1-9384-3c2f-8951-b851a54b3fed",
                                        "entry_id": "b79a995e-90ea-3ac8-a905-8ba3e03a643c",
                                        "glosses": [
                                            "Objet méprisable, sans intérêt, nul."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2718001-2d6c-4780-ac6c-27592a660fba",
                                                "sense_id": "678285b1-9384-3c2f-8951-b851a54b3fed",
                                                "text": "Je perds tout mon temps, avec cette saloperie d’histoire-géo !"
                                            },
                                            {
                                                "example_id": "fe26076b-ea59-4790-aa3d-582ae33c8559",
                                                "sense_id": "678285b1-9384-3c2f-8951-b851a54b3fed",
                                                "text": "Le profit. Il n’y avait plus que le profit. Le troc. Le marché noir. Enfin, quoi, le vice qui rongeait tout ! L’égoïsme qui n’en finissait plus de dresser les hommes les uns contre les autres pour un bout de cette saloperie qu’on osait appeler du pain !"
                                            },
                                            {
                                                "example_id": "8e262ed2-d84c-4f8f-958e-4e60cc43fdb6",
                                                "sense_id": "678285b1-9384-3c2f-8951-b851a54b3fed",
                                                "text": "— J’ai perdu l’habitude de ces petites guimbardes, dit-il. De vraies saloperies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d1946bd-e800-3de8-9cb7-922f7154e644",
                                        "entry_id": "b79a995e-90ea-3ac8-a905-8ba3e03a643c",
                                        "glosses": [
                                            "Traîtrise."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "867aed8d-eb56-4b44-98f4-f1c3d68ec14a",
                                                "sense_id": "6d1946bd-e800-3de8-9cb7-922f7154e644",
                                                "text": "— Tu es fou ! Tu ne sens donc pas que tu me proposes une trahison ? Que tu me demandes une saloperie ?...\n — Il n'y a là ni trahison, ni saloperie, c'est de la politique ! proclama Fraizal."
                                            },
                                            {
                                                "example_id": "6ae3c683-739d-4cf4-932b-9e80f0833f0c",
                                                "sense_id": "6d1946bd-e800-3de8-9cb7-922f7154e644",
                                                "text": "On a fait une belle saloperie. Un acte innommable comme ils disent dans le journalisme."
                                            },
                                            {
                                                "example_id": "c5463393-ba50-480f-b223-8ddb49e1afcb",
                                                "sense_id": "6d1946bd-e800-3de8-9cb7-922f7154e644",
                                                "text": "– Et n’oublie pas que la s…rie que tu viens de faire peut aussi se retourner contre toi."
                                            },
                                            {
                                                "example_id": "98da7285-4079-4cb0-99cd-9fe3cc7fb900",
                                                "sense_id": "6d1946bd-e800-3de8-9cb7-922f7154e644",
                                                "text": "Quand un homme se met à se vanter de sa famille et de ses enfants, c’est en général un repère assez sûr : il a fait une saloperie."
                                            },
                                            {
                                                "example_id": "27998f9a-0d8d-4090-b6ef-29a29c5bbfdf",
                                                "sense_id": "6d1946bd-e800-3de8-9cb7-922f7154e644",
                                                "text": "Le silence, ça n’était rien d’autre que du mépris. Et même la pire des méchancetés, la plus vile saloperie, aurait été préférable à ce mépris-là."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c86bae90-d3a6-4e07-9f5a-10f36a816e41",
                        "source_entry_id": "9468ad4f-1bfe-3cd0-afdb-0999b45cd1e6",
                        "source_sense_id": "6bce9368-6b97-3128-909e-8505edee21a9",
                        "source_sense_description": "grob abwertend: etwas, das nichts taugt",
                        "target_lang_word": "merde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c07fb0e-4dee-3885-b10c-450e2ae1d6a0",
                                        "entry_id": "cf3d128b-52a0-324c-8a1e-c34a0146ecde",
                                        "glosses": [
                                            "Excrément de personne ou d’animal."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e62a5c4-698d-445a-b4e9-0d20206b3d37",
                                                "sense_id": "7c07fb0e-4dee-3885-b10c-450e2ae1d6a0",
                                                "text": "Ce pourquoi à tout, on préférait la merde du jeune homme sain — et parfois même celle, connue sous le nom de méconium, qui résultait de « la première déjection que font les enfants après leur naissance » — jusqu’à asservir un homme spécialement à cet office […]"
                                            },
                                            {
                                                "example_id": "9fb68a23-d043-4e73-8535-96394b065138",
                                                "sense_id": "7c07fb0e-4dee-3885-b10c-450e2ae1d6a0",
                                                "text": "Ici, cependant, la merde est un objet de culte. La patine n'est pas autre chose qu'une cochonnerie que le temps accumule sur les immeubles, sur les objets, sur les meubles, etc."
                                            },
                                            {
                                                "example_id": "368e7666-b97b-41ed-8561-1d544a581328",
                                                "sense_id": "7c07fb0e-4dee-3885-b10c-450e2ae1d6a0",
                                                "text": "Jamais la rancœur d’être seule à nourrir et torcher, la merde partagée c’est moins de la merde. Des fois ça ressemblait à l’amour."
                                            },
                                            {
                                                "example_id": "f1bb2e79-79ee-4e80-9e2c-8a7ff77799e8",
                                                "sense_id": "7c07fb0e-4dee-3885-b10c-450e2ae1d6a0",
                                                "text": "J’avais donc la puce aux narines en entrouvrant la porte, et ne fus pas si surpris de libérer à la vue ainsi qu’à l’odorat ce spectacle sidérant, […] : l’appartement était recouvert de merde, de merde de poulet, ou plus exactement de merde de chien à base de poulet, sur l’entière surface des sols et sur toute la base des murs. De plus, il ne s’agissait nullement de crotte mais bien de merde, lourde, gluante, épaisse, en grande quantité […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb642edb-4497-3eff-8f8e-a0615f6d887a",
                                        "entry_id": "cf3d128b-52a0-324c-8a1e-c34a0146ecde",
                                        "glosses": [
                                            "Chose sans valeur ; objet de mauvaise qualité."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively",
                                            "pejorative",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e58a8590-0f27-4b35-bdbd-66f87356c7ce",
                                                "sense_id": "eb642edb-4497-3eff-8f8e-a0615f6d887a",
                                                "text": "mais tout de même, disaient-ils, et ils avaient raison, Marienbad, quelle merde !"
                                            },
                                            {
                                                "example_id": "47791bc0-9e4b-407c-a664-797dc1acc9ac",
                                                "sense_id": "eb642edb-4497-3eff-8f8e-a0615f6d887a",
                                                "text": "De plus, son poème était une merde. Non, ce n’était pas une merde. Ou peut-être que c’était une merde, mais il fallait qu’il l'écrive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ead3edb0-b0ac-332d-a536-504e165612e1",
                                        "entry_id": "cf3d128b-52a0-324c-8a1e-c34a0146ecde",
                                        "glosses": [
                                            "Personne méprisable, sans valeur."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively",
                                            "offensive",
                                            "pejorative",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6749f53-014f-404b-a757-d5112b841e4f",
                                                "sense_id": "ead3edb0-b0ac-332d-a536-504e165612e1",
                                                "text": "T'es une vraie merde."
                                            },
                                            {
                                                "example_id": "f8dbeda2-01e8-4fe4-8521-bec6107f656f",
                                                "sense_id": "ead3edb0-b0ac-332d-a536-504e165612e1",
                                                "text": "Petite merde !"
                                            },
                                            {
                                                "example_id": "e8fd8bf7-fdd4-4d12-b48d-c414355ba2ab",
                                                "sense_id": "ead3edb0-b0ac-332d-a536-504e165612e1",
                                                "text": "Tu n'es qu'une merde !"
                                            },
                                            {
                                                "example_id": "e7ba3839-8034-4353-858c-1ab6da2d315b",
                                                "sense_id": "ead3edb0-b0ac-332d-a536-504e165612e1",
                                                "text": "Pauvre merde !"
                                            },
                                            {
                                                "example_id": "37b802de-da22-40c6-a29b-901ede1daac3",
                                                "sense_id": "ead3edb0-b0ac-332d-a536-504e165612e1",
                                                "text": "Sale merde !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "349a13a3-f2a5-3085-b7d2-ddc76bec8fec",
                                        "entry_id": "cf3d128b-52a0-324c-8a1e-c34a0146ecde",
                                        "glosses": [
                                            "Situation inextricable."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively",
                                            "pejorative",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2345ac54-c3b5-4aed-8587-2dc35abbe0ba",
                                                "sense_id": "349a13a3-f2a5-3085-b7d2-ddc76bec8fec",
                                                "text": "Le gros des pêcheurs était sur l’eau. Écartant les brouillards et les rideaux de l’aube, ils atteignaient leur rivière, le cœur battant, ensommeillés mais touchant à la vie, enfin, après des mois de mort au ralenti, de fumées d’usine, de regards précipités aux horloges, de « bonjour monsieur », d’heures de train, de métro, de merde noire en tranche ou en bâton."
                                            },
                                            {
                                                "example_id": "e5e76739-82fc-4cbc-bc79-04a0360fc7ed",
                                                "sense_id": "349a13a3-f2a5-3085-b7d2-ddc76bec8fec",
                                                "text": "« La vie, c’est un grand plat de merde qu’il faut manger à la petite cuillère. »\nPrononcer « marde », et même plutôt « marrd’ », bien molle bien noire, en roulant férocement l’r sur le bout de la langue."
                                            },
                                            {
                                                "example_id": "5629cdb8-e424-409d-9afe-2ae856b3d7ea",
                                                "sense_id": "349a13a3-f2a5-3085-b7d2-ddc76bec8fec",
                                                "text": "C’était vraiment la merde pour moi, j’aurais pu aller en prison. Mais le procureur a passé un marché avec mon avocat. Ils m’ont donné une seconde chance. Laura Griffin, Secrets en série, éditions J’ai Lu, 2015"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b46b76e-c162-3e06-bfa2-d990bb52560a",
                                        "entry_id": "cf3d128b-52a0-324c-8a1e-c34a0146ecde",
                                        "glosses": [
                                            "Fait désagréable, incommodité, incident de la vie."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively",
                                            "pejorative",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecc40a76-b04e-4cdd-857b-e3965859183d",
                                                "sense_id": "0b46b76e-c162-3e06-bfa2-d990bb52560a",
                                                "text": "Une présentatrice se matérialise dans la chambre. Tout d’abord translucide comme un voile, elle devient de plus en plus nette.\n— Bonsoir. Voici les nouvelles !\nElle n’annonce que des merdes ultra-pessimistes. Au moins une qui ne déçoit pas Mishima."
                                            },
                                            {
                                                "example_id": "54b1c7c3-f45a-4a67-9566-5fbfea684888",
                                                "sense_id": "0b46b76e-c162-3e06-bfa2-d990bb52560a",
                                                "text": "Tous aux abris ! Jacques Chirac en avait fait une philosophie prudentissime de l’action politique : « Les merdes, disait l’ancien président, volent en escadrille »."
                                            },
                                            {
                                                "example_id": "8a73b249-6ff3-4ee2-bc86-c7c430f7d7b1",
                                                "sense_id": "0b46b76e-c162-3e06-bfa2-d990bb52560a",
                                                "text": "Il m’est arrivé une merde."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "merde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b83dfd60-d2f8-369b-9b14-c9338669eabc",
                                        "entry_id": "55843a12-237b-30dc-8eee-52a1099b8a6b",
                                        "glosses": [
                                            "Exclamation de colère, d’irritation ou de surprise."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b991e7bb-e5c0-441b-a697-add7730a41fd",
                                                "sense_id": "b83dfd60-d2f8-369b-9b14-c9338669eabc",
                                                "text": "Il vente, il pleut des hallebardes : / Merde ! c'est encore l'hiver."
                                            },
                                            {
                                                "example_id": "c53286ea-f79c-416e-9bcd-11fefcf39c38",
                                                "sense_id": "b83dfd60-d2f8-369b-9b14-c9338669eabc",
                                                "text": "Je reçus d’elle, sitôt après, une lettre enthousiaste, […] où il est question de ma séduction, de mon charme secret, etc. J’aurais dit « merde », qu’elle l’aurait trouvé divin."
                                            },
                                            {
                                                "example_id": "f4d1c725-3e87-4026-8d79-1f71ca5be859",
                                                "sense_id": "b83dfd60-d2f8-369b-9b14-c9338669eabc",
                                                "text": "Amène-toi morveux : on est grands, merde aux gniards. Ça te travaille pas, la glande, momichon ? Ça va le faire. Ça vient, a pas peur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c61d07ef-69d2-322d-8f5e-ef3ab0ede22b",
                                        "entry_id": "55843a12-237b-30dc-8eee-52a1099b8a6b",
                                        "glosses": [
                                            "Vœu de bonne chance à un acteur de théâtre avant qu’il n’entre en scène."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b91c6bd-83a2-4735-887b-3deeb6900ed4",
                                                "sense_id": "c61d07ef-69d2-322d-8f5e-ef3ab0ede22b",
                                                "text": "Vas-y, je te dis merde."
                                            },
                                            {
                                                "example_id": "e0708aea-7497-4870-86e1-978ac62b7248",
                                                "sense_id": "c61d07ef-69d2-322d-8f5e-ef3ab0ede22b",
                                                "text": "Il est temps d’y aller. Merde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49a490b7-050f-302a-b84f-f59b44bfa7cc",
                                        "entry_id": "55843a12-237b-30dc-8eee-52a1099b8a6b",
                                        "glosses": [
                                            "Vœu de bonne chance à une personne avant qu’elle ne passe une épreuve (souhaiter bonne chance étant supposé porter malheur)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdcb8328-f6df-412f-8802-4bf6b0a1a79b",
                                                "sense_id": "49a490b7-050f-302a-b84f-f59b44bfa7cc",
                                                "text": "Au fait : merde pour le bac."
                                            }
                                        ]
