                "senses": [
                    {
                        "sense_id": "49efd711-e4de-3545-a3e7-4fe04884572a",
                        "entry_id": "d3bb487c-05a8-3ef6-b103-a86c19689c25",
                        "glosses": [
                            "friendly treat, hospitality, friendly attitude"
                        ],
                        "tags": [
                            "colloquial",
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "cb323a32-2f85-46bf-96fb-32bb7e2bead8",
                                "sense_id": "49efd711-e4de-3545-a3e7-4fe04884572a",
                                "text": "Их не встреча́ли хле́бом-со́лью.",
                                "translation": "They were not welcome.",
                                "english": "They were not welcome."
                            },
                            {
                                "example_id": "ebd19b75-e074-4792-9568-259b712be4c8",
                                "sense_id": "49efd711-e4de-3545-a3e7-4fe04884572a",
                                "text": "Да здра́вствует вели́кий госуда́рь!\nПрости́те же вы, го́сти дороги́е;\nБлагодарю́, что вы мое́й хлеб-со́лью\nНе презре́ли. Прости́те, до́брый сон.",
                                "translation": "Long live our great sovereign!\nAnd to you, dear guests, I say goodbye;\nI thank you that you’ve chosen not to scorn\nMy hospitality. Goodbye and sleep well.",
                                "english": "Long live our great sovereign!\nAnd to you, dear guests, I say goodbye;\nI thank you that you’ve chosen not to scorn\nMy hospitality. Goodbye and sleep well."
                            }
                        ]
                    }
                ],
