                "senses": [
                    {
                        "sense_id": "33b6691e-1a1a-3619-bbba-90e6091de2c5",
                        "entry_id": "e0fb8f51-c4ba-395f-88fd-e8bae49597a5",
                        "glosses": [
                            "Poudre cosmétique composée (aujourd’hui) d’un mélange de galène, de malachite et de soufre, stabilisée dans une base grasse, et utilisée pour maquiller les yeux (l’antimoine n’est plus utilisé en cosmétique en raison de sa forte toxicité)."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7af8356a-243c-4c06-8ed0-503b67b8d137",
                                "sense_id": "33b6691e-1a1a-3619-bbba-90e6091de2c5",
                                "text": "Le khôl rehausse et sublime l’œil en lui donnant du mystère et de la profondeur."
                            },
                            {
                                "example_id": "8f6ba3f9-abf9-4a51-8cae-c6338e1e6eca",
                                "sense_id": "33b6691e-1a1a-3619-bbba-90e6091de2c5",
                                "text": "Il n'avait plus rien du cabotin miteux de tout à l'heure ; l'habit de soirée lui seyait à merveille, la fine barbiche noire allongeait avantageusement son visage et le léger trait de khôl lui donnait des yeux rêveurs d'amoureux."
                            },
                            {
                                "example_id": "66b2cecd-c292-410b-a267-061beee52711",
                                "sense_id": "33b6691e-1a1a-3619-bbba-90e6091de2c5",
                                "text": "Le marchand, pour toute réponse, leva ses larges yeux bruns cernés de khôl vers le ciel."
                            },
                            {
                                "example_id": "a54e0a52-b6ec-46c4-8efd-a57c733de126",
                                "sense_id": "33b6691e-1a1a-3619-bbba-90e6091de2c5",
                                "text": "Tu enfiles ta robe de chambre. Tu prends soin de colorer tes yeux de khôl noir. Et tu ouvres."
                            },
                            {
                                "example_id": "aa0c76be-30f3-456e-972f-c134bec36b50",
                                "sense_id": "33b6691e-1a1a-3619-bbba-90e6091de2c5",
                                "text": "Je passe un peu de khôl sur le bord supérieur de mes yeux, du rouge mat sur mes lèvres et je me vaporise de parfum Elie Saab jusqu'à la teucha."
                            },
                            {
                                "example_id": "0e4b3ac4-272f-4e30-813d-b283c35bdda7",
                                "sense_id": "33b6691e-1a1a-3619-bbba-90e6091de2c5",
                                "text": "En silence, Vicente conduit Myriam jusqu’à la cuisine, où dans la lumière électrique, elle s’aperçoit qu’il s’est maquillé les yeux avec de la poudre de khôl."
                            }
                        ]
                    }
                ],
