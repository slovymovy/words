                        "poser un problème",
                        "avoir un problème"
                    ]
                },
                {
                    "sense_id": "3e8a72e5-163c-3802-afc7-f7a4e14a88a6",
                    "sense_definition": "Question théorique ou exercice scientifique qu'il faut résoudre par le raisonnement ou le calcul.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves doivent résoudre ce <w>problème</w> de mathématiques avant la fin du cours."
                        },
                        {
                            "text": "Le professeur explique la méthode pour aborder chaque nouveau <w>problème</w> de géométrie."
                        }
                    ],
                    "antonyms": [
                        "solution"
                    ],
                    "common_phrases": [
