                        ],
                        "examples": [
                            {
                                "example_id": "22d78530-e01b-4b38-b976-54e6903ec82a",
                                "sense_id": "18a9c8db-c7bb-3963-b828-5ccb34c8f4cf",
                                "text": "To, czemu się cały czas oddajesz, można jedynie nazwać nieróbstwem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db8cd2da-ba52-4f1d-9a1b-84094ff8eb6c",
