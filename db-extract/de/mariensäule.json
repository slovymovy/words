                "senses": [
                    {
                        "sense_id": "945afd18-7e78-3636-a3bb-2ecd6b2a8fb9",
                        "entry_id": "77dc5967-8039-3767-b23e-54984c867b5a",
                        "glosses": [
                            "hohe Säule, auf der die Figur der Heiligen Maria steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c38b081-3f20-4103-8518-55ba0f3aa2ec",
                                "sense_id": "945afd18-7e78-3636-a3bb-2ecd6b2a8fb9",
                                "text": "„Auf der linken Seite der Mosel, auf dem höchsten Punkt der Sandsteinfelsen, überragt die Mariensäule die Stadt.“"
                            },
                            {
                                "example_id": "8dfe49fa-8145-4acd-923d-6d44c86d759c",
                                "sense_id": "945afd18-7e78-3636-a3bb-2ecd6b2a8fb9",
                                "text": "„In der Mitte des Platzes steht die im Jahre 1638 vom bayerischen Herzog Maximilian (1573-1651) errichtete Mariensäule, die dem Platz seinen Namen gab.“"
                            },
                            {
                                "example_id": "287e35f1-d70d-470d-a137-e92da9df689e",
                                "sense_id": "945afd18-7e78-3636-a3bb-2ecd6b2a8fb9",
                                "text": "„Auf die Sockel der Mariensäule wurden 1641 vier Putti aus Bronze plaziert, sie versinnbildlichen den Sieg Marias über Hunger (Drache), Krieg (Löwe), Pest (Basilisk) und Ketzerei (Schlange).“"
                            },
                            {
                                "example_id": "493e58f6-eab7-4b09-abf9-38967bb13a29",
                                "sense_id": "945afd18-7e78-3636-a3bb-2ecd6b2a8fb9",
                                "text": "„Die Brüder Wolfgang und Johann Baptist Hagenauer errichteten die Mariensäule von 1766 bis 1771 im Auftrag des Erzbischofs Sigismund Graf von Schrattenbach“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
