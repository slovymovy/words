                                "target_senses": [
                                    {
                                        "sense_id": "cb7a5024-bcb2-3e0e-8570-f80635399186",
                                        "entry_id": "73a68802-30f3-39ab-83e7-a3fae6c1f2f3",
                                        "glosses": [
                                            "zwischen zwei oder mehreren verschiedenen Molekülen ablaufend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fcace94-6ba1-454c-bf5d-9696888b0fb7",
                                                "sense_id": "cb7a5024-bcb2-3e0e-8570-f80635399186",
                                                "text": "„Die Verbindung der einzelnen antigenbindenden Moleküle erfolgt durch zusätzliche intermolekulare Disulfidbrücken und die J-Kette.“"
                                            },
                                            {
                                                "example_id": "e56aa063-3284-4bb2-a313-a13fb2bb4d63",
                                                "sense_id": "cb7a5024-bcb2-3e0e-8570-f80635399186",
                                                "text": "„Das Ziegler-Ruggli-Verdünnungsprinzip (auch Ruggli-Ziegler-Prinzip) besagt, dass eine intramolekulare chemische Reaktion gegenüber der intermolekularen Reaktion bei hoher Verdünnung bevorzugt ist, […].“"
                                            }
                                        ],
