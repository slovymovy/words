        "fr-extract.jsonl": [
            {
                "entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                "word": "échauffement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9024e618-3d0d-4a9a-80e0-48e932144f03",
                        "entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                        "tags": [
                            "plural"
                        ],
                        "form": "échauffements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "65cae8a3-2f09-3032-8ec8-7c2facc8443d",
                        "entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                        "glosses": [
                            "Action d’échauffer ou de s’échauffer ; résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dba6a9e4-527d-4543-9c24-41ccbfd2791b",
                                "sense_id": "65cae8a3-2f09-3032-8ec8-7c2facc8443d",
                                "text": "La centrale thermique de Vernou-sur-Seine est située approximativement au milieu du bief. D'une puissance totale de 750 MW, elle prélève lorsqu’elle fonctionne à pleine charge, un débit de 28 m³/s qu'elle réchauffe de 7°C, ce qui correspond à un échauffement théorique de la Seine d'environ 2°C pour le débit moyen annuel de 120 m³/s."
                            },
                            {
                                "example_id": "8874d92e-08ba-4c02-b37b-e3df577f6552",
                                "sense_id": "65cae8a3-2f09-3032-8ec8-7c2facc8443d",
                                "text": "Car tout bourgeois, dans l’échauffement de sa jeunesse, ne fût-ce qu’un jour, une minute, s’est cru capable d’immenses passions, de hautes entreprises."
                            },
                            {
                                "example_id": "d2ebaddb-ddd3-4078-bd7e-2705b4dd5c52",
                                "sense_id": "65cae8a3-2f09-3032-8ec8-7c2facc8443d",
                                "text": "Compte tenu de la durée de vie de certains radioéléments, le principal atout d’une pile nucléaire tient dans son incomparable durée d’utilisation… qu’on s’en serve ou pas ; et cela sans échauffement de la pile."
                            }
                        ]
                    },
                    {
                        "sense_id": "742fce89-dcfd-3e9b-99f5-c320f5b85134",
                        "entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                        "glosses": [
                            "Course destinée à s’échauffer, et de manière général mouvements destinés à se préparer à un effort physique, permettant de diminuer le risque d’accident."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43a4a7ec-96f4-480c-b9ce-e23886c37d59",
                                "sense_id": "742fce89-dcfd-3e9b-99f5-c320f5b85134",
                                "text": "Ainsi, un échauffement de 5,2 km est organisé par l’Unesco, baptisé \"course du petit-déjeuner\" dès 8 h 30."
                            }
                        ]
                    },
                    {
                        "sense_id": "fce114bb-3226-3f72-a4e8-92e2168ce8e0",
                        "entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                        "glosses": [
                            "Trouble intestinal qui se manifeste par la constipation."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9ac40c4c-e8d1-3999-8c9e-09db36df0f2b",
                        "entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                        "glosses": [
                            "Pourriture partielle d’un bois récemment abattu par des champignons lignivores, formant des taches noires et blanches typiques ; le bois doté d’échauffure est dit échauffé."
                        ],
                        "tags": [
                            "Exploitation forestière"
                        ],
                        "examples": [
                            {
                                "example_id": "88ca55c6-942d-4675-a38e-9ef678b436af",
                                "sense_id": "9ac40c4c-e8d1-3999-8c9e-09db36df0f2b",
                                "text": "L'échauffure est le résultat de lʼéchauffement du bois dû à la fermentation de la sève ou à une attaque par des champignons lignivores. Le bois échauffé est utilisé pour ses qualités décoratives. La cause de l'échauffement doit alors être neutralisée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7955674-c758-4049-95e1-d24650009819",
                        "source_entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                        "source_sense_id": "65cae8a3-2f09-3032-8ec8-7c2facc8443d",
                        "source_sense_description": "Action d’échauffer",
                        "target_lang_word": "Erhitzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erhitzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "002e0ba7-8981-390a-af7b-b5f7cd01d465",
                                        "entry_id": "58710915-a741-3dd0-8a72-2a820c1c5cd3",
                                        "glosses": [
                                            "der Vorgang, bei dem die Temperatur von etwas gesteigert (erhöht) wird, meist über 80 °C"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73b916ec-623e-4c4b-bc6a-026f57e4a0a1",
                                                "sense_id": "002e0ba7-8981-390a-af7b-b5f7cd01d465",
                                                "text": "Bei Erhitzung dehnen sich die Materialien unterschiedlich aus."
                                            },
                                            {
                                                "example_id": "46738451-4c56-43c9-b333-bf40680fdf33",
                                                "sense_id": "002e0ba7-8981-390a-af7b-b5f7cd01d465",
                                                "text": "Ziemlich keimfrei bekommen wir daher ein Lebensmittel wie Milch durch Pasteurisierung, eine Erhitzung auf 80 bis 100 Grad für wenige Sekunden."
                                            },
                                            {
                                                "example_id": "78f06c51-66b2-4fbd-b3d9-7d6e3e8b538b",
                                                "sense_id": "002e0ba7-8981-390a-af7b-b5f7cd01d465",
                                                "text": "Bier aus Gräfenberg muss innerhalb weniger Wochen getrunken werden, weshalb die Meisterinnen aus dem Dorf auf Erhitzung oder Sterilisierung verzichten."
                                            },
                                            {
                                                "example_id": "69658e61-9506-414b-9fe7-ef24a87adf46",
                                                "sense_id": "002e0ba7-8981-390a-af7b-b5f7cd01d465",
                                                "text": "Das deutsche Bundesamt für Risikobewertung warnte im Januar vor schädlichem Formaldehyd, das bei der Erhitzung der Tabakflüssigkeit freigesetzt werden könne."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78dd556f-a035-4da3-992f-228033333ae1",
                        "source_entry_id": "7d095860-4568-3dc0-9122-573da857248e",
                        "source_sense_id": "65cae8a3-2f09-3032-8ec8-7c2facc8443d",
                        "source_sense_description": "Action d’échauffer",
                        "target_lang_word": "Erwärmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erwärmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                        "entry_id": "027c3ca2-24f5-3a95-bdca-469f33c712a5",
                                        "glosses": [
                                            "kleine Erhöhung der Temperatur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db518bad-72ea-4758-97b5-4170cdaf584e",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "Bei der Reaktion ist mit einer Erwärmung des Substrats zu rechnen."
                                            },
                                            {
                                                "example_id": "8d816dfc-b492-4690-a0d5-8deb8f1c0215",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "Die Erwärmung der Atmosphäre scheint unabwendbar."
                                            },
                                            {
                                                "example_id": "1d2fa22c-ef1e-4ee4-8b45-287425d9b213",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "„Zweitens werde diskutiert, ob die globale Erwärmung die jährlichen Schwankungen im Luftdruckunterschied zwischen Islandtief und Azorenhoch verstärkt.“"
                                            },
                                            {
                                                "example_id": "5130f4ef-3833-4c69-a610-c616d9c2df06",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "„Der kleine Inselstaat setzt sich vor allem für die Belange vieler pazifischer Länder ein, die vom Meeresspiegelanstieg infolge der globalen Erwärmung bedroht sind.“"
                                            },
                                            {
                                                "example_id": "dbda1175-693a-4916-ae6d-f35f0154f4e6",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "„»Wir wissen schon seit Jahrzehnten, dass eine bestimmte Menge Kohlendioxid, die in die Atmosphäre abgegeben wird, immer ein bestimmtes Maß der Erwärmung nach sich zieht. Das ist eine Grundlage der Wissenschaft«, sagt er.“"
                                            },
                                            {
                                                "example_id": "c794f95d-85ec-4ad5-89a4-010428e22906",
                                                "sense_id": "2b736d73-faae-346a-9501-62bb8f189fed",
                                                "text": "„Wenn Salze gelöst werden, sind oft Temperaturänderungen zu beobachten. So löst sich Kaliumchlorid unter Abkühlung, Lithiumchlorid dagegen unter Erwärmung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
