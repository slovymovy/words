                        "entry_id": "ea2ddaf2-75a7-3e12-9a97-332e8dad8517",
                        "glosses": [
                            "Vorgang des Auftauchens aus der Unkenntlichkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd40d122-9668-49d8-b25e-86772277a375",
                                "sense_id": "3951384e-32eb-3782-a59b-02f59d5a250d",
                                "text": "Ich beobachte gerne das Sichtbarwerden des Mondes."
                            },
                            {
                                "example_id": "08c3ed44-efc2-4751-b0bd-9e60221e4660",
                                "sense_id": "3951384e-32eb-3782-a59b-02f59d5a250d",
                                "text": "Die erste Anwendung kann im Frühjahr bei Befallsbeginn bzw. bei Sichtbarwerden der ersten Symptome ab ES 25 (BBCH-Code: 5 Bestockungstriebe sichtbar) erfolgen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
