                        "sense_id": "50b7cb6b-33b1-34a5-b4fc-3318ab80e5d0",
                        "entry_id": "56e5d8d4-5169-3947-94ea-7e8f95a6edb0",
                        "glosses": [
                            "de masten en hun verstaging (het zg. staande want) van een traditioneel zeilschip."
                        ],
                        "tags": [
