                ],
                "senses": [
                    {
                        "sense_id": "6ef0f4db-07b8-3309-8fc3-d932a31fe0cf",
                        "entry_id": "c9ad331a-3410-35df-94b0-3d185b98aff0",
                        "glosses": [
                            "Centre de collecte et de tri volontaire des déchets qui peut en assurer la récupération, le recyclage, l’incinération ou le stockage dans un centre d’enfouissement."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "a2063668-c6b3-4937-9cc1-3a990e5aa213",
                                "sense_id": "6ef0f4db-07b8-3309-8fc3-d932a31fe0cf",
                                "text": "Concernant l’innovation dans les déchetteries, on peut mentionner l'exemple de la déchetterie fluviale sur le quai Fléchimont, en bord de Saône en plein cœur de Lyon. […]. Cette déchetterie futuriste est installée sur une barge de 50 m de long ; cela permet d’optimiser l’espace qui manque dans les centres des grandes villes."
                            },
                            {
                                "example_id": "21de736d-3a28-4957-ab37-4ec5d623f7ce",
                                "sense_id": "6ef0f4db-07b8-3309-8fc3-d932a31fe0cf",
                                "text": "Hier en début d’après-midi, les habitués de la déchetterie de Sainte-Marie-aux-Mines sont tombés nez à nez avec un panonceau, écrit à la hâte sur du carton, annonçant la fermeture de la déchetterie « en raison de l’apport d’un obus »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40663e18-6e59-404c-a3de-97a5680d8a4e",
                        "source_entry_id": "c9ad331a-3410-35df-94b0-3d185b98aff0",
                        "source_sense_id": "6ef0f4db-07b8-3309-8fc3-d932a31fe0cf",
                        "target_lang_word": "Recyclinghof",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Recyclinghof",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7585325a-b4f2-3088-8b09-05b8f317790d",
                                        "entry_id": "12c5d71e-3d37-3294-bacf-1cee245eb40e",
                                        "glosses": [
                                            "zentrale Sammelstelle für wiederverwertbare Abfälle und Wertstoffe aus Privathaushalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "599efb0b-8bd5-4c4e-b4ba-de740179c64a",
                                                "sense_id": "7585325a-b4f2-3088-8b09-05b8f317790d",
                                                "text": "„Ihre Abgabestellen für Sperrmüll, Grünabfälle, Wertstoffe und Problemstoffe sind unsere Recyclinghöfe und die Mobile Problemstoffsammlung.“"
                                            },
                                            {
                                                "example_id": "68909de9-407e-41c3-ab66-a4b1ebf86dd8",
                                                "sense_id": "7585325a-b4f2-3088-8b09-05b8f317790d",
                                                "text": "„Die städtischen Recyclinghöfe Fürth und Schwabach werden von uns privatrechtlich, jedoch im Auftrag der Kommune, bzw. Stadt betrieben.“"
                                            },
                                            {
                                                "example_id": "a0fed165-805e-46f6-b652-eea9d5cff218",
                                                "sense_id": "7585325a-b4f2-3088-8b09-05b8f317790d",
                                                "text": "„In Münster gibt es elf Recyclinghöfe, hier werden alle Wertstoffe, Problemabfälle und Sperrgut aus Privathaushalten kostenlos angenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
