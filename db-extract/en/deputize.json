                "senses": [
                    {
                        "sense_id": "ad978934-8fd2-3abd-8078-fcc14580cf23",
                        "entry_id": "566e35dc-c5d9-303f-912e-5c6f0324e126",
                        "glosses": [
                            "To officially empower, authorize, pronounce, and establish (someone) to be a deputy."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dfec559b-1bfb-376d-a338-904ef762b0db",
                        "entry_id": "566e35dc-c5d9-303f-912e-5c6f0324e126",
                        "glosses": [
                            "to officially empower and authorize (someone) to act as a substitute in one's role or office"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "05a8a921-b764-423d-9ebf-b875f87dc154",
                                "sense_id": "dfec559b-1bfb-376d-a338-904ef762b0db",
                                "text": "I deputize you to act for me while I'm away."
                            }
                        ]
                    },
                    {
                        "sense_id": "c37088af-371e-34a9-9674-f99ab36c1183",
                        "entry_id": "566e35dc-c5d9-303f-912e-5c6f0324e126",
                        "glosses": [
                            "To act as a substitute for a person in their role or office"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d5758ce9-b8e0-4faf-9696-1c419fc74288",
                                "sense_id": "c37088af-371e-34a9-9674-f99ab36c1183",
                                "text": "Gringoire, on the other hand, stuck with equal firmness to the fact that he was deputizing for a brother officer who was sick — so sick that he had mislaid his orders."
                            },
                            {
                                "example_id": "e96a5d59-d1a9-4cfa-9d3d-a6733d85119d",
                                "sense_id": "c37088af-371e-34a9-9674-f99ab36c1183",
                                "text": "What he wanted was someone who could really deputize for him when he was away on business – clearly not the job for a secretary but, because of years of experience and a willingness to take responsibility, one that the previous holder of the post had taken on."
                            },
                            {
                                "example_id": "c6fbaa7b-06a3-47bd-bfca-865f48de12aa",
                                "sense_id": "c37088af-371e-34a9-9674-f99ab36c1183",
                                "text": "It is commonly used in the theatre where an understudy essentially deputizes for an indisposed actor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1173e3b-595f-4993-9a7a-8cc1e82bb3ec",
                        "source_entry_id": "566e35dc-c5d9-303f-912e-5c6f0324e126",
                        "source_sense_description": "to make (someone) a deputy",
