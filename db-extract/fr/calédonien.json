                "senses": [
                    {
                        "sense_id": "9b425d60-3fb1-3805-8d49-647a133e14c3",
                        "entry_id": "239e92ae-7946-3e07-a7a1-315af745f50b",
                        "glosses": [
                            "Relatif à la Calédonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c5b4931-02e9-4699-94fc-c42b770ecdc5",
                                "sense_id": "9b425d60-3fb1-3805-8d49-647a133e14c3",
                                "text": "Le mur d’Hadrien est construit à partir de 122 par les Romains sur toute la largeur de l’Angleterre pour protéger le Sud de l’île des attaques des tribus calédoniennes."
                            },
                            {
                                "example_id": "3be817ce-e51c-4ce1-89f9-55635310e080",
                                "sense_id": "9b425d60-3fb1-3805-8d49-647a133e14c3",
                                "text": "(Panoramix) Comme nous, nos cousins calédoniens sont de farouches guerriers qui résistent depuis toujours à l’envahisseur romain […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "5118bd30-8899-3b46-a225-cb41d1f2c7c2",
                        "entry_id": "239e92ae-7946-3e07-a7a1-315af745f50b",
                        "glosses": [
                            "Relatif à la Nouvelle-Calédonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a421ac8-3041-4e24-bfa4-f94585490386",
                                "sense_id": "5118bd30-8899-3b46-a225-cb41d1f2c7c2",
                                "text": "L’Union calédonienne est un parti politique de Nouvelle-Calédonie qui milite pour l’indépendance de ce territoire."
                            }
                        ]
                    }
                ],
