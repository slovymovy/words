                                        "entry_id": "5313bae5-a9e7-3774-a682-4ef769b59dba",
                                        "glosses": [
                                            "Distinctive, characteristic, signature."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af6b56f4-9872-4277-9b95-2af56c05694a",
                                                "sense_id": "c5e7dcef-54be-3338-b88e-f0142da85388",
                                                "text": "Sutho took a pull at his Johnny Walker and Coke and laughed that trademark laugh of his and said: `Okay. I'll pay that all right.'"
                                            },
                                            {
                                                "example_id": "4b3bb8cd-6a86-4723-a012-4473966da2db",
                                                "sense_id": "c5e7dcef-54be-3338-b88e-f0142da85388",
                                                "text": "Riise did crash a fantastic, trademark free-kick against the bar from 25 yards but it was the Potters who increasingly posed the greater threat."
                                            },
                                            {
                                                "example_id": "297f50e0-6ac0-4505-92cd-58010821c8a3",
                                                "sense_id": "c5e7dcef-54be-3338-b88e-f0142da85388",
                                                "text": "The world’s most powerful man entered with an air of unhurried bonhomie. Dressed in his trademark navy suit and red tie, Trump, 78, appeared a little older than he had some seven months earlier, when he last met with TIME—more subdued, less verbose, the same discursive speech patterns but with the volume turned down."
                                            }
                                        ]
                                    }
