                        "sense_id": "bfc4aeb7-7b2c-3a70-813d-447ac6b079e3",
                        "entry_id": "b599a088-b43a-3db3-9209-90fe03cdbfdc",
                        "glosses": [
                            "A personification of the German people."
                        ],
                        "tags": [
                            "UK",
                            "US",
                            "dated",
