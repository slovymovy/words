                        "zh": [
                            {
                                "target_lang_word": "缺少的",
                                "target_lang_sense_clarification": "指构成整体的一部分缺失"
                            },
                            {
                                "target_lang_word": "不在的",
                                "target_lang_sense_clarification": "指人或物未出席或未在场"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bde1d31-6f72-3c47-87ee-8ded5144e28a",
                    "sense_definition": "Of an engine, running roughly due to irregular firing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old truck's engine started <w>missing</w> as we climbed the hill.",
                            "target_lang_translations": {
                                "ru": "Двигатель старого грузовика начал <w>давать перебои</w>, когда мы поднимались на холм.",
                                "de": "Der Motor des alten Lastwagens fing an zu <w>stottern</w>, als wir den Hügel hinauffuhren.",
                                "zh": "当我们爬坡时，那辆旧卡车的发动机开始<w>缺火</w>。"
                            }
                        },
                        {
                            "text": "You can hear the motor <w>missing</w> when it idles.",
                            "target_lang_translations": {
                                "ru": "Слышно, как мотор <w>работает с перебоями</w> на холостом ходу.",
                                "de": "Man kann hören, wie der Motor im Leerlauf <w>Zündaussetzer hat</w>.",
                                "zh": "怠速时能听到发动机<w>运转不稳</w>的声音。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О двигателе: работающий с перебоями из-за нерегулярного воспламенения.",
                        "de": "Bei einem Motor: unrunder Lauf aufgrund von Zündaussetzern.",
                        "zh": "指发动机因点火不正常而运转不平稳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "работающий с перебоями",
                                "target_lang_sense_clarification": "о механизме"
                            },
                            {
                                "target_lang_word": "троящий",
                                "target_lang_sense_clarification": "проф. сленг о двигателе"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "mit Zündaussetzern",
                                "target_lang_sense_clarification": "technische Beschreibung"
                            },
                            {
