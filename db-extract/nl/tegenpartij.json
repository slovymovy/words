                "senses": [
                    {
                        "sense_id": "e9738d2b-242d-3923-b65e-8cf96b17c27f",
                        "entry_id": "3606de5b-4c6b-3024-bf84-89cff3dccf5c",
                        "glosses": [
                            "de andere partij die de tegenstander is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab16dd8e-d7a4-4b92-9e67-42739d008ce6",
                                "sense_id": "e9738d2b-242d-3923-b65e-8cf96b17c27f",
                                "text": "Hij zou zijn eerste hoorzitting gaan voeren, met de eis te winnen, ongeacht welke advocaat de tegenpartij had gemobiliseerd. Op dat punt was Henning heel duidelijk geweest, er was geen ruimte voor gepruts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "110345c6-937a-4407-8e5a-f5b47872ab4c",
                        "source_entry_id": "3606de5b-4c6b-3024-bf84-89cff3dccf5c",
                        "source_sense_id": "e9738d2b-242d-3923-b65e-8cf96b17c27f",
                        "source_sense_description": "de andere partij",
                        "target_lang_word": "Gegenpartei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenpartei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd326313-7f73-3638-89c2-c67f45aa8519",
                                        "entry_id": "b9ca072c-307e-3494-ba62-1b392a3f861e",
                                        "glosses": [
                                            "diejenige Gruppierung/Partei, gegen die man antritt"
                                        ],
                                        "tags": [
                                            "Jurisdiktion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4f3c7c5-032b-4628-9958-a87f04668f43",
                                                "sense_id": "bd326313-7f73-3638-89c2-c67f45aa8519",
                                                "text": "„Für einen gewonnenen Robber gibt es Prämien: 500 Punkte, wenn die Gegenpartei auch schon eine Partie gewonnen hat; 700 Punkte, wenn die Gegenpartei noch keine Partie gewonnen hatte (quick robber).“"
                                            },
                                            {
                                                "example_id": "976a5672-a6d6-4c8f-8c36-f485bf5a5773",
                                                "sense_id": "bd326313-7f73-3638-89c2-c67f45aa8519",
                                                "text": "Die Gegenpartei hat einen neuen Antrag gestellt. Diesmal einen Befangenheitsantrag."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "676b2ef7-25bd-3e60-ac56-0cac47d51412",
                                        "entry_id": "b9ca072c-307e-3494-ba62-1b392a3f861e",
                                        "glosses": [
                                            "Auffassung/Position, die eine Gruppe mit anderer Auffassung vertritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40da531f-e4b2-43f3-8742-f20d2b7e0aff",
                                                "sense_id": "676b2ef7-25bd-3e60-ac56-0cac47d51412",
                                                "text": "„Aber das Schweigen war als Macht sehr aktiv in den fünf Jahren; wer nicht klar Partei ergriff, hatte die Gegenpartei ergriffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0099e97-ff5c-44ba-a0fb-79aeb4a494a6",
                        "source_entry_id": "3606de5b-4c6b-3024-bf84-89cff3dccf5c",
