                            {
                                "example_id": "7224dbf3-60fe-4a44-9bc0-494d7947132b",
                                "sense_id": "53bbaf56-47f1-36d0-b3b6-1a00a4b2d47f",
                                "text": "„Dann nahmen wir ein Sutton Place Townhome mit unbekanntem Ziel und landeten schließlich in Billings, Montana.“"
                            },
                            {
                                "example_id": "57c077b5-73f8-40bc-b17b-c722f95613aa",
                                "sense_id": "53bbaf56-47f1-36d0-b3b6-1a00a4b2d47f",
                                "text": "„Als die Streifenbeamten drinnen waren, hatte er ihnen erzählt, er gehöre dem LAPD an un der Übeltäter sei ein Kiffer, den er nach San Quentin gebracht habe - David Haskins, und in Wahrheit vor Kurzem an einer Überdosis in Billings, Montana, verstorben.“"
                            }
                        ],
