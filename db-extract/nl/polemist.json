                    {
                        "sense_id": "c9ebd8a7-ea94-32e9-b383-5abe0e7eee4b",
                        "entry_id": "1395c7c9-7fc0-3a48-ab73-01ab3b5ddaae",
                        "glosses": [
                            "iemand die graag strijd voert in de media"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe1b3254-4522-422b-a74b-af3224b97889",
                                "sense_id": "c9ebd8a7-ea94-32e9-b383-5abe0e7eee4b",
                                "text": "Vlijmscherp polemist Komrij, geboren in Winterswijk in 1944, maakte naam als dichter en schrijver, bloemlezer, vertaler en criticus."
                            },
                            {
                                "example_id": "b047f759-f698-4085-a89a-d6695ab51579",
                                "sense_id": "c9ebd8a7-ea94-32e9-b383-5abe0e7eee4b",
                                "text": "Reve was een enthousiast polemist en liet zich zo nu en dan fel uit over vakgenoten. In dit fragment, afkomstig uit correspondentie met luchtmachtpredikant C.B. Dekker, moest schrijver Theun de Vries het ontgelden, die Reves vader had beticht van collaboreren in de oorlog."
                            }
                        ]
                    }
