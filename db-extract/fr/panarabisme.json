        "fr-extract.jsonl": [
            {
                "entry_id": "72b8d4b1-2f42-3dba-b1a2-b7592d9be7fe",
                "word": "panarabisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dcb7db06-c7bd-4987-862b-7706f864f529",
                        "entry_id": "72b8d4b1-2f42-3dba-b1a2-b7592d9be7fe",
                        "tags": [
                            "plural"
                        ],
                        "form": "panarabismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "31b0329f-e9f9-36ef-8fa5-bb48559c664a",
                        "entry_id": "72b8d4b1-2f42-3dba-b1a2-b7592d9be7fe",
                        "glosses": [
                            "Mouvement politique et idéologique fortement séculier qui vise à réunifier tous les peuples arabes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19f256c4-be7b-476e-94fe-395b41c1c6b0",
                                "sense_id": "31b0329f-e9f9-36ef-8fa5-bb48559c664a",
                                "text": "Les Lions de l’Atlas se retrouvent leadeurs d’un panarabisme que les critiques envers le Qatar ont exacerbé."
                            },
                            {
                                "example_id": "83d5c03f-c7f1-4b67-98bc-eba2193d983e",
                                "sense_id": "31b0329f-e9f9-36ef-8fa5-bb48559c664a",
                                "text": "S’il a été incarné avec le talent que l'on sait par Abdel Gamal Nasser, le panarabisme est né bien avant lui : ses prémices sont à rechercher dans les courants modernistes des dernières décennies de l’Empire ottoman puis, après la guerre, dans le jeune État irakien de Fayçal, et en Égypte à partir des années 30."
                            },
                            {
                                "example_id": "ed61ebd4-74be-4120-90c6-e16ebd470365",
                                "sense_id": "31b0329f-e9f9-36ef-8fa5-bb48559c664a",
                                "text": "[Au sujet de l’Égypte de Nasser] …par ailleurs l’idéologie nassérienne est cristallisée par la question palestinienne et la création de l’État israélien. Le panarabisme devient l’idéologie de l’État."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72845102-e4ce-49e8-91e5-d405c28a2250",
                        "source_entry_id": "72b8d4b1-2f42-3dba-b1a2-b7592d9be7fe",
                        "source_sense_id": "31b0329f-e9f9-36ef-8fa5-bb48559c664a",
                        "target_lang_word": "Panarabismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Panarabismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f322ecf-338b-3376-b0d9-1023e7c45470",
                                        "entry_id": "6d67f3f0-7dbc-3045-b732-07125546ef20",
                                        "glosses": [
                                            "politische Bewegung und Einstellung zur Vereinigung aller arabischen Völker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48d06a36-4c3b-4e92-a233-2ccac1ad9f38",
                                                "sense_id": "1f322ecf-338b-3376-b0d9-1023e7c45470",
                                                "text": "„Die Strahlkraft des ägyptischen Panarabismus unter Gamal Abd al-Nasser und die Sympathie vieler Araberinnen und Araber für den Sozialismus stellten die Legitimität der Golfmonarchien zunehmend infrage.“"
                                            },
                                            {
                                                "example_id": "6f2ae256-a740-48a1-8eef-314c46ca6385",
                                                "sense_id": "1f322ecf-338b-3376-b0d9-1023e7c45470",
                                                "text": "„So etwas war neu und beflügelte den Panarabismus auch in der Region von Aden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
