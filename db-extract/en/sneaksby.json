                        "glosses": [
                            "A paltry person; a sneak."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "67a78b61-39b4-4c2d-a32a-b2a037280e5e",
                                "sense_id": "b65d82b8-2a8c-3514-a5b9-1980fab46e3b",
                                "text": "16??, Isaac Barrow\n[…] such a superstitious fop, such a conscientious simpleton, such a bashful sneaksby […]"
                            },
                            {
                                "example_id": "a9fe14a9-db6a-433c-8ce7-0837c385bd07",
                                "sense_id": "b65d82b8-2a8c-3514-a5b9-1980fab46e3b",
                                "text": "I drink when I have occasion, and sometimes when I have no occasion: I am no proud man, d'ye see, and when the liquor is offered me I whip it off, that they may not take me for a churl or a sneaksby, or think I don't understand myself nor good manners[…]"
                            },
                            {
                                "example_id": "e7cc3eb9-fae8-45a9-a9e6-2ee04a7efbfd",
                                "sense_id": "b65d82b8-2a8c-3514-a5b9-1980fab46e3b",
                                "text": "\"You are such a sneaksby, Lacey. You know how irritating Mama finds him, and yet you write to him secretly. Mama will not be pleased with you.\""
                            }
                        ]
                    }
                ],
