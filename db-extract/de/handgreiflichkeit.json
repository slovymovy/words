                "senses": [
                    {
                        "sense_id": "4dcd5708-95d1-3a9a-ab36-3c8c088ebf5e",
                        "entry_id": "b551fe34-ac64-3d92-823a-a60425f2b8f2",
                        "glosses": [
                            "körperliche/tätliche Auseinandersetzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9f013b9-4c4a-4aae-9b89-c4ccd1268a11",
                                "sense_id": "4dcd5708-95d1-3a9a-ab36-3c8c088ebf5e",
                                "text": "Während der Demonstration kam es zu Handgreiflichkeiten mit der Polizei."
                            },
                            {
                                "example_id": "6affdb97-9014-4d91-b7c7-7160d74023ff",
                                "sense_id": "4dcd5708-95d1-3a9a-ab36-3c8c088ebf5e",
                                "text": "„Nach mehreren heftigen Streitigkeiten und Wortgefechten kam es dann schließlich zu Handgreiflichkeiten.“"
                            },
                            {
                                "example_id": "c41818e4-4ba1-4efb-b9be-be007bda0e65",
                                "sense_id": "4dcd5708-95d1-3a9a-ab36-3c8c088ebf5e",
                                "text": "„Manchmal kam es zu Handgreiflichkeiten zwischen Kriegsbefürwortern und Friedensanhängern.“"
                            },
                            {
                                "example_id": "3bb25d74-bab0-4922-b36b-9e8642bf2b51",
                                "sense_id": "4dcd5708-95d1-3a9a-ab36-3c8c088ebf5e",
                                "text": "„Doch als sie nach unserem Wortwechsel ging, war ich recht froh, daß es nicht zu Handgreiflichkeiten gekommen war, denn sie hätte den Sieg davongetragen, obgleich es finster war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
