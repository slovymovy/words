                ],
                "senses": [
                    {
                        "sense_id": "fd1e9718-25a9-337c-8b5e-a37ec6b57507",
                        "entry_id": "44270226-a161-30f5-a93c-b8f9f118f4a4",
                        "glosses": [
                            "Contraire, opposé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5609d83-e6bb-42ee-86a1-6e68d5da5763",
                                "sense_id": "fd1e9718-25a9-337c-8b5e-a37ec6b57507",
                                "text": "Mais un jour qu’il pleuvait à verse\nEt qu’il courait vers le métro\nButant contre un coureur adverse\nIl s’abattit comme un perdreau"
                            },
                            {
                                "example_id": "e6741764-0fd7-4d6b-a325-7be4098090c4",
                                "sense_id": "fd1e9718-25a9-337c-8b5e-a37ec6b57507",
                                "text": "Le modèle développé précédemment est une variante du premier modèle de sélection adverse proposé par George Akerlof."
                            },
                            {
                                "example_id": "b76bcc5e-cc81-4c20-abff-bd2996942a88",
                                "sense_id": "fd1e9718-25a9-337c-8b5e-a37ec6b57507",
                                "text": "Dans le camp adverse, les Munichois chassent très haut les Bianconeri, quasiment en marquage individuel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
