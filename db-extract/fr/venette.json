            {
                "entry_id": "c5864488-8285-376f-a159-3f188ea95582",
                "word": "venette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6ce32241-1e4b-35bd-8662-ca75c8199929",
                        "entry_id": "c5864488-8285-376f-a159-3f188ea95582",
                        "glosses": [
                            "Peur, inquiétude, alarme."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ec8538a5-2076-4b9f-bc35-6a6b6551202c",
                                "sense_id": "6ce32241-1e4b-35bd-8662-ca75c8199929",
                                "text": "Mais, not’maître, votre figure si pâle de la venette que vous venez d’avoir, mais votre belle calèche anglaise couverte de boue, ça va sembler drôle, on jasera ; ce ne sera pourtant pas moi qui aurai parlé."
                            },
                            {
                                "example_id": "6e470e63-3c3c-4394-b92a-8b890dae0a76",
                                "sense_id": "6ce32241-1e4b-35bd-8662-ca75c8199929",
                                "text": "Ah ! notre cher Théodose m’a donné une fière venette !"
                            },
                            {
                                "example_id": "8f46311c-cb92-4526-a704-423524b57cd3",
                                "sense_id": "6ce32241-1e4b-35bd-8662-ca75c8199929",
                                "text": "Mais à la vue du bonhomme, Grippeminaud, pris de venette, saute à l’escabelle, puis à la huche, puis à la corniche, puis à l’écoinçon, puis à la huitaine, puis au lit."
                            },
                            {
                                "example_id": "da1d0fce-8448-4093-aac3-1dd49156c4f4",
                                "sense_id": "6ce32241-1e4b-35bd-8662-ca75c8199929",
                                "text": "Eh ben ! eh ben ! bredouillait le bonhomme, saisi d’une venette rétrospective, i’ n’aurait pus manqué que ça !"
                            }
                        ]
                    }
                ],
