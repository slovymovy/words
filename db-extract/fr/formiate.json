                "senses": [
                    {
                        "sense_id": "89fe7e94-651b-3241-9536-98a5556cf482",
                        "entry_id": "863b6d38-0530-3f3d-b0c1-80ecd0ef4089",
                        "glosses": [
                            "Sel ou ester produit par la combinaison de l'acide formique avec une base, un alcool ou un phénol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecebcff7-6e3c-47be-a12a-e38af139e454",
                                "sense_id": "89fe7e94-651b-3241-9536-98a5556cf482",
                                "text": "Son essence à l’odeur douce et pénétrante rappelant celle de la rose, est riche en géraniol, en acétate et formiate de géranyle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "664dff4d-3513-4e64-a0a9-3884edfc8a6b",
                        "source_entry_id": "863b6d38-0530-3f3d-b0c1-80ecd0ef4089",
                        "source_sense_id": "89fe7e94-651b-3241-9536-98a5556cf482",
                        "target_lang_word": "formate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94617a50-96ac-3f37-8be0-b41ee4317d23",
                                        "entry_id": "de3df7ba-45c1-3116-9d61-e0941704cbda",
                                        "glosses": [
                                            "Any salt or ester of formic acid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65fb12b7-b723-4139-8ba8-b8b0cfe5f093",
                                                "sense_id": "94617a50-96ac-3f37-8be0-b41ee4317d23",
                                                "text": "But most likely my judgement was distorted by my contempt for his acting the young buck [...] for ever waxing his moustaches and loading himself with medicaments supposed to replace the failing sap of youth, glycerophosphates, formates, nux vomica, yohimba, damiana."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "formate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e0ef880-27c2-3ef5-aa1e-1a8ac9dac2f0",
                                        "entry_id": "6fa1aba2-ff2a-3435-bc50-9962fb370cd6",
                                        "glosses": [
                                            "To assemble flying aircraft into formation; to fly in formation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "144d6456-9497-4bf1-8ced-15bb85496007",
                                                "sense_id": "0e0ef880-27c2-3ef5-aa1e-1a8ac9dac2f0",
                                                "text": "Tiger Moths from the Reserve Flying Schools at Rochester and Cambridge competed with each other at formating in the gusty conditions, Rochester just winning."
                                            },
                                            {
                                                "example_id": "b46a3889-ada2-41bd-9ad7-3edc3ec8aa97",
                                                "sense_id": "0e0ef880-27c2-3ef5-aa1e-1a8ac9dac2f0",
                                                "text": "Formating with Patty Wagstaff' s modified Baron, flown by Dale Snodgrass, was fun on a beautiful morning, though all you learn about an airplane while formating is the power response (very smooth) and the response to control pressures."
                                            },
                                            {
                                                "example_id": "7d7eb36d-2b31-4efb-8690-f7e6fa178e76",
                                                "sense_id": "0e0ef880-27c2-3ef5-aa1e-1a8ac9dac2f0",
                                                "text": "Actually, the leader of the formation was supposed to maintain the eagle-eyed vigil necessary to ensure that his formation kept out of harm's way, because the pilots formating on him had to keep all their attention riveted on his aircraft; but the Air Force recognized that with inexperienced pilots leading formations it was wise to splash extra lookouts around liberally."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
