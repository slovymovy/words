                                                "text": "She lags us if we poach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5e58c29-b9b2-3992-bc8b-074ecce59d7a",
                                        "entry_id": "09d3dd37-75d9-3d8a-bf7f-caa503ec74cb",
                                        "glosses": [
                                            "To arrest or apprehend."
                                        ],
                                        "tags": [
