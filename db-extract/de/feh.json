                                                "sense_id": "4e8bc980-7806-3087-acbd-ef3a9a6a879c",
                                                "text": "Bran wore grey breeches and white doublet, his sleeves and collar trimmed with vair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6bd3673-2edb-3a14-9192-2118220c355d",
                                        "entry_id": "637c2574-6ab8-36ef-8e18-a0e4ca92aa65",
                                        "glosses": [
                                            "An heraldic fur formed by a regular tessellation of bell shapes in two colours, (for example in the image, blue and white)."
                                        ],
