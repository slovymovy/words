                "senses": [
                    {
                        "sense_id": "b9aa4310-1e01-3baa-8040-c44938b6faa2",
                        "entry_id": "9bfbec87-e0de-3f9b-a8bf-c33ad9ce8360",
                        "glosses": [
                            "приятно на вкус"
                        ],
                        "tags": [],
