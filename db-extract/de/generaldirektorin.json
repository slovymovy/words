                "senses": [
                    {
                        "sense_id": "a2fba1ce-f2e7-31de-9ed0-056a17489993",
                        "entry_id": "29dcc97d-749d-3657-8c23-f263ca3d9d3f",
                        "glosses": [
                            "weibliche Person, die ein größeres Unternehmen oder Institution leitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9d5d406-dae0-4f19-8ff5-5d337e612c9e",
                                "sense_id": "a2fba1ce-f2e7-31de-9ed0-056a17489993",
                                "text": "„Hinter ihrem Schreibtisch wusste die Generaldirektorin der WHO nicht so recht, ob sie sich über die Neuigkeiten freuen sollte, die Stephen ihr gerade überbrachte, umso mehr, da Letzterer eine undurchsichtige Miene aufgesetzt hatte.“"
                            },
                            {
                                "example_id": "4e71200c-d00c-46c5-8f7b-8f17da3ddb05",
                                "sense_id": "a2fba1ce-f2e7-31de-9ed0-056a17489993",
                                "text": "„Es muss Ende 1985 oder Anfang 1986 gewesen sein, als ich überraschend zur Generaldirektorin gerufen wurde.“"
                            },
                            {
                                "example_id": "e816aadf-049b-4ea6-b0b7-c2ef5ae725df",
                                "sense_id": "a2fba1ce-f2e7-31de-9ed0-056a17489993",
                                "text": "„Nicoletta öffnete bereits ihren Mund, um mit einer scharfen Entgegnung zu antworten, die neue Generaldirektorin des CERN kam ihr jedoch zuvor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
