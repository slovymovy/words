                        ],
                        "form": "sintered"
                    },
                    {
                        "form_id": "f7b8da7c-ce41-478d-9f65-4ef41fa0a145",
                        "entry_id": "9e8c4ac7-eb86-3659-bf55-02c04b8621cc",
                        "tags": [
                            "past"
                        ],
                        "form": "sintered"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ebc51147-3512-3858-803f-39a1319038f5",
                        "entry_id": "9e8c4ac7-eb86-3659-bf55-02c04b8621cc",
                        "glosses": [
                            "To heat a compacted powder mass to form a hardened mass."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6a4f827-35df-4bc0-8b73-59b5a3666bcd",
                                "sense_id": "ebc51147-3512-3858-803f-39a1319038f5",
                                "text": "Most, if not all, metals may be sintered."
                            },
                            {
                                "example_id": "b4c3fe5e-9d4b-4c51-9fe4-ca3638672075",
                                "sense_id": "ebc51147-3512-3858-803f-39a1319038f5",
                                "text": "A properly made, fully sintered and fully annealed metal clay piece should be able to stand up to any traditional metalsmithing technique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a91bad3-347d-4ac0-8e94-371fabf5b946",
                        "source_entry_id": "9e8c4ac7-eb86-3659-bf55-02c04b8621cc",
                        "source_sense_id": "ebc51147-3512-3858-803f-39a1319038f5",
                        "source_sense_description": "to compact and heat a powder to form a solid mass",
                        "target_lang_word": "sintern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sintern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7b48a18-00f4-36f6-b60d-1115b00ef72e",
                                        "entry_id": "29cc62f3-467f-3eeb-8018-0d13b076bfef",
                                        "glosses": [
                                            "körnige Materialien durch Anwendung von Druck und Hitze unterhalb des Schmelzpunktes verdichten und verfestigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3efb4c7-88e1-4cd6-b326-3bebcaec898a",
                                                "sense_id": "d7b48a18-00f4-36f6-b60d-1115b00ef72e",
                                                "text": "Im allgemeinen wird bei Temperaturen von etwa ⅔ bis ¾ der Schmelztemperaturen (in °K) der Metalle mit Sinterzeiten von einer bis mehreren Stunden gesintert."
                                            },
                                            {
                                                "example_id": "3a5defe2-28ed-470a-ab24-e6cee9f761ec",
                                                "sense_id": "d7b48a18-00f4-36f6-b60d-1115b00ef72e",
                                                "text": "Wenn das Teil aufgebaut ist, wird es gesintert, das heißt im Ofen gebacken."
                                            },
                                            {
                                                "example_id": "df2d4e6d-03d1-494d-945c-b56a85068998",
                                                "sense_id": "d7b48a18-00f4-36f6-b60d-1115b00ef72e",
                                                "text": "Vor der weiteren Verarbeitung wird das Erz schließlich zerkleinert und gemahlen. Danach werden die Erzkörner nach ihrer Größe sortiert und gesintert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "778c8598-5e60-335b-bc70-892c92d31b1e",
                                        "entry_id": "29cc62f3-467f-3eeb-8018-0d13b076bfef",
                                        "glosses": [
                                            "unter Einwirkung von Druck und Hitze Sinter bilden"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90b2e888-e79d-4578-bbc7-b4cdba6e54f7",
                                                "sense_id": "778c8598-5e60-335b-bc70-892c92d31b1e",
                                                "text": "Zinkoxyd sintert bei 1000°C in wenigen Stunden zu einer relativ dichten Masse."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
