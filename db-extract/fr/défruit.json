                        ],
                        "examples": [
                            {
                                "example_id": "212fc93e-2db2-44fa-be37-2d876fa95760",
                                "sense_id": "a9a7652b-1330-3f1c-b96c-2b5590739ca9",
                                "text": "Les Curés & Vicaires des lieux où la bannalité de four est établie en Coutume de Saint-Mihiel, peuvent avoir un four en leur maison pour leur défruit seulement."
                            },
                            {
                                "example_id": "6812349c-e3ab-480a-a894-8542e805278d",
                                "sense_id": "a9a7652b-1330-3f1c-b96c-2b5590739ca9",
                                "text": "Ainsi que les autres fruits sujets à la grosse dixme, & levée par les Pauliers à l'ordinaire ; à la réserve néanmoins des Pommes de terre que lesdits Habitans employent pour le défruit de leurs ménages pendant le cours de l'année."
                            },
                            {
                                "example_id": "1071f557-5eeb-4964-9698-740beab9b4c9",
                                "sense_id": "a9a7652b-1330-3f1c-b96c-2b5590739ca9",
                                "text": "Le Duc Léopold , par Arrêt de son Conseil , du 6 Septembre 1724, les maintint dans ce droit contre les Chartreux de Bosserville , mais seulement pour le défruit de leur maison, et non pour en commercer."
                            }
                        ]
                    }
