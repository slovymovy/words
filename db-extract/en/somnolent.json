                                                "sense_id": "3d687ff4-c0e3-3555-b48c-376be4bd8177",
                                                "text": "Ihre Stimme klang schläfrig."
                                            },
                                            {
                                                "example_id": "96d4a527-0618-4106-95ed-dcb9574cdaa7",
