                ],
                "senses": [
                    {
                        "sense_id": "ab937912-9983-3a3e-8aa5-ac463073ab80",
                        "entry_id": "1fda2d3a-8df4-3f24-bc9b-d07e80c0a543",
                        "glosses": [
                            "Réactionnaire, qui est attaché à des valeurs traditionnelles que certains considèrent comme dépassées."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b288dba3-2ae7-4747-bb03-cf480231d402",
                                "sense_id": "ab937912-9983-3a3e-8aa5-ac463073ab80",
                                "text": "Écoute ce mec qui vote réac,\nÉcoute cette mère seule qui craque,\n Écoute le cri des animaux quand on les enfouis dans un sac."
                            },
                            {
                                "example_id": "6cdcb878-57d5-49a1-b6f4-bb9c6a5ec742",
                                "sense_id": "ab937912-9983-3a3e-8aa5-ac463073ab80",
                                "text": "Pour des raisons plus de cynisme que de conviction, certains chroniqueurs plutôt réacs étaient plutôt favorables au mouvement à ses débuts."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "88f674f5-9086-3a85-a67b-e21d46e62c65",
                "word": "réac",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c1c59a9e-d74d-4e2f-8d64-85905eb69766",
                        "entry_id": "88f674f5-9086-3a85-a67b-e21d46e62c65",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "réacs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8744e701-d247-3f81-b05e-1a239ec2dd91",
                        "entry_id": "88f674f5-9086-3a85-a67b-e21d46e62c65",
                        "glosses": [
                            "Réactionnaire, qui est attaché à des valeurs traditionnelles que certains considèrent comme dépassées."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "188ff1ed-560c-4295-80a5-829b2915fa71",
                                "sense_id": "8744e701-d247-3f81-b05e-1a239ec2dd91",
                                "text": "Nous ferons mettre ces pauvres poulettes en liberté, dit Pornin ; sous la République, les prisons ne doivent servir que pour les réacs."
                            },
                            {
                                "example_id": "95506622-0d9d-4195-917a-93034a4c428b",
                                "sense_id": "8744e701-d247-3f81-b05e-1a239ec2dd91",
                                "text": "Serait-ce du « machisme » ? Du « sexisme » ? Je ne crois pas, mais peu me chaut : en bon réac je prouve l’altérité des genres par mon absolue soumission."
                            },
                            {
                                "example_id": "a0f11dbb-b842-4d09-83be-5159e0031a71",
                                "sense_id": "8744e701-d247-3f81-b05e-1a239ec2dd91",
                                "text": "Privée de ses réacs, elle est devenue une antichambre du libéralisme."
                            },
                            {
                                "example_id": "5489b786-31c1-423f-8b41-8b7e9bc0b41f",
                                "sense_id": "8744e701-d247-3f81-b05e-1a239ec2dd91",
                                "text": "Le livre débute à la mi-1929, quand le président Hindenburg, vieux réac agacé par le pouvoir des sociaux-démocrates au Reichstag, réfléchit à la mise à l’écart du Parlement."
                            }
                        ]
                    }
