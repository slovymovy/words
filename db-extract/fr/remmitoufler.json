                "senses": [
                    {
                        "sense_id": "ed82d5c2-85d3-39bf-9f41-cfd00cf43337",
                        "entry_id": "c3334a00-07f9-31a9-a3cd-2ce9c027455f",
                        "glosses": [
                            "Emmitoufler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77688531-071a-4a0a-89ec-7ea95b3e55e3",
                                "sense_id": "ed82d5c2-85d3-39bf-9f41-cfd00cf43337",
                                "text": "La malheureuse rentre son bras, se remmitoufle et nous bouge plus après avoir lâché, tant elle a eu la frousse, un pet plus aigre que celui d’un putois."
                            },
                            {
                                "example_id": "6e0bf725-a870-44cb-9231-6416b71606a1",
                                "sense_id": "ed82d5c2-85d3-39bf-9f41-cfd00cf43337",
                                "text": "Il rigole légèrement à son trait d'humour et se remmitoufle dans sa cape et sa couverture."
                            }
                        ]
                    }
