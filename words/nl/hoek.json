                {
                    "sense_id": "a2dbcd04-a039-3896-a23a-867329e146d5",
                    "sense_definition": "een plaats waar twee muren of lijnen samenkomen, bijvoorbeeld in een kamer of op straat",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ruimte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kast staat in de <w>hoek</w> van de woonkamer.建设",
                            "target_lang_translations": {
                                "en": "The cupboard is in the <w>corner</w> of the living room.",
                                "ru": "Шкаф стоит в <w>углу</w> гостиной."
                            }
                        },
                        {
                            "text": "Hij wachtte op haar bij de <w>hoek</w> van de straat.",
                            "target_lang_translations": {
                                "en": "He waited for her at the <w>corner</w> of the street.",
                                "ru": "Он ждал её на <w>углу</w> улицы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "om de hoek",
                        "in de hoek"
                    ],
                    "target_lang_definitions": {
                        "en": "a place where two walls or lines meet, for example in a room or on a street",
                        "ru": "место, где сходятся две стены или линии, например, в комнате или на улице"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "corner",
