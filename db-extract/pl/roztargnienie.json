                    {
                        "translation_id": "a6b84474-f7c9-4498-a358-2960be5125bc",
                        "source_entry_id": "9cfdbe80-bd41-3aa7-8375-469faaab65d7",
                        "source_sense_id": "408909b4-9416-3df7-a0d5-867d2143fa04",
                        "target_lang_word": "verstrooidheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verstrooidheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "136730d4-6d4f-3602-8ffe-7ba6c990dffc",
                                        "entry_id": "1cc9aca8-a80b-31ce-972d-3d4217a86f9e",
                                        "glosses": [
                                            "toestand waarin men minder aandacht geeft aan wat men doet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d62cc503-7612-43e3-b018-576d8fcf7862",
                                                "sense_id": "136730d4-6d4f-3602-8ffe-7ba6c990dffc",
                                                "text": "Uit onderzoek blijkt dat de verzorger alleen aan het werk was in het gebouw en de veiligheidssluis van het verblijf uit verstrooidheid liet openstaan. De verzorger zal niet worden ontslagen, maar er volgen wel sancties, zo zegt woordvoerster Ilse Segers. Wat die sancties inhouden, wordt nog besproken."
                                            },
                                            {
                                                "example_id": "99ea4bbe-9f1a-4bef-964e-d8a8e232a794",
                                                "sense_id": "136730d4-6d4f-3602-8ffe-7ba6c990dffc",
                                                "text": "De vrouw doet geen oog meer dicht, schrijven de Belgische media RTL en La Meuse. Zoals altijd deed ze in januari de betalingen aan de leveranciers. Door verstrooidheid maakte Lambin een fout die door omstandigheden moeilijk recht te zetten valt."
                                            },
                                            {
                                                "example_id": "c2de9a6f-8299-4987-8e8c-2f02b057e327",
                                                "sense_id": "136730d4-6d4f-3602-8ffe-7ba6c990dffc",
                                                "text": "Een ontspannen familievakantie in het Amerikaanse Orlando kreeg een valse start voor een gezin uit de Britse plaats Poynton. En dat door een verstrooidheid van de grootvader, die op de officiële reisdocumenten van de familie per ongeluk invulde dat de drie maanden oude Harvey ‘terroristische motieven had om naar de VS te vliegen’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
