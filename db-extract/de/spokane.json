                "senses": [
                    {
                        "sense_id": "cacfd8a2-d999-3423-b9ee-886605b35ac1",
                        "entry_id": "172b350e-8b75-3adb-8c58-2c569f51826e",
                        "glosses": [
                            "Stadt im US-Bundesstaat Washington"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4800a1f-1b41-4eaf-9a8e-8f602d28566c",
                                "sense_id": "cacfd8a2-d999-3423-b9ee-886605b35ac1",
                                "text": "„Ich bin inkognito in Spokane, Washington, und labe mich in einem Shari’s Restaurant an Kuchen und Kaffee, als sie zur Tür hereinkommt und ohne Umschweife auf meinen Tisch zusteuert.“"
                            },
                            {
                                "example_id": "832e002e-41ee-463c-937d-a3f7e70b8ddb",
                                "sense_id": "cacfd8a2-d999-3423-b9ee-886605b35ac1",
                                "text": "„Am nächsten Abend in Spokane, das gleiche Programm.“"
                            },
                            {
                                "example_id": "f2d1fae5-102e-4eac-bb16-dbc5a0d15b50",
                                "sense_id": "cacfd8a2-d999-3423-b9ee-886605b35ac1",
                                "text": "„Die Police Departments von Spokane und Portland listeten Serien von ermordeten und vermissten Prostituierten auf, doch nirgendwo konnte ich eine Verbindung zu den Morden von Seattle herstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
