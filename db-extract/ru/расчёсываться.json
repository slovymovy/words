                        "cross_references": [
                            {
                                "target_word": "se gratter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7a74274-e97b-3a79-b9ba-619ef47469f7",
                                        "entry_id": "548b381d-8154-3331-bf57-69aedb63c1e2",
                                        "glosses": [
                                            "Forme pronominale de gratter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "050ab944-33d6-475f-a061-3aa08a3c9456",
                                                "sense_id": "b7a74274-e97b-3a79-b9ba-619ef47469f7",
                                                "text": "Dès qu’il voyait Milarepa, il ne pouvait s’empêcher de se gratter."
                                            },
                                            {
                                                "example_id": "37c04339-8b8a-4835-8f61-14855f1ffe08",
                                                "sense_id": "b7a74274-e97b-3a79-b9ba-619ef47469f7",
                                                "text": "Certaines s’en servaient pour se gratter le dos, certaines pour piler les fourmis vagabondes qui s’égaraient parfois dans leur verger secret."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eb14b6a-ad4a-322d-aa82-ca4936e14b2b",
                                        "entry_id": "548b381d-8154-3331-bf57-69aedb63c1e2",
                                        "glosses": [
                                            "Hésiter, se tâter."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "869970e5-575f-4547-a2d6-528e7a8aa738",
                                                "sense_id": "4eb14b6a-ad4a-322d-aa82-ca4936e14b2b",
                                                "text": "En temps ordinaire, elle se serait pas grattée pour le faire au moins remarquer. Mais, cette nuit, elle mettait en veilleuse."
                                            },
                                            {
                                                "example_id": "09a869e1-4da5-443a-abe1-5b7e5d06d0eb",
                                                "sense_id": "4eb14b6a-ad4a-322d-aa82-ca4936e14b2b",
                                                "text": "Là, il se gratte, le Johnny, ose ni croire, ni douter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
