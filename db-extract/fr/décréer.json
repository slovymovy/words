                "senses": [
                    {
                        "sense_id": "29972fa1-5c44-3705-aaf4-e921e4d77877",
                        "entry_id": "2018f91c-3fa2-38cb-9205-7b7693fa99aa",
                        "glosses": [
                            "Annuler la création de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9acc0cb1-51e4-4173-870b-69bd84bf1ad4",
                                "sense_id": "29972fa1-5c44-3705-aaf4-e921e4d77877",
                                "text": "Je vais maintenant décréer et détruire ma relation avec ma famille."
                            },
                            {
                                "example_id": "b8d146b1-41d9-4257-abae-9eab1f45c1f4",
                                "sense_id": "29972fa1-5c44-3705-aaf4-e921e4d77877",
                                "text": "Le poète dévoile Dieu : dévoiler Dieu, c’est décréer."
                            },
                            {
                                "example_id": "83f3eef2-ea2d-4050-b300-a0c634918cc2",
                                "sense_id": "29972fa1-5c44-3705-aaf4-e921e4d77877",
                                "text": "Décréer n’équivaut pas à détruire (le prochain cataclysme cosmique qui nous fera disparaître nous détruira, mais ne décréera pas l’homme), mais à soustraire l’être à l’être."
                            }
                        ]
                    }
