                ],
                "senses": [
                    {
                        "sense_id": "1893a33b-0369-3b67-ae2f-e5b5a584bd81",
                        "entry_id": "26680944-33c2-36f6-acaf-6ebc5a372c89",
                        "glosses": [
                            "der Kauf oder Verkauf von Polymeren"
                        ],
                        "tags": [
                            "nur Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "fda1f327-192f-41e5-8be6-95a2c4651195",
                                "sense_id": "1893a33b-0369-3b67-ae2f-e5b5a584bd81",
                                "text": "„Als moderner Kunststoffhandel tragen wir einen Teil dazu bei, dass Sie ökologischer und wirtschaftlicher arbeiten können, indem wir Kunststoffreste aufkaufen und wieder aufbereiten.“"
                            },
                            {
                                "example_id": "789b59e7-332c-4212-8837-6e7a6f056ea9",
                                "sense_id": "1893a33b-0369-3b67-ae2f-e5b5a584bd81",
                                "text": "„Seit über 20 Jahren sind wir aktiv im Kunststoffhandel und setzen uns ein für faire Preise, effektive Verhandlungen und kurze Kommunikationswege.“"
                            },
                            {
                                "example_id": "819b907c-c6d4-4348-ac6f-6091b71a410b",
                                "sense_id": "1893a33b-0369-3b67-ae2f-e5b5a584bd81",
                                "text": "„Der Pfälzische Kunststoffhandel bietet alles rund um den technischen Kunststoffbedarf: Acrylglas (Plexiglas),Well- und Stegplatten, ALU Terrassendächer komplett vorgefertigt, Glas ESG/VSG, Vordächer, Aluverbundplatten, PVC/PE/PA Platten, Kronoplan, Trespa, Trapezprofilbleche, Sandwichelemente, Fassadenschrauben, Zubehör, Zuschnittservice, auf Wunsch Lieferung und Montage!“"
                            },
                            {
                                "example_id": "2b42492e-b28a-428f-b923-36105812e8fa",
                                "sense_id": "1893a33b-0369-3b67-ae2f-e5b5a584bd81",
                                "text": "„Die SpoHntan GmbH ist ein junges und dynamisches Unternehmen für Kunststoffhandel, Kunststoffspritzguß , Kunststofflösungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
