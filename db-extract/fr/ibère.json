            {
                "entry_id": "5fc471f8-7158-33c4-9b11-06eeb774d52c",
                "word": "ibère",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dc0f4ee9-fbcb-3545-a21d-013e2143919d",
                        "entry_id": "5fc471f8-7158-33c4-9b11-06eeb774d52c",
                        "glosses": [
                            "Langue paléo-hispanique (langue morte) parlée autrefois par les Ibères sur toute la côte méditerranéenne péninsulaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67c093cc-6c3a-41d9-bdf3-889b96e71153",
                                "sense_id": "dc0f4ee9-fbcb-3545-a21d-013e2143919d",
                                "text": "Notre connaissance de l’ibère est encore très défectueuse."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "431d1df0-86f9-3772-a733-d4411ffa6741",
                "word": "Ibère",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9169a7ef-33ba-4a85-9cf7-9586395214ae",
                        "entry_id": "431d1df0-86f9-3772-a733-d4411ffa6741",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "Ibères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0632b3c5-893b-3c3d-ad40-4919cbfc0166",
                        "entry_id": "431d1df0-86f9-3772-a733-d4411ffa6741",
                        "glosses": [
                            "Habitant de l’une ou l’autre Ibérie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d838e78-49c9-4d0e-a28a-565306081800",
                                "sense_id": "0632b3c5-893b-3c3d-ad40-4919cbfc0166",
                                "text": "Les Ibères ou Ibériens, soit qu’on les considère comme autochtones, ou comme venus de l’Asie, sont incontestablement les premiers habitants de l’Espagne, dont ils occupaient la partie orientale, la première ouverte aux invasions maritimes ou terrestres."
                            },
                            {
                                "example_id": "5451a14c-9cab-4635-8611-eea16ed7e41f",
                                "sense_id": "0632b3c5-893b-3c3d-ad40-4919cbfc0166",
                                "text": "L’origine des Ibères remonte pour le moins au début du néolithique méditerranéen à la culture des agriculteurs-pêcheurs de la céramique impresso-cardiale qui s’est étendue de l’Adriatique à l’Occident."
                            }
                        ]
                    },
                    {
                        "sense_id": "97cf27e2-503d-30d9-8afb-9714681412e2",
                        "entry_id": "431d1df0-86f9-3772-a733-d4411ffa6741",
                        "glosses": [
                            "Espagnol ou Espagnole"
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f6b68b6f-6b99-44c7-9881-4e40f440d850",
                                "sense_id": "97cf27e2-503d-30d9-8afb-9714681412e2",
                                "text": "Mais la chance se provoque, et personne ne pourra dire que les Ibères n’ont pas mérité leur quatrième titre continental."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c833139c-9c13-4bc3-8277-54edf34418aa",
                        "source_entry_id": "431d1df0-86f9-3772-a733-d4411ffa6741",
                        "source_sense_description": "Habitant de l’Ibérie",
                        "target_lang_word": "Iberer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Iberer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "46e42e72-be88-3bf9-a18c-50c52ae2dc7b",
                                        "entry_id": "7ba6822c-e370-3fc5-a655-a6873d60e443",
                                        "glosses": [
                                            "Urbewohner der Pyrenäenhalbinsel vor Ankunft der Indogermanen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67411fd0-a941-4996-87a8-5f6724eb5d88",
                                                "sense_id": "46e42e72-be88-3bf9-a18c-50c52ae2dc7b",
                                                "text": "Die Söldner waren jetzt alle von erschreckender Magerkeit. Ihre Haut bedeckte sich mit bläulichen Flecken. Am Abend des neunten Tages starben drei Iberer."
                                            },
                                            {
                                                "example_id": "0f197db2-6b44-4a27-9402-d85150c40ed5",
                                                "sense_id": "46e42e72-be88-3bf9-a18c-50c52ae2dc7b",
                                                "text": "Hadrian suchte freundliche Beziehungen mit den Albanern und Iberern anzuknüpfen."
                                            },
                                            {
                                                "example_id": "a0d38a60-6446-47fc-b390-585d65338fe9",
                                                "sense_id": "46e42e72-be88-3bf9-a18c-50c52ae2dc7b",
                                                "text": "Dafür legen auch Zeugnis ab die Frauenheere der Aschantis und des Königs von Dahome in Westafrika, die sich durch Tapferkeit und Wildheit auszeichnen. Auch Tacitus' Urteil über die Frauen der alten Germanen und die Angaben Cäsars über die Frauen der Iberer und Schotten bestätigen dieses."
                                            },
                                            {
                                                "example_id": "90b1f73e-64bd-46b0-83cf-0abd15574a8d",
                                                "sense_id": "46e42e72-be88-3bf9-a18c-50c52ae2dc7b",
                                                "text": "Dass es sich tatsächlich um die Reste des biblischen Bethaniens handelt, schließen die Forscher auch aus frühen Chroniken und Reiseberichten wie denen von Petrus dem Iberer und der galizischen Nonne Aetheria."
                                            },
                                            {
                                                "example_id": "566dbcdd-513d-4354-8d89-0ba58887fc19",
                                                "sense_id": "46e42e72-be88-3bf9-a18c-50c52ae2dc7b",
                                                "text": "Ein Studienreisender darf nicht schlappmachen, schon gar nicht in einer Stadt, in der bereits die Iberer siedelten, die westgotischen Könige ihr Reich etablierten, die Mauren bis zum Ende des 11. Jahrhunderts residierten und in der selbst die rigiden spanischen Könige den Einfluß der Araber und Juden noch lange duldeten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
