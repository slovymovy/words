                "translations": [
                    {
                        "translation_id": "b57ee022-2b2d-411a-ab59-a7f67873aed6",
                        "source_entry_id": "6888c5be-77ff-349f-9c31-c47c32e72417",
                        "source_sense_id": "0f10fae7-08f0-3800-9abc-cf0f7a8374bc",
                        "source_sense_description": "the action of the verb to shout",
                        "target_lang_word": "Schreien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schreien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "458fb3c3-6f12-371c-acf8-7f62cec7b625",
                                        "entry_id": "5c12891d-6b69-30aa-a51b-fa2ef1c3c371",
                                        "glosses": [
                                            "Ausstoßen von Schreien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c96c20e8-4594-4984-a216-815e1a074f96",
                                                "sense_id": "458fb3c3-6f12-371c-acf8-7f62cec7b625",
                                                "text": "„Ihr Schreien benebelte die Scheibe mit Speichel; der Inhalt ihres Mundes besprühte das Glas nur Zentimeter von seinem schlummernden Kind entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schreien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d75c303-c278-390f-8b23-3d0f626748f5",
                                        "entry_id": "04ae35fd-d913-38de-bd61-b4d1c81e3996",
