                "senses": [
                    {
                        "sense_id": "6334a994-4fa3-3bda-947f-97b130d4107d",
                        "entry_id": "fb3f670e-e19e-3fcd-bbac-4072dfc06ad3",
                        "glosses": [
                            "Mettre en bourse ; recevoir de l'argent."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "40dca3b1-57b6-4c0b-bbdf-3f456b292a01",
                                "sense_id": "6334a994-4fa3-3bda-947f-97b130d4107d",
                                "text": "Nos héros de finance emboursent l’argent de la France"
                            },
                            {
                                "example_id": "ddfc4613-593b-4fa8-80a1-47f7b8ff6d2b",
                                "sense_id": "6334a994-4fa3-3bda-947f-97b130d4107d",
                                "text": "Cet homme a manié des millions, dit Norbert, et je ne conçois pas qu’il vienne ici embourser les épigrammes de mon père, souvent abominables."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9a9770c-abd3-3488-b29d-e04af20da1bd",
                        "entry_id": "fb3f670e-e19e-3fcd-bbac-4072dfc06ad3",
                        "glosses": [
                            "Recevoir (des coups de bâton)."
                        ],
                        "tags": [
                            "figuratively",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4034ee2f-0db9-4d68-8a4a-0b35793b0359",
                                "sense_id": "d9a9770c-abd3-3488-b29d-e04af20da1bd",
                                "text": "Et si dans la province Il se donnait en tout vingt coups de nerf de boeuf, Mon père pour sa part en emboursait dix-neuf"
                            }
                        ]
                    }
                ],
