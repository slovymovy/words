    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c672fa06-6d7e-3269-acd1-da2ae13ee774",
                    "sense_definition": "A long journey, especially by ship or through space.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "travel_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Titanic sank in the Atlantic Ocean during its maiden <w>voyage</w>.",
                            "target_lang_translations": {
                                "ru": "\"Титаник\" затонул в Атлантическом океане во время своего первого <w>плавания</w>.",
                                "tr": "Titanic, ilk <w>seferi</w> sırasında Atlas Okyanusu'nda battı."
                            }
                        },
                        {
                            "text": "They prepared provisions for a long sea <w>voyage</w> to the other side of the world.",
                            "target_lang_translations": {
                                "ru": "Они подготовили провизию для долгого морского <w>путешествия</w> на другой конец света.",
                                "tr": "Dünyanın öbür ucuna yapılacak uzun bir <w>deniz yolculuğu</w> için erzak hazırladılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "journey",
                        "expedition",
                        "trip",
                        "crossing"
                    ],
                    "common_phrases": [
                        "maiden voyage",
                        "sea voyage",
                        "voyage of discovery",
                        "long voyage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длительное путешествие, особенно на корабле или в космосе.",
                        "tr": "Özellikle gemiyle veya uzayda yapılan uzun yolculuk."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путешествие",
                                "target_lang_sense_clarification": "общее значение, поездка"
                            },
                            {
                                "target_lang_word": "плавание",
                                "target_lang_sense_clarification": "путешествие по воде"
                            },
                            {
                                "target_lang_word": "рейс",
                                "target_lang_sense_clarification": "маршрут судна"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "seyahat",
                                "target_lang_sense_clarification": "genel anlamda uzun yolculuk"
                            },
                            {
                                "target_lang_word": "deniz yolculuğu",
                                "target_lang_sense_clarification": "özellikle gemi ile yapılan yolculuk"
                            },
                            {
                                "target_lang_word": "sefer",
                                "target_lang_sense_clarification": "bir geminin veya aracın yaptığı yolculuk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f92cc84e-e251-3aba-8169-7e2324c439bb",
                    "sense_definition": "A written account of a journey or travel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "travel_record",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian discovered a dusty <w>voyage</w> written by an explorer from the seventeenth century.",
                            "target_lang_translations": {
                                "ru": "Историк обнаружил пыльное <w>описание путешествия</w>, написанное исследователем семнадцатого века.",
                                "tr": "Tarihçi, on yedinci yüzyıldan bir kâşif tarafından yazılmış tozlu bir <w>seyahatname</w> keşfetti."
                            }
                        },
                        {
                            "text": "She spent the afternoon reading the <w>voyages</w> of early sailors.",
                            "target_lang_translations": {
                                "ru": "Она провела день за чтением <w>путевых заметок</w> ранних мореплавателей.",
                                "tr": "Öğleden sonrasını ilk denizcilerin <w>gezi notlarını</w> okuyarak geçirdi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Modern usage typically refers to 'travels' or 'journals' instead."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменный отчет о путешествии или странствии.",
                        "tr": "Bir yolculuğun veya gezinin yazılı anlatımı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путешествие",
