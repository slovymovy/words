                ],
                "senses": [
                    {
                        "sense_id": "ce4a197c-55c9-30fb-9b7d-f76fb9421c4b",
                        "entry_id": "5e04263e-f029-33ab-900d-30769faa8df6",
                        "glosses": [
                            "Revêtir d’une redingote (vêtement)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a85c320d-b9f8-4c8d-b569-0482f69fb922",
                                "sense_id": "ce4a197c-55c9-30fb-9b7d-f76fb9421c4b",
                                "text": "Boncourt s’étalait dans la grande loge de face. M. Georges en redingote (il redingotait tout de suite); à droite, Madame Renard; à gauche, Madeleine."
                            },
                            {
                                "example_id": "45a96aec-7949-4671-8d68-3fecdec0ca7f",
                                "sense_id": "ce4a197c-55c9-30fb-9b7d-f76fb9421c4b",
                                "text": "De temps en temps apparaissait, telle une frigide et redoutable larve, un avocat ami de Gambetta, svelte, mince et silencieux, redingoté de noir ou de gris, aux yeux de poisson mort, du nom de Waldeck-Rousseau, pour lequel Charcot, dans l’intimité, ne manifestait qu’une sympathie fort médiocre."
                            },
                            {
                                "example_id": "e5d69188-653c-4dc1-b3a4-3a7b892a02c9",
                                "sense_id": "ce4a197c-55c9-30fb-9b7d-f76fb9421c4b",
                                "text": "Il se redingote comme un professeur boche."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3924782-0b4c-3f34-93db-0885d82fc2ee",
                        "entry_id": "5e04263e-f029-33ab-900d-30769faa8df6",
                        "glosses": [
                            "Recouvrir d’une redingote, d’un préservatif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53eebeea-9e23-4df0-b392-c56cf0704bb0",
                                "sense_id": "b3924782-0b4c-3f34-93db-0885d82fc2ee",
                                "text": "Elle rejettera, ou redingotera, les syphiliteux et les pelliculeux , ou même saquera ou épongera l’intérieur et l’extérieur de la fille, outre qu’elle ne leur permettra pas le lit."
                            }
                        ]
                    }
                ],
