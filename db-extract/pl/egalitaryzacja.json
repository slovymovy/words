                        ],
                        "examples": [
                            {
                                "example_id": "cfc1d2d3-0c94-4e25-a7f2-33b8fe38c1e8",
                                "sense_id": "335ffca4-f7f4-340a-945e-b3f33ebd7251",
                                "text": "Egalitaryzacja na tej płaszczyźnie jest równoznaczna ze stopniowym ujednolicaniem stosunku obywateli do środków produkcji poprzez wprowadzanie ich społecznej własności i likwidację własności prywatnej"
                            },
                            {
                                "example_id": "704191e7-89a5-408b-a835-2ef993e6e33e",
                                "sense_id": "335ffca4-f7f4-340a-945e-b3f33ebd7251",
                                "text": "Egalitaryzacja stosunków społecznych była i w przyszłości w coraz większym stopniu będzie główną siłą napędową rozwoju społeczeństw socjalistycznych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
