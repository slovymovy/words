            {
                "entry_id": "929f5d9a-8721-3080-9cb6-772d247a4061",
                "word": "soigné",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "34f5f302-1c30-3a5d-97f9-774233d8b836",
                        "entry_id": "929f5d9a-8721-3080-9cb6-772d247a4061",
                        "glosses": [
                            "Participe passé masculin singulier de soigner."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "8eb14c8a-45f3-4349-989a-bdf95df9654b",
                                "sense_id": "34f5f302-1c30-3a5d-97f9-774233d8b836",
                                "text": "Elle éprouva à ce moment un remord de s’être trop longtemps occupée de son malheur personnel, d’avoir soigné son propre cas et essayé d’abord de se désaffliger elle-même."
                            },
                            {
                                "example_id": "e1edecf4-693b-4352-8c34-046b6ba1634a",
                                "sense_id": "34f5f302-1c30-3a5d-97f9-774233d8b836",
                                "text": "Même si entre-temps l’Espagnol Jon Rahm et le Nord-Irlandais Rory McIlroy ont occupé l’espace, ils ont bien compris que Scheffler, hypersensible qui s’est bien soigné, est rarement sujet aux trous d’air et donc peu disposé à lâcher les sommets."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
