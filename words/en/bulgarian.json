                                "target_lang_sense_clarification": "язык"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保加利亚语",
                                "target_lang_sense_clarification": "语言名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "455c76b7-2c8b-35fb-b1fb-7dc2b1989c16",
                    "sense_definition": "A person from Bulgaria or of Bulgarian descent.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "people",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "My neighbor is a <w>Bulgarian</w> who moved here three years ago.",
