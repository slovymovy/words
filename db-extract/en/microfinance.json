                        "entry_id": "7ba3695f-0c7f-3cac-be80-19a350f90879",
                        "glosses": [
                            "Finance that is provided to unemployed or low-income people or groups."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a5ece825-4ef8-4d6a-9a96-b782d7c1aad6",
                                "sense_id": "6dad8722-d1cd-3b33-8676-4b9e559858b7",
                                "text": "Microfinance, once a relative cottage industry championed by antipoverty activists and development wonks, is on the verge of a revolution, with billions of dollars from big banks, private-equity shops and pension funds pouring in."
                            }
                        ]
                    }
