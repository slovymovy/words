                "senses": [
                    {
                        "sense_id": "24835e14-443f-3e02-b675-765261461342",
                        "entry_id": "250c4318-c50d-3e3c-95c4-20c41fcaacce",
                        "glosses": [
                            "To catch in a trap or snare."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bcaa8268-0637-40f3-9ce2-468addb74444",
                                "sense_id": "24835e14-443f-3e02-b675-765261461342",
                                "text": "Then noble ſouldiers to intrap these theeues […]\nWe haue our Cammels laden al with gold:\nWhich you that be but common ſouldiers,\nShall fling in euery corner of the field:\nAnd while the baſe borne Tartars take it vp,\nYou […] Shall maſſacre those greedie minded ſlaues."
                            },
                            {
                                "example_id": "caac8059-97c7-40ef-9da3-f5c24c0417ab",
                                "sense_id": "24835e14-443f-3e02-b675-765261461342",
                                "text": "He goes home to complain to his father, and the two of them decide on a plan to entrap Enkidu."
                            }
                        ]
                    },
                    {
                        "sense_id": "841a6945-819c-3c0b-a4a8-5d7551e2f601",
                        "entry_id": "250c4318-c50d-3e3c-95c4-20c41fcaacce",
                        "glosses": [
                            "To lure (someone), either into a dangerous situation, or into performing an illegal act."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a2811c0-6030-4a31-b194-b4a3c245614a",
                        "source_entry_id": "250c4318-c50d-3e3c-95c4-20c41fcaacce",
                        "source_sense_description": "lure someone",
                        "target_lang_word": "verstricken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verstricken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa612afa-5b40-39f9-be8f-b1990bb02fa1",
                                        "entry_id": "1c352e43-4c19-3d1b-b969-b7edb01f5dd7",
                                        "glosses": [
                                            "in eine Situation bringen, die unangenehm ist und aus der man sich nicht leicht befreien kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d804571-4917-4d6d-9d7f-3b6d5513edbe",
                                                "sense_id": "aa612afa-5b40-39f9-be8f-b1990bb02fa1",
                                                "text": "Ich glaube, sie wollen ihn in dunkle Geschäfte verstricken."
                                            },
                                            {
                                                "example_id": "bb04455b-51ef-4ec4-b0ff-ded5afb19881",
                                                "sense_id": "aa612afa-5b40-39f9-be8f-b1990bb02fa1",
                                                "text": "„Er parierte jeden Streich, gab jeden Schlag zurück und verstrickte sie zuletzt rettungslos in ihre eigenen Worte, und dabei hatte er den Vorteil der Kälte und Besonnenheit für sich, während sie nahe daran war, ihre ganze Fassung einzubüßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "acd32afd-388c-37d6-be90-bf2a44bde177",
                                        "entry_id": "1c352e43-4c19-3d1b-b969-b7edb01f5dd7",
                                        "glosses": [
                                            "sich in eine heikle Lage bringen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaa98480-47ed-4b7e-b39e-b8ac726b45a9",
                                                "sense_id": "acd32afd-388c-37d6-be90-bf2a44bde177",
                                                "text": "„Sehr häufig lässt Jesp eine große Abneigung gegenüber seinen Mitmenschen erkennen und verstrickt sich somit immer tiefer in seine Einsamkeit.“"
                                            },
                                            {
                                                "example_id": "3558ed5f-c91a-4e31-91c3-54af907f4b8f",
                                                "sense_id": "acd32afd-388c-37d6-be90-bf2a44bde177",
                                                "text": "Sie selbst verstrickt sich mehr und mehr in ihrem Lügengespinst."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8ab1ac20-e76c-3a24-919c-e90dd2a53872",
                                        "entry_id": "1c352e43-4c19-3d1b-b969-b7edb01f5dd7",
                                        "glosses": [
                                            "(zum Beispiel Garn/Wolle) beim Vorgang des Strickens verbrauchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ffcd8d0-1db8-4efc-83e9-d6557e43b0b5",
                                                "sense_id": "8ab1ac20-e76c-3a24-919c-e90dd2a53872",
                                                "text": "Als erstes hatte ich die blaue Merinowolle verstrickt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "00de9414-ae12-3b00-9f94-f1ca216bbf1c",
                                        "entry_id": "1c352e43-4c19-3d1b-b969-b7edb01f5dd7",
                                        "glosses": [
                                            "beim Stricken einen Fehler machen, falsche Maschen stricken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f96a9131-180c-428d-9b76-14beebd169e2",
                                                "sense_id": "00de9414-ae12-3b00-9f94-f1ca216bbf1c",
                                                "text": "Da hast du dich verstrickt, siehst du? Das hätte rechts – links – rechts sein sollen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "747f0cc4-ec93-44ca-89e3-8ac82bfbd420",
                        "source_entry_id": "250c4318-c50d-3e3c-95c4-20c41fcaacce",
                        "source_sense_description": "lure someone",
                        "target_lang_word": "verleiten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verleiten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ab0c237-01b3-3968-9765-cf2e83ef8d48",
                                        "entry_id": "63847305-053f-30f9-8d64-366dc8048bb3",
                                        "glosses": [
                                            "jemanden zu einer Handlung veranlassen, die er von sich aus nicht gemacht hätte"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7491d88-18ef-46a2-adf0-18efbecfb1ba",
                                                "sense_id": "9ab0c237-01b3-3968-9765-cf2e83ef8d48",
                                                "text": "„Nun zeigen US-amerikanische Studien, dass die fettreduzierten Lebensmittel genau das Gegenteil erreichen: Sie verleiten Menschen eher dazu, mehr zu essen.“"
                                            },
                                            {
                                                "example_id": "66ccbdf9-836c-4568-b249-62b9229cb233",
                                                "sense_id": "9ab0c237-01b3-3968-9765-cf2e83ef8d48",
                                                "text": "„Das Verleiten zum Vertragsbruch ist grundsätzlich sittenwidrig, das Verleiten zur ordentlichen Vertragsauflösung nur dann, wenn es unter sittenwidrigen Begleitumständen geschieht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
