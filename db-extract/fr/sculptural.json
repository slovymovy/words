                        "sense_id": "289f8727-6b60-355b-88ad-d5d8223fe9f0",
                        "entry_id": "dc941070-c766-3d07-8f24-8ae3c7e6af0a",
                        "glosses": [
                            "Qui appartient, qui a rapport à la sculpture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0414704e-2c0c-41e1-bcbf-cdc72650eaee",
                                "sense_id": "289f8727-6b60-355b-88ad-d5d8223fe9f0",
                                "text": "Décoration sculpturale."
                            }
                        ]
                    },
                    {
                        "sense_id": "2423b9f6-c11a-3d82-a72f-f2b41e9f5f82",
                        "entry_id": "dc941070-c766-3d07-8f24-8ae3c7e6af0a",
                        "glosses": [
                            "Qui a un caractère digne d’être reproduit par la sculpture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb0e445f-8461-4ed7-b422-b40e319c86b8",
                                "sense_id": "2423b9f6-c11a-3d82-a72f-f2b41e9f5f82",
                                "text": "Une beauté sculpturale."
                            },
                            {
                                "example_id": "c0a7f33b-36bb-4c7a-be48-df32ec68a443",
                                "sense_id": "2423b9f6-c11a-3d82-a72f-f2b41e9f5f82",
                                "text": "Des formes sculpturales."
                            },
                            {
                                "example_id": "896db4d9-94a5-4b55-80d9-7f8b978cf1cb",
                                "sense_id": "2423b9f6-c11a-3d82-a72f-f2b41e9f5f82",
                                "text": "Une Allemande sort de l'eau, sculpturale, et va s'asseoir sans nonchalance, dans un de ces grands pliants de toile, dits « transatlantiques », qui, pareil au roseau, plie et ne rompt pas."
                            },
                            {
                                "example_id": "e72c9c40-b485-4383-9981-347e15dc8353",
                                "sense_id": "2423b9f6-c11a-3d82-a72f-f2b41e9f5f82",
                                "text": "Les artères ayant perdu toute souplesse avaient donné au visage jadis épanoui une dureté sculpturale."
                            }
                        ]
                    }
                ],
