                "forms": [],
                "senses": [
                    {
                        "sense_id": "cc61cd0c-f7fc-3257-9eff-bed26192f423",
                        "entry_id": "90a68ca4-ecbc-3bd6-b18e-e5c30b252c69",
                        "glosses": [
                            "A chain of islands in Japan roughly between Kyushu and Taiwan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d023411-af2f-4980-a18d-8d60bc0935fb",
                                "sense_id": "cc61cd0c-f7fc-3257-9eff-bed26192f423",
                                "text": "White Butterflies in Japan.[...]Shortly after this I left Yokohama for the Ryukyu Islands, and next had my attention attracted by the \"White\" in the Bay of Kagoshima."
                            },
                            {
                                "example_id": "0119c054-c9c5-4f51-994a-5bc91913f341",
                                "sense_id": "cc61cd0c-f7fc-3257-9eff-bed26192f423",
                                "text": "About 140 people live on Kuchinoerabu island in the Ryukyu archipelago, which is approximately 50 miles (80 kilometers) southwest of the main southern island of Kyushu."
                            }
                        ]
                    }
                ],
