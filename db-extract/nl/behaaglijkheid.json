                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d2578c6f-6f58-3bcc-a3f5-2cb91ace73f8",
                        "entry_id": "21d1662c-f073-3d0b-9c15-f885cc5aed30",
                        "glosses": [
                            "het aangenaam, gerieflijk en gezellig zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98e4eece-784b-4679-8776-3f00f0f1bdb4",
                                "sense_id": "d2578c6f-6f58-3bcc-a3f5-2cb91ace73f8",
                                "text": "En weer bedacht hij dat zo'n strenge behaaglijkheid je vast in de stemming zou brengen om je met plezier aan geduldige, vruchtbare arbeid te wijden."
                            },
                            {
                                "example_id": "addd664a-f928-41c7-bf0a-4a6978b3526a",
                                "sense_id": "d2578c6f-6f58-3bcc-a3f5-2cb91ace73f8",
                                "text": "Het winkelende publiek moet ook visueel in de watten worden gelegd, het liefst in een omgeving waar het zich met een zekere behaaglijkheid kan voortbewegen."
                            }
                        ]
                    },
