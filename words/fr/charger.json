    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b87a0e45-a10f-394e-876b-009e259a4895",
                    "sense_definition": "Mettre une charge ou des marchandises dans un véhicule, sur un animal ou sur une personne.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>charger</w> les valises dans le coffre avant de partir."
                        },
                        {
                            "text": "Les ouvriers <w>chargent</w> le camion avec les nouveaux meubles."
                        }
                    ],
                    "synonyms": [
                        "embarquer",
                        "remplir"
                    ],
                    "antonyms": [
                        "décharger",
                        "vider"
                    ],
                    "common_phrases": [
                        "charger les bagages",
                        "charger le camion"
                    ]
                },
                {
                    "sense_id": "02edc4d8-dcab-3ab5-a1a1-845e5c4ebe7c",
                    "sense_definition": "Alimenter un appareil ou un accumulateur en énergie électrique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "electricite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>charger</w> ton téléphone portable cette nuit."
                        },
                        {
                            "text": "La batterie met plusieurs heures à se <w>charger</w> complètement."
                        }
                    ],
                    "synonyms": [
                        "recharger"
                    ],
                    "antonyms": [
                        "décharger"
                    ],
                    "common_phrases": [
                        "charger la batterie",
                        "charger son téléphone"
                    ]
                },
                {
                    "sense_id": "befcc63f-012a-32ec-b3f6-9df5929b1900",
                    "sense_definition": "Donner à quelqu'un la mission, l'ordre ou la responsabilité de faire quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur l'a <w>chargé</w> de rédiger le rapport final."
                        },
                        {
                            "text": "On m'a <w>chargé</w> d'organiser la réunion de demain matin."
                        }
                    ],
                    "synonyms": [
                        "confier",
                        "mandater"
                    ],
                    "antonyms": [
                        "décharger"
                    ],
                    "common_phrases": [
