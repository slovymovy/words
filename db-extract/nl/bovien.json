                        "glosses": [
                            "van runderen, betrekking hebbend op runderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b015e407-05f0-4405-b4d4-2fea3f615b99",
                                "sense_id": "be0af66e-a9ca-35c5-bf53-e45cb80bbd1c",
                                "text": "Boviene Spongiforme Encefalopathie (BSE) dook voor het eerst op in Groot-Brittannië in 1986. De ziekte tast het centrale zenuwstelsel van het besmette dier aan, wat tot de dood kan leiden. Sinds 2001 worden in Nederland alle runderen bij de slacht gecontroleerd op BSE."
                            },
                            {
                                "example_id": "ef9dfaf9-651a-40e4-891a-5dd832cb68fc",
                                "sense_id": "be0af66e-a9ca-35c5-bf53-e45cb80bbd1c",
                                "text": "België kreeg in mei officieel het statuut van 'land met verwaarloosbaar risico' op het vlak van boviene spongiforme encefalopathie (BSE) ofwel gekkekoeienziekte. De dodelijke ziekte bij runderen werd in ons land voor het laatst vastgesteld in 2006."
                            }
                        ]
                    }
