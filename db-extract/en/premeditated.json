                                "example_id": "592f9079-09f4-494c-a916-9f6438145a20",
                                "sense_id": "2fdf5447-e8ff-3f1c-acbb-4876c1cce7af",
                                "text": "caused by grossly negligent or premeditated infringement of duty"
