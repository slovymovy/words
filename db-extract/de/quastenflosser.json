                "senses": [
                    {
                        "sense_id": "3a1b43ce-29b6-360d-8772-dd442ed78068",
                        "entry_id": "244f9d68-bca9-3947-8b1a-9e035679fb97",
                        "glosses": [
                            "Knochenfisch mit quastenförmigen Flossen (Latimeria)"
                        ],
                        "tags": [
                            "speziell Ichthyologie"
                        ],
                        "examples": [
                            {
                                "example_id": "9e0a331c-9875-46f9-baf1-62e141ec3337",
                                "sense_id": "3a1b43ce-29b6-360d-8772-dd442ed78068",
                                "text": "Die Quastenflosser hielt man lange Zeit für bereits ausgestorben."
                            },
                            {
                                "example_id": "829f049a-968b-4294-9d84-68f20e92cf2b",
                                "sense_id": "3a1b43ce-29b6-360d-8772-dd442ed78068",
                                "text": "Wissenschaftler haben 2012 das Genom des Quastenflossers sequenziert und dabei festgestellt, dass er nicht das Brückentier zwischen Fisch und Landtier ist."
                            },
                            {
                                "example_id": "3b6acb01-7744-48d1-93ed-7930b18da4e4",
                                "sense_id": "3a1b43ce-29b6-360d-8772-dd442ed78068",
                                "text": "„Das Ei des Quastenflossers (Latimeria chalumnae) hat einen Durchmesser von 9 cm und wiegt 300 g.“"
                            },
                            {
                                "example_id": "2016f9e1-8d93-4857-9f46-5689afd70a10",
                                "sense_id": "3a1b43ce-29b6-360d-8772-dd442ed78068",
                                "text": "„Auf Lateinisch nennen ihn die Zoologen »Coelacanthus«, auf Deutsch Hohlstachler, weil die Flossenstrahlen im Schwanz hohl sind, oder Quastenflosser, weil die Flossen wie Quasten aussehen.“"
                            },
                            {
                                "example_id": "1e12db5b-f487-46d9-b272-0e3d34baf104",
                                "sense_id": "3a1b43ce-29b6-360d-8772-dd442ed78068",
                                "text": "„1987 entstanden so die ersten Bilder von Quastenflossern in ihrem natürlichem Lebensraum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ad739cf-879a-442a-affc-8a12fb171b1a",
                        "source_entry_id": "244f9d68-bca9-3947-8b1a-9e035679fb97",
                        "source_sense_id": "3a1b43ce-29b6-360d-8772-dd442ed78068",
                        "source_sense_description": "Knochenfisch mit quastenförmigen Flossen",
                        "target_lang_word": "coelacanth",
