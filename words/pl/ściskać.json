    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "155af204-3dc2-33a7-b39b-c0ee5d414788",
                    "sense_definition": "wywierać silny nacisk na coś z różnych stron lub trzymać coś bardzo mocno w dłoniach",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "kompresja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dłoni <w>ściskał</w> mały kluczyk i czekał przed zamkniętymi drzwiami.",
                            "target_lang_translations": {
                                "ru": "В руке он <w>сжимал</w> маленький ключик и ждал перед закрытой дверью."
                            }
                        },
                        {
                            "text": "Ze zdenerwowania mocno <w>ściskała</w> pasek swojej torebki podczas całej rozmowy.",
                            "target_lang_translations": {
                                "ru": "От нервозности она крепко <w>сжимала</w> ремешок своей сумочки во время всего разговора."
                            }
                        }
                    ],
                    "synonyms": [
                        "ścieśniać"
                    ],
                    "antonyms": [
                        "rozluźniać"
                    ],
                    "common_phrases": [
                        "ściskać w dłoni",
                        "ściskać gardło"
                    ],
                    "target_lang_definitions": {
                        "ru": "оказывать сильное давление на что-либо с разных сторон или крепко держать что-либо в руках"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжимать",
                                "target_lang_sense_clarification": "крепко сдавливать или удерживать в руке"
                            },
                            {
                                "target_lang_word": "стискивать",
                                "target_lang_sense_clarification": "с силой сдавливать, зажимать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff3d36e2-04be-360f-91c9-79dc50bcec66",
                    "sense_definition": "obejmować kogoś ramionami na powitanie, pożegnanie lub na znak czułości",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "objęcie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziadek serdecznie <w>ściska</w> wnuki za każdym razem, gdy przyjeżdżają na wieś.",
                            "target_lang_translations": {
                                "ru": "Дедушка сердечно <w>обнимает</w> внуков всякий раз, когда они приезжают в деревню."
                            }
                        },
                        {
                            "text": "Przyjaciele długo <w>ściskali</w> się na peronie przed odjazdem pociągu.",
                            "target_lang_translations": {
                                "ru": "Друзья долго <w>обнимались</w> на перроне перед отправлением поезда."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ściskać kogoś za szyję",
                        "mocno ściskać"
                    ],
                    "target_lang_definitions": {
                        "ru": "обнимать кого-либо руками при встрече, прощании или в знак нежности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обнимать",
                                "target_lang_sense_clarification": "заключать в объятия"
                            },
                            {
                                "target_lang_word": "тискать",
                                "target_lang_sense_clarification": "крепко, эмоционально прижимать к себе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dae06213-6400-3029-9c25-e4f0e0b722c6",
                    "sense_definition": "wzajemnie brać się w ramiona i przytulać",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "objęcie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy serdecznie <w>ściskają</w> się i składają sobie życzenia noworoczne.",
                            "target_lang_translations": {
                                "ru": "Все сердечно <w>обнимаются</w> и поздравляют друг друга с Новым годом."
                            }
                        },
                        {
                            "text": "Po wygranym meczu zawodnicy z radości głośno krzyczeli i <w>ściskali</w> się na boisku.",
                            "target_lang_translations": {
                                "ru": "После победного матча игроки от радости громко кричали и <w>обнимались</w> на поле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ściskać się na pożegnanie",
                        "serdecznie się ściskać"
                    ],
                    "target_lang_definitions": {
                        "ru": "взаимно обнимать друг друга"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обниматься",
                                "target_lang_sense_clarification": "заключать друг друга в объятия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b313e76-5c60-35fb-8d21-c97a799829d0",
                    "sense_definition": "stać lub siedzieć w ciasnej grupie, stłoczonym na małej przestrzeni",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tłok",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pasażerowie musieli <w>ściskać</w> się w starym autobusie przez całą drogę do pracy.",
                            "target_lang_translations": {
                                "ru": "Пассажирам приходилось <w>тесниться</w> в старом автобусе всю дорогу до работы."
                            }
                        },
                        {
                            "text": "W małym pokoju goście <w>ściskają</w> się przy stole, bo brakuje wolnych krzeseł.",
                            "target_lang_translations": {
                                "ru": "В маленькой комнате гости <w>теснятся</w> за столом, потому что не хватает свободных стульев."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ściskać się w tłumie",
                        "ściskać się w autobusie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często w języku potocznym odnośnie tłoku"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "стоять или сидеть тесной группой, тесниться на ограниченном пространстве"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тесниться",
                                "target_lang_sense_clarification": "толпиться в тесноте"
                            },
                            {
                                "target_lang_word": "ютиться",
                                "target_lang_sense_clarification": "находиться в тесном пространстве"
                            },
                            {
                                "target_lang_word": "жаться",
                                "target_lang_sense_clarification": "прижиматься друг к другу от нехватки места"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88cfd1cc-6d94-3e62-a88e-3348d6df200b",
                    "sense_definition": "mocno opasywać talię lub inną część ciała paskiem, gorsetem itp.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kompresja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kobieta zbyt mocno <w>ściskała</w> się gorsetem, przez co z trudem łapała oddech.",
                            "target_lang_translations": {
                                "ru": "Женщина слишком туго <w>утягивалась</w> корсетом, из-за чего с трудом переводила дыхание."
                            }
                        },
                        {
                            "text": "Nie warto tak ciasno <w>ściskać</w> się skórzanym paskiem po obfitym obiedzie.",
                            "target_lang_translations": {
                                "ru": "Не стоит так туго <w>затягиваться</w> кожаным ремнём после плотного обеда."
                            }
                        }
                    ],
                    "antonyms": [
                        "rozluźniać"
                    ],
                    "common_phrases": [
                        "ściskać się paskiem",
                        "ściskać się gorsetem"
                    ],
                    "target_lang_definitions": {
                        "ru": "туго перетягивать талию или другую часть тела ремнём, корсетом и т. п."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утягиваться",
                                "target_lang_sense_clarification": "туго затягивать одежду или корсет на себе"
                            },
                            {
                                "target_lang_word": "перетягиваться",
                                "target_lang_sense_clarification": "стягивать талию поясом или ремнём"
                            },
                            {
                                "target_lang_word": "затягиваться",
                                "target_lang_sense_clarification": "туго застёгивать или шнуровать на себе пояс, корсет"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}