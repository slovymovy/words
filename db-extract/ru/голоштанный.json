                "senses": [
                    {
                        "sense_id": "0d3229f0-abcc-30d5-b4b4-67609d74a89e",
                        "entry_id": "32aa9ba3-753c-36c5-95fe-c0c7924d1d3f",
                        "glosses": [
                            "разг., сниж. неимущий, бедняк"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fd6a62c-1981-4e66-be73-797564245411",
                                "sense_id": "0d3229f0-abcc-30d5-b4b4-67609d74a89e",
                                "text": "Маринка зевнула в кулак и, поглядывая на тускнеющие звезды, равнодушно сказала: Надоел ты мне, голоштанный! Совестно глядеть-то на тебя, не то што…"
                            }
                        ]
                    },
                    {
                        "sense_id": "b55aeff5-734c-3f1a-bf0a-ced596b76962",
                        "entry_id": "32aa9ba3-753c-36c5-95fe-c0c7924d1d3f",
                        "glosses": [
                            "разг., сниж., пренебр. или бран. используется как порицающее или бранное слово"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd6b18fd-7bfb-4c36-b587-930a3aa241f2",
                                "sense_id": "b55aeff5-734c-3f1a-bf0a-ced596b76962",
                                "text": "Никакого опокою от вас, голоштанных, нигде нету…"
                            }
                        ]
                    }
                ],
