                ],
                "senses": [
                    {
                        "sense_id": "ecdbb7a4-0550-3ed2-93b5-c5d3fa845f43",
                        "entry_id": "19f12bea-a684-3ab6-a3fa-c30771c1f8a0",
                        "glosses": [
                            "deutsche Hunderasse, die eine Kreuzung aus Pinscher und Schäferhund ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5f5807-b42a-4dee-8db5-ace898c90a4f",
                                "sense_id": "ecdbb7a4-0550-3ed2-93b5-c5d3fa845f43",
                                "text": "Der Dobermann ist bei der Polizei als Schutzhund sehr beliebt."
                            },
                            {
                                "example_id": "d02e716b-f42b-4ff1-b211-7b718f061ca8",
                                "sense_id": "ecdbb7a4-0550-3ed2-93b5-c5d3fa845f43",
                                "text": "„Der Dobermann starrte mich an.“"
                            },
                            {
                                "example_id": "1995e0a3-0ace-427a-9a88-edd45bb57844",
                                "sense_id": "ecdbb7a4-0550-3ed2-93b5-c5d3fa845f43",
                                "text": "„Die Russen suchten nach dem größten Dobermann und nach dem schlimmsten Rottweiler in der Welt und kreuzten sie mit dem bösartigsten sibirischen Wolf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
