                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "101170fa-d7ab-4766-abb8-ead370fadb9b",
                        "source_entry_id": "e15717ac-5fa2-3d52-9f12-535f0e539d24",
                        "source_sense_id": "d9b9e7ca-cb7a-30b3-ac6e-c83a655d13cf",
                        "source_sense_description": "het gevangen houden of nemen van iemand ten einde iets af te dwingen",
                        "target_lang_word": "Geiselhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geiselhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da16ce72-2f9a-3b5f-9b72-aac115fbff3e",
                                        "entry_id": "e404a3bf-a1ab-3a69-9296-75febc6520d1",
                                        "glosses": [
                                            "(von offizieller Instanz veranlasste) Verwahrung einer oder mehrerer Personen, die als Geiseln gefangen gehalten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb568bca-b98b-46ff-a43f-4ec258f39c3e",
                                                "sense_id": "da16ce72-2f9a-3b5f-9b72-aac115fbff3e",
                                                "text": "„Im Sommer 2006 hielt dieses Kommando die ganze Stadt in Geiselhaft.“"
                                            },
                                            {
                                                "example_id": "6b7b35ca-a8f3-4746-9d57-6b312e9a2be4",
                                                "sense_id": "da16ce72-2f9a-3b5f-9b72-aac115fbff3e",
                                                "text": "„Nach 547 Tagen Geiselhaft sind in Afghanistan die beiden französischen Journalisten Hervé Ghesquière und Stéphane Taponier freigekommen.“"
                                            },
                                            {
                                                "example_id": "df773c2d-4c03-4196-a108-2a72e89d155e",
                                                "sense_id": "da16ce72-2f9a-3b5f-9b72-aac115fbff3e",
                                                "text": "„Schalit war vor zwei Monaten nach mehr als fünf Jahren Geiselhaft im Gazastreifen freigekommen.“"
                                            },
                                            {
                                                "example_id": "3b412f05-53f7-4c06-9a31-3b1fdd90481a",
                                                "sense_id": "da16ce72-2f9a-3b5f-9b72-aac115fbff3e",
                                                "text": "„Jenem Soldaten, der fünf Jahre im Gaza-Streifen in Geiselhaft saß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5bcdc5ef-2b97-39d8-9d8a-7bee59fc904e",
                                        "entry_id": "e404a3bf-a1ab-3a69-9296-75febc6520d1",
                                        "glosses": [
                                            "unbeabsichtigte, nicht gewollte Teilhabe (einer Person, einer Gruppe, eines Volkes oder dergleichen) an der Verantwortung für eine Situation, die man nicht selbst verschuldet hat und die aus eigenen Kräften nicht zu ändern ist"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb1d85c9-8ac7-4002-8e33-310f8dc41fca",
                                                "sense_id": "5bcdc5ef-2b97-39d8-9d8a-7bee59fc904e",
                                                "text": "„Angesichts dieser Bemühungen darf man sich wundern, wie wenig das höchste Gremium der Vereinten Nationen zu sagen hatte, als Israel im Juli 2006 die gesamte libanesische Bevölkerung in Geiselhaft nahm, ganze Regionen zerstörte, hunderte von Zivilisten tötete und zehntausende zur Flucht zwang.“"
                                            },
                                            {
                                                "example_id": "0855d519-8647-4f8c-becf-cdc2c0d13962",
                                                "sense_id": "5bcdc5ef-2b97-39d8-9d8a-7bee59fc904e",
                                                "text": "„Das Parlament, die Demokratie ist in Geiselhaft - ein Nein zum bereits beschlossenen Paket kommt gar nicht in Frage.“"
                                            },
                                            {
                                                "example_id": "320a7ed7-0b9d-4fac-8f36-84f07a514c8a",
                                                "sense_id": "5bcdc5ef-2b97-39d8-9d8a-7bee59fc904e",
                                                "text": "„Die Siedler halten nicht nur das Land in Geiselhaft, die Israelis haben ein Stockholmsyndrom entwickelt – sie haben sich mit den Siedlern solidarisiert.“"
                                            },
                                            {
                                                "example_id": "04c708d2-0d02-4874-8a4a-e048a57da628",
                                                "sense_id": "5bcdc5ef-2b97-39d8-9d8a-7bee59fc904e",
                                                "text": "„Der Rat werde seit Monaten ‚in Geiselhaft gehalten von zwei Ländern, die nur an ihre eigenen Interessen denken.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a187b233-ddd9-4568-aef0-bf08cd8c70d0",
                        "source_entry_id": "e15717ac-5fa2-3d52-9f12-535f0e539d24",
                        "source_sense_id": "d9b9e7ca-cb7a-30b3-ac6e-c83a655d13cf",
                        "source_sense_description": "het gevangen houden of nemen van iemand ten einde iets af te dwingen",
                        "target_lang_word": "Geiselnahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geiselnahme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac42ffd3-1e91-3131-8396-59da9fdbd73b",
                                        "entry_id": "0ec24763-6a87-3e8c-800c-0e103ef9840a",
                                        "glosses": [
                                            "das Gefangennehmen von Personen als Geisel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c41af8ad-104d-41f1-a659-31b1be0faa0a",
                                                "sense_id": "ac42ffd3-1e91-3131-8396-59da9fdbd73b",
                                                "text": "Der Banküberfall endete mit einer Geiselnahme."
                                            },
                                            {
                                                "example_id": "2043aa8a-ec66-448a-897b-9edf6444af31",
                                                "sense_id": "ac42ffd3-1e91-3131-8396-59da9fdbd73b",
                                                "text": "„Anlass für das Verdikt waren verbreitete bewaffnete Überfälle und Geiselnahmen durch Trupps tschetschenischer junger Männer.“"
                                            },
                                            {
                                                "example_id": "52442b31-93f8-49ad-8e75-a0ebd121c574",
                                                "sense_id": "ac42ffd3-1e91-3131-8396-59da9fdbd73b",
                                                "text": "„Zwar gibt es jetzt keine Berichte mehr von misshandelten Kautschuksammlern, niedergebrannten Dörfern, abgeschlagenen Händen und Geiselnahmen an Frauen und Kindern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
