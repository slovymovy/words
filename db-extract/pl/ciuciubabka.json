                                "sense_id": "8e29311c-5b31-36a1-9738-0a87b52f89a3",
                                "text": "Dzieci bawiły się w ciuciubabkę.",
                                "translation": "Děti si hrály na slepou bábu."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef31ed26-330c-38ca-9caf-f278dbca518e",
