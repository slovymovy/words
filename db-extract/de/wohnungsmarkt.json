                "senses": [
                    {
                        "sense_id": "78601d77-fb1c-3779-af90-cd5c13c501e4",
                        "entry_id": "504403fb-9041-35eb-924d-52036f77206b",
                        "glosses": [
                            "Gesamtheit von Angeboten und Nachfrage betreffs Wohnungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83fc341f-71e6-4acb-9817-4749868eecdb",
                                "sense_id": "78601d77-fb1c-3779-af90-cd5c13c501e4",
                                "text": "„Pünktlich zur Bundestagswahl nehmen die Parteien die Probleme auf dem Wohnungsmarkt ins Visier.“"
                            },
                            {
                                "example_id": "10e7594f-2b14-4309-8892-df41024cb8a3",
                                "sense_id": "78601d77-fb1c-3779-af90-cd5c13c501e4",
                                "text": "„Auf diese Weise wolle man künftig vor allem Familien unterbringen, die als Flüchtlinge anerkannt wurden und auf dem Wohnungsmarkt kaum eine Chance hätten.“"
                            }
                        ],
