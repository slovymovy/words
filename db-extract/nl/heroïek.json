                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c106ee7-83fd-4181-9ee3-82268d2980e3",
                                "sense_id": "ef03db20-6cab-37c1-bc3c-8dca031a0bb9",
                                "text": "Een Rus moet ergens in geloven. In het stralende, het hogere. Imperium en communisme zitten ons in het bloed. Heroïek ligt ons."
                            },
                            {
                                "example_id": "957b6018-66e4-4fa1-bdc5-bc77865785fe",
                                "sense_id": "ef03db20-6cab-37c1-bc3c-8dca031a0bb9",
                                "text": "Ik zal nooit kunnen invoelen wat het is om aan de top te voetballen.' En het zijn de journalisten die de heroïek aan het spel toevoegen, dacht ik."
                            },
                            {
                                "example_id": "3c243553-05a5-4ed0-89d1-483918d4d092",
                                "sense_id": "ef03db20-6cab-37c1-bc3c-8dca031a0bb9",
                                "text": "Avildsen zag af van de regie van Rocky 2. De latere Rocky's bleken stuk voor stuk onvergelijkbaar met de eerste: de tragiek, die de heroïek zo mooi in balans hield, was eraf."
                            }
                        ]
                    }
