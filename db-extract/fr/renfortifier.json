                "senses": [
                    {
                        "sense_id": "15903340-1b5d-36a1-8005-ac2ebdf3cddc",
                        "entry_id": "d51766c0-edfa-36ae-9de6-2cce46f23c5b",
                        "glosses": [
                            "Redonner de la force à."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "ab3c42f0-f6c7-4ca9-9c4b-d0f180399dfb",
                                "sense_id": "15903340-1b5d-36a1-8005-ac2ebdf3cddc",
                                "text": "Bon aller, on va se renfortifier les défenses..."
                            },
                            {
                                "example_id": "4f234633-287f-4e77-ab3e-cf6a66e004d2",
                                "sense_id": "15903340-1b5d-36a1-8005-ac2ebdf3cddc",
                                "text": "J eut un point de pneumonie, marqué par une montée de fièvre délirante qui nourrit chez Marthe d'amples affres, et ses journées furent jalonnées de piqûres de pénicilline, de sinapismes, de suppositoires, de verres de jus de citron, pour la vitamine, et de jattes matinales de café au lait enrichi d'un jaune d'œuf cru, prescrites par sa grand-mère, qui lui gardait les plus beaux produits de ses poules, pour le renfortifier."
                            },
                            {
                                "example_id": "215dc3dd-56d5-4c00-91a0-18c7b41342f9",
                                "sense_id": "15903340-1b5d-36a1-8005-ac2ebdf3cddc",
                                "text": "Était-ce pour renfortifier la valeur de la communauté en général?"
                            }
                        ]
                    }
