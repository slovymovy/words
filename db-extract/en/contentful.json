                        "sense_id": "98b3c97b-f662-369b-9266-b12df075b444",
                        "entry_id": "5fd4087e-ff90-3bfc-9f2a-2ee9c85d4a73",
                        "glosses": [
                            "Full of contentment."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4310e0b6-5605-47be-b69b-931294e587fb",
                                "sense_id": "98b3c97b-f662-369b-9266-b12df075b444",
                                "text": "How contentful the whole life is of him, that neither deviseth mischief against others, nor suspects any to be contrived against himself."
                            },
                            {
                                "example_id": "6733102c-7eec-4f30-afbe-21c0c7269a65",
                                "sense_id": "98b3c97b-f662-369b-9266-b12df075b444",
                                "text": "With the setting sun sending long shadows loping ahead of them over the smooth hillocks of the downs, they came up with the lagoon; a contentful return home, with appetite brisked up by a ten-mile walk, and plenty of food to satisfy it."
                            }
                        ]
                    }
                ],
