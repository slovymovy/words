                        "examples": [
                            {
                                "example_id": "74866929-c2d5-4ff9-bede-c8e50c19b376",
                                "sense_id": "3226530b-5866-3230-81b4-1b7934acfc93",
                                "text": "De hackersaanval is een reactie op de arrestatie van Julian Assange, voorman van de klokkenluiderssite WikiLeaks. Een groep met de naam Anonymous had vorige week gedreigd met acties tegen bedrijven die geen zaken meer willen doen met WikiLeaks, zoals MasterCard."
                            },
                            {
                                "example_id": "2561371d-dd1c-40f6-ba01-6d8547209aad",
                                "sense_id": "3226530b-5866-3230-81b4-1b7934acfc93",
                                "text": "De Verenigde Staten hebben zes bevriende landen gewaarschuwd voor documenten die de komende dagen verschijnen op de klokkenluiderssite Wikileaks. Dat meldt Wikileaks op zijn twitterfeed. Het gaat om Groot-Brittannië, Noorwegen, Israël, Australië, Denemarken en Canada."
                            }
                        ]
                    }
