                ],
                "senses": [
                    {
                        "sense_id": "6c78cb03-0364-3a0a-a299-a42c44f7582a",
                        "entry_id": "80e8f73b-af34-3eb7-ae23-20e0c9485c38",
                        "glosses": [
                            "Einrichtung (am Flughafen), bei der der Check-in beziehungsweise die Anmeldung des (Flug-)Gastes erfolgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2b892ce-481f-47c0-96ce-a496a5a05479",
                                "sense_id": "6c78cb03-0364-3a0a-a299-a42c44f7582a",
                                "text": "„Auch die lange Wartezeit am Check-In-Schalter entfällt vielerorts: Das Gepäck kann an sogenannten Drop-Off-Schaltern abgegeben werden, die Boardkarte drucken Sie Zuhause aus.“"
                            },
                            {
                                "example_id": "ee41f729-0efc-4ac4-b1e4-25f4f9769522",
                                "sense_id": "6c78cb03-0364-3a0a-a299-a42c44f7582a",
                                "text": "„Doch dadurch - und durch ganz viel Pech - erreichte das Paar den Check-In-Schalter am Flughafen um genau sieben Minuten zu spät. […] Die Fluggesellschaft wartete nicht: Der Flieger flog ohne das Paar los.“"
                            },
                            {
                                "example_id": "ac7ba975-b34c-47e6-9914-d6522cd82725",
                                "sense_id": "6c78cb03-0364-3a0a-a299-a42c44f7582a",
                                "text": "„Vor einem Check-In-Schalter im Internationalen Flughafen Pudong in Shanghai sind laut der staatlichen Nachrichtenagentur Xinhua um drei Uhr Nachmittags (Ortszeit) Feuerwerkskörper explodiert.“"
                            },
                            {
                                "example_id": "c7b0e56b-adc7-4d53-892e-25b873057cac",
                                "sense_id": "6c78cb03-0364-3a0a-a299-a42c44f7582a",
                                "text": "„In der Abflughalle war das Terminal randvoll mit Reisenden aller Nationalitäten, die die verschiedenen Check-In-Schalter umschwärmten.“"
                            },
                            {
                                "example_id": "91bffbe6-fe02-4788-8e10-c877a2cad865",
                                "sense_id": "6c78cb03-0364-3a0a-a299-a42c44f7582a",
                                "text": "„Obwohl es noch keine 01:00 Uhr war, waren bereits die Check-In-Schalter besetzt und wir konnten sofort nach Erreichen des Terminals 2 einchecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
