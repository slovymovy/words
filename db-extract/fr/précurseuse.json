                    {
                        "translation_id": "3bc32366-2006-4150-8479-6ef6fc363d87",
                        "source_entry_id": "8dd51332-8368-30e0-b0d4-e5cd8b8f7a24",
                        "target_lang_word": "forerunner",
                        "target_lang_code": "en",
