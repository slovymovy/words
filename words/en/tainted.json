{
    "word_family": [
        "taint",
        "taintless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "30b71d10-725a-31ef-b2c4-df7b7ef08b9f",
                    "sense_definition": "Corrupted or filled with imperfections.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "corrupted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigation was <w>tainted</w> by rumors of bribery and corruption.",
                            "target_lang_translations": {
                                "fr": "L'enquête a été <w>entachée</w> par des rumeurs de corruption et de pots-de-vin."
                            }
                        },
                        {
                            "text": "Many people became ill after eating <w>tainted</w> food from the market.",
                            "target_lang_translations": {
                                "fr": "Beaucoup de gens sont tombés malades après avoir mangé de la nourriture <w>contaminée</w> provenant du marché."
                            }
                        }
                    ],
                    "synonyms": [
                        "contaminated",
                        "corrupt",
                        "impure",
                        "imperfect"
                    ],
                    "antonyms": [
                        "pure",
                        "unspoiled"
                    ],
                    "common_phrases": [
                        "tainted food",
                        "tainted money",
                        "tainted reputation"
                    ],
                    "target_lang_definitions": {
                        "fr": "Corrompu, altéré ou souillé par des imperfections ou des éléments extérieurs."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "corrompu",
                                "target_lang_sense_clarification": "utilisé pour des concepts abstraits comme une réputation ou une enquête"
                            },
                            {
                                "target_lang_word": "contaminé",
                                "target_lang_sense_clarification": "utilisé pour des aliments ou des substances physiques"
                            },
                            {
                                "target_lang_word": "altéré",
                                "target_lang_sense_clarification": "utilisé pour signifier que la qualité ou l'intégrité a été dégradée"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3aef7823-27ea-327e-8ce5-2e24ce79def6",
                    "sense_definition": "Originating from an untrusted source.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "corrupted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software security team warned against using <w>tainted</w> data in the system.",
                            "target_lang_translations": {
                                "fr": "L'équipe de sécurité informatique a mis en garde contre l'utilisation de données <w>non fiables</w> dans le système."
                            }
                        },
                        {
                            "text": "Developers must sanitize all <w>tainted</w> input to prevent security vulnerabilities.",
                            "target_lang_translations": {
                                "fr": "Les développeurs doivent assainir toutes les entrées <w>compromises</w> pour éviter les failles de sécurité."
                            }
                        }
                    ],
                    "synonyms": [
                        "contaminated"
                    ],
                    "antonyms": [
                        "trusted",
                        "verified"
                    ],
                    "common_phrases": [
                        "tainted data",
                        "tainted input"
                    ],
                    "target_lang_definitions": {
                        "fr": "Provenant d'une source non fiable ou potentiellement dangereuse, souvent utilisé en informatique."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "non fiable",
                                "target_lang_sense_clarification": "indique une source de données qui n'est pas digne de confiance"
                            },
                            {
                                "target_lang_word": "compromis",
                                "target_lang_sense_clarification": "indique que les données ont été exposées à un risque de sécurité"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1a84a82-e11b-3085-a8af-16c9a7fa9c79",
                    "sense_definition": "Simple past and past participle of <w>taint</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal <w>tainted</w> his reputation for many years.",
                            "target_lang_translations": {
                                "fr": "Le scandale a <w>terni</w> sa réputation pendant de nombreuses années."
                            }
                        },
                        {
                            "text": "His career was <w>tainted</w> by the false accusations made against him.",
                            "target_lang_translations": {
                                "fr": "Sa carrière a été <w>entachée</w> par les fausses accusations portées contre lui."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Forme passée du verbe signifiant ternir, entacher ou corrompre."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "entaché",
                                "target_lang_sense_clarification": "utilisé pour une réputation ou une carrière"
                            },
                            {
                                "target_lang_word": "terni",
                                "target_lang_sense_clarification": "utilisé pour l'image ou la réputation de quelqu'un"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}