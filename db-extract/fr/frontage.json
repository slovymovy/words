                "translations": [
                    {
                        "translation_id": "dcc26c78-9085-43ce-bd16-309baa4f979a",
                        "source_entry_id": "dfa7f530-ec99-39e4-a410-3dbf796a1530",
                        "source_sense_id": "a365a60f-92ff-33d5-8843-7565d46f9cd8",
