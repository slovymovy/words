                "senses": [
                    {
                        "sense_id": "ff215a9c-5109-334e-8204-be69dbd4d802",
                        "entry_id": "ee200e4c-9dbb-388f-887d-70f9a8521016",
                        "glosses": [
                            "in het eigen onderhoud kunnen voorzien zonder externe hulp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc76a7b0-4b37-4315-9cb1-2b2c3e8169ef",
                                "sense_id": "ff215a9c-5109-334e-8204-be69dbd4d802",
                                "text": "De Rechtspraak zelf meent met €3,8 miljoen aan opstartkosten voor rekening van de belastingbetaler uiteindelijk 100 zaken en 25 beroepszaken per jaar te kunnen gaan behandelen, wat een omzet van €75 miljoen aan griffierechten zou moeten opleveren. Zo zou het initiatief ruimschoots zelfbedruipend kunnen zijn."
                            },
                            {
                                "example_id": "0f31dd18-d08b-40c8-b889-756692f0821b",
                                "sense_id": "ff215a9c-5109-334e-8204-be69dbd4d802",
                                "text": "“Ze zijn op dit moment zelfbedruipend. Ze hebben genoeg gijzelaars gepakt en daar geld uit gehaald. Ze verkopen werelderfgoed en hebben de banken leeggeroofd. Dat is het eerste wat ze doen. Ze roven alles. Ze noemen het oorlogsbuit, maar het is alleszins gestolen.”"
                            }
                        ]
                    }
