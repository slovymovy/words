                        "sense_id": "1b196094-8d26-3688-a0c4-51ff946aff2b",
                        "entry_id": "7c5b4934-3294-3323-8e7e-b29131b14aac",
                        "glosses": [
                            "Se tuer l’un l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e439962-424c-4348-b150-2b06fe3ca4b3",
                                "sense_id": "1b196094-8d26-3688-a0c4-51ff946aff2b",
                                "text": "Quant au massacre, c’est inévitable… Rien à y faire. Nous sommes des civilisés, des apprivoisés, tout à coup obligés de s’entretuer…"
                            },
                            {
                                "example_id": "080c810c-1b0e-470c-9b58-dd1d1b30d80c",
                                "sense_id": "1b196094-8d26-3688-a0c4-51ff946aff2b",
                                "text": "Les irakiens continuent de s’entretuer :\nUne autre journée sanglante, une autre journée où le peuple irakien préfère se faire sauter la tronche plutôt que de dialoguer…"
                            }
                        ]
                    }
                ],
