{
    "word_family": [
        "use",
        "user",
        "usable",
        "usability",
        "misusage",
        "useful",
        "useless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ffdaeb0-3bd1-3fd4-882d-c7de9a647c44",
                    "sense_definition": "The act of using something or the amount of something that is used.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "utilization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is trying to reduce its energy <w>usage</w> to save money and help the environment.",
                            "target_lang_translations": {
                                "ru": "Компания старается сократить <w>потребление</w> энергии, чтобы сэкономить деньги и помочь окружающей среде.",
                                "zh": "公司正试图减少能源<w>消耗</w>，以节省开支并保护环境。"
                            }
                        },
                        {
                            "text": "Heavy <w>usage</w> of the internet during the evening can sometimes slow down the connection speed.",
                            "target_lang_translations": {
                                "ru": "Активное <w>использование</w> интернета в вечернее время иногда может замедлять скорость соединения.",
                                "zh": "晚上大量<w>使用</w>互联网有时会降低连接速度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "use",
                        "utilization",
                        "consumption",
                        "employment"
                    ],
                    "antonyms": [
                        "nonuse",
                        "disuse"
                    ],
                    "common_phrases": [
                        "heavy usage",
                        "energy usage",
                        "data usage",
                        "recorded usage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по использованию чего-либо или количество используемого ресурса.",
                        "zh": "指使用某物的行为，或被使用的数量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "использование",
                                "target_lang_sense_clarification": "процесс применения чего-либо"
                            },
                            {
                                "target_lang_word": "потребление",
                                "target_lang_sense_clarification": "расход ресурса, например энергии или данных"
                            },
                            {
                                "target_lang_word": "применение",
                                "target_lang_sense_clarification": "использование на практике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使用",
                                "target_lang_sense_clarification": "应用或利用某物"
                            },
                            {
                                "target_lang_word": "消耗",
                                "target_lang_sense_clarification": "指能源或资源的使用量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57054030-c8ab-3c9f-96e1-1e165ec56aef",
                    "sense_definition": "The way in which words and phrases are actually used in a particular language or community.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "language",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictionary provides many examples of modern English <w>usage</w> to help students learn.",
                            "target_lang_translations": {
                                "ru": "Словарь приводит множество примеров современного английского <w>употребления</w>, чтобы помочь студентам в обучении.",
                                "zh": "这本词典提供了许多现代英语<w>用法</w>的例子，以帮助学生学习。"
                            }
                        },
                        {
                            "text": "In descriptive linguistics, word senses are established by common <w>usage</w> rather than strict rules.",
                            "target_lang_translations": {
                                "ru": "В дескриптивной лингвистике значения слов устанавливаются общим <w>словоупотреблением</w>, а не строгими правилами.",
                                "zh": "在描述语言学中，词义是由通用的<w>用语</w>习惯而非严格的规则确定的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "parlance",
                        "phraseology",
                        "style"
                    ],
                    "common_phrases": [
                        "common usage",
                        "modern usage",
                        "language usage",
                        "standard usage"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, как слова и фразы фактически используются в конкретном языке или сообществе.",
                        "zh": "指特定语言或群体中词汇和短语的实际使用方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "употребление",
                                "target_lang_sense_clarification": "общепринятое использование слов"
                            },
                            {
                                "target_lang_word": "словоупотребление",
                                "target_lang_sense_clarification": "лингвистический термин для использования слов"
                            },
                            {
                                "target_lang_word": "узус",
                                "target_lang_sense_clarification": "общепринятая речевая практика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用法",
                                "target_lang_sense_clarification": "词汇或短语的习惯性使用方式"
                            },
                            {
                                "target_lang_word": "用语",
                                "target_lang_sense_clarification": "特定语境下的词汇表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee39e2d1-9bb1-3867-add2-f08829d6ea3e",
                    "sense_definition": "A custom or established practice that has become a habit over time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "custom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a long-standing <w>usage</w> in the village to ring the bells at midnight on New Year's Eve.",
                            "target_lang_translations": {
                                "ru": "В деревне существовал давний <w>обычай</w> звонить в колокола в полночь накануне Нового года.",
                                "zh": "在村子里，除夕午夜敲钟是一项悠久的<w>习俗</w>。"
                            }
                        },
                        {
                            "text": "The diplomat followed the established <w>usage</w> of the court during the formal ceremony.",
                            "target_lang_translations": {
                                "ru": "Дипломат следовал установленному <w>этикету</w> двора во время официальной церемонии.",
                                "zh": "外交官在正式仪式上遵循了宫廷既定的<w>惯例</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "custom",
                        "tradition",
                        "practice",
                        "convention"
                    ],
                    "common_phrases": [
                        "established usage",
                        "long-standing usage",
                        "ancient usage"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in legal or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обычай или установившаяся практика, ставшая привычкой со временем.",
                        "zh": "指随着时间推移而形成的习俗或既定做法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обычай",
                                "target_lang_sense_clarification": "традиционно установившийся порядок"
                            },
                            {
                                "target_lang_word": "традиция",
                                "target_lang_sense_clarification": "устоявшаяся норма поведения"
                            },
                            {
                                "target_lang_word": "обыкновение",
                                "target_lang_sense_clarification": "заведенный порядок или привычка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "习俗",
                                "target_lang_sense_clarification": "长期形成的社会习惯"
                            },
                            {
                                "target_lang_word": "惯例",
                                "target_lang_sense_clarification": "正式场合中既定的做法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46e0a755-181e-362b-8ecf-00201fe14e47",
                    "sense_definition": "The way in which a person or thing is treated, especially when it is harsh or unfair.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "treatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old car had suffered years of rough <w>usage</w> on the bumpy country roads.",
                            "target_lang_translations": {
                                "ru": "Старая машина пострадала от многолетней грубой <w>эксплуатации</w> на ухабистых проселочных дорогах.",
                                "zh": "这辆旧车在崎岖的乡村道路上经历了多年的粗暴<w>使用</w>。"
                            }
                        },
                        {
                            "text": "The prisoner complained of the cruel <w>usage</w> he received at the hands of his captors.",
                            "target_lang_translations": {
                                "ru": "Заключенный жаловался на жестокое <w>обращение</w>, которому он подвергался со стороны своих похитителей.",
                                "zh": "囚犯抱怨他遭到了俘虏者残酷的<w>对待</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "treatment",
                        "handling",
                        "management"
                    ],
                    "common_phrases": [
                        "rough usage",
                        "harsh usage",
                        "cruel usage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ обращения с человеком или вещью, особенно грубый или несправедливый.",
                        "zh": "指对待人或物的方式，尤指粗暴或不公平的对待。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обращение",
                                "target_lang_sense_clarification": "способ взаимодействия или отношения"
                            },
                            {
                                "target_lang_word": "эксплуатация",
                                "target_lang_sense_clarification": "интенсивное или грубое использование вещи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对待",
                                "target_lang_sense_clarification": "人与人之间的互动方式"
                            },
                            {
                                "target_lang_word": "使用",
                                "target_lang_sense_clarification": "指对物品的粗暴操作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}