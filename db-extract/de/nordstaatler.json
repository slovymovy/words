                "senses": [
                    {
                        "sense_id": "2fa115bf-eccf-36cf-9578-723cc87b76d7",
                        "entry_id": "12b13d46-0822-3bac-8e23-ad9341cef091",
                        "glosses": [
                            "Bewohner der im Nordosten der USA gelegenen Bundesstaaten"
                        ],
                        "tags": [
                            "oft historisch"
                        ],
                        "examples": [
                            {
                                "example_id": "6efb807a-0649-4c26-ac45-3f1069f24974",
                                "sense_id": "2fa115bf-eccf-36cf-9578-723cc87b76d7",
                                "text": "„Sie lehnten die Verfassung so lange strikt ab, bis die Nordstaatler in einen Kompromiss einwilligten: Die erste demokratische Verfassung der modernen Welt würde die Sklaverei erlauben.“"
                            },
                            {
                                "example_id": "0ef3e78d-0527-4ae2-94b0-e7379faecb2d",
                                "sense_id": "2fa115bf-eccf-36cf-9578-723cc87b76d7",
                                "text": "„Dieser 45 Jahre alte, sehnige und knochige Mann war ein Nordstaatler par excellence.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
