                    },
                    {
                        "translation_id": "0f3cd27d-155b-4073-bbcb-e42e1447d98b",
                        "source_entry_id": "d2ec6f42-0697-31f7-8fc6-fd0249e48f2e",
                        "target_lang_word": "Natürlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Natürlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1ccd061-0525-3450-8a16-5ea86ca77da7",
                                        "entry_id": "9be1b14f-a856-395c-80d1-5622283885a2",
                                        "glosses": [
                                            "Eigenschaft, vor allem von Personen, die ein offenes, unverstelltes Verhalten zeigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faebe370-7eee-42cb-8869-5c52f0e94c4e",
                                                "sense_id": "e1ccd061-0525-3450-8a16-5ea86ca77da7",
                                                "text": "Natürlichkeit ist eine seiner guten Eigenschaften."
                                            },
                                            {
                                                "example_id": "8cdba05a-3f34-492f-ae0b-b0547fbb7cc2",
                                                "sense_id": "e1ccd061-0525-3450-8a16-5ea86ca77da7",
                                                "text": "„Mitten unter den nichtigen, dürftigen, von aller Natürlichkeit entfernten Interessen, die in dieser Gesellschaft jeden mit dem andern verbanden, war plötzlich ein natürliches, einfaches Gefühl aufgetaucht: nämlich das Zueinanderstreben zweier wohlgeschaffener, gesunder, junger Menschen, eines Mannes und eines Weibes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "49feaccc-2d3c-3233-97f0-fbcdb5ccc5c6",
                                        "entry_id": "9be1b14f-a856-395c-80d1-5622283885a2",
                                        "glosses": [
                                            "Eigenschaft, die man den Markiertheitsverhältnissen bei Gegensatzpaaren sprachlicher Einheiten/ Kategorien vor allem in Phonologie und Morphologie einer Sprache zuschreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7b7dce0-271b-4133-8fc9-40439f918807",
                                                "sense_id": "49feaccc-2d3c-3233-97f0-fbcdb5ccc5c6",
                                                "text": "Natürlichkeit liegt vor, wenn die Beziehung zwischen den Bedeutungen zweier gegensätzlicher sprachlicher Elemente durch die Unterschiede in der Markiertheit wiedergegeben wird."
                                            },
                                            {
                                                "example_id": "d8e43a95-b0f8-47cc-9dd2-430e07a093eb",
                                                "sense_id": "49feaccc-2d3c-3233-97f0-fbcdb5ccc5c6",
                                                "text": "Ein Beispiel: Im Verhältnis Singular - Plural bedeutet der Plural im Allgemeinen mehr als der Singular; Natürlichkeit ist dann gegeben, wenn entsprechend auch die Form des Plurals mehr anzeigt wird als die des Singulars. Bei Substantiven: das Gegensatzpaar \"Kind\" - \"Kinder\" zeigt Natürlichkeit in der Wiedergabe der grammatischen Kategorien Singular und Plural; das Gegensatzpaar \"Wagen\" (Singular) - \"Wagen\" (Plural) zeigt diese Natürlichkeit der Verhältnisse nicht, da für den Plural in diesem Fall keine zusätzliche Endung vorhanden ist."
                                            },
                                            {
                                                "example_id": "a795f3b5-093c-4401-b882-f8129955fd37",
                                                "sense_id": "49feaccc-2d3c-3233-97f0-fbcdb5ccc5c6",
                                                "text": "„Im Normalfall sind phonologische Natürlichkeit (…) und morphologische Natürlichkeit nicht simultan optimierbar.“"
                                            },
                                            {
                                                "example_id": "e8283c87-8504-4598-b768-bd4b304da5a0",
                                                "sense_id": "49feaccc-2d3c-3233-97f0-fbcdb5ccc5c6",
                                                "text": "„Das Prinzip (i) besagt, daß morphologischer Wandel (soweit er nicht auf Sprach- und Dialektmischung, Entlehnung, Normierung usw. beruht) in Richtung von mehr Markiertheit/weniger Natürlichkeit zu weniger Markiertheit/mehr Natürlichkeit verläuft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
