        "ru-extract.jsonl": [
            {
                "entry_id": "a7b7622b-f18a-3cad-8fc1-70a80dac82c3",
                "word": "видно",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f532ebcb-f9f2-362f-ae31-84634a8fa3b7",
                        "entry_id": "a7b7622b-f18a-3cad-8fc1-70a80dac82c3",
                        "glosses": [
                            "предик. можно увидеть, разглядеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "415a3c63-f283-4f65-a6ce-bd8c1aae3e5e",
                                "sense_id": "f532ebcb-f9f2-362f-ae31-84634a8fa3b7",
                                "text": "Лица фигуры не видно; оно скрыто свесившимися на него длинными волосами каштанового цвета <…>"
                            },
                            {
                                "example_id": "332f5660-405a-407b-93d5-dfdd65779ca9",
                                "sense_id": "f532ebcb-f9f2-362f-ae31-84634a8fa3b7",
                                "text": "В окна графской церкви видно прозрачное, голубое небо, а всю церковь, от расписного купола до пола, пронизывает матовый луч, в котором весело играют клубы ладанного дыма…"
                            }
                        ]
                    },
                    {
                        "sense_id": "28996ccb-1c90-3b39-89ca-15b6dbf1dea8",
                        "entry_id": "a7b7622b-f18a-3cad-8fc1-70a80dac82c3",
                        "glosses": [
                            "предик. можно понять, оценить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3ffed12-6015-47c0-9bde-e691fae88364",
                                "sense_id": "28996ccb-1c90-3b39-89ca-15b6dbf1dea8",
                                "text": "Вот ересь-то вашу и видно."
                            },
                            {
                                "example_id": "52219a54-e98c-458e-b3f5-64b24e33d6e3",
                                "sense_id": "28996ccb-1c90-3b39-89ca-15b6dbf1dea8",
                                "text": "Мне доставили из Митавы бумаги, из которых видно, что у моей матушки есть претензии на имения, находящиеся в Курляндии, принадлежавшие некогда графам Кенигсмаркам, и на первый раз я явлюсь в Митаву только для того, чтоб предъявить эти претензии."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "e9dccfb0-6e8d-4663-8a0a-b9ff728ca943",
                        "source_entry_id": "a7b7622b-f18a-3cad-8fc1-70a80dac82c3",
                        "source_sense_ids": [
                            "f532ebcb-f9f2-362f-ae31-84634a8fa3b7"
                        ],
                        "linkage_type": "synonyms",
                        "word": "заметно"
                    },
                    {
                        "linkage_id": "ce010817-6ed0-4559-ba1c-d75c0c30ff55",
                        "source_entry_id": "a7b7622b-f18a-3cad-8fc1-70a80dac82c3",
                        "source_sense_ids": [
                            "28996ccb-1c90-3b39-89ca-15b6dbf1dea8"
                        ],
                        "linkage_type": "synonyms",
                        "word": "понятно"
                    }
                ]
            },
            {
                "entry_id": "8d7e5e17-5672-3b93-8e7c-95a7605c08f3",
