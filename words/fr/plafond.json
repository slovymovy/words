                    "synonyms": [
                        "ciel",
                        "ciel de carrière"
                    ]
                },
                {
                    "sense_id": "248369d0-001c-3478-8e26-b99c4bbd960d",
                    "sense_definition": "Grand plat ou plateau métallique rectangulaire utilisé pour la cuisson au four.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier dépose la pièce de bœuf sur un <w>plafond</w> avant de l'enfourner."
                        },
                        {
                            "text": "Il faut retirer le rôti du four et le laisser reposer directement sur le <w>plafond</w> chaud."
