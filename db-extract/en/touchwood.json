                        "target_lang_word": "troud",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troud",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "2953ffc5-8893-35cb-8381-e44edd56109b",
                                        "entry_id": "f78ff521-9af3-39e0-980c-e9bc861a7ba5",
                                        "glosses": [
                                            "snadno vznětlivá látka, která se používala při rozdělávání ohně"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db6f2913-0257-45a1-a128-533acc0afd5e",
                                                "sense_id": "2953ffc5-8893-35cb-8381-e44edd56109b",
                                                "text": "K rozdělání ohně jste kdysi potřebovali křesadlo, hubku a troud. Což byl ale pořád velký pokrok oproti tření dvou dřívek o sebe."
                                            },
                                            {
                                                "example_id": "a37c8bd1-8e72-49a1-b839-827e3c864cc8",
                                                "sense_id": "2953ffc5-8893-35cb-8381-e44edd56109b",
                                                "text": "Nu, upečem vás do zlata! Jak troud už splála vaše kutna, teď tušíte, jak věčnost chutná!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37afe762-3335-31f6-b263-e58e4c70c4be",
                                        "entry_id": "f78ff521-9af3-39e0-980c-e9bc861a7ba5",
                                        "glosses": [
                                            "něco vyprahlého, pocit velkého sucha či vyprahlosti"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe46d3d6-ae5f-41d9-bc01-432a60baebba",
                                                "sense_id": "37afe762-3335-31f6-b263-e58e4c70c4be",
                                                "text": "Když hlídám stáj a slyším vítr dout, prosím, ať ji poví, že mám v srdci troud."
                                            },
                                            {
                                                "example_id": "414046de-366c-49c0-8f09-5cedc0c461fe",
                                                "sense_id": "37afe762-3335-31f6-b263-e58e4c70c4be",
                                                "text": "„Panenská, bezcitná, vilná, vzteklá a pyšná, – vypráhlá jako troud, jako troud – a zlá; vy jste zlá; vy jste palčivá samou krutostí a nenávistná a bez srdce; vy jste zlá a k prasknutí nabitá náruživostí; nedotknutelná, chtivá, tvrdá, tvrdá k sobě, led a oheň, oheň a led –“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3dfa949c-b8b9-4555-89c3-d4db63dc286f",
                        "source_entry_id": "58cd742b-b9a4-3a61-ae89-cf642e436cf7",
