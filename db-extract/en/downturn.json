                    }
                ],
                "senses": [
                    {
                        "sense_id": "12a5d7c9-da14-3b94-8ec0-d065afc6db0c",
                        "entry_id": "c0e32f16-be09-3a12-b770-52f7a9b479c6",
                        "glosses": [
                            "A downward trend, or the beginnings of one."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f660f36-4f1c-41a7-8a0d-b5101aaba364",
                                "sense_id": "12a5d7c9-da14-3b94-8ec0-d065afc6db0c",
                                "text": "Near-synonym: decline"
                            },
                            {
                                "example_id": "e4d677cd-e1d9-4951-9c40-dc0b51dfa3bc",
                                "sense_id": "12a5d7c9-da14-3b94-8ec0-d065afc6db0c",
                                "text": "The downturn in the economy made it harder to find jobs."
                            },
                            {
                                "example_id": "ca957f76-e63f-47e6-a1b4-7923a9e10a53",
                                "sense_id": "12a5d7c9-da14-3b94-8ec0-d065afc6db0c",
                                "text": "Any [economic] downturn will eventually impact on rail freight, and indeed passenger traffic, so operators are watching this closely."
                            },
                            {
                                "example_id": "66f51773-ae4a-4072-8771-a4b9b65e8ef1",
                                "sense_id": "12a5d7c9-da14-3b94-8ec0-d065afc6db0c",
                                "text": "In the 1950s, the downturn in BR's financial performance can be illustrated by its declining market share. Between 1951 and 1961, the railways' market share of passenger business fell from 21% to 14%, and for freight from 45% to 29%."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2c83c12-1832-47d0-b6d9-04ef843b0efa",
                        "source_entry_id": "c0e32f16-be09-3a12-b770-52f7a9b479c6",
                        "source_sense_id": "12a5d7c9-da14-3b94-8ec0-d065afc6db0c",
                        "source_sense_description": "a downward trend, or the beginnings of one",
                        "target_lang_word": "ralentissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ralentissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c9d83f1-3d0f-3751-a280-417bdd2fdb30",
                                        "entry_id": "92ab4d39-a7a9-3333-abcf-17267a9c0873",
                                        "glosses": [
                                            "Diminution de vitesse, de mouvement, d’activité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc28795d-e1aa-4c6e-8a1c-9c7a26e0f06c",
                                                "sense_id": "0c9d83f1-3d0f-3751-a280-417bdd2fdb30",
                                                "text": "La plainte psychoémotionnelle se mélange au ralentissement physiologique."
                                            },
                                            {
                                                "example_id": "f0fe95a7-dc49-492b-9709-578ec06c53ed",
                                                "sense_id": "0c9d83f1-3d0f-3751-a280-417bdd2fdb30",
                                                "text": "Le manque d’argent a amené un ralentissement des travaux."
                                            },
                                            {
                                                "example_id": "78b9d10c-71c8-4685-abeb-8673a4d016fd",
                                                "sense_id": "0c9d83f1-3d0f-3751-a280-417bdd2fdb30",
                                                "text": "Le ralentissement de son zèle, de son ardeur."
                                            },
                                            {
                                                "example_id": "3dcaa64a-ead1-4752-aa0e-0a76668e1d4a",
                                                "sense_id": "0c9d83f1-3d0f-3751-a280-417bdd2fdb30",
                                                "text": "D’après lui, ce sont les effets de la pandémie qui compliquent les choses. « Ce n’est pas parce que l’on achète des porcs en Ontario que la situation est plus difficile en ce moment, c’est à cause des ralentissements », précise-t-il."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a2c3a05-a9d5-36d5-b45c-6c14871960a3",
                                        "entry_id": "92ab4d39-a7a9-3333-abcf-17267a9c0873",
                                        "glosses": [
                                            "File de véhicules qui circulent à faible vitesse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a453681f-8b0f-3f1a-a26d-6bfcb1f50dfc",
                                        "entry_id": "92ab4d39-a7a9-3333-abcf-17267a9c0873",
                                        "glosses": [
                                            "Ralentissement des neutrons."
                                        ],
                                        "tags": [
                                            "Physique des réacteurs nucléaires"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff30f3b4-05ba-4def-bd14-f9faf4f1f631",
                        "source_entry_id": "c0e32f16-be09-3a12-b770-52f7a9b479c6",
                        "source_sense_id": "12a5d7c9-da14-3b94-8ec0-d065afc6db0c",
                        "source_sense_description": "a downward trend, or the beginnings of one",
                        "target_lang_word": "déclin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déclin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12711039-7f79-3765-ad86-0ec99b87b14b",
                                        "entry_id": "6c230322-3bd8-313a-a4be-5a61d0648c72",
                                        "glosses": [
                                            "État d’une chose qui penche vers sa fin, qui arrive au terme de son cours, qui perd de sa force, de son éclat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63434127-63d5-41af-8167-2cbcc54da056",
                                                "sense_id": "12711039-7f79-3765-ad86-0ec99b87b14b",
                                                "text": "Toujours dure et sauvage, la mer de Bretagne a quelquefois des colères subites. Elle se soulevait ainsi tout à coup au déclin d'une splendide journée de juillet."
                                            },
                                            {
                                                "example_id": "0186327f-f10b-48a2-b2db-48cf65902d3f",
                                                "sense_id": "12711039-7f79-3765-ad86-0ec99b87b14b",
                                                "text": "Mais venez, au déclin du jour, contempler notre flotte joyeuse, groupée autour du vaisseau amiral qui porte les pères de la patrie et les héros de la fête."
                                            },
                                            {
                                                "example_id": "badae077-f32b-49c5-9e09-37110386f3a3",
                                                "sense_id": "12711039-7f79-3765-ad86-0ec99b87b14b",
                                                "text": "[…]; Azemmour, la ville maure remontant à l’antiquité, en plein déclin aujourd'hui par suite de l’ensablement de son port et l’indolence de sa population; […]."
                                            },
                                            {
                                                "example_id": "5b12f9fe-563b-4304-bd25-d330179d92ee",
                                                "sense_id": "12711039-7f79-3765-ad86-0ec99b87b14b",
                                                "text": "Question oiseuse, aussi oiseuse que de demander si elle aurait pu empêcher […] le lent déclin, la désorganisation graduelle, qui, phase après phase, a délabré l’Empire occidental."
                                            },
                                            {
                                                "example_id": "b73d035f-694d-49a9-b606-91180e558856",
                                                "sense_id": "12711039-7f79-3765-ad86-0ec99b87b14b",
                                                "text": "Une natalité insuffisante et, on va le voir, une mortalité trop forte se conjuguent pour marquer le déclin progressif de la population de ce département."
                                            },
                                            {
                                                "example_id": "690bec97-4d20-437c-a2fc-d2c960cc9127",
                                                "sense_id": "12711039-7f79-3765-ad86-0ec99b87b14b",
                                                "text": "En outre, l'organisation de la famille française s'est achevée sous l'influence du droit canon et du droit romain qui revêtaient hier encore un aspect d'éternité et qui nous surprennent aujourd'hui par l'imminence de leur déclin."
                                            },
                                            {
                                                "example_id": "46ae1754-5b6d-45bb-925c-40a173e5c258",
                                                "sense_id": "12711039-7f79-3765-ad86-0ec99b87b14b",
                                                "text": "Dans les autres régions, constate l'INESSS, \"le nombre d’hospitalisations projetées poursuit son déclin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd13064b-a04a-37ff-a9f7-08d0308bdfa7",
                                        "entry_id": "6c230322-3bd8-313a-a4be-5a61d0648c72",
                                        "glosses": [
                                            "La dernière phase, le dernier quartier de la lune."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49fcea51-c68a-4fb8-966a-4324cb105033",
