                "senses": [
                    {
                        "sense_id": "d08df299-011f-3d2a-b297-1065d677a31f",
                        "entry_id": "ec39d2f1-aa81-38a7-8b45-24939962cf2d",
                        "glosses": [
                            "D’une substance : qui donne à la lumière un certain degré de polarisation."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fe4bb664-8053-33fb-a92a-94c23ecab1b3",
                        "entry_id": "ec39d2f1-aa81-38a7-8b45-24939962cf2d",
                        "glosses": [
                            "D’un appareil optique : qui utilise une lumière polarisée."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "8f6b72e5-57bf-4be2-a1b3-c7bdd8e5321f",
                                "sense_id": "fe4bb664-8053-33fb-a92a-94c23ecab1b3",
                                "text": "Un rapide examen au microscope polarisant montre la dualité de la composition minéralogique, des grains de quartz détritiques (indiquant une érosion continentale) et des oxydes de fer comme l'hématite et la magnétite."
                            },
                            {
                                "example_id": "c4766da7-3c88-498b-a7cd-fe009795e2a7",
                                "sense_id": "fe4bb664-8053-33fb-a92a-94c23ecab1b3",
                                "text": "Les verres polarisants bloquent la lumière qui atteint l’œil sous un certain angle après avoir été réfléchie par une surface, comme une route ou de l’eau, réduisant ainsi l’éblouissement."
                            }
                        ]
                    },
                    {
                        "sense_id": "58f34c98-86dc-3542-b2b9-1ca2f84c9065",
                        "entry_id": "ec39d2f1-aa81-38a7-8b45-24939962cf2d",
                        "glosses": [
                            "Qui renvoie les gens vers des interprétations totalement opposées, parfois extrêmes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2b3f3945-9849-4fa5-85df-bbd6e4fb156b",
                                "sense_id": "58f34c98-86dc-3542-b2b9-1ca2f84c9065",
                                "text": "C’est le tournant décisif dans l’épuisante et polarisante saga trumpéteuse^([sic])."
                            },
                            {
                                "example_id": "a5ed0062-92cd-42a1-ab04-f150949ab37c",
                                "sense_id": "58f34c98-86dc-3542-b2b9-1ca2f84c9065",
                                "text": "Cependant, son mandat n’a pas été exempt de controverses, notamment en raison de son style parfois polarisant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "926da924-3cba-483d-adf7-70e90febbb1d",
