                                        "sense_id": "11365be0-bcc3-3d58-8dc6-5ae39d822997",
                                        "entry_id": "39ad0fba-9f29-332e-8b30-eeec455364f1",
                                        "glosses": [
                                            "Geldbeihilfe für Schüler und Studierende oder für wissenschaftlichen, künstlerischen Nachwuchs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a1b0624-4994-4260-a75a-ccc385fe8882",
                                                "sense_id": "11365be0-bcc3-3d58-8dc6-5ae39d822997",
                                                "text": "Das BAföG ist eine Art Stipendium."
                                            },
                                            {
                                                "example_id": "ca5263e2-4b5d-489b-b804-b56e01a9a0ea",
                                                "sense_id": "11365be0-bcc3-3d58-8dc6-5ae39d822997",
                                                "text": "Anna hatte sich im Herbst um ein Stipendium bei der Hamburger Stiftung beworben."
                                            },
                                            {
                                                "example_id": "817c3cec-5e31-43fd-997e-0416f57a7d32",
                                                "sense_id": "11365be0-bcc3-3d58-8dc6-5ae39d822997",
                                                "text": "„Durch das Stipendium einer wohltätigen Stiftung war er angemessen versorgt, doch neigte er dazu, Geld zu horten, einfach um des Sparens willen.“"
                                            },
                                            {
                                                "example_id": "4d805d69-4af1-47de-bf3f-c409bf94965d",
                                                "sense_id": "11365be0-bcc3-3d58-8dc6-5ae39d822997",
                                                "text": "„Arbeitskräfte oder arbeitslose Personen, können für die Dauer einer Fachkräfteausbildung ein Stipendium erhalten, wenn sie folgende Voraussetzungen erfüllen: …“"
                                            },
                                            {
                                                "example_id": "0ba25e68-2af4-4393-840e-ea5f083fd9e1",
                                                "sense_id": "11365be0-bcc3-3d58-8dc6-5ae39d822997",
                                                "text": "„Er war begabt, ein Stipendium für die höhere Schule traf den Richtigen.“"
                                            },
                                            {
                                                "example_id": "a6c1d9b7-906d-40b5-86fb-ad8a8bca2176",
                                                "sense_id": "11365be0-bcc3-3d58-8dc6-5ae39d822997",
                                                "text": "„Ich will mit einem staatlichen Stipendium eine Reise nach Kaukasien, dem Orient, Persien und der Türkei machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
