                    },
                    {
                        "translation_id": "3a5d1656-a81b-479f-81e0-847df63ce20b",
                        "source_entry_id": "8dec15ce-ac99-39cb-9c9b-39c268a3e98a",
                        "source_sense_id": "6416f18a-d51a-321c-9736-c5fdd2efbf3d",
