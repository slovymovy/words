                                                "sense_id": "641c4732-5761-3653-9d4c-9a2644b1b18b",
                                                "text": "Na dowód tego przytaczam niektóre ustępy z moich broszur i artykułów."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "26775368-9510-3ed6-8b50-8e0ce7aa6cb2",
                                        "entry_id": "7b187657-a627-372d-8c97-844300b79b0a",
                                        "glosses": [
                                            "niewielka publikacja o treści informacyjnej"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "534b4347-ec42-410c-bb0f-caef2091e896",
                                                "sense_id": "26775368-9510-3ed6-8b50-8e0ce7aa6cb2",
                                                "text": "Podatnicy mieli do dyspozycji również broszury informacyjne i prezentacje multimedialne."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8283c532-ebfa-4230-aba4-7095f75f91ec",
