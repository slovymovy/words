{
    "word_family": [
        "order",
        "orderliness",
        "disorderly",
        "disorder",
        "ordered"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fddf8bb7-48f2-3fb1-b428-4cf93023ab06",
                    "sense_definition": "neat and tidy; possessing order",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "neatness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has always kept an <w>orderly</w> kitchen, with nothing out of place.",
                            "target_lang_translations": {
                                "ru": "Он всегда содержал кухню в <w>безупречном порядке</w>, где каждая вещь была на своем месте.",
                                "zh": "他总是把厨房保持得非常<w>整洁</w>，东西都各归其位。"
                            }
                        },
                        {
                            "text": "The books were arranged in an <w>orderly</w> fashion on the wooden shelves.",
                            "target_lang_translations": {
                                "ru": "Книги были <w>аккуратно</w> расставлены на деревянных полках.",
                                "zh": "书架上的书摆放得十分<w>有序</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "neat",
                        "tidy",
                        "well-kept",
                        "shipshape",
                        "in order",
                        "organized"
                    ],
                    "antonyms": [
                        "disorderly"
                    ],
                    "common_phrases": [
                        "orderly fashion",
                        "orderly manner"
                    ],
                    "target_lang_definitions": {
                        "ru": "аккуратный и опрятный; содержащийся в порядке",
                        "zh": "整洁、有序的；处于良好状态的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аккуратный",
                                "target_lang_sense_clarification": "о вещах или месте"
                            },
                            {
                                "target_lang_word": "опрятный",
                                "target_lang_sense_clarification": "чистый и прибранный"
                            },
                            {
                                "target_lang_word": "прибранный",
                                "target_lang_sense_clarification": "находящийся в порядке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "整洁",
                                "target_lang_sense_clarification": "形容物品或环境干净有序"
                            },
                            {
                                "target_lang_word": "有序",
                                "target_lang_sense_clarification": "形容事物排列整齐"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b48933e-0222-3538-b341-f45a26d8803c",
                    "sense_definition": "peaceful and well-behaved",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An <w>orderly</w> gathering of citizens stood on the corner awaiting the bus.",
                            "target_lang_translations": {
                                "ru": "<w>Дисциплинированная</w> группа граждан стояла на углу в ожидании автобуса.",
                                "zh": "一群<w>守纪律</w>的市民站在街角等候公交车。"
                            }
                        },
                        {
                            "text": "The protest remained <w>orderly</w> and calm throughout the entire afternoon.",
                            "target_lang_translations": {
                                "ru": "Протест оставался <w>мирным</w> и спокойным в течение всего дня.",
                                "zh": "整个下午，抗议活动一直保持得非常<w>有秩序</w>且平静。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ruly"
                    ],
                    "antonyms": [
                        "disorderly"
                    ],
                    "common_phrases": [
                        "orderly crowd",
                        "orderly conduct"
                    ],
                    "target_lang_definitions": {
                        "ru": "мирный, спокойный и соблюдающий дисциплину",
                        "zh": "和平的、守纪律的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дисциплинированный",
                                "target_lang_sense_clarification": "о поведении людей"
                            },
                            {
                                "target_lang_word": "мирный",
                                "target_lang_sense_clarification": "без беспорядков"
                            },
                            {
                                "target_lang_word": "спокойный",
                                "target_lang_sense_clarification": "организованный и тихий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "守纪律",
                                "target_lang_sense_clarification": "形容行为符合规范"
                            },
                            {
                                "target_lang_word": "有秩序",
                                "target_lang_sense_clarification": "形容群体行为平和且规范"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d97816e-bd58-393e-aec9-d80636d83d74",
                    "sense_definition": "methodical or systematic",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "systematic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We live in an <w>orderly</w> universe, where rules govern both the movements of planets and the binding of molecules.",
                            "target_lang_translations": {
                                "ru": "Мы живем в <w>упорядоченной</w> вселенной, где правила управляют как движением планет, так и связями молекул.",
                                "zh": "我们生活在一个<w>有条理</w>的宇宙中，规则支配着行星的运动和分子的结合。"
                            }
                        },
                        {
                            "text": "The scientist followed an <w>orderly</w> process to ensure the results were accurate.",
                            "target_lang_translations": {
                                "ru": "Ученый следовал <w>строгому порядку</w> действий, чтобы гарантировать точность результатов.",
                                "zh": "科学家遵循了<w>系统性</w>的流程以确保结果准确。"
                            }
                        }
                    ],
                    "synonyms": [
                        "regular"
                    ],
                    "common_phrases": [
                        "orderly process",
                        "orderly progression"
                    ],
                    "target_lang_definitions": {
                        "ru": "методичный, систематический или последовательный",
                        "zh": "有条理的、系统性的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упорядоченный",
                                "target_lang_sense_clarification": "организованный по системе"
                            },
                            {
                                "target_lang_word": "методичный",
                                "target_lang_sense_clarification": "следующий четкому плану"
                            },
                            {
                                "target_lang_word": "систематический",
                                "target_lang_sense_clarification": "основанный на системе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有条理",
                                "target_lang_sense_clarification": "形容做事有系统"
                            },
                            {
                                "target_lang_word": "系统性",
                                "target_lang_sense_clarification": "形容遵循特定逻辑或方法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c297f3d0-e7dc-36c7-ae29-8617fa9ff332",
                    "sense_definition": "being on duty; keeping order; conveying orders",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "duty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>orderly</w> officer was responsible for inspecting the barracks every morning.",
                            "target_lang_translations": {
                                "ru": "<w>Дежурный</w> офицер отвечал за осмотр казарм каждое утро.",
                                "zh": "<w>值班</w>军官负责每天早上检查营房。"
                            }
                        },
                        {
                            "text": "He was assigned as the <w>orderly</w> sergeant for the duration of the exercise.",
                            "target_lang_translations": {
                                "ru": "На время учений он был назначен <w>дежурным</w> сержантом.",
                                "zh": "演习期间，他被指派担任<w>值班</w>中士。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "orderly officer",
                        "orderly room"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "military context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "дежурный; ответственный за поддержание порядка или передачу приказов",
                        "zh": "值班的；负责维持秩序或传达命令的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дежурный",
                                "target_lang_sense_clarification": "находящийся при исполнении обязанностей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "值班",
                                "target_lang_sense_clarification": "处于工作状态或负责特定任务"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cbae4ef8-771e-3263-b356-0d1b5728ec65",
                    "sense_definition": "a hospital attendant given a variety of non-medical duties",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_staff",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital <w>orderly</w> helped move the patient from the emergency room to the ward.",
                            "target_lang_translations": {
                                "ru": "Больничный <w>санитар</w> помог перевезти пациента из приемного покоя в палату.",
                                "zh": "医院<w>护工</w>帮忙把病人从急诊室转到了病房。"
                            }
                        },
                        {
                            "text": "A medical <w>orderly</w> is responsible for transporting equipment and maintaining cleanliness.",
                            "target_lang_translations": {
                                "ru": "Медицинский <w>санитар</w> отвечает за транспортировку оборудования и поддержание чистоты.",
                                "zh": "医用<w>勤务员</w>负责搬运设备和保持清洁。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hospital orderly",
                        "medical orderly"
                    ],
                    "target_lang_definitions": {
                        "ru": "больничный служитель, выполняющий вспомогательные немедицинские обязанности",
                        "zh": "医院中负责非医疗辅助工作的勤务人员"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "санитар",
                                "target_lang_sense_clarification": "мужчина, младший медперсонал"
                            },
                            {
                                "target_lang_word": "санитарка",
                                "target_lang_sense_clarification": "женщина, младший медперсонал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "护工",
                                "target_lang_sense_clarification": "医院中负责护理辅助工作的员工"
                            },
                            {
                                "target_lang_word": "勤务员",
                                "target_lang_sense_clarification": "负责杂务的辅助人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6b3d211-a37b-3b14-9bb4-9d3db23b2c42",
                    "sense_definition": "a soldier who carries out minor tasks for a superior officer",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military_staff",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general's <w>orderly</w> delivered the message to the front lines immediately.",
                            "target_lang_translations": {
                                "ru": "<w>Ординарец</w> генерала немедленно доставил донесение на передовую.",
                                "zh": "将军的<w>传令兵</w>立即将消息送到了前线。"
                            }
                        },
                        {
                            "text": "He served as an <w>orderly</w> during the war, assisting the colonel with daily tasks.",
                            "target_lang_translations": {
                                "ru": "Во время войны он служил <w>вестовым</w>, помогая полковнику в повседневных делах.",
                                "zh": "战争期间他担任<w>勤务兵</w>，协助上校处理日常事务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "batman"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "military context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "военнослужащий, выполняющий поручения офицера",
                        "zh": "为高级军官处理日常琐事的士兵"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ординарец",
                                "target_lang_sense_clarification": "для связи и поручений"
                            },
                            {
                                "target_lang_word": "вестовой",
                                "target_lang_sense_clarification": "для передачи сообщений"
                            },
                            {
                                "target_lang_word": "денщик",
                                "target_lang_sense_clarification": "исторический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勤务兵",
                                "target_lang_sense_clarification": "军队中负责辅助工作的士兵"
                            },
                            {
                                "target_lang_word": "传令兵",
                                "target_lang_sense_clarification": "负责传递命令的士兵"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a43ea2e0-1403-37a8-96bb-1fe09d2a593b",
                    "sense_definition": "according to good order or practice; in a well-behaved or orderly way",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rectangles are <w>orderly</w> stacked with the topmost rectangle representing the most visible entity.",
                            "target_lang_translations": {
                                "ru": "Прямоугольники <w>аккуратно</w> сложены в стопку, при этом верхний прямоугольник представляет собой наиболее видимый объект.",
                                "zh": "矩形被<w>整齐地</w>堆叠在一起，最顶层的矩形代表最显眼的实体。"
                            }
                        },
                        {
                            "text": "The students were told to proceed <w>orderly</w> through the hallway to the assembly.",
                            "target_lang_translations": {
                                "ru": "Ученикам велели <w>организованно</w> пройти по коридору в актовый зал.",
                                "zh": "学生们被告知要<w>有秩序地</w>穿过走廊去参加集会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "methodically",
                        "systematically"
                    ],
                    "common_phrases": [
                        "orderly stacked"
                    ],
                    "target_lang_definitions": {
                        "ru": "надлежащим образом; организованно или дисциплинированно",
                        "zh": "以整齐、守纪律的方式"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "организованно",
                                "target_lang_sense_clarification": "согласно порядку"
                            },
                            {
                                "target_lang_word": "по порядку",
                                "target_lang_sense_clarification": "последовательно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有秩序地",
                                "target_lang_sense_clarification": "形容动作或过程井然有序"
                            },
                            {
                                "target_lang_word": "整齐地",
                                "target_lang_sense_clarification": "形容排列或移动的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e9680f6-ec9f-322a-83a0-4289b066fd50",
                    "sense_definition": "in a particular order or succession; with a suitable arrangement",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The earth from heaven, the sea from earth, he parted <w>orderly</w>.",
                            "target_lang_translations": {
                                "ru": "Землю от небес, а море от земли он отделил <w>в должном порядке</w>.",
                                "zh": "他将天与地、地与海<w>依次</w>分开。"
                            }
                        },
                        {
                            "text": "The artifacts were laid <w>orderly</w> in the tomb according to their historical significance.",
                            "target_lang_translations": {
                                "ru": "Артефакты были <w>последовательно</w> разложены в гробнице в соответствии с их исторической значимостью.",
                                "zh": "墓中的文物根据其历史重要性被<w>有条不紊地</w>摆放着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "methodically",
                        "systematically"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adverb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "в определенной последовательности или надлежащем расположении",
                        "zh": "按特定顺序或适当安排"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стройно",
                                "target_lang_sense_clarification": "в правильном порядке"
                            },
                            {
                                "target_lang_word": "последовательно",
                                "target_lang_sense_clarification": "один за другим"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "依次",
                                "target_lang_sense_clarification": "按照先后顺序"
                            },
                            {
                                "target_lang_word": "有条不紊地",
                                "target_lang_sense_clarification": "形容安排得当"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}