                ],
                "senses": [
                    {
                        "sense_id": "d59e4b00-6ccc-3117-a3aa-5cbbd293aec0",
                        "entry_id": "732045fa-5b3f-3986-bbc2-4477aed5cb87",
                        "glosses": [
                            "Anxious or uneasy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d088acfc-8bd1-42b9-885b-58e1ca0497e4",
                                "sense_id": "d59e4b00-6ccc-3117-a3aa-5cbbd293aec0",
                                "text": "I'm distressed that sexy John hasn't answered my calls. I hope nothing bad happened to him on the way here."
                            },
                            {
                                "example_id": "84376eaf-c6c8-4bfe-8fc1-e9187585ea41",
                                "sense_id": "d59e4b00-6ccc-3117-a3aa-5cbbd293aec0",
                                "text": "Oh that thou wer't not, poore distreſſed ſoule."
                            },
                            {
                                "example_id": "884a4b85-0ad4-493d-9cce-420919b11181",
                                "sense_id": "d59e4b00-6ccc-3117-a3aa-5cbbd293aec0",
                                "text": "Wee are troubled on euery side, yet not distressed; we are perplexed, but not in despaire,"
                            },
                            {
                                "example_id": "59885a9a-1255-4a12-a432-992546b499e9",
                                "sense_id": "d59e4b00-6ccc-3117-a3aa-5cbbd293aec0",
                                "text": "Now, I saw, upon a time, when he was walking in the fields, that he was, as he was wont, reading in his book, and greatly distressed in his mind; and, as he read, he burst out, as he had done before, crying, \"What shall I do to be saved?\""
                            }
                        ]
                    },
                    {
                        "sense_id": "0c229a65-068c-3507-8c17-e8f1dc0af029",
                        "entry_id": "732045fa-5b3f-3986-bbc2-4477aed5cb87",
                        "glosses": [
                            "Damaged."
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "49985e11-635b-3ffe-84e6-bc18f34ee340",
                        "entry_id": "732045fa-5b3f-3986-bbc2-4477aed5cb87",
                        "glosses": [
                            "Offered for sale after foreclosure."
                        ],
                        "tags": [
                            "of a property"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e22e6205-b249-3588-9c70-e574d69bc69a",
                        "entry_id": "732045fa-5b3f-3986-bbc2-4477aed5cb87",
                        "glosses": [
                            "Faded or abused in order to appear old, or antique."
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "117101b9-011a-443c-90cc-d2f7a6956d65",
                                "sense_id": "e22e6205-b249-3588-9c70-e574d69bc69a",
                                "text": "Distressed jeans bear all the signs of exertion, while the consumer never has to lift a finger. What could be more luxurious than that?"
                            },
                            {
                                "example_id": "d85e5b5d-c8e7-4e00-8cbb-e99e062fcef8",
                                "sense_id": "e22e6205-b249-3588-9c70-e574d69bc69a",
                                "text": "Lawyers for Hirst accepted that his works had on occasion “been made to look older or distressed”."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5bcb3d1-bb67-3f7d-bfac-bbc627f28771",
                        "entry_id": "732045fa-5b3f-3986-bbc2-4477aed5cb87",
                        "glosses": [
                            "Experiencing financial or operational distress, default, or bankruptcy."
                        ],
                        "tags": [
                            "of securities"
                        ],
                        "examples": [
                            {
                                "example_id": "3f964771-1ec2-4563-8b6e-c7fc7d605673",
                                "sense_id": "c5bcb3d1-bb67-3f7d-bfac-bbc627f28771",
                                "text": "distressed debt"
                            },
                            {
                                "example_id": "ecec9547-f3b4-4bd8-a404-931c4f1d3155",
                                "sense_id": "c5bcb3d1-bb67-3f7d-bfac-bbc627f28771",
                                "text": "Funds that buy “distressed” debt, which typically yields ten percentage points or more over Treasuries, are becoming familiar villains."
                            },
                            {
                                "example_id": "f88e569b-3d2a-4a61-9ce8-adb6ae78533b",
                                "sense_id": "c5bcb3d1-bb67-3f7d-bfac-bbc627f28771",
                                "text": "Sam Zell called himself “the Grave Dancer”, even though, as he explained, his penchant for buying distressed assets “wasn’t so much dancing on graves as …raising the dead”."
                            },
                            {
                                "example_id": "f159e36e-53c4-46f0-848e-af59c101fa96",
                                "sense_id": "c5bcb3d1-bb67-3f7d-bfac-bbc627f28771",
                                "text": "One multibillion-dollar firm that specialises in distressed debt called X's debt “uninvestable”."
                            }
                        ]
                    }
                ],
