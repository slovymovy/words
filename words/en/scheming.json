{
    "word_family": [
        "scheme",
        "schemer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f63b915d-dbae-30c5-a07b-2fce47ff77d0",
                    "sense_definition": "Given to forming secret, devious, or deceitful plans.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scheming_deceitful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain was portrayed as a <w>scheming</w> politician who would stop at nothing to gain power.",
                            "target_lang_translations": {
                                "es": "El villano fue retratado como un político <w>intrigante</w> que no se detendría ante nada para conseguir poder."
                            }
                        },
                        {
                            "text": "Be careful around him because he is a <w>scheming</w> person who only looks out for himself.",
                            "target_lang_translations": {
                                "es": "Ten cuidado con él porque es una persona <w>maquinadora</w> que solo mira por sí misma."
                            }
                        }
                    ],
                    "synonyms": [
                        "designing"
                    ],
                    "common_phrases": [
                        "scheming politician"
                    ],
                    "target_lang_definitions": {
                        "es": "Dado a formar planes secretos, taimados o engañosos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "intrigante",
                                "target_lang_sense_clarification": "que suele tramar intrigas o actuar con disimulo"
                            },
                            {
                                "target_lang_word": "maquinador",
                                "target_lang_sense_clarification": "que urde planes o conspiraciones secretas"
                            },
                            {
                                "target_lang_word": "conspirador",
                                "target_lang_sense_clarification": "que actúa en secreto contra algo o alguien"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f064e469-0cbc-338c-8f94-7b259e048553",
                    "sense_definition": "present participle and gerund of <w>scheme</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scheming_deceitful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were caught <w>scheming</w> behind their manager's back to take over the company.",
                            "target_lang_translations": {
                                "es": "Fueron descubiertos <w>conspirando</w> a espaldas de su gerente para tomar el control de la empresa."
                            }
                        },
                        {
                            "text": "She spent weeks <w>scheming</w> against her rivals to secure the promotion.",
                            "target_lang_translations": {
                                "es": "Pasó semanas <w>maquinando</w> contra sus rivales para asegurarse el ascenso."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scheming against"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Forma en gerundio de scheme: tramar, conspirar o intrigar."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tramando",
                                "target_lang_sense_clarification": "planeando en secreto con mala intención"
                            },
                            {
                                "target_lang_word": "intrigando",
                                "target_lang_sense_clarification": "urdiendo maquinaciones o enredos"
                            },
                            {
                                "target_lang_word": "maquinando",
                                "target_lang_sense_clarification": "planificando algo con astucia o engaño"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d606b96-4b7c-3a44-82d3-fcae903e0a6a",
                    "sense_definition": "The activity or practice of making secret or underhanded plans.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scheming_deceitful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His endless <w>scheming</w> eventually cost him the trust of all his closest allies.",
                            "target_lang_translations": {
                                "es": "Sus constantes <w>maquinaciones</w> finalmente le costaron la confianza de todos sus aliados más cercanos."
                            }
                        },
                        {
                            "text": "She refused to participate in the political <w>scheming</w> that dominated the committee meetings.",
                            "target_lang_translations": {
                                "es": "Se negó a participar en las <w>intrigas</w> políticas que dominaban las reuniones del comité."
                            }
                        }
                    ],
                    "common_phrases": [
                        "political scheming"
                    ],
                    "target_lang_definitions": {
                        "es": "Actividad o práctica de planear intrigas o maniobras secretas y engañosas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "intrigas",
                                "target_lang_sense_clarification": "maniobras o confabulaciones secretas"
                            },
                            {
                                "target_lang_word": "maquinaciones",
                                "target_lang_sense_clarification": "planes ocultos y maliciosos"
                            },
                            {
                                "target_lang_word": "manejos",
                                "target_lang_sense_clarification": "artimañas o tejemanejes para conseguir un fin"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}