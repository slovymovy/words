                            {
                                "example_id": "4d7f9cf8-40cb-4fd8-8fd8-12cc1c69a51e",
                                "sense_id": "5b3a338f-c5ad-34be-937f-5a8474266f93",
                                "text": "Toch is dat niet het hele verhaal. Want ook armoede en onderontwikkeling leggen zwaar beslag op de natuur. Zo blijkt uit een studie van de Universiteit van Leuven dat kleine boeren op zoek naar nieuwe landbouwgronden de belangrijkste oorzaak zijn van ontbossing in het Congobekken, het grootste regenwoudgebied van Afrika."
                            }
                        ]
