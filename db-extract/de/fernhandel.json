                        "examples": [
                            {
                                "example_id": "d3258117-33c3-4ff8-b34a-4b7fff1d4fcd",
                                "sense_id": "ffece2d4-ce04-3daf-92d0-b8061fa963e3",
                                "text": "„Zugute kommt das Münzwesen vor allem dem Fernhandel.“"
                            },
                            {
                                "example_id": "23072b2c-f59f-4c05-ab9c-523e3175cd6b",
                                "sense_id": "ffece2d4-ce04-3daf-92d0-b8061fa963e3",
                                "text": "„Die frühesten Quellen erwähnen meist nur einzelne Kaufleute, die im Fernhandel tätig waren, einige von ihnen mit Familie.“"
                            },
                            {
                                "example_id": "aec89a9b-9e73-49f7-948e-30104facfcc0",
                                "sense_id": "ffece2d4-ce04-3daf-92d0-b8061fa963e3",
                                "text": "„Der Fernhandel nahm zu.“"
                            }
                        ],
