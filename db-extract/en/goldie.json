                "senses": [
                    {
                        "sense_id": "5ddc02fc-09f2-3aea-b35a-1a07d0490d48",
                        "entry_id": "9aabd2dd-5926-34a2-adb5-930fcc41b50c",
                        "glosses": [
                            "A female given name from English for a girl with golden hair, mostly American usage around 1900. It was further popularized by actress Goldie Hawn"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1b2d604f-4f40-3e8c-8cc3-ef2871a3ba1a",
