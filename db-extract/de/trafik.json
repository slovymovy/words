                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "338ec66c-0b61-3482-82b4-87feefa26190",
                                        "entry_id": "e4d56f87-6171-3e78-a283-b79820286bf0",
