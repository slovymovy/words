                ],
                "senses": [
                    {
                        "sense_id": "6ff80b47-72af-38b7-a2f9-26e15c637ccc",
                        "entry_id": "c9f53a9f-2e32-3d87-bbcf-ed5f314b2989",
                        "glosses": [
                            "ausgestorbener Verwandter des heutigen Menschen aus der Gattung Homo"
                        ],
                        "tags": [
                            "Anthropologie"
                        ],
                        "examples": [
                            {
                                "example_id": "2ab38ee2-b69c-4a09-9c91-de354eb172e9",
                                "sense_id": "6ff80b47-72af-38b7-a2f9-26e15c637ccc",
                                "text": "Die Neandertaler bilden einen ausgestorbenen Zweig der Entwicklung der Menschheit."
                            },
                            {
                                "example_id": "4367c4b2-5df5-42ee-9b8c-ca8479e23721",
                                "sense_id": "6ff80b47-72af-38b7-a2f9-26e15c637ccc",
                                "text": "Es ist eben ein umfassender Verein »d' Neandertaler«, der die Kulturbedürfnisse vom Belt bis Hallstatt regelt, und sein Leibgesang, wenn er sich nicht an edleren Dichtungen vergreift, ist und bleibt: »Neandertal, du bist mei Freud«. (Karl Kraus: Vor der Walpurgisnacht - Aufsätze 1925-1936 (Kapitel 20))"
                            },
                            {
                                "example_id": "27535c51-0e46-4951-8c2a-bbc202ce41c5",
                                "sense_id": "6ff80b47-72af-38b7-a2f9-26e15c637ccc",
                                "text": "„Carl Heinrich Fuhlrott, der fast vergessene Entdecker des Neandertalers, wurde in Leinefelde geboren und war Lehrer am Gymnasium in Heiligenstadt.“"
                            },
                            {
                                "example_id": "cc7542e0-609f-40f8-8e5b-502c3eff6a92",
                                "sense_id": "6ff80b47-72af-38b7-a2f9-26e15c637ccc",
                                "text": "„Die Neandertaler waren stark gebaut und besaßen besonders dickwandige Knochen.“"
                            },
                            {
                                "example_id": "f618e801-2872-49d6-b7df-a02614dcc55e",
                                "sense_id": "6ff80b47-72af-38b7-a2f9-26e15c637ccc",
                                "text": "„Vielleicht ist einem Neandertaler ein Stein auf den Zeh gefallen, und vor Schmerz umherhüpfend hat er lautstark Umlaute von sich gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5b2daf4-e784-4f6e-966b-0bcafaf7e2b2",
                        "source_entry_id": "c9f53a9f-2e32-3d87-bbcf-ed5f314b2989",
                        "source_sense_id": "6ff80b47-72af-38b7-a2f9-26e15c637ccc",
