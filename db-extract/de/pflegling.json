                                "sense_id": "ae8f30c4-f4c3-3bbb-9e61-3b965e908e46",
                                "text": "„Die Zahl der Pfleglinge wuchs; schließlich kamen auf einen Dorfbewohner vier bis fünf Kranke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
