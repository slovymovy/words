                "senses": [
                    {
                        "sense_id": "87b6d479-e540-3382-86b8-04ae02f7467e",
                        "entry_id": "4c1cf269-e791-32e2-badd-1bca2d2d1379",
                        "glosses": [
                            "Selbstbezeichnung eines einzelnen Menschen der nordamerikanischen und grönländischen Eskimovölker"
                        ],
                        "tags": [
                            "meistens im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "a7547bef-d107-4776-95b4-41103ca7c926",
                                "sense_id": "87b6d479-e540-3382-86b8-04ae02f7467e",
                                "text": "„Die Forscher haben ihn Inuk genannt, das heißt Mensch auf grönländisch, denn im Norden Grönlands hat er gelebt, vor rund 4000 Jahren.“"
                            },
                            {
                                "example_id": "9f19539f-f4d4-4153-a67f-8f8497740cb8",
                                "sense_id": "87b6d479-e540-3382-86b8-04ae02f7467e",
                                "text": "„Vorfahren der Inuit haben einst hier gelebt, sind aus unbekannten Gründen aber wieder verschwunden.“"
                            },
                            {
                                "example_id": "de767ccc-d193-47f5-a535-de25c84f4a9d",
                                "sense_id": "87b6d479-e540-3382-86b8-04ae02f7467e",
                                "text": "„Sie zeigt zwei Inuit im Kindesalter, die die Arbeit ruhen lassen und ihre Köpfe über ein Buch beugen.“"
                            },
                            {
                                "example_id": "f3fe683c-19ca-41b4-bfb2-ae5a3ee47ccf",
                                "sense_id": "87b6d479-e540-3382-86b8-04ae02f7467e",
                                "text": "„Bei den Inuit dienen Schimpfrituale auch der Belustigung: Wortgefechte werden hier nur mit Witz und Spott ausgetragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
