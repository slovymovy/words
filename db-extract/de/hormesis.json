                    {
                        "translation_id": "801d651a-7ea5-4bb3-aba0-2abc40bc1de2",
                        "source_entry_id": "4f436cca-845c-37af-8a48-442c6a38999a",
                        "source_sense_id": "31a0ce9b-f867-34f4-b12c-1a464c067f58",
