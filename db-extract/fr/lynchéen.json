                        "translation_id": "45e51e20-f50a-4723-bcd1-7e44fc872821",
                        "source_entry_id": "53c1210b-0a0a-3a8d-ace0-44b24691400c",
                        "source_sense_id": "e5adbd12-4f54-34c9-a7d1-acfa6d8c79a3",
