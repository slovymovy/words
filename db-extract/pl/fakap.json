                        "source_sense_id": "6127cfab-06b0-3491-b4c2-70d9ec198e32",
                        "target_lang_word": "fuck up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fuck up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5288c8c9-5c0f-34cd-9616-e158eb9db43a",
                                        "entry_id": "f0caa63c-5f35-35e1-acb1-85d48aa7de9f",
                                        "glosses": [
                                            "To make a mistake, to go wrong."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db1721f9-0b19-4269-9fa7-89279f3f807e",
                                                "sense_id": "5288c8c9-5c0f-34cd-9616-e158eb9db43a",
                                                "text": "You really fucked up this time."
                                            },
                                            {
                                                "example_id": "621e1a3e-5413-4008-8a23-82e06ca7839e",
                                                "sense_id": "5288c8c9-5c0f-34cd-9616-e158eb9db43a",
                                                "text": "Don't you fuck up again."
                                            },
                                            {
                                                "example_id": "877aa645-2182-4444-9cd2-a79536d9f8f0",
                                                "sense_id": "5288c8c9-5c0f-34cd-9616-e158eb9db43a",
                                                "text": "When I was in my 20s and writing my first book—I know, I really fucked up there[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51e90489-041a-33c5-83a6-b9c6bfff6689",
                                        "entry_id": "f0caa63c-5f35-35e1-acb1-85d48aa7de9f",
                                        "glosses": [
                                            "To botch or make a mess of."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4627f50e-878e-43d7-a0e2-9ea61dc773ed",
                                                "sense_id": "51e90489-041a-33c5-83a6-b9c6bfff6689",
                                                "text": "I fucked up question 3 of the exam."
                                            },
                                            {
                                                "example_id": "4879f360-6a93-4039-917d-2596b05c1d60",
                                                "sense_id": "51e90489-041a-33c5-83a6-b9c6bfff6689",
                                                "text": "Don't fuck up your arcade game."
                                            },
                                            {
                                                "example_id": "65b8c952-5e11-4992-a4a3-c4707bd2aaad",
                                                "sense_id": "51e90489-041a-33c5-83a6-b9c6bfff6689",
                                                "text": "Tyrion is made to be a strategic fool. I haven’t been as hard on this aspect of the season as others, because I buy that Tyrion might overestimate himself in military matters. But face-to-face negotiation with power players in the capital? Now that really is his bread and butter, and after a season of fucking things up in Dragonstone, he once again completely misreads the situation in King’s Landing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1328c0e9-cddb-33b3-9270-c281d6460333",
                                        "entry_id": "f0caa63c-5f35-35e1-acb1-85d48aa7de9f",
                                        "glosses": [
                                            "To injure or damage badly."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40925916-dfd1-4c6f-9366-bffc6c39c2fa",
                                                "sense_id": "1328c0e9-cddb-33b3-9270-c281d6460333",
                                                "text": "I fucked up my knee while running the marathon."
                                            },
                                            {
                                                "example_id": "ca35f0a3-578e-47b3-9b5c-114361982d93",
                                                "sense_id": "1328c0e9-cddb-33b3-9270-c281d6460333",
                                                "text": "I'm about to fuck somebody up for betrayal."
                                            },
                                            {
                                                "example_id": "9912d68e-0c2e-443d-bf2c-e569ccbd80e9",
                                                "sense_id": "1328c0e9-cddb-33b3-9270-c281d6460333",
                                                "text": "They fuck you up, your mum and dad.\nThey may not mean to, but they do.\nThey fill you with the faults they had\nAnd add some extra, just for you."
                                            },
                                            {
                                                "example_id": "e14c5ef5-bf7c-4e16-a3f5-8c37d5a4e8fc",
                                                "sense_id": "1328c0e9-cddb-33b3-9270-c281d6460333",
                                                "text": "Mom and Pop, they will fuck you up\nFor sure\nLove so deep, kills you in your sleep\nIt's true"
                                            },
                                            {
                                                "example_id": "65901040-1a0f-44b7-9095-0d58c479f655",
                                                "sense_id": "1328c0e9-cddb-33b3-9270-c281d6460333",
                                                "text": "Shame on a nigga who try to run game on a nigga\nWu buck wild with the trigger!\nShame on a nigga who try to run game on a nigga\nI'll fuck your ass up!"
                                            },
                                            {
                                                "example_id": "e795042f-76f3-4dd9-abea-254c2559bc2b",
                                                "sense_id": "1328c0e9-cddb-33b3-9270-c281d6460333",
                                                "text": "He'll fuck you up, yes, God will fuck you up\nIf you dare to disobey His stern command.\nHe'll fuck you up, don't you know He'll fuck you up?\nSo you better do some prayin' while you can."
                                            },
                                            {
                                                "example_id": "4bb37d19-45c9-4679-86bf-82e50c3edc56",
                                                "sense_id": "1328c0e9-cddb-33b3-9270-c281d6460333",
                                                "text": "What are these, hookers? I guess this guy doesn't understand the concept of a hooker. You're supposed to fuck her, not fuck her up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfbf8638-9679-3f97-8d41-ba50ce0d7ee7",
                                        "entry_id": "f0caa63c-5f35-35e1-acb1-85d48aa7de9f",
                                        "glosses": [
                                            "To cause someone to become intoxicated or otherwise alter someone's mental state."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94a16746-d11f-48f6-bb0f-086caaf6c7b7",
                                                "sense_id": "dfbf8638-9679-3f97-8d41-ba50ce0d7ee7",
                                                "text": "I really got fucked up on cocaine last night."
                                            },
                                            {
                                                "example_id": "aca43144-3825-4e63-ae32-b9e94e079cd4",
                                                "sense_id": "dfbf8638-9679-3f97-8d41-ba50ce0d7ee7",
                                                "text": "Vodka, Bit says, because it fucks you up fastest."
                                            },
                                            {
                                                "example_id": "97b9c309-949f-4244-a188-7dee96e74b1a",
                                                "sense_id": "dfbf8638-9679-3f97-8d41-ba50ce0d7ee7",
                                                "text": "Yeah, well the use of smack, cocaine, and other nasties continues, along with a wide range of designer drugs. […] There's still plenty of shit quality material available to fuck up the youth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bb09e2f-4ce7-36bb-aac6-efefdf77e652",
                                        "entry_id": "f0caa63c-5f35-35e1-acb1-85d48aa7de9f",
                                        "glosses": [
                                            "To traumatise; to negatively affect the wellbeing of someone."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3e4f2c9-6468-4bd2-9d58-7c425cc4286e",
                                                "sense_id": "0bb09e2f-4ce7-36bb-aac6-efefdf77e652",
                                                "text": "They fuck you up, your mum and dad.\nThey may not mean to, but they do.\nThey fill you with their faults they had\nAnd add some extra, just for you."
                                            },
                                            {
                                                "example_id": "ee6c62f4-5249-4921-92f0-c5d25f6b8402",
                                                "sense_id": "0bb09e2f-4ce7-36bb-aac6-efefdf77e652",
                                                "text": "She'd never get the chance to have the proper goodbye to her own husband, and that fucked me up for some reason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79d59f5e-50c6-32ef-b145-365bb7cbc1e8",
                                        "entry_id": "f0caa63c-5f35-35e1-acb1-85d48aa7de9f",
                                        "glosses": [
                                            "Ellipsis of shut the fuck up."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8374c6a-2c8c-474d-b03e-937c4399a126",
                                                "sense_id": "79d59f5e-50c6-32ef-b145-365bb7cbc1e8",
                                                "text": "Fuck up, mate! I don't want to listen to you!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fuck up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e4c5df5-869b-370d-91fe-550a38bde41a",
                                        "entry_id": "c677d6a3-ff76-3881-b034-a0fcd54a643e",
                                        "glosses": [
