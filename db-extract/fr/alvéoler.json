                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeb968d0-2d73-4d5e-b20a-5405b37c596a",
                                "sense_id": "268a5b19-7fac-3a98-b6e2-fa5cf642c294",
                                "text": "Les vallées sans rivières qui alvéolent le calcaire des Grands Fonds prenaient des aspects de cirques sélénites."
                            },
                            {
                                "example_id": "703f9d2a-a02f-4a97-93b1-45fb6dc3913f",
                                "sense_id": "268a5b19-7fac-3a98-b6e2-fa5cf642c294",
                                "text": "N’a-t-il pas ajouté au miracle de l’eau celui de pétrir et d’alvéoler deux grosses pierres plates en y laissant les empreintes de ses mains et de ses pieds ?"
                            }
                        ]
                    }
