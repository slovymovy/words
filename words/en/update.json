{
    "word_family": [
        "updatable",
        "updater"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "faf24316-74a2-3a3f-8d67-f672a64a545f",
                    "sense_definition": "To bring something up to date by adding new information or making changes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "modify",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>update</w> my records to take account of the most recent transaction.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>обновить</w> свои записи, чтобы учесть последнюю транзакцию."
                            }
                        },
                        {
                            "text": "You should <w>update</w> software regularly to ensure your computer stays secure from viruses.",
                            "target_lang_translations": {
                                "ru": "Вам следует регулярно <w>обновлять</w> программное обеспечение, чтобы обеспечить защиту компьютера от вирусов."
                            }
                        }
                    ],
                    "synonyms": [
                        "refresh",
                        "renew",
                        "upgrade"
                    ],
                    "common_phrases": [
                        "update software",
                        "update a profile",
                        "update records"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить что-либо в соответствие с текущим моментом, добавляя новую информацию или внося изменения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обновлять",
                                "target_lang_sense_clarification": "делать более современным или актуальным"
                            },
                            {
                                "target_lang_word": "актуализировать",
                                "target_lang_sense_clarification": "приводить информацию в соответствие с текущими данными"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aaed356f-0056-3c8a-9cee-1c14e5b5763c",
                    "sense_definition": "To give someone the most recent information about a situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "inform",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>update</w> me on what happened while I was away on vacation.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>введи меня в курс дела</w> относительно того, что произошло, пока я был в отпуске."
                            }
                        },
                        {
                            "text": "The manager will <w>update</w> the team during the morning meeting tomorrow.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>проинформирует</w> команду о последних новостях завтра на утреннем совещании."
                            }
                        }
                    ],
                    "synonyms": [
                        "inform",
                        "brief"
                    ],
                    "common_phrases": [
                        "update me on",
                        "keep someone updated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять кому-либо самую свежую информацию о ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вводить в курс дела",
                                "target_lang_sense_clarification": "сообщать последние новости"
                            },
                            {
                                "target_lang_word": "информировать",
                                "target_lang_sense_clarification": "сообщать актуальные сведения"
                            },
                            {
                                "target_lang_word": "держать в курсе",
                                "target_lang_sense_clarification": "постоянно сообщать новости"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "354a53ec-761f-3613-ac81-b517cff6131a",
                    "sense_definition": "A report or piece of information that gives the most recent news about a situation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave me an <w>update</w> on the situation in New York this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром он предоставил мне <w>свежую информацию</w> о ситуации в Нью-Йорке."
                            }
                        },
                        {
                            "text": "We are waiting for a status <w>update</w> from the engineering team regarding the delay.",
                            "target_lang_translations": {
                                "ru": "Мы ждем <w>обновления</w> статуса от инженерной группы по поводу задержки."
                            }
                        }
                    ],
                    "synonyms": [
                        "report",
                        "briefing"
                    ],
                    "common_phrases": [
                        "status update",
                        "latest update",
                        "provide an update"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отчет или порция информации, содержащая последние новости о ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обновление",
                                "target_lang_sense_clarification": "свежие данные"
                            },
                            {
                                "target_lang_word": "свежая информация",
                                "target_lang_sense_clarification": "последние новости"
                            },
                            {
                                "target_lang_word": "сводка",
                                "target_lang_sense_clarification": "краткий отчет о текущем положении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a751b90-a4be-3a6e-b01e-9ecacec7a439",
                    "sense_definition": "A new version of software or a document that replaces an older one.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have a couple of <w>updates</w> to install on your laptop to fix the bugs.",
                            "target_lang_translations": {
                                "ru": "Мне нужно установить пару <w>обновлений</w> на твой ноутбук, чтобы исправить ошибки."
                            }
                        },
                        {
                            "text": "The system will download a software <w>update</w> automatically when you connect to Wi-Fi.",
                            "target_lang_translations": {
                                "ru": "Система автоматически загрузит <w>обновление</w> программного обеспечения, когда вы подключитесь к Wi-Fi."
                            }
                        }
                    ],
                    "synonyms": [
                        "upgrade",
                        "patch"
                    ],
                    "common_phrases": [
                        "software update",
                        "system update",
                        "install an update"
                    ],
                    "target_lang_definitions": {
                        "ru": "Новая версия программного обеспечения или документа, заменяющая старую."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обновление",
                                "target_lang_sense_clarification": "новая версия ПО или файла"
                            },
                            {
                                "target_lang_word": "апдейт",
                                "target_lang_sense_clarification": "компьютерный сленг для обновления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}