                    }
                ],
                "senses": [
                    {
                        "sense_id": "73f512ae-8588-39f9-9f53-304997c1ed7d",
                        "entry_id": "9ca34197-46b2-397a-9ca6-e66b5c83c141",
                        "glosses": [
                            "Véhicule à stabilisation gyroscopique composé de deux roues, d’un manche de conduite, et d’une plateforme monoplace sur laquelle l’utilisateur se tient debout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b41448c-6b86-4ab0-addf-19b46b6054fa",
                                "sense_id": "73f512ae-8588-39f9-9f53-304997c1ed7d",
                                "text": "Les Engins de Déplacement Personnel motorisés (EDPm) contiennent les trottinettes électriques, gyropodes, hoverboards, segways, etc... ; ils se déplacent comme des vélos."
                            },
                            {
                                "example_id": "8ce9f4ee-1c92-4ce0-930c-fcd57484cbea",
                                "sense_id": "73f512ae-8588-39f9-9f53-304997c1ed7d",
                                "text": "À Nice, le gyropode Segway n’a plus de secret pour les policiers municipaux."
                            },
                            {
                                "example_id": "4821a49e-f844-49f3-943a-643d4f81024b",
                                "sense_id": "73f512ae-8588-39f9-9f53-304997c1ed7d",
                                "text": "Elle n'a rien trouvé de plus original que de m'obliger à circuler sur un de ces engins pour citadins branchés : un Segway ! Enfin, on devrait dire un gyropode. Bref, ce truc à deux roues parallèles sur lequel on se tient debout grâce à système de stabilisation gyroscopique et une bonne dose de confiance en soi."
                            },
                            {
                                "example_id": "cb9054af-32dd-4e66-8aaa-2a1c8b25a5b9",
                                "sense_id": "73f512ae-8588-39f9-9f53-304997c1ed7d",
                                "text": "Cyclosud, entreprise dynamique propose des balades touristiques et autres activités ludiques en gyropodes à Marseille, Aix-en-Provence, Arles, Avignon, Nîmes, Salon et Montpellier. Ces engins sont 100% sécurisés, intuitifs et faciles à prendre en main !"
                            }
                        ]
                    }
                ],
