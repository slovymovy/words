                                        "sense_id": "8f653123-a660-33d1-b23a-c577cbd8c0e2",
                                        "entry_id": "e31c5708-a272-364c-b5fa-517045567810",
                                        "glosses": [
                                            "One who exercises control and direction over a group of persons."
