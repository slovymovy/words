                        "entry_id": "c79e41c2-21f3-3369-bf75-09327f6f62e5",
                        "glosses": [
                            "Nom donné par les marins à un groupe d’îlots ou de récifs d’une certaine étendue, et parmi lesquels il y a généralement des passages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8722e8bb-a26f-4b22-a473-0ecc3505cb1e",
                                "sense_id": "f57e3b0d-c3c7-301c-ae3c-847b918e7e1d",
                                "text": "Les îles Paracels sont un archipel de petites îles coralliennes inhabitées situées en mer de Chine méridionale."
                            },
                            {
                                "example_id": "cd0a9246-f92a-4ebb-90ed-176191c69f18",
                                "sense_id": "f57e3b0d-c3c7-301c-ae3c-847b918e7e1d",
                                "text": "Notre point de réunion était au Paracel de Saint-Brandon, dans la mer d’Inde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4dfe03de-883e-4d56-aa92-1c545452ce21",
                        "source_entry_id": "c79e41c2-21f3-3369-bf75-09327f6f62e5",
                        "source_sense_id": "f57e3b0d-c3c7-301c-ae3c-847b918e7e1d",
                        "target_lang_word": "Paracel Islands",
                        "target_lang_code": "en",
