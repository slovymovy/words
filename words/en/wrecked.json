            "senses": [
                {
                    "sense_id": "f9440dcd-16e2-3594-85a1-e226dcb440da",
                    "sense_definition": "Simple past and past participle of <w>wreck</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The violent storm <w>wrecked</w> several fishing boats along the coast.",
                            "target_lang_translations": {
                                "zh": "强烈的风暴沿海<w>毁坏</w>了好几艘渔船。"
                            }
                        },
                        {
                            "text": "He completely <w>wrecked</w> his car after losing control on the icy road.",
                            "target_lang_translations": {
                                "zh": "他在结冰的路面上失控后，彻底把车给<w>撞毁</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
