                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84c30050-13be-49e6-8118-04a86ab1ed2f",
                                                "sense_id": "b56f616f-49b8-34e2-b177-45860fd1db75",
                                                "text": "Dérangement d’esprit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a33c55c3-5b27-320e-8d86-66fa683e332e",
                                        "entry_id": "86681746-db47-355c-899b-d9f50ebb3f94",
                                        "glosses": [
                                            "Action de se déranger, de se déplacer."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcf422db-414e-42fa-8a93-b7fedfd3fb6f",
                                                "sense_id": "a33c55c3-5b27-320e-8d86-66fa683e332e",
                                                "text": "[…] ils ne pouvaient avoir une valeur suffisante pour justifier le dérangement, surtout quand on en a été réduit à vivre avec un mistouflard, un gagne-petit, comme le frangin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1f18016-beb6-36de-a87e-6800220bc182",
                                        "entry_id": "86681746-db47-355c-899b-d9f50ebb3f94",
