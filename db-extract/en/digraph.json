                            "plural"
                        ],
                        "form": "digraphs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8b97951-43c1-37aa-84e8-7aedfdde9a99",
                        "entry_id": "c7caf968-253e-3908-a769-ec30454e9804",
                        "glosses": [
                            "A two-character sequence used to enter a single conceptual character."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "666498ca-cb93-34c0-b122-4a945e7cc7f2",
                        "entry_id": "c7caf968-253e-3908-a769-ec30454e9804",
                        "glosses": [
                            "A pair of letters, especially a pair representing a single phoneme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "621c015a-dd91-4165-82ab-883ebd6b8942",
                                "sense_id": "666498ca-cb93-34c0-b122-4a945e7cc7f2",
                                "text": "As a special education teacher, I find that introducing one or two digraphs a week works well."
                            },
                            {
                                "example_id": "ce086f7c-231e-4fc6-ac10-f02863b327a1",
                                "sense_id": "666498ca-cb93-34c0-b122-4a945e7cc7f2",
                                "text": "A consonant digraph is a combination of two consonants that represent one sound."
                            }
                        ]
                    },
                    {
                        "sense_id": "4307d0a3-e876-311a-88f9-c384031810aa",
                        "entry_id": "c7caf968-253e-3908-a769-ec30454e9804",
                        "glosses": [
                            "a sequence of two lines, each of which may be unbroken, broken once, or broken twice."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cab7b21c-3976-4c2b-921f-12a6e0a5f03f",
                        "source_entry_id": "c7caf968-253e-3908-a769-ec30454e9804",
                        "source_sense_description": "computing: two-character sequence",
                        "target_lang_word": "digraaf",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "digraaf",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ac17f6eb-c3aa-3286-b637-1302f7b451e5",
                                        "entry_id": "5f9f77a2-6dc0-3519-a8be-ae696d413b7c",
                                        "glosses": [
                                            "een opeenvolging van twee lettertekens die samen één gesproken klank weergeven."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ca7879e-a69a-41cd-8bc8-3ab547846e89",
                                                "sense_id": "ac17f6eb-c3aa-3286-b637-1302f7b451e5",
                                                "text": "In het Nederlands zijn de ch, ng en nk voorbeelden van een digraaf die één medeklinker weergeeft en de combinaties au, ei, eu, ie, ij, oe, ou en ui voorbeelden die één klinker representeren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a4758c2-41de-319d-930e-9110b4000f94",
                                        "entry_id": "5f9f77a2-6dc0-3519-a8be-ae696d413b7c",
                                        "glosses": [
                                            "een gerichte graaf"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dad194ba-d0a3-4178-b277-e94177657e89",
                        "source_entry_id": "c7caf968-253e-3908-a769-ec30454e9804",
                        "source_sense_description": "computing: two-character sequence",
                        "target_lang_word": "Digraph",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Digraph",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a023dc8-178c-3824-8869-a2de12944170",
                                        "entry_id": "fd742eed-3e19-3b2c-b616-b31fd45eb4c2",
                                        "glosses": [
                                            "ein Doppelbuchstabe, der einen einzigen Laut repräsentiert"
                                        ],
                                        "tags": [
                                            "Linguistik/Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6deded6a-fab5-42e6-8e15-ef401ecef7b7",
                                                "sense_id": "1a023dc8-178c-3824-8869-a2de12944170",
                                                "text": "Die original altgriechischen Digraphen („ch“, „ph“, „th“ und „rh“) sind in allen neuromanischen Sprachen mit Ausnahme des Französischen auf einen Buchstaben vereinfacht. Beispiel für den altgriechischen Digraphen „ph“: Okzitanisch: filosofia, Französisch philosophie."
                                            },
                                            {
                                                "example_id": "8d9273d9-7c97-405c-a684-ba28cd401d10",
                                                "sense_id": "1a023dc8-178c-3824-8869-a2de12944170",
                                                "text": "\"ch\" in \"Chemie\" ist im Deutschen ein Digraph für den Laut [ç]"
                                            },
                                            {
                                                "example_id": "d4019bfa-6302-4c7a-855f-61a97e617ffb",
                                                "sense_id": "1a023dc8-178c-3824-8869-a2de12944170",
                                                "text": "„»Der obligatorische Wechsel zum Kyrillischen hat groteske Verrenkungen erforderlich gemacht, so die Verwendung von diakritischen Zeichen, von Digraphen, Trigraphen und sogar - zur Darstellung des entstimmten aspirierten labialisierten uvularen Plosivs im Kabardinischen - von einem Tetragraphen«.“"
                                            },
                                            {
                                                "example_id": "12703a5c-e61a-4bdc-9e16-9fe49ec0db92",
                                                "sense_id": "1a023dc8-178c-3824-8869-a2de12944170",
                                                "text": "„Es gibt heute nur wenige Sprachen, in denen das q ohne ein nachfolgendes u vorkommt (etwa im Albanischen und Arabischen), und auch im Deutschen kommt das q aus historischen Gründen nur als sogenannter Digraph beziehungsweise Doppelbuchstabe mit einem u vor und trägt noch immer, wie zu lateinischen Zeiten, den Lautwert /kv/.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
