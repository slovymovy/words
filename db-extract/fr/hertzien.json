                "senses": [
                    {
                        "sense_id": "a8f8c876-d8ff-386e-8c37-9208acbc8bcc",
                        "entry_id": "9c0feb05-c1cb-3d9b-a398-2a2fdce6baf4",
                        "glosses": [
                            "Désigne les ondes électromagnétiques ayant une longueur d’onde supérieure à celle des micro-ondes."
                        ],
                        "tags": [
                            "Radiotélégraphie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f67a845b-acf2-3fb6-b799-5013d54e5c2b",
                        "entry_id": "9c0feb05-c1cb-3d9b-a398-2a2fdce6baf4",
                        "glosses": [
                            "Qui se rapporte à ces ondes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2acea846-2ef4-3c53-8a35-26e1c4246957",
                        "entry_id": "9c0feb05-c1cb-3d9b-a398-2a2fdce6baf4",
                        "glosses": [
                            "Relatif au transport des ondes hertziennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "475f6d14-797b-4e5f-ae4a-5e8dafc075c1",
                                "sense_id": "2acea846-2ef4-3c53-8a35-26e1c4246957",
                                "text": "Les équipements de télécommunications, que l'on appelle des répéteurs, assurent les mêmes fonctions qu'un relai hertzien : ils reçoivent les émissions provenant de la Terre et les réémettent vers la Terre après amplification et transposition en fréquence."
                            },
                            {
                                "example_id": "f13e7dcd-4103-4e41-bf2f-9c786881a97b",
                                "sense_id": "2acea846-2ef4-3c53-8a35-26e1c4246957",
                                "text": "il serait dangereux de quitter un univers hertzien régulé et dominé par des acteurs français, pour l’univers de la diffusion ‘over-the-top’ dominé par des Américains et dont la régulation n’est pas encore stabilisée."
                            }
                        ]
                    }
                ],
