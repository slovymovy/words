                "senses": [
                    {
                        "sense_id": "de24360c-5bf1-3d40-ad55-406450b0b1d7",
                        "entry_id": "21b6b11f-29f3-3c01-8f94-e070f259a068",
                        "glosses": [
                            "In a prescient manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc575f25-1c5d-4b70-8160-aff71c74d2f9",
                                "sense_id": "de24360c-5bf1-3d40-ad55-406450b0b1d7",
                                "text": "The desire to know definitely and presciently is also one of the most urgent of the instincts proper of man; it leads him on to the most mystical speculations as to the future, and is the orectic basis of all the arts of divination, as well as of scientific Proleptics or anticipation of the order of nature."
                            },
                            {
                                "example_id": "5b306e7d-cbbf-4346-b22d-0c5a1c63a5f4",
                                "sense_id": "de24360c-5bf1-3d40-ad55-406450b0b1d7",
                                "text": "It was Sir Walter Raleigh who presciently said: 'Who commands the sea commands trade; who commands the trade of the world commands its riches, and so commands the world itself.'"
                            },
                            {
                                "example_id": "d576a576-5a05-4ad5-8803-71ebf4001d11",
                                "sense_id": "de24360c-5bf1-3d40-ad55-406450b0b1d7",
                                "text": "But as the pandemic accelerated, EMR acted presciently and made changes before the Government put the country into lockdown."
                            }
                        ]
                    }
                ],
