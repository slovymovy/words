                        "entry_id": "2d303cb6-491a-34ef-a54d-ec95be23179e",
                        "glosses": [
                            "prymitywne narzędzie do oddzielania plew od ziarna w formie szufli, wideł lub płaskiego kosza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a2b3ffb-a1b7-4833-9719-ab11f1b87323",
                                "sense_id": "076f9341-3cee-3fa4-a026-79204a94275a",
                                "text": "Ma On wiejadło w ręku i oczyści swój omłot: pszenicę zbierze do spichlerza, a plewy spali w ogniu nieugaszonym."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
