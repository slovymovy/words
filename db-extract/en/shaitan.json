        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "192e699e-0b11-3fca-b89e-d3e2cc1e0804",
                "word": "Shaitan",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3e8b08f9-31b5-3f42-80e5-ae5036c98497",
                        "entry_id": "192e699e-0b11-3fca-b89e-d3e2cc1e0804",
                        "glosses": [
                            "Iblis, Satan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b376999-1698-47a3-b070-e49e42d05f3f",
                                "sense_id": "3e8b08f9-31b5-3f42-80e5-ae5036c98497",
                                "text": "Beside him two Egyptian artillerymen with their throats cut were sobbing out their lives upon the ground. \"Who lays the gun this time?\" asked the fierce chief, glaring at the frightened gunners. \"Here, thou black-browed child of Shaitan, aim, and aim for thy life.\""
                            },
                            {
                                "example_id": "ca44b6d9-d3c5-4fc1-8707-369fbbcaa251",
                                "sense_id": "3e8b08f9-31b5-3f42-80e5-ae5036c98497",
                                "text": "He thanks Allah for his mercy to men in sending Mohammed the Prophet, who gave the world the True Belief, and he curses Shaitan, who wages war against Allah and his children."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b06f3676-e2f5-4ee1-b99d-a4e185250927",
