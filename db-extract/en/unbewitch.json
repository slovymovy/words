                                    {
                                        "sense_id": "d4acbbcb-7c61-3530-bf6c-94284b6e1cc1",
                                        "entry_id": "2efc552e-7dbf-3c80-a800-003fcd774236",
                                        "glosses": [
                                            "Délivrer de l’ensorcellement, du mauvais sort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4077c563-4c1e-4ebb-b3df-0c83de4fc536",
                                                "sense_id": "d4acbbcb-7c61-3530-bf6c-94284b6e1cc1",
                                                "text": "Ma parole, il faudrait bien que votre curé vous désensorcelle !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "951a6c2b-d99e-3491-a8a1-7cbb3ab26a89",
                                        "entry_id": "2efc552e-7dbf-3c80-a800-003fcd774236",
                                        "glosses": [
                                            "Libérer d’une passion, d’un attachement, d’un aveuglement."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32ba3585-289a-43b6-bf15-615ec47ac276",
                                                "sense_id": "951a6c2b-d99e-3491-a8a1-7cbb3ab26a89",
                                                "text": "Il a une passion violente pour cette femme, on ne peut la désensorceler."
                                            },
                                            {
                                                "example_id": "e6a5ad9d-ae8f-44dd-916e-b1a796c50245",
                                                "sense_id": "951a6c2b-d99e-3491-a8a1-7cbb3ab26a89",
                                                "text": "Rien ne pouvait désensorceler l’auditoire. Tous les yeux restaient fixés là, et les nouveaux arrivants."
                                            },
                                            {
                                                "example_id": "66b8f628-850e-494b-8818-31c6daad888d",
                                                "sense_id": "951a6c2b-d99e-3491-a8a1-7cbb3ab26a89",
                                                "text": "Pierre prenait racine, n’arrivant pas à se désensorceler, à sortir de cet empire vanillé où le temps ne pénétrait pas, où il serait resté enfermé jusqu’au petit jour si M. de Rocheflamme, entre autres crétineries et gallicismes, n’avait parlé de « réintégrer ses pénates »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "340b0103-9b31-3be5-b193-a12d971453ea",
                                        "entry_id": "2efc552e-7dbf-3c80-a800-003fcd774236",
                                        "glosses": [
                                            "Assainir par l'élimination d'un élément immatériel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b20946d-b3f7-4b76-82fd-01d8e4c93f95",
                                                "sense_id": "340b0103-9b31-3be5-b193-a12d971453ea",
                                                "text": "Toutes les chambres sont hantées, nous le savons depuis le roman gothique, nous avons besoin de les désensorceler pour les faires nôtres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27bb792f-fc9c-4d55-83a0-de59dcc67c46",
                        "source_entry_id": "16a51f02-3dcb-3d07-ab99-329a4c0855bb",
                        "source_sense_id": "1b964700-3f48-3e35-bfff-16d491356e74",
