                "senses": [
                    {
                        "sense_id": "f68d0e87-11bb-3f43-9b83-efb5e5e2924a",
                        "entry_id": "97da5f1c-388c-3a0a-8cf5-1271792fb326",
                        "glosses": [
                            "A homologous series of organic molecules whose functional group is an oxygen atom joined to a carbon atom—by a double bond—in a carbon-hydrogen based molecule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bbd8448-3b1e-484c-ab48-e5f9ceb7cded",
                                "sense_id": "f68d0e87-11bb-3f43-9b83-efb5e5e2924a",
                                "text": "acetone R₁ = R₂ = CH₃"
                            },
                            {
                                "example_id": "8bdfa817-7326-4941-a519-b92506410c1b",
                                "sense_id": "f68d0e87-11bb-3f43-9b83-efb5e5e2924a",
                                "text": "methyl ethyl ketone R₁ = CH₃, R₂ = C₂H₅"
                            },
                            {
                                "example_id": "362753e3-cd5b-4199-80e2-d2740df185d9",
                                "sense_id": "f68d0e87-11bb-3f43-9b83-efb5e5e2924a",
                                "text": "camphor C₁₀H₁₇O"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "254d04c6-989b-426e-acbc-b4ec8a72dc9a",
