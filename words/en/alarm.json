                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Luckily, the report of smoke was just a false <w>alarm</w>.",
                            "target_lang_translations": {
                                "ru": "К счастью, сообщение о дыме оказалось лишь ложной <w>тревогой</w>.",
                                "nl": "Gelukkig was de melding van rook slechts vals <w>alarm</w>.",
                                "pl": "Na szczęście doniesienie o dymie okazało się tylko fałszywym <w>alarmem</w>.",
                                "de": "Glücklicherweise war die Rauchmeldung nur ein falscher <w>Alarm</w>.",
                                "fr": "Heureusement, le signalement de fumée n'était qu'une fausse <w>alarme</w>.",
                                "it": "Per fortuna, la segnalazione di fumo era solo un falso <w>allarme</w>.",
                                "cs": "Hlášení o kouři byl naštěstí jen planý <w>poplach</w>.",
                                "tr": "Neyse ki duman ihbarı sadece asılsız bir <w>alarm</w> çıktı.",
                                "es": "Por suerte, el reporte de humo fue solo una falsa <w>alarma</w>."
                            }
                        },
                        {
                            "text": "Someone needs to sound the <w>alarm</w> before the fire spreads.",
                            "target_lang_translations": {
                                "ru": "Кто-то должен поднять <w>тревогу</w>, пока огонь не распространился.",
                                "nl": "Iemand moet <w>alarm slaan</w> voordat het vuur zich verspreidt.",
                                "pl": "Ktoś musi podnieść <w>alarm</w>, zanim ogień się rozprzestrzeni.",
                                "de": "Jemand muss <w>Alarm</w> schlagen, bevor sich das Feuer ausbreitet.",
                                "fr": "Quelqu'un doit sonner l'<w>alarme</w> avant que le feu ne se propage.",
                                "it": "Qualcuno deve lanciare l'<w>allarme</w> prima che l'incendio si diffonda.",
                                "cs": "Někdo musí spustit <w>poplach</w>, než se oheň rozšíří.",
                                "tr": "Yangın yayılmadan önce birinin <w>alarmı</w> çalması gerekiyor.",
                                "es": "Alguien tiene que dar la <w>alarma</w> antes de que el fuego se propague."
                            }
