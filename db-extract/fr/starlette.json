                    },
                    {
                        "form_id": "3529ee94-d639-4bcb-b188-4d9c005f2fd5",
                        "entry_id": "f52d58f0-7a9e-3e7a-97b3-a00171e2b5f1",
                        "tags": [],
                        "form": "starlett"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e63c918-744d-3b22-a5d8-64ce015659cc",
                        "entry_id": "f52d58f0-7a9e-3e7a-97b3-a00171e2b5f1",
                        "glosses": [
                            "Actrice de cinéma dont la gloire ou la célébrité n'est encore que potentielle."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "79f235ef-d7c2-49f3-a646-6af4def1efef",
                                "sense_id": "1e63c918-744d-3b22-a5d8-64ce015659cc",
                                "text": "Une brune anguleuse la remplaçait, l’œil aux aguets des anciennes starlettes."
                            },
                            {
                                "example_id": "8dcccadc-fb02-44d7-8c6c-b7f8a4a24b31",
                                "sense_id": "1e63c918-744d-3b22-a5d8-64ce015659cc",
                                "text": "La moindre scénette érotique (anodine aujourd'hui) fait sensation, telle celle de la starlette Françoise Deldick à demi nue montant à cheval les marches du Carlton."
                            },
                            {
                                "example_id": "e7f544d1-db09-446e-a1e9-1fd38ff4f02f",
                                "sense_id": "1e63c918-744d-3b22-a5d8-64ce015659cc",
                                "text": "C’est Castro qui vous a envoyé, n’est-ce pas ? Ou alors Kennedy, ce bébé Cadum qui passe son temps à coursailler les starlettes de Hollywood ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b405320-1ffa-49e7-b7a8-57c6db88a6e2",
                        "source_entry_id": "f52d58f0-7a9e-3e7a-97b3-a00171e2b5f1",
                        "source_sense_id": "1e63c918-744d-3b22-a5d8-64ce015659cc",
                        "target_lang_word": "starlet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "starlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcf5f711-85d1-3c4c-a23e-b68262d8754b",
                                        "entry_id": "985b19c5-9fbc-3d91-99dd-9100999112ad",
                                        "glosses": [
                                            "A young actress with a promising career ahead of her."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dad2b61d-28eb-45ba-8c4f-9f380204f82b",
                                                "sense_id": "dcf5f711-85d1-3c4c-a23e-b68262d8754b",
                                                "text": "There were other flapper-era starlets, of course—Louise Brooks, Greta Garbo—but they were poseurs by comparison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fd88f35-c2a6-33eb-8b76-4e8fc5124643",
                                        "entry_id": "985b19c5-9fbc-3d91-99dd-9100999112ad",
                                        "glosses": [
                                            "An accomplished and important supporting player in a sports team."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93f809ff-068d-4d63-b3a6-3130ddfe0e86",
                                                "sense_id": "7fd88f35-c2a6-33eb-8b76-4e8fc5124643",
                                                "text": "As Mourinho also entered the press room while most journalists were still watching the players’ lap of honour, nothing could be confirmed about the condition of Pogba, who scored United’s second goal and the Portuguese declined a chance to praise some fine performances from his starlets, with Josh Harrop scoring on his debut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f79d0b75-d5b1-3c5c-a196-a2b8d3eb294d",
                                        "entry_id": "985b19c5-9fbc-3d91-99dd-9100999112ad",
                                        "glosses": [
                                            "A small star."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "118675f1-8e16-43eb-b44c-1190f2d3693e",
                                                "sense_id": "f79d0b75-d5b1-3c5c-a196-a2b8d3eb294d",
                                                "text": "It e'en the semblance of sound's softest echo Were to compare the faintest starlet's beam, Struggling through angry clouds its misty Ray, With the all-powerful Sun's meridian ray, Dazzling the gaze of nature — doth pervade The atmosphere, as 'twere a whisper's shadow Or breathing soft disembodied souls;"
                                            },
                                            {
                                                "example_id": "865b67ec-e410-4b8c-ba1d-1cbf2202d5c5",
                                                "sense_id": "f79d0b75-d5b1-3c5c-a196-a2b8d3eb294d",
                                                "text": "As I saw the love-light beam From her radiant eyes, more glorious far Than the starlet's nightly gleam :"
                                            },
                                            {
                                                "example_id": "5841a71a-037c-48f5-92bc-0a93de5f5936",
                                                "sense_id": "f79d0b75-d5b1-3c5c-a196-a2b8d3eb294d",
                                                "text": "The shimmering, shivering, trembling, twinkling starlet white, Dancy rays darteth down, showering blossoms of silvern light ;"
                                            },
                                            {
                                                "example_id": "77b028ff-9b2d-4c01-bccc-fcf0427cc877",
                                                "sense_id": "f79d0b75-d5b1-3c5c-a196-a2b8d3eb294d",
                                                "text": "I have a little golden dream That haunts me night and day, And like a starlet's golden beam Lights up my darksome way."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "starlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37d92d2e-0bcf-30b7-b785-3b1e4aa0a177",
                                        "entry_id": "2b8631c1-7a2d-352f-8e35-b348daad22ca",
                                        "glosses": [
                                            "Alternative form of starlit."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d37a2ef-c1f2-4e53-8001-23325a57574a",
                                                "sense_id": "37d92d2e-0bcf-30b7-b785-3b1e4aa0a177",
                                                "text": "Through the starlet night, under the moon, they dreamed and loved."
                                            },
                                            {
                                                "example_id": "947e8773-afe8-406f-82d7-1fa3c4fa386b",
                                                "sense_id": "37d92d2e-0bcf-30b7-b785-3b1e4aa0a177",
                                                "text": "King's single file column made good time as they took turns riding their horses in the crisp starlet night and leading their mounts by the reins while they walked over extremely rough terrain."
                                            },
                                            {
                                                "example_id": "8bfc0817-cf5d-49f7-9489-80439f5094dc",
                                                "sense_id": "37d92d2e-0bcf-30b7-b785-3b1e4aa0a177",
                                                "text": "The Fortune Teller gazed his wondering green eye in the orb of clouded mist. Over looking their movements from above the starlet night."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
