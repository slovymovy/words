                "senses": [
                    {
                        "sense_id": "60a0f785-742f-364c-af07-d338afe6898c",
                        "entry_id": "34bfa53d-163d-3dda-9884-daa1291d5706",
                        "glosses": [
                            "Genre de plantes carnivores de la famille des Droséracées.→ voir Drosera"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "724fd204-989a-43ca-a855-faf3206ef5f1",
                                "sense_id": "60a0f785-742f-364c-af07-d338afe6898c",
                                "text": "Des plantes sensibles comme les mimosas ou les droséras… la plante connue sous le nom de droséra, n’est sensible qu’au toucher."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fe174d5-d8f7-496c-89e0-f68181de983e",
                        "source_entry_id": "34bfa53d-163d-3dda-9884-daa1291d5706",
                        "source_sense_id": "60a0f785-742f-364c-af07-d338afe6898c",
                        "target_lang_word": "Sonnentau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnentau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c525a0c7-cb77-32b3-aaf8-50dd610cd917",
                                        "entry_id": "eb6f0b2f-304a-3d68-b734-23d8d3314794",
                                        "glosses": [
                                            "unter Naturschutz stehende Gattung der fleischfressenden Pflanzen mit über 170 Arten, zur Familie der Sonnentaugewächse gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63b994d9-5ffe-4a33-bd68-268cb51d4dad",
                                                "sense_id": "c525a0c7-cb77-32b3-aaf8-50dd610cd917",
                                                "text": "Der Sonnentau steht unter Naturschutz."
                                            },
                                            {
                                                "example_id": "30bb9cad-bd00-4267-960c-563ff69b0d18",
                                                "sense_id": "c525a0c7-cb77-32b3-aaf8-50dd610cd917",
                                                "text": "„Die Vegetation des Wallums ist selten höher als einen Meter und reich an Orchideen, Sonnentauen, Wasserschläuchen und Stylidium.“"
                                            },
                                            {
                                                "example_id": "743ace3c-5184-46b2-85d5-cbfa502a1942",
                                                "sense_id": "c525a0c7-cb77-32b3-aaf8-50dd610cd917",
                                                "text": "„Für die Blüte lassen sich die Sonnentaue nicht sehr viel Zeit. Nur von Juni bis August öffnen sich bei Sonnenschein die weißen Blüten, in alpinen Gegenden erst ab Juli.“"
                                            },
                                            {
                                                "example_id": "8416aa8b-a041-44ca-bc7d-ca982ec19d7e",
                                                "sense_id": "c525a0c7-cb77-32b3-aaf8-50dd610cd917",
                                                "text": "„Man unterscheidet solche mit passiven Fallen, zumeist Krügen, und solche mit aktiven Fallen. Zu letzteren gehören die auch einheimisch vorkommenden Sonnentaue (Drosera) und die im östlichen Nordamerika wachsende Venusfliegfalle.“"
                                            },
                                            {
                                                "example_id": "69bc16ab-7c81-42be-ae07-8a88735de804",
                                                "sense_id": "c525a0c7-cb77-32b3-aaf8-50dd610cd917",
                                                "text": "„Allerdings: Irgendetwas müssen die rotblättrigen Sonnentaue dennoch haben, das die Zweiflügler geradezu magisch anzieht. Denn wie die Forscher feststellten, fingen die echten Sonnentaue immer dann am meisten Insekten, wenn sie relativ rote und gleichzeitig auch besonders viele Blätter besaßen.“"
                                            },
                                            {
                                                "example_id": "7149e88c-fc70-482a-9f97-b852ba9e0ada",
                                                "sense_id": "c525a0c7-cb77-32b3-aaf8-50dd610cd917",
                                                "text": "„Im Frühjahr blühen hier Glockenheiden, Sonnentaue und Moosbeeren, dazwischen quaken Moorfrösche und Kreuzkröten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a158b6e-87ab-4457-b5c7-8d514d89376f",
