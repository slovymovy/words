                "senses": [
                    {
                        "sense_id": "27fa8af0-1529-31fe-91bc-729a0e85f6f2",
                        "entry_id": "64ff641e-c765-375d-90d6-835a7d2217f1",
                        "glosses": [
                            "taki, który ma czarną głowę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e10bfa38-97d1-4c53-9656-904440e82cf4",
                                "sense_id": "27fa8af0-1529-31fe-91bc-729a0e85f6f2",
                                "text": "Są też przypuszczenia, że starożytni czarnogłowi Sumerowie są krewniakami Kaukazczyków."
                            },
                            {
                                "example_id": "33294293-5753-4cef-897f-e1542b42c1f2",
                                "sense_id": "27fa8af0-1529-31fe-91bc-729a0e85f6f2",
                                "text": "Cisi, przygięci do ziemi, czarnogłowi i w czarnych okryciach, nie patrząc na boki, przeszli boso i znikli w lesie opodal."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
