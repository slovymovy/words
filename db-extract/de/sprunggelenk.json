                    }
                ],
                "senses": [
                    {
                        "sense_id": "6197eb09-b8b9-30cd-86e0-cf8cb823d727",
                        "entry_id": "9cfb731f-a4cd-361c-8fdb-3bade7e28dde",
                        "glosses": [
                            "die bewegliche Verbindung zwischen den Fuß- und den Unterschenkelknochen der Wade (Wadenbein, Schienbein)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71b8d835-a93a-4ea3-af2b-c5aa7b8b76f2",
                                "sense_id": "6197eb09-b8b9-30cd-86e0-cf8cb823d727",
                                "text": "Das Sprunggelenk ist ein Zylindergelenk, d. h. es ist in nur einer Achse beweglich."
                            },
                            {
                                "example_id": "65c2c88e-c082-49a0-a71e-2f14ab73414d",
                                "sense_id": "6197eb09-b8b9-30cd-86e0-cf8cb823d727",
                                "text": "Es ist ziemlich schmerzhaft, heftig umzuknicken, d. h. sich die Bänder um das Sprunggelenk zu überdehnen."
                            },
                            {
                                "example_id": "bdb9219e-e4ad-48e5-a859-2b18515ee2de",
                                "sense_id": "6197eb09-b8b9-30cd-86e0-cf8cb823d727",
                                "text": "Kapitän Lahm hat während des DFB-Pokalfinales statt des zunächst diagnostizierten Blutergusses nach eigener Auskunft einen Kapselriss im Sprunggelenk erlitten und soll erst am Freitag (23.05.2014) nachkommen."
                            },
                            {
                                "example_id": "7e2a0396-f84c-46c4-9b97-ebf316fd878c",
                                "sense_id": "6197eb09-b8b9-30cd-86e0-cf8cb823d727",
                                "text": "[Die Tennisspielerin Mona] Barthel hatte sich im Dezember beim Joggen einen Bänderriss im Sprunggelenk zugezogen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7b5212f-2be3-42f2-b191-a5a2559b60af",
                        "source_entry_id": "9cfb731f-a4cd-361c-8fdb-3bade7e28dde",
                        "source_sense_id": "6197eb09-b8b9-30cd-86e0-cf8cb823d727",
                        "target_lang_word": "ankle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ankle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49c71932-1f0e-34da-a9fd-92a7555a8b40",
                                        "entry_id": "363da069-17a1-3d84-9cdf-c5f1e587ea80",
                                        "glosses": [
                                            "The skeletal joint which connects the foot with the leg; the uppermost portion of the foot and lowermost portion of the leg, which contain this skeletal joint."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ankle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38889dc6-dc09-3897-9d61-cc56bda3dc52",
                                        "entry_id": "5bc43059-9f96-363f-bf06-52ca0682975c",
                                        "glosses": [
                                            "To walk."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be84fcbb-c4e2-457c-803b-6767cf185fd0",
                                                "sense_id": "38889dc6-dc09-3897-9d61-cc56bda3dc52",
                                                "text": "Arvay’s tearful speech followed the usual pattern, and everybody said it was just fine. There had been nothing about the heathens of China, India and Africa wallowing around on the heavenly chairs, nor ankling up and down the golden streets."
                                            },
                                            {
                                                "example_id": "94fa361c-a450-4a27-942f-7cf23989982a",
                                                "sense_id": "38889dc6-dc09-3897-9d61-cc56bda3dc52",
                                                "text": "1951, Anthony Buckeridge, Jennings’ Little Hut, London: Collins, 1973, Chapter 15, p. 178,\nSupposing we all ankled over to the huts […]"
                                            },
                                            {
                                                "example_id": "cfde6769-31a9-4810-973d-9dc80bc7da43",
                                                "sense_id": "38889dc6-dc09-3897-9d61-cc56bda3dc52",
                                                "text": "1966, P. G. Wodehouse, Plum Pie, London: Everyman, 2007, Chapter 6, p. 158,\nHe ankled round, accordingly, to her house and his ring at the bell was answered by Wilberforce, her butler […]"
                                            },
                                            {
                                                "example_id": "8707edaa-c03f-46bf-8e81-d70440aa4db2",
                                                "sense_id": "38889dc6-dc09-3897-9d61-cc56bda3dc52",
                                                "text": "After a while he got up and ankled his way down the corridor and met Penny coming out of the toilet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62babd6f-1771-341b-888e-2b5799014630",
                                        "entry_id": "5bc43059-9f96-363f-bf06-52ca0682975c",
                                        "glosses": [
                                            "To cyclically angle the foot at the ankle while pedaling, to maximize the amount of work applied to the pedal during each revolution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
