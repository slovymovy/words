                    {
                        "sense_id": "e3a4c8b7-62ac-32e8-8f53-68b3cace2465",
                        "entry_id": "6ef1d748-cb35-3ee2-a885-bf8ae3c19291",
                        "glosses": [
                            "nach dem Ende eines Krieges vorherrschender Mangel an etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "160402bc-c0aa-4241-9a6d-637f61d10460",
                                "sense_id": "e3a4c8b7-62ac-32e8-8f53-68b3cace2465",
                                "text": "„Zusammen mit dem Nachkriegsmangel an preiswerten, guten Lebensmitteln und Reallöhnen, die selten auch nur in die Nähe des Vorkriegsniveaus kamen, trug diese Wohnsituation zur Verschlechterung der Lebensbedingungen bei.“"
                            },
                            {
                                "example_id": "c3bc4bce-a913-4c9e-8c9d-9a29d0b57e2b",
                                "sense_id": "e3a4c8b7-62ac-32e8-8f53-68b3cace2465",
                                "text": "„Dennoch diktierte der Nachkriegsmangel das Baukonzept.“"
                            },
                            {
                                "example_id": "6745a41b-72ee-40d5-bc0f-9d626a0b79e5",
                                "sense_id": "e3a4c8b7-62ac-32e8-8f53-68b3cace2465",
                                "text": "„Der Nachkriegsmangel schien auf einen Schlag verschwunden zu sein.“"
                            },
                            {
                                "example_id": "98386505-837c-4760-bd62-2c4cbe8374f3",
                                "sense_id": "e3a4c8b7-62ac-32e8-8f53-68b3cace2465",
                                "text": "„Der Nachkriegsmangel ist überwunden, Westdeutschlands Landschaften blühen auf.“"
                            }
                        ],
