    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "98149706-d241-3e18-9219-1654ae5fc64e",
                    "sense_definition": "Having little thickness or extent from one surface to its opposite.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_dimension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>thin</w> paper tore easily when I tried to write on it with a heavy pen.",
                            "target_lang_translations": {
                                "ru": "<w>Тонкая</w> бумага легко порвалась, когда я попытался писать на ней тяжелой ручкой.",
                                "nl": "Het <w>dunne</w> papier scheurde gemakkelijk toen ik er met een zware pen op probeerde te schrijven."
                            }
                        },
                        {
                            "text": "Be careful when walking on <w>thin</w> ice during the early winter months.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, когда идете по <w>тонкому</w> льду в начале зимы.",
                                "nl": "Wees voorzichtig als je op <w>dun</w> ijs loopt tijdens de vroege wintermaanden."
                            }
                        }
                    ],
                    "synonyms": [
                        "narrow"
                    ],
                    "antonyms": [
                        "thick"
                    ],
                    "common_phrases": [
                        "thin ice",
                        "thin layer",
                        "thin paper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий небольшую толщину или протяженность от одной поверхности до другой.",
                        "nl": "Met weinig dikte of omvang van het ene oppervlak naar het tegenoverliggende."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонкий",
                                "target_lang_sense_clarification": "о предметах"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "dun",
                                "target_lang_sense_clarification": "van voorwerpen of lagen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cff2c4e-3deb-32e5-98f2-b2378a572026",
                    "sense_definition": "Having little body fat or flesh; slim; slender; lean; gaunt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "body_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has always been a <w>thin</w> person regardless of how much he eats.",
                            "target_lang_translations": {
                                "ru": "Он всегда был <w>худым</w> человеком, независимо от того, сколько он ест.",
                                "nl": "Hij is altijd een <w>dun</w> persoon geweest, ongeacht hoeveel hij eet."
                            }
                        },
                        {
                            "text": "The marathon runner looked very <w>thin</w> and fit after months of training.",
                            "target_lang_translations": {
                                "ru": "Марафонец выглядел очень <w>худым</w> и подтянутым после месяцев тренировок.",
                                "nl": "De marathonloper zag er na maanden van training erg <w>mager</w> en fit uit."
                            }
                        }
                    ],
                    "synonyms": [
                        "skinny",
                        "slender",
                        "slim",
                        "svelte",
                        "scrawny"
                    ],
                    "common_phrases": [
                        "thin person",
                        "thin face"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий мало жира или плоти; стройный, худощавый или изможденный.",
                        "nl": "Met weinig lichaamsvet of vlees; slank; mager."
