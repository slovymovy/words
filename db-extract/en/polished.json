                    {
                        "translation_id": "064ce71d-9839-46ee-b721-5942309efe54",
                        "source_entry_id": "036bb803-792f-3100-89e8-1f96ff48ea0f",
                        "source_sense_description": "made smooth or shiny by polishing",
                        "target_lang_word": "poli",
