                "senses": [
                    {
                        "sense_id": "f27c93ba-eada-363d-bee8-977ceea12445",
                        "entry_id": "ff194e20-7fe2-3c4f-8e98-574eabad3767",
                        "glosses": [
                            "kobieta szukająca rozrywek poza domem"
                        ],
                        "tags": [
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "bcdd857d-9953-48c9-a426-e73b172c2bd9",
                                "sense_id": "f27c93ba-eada-363d-bee8-977ceea12445",
                                "text": "Nie wiem czy pamiętasz, ale poprzednio pisałem ci, że wróciła do niego jego żona-latawica i któregoś wieczoru zastał ją nagusieńką w swoim łóżku. Od tego czasu chroni się przed nią u swojej matki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a0d9faff-8968-36d6-aa78-2b3c95620ab8",
                        "entry_id": "ff194e20-7fe2-3c4f-8e98-574eabad3767",
                        "glosses": [
                            "kobieta prowadząca rozwiązły tryb życia"
                        ],
                        "tags": [
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "22b1c64b-2827-4545-a80d-a296c7b2d38f",
                                "sense_id": "a0d9faff-8968-36d6-aa78-2b3c95620ab8",
                                "text": "Zadzwonił do mnie kolega i powiedział, że widział mnie z nią. Powiedział mi, że tracę czas i spotykam się z latawicą. Początkowo mu nie wierzyłem, z czasem zacząłem się zastanawiać, że wszystko poszło szybciej niż zwykle…"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93d5816f-aa0a-467d-8883-0f5d506250fe",
                        "source_entry_id": "ff194e20-7fe2-3c4f-8e98-574eabad3767",
                        "source_sense_id": "a0d9faff-8968-36d6-aa78-2b3c95620ab8",
                        "target_lang_word": "hussy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hussy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02606635-22a8-3568-b635-7425c87c97fe",
                                        "entry_id": "4d94bfb1-2cc1-3cb6-9207-eacab745a79a",
                                        "glosses": [
                                            "A housewife or housekeeper."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb3799c4-4319-4dd8-a941-53886c285b9a",
                                                "sense_id": "02606635-22a8-3568-b635-7425c87c97fe",
                                                "text": "WIRTHIN. Well, I should think so! They just dote on that hussy—can't seem to get enough of her. Gretchen tells me so herself. And the care she takes of them!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0da08c4-1a46-3be7-a13a-ccefeccb983d",
                                        "entry_id": "4d94bfb1-2cc1-3cb6-9207-eacab745a79a",
                                        "glosses": [
                                            "A sexually immoral woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74a0ad3c-ddee-42ce-9583-18ee2ab40689",
                                                "sense_id": "a0da08c4-1a46-3be7-a13a-ccefeccb983d",
                                                "text": "She called him `pig' in bastard Arabic, and he called her `hussy' in good English, but these amenities were forgotten in the face of the catastrophe that had overwhelmed her at the hands of her Queen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5acd0441-a41a-35ae-ab37-b8bcf48d12cc",
                                        "entry_id": "4d94bfb1-2cc1-3cb6-9207-eacab745a79a",
                                        "glosses": [
                                            "A cheeky or disrespectful girl; a woman showing inappropriate or improper behavior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5905d52-3678-434a-802f-089e144cc3e0",
                                                "sense_id": "5acd0441-a41a-35ae-ab37-b8bcf48d12cc",
                                                "text": "Molly the dairymaid came a little way from the rickyard, and said she would pluck the pigeon that very night after work. She was always ready to do anything for us boys; and we could never quite make out why they scolded her so for an idle hussy indoors. It seemed so unjust. Looking back, I recollect she had very beautiful brown eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fef4a1b8-a5ca-366b-9b87-343dea66160f",
                                        "entry_id": "4d94bfb1-2cc1-3cb6-9207-eacab745a79a",
                                        "glosses": [
                                            "A case or bag for needles, thread, etc."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
