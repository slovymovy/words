                    {
                        "translation_id": "a66b0341-a4d6-4c1f-ad96-9c814d98a2a3",
                        "source_entry_id": "36117b68-b2d0-3f39-828c-df3f7dbf89ef",
                        "source_sense_id": "7872b873-207a-3bf5-920b-004c8ade27f1",
                        "source_sense_description": "interrogativ: um welche Sache/Angelegenheit",
                        "target_lang_word": "de quoi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de quoi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce38e76a-e4ce-3431-94da-26db42404752",
                                        "entry_id": "201fbf18-a665-3839-9d33-184231a16a9d",
                                        "glosses": [
                                            "(Suivi d'un verbe à l'infinitif) Ce qui est nécessaire pour, ce qu’il faut pour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e5eadd8-2f00-42e6-9962-64c36fba2bf6",
                                                "sense_id": "ce38e76a-e4ce-3431-94da-26db42404752",
                                                "text": "J’ai de quoi vous répondre."
                                            },
                                            {
                                                "example_id": "cd2d9d78-2f38-445c-9323-4baf50e59db7",
                                                "sense_id": "ce38e76a-e4ce-3431-94da-26db42404752",
                                                "text": "Ne te gêne pas, réponds [au téléphone]. Je t'en prie, j'ai de quoi m'occuper."
                                            },
                                            {
                                                "example_id": "4bb13eae-0853-4d8e-9de9-55c22685a753",
                                                "sense_id": "ce38e76a-e4ce-3431-94da-26db42404752",
                                                "text": "Elle était prenable, cette équipe de France. Il y a de quoi avoir des regrets."
                                            },
                                            {
                                                "example_id": "2327ac16-612c-4ef8-a72e-a96a267aab4c",
                                                "sense_id": "ce38e76a-e4ce-3431-94da-26db42404752",
                                                "text": "Cette prétention a de quoi me surprendre."
                                            },
                                            {
                                                "example_id": "e4fad0d1-36a8-426a-aa59-9228f3935627",
                                                "sense_id": "ce38e76a-e4ce-3431-94da-26db42404752",
                                                "text": "Donnez-moi de quoi écrire."
                                            },
                                            {
                                                "example_id": "fa5d1158-30f5-44e7-a0de-b88a885d5047",
                                                "sense_id": "ce38e76a-e4ce-3431-94da-26db42404752",
                                                "text": "Voici de quoi faire les frais du repas que tu es obligée de donner demain."
                                            },
                                            {
                                                "example_id": "0990314c-4658-432e-ae70-e94bde2a578f",
                                                "sense_id": "ce38e76a-e4ce-3431-94da-26db42404752",
                                                "text": "— Combien ? demanda Ouroz.\n— Oh ! pas une fortune, répliqua Mokkhi avec un rire qui sonna faux. Juste de quoi…"
                                            },
                                            {
                                                "example_id": "4717c1aa-06da-4b8b-99c5-62c574aa720f",
                                                "sense_id": "ce38e76a-e4ce-3431-94da-26db42404752",
                                                "text": "J'empruntais à mon copain de quoi payer mon billet d'autocar jusqu'à Casa, où je comptais bien me glisser à bord d'un bateau en partance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5631c984-eed1-3fbf-af7a-8ea45c43c2de",
                                        "entry_id": "201fbf18-a665-3839-9d33-184231a16a9d",
                                        "glosses": [
                                            "(Comme complément direct) Quelque chose."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb29e7fd-0f35-4a51-bdc0-236455f67f50",
                                                "sense_id": "5631c984-eed1-3fbf-af7a-8ea45c43c2de",
                                                "text": "J'ai pensé à de quoi hier..."
                                            },
                                            {
                                                "example_id": "d690c82e-064b-4daf-bad0-9a7b6cddacbd",
                                                "sense_id": "5631c984-eed1-3fbf-af7a-8ea45c43c2de",
                                                "text": "Ils ont vu de quoi, alors que tout le monde voyait une petite fille gênée avec un gros trou noir au lieu du cœur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "de quoi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7c0656a-e5d2-37f2-9736-76c07e740d43",
                                        "entry_id": "9dedff82-d70d-38b1-8e22-3de0a0b272da",
                                        "glosses": [
                                            "Qu’est-ce à dire."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
