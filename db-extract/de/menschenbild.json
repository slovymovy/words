                ],
                "senses": [
                    {
                        "sense_id": "95ad1da5-5a7d-3850-ab29-db99c96762f1",
                        "entry_id": "a14e0d06-9085-3d30-a530-167d872410ee",
                        "glosses": [
                            "Eindruck oder Meinung, die eine Person über Menschen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df8f286-2cfb-486d-9be1-ff4fbd7cd9f9",
                                "sense_id": "95ad1da5-5a7d-3850-ab29-db99c96762f1",
                                "text": "„Ich glaube, wir können es schaffen, aus unserer Sprachlosigkeit und unseren Fehlern der Vergangenheit zu lernen, einander zu verstehen, zu akzeptieren und ein gesundes, der Kulturenvielfalt in unserem Lande Rechnung tragendes Menschenbild zu entwickeln.“"
                            },
                            {
                                "example_id": "2759a9ad-c4cf-4d9a-927e-563320fdaa67",
                                "sense_id": "95ad1da5-5a7d-3850-ab29-db99c96762f1",
                                "text": "„Es ist das Neue, das sie dem modernen Menschenbild eingeschrieben hat.“"
                            },
                            {
                                "example_id": "06313a58-3aee-470e-ab8a-1f4a8ad08949",
                                "sense_id": "95ad1da5-5a7d-3850-ab29-db99c96762f1",
                                "text": "„Dieser würde damit zum »guten Menschen« aufgewertet, den es in Buschs Menschenbild überhaupt nicht gab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
