        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9dd10d1-303e-3242-9b1a-9740d48b1767",
                    "sense_definition": "Participe présent de <w>étinceler</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>étincelant</w> dans la nuit noire, les lucioles guidaient nos pas sur le chemin.",
                            "target_lang_translations": {
                                "en": "<w>Sparkling</w> in the dark night, the fireflies guided our steps along the path.",
                                "ru": "<w>Сверкая</w> в тёмной ночи, светлячки направляли наши шаги по тропинке.",
                                "de": "<w>Funkelnd</w> in der schwarzen Nacht leiteten die Glühwürmchen unsere Schritte auf dem Weg.",
                                "es": "<w>Centelleando</w> en la noche oscura, las luciérnagas guiaban nuestros pasos por el camino.",
                                "zh": "萤火虫在漆黑的夜里<w>闪烁</w>，为我们照亮了脚下的小路。"
                            }
                        },
                        {
                            "text": "Le métal chauffé projetait de nombreuses gerbes de feu en <w>étincelant</w> sur l'enclume.",
                            "target_lang_translations": {
                                "en": "The heated metal threw off many showers of fire, <w>sparkling</w> on the anvil.",
                                "ru": "Раскалённый металл разбрасывал множество снопов огня, <w>сверкая</w> на наковальне.",
                                "de": "Das erhitzte Metall warf zahlreiche Feuergarben aus und <w>funkelte</w> dabei auf dem Amboss.",
                                "es": "El metal calentado lanzaba numerosos haces de fuego, <w>centelleando</w> sobre el yunque.",
                                "zh": "烧红的金属在铁砧上<w>闪光</w>，溅起一簇簇火花。"
                            }
                        }
