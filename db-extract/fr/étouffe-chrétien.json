        "fr-extract.jsonl": [
            {
                "entry_id": "06422892-3847-3b5d-a515-d79f419b76ef",
                "word": "étouffe-chrétien",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8ea2c57d-c398-3924-82d0-c7e047228c8c",
                        "entry_id": "06422892-3847-3b5d-a515-d79f419b76ef",
                        "glosses": [
                            "Très nourrissant ; bourratif au point d'être indigeste."
                        ],
                        "tags": [
                            "hyperbole"
                        ],
                        "examples": [
                            {
                                "example_id": "a5415d12-122e-439f-b7d0-77e77b92e117",
                                "sense_id": "8ea2c57d-c398-3924-82d0-c7e047228c8c",
                                "text": "Fougère opine, les plumes de son chapeau touchent terre, ça doit être très étouffe-chrétien, un croupion d’autruche, quand on y pense."
                            },
                            {
                                "example_id": "ba48a992-e09b-4778-b7d9-ba64ff155b4b",
                                "sense_id": "8ea2c57d-c398-3924-82d0-c7e047228c8c",
                                "text": "C'est le cuisinier le plus inventif en Lot-et-Garonne et même peut-être dans tout le Sud-Ouest. Il mérite le déplacement jusqu'à ce petit village de Moirax, […]. Une cuisine éclatante qui fait facilement oublier foies gras, magrets et autres spécialités locales un peu étouffe-chrétien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b9fc3ee-2703-4973-8ba6-bb92db01f383",
                        "source_entry_id": "06422892-3847-3b5d-a515-d79f419b76ef",
                        "source_sense_id": "8ea2c57d-c398-3924-82d0-c7e047228c8c",
                        "target_lang_word": "stodgy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stodgy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8752d94a-a1d4-3f4d-b016-9e356780f7e7",
                                        "entry_id": "4c5a3762-b037-386d-8a62-6cedb3217bf3",
                                        "glosses": [
                                            "Dull, old-fashioned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11b2a67e-c434-44c2-8066-a00ec5eff3b7",
                                                "sense_id": "8752d94a-a1d4-3f4d-b016-9e356780f7e7",
                                                "text": "I gave up trying to get that stodgy club to try anything new."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46841a85-ca07-3f51-b247-94356716bedd",
                                        "entry_id": "4c5a3762-b037-386d-8a62-6cedb3217bf3",
                                        "glosses": [
                                            "Having a thick, semi-solid consistency; glutinous; heavy on the stomach."
                                        ],
                                        "tags": [
                                            "of food"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c4d4968-7750-4108-9aa9-7a0761c62ef1",
                                                "sense_id": "46841a85-ca07-3f51-b247-94356716bedd",
                                                "text": "\"What's the matter with you?\" — \"Nothing. I'm sorry to be so damned emotional, but for six months I've been starved for beauty.\" — \"You used to be so matter of fact. It's very interesting to hear you say that.\" — \"Damn it all, I don't want to be interesting,\" laughed Philip. \"Let's go and have a stodgy tea.\""
                                            },
                                            {
                                                "example_id": "7530357b-9a47-4d6e-a4a3-32322a540c44",
                                                "sense_id": "46841a85-ca07-3f51-b247-94356716bedd",
                                                "text": "“. . . Why! Why! Why is the middle-class so stodgy—so utterly without a sense of humour! My dear, it's only by a fluke that I am here at all—Norman being the protective fluke.”"
                                            },
                                            {
                                                "example_id": "375d4a37-aeee-4741-a983-f0839546bf46",
                                                "sense_id": "46841a85-ca07-3f51-b247-94356716bedd",
                                                "text": "The Southampton striker, who also struck a post late on, was being serenaded by the Wembley crowd before the end and should probably brace himself for some Lambert-mania over the coming days but, amid the eulogies, it should not overlook the deficiencies that were evident in another stodgy England performance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "017e84db-b574-3ca4-88f0-99389ee59720",
                                        "entry_id": "4c5a3762-b037-386d-8a62-6cedb3217bf3",
                                        "glosses": [
                                            "Badly put together."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
