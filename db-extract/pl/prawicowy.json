                        "glosses": [
                            "związany z prawicą, właściwy prawicy, wywodzący się z prawicy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46cff277-e35f-4491-8b5f-8640bdb8e310",
                                "sense_id": "893f9f09-5947-3e99-8b31-4899471736fb",
                                "text": "W miejsce koncepcji federalistycznej zaczęła stopniowo dominować, wywodząca się z nacjonalistycznej myśli prawicowej, koncepcja inkorporacji"
                            }
