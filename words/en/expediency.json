                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The minister chose political <w>expediency</w> over his core moral convictions."
                        },
                        {
