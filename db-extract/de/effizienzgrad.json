                ],
                "senses": [
                    {
                        "sense_id": "c821d435-28a2-3874-86dd-6704b48e958f",
                        "entry_id": "f44c6f47-7b63-306c-8925-15d4158f64b4",
                        "glosses": [
                            "Verhältnis, in dem ein eingesetzter Aufwand zu einem erhaltenen Nutzen steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7afac172-a6ee-42ba-aaff-e2509c48a1ca",
                                "sense_id": "c821d435-28a2-3874-86dd-6704b48e958f",
                                "text": "„Effizienzgrade sind Maßstäbe der realisierten oder nicht realisierten Effizienz. Sie werden entweder durch Quotientenbildung oder durch Differenzbildung konkretisiert.“"
                            },
                            {
                                "example_id": "6a391574-8f48-475a-9742-d7bbd2680b98",
                                "sense_id": "c821d435-28a2-3874-86dd-6704b48e958f",
                                "text": "„Der Effizienzgrad bezeichnet einen Parameter in der Berechnung der Zieleffizienz eines Ventilators in Abhängigkeit von der elektrischen Eingangsleistung im Energieeffizienz-Optimum.“"
                            },
                            {
                                "example_id": "fac44433-95e6-4109-8066-c5f272253179",
                                "sense_id": "c821d435-28a2-3874-86dd-6704b48e958f",
                                "text": "„Die Erhöhung des Effizienzgrades hat einen Maximal-Wert (33,7%), der überschreitet werden kann, wenn mehrere dünne aufeinander gelegte Sonnenzellen eingesetzt werden, weil sie so pro Schicht auf immer kürzere Lichtwellenlänge empfindlich sind.“"
                            },
                            {
                                "example_id": "de09b34f-f3a6-43fd-afe2-8a70f1206415",
                                "sense_id": "c821d435-28a2-3874-86dd-6704b48e958f",
                                "text": "„Gemäß dieser Verordnung müssen interne Netzteile einen Effizienzgrad von 85% bei 50% der Nennleistung und einen Effizienzgrad von 82% bei 20% und 100% der Nennleistung erreichen.“"
                            },
                            {
                                "example_id": "add2d9b2-370c-4b76-b701-3df9bc9104e6",
                                "sense_id": "c821d435-28a2-3874-86dd-6704b48e958f",
                                "text": "„Der Effizienzgrad des Herzens liegt bei ca.: 30 % - 40 %. Dies ist ein überdurchschnittlich guter Wert. Dabei ist der Effizienzgrad bei einer Volumenbelastung höher als bei einer Druckbelastung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
