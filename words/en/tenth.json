                },
                {
                    "sense_id": "e87d8af8-d7a9-36d7-b33c-5d650b8e3db0",
                    "sense_definition": "The person or thing in the tenth position.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ordinal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "September is the ninth month, and October is the <w>tenth</w>.",
                            "target_lang_translations": {
                                "ru": "Сентябрь — девятый месяц, а Октябрь — <w>десятый</w>.",
                                "zh": "九月是第九个月，十月是<w>第十</w>个。"
                            }
                        },
                        {
                            "text": "He was the <w>tenth</w> to cross the finish line in the marathon.",
                            "target_lang_translations": {
                                "ru": "Он пришел к финишу марафона <w>десятым</w>.",
                                "zh": "他是马拉松比赛中<w>第十</w>个冲过终点线的人。"
                            }
                        }
