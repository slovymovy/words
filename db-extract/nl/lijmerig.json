                                "target_senses": [
                                    {
                                        "sense_id": "812c7683-39eb-3834-b5cc-3bd80011a8b7",
                                        "entry_id": "996aad73-c0d1-388b-bb30-3d9df43428c2",
                                        "glosses": [
                                            "Glue-like, sticky, viscid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86fd5e4d-75a4-4e7b-aa1c-59ecd4fb763a",
                                                "sense_id": "812c7683-39eb-3834-b5cc-3bd80011a8b7",
                                                "text": "Then comes the dinner, a glutinous spread that seems simultaneously generous and disgusting, but no one ever touches the food"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9549cc48-fdb0-3ffa-be78-f92d6c271dd2",
