                                        "entry_id": "08c27e7e-514b-3c63-98b9-f77d06f28660",
                                        "glosses": [
                                            "A member of the imperial body guard at Constantinople from 955."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "424e277a-c5bf-40df-ac42-ae1cdc778206",
                                                "sense_id": "e198fd0e-253d-3098-8cee-18868c06b2a9",
                                                "text": "The Byzantines continued to recruit elite warriors from the north, not merely from Rus’ but directly from far-off Scandinavia; from the end of the tenth century, they referred to them as ‘Varangians’."
                                            }
                                        ]
