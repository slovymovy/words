        "fr-extract.jsonl": [
            {
                "entry_id": "f76fb6b6-0c21-3537-a6e7-fc313dcce5ab",
                "word": "cliquette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fbcd5267-a9f1-4406-9d78-8cd5593b3aea",
                        "entry_id": "f76fb6b6-0c21-3537-a6e7-fc313dcce5ab",
                        "tags": [
                            "plural"
                        ],
                        "form": "cliquettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "103241ae-8571-38d8-8d31-b2644b7d36ef",
                        "entry_id": "f76fb6b6-0c21-3537-a6e7-fc313dcce5ab",
                        "glosses": [
                            "Sorte d’instrument fait de deux os, de deux morceaux de bois ou de deux tessons, etc., qu’on met entre les doigts et dont on tire un son mesuré, en les battant l’un contre l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d96a4f67-09a9-48d8-8bd1-ca50aac23c60",
                                "sense_id": "103241ae-8571-38d8-8d31-b2644b7d36ef",
                                "text": "De Wissembourg jusqu’à Champigny, il avait fait toute la campagne, traversant les champs de bataille comme un oiseau de tempête, avec ses cliquettes de fer et sa derbouka (tambour arabe)."
                            },
                            {
                                "example_id": "46693104-25a4-4eaf-87fc-c00c7d970579",
                                "sense_id": "103241ae-8571-38d8-8d31-b2644b7d36ef",
                                "text": "Aux heures des offices on entendait les petites voix grêles des enfants traînant par les rues. Ils agitaient des cliquettes de bois blanc dont les sons vibraient, comme un chant de sauterelles dans l’épaisseur des blés :\n— Voilà le premier. Mettez vos beaux souliers.\n— Voilà le second. Mettez vos beaux jupons."
                            }
                        ]
                    },
                    {
                        "sense_id": "51d3f888-5b7a-3aa1-846a-6b6a85459c0e",
                        "entry_id": "f76fb6b6-0c21-3537-a6e7-fc313dcce5ab",
                        "glosses": [
                            "Instrument utilisé au Moyen-Âge par les lépreux pour se signaler."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "4966267b-7a68-4e74-9725-525551609b45",
                                "sense_id": "51d3f888-5b7a-3aa1-846a-6b6a85459c0e",
                                "text": "Jouer des cliquettes. Les ordonnances obligeaient autrefois les lépreux à porter des cliquettes, afin qu’on se détournât de leur chemin."
                            },
                            {
                                "example_id": "7cb1bab3-8317-4820-ae3f-a0ee4773faad",
                                "sense_id": "51d3f888-5b7a-3aa1-846a-6b6a85459c0e",
                                "text": "Ne vous a-t-on jamais parlé de cette femme autrefois qui vivait seule dans les roches du Géyn\nToute voilée du haut en bas et qui avait une cliquette à la main ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "f3d8f60f-0e71-3a71-8407-f0e27165e388",
                        "entry_id": "f76fb6b6-0c21-3537-a6e7-fc313dcce5ab",
                        "glosses": [
                            "Oreille"
                        ],
