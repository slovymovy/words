                                "target_lang_sense_clarification": "отдельный след грязи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92350680-dd2e-363e-a9c8-2a66e60965bc",
                    "sense_definition": "substancja lub materiał powodujący zanieczyszczenie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "brud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Filtry w wentylacji zatrzymują cząsteczki kurzu i inne niebezpieczne <w>zabrudzenia</w>.",
                            "target_lang_translations": {
                                "ru": "Фильтры в вентиляции задерживают частицы пыли и другие опасные <w>загрязнения</w>."
                            }
                        },
                        {
                            "text": "W wodzie wykryto chemiczne <w>zabrudzenie</w>, które zagrażało rybom w stawie.",
                            "target_lang_translations": {
                                "ru": "В воде было обнаружено химическое <w>загрязнение</w>, которое угрожало рыбе в пруду."
                            }
                        }
                    ],
                    "synonyms": [
                        "zanieczyszczenie",
                        "nieczystość"
                    ],
                    "common_phrases": [
                        "chemiczne zabrudzenie"
                    ],
                    "target_lang_definitions": {
