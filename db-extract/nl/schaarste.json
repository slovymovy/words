                        "sense_id": "f25bf15e-86e5-3882-a13b-c0c74148b082",
                        "entry_id": "3ab46ac4-5206-375d-9506-da1822663626",
                        "glosses": [
                            "tijd waarin het aanbod van iets veel lager is dan de vraag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f62fbe5-87af-4ee4-9199-66c3b08da151",
                                "sense_id": "f25bf15e-86e5-3882-a13b-c0c74148b082",
                                "text": "Door de mislukte oogst heerst er schaarste op de graanmarkt."
                            }
