                {
                    "sense_id": "3100788d-bd87-386b-baac-65c60d7bcfcb",
                    "sense_definition": "vervelend, onaangenaam of flauw op een manier die irritatie opwekt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervelend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is een beetje <w>lullig</w> om nooit een rondje te betalen voor je vrienden.",
                            "target_lang_translations": {
                                "en": "It's a bit <w>shabby</w> to never buy a round for your friends.",
                                "de": "Es ist ein bisschen <w>schäbig</w>, seinen Freunden nie eine Runde auszugeben."
                            }
                        },
                        {
                            "text": "Ik vind het echt een <w>lullige</w> opmerking van hem na al mijn harde werk.",
                            "target_lang_translations": {
                                "en": "I think that was a really <w>mean</w> remark from him after all my hard work.",
                                "de": "Ich finde das wirklich eine <w>fiese</w> Bemerkung von ihm nach all meiner harten Arbeit."
                            }
                        }
                    ],
                    "synonyms": [
                        "vervelend",
                        "onaangenaam",
                        "flauw",
                        "gemeen",
                        "rot"
                    ],
                    "antonyms": [
                        "aardig",
                        "sympathiek"
                    ],
                    "common_phrases": [
                        "een lullige opmerking",
                        "een beetje lullig"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
