                                        "sense_id": "5d5ff4c0-7368-3b32-9723-aa800dfddac5",
                                        "entry_id": "da0ab81c-c426-3154-879c-87430b52e26b",
                                        "glosses": [
                                            "Alternative form of blood loss."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "257d2649-445f-417d-bad3-07ebebc02332",
                                                "sense_id": "5d5ff4c0-7368-3b32-9723-aa800dfddac5",
                                                "text": "Red blood cells with or without cryosupernatant plasma depending on volume need were given to compensate for bloodloss."
                                            },
                                            {
                                                "example_id": "f5ab65af-5ba9-4296-ba78-31b8e1d45b2c",
                                                "sense_id": "5d5ff4c0-7368-3b32-9723-aa800dfddac5",
                                                "text": "Thus, bloodloss also revealed in rabbits subjected to prolonged Fe administration certain changes in leucopoiesis, especially in lymphopoiesis."
                                            },
                                            {
                                                "example_id": "98d9b7b5-c9ad-43c2-b7f8-ea70f4f61f9f",
                                                "sense_id": "5d5ff4c0-7368-3b32-9723-aa800dfddac5",
                                                "text": "An important problem is the coagulation abnormalities, intrinsic to the deterioration of liver function, with subsequent massive peroperative bloodloss."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84def4a3-300f-432b-a58c-a98b8e265f64",
                        "source_entry_id": "c97865cd-abb2-35fe-9369-927c5aaa986a",
                        "source_sense_id": "3ebbf6b2-129d-3772-a9f5-ca9a0933e36d",
                        "target_lang_word": "Blutverlust",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutverlust",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51c89c0b-c390-31fd-b55a-93d0ca98293a",
                                        "entry_id": "985cfd2a-0207-3e57-a614-ace4d4c31132",
                                        "glosses": [
                                            "Verlust von Blut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "094aa005-56b4-4c36-8e9f-ced27eccada8",
                                                "sense_id": "51c89c0b-c390-31fd-b55a-93d0ca98293a",
                                                "text": "Der Blutverlust konnte erfolgreich behandelt werden."
                                            },
                                            {
                                                "example_id": "4a92c47f-60a6-4dd4-8160-dc8ab13d3fae",
                                                "sense_id": "51c89c0b-c390-31fd-b55a-93d0ca98293a",
                                                "text": "„Doch auch jetzt noch sollten die Waffen seiner schonen, daß nicht Blutverlust, Schmerz und Angst ihn vor der eigentlichen, der echten großen Marterung schwächten und die Zuschauer um den höchsten Genuß des Festspiels verkürzten.“"
                                            },
                                            {
                                                "example_id": "e3f93ad2-2a78-4c72-9f71-fefe5f80571b",
                                                "sense_id": "51c89c0b-c390-31fd-b55a-93d0ca98293a",
                                                "text": "„Blutverlust und frühere Erschöpfung hatten die Kräfte des jungen Menschen so ganz aufgerieben, daß sie ihn kaum mit Anstrengung aller ihrer Kräfte aufrecht erhalten konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9b65028f-2c68-3103-a2f0-1f030c32932a",
                                        "entry_id": "985cfd2a-0207-3e57-a614-ace4d4c31132",
                                        "glosses": [
                                            "Verlust an Menschenleben"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c088481a-695b-46b1-a08f-ec5fa1f6a2fd",
                                                "sense_id": "9b65028f-2c68-3103-a2f0-1f030c32932a",
                                                "text": "„Was diesen ungeheuren Blutverlust, den schwersten des ganzen Krieges, zu einer so vernichtenden Anklage gegen die deutsche Heerführung macht, war, daß er seit Mai ohne jeden schlüssigen strategischen Gedanken in Kauf genommen wurde, also praktisch für nichts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
