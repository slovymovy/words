                        "glosses": [
                            "Roche sédimentaire détritique, riche en quartz et en muscovite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eee6917a-b26a-49bc-a2b4-81a9dd1529ae",
                                "sense_id": "288d273b-6c4d-3c64-8253-4a725b537a6c",
                                "text": "On retrouve ce psammite à l'Est, à mi-hauteur du chemin d’Aiglemont, où il passe en dessus et en dessous des schistes gris bleu, quarzeux."
                            },
                            {
                                "example_id": "70aa2235-1452-4de4-83f6-2e373fe2c7c2",
                                "sense_id": "288d273b-6c4d-3c64-8253-4a725b537a6c",
                                "text": "Au delà de Couiza, le premier est encore représenté par des grès gris-jaunâtres, des psammites et des poudingues constituant les collines de la rive gauche de l’Aude jusqu’à Esperaza et se prolongeant à l’O. vers Rouvenac."
                            }
                        ]
                    }
