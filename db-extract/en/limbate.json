                "translations": [
                    {
                        "translation_id": "2d8901ee-e756-4eef-82f7-5ae8823e3cbd",
                        "source_entry_id": "f188beaf-1980-3512-92ec-bea81fba6d15",
                        "source_sense_id": "fec7483a-5232-3cc2-8db3-9bcf830938dc",
                        "source_sense_description": "having a distinct edge",
                        "target_lang_word": "bordé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bordé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4433794f-e398-3a91-895c-b1c358e775d2",
                                        "entry_id": "b8ff6f93-f756-3797-8534-8bd1a6c27a20",
                                        "glosses": [
                                            "Garni d'un bord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec05e8d2-a050-49e7-b25a-1035f6465f50",
                                                "sense_id": "4433794f-e398-3a91-895c-b1c358e775d2",
                                                "text": "La construction du bateau fut activement poussée, et il devait être entièrement bordé et ponté avant la fin du mois."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bordé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ae73c78-3714-3346-9f52-f570c814a8da",
                                        "entry_id": "c67d5cf9-ea5e-3333-808c-0dc454e5ddc5",
                                        "glosses": [
                                            "Galon d’or, d’argent ou de soie qui sert à border des vêtements, des meubles, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36fd8da8-4141-4d4d-b91d-3c7c6cec279e",
                                                "sense_id": "8ae73c78-3714-3346-9f52-f570c814a8da",
                                                "text": "Son habit n’avait qu’un simple bordé."
                                            },
                                            {
                                                "example_id": "6c8365a5-735b-4c24-9523-db0e27d54573",
                                                "sense_id": "8ae73c78-3714-3346-9f52-f570c814a8da",
                                                "text": "Il faut mettre un petit bordé à ces rideaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff7556b6-aca7-3516-92eb-26d365ce7ebf",
                                        "entry_id": "c67d5cf9-ea5e-3333-808c-0dc454e5ddc5",
                                        "glosses": [
                                            "Ensemble des parties qui constituent la coque extérieure d'un bateau ; le bordé s'appuie sur la charpente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d12b392-3298-4bd1-982e-c93d63c6d1f2",
                                                "sense_id": "ff7556b6-aca7-3516-92eb-26d365ce7ebf",
                                                "text": "Les bordés de carène."
                                            },
                                            {
                                                "example_id": "6847643c-0e80-4d01-bf37-fcc6df93f277",
                                                "sense_id": "ff7556b6-aca7-3516-92eb-26d365ce7ebf",
                                                "text": "Les bordés des ponts."
                                            },
                                            {
                                                "example_id": "e9402673-996a-4119-a81c-53f5a1b813b6",
                                                "sense_id": "ff7556b6-aca7-3516-92eb-26d365ce7ebf",
                                                "text": "Ils viennent d'apercevoir le bateau. Leur vieux bateau. Il a besoin d'être écopé, l'eau affleure le caillebotis. Mais le fond a été repassé au coaltar, le bordé repeint, les tolets graissés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bordé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cdfe33e-49a3-3c47-a2b4-0b74c65d8c4a",
                                        "entry_id": "ce54f7c8-1105-34f0-bd68-a39148195b56",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe border."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "251511e0-01dc-45eb-8cd4-3efba2cadfcf",
                                                "sense_id": "4cdfe33e-49a3-3c47-a2b4-0b74c65d8c4a",
                                                "text": "Quelques mois se sont passés pendant lesquels j’ai été bilanisé, palpé, stéthoscopé, pulsé, tensiomètré, prisedesangué, radiographié, électrocardiographié, échocardiographié, test-défortisé, scannérisé, IRMé, coronarographié, ambulancé, transbahuté, piqué, somnifèré, anesthésié, quasi-congelé (28°), hiberné, opéré, saigné, entubé, scié, incisé, ponté, clippé, couturé, rafistolé, pansementé, drainé, désentubé, réanimé, bordé, débordées (les infirmières), dépansementé, goutteàgoutté, médicamenté (de toute couleur, forme, de (dé)goût), thermomètré, bêta-bloquanté, anti-inflammatoirisé, alimenté, gymnastiqué, véloté, véhiculé, SAMUé, cicatrisé, urinovolumètré, désalé (le régime), pesé, suppositoirisé (pour transiter), monitoringué (à distance), brancardé, chaise-roulanté, hématomé, œdèmé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07879920-3473-4e22-ac38-a848ec2a1e9c",
                        "source_entry_id": "f188beaf-1980-3512-92ec-bea81fba6d15",
