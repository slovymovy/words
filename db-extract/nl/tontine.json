                    },
                    {
                        "sense_id": "8b1a8d77-c984-3958-9de0-8337c54eb972",
                        "entry_id": "5a289386-2423-3945-b0f3-f7b7eeb1ae98",
                        "glosses": [
                            "regeling tussen samenwonenden partners die het eigendom van een goed vastlegt als een van de partners sterft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c8dc81d-6c6c-4bd7-939b-20a72db255a2",
                                "sense_id": "8b1a8d77-c984-3958-9de0-8337c54eb972",
                                "text": "Een tontineclausule werd vroeger vaak gebruikt tussen samenwonenden, gezien zij geen automatisch erfrecht hadden en de successierechten tussen hen ook erg hoog lagen (vroeger tarief vreemden tussen 45 en 65 %). Tussen gehuwden was een tontine minder nuttig omdat gehuwden sowieso aan lage tarieven konden erven (vanaf 3 % tot 27 %)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47936819-9730-4f4e-aea4-e17639a84c7e",
                        "source_entry_id": "5a289386-2423-3945-b0f3-f7b7eeb1ae98",
                        "source_sense_id": "4b16a0dc-15af-37db-9e40-85495e3ea4b5",
                        "source_sense_description": "lijfrente die uitbetaald wordt aan de overlevende deelnemers",
                        "target_lang_word": "tontine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tontine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f40e12d3-346c-3813-be63-c53bbabcdd08",
                                        "entry_id": "7335a3e4-00c7-3bc2-a5d5-bed0c0580225",
                                        "glosses": [
                                            "A form of investment in which, on the death of an investor, his share is divided amongst the other investors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ed7f404-5f5a-4233-9b6c-e1816ae2f47b",
                                                "sense_id": "f40e12d3-346c-3813-be63-c53bbabcdd08",
                                                "text": "When Joseph Finsbury and his brother Masterman were little lads in white-frilled trousers, their father—a well-to-do merchant in Cheapside—caused them to join a small but rich tontine of seven-and-thirty lives."
                                            },
                                            {
                                                "example_id": "321be5a5-08bb-4a5b-bf00-0855310c732a",
                                                "sense_id": "f40e12d3-346c-3813-be63-c53bbabcdd08",
                                                "text": "There were many speculative schemes which gambled on the expectation of an individual's life, as in the tontine system, whereby all the group's contributions went to the last survivor."
                                            },
                                            {
                                                "example_id": "6d739f53-1b3f-4c9d-ba7e-21524c14b73e",
                                                "sense_id": "f40e12d3-346c-3813-be63-c53bbabcdd08",
                                                "text": "They were pleasantly high, but in an almost self-conscious way, as if they were members of a tontine blessed by the unexpected death of two or three of its members."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
