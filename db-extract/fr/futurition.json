        "fr-extract.jsonl": [
            {
                "entry_id": "608470c7-16b7-30cd-aed0-19a5f77be933",
                "word": "futurition",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "395e75c6-e7ec-4a67-9460-780d393da1b5",
                        "entry_id": "608470c7-16b7-30cd-aed0-19a5f77be933",
                        "tags": [
                            "plural"
                        ],
                        "form": "futuritions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ece44a30-9cda-3d71-afd6-ec3e7a38d7a7",
                        "entry_id": "608470c7-16b7-30cd-aed0-19a5f77be933",
                        "glosses": [
                            "Caractère d’une chose future, projection dans le futur."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "60b83c3d-eb5c-4deb-81d1-1615237c2ad2",
                                "sense_id": "ece44a30-9cda-3d71-afd6-ec3e7a38d7a7",
                                "text": "Les pronostics de notre futurition sont vains ; nous sommes ce que nous font les circonstances : qu’un enfant soit gai ou triste, silencieux ou bruyant, qu’il montre ou ne montre pas des aptitudes au travail, nul augure à en tirer."
                            },
                            {
                                "example_id": "7f7e7596-128d-4611-bd8f-5492a5b2655c",
                                "sense_id": "ece44a30-9cda-3d71-afd6-ec3e7a38d7a7",
                                "text": "Les valeurs et les vertus proprement humaines — c’est-à-dire, assez essentielles pour fonder la transcendance d’un idéal du Moi altruiste, historiquement chargé de futuritions collectives — ne peuvent se concevoir ni se mesurer uniquement à l’aune de la capacité de résistance à la torture."
                            },
                            {
                                "example_id": "35bf21fb-f64f-4eaa-80f2-ce7167a422b2",
                                "sense_id": "ece44a30-9cda-3d71-afd6-ec3e7a38d7a7",
                                "text": "Par la futurition, l’homme est dans le temps comme auteur de sa temporalité interne. Comme jouissant d’un délai destinal, l’homme est dans le temps comme acteur de la vie qui lui a été assignée, du temps qui lui a été fixé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60dd18c9-7a1a-4e5a-86a7-5216570f6450",
                        "source_entry_id": "608470c7-16b7-30cd-aed0-19a5f77be933",
                        "source_sense_id": "ece44a30-9cda-3d71-afd6-ec3e7a38d7a7",
                        "target_lang_word": "futurition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "futurition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66a3500a-e307-3d04-a50a-28afd8281b12",
                                        "entry_id": "e2a9c38b-cbc5-388c-a525-342ae0a7c96c",
                                        "glosses": [
                                            "Synonym of futurity: the state of being future."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3b45aa3-159f-4ab8-a493-6a5b3520c1f2",
                                                "sense_id": "66a3500a-e307-3d04-a50a-28afd8281b12",
                                                "text": "Nothing […] can have this imagined futurition, but as it is decreed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e319d54-5661-4653-8c8d-32dc7846ff62",
                        "source_entry_id": "608470c7-16b7-30cd-aed0-19a5f77be933",
                        "source_sense_id": "ece44a30-9cda-3d71-afd6-ec3e7a38d7a7",
                        "target_lang_word": "futurity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "futurity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e97d824c-e196-3d04-a039-3b27189e95c1",
                                        "entry_id": "0f58bd6e-5b9d-3ead-8031-254eccab04a4",
                                        "glosses": [
                                            "The future."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86610f0b-d281-468b-8938-5d164fe6be79",
                                                "sense_id": "e97d824c-e196-3d04-a039-3b27189e95c1",
                                                "text": "Charles's was just an exciting consciousness; and he paced the streets, sometimes roused into disdain of the busy and thoughtless crowd around, but oftener lost in gloomy dreams of that futurity whose depths he was so soon to explore."
                                            },
                                            {
                                                "example_id": "c7a18a35-d93f-4667-86fc-bed341160e6a",
                                                "sense_id": "e97d824c-e196-3d04-a039-3b27189e95c1",
                                                "text": "Now instead of reversing the levers I had pulled them over so as to go forward with them, and when I came to look at these indicators I found that the thousands hand was sweeping round as fast as the seconds hand of a watch, into futurity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "266341ff-231d-36bc-bada-99cc2d27ff10",
                                        "entry_id": "0f58bd6e-5b9d-3ead-8031-254eccab04a4",
                                        "glosses": [
                                            "The state of being in the future."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fec7bb15-b09f-49b4-97a4-421fb82fc713",
                                                "sense_id": "266341ff-231d-36bc-bada-99cc2d27ff10",
                                                "text": "[I]ts meaning is often tentative and fluctuates, but most often it indicates a level of uncertainty or doubt regarding futurity (”likely but not certain“)[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8130f6e4-82ae-3117-a287-7d589837a153",
                                        "entry_id": "0f58bd6e-5b9d-3ead-8031-254eccab04a4",
                                        "glosses": [
                                            "A future event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b7283f8-b37d-4028-bf53-3afe1f91c33a",
                                                "sense_id": "8130f6e4-82ae-3117-a287-7d589837a153",
                                                "text": "[…] on this perhaps,\nThis peradventure, infamous for lies,\nAs on a rock of adamant, we build\nOur mountain hopes; spin out eternal schemes,\nAs we the fatal sisters could out-spin,\nAnd, big with life’s futurities, expire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c30b7db6-48da-3877-983f-1d247aa1cd39",
                                        "entry_id": "0f58bd6e-5b9d-3ead-8031-254eccab04a4",
                                        "glosses": [
                                            "A race for two-year-old horses, nominated to run when still foals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
