                ],
                "senses": [
                    {
                        "sense_id": "cfeec6f2-1250-330d-915d-6a814e691b94",
                        "entry_id": "b17accf6-4452-36b3-b72d-23e12c8f6b61",
                        "glosses": [
                            "Muskulatur, die sich zwischen den Rippen befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "639f5d28-a9df-4235-9ccf-91bca1322364",
                                "sense_id": "cfeec6f2-1250-330d-915d-6a814e691b94",
                                "text": "„Das Atmen beginnt beim Einatmen (Inspiration) in der Regel mit der Interkostalmuskulatur bzw. dem Zwerchfell.“"
                            },
                            {
                                "example_id": "0b7a7e88-e690-4046-ba5c-7320965577d2",
                                "sense_id": "cfeec6f2-1250-330d-915d-6a814e691b94",
                                "text": "„Im Bereich der Thoraxwand wird die Pleura von Rippen, dem Sternum sowie der Interkostalmuskulatur begrenzt.“"
                            },
                            {
                                "example_id": "98557d69-efed-4e15-a8c4-e33468757bdf",
                                "sense_id": "cfeec6f2-1250-330d-915d-6a814e691b94",
                                "text": "„Die Lähmung der Interkostalmuskulatur und des Zwerchfells ist die häufigste Ursache von Atemstörungen; ihr Auftreten ist eine absolute Indikation für die Anwendung der eisernen Lunge.“"
                            },
                            {
                                "example_id": "9c18f0c4-152a-4a93-ab95-0ad35a4e7f0e",
                                "sense_id": "cfeec6f2-1250-330d-915d-6a814e691b94",
                                "text": "„An der gewünschten Stelle wird nach Durchtrennung der Haut und der etwa den Thorax bedeckenden Muskeln die Interkostalmuskulatur parallel den Rippen durchschnitten.“"
                            },
                            {
                                "example_id": "ef598014-e77a-4ea7-89cf-de5d11d8ebec",
                                "sense_id": "cfeec6f2-1250-330d-915d-6a814e691b94",
                                "text": "„Der Thorakalraum wird bei Inspiration durch Kontraktion des Zwerchfells und Erschlaffung der Interkostalmuskulatur (passive Horizontalausrichtung der Rippen) vergrößert und bei Exspiration durch Erschlaffung der Zwerchfell und Kontraktion der Interkostalmuskulatur (aktive Vertikalausrichtung der Rippen) verkleinert.“"
                            },
                            {
                                "example_id": "cd3911b7-987f-43fc-ab34-70ccd9702be6",
                                "sense_id": "cfeec6f2-1250-330d-915d-6a814e691b94",
                                "text": "„Sowohl die Interkostalmuskulatur als auch die anderen am Thorax ansetzenden Muskeln sind gegen das Subkutangewebe durch eine bindegewebige Faszie abgegrenzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
