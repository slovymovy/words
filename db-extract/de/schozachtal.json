                "senses": [
                    {
                        "sense_id": "bbe2d6c3-34b8-316f-a7e7-f95c6040bf5e",
                        "entry_id": "06fad31c-3d28-3a80-9452-62bc7aa6e79a",
                        "glosses": [
                            "das Tal, in dem die Schozach fließt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "781b21fa-918f-4e6b-b10f-39b516033ddc",
                                "sense_id": "bbe2d6c3-34b8-316f-a7e7-f95c6040bf5e",
                                "text": "„Die 18 Teilnehmer kommen aus Musikschulen in ganz Baden-Württemberg wie Bruchsal, Ulm oder dem Schozachtal.“"
                            },
                            {
                                "example_id": "79444849-a5d3-4f54-864d-7020a5e41a91",
                                "sense_id": "bbe2d6c3-34b8-316f-a7e7-f95c6040bf5e",
                                "text": "„Vom Schozachtal geht es durch Weinberge zum Aussichtspunkt „Krappenfelsen“ und weiter zur Villa Rustica, den Resten eines römischen Gutshofes.“"
                            },
                            {
                                "example_id": "d0acc6a2-98ba-403c-8d9d-f3706dae375e",
                                "sense_id": "bbe2d6c3-34b8-316f-a7e7-f95c6040bf5e",
                                "text": "„Auf Wunsch der angrenzenden Region Heilbronn-Franken wurde auch untersucht, welchen Nutzen eine Verlängerung der Trasse ins Schozachtal hinein hätte.“"
                            },
                            {
                                "example_id": "341c5005-e8aa-4bc4-9f44-f5ecb5683a0b",
                                "sense_id": "bbe2d6c3-34b8-316f-a7e7-f95c6040bf5e",
                                "text": "„Die 1409 Mitglieder der Felsengartenkellerei bewirtschaften 699 Hektar Rebfläche im Bereich Mittlerer Neckar, Enztal und Schozachtal.“"
                            },
                            {
                                "example_id": "c21b9bec-41e5-4c5e-8a5c-7030661cd5dd",
                                "sense_id": "bbe2d6c3-34b8-316f-a7e7-f95c6040bf5e",
                                "text": "„Gleich zwei Burgen thronen auf den Weinbergen rund um den beschaulichen Weinort im Schozachtal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
