                        "cross_references": [
                            {
                                "target_word": "mammifère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79f089c7-ac08-3641-aeca-6222f41f825d",
                                        "entry_id": "d0cf232e-0eed-36e5-9884-86c08a78aeca",
                                        "glosses": [
                                            "Animal qui porte des mamelles pour allaiter ses petits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f359f06-f39d-4030-b44a-5db3717e4964",
                                                "sense_id": "79f089c7-ac08-3641-aeca-6222f41f825d",
                                                "text": "Deux mammifères, tous deux de l’ordre des rongeurs, tous deux remarquables par leur fécondité, le rat et le lapin, profitèrent de cette absence de l’homme, et se disputèrent la possession de ces roches abandonnées."
                                            },
                                            {
                                                "example_id": "ebb4260d-cded-44c3-b132-70bf1ced7183",
                                                "sense_id": "79f089c7-ac08-3641-aeca-6222f41f825d",
                                                "text": "Nul autre pays au monde n’abrite davantage de mammifères. Quelques-unes des espèces les plus emblématiques, comme le jaguar et le loup à crinière, sont presque impossibles à apercevoir."
                                            },
                                            {
                                                "example_id": "05a5d9ff-e34f-4ebb-9bf9-e34962d9c025",
                                                "sense_id": "79f089c7-ac08-3641-aeca-6222f41f825d",
                                                "text": "Une femme plus sage aurait sans doute vu dans tout ceci un mauvais présage, mais j’avais perdu toute sagesse. Je n’étais guère plus qu’une mammifère en quête de son partenaire aux quatre coins de la terre."
                                            }
                                        ]
                                    },
