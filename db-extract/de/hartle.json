                "senses": [
                    {
                        "sense_id": "2d24ccca-50af-3665-b6e0-51513fcff939",
                        "entry_id": "3b35ddb2-a0ef-374b-befa-a41a73c0217c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "affe7443-183e-4cb4-8c05-7626cb7f319e",
                                "sense_id": "2d24ccca-50af-3665-b6e0-51513fcff939",
                                "text": "Frau Hartle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "23a2ba78-ecdb-4480-ac60-8f8344a99983",
                                "sense_id": "2d24ccca-50af-3665-b6e0-51513fcff939",
                                "text": "Herr Hartle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b5bbf9d9-98f8-459c-b49b-29fa7c37c034",
                                "sense_id": "2d24ccca-50af-3665-b6e0-51513fcff939",
                                "text": "Die Hartles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4ab792ab-6175-4a7e-be9a-aa9041aa255f",
                                "sense_id": "2d24ccca-50af-3665-b6e0-51513fcff939",
                                "text": "Der Hartle trägt nie die Schals, die die Hartle ihm strickt."
                            },
                            {
                                "example_id": "beec36d4-ee9b-408c-ac97-bb1b33a10aa0",
                                "sense_id": "2d24ccca-50af-3665-b6e0-51513fcff939",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hartle kommt, geht der Herr Hartle.“"
                            },
                            {
                                "example_id": "27ee96e3-d8cd-43c8-bab4-bbce615721e2",
                                "sense_id": "2d24ccca-50af-3665-b6e0-51513fcff939",
                                "text": "Hartle kommt und geht."
                            },
                            {
                                "example_id": "a1bcad3b-d531-44c4-8185-60ebcebc0bdd",
                                "sense_id": "2d24ccca-50af-3665-b6e0-51513fcff939",
                                "text": "Hartles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
