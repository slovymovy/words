    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ac2cee7-8636-3b2d-b4a1-935c8a416f0a",
                    "sense_definition": "An element on a kitchen stove that generates localized heat for cooking.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "heating_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She turned on the front <w>burner</w> to boil a pot of water for the pasta.",
                            "target_lang_translations": {
                                "ru": "Она включила переднюю <w>конфорку</w>, чтобы вскипятить кастрюлю воды для пасты."
                            }
                        },
                        {
                            "text": "Be careful because the stove <w>burner</w> is still very hot after cooking.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, потому что <w>конфорка</w> плиты всё ещё очень горячая после готовки."
                            }
                        }
                    ],
                    "synonyms": [
                        "ring"
                    ],
                    "common_phrases": [
                        "stove burner",
                        "gas burner",
                        "electric burner",
                        "back burner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Элемент кухонной плиты, который генерирует тепло для приготовления пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конфорка",
                                "target_lang_sense_clarification": "на кухонной плите"
                            },
                            {
                                "target_lang_word": "горелка",
                                "target_lang_sense_clarification": "газовая или спиртовая"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c113326-27cc-33a6-b046-64fa6f7a609e",
                    "sense_definition": "A cheap mobile phone used for a short time and then discarded to avoid being traced.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temporary_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective found a discarded <w>burner</w> in the trash can near the crime scene.",
                            "target_lang_translations": {
                                "ru": "Детектив нашел выброшенный <w>одноразовый телефон</w> в мусорном баке рядом с местом преступления."
                            }
                        },
                        {
                            "text": "He used a <w>burner</w> phone to make the secret call so no one could track him.",
                            "target_lang_translations": {
                                "ru": "Он использовал <w>временный телефон</w>, чтобы сделать секретный звонок, чтобы никто не мог его выследить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "burner phone",
                        "prepaid burner"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the context of crime or privacy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дешевый мобильный телефон, используемый в течение короткого времени и затем выбрасываемый, чтобы избежать слежки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одноразовый телефон",
                                "target_lang_sense_clarification": "для анонимности"
                            },
