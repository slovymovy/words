                    },
                    {
                        "translation_id": "70190d21-785c-4e65-bcdf-562d3cb4626c",
                        "source_entry_id": "e6da840e-2c7d-35ea-a6bf-f28caede6b26",
                        "target_lang_word": "Luzifer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luzifer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98d7c03b-2668-3b1c-bbc6-3c0ee7fd642c",
                                        "entry_id": "4c540ddf-b58d-36f3-bb00-317fa739e590",
                                        "glosses": [
                                            "der Teufel oder Satan in Anschluss an die lateinische Übersetzung von Jesaja 14,12, wo die gottfeindliche babylonische Weltmacht „Luzifer“ genannt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da954b7d-4817-4447-a958-2b762d3360ec",
                                                "sense_id": "98d7c03b-2668-3b1c-bbc6-3c0ee7fd642c",
                                                "text": "„Und wenn Luzifer mit der Schlange identisch sein soll, war er es, der Schritte einleitete, und den Menschen die Augen öffnete, so daß sie ihren Horizont erweitern konnten.“"
                                            },
                                            {
                                                "example_id": "d8bab519-3241-40f6-a95f-8c3d99b059ee",
                                                "sense_id": "98d7c03b-2668-3b1c-bbc6-3c0ee7fd642c",
                                                "text": "„Auch in Werken der Rockmusik tritt Luzifer auf, etwa als Ich-Erzähler in \"Sympathy for the Devil\" der Rolling Stones von 1968 […]“"
                                            },
                                            {
                                                "example_id": "749ca110-7eb4-48b1-b49e-3369d3968a16",
                                                "sense_id": "98d7c03b-2668-3b1c-bbc6-3c0ee7fd642c",
                                                "text": "„Wie Luzifer hinterläßt er Dunkelheit, als er geht.“"
                                            },
                                            {
                                                "example_id": "78ae81d8-34bd-4c03-924e-2810dc32c019",
                                                "sense_id": "98d7c03b-2668-3b1c-bbc6-3c0ee7fd642c",
                                                "text": "„Luzifer aber bestätigt immer seinen Gegenspieler Gott.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c5baf62d-c83a-3875-a049-09b75e4cea3d",
                                        "entry_id": "4c540ddf-b58d-36f3-bb00-317fa739e590",
                                        "glosses": [
                                            "der Morgenstern/ die Venus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b5cd7fd-e644-4817-b99b-c408d2e5bdeb",
                                                "sense_id": "c5baf62d-c83a-3875-a049-09b75e4cea3d",
                                                "text": "„Man fragt sich auch, warum der wunderbare Morgenstern, Luzifer genannt, der Lichtbringer, in der Vorstellung der Völker als eine Macht des Bösen, als ein gefallener Stern lebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
