                                        "entry_id": "360b550b-15d0-3c12-8e49-65c3b541e2d0",
                                        "glosses": [
                                            "Pièce de théâtre (tragique ou comique)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d1acb5a-631e-47dd-8bcc-a1b1d91c4765",
                                                "sense_id": "f13b9b44-c77b-3537-8115-487c9d160d68",
                                                "text": "Macbeth est un drame de William Shakespeare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d65666a-d284-36ab-b73d-abc2197a73d1",
                                        "entry_id": "360b550b-15d0-3c12-8e49-65c3b541e2d0",
                                        "glosses": [
                                            "Pièce de théâtre en vers ou en prose, entre la tragédie et la comédie (sens apparu dans la première moitié du XVIIIᵉ siècle)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a27805e-a880-490b-8f12-485cbb4e1bef",
                                                "sense_id": "7d65666a-d284-36ab-b73d-abc2197a73d1",
                                                "text": "Un drame populaire."
                                            },
                                            {
                                                "example_id": "35751485-0073-49b2-99a9-3c3bf7ac3960",
                                                "sense_id": "7d65666a-d284-36ab-b73d-abc2197a73d1",
                                                "text": "Les romantiques ont opposé le drame de Shakespeare à la tragédie de Racine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "757b5020-1d4a-3cd8-a9e9-0cf6e5f9df42",
                                        "entry_id": "360b550b-15d0-3c12-8e49-65c3b541e2d0",
                                        "glosses": [
                                            "Genre cinématographique qui traite de situations généralement non-épiques dans un contexte sérieux, sur un ton plus susceptible d’inspirer la tristesse que le rire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49244178-2e49-3dea-b636-b1a366b014a1",
                                        "entry_id": "360b550b-15d0-3c12-8e49-65c3b541e2d0",
                                        "glosses": [
                                            "Événement pénible ou suite d’événements qui émeuvent, qui touchent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd2bf385-18cb-4c0b-9931-fb6097d55306",
                                                "sense_id": "49244178-2e49-3dea-b636-b1a366b014a1",
                                                "text": "Son arrivée, son départ a été tout un drame."
                                            },
                                            {
                                                "example_id": "3f92ddad-ee44-4afb-9c89-e00280fb5db2",
                                                "sense_id": "49244178-2e49-3dea-b636-b1a366b014a1",
                                                "text": "N’en fais pas un drame !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
