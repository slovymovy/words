                    {
                        "form_id": "eacc7231-82c3-40b0-b1bf-879f67799d4f",
                        "entry_id": "2e04e179-3749-3598-bc9d-8080e59a84a7",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Flüchtlingskrise"
                    },
                    {
                        "form_id": "27b8ce43-2a6d-48a5-8822-320331f0251b",
                        "entry_id": "2e04e179-3749-3598-bc9d-8080e59a84a7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Flüchtlingskrisen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94b3cec4-0f12-3158-9baa-780f51660ed7",
                        "entry_id": "2e04e179-3749-3598-bc9d-8080e59a84a7",
                        "glosses": [
                            "eine Krise im Zusammenhang mit Flüchtlingen, besonders die Flüchtlingskrise in Europa 2015"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f86dfbf-b779-4477-95b1-d4519d61c7f2",
                                "sense_id": "94b3cec4-0f12-3158-9baa-780f51660ed7",
                                "text": "Die Europäische Union ist tief gespalten im Umgang mit der Flüchtlingskrise, aber immerhin gibt es Gipfeltreffen."
                            },
                            {
                                "example_id": "3a7ee935-d95b-4f41-8f1d-73d44a51274a",
                                "sense_id": "94b3cec4-0f12-3158-9baa-780f51660ed7",
                                "text": "„Union und SPD ringen seit Monaten um Antworten auf die Flüchtlingskrise - und die politische Vorherrschaft.“"
                            },
                            {
                                "example_id": "6814b559-bbfa-4908-9626-328f8531e00d",
                                "sense_id": "94b3cec4-0f12-3158-9baa-780f51660ed7",
                                "text": "„Die Griechenlandkrise, welche die erste Hälfte des Jahres bis etwa Mitte Juli und bis zu der Verabschiedung des Hilfspakets durch den Deutschen Bundestag die politische und mediale Agenda bestimmt hat, wurde ab Mitte August von der Flüchtlingskrise abgelöst.“"
                            },
                            {
                                "example_id": "59ea953e-6fb9-47db-831a-36a8bc9fafd3",
                                "sense_id": "94b3cec4-0f12-3158-9baa-780f51660ed7",
                                "text": "„Die Flüchtlingskrise haben die Eifeler im Fernsehen verfolgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6ff2c815-c245-3cd1-8e20-1ea84e14e8bb",
                        "entry_id": "2e04e179-3749-3598-bc9d-8080e59a84a7",
                        "glosses": [
                            "Der Begriff wird von einigen als ein verkürzender und negativ besetzter Pressejargon angesehen, da es sich eher um eine Krise der deutschen/europäischen politischen Institutionen und der deutschen kommunalen und Länder-Verwaltungen sowie der Bildungs- und Gesundheitsinstitutionen handelt wegen Schwierigkeiten bei Asylverfahren und der Integrierung von Flüchtlingen, aber nicht der Flüchtlinge auf ihrem Fußweg nach Europa"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b53cc0b-5f26-4e28-a1af-4ababa2f1c40",
                        "source_entry_id": "2e04e179-3749-3598-bc9d-8080e59a84a7",
                        "source_sense_id": "94b3cec4-0f12-3158-9baa-780f51660ed7",
                        "target_lang_word": "crisis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crisis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee0c93af-77dd-3faf-b806-2e1a3a0a3209",
                                        "entry_id": "269143b6-919e-34ea-a141-fb84a7eb6452",
                                        "glosses": [
                                            "A crucial or decisive point or situation; a turning point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "617afad8-9768-398f-9396-44dc47a20878",
                                        "entry_id": "269143b6-919e-34ea-a141-fb84a7eb6452",
                                        "glosses": [
                                            "An unstable situation, in political, social, economic or military affairs, especially one involving an impending abrupt change."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1075b64-7531-4281-8c92-5c2eb136bb3c",
                                                "sense_id": "617afad8-9768-398f-9396-44dc47a20878",
                                                "text": "The financial crisis could have been avoided and was the result of poor decision making both in Washington and at top financial firms that fostered a culture of excessive risk taking, according to a draft report written by Democrats on a panel that investigated the meltdown and obtained by Reuters."
                                            },
                                            {
                                                "example_id": "2e85dc6a-f516-424d-a293-3f2e6f421906",
                                                "sense_id": "617afad8-9768-398f-9396-44dc47a20878",
                                                "text": "The big question, I believe, is whether the Italian and maybe Spanish crises are the kind of thing that might be brought under control by ECB bond purchases. This is often phrased in terms of whether they are facing liquidity or solvency problems; but I think it’s better phrased in terms of the possibility of self-fulfilling crises, a la Obstfeld. […] So there is a reasonable case that what we’re seeing in Italy is a self-fulfilling crisis trying to happen, in which fear of default is precisely what leads to default."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8641f14-4421-3cc2-ba64-995f2ba45239",
                                        "entry_id": "269143b6-919e-34ea-a141-fb84a7eb6452",
                                        "glosses": [
                                            "A sudden change in the course of a disease, usually at which point the patient is expected to either recover or die."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60fc8a43-44f6-327c-8876-0ca4c7f3d374",
                                        "entry_id": "269143b6-919e-34ea-a141-fb84a7eb6452",
                                        "glosses": [
                                            "A traumatic or stressful change in a person's life."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7173e28-70ff-44e8-b9ae-bf4483c70830",
                                                "sense_id": "60fc8a43-44f6-327c-8876-0ca4c7f3d374",
                                                "text": "I'm having a major crisis trying to wallpaper the living room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e6c2e8a-e705-3f5f-9aab-5f19f3239364",
                                        "entry_id": "269143b6-919e-34ea-a141-fb84a7eb6452",
                                        "glosses": [
                                            "A point in a drama at which a conflict reaches a peak before being resolved."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
