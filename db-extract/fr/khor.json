                            {
                                "example_id": "ac790cfe-aea8-4e43-991e-6411f652ff5a",
                                "sense_id": "a220914f-f53f-30b0-b51f-ce2a1ecd6071",
                                "text": "Le carnage était si effroyable que Cheikh Ed Din lui-même montra l’exemple en allant s’abriter dans un khor (ravin) à l’ouest de la colline de Surgham."
                            },
                            {
                                "example_id": "f260a132-e2eb-4da6-a3d6-7cd87fc25ef5",
                                "sense_id": "a220914f-f53f-30b0-b51f-ce2a1ecd6071",
                                "text": "Ils ont essayé de nous emmener dans un khor [lit à sec d'une rivière] voisin."
                            }
                        ]
                    },
                    {
                        "sense_id": "c733e3fe-f6dd-3ef0-a184-2fce902057f2",
                        "entry_id": "6d4e7dd3-6b11-397d-8f94-1a72eb38f092",
                        "glosses": [
                            "Ruisseau, cours d’eau souvent temporaire, saisonnier..."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6987f4cf-f4c9-4835-867d-6ba91d491a3f",
                                "sense_id": "c733e3fe-f6dd-3ef0-a184-2fce902057f2",
                                "text": "Durant la saison des pluies, les habitants de Ruseris s’approvisionnent directement à un khor (un ruisseau saisonnier) (...) Sa famille continue à aller chaque jour chercher de l’eau au khor, mais elle la filtre désormais avant de la boire ou de la stocker."
                            },
                            {
                                "example_id": "5a7ab01e-73de-4455-a8f6-316ab07d0689",
                                "sense_id": "c733e3fe-f6dd-3ef0-a184-2fce902057f2",
                                "text": "Chameaux au hafir (trou d’eau) aménagé dans un khor (petit cours d’eau temporaire)."
                            }
                        ]
                    }
