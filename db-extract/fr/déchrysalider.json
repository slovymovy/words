                "senses": [
                    {
                        "sense_id": "495ba6dd-8671-3275-92fa-8c1d206464c0",
                        "entry_id": "1f2e96d6-5472-3280-8c8a-d425b3a932f2",
                        "glosses": [
                            "Faire sortir de sa chrysalide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84977aec-b3f5-47ca-a499-17cc571daa25",
                                "sense_id": "495ba6dd-8671-3275-92fa-8c1d206464c0",
                                "text": "Leur rustique n’est pas contradictoire avec le goût du mot précieux comme une truffe, du terme rare à déchrysalider, des masques à arracher — avec des lambeaux du réel — au sens obscur."
                            },
                            {
                                "example_id": "4dfdbd60-6647-44b6-9390-57e6978a73e6",
                                "sense_id": "495ba6dd-8671-3275-92fa-8c1d206464c0",
                                "text": "Titubant et bêlant le long des ritournelles des nocturnes loriots de vos cœurs, et vous flagellant d’étamines choisies, hypnotisez-vous devers la Lune, pour la saison des semailles, et caressez-vous ensuite bien singulièrement pour déchrysalider vos papillons de nuit !"
                            }
                        ]
                    }
                ],
