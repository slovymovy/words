                    {
                        "form_id": "580dbc15-e53b-42ed-aa4e-fcd3a27586d1",
                        "entry_id": "642f6a3a-0ab5-3b34-907f-19514933d50b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Quadratwurzeln"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33f16e92-d9bc-3dfd-8b37-03b3230ee7e0",
                        "entry_id": "642f6a3a-0ab5-3b34-907f-19514933d50b",
                        "glosses": [
                            "jene positive Zahl, die mit sich selbst multipliziert wieder die Ausgangszahl ergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a52d07ad-4ba1-4bb6-bbbb-a96cfb33872e",
                                "sense_id": "33f16e92-d9bc-3dfd-8b37-03b3230ee7e0",
                                "text": "Die Quadratwurzel von 16 ist 4."
                            },
                            {
                                "example_id": "a6cb1fff-1215-453c-8d0f-0f779b1e6530",
                                "sense_id": "33f16e92-d9bc-3dfd-8b37-03b3230ee7e0",
                                "text": "„In meinem Manuskript erörtert Eudemos neben vielen anderen Dingen die Liste von Quadratwurzeln, die Theodoros von Kyrene vorgelegt hat.“"
                            },
                            {
                                "example_id": "b7534844-c396-4d0c-8c13-37cf7a5ff78a",
                                "sense_id": "33f16e92-d9bc-3dfd-8b37-03b3230ee7e0",
                                "text": "„Denn jetzt gleich, auf der Stelle, erweitern wir die reellen Zahlen und die imaginären, um die Quadratwurzeln der negativen Zahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48f44a90-c730-4abe-9204-c59eff0dc5b5",
                        "source_entry_id": "642f6a3a-0ab5-3b34-907f-19514933d50b",
                        "source_sense_id": "33f16e92-d9bc-3dfd-8b37-03b3230ee7e0",
                        "source_sense_description": "Mathematik: jene positive Zahl, die mit sich selbst multipliziert wieder die Ausgangszahl ergibt",
                        "target_lang_word": "平方根",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d5359424-8716-41a4-a01a-d6b48393590e",
                        "source_entry_id": "642f6a3a-0ab5-3b34-907f-19514933d50b",
                        "source_sense_id": "33f16e92-d9bc-3dfd-8b37-03b3230ee7e0",
                        "source_sense_description": "Mathematik: jene positive Zahl, die mit sich selbst multipliziert wieder die Ausgangszahl ergibt",
                        "target_lang_word": "square root",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "square root",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4ca7254-80fe-354f-b87e-9102c167dba1",
                                        "entry_id": "637ca87a-f028-3dff-ba1e-843fd132d3cd",
                                        "glosses": [
                                            "The number which, when squared, yields another number."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea568984-74c2-44cc-ab9d-21b5479a33bc",
                                                "sense_id": "f4ca7254-80fe-354f-b87e-9102c167dba1",
                                                "text": "Near-synonym: √"
                                            },
                                            {
                                                "example_id": "bf4a788d-6a71-47d2-8f33-c85dd1182cbe",
                                                "sense_id": "f4ca7254-80fe-354f-b87e-9102c167dba1",
                                                "text": "The square roots of 4 are 2 and −2, the square root of 0 is 0, and the square roots of −4 are 2i and −2i."
                                            },
                                            {
                                                "example_id": "9637a452-6675-41cf-a89d-b93afb3f7f0f",
                                                "sense_id": "f4ca7254-80fe-354f-b87e-9102c167dba1",
                                                "text": "In √a̅+̅b̅, the horizontal bar or vinculum is actually a parenthesis that groups a+b. Without it, √a+b might mean b+√a̅ or it might mean √a̅+̅b̅. Nevertheless, the square-root sign without the vinculum is often used[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7915cf23-8fff-3800-8387-1e7e2b7d3ea1",
                                        "entry_id": "637ca87a-f028-3dff-ba1e-843fd132d3cd",
                                        "glosses": [
                                            "The positive number which, when squared, yields another number: the principal square root."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bda6115-1589-436c-9916-829617c3a2aa",
                                                "sense_id": "7915cf23-8fff-3800-8387-1e7e2b7d3ea1",
                                                "text": "The square root of 4 is 2. No negative real square roots exist. Negative numbers have no real square roots."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "480c823e-da4d-4a96-b084-fdaaa9ec979d",
                        "source_entry_id": "642f6a3a-0ab5-3b34-907f-19514933d50b",
                        "source_sense_id": "33f16e92-d9bc-3dfd-8b37-03b3230ee7e0",
                        "source_sense_description": "Mathematik: jene positive Zahl, die mit sich selbst multipliziert wieder die Ausgangszahl ergibt",
                        "target_lang_word": "racine carrée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "racine carrée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cd8e63d-d420-37da-99e3-0240dfd70c5f",
                                        "entry_id": "42c94df7-5807-3f30-9eaf-eae2a8643b39",
                                        "glosses": [
                                            "Nombre réel positif qui, une fois multiplié par lui-même, donne le nombre réel en question. La racine carrée de x est notée √, utilisant √."
                                        ],
                                        "tags": [],
                                        "examples": [
