                                        "sense_id": "3879eb47-445d-3a45-9d89-59cd558bdaf4",
                                        "entry_id": "de36b557-4c13-3372-916c-6d665755ef05",
                                        "glosses": [
                                            "zwaarder belasten dan het systeem verdragen kan"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a26f2d4-26d2-4f4c-94c6-a08d7e7290c8",
                                                "sense_id": "3879eb47-445d-3a45-9d89-59cd558bdaf4",
                                                "text": "Het netwerk werd overbelast en ging door zijn knieën."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52d1d4cf-927f-4f0d-9c14-39446722f2c1",
                        "source_entry_id": "9a143c28-a9d7-3e3e-bfd3-e552046ae2f9",
                        "source_sense_id": "70e9fb1b-5f1a-35ae-bfd5-1bb5b33f8470",
                        "source_sense_description": "subject to an excessive demand",
                        "target_lang_word": "überlasten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überlasten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7e72b34-618b-315f-92a5-d67cef6f70f4",
                                        "entry_id": "c6f361a0-08df-335f-b814-91b79f995ba9",
                                        "glosses": [
                                            "mit mehr Fracht/Last versehen/belasten, als vorgesehen oder tragbar/machbar ist"
                                        ],
                                        "tags": [
                                            "Schwerpunkt Gewicht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9338e9b8-b7a6-4bb2-9aea-077b26414ceb",
                                                "sense_id": "e7e72b34-618b-315f-92a5-d67cef6f70f4",
                                                "text": "Wenn Sie den Anhänger so überlasten, ist das Gespann nicht mehr verkehrssicher, weil es dann in der nächsten Kurve umkippen könnte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e058681f-de8d-3bcb-8ed0-8ef6180d22a7",
                                        "entry_id": "c6f361a0-08df-335f-b814-91b79f995ba9",
                                        "glosses": [
                                            "so sehr seiner Bestimmung entsprechend nutzen, dass etwas nicht mehr funktioniert"
                                        ],
                                        "tags": [
                                            "Verkehr"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f9af344-7e0e-40de-9c90-0201abd6afc4",
                                                "sense_id": "e058681f-de8d-3bcb-8ed0-8ef6180d22a7",
                                                "text": "„Innerstädtisch ist es die Herausforderung der Stadtplaner, die Straßen nicht zu überlasten.“"
                                            },
                                            {
                                                "example_id": "8bd09196-8671-48f8-a0e0-9b79b0bfb870",
                                                "sense_id": "e058681f-de8d-3bcb-8ed0-8ef6180d22a7",
                                                "text": "„Mit gesetztem ECE-Bit (ECN-Echo) teilt der Empfänger dem Sender mit, dass das Netzwerk überlastet ist und die Senderate reduziert werden muss.“"
                                            },
                                            {
                                                "example_id": "005d3c52-ba75-439f-b2a2-d8f96e6eb637",
                                                "sense_id": "e058681f-de8d-3bcb-8ed0-8ef6180d22a7",
                                                "text": "„Stromnetze sind häufig überlastet, Abschaltungen ganzer Stadtviertel sind an der Tagesordnung.“"
                                            },
                                            {
                                                "example_id": "5871df15-4b89-4160-bed1-654c8c79c126",
                                                "sense_id": "e058681f-de8d-3bcb-8ed0-8ef6180d22a7",
                                                "text": "„Beides kann zum Kentern des Schiffes führen und die Takelage überlasten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f9efd226-45c7-3ccf-9e7d-d53644e02e9a",
                                        "entry_id": "c6f361a0-08df-335f-b814-91b79f995ba9",
                                        "glosses": [
                                            "so sehr Leistung fordern, dass die Gesundheit gefährdet wird"
                                        ],
                                        "tags": [
                                            "oft über den Menschen, häufig im Partizip verwendet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d58e0809-088f-4c65-b887-94f681e44517",
                                                "sense_id": "f9efd226-45c7-3ccf-9e7d-d53644e02e9a",
                                                "text": "„Die A-Team-Manager mit zu vielen Mitarbeitern, sind überlastet und gestresst.“"
                                            },
                                            {
                                                "example_id": "9bb5b723-32b3-45ad-8b7f-42f604b384ef",
                                                "sense_id": "f9efd226-45c7-3ccf-9e7d-d53644e02e9a",
                                                "text": "„Häufig gibt es zu wenig Erzieher und Pfleger in den Heimen, sie sind überlastet und haben kaum Zeit für die Patienten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ab50706-3ca8-41ab-a312-b2718e84b7a1",
                        "source_entry_id": "9a143c28-a9d7-3e3e-bfd3-e552046ae2f9",
                        "source_sense_id": "70e9fb1b-5f1a-35ae-bfd5-1bb5b33f8470",
