                "senses": [
                    {
                        "sense_id": "e3c1f89d-6096-390b-ace2-16242257494a",
                        "entry_id": "ac8daa86-d7f9-349a-a48a-864b911542ae",
                        "glosses": [
                            "herenkostuum, pak"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "09cacb7a-1b91-399e-bab6-0935e8cd6bea",
                        "entry_id": "ac8daa86-d7f9-349a-a48a-864b911542ae",
                        "glosses": [
                            "jasje met rok gemaakt van dezelfde stof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00fd41d2-85fa-4258-ae9d-86226c223171",
                                "sense_id": "09cacb7a-1b91-399e-bab6-0935e8cd6bea",
                                "text": "Het groen van de bus paste wel weer mooi bij de outfit van Gimmy More, die gisteravond een complet had samengesteld rond die kleur."
                            },
                            {
                                "example_id": "af8bb06b-106a-4878-85f9-800ef1042815",
                                "sense_id": "09cacb7a-1b91-399e-bab6-0935e8cd6bea",
                                "text": "In het gevolg van de koningin waren behalve prins Willem–Alexander, prins Constantijn en mr. Pieter van Vollenhoven ook de prinsessen Máxima, Laurentien en Margriet aanwezig. Zij vormden qua kleding naast het groenblauw van Beatrix een kleurig geheel. Zo droeg Máxima oranje met brique, Margriet een goudkleurig complet van zijde en kant en Laurentien een pakje van tweed met turkooizen lurex."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7be0b3c8-96af-4f47-b9f0-e471e6ac496c",
                        "source_entry_id": "ac8daa86-d7f9-349a-a48a-864b911542ae",
                        "source_sense_id": "e3c1f89d-6096-390b-ace2-16242257494a",
                        "source_sense_description": "kostuum",
                        "target_lang_word": "suit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53fb9601-97f2-3f58-8f65-3615cbfb0f69",
                                        "entry_id": "819c4b0b-7bb3-3f92-82f5-b93b143324cd",
                                        "glosses": [
                                            "A set of clothes to be worn together, now especially a man's matching jacket and trousers (also business suit or lounge suit), or a similar outfit for a woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0017bf2-14ee-415f-889b-0165b3a2d16e",
                                                "sense_id": "53fb9601-97f2-3f58-8f65-3615cbfb0f69",
                                                "text": "A canister of flour from the kitchen had been thrown at the looking-glass and lay like trampled snow over the remains of a decent blue suit with the lining ripped out which lay on top of the ruin of a plastic wardrobe."
                                            },
                                            {
                                                "example_id": "07443d72-756c-491a-bba1-a1822e5f2815",
                                                "sense_id": "53fb9601-97f2-3f58-8f65-3615cbfb0f69",
                                                "text": "Think of banking today and the image is of grey-suited men in towering skyscrapers. Its future, however, is being shaped in converted warehouses and funky offices in San Francisco, New York and London, where bright young things in jeans and T-shirts huddle around laptops, sipping lattes or munching on free food."
                                            },
                                            {
                                                "example_id": "9c543928-774f-4639-b4d6-62278cbea50b",
                                                "sense_id": "53fb9601-97f2-3f58-8f65-3615cbfb0f69",
                                                "text": "Nick hired a navy-blue suit for the wedding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c90cbf8-7d7f-390a-8432-49ab8c5d6e97",
                                        "entry_id": "819c4b0b-7bb3-3f92-82f5-b93b143324cd",
                                        "glosses": [
                                            "A garment or set of garments suitable and/or required for a given task or activity: space suit, boiler suit, protective suit, swimsuit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32f3a00e-bc1b-3c30-aed9-040af30d153f",
                                        "entry_id": "819c4b0b-7bb3-3f92-82f5-b93b143324cd",
                                        "glosses": [
                                            "A dress."
                                        ],
                                        "tags": [
                                            "Pakistan"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22e73957-f814-32bb-a02c-d9308c55b78b",
                                        "entry_id": "819c4b0b-7bb3-3f92-82f5-b93b143324cd",
                                        "glosses": [
                                            "A person who wears matching jacket and trousers, especially a boss or a supervisor."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "metonymically",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb2d5e99-d85e-4e94-bccd-521e455ce68b",
                                                "sense_id": "22e73957-f814-32bb-a02c-d9308c55b78b",
                                                "text": "Be sure to keep your nose to the grindstone today; the suits are making a \"surprise\" visit to this department."
                                            },
                                            {
                                                "example_id": "a58b773c-8a66-446e-ac7e-20bd535ee070",
                                                "sense_id": "22e73957-f814-32bb-a02c-d9308c55b78b",
                                                "text": "You had an army / Of suits behind you"
                                            },
                                            {
                                                "example_id": "f99143cb-2d6d-4abf-8de5-090dcb0df5ba",
                                                "sense_id": "22e73957-f814-32bb-a02c-d9308c55b78b",
                                                "text": "Two smartly dressed suits walked up to the doctor. \"Are you alright Dr. La Perouse?\""
                                            },
                                            {
                                                "example_id": "97baa266-4a20-4aa2-a08c-3197e3ed01f5",
                                                "sense_id": "22e73957-f814-32bb-a02c-d9308c55b78b",
                                                "text": "Suits didn't wear suits any more—they wore Tibetan prayer beads coiled around their wrists. But they slithered in a suitlike way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af3cedd2-1ed8-3c97-8340-d927956bd205",
                                        "entry_id": "819c4b0b-7bb3-3f92-82f5-b93b143324cd",
                                        "glosses": [
                                            "A full set of armour."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32d543f1-9930-3279-bb0f-be6fbd53e995",
                                        "entry_id": "819c4b0b-7bb3-3f92-82f5-b93b143324cd",
                                        "glosses": [
                                            "The attempt to gain an end by legal process; a process instituted in a court of law for the recovery of a right or claim; a lawsuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51bbfe4b-be33-4d8a-bc54-a596343bd594",
                                                "sense_id": "32d543f1-9930-3279-bb0f-be6fbd53e995",
                                                "text": "If you take my advice, you'll file a suit against him immediately."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eddf3856-4040-301b-9d1e-76ab639cd48f",
                                        "entry_id": "819c4b0b-7bb3-3f92-82f5-b93b143324cd",
                                        "glosses": [
                                            "Petition, request, entreaty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd09e50d-56c5-4ab1-babb-2c272b9b44be",
                                                "sense_id": "eddf3856-4040-301b-9d1e-76ab639cd48f",
                                                "text": "Tam[burlaine]. Are you the wittie King of Perſea?\nMyc[etes]. I marrie am I: haue you any ſute to me?\nTam[burlaine]. I woulde intreate you to ſpeake but three wiſe wordes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "306c2507-84b4-386b-8278-9eb49935d7eb",
                                        "entry_id": "819c4b0b-7bb3-3f92-82f5-b93b143324cd",
                                        "glosses": [
                                            "The act of following or pursuing; pursuit, chase."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aba063ad-b249-3ac3-9b99-c4baf4af8a4a",
                                        "entry_id": "819c4b0b-7bb3-3f92-82f5-b93b143324cd",
                                        "glosses": [
                                            "Pursuit of a love-interest; wooing, courtship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c830dd66-2bc1-4215-afb5-9e85302673db",
                                                "sense_id": "aba063ad-b249-3ac3-9b99-c4baf4af8a4a",
                                                "text": "Rebate your loves, each rival suit suspend,\n Till this funereal web my labors end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "914a2ff0-7294-34c3-8f23-7c6c6b1a5169",
                                        "entry_id": "819c4b0b-7bb3-3f92-82f5-b93b143324cd",
                                        "glosses": [
                                            "The act of suing; the pursuit of a particular object or goal."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfd2e950-1b66-412b-aeea-73135b17e84e",
                                                "sense_id": "914a2ff0-7294-34c3-8f23-7c6c6b1a5169",
                                                "text": "Thenceforth the suitt of earthly conquest shonne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aa44353-e834-313b-b44b-e6c3d13f0e59",
                                        "entry_id": "819c4b0b-7bb3-3f92-82f5-b93b143324cd",
                                        "glosses": [
                                            "The full set of sails required for a ship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16085acb-0ac5-3c1e-acc3-6a40acbf7123",
                                        "entry_id": "819c4b0b-7bb3-3f92-82f5-b93b143324cd",
                                        "glosses": [
                                            "Each of the sets of a pack of cards distinguished by colour and/or specific emblems, such as the spades, hearts, diamonds, or clubs of traditional Anglo, Hispanic, and French playing cards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faba1b07-fafd-40b5-9cec-88c2fc35181b",
                                                "sense_id": "16085acb-0ac5-3c1e-acc3-6a40acbf7123",
                                                "text": "To deal and shuffle, to divide and sort\nHer mingled suits and sequences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2616e705-c24b-3536-9e43-6dd99b85ca1c",
                                        "entry_id": "819c4b0b-7bb3-3f92-82f5-b93b143324cd",
                                        "glosses": [
                                            "Regular order; succession."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dffbe12a-e35f-425a-90cc-25e55eaaf628",
                                                "sense_id": "2616e705-c24b-3536-9e43-6dd99b85ca1c",
                                                "text": "Every five and thirty years the same kind and suit of weather comes again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8b9adab-47cc-3eaf-ab88-078d28b2518e",
                                        "entry_id": "819c4b0b-7bb3-3f92-82f5-b93b143324cd",
                                        "glosses": [
                                            "A company of attendants or followers; a retinue."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf5885eb-1e7c-36c1-89bd-cd1a54ca949f",
                                        "entry_id": "819c4b0b-7bb3-3f92-82f5-b93b143324cd",
                                        "glosses": [
                                            "A group of similar or related objects or items considered as a whole; a suite (of rooms etc.)"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ad7596e-745a-4822-a50b-0c53aa9e032c",
                                                "sense_id": "cf5885eb-1e7c-36c1-89bd-cd1a54ca949f",
                                                "text": "\"You must wear these to-day, my dear child,\" said Lord Norbourne, as, entering the dressing-room of his daughter, he laid a suit of pearls on her table"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "suit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96d39b93-2931-3dc6-84ab-6ae708f432b2",
                                        "entry_id": "08fe1532-6749-3010-bbb8-32f75affe213",
                                        "glosses": [
                                            "To make proper or suitable; to adapt or fit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b405ab79-32ee-4ce5-8df0-497be6b49d0e",
                                                "sense_id": "96d39b93-2931-3dc6-84ab-6ae708f432b2",
                                                "text": "but let your owne Diſcretion be your Tutor: Sute the Action to the Word, the Word to the Action,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff83c152-ef99-3a59-adfc-82ac461ab91f",
                                        "entry_id": "08fe1532-6749-3010-bbb8-32f75affe213",
                                        "glosses": [
                                            "To be suitable or apt for one's image."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0764b046-7fc3-4143-8ebb-bad435788075",
                                                "sense_id": "ff83c152-ef99-3a59-adfc-82ac461ab91f",
                                                "text": "The ripped jeans didn't suit her elegant image."
                                            },
                                            {
                                                "example_id": "47f26a3b-de81-4fa5-88f4-e98dfa2193f2",
                                                "sense_id": "ff83c152-ef99-3a59-adfc-82ac461ab91f",
                                                "text": "That new top suits you. Where did you buy it?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "857c0367-bf62-322c-9c06-a93a6aa16247",
                                        "entry_id": "08fe1532-6749-3010-bbb8-32f75affe213",
                                        "glosses": [
                                            "To be appropriate or apt for."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4d71078-a66e-453b-bdb8-951ede54fadc",
                                                "sense_id": "857c0367-bf62-322c-9c06-a93a6aa16247",
                                                "text": "Ill suits his cloth the praise of railing well."
                                            },
                                            {
                                                "example_id": "4617d7aa-d5ad-4e81-a532-b600631c6006",
                                                "sense_id": "857c0367-bf62-322c-9c06-a93a6aa16247",
                                                "text": "c. 1700, Matthew Prior, epistle to Dr. Sherlock\nRaise her notes to that sublime degree / Which suits song of piety and thee."
                                            },
                                            {
                                                "example_id": "e9ec7a49-0d39-4dae-bbc3-5b16581cbb4c",
                                                "sense_id": "857c0367-bf62-322c-9c06-a93a6aa16247",
                                                "text": "The nickname \"Bullet\" suits her, since she is a fast runner."
                                            },
                                            {
                                                "example_id": "9cebee08-c94e-45d0-9c02-9d4b5afb2a01",
                                                "sense_id": "857c0367-bf62-322c-9c06-a93a6aa16247",
                                                "text": "“[…] it is not fair of you to bring against mankind double weapons ! Dangerous enough you are as woman alone, without bringing to your aid those gifts of mind suited to problems which men have been accustomed to arrogate to themselves.”"
                                            },
                                            {
                                                "example_id": "35004b08-7b3b-4ab7-8136-1d0b0b1e8e03",
                                                "sense_id": "857c0367-bf62-322c-9c06-a93a6aa16247",
                                                "text": "I'm going where the sun keeps shinin' […] / Going where the weather suits my clothes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4c93220-584c-3fb9-ae43-71e3872a817a",
                                        "entry_id": "08fe1532-6749-3010-bbb8-32f75affe213",
                                        "glosses": [
                                            "To dress; to clothe."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb3e57e0-e729-49a6-a689-de03187f9e8f",
                                                "sense_id": "b4c93220-584c-3fb9-ae43-71e3872a817a",
                                                "text": "So went he suited to his watery tomb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d870257a-1731-32c7-8f52-e8e8d6777b39",
                                        "entry_id": "08fe1532-6749-3010-bbb8-32f75affe213",
                                        "glosses": [
                                            "To please; to make content; to fit someone's (or one's own) taste."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d56f6cf1-35c8-4e21-b751-9309f1c858c2",
                                                "sense_id": "d870257a-1731-32c7-8f52-e8e8d6777b39",
                                                "text": "will build to suit   [on for-sale signs marking vacant lots]"
                                            },
                                            {
                                                "example_id": "f457c512-d14c-43e5-afb6-a6f0c0dc28b9",
                                                "sense_id": "d870257a-1731-32c7-8f52-e8e8d6777b39",
                                                "text": "He is well suited with his place."
                                            },
                                            {
                                                "example_id": "73871846-7adf-4772-9b77-da323437ce80",
                                                "sense_id": "d870257a-1731-32c7-8f52-e8e8d6777b39",
                                                "text": "My new job suits me, as I work fewer hours and don't have to commute so much."
                                            },
                                            {
                                                "example_id": "a3c39bd7-56c3-40f1-934f-158e0bdb6190",
                                                "sense_id": "d870257a-1731-32c7-8f52-e8e8d6777b39",
                                                "text": "When's it suit you for me to call?"
                                            },
                                            {
                                                "example_id": "5d83cb73-c4d5-4cbc-b91a-2ee623e006fa",
                                                "sense_id": "d870257a-1731-32c7-8f52-e8e8d6777b39",
                                                "text": "This arrangement suited everybody - right up until the moment that it suddenly didn't, when unions were able to point a loaded gun at management's head in any disputes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2053698a-2372-371e-9b8f-f4a124b09524",
                                        "entry_id": "08fe1532-6749-3010-bbb8-32f75affe213",
                                        "glosses": [
                                            "To agree; to be fitted; to correspond (usually followed by to, archaically also followed by with)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "752c02ce-e54d-4b56-bdb8-849c73b3f9dd",
                                                "sense_id": "2053698a-2372-371e-9b8f-f4a124b09524",
                                                "text": "The place itself was suiting to his care."
                                            },
                                            {
                                                "example_id": "fb544821-af6f-499f-92ca-4eb75d1380e5",
                                                "sense_id": "2053698a-2372-371e-9b8f-f4a124b09524",
                                                "text": "Give me not an office / That suits with me so ill."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00893396-5fea-4ef2-8d99-24920774df42",
                        "source_entry_id": "ac8daa86-d7f9-349a-a48a-864b911542ae",
