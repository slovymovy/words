                    {
                        "sense_id": "12c45c95-30a6-3ef1-8e7e-9b8b09abb816",
                        "entry_id": "95b15653-5462-337b-ada7-6f4d66405670",
                        "glosses": [
                            "Material, das zum bewaffneten Kampf benötigt wird, insbesondere Munition"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97389bd4-726b-4b9a-b81a-6fb614adee0f",
                                "sense_id": "12c45c95-30a6-3ef1-8e7e-9b8b09abb816",
                                "text": "Der Boden des ehemaligen Truppenübungsplatzes ist mit Kampfmitteln verseucht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bcfa8cfb-9e39-33a9-86bf-8776dc834e22",
                        "entry_id": "95b15653-5462-337b-ada7-6f4d66405670",
                        "glosses": [
                            "taktisches Mittel in einer (politischen) Auseinandersetzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f372f2d8-020c-4943-8ae1-75a9cdbb92c7",
                                "sense_id": "bcfa8cfb-9e39-33a9-86bf-8776dc834e22",
                                "text": "Der Streik ist ein politisches Kampfmittel der Gewerkschaften."
                            },
                            {
                                "example_id": "697a455d-2476-4528-8a9e-563ff6fc5bd7",
                                "sense_id": "bcfa8cfb-9e39-33a9-86bf-8776dc834e22",
                                "text": "„Deshalb muss unser vorderstes Kampfmittel der Generalstreik sein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
