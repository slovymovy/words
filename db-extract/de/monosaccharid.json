                    },
                    {
                        "translation_id": "60362246-6dbc-4587-8189-458257786158",
                        "source_entry_id": "8fd0e6cd-aba9-3df9-a0c6-da4a4d12cdfd",
                        "source_sense_id": "ecaac5a2-9f21-398f-9314-7a6d4feceb90",
