                    },
                    {
                        "translation_id": "1d5efb00-c61d-4175-9ac8-516f1b28951c",
                        "source_entry_id": "8f7108d3-b5d9-3eb2-8e9d-ed5d50733f44",
                        "source_sense_description": "military march up-country",
                        "target_lang_word": "ана́басис",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d0a8434f-e605-4d88-94f5-41713f434c55",
                        "source_entry_id": "8f7108d3-b5d9-3eb2-8e9d-ed5d50733f44",
                        "source_sense_description": "military march up-country",
                        "target_lang_word": "марш",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "марш",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0081c1a9-297a-3cd4-83d8-3a8bd1badf40",
                                        "entry_id": "4439738f-5dc8-3b8d-b419-96e5e9ca3886",
                                        "glosses": [
                                            "воен. способ строго размеренного прохождения в строю"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f7173d7-526b-4294-bda1-b74be4ca9974",
                                                "sense_id": "0081c1a9-297a-3cd4-83d8-3a8bd1badf40",
                                                "text": "Алеша увидел двадцать маленьких рыцарей в золотых латах, с пунцовыми на шлемах перьями, которые попарно входили тихим маршем"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27b3b55e-6d7d-3ff6-b92b-c8261aa0d871",
                                        "entry_id": "4439738f-5dc8-3b8d-b419-96e5e9ca3886",
                                        "glosses": [
                                            "перемещение войск в походном состоянии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2156518a-ae39-4b76-bf34-32d0aef41d2e",
                                                "sense_id": "27b3b55e-6d7d-3ff6-b92b-c8261aa0d871",
                                                "text": "Использование радиосвязи на марше, в районах сосредоточении и в исходном положении категорически запрещается."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50587557-f799-325d-9f69-6f0300afe59d",
                                        "entry_id": "4439738f-5dc8-3b8d-b419-96e5e9ca3886",
                                        "glosses": [
                                            "полит. согласованное передвижение большой массы людей, как правило, с целью привлечения внимания к чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "308ec21e-3394-4655-a702-aa282af82272",
                                                "sense_id": "50587557-f799-325d-9f69-6f0300afe59d",
                                                "text": "В Москве прошел молодежный марш протеста против детского голода."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d4f7f30-242b-3e5e-80b1-af239a2f6a6a",
                                        "entry_id": "4439738f-5dc8-3b8d-b419-96e5e9ca3886",
                                        "glosses": [
                                            "музыкальный жанр, характеризуемый чётким ритмом и энергичным звучанием; также произведение в этом жанре, обычно сопровождающее или представляющее марш [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afe2e5e1-14c9-4174-be24-c654ea21a013",
                                                "sense_id": "2d4f7f30-242b-3e5e-80b1-af239a2f6a6a",
                                                "text": "При входе новобрачных в зал музыканты исполняют марш Мендельсона, после тостов — туш."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b554bd7a-28bb-3041-b362-629200b8f556",
                                        "entry_id": "4439738f-5dc8-3b8d-b419-96e5e9ca3886",
                                        "glosses": [
                                            "часть лестницы между двумя площадками"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47f45f15-bd32-4da2-8044-a26b0181e37d",
                                                "sense_id": "b554bd7a-28bb-3041-b362-629200b8f556",
                                                "text": "Марш должен иметь не менее 3 и не более 15 ступеней; при большей длине между маршами делают горизонтальную площадку для отдыха."
                                            },
                                            {
                                                "example_id": "38c232e7-5c87-4af7-95aa-d54ddb81eaed",
                                                "sense_id": "b554bd7a-28bb-3041-b362-629200b8f556",
                                                "text": "Спустившись на один марш, он повернулся, увидел Гришкино освещенное огоньком зажигалки курносое, совсем еще детское лицо…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "марш",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "21ebfd7e-5ba7-3899-9939-f5837da2c398",
                                        "entry_id": "2e88df4c-266e-3768-86e6-f792cd794e0f",
                                        "glosses": [
                                            "команда, приказ идти, двигаться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1ec611a-8fa1-43d0-a712-eea55ffb76bb",
                                                "sense_id": "21ebfd7e-5ba7-3899-9939-f5837da2c398",
                                                "text": "А ну марш отсюда, быстро, пока уши не оборвал!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9659794a-1567-4507-96d4-00168607efa4",
                        "source_entry_id": "8f7108d3-b5d9-3eb2-8e9d-ed5d50733f44",
                        "source_sense_description": "military march up-country",
                        "target_lang_word": "похо́д",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "похо́д",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f9ccdda2-0f1c-3b10-9c5e-39b151384800",
                                        "entry_id": "04bd8c0e-f2c7-3316-87de-f717f6dd1bf9",
                                        "glosses": [
                                            "воен. целенаправленное передвижение войск или флота"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "836db2ee-5bfe-3e73-a915-200812d90c43",
                                        "entry_id": "04bd8c0e-f2c7-3316-87de-f717f6dd1bf9",
                                        "glosses": [
                                            "воен., также перен. наступательная операция, дальнее передвижение войск в ходе войны, а также боевые действия в период такого передвижения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdf6c4ce-3ea3-499b-b9ed-df897d7e8c60",
                                                "sense_id": "836db2ee-5bfe-3e73-a915-200812d90c43",
                                                "text": "Гром побед Наполеона звучал уже 9 лет — начиная с Итальянского похода 1796 года."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "426190fe-5f3e-3ab1-b031-ecf55baaa236",
                                        "entry_id": "04bd8c0e-f2c7-3316-87de-f717f6dd1bf9",
                                        "glosses": [
                                            "организованное путешествие или дальняя прогулка с тренировочными, развлекательными или познавательными целями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50d3d765-3f77-428f-b3ce-c290b4941ea6",
                                                "sense_id": "426190fe-5f3e-3ab1-b031-ecf55baaa236",
                                                "text": "Для походов и прогулок рекомендуется брать рюкзак, сменную обувь, одежду, питьё и еду, полиэтиленовую плёнку на случай дождя."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "055bc860-9a7e-36bc-9233-b7718a06494c",
                                        "entry_id": "04bd8c0e-f2c7-3316-87de-f717f6dd1bf9",
                                        "glosses": [
                                            "организованное или запланированное посещение чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d94da3-080a-4fab-b505-8a2cef65101b",
                                                "sense_id": "055bc860-9a7e-36bc-9233-b7718a06494c",
                                                "text": "Поход по магазинам для большинства женщин — это то же самое, что и просмотр футбольного матча для мужчин."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
