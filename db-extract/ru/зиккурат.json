                    {
                        "translation_id": "579a90c6-a0d8-48c2-a967-da245be7b613",
                        "source_entry_id": "ad57828d-1c87-31a8-b686-c741c98c8dc2",
                        "source_sense_description": "многоступенчатое культовое сооружение в древнем Междуречье",
                        "target_lang_word": "Zikkurat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zikkurat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc88986b-3342-323d-b6f8-209e5048039d",
                                        "entry_id": "1aca0850-38a6-33a5-93a3-2cd7b183c605",
                                        "glosses": [
                                            "ein mehrstufiger Tempelbau der Hochkulturen Mesopotamiens, z. B. der Turm zu Babel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f563cf0f-01fb-4045-a4ee-8514c2852913",
                                                "sense_id": "dc88986b-3342-323d-b6f8-209e5048039d",
                                                "text": "„Die besterhaltene Zikkurat, von den Sumerern dem Mondgott Nanna geweiht, steht in Ur, einer der ältesten Städte der Welt.“"
                                            },
                                            {
                                                "example_id": "8ee8deea-94d2-46e2-80b1-84191cbb4ffb",
                                                "sense_id": "dc88986b-3342-323d-b6f8-209e5048039d",
                                                "text": "„Doch eines Tages bin ich in Kiel, nachdem ich zum Studium dorthin zurückgekehrt war, zufällig auf diese Zikkurat gestoßen, ein kleines Totenmal aus Granit,…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be486d27-a58c-48c8-befc-8565e9f7236f",
