                                "target_lang_sense_clarification": "игра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "国际象棋",
                                "target_lang_sense_clarification": "棋类游戏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4385211f-ca70-356d-877f-3425923b981c",
                    "sense_definition": "Any of several species of grass in the genus Bromus, generally considered weeds.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer identified the weed in the field as <w>chess</w>.",
