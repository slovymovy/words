                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "réalisateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd6760d-6f6e-37f2-a06a-d9445904bc18",
                                        "entry_id": "a99e7c1f-4b57-3774-bfc9-6538685e9532",
                                        "glosses": [
                                            "Celui qui réalise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2bf529f-386a-465b-b1cd-acb7afe8803a",
                                                "sense_id": "0cd6760d-6f6e-37f2-a06a-d9445904bc18",
                                                "text": "Ce n’est pas seulement un imaginatif, c’est un réalisateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "759747e3-f541-3d14-a068-147ed0ca5467",
                                        "entry_id": "a99e7c1f-4b57-3774-bfc9-6538685e9532",
                                        "glosses": [
                                            "Personne responsable de la réalisation d’un film."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80c6a288-492c-4333-acbf-60510fa3aab7",
                                                "sense_id": "759747e3-f541-3d14-a068-147ed0ca5467",
                                                "text": "A Marchand, le réalisateur reprochera de « ribouler » quand il joue la colère. En pleine projection de rushes, sa voix s'élève, pour lancer à l'acteur sur l'écran : « Arrête de ribouler des yeux! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2019b879-9d50-419c-9062-cc560ac6c7db",
                        "source_entry_id": "b15c17aa-6d6e-3934-b17d-f6ba7bafafda",
                        "source_sense_id": "800500bd-58f4-3b6a-8c05-08b7248a2cb6",
                        "target_lang_word": "réalisatrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réalisatrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75d8f283-157e-3e7a-8f2c-a8324431df9d",
                                        "entry_id": "8f31163d-405b-30fc-8550-873c69255e07",
                                        "glosses": [
                                            "Celle qui est chargée de la réalisation d’un film."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17b47c99-07c4-4e27-97dd-a3153626449f",
                                                "sense_id": "75d8f283-157e-3e7a-8f2c-a8324431df9d",
                                                "text": "Aujourd'hui, le flambeau est fièrement repris par de talentueuses réalisatrices d’un porno joyeux et féministe : Madison Young, Erika Lust, Lucie Blush… Mais au fond, un porno féministe, c’est quoi ?"
                                            },
                                            {
                                                "example_id": "c7832880-52a1-4bc2-bbfd-ec6c7e50af1c",
                                                "sense_id": "75d8f283-157e-3e7a-8f2c-a8324431df9d",
                                                "text": "Lorsque la réalisatrice me demande où nous pouvons tourner, je réponds : « Partout, sauf en hauteur. »"
                                            },
                                            {
                                                "example_id": "c0791a6b-256d-4f08-8d2a-08b03b61d4cf",
                                                "sense_id": "75d8f283-157e-3e7a-8f2c-a8324431df9d",
                                                "text": "Julia revient à ce qui l’a fait connaître, confie Noémie Lefort, réalisatrice et fan de l’actrice américaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
