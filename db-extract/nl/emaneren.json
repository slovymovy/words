                        "cross_references": [
                            {
                                "target_word": "émaner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c424a52a-85cb-3147-9904-ad949dfd7a1c",
                                        "entry_id": "6112606b-6918-3d82-a617-10cb7f89513f",
                                        "glosses": [
                                            "Se dégager par particules impondérables d’un corps dont la substance n’en est ni diminuée, ni altérée sensiblement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99762603-e70c-455f-898f-1ab1ddf4ea12",
                                                "sense_id": "c424a52a-85cb-3147-9904-ad949dfd7a1c",
                                                "text": "Les phéromones émanent de glandes exocrines."
                                            },
                                            {
                                                "example_id": "87af01d1-bbe8-4b4b-b469-38f1d7d571e4",
                                                "sense_id": "c424a52a-85cb-3147-9904-ad949dfd7a1c",
                                                "text": "Certains corpuscules qui émanent des corps odorants provoquent les odeurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53c49cde-384a-3c5a-b7f4-2c162fbb18b2",
                                        "entry_id": "6112606b-6918-3d82-a617-10cb7f89513f",
                                        "glosses": [
                                            "Provenir de quelqu’un ou de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ebb6c6-63a3-4295-ba8d-5f706a338663",
                                                "sense_id": "53c49cde-384a-3c5a-b7f4-2c162fbb18b2",
                                                "text": "Telle assertion, émanant de certains spécialistes, paraîtra inacceptable à d'autres."
                                            },
                                            {
                                                "example_id": "bd159689-d8b2-4bf4-8855-3cb22597c82b",
                                                "sense_id": "53c49cde-384a-3c5a-b7f4-2c162fbb18b2",
                                                "text": "Les rayons de jouets sont moins encombrés que prévu. Un couple de grands-parents contemple anxieusement une grande poupée comme si allait émaner de se ses lèvres rouges et de ses yeux fixes le signe que c’est elle, pas une autre, qu’il leur faut élire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4f39bbb-3df2-3756-9fdb-4b220a5c4ffb",
                                        "entry_id": "6112606b-6918-3d82-a617-10cb7f89513f",
                                        "glosses": [
                                            "Engendrer, produire."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c5ceb0c-5f1c-443c-93ca-149ea914b71a",
                                                "sense_id": "a4f39bbb-3df2-3756-9fdb-4b220a5c4ffb",
                                                "text": "Le corps du monstre émanait des odeurs toxiques."
                                            }
                                        ]
                                    }
                                ]
                            }
