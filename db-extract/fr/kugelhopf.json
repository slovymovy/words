                "senses": [
                    {
                        "sense_id": "70c8f98b-f0f6-3bc0-9c87-eacdb42a0180",
                        "entry_id": "33e13b2a-446b-3506-ae80-977d729d4b8c",
                        "glosses": [
                            "Brioche de forme caractéristique, spécialité alsacienne et du sud de l’Allemagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cae6b8c-4438-41ba-b9d2-ff6e7b4c217c",
                                "sense_id": "70c8f98b-f0f6-3bc0-9c87-eacdb42a0180",
                                "text": "Par éviscération abdominale, le légiste (aidé d’une brigade de mitrons) dénombra par ordre d’entrée en scène : 18 tartelettes amandines, 26 pets-de-nonne, 13 paris-brest, 8 polonaises, 3 apfelstrudels, 1 demi saint-honoré, 5 poires Bourdaloue, 6 religieuses, 34 profiteroles, 3 quarts de kugelhopf, 1 brioche à la parisienne, 1 cake à l’ancienne, 3 babas au rhum et 137 éclairs au chocolat et 2 au café."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08bacf02-e428-4b8c-868d-b8bd308773af",
                        "source_entry_id": "33e13b2a-446b-3506-ae80-977d729d4b8c",
                        "source_sense_id": "70c8f98b-f0f6-3bc0-9c87-eacdb42a0180",
                        "target_lang_word": "Gugelhupf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gugelhupf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d93602d-35ba-3587-b1f1-d0105d55d2a8",
                                        "entry_id": "1ed1623b-efef-3f42-a863-4ec7087392cb",
                                        "glosses": [
                                            "Napfkuchen aus Hefeteig"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6714ce8-fe70-4943-993d-9210e2f561f7",
                                                "sense_id": "0d93602d-35ba-3587-b1f1-d0105d55d2a8",
                                                "text": "Als Zutaten für Gugelhupf werden Mehl, Eier, Milch, Butter, Mandeln, Rosinen und Hefe verwendet."
                                            },
                                            {
                                                "example_id": "3015d568-c157-43b1-b0c6-7798f798b148",
                                                "sense_id": "0d93602d-35ba-3587-b1f1-d0105d55d2a8",
                                                "text": "An einer langen Tafel sitzen die Schüler im Inneren der Hütte und haben auf dem Holztisch ihren Proviant ausgebreitet. Wir dürfen vom selbst gemachten Gugelhupf kosten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11e20f08-d413-3fd4-8c1a-a8327cdee2ee",
                                        "entry_id": "1ed1623b-efef-3f42-a863-4ec7087392cb",
                                        "glosses": [
                                            "psychiatrische Klinik"
                                        ],
                                        "tags": [
                                            "Wien",
                                            "Graz",
                                            "verhüllend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5b8ebe4-f908-4643-b851-a8db1700f6c6",
                                                "sense_id": "11e20f08-d413-3fd4-8c1a-a8327cdee2ee",
                                                "text": "„Du bringst mich noch in den Gugelhupf.“"
                                            },
                                            {
                                                "example_id": "00b3f974-74ff-445b-84a0-2d93ba58099b",
                                                "sense_id": "11e20f08-d413-3fd4-8c1a-a8327cdee2ee",
                                                "text": "Pass auf, dass sie dich nicht in' Gugelhupf bringen."
                                            },
                                            {
                                                "example_id": "bf3cb850-7006-4fb6-889f-7105dea1f0f1",
                                                "sense_id": "11e20f08-d413-3fd4-8c1a-a8327cdee2ee",
                                                "text": "„Nicht bestimmt wüßte sie, die Wirtin, ob der Rudi aufgrund seiner Vorliebe für diese seltsame Messerschnitzerei eingeliefert worden war oder ob er seine Freizeitbeschäftigung nachher entwickelt, erst im Gugelhupf diese Symbole zu drechseln begonnen habe.“"
                                            },
                                            {
                                                "example_id": "4f04ac91-2f96-4bc4-959a-827d0ea56a44",
                                                "sense_id": "11e20f08-d413-3fd4-8c1a-a8327cdee2ee",
                                                "text": "„Um meinem gespielten Irrsinn etwas Nachdruck zu verleihen, hab ich mich ja im Gugelhupf proforma aufhängen wollen.“"
                                            },
                                            {
                                                "example_id": "6a511b2d-259e-4bab-97f0-d42343b94e0c",
                                                "sense_id": "11e20f08-d413-3fd4-8c1a-a8327cdee2ee",
                                                "text": "„So, jetzt siehst Du würdig aus, mein König Lear. […] Beeindruckender als viele Staatsmänner und Politiker! Und die sind nicht in einem Nervensanatorium, im Narrenhaus, im Gugelhupf eingesperrt, nein, die sind noch immer frei, tanzen auf der Bühne der Weltpolitik.“"
                                            },
                                            {
                                                "example_id": "7637ec73-94e4-4cc2-ad61-9ba97249801f",
                                                "sense_id": "11e20f08-d413-3fd4-8c1a-a8327cdee2ee",
                                                "text": "„Die g'hört in Gugelhupf, die is verruckt!“"
                                            },
                                            {
                                                "example_id": "153a51b2-dcf3-413b-b12f-6ef0e36db72d",
                                                "sense_id": "11e20f08-d413-3fd4-8c1a-a8327cdee2ee",
                                                "text": "„Stani, wenn du so weitermachst, wirst noch im Gugelhupf landen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
