                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nagelbijten en voortdurend knipperen met de ogen zijn bekende voorbeelden van een <w>zenuwtrek</w>.",
                            "target_lang_translations": {
                                "en": "Nail-biting and constant blinking are well-known examples of a <w>nervous tic</w>."
                            }
                        },
                        {
                            "text": "Toen hij de stressvolle vraag moest beantwoorden, kreeg hij een kleine <w>zenuwtrek</w> rond zijn linkeroog.",
                            "target_lang_translations": {
                                "en": "When he had to answer the stressful question, he got a small <w>twitch</w> around his left eye."
                            }
                        }
                    ],
                    "synonyms": [
                        "zenuwtrekking"
                    ],
                    "common_phrases": [
                        "een vervelende zenuwtrek",
                        "een zenuwtrek onderdrukken"
                    ],
                    "target_lang_definitions": {
                        "en": "An involuntary, repetitive movement of a muscle, often caused by tension or nervousness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nervous tic",
                                "target_lang_sense_clarification": "involuntary muscle spasm due to tension"
                            },
