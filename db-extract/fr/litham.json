                "senses": [
                    {
                        "sense_id": "acd3eaf5-ec1c-37db-a99e-a51d8b55b732",
                        "entry_id": "7b6422c0-2d8b-34d8-ab90-575d820d19b8",
                        "glosses": [
                            "Genre de foulard porté au Sahara et couvrant le bas du visage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a267b71-4bba-44b6-9260-dd3b0788993e",
                                "sense_id": "acd3eaf5-ec1c-37db-a99e-a51d8b55b732",
                                "text": "Il semble qu’une autre vie commence et qu’elle se cantonne, là, dans notre tache d’ombre, avec un petit coq arrogant au milieu de ses poules, deux pigeons sur une selle d’Agadès aux appliques de cuir vert et rouge, avec le Corse Scarbonchi — déjà très targuisé, et nous l’aimons comme ça! — El-Ranaffi, astucieux goumier et notre hôte Kinan qui nous observe avec discrétion par-dessus son litham."
                            },
                            {
                                "example_id": "04026130-52d4-48f7-9eba-4cb1dc7f50d2",
                                "sense_id": "acd3eaf5-ec1c-37db-a99e-a51d8b55b732",
                                "text": "Précédant quelque peu ses 70 guerriers au litham bleu, avance, du pas tranquille de son plus beau chameau blanc, l’aménokal des Hoggar, Moussa ag Amastane."
                            }
                        ]
                    }
