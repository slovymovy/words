                "senses": [
                    {
                        "sense_id": "a9aa0aff-fcb6-37bf-a9e6-6f65025e6d62",
                        "entry_id": "94938399-db31-3335-9d3c-4e80fcf5c835",
                        "glosses": [
                            "Donner un caractère infusible à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d33bdc8-9d64-4311-a5f2-37cc955f60dc",
                                "sense_id": "a9aa0aff-fcb6-37bf-a9e6-6f65025e6d62",
                                "text": "Cette source de radiations ultra-violettes polymérise et infusibilise la pellicule en relief."
                            },
                            {
                                "example_id": "0b5bf0e4-37c7-4299-a257-645774b02548",
                                "sense_id": "a9aa0aff-fcb6-37bf-a9e6-6f65025e6d62",
                                "text": "b) infusibiliser cette fibre de filage, en atmosphère oxydante"
                            },
                            {
                                "example_id": "a5e637b3-2b42-4af4-ae3c-9dbc229cadc3",
                                "sense_id": "a9aa0aff-fcb6-37bf-a9e6-6f65025e6d62",
                                "text": "Procédé de production de fibres de carbone selon la revendication 4, dans lequel les fibres de brai sont infusibilisées, puis carbonisées ou graphitisées à une température de 800 à 3000°C de manière à obtenir des fibres de carbone, et en outre, les fibres de carbone sont enroulées sur une bobine en graphique ou autour d'un matériau formant coeur, puis placées dans un creuset en graphite et soumises à un traitement de graphitisation intensif à une température de 1400 à 3500°C pendant une durée de 30 minutes à 300 jours."
                            }
                        ]
                    }
