                                                "sense_id": "ef71a6c2-0288-3cdb-b9c6-a422b29e50dc",
                                                "text": "Er is een gebrek aan voedsel."
                                            },
                                            {
                                                "example_id": "10f2136e-dff2-410e-b3d6-274e4f2a11ec",
                                                "sense_id": "ef71a6c2-0288-3cdb-b9c6-a422b29e50dc",
                                                "text": "Vanwege het gebrek aan steun echter moesten mijn enkels erg wennen aan het oneffen terrein."
                                            },
                                            {
                                                "example_id": "302ee305-3c97-4240-a573-fd5556950531",
                                                "sense_id": "ef71a6c2-0288-3cdb-b9c6-a422b29e50dc",
                                                "text": "Ze sloot haar ogen, zich verzettend tegen de mogelijke schade die dit schilderij, of Isaacs gebrek aan talent, haar hart zou kunnen berokkenen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21d4fac3-e5e2-3dd3-b03a-2dfcb8fe2daf",
                                        "entry_id": "03ef6871-3173-3602-8dc6-deab33003cf7",
                                        "glosses": [
                                            "een defect, een mankement"
                                        ],
                                        "tags": [],
