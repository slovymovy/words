                "senses": [
                    {
                        "sense_id": "f6371373-074e-3848-b8ca-17d0b490fecd",
                        "entry_id": "b184e279-07ed-3820-a9b1-e9c8b105c59e",
                        "glosses": [
                            "To arrange words or items in order of the first (and then subsequent) letters as they occur in the alphabet."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c69e4c7a-c584-4a79-903c-972ac0ab0b3b",
                                "sense_id": "f6371373-074e-3848-b8ca-17d0b490fecd",
                                "text": "It was almost impossible to locate specific books in the library until we had alphabetized them by the authors' surnames."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15109282-366d-4452-863b-7b9590813ee5",
                        "source_entry_id": "b184e279-07ed-3820-a9b1-e9c8b105c59e",
                        "source_sense_id": "f6371373-074e-3848-b8ca-17d0b490fecd",
                        "source_sense_description": "to arrange alphabetically",
                        "target_lang_word": "alphabetisieren",
