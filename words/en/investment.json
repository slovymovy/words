{
    "word_family": [
        "invest",
        "investor",
        "investiture",
        "reinvest",
        "reinvestment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3d2f42ee-f1a5-31bd-ad35-644ea1109b02",
                    "sense_definition": "The action of putting money into financial schemes, shares, property, or a commercial venture with the expectation of achieving a profit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "financial_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Buying a house is often considered a safe <w>investment</w> for the future.",
                            "target_lang_translations": {
                                "ru": "Покупка дома часто считается надежной <w>инвестицией</w> в будущее.",
                                "tr": "Ev satın almak genellikle gelecek için güvenli bir <w>yatırım</w> olarak kabul edilir."
                            }
                        },
                        {
                            "text": "The company plans to increase its <w>investment</w> in renewable energy sources.",
                            "target_lang_translations": {
                                "ru": "Компания планирует увеличить свои <w>инвестиции</w> в возобновляемые источники энергии.",
                                "tr": "Şirket, yenilenebilir enerji kaynaklarına yaptığı <w>yatırımı</w> artırmayı planlıyor."
                            }
                        }
                    ],
                    "antonyms": [
                        "divestment"
                    ],
                    "common_phrases": [
                        "return on investment",
                        "foreign investment",
                        "good investment",
                        "capital investment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по вложению денег в финансовые схемы, акции, недвижимость или коммерческое предприятие с ожиданием получения прибыли.",
                        "tr": "Kâr elde etme beklentisiyle finansal planlara, hisselere, mülke veya ticari bir girişime para yatırma eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инвестиция",
                                "target_lang_sense_clarification": "финансовое вложение"
                            },
                            {
                                "target_lang_word": "вложение",
                                "target_lang_sense_clarification": "размещение средств"
                            },
                            {
                                "target_lang_word": "инвестирование",
                                "target_lang_sense_clarification": "процесс вложения"
                            },
                            {
                                "target_lang_word": "капиталовложение",
                                "target_lang_sense_clarification": "вложение капитала"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yatırım",
                                "target_lang_sense_clarification": "finansal sermaye yatırma"
                            },
                            {
                                "target_lang_word": "envestisman",
                                "target_lang_sense_clarification": "yatırım (terimsel)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7af667ac-0d7c-3ad1-8f22-cdb88c2f1f35",
                    "sense_definition": "The act of devoting time, effort, or energy to a particular undertaking with the hope of a worthwhile result.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "general_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Learning a new language requires a significant <w>investment</w> of time and patience.",
                            "target_lang_translations": {
                                "ru": "Изучение нового языка требует значительного <w>вложения</w> времени и терпения.",
                                "tr": "Yeni bir dil öğrenmek, önemli bir zaman ve sabır <w>yatırımı</w> gerektirir."
                            }
                        },
                        {
                            "text": "Her emotional <w>investment</w> in the project made the failure hard to accept.",
                            "target_lang_translations": {
                                "ru": "Её эмоциональный <w>вклад</w> в проект сделал неудачу трудной для принятия.",
                                "tr": "Projeye yaptığı duygusal <w>yatırım</w>, başarısızlığı kabullenmeyi zorlaştırdı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "investment of time",
                        "emotional investment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт посвящения времени, усилий или энергии определенному делу в надежде на стоящий результат.",
                        "tr": "Faydalı bir sonuç elde etme umuduyla belirli bir işe zaman, çaba veya enerji adama eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вложение",
                                "target_lang_sense_clarification": "трата ресурсов или сил"
                            },
                            {
                                "target_lang_word": "вклад",
                                "target_lang_sense_clarification": "участие в деле"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yatırım",
                                "target_lang_sense_clarification": "zaman veya emek harcama"
                            },
                            {
                                "target_lang_word": "katkı",
                                "target_lang_sense_clarification": "çaba veya duygu aktarımı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44646829-2264-371c-8efa-038b2a33b9d2",
                    "sense_definition": "The act of surrounding a place with military forces to cut off supplies or escape; a siege.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general ordered the immediate <w>investment</w> of the enemy fortress.",
                            "target_lang_translations": {
                                "ru": "Генерал приказал немедленно начать <w>осаду</w> вражеской крепости.",
                                "tr": "General, düşman kalesinin derhal <w>kuşatılmasını</w> emretti."
                            }
                        },
                        {
                            "text": "During the <w>investment</w> of the city, no food was allowed to enter.",
                            "target_lang_translations": {
                                "ru": "Во время <w>осады</w> города ввоз продовольствия был запрещен.",
                                "tr": "Şehrin <w>kuşatılması</w> sırasında içeriye hiçbir yiyeceğin girmesine izin verilmedi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Окружение места военными силами с целью отрезать пути снабжения или побега; осада.",
                        "tr": "Tedarik hatlarını veya kaçış yollarını kesmek için bir yeri askeri güçlerle kuşatma eylemi; kuşatma."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осада",
                                "target_lang_sense_clarification": "военная блокада"
                            },
                            {
                                "target_lang_word": "обложение",
                                "target_lang_sense_clarification": "окружение войсками"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kuşatma",
                                "target_lang_sense_clarification": "askeri abluka"
                            },
                            {
                                "target_lang_word": "çevirme",
                                "target_lang_sense_clarification": "etrafını sarma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4df2e5fe-fa93-3e2e-bc43-ddc3b1b0be59",
                    "sense_definition": "A mixture of silica sand and plaster used to form a mold for casting metals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jeweler poured the liquid <w>investment</w> around the wax model.",
                            "target_lang_translations": {
                                "ru": "Ювелир залил жидкую <w>формовочную смесь</w> вокруг восковой модели.",
                                "tr": "Kuyumcu, sıvı <w>döküm harcını</w> balmumu modelin etrafına döktü."
                            }
                        },
                        {
                            "text": "Once the <w>investment</w> hardened, it was placed in the kiln.",
                            "target_lang_translations": {
                                "ru": "Как только <w>формовочная смесь</w> затвердела, её поместили в печь.",
                                "tr": "<w>Döküm harcı</w> sertleşince fırına yerleştirildi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смесь кварцевого песка и гипса, используемая для создания форм при литье металлов.",
                        "tr": "Metalleri dökmek için bir kalıp oluşturmada kullanılan silis kumu ve alçı karışımı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "формовочная смесь",
                                "target_lang_sense_clarification": "материал для литья"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "döküm harcı",
                                "target_lang_sense_clarification": "kuyumculuk ve döküm kalıp malzemesi"
                            },
                            {
                                "target_lang_word": "revizman",
                                "target_lang_sense_clarification": "kuyumculukta kullanılan alçı karışımı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77b81535-9e7c-314c-9391-355b653911d5",
                    "sense_definition": "A garment or piece of clothing, especially a ceremonial vestment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest appeared in a white <w>investment</w> for the sacred ritual.",
                            "target_lang_translations": {
                                "ru": "Священник появился в белом <w>облачении</w> для священного ритуала.",
                                "tr": "Rahi̇p, kutsal tören için beyaz bir <w>kisve</w> içinde göründü."
                            }
                        },
                        {
                            "text": "He was clad in the strange <w>investment</w> of an ancient king.",
                            "target_lang_translations": {
                                "ru": "Он был облачен в странное <w>одеяние</w> древнего короля.",
                                "tr": "Eski bir kralın garip <w>libasına</w> bürünmüştü."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used to refer to clothing or vestments"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет одежды, особенно церемониальное облачение.",
                        "tr": "Bir giysi veya elbise parçası, özellikle dini veya törensel giysi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облачение",
                                "target_lang_sense_clarification": "церемониальная одежда"
                            },
                            {
                                "target_lang_word": "одеяние",
                                "target_lang_sense_clarification": "одежда"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "libas",
                                "target_lang_sense_clarification": "eski dilde giysi"
                            },
                            {
                                "target_lang_word": "kisve",
                                "target_lang_sense_clarification": "törensel veya resmi giysi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
