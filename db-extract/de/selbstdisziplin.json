                ],
                "senses": [
                    {
                        "sense_id": "e269a7c9-eb10-3563-a50b-d85ef280e655",
                        "entry_id": "0a6b4569-8ecb-3e84-90b1-50fc367f6473",
                        "glosses": [
                            "Kontrolle einer Person über sich selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3d1fd66-bcc7-46eb-b27b-734513c24dfb",
                                "sense_id": "e269a7c9-eb10-3563-a50b-d85ef280e655",
                                "text": "Sportliche Höchstleistungen erfordern viel Selbstdisziplin."
                            },
                            {
                                "example_id": "af02762a-2159-4cae-b383-05e822f697d6",
                                "sense_id": "e269a7c9-eb10-3563-a50b-d85ef280e655",
                                "text": "„Es ist das Sinnbild der englischen Variante der Selbstdisziplin, der berühmten steifen Oberlippe, die allen Briten in Krisenzeiten ins Gesicht geschrieben steht.“"
                            },
                            {
                                "example_id": "86e17557-0ec9-421b-b847-49d77ddf5dd2",
                                "sense_id": "e269a7c9-eb10-3563-a50b-d85ef280e655",
                                "text": "„Ironischerweise hat dann gerade die ›protestantische Ethik‹ mit ihrer Selbstdisziplin, ihrem Arbeitsfleiß und ihrem Erfolgseifer dazu beigetragen, dass aus dieser ›unfruchtbaren Sache‹ eine wurde, ohne die nichts mehr funktionierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddf3a2f6-c164-4dac-8d16-58465266a139",
                        "source_entry_id": "0a6b4569-8ecb-3e84-90b1-50fc367f6473",
                        "source_sense_id": "e269a7c9-eb10-3563-a50b-d85ef280e655",
                        "source_sense_description": "Kontrolle einer Person über sich selbst",
                        "target_lang_word": "self-discipline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-discipline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c33c7be-0000-3b55-9a76-1f946c3cd5bc",
                                        "entry_id": "6e9e7de8-55ff-3cca-9a1a-62cdd808445c",
                                        "glosses": [
                                            "Control of oneself."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31d14504-6709-4fab-97de-e17007144b92",
                                                "sense_id": "4c33c7be-0000-3b55-9a76-1f946c3cd5bc",
                                                "text": "Near-synonym: willpower"
                                            },
                                            {
                                                "example_id": "500b118b-e7f2-4f92-97bf-e0fe8abd92e9",
                                                "sense_id": "4c33c7be-0000-3b55-9a76-1f946c3cd5bc",
                                                "text": "Personal reinventions fail partly for the obvious reasons: you set your goals too high; or your existing obligations at work or home get in the way; or you find (who could have imagined it?) that the unimpressive level of self-discipline you’ve demonstrated for your entire life until this moment can’t magically be tripled overnight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22177874-4107-44fb-8ead-54b04e33d1e7",
                        "source_entry_id": "0a6b4569-8ecb-3e84-90b1-50fc367f6473",
                        "source_sense_id": "e269a7c9-eb10-3563-a50b-d85ef280e655",
                        "source_sense_description": "Kontrolle einer Person über sich selbst",
                        "target_lang_word": "autodiscipline",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
