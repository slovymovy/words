                ],
                "senses": [
                    {
                        "sense_id": "27aca507-96d7-3391-a3de-7cb489610eb3",
                        "entry_id": "c9829c9a-b43c-304b-9604-ae87adfe0a58",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea863889-d731-4da8-a26f-381401a29b46",
                                "sense_id": "27aca507-96d7-3391-a3de-7cb489610eb3",
                                "text": "Frau Kienle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fb82058d-d9f8-4569-9599-ee508b37805f",
                                "sense_id": "27aca507-96d7-3391-a3de-7cb489610eb3",
                                "text": "Herr Kienle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b0c397d6-afb2-4d13-a1a9-795ce7832061",
                                "sense_id": "27aca507-96d7-3391-a3de-7cb489610eb3",
                                "text": "Die Kienles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "60c52421-5231-40e5-8106-787b8296334b",
                                "sense_id": "27aca507-96d7-3391-a3de-7cb489610eb3",
                                "text": "Der Kienle trägt nie die Schals, die die Kienle ihm strickt."
                            },
                            {
                                "example_id": "ad385535-ba3b-49cd-a99b-2d59d6b602ad",
                                "sense_id": "27aca507-96d7-3391-a3de-7cb489610eb3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kienle kommt, geht der Herr Kienle.“"
                            },
                            {
                                "example_id": "4b0c9899-f4a0-4cc6-9dce-68ad4be0cf9c",
                                "sense_id": "27aca507-96d7-3391-a3de-7cb489610eb3",
                                "text": "Kienle kommt und geht."
                            },
                            {
                                "example_id": "dcec79ee-8e33-4045-b571-f5b7e37157a9",
                                "sense_id": "27aca507-96d7-3391-a3de-7cb489610eb3",
                                "text": "Kienles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
