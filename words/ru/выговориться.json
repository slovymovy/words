{
    "word_family": [
        "говор",
        "говорить",
        "разговор",
        "договор",
        "приговор",
        "заговор",
        "выговор"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ace0bb06-8032-3519-8b86-da56d3cb27b1",
                    "sense_definition": "Высказать всё, что накопилось на душе, облегчить душу разговором.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "выражение_чувств",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ей нужно было <w>выговориться</w>, чтобы почувствовать себя лучше после тяжелого дня.",
                            "target_lang_translations": {
                                "en": "She needed to <w>unburden herself</w> to feel better after a hard day."
                            }
                        },
                        {
                            "text": "Иногда полезно просто <w>выговориться</w> близкому другу, чтобы снять напряжение.",
                            "target_lang_translations": {
                                "en": "Sometimes it is helpful just to <w>vent</w> to a close friend to relieve tension."
                            }
                        }
                    ],
                    "synonyms": [
                        "излиться",
                        "отвести душу"
                    ],
                    "common_phrases": [
                        "хочется выговориться",
                        "нужно выговориться"
                    ],
                    "target_lang_definitions": {
                        "en": "To express everything that has been weighing on one's mind, to unburden oneself through talking."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to unburden oneself",
                                "target_lang_sense_clarification": "to relieve emotional stress by talking"
                            },
                            {
                                "target_lang_word": "to vent",
                                "target_lang_sense_clarification": "to express strong feelings or frustrations"
                            },
                            {
                                "target_lang_word": "to get it off one's chest",
                                "target_lang_sense_clarification": "idiomatic expression for sharing hidden worries"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf91d497-0d32-32b2-b5e1-f239016d9e8d",
                    "sense_definition": "Высказать всё, что планировалось, договорить до конца.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "завершение_речи",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он не успел <w>выговориться</w>, как его перебили на полуслове.",
                            "target_lang_translations": {
                                "en": "He hadn't finished <w>having his say</w> before he was interrupted mid-sentence."
                            }
                        },
                        {
                            "text": "Дай мне <w>выговориться</w>, а потом уже задавай свои вопросы.",
                            "target_lang_translations": {
                                "en": "Let me <w>finish speaking</w>, and then you can ask your questions."
                            }
                        }
                    ],
                    "synonyms": [
                        "договорить"
                    ],
                    "common_phrases": [
                        "дать выговориться"
                    ],
                    "target_lang_definitions": {
                        "en": "To say everything one intended to say, to finish speaking completely."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to finish speaking",
                                "target_lang_sense_clarification": "to complete one's intended message"
                            },
                            {
                                "target_lang_word": "to have one's say",
                                "target_lang_sense_clarification": "to express one's opinion fully"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f72ae8b-6b47-3af3-94ed-1c83cb32ed0e",
                    "sense_definition": "Прозвучать при произнесении каким-либо образом, иметь определенную манеру произношения.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "произношение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это слово <w>выговорилось</w> с трудом из-за непривычного сочетания звуков.",
                            "target_lang_translations": {
                                "en": "This word was <w>pronounced</w> with difficulty due to the unusual combination of sounds."
                            }
                        },
                        {
                            "text": "Иностранное имя <w>выговорилось</w> не совсем правильно в первый раз.",
                            "target_lang_translations": {
                                "en": "The foreign name <w>came out</w> not quite correctly the first time."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be pronounced in a certain way, to have a specific manner of articulation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be pronounced",
                                "target_lang_sense_clarification": "referring to the physical act of articulation"
                            },
                            {
                                "target_lang_word": "to come out",
                                "target_lang_sense_clarification": "how a word sounds when spoken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf31e41f-ee4f-3a63-85b8-13fccbb45743",
                    "sense_definition": "Страдательная форма глагола <w>выговорить</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "грамматика",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Условие было <w>выговорено</w> заранее в ходе переговоров.",
                            "target_lang_translations": {
                                "en": "The condition was <w>stipulated</w> in advance during the negotiations."
                            }
                        },
                        {
                            "text": "Требование было четко <w>выговорено</w> представителем компании.",
                            "target_lang_translations": {
                                "en": "The demand was clearly <w>articulated</w> by the company representative."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "грамматическая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Passive form of the verb 'to articulate' or 'to stipulate'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be articulated",
                                "target_lang_sense_clarification": "to be clearly expressed or stated"
                            },
                            {
                                "target_lang_word": "to be stipulated",
                                "target_lang_sense_clarification": "to be specified as a condition"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}