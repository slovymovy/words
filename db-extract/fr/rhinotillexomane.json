                        "translation_id": "2f1e4078-ff51-4cc6-8928-b9356c69843b",
                        "source_entry_id": "384a2c62-c5e7-3ade-a35d-a96999803870",
                        "source_sense_id": "ce237a32-0f0e-3b9c-a6d5-3c655e97bd0b",
                        "target_lang_word": "rhinotillexomaniac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhinotillexomaniac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "800ddeb6-c110-3446-bbae-f01a7e88cbba",
                                        "entry_id": "efe64891-c136-3e89-8f89-0a4db08c0dcb",
                                        "glosses": [
                                            "One who suffers from rhinotillexomania; a compulsive nose-picker."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd334089-e0cd-4fdd-abb7-d1926f388c9c",
                                                "sense_id": "800ddeb6-c110-3446-bbae-f01a7e88cbba",
                                                "text": "If you see someone picking their nose, call them a \"rhinotillexomaniac\" (ri-no-til-ex-o-MANE-ee-ack)."
                                            },
                                            {
                                                "example_id": "246d251b-c9f8-4665-a491-e241fc7906c5",
                                                "sense_id": "800ddeb6-c110-3446-bbae-f01a7e88cbba",
                                                "text": "Now you have fancy names for armpit-odor lovers, for those who love mannequins more than people, for biters and the bitten, and seven more. \"Massive\" must be a filter, with the rhinotillexomaniacs and the apotemnophiliacs laying low these days."
                                            },
                                            {
                                                "example_id": "416591e8-e11f-4071-b598-f0596f308dc3",
                                                "sense_id": "800ddeb6-c110-3446-bbae-f01a7e88cbba",
                                                "text": "Larry, as a prolific rhinotillexomaniac, what is your professional opinion about this scholarly study? Did you take part in the study and how much did you eat?"
                                            },
                                            {
                                                "example_id": "ccc0b5c6-4600-45fe-aa15-4954c33d32c0",
                                                "sense_id": "800ddeb6-c110-3446-bbae-f01a7e88cbba",
                                                "text": "He was cursing his lousy tendency of aggressive nose-picking, like a Rhinotillexomaniac."
                                            },
                                            {
                                                "example_id": "64971cb0-152c-4a44-b301-dc73d3114c38",
                                                "sense_id": "800ddeb6-c110-3446-bbae-f01a7e88cbba",
                                                "text": "reading that night writes poems about guerilla warfare and hearts in ribcages, please don't sit down there, the man is a rhinotillexomaniac, I can tell you all about it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
