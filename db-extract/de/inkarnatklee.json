                "senses": [
                    {
                        "sense_id": "eb032923-492f-39e5-bfab-61feb1a2c38d",
                        "entry_id": "f8994998-3ac0-3130-b36d-ce9fa38b1059",
                        "glosses": [
                            "eine Pflanze aus der Gattung des Klees (Trifolium), die vor allen Dingen als Futterpflanze angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8155bb72-abc1-4042-a0e3-4d55c6854741",
                                "sense_id": "eb032923-492f-39e5-bfab-61feb1a2c38d",
                                "text": "„Der Inkarnatklee ist eine einjährige (selten zweijährige), krautige Pflanze, die Wuchshöhen von zwischen 20 und 50 Zentimeter erreicht.“"
                            },
                            {
                                "example_id": "de0e348e-a65e-40c7-aa0f-fb81ae9bd7a5",
                                "sense_id": "eb032923-492f-39e5-bfab-61feb1a2c38d",
                                "text": "„Das natürliche Verbreitungsgebiet des Inkarnatklees ist der Mittelmeerraum mit Portugal, Spanien, Frankreich, Italien (mit allen Inseln), die Balkanhalbinsel und Türkei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
