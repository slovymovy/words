                ],
                "senses": [
                    {
                        "sense_id": "0aa8265a-5dac-3ee3-9dd6-af45e9a448e7",
                        "entry_id": "5f372980-354b-3528-b1a8-b780f157cff0",
                        "glosses": [
                            "Teppichmaterial, das den Fußboden bedeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65f5f190-1e2e-4558-8744-446a8d049f7d",
                                "sense_id": "0aa8265a-5dac-3ee3-9dd6-af45e9a448e7",
                                "text": "„An der Tür hatte sich ein Stück vom Teppichboden gelöst, aber ich konnte nicht herausfinden, ob der Schaden von der Türbewegung herrührte oder vom Ein- und Aussteigen.“"
                            },
                            {
                                "example_id": "e2d6cc88-5c8b-4bbf-acc4-d3d46dae1695",
                                "sense_id": "0aa8265a-5dac-3ee3-9dd6-af45e9a448e7",
                                "text": "„Sie rutschte vom Schreibtisch und ging auf meinem Teppichboden auf und ab.“"
                            },
                            {
                                "example_id": "00a68948-8b13-400b-a959-6f2cff499c32",
                                "sense_id": "0aa8265a-5dac-3ee3-9dd6-af45e9a448e7",
                                "text": "„Der Meister und sein Lehrling verlegen Teppichboden.“"
                            },
                            {
                                "example_id": "332eda77-0f55-4bf4-bacb-f77cde1bfd6a",
                                "sense_id": "0aa8265a-5dac-3ee3-9dd6-af45e9a448e7",
                                "text": "„Er streifte sich abermals die Stiefelsohlen am Teppichboden ab, ließ den Blick ein letztes Mal durchs Zimmer wandern und ging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
