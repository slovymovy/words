                "senses": [
                    {
                        "sense_id": "74facda9-4ea6-37a2-b48a-4f8b7a73a171",
                        "entry_id": "d24d156c-fb9f-32d0-aebd-e585b89e2c30",
                        "glosses": [
                            "Variante de rob, deux manches de gagnées de suite par une équipe au whist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cb9968c-9f00-4313-8bc3-6f1732526472",
                                "sense_id": "74facda9-4ea6-37a2-b48a-4f8b7a73a171",
                                "text": "Pendant le jeu, les joueurs ne parlaient pas, mais entre les robres, la conversation interrompue reprenait de plus belle."
                            },
                            {
                                "example_id": "ac2df1d5-4a5f-484a-9567-1e22dc96b04f",
                                "sense_id": "74facda9-4ea6-37a2-b48a-4f8b7a73a171",
                                "text": "En général, une partie de bridge se joue en trois robres ou manches."
                            },
                            {
                                "example_id": "20121dcb-db67-478b-8e97-f558599b3436",
                                "sense_id": "74facda9-4ea6-37a2-b48a-4f8b7a73a171",
                                "text": "« Un autre robre, Alfred ? » dit-il au père de Miles, alors que les voitures emmenaient les invités."
                            },
                            {
                                "example_id": "815d6fd6-1631-4951-af12-ffb2378d948a",
                                "sense_id": "74facda9-4ea6-37a2-b48a-4f8b7a73a171",
                                "text": "Quand il arriva, ses amis finissaient juste de distribuer le premier robre et il put aisément se faire accepter comme cinquième partenaire."
                            }
                        ]
                    }
                ],
