                "senses": [
                    {
                        "sense_id": "dd5cd6b3-5185-30cf-9e4d-1253c2bf4615",
                        "entry_id": "48d0dc35-6162-3783-8230-27d0deb21d1c",
                        "glosses": [
                            "Bildnis von Adolf Hitler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83ee5060-dcdf-4870-a5c7-5062f460c66d",
                                "sense_id": "dd5cd6b3-5185-30cf-9e4d-1253c2bf4615",
                                "text": "„An der Stirnwand des Raumes hing ein fast lebensgroßes Hitlerbild im Farbdruck.“"
                            },
                            {
                                "example_id": "c9d1be5f-94e0-477e-9f64-ef6c04e70549",
                                "sense_id": "dd5cd6b3-5185-30cf-9e4d-1253c2bf4615",
                                "text": "„Viele mussten ein Hitlerbild ablecken, das die Partisanen bespuckt hatten.“"
                            },
                            {
                                "example_id": "3e48cf2e-386e-4115-9fcd-b398b89c3fad",
                                "sense_id": "dd5cd6b3-5185-30cf-9e4d-1253c2bf4615",
                                "text": "„Landauf, landab befestigen Bürgerinnen und Bürger Hakenkreuzfahnen und Hitlerbilder an Fenstern und Balkonen, flechten Girlanden, schicken Geschenke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
