                                            {
                                                "example_id": "9c304d33-464c-4f25-8d87-d646871a2f5b",
                                                "sense_id": "66667321-e456-3891-8392-265980954991",
                                                "text": "De bloeddorstige soldaten vochten zeer wreed in de oorlog."
                                            },
