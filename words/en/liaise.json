    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b47a154e-69c0-3679-b147-4aea20d1b8ac",
                    "sense_definition": "To establish a connection or communication link between different groups or people.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager will <w>liaise</w> with the marketing department to ensure the campaign is ready."
                        },
                        {
                            "text": "We need to <w>liaise</w> effectively with local authorities on this project."
                        }
                    ],
                    "synonyms": [
                        "connect",
                        "coordinate"
                    ],
                    "common_phrases": [
                        "liaise with"
                    ]
                },
                {
                    "sense_id": "3c8efdd9-5c06-3805-9582-004b77869524",
                    "sense_definition": "To cooperate and consult with others to reach a shared goal or solution.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team must <w>liaise</w> with contractors to restart the construction work safely."
                        },
                        {
                            "text": "Our office will <w>liaise</w> with the partners on the final budget details."
                        }
                    ],
                    "synonyms": [
                        "collaborate",
                        "cooperate"
                    ],
                    "common_phrases": [
                        "liaise with"
                    ]
                },
                {
                    "sense_id": "e8e21d09-ad82-3b6a-b1b2-f4f645174723",
                    "sense_definition": "To act as an intermediary between parties to help resolve disagreements.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diplomat was sent to <w>liaise</w> between the two warring factions to find peace."
                        },
                        {
                            "text": "She had to <w>liaise</w> between the angry client and the design team."
                        }
                    ],
                    "synonyms": [
                        "mediate",
                        "arbitrate"
                    ],
                    "common_phrases": [
                        "liaise between"
                    ]
                }
            ]
        }
    ]
