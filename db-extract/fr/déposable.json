                            {
                                "example_id": "c5a4ee30-555b-4adf-bbef-2a3f129ceef7",
                                "sense_id": "b2153f73-74de-3ee0-b2b0-af1683442f59",
                                "text": "Le montant maximum déposable sur un LDD passera à 12 000 €, dès octobre 2012."
