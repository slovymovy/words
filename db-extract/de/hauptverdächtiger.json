                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9bdcbbb-66d4-4635-b992-8bddf8a89106",
                                "sense_id": "8d617ec0-685e-30df-a156-74e62a25213e",
                                "text": "„Der zweite Hauptverdächtige liegt weiter mit Schussverletzungen im Krankenhaus.“"
                            },
                            {
                                "example_id": "66d1df8e-20b2-40de-b8b0-d20e7a611030",
                                "sense_id": "8d617ec0-685e-30df-a156-74e62a25213e",
                                "text": "„Obgleich verschiedene Versionen über die Ermordung Habibullahs I. kursieren, wird immer wieder Amanullah als Hauptverdächtiger genannt.“"
                            }
                        ],
