                    "semantic_group_id": "historische_dokumente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Universitätsbibliothek werden zahlreiche wertvolle <w>Manuskripte</w> aus dem Mittelalter aufbewahrt."
