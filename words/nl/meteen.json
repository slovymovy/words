                {
                    "sense_id": "d1e545cc-1bb1-3a51-b65d-d4de03e2c2fa",
                    "sense_definition": "Tegelijkertijd met een andere handeling; in één moeite door.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als we daar toch zijn, zullen we het pakketje <w>meteen</w> meenemen.",
                            "target_lang_translations": {
                                "en": "If we're there anyway, we'll take the package <w>at the same time</w>.",
                                "ru": "Раз уж мы там будем, то <w>заодно</w> заберем и посылку.",
                                "pl": "Skoro i tak tam będziemy, <w>przy okazji</w> zabierzemy paczkę.",
                                "de": "Wenn wir schon einmal da sind, nehmen wir das Paket <w>gleich</w> mit.",
                                "fr": "Puisque nous y sommes, nous prendrons le colis <w>par la même occasion</w>.",
                                "it": "Dato che siamo già lì, porteremo via il pacchetto <w>già che ci siamo</w>.",
                                "cs": "Když už tam budeme, <w>zaodno</w> vezmeme i ten balíček.",
                                "tr": "Madem oraya gidiyoruz, paketi de <w>hazır gitmişken</w> alalım.",
                                "es": "Ya que vamos a estar allí, <w>de paso</w> nos llevamos el paquete.",
                                "zh": "既然我们都要去那里，就<w>顺便</w>把包裹带上吧。"
                            }
                        },
                        {
                            "text": "Als je naar de keuken loopt, breng dan <w>meteen</w> wat koffie mee.",
                            "target_lang_translations": {
                                "en": "If you walk to the kitchen, bring some coffee <w>while you're at it</w>.",
                                "ru": "Если идешь на кухню, захвати <w>заодно</w> кофе.",
                                "pl": "Jeśli idziesz do kuchni, <w>przy okazji</w> przynieś trochę kawy.",
                                "de": "Wenn du in die Küche gehst, bring <w>gleich</w> etwas Kaffee mit.",
                                "fr": "Si tu vas à la cuisine, apporte <w>en passant</w> un peu de café.",
                                "it": "Se vai in cucina, porta <w>già che ci sei</w> anche un po' di caffè.",
                                "cs": "Když jdeš do kuchyně, přines <w>zaodno</w> i trochu kávy.",
                                "tr": "Mutfak tarafına gidiyorsan, <w>hazır gitmişken</w> biraz kahve getir.",
                                "es": "Si vas a la cocina, <w>de paso</w> trae un poco de café.",
                                "zh": "如果你要去厨房，就<w>顺便</w>带点咖啡过来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "meteen meenemen",
                        "meteen even doen"
                    ],
                    "target_lang_definitions": {
                        "en": "Simultaneously with another action; taking the opportunity to do something else in the same effort.",
                        "ru": "Одновременно с другим действием; попутно.",
                        "pl": "Jednocześnie z inną czynnością; przy okazji wykonywania czegoś innego.",
                        "de": "Gleichzeitig mit einer anderen Handlung; bei der Gelegenheit.",
                        "fr": "En même temps qu'une autre action ; profiter de l'occasion pour faire quelque chose d'autre.",
                        "it": "Contemporaneamente a un'altra azione; cogliendo l'occasione per fare qualcos'altro nello stesso momento.",
                        "cs": "Současně s jinou činností; při jedné příležitosti.",
                        "tr": "Başka bir eylemle eş zamanlı olarak; fırsattan istifade ederek.",
                        "es": "Simultáneamente con otra acción; aprovechando la oportunidad para hacer algo más en el mismo esfuerzo.",
                        "zh": "与另一动作同时进行；顺便完成某事。"
                    },
