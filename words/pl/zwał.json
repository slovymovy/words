            "senses": [
                {
                    "sense_id": "7c54d609-287d-3522-a48e-7efbddc3121a",
                    "sense_definition": "duża sterta lub kupa czegoś",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sterta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na środku pokoju leżał wielki <w>zwał</w> ubrań.",
                            "target_lang_translations": {
                                "ru": "Посреди комнаты лежала огромная <w>куча</w> одежды."
                            }
                        },
                        {
                            "text": "Wiatr usypał wysoki <w>zwał</w> śniegu przed wejściem do domu.",
                            "target_lang_translations": {
                                "ru": "Ветер намел высокий <w>сугроб</w> снега перед входом в дом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zwał śniegu",
                        "zwał ubrań"
                    ],
                    "target_lang_definitions": {
                        "ru": "большая куча или груда чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куча",
                                "target_lang_sense_clarification": "общая груда предметов"
                            },
                            {
                                "target_lang_word": "груда",
                                "target_lang_sense_clarification": "большое скопление предметов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff974358-93e4-35fd-aebf-38e1392edabe",
                    "sense_definition": "miejsce składowania odpadów przemysłowych lub górniczych",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sterta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W oddali widać było ogromny <w>zwał</w> kamieni z kopalni.",
                            "target_lang_translations": {
                                "ru": "Вдали был виден огромный <w>террикон</w> камней из шахты."
                            }
                        },
                        {
                            "text": "Teren wokół dawnego <w>zwału</w> został poddany rekultywacji.",
                            "target_lang_translations": {
                                "ru": "Территория вокруг бывшего <w>отвала</w> была рекультивирована."
                            }
                        }
                    ],
                    "synonyms": [
                        "hałda",
                        "zsypisko"
                    ],
                    "common_phrases": [
