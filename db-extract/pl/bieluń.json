        "pl-extract.jsonl": [
            {
                "entry_id": "4c603806-9d93-3103-924f-e8890ddb0050",
                "word": "bieluń",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "22ad5681-e16d-32e5-9e82-9a425e8e54a2",
                        "entry_id": "4c603806-9d93-3103-924f-e8890ddb0050",
                        "glosses": [
                            "Datura L., rodzaj trujących roślin z rodziny psiankowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e0e3412-3549-4ce0-8f03-847042fde9d7",
                                "sense_id": "22ad5681-e16d-32e5-9e82-9a425e8e54a2",
                                "text": "Bieluń jest rośliną silnie trującą – zawiera alkaloidy tropanowe."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8664fc86-efc4-402d-807e-352adafa50fc",
                        "source_entry_id": "4c603806-9d93-3103-924f-e8890ddb0050",
                        "source_sense_id": "22ad5681-e16d-32e5-9e82-9a425e8e54a2",
                        "target_lang_word": "datura",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "datura",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a58dd630-9daf-3eeb-8971-f146081bcc8e",
                                        "entry_id": "a92c63c4-4af0-36eb-8e59-f6a99e0c6a0b",
                                        "glosses": [
                                            "A plant of the genus Datura, known for its trumpet-shaped flowers and poisonous properties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "018ff4ed-0296-4387-9eb2-e028b935f062",
                                                "sense_id": "a58dd630-9daf-3eeb-8971-f146081bcc8e",
                                                "text": "Garcias ab Horto [...] makes mention of an herb called datura, “which, if it be eaten for twenty-four hours following, takes away all sense of grief, makes them incline to laughter and mirth” [...]."
                                            },
                                            {
                                                "example_id": "eb9e84c4-7568-4961-ab30-4b0fe79fcfa1",
                                                "sense_id": "a58dd630-9daf-3eeb-8971-f146081bcc8e",
                                                "text": "\"Apple of Death\" is what the Jungle call thorn-apple or dhatura, the readiest poison in all India."
                                            },
                                            {
                                                "example_id": "23cb7e24-9935-4aa2-b907-5eee4309be24",
                                                "sense_id": "a58dd630-9daf-3eeb-8971-f146081bcc8e",
                                                "text": "\"Suffice it that it was of the datura family which supplies deadly poisons as well as powerful medicines.\""
                                            },
                                            {
                                                "example_id": "f2ee8cdd-2ef4-4ae8-b5b1-8120e22bc211",
                                                "sense_id": "a58dd630-9daf-3eeb-8971-f146081bcc8e",
                                                "text": "Datura did grow in Haiti, three species, all of them introduced from the Old World."
                                            },
                                            {
                                                "example_id": "16437bd9-2c69-4e90-9ca5-82af4f27f06d",
                                                "sense_id": "a58dd630-9daf-3eeb-8971-f146081bcc8e",
                                                "text": "It was a decoction of datura that wrung the truth from the old woman, by sending her into a trance from which she never recovered."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "876e74d3-345e-43a3-9710-0f3bb131452d",
                        "source_entry_id": "4c603806-9d93-3103-924f-e8890ddb0050",
                        "source_sense_id": "22ad5681-e16d-32e5-9e82-9a425e8e54a2",
                        "target_lang_word": "jimsonweed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jimsonweed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "672919d8-4f61-3bfa-b905-f722f4da217e",
                                        "entry_id": "94d33869-9e30-3ea4-820e-2cbbdf21e188",
                                        "glosses": [
                                            "A poisonous plant of the Datura stramonium species, part of the nightshade (Solanaceae) family, occasionally ingested as a hallucinogen."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db2fe397-19b5-44bb-af7b-763075b41b3d",
                                                "sense_id": "672919d8-4f61-3bfa-b905-f722f4da217e",
                                                "text": "In so doing I have included a number of categories which may not generally be considered suitable for inclusion under the heading of religion. Stewart, for instance, includes shamanism, curing, special powers of shamans, miscellaneous shamanistic information, guardian spirits, destiny of the soul, ghosts or soul, and jimsonweed."
                                            },
                                            {
                                                "example_id": "de466c89-15f0-4b52-a784-024d462f084e",
                                                "sense_id": "672919d8-4f61-3bfa-b905-f722f4da217e",
                                                "text": "While the hallucinations produced by jimsonweed and other anticholinergics are frequently described as frightening or even “nightmarish,” the toxic anticholinergic syndrome caused by jimsonweed can include seizures, CNS depression, respiratory failure, and cardiac abnormalities, all of which can be life-threatening."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "395d06dc-83c1-383b-8d48-eb43150b1430",
                                        "entry_id": "94d33869-9e30-3ea4-820e-2cbbdf21e188",
                                        "glosses": [
                                            "Any poisonous plant of the genus Datura."
                                        ],
                                        "tags": [
                                            "US",
                                            "broadly",
                                            "countable",
                                            "proscribed",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
