                "senses": [
                    {
                        "sense_id": "4965ac81-1bd4-38a2-a33b-62af7c295be2",
                        "entry_id": "bb455902-61f4-338d-a3fd-5887d033c32a",
                        "glosses": [
                            "Ne plus s'adosser (ou être adossé) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c77bcbe-68ef-493e-af90-93f25d8f6c16",
                                "sense_id": "4965ac81-1bd4-38a2-a33b-62af7c295be2",
                                "text": "L'assureur peut donc soit vendre plus d'obligations, au risque de désadosser les contrats restants, soit emprunter de l'argent sur le marché."
                            },
                            {
                                "example_id": "881b27ce-8836-41fc-a362-c063434e4bce",
                                "sense_id": "4965ac81-1bd4-38a2-a33b-62af7c295be2",
                                "text": "C'est pourquoi la logique politique d'une MLCC ne devrait pas mener à sa dématérialisation mais à se désadosser de l'Euro."
                            },
                            {
                                "example_id": "f48807b0-f576-4d89-8c57-f9c5758d6d76",
                                "sense_id": "4965ac81-1bd4-38a2-a33b-62af7c295be2",
                                "text": "Tout en ayant dit ces mots, il avait fini sa bière et tenait sa chope à deux mains et s'était désadossé du rebord du banc sur lequel il était assis."
                            }
                        ]
                    }
