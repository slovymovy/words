        "nl-extract.jsonl": [
            {
                "entry_id": "97433bc1-cadc-31f9-a921-3d39d9a98886",
                "word": "optekenen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "14373fda-0813-3622-9a90-82c4ce24627e",
                        "entry_id": "97433bc1-cadc-31f9-a921-3d39d9a98886",
                        "glosses": [
                            "nauwkeurig omschrijven en schriftelijk vastleggen zodat men het later nog kan raadplegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "015762e5-f40b-4d65-9f88-bfb9b0f8703a",
                                "sense_id": "14373fda-0813-3622-9a90-82c4ce24627e",
                                "text": "In Monza had Stoffel Vandoorne met een zevende plaats in de tweede vrije training al zijn beste resultaat in een officiële sessie laten optekenen. Vrijdag in Singapore, deed hij nog een plaatsje beter: zesde, op een stratenomloop waarop hij nog nooit eerder had gereden. Met een tijd van 1:42.501 was hij bijna drie tienden van een seconde sneller dan ploegmaat Fernando Alonso. Het wakkert de hoop op punten alleen maar aan. ‘Het was een positieve dag, ja’, grijnsde Vandoorne."
                            },
                            {
                                "example_id": "07d03335-f914-4d65-931a-0c8018db7fd6",
                                "sense_id": "14373fda-0813-3622-9a90-82c4ce24627e",
                                "text": "In het boek gaat de voormalige presentator niet alleen in op de zaak, maar laat hij zijn levensverhaal optekenen."
                            },
                            {
                                "example_id": "eaf05587-3240-40da-ab79-db9deacbf576",
                                "sense_id": "14373fda-0813-3622-9a90-82c4ce24627e",
                                "text": "Indië is volgens de zanger het mooiste nummer van List. \"Iedereen kent haar geschiedenis wel: ze heeft in een jappenkamp gezeten, een zwaar leven gehad. Maar ze stond net als Ramses altijd positief in het leven, daar kunnen we een hoop van leren. Indië is het nummer over haar levensgeschiedenis, opgetekend door Freek de Jonge. Een geniale tekst.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20d57113-3237-4009-b74c-af9ea2d309d4",
                        "source_entry_id": "97433bc1-cadc-31f9-a921-3d39d9a98886",
                        "source_sense_id": "14373fda-0813-3622-9a90-82c4ce24627e",
                        "source_sense_description": "nauwkeurig omschrijven en schriftelijk vastleggen zodat men het later nog kan raadplegen",
                        "target_lang_word": "record",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "record",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "211dc091-3d72-3bbe-92da-5e0c9e9dd083",
                                        "entry_id": "22d8068d-1dec-3573-89bf-07f91d6387d6",
                                        "glosses": [
                                            "An item of information put into a temporary or permanent physical medium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08b87e70-89fe-4dbb-bf87-4c6b31df1d27",
                                                "sense_id": "211dc091-3d72-3bbe-92da-5e0c9e9dd083",
                                                "text": "The person had a record of the interview so she could review her notes."
                                            },
                                            {
                                                "example_id": "ed26fddc-6d9c-40f9-ac85-d109cb856529",
                                                "sense_id": "211dc091-3d72-3bbe-92da-5e0c9e9dd083",
                                                "text": "The tourist's photographs and the tape of the police call provide a record of the crime."
                                            },
                                            {
                                                "example_id": "644634f9-a546-46e0-a752-e03216537a2f",
                                                "sense_id": "211dc091-3d72-3bbe-92da-5e0c9e9dd083",
                                                "text": "He draws eclectically on studies of baboons, descriptive anthropological accounts of hunter-gatherer societies and, in a few cases, the fossil record."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4cef54e-7174-39f1-b055-964e93a07ce4",
                                        "entry_id": "22d8068d-1dec-3573-89bf-07f91d6387d6",
                                        "glosses": [
                                            "Any instance of a physical medium on which information was put for the purpose of preserving it and making it available for future reference."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f752600b-8450-492a-ad95-98ef470f0dbb",
                                                "sense_id": "b4cef54e-7174-39f1-b055-964e93a07ce4",
                                                "text": "We have no record of you making this payment to us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "366e562c-a402-3cbb-9d9b-1b8d6e86f607",
                                        "entry_id": "22d8068d-1dec-3573-89bf-07f91d6387d6",
                                        "glosses": [
                                            "Ellipsis of phonograph record (“a disc, usually made from vinyl, on which sound is recorded and may be replayed on a phonograph”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b45c561-1d9f-4bc1-8916-ce5cfb556973",
                                                "sense_id": "366e562c-a402-3cbb-9d9b-1b8d6e86f607",
                                                "text": "I still like records better than CDs."
                                            },
                                            {
                                                "example_id": "36a7ae89-5796-4d2c-ab70-c6366ab5e4d8",
                                                "sense_id": "366e562c-a402-3cbb-9d9b-1b8d6e86f607",
                                                "text": "He's the record doctor / Tell him your woes / He'll reach in his bag / And he'll give you a dose"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e74376c-4b17-3560-8a91-f9e24a95bc42",
                                        "entry_id": "22d8068d-1dec-3573-89bf-07f91d6387d6",
                                        "glosses": [
                                            "A set of data relating to a single individual or item."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20bf6559-5401-44bc-87e1-9f3689e34cdf",
                                                "sense_id": "3e74376c-4b17-3560-8a91-f9e24a95bc42",
                                                "text": "Pull up the record on John Smith. What's his medical history?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b7640ff-6ee9-3d37-b98a-5caf0f462e16",
                                        "entry_id": "22d8068d-1dec-3573-89bf-07f91d6387d6",
                                        "glosses": [
                                            "A data structure similar to a struct, in some programming languages such as C and Java based on classes and designed for storing immutable data."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68afb550-12eb-44ca-8008-a8569b45a6a0",
                                                "sense_id": "4b7640ff-6ee9-3d37-b98a-5caf0f462e16",
                                                "text": "This chapter examines another data structure, the record (available in Pascal but not in all other high-level languages). Records make it easier to organize and represent information in Pascal, a major reason for the popularity of the Pascal[…]"
                                            },
                                            {
                                                "example_id": "5f797001-eb7b-41ab-b259-71a712d61111",
                                                "sense_id": "4b7640ff-6ee9-3d37-b98a-5caf0f462e16",
                                                "text": "The new record type provides another solution. A record is a class-like construct for data classes, a restricted form of class like enums and annotations."
                                            },
                                            {
                                                "example_id": "5e9552d9-c9f0-49e9-8a6d-f4030dd8fc89",
                                                "sense_id": "4b7640ff-6ee9-3d37-b98a-5caf0f462e16",
                                                "text": "A record is a special kind of class that's designed to work well with immutable (readonly) data."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28449607-461e-38eb-8fdd-311b3b50c0ae",
                                        "entry_id": "22d8068d-1dec-3573-89bf-07f91d6387d6",
                                        "glosses": [
                                            "The most extreme known value of some variable, particularly that of an achievement in competitive events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5b20740-dbc5-49e4-9e17-0723323555ff",
                                                "sense_id": "28449607-461e-38eb-8fdd-311b3b50c0ae",
                                                "text": "The heat and humidity were both new records."
                                            },
                                            {
                                                "example_id": "ea6c3389-53da-4e5d-bbd6-ab6a7682a8d3",
                                                "sense_id": "28449607-461e-38eb-8fdd-311b3b50c0ae",
                                                "text": "Australia set a record of 10 back-to-back T20I wins."
                                            },
                                            {
                                                "example_id": "cac40a19-18b3-4fbc-aed1-c72185b5b98d",
                                                "sense_id": "28449607-461e-38eb-8fdd-311b3b50c0ae",
                                                "text": "He broke the record for the youngest English captain."
                                            },
                                            {
                                                "example_id": "6b33c310-dace-479e-88cf-b57344a685d7",
                                                "sense_id": "28449607-461e-38eb-8fdd-311b3b50c0ae",
                                                "text": "The team set a new record for most points scored in a game."
                                            },
                                            {
                                                "example_id": "bb236dfa-8e05-4425-8bad-5678918e4756",
                                                "sense_id": "28449607-461e-38eb-8fdd-311b3b50c0ae",
                                                "text": "\"Avanti has literally broken records over the last six months for delays and cancellations, and the Conservatives' answer is to reward failure with millions more in taxpayer cash,\" said Labour Shadow Transport Secretary Louise Haigh."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "record",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2f4c072-a1aa-3027-b8bc-70256eea1af4",
                                        "entry_id": "106cdf74-9557-3df7-8eab-60ce3f4ec181",
                                        "glosses": [
                                            "Enough to break previous records and set a new one; world-class; historic."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edafccc7-a0fa-41e8-8b06-3afc5eb983dd",
                                                "sense_id": "c2f4c072-a1aa-3027-b8bc-70256eea1af4",
                                                "text": "\"But it's far worse for me,\" said Edmund, \"because you'll at least have a room of your own and I shall have to share a bedroom with that record stinker, Eustace.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "record",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3643acc5-f701-3a3e-a9f3-8934edc48c8e",
                                        "entry_id": "c89acc61-1b46-3c2f-9e53-dac20996dde5",
                                        "glosses": [
                                            "To make a record of information."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b557bec-4902-465f-b8b7-1d7482a31d93",
                                                "sense_id": "3643acc5-f701-3a3e-a9f3-8934edc48c8e",
                                                "text": "I wanted to record every detail of what happened, for the benefit of future generations."
                                            },
                                            {
                                                "example_id": "8fddd3b6-2a4c-4c7d-a73e-130a4bdfcc0a",
                                                "sense_id": "3643acc5-f701-3a3e-a9f3-8934edc48c8e",
                                                "text": "The display and result must be placed in the context that was it was against a side that looked every bit their Fifa world ranking of 141 - but England completed the job with efficiency to record their biggest away win in 19 years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a6aa9bb-82b4-32d2-b31c-276808ab60a6",
                                        "entry_id": "c89acc61-1b46-3c2f-9e53-dac20996dde5",
                                        "glosses": [
                                            "To make an audio or video recording of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e9a8020-8a00-4455-a1b6-4f50d821b7b9",
                                                "sense_id": "3a6aa9bb-82b4-32d2-b31c-276808ab60a6",
                                                "text": "Within a week they had recorded both the song and the video for it."
                                            },
                                            {
                                                "example_id": "c93757e9-3692-4ed7-bdfa-57846f70935c",
                                                "sense_id": "3a6aa9bb-82b4-32d2-b31c-276808ab60a6",
                                                "text": "However, the ability to record people without their knowledge, with the stroke of a finger over the spectacle frame or a voice command, has prompted privacy concerns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "642931b5-e84a-306f-8095-22b1911c9005",
                                        "entry_id": "c89acc61-1b46-3c2f-9e53-dac20996dde5",
                                        "glosses": [
                                            "To give legal status to by making an official public record."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60781477-45aa-4c85-a355-5c2fa0e91c8f",
                                                "sense_id": "642931b5-e84a-306f-8095-22b1911c9005",
                                                "text": "When the deed was recorded, we officially owned the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69706b5f-2973-3df5-81f9-90a3aa9d74e0",
                                        "entry_id": "c89acc61-1b46-3c2f-9e53-dac20996dde5",
                                        "glosses": [
                                            "To fix in a medium, usually in a tangible medium."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92e44f15-248b-3c3c-abbe-d091f958a556",
                                        "entry_id": "c89acc61-1b46-3c2f-9e53-dac20996dde5",
                                        "glosses": [
                                            "To make an audio, video, or multimedia recording."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f8797ae-a29d-3e7f-a614-6af8c0f6233f",
                                        "entry_id": "c89acc61-1b46-3c2f-9e53-dac20996dde5",
                                        "glosses": [
                                            "To repeat; to practice."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbd76743-1f7c-3001-bd3f-8e66cdfe632e",
                                        "entry_id": "c89acc61-1b46-3c2f-9e53-dac20996dde5",
                                        "glosses": [
                                            "To sing or repeat a tune."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d92be39-45e1-4a69-8626-fc9a729bfc71",
                                                "sense_id": "fbd76743-1f7c-3001-bd3f-8e66cdfe632e",
                                                "text": "1595, George Peele, The Old Wives’ Tale, The Malone Society Reprints, 1908, lines 741-742,\nCome Berecynthia, let vs in likewise,\nAnd heare the Nightingale record hir notes."
                                            },
                                            {
                                                "example_id": "e028804b-58cc-4f07-bf8f-188dfa026007",
                                                "sense_id": "fbd76743-1f7c-3001-bd3f-8e66cdfe632e",
                                                "text": "They long’d to see the day, to heare the larke\nRecord her hymnes and chant her carols blest,"
                                            },
                                            {
                                                "example_id": "6be7b674-35cd-42e7-8f1f-54d633b67962",
                                                "sense_id": "fbd76743-1f7c-3001-bd3f-8e66cdfe632e",
                                                "text": "[…] to the lute\nShe sung, and made the night-bird mute,\nThat still records with moan;"
                                            },
                                            {
                                                "example_id": "fe6cf0bb-f0d1-4f2f-b1e8-3349bc8a33f3",
                                                "sense_id": "fbd76743-1f7c-3001-bd3f-8e66cdfe632e",
                                                "text": "[…] the Nymph did earnestly contest\nWhether the Birds or she recorded best […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d82890a7-7345-3dac-a28a-55a75a8952d0",
                                        "entry_id": "c89acc61-1b46-3c2f-9e53-dac20996dde5",
                                        "glosses": [
                                            "To reflect; to ponder."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f6f104d-6901-47d7-8c47-1b19a17eb7f0",
                                                "sense_id": "d82890a7-7345-3dac-a28a-55a75a8952d0",
                                                "text": "[…] he was […] carried to the Scaffold on the Tower-hill […], himself praying all the way, and recording upon the words which he before had read."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
