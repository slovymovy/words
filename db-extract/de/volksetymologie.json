                                                "example_id": "1ad36f44-2021-4d10-9a0a-f14a4d8b967e",
                                                "sense_id": "8fad47fc-87cf-39e4-a059-6220aab42e3f",
                                                "text": "Het woord ‘kapoen’ stamt volgens de volksetymologie af van het oudere kaphan, vergelijkbaar met het 15e eeuwse kaphun of kaphuhn."
                                            }
                                        ]
                                    }
                                ]
                            }
