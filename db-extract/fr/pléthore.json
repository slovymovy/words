        "fr-extract.jsonl": [
            {
                "entry_id": "ce9dca7e-be2d-31a4-bad1-b6785d9ee463",
                "word": "pléthore",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bf4f165e-4d54-4ea1-979a-254e77f3ecb8",
                        "entry_id": "ce9dca7e-be2d-31a4-bad1-b6785d9ee463",
                        "tags": [
                            "plural"
                        ],
                        "form": "pléthores"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc25b844-5ccd-3319-8342-258701063e17",
                        "entry_id": "ce9dca7e-be2d-31a4-bad1-b6785d9ee463",
                        "glosses": [
                            "Surabondance de sang et d’humeurs en ancienne médecine."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "11c63a6b-b5aa-4971-be65-bda9c4bf2715",
                                "sense_id": "fc25b844-5ccd-3319-8342-258701063e17",
                                "text": "Après les pléthores physiologiques et les pléthores morbides, viennent, dans un ordre naturel, les pléthores cachectiques, qui elles-mêmes, à défaut de moyens spécifiques ou directs, ne sont pas sans présenter quelquefois l’indication des émissions sanguines."
                            },
                            {
                                "example_id": "cf4f1bc2-d705-4ad4-94f2-53c145f4bd5b",
                                "sense_id": "fc25b844-5ccd-3319-8342-258701063e17",
                                "text": "L’avenir qu’on peut le plus raisonnablement prévoir, c’est une suite de pléthores et de saignées. Les gens d’église s’enrichiront pendant cinquante ans de paix, et quand les révolutions viendront, on leur prendra leurs biens. Mais ces purgations périodiques violentes sont malsaines."
                            }
                        ]
                    },
                    {
                        "sense_id": "46a2f22f-ed54-329d-abfd-d082e250671d",
                        "entry_id": "ce9dca7e-be2d-31a4-bad1-b6785d9ee463",
                        "glosses": [
                            "Surabondance de quelque chose."
                        ],
                        "tags": [
                            "figuratively",
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "3449382a-aabf-4df1-90b1-6c32dd327359",
                                "sense_id": "46a2f22f-ed54-329d-abfd-d082e250671d",
                                "text": "Il y a pléthore d’argent dans ce pays."
                            },
                            {
                                "example_id": "f5921984-d063-4b69-a412-2adeb05d03b4",
                                "sense_id": "46a2f22f-ed54-329d-abfd-d082e250671d",
                                "text": "Nous déployons dans notre monde moderne une pléthore de stratégies de communication toujours plus sophistiquées."
                            },
                            {
                                "example_id": "ddf32ff6-0e9a-4c1d-a036-c4d2f8ecae9c",
                                "sense_id": "46a2f22f-ed54-329d-abfd-d082e250671d",
                                "text": "Les donneurs de leçons sont pléthore, mais combien, dans l’histoire, jouent véritablement leur peau, pour reprendre le titre de l’essai (Les Belles lettres) fondamental du statisticien Nassim Nicholas Taleb ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e7c98aa-8b2d-4260-9fae-07dc72a4f743",
                        "source_entry_id": "ce9dca7e-be2d-31a4-bad1-b6785d9ee463",
                        "source_sense_description": "Sens à préciser",
                        "target_lang_word": "plethora",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plethora",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dd19acb-35e9-36c3-afef-1225445f3943",
                                        "entry_id": "9ce7a17f-ee66-3512-b540-7d19d4d7790b",
                                        "glosses": [
                                            "An excessive amount or number; an abundance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a46ebdf-33ec-4e3a-944f-7fbc6e726156",
                                                "sense_id": "4dd19acb-35e9-36c3-afef-1225445f3943",
                                                "text": "The menu offers a plethora of cuisines from around the world."
                                            },
                                            {
                                                "example_id": "6fee6c67-5f32-4509-abbd-fabb549fb88d",
                                                "sense_id": "4dd19acb-35e9-36c3-afef-1225445f3943",
                                                "text": "1817, Francis Jeffrey, review of Lalla Rookh, in the Edinburgh Review\nHe labours under a plethora of wit and imagination."
                                            },
                                            {
                                                "example_id": "4f048541-d6eb-40a7-ac84-c75b492817e1",
                                                "sense_id": "4dd19acb-35e9-36c3-afef-1225445f3943",
                                                "text": "I pushed my seat right up before the most insolent gazer, a short fat man, with a plethora of cravat round his neck, and fixing my gaze on his, gave him more gazes than he sent."
                                            },
                                            {
                                                "example_id": "2fa80d33-47d6-4948-9680-c872dec7a449",
                                                "sense_id": "4dd19acb-35e9-36c3-afef-1225445f3943",
                                                "text": "Meanwhile other hands had not been idle, so that above the dreary plethora of trash like Marquis von Grosse's Horrid Mysteries..., there arose many memorable weird works both in English and German."
                                            },
                                            {
                                                "example_id": "98d0540f-bac3-4e2b-b896-1dda36c5af47",
                                                "sense_id": "4dd19acb-35e9-36c3-afef-1225445f3943",
                                                "text": "Jefe: We have many beautiful piñatas for your birthday celebration, each one filled with little surprises!\nEl Guapo: How many piñatas?\nJefe: Many piñatas, many!\nEl Guapo: Jefe, would you say I have a plethora of piñatas?\nJefe: A what?\nEl Guapo: A plethora."
                                            },
                                            {
                                                "example_id": "b6a9da11-01cb-404c-84a5-9e9a3af2b30d",
                                                "sense_id": "4dd19acb-35e9-36c3-afef-1225445f3943",
                                                "text": "The story of the woodhen is one outstanding conservation triumph in a plethora of tragedy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb9dad5e-4f17-389f-8464-599045ff3ade",
                                        "entry_id": "9ce7a17f-ee66-3512-b540-7d19d4d7790b",
                                        "glosses": [
                                            "Excess of blood in the skin, especially in the face and especially chronically."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4a01cc2-b63d-40a3-8ce9-3274f1cde27a",
                                                "sense_id": "cb9dad5e-4f17-389f-8464-599045ff3ade",
                                                "text": "[Y]our Character at Present is like a Person in a Plethora, absolutely dying of too much Health—"
                                            },
                                            {
                                                "example_id": "184f8186-0d52-4492-b28c-0e79bb0fa262",
                                                "sense_id": "cb9dad5e-4f17-389f-8464-599045ff3ade",
                                                "text": "The food necessary for the maintenance of his dog, a bull-terrier, in the condition of ferocious plethora to which it was accustomed, he generously declared himself willing to pay for out of his own pocket, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
