                                        "examples": [
                                            {
                                                "example_id": "9b9bf9fc-d6d7-49af-9c0d-ecca2f92238f",
                                                "sense_id": "437c4a1c-61bd-3c69-bf99-0948f8f82270",
                                                "text": "Здесь помещен очерк о Воронеже — посёлке городского типа Шосткинского района."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b02a704-6dca-36fb-8e49-f8598ececa76",
                                        "entry_id": "fbe027da-0c4e-38e6-959c-7cbd4f07f704",
                                        "glosses": [
                                            "посёлок в Алтайском крае России"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91677ffb-9b4f-4420-a541-5d66c81702ed",
                                                "sense_id": "9b02a704-6dca-36fb-8e49-f8598ececa76",
                                                "text": "Посёлок Воронеж входит в состав Карамышевского сельсовета Змеиногорского района."
