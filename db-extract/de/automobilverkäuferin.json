                "senses": [
                    {
                        "sense_id": "4dabf195-6653-3d07-b6fd-add9ee3c6911",
                        "entry_id": "b8116a23-ad75-3e7a-8791-421bc6cda433",
                        "glosses": [
                            "weibliche Person, die mit Autos handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a53d467e-51ad-43a6-95e9-c871e5505c0d",
                                "sense_id": "4dabf195-6653-3d07-b6fd-add9ee3c6911",
                                "text": "„Technische Aspekte der Automobilproduktion und des Reparaturgeschäfts lassen sich nach Aussage aller Frauen, die im Laufe ihrer Karriere einmal als Automobilverkäuferin gearbeitet haben, durchaus in der Praxis erlernen.“"
                            },
                            {
                                "example_id": "50082370-6368-4cc8-828c-ed5c487a6faf",
                                "sense_id": "4dabf195-6653-3d07-b6fd-add9ee3c6911",
                                "text": "„Doch erst der Besuch der selbstsicheren Automobilverkäuferin Magda bringt eine Wende in Pauls Leben.“"
                            },
                            {
                                "example_id": "5f6a5c74-34fc-4ca5-b4ae-3e4127782f3e",
                                "sense_id": "4dabf195-6653-3d07-b6fd-add9ee3c6911",
                                "text": "„Während ihrer Ausbildung nahm sie erfolgreich an einer Ausbildung zur zertifizierten und geprüften Automobilverkäuferin teil.“"
                            },
                            {
                                "example_id": "93203358-6484-4fa3-9ecd-12d47e66e383",
                                "sense_id": "4dabf195-6653-3d07-b6fd-add9ee3c6911",
                                "text": "„Die neue Automobilverkäuferin Bertha, die den ausgeschiedenen Kollegen Anton ersetzen soll, kommt aus der Großstadt – wie hier aus Berlin –, die über eine ausgezeichnete Infrastruktur verfügt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
