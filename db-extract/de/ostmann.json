                ],
                "senses": [
                    {
                        "sense_id": "151282d9-39e9-3a66-8bb7-8179f0403340",
                        "entry_id": "25180943-cc10-3fc0-8898-eed877ecf218",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "778be3f1-9da7-46db-b3c3-a016068b0e3a",
                                "sense_id": "151282d9-39e9-3a66-8bb7-8179f0403340",
                                "text": "Ostmanns kamen, sahen und siegten."
                            },
                            {
                                "example_id": "3a226b62-572f-4025-85c2-92c198f4bfe0",
                                "sense_id": "151282d9-39e9-3a66-8bb7-8179f0403340",
                                "text": "Ostmann kommt und geht."
                            },
                            {
                                "example_id": "61f97ddf-f30b-4534-a2d7-47c337e76ab5",
                                "sense_id": "151282d9-39e9-3a66-8bb7-8179f0403340",
                                "text": "Frau Ostmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6bb4bd68-f969-4113-a988-01d6be81437f",
                                "sense_id": "151282d9-39e9-3a66-8bb7-8179f0403340",
                                "text": "Herr Ostmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "01f0b2ad-11d1-4a40-a4c8-9f3c05d67054",
                                "sense_id": "151282d9-39e9-3a66-8bb7-8179f0403340",
                                "text": "Die Ostmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a1727616-7fa9-4c7f-9135-8749aa5449e9",
                                "sense_id": "151282d9-39e9-3a66-8bb7-8179f0403340",
                                "text": "Der Ostmann trägt nie die Schals, die die Ostmann ihm strickt."
                            },
                            {
                                "example_id": "d1f85cbe-b338-4b7b-bad4-d85d6d1b78c0",
                                "sense_id": "151282d9-39e9-3a66-8bb7-8179f0403340",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ostmann kommt, geht der Herr Ostmann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
