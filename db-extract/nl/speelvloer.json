                            {
                                "example_id": "262f7344-433e-4640-b3a8-4426be0bb6f6",
                                "sense_id": "2dfb07d4-d019-3a7b-8623-f9c7f2cd7c64",
                                "text": "Of een stuk van Dürrenmatt over de laatste Romeinse keizer die zich liever bezighoudt met zijn eigen beslommeringen dan die van het volk. De theaters zitten bomvol, tot op de trappen en de speelvloer zitten rijendik toeschouwers die haarfijn aanvoelen wat de maker probeert te zeggen."
                            }
                        ]
                    },
