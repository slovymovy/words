                "senses": [
                    {
                        "sense_id": "b725dd61-4ee7-3baa-b74c-55b9a32d5290",
                        "entry_id": "f962454b-dc5d-33d2-9beb-176fc0b3d315",
                        "glosses": [
                            "Effrayer."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "dacbfe73-e2ca-4b9b-bde1-bf6f00f1de82",
                                "sense_id": "b725dd61-4ee7-3baa-b74c-55b9a32d5290",
                                "text": "Il est bien entendu que dessous … c'est le vide. (A la limite de s'encorder tout de même : ça épouaire !"
                            },
                            {
                                "example_id": "4b6be3c3-6083-45ba-b117-4910e959c943",
                                "sense_id": "b725dd61-4ee7-3baa-b74c-55b9a32d5290",
                                "text": "Si vous êtes \"épouairé\" (effrayé) ou si vous êtes sur le \"balan\" (l'hésitation), dites-vous que c'est la meilleure opportunité depuis bien longtemps !"
                            },
                            {
                                "example_id": "9022421e-da0a-4ccc-89dc-e1e8abec8ac0",
                                "sense_id": "b725dd61-4ee7-3baa-b74c-55b9a32d5290",
                                "text": "Au pays du papet et des molachus, on ne va pas s'épouairer pour rien."
                            }
                        ]
                    }
