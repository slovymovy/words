                ],
                "senses": [
                    {
                        "sense_id": "f3331aae-dc27-3f82-9df6-a4c97adb452b",
                        "entry_id": "17d91a00-2976-337a-a34f-3e5f2dabddfa",
                        "glosses": [
                            "Utiliser le corps physique d’un disciple, généralement un initié de niveau assez élevé, avec son plein accord conscient, afin de transmettre les enseignements spirituels de haut niveau, nécessaires au développement moral futur de l’humanité."
                        ],
                        "tags": [
                            "Théosophie"
                        ],
                        "examples": [
                            {
                                "example_id": "2338389a-a5bc-4014-9836-4881b37253cb",
                                "sense_id": "f3331aae-dc27-3f82-9df6-a4c97adb452b",
                                "text": "Une autre version voit l’entité spirituelle Christ « adombrer » l’homme Jésus."
                            },
                            {
                                "example_id": "0a6c917e-50da-47bb-b8aa-e474d3f1fe79",
                                "sense_id": "f3331aae-dc27-3f82-9df6-a4c97adb452b",
                                "text": "Marie n’est alors, pour les tenants de la religion dualiste, que le « moyen » qui permit au Christ, ange divin, de s’adombrer."
                            }
                        ]
                    }
                ],
