                                "target_senses": [
                                    {
                                        "sense_id": "f1b3332e-4429-3fa6-9d85-ae50db1a4830",
                                        "entry_id": "aeb98bc7-3d67-3347-a800-dfacc14ecd22",
                                        "glosses": [
                                            "Non-Oxford British English standard spelling of industrialization."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f21f557c-6ca8-4081-9af8-a2bfb8dea570",
                                                "sense_id": "f1b3332e-4429-3fa6-9d85-ae50db1a4830",
                                                "text": "The great industrialisations of the Midlands, north and Scotland that gave birth to large-scale organised Labour passed most of southern England by."
                                            },
                                            {
                                                "example_id": "4e5c0114-0e01-43d5-8f56-7df479ad8d5b",
                                                "sense_id": "f1b3332e-4429-3fa6-9d85-ae50db1a4830",
                                                "text": "It gave me more of a Cormac McCarthy vibe than a Westworld one, hinting at the death of the old west, the consequences of America’s rapid industrialisation and the death of a way of life, rather than a straightforward romanticisation of the frontier and its outlaw heroes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
