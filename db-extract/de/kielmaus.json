                ],
                "senses": [
                    {
                        "sense_id": "aa71ed38-d80e-376d-836c-ae452cfb5ffc",
                        "entry_id": "d9fd2327-3888-35b3-a541-f241b288226f",
                        "glosses": [
                            "Person – oft ein erfahrener Wassersportler –, die im vorderen Bereich eines Schlauchboots liegt, um es für die meist sehr jungen Fahrer zu stabilisieren und bei Problemfällen eingreifen zu können; Begleitperson bei einem Rennen mit Schlauchbooten"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1a732f14-6103-426d-a876-f0d19391370c",
                                "sense_id": "aa71ed38-d80e-376d-836c-ae452cfb5ffc",
                                "text": "„Allein ist Jana bei keiner Fahrt, auch wenn es so scheint. Immer liegt eine Begleitperson vorn im Boot, die sogenannte Kielmaus.“"
                            },
                            {
                                "example_id": "7b908df6-3507-4951-8091-9cc6f6d84556",
                                "sense_id": "aa71ed38-d80e-376d-836c-ae452cfb5ffc",
                                "text": "„Als Kielmaus wird die Begleitperson bezeichnet, die bis zur Klasse 3 vorgeschrieben ist.“"
                            },
                            {
                                "example_id": "fad75ba2-0316-476f-8288-d6407783be6c",
                                "sense_id": "aa71ed38-d80e-376d-836c-ae452cfb5ffc",
                                "text": "„Papa René Simon ist stolz auf seine Tochter, die nur von einer „Kielmaus“ im Bug begleitet mit dem Sechs-PS-Außenborder geschickt die Bojen umkurvt, Schikanen meistert und wie „ein alter Hase“ am Anlegesteg festmacht.“"
                            },
                            {
                                "example_id": "b7c277c8-3c02-4f38-9e14-ba72ceb6b214",
                                "sense_id": "aa71ed38-d80e-376d-836c-ae452cfb5ffc",
                                "text": "„Seil, Schwimmweste, Kielmaus und Boot bekommt man zur Verfügung gestellt.“"
                            },
                            {
                                "example_id": "9d0c06cc-28d4-4196-a03c-1ed30ca7835b",
                                "sense_id": "aa71ed38-d80e-376d-836c-ae452cfb5ffc",
                                "text": "„Die „Kielmäuse“ gehen zu ihren Booten, weil in den kleinen Klassen ein erfahrener Pilot zur Sicherheit für die Fahrer im Boot sein muss.“"
                            },
                            {
                                "example_id": "10e4faa4-dfd2-485d-9929-a86116ea6c36",
                                "sense_id": "aa71ed38-d80e-376d-836c-ae452cfb5ffc",
                                "text": "„Inhalte der Schulung waren u.a., die Erörterung des Reglements der Deutschen Jugendmeisterschaft, Platzierung und Ausstattung der Bojenbeobachter, die Aufgaben, die Wettkampfrichter im Einzelnen haben und last, but not least die Funktion der Begleitperson im Boot - auch als Kielmaus bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
