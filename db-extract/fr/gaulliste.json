            {
                "entry_id": "cd787fc2-9f21-3ac6-8a12-dc65fd370e48",
                "word": "gaulliste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "957c1d9e-af8c-495b-adff-11d1571c6e9e",
                        "entry_id": "cd787fc2-9f21-3ac6-8a12-dc65fd370e48",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "gaullistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4522c04e-f325-392b-b90f-9651cfff76fc",
                        "entry_id": "cd787fc2-9f21-3ac6-8a12-dc65fd370e48",
                        "glosses": [
                            "Partisan de Charles de Gaulle ou du gaullisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14e9a92c-bda5-4dfe-809d-f62cc0194559",
                                "sense_id": "4522c04e-f325-392b-b90f-9651cfff76fc",
                                "text": "Celui-ci réunissait un échantillon de députés de tous bords, allant de gaullistes proarabes comme Daniel Garrigue et Patrick Ollier à des socialistes proches des thèses laïques du régime irakien tel Jean-Pierre Chevènement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2d705f7-b11c-414b-b60f-fb0060bf8e96",
                        "source_entry_id": "cd787fc2-9f21-3ac6-8a12-dc65fd370e48",
                        "source_sense_id": "4522c04e-f325-392b-b90f-9651cfff76fc",
                        "target_lang_word": "Gaullist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gaullist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9330a93-5df7-30fb-81e8-e54d36f4e259",
                                        "entry_id": "beb37cb0-3f4e-3654-b695-f68d02441d54",
                                        "glosses": [
                                            "Anhänger des Gaullismus (politische Bewegung, die die Ideen von General Charles de Gaulle vertritt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca74c2b-a448-45c8-82dd-611a09771f9c",
                                                "sense_id": "a9330a93-5df7-30fb-81e8-e54d36f4e259",
                                                "text": "[Über Charles de Gaulle] „Paradoxerweise blieb er aber in keiner seiner großen historischen Rollen unumstritten. Vielmehr provozierte er wiederholt erbitterte Gegnerschaft und spaltete das Land in Gaullisten und Anti-Gaullisten.“"
                                            },
                                            {
                                                "example_id": "852fe222-40f0-468a-9c11-bcd76c7d9b56",
                                                "sense_id": "a9330a93-5df7-30fb-81e8-e54d36f4e259",
                                                "text": "„Die nach den französischen Parlamentswahlen von 1951 erstarkten Gaullisten fürchteten um die nationale Souveränität Frankreichs.“"
                                            },
                                            {
                                                "example_id": "59db037c-8560-4151-a528-cd1c31869760",
                                                "sense_id": "a9330a93-5df7-30fb-81e8-e54d36f4e259",
                                                "text": "„Allerdings ging die Initiative von einem Konservativen aus: dem französischen Präsidenten Jacques Chirac (Gaullist).“"
                                            },
                                            {
                                                "example_id": "9d6d4bd4-7702-4b61-82e5-d06dfec75e7b",
                                                "sense_id": "a9330a93-5df7-30fb-81e8-e54d36f4e259",
                                                "text": "„Auf den handküssenden, stolzen Gaullisten Jacques Chirac folgte der nervöse Selbstdarsteller Nicolas Sarkozy.“"
                                            },
                                            {
                                                "example_id": "1449f445-7d46-443b-8541-55fd41f8e65a",
                                                "sense_id": "a9330a93-5df7-30fb-81e8-e54d36f4e259",
                                                "text": "[Über Jacques Chirac] „Der konservative, zutiefst bodenständige Gaullist war nahbar, menschlich und mitfühlend.“"
                                            },
                                            {
                                                "example_id": "84669055-f513-4253-a7e2-69be4858c0eb",
                                                "sense_id": "a9330a93-5df7-30fb-81e8-e54d36f4e259",
                                                "text": "„Allerdings war es auch stets ein offenes Geheimnis, dass die Gaullisten von finanzieller Zuwendung der Maghrebstaaten profitierten.“"
                                            },
                                            {
                                                "example_id": "d44ae09a-0850-410b-9174-916fd7af32da",
                                                "sense_id": "a9330a93-5df7-30fb-81e8-e54d36f4e259",
                                                "text": "„Während die Parteidisziplin bei den Sozialisten Mehrfachkandidaturen verhinderte, gab es aus den Reihen der Gaullisten mehrmals mehrere Kandidaten, ohne dass deswegen aber Parteiausschlussverfahren eingeleitet worden wären.“"
                                            },
                                            {
                                                "example_id": "ae8ed4fb-6795-43c4-8079-efe23717e04f",
                                                "sense_id": "a9330a93-5df7-30fb-81e8-e54d36f4e259",
                                                "text": "„Nach seinem Rücktritt als Ministerpräsident Frankreichs wurde er 1963 Abgeordneter von La Réunion. In einer von Manipulationsvorwürfen überschatteten Wahl hatte der Gaullist Debré, der keinerlei familiäre Beziehungen zu der Insel hatte, Paul Vergès ausgestochen, den Vorsitzenden der Kommunistischen Partei von La Réunion, der für die Unabhängigkeit der Insel eintrat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "227a8852-a2f8-30aa-b155-f6de90518cf8",
                                        "entry_id": "beb37cb0-3f4e-3654-b695-f68d02441d54",
                                        "glosses": [
                                            "deutscher Politiker (meist der Parteien CDU und CSU), der eine politisch engere Kooperation mit Frankreich (im Gegensatz zu einer engen Kooperation mit den USA) Ende der 1950er und in den 1960er Jahren anstrebte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a539f36e-5b47-4fbc-8879-dd811283fbe6",
                                                "sense_id": "227a8852-a2f8-30aa-b155-f6de90518cf8",
                                                "text": "„Die innenpolitische Auseinandersetzung zwischen \"Atlantikern\" und \"Gaullisten\" brach 1963 im Zuge der Ratifizierung des Elysée-Vertrags endgültig auf.“"
                                            },
                                            {
                                                "example_id": "398568d7-41ad-4f0f-8d3c-07ee42e0fc03",
                                                "sense_id": "227a8852-a2f8-30aa-b155-f6de90518cf8",
                                                "text": "„Die Unionsparteien zerfielen zwischenzeitlich in zwei Lager, auf der einen Seite die \"Gaullisten\", zu denen neben Adenauer auch Franz Josef Strauß gehörte; auf der anderen Seite die \"Atlantiker\" mit Ludwig Erhard und Gerhard Schröder an der Spitze, die eher eine privilegierte Beziehung mit den USA befürworteten.“"
                                            },
                                            {
                                                "example_id": "2adeac9f-b551-444a-b04f-af34cf174ace",
                                                "sense_id": "227a8852-a2f8-30aa-b155-f6de90518cf8",
                                                "text": "„Mit Frankreichs Rückzug aus den Verteidigungsstrukturen der NATO im Laufe des Jahres 1966 erreichte schließlich auch der innenpolitische Konflikt in der Bundesrepublik zwischen Atlantikern und Gaullisten seinen Höhepunkt.“"
                                            },
                                            {
                                                "example_id": "a35fa2bc-154d-4a35-b9ce-330189c4938b",
                                                "sense_id": "227a8852-a2f8-30aa-b155-f6de90518cf8",
                                                "text": "„Im Gegensatz zur Vorgängerregierung konnte die Große Koalition den alten Konflikt zwischen Atlantikern und Gaullisten vermeiden.“"
                                            },
                                            {
                                                "example_id": "ce22b824-7cd3-4f2e-a086-33529cf67ecb",
                                                "sense_id": "227a8852-a2f8-30aa-b155-f6de90518cf8",
                                                "text": "„Nach diesem diplomatischen Kraftakt de Gaulles plädierten auch die Bonner Gaullisten alsbald für Beziehungen mit Rot-China.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
