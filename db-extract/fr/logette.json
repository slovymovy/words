        "fr-extract.jsonl": [
            {
                "entry_id": "9b5e4e80-da2f-3c9a-bc2f-85a252da7979",
                "word": "logette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "85ded764-281e-4a74-91c8-8048b95f55ec",
                        "entry_id": "9b5e4e80-da2f-3c9a-bc2f-85a252da7979",
                        "tags": [
                            "plural"
                        ],
                        "form": "logettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aab83390-73cf-39e7-9480-23221a445fff",
                        "entry_id": "9b5e4e80-da2f-3c9a-bc2f-85a252da7979",
                        "glosses": [
                            "Petite loge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba45f535-c4a3-4f13-8ffd-b625343ecd23",
                                "sense_id": "aab83390-73cf-39e7-9480-23221a445fff",
                                "text": "Oh ! chante-moi ta chanson de chaque soir dans ta logette de cendre et de suie […]"
                            },
                            {
                                "example_id": "574ffb4e-f10f-4299-b503-d9668934202b",
                                "sense_id": "aab83390-73cf-39e7-9480-23221a445fff",
                                "text": "Sigognac ayant, avec l’aide de Blazius, achevé de s’habiller en la logette du jeu de paume réservée aux comédiens, rentra dans la chambre des actrices pour attendre que la répétition commençât."
                            },
                            {
                                "example_id": "02c1478c-b5f7-4c15-9af1-3195efa2e99f",
                                "sense_id": "aab83390-73cf-39e7-9480-23221a445fff",
                                "text": "À onze heures en été, à dix heures en hiver, on fermait ces portes à double tour. La ville, après avoir ainsi poussé les verrous comme une fille peureuse, dormait tranquille. Un gardien, qui habitait une logette placée dans un des angles intérieurs de chaque portail, avait charge d’ouvrir aux personnes attardées."
                            },
                            {
                                "example_id": "ba3e14ba-2e0e-409a-bced-ffe688f8f83d",
                                "sense_id": "aab83390-73cf-39e7-9480-23221a445fff",
                                "text": "Popof n’est point en ce moment au fond de sa logette. La porte du fourgon de bagages étant ouverte, j’en conclus que notre chef de train est allé parler au mécanicien."
                            },
                            {
                                "example_id": "bacf714f-2ce0-4bdd-bf09-99e26cfad9e7",
                                "sense_id": "aab83390-73cf-39e7-9480-23221a445fff",
                                "text": "Quittant ma tanière enfantine — une ancienne logette de portier à grosses poutres, carrelée, suspendue au-dessus de l’entrée cochère et commandée par la chambre à coucher de ma mère — je dormais, depuis un mois, dans ce lit que je n’avais osé convoiter"
                            }
                        ]
                    },
                    {
                        "sense_id": "06934f9a-d04b-36c1-80f2-cd1598a4ad4c",
                        "entry_id": "9b5e4e80-da2f-3c9a-bc2f-85a252da7979",
                        "glosses": [
                            "Petit compartiment destiné à accueillir une personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c2fc3fc-feb7-4592-9d20-002ad792d143",
                                "sense_id": "06934f9a-d04b-36c1-80f2-cd1598a4ad4c",
                                "text": "Tantôt croyant voir qu’une main lui faisait signe au fond du confessionnal, tantôt ne découvrant plus dans la logette qu’une stalle vide, il attendit longtemps."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e67afda-0b65-3c64-bfcc-a1b7309d881d",
                        "entry_id": "9b5e4e80-da2f-3c9a-bc2f-85a252da7979",
                        "glosses": [
                            "Chacune des petites cavités qui contiennent le pollen dans certaines anthères."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0f3e1d37-c58b-3ad4-b2ad-537cafd1ec61",
                        "entry_id": "9b5e4e80-da2f-3c9a-bc2f-85a252da7979",
                        "glosses": [
                            "Chacune des petites cavités qui contiennent une dose de médicament dans une plaquette pharmaceutique."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "be60019a-812b-490c-a692-5d9fb3a0e45b",
                                "sense_id": "0f3e1d37-c58b-3ad4-b2ad-537cafd1ec61",
                                "text": "Cette plaque dont l’avers de plastique transparent faisait sandwich avec un revers de papier d’étain et laissait voir, dans vingt et une logettes, des pilules roses portant chacune l’indication d’un jour de la semaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "0756ba51-64df-3cc3-9e56-282a753ba6fc",
                        "entry_id": "9b5e4e80-da2f-3c9a-bc2f-85a252da7979",
                        "glosses": [
                            "Petite loge prévue pour que des animaux (poules, vaches, notamment) puissent s’y installer."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "4dc8eedc-0765-4624-927f-cd0ac26bd740",
                                "sense_id": "0756ba51-64df-3cc3-9e56-282a753ba6fc",
                                "text": "En ce qui concerne le temps de travail, il a bien diminué : il fallait compter 1 h de paillage et raclage chaque jour, contre 30 minutes aujourd’hui pour passer la raclette matin et soir sur les logettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd78e7b1-469f-3feb-95f8-97002f19e314",
                        "entry_id": "9b5e4e80-da2f-3c9a-bc2f-85a252da7979",
                        "glosses": [
                            "Stalle où sont enfermés les taureaux lors d’une corrida, avant leur entrée dans l’arène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17f263c0-e500-4deb-b9bb-31b9f34f292f",
                                "sense_id": "dd78e7b1-469f-3feb-95f8-97002f19e314",
                                "text": "On nous fit remarquer les logettes qui contiennent les taureaux pendant la course ; ce sont des espèces de cages en grosses poutres, fermées d’une porte qui se lève comme une vanne de moulin ou une bonde d’étang. Pour exciter leur rage, on les harcèle avec des pointes, on les frotte d’acide nitrique ; enfin, on cherche tous les moyens de leur envenimer le caractère."
                            }
                        ]
                    },
                    {
                        "sense_id": "80b75dbf-d9fb-377f-a05b-d18c58a71116",
                        "entry_id": "9b5e4e80-da2f-3c9a-bc2f-85a252da7979",
                        "glosses": [
                            "Oriel, bow-window."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
