                        ],
                        "form": "conviviaux"
                    },
                    {
                        "form_id": "bdd099f1-92ec-45cd-9a09-ac327a5777ee",
                        "entry_id": "31ebead0-9993-335b-bbe3-14e7ff9d3b79",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "conviviale"
                    },
                    {
                        "form_id": "270d684e-c210-48c2-97f9-479aa2a87e6d",
                        "entry_id": "31ebead0-9993-335b-bbe3-14e7ff9d3b79",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "conviviales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4bab0d66-b9e1-397f-b1d7-3110cbaaa469",
                        "entry_id": "31ebead0-9993-335b-bbe3-14e7ff9d3b79",
                        "glosses": [
                            "Qui suscite des relations favorables ou agréables parmi les membres d’un groupe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d180a092-5518-421b-acdc-d7bc25c062c5",
                                "sense_id": "4bab0d66-b9e1-397f-b1d7-3110cbaaa469",
                                "text": "Un lieu de réunion convivial."
                            },
                            {
                                "example_id": "fbb99b50-d933-4268-8ccc-2ae2503699cc",
                                "sense_id": "4bab0d66-b9e1-397f-b1d7-3110cbaaa469",
                                "text": "L’homme était convivial et sympathique."
                            },
                            {
                                "example_id": "66fcfcad-0fbb-46f1-888c-246272d68d16",
                                "sense_id": "4bab0d66-b9e1-397f-b1d7-3110cbaaa469",
                                "text": "À l’heure actuelle, la science disponible – les études se comptent par centaines – n’a fourni aucune preuve que ces politiques transforment les milieux de travail pour les rendre plus conviviaux, plus accueillants, plus bienveillants, plus productifs, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c3705bf-4151-3922-affd-c6a18f5277b2",
                        "entry_id": "31ebead0-9993-335b-bbe3-14e7ff9d3b79",
                        "glosses": [
                            "Relatif au repas, au festin."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0172255f-b5ad-37ac-b296-7c0c5c4d4c6d",
                        "entry_id": "31ebead0-9993-335b-bbe3-14e7ff9d3b79",
                        "glosses": [
                            "Chaleureux, dans l’esprit d’une réunion festive."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "7a26e15c-ecd6-4ee6-aa9a-255fd91fdbb6",
                                "sense_id": "0172255f-b5ad-37ac-b296-7c0c5c4d4c6d",
                                "text": "La décoration également, raffinée et l’atmosphère y est conviviale autour de cocktails connus et reconnus comme un dry Martini, un daïquiri, une margarita, un bloody-mary, un cuba-libre, une piña-colada…, mais aussi des cocktails sans alcool, un apéritif classique avec une très intéressante carte de chiskies et de champagnes."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0c92a13-a8dc-35b0-b55d-9d7e92df1afe",
                        "entry_id": "31ebead0-9993-335b-bbe3-14e7ff9d3b79",
                        "glosses": [
                            "D’utilisation pratique et intuitive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ae1d7cf-6bfb-4f69-b89e-6abd75d083d7",
                                "sense_id": "b0c92a13-a8dc-35b0-b55d-9d7e92df1afe",
                                "text": "L'utilisation de cette application est conviviale."
                            }
                        ]
                    },
                    {
                        "sense_id": "cde20556-15f9-3da1-8c1d-491390d0572e",
                        "entry_id": "31ebead0-9993-335b-bbe3-14e7ff9d3b79",
                        "glosses": [
                            "Se disant d’un outil en particulier, selon Ivan Illich, au service de l’être humain, adapté à la nature humaine, à dimension humaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2869cb72-6e77-4ed0-a75f-a018129a9723",
                                "sense_id": "cde20556-15f9-3da1-8c1d-491390d0572e",
                                "text": "Le vélo est un véhicule convivial car il émancipe plus qu’il ne rend dépendant d'un ensemble de déterminants, contrairement à l'automobile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65b59def-1ba6-41ee-a1d5-73b9327f8aa6",
                        "source_entry_id": "31ebead0-9993-335b-bbe3-14e7ff9d3b79",
                        "source_sense_id": "4bab0d66-b9e1-397f-b1d7-3110cbaaa469",
