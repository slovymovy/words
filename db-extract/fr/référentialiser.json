                ],
                "senses": [
                    {
                        "sense_id": "b5d8a3ab-f89a-3e31-871e-e6f2398f8c78",
                        "entry_id": "d142fb10-e502-34bf-a9cd-13b048f76481",
                        "glosses": [
                            "Doter d’un référentiel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c21a0102-6490-43d6-9774-ac9ed2b9d445",
                                "sense_id": "b5d8a3ab-f89a-3e31-871e-e6f2398f8c78",
                                "text": "La fiction se trouve déchargée, pour une part, de l’obligation de référentialiser les faits et gestes qu’elle agence."
                            },
                            {
                                "example_id": "d4ce9254-3e0c-435a-ba19-64144eb5570f",
                                "sense_id": "b5d8a3ab-f89a-3e31-871e-e6f2398f8c78",
                                "text": "Pour une raison bien élémentaire: c’est que derrière le signe musical, on ne pressent aucunement la menace d’un objet extérieur qui viendrait dyadiser ou référentialiser le signe."
                            },
                            {
                                "example_id": "a21e019b-0f1b-4895-bb7a-b89dd18fa327",
                                "sense_id": "b5d8a3ab-f89a-3e31-871e-e6f2398f8c78",
                                "text": "L'enfant doit pouvoir référentialiser un plan et effectuer des jugements d'ordre sur des séquences de sons non verbaux et verbaux."
                            }
                        ]
                    }
                ],
