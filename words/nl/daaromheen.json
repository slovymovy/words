{
    "word_family": [
        "omheen",
        "eromheen",
        "hieromheen",
        "waaromheen"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2250b87d-0fc6-3fd6-bab7-ad5b696eeb02",
                    "sense_definition": "Rondom datgene; in de ruimte of het gebied om die specifieke plaats of dat object heen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ruimtelijke_positie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen ze bij het kasteel kwamen liepen ze <w>daaromheen</w> om de poort te zoeken.",
                            "target_lang_translations": {
                                "en": "When they reached the castle, they walked <w>around it</w> to look for the gate."
                            }
                        },
                        {
                            "text": "Wij bezochten de grote stad en alle kleine dorpen <w>daaromheen</w>.",
                            "target_lang_translations": {
                                "en": "We visited the big city and all the small villages <w>around there</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "eromheen",
                        "rondom"
                    ],
                    "common_phrases": [
                        "de dorpen daaromheen",
                        "een weg daaromheen"
                    ],
                    "target_lang_definitions": {
                        "en": "Around that; in the space or area surrounding that specific place or object."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "around it",
                                "target_lang_sense_clarification": "surrounding a specific object or place"
                            },
                            {
                                "target_lang_word": "around there",
                                "target_lang_sense_clarification": "in the surrounding area"
                            },
                            {
                                "target_lang_word": "thereabouts",
                                "target_lang_sense_clarification": "near that place"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2326a9e1-1869-3332-b37a-24c21a9618fe",
                    "sense_definition": "Voornaamwoordelijk bijwoord gevormd uit de combinatie van het aanwijzend voornaamwoord dat en het voorzetsel <w>omheen</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammaticale_vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er staat een groot hek en je kunt niet gemakkelijk <w>daaromheen</w> lopen.",
                            "target_lang_translations": {
                                "en": "There is a large fence and you cannot easily walk <w>around it</w>."
                            }
                        },
                        {
                            "text": "Het probleem is complex, maar we kunnen niet <w>daaromheen</w> werken.",
                            "target_lang_translations": {
                                "en": "The problem is complex, but we cannot work <w>around that</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "pronominal adverb"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Pronominal adverb formed from the combination of the demonstrative pronoun 'dat' (that) and the preposition 'omheen' (around)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "around it",
                                "target_lang_sense_clarification": "circumventing or bypassing something"
                            },
                            {
                                "target_lang_word": "around that",
                                "target_lang_sense_clarification": "getting around a problem or obstacle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}