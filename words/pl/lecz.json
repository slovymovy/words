            "senses": [
                {
                    "sense_id": "6f46e4c0-4ecf-3bee-afe9-63afe0365aa0",
                    "sense_definition": "Spójnik łączący zdania lub części zdania o przeciwstawnym znaczeniu, wprowadzający treść ograniczającą lub korygującą; synonim słowa \"ale\", często używany w języku pisanym.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chciałbym ci pomóc, <w>lecz</w> nie mam teraz czasu.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы тебе помочь, <w>но</w> у меня сейчас нет времени.",
                                "en": "I would like to help you, <w>but</w> I don't have time right now.",
                                "nl": "Ik zou je graag willen helpen, <w>maar</w> ik heb nu geen tijd.",
                                "de": "Ich würde dir gerne helfen, <w>aber</w> ich habe jetzt keine Zeit.",
                                "fr": "J'aimerais t'aider, <w>mais</w> je n'ai pas le temps maintenant.",
                                "it": "Vorrei aiutarti, <w>ma</w> non ho tempo adesso.",
                                "cs": "Chtěl bych ti pomoci, <w>ale</w> nemám teď čas.",
                                "tr": "Sana yardım etmek isterdim <w>ama</w> şu an vaktim yok.",
                                "es": "Me gustaría ayudarte, <w>pero</w> no tengo tiempo ahora.",
                                "zh": "我想帮你，<w>但是</w>我现在没时间。"
                            }
                        },
                        {
                            "text": "To zadanie jest trudne, <w>lecz</w> możliwe do wykonania.",
                            "target_lang_translations": {
                                "ru": "Это задание трудное, <w>однако</w> выполнимое.",
                                "en": "This task is difficult, <w>however</w> it is possible to complete.",
                                "nl": "Deze taak is moeilijk, <w>echter</w> uitvoerbaar.",
                                "de": "Diese Aufgabe ist schwierig, <w>jedoch</w> machbar.",
                                "fr": "Cette tâche est difficile, <w>cependant</w> réalisable.",
                                "it": "Questo compito è difficile, <w>tuttavia</w> possibile da eseguire.",
                                "cs": "Tento úkol je těžký, <w>však</w> proveditelný.",
                                "tr": "Bu görev zor <w>fakat</w> yapılabilir.",
                                "es": "Esta tarea es difícil, <w>sin embargo</w> es posible realizarla.",
                                "zh": "这项任务很难，<w>然而</w>是可以完成的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ale",
                        "jednak",
                        "jednakże",
                        "natomiast",
                        "zaś"
                    ],
                    "common_phrases": [
                        "wolno, lecz pewnie",
                        "mały, lecz ważny",
                        "smutny, lecz prawdziwy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Союз, соединяющий предложения или части предложения с противоположным значением, вводящий ограничивающее или корректирующее содержание; синоним слова \"ale\" (но), часто используется в письменной речи.",
                        "en": "A conjunction used to connect sentences or parts of sentences with contrasting meanings, introducing a limiting or corrective thought; a synonym for 'but', often used in written language.",
                        "nl": "Voegwoord dat zinnen of zinsdelen met een tegenstellende betekenis verbindt; een synoniem voor 'maar', vaak gebruikt in geschreven taal.",
                        "de": "Eine Konjunktion, die Sätze oder Satzteile mit gegensätzlicher Bedeutung verbindet; ein Synonym für 'aber', das häufig in der Schriftsprache verwendet wird.",
                        "fr": "Conjonction de coordination utilisée pour introduire une opposition ou une restriction, équivalente à \"mais\".",
                        "it": "Congiunzione che unisce frasi o parti di frasi con significato opposto, introducendo un contenuto limitativo o correttivo; sinonimo di \"ale\" (ma), spesso usato nel linguaggio scritto.",
                        "cs": "Spojka spojující věty nebo části vět s protikladným významem, uvádějící omezující nebo opravný obsah; synonymum slova \"ale\", často používané v psaném projevu.",
                        "tr": "Cümleleri veya cümle parçalarını karşıt anlamla birleştiren, sınırlayıcı veya düzeltici bir içerik sunan bağlaç; 'ale' (ama/fakat) kelimesinin eş anlamlısı olup genellikle yazılı dilde kullanılır.",
                        "es": "Conjunción que une oraciones o partes de una oración con significado opuesto, introduciendo un contenido limitativo o correctivo; sinónimo de \"pero\", usado a menudo en el lenguaje escrito.",
                        "zh": "用于连接意义相反的句子或句子成分，表示转折或限制的连词；常用于书面语，相当于“但是”。"
                    },
