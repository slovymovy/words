{
    "word_family": [
        "squeezer",
        "squeezable",
        "unsqueezed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae30d8c0-4527-39dd-a60d-f52e112bb35e",
                    "sense_definition": "To apply pressure to something from two or more sides at once, often to change its shape or extract liquid.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_pressure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>squeeze</w> the lemon to get all the juice out for the recipe.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит <w>выжать</w> лимон, чтобы получить весь сок для рецепта.",
                                "zh": "你应该把柠檬<w>挤</w>一下，把做菜用的汁水全部取出来。"
                            }
                        },
                        {
                            "text": "Please do not <w>squeeze</w> the toothpaste tube in the middle because it makes a mess.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>сдавливай</w> тюбик зубной пасты посередине, иначе получится беспорядок.",
                                "zh": "请不要从中间<w>挤</w>牙膏，那样会弄得很乱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compress",
                        "condense"
                    ],
                    "antonyms": [
                        "expand",
                        "stretch"
                    ],
                    "common_phrases": [
                        "squeeze a lemon",
                        "squeeze the trigger",
                        "squeeze out liquid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сжимать что-либо с двух или более сторон, часто чтобы изменить форму или извлечь жидкость.",
                        "zh": "施加压力以改变形状或提取液体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжимать",
                                "target_lang_sense_clarification": "оказывать давление"
                            },
                            {
                                "target_lang_word": "выжимать",
                                "target_lang_sense_clarification": "извлекать жидкость"
                            },
                            {
                                "target_lang_word": "выдавливать",
                                "target_lang_sense_clarification": "из тюбика или плода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挤",
                                "target_lang_sense_clarification": "施加压力"
                            },
                            {
                                "target_lang_word": "压榨",
                                "target_lang_sense_clarification": "提取液体"
                            },
                            {
                                "target_lang_word": "挤压",
                                "target_lang_sense_clarification": "改变形状"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50f6a0ca-ccf2-3c3b-b6b5-dfad14542454",
                    "sense_definition": "To manage to fit into or pass through a very tight or narrow space.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fitting_into_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I managed to <w>squeeze</w> the car into that tiny parking space near the shop.",
                            "target_lang_translations": {
                                "ru": "Мне удалось <w>втиснуть</w> машину на то крошечное парковочное место рядом с магазином.",
                                "zh": "我设法把车<w>挤</w>进了商店旁那个狭小的停车位里。"
                            }
                        },
                        {
                            "text": "The cat tried to <w>squeeze</w> through the gap in the garden fence.",
                            "target_lang_translations": {
                                "ru": "Кот пытался <w>протиснуться</w> сквозь щель в садовом заборе.",
                                "zh": "猫试图从花园栅栏的缝隙中<w>挤</w>过去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compress",
                        "condense"
                    ],
                    "common_phrases": [
                        "squeeze through a gap",
                        "squeeze into a seat",
                        "squeeze past someone"
