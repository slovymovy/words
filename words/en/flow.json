                                "target_lang_sense_clarification": "psychologische staat (vaak onvertaald)"
                            },
                            {
                                "target_lang_word": "flowtoestand",
                                "target_lang_sense_clarification": "formele term voor de mentale staat"
                            }
                        ]
                    }
                },
                {
