                            {
                                "example_id": "d87fcefb-12a8-4e09-8f31-a74bfd2fb4f6",
                                "sense_id": "cc57a428-19f3-38a7-8559-fb0988ee2283",
                                "text": "Violences ? Ultraviolences même, commises à Rennes en 1994 par des marins-pêcheurs désespérés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0d13eb5-5f7b-4881-8287-4e48e0073d69",
                        "source_entry_id": "fd15ccc2-576e-38bb-b1c8-f177d4c92366",
