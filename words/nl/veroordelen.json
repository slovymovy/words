{
    "word_family": [
        "veroordeling",
        "oordeel",
        "oordelen",
        "beoordelen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da035e66-2075-3342-a8c8-b22bf570c4ee",
                    "sense_definition": "In een rechtszaak officieel uitspreken dat iemand schuldig is en een straf krijgt.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter <w>veroordeelde</w> de verdachte tot een gevangenisstraf van vijf jaar.",
                            "target_lang_translations": {
                                "en": "The judge <w>sentenced</w> the suspect to a prison sentence of five years.",
                                "ru": "Судья <w>приговорил</w> обвиняемого к пяти годам тюремного заключения.",
                                "pl": "Sędzia <w>skazał</w> podejrzanego na karę pięciu lat pozbawienia wolności."
                            }
                        },
                        {
                            "text": "Hij werd bij verstek <w>veroordeeld</w> omdat hij niet bij de rechtszaak aanwezig was.",
                            "target_lang_translations": {
                                "en": "He was <w>convicted</w> in absentia because he was not present at the trial.",
                                "ru": "Он был <w>осужден</w> заочно, так как не присутствовал на судебном заседании.",
                                "pl": "Został <w>skazany</w> zaocznie, ponieważ nie był obecny na procesie."
                            }
                        }
                    ],
                    "synonyms": [
                        "vonnissen"
                    ],
                    "antonyms": [
                        "vrijspreken"
                    ],
                    "common_phrases": [
                        "tot gevangenisstraf veroordelen",
                        "ter dood veroordelen",
                        "bij verstek veroordelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To officially declare someone guilty in a court of law and impose a punishment.",
                        "ru": "Официально признать кого-либо виновным в суде и назначить наказание.",
                        "pl": "Oficjalnie uznać kogoś za winnego w sądzie i wymierzyć mu karę."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sentence",
                                "target_lang_sense_clarification": "to impose a punishment"
                            },
                            {
                                "target_lang_word": "convict",
                                "target_lang_sense_clarification": "to find guilty"
                            },
                            {
                                "target_lang_word": "condemn",
                                "target_lang_sense_clarification": "to sentence to a severe punishment"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "приговаривать",
                                "target_lang_sense_clarification": "выносить приговор о наказании"
                            },
                            {
                                "target_lang_word": "осуждать",
                                "target_lang_sense_clarification": "признавать виновным юридически"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "skazywać",
                                "target_lang_sense_clarification": "wymierzać karę sądownie (niedokonany)"
                            },
                            {
                                "target_lang_word": "skazać",
                                "target_lang_sense_clarification": "wymierzyć karę sądownie (dokonany)"
                            },
                            {
                                "target_lang_word": "wydać wyrok",
                                "target_lang_sense_clarification": "orzec karę w sądzie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38be6752-4c9d-31dc-9b54-c736c44b21b6",
                    "sense_definition": "Streng en openlijk zeggen dat men iets of iemand slecht, verkeerd of onaanvaardbaar vindt.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De regering <w>veroordeelt</w> het geweld tegen de vreedzame demonstranten ten zeerste.",
                            "target_lang_translations": {
                                "en": "The government strongly <w>condemns</w> the violence against the peaceful protesters.",
                                "ru": "Правительство решительно <w>осуждает</w> насилие в отношении мирных демонстрантов.",
                                "pl": "Rząd stanowczo <w>potępia</w> przemoc wobec pokojowych demonstrantów."
                            }
                        },
                        {
                            "text": "Veel wetenschappers <w>veroordelen</w> de politieke aanvallen op hun onafhankelijke onderzoek.",
                            "target_lang_translations": {
                                "en": "Many scientists <w>condemn</w> the political attacks on their independent research.",
                                "ru": "Многие ученые <w>осуждают</w> политические нападки на их независимые исследования.",
                                "pl": "Wielu naukowców <w>potępia</w> polityczne ataki na ich niezależne badania."
                            }
                        }
                    ],
                    "synonyms": [
                        "afkeuren"
                    ],
                    "antonyms": [
                        "toejuichen"
                    ],
                    "common_phrases": [
                        "scherp veroordelen",
                        "ten stelligste veroordelen",
                        "geweld veroordelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To strongly and openly state that something or someone is bad, wrong, or unacceptable.",
                        "ru": "Резко и публично выражать неодобрение чьим-либо действиям или поведению.",
                        "pl": "Stanowczo i otwarcie uznać kogoś lub coś za złe, niewłaściwe lub nie do zaakceptowania."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "condemn",
                                "target_lang_sense_clarification": "to express strong disapproval"
                            },
                            {
                                "target_lang_word": "denounce",
                                "target_lang_sense_clarification": "to publicly declare as wrong"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "осуждать",
                                "target_lang_sense_clarification": "выражать неодобрение"
                            },
                            {
                                "target_lang_word": "порицать",
                                "target_lang_sense_clarification": "высказывать укор"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "potępiać",
                                "target_lang_sense_clarification": "surowo i otwarcie krytykować"
                            },
                            {
                                "target_lang_word": "potępić",
                                "target_lang_sense_clarification": "wyrazić stanowczą dezaprobatę"
                            },
                            {
                                "target_lang_word": "krytykować",
                                "target_lang_sense_clarification": "wytykać błędy i oceniać negatywnie"
                            },
                            {
                                "target_lang_word": "dezaprobować",
                                "target_lang_sense_clarification": "nie pochwalać czegoś"
                            }
                        ]
                    }
                }
            ]
        }
    ]
