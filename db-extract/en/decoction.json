                                    {
                                        "sense_id": "983b5189-b8be-3e8a-bdf4-863ae51b4141",
                                        "entry_id": "9656f968-1519-3fae-a85d-e9f01a138311",
                                        "glosses": [
                                            "wässriger Extrakt von tierischen oder pflanzlichen Stoffen mit heilender Wirkung, der durch Kochen gewonnen wird"
                                        ],
                                        "tags": [
                                            "Phytotherapie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ab517bb-e5c1-4d06-85c8-6e69813186b2",
                                                "sense_id": "983b5189-b8be-3e8a-bdf4-863ae51b4141",
                                                "text": "Das ›Dekokt‹ gegen die Gicht, dieser bittere Holztrunk, dessen Rezept ihm zwei oder drei Jahre zuvor ein Jesuit in Wien genannt hatte, zeitigte diesmal nicht den gewünschten Erfolg."
                                            },
                                            {
                                                "example_id": "851b3959-15f1-4fec-9bbb-a88136971064",
                                                "sense_id": "983b5189-b8be-3e8a-bdf4-863ae51b4141",
                                                "text": "Fichtennadelbäder, diese modernste Terpentinölung oder Menschenfirnissung, sind im Dekokt und Destillat leicht zu beschaffen."
                                            },
                                            {
                                                "example_id": "67b7f734-28a6-4ca5-bfaa-7eb05641d102",
                                                "sense_id": "983b5189-b8be-3e8a-bdf4-863ae51b4141",
                                                "text": "»Erlauben Sie gütigst, lieber Herr Vikarius«, unterbrach der Gutsherr ihn und nahm die Kanne aus seiner Hand; dann öffnete er das Fenster und goß den ganzen Dekokt in den Baumhof hinunter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
