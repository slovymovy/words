                        {
                            "trait_type": "archaic",
                            "comment": "Rare in modern usage as a mass noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "高度赞扬，称颂"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "赞美",
                                "target_lang_sense_clarification": "指赞赏、称誉"
                            },
                            {
                                "target_lang_word": "赞颂",
                                "target_lang_sense_clarification": "高度的称赞与歌颂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b52749b-b317-3380-ad93-7955801ac6d3",
                    "sense_definition": "A hymn, song, or formal expression of praise to God.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "worship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cathedral choir sang a traditional <w>laud</w> during the festival.",
                            "target_lang_translations": {
