                        "examples": [
                            {
                                "example_id": "80e81c0b-6f70-45c3-966f-fa8b49678644",
                                "sense_id": "77ba2fec-9689-345f-b88b-3ae2645b4006",
                                "text": "The eruca, or rocket, so called from the Greek, […] was had in so great esteem heretofore, as to its efficacy in conjugal performances, that many of the antient authors, both in poetry and prose, make mention of it purely for that purpose:[…]"
                            },
                            {
                                "example_id": "203a4baf-3970-4173-a8d8-279a2e2a848b",
                                "sense_id": "77ba2fec-9689-345f-b88b-3ae2645b4006",
                                "text": "Eruca, or Garden Rocket, was formerly much used as a salad herb, but has been long rejected on account of its ungrateful smell."
                            }
                        ]
