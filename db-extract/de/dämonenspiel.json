                "senses": [
                    {
                        "sense_id": "dd275998-facb-3d11-98fb-09405a9ffaa9",
                        "entry_id": "98b886f7-c14f-3eba-a83e-0d6834212734",
                        "glosses": [
                            "Spiel mit unheimlichen Gestalten wie Geistern oder Gespenstern beziehungsweise hilfreichen göttlichen oder bösartigen teuflischen Wesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95c5996f-a674-403e-8446-08bbae57a968",
                                "sense_id": "dd275998-facb-3d11-98fb-09405a9ffaa9",
                                "text": "„Das plötzliche Umschlagen eines dramatisch sich steigernden Erzählens in Anrufschock und Handgreiflichkeit zeigt die enge Verwandtschaft der Miterlebensweise von Kindermärchen und Dämonenspiel auf.“"
                            },
                            {
                                "example_id": "5aabca56-97af-4d2d-be6e-ed8c06c5ec3e",
                                "sense_id": "dd275998-facb-3d11-98fb-09405a9ffaa9",
                                "text": "„Die neckenden Kinder ihrerseits riskieren, berührt und damit selbst mit Blindheit geschlagen zu werden. Dieses uralte Spiel wurde in vorchristlicher Zeit als kultisches Dämonenspiel zelebriert.“"
                            },
                            {
                                "example_id": "aba3157d-1cac-44ae-97ec-496e6d28f47f",
                                "sense_id": "dd275998-facb-3d11-98fb-09405a9ffaa9",
                                "text": "„Zu nennen sind hier u. a. Zeamis Kriegerspiele ‚Tadanori’, ‚Atsumori’ und ‚Yorimasa’ sowie das Dämonenspiel ‚Nue’ (ein Ungeheuer am kaiserlichen Hof).“"
                            },
                            {
                                "example_id": "8ed28189-0f86-4cce-9999-d8b9b1819849",
                                "sense_id": "dd275998-facb-3d11-98fb-09405a9ffaa9",
                                "text": "„Möglicherweise ist das Spiel aber sogar noch viel älter: Kulturhistoriker glauben es in vorchristlicher Zeit als kultisches Dämonenspiel verorten zu können, wo ihm sogar die Bedeutung zukommt, durch die Erfahrung der Blindheit das Sehen neu zu schaffen.“"
                            },
                            {
                                "example_id": "a01ea315-06d0-4924-bb71-c9cc1aa8a56c",
                                "sense_id": "dd275998-facb-3d11-98fb-09405a9ffaa9",
                                "text": "„Dämonenspiel ist wie auch die Vorgängerromane ein mäßig spannender Mix aus bekannten Horror- und Mystery-Elementen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
