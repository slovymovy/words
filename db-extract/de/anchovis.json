                                                "example_id": "a6087851-2fd9-4bb6-80f5-6a61065a6f45",
                                                "sense_id": "e7d4be9a-c14f-318d-a225-21f3b42c6a52",
                                                "text": "le alici sott'olio in conserva sono una prelibatezza"
                                            },
                                            {
                                                "example_id": "3227d4b0-2307-43b1-9127-d50d05627898",
                                                "sense_id": "e7d4be9a-c14f-318d-a225-21f3b42c6a52",
                                                "text": "grazie ad un clima adeguato, solitamente nelle fabbriche in Marocco le alici vengono “custodite” con sale in fusti da kg 250 circa per la vendita import-export"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "010efef6-eaf5-426e-8510-5e51555bedb1",
                        "source_entry_id": "e58fb72d-1e46-3a3c-b3c6-9d4ccad3663c",
                        "source_sense_id": "21f49900-0293-307b-8625-8a2ec6d18e3a",
                        "source_sense_description": "europäische Sardelle",
                        "target_lang_word": "анчоус",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "анчоус",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c1e5271d-9159-3376-b895-560b4afe3810",
                                        "entry_id": "cc2f5e0e-8954-393c-9a82-7c09369398d3",
                                        "glosses": [
                                            "мелкая морская рыба отряда сельдеобразных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b866578-8d9d-42c7-976e-d1920d30076a",
                                                "sense_id": "c1e5271d-9159-3376-b895-560b4afe3810",
                                                "text": "Молодой ученый установил, что, догнав добычу — косяк скумбрии или анчоуса (он это наблюдал в зоне течений Калифорнийского и Куросиво), — стая дельфинов-белобочек ведет себя точно так же, как волчья."
                                            },
                                            {
                                                "example_id": "7c0a63db-edff-4b3b-a8ca-4358c84769fc",
                                                "sense_id": "c1e5271d-9159-3376-b895-560b4afe3810",
                                                "text": "Ночью вода здесь фосфоресцирует от несметного множества крошечных живых существ — диатомей. То тут, то там ее прочерчивают сотни зеленых полосок. Это проносятся стайки перуанского анчоуса — мелкой рыбешки, брюшные полости которой набиты светящимся фитопланктоном."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67bc12c9-9e6d-3613-ac45-71b6930d918a",
                                        "entry_id": "cc2f5e0e-8954-393c-9a82-7c09369398d3",
                                        "glosses": [
                                            "мясо такой рыбы, употребляемое в пищу; также кушанье, приготовленное из такого мяса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43b6a0ac-a2c2-4984-ac82-3a2994d90a0c",
                                                "sense_id": "67bc12c9-9e6d-3613-ac45-71b6930d918a",
                                                "text": "Мы сами выбрали себе павильйон, велели подать цыпленка, анчоусов, сыру, масла, бутылку кларету и заплатили рублей шесть."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
