                ],
                "senses": [
                    {
                        "sense_id": "4985ce4e-6d04-316b-84b8-2227305f9ada",
                        "entry_id": "c30a09bd-17ff-312a-a66e-5a042392e494",
                        "glosses": [
                            "Enlever à quelque chose son caractère anonyme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c7af15a-8515-4d08-ac0b-d6f7cda6bf3b",
                                "sense_id": "4985ce4e-6d04-316b-84b8-2227305f9ada",
                                "text": "Ré-identifier ou dé-anonymiser des données se fait le plus souvent avec une étonnante facilité."
                            },
                            {
                                "example_id": "3833fd00-bd2d-4f1a-a885-e5f6e34e889e",
                                "sense_id": "4985ce4e-6d04-316b-84b8-2227305f9ada",
                                "text": "De ce fait, les chercheurs voulaient démontrer si on pouvait dé-anonymiser ces données même si l'historique de navigation ne contenait pas ces identités."
                            },
                            {
                                "example_id": "a42ba3fe-0db0-4bb9-8b44-da520d3e2625",
                                "sense_id": "4985ce4e-6d04-316b-84b8-2227305f9ada",
                                "text": "Le réseau d'anonymisation Tor aurait été la cible de la NSA dans le cadre du programme d'écoute Prism. L'agence n'aurait que très partiellement réussi à en dé-anonymiser les utilisateurs."
                            }
                        ]
                    }
