                        "cross_references": [
                            {
                                "target_word": "weather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28353b1b-8e3e-3024-814a-275b4d04f088",
                                        "entry_id": "ecc14260-ff2f-32d6-a38f-37da6d8dbc73",
                                        "glosses": [
                                            "The short term state of the atmosphere at a specific time and place, including the temperature, relative humidity, cloud cover, precipitation, wind, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfcec961-34fe-4d38-bc15-040a0d4c9d4c",
                                                "sense_id": "28353b1b-8e3e-3024-814a-275b4d04f088",
                                                "text": "What's the weather like today?"
                                            },
                                            {
                                                "example_id": "26567d8c-951b-46d9-8134-340c8893f372",
                                                "sense_id": "28353b1b-8e3e-3024-814a-275b4d04f088",
                                                "text": "We'll go for a walk when the weather's better."
                                            },
                                            {
                                                "example_id": "c77b8c5e-a231-49c3-a2d0-5b998b401aa7",
                                                "sense_id": "28353b1b-8e3e-3024-814a-275b4d04f088",
                                                "text": "The garden party was called off due to bad weather."
                                            },
                                            {
                                                "example_id": "2f434880-322f-4246-b39c-320ccf0345f5",
                                                "sense_id": "28353b1b-8e3e-3024-814a-275b4d04f088",
                                                "text": "Here and there, the weather on the sea allowed two of their friends to hear and see, too."
                                            },
                                            {
                                                "example_id": "2c83d380-cf5e-4a36-9fc0-91df0a6e496d",
                                                "sense_id": "28353b1b-8e3e-3024-814a-275b4d04f088",
                                                "text": "Human beings love to talk about the weather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac6e9508-bda4-3d6a-8fe0-531a4c0e9348",
                                        "entry_id": "ecc14260-ff2f-32d6-a38f-37da6d8dbc73",
                                        "glosses": [
                                            "Unpleasant or destructive atmospheric conditions, and their effects."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aafc988c-1bb7-42b9-bc4e-1908b82ed403",
                                                "sense_id": "ac6e9508-bda4-3d6a-8fe0-531a4c0e9348",
                                                "text": "Wooden garden furniture must be well oiled as it is continuously exposed to weather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f626719-1a92-3128-aafa-959b7a7f9e4d",
                                        "entry_id": "ecc14260-ff2f-32d6-a38f-37da6d8dbc73",
                                        "glosses": [
                                            "The direction from which the wind is blowing; used attributively to indicate the windward side."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "287d4b2f-445f-44ae-837c-4f45f6f0792d",
                                                "sense_id": "6f626719-1a92-3128-aafa-959b7a7f9e4d",
                                                "text": "One complained of a bad cold in his head, upon which Jonah mixed him a pitch-like potion of gin and molasses, which he swore was a sovereign cure for all colds and catarrhs whatsoever, never mind of how long standing, or whether caught off the coast of Labrador, or on the weather side of an ice-island."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "681579e9-f0c2-3efb-848b-497fdf0b0258",
                                        "entry_id": "ecc14260-ff2f-32d6-a38f-37da6d8dbc73",
                                        "glosses": [
                                            "A situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60c92396-485f-3138-bc74-ae003ae30334",
                                        "entry_id": "ecc14260-ff2f-32d6-a38f-37da6d8dbc73",
                                        "glosses": [
                                            "A storm; a tempest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a30cb725-5b57-4d35-a787-49c300ee81f2",
                                                "sense_id": "60c92396-485f-3138-bc74-ae003ae30334",
                                                "text": "What gusts of weather from that gathering cloud / My thoughts presage!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4644d73e-2b60-3a22-9ce0-79740a5c038b",
                                        "entry_id": "ecc14260-ff2f-32d6-a38f-37da6d8dbc73",
                                        "glosses": [
                                            "A light shower of rain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "weather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a66ebdf0-dd32-3fca-a275-35969e41d677",
                                        "entry_id": "33a23ede-f142-3929-91ee-8b2760f62922",
                                        "glosses": [
                                            "Facing towards the flow of a fluid, usually air."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc3185a1-51c6-4771-bc58-227beb6544d3",
                                                "sense_id": "a66ebdf0-dd32-3fca-a275-35969e41d677",
                                                "text": "weather side, weather helm"
                                            },
                                            {
                                                "example_id": "b92e5fe7-553e-4e3a-90f2-f960facef34d",
                                                "sense_id": "a66ebdf0-dd32-3fca-a275-35969e41d677",
                                                "text": "Let me make a clean breast of it here, and frankly admit that I kept but sorry guard. With the problem of the universe revolving in me, how could I—being left completely to myself at such a thought-engendering altitude—how could I but lightly hold my obligations to observe all whale-ships’ standing orders, “Keep your weather eye open, and sing out every time.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "weather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84ce60f3-d5fe-3fce-b11c-f0073240a3c5",
                                        "entry_id": "ee43bce7-5517-339c-8a7b-09bb1d9587de",
                                        "glosses": [
                                            "To expose to the weather, or show the effects of such exposure, or to withstand such effects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e86f364d-6181-42f0-9b95-9f57842abc8e",
                                                "sense_id": "84ce60f3-d5fe-3fce-b11c-f0073240a3c5",
                                                "text": "The organisms […] seem indestructible, while the hard matrix in which they are embedded has weathered from around them."
                                            },
                                            {
                                                "example_id": "01acad3c-3dd9-45c9-87aa-a2f629892588",
                                                "sense_id": "84ce60f3-d5fe-3fce-b11c-f0073240a3c5",
                                                "text": "[An eagle] soaring through his wide empire of the air / To weather his broad sails."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d1fac9b-c6a8-37a3-a208-a7f84c547253",
                                        "entry_id": "ee43bce7-5517-339c-8a7b-09bb1d9587de",
                                        "glosses": [
                                            "To sustain the trying effect of; to bear up against and overcome; to endure; to resist."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7274b73e-f0ca-4e5f-931b-7c8643a92180",
                                                "sense_id": "8d1fac9b-c6a8-37a3-a208-a7f84c547253",
                                                "text": "\"Come hither! come hither! my little daughter, / And do not tremble so; / For I can weather the roughest gale, That ever wind did blow.\""
                                            },
                                            {
                                                "example_id": "4c8c7a63-76c2-4226-8e7e-eabae351d622",
                                                "sense_id": "8d1fac9b-c6a8-37a3-a208-a7f84c547253",
                                                "text": "April 18, 1850, Frederick William Robertson, An Address Delivered to the Members of the Working Man's Institute\nYou will weather the difficulties yet."
                                            },
                                            {
                                                "example_id": "502e0c9d-130b-4960-b981-b9151b9ad213",
                                                "sense_id": "8d1fac9b-c6a8-37a3-a208-a7f84c547253",
                                                "text": "Some observers have contrasted China with the US, whose economy has weathered the post-Covid recovery better. Until recently, Americans may have feared the day China would overtake them as the world's largest economy, but now analysts doubt if this will happen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cacaf56-0db9-3700-a84a-7e356b7dbff8",
                                        "entry_id": "ee43bce7-5517-339c-8a7b-09bb1d9587de",
                                        "glosses": [
                                            "To break down, of rocks and other materials, under the effects of exposure to rain, sunlight, temperature, and air."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de81fb3c-9eab-349a-b8df-818a0f5ec10c",
                                        "entry_id": "ee43bce7-5517-339c-8a7b-09bb1d9587de",
                                        "glosses": [
                                            "To cause (rocks) to break down by crushing, grinding, and/or dissolving with acids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d796fd74-c734-4055-ae0c-ed4d93e309a2",
                                                "sense_id": "de81fb3c-9eab-349a-b8df-818a0f5ec10c",
                                                "text": "Lichens' ability to weather makes them a geological force, yet they do more than disolve the physical features of the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eff13d7f-f0ff-3128-8480-6e3d95b328d1",
                                        "entry_id": "ee43bce7-5517-339c-8a7b-09bb1d9587de",
                                        "glosses": [
                                            "To pass to windward in a vessel, especially to beat 'round."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8609a577-0381-4b32-9dc0-a7130be44bb9",
                                                "sense_id": "eff13d7f-f0ff-3128-8480-6e3d95b328d1",
                                                "text": "to weather a cape    to weather another ship"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2264813f-a528-3c13-948f-af1459e18944",
                                        "entry_id": "ee43bce7-5517-339c-8a7b-09bb1d9587de",
                                        "glosses": [
                                            "To endure or survive an event or action without undue damage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3db26ea-6233-4b60-b72e-5f7c501a7e56",
                                                "sense_id": "2264813f-a528-3c13-948f-af1459e18944",
                                                "text": "Joshua weathered a collision with a freighter near South Africa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e52ceb7-77c6-3014-871a-8521e7660bbb",
                                        "entry_id": "ee43bce7-5517-339c-8a7b-09bb1d9587de",
                                        "glosses": [
                                            "To place (a hawk) unhooded in the open air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3c2686c-5093-4e92-8e97-dd068573a7a6",
                                                "sense_id": "2e52ceb7-77c6-3014-871a-8521e7660bbb",
                                                "text": "If your hawk is bad-weathered, that is, will not fit on your fist when the wind blows, but hales, and beats, and hangs by the jeſſes, ſhe has an ill habit of the worſt kind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfb87082-0f4d-3890-b94f-36de439f3bdd",
                                        "entry_id": "ee43bce7-5517-339c-8a7b-09bb1d9587de",
                                        "glosses": [
                                            "To rain; to storm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc49b87a-f3f5-4e16-8851-859600a16185",
                                                "sense_id": "cfb87082-0f4d-3890-b94f-36de439f3bdd",
                                                "text": "But there's no law against taking pictures when it's weathering out there, and you're likely to produce some beautiful, if not different, images for your efforts. All that's needed is to dress your camera for the weather[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
