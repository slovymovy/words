                    },
                    {
                        "translation_id": "b2d4fb59-3986-4b12-a18b-1bed615a2b2f",
                        "source_entry_id": "e15a63c0-f1cd-300d-9d8d-16ff5112cdc2",
                        "source_sense_id": "6bbf90ff-63cc-3631-bdd7-cae69bde0b03",
                        "source_sense_description": "ein Mensch, der schnell wütend wird und leicht tobt",
                        "target_lang_word": "fou furieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fou furieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "792385ed-17b5-3601-a75e-137cd07490cd",
                                        "entry_id": "81ade603-7fec-3354-a1d7-9158084bb93a",
                                        "glosses": [
                                            "Qui est dans un état de folle fureur, de folle furie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d7b98e1-aa60-4b1a-ba00-8713c6979ce6",
                                                "sense_id": "792385ed-17b5-3601-a75e-137cd07490cd",
                                                "text": "Un fou furieux a battu deux policières et tenté de les désarmer lors d’une arrestation qui a bien failli tourner au drame, dans la nuit de vendredi, à Sherbrooke, en Estrie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fou furieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dca9d7ef-928f-3304-bcda-24f09c8c6e7c",
                                        "entry_id": "f37b1e30-db52-34aa-be3a-f4f5463bf728",
                                        "glosses": [
                                            "Personne en état de folle fureur, de folle furie."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "195dfab4-bd08-4ef2-8a41-aae6d2c6fe8d",
                                                "sense_id": "dca9d7ef-928f-3304-bcda-24f09c8c6e7c",
                                                "text": "Il regardait les vastes bâtiments de l’Asile, les ailes des différents quartiers, séparés par des jardins, celui des hommes et celui des femmes, ceux des fous tranquilles et des fous furieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32986b58-6509-3a56-acb2-eb6d8b128f50",
                                        "entry_id": "f37b1e30-db52-34aa-be3a-f4f5463bf728",
                                        "glosses": [
                                            "Personne dogmatique, incontrôlable ou imprévisible."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24af3a4f-1d09-41cb-ab2a-f8fca4c47665",
                                                "sense_id": "32986b58-6509-3a56-acb2-eb6d8b128f50",
                                                "text": "« Un essai thérapeutique a été lancé, très encadré : comme ça, le fou furieux va être occupé à autre chose et on le verra moins sur les plateaux télé »"
                                            },
                                            {
                                                "example_id": "fd9c4d39-e969-4d92-b7fc-19b7c8ba4daf",
                                                "sense_id": "32986b58-6509-3a56-acb2-eb6d8b128f50",
                                                "text": "« Stéphane Baly, tête de liste écologiste, est « quelqu’un que j’apprécie » mais il y a dans sa liste « des fous furieux », « des écolos marxistes », a jugé Thierry Pauchet. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
