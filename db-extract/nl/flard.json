                        ],
                        "examples": [
                            {
                                "example_id": "f0f13ac5-9a4d-437b-95e6-72dc1f0db421",
                                "sense_id": "165fce0f-feb8-31e1-af22-2c1f94bc376a",
                                "text": "Het is geen kunst bij de entree van de Amstelstraat, komend van het Rembrandtplein, een flard van triestheid door het hart te voelen gaan."
                            }
                        ]
