                                    {
                                        "sense_id": "b5c61688-840e-3bd0-b055-bae8613a1ce8",
                                        "entry_id": "683c2808-13bc-3b41-9c7e-9a97fefeefff",
                                        "glosses": [
                                            "That which goads or incites; a stimulus."
                                        ],
                                        "tags": [
