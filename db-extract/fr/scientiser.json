                "senses": [
                    {
                        "sense_id": "6a945773-9141-3eea-80ba-6908011c1d3d",
                        "entry_id": "88187840-b5f0-329e-bc3a-c733f48ce45e",
                        "glosses": [
                            "Donner un caractère de science à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ed62d50-15da-497c-b618-84300afe4554",
                                "sense_id": "6a945773-9141-3eea-80ba-6908011c1d3d",
                                "text": "Ces ouvrages appartiennent à un ensemble de publications qui témoignent d'un mouvement, amorcé quelque vingt ans plus tôt, visant à \"scientiser\" la réflexion sur et la pratique de l'enseignement des langues (Brooks, N. 1960, Lado 1964, Halliday et al. 1964, Girard 1974, …)."
                            },
                            {
                                "example_id": "43bb1560-6ca9-4b4c-8bca-05fe03365643",
                                "sense_id": "6a945773-9141-3eea-80ba-6908011c1d3d",
                                "text": "Escrocs entrés à l'université par effraction pour «scientiser» l'art qu'est, à l'origine, la manière de les transmettre, ces savoirs."
                            },
                            {
                                "example_id": "2f0efc9d-8a4f-44c4-952f-e8ef03f1d8b2",
                                "sense_id": "6a945773-9141-3eea-80ba-6908011c1d3d",
                                "text": "Ce n'est pas constructif de tout vouloir scientiser."
                            }
                        ]
                    }
                ],
