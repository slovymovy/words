                    {
                        "sense_id": "1af6be6f-76a1-37df-ab45-cc45ff605b32",
                        "entry_id": "6e4d8c6a-167e-3efe-b2a2-2ccf0da18ea7",
                        "glosses": [
                            "ein zum Arm gehörender Muskel, der an einem Ende in drei Teile ausläuft und dem Oberarm als Streckmuskel dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91d926ae-27c2-4083-8ef5-b31e64729102",
                                "sense_id": "1af6be6f-76a1-37df-ab45-cc45ff605b32",
                                "text": "Der Trizeps ist der Gegenspieler des Bizepses."
                            },
                            {
                                "example_id": "203e94a2-ad62-48d8-959a-385dc9af693d",
                                "sense_id": "1af6be6f-76a1-37df-ab45-cc45ff605b32",
                                "text": "Die Hauptfunktion des Trizepses (auch: des Trizeps) besteht darin, die Streckung des Armes zu ermöglichen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
