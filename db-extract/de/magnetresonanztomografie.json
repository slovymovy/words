                "senses": [
                    {
                        "sense_id": "729f1ffc-22a4-3993-8204-faab0d57aca5",
                        "entry_id": "38b49922-efc9-36d8-8f65-99e82224e051",
                        "glosses": [
                            "bildgebendes Verfahren, das vor allem in der medizinischen Diagnostik zur Darstellung von Struktur und Funktion der Gewebe und Organe im Körper eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59e6e98f-df45-4736-9874-4b6586993cfe",
                                "sense_id": "729f1ffc-22a4-3993-8204-faab0d57aca5",
                                "text": "Die Magnetresonanztomografie basiert auf sehr starken Magnetfeldern sowie elektromagnetischen Wechselfeldern im Radiofrequenzbereich, mit denen bestimmte Atomkerne im Körper resonant angeregt werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
