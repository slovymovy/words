                "translations": [
                    {
                        "translation_id": "bce189f9-8ebe-4633-97a7-39555f73f394",
                        "source_entry_id": "2c6faa00-8c1b-3800-bf3c-113bb2b83f4a",
                        "source_sense_id": "4471ed18-93c0-34aa-971a-60ee92da8294",
                        "target_lang_word": "glitter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glitter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9bd394b-ac1d-35a3-b26e-23c7e23834df",
                                        "entry_id": "218710e2-ebc4-37fe-9bad-92c50bd518ca",
                                        "glosses": [
                                            "A bright, sparkling light; shininess or brilliance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c9e3d6b-0296-49d6-8626-e120e60049bc",
                                                "sense_id": "d9bd394b-ac1d-35a3-b26e-23c7e23834df",
                                                "text": "As yet there had been no symptom of the news having any better foundation than in the fears of those who brought it, but The Boot had not been deserted five minutes, when there appeared, coming across the fields, a body of men who, it was easy to see, by the glitter of their arms and ornaments in the sun, and by their orderly and regular mode of advancing."
                                            },
                                            {
                                                "example_id": "647b14d6-1376-489f-8903-f1858fd6a695",
                                                "sense_id": "d9bd394b-ac1d-35a3-b26e-23c7e23834df",
                                                "text": "This to them seems most like mother earth in color, and therefore best, as it is, to enhance the beauty of flowers instead of detracting from their exquisite shades. What a contrast to the glitter and show of our silver vases, which represent generally little else but their cost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3b7763f-0a45-3649-b314-63038ecdfc5f",
                                        "entry_id": "218710e2-ebc4-37fe-9bad-92c50bd518ca",
                                        "glosses": [
                                            "A shiny, decorative adornment, sometimes sprinkled on glue to make simple artwork."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "895d3f2b-4a2e-3ab4-aaba-733176cb339a",
                                        "entry_id": "218710e2-ebc4-37fe-9bad-92c50bd518ca",
                                        "glosses": [
                                            "Glitz."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "glitter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f450466f-3fb7-3f31-ab52-ea23c75d8993",
                                        "entry_id": "5c3bf602-023d-3a68-b22d-00b7eaf4d0ed",
                                        "glosses": [
                                            "To sparkle with light; to shine with a brilliant and broken light or showy luster; to gleam."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "869831e7-d9e9-43c7-97f2-57a5f319fe0e",
                                                "sense_id": "f450466f-3fb7-3f31-ab52-ea23c75d8993",
                                                "text": "a glittering sword"
                                            },
                                            {
                                                "example_id": "3022b4cb-c1fb-4a9f-9d42-4a63c2679f3c",
                                                "sense_id": "f450466f-3fb7-3f31-ab52-ea23c75d8993",
                                                "text": "the glittering ornaments on a Christmas tree"
                                            },
                                            {
                                                "example_id": "06d4c5e6-7104-4292-82c3-8f45ac39522b",
                                                "sense_id": "f450466f-3fb7-3f31-ab52-ea23c75d8993",
                                                "text": "The field yet glitters with the pomp of war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b525baac-06c6-3855-a18b-02dee7b06319",
                                        "entry_id": "5c3bf602-023d-3a68-b22d-00b7eaf4d0ed",
                                        "glosses": [
                                            "To be showy, specious, or striking, and hence attractive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60b426bc-43cb-4bde-9818-f6f107252852",
                                                "sense_id": "b525baac-06c6-3855-a18b-02dee7b06319",
                                                "text": "the glittering scenes of a court"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fe63875-3485-4df3-8f86-035ff1c42348",
                        "source_entry_id": "2c6faa00-8c1b-3800-bf3c-113bb2b83f4a",
                        "source_sense_id": "4471ed18-93c0-34aa-971a-60ee92da8294",
                        "target_lang_word": "Glitter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glitter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89302569-c7bd-32d4-a5ed-f3d1b171e17e",
                                        "entry_id": "ad74fea2-7663-38cf-a185-45a09cb8c500",
                                        "glosses": [
                                            "feine, glänzende Stückchen aus Metall, Kunststoff, Glas oder Papier, die zur Dekoration, zum Basteln oder in Kosmetika verwendet werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14ea9ff0-b6e9-4136-b202-63a917868192",
                                                "sense_id": "89302569-c7bd-32d4-a5ed-f3d1b171e17e",
                                                "text": "Nach der Party fand ich noch wochenlang Glitter in meiner Wohnung."
                                            },
                                            {
                                                "example_id": "d6c7687d-b44a-4619-9f07-1451890e863a",
                                                "sense_id": "89302569-c7bd-32d4-a5ed-f3d1b171e17e",
                                                "text": "Das Pferd, das er im Kindergarten gebastelt hatte, war mit Glitter und buntem Krepppapier beklebt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "396a347d-39fa-4da2-9586-ec9fcd060a96",
                        "source_entry_id": "2c6faa00-8c1b-3800-bf3c-113bb2b83f4a",
                        "source_sense_id": "4471ed18-93c0-34aa-971a-60ee92da8294",
                        "target_lang_word": "glitter",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5651673a-1cdd-427f-9ceb-be31baadb662",
                        "source_entry_id": "2c6faa00-8c1b-3800-bf3c-113bb2b83f4a",
                        "source_sense_id": "bb8779c0-64b6-3b1d-8e8e-9e79c0f2fbe2",
                        "target_lang_word": "brocade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brocade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b555d967-00dd-3445-bc30-96f711e68d76",
                                        "entry_id": "ffa36f19-e540-39c8-904f-bf91baeedc94",
                                        "glosses": [
                                            "A thick heavy fabric into which raised patterns have been woven, originally in gold and silver; more recently any cloth incorporating raised, woven patterns."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "529755d1-23f3-4d00-9903-bfb245594203",
                                                "sense_id": "b555d967-00dd-3445-bc30-96f711e68d76",
                                                "text": "Madame Legarde, the \"glass of fashion and the nurse of form,\" (alias the most fashionable of milliners,) has comfortably assured me, \"that my figure has great merit, and only requires cultivation:\" this is to be done by tissues, brocades, and laces, which are now scattered round me in charming confusion."
                                            },
                                            {
                                                "example_id": "97605c88-c2fe-4672-98a5-ed6ccd9e6806",
                                                "sense_id": "b555d967-00dd-3445-bc30-96f711e68d76",
                                                "text": "… his desire to stand in brocade and sing Rhadames in Aida was like my eagerness to go far, far beyond fellow intellectuals of my generation who had lost the imaginative soul."
                                            },
                                            {
                                                "example_id": "0bec5f5f-08e6-4586-95a4-240292b116ed",
                                                "sense_id": "b555d967-00dd-3445-bc30-96f711e68d76",
                                                "text": "I selected a pair of loose, dark trousers bound at the waist with a russet sash, a tunic with an open neck and large pockets, and a cloak of the true fuligin of that guild of which I am still officially a master, lined with particolored brocade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee6194ff-f877-390f-a93b-36d712eb74e0",
                                        "entry_id": "ffa36f19-e540-39c8-904f-bf91baeedc94",
                                        "glosses": [
                                            "An item decorated with brocade."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1556e8d2-af91-3818-9109-ca001f2382b2",
                                        "entry_id": "ffa36f19-e540-39c8-904f-bf91baeedc94",
                                        "glosses": [
                                            "Any of several species of noctuid moths such as some species in the genera Calophasia and Hadena"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00f52374-0c2f-46a3-b614-107ace2cb75b",
                                                "sense_id": "1556e8d2-af91-3818-9109-ca001f2382b2",
                                                "text": "Other species considered occasional migrants have become established in the UK in recent years, such as the ... sombre brocade, Blair's mocha, Flame brocade, and Clifden nonpareil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0993c0c4-9145-3e0e-b0d6-4b80e042ed96",
                                        "entry_id": "ffa36f19-e540-39c8-904f-bf91baeedc94",
                                        "glosses": [
                                            "A decorative pattern."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7868850d-41f9-43dc-a4ff-a06bed92d3b6",
                                                "sense_id": "0993c0c4-9145-3e0e-b0d6-4b80e042ed96",
                                                "text": "The shrubbery around the cottages is a brocade of lawns and shrubs intermixed, in fancy patterns, with gravel walks, in various directions, which wind into the woods."
                                            },
                                            {
                                                "example_id": "23f33700-7a9d-45eb-8df4-e041adbc10fe",
                                                "sense_id": "0993c0c4-9145-3e0e-b0d6-4b80e042ed96",
                                                "text": "It is as though the poets and mystics were weaving a colorful brocade of words with the intention to please God and to show His greatness to the world."
                                            },
                                            {
                                                "example_id": "8b439982-ecb0-45fd-88ad-2c0aad471d96",
                                                "sense_id": "0993c0c4-9145-3e0e-b0d6-4b80e042ed96",
                                                "text": "Saying this, Rikyu stepped into the garden, shook a tree and scattered over the garden gold and crimson leaves, scraps of the brocade of autumn!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brocade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ec3519e-8816-3eba-8170-2362410f35b9",
                                        "entry_id": "e3be1054-5266-38a1-8a66-1d794fa99196",
                                        "glosses": [
                                            "To decorate fabric with raised woven patterns."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19ddf90b-e847-4a85-a8a3-4a3663dd2818",
                        "source_entry_id": "2c6faa00-8c1b-3800-bf3c-113bb2b83f4a",
                        "source_sense_id": "bb8779c0-64b6-3b1d-8e8e-9e79c0f2fbe2",
                        "target_lang_word": "brokát",
