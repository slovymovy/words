                    ],
                    "common_phrases": [
                        "du côté des anciens"
                    ]
                },
                {
                    "sense_id": "33870f2a-96d0-3b11-a2ef-6196578efe09",
                    "sense_definition": "Élève de seconde année, dans certaines écoles ou classes préparatoires.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En classes préparatoires, les <w>anciens</w> aident les nouveaux à s'organiser."
                        },
                        {
                            "text": "Les <w>anciens</w> organisent une soirée pour accueillir les nouveaux élèves."
                        }
                    ]
                },
                {
                    "sense_id": "cfc8e48e-49ca-3b89-bca0-1c4d390b4816",
                    "sense_definition": "En taillis sous futaie, arbre « moderne » de la rotation précédente, choisi pour être conservé une rotation de plus.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce taillis sous futaie, on conserve quinze <w>anciens</w> par hectare."
                        },
                        {
                            "text": "Le forestier a marqué les <w>anciens</w> pour une rotation supplémentaire."
                        }
                    ]
                }
            ]
        }
    ]
