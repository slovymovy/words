                    {
                        "translation_id": "f771aae2-0f1b-4878-8738-4679e30e8e2e",
                        "source_entry_id": "8c9bfb89-a1e8-3d40-bf6d-1b3d015a76ad",
                        "source_sense_id": "06d17fe5-6bc7-3760-8f57-9b8993487343",
