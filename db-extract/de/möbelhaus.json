                "senses": [
                    {
                        "sense_id": "396793dd-1da2-30ae-9068-3445c64281a7",
                        "entry_id": "19d9b4dd-93fa-336f-ba59-6340c8a285b7",
                        "glosses": [
                            "Einrichtungshaus für Möbel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94fccf5e-6f61-4bb1-b724-55acea6d4a00",
                                "sense_id": "396793dd-1da2-30ae-9068-3445c64281a7",
                                "text": "Das Möbelhaus zeigt aktuelle Trends für die Wohnraumgestaltung."
                            },
                            {
                                "example_id": "158ff1f9-519c-41a6-a05f-3b335011eb07",
                                "sense_id": "396793dd-1da2-30ae-9068-3445c64281a7",
                                "text": "„Nach der Lesung hatte es im Möbelhaus noch einen kurzen Umtrunk und Imbiss gegeben, freundliches Geplauder.“"
                            },
                            {
                                "example_id": "4bb43b80-5f25-404a-a8d0-2dc27f4603d0",
                                "sense_id": "396793dd-1da2-30ae-9068-3445c64281a7",
                                "text": "„Dienstagabend startet in den Schaufenstern eines Möbelhauses auf der Wiener Mariahilfer Straße ein Weltrekordversuch im Dauerfernsehen.“"
                            },
                            {
                                "example_id": "99959a43-8081-4f20-89f1-f35ff4332006",
                                "sense_id": "396793dd-1da2-30ae-9068-3445c64281a7",
                                "text": "„Stundenlang wanderte ich durch das große Möbelhaus und suchte nach mir, nicht nach der alten Elin, sondern der neuen, die zwanzig Jahre alt und erwachsen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
