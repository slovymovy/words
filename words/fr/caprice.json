            "senses": [
                {
                    "sense_id": "8f94c1dd-2266-3982-a759-e144d5fa7572",
                    "sense_definition": "Manifestation d'entêtement, pleurs ou colère d'un enfant qui veut obtenir immédiatement ce qu'il désire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant a fait un gros <w>caprice</w> au supermarché pour avoir des bonbons."
                        },
                        {
                            "text": "Les parents ont décidé de ne plus céder au moindre <w>caprice</w> de leur fils."
                        }
                    ],
                    "common_phrases": [
