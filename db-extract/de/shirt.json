                        "entry_id": "f97e811a-8cdc-3ed7-b5e1-716ec74161f5",
                        "glosses": [
                            "bequemes, meist aus Baumwolle gefertigtes Oberteil mit kurzen Ärmeln, das meist ohne Kragen und mit Rundhals- oder V-Ausschnitt getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7432999f-767b-4f23-bf5f-44b7613ca546",
                                "sense_id": "937e8345-9868-3d01-ac79-f6bf2448e047",
                                "text": "Er trug ein einfaches, weißes Shirt."
                            },
                            {
                                "example_id": "a2b0edf1-20af-406b-8bcc-001d8bb5d57b",
                                "sense_id": "937e8345-9868-3d01-ac79-f6bf2448e047",
                                "text": "„Dass ich unter dem Shirt nackt bin, ist mir egal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1897a831-1597-4401-a3a7-2d1888b0cc54",
