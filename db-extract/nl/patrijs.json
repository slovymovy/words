                    {
                        "translation_id": "85698c42-2ccc-499c-bf0e-cef2184b4d4d",
                        "source_entry_id": "53290039-eadd-3035-820d-ba2ab9199aa3",
                        "source_sense_id": "20b77876-430f-34b1-aeb9-3404d48f33da",
                        "source_sense_description": "een vogel uit de familie van de fazanten",
                        "target_lang_word": "partridge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partridge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cec3c313-c22f-3aab-a0da-8cb0476d3409",
                                        "entry_id": "ed9329bb-5e48-39a5-88d9-3bd332deeaa5",
                                        "glosses": [
                                            "Any bird of a number of genera in the family Phasianidae, notably in the genera Perdix and Alectoris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e338b6b8-7e06-47fa-84d0-8f97999c0ef2",
                                                "sense_id": "cec3c313-c22f-3aab-a0da-8cb0476d3409",
                                                "text": "On the first day of Christmas, my true love sent to me a partridge in a pear tree."
                                            },
                                            {
                                                "example_id": "26b6ea07-2d8b-4fe3-8f27-cfeccac74175",
                                                "sense_id": "cec3c313-c22f-3aab-a0da-8cb0476d3409",
                                                "text": "...and the loudest sound in the lonely fields was when, adventuring too near some late brood, the partridge sought to deceive by a plaintive cry and seeming helplessness, crossing before your very feet, till, when drawn to a sufficient distance, suddenly the air vibrated to the flutter of her active pinions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62ddff66-d2e6-36b3-b114-0269a0f8e36e",
                                        "entry_id": "ed9329bb-5e48-39a5-88d9-3bd332deeaa5",
                                        "glosses": [
                                            "The flesh or meat of this bird eaten as food."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db572750-c351-3ebb-80ec-61d6a9ef9566",
                                        "entry_id": "ed9329bb-5e48-39a5-88d9-3bd332deeaa5",
                                        "glosses": [
                                            "A type of cannon charge composed of several missiles fired all together, similar to langrage or case-shot. Also a large cannon that shoots stones."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58dfcf6d-43af-41f9-bba6-f2329619140c",
                        "source_entry_id": "53290039-eadd-3035-820d-ba2ab9199aa3",
                        "source_sense_id": "20b77876-430f-34b1-aeb9-3404d48f33da",
                        "source_sense_description": "een vogel uit de familie van de fazanten",
                        "target_lang_word": "perdrix",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perdrix",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a42843b-ac92-3821-8a60-06501a081a8c",
                                        "entry_id": "50f53e5e-d8cd-3c29-ae5f-ee7900c77b39",
                                        "glosses": [
                                            "Nom normalisé réservé à six genres de gallinacés de petite taille, de la sous-famille des perdicinés (e.g. cailles, francolins, lagopèdes, etc.) et au sein de la famille des phasianidés, vivant en Europe, en Asie ou en Afrique du Nord, dont les genres les mieux connus sont Perdix (incluant la perdrix grise) et Alectoris (qui inclut la perdrix rouge, la perdrix bartavelle, la perdrix choukar, etc.)."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef4d6a04-7c3a-462d-a782-6e25230f5b52",
                                                "sense_id": "6a42843b-ac92-3821-8a60-06501a081a8c",
                                                "text": "Une question de détail faillit les arrêter, ils n’avaient pas de balles ; mais ils décidèrent qu’ils chargeraient leurs armes avec du plomb à perdrix, ce qui même était inutile, puisqu’ils ne devaient rencontrer aucune résistance."
                                            },
                                            {
                                                "example_id": "f7f458cb-4a4d-47f2-a48b-536dd8e31080",
                                                "sense_id": "6a42843b-ac92-3821-8a60-06501a081a8c",
                                                "text": "C’étaient des volatiles appartenant à l’espèce des perdrix, et auxquels les dénominations zoologiques ne manquent pas."
                                            },
                                            {
                                                "example_id": "98260cc0-41c0-42b5-a3b3-680abb527112",
                                                "sense_id": "6a42843b-ac92-3821-8a60-06501a081a8c",
                                                "text": "Car la région que nous traversons est assez giboyeuse, et les grands nemrods de la m'halla, […], qui ont emmené des meutes de lévriers et des faucons chasseurs, font des hécatombes de lièvres, de perdrix, de poules de Carthage, de renards et de chacals."
                                            },
                                            {
                                                "example_id": "6012ff1b-a646-4039-abc2-099ee337bf9d",
                                                "sense_id": "6a42843b-ac92-3821-8a60-06501a081a8c",
                                                "text": "La bartavelle, c'est la perdrix royale, et plus royale que perdrix, car elle est énorme et rutilante. En réalité, c'est presque un coq de bruyère."
                                            },
                                            {
                                                "example_id": "87468270-b483-4519-8419-aeae7b2af5c9",
                                                "sense_id": "6a42843b-ac92-3821-8a60-06501a081a8c",
                                                "text": "Cette perdrix n'est pas la Caccabis Rufa, qui est beaucoup plus petite. C'est la Caccabis Saxatilis, c'est-à-dire la perdrix des roches, qu'on appelle aussi la perdrix grecque, et en Provence, la bartavelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d26ab5e2-8be9-38da-a364-8a244f4d136c",
                                        "entry_id": "50f53e5e-d8cd-3c29-ae5f-ee7900c77b39",
                                        "glosses": [
                                            "Nom donné à diverses autres espèces d’oiseaux pouvant rappeler les perdrix proprement dites."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d041758-41f3-4473-929a-6d4d024bf83e",
                                                "sense_id": "d26ab5e2-8be9-38da-a364-8a244f4d136c",
                                                "text": "Maintenant, laisse-moi partir seule… Il ne faut pas qu'on nous voie ensemble… » Puis, sans rien ajouter, comme une perdrix qui se lève sous le pied du chasseur, elle s'échappa et disparut dans le détour des chenaux, vers le grand chemin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f27dea3-5507-3c82-b641-968275a23afa",
                                        "entry_id": "50f53e5e-d8cd-3c29-ae5f-ee7900c77b39",
                                        "glosses": [
                                            "Nom donné à diverses autres espèces d’oiseaux pouvant rappeler les perdrix proprement dites.",
                                            "Nom donné familièrement à la gélinotte huppée (Bonasa umbellus) au Canada français, et dont l'origine remonte aux débuts de la Nouvelle-France."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial",
                                            "common"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c18eace-b93a-30a9-a6ec-b57aff1b688d",
                                        "entry_id": "50f53e5e-d8cd-3c29-ae5f-ee7900c77b39",
                                        "glosses": [
                                            "Viande de perdrix."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
