                "senses": [
                    {
                        "sense_id": "10e60b3f-c4f9-3e2c-90f3-e284df59ce69",
                        "entry_id": "4acd9cff-0f4b-365b-92f1-1340ef19a79f",
                        "glosses": [
                            "Défaire fil à fil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dc1e0dc-711d-4064-a5c1-cffa15ce7a25",
                                "sense_id": "10e60b3f-c4f9-3e2c-90f3-e284df59ce69",
                                "text": "Et vous qui avez parfilé la soie de ma vie, ô femmes!"
                            },
                            {
                                "example_id": "618d4cfa-07b1-4fb3-877d-b0d8c64ae1a4",
                                "sense_id": "10e60b3f-c4f9-3e2c-90f3-e284df59ce69",
                                "text": "Cette femme passait son temps à parfiler."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9b5c02e-7a5e-3060-a543-b0eed7324f22",
                        "entry_id": "4acd9cff-0f4b-365b-92f1-1340ef19a79f",
                        "glosses": [
                            "Tisser avec des fils en métal précieux, comme l’or ou l’argent."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "15dcba20-22ba-4443-a15f-22ae60f96233",
                                "sense_id": "e9b5c02e-7a5e-3060-a543-b0eed7324f22",
                                "text": "En effet, la musique et les enchantements de la scène sont purement accessoires, le grand intérêt est dans les conversations qui s’y tiennent, dans les grandes petites affaires de cœur qui s’y traitent, dans les rendez-vous qui s’y donnent, dans les récits et les observations qui s’y parfilent."
                            }
                        ]
                    },
