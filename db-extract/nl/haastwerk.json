                                        "examples": [
                                            {
                                                "example_id": "f793a7b3-19cb-487b-b5de-22138d01b898",
                                                "sense_id": "6e08b1d7-5358-37f1-a8ba-8617218b630e",
                                                "text": "\"Rush job?\"\n\"Yes, sir. You'll have to excuse me. I've got to get started.\""
                                            },
                                            {
                                                "example_id": "00e6a76e-5d98-45f6-836d-57f3f08af72e",
                                                "sense_id": "6e08b1d7-5358-37f1-a8ba-8617218b630e",
                                                "text": "\"[W]hen they called me for a rush job, there wasn't enough time to sign an agreement, nor did I think it necessary.\""
                                            },
                                            {
                                                "example_id": "2531d826-9dce-4250-be77-44b4df738dda",
                                                "sense_id": "6e08b1d7-5358-37f1-a8ba-8617218b630e",
                                                "text": "[T]he production values are excellent and there are no obvious signs of it having been a rush job."
                                            }
