                        "glosses": [
                            "Having no extremes or limits; infinite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0eaa33a-1956-4cd6-9057-846a0e1c21c2",
                                "sense_id": "dd463bc6-8a94-36a4-98d2-e8e32697638f",
                                "text": "Hence Chautsz' merely spoke of the extremeless, or illimitable."
                            },
                            {
                                "example_id": "b354a5f5-adfa-46c9-90d7-6762d1313001",
                                "sense_id": "dd463bc6-8a94-36a4-98d2-e8e32697638f",
                                "text": "The auspicious farman has acquired the honour of being issued that Mashhur-ud-Dawla (famous in the Sovereignty) Yashawantarao, being strengthened and hopeful by the extremeless imperial kindnesses, may know that the Nawab with (a court worthy of the angles) the thresholds as high as the sky-having the Magnanimity of the sky,"
                            },
                            {
                                "example_id": "2454536f-9fd3-4456-99a3-1673fd8ec89a",
                                "sense_id": "dd463bc6-8a94-36a4-98d2-e8e32697638f",
                                "text": "If you have not meditated enough to have had at least some glimpse of this ineffable, extremeless state of mind, some warmth of that experience yourself, you are not yet a true Sakya practitioner."
                            }
                        ]
                    }
