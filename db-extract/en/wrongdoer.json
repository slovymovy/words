                    },
                    {
                        "translation_id": "7b8f5dc6-451f-4d2e-bb1a-37735d8c23a4",
                        "source_entry_id": "574cb1d8-2c6e-307a-8dd2-853955eb559d",
                        "source_sense_id": "422408eb-cdf3-333a-9698-e246e47d7536",
                        "source_sense_description": "someone who does wrong",
                        "target_lang_word": "Abweichler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abweichler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "46385aac-95b0-3e63-a3fe-95d5a71fd446",
                                        "entry_id": "8eb42cb6-e090-338e-8754-2ee0abc7abc7",
                                        "glosses": [
                                            "Andersdenkender in einem auf Linientreue ausgerichteten System"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7cf331b-31c3-476a-91ab-2f23f71d9fe6",
                                                "sense_id": "46385aac-95b0-3e63-a3fe-95d5a71fd446",
                                                "text": "Der Fraktionsvorsitzende ging mit den Abweichlern hart ins Gericht."
                                            },
                                            {
                                                "example_id": "d8ac76b3-9413-4138-9f15-3a9ff70926fb",
                                                "sense_id": "46385aac-95b0-3e63-a3fe-95d5a71fd446",
                                                "text": "„Ein wesentlicher Teil der gesetzgeberischen Tätigkeit betraf die Religionspolitik, weil angesichts der vielen Abweichler der Bedarf an Einheitlichkeit besonders groß war.“"
                                            },
                                            {
                                                "example_id": "310cdc6f-2bdd-4ee1-b87c-1c80c1c6e131",
                                                "sense_id": "46385aac-95b0-3e63-a3fe-95d5a71fd446",
                                                "text": "„Abweichler haben das Land verlassen oder befinden sich hinter Gittern.“"
                                            },
                                            {
                                                "example_id": "12af4494-afa5-4ddd-86fa-62736cc4e95e",
                                                "sense_id": "46385aac-95b0-3e63-a3fe-95d5a71fd446",
                                                "text": "„Man muss bedenken, welche Sanktionen Abweichlern von der Linie des Nationalsozialismus drohten.“"
                                            },
                                            {
                                                "example_id": "09b51722-1d02-4904-96ba-31f73de810e8",
                                                "sense_id": "46385aac-95b0-3e63-a3fe-95d5a71fd446",
                                                "text": "„Mit seinen Ausführungen gab er die Richtung vor, in die sich die Partei innerhalb kurzer Zeit tatsächlich entwickeln sollte, nämlich zu einer straff geführten, von Konformismus geprägten, undemokratischen Organisation, die von oben kontrolliert wurde und Abweichler bestrafte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
