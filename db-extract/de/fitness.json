                    }
                ],
                "senses": [
                    {
                        "sense_id": "1fc8acae-6ba2-3fb6-af18-55acaec192c7",
                        "entry_id": "0c07f0ef-5fc4-3863-a801-fcb935dc55a9",
                        "glosses": [
                            "körperliches und geistiges Wohlbefinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ece9944c-1c0b-4ded-9cb6-5015398c14c5",
                                "sense_id": "1fc8acae-6ba2-3fb6-af18-55acaec192c7",
                                "text": "Seine körperliche Fitness war so gut, dass er den Marathon in persönlicher Bestzeit lief."
                            },
                            {
                                "example_id": "e7e1daf1-4a7f-4c81-9a9d-6d699346bf9b",
                                "sense_id": "1fc8acae-6ba2-3fb6-af18-55acaec192c7",
                                "text": "„Der jüdische Arzt und Zionist Max Nordau begegnete diesem Vorurteil 1899 mit dem Konzept des ‚Muskeljudentums‘ und rief dazu auf, die körperliche Fitness der Juden durch Turnen zu fördern.“"
                            },
                            {
                                "example_id": "8185b999-a4ea-4aa1-afea-8259bb24d985",
                                "sense_id": "1fc8acae-6ba2-3fb6-af18-55acaec192c7",
                                "text": "„Dafür sind körperliche Fitness, Trittsicherheit und ein guter Orientierungssinn notwendig, denn Wanderwegmarkierungen und Wegweiser gibt es hier fast keine.“"
                            },
                            {
                                "example_id": "73a78f5a-cf42-4e33-895d-71153718536e",
                                "sense_id": "1fc8acae-6ba2-3fb6-af18-55acaec192c7",
                                "text": "„Drachenfliegen ist eine anspruchsvolle, dynamische Flugsportart. Sie erfordert überdurchschnittlich gute körperliche Fitness und regelmäßiges Training.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d79dcbc2-d0bc-395c-bc81-9a8ba369570d",
                        "entry_id": "0c07f0ef-5fc4-3863-a801-fcb935dc55a9",
                        "glosses": [
                            "Grad der erfolgreichen Anpassung an den Selektionsdruck in einer Population"
                        ],
                        "tags": [
                            "Genetik"
                        ],
                        "examples": [
                            {
                                "example_id": "8ed40401-c2c3-4331-9d35-3566234a6a91",
                                "sense_id": "d79dcbc2-d0bc-395c-bc81-9a8ba369570d",
                                "text": "„Die Befunde sprechen schon dafür, dass diese Variante eine besondere Fitness hat und sich im Hinblick auf den Menschen als Wirt noch besser angepasst hat.“"
                            },
                            {
                                "example_id": "7f5449df-6d7a-4e32-9bd3-07cfabfa796e",
                                "sense_id": "d79dcbc2-d0bc-395c-bc81-9a8ba369570d",
                                "text": "„Bei der Evolution einer Population sammeln sich nach und nach vorteilhafte Mutationen an. Dabei erhöht sich die Fitness der Population, bis sich alle vorteilhaften Mutationen durchgesetzt haben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e48ee59b-a382-430c-aa8c-b2e37e55094d",
                        "source_entry_id": "0c07f0ef-5fc4-3863-a801-fcb935dc55a9",
                        "source_sense_id": "1fc8acae-6ba2-3fb6-af18-55acaec192c7",
