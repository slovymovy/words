                "forms": [],
                "senses": [
                    {
                        "sense_id": "3ae7ca34-a5b6-3dc8-8324-37bc0148cbce",
                        "entry_id": "90ed96a9-ed71-3611-bf02-8b6b5ce2135b",
                        "glosses": [
                            "Pédopsychiatrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0159dcf-7885-455e-98cc-0179b1f8c56a",
                                "sense_id": "3ae7ca34-a5b6-3dc8-8324-37bc0148cbce",
                                "text": "Quand je faisais de la pédopsy aux Antilles, je ne comprenais rien : ni la langue, le créole, la seule langue que les enfants en âge préscolaire parlaient en famille, ni la culture, celle de l’esclave qui développait une méfiance préalable à tout ce qui avait peau blanche, ni la moindre idée du contexte socio-familial, qui vivait avec qui et pourquoi."
                            },
                            {
                                "example_id": "99f0f9f8-dfb9-427f-9c7d-91b18cb68eb9",
                                "sense_id": "3ae7ca34-a5b6-3dc8-8324-37bc0148cbce",
                                "text": "Une dernière fois, je vais transmettre ce travail que j’aurai tissé de la pédopsy à la néonat, ce travail que j’aurai tant aimé !"
                            }
                        ]
                    },
                    {
                        "sense_id": "95e4dad3-4521-3dc9-879d-aa7224f38eb7",
                        "entry_id": "90ed96a9-ed71-3611-bf02-8b6b5ce2135b",
                        "glosses": [
                            "Service de pédopsychiatrie d’un établissement hospitalier."
                        ],
