                        "glosses": [
                            "Qualité de ce qui est altérable ; propension à s’altérer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12e485ad-0bc8-4679-a478-2f71adc8dc90",
                                "sense_id": "7e5da63d-2a30-3146-afef-327d624708ab",
                                "text": "L’altérabilité des roches se manifeste soit par simple désagrégation, soit par décomposition, soit par une haute température naturelle."
                            },
                            {
                                "example_id": "51ee4f3b-bf78-4c81-8123-ae2b2f842e2e",
                                "sense_id": "7e5da63d-2a30-3146-afef-327d624708ab",
                                "text": "Ainsi, nous nʼavons pas encore tenu compte des phénomènes dʼaltérabilité et des phénomènes de vieillissement"
                            }
                        ]
                    }
