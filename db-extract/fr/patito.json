                "entry_id": "2f56ee25-6eb0-300c-8732-426a0a1283a9",
                "word": "patito",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9a41a518-1855-4d8f-99e7-1217cf466391",
                        "entry_id": "2f56ee25-6eb0-300c-8732-426a0a1283a9",
