                ],
                "senses": [
                    {
                        "sense_id": "51374222-f530-3534-8c24-5aab70f004a4",
                        "entry_id": "65cb1024-9276-3855-9d33-42c1d79dd361",
                        "glosses": [
                            "церк. духовенство какой-либо церкви или прихода"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d99d140-d7b5-4440-b6b4-8506bbf8b273",
                                "sense_id": "51374222-f530-3534-8c24-5aab70f004a4",
                                "text": "Для того чтобы принять определённое решение, РПЦ необходимо опереться на единое мнение клира и паствы."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb25e9b7-dcd4-3446-93d1-2b0c5ea95744",
                        "entry_id": "65cb1024-9276-3855-9d33-42c1d79dd361",
                        "glosses": [
                            "церк. то же, что клирос; певчие в церкви"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0530b804-7107-4958-bd48-60c7bfc69a6d",
                                "sense_id": "fb25e9b7-dcd4-3446-93d1-2b0c5ea95744",
                                "text": "В свежем воздухе весело звенькали, трезвонили, бу́хали колокола, клир дружно и уверенно пел церковную стихиру .."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7537d5ad-c902-49a3-a4c3-3c5175a71d7a",
                        "source_entry_id": "65cb1024-9276-3855-9d33-42c1d79dd361",
                        "source_sense_description": "духовенство церкви или прихода",
                        "target_lang_word": "clergy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clergy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81e487eb-aaf2-3550-9989-f86cdc3f03ce",
                                        "entry_id": "cc1e08c5-076a-3234-9ae1-f1bd7030ddee",
                                        "glosses": [
                                            "Body of persons, such as priests, who are trained and ordained for religious service."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77aaf779-7ba3-47f8-9dc3-9a00667cc8d1",
                                                "sense_id": "81e487eb-aaf2-3550-9989-f86cdc3f03ce",
                                                "text": "Today we brought together clergy from the Anglican, Catholic, Orthodox, and Reformed traditions for ecumenical dialogue."
                                            },
                                            {
                                                "example_id": "2f187d88-5e73-4bfb-b681-34cbead7535f",
                                                "sense_id": "81e487eb-aaf2-3550-9989-f86cdc3f03ce",
                                                "text": "Then everybody once more knelt, and soon the blessing was pronounced. The choir and the clergy trooped out slowly, […], down the nave to the western door. […] At a seemingly immense distance the surpliced group stopped to say the last prayer."
                                            },
                                            {
                                                "example_id": "96430d3d-328a-41f4-9071-5709c087df34",
                                                "sense_id": "81e487eb-aaf2-3550-9989-f86cdc3f03ce",
                                                "text": "After years of debate, hundreds of United Methodists from all over the world gathered in St. Louis last week to settle the denomination’s stance on LGBT clergy and same-sex weddings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf6ce8b4-e1f3-4c9d-81e4-d305680ef984",
                        "source_entry_id": "65cb1024-9276-3855-9d33-42c1d79dd361",
                        "source_sense_description": "духовенство церкви или прихода",
                        "target_lang_word": "Klerus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klerus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "132bb2e6-08f2-332d-9db8-08124e1472fe",
                                        "entry_id": "6fef1487-e474-36e7-afe0-739033e3fd36",
                                        "glosses": [
                                            "die Gesamtheit der Geistlichen (Kleriker)"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33806e0f-e1aa-432f-8947-0d9f39183d24",
                                                "sense_id": "132bb2e6-08f2-332d-9db8-08124e1472fe",
                                                "text": "„Dies zeigt, daß im fünfzehnten und vielerorts schon im vierzehnten Jahrhundert die Beherrschung der Schrift keineswegs mehr auf den Klerus beschränkt, sondern im Bürgertum verbreitet war.“"
                                            },
                                            {
                                                "example_id": "c5532feb-9fca-411d-bfb6-345756e2b6d4",
                                                "sense_id": "132bb2e6-08f2-332d-9db8-08124e1472fe",
                                                "text": "„Am nächsten Tag mußte er ein Pontifikalamt zelebrieren, und dabei sah ich seinen gesamten Klerus und auch die Frauen und Männer, die seine Kirche füllten.“"
                                            },
                                            {
                                                "example_id": "573fac2c-146e-4a49-b36b-7818270d054c",
                                                "sense_id": "132bb2e6-08f2-332d-9db8-08124e1472fe",
                                                "text": "„Sicherlich gilt er zum guten Teil vor allem der katholischen Kirche, insbesondere dem Klerus seiner Zeit, als dessen wenig würdigen Vertreter der Marquis ja schon in früher Jugend den Abbé de Sade, seinen Onkel und Erzieher, kennengelernt hatte.“"
                                            },
                                            {
                                                "example_id": "8fe28a2c-0f08-4bba-84f3-658b9ae893b6",
                                                "sense_id": "132bb2e6-08f2-332d-9db8-08124e1472fe",
                                                "text": "„Der Klerus regiert nicht, hat aber Einfluss, mal mehr, mal weniger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d029d1f-c925-4c42-93fd-5ed8d316421b",
                        "source_entry_id": "65cb1024-9276-3855-9d33-42c1d79dd361",
                        "source_sense_description": "духовенство церкви или прихода",
                        "target_lang_word": "Kirchendiener",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kirchendiener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "016e6105-9756-3009-9ab7-216b825904d3",
                                        "entry_id": "1aa85c22-1252-323b-9c2e-130dead7fd61",
                                        "glosses": [
                                            "jemand, der angestellt ist, um kirchliche Belange zu unterstützen (Organisation der Gottesdienste, Pflege des Gotteshauses, ...)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1332092-a53e-4362-a5d9-2c8f6ee48d26",
                                                "sense_id": "016e6105-9756-3009-9ab7-216b825904d3",
                                                "text": "„Bisher hatten sie weder Schullehrer noch Kirchendiener hervorgebracht.“"
                                            },
                                            {
                                                "example_id": "76da83f0-2d77-4c7e-bc5f-72b0f2facb9c",
                                                "sense_id": "016e6105-9756-3009-9ab7-216b825904d3",
                                                "text": "„Ein Lakai und ein Kirchendiener mit einem Räucherfass kamen ihnen auf den Zehenspitzen entgegen, ohne sie aber zu beachten.“"
                                            },
                                            {
                                                "example_id": "28f2a2f0-d440-4919-a985-7a4df52a9f95",
                                                "sense_id": "016e6105-9756-3009-9ab7-216b825904d3",
                                                "text": "„Sogar ein einfacher Kirchendiener darf dieses Ritual ausführen.“"
                                            },
                                            {
                                                "example_id": "967658d5-f482-451a-b041-e8c13ee36968",
                                                "sense_id": "016e6105-9756-3009-9ab7-216b825904d3",
                                                "text": "„Mit Jesaja in seinem Sarg ist eine Trauergemeinde hierhergekommen, die aus den Bekannten von Juliane, die sie jetzt stützen, aus dem Pastor und dem Kirchendiener, dem Mechaniker und einer kleinen Gruppe von Dänen besteht, von denen ich nur den amtlichen Pfleger und den Assessor erkenne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
