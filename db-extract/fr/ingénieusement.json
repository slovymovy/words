        "fr-extract.jsonl": [
            {
                "entry_id": "9e4a3865-4f01-363c-bdcd-59dd1153a3a1",
                "word": "ingénieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f4e56273-46f1-312a-8fd1-d6be225f89b9",
                        "entry_id": "9e4a3865-4f01-363c-bdcd-59dd1153a3a1",
                        "glosses": [
                            "D’une manière ingénieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e34414a-e544-4990-8179-70e278974e6c",
                                "sense_id": "f4e56273-46f1-312a-8fd1-d6be225f89b9",
                                "text": "Les poëmes d’Homère sont remplis de fictions qui, sous l’enveloppe d’une fable ingénieusement inventée […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a4fae49-d799-46ba-9250-7563dfd1997b",
                        "source_entry_id": "9e4a3865-4f01-363c-bdcd-59dd1153a3a1",
                        "source_sense_id": "f4e56273-46f1-312a-8fd1-d6be225f89b9",
                        "target_lang_word": "cleverly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cleverly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c3a9f94-e9ea-30f5-ac7d-d6045f012c0b",
                                        "entry_id": "0553d054-b61a-38a9-ab12-c14f08753cb8",
                                        "glosses": [
                                            "Wittily; in a tricky manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38b15569-0d3e-4c3e-8cec-ff9a7c4ea8b2",
                                                "sense_id": "1c3a9f94-e9ea-30f5-ac7d-d6045f012c0b",
                                                "text": "He joked cleverly with each guest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32a98c9a-90c5-3e47-86a0-6635aeff4dbf",
                                        "entry_id": "0553d054-b61a-38a9-ab12-c14f08753cb8",
                                        "glosses": [
                                            "Intelligently directed to a purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "862bacc5-a169-4a1b-b82f-44193d2c6482",
                                                "sense_id": "32a98c9a-90c5-3e47-86a0-6635aeff4dbf",
                                                "text": "Cleverly, he found ways of ingratiating himself with all the important guests."
                                            },
                                            {
                                                "example_id": "689015ea-95f8-4dc3-8758-c07a8673aeb6",
                                                "sense_id": "32a98c9a-90c5-3e47-86a0-6635aeff4dbf",
                                                "text": "The double world champion quickly closed on to the rear of the Williams, but Maldonado drove cleverly to ensure he was always far enough ahead at the start of the pit straight to ensure Alonso could not pass him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44891819-a2f9-347c-ab40-8c467d594372",
                                        "entry_id": "0553d054-b61a-38a9-ab12-c14f08753cb8",
                                        "glosses": [
                                            "Completely, fully."
                                        ],
                                        "tags": [
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e13107b-05a0-4cd7-bce9-cca7708b2b85",
                                                "sense_id": "44891819-a2f9-347c-ab40-8c467d594372",
                                                "text": "“I ain't a-goin' ter let leetle Mose be kep' up hyar till midnight a-waitin' for you-uns ter milk the cow. It's cleverly dark now.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30a05467-2429-4689-b445-9707d58ef6dd",
                        "source_entry_id": "9e4a3865-4f01-363c-bdcd-59dd1153a3a1",
                        "source_sense_id": "f4e56273-46f1-312a-8fd1-d6be225f89b9",
                        "target_lang_word": "ingeniously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingeniously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfdf4a80-83cb-350e-a714-b44c4d749426",
                                        "entry_id": "1f1743f9-57d9-31ff-be9e-ad3378e720c5",
                                        "glosses": [
                                            "In an ingenious manner; using ingenuity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "456f45c5-6c22-436c-b750-f18611a57c26",
                                                "sense_id": "cfdf4a80-83cb-350e-a714-b44c4d749426",
                                                "text": "Nefzawi, rather ingeniously, offers numerous fantastic explanations and interpretations of dream sequences in The Perfumed Garden."
                                            },
                                            {
                                                "example_id": "c0320d25-f78e-4f9b-b1a0-b7c71c6286e0",
                                                "sense_id": "cfdf4a80-83cb-350e-a714-b44c4d749426",
                                                "text": "The exterior of the train is perfectly air-smoothed and to cut passenger steps up to recessed doors would never do; when the deep doors are shut, therefore, the steps fold up ingeniously on the inside of them to create a level floor in the corridor of the coach."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51e88220-8a40-416d-89bf-3d95ef643186",
                        "source_entry_id": "9e4a3865-4f01-363c-bdcd-59dd1153a3a1",
