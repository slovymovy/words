                                "target_senses": [
                                    {
                                        "sense_id": "00f012c5-7c66-35c7-a944-fbe401049180",
                                        "entry_id": "e137c13c-7a76-3aac-96b5-ad040f31fec8",
                                        "glosses": [
                                            "A humanoid or apelike animal said to exist in the Himalayas."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca9da8f-96b3-43f9-9c7b-1d67edb6dfd2",
                                                "sense_id": "00f012c5-7c66-35c7-a944-fbe401049180",
                                                "text": "The Abominable Snowman – existing and not existing, flickering at the edges of blizzards, apelike man or manlike ape, stealthy, elusive, known only through rumours and through its backward-pointing footprints."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
