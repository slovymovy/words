                        "entry_id": "8a62dbea-ed03-3dd4-8ed1-0e3895d6f720",
                        "glosses": [
                            "dicker Bauch, der in starkem ästhetischen Gegensatz zum sonstigen Körperbau steht und deshalb besonders auffällt"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "999f8f5c-9408-41fd-b119-f38e4b739a05",
                                "sense_id": "fc9f8564-624d-336e-8e87-6f08ae0dce22",
                                "text": "Mann, der hat aber 'ne Plauze!"
                            },
                            {
                                "example_id": "18ec50e4-4f70-4fad-a7af-86118eab521b",
                                "sense_id": "fc9f8564-624d-336e-8e87-6f08ae0dce22",
                                "text": "„Ihre am Strand in den Himmel ragenden Plauzen sind – wie die Betonklötze hinter ihnen – gewiss Zeichen mustergültigen Wachstums.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
