                "senses": [
                    {
                        "sense_id": "f3eaa68a-e1bc-3bcd-ae1b-94cb1a837067",
                        "entry_id": "d0b2c8bf-7820-3255-847e-fea84c4d1cab",
                        "glosses": [
                            "Donner un caractère cachectique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9bb4cc6-67ea-4589-9e10-3a4ac39701b5",
                                "sense_id": "f3eaa68a-e1bc-3bcd-ae1b-94cb1a837067",
                                "text": "La suppuration est à redouter, lorsqu’elle se développe sur un organe essentiel à la vie ; à l’extérieur, elle peut épuiser et cachectiser la constitution par sa trop grande durée."
                            },
                            {
                                "example_id": "8f1777d2-ef20-44b2-a680-c85e30766adf",
                                "sense_id": "f3eaa68a-e1bc-3bcd-ae1b-94cb1a837067",
                                "text": "Mais, en répétant les inoculations, on voit l’animal privé d’épiploon maigrir et se cachectiser ;"
                            }
                        ]
                    }
                ],
