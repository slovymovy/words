                                            {
                                                "example_id": "7ee143b6-f4db-44fa-af68-b7228f35d5d1",
                                                "sense_id": "6a7acb98-da00-3eab-a15f-6a9fc901bb18",
                                                "text": "Ik zat even te zonnen in het voorjaarszonnetje."
                                            },
                                            {
                                                "example_id": "b148f178-5303-47da-8d28-a5057ad99c5c",
                                                "sense_id": "6a7acb98-da00-3eab-a15f-6a9fc901bb18",
                                                "text": "Midden op het pad lag een reusachtige ratelslang te zonnen, de koningin van de woestijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2bd116b-4de8-3be2-914b-a596c5d9c15a",
                                        "entry_id": "998cfdc0-69f7-31f8-9e48-01fea73a1a5e",
                                        "glosses": [
                                            "licht en warm worden door zonnestraling, het schijnen van de zon"
                                        ],
