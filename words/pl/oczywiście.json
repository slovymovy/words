                    "sense_id": "0f092173-df93-340f-b36f-e803025befea",
                    "sense_definition": "Słowo używane w zdaniu do podkreślenia, że to, o czym się mówi, jest pewne, bezsporne lub zrozumiałe samo przez się.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Oczywiście</w> zapomniałem parasola i zmokłem w drodze do domu.",
                            "target_lang_translations": {
                                "ru": "<w>Конечно</w>, я забыл зонт и промок по дороге домой.",
                                "en": "<w>Of course</w>, I forgot my umbrella and got wet on the way home.",
                                "nl": "<w>Natuurlijk</w> was ik mijn paraplu vergeten en werd ik nat op weg naar huis.",
                                "de": "<w>Natürlich</w> habe ich meinen Regenschirm vergessen und bin auf dem Heimweg nass geworden.",
                                "fr": "<w>Évidemment</w>, j'ai oublié mon parapluie et j'ai été trempé sur le chemin du retour.",
                                "it": "<w>Ovviamente</w> ho dimenticato l'ombrello e mi sono bagnato tornando a casa.",
                                "cs": "<w>Samozřejmě</w> jsem zapomněl deštník a cestou domů jsem zmokl.",
                                "tr": "<w>Doğal olarak</w> şemsiyemi unuttum ve eve giderken ıslandım.",
                                "es": "<w>Evidentemente</w>, olvidé el paraguas y me mojé de camino a casa.",
                                "zh": "<w>当然</w>，我忘了带伞，结果在回家的路上淋湿了。"
                            }
                        },
                        {
                            "text": "To jest <w>oczywiście</w> tylko moja prywatna opinia.",
                            "target_lang_translations": {
                                "ru": "Это, <w>конечно</w>, лишь мое частное мнение.",
                                "en": "This is, <w>of course</w>, only my private opinion.",
                                "nl": "Dit is <w>uiteraard</w> slechts mijn persoonlijke mening.",
                                "de": "Das ist <w>natürlich</w> nur meine private Meinung.",
                                "fr": "C'est <w>évidemment</w> seulement mon opinion personnelle.",
                                "it": "Questa è <w>ovviamente</w> solo la mia opinione personale.",
                                "cs": "To je <w>samozřejmě</w> jen můj soukromý názor.",
                                "tr": "Bu <w>elbette</w> sadece benim şahsi fikrim.",
                                "es": "Esta es, <w>obviamente</w>, solo mi opinión privada.",
                                "zh": "这<w>当然</w>只是我个人的观点。"
                            }
                        }
