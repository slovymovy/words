{
    "word_family": [
        "souscription",
        "souscripteur",
        "souscriptrice"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f85699b-d301-398d-8c44-8fee3029f7d1",
                    "sense_definition": "Signer un acte, un contrat ou un document pour contracter un engagement officiel ou bénéficier d'un service.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "engagement_contractuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir en voyage, il a décidé de <w>souscrire</w> une assurance médicale complète."
                        },
                        {
                            "text": "Vous devez lire attentivement toutes les conditions avant de <w>souscrire</w> ce contrat."
                        }
                    ],
                    "synonyms": [
                        "contracter",
                        "signer"
                    ],
                    "common_phrases": [
                        "souscrire une assurance",
                        "souscrire un contrat",
                        "souscrire un prêt"
                    ]
                },
                {
                    "sense_id": "c2ca2a04-0b72-3548-a5b0-502439f46c9e",
                    "sense_definition": "Donner son plein accord ou son approbation à une idée, une décision ou une proposition formulée par autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accord_intellectuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne peux pas <w>souscrire</w> à cette décision sans obtenir des explications claires."
                        },
                        {
                            "text": "Toute l'équipe a choisi de <w>souscrire</w> pleinement à cette nouvelle proposition."
                        }
                    ],
                    "synonyms": [
                        "adhérer",
                        "approuver",
                        "consentir"
                    ],
                    "antonyms": [
                        "refuser",
                        "rejeter",
                        "s'opposer"
                    ],
                    "common_phrases": [
                        "souscrire à une idée",
                        "souscrire à une proposition",
                        "souscrire pleinement"
                    ]
                },
                {
                    "sense_id": "a494ec79-7655-3deb-a403-69ad55308d0a",
                    "sense_definition": "S'engager à verser une somme d'argent pour une œuvre de bienfaisance, une entreprise collective ou une souscription publique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "contribution_financiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs habitants ont accepté de <w>souscrire</w> pour financer la rénovation du village."
                        },
                        {
                            "text": "Chacun des membres a pu <w>souscrire</w> une somme modeste pour soutenir le projet."
                        }
                    ],
                    "synonyms": [
                        "contribuer",
                        "cotiser"
                    ],
                    "common_phrases": [
                        "souscrire pour une somme",
                        "souscrire à une collecte"
                    ]
                },
                {
                    "sense_id": "64d4f8a7-b01f-3912-98b9-7c430ed2f2ed",
                    "sense_definition": "S'engager par avance à acheter un ou plusieurs exemplaires d'un livre ou d'un ouvrage avant sa parution.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "edition_et_publication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux lecteurs passionnés ont choisi de <w>souscrire</w> à cette édition spéciale."
                        },
                        {
                            "text": "L'éditeur propose aux lecteurs de <w>souscrire</w> avant la date limite d'impression."
                        }
                    ],
                    "synonyms": [
                        "s'abonner"
                    ],
                    "common_phrases": [
                        "souscrire à une publication"
                    ]
                },
                {
                    "sense_id": "83faf1ae-da82-3f89-8312-581d7dce0acc",
                    "sense_definition": "S'engager formellement à acquérir une part déterminée d'un emprunt public ou de titres financiers émis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marche_financier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les investisseurs ont été nombreux à <w>souscrire</w> au nouvel emprunt public."
                        },
                        {
                            "text": "La banque a encouragé ses clients à <w>souscrire</w> à ces obligations récentes."
                        }
                    ],
                    "synonyms": [
                        "investir"
                    ],
                    "common_phrases": [
                        "souscrire un emprunt",
                        "souscrire à des obligations"
                    ]
                }
            ]
        }
    ]
}