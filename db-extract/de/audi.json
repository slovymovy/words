                ],
                "senses": [
                    {
                        "sense_id": "f245feb9-4d43-3bae-964f-0b094309a82d",
                        "entry_id": "62e6f3b9-43da-39fd-9924-6af3234d7fc9",
                        "glosses": [
                            "deutscher Fahrzeughersteller mit Hauptsitz in Ingolstadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93ba2da7-6072-4a25-91b9-4f6be93fe876",
                                "sense_id": "f245feb9-4d43-3bae-964f-0b094309a82d",
                                "text": "„„Vorsprung durch Technik“, so lautet der Werbeslogan von Audi.“"
                            },
                            {
                                "example_id": "1d1d6f43-af11-47f6-aaca-9d97286effae",
                                "sense_id": "f245feb9-4d43-3bae-964f-0b094309a82d",
                                "text": "„Nicht nur Audi, die gesamte Autowelt hat sich seit Beginn des Jahrtausends verändert.“"
                            },
                            {
                                "example_id": "d218ff2c-3c7f-40d9-bf21-13969b8f61dc",
                                "sense_id": "f245feb9-4d43-3bae-964f-0b094309a82d",
                                "text": "„Der Gesamtabsatz hat sich fast verdreifacht, und aus rund 650 000 verkauften Audi wurden 1,6 Millionen.“"
                            },
                            {
                                "example_id": "929856e9-5795-4053-b9af-dec5d0cb9c58",
                                "sense_id": "f245feb9-4d43-3bae-964f-0b094309a82d",
                                "text": "„Es war heute schwer, eine perfekte Strategie zu finden, denn es waren einfach zu viele Audi um mich herum.“"
                            },
                            {
                                "example_id": "cd01f0a7-cbeb-4883-8b94-374c825cad1c",
                                "sense_id": "f245feb9-4d43-3bae-964f-0b094309a82d",
                                "text": "„Im vorderen Teil des Zuges hatte der Zug zudem mehrere Audi geladen.“"
                            },
                            {
                                "example_id": "cc744487-07f0-471e-a311-d3ca4f10dae8",
                                "sense_id": "f245feb9-4d43-3bae-964f-0b094309a82d",
                                "text": "„Mit Timo Scheider und Edoardo Mortara folgten zwei weitere Audi auf den Plätzen fünf und sechs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
