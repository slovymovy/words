                    },
                    {
                        "translation_id": "e97cc966-7e24-423d-81f2-9750928d8cc0",
                        "source_entry_id": "8d28c1a9-21cf-396c-b2c3-d3bc3d732da5",
                        "source_sense_id": "926e976a-a1a8-3310-bbe2-75632cbfa144",
                        "source_sense_description": "state or characteristic of drunkenness",
                        "target_lang_word": "Trunkenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trunkenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd9faf6c-7f7c-33b7-a6b8-ec109212e325",
                                        "entry_id": "db0c3eee-2e50-3940-bbf6-040e85ecc18c",
                                        "glosses": [
                                            "Zustand nach dem übermäßigen Konsum alkoholhaltiger Getränke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24032876-19c6-4ce9-af7a-aecc25b3a85c",
                                                "sense_id": "fd9faf6c-7f7c-33b7-a6b8-ec109212e325",
                                                "text": "„Ich kann jedoch nicht sagen, ich hätte ihre Trunkenheit mißbraucht, denn in ihrer starken Sinnlichkeit kam sie allen Genüssen, zu denen ich sie bis zwei Uhr morgens anspornte, bereitwillig entgegen, bis wir beide nicht mehr konnten und uns trennten.“"
                                            },
                                            {
                                                "example_id": "1fa49106-ffc2-4565-b1df-e81e931a8344",
                                                "sense_id": "fd9faf6c-7f7c-33b7-a6b8-ec109212e325",
                                                "text": "„Ganz oben am Pyramidion wird dargestellt, wie der Pharao den Göttern Wein, der göttliche Trunkenheit herbeiführt, oder reinigendes Wasser opfert.“"
                                            },
                                            {
                                                "example_id": "6b186f5a-494e-4b4c-9eb1-eb0f7722dc8b",
                                                "sense_id": "fd9faf6c-7f7c-33b7-a6b8-ec109212e325",
                                                "text": "„Wie Roth bald erfahren würde, hatte sie das Sorgerecht für ihre Kinder verloren, weil sie Alkoholikerin war und man sie mehrfach wegen Trunkenheit am Steuer verurteilt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d05dee3-20ae-48f2-9ccd-1feb48434205",
                        "source_entry_id": "8d28c1a9-21cf-396c-b2c3-d3bc3d732da5",
                        "source_sense_id": "926e976a-a1a8-3310-bbe2-75632cbfa144",
                        "source_sense_description": "state or characteristic of drunkenness",
                        "target_lang_word": "Betrunkenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betrunkenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b8a9a93-3ad0-374f-9b8f-c9d3d91467ba",
                                        "entry_id": "ac1824c8-f7d9-31d5-8b70-9699e9d1e7c4",
                                        "glosses": [
                                            "Zustand nach dem übermäßigen Konsum alkoholhaltiger Getränke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd26f413-8345-4df5-aabb-e307dc76fc0c",
                                                "sense_id": "4b8a9a93-3ad0-374f-9b8f-c9d3d91467ba",
                                                "text": "Betrunkenheit fühlt man dann, wenn man vom Alkohol berauscht ist."
                                            },
                                            {
                                                "example_id": "a8e1a46a-c706-4217-873b-de4ac6d9fdaa",
                                                "sense_id": "4b8a9a93-3ad0-374f-9b8f-c9d3d91467ba",
                                                "text": "Trotz ihrer Betrunkenheit setzte sie sich ins Auto und beging dann auch prompt später einen Unfall mit Fahrerflucht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eaed5c93-0451-4eba-9c04-3a6a2c6f14cb",
                        "source_entry_id": "8d28c1a9-21cf-396c-b2c3-d3bc3d732da5",
                        "source_sense_id": "926e976a-a1a8-3310-bbe2-75632cbfa144",
                        "source_sense_description": "state or characteristic of drunkenness",
                        "target_lang_word": "Rausch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rausch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6ae38aa-fd8d-3674-9726-90b9130b1188",
                                        "entry_id": "ba3f51ae-5814-3733-a31a-139738b75bd1",
                                        "glosses": [
                                            "mentaler Zustand der Glückseligkeit oder auch der Verwirrung und Übelkeit, wenn Drogenkonsum Wirkung zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "252f7a64-5c56-4f96-96e0-882d30be17b0",
                                                "sense_id": "a6ae38aa-fd8d-3674-9726-90b9130b1188",
                                                "text": "Im Rausch ist er unerträglich."
                                            },
                                            {
                                                "example_id": "ca7bee3d-d8d4-42b7-af7c-e785de47de14",
                                                "sense_id": "a6ae38aa-fd8d-3674-9726-90b9130b1188",
                                                "text": "Nachdem ich meinen Rausch ausgeschlafen hatte, hatte ich Kopfschmerzen und mir war immer noch schlecht."
                                            },
                                            {
                                                "example_id": "95b7ef13-1f58-4ba1-a46a-734c4f6819cf",
                                                "sense_id": "a6ae38aa-fd8d-3674-9726-90b9130b1188",
                                                "text": "Die ganze Reise war einfach wundervoll, aber sie ging so schnell vorüber wie in einem einzigen Rausch."
                                            },
                                            {
                                                "example_id": "28681d8a-8f3b-4f91-bd31-e4cd91f7f1f4",
                                                "sense_id": "a6ae38aa-fd8d-3674-9726-90b9130b1188",
                                                "text": "„Eine Nacht und einen Tag hatte sie allein im Zimmer gewartet, hatte vor Langeweile den Sextanten auseinandergenommen, die gesammelten Pflanzen durcheinander gebracht, von dem für Präparate vorgesehenen Spiritus getrunken und ihren Rausch ausgeschlafen.“"
                                            },
                                            {
                                                "example_id": "f03d27a9-243d-496a-83a2-eb1031659b4b",
                                                "sense_id": "a6ae38aa-fd8d-3674-9726-90b9130b1188",
                                                "text": "„Zbigniew merkte man keinen Rausch an.“"
                                            },
                                            {
                                                "example_id": "690fb04c-2835-4961-b0d9-f18fdeb150be",
                                                "sense_id": "a6ae38aa-fd8d-3674-9726-90b9130b1188",
                                                "text": "„Der Geschmack brennt unter und auf der Zunge, der Rausch ist schwer übelkeitserzeugend.“"
                                            },
                                            {
                                                "example_id": "2a4f559d-b3b2-491d-b3fc-1ef6d6dbc58e",
                                                "sense_id": "a6ae38aa-fd8d-3674-9726-90b9130b1188",
                                                "text": "„Es gehörte zu diesem Rausch – für uns beide gehörte es dazu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c6b3abed-8ace-346f-9f3e-1a3bb4002ecb",
                                        "entry_id": "ba3f51ae-5814-3733-a31a-139738b75bd1",
                                        "glosses": [
                                            "Überschwang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28da94c8-bf47-4742-b488-d19e140070fa",
                                                "sense_id": "c6b3abed-8ace-346f-9f3e-1a3bb4002ecb",
                                                "text": "Die ganze Reise war einfach wundervoll, aber sie ging so schnell vorüber wie in einem einzigen Rausch."
                                            },
                                            {
                                                "example_id": "89e609b6-cbbe-4b29-b871-4d06d8cb1a3c",
                                                "sense_id": "c6b3abed-8ace-346f-9f3e-1a3bb4002ecb",
                                                "text": "„Es gehörte zu diesem Rausch – für uns beide gehörte es dazu.“"
                                            },
                                            {
                                                "example_id": "36b522a9-4136-43c8-9ce6-d665829ec5a3",
                                                "sense_id": "c6b3abed-8ace-346f-9f3e-1a3bb4002ecb",
                                                "text": "Sie erlebten die Farbenfülle als einen Rausch der Farbvielfalt, der sie unglaublich inspirierte, nun auch Eigenes zu schaffen."
                                            },
                                            {
                                                "example_id": "688459f6-dab9-48f0-8f5b-b803850f766b",
                                                "sense_id": "c6b3abed-8ace-346f-9f3e-1a3bb4002ecb",
                                                "text": "Im Rausche der Gefühle versprach er ihr die Ehe und sollte es später auf das Bitterste bereuen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c0debb08-6313-383e-b520-e0a7704050d8",
                                        "entry_id": "ba3f51ae-5814-3733-a31a-139738b75bd1",
                                        "glosses": [
                                            "große Vielfalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ece737-1b55-4ece-80b5-0e330ee6535d",
                                                "sense_id": "c0debb08-6313-383e-b520-e0a7704050d8",
                                                "text": "Der Herbst erzeugt einen Rausch von Farben."
                                            },
                                            {
                                                "example_id": "58e21312-338e-489b-8c3d-66cb9a511a8b",
                                                "sense_id": "c0debb08-6313-383e-b520-e0a7704050d8",
                                                "text": "Ein Rausch von neuen Eindrücken prasselte auf sie nieder."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
