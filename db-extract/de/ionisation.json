                        ],
                        "form": "die Ionisationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb78bc4e-eac2-3a70-b921-c6f5c15c7830",
                        "entry_id": "1369bba9-041d-3287-aa69-e02e4313e91e",
                        "glosses": [
                            "die Entfernung eines oder mehrerer Elektronen aus einem Atom oder Molekül durch Energiezufuhr oder auch deren Anlagerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6033be0-4027-49a8-8501-34dd009aa97a",
                                "sense_id": "fb78bc4e-eac2-3a70-b921-c6f5c15c7830",
                                "text": "Natürliche Ionisation entsteht durch kosmischen Strahlung, der Strahlung radioaktiven Stoffe, der Sonnenstrahlung oder physikalischer Natureffekte wie am Wasserfall"
                            },
                            {
                                "example_id": "19d47f56-a746-4b65-8ac4-07b45646e5ad",
                                "sense_id": "fb78bc4e-eac2-3a70-b921-c6f5c15c7830",
                                "text": "„Unter Ionisation versteht man die Erzeugung freier Elektronen und positiv geladener Atome - also Ionen.“"
                            },
                            {
                                "example_id": "2d5e974b-c06c-4c24-a443-bec8774ac57d",
                                "sense_id": "fb78bc4e-eac2-3a70-b921-c6f5c15c7830",
                                "text": "„Unter Ionisation versteht man den Vorgang, aus elektrisch neutralen Atomen oder Molekülen positiv und negativ geladene Teilchen, also I.-Paare zu bilden“"
                            },
                            {
                                "example_id": "5a6fd9e1-1b91-4c54-bc98-0d84f859f518",
                                "sense_id": "fb78bc4e-eac2-3a70-b921-c6f5c15c7830",
                                "text": "„Die Ionisation auf dem elektronischem Wege erfolgt so: Nach dem Prinzip der Koronaentladung wird naszierender Sauerstoff erzeugt, d. h. die Spaltung von Sauerstoffmolekülen O2 in die beiden Sauerstoffatome O* mit pos. oder neg. Ladung, die ein erhöhtes Energie- und Ladungspotenzial aufweisen.“"
                            },
                            {
                                "example_id": "757ce101-706a-4aaa-b3c3-ce215ab9f153",
                                "sense_id": "fb78bc4e-eac2-3a70-b921-c6f5c15c7830",
                                "text": "„Durch künstliche Ionisation […] kann die natürliche Konzentration an negativen Luftionen wiederhergestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
