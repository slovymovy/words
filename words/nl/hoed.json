                {
                    "sense_id": "511f2f9c-8a7d-30e8-811c-a0ca5f057f2d",
                    "sense_definition": "Het bovenste, vaak brede gedeelte van een paddenstoel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vliegenzwam is herkenbaar aan zijn rode <w>hoed</w> met witte stippen.",
                            "target_lang_translations": {
                                "en": "The fly agaric is recognizable by its red <w>cap</w> with white dots.",
                                "ru": "Мухомор узнаваем по своей красной <w>шляпке</w> с белыми точками.",
                                "pl": "Muchomor jest rozpoznawalny po czerwonym <w>kapeluszu</w> w białe kropki.",
                                "de": "Der Fliegenpilz ist an seinem roten <w>Hut</w> mit weißen Punkten erkennbar.",
                                "fr": "L'amanite tue-mouches est reconnaissable à son <w>chapeau</w> rouge à points blancs.",
                                "it": "L'ovolo malefico è riconoscibile per il suo <w>cappello</w> rosso a pois bianchi.",
                                "cs": "Muchomůrka červená je rozpoznatelná podle svého červeného <w>klobouku</w> s bílými tečkami.",
                                "tr": "Sinek mantarı, beyaz benekli kırmızı <w>şapkasıyla</w> tanınır.",
                                "es": "La amanita muscaria es reconocible por su <w>sombrero</w> rojo con puntos blancos."
                            }
                        },
                        {
                            "text": "Onder de <w>hoed</w> van de paddenstoel zitten de sporen.",
                            "target_lang_translations": {
                                "en": "The spores are located under the <w>cap</w> of the mushroom.",
                                "ru": "Споры находятся под <w>шляпкой</w> гриба.",
                                "pl": "Pod <w>kapeluszem</w> grzyba znajdują się zarodniki.",
                                "de": "Unter dem <w>Hut</w> des Pilzes befinden sich die Sporen.",
                                "fr": "Les spores se trouvent sous le <w>chapeau</w> du champignon.",
                                "it": "Sotto il <w>cappello</w> del fungo si trovano le spore.",
                                "cs": "Pod <w>kloboukem</w> houby se nacházejí výtrusy.",
                                "tr": "Mantarın <w>şapkasının</w> altında sporlar bulunur.",
                                "es": "Las esporas se encuentran debajo del <w>sombrero</w> de la seta."
                            }
                        }
