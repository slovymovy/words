                ],
                "senses": [
                    {
                        "sense_id": "80f2b032-f9ce-3a65-aeaa-32a6a86d0de3",
                        "entry_id": "6e431002-f024-3f73-8557-2d66e3c07d4f",
                        "glosses": [
                            "A Chinese dumpling, often stuffed with varieties of meat or seafood and vegetables."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4edf6c4e-3bdd-461f-9183-b79a268ac496",
                                "sense_id": "80f2b032-f9ce-3a65-aeaa-32a6a86d0de3",
                                "text": "The wonton will be done when the crab filling is cooked through and the wonton are very soft."
                            },
                            {
                                "example_id": "3cad9268-0a55-41ef-8f00-bdf6f2b5a318",
                                "sense_id": "80f2b032-f9ce-3a65-aeaa-32a6a86d0de3",
                                "text": "When the water boils again, the wonton are ready to be inhaled with a little chicken broth."
                            },
                            {
                                "example_id": "466289bf-1c80-43a8-87e9-d0dbf2d7a4cf",
                                "sense_id": "80f2b032-f9ce-3a65-aeaa-32a6a86d0de3",
                                "text": "Arrange cooked or uncooked filled wonton in a single layer on a baking sheet. Cover and place in freezer. When the wonton are frozen, transfer to freezer bag."
                            },
                            {
                                "example_id": "4ded0cd6-32e3-4312-924e-b500d3bddeed",
                                "sense_id": "80f2b032-f9ce-3a65-aeaa-32a6a86d0de3",
                                "text": "The congee with crab is a best seller, while wonton are generously filled and flavoursome."
                            }
                        ]
                    }
                ],
