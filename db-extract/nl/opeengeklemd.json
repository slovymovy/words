                            {
                                "example_id": "ca9fa7f0-98da-4529-ae76-eeaf754da416",
                                "sense_id": "2e2f5a2b-73da-3a6f-a4a0-7377a9405e30",
                                "text": "Het hoekige voorhoofd met de gefronste wenkbrauwen past niet bij het slappe vel van zijn wangen. Zijn dunne, samengeperste lippen verraden dat hij poseert met opeengeklemde tanden."
                            },
                            {
                                "example_id": "c6c717cd-0605-4f5d-8365-d2711a3c1432",
                                "sense_id": "2e2f5a2b-73da-3a6f-a4a0-7377a9405e30",
                                "text": "Lloyds blijft met opeengeklemde lippen, maar volgens de huidige plannen zouden de Britse fondsen beheerd worden vanuit Schotland, terwijl Fortis de Europese beleggingen zou beheren."
                            }
                        ]
