                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "machine_learning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest language model was trained with billions of <w>parameters</w>.",
                            "target_lang_translations": {
                                "ru": "Последняя языковая модель была обучена на миллиардах <w>параметров</w>."
                            }
                        },
                        {
                            "text": "We need to perform <w>parameter</w> estimation to improve the model's accuracy.",
                            "target_lang_translations": {
                                "ru": "Нам необходимо выполнить оценку <w>параметров</w>, чтобы повысить точность модели."
                            }
