                "senses": [
                    {
                        "sense_id": "a29be40f-5c50-3d7c-9029-19e8dbfc6d7f",
                        "entry_id": "f32f4cf3-a7b4-36ee-854e-5815d12e3914",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным эпиграмма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8be8becc-aae5-4bec-8b63-d8f5d8e92a58",
                                "sense_id": "a29be40f-5c50-3d7c-9029-19e8dbfc6d7f",
                                "text": "Поэзия разделилась на лирическую, эпическую, драматическую, дидактическую, описательную, эпистолярную, пастушескую, сатирическую, эпиграмматическую и проч. и проч."
                            }
                        ]
                    },
                    {
                        "sense_id": "209071bf-d59d-3155-a23e-f39f2f8eda81",
                        "entry_id": "f32f4cf3-a7b4-36ee-854e-5815d12e3914",
                        "glosses": [
                            "устар. колкий, язвительный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "868e8149-4a50-4083-8b21-f8345e2e9c20",
                                "sense_id": "209071bf-d59d-3155-a23e-f39f2f8eda81",
                                "text": "― Язык мой ― враг мой, ― говаривал он, как бы оправдываясь в своей эпиграмматической невоздержности."
                            }
                        ]
                    }
