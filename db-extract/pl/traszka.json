                                        "sense_id": "e9be99b0-b473-31e7-9bf7-07d7913ba196",
                                        "entry_id": "4643d385-0a0e-351e-a593-e98cb0a503bf",
                                        "glosses": [
                                            "To turn (someone) into a newt, especially by magic."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "153673f4-7403-4625-9400-c7b7742bbf27",
                                                "sense_id": "e9be99b0-b473-31e7-9bf7-07d7913ba196",
                                                "text": "If you moved first and newted someone , you were a murderer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ddca5c9-fb4c-335c-be4a-4180ec9b2d62",
                                        "entry_id": "4643d385-0a0e-351e-a593-e98cb0a503bf",
                                        "glosses": [
                                            "To (usually temporarily) expel a user from a MUD or similar system"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ef99f17-4d37-4cfc-afef-b07ad62e1eb6",
                                                "sense_id": "4ddca5c9-fb4c-335c-be4a-4180ec9b2d62",
                                                "text": "So instead Sredna [presumably an abbreviation of \"Nosredna\", one of the LambdaMOO wizards] newted Finn. She newted him, and though she did not specify the length of time for which he was to remain newted, it seemed clear enough that forever would be just fine with the wizards."
                                            },
                                            {
                                                "example_id": "d077ab75-d848-484f-a218-8d9552d1cf90",
                                                "sense_id": "4ddca5c9-fb4c-335c-be4a-4180ec9b2d62",
                                                "text": "If, after a period of newting, the person still refuses to adhere to proper conduct and[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f89abe3-9e53-49bd-bad2-506bc09cfad9",
                        "source_entry_id": "e8993a30-c316-36ff-9f67-dcaf00e67559",
                        "source_sense_id": "60012efa-e828-33ea-929c-b387f9368b05",
