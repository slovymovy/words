                ],
                "senses": [
                    {
                        "sense_id": "bd8ebaae-beed-3161-9a14-4075ab71ad6b",
                        "entry_id": "9df4d8c1-25b4-34a7-90b6-a2cc0aef0da7",
                        "glosses": [
                            "Zahl, welche die Position eines Himmelskörpers auf der gedachten Himmelskugel angibt"
                        ],
                        "tags": [
                            "selten im Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "4bd0222c-40ae-46b9-bd38-dca50f25d295",
                                "sense_id": "bd8ebaae-beed-3161-9a14-4075ab71ad6b",
                                "text": "„Das blaue Koordinatensystem auf den Sternkarten markiert die Himmelskoordinaten Rektaszension und Deklination.“"
                            },
                            {
                                "example_id": "fc1b0b07-ddcb-495c-83d8-a09eb8885540",
                                "sense_id": "bd8ebaae-beed-3161-9a14-4075ab71ad6b",
                                "text": "„Der geografischen Länge entspricht dabei die Himmelskoordinate ‚Rektaszension‘, der Breite die ‚Deklination‘. Mit diesen beiden Koordinaten kann man die Position eines Sterns genau und für jeden Beobachter nachvollziehbar angeben.“"
                            },
                            {
                                "example_id": "8b484b1f-9168-44c2-ad16-af8d7844f09d",
                                "sense_id": "bd8ebaae-beed-3161-9a14-4075ab71ad6b",
                                "text": "„Mit den Himmelskoordinaten sich zu beschäftigen, ist nicht verkehrt, damit man ein wenig Ahnung davon hat, wie diese Steuerung die Sterne finden soll, vor allem wo und wie man das Fernrohr aufstellt.“"
                            },
                            {
                                "example_id": "d0efbfb2-b07f-4d14-8444-437c02e338e4",
                                "sense_id": "bd8ebaae-beed-3161-9a14-4075ab71ad6b",
                                "text": "„Er stellt einen Himmelsglobus her, entwickelt das Astrolabium so weiter, dass er mit diesem astronomischen Gerät Himmelskoordinaten bestimmen kann.“"
                            },
                            {
                                "example_id": "ed6b6ecb-7945-4436-827a-6fc0f9639660",
                                "sense_id": "bd8ebaae-beed-3161-9a14-4075ab71ad6b",
                                "text": "„Die ekliptikale Länge ist, neben der ekliptikalen Breite, die uns hier aber nicht interessiert, eine der zwei Himmelskoordinaten des ekliptikalen Koordinatensystems.“"
                            },
                            {
                                "example_id": "121b7c13-380e-4aa8-aa7a-4977e80c56ba",
                                "sense_id": "bd8ebaae-beed-3161-9a14-4075ab71ad6b",
                                "text": "„Neben der Himmelskugel befindet sich eine Armillarsphäre, die der Messung der Himmelskoordinaten oder der Darstellung der Bahnen der Himmelskörper dient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
