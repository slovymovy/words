                "translations": [
                    {
                        "translation_id": "3035b37f-b325-4255-8dac-12ac9d3dadee",
                        "source_entry_id": "a00fc109-f265-334a-bc08-5d5f0e16a71e",
                        "source_sense_id": "68f07ea6-45aa-3781-8911-61a48956808e",
                        "source_sense_description": "of both society and culture",
                        "target_lang_word": "socioculturel",
