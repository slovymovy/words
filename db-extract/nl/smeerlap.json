                ],
                "senses": [
                    {
                        "sense_id": "8a3a1a4a-9ade-3f93-bd80-b0e6f8c6ac0a",
                        "entry_id": "94c4a837-f036-39c2-ac9f-5b4717fb416c",
                        "glosses": [
                            "vette lap waarmee men iets insmeert om wrijving te verminderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6dd82b3-f61a-4c4b-a4c8-f21fcf58342c",
                                "sense_id": "8a3a1a4a-9ade-3f93-bd80-b0e6f8c6ac0a",
                                "text": "De smeerlap kwam van pas zodra het droog weer was (alleen met sneeuw verliep het traject soepeltjes), waardoor het paard de kar niet meer kon trekken. De sleper smeerde de wielen in met de vette lap zodat de kar weer verder kon worden getrokken."
                            },
                            {
                                "example_id": "f7d0b90a-728e-4774-8b0c-039078384b92",
                                "sense_id": "8a3a1a4a-9ade-3f93-bd80-b0e6f8c6ac0a",
                                "text": "De sleepkoets werd meestal voortgetrokken door een paard, waarvan de menner genoodzaakt was naast het vehikel te lopen en zo nu en dan met zijn smeerlap de glij-ijzers wat gladder te maken."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f56f1c7-df97-3068-aaa3-03b95725f1ca",
                        "entry_id": "94c4a837-f036-39c2-ac9f-5b4717fb416c",
                        "glosses": [
                            "man die wangedrag vertoont"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "acb15241-a8ab-3909-bae8-af838f2bcae3",
                        "entry_id": "94c4a837-f036-39c2-ac9f-5b4717fb416c",
                        "glosses": [
                            "man die wangedrag vertoont",
                            "man die zichzelf of zijn omgeving vies maakt"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "83d1456b-07bd-469a-a18c-38f4e94e4911",
                                "sense_id": "acb15241-a8ab-3909-bae8-af838f2bcae3",
                                "text": "Hij keek me aan alsof ik de goorste smeerlap was die hij in jaren was tegengekomen. „Een blower?!” riep hij uit. „Die maakt het alleen maar nóg veel viezer.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "8778174a-adf7-3b8f-a288-7a33ed9496d1",
                        "entry_id": "94c4a837-f036-39c2-ac9f-5b4717fb416c",
                        "glosses": [
                            "man die wangedrag vertoont",
                            "man die gemene dingen doet"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "f56a5c0c-d16a-407a-9b0a-b36705a650f6",
                                "sense_id": "8778174a-adf7-3b8f-a288-7a33ed9496d1",
                                "text": "‘Ja, hou hem vast. Hou die smeerlap vast.’ Sommigen konden zich amper inhouden en schopten de overvaller."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3440525-ea77-3af7-b103-7d69fd601afd",
                        "entry_id": "94c4a837-f036-39c2-ac9f-5b4717fb416c",
                        "glosses": [
                            "man die wangedrag vertoont",
                            "man met onsmakelijke seksuele voorkeuren"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "357aadd7-6ccb-4c15-8cf1-1e4340d1dc14",
                                "sense_id": "e3440525-ea77-3af7-b103-7d69fd601afd",
                                "text": "Het meisje graait wat, ze grinnikt: „Ik kan geen stier melken.” En dat is dat. Jeugd en ouderdom. Kind en ouwe smeerlap. Kracht en impotentie, leven en dood."
                            }
                        ]
                    }
                ],
