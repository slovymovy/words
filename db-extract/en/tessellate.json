                        "entry_id": "97df258a-89f5-3606-a7af-df45e16588e0",
                        "glosses": [
                            "To cover with tiles or stones, as a mosaic; to tile."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "20423e95-a2d8-3b4e-84e8-8900242cd6e2",
                        "entry_id": "97df258a-89f5-3606-a7af-df45e16588e0",
                        "glosses": [
                            "to cover a two-dimensional shape, such that multiple copies of itself placed edge to edge cover an area leaving no space between the shapes."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "011db6a3-0e1b-4cad-8750-31fe9da41319",
                                "sense_id": "20423e95-a2d8-3b4e-84e8-8900242cd6e2",
                                "text": "Regular hexagons tessellate."
                            }
                        ]
                    },
                    {
                        "sense_id": "016ab845-adbd-32e0-bc31-27d2116bf324",
                        "entry_id": "97df258a-89f5-3606-a7af-df45e16588e0",
                        "glosses": [
                            "To completely fill (an area) when multiple copies of one or more two-dimensional shapes are placed edge to edge."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5aa6f1ca-79fb-4eba-8275-9841720319bc",
                                "sense_id": "016ab845-adbd-32e0-bc31-27d2116bf324",
                                "text": "It is possible to tessellate the plane with equilateral triangles and regular hexagons."
                            }
                        ]
                    }
                ],
