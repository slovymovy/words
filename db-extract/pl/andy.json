                    {
                        "translation_id": "ff51e7c9-2d78-4b1c-a531-c02c8368790a",
                        "source_entry_id": "1b51df05-7a54-33e9-b1f8-63f13f2a7043",
                        "source_sense_id": "175b344e-e613-34ee-a69a-5bd5fe36f4a0",
                        "target_lang_word": "Andes",
