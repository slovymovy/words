                        "sense_id": "f36b60c1-b496-32b6-b33e-9c160d284c69",
                        "entry_id": "0f4a82a7-c020-3783-8f47-5506f54edbc1",
                        "glosses": [
                            "Maß, das geordnete Werte in zehn gleiche Teile einteilt"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "2d86498b-cc8e-465a-9d89-d004163e8f54",
                                "sense_id": "f36b60c1-b496-32b6-b33e-9c160d284c69",
                                "text": "„Die Wissenschaftler … unterteilten die Bevölkerung nach der Höhe des Einkommens in zehn gleich große Gruppen, in sogenannte Dezile. Das unterste Zehntel gibt die Einkommenssituation der ärmsten zehn Prozent wieder, das oberste die der reichsten zehn Prozent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
