                        "form": "черноволо́сей"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a219ee76-46e2-3a1c-9178-fb5200644599",
                        "entry_id": "73b3b2dc-b1ff-30d5-8304-66598be0a95c",
                        "glosses": [
                            "имеющий чёрные волосы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4b51f7d-eb61-410a-93ad-a2bf9fe6fe3e",
                                "sense_id": "a219ee76-46e2-3a1c-9178-fb5200644599",
                                "text": "Черноволосый, нестриженый, взъерошенный, с проступающими рёбрышками, он был похож на маленького исхудалого волчонка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3eaf3700-592c-47bd-865a-0dfd2ad5ea97",
                        "source_entry_id": "73b3b2dc-b1ff-30d5-8304-66598be0a95c",
                        "source_sense_id": "a219ee76-46e2-3a1c-9178-fb5200644599",
                        "target_lang_word": "black-haired",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "black-haired",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b730a67-a9f8-39d8-9129-605871de1c5d",
                                        "entry_id": "0e3f6461-54bb-35d9-a172-e2fea9eff185",
                                        "glosses": [
                                            "Having hair of a black color."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d19e770-bc8f-45d4-a40a-13e9d5bed222",
                                                "sense_id": "7b730a67-a9f8-39d8-9129-605871de1c5d",
                                                "text": "Aline looked even smaller and blacker-haired than usual, beside Ashley."
                                            },
                                            {
                                                "example_id": "ff734f19-3ff1-46bf-a9e9-f4b74b258e89",
                                                "sense_id": "7b730a67-a9f8-39d8-9129-605871de1c5d",
                                                "text": "Then, the voice of the oldest of the Lay brothers, the leader of the pack, the tallest, the blackest-haired, the bluest-eyed."
                                            },
                                            {
                                                "example_id": "eb58ef46-f2c7-45b2-a841-d350678b8b9a",
                                                "sense_id": "7b730a67-a9f8-39d8-9129-605871de1c5d",
                                                "text": "He smiled, remembering the morning when Esteban and Gregorio, two of his darkest-eyed, blackest-haired and most sunburnt men, had come to him with a daring plan that he’d immediately sanctioned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
