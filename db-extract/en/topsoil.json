                "senses": [
                    {
                        "sense_id": "613b1b50-8a0d-3cb5-b5d2-3d3efa0870a3",
                        "entry_id": "3ded8d9f-9e35-34e8-967f-86359989d5a4",
                        "glosses": [
                            "The upper layer of soil, typically most fertile and in which it is the easiest to start new plants."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "58721cfa-30d6-4b83-9e6e-9f2fea79047c",
                                "sense_id": "613b1b50-8a0d-3cb5-b5d2-3d3efa0870a3",
                                "text": "Little grew on the farm, after the floods from the hurricane washed away the topsoil."
                            },
                            {
                                "example_id": "dd2b30de-066e-46c7-914d-6e8cbdaa86f4",
                                "sense_id": "613b1b50-8a0d-3cb5-b5d2-3d3efa0870a3",
                                "text": "Without urgent action, the majority of the Earth’s topsoil could be severely degraded or lost before the end of this century. In China, topsoil is being lost fifty-seven times faster than this natural replacement process; in Europe seventeen times faster."
                            }
                        ]
                    }
                ],
