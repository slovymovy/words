                "senses": [
                    {
                        "sense_id": "dc5e3eed-9147-3d36-b0f6-dd48de50e619",
                        "entry_id": "6588f08e-d84c-317d-ac44-ca69fffdd99d",
                        "glosses": [
                            "de hoeveelheid en variatie van vissen die in een bepaald water aanwezig zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bf89915-6f06-4073-8edc-1253c9a61994",
                                "sense_id": "dc5e3eed-9147-3d36-b0f6-dd48de50e619",
                                "text": "Ieder najaar spreken de ministers in Brussel nieuwe visquota af. Komend jaar mag er minder tong en schol worden gevangen. Op haring, kabeljauw, tarbot en griet geldt juist een verruiming. De visstand in de Noordzee heeft zich volgens het ministerie de afgelopen jaren goed ontwikkeld."
                            },
                            {
                                "example_id": "a59320e9-c9a2-408c-8ec1-ad8f0aeffd69",
                                "sense_id": "dc5e3eed-9147-3d36-b0f6-dd48de50e619",
                                "text": "„Het kabinet kan geen sportakkoord sluiten zonder dat de sportvissers daar onderdeel van uitmaken”, stelt de politica. „De vissers hebben dringend goed water nodig en daar moet werk van gemaakt worden samen met de waterschappen en Staatsbosbeheer. Steeds meer wateren groeien vol met planten, dat is slecht voor de visstand en dus slecht voor de vissers.”"
                            }
                        ]
                    }
