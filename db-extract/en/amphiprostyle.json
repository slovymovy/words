                        "glosses": [
                            "An amphiprostyle temple or edifice."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "93f3d607-69a8-4389-9055-2cdb8d5b80c9",
                                "sense_id": "2e089226-7396-321c-8b1b-c8e4a0de5529",
                                "text": "1819, Periptere, Abraham Rees, The Cyclopædia: Or, Universal Dictionary of Arts, Sciences, and Literature, Volume 26, unnumbered page,\nPeripteres were properly temples which had columns on all the four ſides; by which they were distinguished from proſtyles, and amphiproſtyles, the one of which had no columns before, and the other none on the sides."
                            }
                        ]
                    }
