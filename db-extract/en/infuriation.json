                "senses": [
                    {
                        "sense_id": "a01a8abd-d763-34c2-93f7-e68eab47027f",
                        "entry_id": "a1bd2546-fd76-3fb2-a2c8-3d0eacbfded4",
                        "glosses": [
                            "Extreme anger."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d2d709fd-9c05-4007-b3e2-7d99fc9358c6",
                                "sense_id": "a01a8abd-d763-34c2-93f7-e68eab47027f",
                                "text": "He had several long arguments with Annie, but to no purpose; and after his last interview with her, he returned to the saloon in a state little short of infuriation."
                            },
                            {
                                "example_id": "e41bccbb-0f57-4f32-acb8-b9f3cfe55385",
                                "sense_id": "a01a8abd-d763-34c2-93f7-e68eab47027f",
                                "text": "Any compassion I felt for my middle school friend had evaporated, leaving little hard nuggets of infuriation."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e4f6d0f-3967-360b-b0fd-5774b48105c8",
                        "entry_id": "a1bd2546-fd76-3fb2-a2c8-3d0eacbfded4",
                        "glosses": [
                            "Something that causes extreme anger; an expression or instance of extreme anger."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "7131dc3e-1902-44d7-b399-b5cb53df6206",
                                "sense_id": "7e4f6d0f-3967-360b-b0fd-5774b48105c8",
                                "text": "1923, T. E. Lawrence, letter to Edward Garnett dated 16 December, 1923, in David Garnett (ed.), Letters of T. E. Lawrence, London: Jonathan Cape, 1938, p. 444,\nHe likes the chapters in which I ramble round among the cobwebs of my own mind—those you wanted cut! Quaint, isn’t it? He also likes others, which you praised.\nThat’s one infuriation of letters, of all artistic effort… their lack of an absolute."
                            },
                            {
                                "example_id": "cf237c68-b1e0-46cb-849d-4b7222dc14e6",
                                "sense_id": "7e4f6d0f-3967-360b-b0fd-5774b48105c8",
                                "text": "[…] spring’s infuriations over and a long way\nTo the first autumnal inhalations,"
                            }
                        ]
                    }
                ],
