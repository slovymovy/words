                                        "sense_id": "4b97a2ce-7bbf-36f2-a090-c1a828620c7e",
                                        "entry_id": "f0ae029e-9249-3a1d-bc09-e98bfa4b22f1",
                                        "glosses": [
                                            "The set of precision kettledrums in an orchestra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa980263-b216-49a2-8b68-9e034ec26810",
                                                "sense_id": "4b97a2ce-7bbf-36f2-a090-c1a828620c7e",
                                                "text": "Since the timpani is a legato instrument, a note must be allowed to sound and ring to achieve the full effect of the drum."
