{
    "word_family": [
        "dress",
        "dressing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3223aca7-d505-32a3-9547-4af5b29f5789",
                    "sense_definition": "A piece of kitchen furniture with shelves for storing dishes or cooking tools.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She placed the clean plates on the wooden <w>dresser</w>.",
                            "target_lang_translations": {
                                "ru": "Она расставила чистые тарелки в деревянном <w>буфете</w>."
                            }
                        },
                        {
                            "text": "The old kitchen had a large <w>dresser</w> filled with colorful bowls.",
                            "target_lang_translations": {
                                "ru": "На старой кухне стоял большой <w>посудный шкаф</w>, заполненный разноцветными мисками."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kitchen dresser"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет кухонной мебели с полками для хранения посуды или кухонной утвари (буфет, горка)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буфет",
                                "target_lang_sense_clarification": "кухонный шкаф с полками для посуды"
                            },
                            {
                                "target_lang_word": "кухонный шкаф",
                                "target_lang_sense_clarification": "шкаф для посуды и утвари"
                            },
                            {
                                "target_lang_word": "посудный шкаф",
                                "target_lang_sense_clarification": "шкаф с полками для посуды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be2a6ecf-c963-32f3-81ab-6aad5df38493",
                    "sense_definition": "A piece of bedroom furniture with drawers and often a mirror for storing clothes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kept his socks in the top drawer of the <w>dresser</w>.",
                            "target_lang_translations": {
                                "ru": "Он хранил свои носки в верхнем ящике <w>комода</w>."
                            }
                        },
                        {
                            "text": "She looked in the mirror on her <w>dresser</w> to brush her hair.",
                            "target_lang_translations": {
                                "ru": "Она посмотрела в зеркало на своем <w>туалетном столике</w>, чтобы причесаться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bedroom dresser"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет мебели для спальни с выдвижными ящиками (и часто зеркалом) для хранения одежды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комод",
                                "target_lang_sense_clarification": "шкаф с выдвижными ящиками для белья и одежды"
                            },
                            {
                                "target_lang_word": "туалетный столик",
                                "target_lang_sense_clarification": "столик с зеркалом и ящиками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cfc413c-7e4a-37c7-9682-83da6aed9693",
                    "sense_definition": "A person who wears clothes in a specific style.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is known as a very stylish <w>dresser</w> at the office.",
                            "target_lang_translations": {
                                "ru": "В офисе он известен тем, что <w>очень стильно одевается</w>."
                            }
                        },
                        {
                            "text": "She is a casual <w>dresser</w> who prefers jeans and t-shirts.",
                            "target_lang_translations": {
                                "ru": "Она <w>одевается просто</w> и предпочитает джинсы и футболки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "snappy dresser"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, одевающийся определённым образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "человек, который одевается (каким-либо образом)",
                                "target_lang_sense_clarification": "о стиле одежды человека"
                            },
                            {
                                "target_lang_word": "модник",
                                "target_lang_sense_clarification": "человек, любящий модно и стильно одеваться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2558aaab-a793-37e7-888d-36453706238b",
                    "sense_definition": "A person who helps actors or performers put on their costumes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lead actor thanked his <w>dresser</w> for helping him change quickly.",
                            "target_lang_translations": {
                                "ru": "Исполнитель главной роли поблагодарил своего <w>костюмера</w> за помощь в быстром переодевании."
                            }
                        },
                        {
                            "text": "A professional <w>dresser</w> ensures the costumes are ready for every scene.",
                            "target_lang_translations": {
                                "ru": "Профессиональный <w>костюмер</w> следит за тем, чтобы костюмы были готовы к каждой сцене."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Театральный работник, помогающий актёрам одеваться или менять сценические костюмы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "костюмер",
                                "target_lang_sense_clarification": "помощник по костюмам в театре или кино"
                            },
                            {
                                "target_lang_word": "одевальщик",
                                "target_lang_sense_clarification": "человек, помогающий одеваться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd4da6b2-d20c-3b4e-91e2-a14d986082fd",
                    "sense_definition": "A medical assistant who helps clean and bandage wounds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital <w>dresser</w> carefully changed the bandages on the patient's arm.",
                            "target_lang_translations": {
                                "ru": "Больничный <w>перевязочный санитар</w> аккуратно сменил повязки на руке пациента."
                            }
                        },
                        {
                            "text": "In the past, a <w>dresser</w> was essential for managing surgical wounds.",
                            "target_lang_translations": {
                                "ru": "В прошлом <w>помощник хирурга по перевязкам</w> играл ключевую роль в обработке послеоперационных ран."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical medical role."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинский работник или санитар, обрабатывающий и перевязывающий раны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевязочный санитар",
                                "target_lang_sense_clarification": "помощник врача, делающий перевязки"
                            },
                            {
                                "target_lang_word": "перевязчик",
                                "target_lang_sense_clarification": "медицинский работник, накладывающий повязки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "787ae73e-861d-3757-85b9-906a2961ea0b",
                    "sense_definition": "A machine used in a mill to sift or separate grain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "machine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grain <w>dresser</w> removed the impurities from the wheat harvest.",
                            "target_lang_translations": {
                                "ru": "<w>Зерноочистительная машина</w> удалила примеси из собранного урожая пшеницы."
                            }
                        },
                        {
                            "text": "Modern mills use an automated <w>dresser</w> to process large amounts of flour.",
                            "target_lang_translations": {
                                "ru": "На современных мельницах используется автоматический <w>бурат</w> для обработки больших объемов муки."
                            }
                        }
                    ],
                    "synonyms": [
                        "bolt#Noun_2",
                        "bolter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мукомольная или зерноочистительная машина для просеивания и сортировки зерна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сортировальная машина",
                                "target_lang_sense_clarification": "машина для очистки и калибровки зерна"
                            },
                            {
                                "target_lang_word": "бурат",
                                "target_lang_sense_clarification": "просеивающая машина на мельнице"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "08406638-93fa-33a3-8662-67361df61eb3",
                    "sense_definition": "A family name.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Dresser</w> is our new neighbor.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Дрессер</w> — наш новый сосед."
                            }
                        },
                        {
                            "text": "The author of the book is named <w>Dresser</w>.",
                            "target_lang_translations": {
                                "ru": "Фамилия автора книги — <w>Дрессер</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия Дрессер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дрессер",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}