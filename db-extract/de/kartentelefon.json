                "senses": [
                    {
                        "sense_id": "6e279f21-11ec-3b1f-a615-1aa36a90a2c0",
                        "entry_id": "2f2a5d01-aabd-34af-a345-53d467c3b1aa",
                        "glosses": [
                            "öffentlicher Fernsprecher, für dessen Verwendung eine elektronische Wertkarte (Telefonkarte) benötigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "082cfc3d-c034-46f4-8961-4779ec558367",
                                "sense_id": "6e279f21-11ec-3b1f-a615-1aa36a90a2c0",
                                "text": "„Die Telekom habe den Erhalt dieser Standorte in einem Schreiben zugesichert, sagte Haas, und zudem versprochen, das Kartentelefon in der Kleinfeldstraße in einen Münzfernsprecher umzurüsten.“"
                            },
                            {
                                "example_id": "fdb26c85-99f4-4673-938e-536ad6eab52f",
                                "sense_id": "6e279f21-11ec-3b1f-a615-1aa36a90a2c0",
                                "text": "„Im schmucklosen Hausflur der Nummer 30 im Römanns Kamp hängt ein Kartentelefon an der Wand, aus dem Hinterzimmer dröhnt laute Musik, über Satellitenschüssel empfängt der Fernseher einen polnischen Musiksender.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
