                        "sense_id": "2624cc75-8652-3990-98bd-dc07ecd5ced7",
                        "entry_id": "4de0dd89-a7b3-3610-a1cd-48106d75b23d",
                        "glosses": [
                            "Holster zum Tragen einer Pistole"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37d2b994-b044-4345-8814-5576d3c65c53",
                                "sense_id": "2624cc75-8652-3990-98bd-dc07ecd5ced7",
                                "text": "„Er hatte Gray Man gesehen, der trug ein dunkelbraunes Hemd mit großen Blutflecken an der Taille, ein Pistolenholster an der rechten Hüfte und ein Magazinholster links über der kugelsicheren Weste.“"
                            },
                            {
                                "example_id": "f747b261-f522-4b8a-8d60-d96fad158153",
                                "sense_id": "2624cc75-8652-3990-98bd-dc07ecd5ced7",
                                "text": "„Chu zog den Reißverschluss seiner Jacke halb herunter, sodass man das lederne Pistolenholster sehen konnte, das zu einer Messerscheide umgearbeitet worden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
