                "senses": [
                    {
                        "sense_id": "0072a00e-98a1-3eb4-b268-b01d66b22050",
                        "entry_id": "61ac9b1c-4ec7-3eab-9c0a-6ee3349244d5",
                        "glosses": [
                            "aus Porzellan gefertigter Teller"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b633800-be83-4ef3-afda-9b001fcd52d7",
                                "sense_id": "0072a00e-98a1-3eb4-b268-b01d66b22050",
                                "text": "Der antike Porzellanteller ging gestern zu Bruch."
                            },
                            {
                                "example_id": "5c799b65-b6f1-47e9-8a6b-fd1ad23fc809",
                                "sense_id": "0072a00e-98a1-3eb4-b268-b01d66b22050",
                                "text": "„Selbstverständlich hatte jeder einen Porzellanteller vor sich, Besteck und eine weiße Stoffserviette.“"
                            },
                            {
                                "example_id": "974944dd-588a-44d6-8ffa-c5357865b930",
                                "sense_id": "0072a00e-98a1-3eb4-b268-b01d66b22050",
                                "text": "„Der sonst eher lässige Chef-Patissier verfolgte jetzt haargenau, wie die großen Porzellanteller von seinen Mitarbeitern angrichtet wurden.“"
                            },
                            {
                                "example_id": "65c6dfc0-eb61-4d6d-a6d7-a0a906be6272",
                                "sense_id": "0072a00e-98a1-3eb4-b268-b01d66b22050",
                                "text": "„Er legte ein paar Scheine auf den Porzellanteller, nachdem er die Summe addiert hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
