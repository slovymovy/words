            {
                "entry_id": "3ac67134-10a2-35d2-b6f6-d89c925702f3",
                "word": "toutxs",
                "pos": "pron",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9bc8e4c2-01b4-31d0-a74b-a1b9f8f9a447",
                        "entry_id": "3ac67134-10a2-35d2-b6f6-d89c925702f3",
                        "glosses": [
                            "Forme neutre pluriel de tout."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "41fe6f0d-f0eb-4eaf-88b1-78fedc5eb780",
                                "sense_id": "9bc8e4c2-01b4-31d0-a74b-a1b9f8f9a447",
                                "text": "CONFIANCE ET MÉCA POUR TOUTXS !"
                            },
                            {
                                "example_id": "91a7d62c-b9f5-486a-9876-13f3485469c1",
                                "sense_id": "9bc8e4c2-01b4-31d0-a74b-a1b9f8f9a447",
                                "text": "Deux jours d’atelier de lectures pour une réflexion commune autour de questions écologiques à travers des prismes féministes trans-inclusifs et décoloniaux suivie d’une soirée de lecture ouverte à toutxs."
                            },
                            {
                                "example_id": "1d124a6a-e05c-413a-87b5-7d1a8aa5874a",
                                "sense_id": "9bc8e4c2-01b4-31d0-a74b-a1b9f8f9a447",
                                "text": "L’imperfection, cette aventure que toutxs nous vivons."
                            },
                            {
                                "example_id": "32adf67f-9d89-42aa-9a7e-7c85f86efe95",
                                "sense_id": "9bc8e4c2-01b4-31d0-a74b-a1b9f8f9a447",
                                "text": "Les changements de direction et d’organisation de l’école ont fait émerger à Cergy, comme ailleurs, des discussions nécessaires, et le studio “ Production ” a pu être un cadre propice pour les accueillir et les mettre en perspective, en donnant une voix à toutxs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69804f50-16e0-40a7-bbd5-911b59cb4d3d",
                        "source_entry_id": "3ac67134-10a2-35d2-b6f6-d89c925702f3",
                        "source_sense_id": "9bc8e4c2-01b4-31d0-a74b-a1b9f8f9a447",
                        "target_lang_word": "all",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "all",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6db16e13-b379-320d-9355-fe8899b08010",
                                        "entry_id": "8cdd1165-1b1a-3ad9-b271-29a163e0158a",
                                        "glosses": [
                                            "Every individual or anything of the given class, with no exceptions (the noun or noun phrase denoting the class must be plural or uncountable)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8df7647-e89d-40b8-94f7-99da64689f92",
                                                "sense_id": "6db16e13-b379-320d-9355-fe8899b08010",
                                                "text": "All contestants must register for the footrace: we've arranged numbers for them all."
                                            },
                                            {
                                                "example_id": "ad2d2d76-38a6-471b-91d2-0264a81ed640",
                                                "sense_id": "6db16e13-b379-320d-9355-fe8899b08010",
                                                "text": "All flesh is originally grass."
                                            },
                                            {
                                                "example_id": "8cd3205f-30d3-4223-9f4e-90182fd79752",
                                                "sense_id": "6db16e13-b379-320d-9355-fe8899b08010",
                                                "text": "All (the) three of my nephews adore classical music."
                                            },
                                            {
                                                "example_id": "a0ec7a55-c022-4e44-9668-7cc0d44a718e",
                                                "sense_id": "6db16e13-b379-320d-9355-fe8899b08010",
                                                "text": "Beautie alone is a ſoveraigne remedy againſt feare,griefe,and all melancholy fits; a charm,as Peter de la Seine and many other writers affirme,a banquet it ſelfe;he gives inſtance in diſcontented Menelaus that was ſo often freed by Helenas faire face: and ʰTully, 3 Tusc. cites Epicurus as a chiefe patron of this Tenent."
                                            },
                                            {
                                                "example_id": "e07ec8ab-e076-48f2-b7ea-60999652a113",
                                                "sense_id": "6db16e13-b379-320d-9355-fe8899b08010",
                                                "text": "In former days every tavern of repute kept such a room for its own select circle, a club, or society, of habitués, who met every evening, for a pipe and a cheerful glass. In this way all respectable burgesses, down to fifty years ago, spent their evenings."
                                            },
                                            {
                                                "example_id": "be1fee6d-e0af-485c-97d8-06d36ea6ff32",
                                                "sense_id": "6db16e13-b379-320d-9355-fe8899b08010",
                                                "text": "Pretty soon I struck into a sort of path[…]. It twisted and turned,[…]and opened out into a big clear space like a lawn. And, back of the lawn, was a big, old-fashioned house, with piazzas stretching in front of it, and all blazing with lights."
                                            },
                                            {
                                                "example_id": "1a60e8fa-f7cf-4dba-acf7-d32dd154e4dc",
                                                "sense_id": "6db16e13-b379-320d-9355-fe8899b08010",
                                                "text": "Now, Nielsen is sending all hotel employees through EI training to help them become more open and confident, understand their own limitations and fears, and to boost their self-worth and comfort in dealing with other people."
                                            },
                                            {
                                                "example_id": "92c0a8e8-abc6-48a9-9128-7384a892a7ee",
                                                "sense_id": "6db16e13-b379-320d-9355-fe8899b08010",
                                                "text": "On the one hand, we had a scenario where, effectively, the American admiral just went \"You know what, all the destroyers attack\", at which point they mowed through the Japanese destroyers like a Grim Reaper through a harvest of very, very dead gorn, especially with the Brooklyns in support."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b444cbd0-bc64-3506-ab06-c25776e66128",
                                        "entry_id": "8cdd1165-1b1a-3ad9-b271-29a163e0158a",
                                        "glosses": [
                                            "Throughout the whole of (a stated period of time; generally used with units of a day or longer)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7061c21-d3aa-4927-a9e9-48b83d41439f",
                                                "sense_id": "b444cbd0-bc64-3506-ab06-c25776e66128",
                                                "text": "The store is open all day and all night."
                                            },
                                            {
                                                "example_id": "927a5c43-72b5-4e04-ab94-d0013578db2f",
                                                "sense_id": "b444cbd0-bc64-3506-ab06-c25776e66128",
                                                "text": "I’ve been working on this all year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33f2f422-db31-30fb-a041-1f0c945d76e0",
                                        "entry_id": "8cdd1165-1b1a-3ad9-b271-29a163e0158a",
                                        "glosses": [
                                            "Only; alone; nothing but."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e2ac4be-b217-4ad7-abde-08c67838a0d0",
                                                "sense_id": "33f2f422-db31-30fb-a041-1f0c945d76e0",
                                                "text": "He's all talk; he never puts his ideas into practice."
                                            },
                                            {
                                                "example_id": "94df3ce2-69ad-42ef-9eac-6e0dceb18371",
                                                "sense_id": "33f2f422-db31-30fb-a041-1f0c945d76e0",
                                                "text": "I was born to speak all mirth and no matter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aefcb241-c652-3d1b-957d-e4bcd418a4b3",
                                        "entry_id": "8cdd1165-1b1a-3ad9-b271-29a163e0158a",
                                        "glosses": [
                                            "Any."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9df04fa8-b7ea-4af0-9736-efe7485f2894",
                                                "sense_id": "aefcb241-c652-3d1b-957d-e4bcd418a4b3",
                                                "text": "without all remedy"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "all",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd07f954-f808-3a9f-a02d-caea18ebc562",
                                        "entry_id": "4ed1d33e-9d7f-32d2-b307-c21b1da1d64e",
                                        "glosses": [
                                            "Everything."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8a76b32-49b1-459a-b880-1945530173ec",
                                                "sense_id": "dd07f954-f808-3a9f-a02d-caea18ebc562",
                                                "text": "Some gave all they had."
                                            },
                                            {
                                                "example_id": "4bef2481-76f2-455f-b7f1-99e4ddc62799",
                                                "sense_id": "dd07f954-f808-3a9f-a02d-caea18ebc562",
                                                "text": "She knows all and sees all."
                                            },
                                            {
                                                "example_id": "1aded386-3baa-4f0b-bdfe-61cd810dfe61",
                                                "sense_id": "dd07f954-f808-3a9f-a02d-caea18ebc562",
                                                "text": "All of Jones’s maneuvers to trounce Kennedy."
                                            },
                                            {
                                                "example_id": "839a1c91-63a8-46c6-b8c3-f4d4aee92a4a",
                                                "sense_id": "dd07f954-f808-3a9f-a02d-caea18ebc562",
                                                "text": "All is not well at home lately."
                                            },
                                            {
                                                "example_id": "9684e1e0-0c03-4a0a-9582-7651fc0655eb",
                                                "sense_id": "dd07f954-f808-3a9f-a02d-caea18ebc562",
                                                "text": "Those who think they know it all are annoying to those of us who do."
                                            },
                                            {
                                                "example_id": "85386240-2244-465a-a47d-cd8336c674b6",
                                                "sense_id": "dd07f954-f808-3a9f-a02d-caea18ebc562",
                                                "text": "Now all this was very fine, but not at all in keeping with the Celebrity's character as I had come to conceive it. The idea that adulation ever cloyed on him was ludicrous in itself. In fact I thought the whole story fishy, and came very near to saying so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "584d9e71-185d-30c5-8435-9ad98b03ade8",
                                        "entry_id": "4ed1d33e-9d7f-32d2-b307-c21b1da1d64e",
                                        "glosses": [
                                            "Everyone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2ad8169-bcf4-446d-aecf-e81a523d49aa",
                                                "sense_id": "584d9e71-185d-30c5-8435-9ad98b03ade8",
                                                "text": "A good time was had by all (of you/us/them)."
                                            },
                                            {
                                                "example_id": "75bd4410-7a50-4fc9-95cb-b0f87de7f97b",
                                                "sense_id": "584d9e71-185d-30c5-8435-9ad98b03ade8",
                                                "text": "We all enjoyed the movie."
                                            },
                                            {
                                                "example_id": "7b30c314-9f4f-4688-b2ce-dced784ad96d",
                                                "sense_id": "584d9e71-185d-30c5-8435-9ad98b03ade8",
                                                "text": "I've got three children, of whom all are studying medicine."
                                            },
                                            {
                                                "example_id": "d2c9a1b7-1464-4777-aaec-779bec4968f9",
                                                "sense_id": "584d9e71-185d-30c5-8435-9ad98b03ade8",
                                                "text": "Hey all, just a quick note as I am trying to do 46 things at once and slow down a touch all at once…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdee842f-770c-3209-8e16-2cce18a90462",
                                        "entry_id": "4ed1d33e-9d7f-32d2-b307-c21b1da1d64e",
                                        "glosses": [
                                            "The only thing(s)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aef4f9e8-63e7-42a6-803b-0660ae9590b1",
                                                "sense_id": "fdee842f-770c-3209-8e16-2cce18a90462",
                                                "text": "All that was left was a small pile of ash."
                                            },
                                            {
                                                "example_id": "7794771c-b3ab-4767-ba34-9056b5d4e5fa",
                                                "sense_id": "fdee842f-770c-3209-8e16-2cce18a90462",
                                                "text": "We ate potatoes and ziti .... that's all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18fe6771-c6ae-3e05-b78f-9f3b80b493b9",
                                        "entry_id": "4ed1d33e-9d7f-32d2-b307-c21b1da1d64e",
                                        "glosses": [
                                            "Used after who, what, where, how and similar words, either without changing their meaning, or indicating that one expects that they cover more than one element, e.g. that \\\"Who all attended?\\\" is more than one person. (Some dialects only allow this to follow some words and not others.)"
                                        ],
                                        "tags": [
                                            "India",
                                            "Northern-Ireland",
                                            "Scotland",
                                            "Southern-US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "295b939b-9264-4176-a805-bc299fd28007",
                                                "sense_id": "18fe6771-c6ae-3e05-b78f-9f3b80b493b9",
                                                "text": "Q. Now, then, when you started to go to stake the claims, who all went along?"
                                            },
                                            {
                                                "example_id": "685b506d-e16f-4298-bd8a-847e8517b838",
                                                "sense_id": "18fe6771-c6ae-3e05-b78f-9f3b80b493b9",
                                                "text": "\"I mean, you could have called us—collect, o'course—jes' to let us know how-all it's a-goin'.\""
                                            },
                                            {
                                                "example_id": "187b7ad9-f0c6-4bf4-8172-838db966c9f5",
                                                "sense_id": "18fe6771-c6ae-3e05-b78f-9f3b80b493b9",
                                                "text": "\"Where all did he go? What exactly was his job?\" Gary shrugged and produced a weak laugh. \"I reckon the Middle East. Ain't that where all the oil is?\""
                                            },
                                            {
                                                "example_id": "7c167f5b-205b-4f10-a694-aa0f958ab0d4",
                                                "sense_id": "18fe6771-c6ae-3e05-b78f-9f3b80b493b9",
                                                "text": "\"Do you ever ask me what I want to see? Or ask me about where all I've gone, who all I've met, what all I've done? Never. Not for one second. And why? Because you don't give two hoops about me.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "all",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c2d2f03-d3a2-3773-82ed-075987a9953a",
                                        "entry_id": "f6e2641c-17e6-3c18-86d2-f769a1953b86",
                                        "glosses": [
                                            "Wholly; entirely; completely; totally."
                                        ],
                                        "tags": [
                                            "childish",
                                            "emphatic",
                                            "intensifier",
                                            "not-comparable",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "496ffdcc-4db0-4eb3-b071-62e40bf23758",
                                                "sense_id": "2c2d2f03-d3a2-3773-82ed-075987a9953a",
                                                "text": "She was sitting all alone.\n It suddenly went all quiet.\nI'm all done, Mommy! I did it all by myself."
                                            },
                                            {
                                                "example_id": "c951ca0f-a7a6-40bb-a183-fd309a7b882c",
                                                "sense_id": "2c2d2f03-d3a2-3773-82ed-075987a9953a",
                                                "text": "'Tis mystery all: th'Immortal dies"
                                            },
                                            {
                                                "example_id": "5274f2c7-f0a6-4051-bf56-c84bf92878c9",
                                                "sense_id": "2c2d2f03-d3a2-3773-82ed-075987a9953a",
                                                "text": "The parson, all unaware, dully pursued his calling, perched above the exquisite derision of their glances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "229e3a1f-50a0-321b-96ec-7bf1567448a6",
                                        "entry_id": "f6e2641c-17e6-3c18-86d2-f769a1953b86",
                                        "glosses": [
                                            "Apiece; each."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0be7cbb-f3e9-4802-b1b7-766b9dc4ce9a",
                                                "sense_id": "229e3a1f-50a0-321b-96ec-7bf1567448a6",
                                                "text": "The score was 30 all when the rain delay started."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25a990f7-f3d8-3868-a4c8-777ad5953289",
                                        "entry_id": "f6e2641c-17e6-3c18-86d2-f769a1953b86",
                                        "glosses": [
                                            "So much; used with \\\"the\\\" and a comparative."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67fe89ee-cda7-48ca-9bb5-9a686d316b6e",
                                                "sense_id": "25a990f7-f3d8-3868-a4c8-777ad5953289",
                                                "text": "Don't want to go? All the better since I lost the tickets."
                                            },
                                            {
                                                "example_id": "48bd935d-ea48-4ef4-84a1-44141629dddd",
                                                "sense_id": "25a990f7-f3d8-3868-a4c8-777ad5953289",
                                                "text": "If he leave the company, I'll have to work all the harder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ea958a4-e86c-34c4-aaa4-9ba6bd201d53",
                                        "entry_id": "f6e2641c-17e6-3c18-86d2-f769a1953b86",
                                        "glosses": [
                                            "Even; just."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1813dc1e-45e6-444d-95d7-3d827fb89f31",
                                                "sense_id": "1ea958a4-e86c-34c4-aaa4-9ba6bd201d53",
                                                "text": "All as his straying flock he fed."
                                            },
                                            {
                                                "example_id": "32ed446b-d9df-4b00-b366-1210539be6cc",
                                                "sense_id": "1ea958a4-e86c-34c4-aaa4-9ba6bd201d53",
                                                "text": "A damsel lay deploring / All on a rock reclined."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7287368-8ccf-32bf-b430-454959a19778",
                                        "entry_id": "f6e2641c-17e6-3c18-86d2-f769a1953b86",
                                        "glosses": [
                                            "A quotative particle, compare like."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c79722bb-5b4c-4cae-8e22-9a00de142afc",
                                                "sense_id": "d7287368-8ccf-32bf-b430-454959a19778",
                                                "text": "She was all, “Whatever.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
