                "senses": [
                    {
                        "sense_id": "2fe9994c-92ed-3fce-bd49-3cbdbba54403",
                        "entry_id": "6f6d45fd-27af-3027-a495-150b598ec801",
                        "glosses": [
                            "een uitkomst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5215d255-d7b4-4121-801c-d51c401b3694",
                                "sense_id": "2fe9994c-92ed-3fce-bd49-3cbdbba54403",
                                "text": "De resultaten van het proefwerk waren bedroevend slecht."
                            },
                            {
                                "example_id": "c16b1056-0a66-4b5f-a703-7577e59e2b72",
                                "sense_id": "2fe9994c-92ed-3fce-bd49-3cbdbba54403",
                                "text": "Mentaal sterke mensen: .... Verwachten niet onmiddellijk resultaten."
                            },
                            {
                                "example_id": "24cbaf63-c014-4f88-8dc1-d9afa44ca0d3",
                                "sense_id": "2fe9994c-92ed-3fce-bd49-3cbdbba54403",
                                "text": "'Zodra iets “goed” wordt gevonden, trekt het mensen aan, niet zelden met als resultaat de uiteindelijke ondergang van de maker."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89b9bf1e-34ba-48ad-85ff-8fc1a8559541",
                        "source_entry_id": "6f6d45fd-27af-3027-a495-150b598ec801",
                        "source_sense_id": "2fe9994c-92ed-3fce-bd49-3cbdbba54403",
                        "source_sense_description": "een uitkomst",
                        "target_lang_word": "Ergebnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ergebnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47bdc51c-2729-37bf-8884-e909e24dbbe5",
                                        "entry_id": "1f409ce0-bbfa-33cd-be2e-f7f7b3a9ed3c",
                                        "glosses": [
                                            "das, was bei einem Vorgang herauskommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4cc74dd-b816-44a8-90d7-4ef57a8ca830",
                                                "sense_id": "47bdc51c-2729-37bf-8884-e909e24dbbe5",
                                                "text": "Das Ergebnis seiner Bemühungen war gleich null."
                                            },
                                            {
                                                "example_id": "be5d81db-af08-4f14-8f2f-7a0d0dc75574",
                                                "sense_id": "47bdc51c-2729-37bf-8884-e909e24dbbe5",
                                                "text": "Das Ergebnis der Berechnung lautet 42."
                                            },
                                            {
                                                "example_id": "1cbba5ef-06ca-4151-8d6c-834cc57d2de5",
                                                "sense_id": "47bdc51c-2729-37bf-8884-e909e24dbbe5",
                                                "text": "„Die Ergebnisse wurden als Empfehlungen an den DAeC weitergeleitet, denn beschließen können die Segelflieger nichts, weil sie bislang – ebenso wie die Motorflieger, Modellflieger, Ballonfahrer und Fallschirmsportler – keine selbständige Sparte innerhalb des DAeC bilden, der den gesamten Luftsport beim Internationalen Luftfahrt-Verband (FAI) vertritt.“"
                                            },
                                            {
                                                "example_id": "2d1d305b-eb18-4fc0-85d4-fd5e0f0a0ea8",
                                                "sense_id": "47bdc51c-2729-37bf-8884-e909e24dbbe5",
                                                "text": "„Nahe dem Äquator gedeihen Bäume in strahlender Sonne, heftigem Regen und ganzjähriger Wärme. Das Ergebnis ist ein dichter tropischer Regenwald, eines der artenreichsten Gebiete der Erde.“"
                                            },
                                            {
                                                "example_id": "3ecf72dc-b32e-495f-92ce-09b3c6c190e7",
                                                "sense_id": "47bdc51c-2729-37bf-8884-e909e24dbbe5",
                                                "text": "„Das Hauptgewicht liegt in Deutschland auf dem Fachunterricht, der den praktischen Ausbildungsgang begleitet, ergänzt, die dort gewonnenen Ergebnisse sammelt, ordnet, vertieft und befestigt.“"
                                            },
                                            {
                                                "example_id": "bfa33a89-0b49-49eb-b24a-4cdbd037fb26",
                                                "sense_id": "47bdc51c-2729-37bf-8884-e909e24dbbe5",
                                                "text": "„Die Ergebnisse der Italien-Reise erlaubten es Leibniz, einen stringenten Plan der Welfengeschichte zu konzipieren, den er nun seinem Herzog mit der Versicherung vorlegte, das Werk in zwei Jahren abschließen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72ed3afd-9fc2-4260-a576-f32fc93081ed",
                        "source_entry_id": "6f6d45fd-27af-3027-a495-150b598ec801",
                        "source_sense_id": "2fe9994c-92ed-3fce-bd49-3cbdbba54403",
                        "source_sense_description": "een uitkomst",
                        "target_lang_word": "result",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "result",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfe9d20f-4a65-3644-aabd-b3d234562f62",
                                        "entry_id": "0495ac26-c07e-3336-b29b-8c81937e00d5",
                                        "glosses": [
                                            "To proceed, spring up or rise, as a consequence, from facts, arguments, premises, combination of circumstances, consultation, thought or endeavor."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85baee93-265a-41b7-a47f-26f4d7ea7afb",
                                                "sense_id": "bfe9d20f-4a65-3644-aabd-b3d234562f62",
                                                "text": "Pleasure and peace do naturally result from a holy and good life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f13297d-3dd0-30a7-ade5-45305b3a984c",
                                        "entry_id": "0495ac26-c07e-3336-b29b-8c81937e00d5",
                                        "glosses": [
                                            "To have as a consequence; to lead to; to bring about"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7823235-a667-4d28-bec5-856e7a294145",
                                                "sense_id": "7f13297d-3dd0-30a7-ade5-45305b3a984c",
                                                "text": "This measure will result in good or in evil."
                                            },
                                            {
                                                "example_id": "31945f18-2a91-457b-9991-41503a69dcfb",
                                                "sense_id": "7f13297d-3dd0-30a7-ade5-45305b3a984c",
                                                "text": "United's hopes of mounting a serious response suffered a blow within two minutes of the restart when Evans, who had endured a miserable afternoon, lost concentration and allowed Balotelli to steal in behind him. The defender's only reaction was to haul the Italian down, resulting in an inevitable red card."
                                            },
                                            {
                                                "example_id": "b41c82fd-4e63-48d2-b4b5-21e9bbf47350",
                                                "sense_id": "7f13297d-3dd0-30a7-ade5-45305b3a984c",
                                                "text": "In plants, the ability to recognize self from nonself plays an important role in fertilization, because self-fertilization will result in less diverse offspring than fertilization with pollen from another individual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f9ba2dd-7189-3cf4-ac15-479d15828d3b",
                                        "entry_id": "0495ac26-c07e-3336-b29b-8c81937e00d5",
                                        "glosses": [
                                            "To return to the proprietor (or heirs) after a reversion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2c2e041-96de-3819-a559-8b4237b0e3e9",
                                        "entry_id": "0495ac26-c07e-3336-b29b-8c81937e00d5",
                                        "glosses": [
                                            "To leap back; to rebound."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41374766-e447-4632-8ac6-e9428cfc6f8d",
                                                "sense_id": "f2c2e041-96de-3819-a559-8b4237b0e3e9",
                                                "text": "the huge round stone, resulting with a bound"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "result",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4124755b-ce87-32b2-a526-68ff75687a88",
                                        "entry_id": "9d5c35eb-9edf-362a-8b2f-677fab0749ed",
                                        "glosses": [
                                            "That which results; the conclusion or end to which any course or condition of things leads, or which is obtained by any process or operation; consequence or effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4c7935b-0000-437f-bfd9-16e424cccf1b",
                                                "sense_id": "4124755b-ce87-32b2-a526-68ff75687a88",
                                                "text": "the result of a course of action;  the result of a mathematical operation"
                                            },
                                            {
                                                "example_id": "21ee2781-0c28-4fc1-b5f2-6d5d7b2267c1",
                                                "sense_id": "4124755b-ce87-32b2-a526-68ff75687a88",
                                                "text": "In America alone, people spent $170 billion on “direct marketing”—junk mail of both the physical and electronic varieties—last year. Yet of those who received unsolicited adverts through the post, only 3% bought anything as a result. If the bumf arrived electronically, the take-up rate was 0.1%. And for online adverts the “conversion” into sales was a minuscule 0.01%."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6468c915-c616-3af7-9ffc-cbe7290582e2",
                                        "entry_id": "9d5c35eb-9edf-362a-8b2f-677fab0749ed",
                                        "glosses": [
                                            "The final product, beneficial or tangible effect(s) achieved by effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86fe3642-729a-4ff3-a7c9-55bd0a62c902",
                                                "sense_id": "6468c915-c616-3af7-9ffc-cbe7290582e2",
                                                "text": "The stories did not seem to me to touch life. They were plainly intended to have a bracing moral effect, and perhaps had this result for the people at whom they were aimed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14094b54-7dd2-3da1-b8c2-ca23a3f2d77c",
                                        "entry_id": "9d5c35eb-9edf-362a-8b2f-677fab0749ed",
                                        "glosses": [
                                            "The decision or determination of a council or deliberative assembly; a resolve; a decree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3df02487-df97-4269-bdb6-88147e66a83f",
                                                "sense_id": "14094b54-7dd2-3da1-b8c2-ca23a3f2d77c",
                                                "text": "Then of their session ended they bid cry / With trumpet's regal sound the great result."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ff3077c-9951-3981-9d45-88dc4e134a9c",
                                        "entry_id": "9d5c35eb-9edf-362a-8b2f-677fab0749ed",
                                        "glosses": [
                                            "A flying back; resilience."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32181776-306c-4d7d-b3e7-394d3eee2a8d",
                                                "sense_id": "0ff3077c-9951-3981-9d45-88dc4e134a9c",
                                                "text": "Sound is produced between the string and the air by the return or the result of the string."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "412de87d-61a6-3563-a8ad-b2e049cfa7d0",
                                        "entry_id": "9d5c35eb-9edf-362a-8b2f-677fab0749ed",
                                        "glosses": [
                                            "The final score in a game."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d5b672d-b2a7-4223-bdfb-4270acec545f",
                                                "sense_id": "412de87d-61a6-3563-a8ad-b2e049cfa7d0",
                                                "text": "It had been his intention to go to Wimbledon, but as he himself said: “Why be blooming well frizzled when you can hear all the results over the wireless. And results are all that concern me. […]”"
                                            },
                                            {
                                                "example_id": "80bf4c4a-cb3b-40a8-9ef2-be89c7373fa4",
                                                "sense_id": "412de87d-61a6-3563-a8ad-b2e049cfa7d0",
                                                "text": "The Gunners boss has been heavily criticised for his side's poor start to the Premier League season but this result helps lift the pressure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55ac3eb9-dbbd-3e49-a398-f8aaf88fa015",
                                        "entry_id": "9d5c35eb-9edf-362a-8b2f-677fab0749ed",
                                        "glosses": [
                                            "A positive or favourable outcome for someone."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "result",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1f2cf17-4a48-3710-abfc-5d62b0ae6584",
                                        "entry_id": "a60bb447-8428-300c-a24a-aded3f306456",
                                        "glosses": [
                                            "An exclamation of joy following a favorable outcome."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f43f260c-7efe-4aa9-b889-dec3fd981b33",
                                                "sense_id": "e1f2cf17-4a48-3710-abfc-5d62b0ae6584",
                                                "text": "'Yes! Result! Game on!' He leans forward to a mike fixed over the desk and presses one of the […]"
                                            },
                                            {
                                                "example_id": "bfcf9741-950f-47e1-aa62-a728855bf73c",
                                                "sense_id": "e1f2cf17-4a48-3710-abfc-5d62b0ae6584",
                                                "text": "'Yes! Result, Nick!' He heard a distant cheer. 'Right, well I'll give you a ring on Saturday, make the arrangements."
                                            },
                                            {
                                                "example_id": "9f2b79ab-a665-42d3-ba9c-d8443eb82639",
                                                "sense_id": "e1f2cf17-4a48-3710-abfc-5d62b0ae6584",
                                                "text": "I was lucky enough to win by a knock-out in the second round - My opponent was Tpr McAdoo - HQ squadron won by nine fights to three (21pts to 15pts) - YES! RESULT."
                                            },
                                            {
                                                "example_id": "787a73a3-4f1b-4738-9d1d-69b2e273ac72",
                                                "sense_id": "e1f2cf17-4a48-3710-abfc-5d62b0ae6584",
                                                "text": "(picking a lock) I wonder what I did...\n(the lock opens) Hey hey, result!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31ac207c-90b2-414e-8a40-26d7f77efc45",
                        "source_entry_id": "6f6d45fd-27af-3027-a495-150b598ec801",
                        "source_sense_id": "2fe9994c-92ed-3fce-bd49-3cbdbba54403",
                        "source_sense_description": "een uitkomst",
                        "target_lang_word": "résultat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "résultat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34fee5d3-0888-3d81-bd15-612c5ab91e0d",
                                        "entry_id": "e5bc4f1c-b418-386a-bcd0-c44c00227615",
                                        "glosses": [
                                            "Ce qui résulte, ce qui s’ensuit d’une délibération, d’un principe, d’une opération, d’un évènement, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca55001c-2232-4dbc-b8ac-081e51328725",
                                                "sense_id": "34fee5d3-0888-3d81-bd15-612c5ab91e0d",
                                                "text": "Les obus sont chargés avec une poudre spéciale appelée lydite, dont les essais ont donné des résultats terrifiants."
                                            },
                                            {
                                                "example_id": "dd0eb7cb-3f45-45af-92ba-e01c64106907",
                                                "sense_id": "34fee5d3-0888-3d81-bd15-612c5ab91e0d",
                                                "text": "Dans le passé, beaucoup de révolutions furent le résultat de coalitions entre groupes mécontents ; […]."
                                            },
                                            {
                                                "example_id": "694ce9b8-ab93-45f0-a640-1be0bc145e42",
                                                "sense_id": "34fee5d3-0888-3d81-bd15-612c5ab91e0d",
                                                "text": "Il a marqué les esprits durant son deuxième passage au pouvoir, beaucoup plus long (2012-2020) avec sa politique économique audacieuse surnommée les « Abenomics », combinant des relances budgétaires massives avec une politique monétaire ultra-accommodante, une stratégie qui perdure encore au Japon, malgré des résultats inégaux faute de réformes structurelles suffisantes."
                                            },
                                            {
                                                "example_id": "d22112c8-dcbd-4c0f-ac6c-b852f74cb56c",
                                                "sense_id": "34fee5d3-0888-3d81-bd15-612c5ab91e0d",
                                                "text": "Si les engrais verts donnent de fort bons résultats dans les sols infertiles et épuisés, à plus forte raison sont-ils avantageux dans les sols fertiles et riches."
                                            },
                                            {
                                                "example_id": "78244b60-1924-44c2-b26d-9b5f8dc5c293",
                                                "sense_id": "34fee5d3-0888-3d81-bd15-612c5ab91e0d",
                                                "text": "Après la publication des résultats de l’écrit sur le site de publinet, les candidats admissibles reçoivent une convocation pour assister à une réunion au lycée Saint-Louis en fin d'après-midi."
                                            },
                                            {
                                                "example_id": "c116822a-0d61-4c9c-b429-42543ba0e4df",
                                                "sense_id": "34fee5d3-0888-3d81-bd15-612c5ab91e0d",
                                                "text": "Le résultat d’une expérience chimique."
                                            },
