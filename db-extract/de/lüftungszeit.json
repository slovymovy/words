                "senses": [
                    {
                        "sense_id": "4689b725-a74f-3f0b-bf56-fc4a857413fd",
                        "entry_id": "07e406b4-19f7-34bb-8159-c38d5c9f22ce",
                        "glosses": [
                            "zeitliche Erstreckung der Lüftung von einem Raum oder Gebäude; auch in Zeitabschnitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96dbff01-4d82-4710-923c-35b48f255e21",
                                "sense_id": "4689b725-a74f-3f0b-bf56-fc4a857413fd",
                                "text": "„Gerade im Winter sollte die Lüftungszeit aber auf höchstens 10 Minuten beschränkt werden, damit die Räume nicht zu sehr auskühlen und unnötige Aufheizkosten vermieden werden.“"
                            },
                            {
                                "example_id": "1ca790c5-bd8e-4ab5-9bbd-af8624e3f91f",
                                "sense_id": "4689b725-a74f-3f0b-bf56-fc4a857413fd",
                                "text": "„Die Wände kühlen bei all diesen kurzen Lüftungszeiten nicht aus und die Zimmer werden schnell wieder warm.“"
                            },
                            {
                                "example_id": "46c9917c-e93a-48ca-a465-dd47d8f1e27d",
                                "sense_id": "4689b725-a74f-3f0b-bf56-fc4a857413fd",
                                "text": "„Daraus folgt, dass man im Winter wesentlich kürzere Lüftungszeiten für einen Luftwechsel benötigt als im Sommer.“"
                            },
                            {
                                "example_id": "06deb24d-c3f9-450a-b824-160771f2a9f7",
                                "sense_id": "4689b725-a74f-3f0b-bf56-fc4a857413fd",
                                "text": "„Kann das Bad nach dem morgendlichen Duschen erst mittags gelüftet werden, verdoppelt sich die Lüftungszeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
