                "senses": [
                    {
                        "sense_id": "88eb834a-da41-32be-a68b-676e88014a71",
                        "entry_id": "74ac0743-55f5-38ef-b265-ce500e4d8e24",
                        "glosses": [
                            "gemaakt, ontwikkeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5f74729-9d70-4b85-bbbf-285da5d9159f",
                                "sense_id": "88eb834a-da41-32be-a68b-676e88014a71",
                                "text": "Hij heeft het huis met eigen handen opgebouwd."
                            },
                            {
                                "example_id": "32fe68b1-59fe-4b63-8cac-fb6db8cc45ed",
                                "sense_id": "88eb834a-da41-32be-a68b-676e88014a71",
                                "text": "Hij heeft goede relaties met zijn klangen opgebouwd."
                            },
                            {
                                "example_id": "433307ec-d67d-4988-9acd-e0b18ffbd245",
                                "sense_id": "88eb834a-da41-32be-a68b-676e88014a71",
                                "text": "Ook boer Henk Koster kwam afscheid nemen. \"Ik heb de hele ontwikkeling meegemaakt, vanaf het begin. Lenie 't Hart kwam vroeger bij ons spullen lenen om zeehondenpups groot te krijgen. Wat hier is opgebouwd, is een succes voor Pieterburen én voor de zeehonden. Voor de levendigheid in het dorp was het beter geweest als het hier was gebleven\", zei hij."
                            }
                        ]
                    }
