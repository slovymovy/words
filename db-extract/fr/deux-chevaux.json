        "fr-extract.jsonl": [
            {
                "entry_id": "4f519983-2312-388c-9ea5-ef01f17f7ae7",
                "word": "deux-chevaux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9150e3d4-edf4-3bd2-bf88-cf5dafd793b7",
                        "entry_id": "4f519983-2312-388c-9ea5-ef01f17f7ae7",
                        "glosses": [
                            "Modèle de véhicule automobile de la marque Citroën, la 2CV."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f53e8387-08bd-4c03-bbe2-348debac6fe0",
                                "sense_id": "9150e3d4-edf4-3bd2-bf88-cf5dafd793b7",
                                "text": "Sur le trottoir, deux voitures stationnent : une deux-chevaux et une DS. — Laquelle préférez-vous ? me demande Frank."
                            },
                            {
                                "example_id": "8eba1454-219b-4775-9f39-53b1c13a14f9",
                                "sense_id": "9150e3d4-edf4-3bd2-bf88-cf5dafd793b7",
                                "text": "Hé, dis-donc ! c'est normal que ça ralentisse comme ça quand tu passes la quatrième ?\n- Ben ouais, ça fait ça sur toutes les dianes.\n- La deux-chevaux de mon beauf, elle a vachement plus la patate.\n-Ouais... mais ton beauf, c'est pas pareil."
                            }
                        ]
                    },
                    {
                        "sense_id": "49e9babd-3d75-3e63-b2a6-3d63ff765c98",
                        "entry_id": "4f519983-2312-388c-9ea5-ef01f17f7ae7",
                        "glosses": [
                            "Automobile dont la puissance fiscale est de 2 CV."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40583c92-4733-49de-86f2-a134f8149391",
                                "sense_id": "49e9babd-3d75-3e63-b2a6-3d63ff765c98",
                                "text": "La vignette n’est pas chère, c’est une deux-chevaux."
                            },
                            {
                                "example_id": "1d0be202-0cb3-4934-b82b-52adadf67fe1",
                                "sense_id": "49e9babd-3d75-3e63-b2a6-3d63ff765c98",
                                "text": "Abrév. de CHEVAL-VAPEUR, qui, au pluriel, sert à désigner une automobile par sa puissance fiscale : Une deux-chevaux, une quatre-chevaux (symb. : CV)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6c2a95a-b179-4065-b938-acfc4b7fde62",
                        "source_entry_id": "4f519983-2312-388c-9ea5-ef01f17f7ae7",
                        "source_sense_id": "9150e3d4-edf4-3bd2-bf88-cf5dafd793b7",
                        "source_sense_description": "automobile de la marque Citroën",
                        "target_lang_word": "Ente",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ente",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7d7b07-02f2-3375-9a30-37725c00f533",
                                        "entry_id": "c1487da2-3c7f-3ae3-ad6e-f750cdcb849b",
                                        "glosses": [
                                            "kleinerer Wasservogel aus der Familie der Entenvögel (Anatidae), speziell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf6614e6-0557-431e-9b3c-0c647d1e010e",
                                                "sense_id": "2e7d7b07-02f2-3375-9a30-37725c00f533",
                                                "text": "\"Eigentlich hat's ja nicht viel auf sich mit dem besten Pessimismus. An dem Glücklichen gleitet er ab wie Wasser an der pomadisierten Ente, und der Unglückliche weiß ohne weiteres Bescheid.\""
                                            },
                                            {
                                                "example_id": "223b392e-3d9d-4a3d-8f1c-886d8abceb21",
                                                "sense_id": "2e7d7b07-02f2-3375-9a30-37725c00f533",
                                                "text": "Auf dem Teich schwimmen Enten."
                                            },
                                            {
                                                "example_id": "8719bf3b-3072-4957-9075-e23e04fd8aab",
                                                "sense_id": "2e7d7b07-02f2-3375-9a30-37725c00f533",
                                                "text": "„Der eine legt an, zielt, schießt und eine tote Ente fällt direkt vor seine Füße."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6e1a632d-c1b2-3f2c-b6f9-8a0999bc806b",
                                        "entry_id": "c1487da2-3c7f-3ae3-ad6e-f750cdcb849b",
                                        "glosses": [
                                            "kleinerer Wasservogel aus der Familie der Entenvögel (Anatidae), speziell",
                                            "das Weibchen, [b] die Hausente"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "6161450d-74df-32b0-90ce-91917ec03470",
                                        "entry_id": "c1487da2-3c7f-3ae3-ad6e-f750cdcb849b",
                                        "glosses": [
                                            "Ente(n)^([1]) als Speise"
                                        ],
                                        "tags": [
                                            "unzählbar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5450f5b1-b2ec-45bd-b4f1-fa758930d847",
                                                "sense_id": "6161450d-74df-32b0-90ce-91917ec03470",
                                                "text": "Heute gibt's gebratene Ente zum Mittagessen."
                                            },
                                            {
                                                "example_id": "87b0924d-8ced-42e8-a14e-88c980741c17",
                                                "sense_id": "6161450d-74df-32b0-90ce-91917ec03470",
                                                "text": "„Und was hier mit einer Ente geschah, empörte seinen Feinschmeckerstolz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9027a5e0-2c25-3928-938b-fb137387c70d",
                                        "entry_id": "c1487da2-3c7f-3ae3-ad6e-f750cdcb849b",
                                        "glosses": [
                                            "eine auf Gerüchten basierende, unbestätigte Pressemeldung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "511bab05-a65a-4e91-b64a-4011ee963f3d",
                                                "sense_id": "9027a5e0-2c25-3928-938b-fb137387c70d",
                                                "text": "Das war wohl eine Ente, dass der Minister erpresst wird."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "956cf8a1-afa3-3971-b4d0-f8fa58af793a",
                                        "entry_id": "c1487da2-3c7f-3ae3-ad6e-f750cdcb849b",
                                        "glosses": [
                                            "das Automodell Citroën 2CV"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53d656a5-c8f8-4704-a831-62e4c44fe3b6",
                                                "sense_id": "956cf8a1-afa3-3971-b4d0-f8fa58af793a",
                                                "text": "Fahr doch an meiner Ente vorbei!"
                                            },
                                            {
                                                "example_id": "2a1dc689-fc3a-48fe-ab53-c937b09a6768",
                                                "sense_id": "956cf8a1-afa3-3971-b4d0-f8fa58af793a",
                                                "text": "Ente zu fahren hatte etwas ganz besonderes. Entenfahrer grüßten sich."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "665e9059-cfdb-37e1-958c-7f4ecd9d63eb",
                                        "entry_id": "c1487da2-3c7f-3ae3-ad6e-f750cdcb849b",
                                        "glosses": [
                                            "Urinflasche für Männer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20f31cc0-ce5b-4722-83f4-f3bb34145468",
                                                "sense_id": "665e9059-cfdb-37e1-958c-7f4ecd9d63eb",
                                                "text": "Da er im Krankenhaus nicht auf Toilette gehen konnte, musste er eine Ente benutzen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
