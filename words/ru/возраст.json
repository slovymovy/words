{
    "word_family": [
        "возрастной"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b27297f4-6df9-3116-bc1d-1d54936ab0f1",
                    "sense_definition": "Количество прожитых лет от рождения.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его <w>возраст</w> составляет двадцать лет.",
                            "target_lang_translations": {
                                "en": "His <w>age</w> is twenty years."
                            }
                        },
                        {
                            "text": "В этом <w>возрасте</w> дети начинают ходить в школу.",
                            "target_lang_translations": {
                                "en": "At this <w>age</w>, children start going to school."
                            }
                        }
                    ],
                    "common_phrases": [
                        "пожилой возраст",
                        "детский возраст"
                    ],
                    "target_lang_definitions": {
                        "en": "The number of years a person or living thing has lived since birth."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "age",
                                "target_lang_sense_clarification": "The amount of time a being has been alive."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e730266d-5547-3feb-9350-ae68e915b668",
                    "sense_definition": "Общая продолжительность жизни или существования чего-либо.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учёные определили <w>возраст</w> этой древней находки.",
                            "target_lang_translations": {
                                "en": "Scientists determined the <w>age</w> of this ancient find."
                            }
                        },
                        {
                            "text": "Геологический <w>возраст</w> этих гор составляет миллионы лет.",
                            "target_lang_translations": {
                                "en": "The geological <w>age</w> of these mountains is millions of years."
                            }
                        }
                    ],
                    "common_phrases": [
                        "возраст земли"
                    ],
                    "target_lang_definitions": {
                        "en": "The total duration of existence of an object or phenomenon."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "age",
                                "target_lang_sense_clarification": "The amount of time something has been in existence."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09184301-2487-3dca-810d-dac5215dfcfd",
                    "sense_definition": "Определенный период в развитии человека или живого организма.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Переходный <w>возраст</w> часто бывает трудным для подростков.",
                            "target_lang_translations": {
                                "en": "The <w>transitional age</w> (adolescence) is often difficult for teenagers."
                            }
                        },
                        {
                            "text": "В зрелом <w>возрасте</w> люди начинают больше ценить время.",
                            "target_lang_translations": {
                                "en": "In <w>mature age</w>, people begin to value time more."
                            }
                        }
                    ],
                    "common_phrases": [
                        "переходный возраст",
                        "зрелый возраст"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific period in the development of a person or organism."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stage of life",
                                "target_lang_sense_clarification": "A particular phase or period in a person's development."
                            },
                            {
                                "target_lang_word": "age",
                                "target_lang_sense_clarification": "A particular stage of life."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d29a75a-c089-3db5-901d-84e1336544c9",
                    "sense_definition": "Период времени с момента создания или появления чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот дом уже почтенного <w>возраста</w>.",
                            "target_lang_translations": {
                                "en": "This house is already of a <w>venerable age</w>."
                            }
                        },
                        {
                            "text": "Техника такого <w>возраста</w> требует бережного обращения.",
                            "target_lang_translations": {
                                "en": "Equipment of such an <w>age</w> requires careful handling."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The period of time since something was created or appeared."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "age",
                                "target_lang_sense_clarification": "The time elapsed since an object's creation."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68142e71-45a9-35a4-ac82-da49428a7a69",
                    "sense_definition": "Ступень или этап в росте и развитии чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Растение достигло нового <w>возраста</w> и начало цвести.",
                            "target_lang_translations": {
                                "en": "The plant reached a new <w>stage of development</w> and began to bloom."
                            }
                        },
                        {
                            "text": "Каждый <w>возраст</w> развития требует особых условий.",
                            "target_lang_translations": {
                                "en": "Each <w>developmental stage</w> requires special conditions."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A step or phase in the growth and development of something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stage",
                                "target_lang_sense_clarification": "A distinct phase in a process of development."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}