                        "examples": [
                            {
                                "example_id": "681f0c93-c982-4fb9-8fcf-df2c98f4eca6",
                                "sense_id": "087d1270-bd62-3166-b9d5-d6dc6f580e2e",
                                "text": "Ook vrouwen kijken naar erotische films."
                            },
                            {
                                "example_id": "ceb09617-9d5e-4cbf-8ac8-526893f8a4f3",
                                "sense_id": "087d1270-bd62-3166-b9d5-d6dc6f580e2e",
                                "text": "Zijn erotische opmerkingen werden gezien als seksueel ongewenst gedrag."
                            },
                            {
                                "example_id": "0cf5aa84-018f-42b7-8f45-40d150e53416",
                                "sense_id": "087d1270-bd62-3166-b9d5-d6dc6f580e2e",
                                "text": "Misschien was dit de meest fantastische reis die hij ooit had gemaakt, evenzeer een erotisch als een politiek als een cultuurhistorisch avontuur."
                            }
                        ]
                    }
                ],
