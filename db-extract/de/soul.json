                    {
                        "sense_id": "a5eadda4-2f8f-38cd-a430-f8015898ae7d",
                        "entry_id": "ffe9f714-0d1d-3423-8451-53e27db1014e",
                        "glosses": [
                            "etwa ab Mitte der 1950er Jahre entstandene musikalische Stilrichtung der afroamerikanischen Unterhaltungsmusik"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "a1032b6f-dc59-4033-bc1a-95714de1d3aa",
                                "sense_id": "a5eadda4-2f8f-38cd-a430-f8015898ae7d",
                                "text": "„The Ashantis“, eine Mischung aus Soul, Barmusik und afrikanischer Musik."
                            },
                            {
                                "example_id": "d17b0365-5f4d-4908-b4c2-3913fe557019",
                                "sense_id": "a5eadda4-2f8f-38cd-a430-f8015898ae7d",
                                "text": "„Eine der größten Legende[n] des Soul ist tot.“"
                            },
                            {
                                "example_id": "e77a8bf3-e1b6-428a-a7be-0cfc7ea405d2",
                                "sense_id": "a5eadda4-2f8f-38cd-a430-f8015898ae7d",
                                "text": "„Der heutige Format-R’n’B hat mit dem erdigen Soul der 70er kaum mehr etwas zu tun.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e50164b-76d0-43a7-8d6c-fe6c99dfe9f5",
                        "source_entry_id": "ffe9f714-0d1d-3423-8451-53e27db1014e",
                        "source_sense_id": "a5eadda4-2f8f-38cd-a430-f8015898ae7d",
                        "target_lang_word": "soul",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soul",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e398c16-fc71-3ae0-9438-55bca4a5af46",
                                        "entry_id": "74e35e4d-2b48-3678-971d-adc98545fe71",
                                        "glosses": [
                                            "The spirit or essence of a person usually thought to consist of one's thoughts and personality, often believed to live on after the person's death."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dd0932b-ba75-4738-becc-bf21bb91a1d1",
                                                "sense_id": "5e398c16-fc71-3ae0-9438-55bca4a5af46",
                                                "text": "1836, Hans Christian Andersen (translated into English by Mrs. H. B. Paull in 1872), The Little Mermaid\n\"Among the daughters of the air,\" answered one of them. \"A mermaid has not an immortal soul, nor can she obtain one unless she wins the love of a human being. On the power of another hangs her eternal destiny. But the daughters of the air, although they do not possess an immortal soul, can, by their good deeds, procure one for themselves."
                                            },
                                            {
                                                "example_id": "3a1f238a-c92a-4dee-aee3-1a513ba99dc1",
                                                "sense_id": "5e398c16-fc71-3ae0-9438-55bca4a5af46",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or[…]. And at last I began to realize in my harassed soul that all elusion was futile, and to take such holidays as I could get, when he was off with a girl, in a spirit of thankfulness."
                                            },
                                            {
                                                "example_id": "57368982-5f0c-414b-a422-7c2c1e2e3c2f",
                                                "sense_id": "5e398c16-fc71-3ae0-9438-55bca4a5af46",
                                                "text": "Flowey: See that heart? That is your SOUL, the very culmination of your being!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec694770-e2d0-32ec-bb14-2b8a3b38abaa",
                                        "entry_id": "74e35e4d-2b48-3678-971d-adc98545fe71",
                                        "glosses": [
                                            "The spirit or essence of anything."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cfb7d82-892c-4fb3-b508-46d7c9603248",
                                                "sense_id": "ec694770-e2d0-32ec-bb14-2b8a3b38abaa",
                                                "text": "From another point of view, it was a place without a soul. The well-to-do had hearts of stone; the rich were brutally bumptious; the Press, the Municipality, all the public men, were ridiculously, vaingloriously self-satisfied."
                                            },
                                            {
                                                "example_id": "e755f700-c7a5-4e4b-b351-6563d1ad8f04",
                                                "sense_id": "ec694770-e2d0-32ec-bb14-2b8a3b38abaa",
                                                "text": "It is possible with only these qualities for a man to be a reasonably efficient President, but there is one thing more needed to make him a great President. It is that quality of soul which makes a man loved by little children, by dumb animals, that quality of soul which makes him a strong help to all those in sorrow or in trouble, that quality which makes him not merely admired, but loved by all the people - the quality of sympathetic understanding of the human heart, of real interest in one's fellow men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f0b268e-4e8f-3714-87ba-b3ea3b835158",
                                        "entry_id": "74e35e4d-2b48-3678-971d-adc98545fe71",
                                        "glosses": [
                                            "Life, energy, vigor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8f424cd-665d-4748-a6dc-2b7b1c486850",
                                                "sense_id": "8f0b268e-4e8f-3714-87ba-b3ea3b835158",
                                                "text": "That he vvants Algebra he muſt confeſs. / But not a ſoul to give our arms ſucceſs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "490cdc19-42db-3e7d-95cd-df5a98a9b639",
                                        "entry_id": "74e35e4d-2b48-3678-971d-adc98545fe71",
                                        "glosses": [
                                            "Soul music."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb5ee420-9374-307c-bdc5-209b1b24a415",
                                        "entry_id": "74e35e4d-2b48-3678-971d-adc98545fe71",
                                        "glosses": [
                                            "A person, especially as one among many."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "488c0d6e-f09a-46d5-bb86-cfe6ed2cfd56",
                                                "sense_id": "fb5ee420-9374-307c-bdc5-209b1b24a415",
                                                "text": "18 January 1915, D. H. Lawrence, letter to William Hopkin\nI want to gather together about twenty souls and sail away from this world of war and squalor and found a little colony where there shall be no money but a sort of communism as far as necessaries of life go, and some real decency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc984ed8-47e6-3347-8316-8ae5c667b8df",
                                        "entry_id": "74e35e4d-2b48-3678-971d-adc98545fe71",
                                        "glosses": [
                                            "An individual life."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29999b5b-52c9-45b4-ad8b-874e539fdce9",
                                                "sense_id": "fc984ed8-47e6-3347-8316-8ae5c667b8df",
                                                "text": "Fifty souls were lost when the ship sank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0f8af4e-6998-3520-997e-6659c39dc0dd",
                                        "entry_id": "74e35e4d-2b48-3678-971d-adc98545fe71",
                                        "glosses": [
                                            "A kind of submanifold involved in the soul theorem of Riemannian geometry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "soul",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6176c79-149e-3724-8d68-489d5eca5f11",
