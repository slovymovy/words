                        "examples": [
                            {
                                "example_id": "12467173-73ce-4674-a0be-3aabc93b1747",
                                "sense_id": "1306e37d-955e-3329-8f01-43830cb83476",
                                "text": "De chili groeit overal; het is eene plant, die zeer veel verduren kan; de kunst bij de aankweeking doet dezelve wel in grootte toenemen , maar in kracht verminderen."
                            }
                        ]
                    },
                    {
