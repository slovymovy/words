                                "example_id": "37272854-2f13-4b16-8fce-f90a352ae7e5",
                                "sense_id": "20490a06-6df6-3991-b846-5f83f0771912",
                                "text": "[…] a death which overtook one galloping frantically over a desert was wholly irregular and discomposing."
                            },
                            {
                                "example_id": "95c70e11-ff94-42db-a75d-831659e58978",
                                "sense_id": "20490a06-6df6-3991-b846-5f83f0771912",
                                "text": "By that time the fellow had managed to tug and jerk his hat clear of his head, and advanced with slight bows at Ruthvel, who told me the sight was so discomposing that for some time he listened, quite unable to make out what that apparition wanted."
                            },
                            {
                                "example_id": "716b6916-2a4a-4ce8-bff5-1fcc24eb651b",
                                "sense_id": "20490a06-6df6-3991-b846-5f83f0771912",
                                "text": "The prospect was discomposing."
                            },
                            {
                                "example_id": "cb009ad1-de16-4c14-8e8d-08cc8b9d37fa",
                                "sense_id": "20490a06-6df6-3991-b846-5f83f0771912",
                                "text": "The news has had a decidedly discomposing effect already."
                            }
                        ]
                    }
