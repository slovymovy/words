                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae6c135-4b96-4850-bea8-a80444f4b4a4",
                                                "sense_id": "f676b9a9-31a8-3bb9-b27e-bb469ac47c01",
                                                "text": "This declaration, by the British director Peter Brook, is one of dozens that are recited, chanted, sung, supertitled or otherwise transmitted in the course of “Dr. C (Or How I Learned to Act in Eight Steps),” presented by Theater Mitu at the 3LD Art & Technology Center."
