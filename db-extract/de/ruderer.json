                                    {
                                        "sense_id": "db889191-27ee-3276-9b77-c50a9d299645",
                                        "entry_id": "32d59eb6-4414-3d0a-8f79-20bdeb98ce11",
                                        "glosses": [
                                            "attrezzo ginnico per eseguire esercizi di voga, costituito da un sedile applicato ad un carrello mobile che scorre su guide e da due mezzi remi controllati da molle che oppongono una resistenza simile a quella dell'acqua"
                                        ],
