                "senses": [
                    {
                        "sense_id": "012d0d09-d6d5-385b-b48c-13d55606f4d5",
                        "entry_id": "b4ac891a-f127-38ad-ba71-2ee7b5acbb0b",
                        "glosses": [
                            "Cheval de trait rapide, originaire du Boulonnais, sur la côte de la Manche, en France, dont la taille au garrot est de 1,55 à 1,75 m : attelage, labour et débardage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34925654-93e0-4331-8c0f-062f393241d1",
                                "sense_id": "012d0d09-d6d5-385b-b48c-13d55606f4d5",
                                "text": "Nous terminons en disant que l’élevage à l’écurie est un puissant agent de modification : le cheval de pur sang anglais, le boulonnais et le percheron en sont des exemples frappants."
                            },
                            {
                                "example_id": "84f25391-bda9-4b90-a6d0-e6d4c65ce57e",
                                "sense_id": "012d0d09-d6d5-385b-b48c-13d55606f4d5",
                                "text": "Anciennement, même le profane pouvait distinguer petit et gros ardennais, petit et gros boulonnais, postier et trait breton."
                            }
                        ]
                    }
                ],
