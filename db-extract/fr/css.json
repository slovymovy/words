                                        "sense_id": "e4082f92-d5a7-3c73-a81a-b8bc0fb97d5c",
                                        "entry_id": "a2784736-5faa-315b-968a-85c46a5461e9",
                                        "glosses": [
                                            "Initialism of Content Scramble System, a DRM and encryption system for DVDs."
                                        ],
                                        "tags": [
                                            "abbreviation",
