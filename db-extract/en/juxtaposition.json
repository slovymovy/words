                        "target_lang_word": "Juxtaposition",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Juxtaposition",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3bd5b8a8-a069-34f9-ada6-fc3a24bd57c3",
                                        "entry_id": "cdb5b392-ff77-3f7d-9af3-9a51112040f6",
                                        "glosses": [
                                            "Linguistik/Sprachwissenschaft, speziell: Wortbildung: Zusammenrückung von Einzelwörtern in einem Wort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d153b41a-4de8-4717-93be-7e22682a4931",
                                                "sense_id": "3bd5b8a8-a069-34f9-ada6-fc3a24bd57c3",
                                                "text": "Beispiele für Juxtapositionen im Bereich der Wortbildung sind Wörter wie Haudrauf oder Tunichtgut."
                                            },
                                            {
                                                "example_id": "08c2c850-4975-4318-baf1-1ae1dec8d680",
                                                "sense_id": "3bd5b8a8-a069-34f9-ada6-fc3a24bd57c3",
                                                "text": "„Diese Gebilde nennt man deshalb Z u s a m m e n r ü c k u n g e n (J u x t a p o s i t i o n).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8ebefef5-de32-3e5e-a97a-3cdda40635f6",
                                        "entry_id": "cdb5b392-ff77-3f7d-9af3-9a51112040f6",
                                        "glosses": [
                                            "Linguistik/Sprachwissenschaft, speziell: Wortstruktur: Wortstruktur in agglutinierenden Sprachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d10008a-9a49-4ccc-ae72-36a37a6e45ac",
                                                "sense_id": "8ebefef5-de32-3e5e-a97a-3cdda40635f6",
                                                "text": "Als Juxtaposition wird auch die Aneinanderreihung von Morphemen in den Wörtern agglutinierender Sprachen aufgefasst."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c87e6668-8c95-3356-9c79-8b506eb67a97",
                                        "entry_id": "cdb5b392-ff77-3f7d-9af3-9a51112040f6",
                                        "glosses": [
                                            "Linguistik/Sprachwissenschaft: benachbarte Position von linguistischen Elementen, zum Beispiel im Falle der engen Apposition oder getrennt geschriebener Komposita"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dac31b25-4767-4bc5-9378-89f2c21f142f",
                                                "sense_id": "c87e6668-8c95-3356-9c79-8b506eb67a97",
                                                "text": "„Als »determinative« Juxtaposition bezeichnet man enge appositionelle Konstruktionen wie Kaiserin Elisabeth, Herr Maier.“"
                                            },
                                            {
                                                "example_id": "a4b40046-d30e-4770-a2d7-56b901e2abac",
                                                "sense_id": "c87e6668-8c95-3356-9c79-8b506eb67a97",
                                                "text": "Auch die englische Wortgruppe »football game« (= Fußballspiel) wird als Juxtaposition bezeichnet."
                                            },
                                            {
                                                "example_id": "b6564f92-2a19-401d-ac09-e2373cecf40e",
                                                "sense_id": "c87e6668-8c95-3356-9c79-8b506eb67a97",
                                                "text": "„Bei der Mehrzahl der durch Juxtaposition gebildeten Zusammensetzungen ist daher auch die dem Französischen eigene Kompositionsfolge déterminé + déterminant festzustellen:…“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "58b5dc92-064e-3891-8ecb-d628c0ff9595",
                                        "entry_id": "cdb5b392-ff77-3f7d-9af3-9a51112040f6",
                                        "glosses": [
                                            "Linguistik/Sprachwissenschaft: benachbarte Position von linguistischen Elementen zum Ausdruck der Koordination"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2a0df73-c92f-4f61-821a-d6a864d6e047",
                                                "sense_id": "58b5dc92-064e-3891-8ecb-d628c0ff9595",
                                                "text": "Die Juxtaposition der Adjektive in »der arme, kleine, kranke Junge« zeigt ihre Koordination an."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "146376e4-2d79-456a-b1b3-c202311b8345",
                        "source_entry_id": "1aca8d4d-ef47-3ef7-aa17-c5ccf479c1dc",
                        "source_sense_description": "extra emphasis given to a comparison",
                        "target_lang_word": "Gegenüberstellung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenüberstellung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a1d3a48-f8bf-3083-9bbf-9630484392a9",
                                        "entry_id": "c3aba822-7612-3a5a-a8b4-2f84d17e11b6",
                                        "glosses": [
                                            "polizeiliche Maßnahme, die dazu dient, Straftäter zu identifizieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd033d18-6605-466e-b45f-b63caefe8bd9",
                                                "sense_id": "6a1d3a48-f8bf-3083-9bbf-9630484392a9",
                                                "text": "Es kam zu einer Gegenüberstellung vor Gericht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5f2d0ddb-a19e-3a14-b112-597390821b1b",
                                        "entry_id": "c3aba822-7612-3a5a-a8b4-2f84d17e11b6",
                                        "glosses": [
                                            "Vergleich zwischen zwei Dingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a20a2001-85d5-4529-b475-1e6c838e2da4",
                                                "sense_id": "5f2d0ddb-a19e-3a14-b112-597390821b1b",
                                                "text": "Bei der Gegenüberstellung der Gewinne und Verluste zeigte sich, dass noch mehr in die Werbung gesteckt werden musste."
                                            },
                                            {
                                                "example_id": "1f983ea3-5906-4bbf-a2e3-77a2e35c26b9",
                                                "sense_id": "5f2d0ddb-a19e-3a14-b112-597390821b1b",
                                                "text": "„So löst die Gegenüberstellung von Dichtung und Wahrheit, von Subjektivität und Objektivität, in diesem Fall nicht nur einige literaturwissenschaftliche Rätsel.“"
                                            },
                                            {
                                                "example_id": "ec9f24f1-fcd5-4bd4-995a-6dd43db857d8",
                                                "sense_id": "5f2d0ddb-a19e-3a14-b112-597390821b1b",
                                                "text": "„Zugegeben, diese krasse Gegenüberstellung war übertrieben; gleichwohl macht sie das Unverhältnis zwischen Sprachkritik und Sprachwissenschaft deutlich.“"
                                            },
                                            {
                                                "example_id": "c150b2c4-ad92-4d69-a3cd-98a09366fbbf",
                                                "sense_id": "5f2d0ddb-a19e-3a14-b112-597390821b1b",
                                                "text": "„Durch die Gegenüberstellung aber und durch den jeweiligen Kontext wird auf der tieferen Sinnebene eine andere, ebenfalls vorhandene Bedeutung eines dieser Wörter aktualisiert.“"
                                            },
                                            {
                                                "example_id": "3409f155-f19c-47d1-8c70-2adccb0d14e4",
                                                "sense_id": "5f2d0ddb-a19e-3a14-b112-597390821b1b",
                                                "text": "„Die den Roman treibende Kraft ist, wie oben gesagt, die Gegenüberstellung Agathon – Hippias.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcc27c4b-3ae5-4078-82b0-24dec7b40412",
                        "source_entry_id": "1aca8d4d-ef47-3ef7-aa17-c5ccf479c1dc",
                        "source_sense_description": "arts: contrasting sounds or colours",
                        "target_lang_word": "juxtapositie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "juxtapositie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "25eb2f84-085a-38fa-bc1c-85023648dca9",
                                        "entry_id": "7ee0e5ff-f34c-38a5-9f43-faec0c901d03",
                                        "glosses": [
                                            "het naast elkaar zetten van meerdere zaken om zo een verband te suggereren (dat er soms helemaal niet is)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3be80029-634e-41fb-bbac-a80546e34686",
                                                "sense_id": "25eb2f84-085a-38fa-bc1c-85023648dca9",
                                                "text": "Het Europees Parlement is slechts een juxtapositie van nationale verkozenen. Er bestaat geen Europese socialistische of liberale partij, geen Europees partijprogramma."
                                            },
                                            {
                                                "example_id": "4b682874-7234-4c8d-9d93-ab73f7b17f52",
                                                "sense_id": "25eb2f84-085a-38fa-bc1c-85023648dca9",
                                                "text": "Ik was inmiddels dankzij Clio zo geobsedeerd geraakt met Caravaggio's levensverhaal, zijn doodvonnis en zijn angst voor onthoofding dat ik een tweede betekenislaag in het schilderij meende aan te treffen. De schedel is ook van zijn romp gescheiden. De juxtapositie van de pen en het symbool bij uitstek van de dood evoceert het vonnis, ondertekend door een gestrenge aartsvader van de kerk die verdiept is in zijn theologische fijnslijperijen en die de verdoemde schilder die hem portretteert en die hij veroordeelt, niet eens een blik waardig gunt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
