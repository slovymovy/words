                                "target_lang_sense_clarification": "профессиональный термин в керамике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fe0bbbb-c814-3a2c-afda-ef8f7888bfca",
                    "sense_definition": "To weaken, impair, or make something decrepit",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He feared that old age and lack of movement would <w>craze</w> his limbs over time.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что старость и отсутствие движения со временем <w>ослабят</w> его конечности."
                            }
                        },
                        {
                            "text": "The harsh winter conditions continued to <w>craze</w> the structural integrity of the old bridge.",
                            "target_lang_translations": {
                                "ru": "Суровые зимние условия продолжали <w>подтачивать</w> структурную целостность старого моста."
                            }
                        }
                    ],
                    "synonyms": [
                        "weaken",
                        "impair",
                        "enfeeble"
