                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это маленькое государство <w>независимо</w> и имеет свою собственную валюту.",
                            "target_lang_translations": {
                                "en": "This small state is <w>independent</w> and has its own currency.",
                                "tr": "Bu küçük devlet <w>bağımsızdır</w> ve kendi para birimine sahiptir."
                            }
                        },
                        {
                            "text": "Мнение экспертного жюри было абсолютно <w>независимо</w> и объективно.",
                            "target_lang_translations": {
