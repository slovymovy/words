                ],
                "translations": [
                    {
                        "translation_id": "d6b7d273-19bd-4979-a064-905346a8a16a",
                        "source_entry_id": "2302f7e0-5fa4-3eed-bc70-4082a8283f9a",
                        "source_sense_id": "c9cdd77b-f49d-32f2-92ae-74380b85145e",
                        "target_lang_word": "scalar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scalar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cda86545-af2e-3530-a2a0-ce954d2da098",
                                        "entry_id": "edc1e3a5-aa80-3c6a-9a1d-49a155cfa3e9",
                                        "glosses": [
                                            "Having magnitude but not direction."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35a0351f-90a9-3e17-91af-c0253faaff64",
                                        "entry_id": "edc1e3a5-aa80-3c6a-9a1d-49a155cfa3e9",
                                        "glosses": [
                                            "Consisting of a single value (e.g. integer or string) rather than multiple values (e.g. array)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43e2d0e9-a229-3a8a-a079-0c1385b91a28",
                                        "entry_id": "edc1e3a5-aa80-3c6a-9a1d-49a155cfa3e9",
                                        "glosses": [
                                            "Of, or relating to scale."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8f1696a-85e4-44c5-8167-69fbba89755e",
                                                "sense_id": "43e2d0e9-a229-3a8a-a079-0c1385b91a28",
                                                "text": "However, it can be expected that 'scale-similarity' models of this form will be inadequate for describing non-equilibrium scalar fields resulting, for example, from non-equilibrium inlet flow conditions."
                                            },
                                            {
                                                "example_id": "1ee59ae3-0c8f-4501-8474-75b52e7b7e48",
                                                "sense_id": "43e2d0e9-a229-3a8a-a079-0c1385b91a28",
                                                "text": "Scalar thickening is useful for understanding the propensity of scales to coalesce in certain times and places, or even how a particular scale provides conditions for other forms of scalar production."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be135b6e-ee4b-3520-8325-9ea588aa2e4b",
                                        "entry_id": "edc1e3a5-aa80-3c6a-9a1d-49a155cfa3e9",
                                        "glosses": [
                                            "Of or pertaining to a musical scale."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd7562fe-829b-3ee8-84d2-7c886ef14bcd",
                                        "entry_id": "edc1e3a5-aa80-3c6a-9a1d-49a155cfa3e9",
                                        "glosses": [
                                            "Relating to particles with a spin (quantum angular momentum) of 0 (known as spin 0)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88fa6ed1-7f63-3ed7-b89f-024b34437764",
                                        "entry_id": "edc1e3a5-aa80-3c6a-9a1d-49a155cfa3e9",
                                        "glosses": [
                                            "Pertaining to the dimension on which something is measured."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4b3280e-ce12-40bc-a9b7-d3ce2d999787",
                                                "sense_id": "88fa6ed1-7f63-3ed7-b89f-024b34437764",
                                                "text": "Spector (2006, 2007) suggests to derive this inference as a scalar implicature."
                                            },
                                            {
                                                "example_id": "628c4782-fae6-4579-ac08-9c42b762ac8d",
                                                "sense_id": "88fa6ed1-7f63-3ed7-b89f-024b34437764",
                                                "text": "Also, the scalar meaning in both sentences is not sensitive to context, because the truth value of the sentences does not change depending on context."
                                            },
                                            {
                                                "example_id": "fa87328c-ce5e-4f06-b629-09104b884ae5",
                                                "sense_id": "88fa6ed1-7f63-3ed7-b89f-024b34437764",
                                                "text": "In Mandarin Chinese, the same sentence containing a numeral-classifier phrase as a negative polarity item can be employed for two types of scalar inferences based on either the numeral or the noun."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scalar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15b9b0a7-bef6-3cc4-9ad6-06203d745d01",
                                        "entry_id": "6b7112c2-7a38-3f4a-8906-0bf74cf88c08",
                                        "glosses": [
                                            "A quantity that has magnitude but not direction; compare vector."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbbcfb17-5ef6-31e7-be84-0de02dbda0a8",
                                        "entry_id": "6b7112c2-7a38-3f4a-8906-0bf74cf88c08",
