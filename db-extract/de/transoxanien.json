                                        "glosses": [
                                            "An ancient portion of Central Asia, the region between the Amu Darya (Classical Oxus) and Syr Darya rivers, corresponding approximately with modern-day Uzbekistan, Tajikistan and southwest Kazakhstan."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6edafaf-c97a-4c9a-9d37-de3ec2c4c6fd",
                                                "sense_id": "84ccafc6-f2bc-3152-b088-dde2f4564379",
                                                "text": "The success of this trade depended upon the security of four areas- the oases south of the T'ien Shan mountains in the area known as Uyghuristan, the towns of Transoxiana, the cities of Persia, and the commercial centers of Turkey."
                                            }
