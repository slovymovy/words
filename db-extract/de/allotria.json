                        "sense_id": "f8e6e9cd-7741-3289-a8e4-1cfa6336491b",
                        "entry_id": "cf5833b1-d13c-3c9f-82c9-e14101aed1be",
                        "glosses": [
                            "tomfoolery, monkey business, foolish behavior"
                        ],
                        "tags": [
                            "neuter",
