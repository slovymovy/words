                        "glosses": [
                            "durch die Anwendung von Öl oder Ähnlichem wasserdicht gemachte Jacke für schlechtes Wetter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ffa84d8-507b-41ec-b335-e186ff7cfa45",
                                "sense_id": "14e24ff1-c9a3-3bae-b8a5-4af9d0db266c",
                                "text": "„Vom Bus aus sehe ich, dass die raumhohen Fenster im dritten Stock meines Bürogebäudes herausgesprengt sind, und drinnen schlägt ein Feuerwehrmann in einer verschmierten gelben Öljacke nach einem verkohlten Paneel in der Hängedecke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
