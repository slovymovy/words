                "senses": [
                    {
                        "sense_id": "bc9a7331-93cd-3a85-93c8-e57e0725f000",
                        "entry_id": "150e5e40-257d-3dd3-a1b6-e6820eaec0a3",
                        "glosses": [
                            "Gerät, mit dem die Druckstärke gemessen werden kann (zum Beispiel, um eine individuelle Schmerzschwelle zu bestimmen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1edb50f8-de36-4006-ab45-f99843c8dbfa",
                                "sense_id": "bc9a7331-93cd-3a85-93c8-e57e0725f000",
                                "text": "„Auch er fand bereits in der Latenzzeit eine Hyperalgesie, außerdem eine Vermehrung der Schmerzpunkte mit dem Algesimeter.“"
                            },
                            {
                                "example_id": "17b5a6d1-d657-4e12-b5dd-e9db5ecab321",
                                "sense_id": "bc9a7331-93cd-3a85-93c8-e57e0725f000",
                                "text": "„Drückt man vermittelst des Algesimeters auf die zu untersuchende Stelle und setzt fest, bei wieviel Gewicht Patient Schmerz empfindet, dann hat man so feste Zahlen, welche für die Diagnose von Belang sein können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
