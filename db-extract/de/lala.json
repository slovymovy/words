                                "target_senses": [
                                    {
                                        "sense_id": "fec88451-371f-3149-9abf-7a5ce691eb47",
                                        "entry_id": "7f46757b-2d86-339c-9426-ee7c7abd60cf",
                                        "glosses": [
                                            "Neither good nor bad; tolerable, passable, indifferent."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27d3caa4-805f-4043-a75e-2a8f8bb87d5a",
                                                "sense_id": "fec88451-371f-3149-9abf-7a5ce691eb47",
                                                "text": "The dessert was pretty good, but the meal was so-so."
                                            },
                                            {
                                                "example_id": "4ced0565-54f7-4e94-bd11-46ad16217547",
                                                "sense_id": "fec88451-371f-3149-9abf-7a5ce691eb47",
                                                "text": "[I]n ſome Iriſh Houſes, vvhere things are ſo-ſo, / One Gammon of Bacon hangs up for a ſhow; […]"
                                            },
                                            {
                                                "example_id": "e29c5847-d166-4a77-b795-593fd5d0be47",
                                                "sense_id": "fec88451-371f-3149-9abf-7a5ce691eb47",
                                                "text": "He [Robert Burns] certainly wrote some so-so verses to the Tree of Liberty."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "so-so",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b65a422-8b43-3ebb-b89e-4fc3cf5142ae",
                                        "entry_id": "3785b25e-ca0f-3da5-922a-02556ec768a5",
                                        "glosses": [
                                            "Neither very well nor very poorly."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b3389f5-66d9-48c8-b7d3-6ad30c8281bf",
                                                "sense_id": "5b65a422-8b43-3ebb-b89e-4fc3cf5142ae",
                                                "text": "He performed so-so during the tryouts, and the coach was undecided whether to add him to the team or not."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6c5facc-fadc-4cb2-9f03-e0a660010353",
                        "source_entry_id": "fea9323b-905a-3177-b4c8-8ac5da73a7b7",
                        "source_sense_id": "e399368e-584c-37e4-9c0a-f4efbdb24e19",
                        "source_sense_description": "umgangssprachlich; in der Wendung „so lala“: einigermaßen, leidlich, okay, mäßig gut",
                        "target_lang_word": "couci-couça",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couci-couça",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efe4a4d7-6458-3ac6-849b-f38ba928f85d",
                                        "entry_id": "4c13ff97-656d-3b7a-b8fc-7e19ca3e7fe8",
                                        "glosses": [
                                            "Passable, plus ou moins."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3744cdf-cda3-46e3-b4e5-ae3ca5e39182",
                                                "sense_id": "efe4a4d7-6458-3ac6-849b-f38ba928f85d",
                                                "text": "Les affaires vont couci-couça."
                                            },
                                            {
                                                "example_id": "82a5c357-fe70-4f8a-bb49-e95976168ea3",
                                                "sense_id": "efe4a4d7-6458-3ac6-849b-f38ba928f85d",
                                                "text": "— La température ?\n— Couci-couça, riposta Maigret."
                                            },
                                            {
                                                "example_id": "94338f4d-56ac-41ce-b325-12170eab21aa",
                                                "sense_id": "efe4a4d7-6458-3ac6-849b-f38ba928f85d",
                                                "text": "- Et de votre côté, vous avez avancé votre enquête ? …\n— Heu ! couci-couça, monsieur le professeur... Je venais seulement d’arriver..."
                                            },
                                            {
                                                "example_id": "bd153ad1-ceb3-4121-b88e-3c136df4e68c",
                                                "sense_id": "efe4a4d7-6458-3ac6-849b-f38ba928f85d",
                                                "text": "Sa vie a sans doute été plus dure que la mienne ; j’ai pourtant idée que c’est couci-couça. Elle est comme nous tous dans l’inextricable et l’inéluctable."
                                            },
                                            {
                                                "example_id": "8a78e269-3a86-4403-a711-c395106e0e5e",
                                                "sense_id": "efe4a4d7-6458-3ac6-849b-f38ba928f85d",
                                                "text": "Non, ça va couci-couça. Et, surtout, il faudra un examen de conscience collective qui risque de n’être pas sans douleur si l’on espère retrouver la fierté d’être Québécois."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "couci-couça",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8780b37-71ec-327a-a504-23a42de271a5",
                                        "entry_id": "6bae6f58-e42f-329b-b1af-f9e0906475d0",
                                        "glosses": [
                                            "Quelqu’un d’indéterminé."
                                        ],
                                        "tags": [
                                            "pejorative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c4e6a53-11a5-4f85-ad15-c59159e97334",
                                                "sense_id": "a8780b37-71ec-327a-a504-23a42de271a5",
                                                "text": "— C’est ce qu’on peut appeler un couci-couça.\n— Et plutôt couça que couci…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b9d8d35-d50c-4a49-9100-ce860b5f2c1d",
                        "source_entry_id": "fea9323b-905a-3177-b4c8-8ac5da73a7b7",
                        "source_sense_id": "e399368e-584c-37e4-9c0a-f4efbdb24e19",
                        "source_sense_description": "umgangssprachlich; in der Wendung „so lala“: einigermaßen, leidlich, okay, mäßig gut",
                        "target_lang_word": "comme ci comme ça",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comme ci comme ça",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d335cde7-6a21-39f8-87c4-06ffcddc9b97",
                                        "entry_id": "a63e3ab5-7e77-36b4-b889-ad8dfca5959e",
                                        "glosses": [
                                            "Ni bien ni mal ; moyennement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1b867cb-99d2-4d4d-9f42-de0d2028d2e7",
                                                "sense_id": "d335cde7-6a21-39f8-87c4-06ffcddc9b97",
                                                "text": "— Alors, comment va notre jolie demoiselle ?\n— Comme ci comme ça. C'est une journée un peu difficile, mais j'ai promis à Luca que je n'y penserais pas avant ce soir."
                                            },
                                            {
                                                "example_id": "778fef00-9fc4-4a74-9074-84123839c624",
                                                "sense_id": "d335cde7-6a21-39f8-87c4-06ffcddc9b97",
                                                "text": "— Dis-moi, poursuit Jules, tu le connaissais bien toi le Bertrand qui s'est noyé chez vous ?\n— Comme-ci comme-ça, bonjour-bonsoir. Le boulot quoi ! fait Bébert laconiquement."
                                            },
                                            {
                                                "example_id": "898a201f-449f-427e-b74b-2e4fa58200cd",
                                                "sense_id": "d335cde7-6a21-39f8-87c4-06ffcddc9b97",
                                                "text": "Même quand une histoire commence comme ci comme ça, elle finit bien, les adultes se réconcilient, les problèmes se résolvent, les chiens te font la fête et te lèchent la figure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
