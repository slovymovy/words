                    {
                        "form_id": "73fb126e-05d7-4ff3-93d3-212e516e1014",
                        "entry_id": "102431a8-2fe0-3c3c-bcfd-0bb42e885017",
                        "tags": [
                            "past"
                        ],
                        "form": "womanished"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9f73e4ce-3125-3413-9436-a455fa06d1c6",
                        "entry_id": "102431a8-2fe0-3c3c-bcfd-0bb42e885017",
                        "glosses": [
                            "To make womanish."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "017e1ff8-c988-4b60-9289-6559424ee935",
                                "sense_id": "9f73e4ce-3125-3413-9436-a455fa06d1c6",
                                "text": "Then the Lord Gaspar: “I believe music,” quoth he, “together with many other vanities, is meet for women, and peradventure for some also that have the likeness of men, but not for them that be men indeed, who ought not with such delicacies to womanish their minds and bring themselves in that sort to dread death.”"
                            },
                            {
                                "example_id": "9063c6a3-8db9-4cf8-9056-788c01284338",
                                "sense_id": "9f73e4ce-3125-3413-9436-a455fa06d1c6",
                                "text": "[T]his effeminate love of a Woman, dothe ſo womaniſh a man, that, yf yow yeelde to yt, yt will not onely make yow a famous Amazon but a Launder, a Diſtaff ſpinner, or whatſoever other vyle occupacyon theyre Idle heades can Imagyn, and theyre weyke handes ꝑforme [performe]: […]",
                                "translation": "The Old Arcadia",
                                "english": "The Old Arcadia"
                            },
                            {
                                "example_id": "34957d3a-4dfa-40a4-92d2-8b1bc76fc9bf",
                                "sense_id": "9f73e4ce-3125-3413-9436-a455fa06d1c6",
                                "text": "He [Stubbes] complains of music “being used in public assemblies and private conventicles as a directory to filthy dancing;” and that “through the sweet harmony and smooth melody thereof, it estrangeth the mind, stirreth up lust, womanisheth the mind, and ravisheth the heart.”"
                            }
                        ]
                    }
