                "senses": [
                    {
                        "sense_id": "54a84702-ce6c-362d-8aaf-ad66352dffe2",
                        "entry_id": "3991ee3b-ce70-3ed2-b476-779513be8462",
                        "glosses": [
                            "Frage, mit deren Hilfe ein grammatisches Phänomen (zum Beispiel der Kasus eines Substantivs im Satz) näher bestimmt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b4cf45e-eacf-42a2-80ee-95a69e087262",
                                "sense_id": "54a84702-ce6c-362d-8aaf-ad66352dffe2",
                                "text": "„Man kann es mit der Hilfsfrage: ‚Wer oder was tut etwas?‘ ermitteln.“"
                            },
                            {
                                "example_id": "ae6e43fd-3809-4ec8-93e8-c6877f3c3554",
                                "sense_id": "54a84702-ce6c-362d-8aaf-ad66352dffe2",
                                "text": "„Man kann ihn gut mit den Hilfsfragen ermitteln.“"
                            },
                            {
                                "example_id": "278bf0b7-18ad-4b72-a25d-e66fbdf755a7",
                                "sense_id": "54a84702-ce6c-362d-8aaf-ad66352dffe2",
                                "text": "„Vermerkt in Klammern, welche Hilfsfrage ihr stellen könnt.“"
                            },
                            {
                                "example_id": "f72c5727-e346-4e82-831b-e3a7c1366337",
                                "sense_id": "54a84702-ce6c-362d-8aaf-ad66352dffe2",
                                "text": "„Präpositionale Objekte sind nominale Satzglieder mit Präposition und benennen Personen oder Sachen. Sie werden mit Hilfsfragen Auf Wen? Auf Was? Für Was? Für Wen? Mit Wem? nd so weiter ermittelt.“"
                            },
                            {
                                "example_id": "34bb6c1f-0261-4137-aac6-02042e5d131d",
                                "sense_id": "54a84702-ce6c-362d-8aaf-ad66352dffe2",
                                "text": "„Der Dativ hingegen gibt einen Ort an, man gebraucht die Hilfsfrage ‚Wo?‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
