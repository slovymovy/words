{
    "word_family": [
        "kill",
        "killing",
        "overkill"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6162137a-49ea-3484-91c0-342dcb74e621",
                    "sense_definition": "A person, animal, or thing that causes death.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "death_agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are still looking for the <w>killer</w>.",
                            "target_lang_translations": {
                                "ru": "Полиция все еще ищет <w>убийцу</w>.",
                                "zh": "警方仍在搜捕那名<w>凶手</w>。"
                            }
                        },
                        {
                            "text": "Heart disease is a silent <w>killer</w> in many parts of the world.",
                            "target_lang_translations": {
                                "ru": "Болезни сердца — это тихий <w>убийца</w> во многих частях света.",
                                "zh": "心脏病是世界上许多地区无声的<w>杀手</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "healer",
                        "life giver"
                    ],
                    "common_phrases": [
                        "serial killer",
                        "silent killer",
                        "contract killer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, животное или вещь, являющиеся причиной смерти.",
                        "zh": "导致死亡的人、动物或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убийца",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "киллер",
                                "target_lang_sense_clarification": "наемный убийца"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杀手",
                                "target_lang_sense_clarification": "指行凶者或造成死亡的因素"
                            },
                            {
                                "target_lang_word": "凶手",
                                "target_lang_sense_clarification": "指犯罪的杀人者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dcab22b-a5e6-3527-b89c-f6d0008417de",
                    "sense_definition": "A large black and white marine mammal; a short form of killer whale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched a <w>killer</w> swimming near the boat.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как <w>косатка</w> плавала возле лодки.",
                                "zh": "我们看着一只<w>虎鲸</w>在船附近游动。"
                            }
                        },
                        {
                            "text": "The <w>killer</w> whale is actually the largest member of the dolphin family.",
                            "target_lang_translations": {
                                "ru": "<w>Косатка</w> на самом деле является крупнейшим представителем семейства дельфиновых.",
                                "zh": "<w>虎鲸</w>实际上是海豚科中体型最大的成员。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "killer whale"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortening of killer whale"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное морское млекопитающее; сокращение от «кит-убийца» (косатка).",
                        "zh": "一种大型黑白相间的海洋哺乳动物，即虎鲸的简称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "косатка",
                                "target_lang_sense_clarification": "морское животное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虎鲸",
                                "target_lang_sense_clarification": "海洋哺乳动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a42b2e0b-0228-30ce-bab2-70fdecae9852",
                    "sense_definition": "Something that is extremely difficult to do, deal with, or withstand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That math exam was a real <w>killer</w>.",
                            "target_lang_translations": {
                                "ru": "Этот экзамен по математике был просто <w>убийственным</w>.",
                                "zh": "那场数学考试简直是场<w>噩梦</w>。"
                            }
                        },
                        {
                            "text": "Climbing the final hill of the race was a <w>killer</w> for the cyclists.",
                            "target_lang_translations": {
                                "ru": "Подъем на последний холм в гонке стал <w>настоящей каторгой</w> для велосипедистов.",
                                "zh": "爬上比赛的最后一个山坡对骑手们来说简直是<w>苦差事</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "a real killer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то чрезвычайно сложное для выполнения или преодоления.",
                        "zh": "极难完成、处理或承受的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каторга",
                                "target_lang_sense_clarification": "перен. тяжелое испытание"
                            },
                            {
                                "target_lang_word": "убийство",
                                "target_lang_sense_clarification": "разг. что-то очень сложное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苦差事",
                                "target_lang_sense_clarification": "指极度困难或令人痛苦的任务"
                            },
                            {
                                "target_lang_word": "难题",
                                "target_lang_sense_clarification": "指难以解决的问题"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cccb4dba-9286-3ac4-a72f-9e337fb6f3c9",
                    "sense_definition": "A product or service that is so successful or effective that it eliminates its competition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "business_tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors are always looking for the next big <w>killer</w> app.",
                            "target_lang_translations": {
                                "ru": "Инвесторы всегда ищут следующее крупное <w>приложение-убийцу</w>.",
                                "zh": "投资者总是在寻找下一个重大的<w>杀手级应用</w>。"
                            }
                        },
                        {
                            "text": "Digital streaming services became the CD <w>killer</w> of the music industry.",
                            "target_lang_translations": {
                                "ru": "Стриминговые сервисы стали <w>убийцами</w> компакт-дисков в музыкальной индустрии.",
                                "zh": "数字流媒体服务成为了音乐产业中光盘的<w>终结者</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "killer app",
                        "category killer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "business or technology context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продукт или услуга, которые настолько успешны, что вытесняют конкурентов.",
                        "zh": "一种极其成功或有效，以至于淘汰了竞争对手的产品或服务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убийца",
                                "target_lang_sense_clarification": "в контексте конкуренции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杀手级应用",
                                "target_lang_sense_clarification": "指在商业或技术领域具有统治力的产品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0df9c342-196a-3b6e-8672-4abef67f7c2a",
                    "sense_definition": "Capable of causing death, destruction, or serious harm.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "death_agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The swarm of <w>killer</w> bees moved through the forest.",
                            "target_lang_translations": {
                                "ru": "Рой <w>пчел-убийц</w> двигался через лес.",
                                "zh": "一群<w>杀手</w>蜂穿过了森林。"
                            }
                        },
                        {
                            "text": "He showed a <w>killer</w> instinct during the final match of the tournament.",
                            "target_lang_translations": {
                                "ru": "Он проявил <w>инстинкт убийцы</w> во время финального матча турнира.",
                                "zh": "他在锦标赛的决赛中展现出了<w>杀手</w>般的本能。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "killer bee",
                        "killer instinct",
                        "killer robot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный причинить смерть, разрушение или серьезный вред.",
                        "zh": "能够导致死亡、破坏或严重伤害的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убийственный",
                                "target_lang_sense_clarification": "смертоносный"
                            },
                            {
                                "target_lang_word": "убийца",
                                "target_lang_sense_clarification": "в составе сложных слов (пчела-убийца)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "致命的",
                                "target_lang_sense_clarification": "指具有致死能力的"
                            },
                            {
                                "target_lang_word": "杀手",
                                "target_lang_sense_clarification": "用于复合词中表示具有攻击性或危险性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e775985d-5365-3caf-9919-84972c4d8492",
                    "sense_definition": "Causing severe physical pain or distress.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I woke up this morning with a <w>killer</w> headache.",
                            "target_lang_translations": {
                                "ru": "Я проснулся сегодня утром с <w>адской</w> головной болью.",
                                "zh": "我今天早上醒来时头痛得<w>要命</w>。"
                            }
                        },
                        {
                            "text": "This flu is a <w>killer</w> strain that keeps you in bed for days.",
                            "target_lang_translations": {
                                "ru": "Этот грипп — <w>убойный</w> штамм, который укладывает в постель на несколько дней.",
                                "zh": "这种流感是一种<w>厉害</w>的病毒株，会让你卧床好几天。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "killer headache",
                        "killer hangover"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причиняющий сильную физическую боль или страдание.",
                        "zh": "引起剧烈身体疼痛或痛苦的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адский",
                                "target_lang_sense_clarification": "о боли"
                            },
                            {
                                "target_lang_word": "убийственный",
                                "target_lang_sense_clarification": "мучительный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剧烈的",
                                "target_lang_sense_clarification": "形容疼痛程度极高"
                            },
                            {
                                "target_lang_word": "要命的",
                                "target_lang_sense_clarification": "口语中形容痛苦程度极深"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48214482-e0a6-3fd9-822e-96434a519cf2",
                    "sense_definition": "Extremely good, impressive, or exciting.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played a <w>killer</w> song that got everyone dancing.",
                            "target_lang_translations": {
                                "ru": "Группа сыграла <w>убойную</w> песню, под которую все танцевали.",
                                "zh": "乐队演奏了一首<w>绝佳</w>的歌曲，让所有人都跳了起来。"
                            }
                        },
                        {
                            "text": "From the top of the mountain, there is a <w>killer</w> view of the city.",
                            "target_lang_translations": {
                                "ru": "С вершины горы открывается <w>потрясающий</w> вид на город.",
                                "zh": "从山顶可以欣赏到城市<w>绝美</w>的景色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "awesome",
                        "brilliant",
                        "cool",
                        "excellent",
                        "fantastic",
                        "great",
                        "outstanding",
                        "superb",
                        "terrific",
                        "wicked"
                    ],
                    "common_phrases": [
                        "killer view",
                        "killer feature",
                        "killer smile"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно хороший, впечатляющий или захватывающий.",
                        "zh": "极好的、令人印象深刻的或令人兴奋的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убойный",
                                "target_lang_sense_clarification": "сленг: отличный"
                            },
                            {
                                "target_lang_word": "потрясающий",
                                "target_lang_sense_clarification": "впечатляющий"
                            },
                            {
                                "target_lang_word": "шикарный",
                                "target_lang_sense_clarification": "великолепный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极好的",
                                "target_lang_sense_clarification": "形容事物非常出色"
                            },
                            {
                                "target_lang_word": "绝佳的",
                                "target_lang_sense_clarification": "形容质量或体验极高"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}