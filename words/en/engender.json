{
    "word_family": [
        "gender",
        "engenderment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b18b5a3-04a7-3fc0-ac3a-d821d075e338",
                    "sense_definition": "To bring into existence a situation, quality, or result; to cause or create.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy will <w>engender</w> a sense of trust among the employees.",
                            "target_lang_translations": {
                                "ru": "Новая политика <w>породит</w> чувство доверия среди сотрудников."
                            }
                        },
                        {
                            "text": "Such unfair treatment often <w>engender</w>s resentment and anger in the community.",
                            "target_lang_translations": {
                                "ru": "Такое несправедливое обращение часто <w>порождает</w> негодование и гнев в обществе."
                            }
                        }
                    ],
                    "synonyms": [
                        "cause",
                        "create",
                        "generate",
                        "produce"
                    ],
                    "common_phrases": [
                        "engender trust",
                        "engender resentment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать появление чего-либо, служить причиной возникновения ситуации, чувства или результата."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порождать",
                                "target_lang_sense_clarification": "быть источником или причиной возникновения чего-либо (абстрактного)"
                            },
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "приводить к возникновению определенной реакции или состояния"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd95dd3b-27b0-3905-963c-568ce5f0058a",
                    "sense_definition": "To give existence to or produce living creatures.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "create",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harsh environment <w>engender</w>ed a unique species of resilient plants.",
                            "target_lang_translations": {
                                "ru": "Суровая среда <w>породила</w> уникальный вид выносливых растений."
                            }
                        },
                        {
                            "text": "Nature <w>engender</w>s life in the most unexpected places.",
                            "target_lang_translations": {
                                "ru": "Природа <w>порождает</w> жизнь в самых неожиданных местах."
                            }
                        }
                    ],
                    "synonyms": [
                        "produce",
                        "spawn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать жизнь или производить на свет живые существа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порождать",
                                "target_lang_sense_clarification": "производить на свет, давать жизнь (книжный стиль)"
                            },
                            {
                                "target_lang_word": "производить",
                                "target_lang_sense_clarification": "создавать или давать начало жизни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cd8a150-e33c-3205-a7a1-094da1e66794",
                    "sense_definition": "To assume form or come into existence.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "create",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Storms often <w>engender</w> over the warm ocean waters.",
                            "target_lang_translations": {
                                "ru": "Штормы часто <w>зарождаются</w> над теплыми океанскими водами."
                            }
                        },
                        {
                            "text": "New ideas <w>engender</w> from deep reflection and quiet study.",
                            "target_lang_translations": {
                                "ru": "Новые идеи <w>возникают</w> в результате глубоких размышлений и спокойного изучения."
                            }
                        }
                    ],
                    "synonyms": [
                        "arise",
                        "emerge",
                        "originate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or poetic sense."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать форму или возникать, появляться (устар. или поэтич.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возникать",
