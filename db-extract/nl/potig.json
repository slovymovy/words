                                            {
                                                "example_id": "b5dcdcc8-2400-4344-90b7-2c33464571d3",
                                                "sense_id": "f99f8485-1bb4-3612-9570-3d0955fb400b",
                                                "text": "He was not of any delicate contexture; his limbs rather sturdy then dainty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50d40302-4640-335c-b83e-14715b723dad",
                                        "entry_id": "15b5a2e3-8c5a-372a-9845-ee9cd1979d9b",
                                        "glosses": [
                                            "Solid in structure or person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c1b0337-615b-4752-aa3b-da453c904d10",
                                                "sense_id": "50d40302-4640-335c-b83e-14715b723dad",
                                                "text": "It was a sturdy building, able to withstand strong winds and cold weather."
                                            },
                                            {
                                                "example_id": "733b8ce0-6007-4433-a034-792dda67fe07",
                                                "sense_id": "50d40302-4640-335c-b83e-14715b723dad",
                                                "text": "The dog was sturdy and could work all day without getting tired."
                                            },
                                            {
                                                "example_id": "01f47786-bd53-437d-8d3d-ac9910be10bc",
                                                "sense_id": "50d40302-4640-335c-b83e-14715b723dad",
                                                "text": "Diana’s most recent romantic adventure at that time was with the sturdy hunk Will Carling, captain of the England rugby team, whom she had met in 1995 working out at the Chelsea Harbor Club gym."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a22b32e2-155c-3550-ae64-461bb53758e9",
                                        "entry_id": "15b5a2e3-8c5a-372a-9845-ee9cd1979d9b",
                                        "glosses": [
                                            "Foolishly obstinate or resolute; stubborn."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75fcfa58-3ae9-4ecc-a0c8-f829b67183a4",
                                                "sense_id": "a22b32e2-155c-3550-ae64-461bb53758e9",
                                                "text": "This must be done, and I would fain see / Mortal so sturdy as to gainsay."
                                            },
                                            {
                                                "example_id": "35f85d7a-e9f9-437e-be80-e25df3f88ace",
                                                "sense_id": "a22b32e2-155c-3550-ae64-461bb53758e9",
                                                "text": "[A] ſturdy, hardned Sinner ſhall advance to the utmoſt pitch of Impiety with leſs difficulty, leſs reluctance of Mind, than perhaps he took the firſt ſteps in Wickedneſs, whilſt his Conſcience was yet Vigilant and Tender."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df60fbc7-d85d-3ca6-a469-371ccaf732bf",
                                        "entry_id": "15b5a2e3-8c5a-372a-9845-ee9cd1979d9b",
                                        "glosses": [
                                            "Resolute, in a good sense; or firm, unyielding quality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aed3a270-8cb1-4fae-9989-f13ddadcc8b3",
                                                "sense_id": "df60fbc7-d85d-3ca6-a469-371ccaf732bf",
                                                "text": "a man of sturdy piety or patriotism"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sturdy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "896d545b-e8b5-3a06-85a9-c96b933f7aa6",
                                        "entry_id": "5eae9fc2-2f14-3c4b-9c88-c819d5683eee",
                                        "glosses": [
                                            "A disease caused by a coenurus infestation in the brain of an animal, especially a sheep or canid; coenurosis."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
