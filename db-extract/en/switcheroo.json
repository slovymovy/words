    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "45a9aaf4-fe3e-3b2b-be7f-30962f72e0a3",
                "word": "switcheroo",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "68bad55d-9dab-4c60-9581-5a9197459965",
                        "entry_id": "45a9aaf4-fe3e-3b2b-be7f-30962f72e0a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "switcheroos"
