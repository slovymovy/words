                "senses": [
                    {
                        "sense_id": "df5ff19c-fa19-3ac4-9548-c76fb392d987",
                        "entry_id": "5ff15adf-65cf-3aeb-a353-bcb130928881",
                        "glosses": [
                            "Considérer comme une idole, idolâtrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "620611c3-3ded-4740-b234-ce5975061494",
                                "sense_id": "df5ff19c-fa19-3ac4-9548-c76fb392d987",
                                "text": "Dans cette intimité, il y a une expérience de la surévaluation « idolisée » du soi et de l’objet, de l’insatiabilité et du jeu solitaire — et cette surévaluation est associée à l’envie."
                            },
                            {
                                "example_id": "9f60c684-e69a-4ea3-bb04-3a886b0ba453",
                                "sense_id": "df5ff19c-fa19-3ac4-9548-c76fb392d987",
                                "text": "Les païens ont prié pour idoliser la Marne pendant sept jours, mais ne voyant pas la pluie, ils ont arrêté leurs prières dans le désespoir."
                            },
                            {
                                "example_id": "8df75992-255d-4bcc-9967-bec5f8f4014c",
                                "sense_id": "df5ff19c-fa19-3ac4-9548-c76fb392d987",
                                "text": "Le monde va s’incliner, s’agenouiller sur les deux genoux et idoliser la bête."
                            },
                            {
                                "example_id": "49d00180-6109-4f09-a29e-9f38142d7c77",
                                "sense_id": "df5ff19c-fa19-3ac4-9548-c76fb392d987",
                                "text": "Et tu peux idoliser la nouvelle Yohane trop cool."
                            }
                        ]
                    }
                ],
