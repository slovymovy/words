                                                "sense_id": "03e61d3f-9ea1-3e26-a145-098da0600341",
                                                "text": "The growling dog frightened him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "growling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1ea857c-ff52-3ef1-b8f9-939803b60185",
                                        "entry_id": "28ea65b7-965e-3864-b300-48924c12c921",
                                        "glosses": [
                                            "A sustained instance of growls or guttural noises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4a8eb71-ad8b-4787-9eab-6506d919ffde",
                                                "sense_id": "b1ea857c-ff52-3ef1-b8f9-939803b60185",
                                                "text": "The growling from her stomach told us she was hungry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26d4fe64-8e48-3515-b4b9-f37ae226e4c1",
