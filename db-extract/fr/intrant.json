                "entry_id": "c8a2b55b-c3af-3b04-aa55-668a5a3da329",
                "word": "intrant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c7ad93a0-f417-469c-815b-015672d6a542",
                        "entry_id": "c8a2b55b-c3af-3b04-aa55-668a5a3da329",
                        "tags": [
