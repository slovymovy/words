                        "entry_id": "40b99ee2-bfb3-3869-bacb-279d9b74612b",
                        "glosses": [
                            "Soigner particulièrement son apparence, par exemple en se faisant une beauté."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "02290c29-b316-432e-bb97-27c98f10661e",
                                "sense_id": "fc2a0aee-fc7b-3a10-af76-fce4e911a526",
                                "text": "Le château, ranimé par un bain de soleil, se défublait de ses mines grognonnes, rajeunissait, s’affétait, coquettait, pour son départ."
                            },
                            {
                                "example_id": "62dbfad3-46fc-4816-98a9-81cb5acac90d",
                                "sense_id": "fc2a0aee-fc7b-3a10-af76-fce4e911a526",
                                "text": "Clervie rentra, il était temps de s’afféter, de se faire une beauté, sobre et éclatante à la fois."
                            }
                        ]
                    }
