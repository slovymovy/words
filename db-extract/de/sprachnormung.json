                    {
                        "sense_id": "22915dd0-a8ac-36ba-b54b-64538be77ba3",
                        "entry_id": "da122e60-a42a-3878-bfb7-6f37ee0bab47",
                        "glosses": [
                            "Maßnahme zur Festlegung oder Feststellung einer Sprachnorm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fa17e18-7c5b-4e34-b640-9c3cf6fac53d",
                                "sense_id": "22915dd0-a8ac-36ba-b54b-64538be77ba3",
                                "text": "Bei der Sprachnormung, der Durchsetzung von Sprachnormen, spielen die Schulen und die Medien eine entscheidende Rolle."
                            },
                            {
                                "example_id": "51597ab3-22b1-40df-b2a0-7fdb0378327c",
                                "sense_id": "22915dd0-a8ac-36ba-b54b-64538be77ba3",
                                "text": "Glück definiert Sprachnormung als „Planung und Festlegung von fachsprachlichen Termini oder von Standardvarietäten.“ Bußmann erklärt Sprachnormung im engeren Sinne als Terminologienormung, im weiteren Sinne auch als „normierende Maßnahmen im Bereich der Standardsprache.“"
                            },
                            {
                                "example_id": "e6e521bb-13f8-4a89-bc35-1e4265388fd4",
                                "sense_id": "22915dd0-a8ac-36ba-b54b-64538be77ba3",
                                "text": "Duden unterscheidet Sprachnormierung nicht von Sprachnormung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
