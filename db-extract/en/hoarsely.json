                                        "glosses": [
                                            "D’une manière sèche, froide, peu agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50dd9d5c-3cf1-4e2b-be18-53d538a7091f",
                                                "sense_id": "31abf7a3-b773-36f0-b408-1de24988ec0c",
                                                "text": "Elle commande sèchement les devoirs de la famille et de la cité, comme s'il s'agissait d'agencer des pierres et non d'harmoniser des hommes."
                                            },
                                            {
                                                "example_id": "71abed99-8a7e-45ec-94a3-9d54610a16ea",
                                                "sense_id": "31abf7a3-b773-36f0-b408-1de24988ec0c",
                                                "text": "Il ne faut jamais parler sèchement à un Numide."
                                            },
                                            {
                                                "example_id": "cd326dc5-0562-42ca-a4b5-ef419a9959b3",
                                                "sense_id": "31abf7a3-b773-36f0-b408-1de24988ec0c",
                                                "text": "Plusieurs coups de baguette assénés sèchement par le chef d'orchestre sur son pupitre interrompirent le colloque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3046124-3c3a-3785-a7d9-7c22bcb73c6b",
                                        "entry_id": "e9d538ae-f6ff-3455-80a6-e268f6c7317c",
                                        "glosses": [
                                            "En ayant un style sec, dénué d’agrément, en parlant d’écriture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0780d733-2f15-4af0-9e44-bba8434621af",
                                                "sense_id": "d3046124-3c3a-3785-a7d9-7c22bcb73c6b",
                                                "text": "Écrire sèchement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "640b03f3-b800-3bc6-ba4f-d4a3d33eb892",
                                        "entry_id": "e9d538ae-f6ff-3455-80a6-e268f6c7317c",
                                        "glosses": [
