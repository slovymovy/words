                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6cb26e5-e461-477a-89d9-1263b93a7c1b",
                                                "sense_id": "4eddc434-4b9a-3d23-92c6-7801e9a85828",
                                                "text": "And Ioshua said vnto the people, Ye cannot serue the Lord: for hee is an holy God: he is a ielous God, he will not forgiue your transgressions nor your sinnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84dbd971-851b-347a-bf10-9e7e46ed1724",
                                        "entry_id": "c03090ed-4b73-3c43-8883-a268c6d78fd9",
