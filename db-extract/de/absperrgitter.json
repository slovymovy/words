                "senses": [
                    {
                        "sense_id": "feb248d3-6725-3159-90fa-b1a6f2a70eea",
                        "entry_id": "2524f0aa-eda8-3bc3-af93-a319848ab940",
                        "glosses": [
                            "Gitter, um Bereiche abzusperren, oft aus Draht, Stahl oder Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d95c870-6b54-41d1-84d4-4aaa57f23777",
                                "sense_id": "feb248d3-6725-3159-90fa-b1a6f2a70eea",
                                "text": "Über dieses Absperrgitter schaffen wir's."
                            },
                            {
                                "example_id": "feb4dd2c-a140-48c0-871e-3c354672e8a2",
                                "sense_id": "feb248d3-6725-3159-90fa-b1a6f2a70eea",
                                "text": "Das Absperrgitter versperrte den Weg."
                            },
                            {
                                "example_id": "9be920cc-e41a-49b8-9080-a189c727fc91",
                                "sense_id": "feb248d3-6725-3159-90fa-b1a6f2a70eea",
                                "text": "Der Veranstalter hatte Absperrgitter aufgestellt."
                            },
                            {
                                "example_id": "83a57629-6ca7-48c5-9edf-40934cfb8229",
                                "sense_id": "feb248d3-6725-3159-90fa-b1a6f2a70eea",
                                "text": "„Ramin geht vor, steigt über die gelben Absperrgitter, ignoriert Under-Construction-Schilder, hält einen kleinen Vortrag über die Geschichte der Festung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5c74ab9f-76d8-3f67-aa05-cb10a825653e",
                        "entry_id": "2524f0aa-eda8-3bc3-af93-a319848ab940",
                        "glosses": [
                            "Gitter, das den Brutraum der Bienenkönigin vom Honigraum trennt; diese sind aus Metall oder Plastik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be759815-9271-4886-84a1-7e62d0da5636",
                                "sense_id": "5c74ab9f-76d8-3f67-aa05-cb10a825653e",
                                "text": "Das Absperrgitter dient in der konventionellen Bienenhaltung vor allem dazu, den Honigertrag zu optimieren und frühe und häufige Ernten möglich zu machen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
