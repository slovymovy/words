                                    },
                                    {
                                        "sense_id": "0d7e2e95-5962-33d1-bf42-9394d84c13e1",
                                        "entry_id": "405af903-ef98-32cc-b296-ca0231d76884",
                                        "glosses": [
                                            "En forme de nodule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d9b145e-62a0-4334-917f-de93230b8229",
                                                "sense_id": "0d7e2e95-5962-33d1-bf42-9394d84c13e1",
                                                "text": "On distingue les granulats nodulaires et le granulats concassées. Les grains nodulaires sont des grains de forme arrondie élaborés généralement au four rotatif et comportant une peau extérieure enveloppant une structure intérieure alvéolaire."
                                            },
                                            {
                                                "example_id": "4b43ef21-df5c-4fa6-b64a-145aefac246d",
                                                "sense_id": "0d7e2e95-5962-33d1-bf42-9394d84c13e1",
                                                "text": "Les trigger points sont des zones ultracompactes ou des bandes hypercontractées nodulaires au sein du muscle et sont palpables."
                                            }
                                        ]
                                    }
