                                        "sense_id": "33af765f-837f-31fe-a50f-1e3b5bc4b557",
                                        "entry_id": "16b15f89-33ea-3646-9a0e-959f6c1c376c",
                                        "glosses": [
                                            "кухонная плита использующая в качестве топлива горючий газ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8b97dcb-54f1-4d03-87cd-f56e204f5ef7",
                                                "sense_id": "33af765f-837f-31fe-a50f-1e3b5bc4b557",
                                                "text": "Кухни общие, но для каждой квартиры приспособлены отдельные газовая плита и отдельный газовый шкаф."
                                            },
                                            {
                                                "example_id": "8258255e-a3fc-4c85-a6dc-a45269f293a6",
                                                "sense_id": "33af765f-837f-31fe-a50f-1e3b5bc4b557",
                                                "text": "В конфорках газовых плит в городах и поселках горит природный газ, состоящий главным образом из метана."
                                            },
                                            {
                                                "example_id": "73cc1786-a524-4bf4-bd95-9a50a51f72a4",
                                                "sense_id": "33af765f-837f-31fe-a50f-1e3b5bc4b557",
                                                "text": "Тут она вскочила, подставила под струи таз, что нисколько не помогло, так как дождь расширился и стал заливать и газовую плиту, и стол с посудой."
                                            }
                                        ]
                                    }
                                ]
                            }
