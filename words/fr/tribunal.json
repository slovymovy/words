            "senses": [
                {
                    "sense_id": "34f63d24-43b8-3ec2-bf1a-9a57dd4f4b68",
                    "sense_definition": "Autorité judiciaire composée d'un ou plusieurs magistrats chargés d'instruire les affaires et de rendre la justice.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a présenté de nouveaux documents pour convaincre le <w>tribunal</w> de l'innocence de son client."
                        },
                        {
                            "text": "Les <w>tribunaux</w> doivent examiner attentivement chaque preuve avant de prononcer un verdict équitable."
                        }
                    ],
                    "synonyms": [
                        "cour",
                        "juridiction"
                    ],
                    "common_phrases": [
                        "comparaître devant le tribunal",
                        "décision du tribunal",
                        "saisir le tribunal"
                    ]
                },
                {
                    "sense_id": "a8a76a8e-4292-3731-a7d8-7e5303f80ded",
                    "sense_definition": "Bâtiment ou salle d'audience où siègent les juges et où se déroulent les procès.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux journalistes et citoyens attendaient devant les portes du <w>tribunal</w> dès le début de la matinée."
                        },
                        {
                            "text": "Le public a été prié de quitter la salle du <w>tribunal</w> avant le début des délibérations secrètes."
                        }
                    ],
                    "synonyms": [
                        "palais de justice"
                    ],
                    "common_phrases": [
                        "portes du tribunal",
                        "salle du tribunal"
                    ]
                },
                {
                    "sense_id": "51ea883c-114a-37d0-8b2d-303d976bd52b",
                    "sense_definition": "Instance morale, jugement collectif ou autorité abstraite devant laquelle on doit répondre de ses actes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette personnalité politique a dû faire face au redoutable <w>tribunal</w> de l'opinion publique."
                        },
                        {
                            "text": "Chacun est un jour confronté au jugement inflexible de son propre <w>tribunal</w> intérieur."
