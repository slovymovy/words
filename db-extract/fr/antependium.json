                        "entry_id": "f1cd87d2-69f0-34e6-bb14-8b08bfd6064e",
                        "glosses": [
                            "Pièce de tissu ou de cuir, ou de tout autre matériau souple, servant de devant d’autel."
                        ],
                        "tags": [
                            "Liturgie"
                        ],
                        "examples": [
                            {
                                "example_id": "bd11f409-32ec-4533-a709-fd93ad813c85",
                                "sense_id": "1328d0e4-2313-3638-82d3-2ab589362193",
                                "text": "Dans l’art religieux, nous trouvons l’antependium, riche pièce qui se trouve devant l’autel."
                            },
                            {
                                "example_id": "0cfffaeb-cc52-419d-beda-40527e80c1d3",
                                "sense_id": "1328d0e4-2313-3638-82d3-2ab589362193",
                                "text": "Toute la surface de l’antependium en était truffée…"
                            }
                        ]
                    }
                ],
