                },
                {
                    "sense_id": "5e64e303-f663-39c5-b12f-f162e9b68265",
                    "sense_definition": "ogół żołnierzy niepełniących czynnej służby, którzy mogą być powołani w razie potrzeby",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wojsko",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po zakończeniu zasadniczej służby wojskowej młody żołnierz przeszedł do <w>rezerwy</w>.",
                            "target_lang_translations": {
                                "ru": "После окончания срочной военной службы молодой солдат уволился в <w>запас</w>."
                            }
                        },
                        {
                            "text": "Ministerstwo obrony wezwało żołnierzy <w>rezerwy</w> na obowiązkowe ćwiczenia.",
                            "target_lang_translations": {
                                "ru": "Министерство обороны призвало военнослужащих <w>запаса</w> на обязательные учения."
                            }
                        }
