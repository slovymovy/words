                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "439dbaea-ed54-3d8f-8dea-170e6c9b6507",
                                        "entry_id": "a693961d-a852-3e87-b53c-73cdfd90d401",
                                        "glosses": [
                                            "A cricket ball or football."
                                        ],
                                        "tags": [
                                            "colloquial",
