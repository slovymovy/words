    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7a547108-37e0-33b0-896e-20fbb630fb44",
                    "sense_definition": "Не закрытый, не запечатанный, находящийся в состоянии, позволяющем доступ внутрь.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На столе стоял <w>открытый</w> графин с водой.",
                            "target_lang_translations": {
                                "en": "An <w>open</w> carafe of water was standing on the table."
                            }
                        },
                        {
                            "text": "В комнате стоял <w>открытый</w> сундук с вещами.",
                            "target_lang_translations": {
                                "en": "There was an <w>open</w> chest of belongings in the room."
                            }
                        }
                    ],
                    "synonyms": [
                        "раскрытый"
                    ],
                    "antonyms": [
                        "закрытый"
                    ],
                    "common_phrases": [
                        "открытое окно",
                        "открытая дверь"
                    ],
                    "target_lang_definitions": {
                        "en": "Not closed or sealed; in a state that allows access inside."
                    },
                    "translations": {
