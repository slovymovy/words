                                "sense_id": "3faa0294-8e1f-300d-b9cd-fd45accd8a68",
                                "text": "„Erzähl mir lieber noch mal, wie Moritz auf so großartige Art und Weise der Friendzone entkommen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
