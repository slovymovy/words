                    {
                        "sense_id": "a8079d4f-986c-317a-a74a-4f06186810fa",
                        "entry_id": "277c7f60-d5ec-3048-ae9d-360291f5bf24",
                        "glosses": [
                            "To make a gloomy, sullen or miserable facial expression; to scowl."
                        ],
                        "tags": [
                            "intransitive",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "9f4d46ae-91a9-4131-a7e2-64ea3754511d",
                                "sense_id": "a8079d4f-986c-317a-a74a-4f06186810fa",
                                "text": "“Oh, stop your sourpussing. We got what you needed.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "796a8d73-e5f1-40cb-9d4f-4226c881c450",
                        "source_entry_id": "277c7f60-d5ec-3048-ae9d-360291f5bf24",
                        "source_sense_id": "a8079d4f-986c-317a-a74a-4f06186810fa",
                        "source_sense_description": "A person who is gloomy, sullen, or miserable",
                        "target_lang_word": "Miesepeter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Miesepeter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70a536d5-efbb-385b-9000-8934c3af8e10",
                                        "entry_id": "0db4c18a-de0a-3ae7-839c-33df58f57334",
                                        "glosses": [
                                            "Person, die Vieles schlecht findet oder macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "482d4a5d-f675-45ff-8d90-1c989827395f",
                                                "sense_id": "70a536d5-efbb-385b-9000-8934c3af8e10",
                                                "text": "Ich habe noch selten einen Miesepeter wie ihn erlebt."
                                            },
                                            {
                                                "example_id": "56603988-307b-4d6d-ac78-856c91dc8473",
                                                "sense_id": "70a536d5-efbb-385b-9000-8934c3af8e10",
                                                "text": "„Der Miesepeter hielt fortan seinen Mund, und so konnte Laura Leonore ihrem Enthusiasmus freie Bahn lassen.“"
                                            },
                                            {
                                                "example_id": "186b8ce4-e882-4828-8585-5f99d934a5f5",
                                                "sense_id": "70a536d5-efbb-385b-9000-8934c3af8e10",
                                                "text": "„Meine Beschäftigung mit den kleinsten Einzelheiten der Vergangenheit, die mir soviel Vergnügen bereitet und die menschliche Natur auf eine Art erhellt, die sie mir erträglich macht, werden als Korinthenkackerei angesehen oder als Beweis für einen geistigen Miesepeter, der mit sich selbst im Streit liegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcb7e604-2216-47c8-aedd-ad21d343faf5",
                        "source_entry_id": "277c7f60-d5ec-3048-ae9d-360291f5bf24",
                        "source_sense_id": "a8079d4f-986c-317a-a74a-4f06186810fa",
                        "source_sense_description": "A person who is gloomy, sullen, or miserable",
                        "target_lang_word": "Sauertopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sauertopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4bd5b64-c11e-3e57-8be1-ee6958ea5ed6",
                                        "entry_id": "122e3bea-f591-3f7d-864c-4526a39e1c35",
                                        "glosses": [
                                            "Person, die immer schlechte Laune hat und wenig Freude am Leben zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7070534e-4c70-4424-94f2-bca2c2a579b7",
                                                "sense_id": "c4bd5b64-c11e-3e57-8be1-ee6958ea5ed6",
                                                "text": "„Tolldrastische Geschichten: wie sie in den Abteien und Klöstern der Touraine gesammelt und ans Licht gebracht der edle Herr Honoré de Balzac, zu Ergötzen, Kurzweil und Erbauung aller derer Pantagruelisten und mitnichten der Banausen und griesgrämigen Sauertöpfe.“"
                                            },
                                            {
                                                "example_id": "cab001fe-bff5-4f02-be3e-7c8e1bad295a",
                                                "sense_id": "c4bd5b64-c11e-3e57-8be1-ee6958ea5ed6",
                                                "text": "„Andernfalls droht ein Ende im Dauerhader oder als Sauertopf.“"
                                            },
                                            {
                                                "example_id": "af429a8e-f16b-4e17-b3ac-e222d07e0fca",
                                                "sense_id": "c4bd5b64-c11e-3e57-8be1-ee6958ea5ed6",
                                                "text": "„Sie wurde traurig oder tat wenigstens so, als ich mir herausnahm, ihr zu sagen, daß ihr Zukünftiger, den ihr Vater Mardochai für sie ausgewählt habe, vielleicht ein Mann sei, den die Natur schlecht ausgerüstet habe, oder einer jener Sauertöpfe mit schlechter Verdauung, die ihre ehelichen Pflichten nur einmal in der Woche erfüllen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07728723-e532-4436-9489-8e1ea9039418",
