                    {
                        "sense_id": "d7937e74-9e55-3423-890a-00a04b7d804a",
                        "entry_id": "059c01de-9f98-3ae1-b04c-43a01e7fa4c7",
                        "glosses": [
                            "met een grote groep vogels ergens om heen bewegen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "26d4f640-7f9e-3150-aa9a-919fa62ce98b",
                        "entry_id": "059c01de-9f98-3ae1-b04c-43a01e7fa4c7",
                        "glosses": [
                            "met een grote grote groep mensen om iets of iemand heen bewegen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "339fecd3-6941-4773-a4ae-b20528abb122",
                                "sense_id": "26d4f640-7f9e-3150-aa9a-919fa62ce98b",
                                "text": "Als de paparazzi hem bij een speeltuinbezoek omzwermen, roepen ze hem toe: ‘Waarom doe je zo boos? Je hebt zelf met haar geposeerd.’’"
                            },
                            {
                                "example_id": "5d205f35-a001-408a-91b1-425dd260069f",
                                "sense_id": "26d4f640-7f9e-3150-aa9a-919fa62ce98b",
                                "text": "Vooral de smadelijke aftocht, vijf weken later, is diep in het Europese geheugen verankerd. Het uitgehongerde leger, wat er althans van over is, wordt voortdurend bestookt door kozakken, die als gevaarlijke insecten op hun vlugge paardjes het leger omzwermen."
                            }
                        ]
                    }
