{
    "word_family": [
        "sens",
        "sensé",
        "insensément"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7dccac27-4155-3612-b0ba-c651698c86c8",
                    "sense_definition": "Qui est contraire à la raison ou au bon sens.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "déraisonnable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prendre la route sous cette violente tempête de neige est une idée totalement <w>insensée</w>."
                        },
                        {
                            "text": "Son discours était tellement <w>insensé</w> que personne dans la salle n'a compris ses intentions."
                        }
                    ],
                    "synonyms": [
                        "absurde"
                    ],
                    "antonyms": [
                        "sensé"
                    ],
                    "common_phrases": [
                        "projet insensé",
                        "idée insensée"
                    ]
                },
                {
                    "sense_id": "0f675e73-6b55-3966-9c8a-7862bcb11719",
                    "sense_definition": "Qui dépasse la mesure normale ; excessif, incroyable ou extravagant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excessif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune comédien a eu une chance <w>insensée</w> en décrochant ce grand rôle dès son premier casting."
                        },
                        {
                            "text": "Ils dépensent chaque mois une somme <w>insensée</w> pour financer les travaux de leur maison."
                        }
                    ],
                    "common_phrases": [
                        "chance insensée",
                        "succès insensé"
                    ]
                },
                {
                    "sense_id": "a711c26d-b972-3745-9086-59ad7f1f0262",
                    "sense_definition": "Qui n'a pas toute sa raison, qui se comporte de manière déraisonnable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "déraisonnable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut être <w>insensé</w> pour investir toutes ses économies dans une affaire aussi risquée."
                        },
                        {
                            "text": "Face au danger, les passagers sont devenus presque <w>insensés</w> et criaient de panique."
                        }
                    ],
                    "antonyms": [
                        "sensé"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19752d25-708f-3bd6-ad9a-5529e88c0176",
                    "sense_definition": "Personne qui agit de façon déraisonnable ou qui semble avoir perdu la raison.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet <w>insensé</w> refuse de consulter un médecin malgré ses douleurs persistantes au ventre."
                        },
                        {
                            "text": "En le voyant traverser l'autoroute à pied, tout le monde a pensé que c'était un <w>insensé</w>."
                        }
                    ],
                    "common_phrases": [
                        "courir comme un insensé"
                    ]
                }
            ]
        }
    ]
}