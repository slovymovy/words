                        "entry_id": "9a6ef63f-2d1e-3f41-abd1-3d6f3ce39671",
                        "glosses": [
                            "Bière de sassafras, boisson gazeuse préparée à partir de différentes racines et fines herbes, populaire surtout en Amérique du Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f92dc950-94d5-41b8-b0a6-767bac994686",
                                "sense_id": "05a76fc5-3f68-30b9-958a-81950b331565",
                                "text": "Donnez-moi un cheeseburger, une portion de frites, et une grande racinette."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df060682-7b41-4282-908e-0c04b565ce95",
                        "source_entry_id": "9a6ef63f-2d1e-3f41-abd1-3d6f3ce39671",
                        "source_sense_id": "05a76fc5-3f68-30b9-958a-81950b331565",
                        "target_lang_word": "Rootbier",
