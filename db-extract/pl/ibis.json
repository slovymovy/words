                "senses": [
                    {
                        "sense_id": "fb435d72-268a-3e6e-9332-9123571af400",
                        "entry_id": "5969468d-c990-3256-9072-e029ba08626c",
                        "glosses": [
                            "ptak brodzący z podrodziny ibisów, Threskiornithinae"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70d93434-74c0-4719-acb1-b5639ef8f2b1",
                                "sense_id": "fb435d72-268a-3e6e-9332-9123571af400",
                                "text": "Do Polski ibisy zalatują sporadycznie."
                            },
                            {
                                "example_id": "f8120258-2ccb-4b92-9f68-c08b37a96c2e",
                                "sense_id": "fb435d72-268a-3e6e-9332-9123571af400",
                                "text": "Warugi poznawaliśmy po czepku z piór na głowie, a gdy przeleciało nad nami stado ibisów z groteskowo zagiętymi ku dołowi dziobami, nie było już wątpliwości, że zbliżaliśmy się do wielkiej wody."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20772d42-0d20-405b-8ea1-11cf8a6fcefb",
                        "source_entry_id": "5969468d-c990-3256-9072-e029ba08626c",
                        "source_sense_id": "fb435d72-268a-3e6e-9332-9123571af400",
                        "target_lang_word": "ibis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ibis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71af7512-b4c2-3702-91ab-21675b37dd00",
                                        "entry_id": "29c606dc-e9ff-31df-a29a-bad173eabb39",
                                        "glosses": [
                                            "Any of various long-legged wading birds in the family Threskiornithidae, having long downcurved bills used to probe the mud for prey such as crustaceans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e158b75-b4f2-4820-b695-bc926f21cda2",
                                                "sense_id": "71af7512-b4c2-3702-91ab-21675b37dd00",
                                                "text": "It is out of the idolatrous dotings of the old Egyptians upon broiled ibis and roasted river horse, that you see the mummies of those creatures in their huge bake-houses the pyramids."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9eca1686-778e-4043-9104-f27db0614140",
                        "source_entry_id": "5969468d-c990-3256-9072-e029ba08626c",
                        "source_sense_id": "fb435d72-268a-3e6e-9332-9123571af400",
