                ],
                "senses": [
                    {
                        "sense_id": "33bf26f1-0f43-3c8d-a134-6ecedcb03130",
                        "entry_id": "509ab60c-11f4-3477-8879-1501e92bb335",
                        "glosses": [
                            "Faire perdre son caractère racial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73d1089d-40c4-40b8-bf6d-605a0d1f6e06",
                                "sense_id": "33bf26f1-0f43-3c8d-a134-6ecedcb03130",
                                "text": "Lorsque la lutte pour dé-racialiser la société civile atteignait une puissance significative, l’État indépendant jouait un rôle central."
                            },
                            {
                                "example_id": "ffd19404-4c23-4082-92a5-afc1e12612ec",
                                "sense_id": "33bf26f1-0f43-3c8d-a134-6ecedcb03130",
                                "text": "Quelle est notre capacité à dé-racialiser les relations sociales ?"
                            },
                            {
                                "example_id": "a8e7879d-35bd-4d97-bc11-da80d2df00b9",
                                "sense_id": "33bf26f1-0f43-3c8d-a134-6ecedcb03130",
                                "text": "Le volontarisme étatique tente donc de dé-racialiser -ou multiracialiser- l’économie par des attributions de marchés, le soutien à l’entrée dans les conseils d’administration, et bien d’autres mesures positives d’appui à l’émergence d’une économie d’acteurs noirs africains..."
                            }
                        ]
                    }
