                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "601c75e7-189d-4b3f-b964-f270da664806",
                                "sense_id": "12251d82-6e2f-35ea-8f3b-5c27537c7a13",
                                "text": "Zij zat in een koffieshop, nou, ik kwam daar elke keer. Gewoon om stuff te kopen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d67e4647-714a-358b-96de-6464e7f1813e",
                        "entry_id": "7ff02104-8f5d-37a1-a331-fa3a36144ab7",
                        "glosses": [
                            "diverse voorwerpen als een geheel opgevat"
                        ],
                        "tags": [
