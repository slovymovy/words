                ],
                "senses": [
                    {
                        "sense_id": "0389306a-a56e-3f1a-87c9-7f4229cef951",
                        "entry_id": "1d1c5bee-dccd-34b3-bea6-94272a05db13",
                        "glosses": [
                            "Veränderung des Landschaftsbildes durch einen zunehmenden Anbau von Mais auf den Ackerflächen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52fa61c9-227d-4d38-a6f2-f9a54793c5c2",
                                "sense_id": "0389306a-a56e-3f1a-87c9-7f4229cef951",
                                "text": "„Im ländlichen Raum tun Phänome wie die Monokultur etwa in Form der Vermaisung der Landschaft ihr Übriges dazu.“"
                            },
                            {
                                "example_id": "6ffa01b7-e3ea-4988-b0cc-a25feb9fbdcb",
                                "sense_id": "0389306a-a56e-3f1a-87c9-7f4229cef951",
                                "text": "„Dass es überall Vermaisung der Landschaft gibt, hängt auch damit zusammen, dass über Biogasanlagen erneuerbare Energie hergestellt wird.“"
                            },
                            {
                                "example_id": "16b46600-b143-4bfc-a392-33338a380e63",
                                "sense_id": "0389306a-a56e-3f1a-87c9-7f4229cef951",
                                "text": "„Die Europäische Union subventioniert die eintönige Vermaisung unserer Landschaft.“"
                            },
                            {
                                "example_id": "f383a051-64f1-44dd-9be0-ce2c44fb0317",
                                "sense_id": "0389306a-a56e-3f1a-87c9-7f4229cef951",
                                "text": "„An der »Verspargelung der Landschaft« durch Windräder bin ich also ebenso wenig beteiligt wie an der »Vermaisung der Felder« für Biogasanlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
