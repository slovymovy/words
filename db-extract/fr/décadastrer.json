                ],
                "senses": [
                    {
                        "sense_id": "0f8eafeb-f29f-321b-b0e9-5c89123b727e",
                        "entry_id": "5d76a9c9-3689-37d0-819e-23c7b2073b09",
                        "glosses": [
                            "Ne plus faire figurer au cadastre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae0d2ba5-6437-4c37-8ccf-51573323986e",
                                "sense_id": "0f8eafeb-f29f-321b-b0e9-5c89123b727e",
                                "text": "L’année dernière la municipalité a demandé au Conseil Municipal, par un vote, de l’autoriser à décadastrer environ 200 parcelles du territoire communal, propriétés de la Commune, au prétexte qu’il fallait payer des impôts sur ces parcelles sans préciser le montant de ces impôts."
                            },
                            {
                                "example_id": "5a97553a-4d7d-4f21-9a6c-220e669a195c",
                                "sense_id": "0f8eafeb-f29f-321b-b0e9-5c89123b727e",
                                "text": "Il est ainsi nécessaire de décadastrer une zone (153 m2) pour créer les places de parc réservées aux enseignants itinérants."
                            },
                            {
                                "example_id": "292ddef7-bc67-40ba-a5ad-fa0062595445",
                                "sense_id": "0f8eafeb-f29f-321b-b0e9-5c89123b727e",
                                "text": "Dès les premiers avant-textes de Melancholia Sartre avait déjà décadastré l’ensemble de la ville du Havre à l’exception notable de l’hôtel Printania où loge Roquentin — où Sartre a habité une chambre au début de son exil havrais."
                            }
                        ]
                    }
                ],
