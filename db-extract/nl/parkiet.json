                                        "sense_id": "c5d5e2d7-1c6d-33d0-a7f9-25c64eb450d4",
                                        "entry_id": "03409460-64c8-35ba-b7f6-8e4423eee58b",
                                        "glosses": [
                                            "ein kleiner Vogel mit langem Schwanz, der zu den Papageien (Ordnung Psittaciformes) gehört"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15210fc5-a6bc-452d-8282-5ba2939ecdeb",
                                                "sense_id": "c5d5e2d7-1c6d-33d0-a7f9-25c64eb450d4",
                                                "text": "Meyers haben sich einen Sittich angeschafft."
                                            },
                                            {
                                                "example_id": "b651b1ca-99ac-4683-9653-5680cb680a96",
                                                "sense_id": "c5d5e2d7-1c6d-33d0-a7f9-25c64eb450d4",
                                                "text": "„Er geht behutsam vor, fängt aber nur den gelben Sittich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
