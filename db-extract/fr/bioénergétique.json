                ],
                "senses": [
                    {
                        "sense_id": "96a39259-4deb-343f-8571-c3cfe5ee7f02",
                        "entry_id": "a8f17298-c843-368b-9e88-d7a42e22c5c6",
                        "glosses": [
                            "Relatif aux mécanismes de transduction d’énergie par les organismes vivants tels qu’étudiés par des approches biochimiques et biophysiques et quantifiés par la mesure des vitesses de synthèse et d’hydrolyse de l’ATP."
                        ],
                        "tags": [
                            "Biophysique"
                        ],
                        "examples": [
                            {
                                "example_id": "65ae4137-a131-477e-b2b1-0114f2b75fb1",
                                "sense_id": "96a39259-4deb-343f-8571-c3cfe5ee7f02",
                                "text": "Recherche sur l’optimisation des filières bioénergétiques et l’élaboration de systèmes bioénergétiques intégrés, dans le cadre du concept de « bioraffinerie »."
                            }
                        ]
                    },
                    {
                        "sense_id": "f64828f0-7038-3adb-848a-a71a87f48c2d",
                        "entry_id": "a8f17298-c843-368b-9e88-d7a42e22c5c6",
                        "glosses": [
                            "Relatif aux énergies propres aux êtres vivants, de nature plus ésotériques et s’appuyant sur des concepts et des théories de diverses natures mais ne relevant pas des méthodes objectives traditionnelles de la physiologie et de la médecine expérimentale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3efbf7ef-6b34-4b50-8d30-19d7f132050e",
                                "sense_id": "f64828f0-7038-3adb-848a-a71a87f48c2d",
                                "text": "Ce chapitre expose les moyens pour amener le corps, la force bioénergétique, les sens et le mental sous contrôle."
                            }
                        ]
                    }
                ],
