{
    "word_family": [
        "bare",
        "bareness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "79d3db34-7231-3668-a5ce-0b604ed6f793",
                    "sense_definition": "Almost not at all; used to emphasize that something is only just true or possible.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plane is so far away now I can <w>barely</w> see it.",
                            "target_lang_translations": {
                                "ru": "Самолет сейчас так далеко, что я <w>едва</w> его вижу.",
                                "zh": "飞机现在太远了，我<w>几乎</w>看不见它。"
                            }
                        },
                        {
                            "text": "The music was so quiet that it was <w>barely</w> audible to the audience.",
                            "target_lang_translations": {
                                "ru": "Музыка была настолько тихой, что была <w>еле</w> слышна публике.",
                                "zh": "音乐太轻了，观众<w>勉强</w>能听到。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hardly",
                        "scarcely"
                    ],
                    "antonyms": [
                        "completely",
                        "fully"
                    ],
                    "common_phrases": [
                        "barely visible",
                        "barely audible",
                        "can barely see"
                    ],
                    "target_lang_definitions": {
                        "ru": "Почти совсем нет; используется для подчеркивания того, что что-то лишь едва верно или возможно.",
                        "zh": "几乎没有；用于强调某事仅仅是勉强真实或可能。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "едва",
                                "target_lang_sense_clarification": "в самой малой степени"
                            },
                            {
                                "target_lang_word": "еле",
                                "target_lang_sense_clarification": "почти не"
                            },
                            {
                                "target_lang_word": "почти не",
                                "target_lang_sense_clarification": "отрицание полноты действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "几乎不",
                                "target_lang_sense_clarification": "表示程度极低"
                            },
                            {
                                "target_lang_word": "勉强",
                                "target_lang_sense_clarification": "表示能力或状态处于边缘"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70fe6b4c-10e1-3dec-bf70-0b7957276117",
                    "sense_definition": "By a very small margin; only just.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>barely</w> completed my homework before the deadline.",
                            "target_lang_translations": {
                                "ru": "Я <w>едва-едва</w> успел сделать домашнее задание до дедлайна.",
                                "zh": "我在截止日期前<w>好不容易</w>写完了作业。"
                            }
                        },
                        {
                            "text": "He <w>barely</w> managed to catch the train as it was leaving the station.",
                            "target_lang_translations": {
                                "ru": "Ему <w>еле-еле</w> удалось успеть на поезд, когда тот уже отходил от станции.",
                                "zh": "火车离站时，他<w>勉强</w>赶上了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "just",
                        "only just"
                    ],
                    "antonyms": [
                        "easily",
                        "well"
                    ],
                    "common_phrases": [
                        "barely managed",
                        "barely enough",
                        "barely escaped"
                    ],
                    "target_lang_definitions": {
                        "ru": "С очень небольшим запасом; только что.",
                        "zh": "以极小的差距；刚刚好。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "едва",
                                "target_lang_sense_clarification": "с трудом, насилу"
                            },
                            {
                                "target_lang_word": "еле-еле",
                                "target_lang_sense_clarification": "с большим трудом"
                            },
                            {
                                "target_lang_word": "только-только",
                                "target_lang_sense_clarification": "с трудом успев"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好不容易",
                                "target_lang_sense_clarification": "强调过程的艰难"
                            },
                            {
                                "target_lang_word": "勉强",
                                "target_lang_sense_clarification": "强调结果的勉强达成"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "348770df-f65d-3560-891d-30e32d50ee4d",
                    "sense_definition": "Only a very short time ago; recently.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>barely</w> got to the store when it started to rain.",
                            "target_lang_translations": {
                                "ru": "Я <w>только</w> дошел до магазина, как начался дождь.",
                                "zh": "我<w>刚</w>到商店就开始下雨了。"
                            }
                        },
                        {
                            "text": "They had <w>barely</w> arrived when the meeting was called to order.",
                            "target_lang_translations": {
                                "ru": "Они <w>едва</w> успели приехать, как собрание объявили открытым.",
                                "zh": "他们<w>刚</w>到，会议就开始了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "just"
                    ],
                    "common_phrases": [
                        "barely arrived",
                        "barely started"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совсем недавно; только что.",
                        "zh": "不久前；刚刚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "только",
                                "target_lang_sense_clarification": "совсем недавно"
                            },
                            {
                                "target_lang_word": "едва",
                                "target_lang_sense_clarification": "как только"
                            },
                            {
                                "target_lang_word": "лишь",
                                "target_lang_sense_clarification": "сразу после того как"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刚",
                                "target_lang_sense_clarification": "表示时间极短"
                            },
                            {
                                "target_lang_word": "才",
                                "target_lang_sense_clarification": "表示动作刚刚发生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c66f13c9-7652-375f-b3bc-c7605fb46d8f",
                    "sense_definition": "In a simple or plain way, without any extra detail or decoration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The facts were stated <w>barely</w> and directly without any emotional appeal.",
                            "target_lang_translations": {
                                "ru": "Факты были изложены <w>сухо</w> и прямо, без какого-либо эмоционального призыва.",
                                "zh": "事实被<w>平淡</w>而直接地陈述出来，没有任何情感色彩。"
                            }
                        },
                        {
                            "text": "The room was <w>barely</w> furnished with only a single wooden chair.",
                            "target_lang_translations": {
                                "ru": "Комната была <w>скудно</w> обставлена — в ней стоял лишь один деревянный стул.",
                                "zh": "房间里陈设<w>简陋</w>，只有一把木椅子。"
                            }
                        }
                    ],
                    "antonyms": [
                        "elaborately"
                    ],
                    "common_phrases": [
                        "stated barely",
                        "barely furnished"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in formal or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Просто или прямо, без лишних деталей или украшений.",
                        "zh": "以简单或朴素的方式，没有任何额外的细节或装饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скудно",
                                "target_lang_sense_clarification": "о мебели или обстановке"
                            },
                            {
                                "target_lang_word": "сухо",
                                "target_lang_sense_clarification": "о фактах или стиле изложения"
                            },
                            {
                                "target_lang_word": "просто",
                                "target_lang_sense_clarification": "без прикрас"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简陋地",
                                "target_lang_sense_clarification": "指环境或陈设"
                            },
                            {
                                "target_lang_word": "平淡地",
                                "target_lang_sense_clarification": "指叙述风格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "849d33e5-3bbf-305e-a7cc-421b889b31a0",
                    "sense_definition": "Only; no more than; <w>merely</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fire does not always <w>barely</w> separate the parts but sometimes alters them.",
                            "target_lang_translations": {
                                "ru": "Огонь не всегда <w>просто</w> разделяет части, но иногда и изменяет их.",
                                "zh": "火并不总是<w>仅仅</w>将各部分分开，有时还会改变它们。"
                            }
                        },
                        {
                            "text": "He was <w>barely</w> a child when he was forced to work in the mines.",
                            "target_lang_translations": {
                                "ru": "Он был <w>всего лишь</w> ребенком, когда его заставили работать в шахтах.",
                                "zh": "他<w>只不过</w>还是个孩子时，就被迫去矿井工作了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "this sense is rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Только; не более чем; всего лишь.",
                        "zh": "仅仅；不外乎；只不过。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всего лишь",
                                "target_lang_sense_clarification": "ограничение значения"
                            },
                            {
                                "target_lang_word": "только",
                                "target_lang_sense_clarification": "исключительно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仅仅",
                                "target_lang_sense_clarification": "表示范围或数量的限制"
                            },
                            {
                                "target_lang_word": "只不过",
                                "target_lang_sense_clarification": "表示程度轻微"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}