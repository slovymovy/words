                "senses": [
                    {
                        "sense_id": "8589dc94-b3aa-3700-b12c-4ca9600aedfc",
                        "entry_id": "e9a593d7-a2f3-331e-94be-f972da9f0f7d",
                        "glosses": [
                            "устар. и рег. : укрепить, привести в порядок, утеплить"
                        ],
                        "tags": [
                            "о строении, помещении"
                        ],
                        "examples": [
                            {
                                "example_id": "b4b67bf6-2492-43bf-93a3-1f24d3c3fbf0",
                                "sense_id": "8589dc94-b3aa-3700-b12c-4ca9600aedfc",
                                "text": "Изба прочна и хорошо ухичена; запасу вдоволь, скотины в избытке, дети — в порядке."
                            },
                            {
                                "example_id": "f27a9193-a2f8-4a2d-97f4-b02298d30e73",
                                "sense_id": "8589dc94-b3aa-3700-b12c-4ca9600aedfc",
                                "text": "Он только недавно кончил пастьбу, но ещё не перебирался домой, без него же ухитить хибарку от наступавшей стужи было некому."
                            }
                        ]
                    }
