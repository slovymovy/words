                    ],
                    "common_phrases": [
                        "emotioneel instorten",
                        "geestelijk instorten"
                    ],
                    "target_lang_definitions": {
                        "en": "To lose mental or emotional control due to great tension or grief"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "collapse",
                                "target_lang_sense_clarification": "emotional or mental breakdown"
                            },
                            {
                                "target_lang_word": "break down",
                                "target_lang_sense_clarification": "to lose emotional control"
                            },
                            {
                                "target_lang_word": "have a breakdown",
                                "target_lang_sense_clarification": "mental health crisis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83afcae8-746e-3fde-94c0-c58a9ea51e20",
                    "sense_definition": "het ophouden te bestaan van een systeem, regime of markt door externe druk of zwakte",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract bezwijken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Economen zijn bang dat de aandelenmarkt zal <w>instorten</w> als de rente verder stijgt.",
                            "target_lang_translations": {
                                "en": "Economists fear that the stock market will <w>collapse</w> if interest rates rise further."
