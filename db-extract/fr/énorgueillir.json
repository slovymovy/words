                ],
                "senses": [
                    {
                        "sense_id": "64ddf92d-0d74-34b3-94b3-fdaf70ae2fbd",
                        "entry_id": "578eeff1-77c8-3ae8-84be-29d3031db67f",
                        "glosses": [
                            "Variante de enorgueillir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c9b8699-2cf2-42c8-9bc6-04c72027bcf8",
                                "sense_id": "64ddf92d-0d74-34b3-94b3-fdaf70ae2fbd",
                                "text": "Pourquoi vous énorgueillir de votre beauté ? Vous ne savez pas combien elle durera : & quand elle dureroit long-temps, devez-vous vous énorgueillir d’une chose qui ne vous rend pas plus estimable ?"
                            },
                            {
                                "example_id": "5fbd6887-da37-4755-8f57-9708b3876c7e",
                                "sense_id": "64ddf92d-0d74-34b3-94b3-fdaf70ae2fbd",
                                "text": "La grandeur de l’âme ne consiste point à jouir pour soi seul et à s’énorgueillir de ses richesses, mais à les mépriser."
                            },
                            {
                                "example_id": "4ae1c29e-dba6-4a95-951b-d193ff9879a4",
                                "sense_id": "64ddf92d-0d74-34b3-94b3-fdaf70ae2fbd",
                                "text": "M. le Professeur Hafter peut en effet s’énorgueillir — ou il pourrait s’énorgueillir s’il n’était la simplicité et la modestie même — d’une carrière magnifique et bien remplie, toute consacrée à son pays et à la science du droit."
                            },
                            {
                                "example_id": "f52a32fe-6d02-44a9-84cb-eb2a09cfe4f1",
                                "sense_id": "64ddf92d-0d74-34b3-94b3-fdaf70ae2fbd",
                                "text": "Je ne souhaite pas m’énorgueillir en l’écrivant, sinon que je veux être honnête : j’aime lire."
                            }
                        ]
                    }
                ],
