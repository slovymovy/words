{
    "word_family": [
        "scary",
        "scarecrow",
        "scaremonger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dd1d8512-7970-369e-b736-ac9213f07d25",
                    "sense_definition": "To cause fear, terror, or alarm in someone or something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cause_fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Loud noises often <w>scare</w> the young children.",
                            "target_lang_translations": {
                                "ru": "Громкие звуки часто <w>пугают</w> маленьких детей.",
                                "de": "Lauta Geräusche <w>erschrecken</w> oft die kleinen Kinder.",
                                "fr": "Les bruits forts <w>effraient</w> souvent les jeunes enfants.",
                                "nl": "Harde geluiden <w>laten</w> jonge kinderen vaak <w>schrikken</w>."
                            }
                        },
                        {
                            "text": "Do not let the dog <w>scare</w> away the birds in the garden.",
                            "target_lang_translations": {
                                "ru": "Не позволяй собаке <w>распугать</w> птиц в саду.",
                                "de": "Lass den Hund die Vögel im Garten nicht <w>verscheuchen</w>.",
                                "fr": "Ne laisse pas le chien <w>faire fuir</w> les oiseaux du jardin.",
                                "nl": "Laat de hond de vogels in de tuin niet <w>verjagen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "frighten",
                        "terrify"
                    ],
                    "antonyms": [
                        "calm",
                        "reassure"
                    ],
                    "common_phrases": [
                        "scare away",
                        "scare off",
                        "scare to death"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать страх, ужас или тревогу у кого-либо.",
                        "de": "Jemandem oder etwas Angst, Schrecken oder Alarm versetzen.",
                        "fr": "Causer de la peur, de la terreur ou de l'effroi chez quelqu'un ou quelque chose.",
                        "nl": "Iemand of iets angst, schrik of alarm aanjagen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пугать",
                                "target_lang_sense_clarification": "вызывать чувство страха (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "напугать",
                                "target_lang_sense_clarification": "вызвать страх (совершенный вид)"
                            },
                            {
                                "target_lang_word": "испугать",
                                "target_lang_sense_clarification": "внезапно вызвать испуг"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erschrecken",
                                "target_lang_sense_clarification": "jemandem einen Schrecken einflößen"
                            },
                            {
                                "target_lang_word": "ängstigen",
                                "target_lang_sense_clarification": "jemanden in Angst versetzen"
                            },
                            {
                                "target_lang_word": "beängstigen",
                                "target_lang_sense_clarification": "Unruhe und Besorgnis auslösen"
                            },
                            {
                                "target_lang_word": "verscheuchen",
                                "target_lang_sense_clarification": "durch Aufschrecken vertreiben (z. B. Tiere)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "effrayer",
                                "target_lang_sense_clarification": "remplir de frayeur ou de peur"
                            },
                            {
                                "target_lang_word": "faire peur à",
                                "target_lang_sense_clarification": "susciter de la peur chez quelqu'un"
                            },
                            {
                                "target_lang_word": "faire fuir",
                                "target_lang_sense_clarification": "effrayer pour faire partir (scare away/off)"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "laten schrikken",
                                "target_lang_sense_clarification": "plotseling schrik aanjagen"
                            },
                            {
                                "target_lang_word": "bang maken",
                                "target_lang_sense_clarification": "vrees of angst veroorzaken"
                            },
                            {
                                "target_lang_word": "angst aanjagen",
                                "target_lang_sense_clarification": "ernstige vrees inboezemen"
                            },
                            {
                                "target_lang_word": "beangstigen",
                                "target_lang_sense_clarification": "zorgen of angst geven"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f5a3714-b05f-3c81-8de1-1507a7793a18",
                    "sense_definition": "To become afraid or frightened; to have the capacity to feel fear.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "feel_fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is very brave and does not <w>scare</w> easily.",
                            "target_lang_translations": {
                                "ru": "Она очень смелая, и её нелегко <w>напугать</w>.",
                                "de": "Sie ist sehr mutig und <w>erschrickt</w> nicht so leicht.",
                                "fr": "Elle est très brave et ne <w>s'effraie</w> pas facilement.",
                                "nl": "Ze is erg dapper en <w>schrikt</w> niet snel."
                            }
                        },
                        {
                            "text": "I do not <w>scare</w> just because of a horror movie.",
                            "target_lang_translations": {
                                "ru": "Я не <w>пугаюсь</w> просто из-за фильма ужасов.",
                                "de": "Ich <w>erschrecke</w> mich nicht einfach nur wegen eines Horrorfilms.",
                                "fr": "Je n'<w>ai</w> pas <w>peur</w> simplement à cause d'un film d'horreur.",
                                "nl": "Ik word niet zomaar <w>bang</w> van een horrorfilm."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scare easily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пугаться, испытывать страх; быть способным чувствовать страх.",
                        "de": "Angst bekommen oder erschrecken; leicht in Angst geraten.",
                        "fr": "Avoir peur ou prendre peur facilement ; être sujet à la frayeur.",
                        "nl": "Bang worden of schrikken; het vermogen hebben om angst te voelen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пугаться",
                                "target_lang_sense_clarification": "испытывать страх"
                            },
                            {
                                "target_lang_word": "бояться",
                                "target_lang_sense_clarification": "чувствовать страх перед чем-либо"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erschrecken",
                                "target_lang_sense_clarification": "von einem Schrecken ergriffen werden"
                            },
                            {
                                "target_lang_word": "sich erschrecken",
                                "target_lang_sense_clarification": "plötzlich Angst bekommen (reflexiv)"
                            },
                            {
                                "target_lang_word": "sich ängstigen",
                                "target_lang_sense_clarification": "Angst haben oder bekommen"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "avoir peur",
                                "target_lang_sense_clarification": "ressentir de la crainte"
                            },
                            {
                                "target_lang_word": "s'effrayer",
                                "target_lang_sense_clarification": "prendre peur"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "schrikken",
                                "target_lang_sense_clarification": "plotseling bang worden"
                            },
                            {
                                "target_lang_word": "bang worden",
                                "target_lang_sense_clarification": "angst beginnen te voelen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78d3ae6f-6c24-336c-a7ae-825314198afc",
                    "sense_definition": "A sudden feeling of fear, shock, or alarm, usually not lasting long.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fright_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You gave me a big <w>scare</w> when you jumped out from behind the door.",
                            "target_lang_translations": {
                                "ru": "Ты меня сильно <w>напугал</w>, когда выпрыгнул из-за двери.",
                                "de": "Du hast mir einen großen <w>Schreck</w> eingejagt, als du hinter der Tür hervorgesprungen bist.",
                                "fr": "Tu m'as fait une grande <w>frayeur</w> quand tu as surgi de derrière la porte.",
                                "nl": "Je bezorgde me een grote <w>schrik</w> toen je achter de deur vandaan sprong."
                            }
                        },
                        {
                            "text": "The medical results were just a <w>scare</w> and everything is fine now.",
                            "target_lang_translations": {
                                "ru": "Результаты анализов оказались лишь ложной <w>тревогой</w>, и теперь всё в порядке.",
                                "de": "Die medizinischen Ergebnisse waren nur ein <w>Schrecken</w> und jetzt ist alles gut.",
                                "fr": "Les résultats médicaux n'étaient qu'une fausse <w>alerte</w> et tout va bien maintenant.",
                                "nl": "De medische uitslagen waren slechts valse <w>schrik</w> en alles is nu goed."
                            }
                        }
                    ],
                    "synonyms": [
                        "fright",
                        "shock",
                        "alarm"
                    ],
                    "common_phrases": [
                        "give a scare",
                        "get a scare",
                        "bit of a scare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное чувство страха, испуг или тревога, обычно кратковременные.",
                        "de": "Ein plötzliches Gefühl von Angst, Schock oder Schrecken, das meist nicht lange anhält.",
                        "fr": "Sensation soudaine de peur, de choc ou d'alarme, généralement de courte durée.",
                        "nl": "Een plotseling gevoel van angst, schrik of ontzetting, meestal van korte duur."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испуг",
                                "target_lang_sense_clarification": "внезапное чувство страха"
                            },
                            {
                                "target_lang_word": "страх",
                                "target_lang_sense_clarification": "чувство боязни"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schreck",
                                "target_lang_sense_clarification": "heftige Emotion durch etwas Unerwartetes oder Bedrohliches"
                            },
                            {
                                "target_lang_word": "Schrecken",
                                "target_lang_sense_clarification": "plötzliches starkes Gefühl der Angst"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "frousse",
                                "target_lang_sense_clarification": "peur soudaine et passagère (familier)"
                            },
                            {
                                "target_lang_word": "peur",
                                "target_lang_sense_clarification": "sentiment de crainte ou de frayeur"
                            },
                            {
                                "target_lang_word": "frayeur",
                                "target_lang_sense_clarification": "vive alarme soudaine"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "schrik",
                                "target_lang_sense_clarification": "plotselinge angst reactie"
                            },
                            {
                                "target_lang_word": "schrikmoment",
                                "target_lang_sense_clarification": "een korte gebeurtenis die schrik veroorzaakt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04152328-d71f-34a5-b835-ef01187eeca4",
                    "sense_definition": "A period of general alarm or panic caused by a specific perceived danger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "public_alarm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The airport went through a security <w>scare</w> yesterday afternoon.",
                            "target_lang_translations": {
                                "ru": "Вчера днем в аэропорту был <w>переполох</w> из-за угрозы безопасности.",
                                "de": "Der Flughafen erlebte gestern Nachmittag einen Sicherheits<w>alarm</w>.",
                                "fr": "L'aéroport a connu une <w>alerte</w> de sécurité hier après-midi.",
                                "nl": "Het vliegveld maakte gistermiddag een veiligheids<w>opschudding</w> mee."
                            }
                        },
                        {
                            "text": "There was a major health <w>scare</w> regarding the contaminated water.",
                            "target_lang_translations": {
                                "ru": "Возникла серьезная <w>паника</w> по поводу здоровья из-за загрязненной воды.",
                                "de": "Es gab eine große Gesundheits<w>panik</w> wegen des kontaminierten Wassers.",
                                "fr": "Il y a eu une grande <w>panique</w> sanitaire concernant l'eau contaminée.",
                                "nl": "Er was grote <w>paniek</w> rondom de volksgezondheid vanwege het vervuilde water."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bomb scare",
                        "health scare",
                        "security scare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период общей тревоги или паники, вызванный предполагаемой опасностью.",
                        "de": "Eine Phase allgemeiner Unruhe oder Panik, die durch eine bestimmte angebliche Gefahr verursacht wird.",
                        "fr": "Période d'alarme générale ou de panique causée par un danger perçu spécifique.",
                        "nl": "Een periode van algemene opschudding of paniek veroorzaakt door een specifiek vermoed gevaar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паника",
                                "target_lang_sense_clarification": "всеобщий страх и смятение"
                            },
                            {
                                "target_lang_word": "переполох",
                                "target_lang_sense_clarification": "суматоха, вызванная тревогой"
                            },
                            {
                                "target_lang_word": "тревога",
                                "target_lang_sense_clarification": "беспокойство из-за опасности"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schrecken",
                                "target_lang_sense_clarification": "allgemeine Beunruhigung oder Panik"
                            },
                            {
                                "target_lang_word": "Panik",
                                "target_lang_sense_clarification": "plötzliche allgemeine Angstwelle"
                            },
                            {
                                "target_lang_word": "Alarm",
                                "target_lang_sense_clarification": "Zustand der Verunsicherung oder Gefahr"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "alerte",
                                "target_lang_sense_clarification": "mouvement de panique ou d'inquiétude collective"
                            },
                            {
                                "target_lang_word": "panique",
                                "target_lang_sense_clarification": "mouvement de peur incontrôlé"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "paniek",
                                "target_lang_sense_clarification": "algemene opschudding of angst"
                            },
                            {
                                "target_lang_word": "opschudding",
                                "target_lang_sense_clarification": "beroering door een vermeende dreiging"
                            },
                            {
                                "target_lang_word": "angst",
                                "target_lang_sense_clarification": "wijdverbreide vrees"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51cda877-b0fd-34df-a82a-e20f5fb2cafe",
                    "sense_definition": "An object or device used to frighten birds or animals away.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer set up a <w>scare</w> in the middle of the cornfield.",
                            "target_lang_translations": {
                                "ru": "Фермер поставил <w>пугало</w> посреди кукурузного поля.",
                                "de": "Der Bauer stellte eine <w>Vogelscheuche</w> mitten im Maisfeld auf.",
                                "fr": "Le fermier a installé un <w>épouvantail</w> au milieu du champ de maïs.",
                                "nl": "De boer zette een <w>vogelverschrikker</w> neer in het midden van het maïsveld."
                            }
                        },
                        {
                            "text": "Birds eventually ignored the old <w>scare</w> and ate the seeds.",
                            "target_lang_translations": {
                                "ru": "Птицы в конце концов перестали обращать внимание на старое <w>пугало</w> и склевали семена.",
                                "de": "Die Vögel ignorierten schließlich die alte <w>Vogelscheuche</w> und fraßen die Samen.",
                                "fr": "Les oiseaux ont fini par ignorer le vieil <w>épouvantail</w> et ont mangé les graines.",
                                "nl": "Vogels negeerden uiteindelijk de oude <w>vogelverschrikker</w> en at de zaden op."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или устройство, используемое для отпугивания птиц или животных.",
                        "de": "Ein Gegenstand oder Gerät, das verwendet wird, um Vögel oder Tiere zu verscheuchen.",
                        "fr": "Objet ou dispositif utilisé pour effrayer et éloigner les oiseaux ou les animaux.",
                        "nl": "Een voorwerp of hulpmiddel om vogels of dieren te verjagen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пугало",
                                "target_lang_sense_clarification": "чучело для отпугивания птиц"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Vogelscheuche",
                                "target_lang_sense_clarification": "Figur oder Gerät zum Verscheuchen von Vögeln"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "épouvantail",
                                "target_lang_sense_clarification": "mannequin ou dispositif servant à effrayer les oiseaux"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "vogelverschrikker",
                                "target_lang_sense_clarification": "pop of voorwerp om vogels af te schrikken"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ded6356b-f334-3d1a-bad1-8031fa5da9f2",
