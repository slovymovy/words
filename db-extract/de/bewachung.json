                "senses": [
                    {
                        "sense_id": "cb5df153-fa1a-3355-b3a2-69f32592a195",
                        "entry_id": "c7decca2-4e14-3b8d-9d18-5d7c47ec7a1f",
                        "glosses": [
                            "Handlung, jemand oder etwas unter Beaufsichtigung/Beobachtung zu halten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3a6795f-2862-402c-a700-ed5b817cbd6a",
                                "sense_id": "cb5df153-fa1a-3355-b3a2-69f32592a195",
                                "text": "„Als Haftort wurde der riesige Komplex des Spandauer Gefängnisses eingerichtet, wo sich die Siegermächte im monatlichen Wechsel bei der Bewachung ablösten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "169dc311-ba8d-3713-94a2-beb9370b2767",
                        "entry_id": "c7decca2-4e14-3b8d-9d18-5d7c47ec7a1f",
                        "glosses": [
                            "Person/Gruppe, die [1] durchführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e42d5594-d3dd-4001-9a6b-2984d4ed6257",
                                "sense_id": "169dc311-ba8d-3713-94a2-beb9370b2767",
                                "text": "„Unten hören sie mit harten Schritten die Patrouille auf und ab marschieren, aber diese Bewachung schreckt sie nicht, denn sie wissen, unter dieser Sansculottenuniform schlagen befreundete Herzen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
