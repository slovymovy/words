                "senses": [
                    {
                        "sense_id": "8098539b-f3a6-3b68-853b-59be42c97121",
                        "entry_id": "2c4f6c03-6348-37e0-945b-34409ee8f5ff",
                        "glosses": [
                            "To exceed in weight or mass."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7ff5d03d-ca6d-46cb-9b81-a2318cc54ab5",
                                "sense_id": "8098539b-f3a6-3b68-853b-59be42c97121",
                                "text": "The King your brother is now hard at hand,\nMeete with the foole, and rid your royall ſhoulders\nOf ſuch a burden, as outweighs the ſands\nAnd all the craggie rockes of Caſpea."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca861e9e-cec4-301d-9687-6fa454fa51eb",
                        "entry_id": "2c4f6c03-6348-37e0-945b-34409ee8f5ff",
                        "glosses": [
                            "To exceed in importance or value."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fc1bd3dd-55cf-41d0-9e9f-8eb75c85e5ba",
                                "sense_id": "ca861e9e-cec4-301d-9687-6fa454fa51eb",
                                "text": "The advantage […] was so great that it would have taken a lot of failures to outweigh it."
                            },
                            {
                                "example_id": "7532a0a1-8023-4ffd-83c9-4a5c70183b22",
                                "sense_id": "ca861e9e-cec4-301d-9687-6fa454fa51eb",
                                "text": "The trials have revealed that the advantage of extra seating capacity is more than outweighed by slower station working, as the double-deck train affords one door for 22 seats, compared with 10 or 12 in ordinary compartment stock."
                            },
                            {
                                "example_id": "89981e29-b06f-416c-90af-e0c7d07643e5",
                                "sense_id": "ca861e9e-cec4-301d-9687-6fa454fa51eb",
                                "text": "A few trains, mostly at peak periods, will still terminate at Barnsley because the convenience to workpeople of their current times outweighs the advantages of through working."
                            },
                            {
                                "example_id": "697a782b-1f49-4bc1-a472-956bf30b1002",
                                "sense_id": "ca861e9e-cec4-301d-9687-6fa454fa51eb",
                                "text": "Flores said the images’ negative impact outweighs their historical and artistic value."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80eb2727-4888-4ecb-9bc6-ccdf36f1b3ee",
                        "source_entry_id": "2c4f6c03-6348-37e0-945b-34409ee8f5ff",
                        "source_sense_description": "to exceed in weight or mass",
                        "target_lang_word": "überwiegen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überwiegen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a8c051a-4604-3174-b083-7420182793cc",
                                        "entry_id": "191e351d-681f-3465-b8b4-3458979937d6",
                                        "glosses": [
                                            "die Mehrheit haben, sich deshalb durchsetzen und die Oberhand gewinnen"
                                        ],
                                        "tags": [
                                            "eher quantitativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cdce067-92f9-42c3-aa37-ff76ea47b47f",
                                                "sense_id": "2a8c051a-4604-3174-b083-7420182793cc",
                                                "text": "\"Bereits im fünften Jahr hintereinander überwiegen die negativen Urteile\", heißt es."
                                            },
                                            {
                                                "example_id": "27984451-106d-4937-9cdb-f89e1348a0e5",
                                                "sense_id": "2a8c051a-4604-3174-b083-7420182793cc",
                                                "text": "Anfangs ist es sonnig, später überwiegen zeitweise Wolken."
                                            },
                                            {
                                                "example_id": "ad89002e-bce1-4fbd-a101-4643f61bc6ec",
                                                "sense_id": "2a8c051a-4604-3174-b083-7420182793cc",
                                                "text": "„Es handelt sich hierbei um Einzeller (Protozoen) wie die Foraminiferen (mit Kalkschale) und die Radiolarien (Skelett aus Kieselsäure), um Coelenteraten wie Medusen und Quallen, um Rädertierchen, Würmer aus der Gruppe der Anneliden und der Chaetognathen sowie zahlreiche Krustentiere, unter den die Copepoden überwiegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b7cf6524-e957-3586-87a6-0af62e949665",
                                        "entry_id": "191e351d-681f-3465-b8b4-3458979937d6",
                                        "glosses": [
                                            "das größere Gewicht oder die größere Stärke/Kraft haben und deshalb obsiegen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d97c32ac-db11-4d13-85e4-30b25a0d70c3",
                                                "sense_id": "b7cf6524-e957-3586-87a6-0af62e949665",
                                                "text": "Ein Erlass des Auswärtigen Amtes zur Visum-Vergabepraxis lege stattdessen fest, dass zur Ablehnung eines Visums die Zweifel an der Rückkehrbereitschaft überwiegen müssten."
                                            },
                                            {
                                                "example_id": "ade3ba13-5721-4934-a474-09bfe466b925",
                                                "sense_id": "b7cf6524-e957-3586-87a6-0af62e949665",
                                                "text": "Letztlich überwog ihre Neugier und sie öffnete den Brief."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "überwiegen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f275de3-8336-31b7-85c0-5994cfe9b3cd",
                                        "entry_id": "0e274281-c305-3841-951a-bc496b0edc39",
                                        "glosses": [
                                            "über das normale Maß wiegen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0b125ad-b043-4d0f-a5e6-4ce97ebcbeb9",
                                                "sense_id": "3f275de3-8336-31b7-85c0-5994cfe9b3cd",
                                                "text": "Nach den Weihnachtsfeiertagen wiegt manch einer über."
                                            },
                                            {
                                                "example_id": "ee87af5f-a7ff-4ada-8bb4-400a380adfa3",
                                                "sense_id": "3f275de3-8336-31b7-85c0-5994cfe9b3cd",
                                                "text": "Die Briefe können auch nicht übergewogen haben."
                                            },
                                            {
                                                "example_id": "7b2300af-a89d-4ee4-ac18-f822ae5781bd",
                                                "sense_id": "3f275de3-8336-31b7-85c0-5994cfe9b3cd",
                                                "text": "Im Moment erscheint mir mein soziales Umfeld wie auf der Kippe, die nur darauf wartet zur einen Seite überzuwiegen und in diese Richtung zu fallen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00113b92-05a2-45d7-83c1-fc849ceddfb6",
                        "source_entry_id": "2c4f6c03-6348-37e0-945b-34409ee8f5ff",
