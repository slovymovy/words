                "senses": [
                    {
                        "sense_id": "f91b61a9-ab7f-3bf9-afee-35be500a80f9",
                        "entry_id": "91baf5d0-60a7-309d-a993-9c8c826d46d1",
                        "glosses": [
                            "Schlamm enthaltende Pfütze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43da8b36-844c-4a0d-9a81-ba5beb0d3656",
                                "sense_id": "f91b61a9-ab7f-3bf9-afee-35be500a80f9",
                                "text": "„Am schlimmsten von allem war der Fußabdruck - die Aufnahme zeigte eine sonnenbeschienene Schlammpfütze irgendwo im verlassenen Hochland.“"
                            },
                            {
                                "example_id": "e1f91fc4-ccef-477b-a79a-81b35960d7f4",
                                "sense_id": "f91b61a9-ab7f-3bf9-afee-35be500a80f9",
                                "text": "„Als Harrogate über bläuliche Schlammpfützen durch einen Stollen schritt, stieß der Strahl seiner Taschenlampe auf Spuren von Menschenwerk.“"
                            },
                            {
                                "example_id": "b04eba9c-cfdc-4047-9881-ac924a58eaff",
                                "sense_id": "f91b61a9-ab7f-3bf9-afee-35be500a80f9",
                                "text": "„Eine Orgie aus Rotlicht, Taschenlampen und Autoscheinwerfern blitzte über dem Areal auf und hob die Einzelheiten hervor: Schlammpfützen, die das Mondlicht und die Schatten reflektierten, den Neondunst Hollywoods in der Ferne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
