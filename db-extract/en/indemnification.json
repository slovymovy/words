                "translations": [
                    {
                        "translation_id": "7e61a2df-1672-45c0-98aa-4ddbf640cadb",
                        "source_entry_id": "577af8b7-582b-3138-b53f-76e11f34302f",
                        "source_sense_description": "act or process of indemnifying",
                        "target_lang_word": "dédommagement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dédommagement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcda24ac-6abb-312b-bf27-2394ff39d3bd",
                                        "entry_id": "f8c7b3cf-d933-3ef6-82eb-f875ae32d64f",
                                        "glosses": [
                                            "Réparation d’un dommage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "804d890b-1136-44f9-aa45-3806443215b9",
                                                "sense_id": "bcda24ac-6abb-312b-bf27-2394ff39d3bd",
                                                "text": "Dix mille francs de dédommagement."
                                            },
                                            {
                                                "example_id": "bd3d6f3d-65d1-4f2d-a429-8e985c10ae71",
                                                "sense_id": "bcda24ac-6abb-312b-bf27-2394ff39d3bd",
                                                "text": "Obtenir, recevoir un bon dédommagement."
                                            },
                                            {
                                                "example_id": "53c39e8f-f263-4bb0-8c14-d600c7c99d3b",
                                                "sense_id": "bcda24ac-6abb-312b-bf27-2394ff39d3bd",
                                                "text": "Elle doit donc obtenir un dédommagement d’une part et être prise en charge pour la réparation du dommage d’autre part."
                                            },
                                            {
                                                "example_id": "6375fc0e-fb23-4cf8-94ad-4655d023d379",
                                                "sense_id": "bcda24ac-6abb-312b-bf27-2394ff39d3bd",
                                                "text": "Acte de justice –\nSuite au délit de violence\npsychologique et émotionnelle\nen parole,\nvous allez verser\nun dédommagement\nà votre\n…\nassistant personnel virtuel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64d07075-330b-3e5d-8e4b-986e5f02c0c6",
                                        "entry_id": "f8c7b3cf-d933-3ef6-82eb-f875ae32d64f",
                                        "glosses": [
                                            "Compensation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a34a286-697a-4453-b3a8-17ef46b02c77",
                                                "sense_id": "64d07075-330b-3e5d-8e4b-986e5f02c0c6",
                                                "text": "Il trouve dans votre amitié un dédommagement à ses malheurs."
                                            },
                                            {
                                                "example_id": "5688db71-f672-4ff1-ab3e-3914dd537ef1",
                                                "sense_id": "64d07075-330b-3e5d-8e4b-986e5f02c0c6",
                                                "text": "La vue magnifique que l’on découvre du haut de la flèche est un large dédommagement de la fatigue de l’ascension."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6d74129-8f0f-4a9d-863c-2eb0c52c2a52",
                        "source_entry_id": "577af8b7-582b-3138-b53f-76e11f34302f",
                        "source_sense_description": "act or process of indemnifying",
                        "target_lang_word": "Entschädigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entschädigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "178eed51-1cad-33aa-9bd2-2967893f4d4b",
                                        "entry_id": "a2d69c37-395e-35b7-a947-3ff8fe355d6d",
                                        "glosses": [
                                            "Leistung als Ausgleich für einen zugefügten Schaden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1233f24c-fb50-463e-aa7b-84ac9e2190bc",
                                                "sense_id": "178eed51-1cad-33aa-9bd2-2967893f4d4b",
                                                "text": "Dafür muss Entschädigung geleistet werden."
                                            },
                                            {
                                                "example_id": "ac3e3802-08f7-4ea7-85fe-031e4ad359b6",
                                                "sense_id": "178eed51-1cad-33aa-9bd2-2967893f4d4b",
                                                "text": "„Doch das Land Hessen lehnt bislang jede Entschädigung ab.“"
                                            },
                                            {
                                                "example_id": "597d2803-329e-4cbe-ad02-3bbe4c7d28e1",
                                                "sense_id": "178eed51-1cad-33aa-9bd2-2967893f4d4b",
                                                "text": "„Das Wort ‚Entschädigung‘ wurde dabei möglichst vermieden. Stattdessen ist von einer ‚materiellen Anerkennung erlittenen Leids‘ die Rede.“"
                                            },
                                            {
                                                "example_id": "65f79540-7a07-4884-8615-1427328a2fbe",
                                                "sense_id": "178eed51-1cad-33aa-9bd2-2967893f4d4b",
                                                "text": "„Die Deutsche Bahn musste aufgrund von Zugausfällen und Verspätungen im Jahr 2022 die Rekordsumme von 92,7 Millionen Euro an Entschädigungen an ihre Kunden zahlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fd25f0dc-ce5e-3554-a323-59923c396c6b",
                                        "entry_id": "a2d69c37-395e-35b7-a947-3ff8fe355d6d",
                                        "glosses": [
                                            "Vergütung einer Dienstleistung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3700fe6-d5ff-440c-a129-32096b57e5fe",
                                                "sense_id": "fd25f0dc-ce5e-3554-a323-59923c396c6b",
                                                "text": "Für den Vortrag erhielt der Redner eine geringe Entschädigung."
                                            },
                                            {
                                                "example_id": "816e9234-c2eb-4bf2-9f4c-a8ba3a6f36f6",
                                                "sense_id": "fd25f0dc-ce5e-3554-a323-59923c396c6b",
                                                "text": "Der deutsche Chemiekonzern IG Farben zahlte ihm [Anmerkung: dem jüdischen Chemiker und Schriftsteller Primo Levi] eine Entschädigung für die im KZ geleistete Zwangsarbeit - in Höhe von rund 63 Euro."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f233626-0722-48b6-9b56-8fbc9da1989b",
                        "source_entry_id": "577af8b7-582b-3138-b53f-76e11f34302f",
                        "source_sense_description": "act or process of indemnifying",
                        "target_lang_word": "güvence verme",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3272b19f-d975-44b7-8e4f-bc29c750a7b3",
                        "source_entry_id": "577af8b7-582b-3138-b53f-76e11f34302f",
                        "source_sense_description": "reimbursement",
                        "target_lang_word": "Schadenersatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schadenersatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40b08594-86f2-39f0-8bfb-2ded3196ab84",
                                        "entry_id": "8b3ea802-6ad8-36a2-9b1f-eda527273afe",
                                        "glosses": [
                                            "Ausgleich/Kompensation für einen entstandenen Schaden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abb3fc0b-f92b-46bc-8385-1517e7b4f78f",
                                                "sense_id": "40b08594-86f2-39f0-8bfb-2ded3196ab84",
                                                "text": "Sie konnten keinen Schadenersatz erreichen, der die Verluste auch nur annähernd ausgeglichen hätte."
                                            },
                                            {
                                                "example_id": "56273763-553d-43ea-af7d-01fa75de6551",
                                                "sense_id": "40b08594-86f2-39f0-8bfb-2ded3196ab84",
                                                "text": "„Dem nach dieser Bestimmung anzuwendenden Grundsatz des billigen richterlichen Ermessens und Ausgleichsgedankens entspreche eine gleichteilige Verpflichtung zum Schadenersatz.“"
                                            },
                                            {
                                                "example_id": "05b24d7c-e595-4e72-92b9-9397fc32a5e2",
                                                "sense_id": "40b08594-86f2-39f0-8bfb-2ded3196ab84",
                                                "text": "„Während des dortigen Sezessionskriegs (1861-1865) war [Anton Schütte] Quartiermeister einer Division der Nordstaaten, wurde jedoch 1862 wegen Unterschlagungen abgesetzt und zu Schadenersatz verurteilt.“"
                                            },
                                            {
                                                "example_id": "a548875c-6e31-4e5a-be80-e9c01c18d064",
                                                "sense_id": "40b08594-86f2-39f0-8bfb-2ded3196ab84",
                                                "text": "„Die Versicherung gewährt ihm aber allenfalls Schadenersatz.“"
                                            },
                                            {
                                                "example_id": "643c76dc-d456-4931-b2b7-77c8f4f0b131",
                                                "sense_id": "40b08594-86f2-39f0-8bfb-2ded3196ab84",
                                                "text": "„Davon abgesehen, kann der Endverbraucher unter Umständen Schadenersatz geltend machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
