                        "entry_id": "fce20898-f7af-31fc-b8db-08f71692ad6d",
                        "glosses": [
                            "перен. об ограниченном, узком круге людей, небольшом коллективе в сравнении с окружающим миром"
                        ],
                        "tags": [],
