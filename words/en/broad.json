        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6340dbc4-b158-35ca-b03f-279922ffae91",
                    "sense_definition": "A common English surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The famous cricketer Stuart <w>Broad</w> has taken many wickets for England.",
                            "target_lang_translations": {
                                "ru": "Знаменитый крикетист Стюарт <w>Броуд</w> взял много калиток за сборную Англии.",
                                "tr": "Ünlü kriketçi Stuart <w>Broad</w>, İngiltere adına birçok kale aldı."
                            }
                        },
                        {
                            "text": "We are meeting with Mr. <w>Broad</w> to discuss the new contract.",
                            "target_lang_translations": {
                                "ru": "Мы встречаемся с мистером <w>Броудом</w>, чтобы обсудить новый контракт.",
                                "tr": "Yeni sözleşmeyi görüşmek üzere Bay <w>Broad</w> ile buluşuyoruz."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная английская фамилия.",
                        "tr": "Yaygın bir İngilizce soyadı."
