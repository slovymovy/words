                "senses": [
                    {
                        "sense_id": "75dd44f8-75f3-359a-927e-dc530dde7b88",
                        "entry_id": "ee682688-11fd-3d20-ab49-7ee5bcbc2739",
                        "glosses": [
                            "Bordé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18136d24-f06c-4a73-ab20-81a2d7419971",
                                "sense_id": "75dd44f8-75f3-359a-927e-dc530dde7b88",
                                "text": "Au fond, une rampe côtoyée de garde-fous en pierre ornés de boules surmontées de pointes menait à un jardin situé en contre-bas de la cour."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc4eb225-27d4-380b-8716-2b5b86779fb8",
                        "entry_id": "ee682688-11fd-3d20-ab49-7ee5bcbc2739",
                        "glosses": [
                            "Se dit de pièces en longueur, comme le pal, la barre et la bande, quand elles sont accompagnées de menues pièces en nombre. L’axe des pièces secondaires est aligné avec celui de la pièce principale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f24ff13-c3c1-4d4f-b6ee-7fda4ff13e8b",
                                "sense_id": "dc4eb225-27d4-380b-8716-2b5b86779fb8",
                                "text": "Côtoyé : Se dit de la bande et de la barre, ou d’une pièce longue posée diagonalement, lorsqu’elle est accompagnée des deux côtés de figures rangées dans la même direction que ces pièces."
                            },
                            {
                                "example_id": "3bab5e21-b42c-4618-9a1d-83455b35c699",
                                "sense_id": "dc4eb225-27d4-380b-8716-2b5b86779fb8",
                                "text": "Scharpfenstein — Prov. rhén. [Province rhénane] D’arg. à la fasce de sin., le bord supérieur côtoyé d’une cotice du même."
                            }
                        ]
                    }
                ],
