                    "sense_definition": "wat de aandacht trekt en wat iedereen dus direct ziet",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "opvallend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij droeg een <w>opvallende</w> rode jas zodat iedereen haar in de menigte kon vinden.",
                            "target_lang_translations": {
                                "en": "She wore a <w>striking</w> red coat so that everyone could find her in the crowd.",
                                "ru": "На ней было <w>заметное</w> красное пальто, чтобы каждый мог найти её в толпе."
                            }
                        },
                        {
                            "text": "Het is <w>opvallend</w> stil in de stad omdat alle winkels vandaag gesloten zijn.",
                            "target_lang_translations": {
                                "en": "It is <w>remarkably</w> quiet in the city because all the shops are closed today.",
                                "ru": "В городе <w>необычайно</w> тихо, потому что все магазины сегодня закрыты."
                            }
                        }
                    ],
