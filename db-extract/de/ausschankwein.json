                "senses": [
                    {
                        "sense_id": "ebbe2bc8-aa1f-3cd4-996d-800382337e10",
                        "entry_id": "b58e84cb-0b4a-31c5-9f48-32af67076072",
                        "glosses": [
                            "Wein, der im Ausschank von gastronomischen Betrieben angeboten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32ae51b6-31c6-48b3-90fb-02558f255bc3",
                                "sense_id": "ebbe2bc8-aa1f-3cd4-996d-800382337e10",
                                "text": "„Die ausgesuchten Tropfen stammen von der Nahe, der Ausschankwein vom Weingut Funk-Schowalter, die Flaschenweine von den Weingütern Kauer, Korrell, Jaeckel und vom Buchenländer Hof.“"
                            },
                            {
                                "example_id": "c38b83e5-9f81-4d28-8d06-57170eb7a3a0",
                                "sense_id": "ebbe2bc8-aa1f-3cd4-996d-800382337e10",
                                "text": "„Alle Einnahmen aus dem Verkauf der Ausschankweine des Weinguts, Bratwürste und Pizzen gehen direkt an die Bedürftigen in der Ukraine.“"
                            },
                            {
                                "example_id": "6e3bafee-914f-42f8-bb98-ae3e1afa9fb3",
                                "sense_id": "ebbe2bc8-aa1f-3cd4-996d-800382337e10",
                                "text": "„Wie im Bildband \"Köln vor dem Krieg\" zu lesen ist, fand 1926 nach drei schlechten Erntejahren erstmals wieder eine Messe mit Ausschankweinen aus den Anbaugebieten Mosel, Saar und Ruwer im Kölner Gürzenich statt.“"
                            },
                            {
                                "example_id": "3aeb865d-4b38-41ab-90b3-4a84bffaecbf",
                                "sense_id": "ebbe2bc8-aa1f-3cd4-996d-800382337e10",
                                "text": "„Bevor die besten Schoppenwirte ihre Preise entgegennehmen konnten, wurden im Juni und Juli 1410 Weine von 269 Weinerzeugern im großen Test der offenen Ausschankweine von Mosel, Saar und Ruwer bewertet.“"
                            },
                            {
                                "example_id": "dc45e989-6b15-48f3-8a8c-4dfa8261e61b",
                                "sense_id": "ebbe2bc8-aa1f-3cd4-996d-800382337e10",
                                "text": "„Der offene Ausschankwein erfüllt am Mittelrhein eine wichtige Aufgabe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
