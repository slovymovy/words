                    "sense_definition": "De basis-eenheid van tijd, gelijk aan een zestigste deel van een minuut.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een minuut bestaat uit zestig <w>seconden</w>.",
                            "target_lang_translations": {
                                "ru": "Минута состоит из шестидесяти <w>секунд</w>.",
                                "en": "A minute consists of sixty <w>seconds</w>.",
                                "pl": "Minuta składa się z sześćdziesięciu <w>sekund</w>.",
                                "de": "Eine Minute besteht aus sechzig <w>Sekunden</w>.",
                                "fr": "Une minute se compose de soixante <w>secondes</w>.",
                                "it": "Un minuto è composto da sessanta <w>secondi</w>.",
                                "cs": "Minuta se skládá ze šedesáti <w>sekund</w>.",
                                "tr": "Bir dakika altmış <w>saniyeden</w> oluşur.",
                                "es": "Un minuto consta de sesenta <w>segundos</w>."
                            }
                        },
                        {
                            "text": "De atleet rende de honderd meter in minder dan tien <w>seconden</w>.",
                            "target_lang_translations": {
                                "ru": "Атлет пробежал сто метров менее чем за десять <w>секунд</w>.",
                                "en": "The athlete ran the hundred meters in less than ten <w>seconds</w>.",
                                "pl": "Lekkoatleta przebiegł sto metrów w mniej niż dziesięć <w>sekund</w>.",
                                "de": "Der Athlet lief die hundert Meter in weniger als zehn <w>Sekunden</w>.",
                                "fr": "L'athlète a couru le cent mètres en moins de dix <w>secondes</w>.",
                                "it": "L'atleta ha corso i cento metri in meno di dieci <w>secondi</w>.",
                                "cs": "Atlet zaběhl sto metrů za méně než deset <w>sekund</w>.",
                                "tr": "Atlet yüz metreyi on <w>saniyeden</w> kısa sürede koştu.",
                                "es": "El atleta corrió los cien metros en menos de diez <w>segundos</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aantal seconden",
                        "per seconde",
                        "halve seconde"
                    ],
                    "target_lang_definitions": {
                        "ru": "Базовая единица времени, равная одной шестидесятой части минуты.",
                        "en": "The basic unit of time, equal to one sixtieth of a minute.",
                        "pl": "Podstawowa jednostka czasu, równa jednej sześćdziesiątej części minuty.",
                        "de": "Die Basiseinheit der Zeit, die einem Sechzigstel einer Minute entspricht.",
                        "fr": "L'unité de base du temps, égale à la soixantième partie d'une minute.",
                        "it": "L'unità di misura di base del tempo, pari alla sessantesima parte di un minuto.",
                        "cs": "Základní jednotka času, která se rovná jedné šedesátině minuty.",
                        "tr": "Bir dakikanın altmışta birine eşit olan temel zaman birimi.",
                        "es": "La unidad básica de tiempo, equivalente a la sexagésima parte de un minuto."
                    },
