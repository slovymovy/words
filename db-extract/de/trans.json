                                        "sense_id": "365301e2-27ba-31a5-9653-7cbb40d0c1f4",
                                        "entry_id": "2abc3bc2-c22f-3105-b130-7d38e3af62a5",
                                        "glosses": [
                                            "To cause to cross from one side to another of (gender, sex or similar)."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "transitive"
                                        ],
