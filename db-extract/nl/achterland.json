                "senses": [
                    {
                        "sense_id": "0bea7692-a024-39eb-ae65-104bf4f00a0a",
                        "entry_id": "24c70da4-2767-3749-98bf-01c42bd8398f",
                        "glosses": [
                            "streek die geografisch verder weg ligt, maar economisch verbonden is met een voorliggende streek of stad, meestal aangeduid gezien vanaf zee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1901ae7-cbb6-4c60-96a4-f20a798eab6d",
                                "sense_id": "0bea7692-a024-39eb-ae65-104bf4f00a0a",
                                "text": "De goederen die in de haven kwamen werden vervolgens het achterland in vervoerd."
                            },
                            {
                                "example_id": "6f0aff8b-5451-4ffe-ad70-c9a89019ed63",
                                "sense_id": "0bea7692-a024-39eb-ae65-104bf4f00a0a",
                                "text": "De Rode Zee en het dorre achterland waren prachtig als je er een paar weken verbleef."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe886d7b-b6cb-3e96-bf0d-edc7bbf87d2f",
                        "entry_id": "24c70da4-2767-3749-98bf-01c42bd8398f",
                        "glosses": [
                            "achteraf gelegen gebied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0277d99e-740a-4ff9-858e-284ce26bb654",
                                "sense_id": "fe886d7b-b6cb-3e96-bf0d-edc7bbf87d2f",
                                "text": "Het achterland lag verder van de dijk en was drassiger."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bdd1c52-6cd6-31ab-8e05-b196acaaa97c",
                        "entry_id": "24c70da4-2767-3749-98bf-01c42bd8398f",
                        "glosses": [
                            "volkenrechtelijk nog onbezet gebied dat is gelegen achter een invloedssfeer die meer aan de kust ligt"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7592a2c5-27e9-3535-a154-7e3d9f8f8447",
                        "entry_id": "24c70da4-2767-3749-98bf-01c42bd8398f",
                        "glosses": [
                            "gebied vanwaaruit legereenheden worden bevoorraad en versterkt"
                        ],
                        "tags": [],
