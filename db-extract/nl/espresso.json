                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd94c863-6e44-344e-b2fc-c6839b156e06",
                                        "entry_id": "d62c3742-cc5f-392a-8ba5-2d8ce82f6c81",
                                        "glosses": [
                                            "A concentrated coffee beverage brewed by forcing hot water under high pressure through finely ground coffee."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2a99a37-00f1-480e-b522-aa8f226b6cd1",
                                                "sense_id": "bd94c863-6e44-344e-b2fc-c6839b156e06",
                                                "text": "It is no surprise that over the last decade the more moneyed elements of the coffee industry have been trying to figure out how to simplify espresso brewing to the point that a consumer can produce a properly rich, smooth-tasting espresso shot without struggling through a complicated process that can be as daunting as upgrading to Vista or assembling a glass-fronted display case from Ikea. […] To conclude, here in tabular form is a summary of our ratings of espressos produced from thirty pod, capsule and disc blends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c25cce45-c52c-335b-a5a6-4a3ca1617bed",
                                        "entry_id": "d62c3742-cc5f-392a-8ba5-2d8ce82f6c81",
                                        "glosses": [
                                            "A drink that includes espresso as an ingredient."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69f41ab3-e279-4e56-8229-e3f2d98727d3",
                        "source_entry_id": "da57c6bc-f51c-3ee2-858d-f26b152d24e2",
                        "source_sense_id": "bd125196-23f9-3a28-b828-e9af45aecde2",
