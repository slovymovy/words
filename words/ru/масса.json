{
    "word_family": [
        "массовый",
        "массив",
        "массивный",
        "биомасса"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "86b14414-d84c-3ee1-b247-4a0e32a7afdc",
                    "sense_definition": "Большое количество, множество кого-либо или чего-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "количество",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед поездкой у нас накопилась целая <w>масса</w> неотложных дел и вопросов.",
                            "target_lang_translations": {
                                "fr": "Avant le voyage, nous avions accumulé une véritable <w>foule</w> d'affaires et de questions urgentes."
                            }
                        },
                        {
                            "text": "У этого нового проекта есть целая <w>масса</w> очевидных преимуществ перед старым.",
                            "target_lang_translations": {
                                "fr": "Ce nouveau projet présente un <w>tas</w> d'avantages évidents par rapport à l'ancien."
                            }
                        }
                    ],
                    "synonyms": [
                        "мно́жество",
                        "ку́ча",
                        "у́йма"
                    ],
                    "common_phrases": [
                        "целая масса",
                        "масса свободного времени",
                        "масса впечатлений"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление для обозначения множества"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Grande quantité, multitude de choses ou de personnes."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "foule",
                                "target_lang_sense_clarification": "grande quantité (foule de choses)"
                            },
                            {
                                "target_lang_word": "tas",
                                "target_lang_sense_clarification": "registre familier, grand nombre"
                            },
                            {
                                "target_lang_word": "masse",
                                "target_lang_sense_clarification": "quantité importante"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a43922fc-02b9-3de1-af25-c32ffbb98fae",
                    "sense_definition": "Физическая величина, характеризующая инертные и гравитационные свойства материального тела.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "физика",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На уроке физики школьники аккуратно измеряли точную <w>массу</w> металлического бруска.",
                            "target_lang_translations": {
                                "fr": "Pendant le cours de physique, les élèves mesuraient soigneusement la <w>masse</w> exacte du bloc métallique."
                            }
                        },
                        {
                            "text": "Общая <w>масса</w> перевозимого груза не должна превышать установленные правилами нормы.",
                            "target_lang_translations": {
                                "fr": "La <w>masse</w> totale du chargement transporté ne doit pas dépasser les normes fixées par le règlement."
                            }
                        }
                    ],
                    "synonyms": [
                        "вес"
                    ],
                    "common_phrases": [
                        "масса тела",
                        "масса груза"
                    ],
                    "target_lang_definitions": {
                        "fr": "Grandeur physique caractérisant la quantité de matière et les propriétés d'inertie et de gravitation d'un corps."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "masse",
                                "target_lang_sense_clarification": "grandeur physique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6335c05c-5ea2-348e-9469-fecf5c275f81",
                    "sense_definition": "Густое, тестообразное или вязкое вещество, однородная смесь.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "вещество",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для приготовления крема взбивайте ингредиенты, пока не получится густая однородная <w>масса</w>.",
                            "target_lang_translations": {
                                "fr": "Pour préparer la crème, fouettez les ingrédients jusqu'à obtenir une <w>masse</w> épaisse et homogène."
                            }
                        },
                        {
                            "text": "На завтрак дети с удовольствием ели сладкую творожную <w>массу</w> с изюмом.",
                            "target_lang_translations": {
                                "fr": "Au petit-déjeuner, les enfants ont mangé avec plaisir une <w>pâte</w> de fromage blanc sucrée aux raisins secs."
                            }
                        }
                    ],
                    "synonyms": [
                        "паста"
                    ],
                    "common_phrases": [
                        "однородная масса",
                        "творожная масса"
                    ],
                    "target_lang_definitions": {
                        "fr": "Substance épaisse, pâteuse ou visqueuse formant un mélange homogène."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pâte",
                                "target_lang_sense_clarification": "mélange épais et malléable"
                            },
                            {
                                "target_lang_word": "masse",
                                "target_lang_sense_clarification": "substance homogène ou pâteuse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36584f59-0694-357f-b42b-3b76994503b0",
                    "sense_definition": "Широкие слои населения, народ, трудовой коллектив (преимущественно во множественном числе).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "общество",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Популярные идеи быстро распространялись среди народных <w>масс</w> через печать.",
                            "target_lang_translations": {
                                "fr": "Les idées populaires se diffusaient rapidement parmi les <w>masses</w> populaires grâce à la presse."
                            }
                        },
                        {
                            "text": "Общественные деятели стремились нести полезные знания и культуру прямо в широкие <w>массы</w>.",
                            "target_lang_translations": {
                                "fr": "Les personnalités publiques s'efforçaient de transmettre des connaissances utiles et la culture directement aux larges <w>masses</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "индивидуум"
                    ],
                    "common_phrases": [
                        "народные массы",
                        "нести в массы",
                        "широкие массы"
                    ],
                    "target_lang_definitions": {
                        "fr": "Ensemble des couches populaires, le peuple (généralement au pluriel)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "masses",
                                "target_lang_sense_clarification": "les couches populaires, le peuple"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d06dcd5d-8112-374d-91dc-3e78d1d04014",
                    "sense_definition": "В электротехнике: металлический корпус прибора или проводник, служащий общим проводом с нулевым потенциалом.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "электротехника",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Механик быстро обнаружил, что поврежденный провод случайно замкнуло прямо на металлическую <w>массу</w>.",
                            "target_lang_translations": {
                                "fr": "Le mécanicien a vite découvert que le fil endommagé faisait court-circuit directement sur la <w>masse</w> métallique."
                            }
                        },
                        {
                            "text": "Перед началом ремонта бортовой сети автомобиля обязательно отключите клемму от <w>массы</w>.",
                            "target_lang_translations": {
                                "fr": "Avant d'entamer la réparation du réseau de bord de la voiture, débranchez impérativement la borne de la <w>masse</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "заземле́ние",
                        "ко́рпус"
                    ],
                    "antonyms": [
                        "фаза"
                    ],
                    "common_phrases": [
                        "замкнуть на массу",
                        "отключить от массы"
                    ],
                    "target_lang_definitions": {
                        "fr": "En électricité : conducteur ou carcasse métallique servant de référence commune de potentiel zéro."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "masse",
                                "target_lang_sense_clarification": "partie conductrice servant de retour à zéro volt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "266cc89b-f47b-3dec-afd1-0972ed996c57",
                    "sense_definition": "Река в России.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Небольшая река <w>Масса</w> протекает по лесистой местности в центральной части региона.",
                            "target_lang_translations": {
                                "fr": "La petite rivière <w>Massa</w> s'écoule à travers une zone boisée dans la partie centrale de la région."
                            }
                        },
                        {
                            "text": "Рыбаки часто приезжали на тихие берега реки <w>Масса</w> ранним субботним утром.",
                            "target_lang_translations": {
                                "fr": "Les pêcheurs venaient souvent sur les rives tranquilles de la rivière <w>Massa</w> tôt le samedi matin."
                            }
                        }
                    ],
                    "common_phrases": [
                        "река Масса"
                    ],
                    "target_lang_definitions": {
                        "fr": "Rivière en Russie."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "Massa",
                                "target_lang_sense_clarification": "nom propre de rivière"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}