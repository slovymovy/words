                        "glosses": [
                            "The quality of being golden."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d30fa2fa-07d9-4200-bf53-ee309006cd2f",
                                "sense_id": "940a4c59-e2cd-3641-9649-2960376725d1",
                                "text": "There is uncommon breadth and mass about it, with a richness of colouring, a sort of brown and glossy goldenness, which is common in the works of the artist."
                            },
                            {
                                "example_id": "1789f2bb-7ee0-42cc-b594-df7f2cc7cba4",
                                "sense_id": "940a4c59-e2cd-3641-9649-2960376725d1",
                                "text": "The dim gray goldenness of the leaves above them seems to grow more ardent in color as they rise against the clear but not too intense blue of the sky."
                            },
                            {
                                "example_id": "399d3f8e-e916-4d8f-bbe1-6fc299ef5985",
                                "sense_id": "940a4c59-e2cd-3641-9649-2960376725d1",
                                "text": "Aslan's goldenness in this book is a different kind of goldenness from the one we find in The Voyage of the 'Dawn Treader.' There it was Solar; here it is, paradoxically, Lunar—the good upper half of the Lunar nature."
                            }
                        ]
                    }
