                                                "example_id": "d6b74344-d967-4745-922e-4eec088f22da",
                                                "sense_id": "40f65f4b-b675-397d-824b-5e1729f24f40",
                                                "text": "“This the only seat y’all got?” [Dank] Demoss, who also goes by Dajua Blanding, asks earnestly."
                                            }
                                        ]
