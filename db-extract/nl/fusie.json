                                        "glosses": [
                                            "Verschmelzung von Gegenständen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e20b89f5-c1e1-4a6c-b2c2-c9d9caedc5ba",
                                                "sense_id": "68fbc885-324b-3e5f-9561-95bcbf9075e5",
                                                "text": "Vor allem die Fusion von leichten Wasserstoffkernen erzeugt in der Sonne Energie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d5127baf-5645-33de-9689-8d8c7fc8aabb",
                                        "entry_id": "8e421c9c-5c64-3eed-a00b-d49625e118c1",
                                        "glosses": [
                                            "die Verschmelzung von Unternehmen oder Organisationen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff7b99c7-6833-45d9-bc42-8b4be59ab034",
                                                "sense_id": "d5127baf-5645-33de-9689-8d8c7fc8aabb",
                                                "text": "Die grenzüberschreitende Fusion von Daimler und Chrysler sorgte weltweit für Aufsehen und erlangte bei den Aktionären keine uneingeschränkte Zustimmung."
                                            },
                                            {
                                                "example_id": "b5be0e39-f09c-4260-8c3b-db4e3f3237c3",
                                                "sense_id": "d5127baf-5645-33de-9689-8d8c7fc8aabb",
                                                "text": "„Die DB AG entstand 1994 aus der Fusion der Deutschen Bundesbahn und der Deutschen Reichsbahn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c61a723c-9350-3354-8afc-a1920957d20c",
                                        "entry_id": "8e421c9c-5c64-3eed-a00b-d49625e118c1",
                                        "glosses": [
                                            "besonders enge Verschmelzung der Flexionsform mit dem Wortstamm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b03621ee-4ac8-4026-8cb6-2ff13cd2a592",
                                                "sense_id": "c61a723c-9350-3354-8afc-a1920957d20c",
                                                "text": "Formen wir \"ziehen\" - \"zogen\" zeigen ebenso das grammatische Verfahren der Fusion wie etwa \"gut\" - \"bess-\"er."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
