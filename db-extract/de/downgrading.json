                "senses": [
                    {
                        "sense_id": "8474dfc9-abad-3819-a43f-9df4f6d77cda",
                        "entry_id": "879aea33-ba01-3df7-9540-ce4edc9b1b02",
                        "glosses": [
                            "Einordnung einer Sache oder Angelegenheit in eine niedrigere Stufe der Wertigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efcdd770-a1e5-4a6a-9a41-02e58d6d5c8e",
                                "sense_id": "8474dfc9-abad-3819-a43f-9df4f6d77cda",
                                "text": "„Lassen Sie kein Downgrading des Gesundheitswesens auf amerikanische Verhältnisse zu“, appelliert der Vorsitzende des Verbands, Thomas Preis, an „alle verantwortungsbewussten Gesundheitspolitiker“."
                            },
                            {
                                "example_id": "25c92502-584a-4ad2-be00-6fe049a0070f",
                                "sense_id": "8474dfc9-abad-3819-a43f-9df4f6d77cda",
                                "text": "„Dagegen werden bei Mark-to-Market-Models bereits Verschlechterungen der Kreditqualität während der Kreditlaufzeit (insbesondere Downgradings) als Kreditereignis betrachtet.“"
                            },
                            {
                                "example_id": "d17eca75-c993-4440-baea-5659e214c7cc",
                                "sense_id": "8474dfc9-abad-3819-a43f-9df4f6d77cda",
                                "text": "„Somit ist entweder die Neueinführung zusätzlicher Dienstleistungen im Individualkauf (Upgrading) oder das Angebot eines verringerten Dienstleistungsangebotes im Bündelkauf (Downgrading) möglich.“"
                            },
                            {
                                "example_id": "c39804b6-a591-4ab9-bc76-c39546ae4e28",
                                "sense_id": "8474dfc9-abad-3819-a43f-9df4f6d77cda",
                                "text": "„Ein Downgrading an dem Produktionsstandort im Heimatmarkt erscheint wenig sinnvoll, da sich solche Produkte ohnehin nur für Schwellen- bzw. Entwicklungsländer eignen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e9cc1c9e-b72d-324e-b62b-4a9636eec187",
                        "entry_id": "879aea33-ba01-3df7-9540-ce4edc9b1b02",
                        "glosses": [
                            "Veränderung des Aufgabengebiets, indem einem Arbeitnehmer weniger anspruchsvolle Aufgaben zugewiesen werden (was auch als Disziplinierungsmaßnahme gemeint oder verstanden werden kann)"
                        ],
                        "tags": [
                            "Arbeitssoziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "bd2f83fa-233b-4cf0-95e8-8678a0a2a008",
                                "sense_id": "e9cc1c9e-b72d-324e-b62b-4a9636eec187",
                                "text": "„Pietrzyk (2002) untersuchte im Rahmen einer Längsschnittstudie den Einfluss von beruflichem Downgrading sowie beruflichen Veränderungen auf Indikatoren beruflicher Handlungskompetenz und motivationale Personenmerkmale.“"
                            },
                            {
                                "example_id": "4050ff76-b564-4803-92f8-e03f6654dff5",
                                "sense_id": "e9cc1c9e-b72d-324e-b62b-4a9636eec187",
                                "text": "„Downgrading der Angestellten: Den Mitarbeitern der Pharmagroßhändler in Bayern drohen Verdiensteinbußen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
