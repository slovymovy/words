                "senses": [
                    {
                        "sense_id": "36537c07-a4a7-3e7e-b9d4-9c133f51b77b",
                        "entry_id": "61f64b1c-87ba-39b7-beb5-2cf693d5b497",
                        "glosses": [
                            "Himmelskörper, der den Planeten Mars umkreist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "257b67a1-c5aa-4187-bf62-10ae80ad49c6",
                                "sense_id": "36537c07-a4a7-3e7e-b9d4-9c133f51b77b",
                                "text": "„Deimos ist der entferntere der beiden Marsmonde, er läuft auf einer fast exakten Kreisbahn von 23.459 km Radius (entsprechend 20.063 km über dem Marsäquator) und benötigt für einen Marsumlauf 1 Tag, 6 Stunden und 18 Minuten.“"
                            },
                            {
                                "example_id": "e45a3a88-08d9-4c74-b880-0f7d3c1997ea",
                                "sense_id": "36537c07-a4a7-3e7e-b9d4-9c133f51b77b",
                                "text": "„Der US-amerikanische Elektronikmusiker Larry Fast widmete den beiden Marsmonden Phobos und Deimos die 1978 auf seinem Album Cords erschienene Komposition Phobos And Deimos Go To Mars.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
