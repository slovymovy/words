                    {
                        "translation_id": "23dbea80-2f83-4d40-8261-5e74fb69d1fd",
                        "source_entry_id": "66238167-326a-332b-9a2e-88e90bc2fa15",
                        "source_sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                        "target_lang_word": "mirre",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mirre",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "843e9186-1f52-3dd4-98a2-779da6a5a298",
                                        "entry_id": "33861218-9ac0-3ee0-b14f-bdb146db4a6d",
                                        "glosses": [
                                            "welriekende maar bitter smakende stof gemaakt van gom en hars"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b230229-bc8e-46a6-bfbe-e060a3e80a35",
                                                "sense_id": "843e9186-1f52-3dd4-98a2-779da6a5a298",
                                                "text": "De geur van wierook en mirre. Je ruikt het maar zelden, behalve als ze het op begrafenissen in de kerk met zo’n vaatje rondstrooien. Het is bijna fout om er tijdens zulke trieste gelegenheden van te genieten, maar de geur is fantastisch."
                                            },
                                            {
                                                "example_id": "09607a2c-fa13-4117-9424-59811bf4b16a",
                                                "sense_id": "843e9186-1f52-3dd4-98a2-779da6a5a298",
                                                "text": "Erica Terpstra gaat in haar positieve reisprogramma (vanaf vanavond in de herhaling op vrijdag) voor omroep MAX op zoek naar geluk en spiritualiteit. In deze aflevering reist ze naar Oman, „het land van 1001 nacht”. Terpstra bezoekt markten waar kamelen, wierook en mirre worden verhandeld die rechtstreeks uit de Middeleeuwen lijken te stammen. Ze spreekt een Arabische prinses en reist dwars door de woestijn, langs oases en bedoeïenenkampen. Ze geniet met volle teugen: „Zit ik hier nu op het mooiste plekje van de wereld?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faba7a79-d1b2-376f-abd0-9bdd3858c5f7",
                                        "entry_id": "33861218-9ac0-3ee0-b14f-bdb146db4a6d",
                                        "glosses": [
                                            "Commiphora myrrha plant waar men mirre uit kan winnen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43f6dc56-cd24-4a56-95be-06b5e2cf0ec2",
                        "source_entry_id": "66238167-326a-332b-9a2e-88e90bc2fa15",
                        "source_sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                        "target_lang_word": "мирра",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мирра",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "502f7067-4ae1-3486-a48f-b7af7f8f1388",
                                        "entry_id": "a97ff32f-5bc4-3cd4-8960-5333eb2b4dd5",
                                        "glosses": [
                                            "ароматическая смола, получаемая из коры некоторых тропических деревьев, используемая в медицине и в парфюмерии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed7a5ee7-89dd-48f4-95dc-b91f51c8ed76",
                                                "sense_id": "502f7067-4ae1-3486-a48f-b7af7f8f1388",
                                                "text": "Возьми три лота толчёной мирры, лот корени чёрной чемерицы, изрежь крупно, положи в скляницу, влей штоф доброго вина и поставь, крепко закупоривши, в тёплое место на две недели или больше, процеди сквозь плат и береги для себя."
                                            },
                                            {
                                                "example_id": "b0e771f4-986d-4f8b-a37f-bc800533f40c",
                                                "sense_id": "502f7067-4ae1-3486-a48f-b7af7f8f1388",
                                                "text": "Её волоса увлажены миррою."
                                            },
                                            {
                                                "example_id": "08dd1fbf-0813-48dc-9a09-9d870721cf72",
                                                "sense_id": "502f7067-4ae1-3486-a48f-b7af7f8f1388",
                                                "text": "С треножника пахло пепелом сожженной мирры."
                                            },
                                            {
                                                "example_id": "0b008dc8-1961-42c1-98f4-2a2170f467ea",
                                                "sense_id": "502f7067-4ae1-3486-a48f-b7af7f8f1388",
                                                "text": "Теперь только во время церковных служб священники курили фимиам и помазывали молящихся душистой миррой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4401205b-a8a5-3fd0-8168-7ffb132bd0aa",
                                        "entry_id": "a97ff32f-5bc4-3cd4-8960-5333eb2b4dd5",
                                        "glosses": [
                                            "растение, источающее такую смолу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a22ebd32-b9d0-4fd4-ab94-832ac7af71b3",
                                                "sense_id": "4401205b-a8a5-3fd0-8168-7ffb132bd0aa",
                                                "text": "Например, «шаджара аль-либан» («дерево ладана»), «шаджара аль-мурр» («дерево мирры») и т. д."
                                            },
                                            {
                                                "example_id": "12c30837-3f7f-4f27-9803-6617a90328cf",
                                                "sense_id": "4401205b-a8a5-3fd0-8168-7ffb132bd0aa",
                                                "text": "Особенно ценились в Риме ароматы кипариса и мирры."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
