                    {
                        "translation_id": "fd46efdf-429b-4a36-90c5-3bd9f7e25be7",
                        "source_entry_id": "03268890-1333-378c-b97d-015b215eece0",
                        "source_sense_id": "55191884-1181-318b-8a7a-43c37554d785",
