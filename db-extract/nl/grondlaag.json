                                "sense_id": "79fd7514-2232-3e09-9f0f-3c6ac7c60471",
                                "text": "Ik heb haar de grondlagen van de wiskunde proberen te onderwijzen."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e0d56d0-600a-3221-8fcd-892d342f57bb",
                        "entry_id": "f981ca36-7a07-3b3d-ba47-0f8036ca5f00",
                        "glosses": [
                            "een horizontale laag in de grond"
