                ],
                "translations": [
                    {
                        "translation_id": "9f484f9f-d021-4f0a-8f91-26cb6c3f22aa",
                        "source_entry_id": "ae3061b4-54fb-38bf-8144-3db78256b059",
                        "source_sense_id": "39953d0e-8ce6-3b9b-aa3e-3e75c5d1ed04",
                        "source_sense_description": "to buy again",
                        "target_lang_word": "racheter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "racheter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5279660e-9b4f-3ca6-8972-0be0381bf326",
                                        "entry_id": "25925c36-22b1-3173-91ac-3988d8a81ff3",
                                        "glosses": [
                                            "Acheter ce qu’on a vendu ou ce qui a été vendu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f9ae4cd-8d1d-4921-aa19-98cfd1b13f9c",
                                                "sense_id": "5279660e-9b4f-3ca6-8972-0be0381bf326",
                                                "text": "J’avais vendu mon cheval à un tel, je le lui ai racheté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a6cb8ae-3d5d-3c6f-9ef7-db53a6edbc69",
                                        "entry_id": "25925c36-22b1-3173-91ac-3988d8a81ff3",
                                        "glosses": [
                                            "Acheter des choses de même espèce que celles que l’on a vendues, ou qu’on ne possède plus par quelque cause que ce soit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8dd01d3-5f92-4d82-a3cb-ea6f8f4a7f17",
                                                "sense_id": "7a6cb8ae-3d5d-3c6f-9ef7-db53a6edbc69",
                                                "text": "Il avait vendu ses tableaux, il en a racheté d’autres."
                                            },
                                            {
                                                "example_id": "13e0e72b-4b44-40f9-bf60-c2a774b292a1",
                                                "sense_id": "7a6cb8ae-3d5d-3c6f-9ef7-db53a6edbc69",
                                                "text": "J’avais donné ce livre, j’en ai racheté un autre exemplaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c116219-ee1f-3b50-ae3c-29cfd390cf96",
                                        "entry_id": "25925c36-22b1-3173-91ac-3988d8a81ff3",
                                        "glosses": [
                                            "Acheter à un autre ce qu'il avait lui-même acheté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "207c31bf-92ee-4c30-9604-3ee2d227657a",
                                                "sense_id": "8c116219-ee1f-3b50-ae3c-29cfd390cf96",
                                                "text": "Mais ces deux gros industriels […] ont un titre de gloire peu commun : voici quelques années, ils ont résisté victorieusement aux assauts répétés de Robert Hersant qui, comme il l'a fait un peu partout en France, a tenté de les mettre à genoux pour racheter leurs journaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ece4b3a-f3c1-348a-953f-08cd1876037f",
                                        "entry_id": "25925c36-22b1-3173-91ac-3988d8a81ff3",
                                        "glosses": [
                                            "Se libérer d’une obligation moyennant une certaine somme d’argent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cef7af6-7201-4d5e-8249-9dff893493b3",
                                                "sense_id": "0ece4b3a-f3c1-348a-953f-08cd1876037f",
                                                "text": "Tel qui transgressait la loi du repos dominical versait une somme d'argent pour racheter sa faute et mettait ainsi sa conscience en repos en s'évitant un droit de surestarie : on faisait encore ainsi une bonne affaire."
                                            },
                                            {
                                                "example_id": "2f0c6ee8-7b2f-4011-882f-b07c67ec8b78",
                                                "sense_id": "0ece4b3a-f3c1-348a-953f-08cd1876037f",
                                                "text": "Racheter une rente, une pension."
                                            },
                                            {
                                                "example_id": "56f486a0-97b4-4faa-9441-26b6d8fd9e49",
                                                "sense_id": "0ece4b3a-f3c1-348a-953f-08cd1876037f",
                                                "text": "Se racheter d’un service foncier."
                                            },
                                            {
                                                "example_id": "1097cbb1-c3f0-4516-a94e-ebe6cc364490",
                                                "sense_id": "0ece4b3a-f3c1-348a-953f-08cd1876037f",
                                                "text": "Se racheter d’une peine."
                                            },
                                            {
                                                "example_id": "97c3b274-8789-41c2-a3e4-b90b02dc60d1",
                                                "sense_id": "0ece4b3a-f3c1-348a-953f-08cd1876037f",
                                                "text": "Se racheter du service militaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b17c8b1-76ce-3a07-8f10-24ea8ce77f39",
                                        "entry_id": "25925c36-22b1-3173-91ac-3988d8a81ff3",
                                        "glosses": [
                                            "Délivrer à prix d’argent un prisonnier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34cfa773-43e1-41f4-b11b-aaab5ec6575a",
                                                "sense_id": "9b17c8b1-76ce-3a07-8f10-24ea8ce77f39",
                                                "text": "On le racheta des mains des pirates."
                                            },
                                            {
                                                "example_id": "7cfdbed4-a320-41d7-a0fb-40d3dc736513",
                                                "sense_id": "9b17c8b1-76ce-3a07-8f10-24ea8ce77f39",
                                                "text": "Racheter de captivité."
                                            },
                                            {
                                                "example_id": "5726aef5-6046-4b6e-b1ca-7994e1df1090",
                                                "sense_id": "9b17c8b1-76ce-3a07-8f10-24ea8ce77f39",
                                                "text": "à Athènes, les esclaves avaient la faculté de se racheter."
                                            },
                                            {
                                                "example_id": "3913e9cd-066f-4d5e-9a9d-7f3b41c03530",
                                                "sense_id": "9b17c8b1-76ce-3a07-8f10-24ea8ce77f39",
                                                "text": "Il s’est racheté des pirates moyennant une forte rançon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12ebe324-c756-3a8c-8443-6d2f98ef5442",
                                        "entry_id": "25925c36-22b1-3173-91ac-3988d8a81ff3",
                                        "glosses": [
                                            "Obtenir sa rédemption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63184c48-fd83-4368-a965-46520b4b0606",
                                                "sense_id": "12ebe324-c756-3a8c-8443-6d2f98ef5442",
                                                "text": "Nous avions pour jardinier un ancien forçat que sa bonne conduite au bagne avait racheté de ses fautes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68526d15-118e-3655-9e2e-24c965a8b9d0",
                                        "entry_id": "25925c36-22b1-3173-91ac-3988d8a81ff3",
                                        "glosses": [
                                            "Compenser ; balancer ; faire pardonner ; faire oublier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85435bb5-69cd-421d-856c-6b9b79bb263a",
                                                "sense_id": "68526d15-118e-3655-9e2e-24c965a8b9d0",
                                                "text": "Dans l’élévation rachetée par les trois marches et dessous chaque fenêtre, se voient les soupiraux des caves, clos par de petites portes en tôle peinte, percées de trous prétentieusement découpés."
                                            },
                                            {
                                                "example_id": "b7603de4-1945-4d14-b767-e9bf4c269f1d",
                                                "sense_id": "68526d15-118e-3655-9e2e-24c965a8b9d0",
                                                "text": "La Société, après avoir donné un souvenir à ces antiques paroisses, a visité l'église d’Hartennes. Cet édifice, bâti en grande partie en grès qui abondent sur ce terroir, aurait un aspect assez triste, s'il ne rachetait ce défaut par un portail de la Renaissance, en pierres de taille, décoré d'une assez jolie rosace et portant des écussons et des salamandres fantastiques."
                                            },
                                            {
                                                "example_id": "5b8580e6-ceea-4e60-8537-c41e27437ca1",
                                                "sense_id": "68526d15-118e-3655-9e2e-24c965a8b9d0",
                                                "text": "La dame, grande, résolue, d’allure noble, posait d’aplomb sur le trottoir des pieds d’Anglaise que rachetaient des jambes gracieuses et des chevilles délicates."
                                            },
                                            {
                                                "example_id": "d7850e4c-d1d4-41f0-89e7-6fed2ba003a5",
                                                "sense_id": "68526d15-118e-3655-9e2e-24c965a8b9d0",
                                                "text": "Il rachète de petits défauts par sa grande honnêteté."
                                            },
                                            {
                                                "example_id": "a2fca8bf-9520-47cf-b1bb-0888dda63390",
                                                "sense_id": "68526d15-118e-3655-9e2e-24c965a8b9d0",
                                                "text": "Cette irrégularité de terrain est rachetée par une pente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb217951-ef19-4b64-a822-2df3cf24da32",
