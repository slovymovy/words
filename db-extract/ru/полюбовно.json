                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43b5106c-7ae4-4f1d-af79-adf4f1db53f1",
                                                "sense_id": "510a1d6b-73ac-3046-b49f-74892156d03c",
                                                "text": "Vieles wird [beim Brexit] davon abhängen, ob die Parteien sich am Ende gütlich einigen können oder nicht."
                                            },
                                            {
                                                "example_id": "24c2acec-e138-4a5a-bf3f-766a95c11002",
                                                "sense_id": "510a1d6b-73ac-3046-b49f-74892156d03c",
                                                "text": "In der Regel [setzen] die Fraktionen [im Bundestag] sich zusammen und versuchen, sich gütlich zu einigen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
