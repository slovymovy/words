                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "752355fd-d70c-45c1-9597-f0a524c3d970",
                                                "sense_id": "9b4c98d2-299b-3fde-8e56-d1e7bb6252da",
                                                "text": "Hij rijdt in een gele auto."
                                            },
                                            {
                                                "example_id": "1c21eb64-f4fe-4abe-ba35-632445afe872",
                                                "sense_id": "9b4c98d2-299b-3fde-8e56-d1e7bb6252da",
                                                "text": "Hij wacht tot er een lege haak voorbijkomt, dan stapt hij over de zwart- geel geblokte veiligheidsbelijning."
                                            },
                                            {
                                                "example_id": "3efe8f87-e54a-4bc6-bb87-e4be7e7a5386",
                                                "sense_id": "9b4c98d2-299b-3fde-8e56-d1e7bb6252da",
                                                "text": "Grauw, bleek vlees verkochten ze in de supermarkt, met geel vet eraan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "geel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6f40b2df-ccd3-3f63-858e-8f186428d810",
                                        "entry_id": "68323250-a7b6-336e-a2f9-9ee3d80000aa",
                                        "glosses": [
                                            "primaire kleur zoals die van licht met een golflengte van ca. 570 - 582 nm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "610d9739-187b-487b-81bc-ca72e3548291",
                                                "sense_id": "6f40b2df-ccd3-3f63-858e-8f186428d810",
                                                "text": "Het geel van deze afbeelding steekt scherp af tegen het blauw."
                                            },
                                            {
                                                "example_id": "a1e22dfd-9763-46aa-9989-90c7c0253621",
                                                "sense_id": "6f40b2df-ccd3-3f63-858e-8f186428d810",
                                                "text": "Veel sterker dan op de Autoroute ervaar je hoe het landschap langzaam van kleur verschiet, van het sappige groen van de Bourgogne naar het azuurblauw van de Méditerranée, via het droge geel van de Provence."
                                            },
                                            {
                                                "example_id": "d6d17702-a2c9-41fc-aadd-a939e94fb4d8",
                                                "sense_id": "6f40b2df-ccd3-3f63-858e-8f186428d810",
                                                "text": "Ik duwde de deur met beide handen open en zag dat er ’s nachts een dik pak sneeuw was gevallen, waarvan een stukje geel kleurde toen ik er mijn waterfles in leegde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89312aee-aab2-3262-afb3-e7685d8ca471",
                                        "entry_id": "68323250-a7b6-336e-a2f9-9ee3d80000aa",
                                        "glosses": [
                                            "aandoening van keel, luchtpijp en krop veroorzaakt door een ééncellige parasiet, Trichomonas gallinae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59f5497d-4da5-4c02-a724-ba36ed4fad00",
                                                "sense_id": "89312aee-aab2-3262-afb3-e7685d8ca471",
                                                "text": "Vroeger was het geel een gevreesde, want dodelijke, ziekte die nu veelal genezen kan worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
