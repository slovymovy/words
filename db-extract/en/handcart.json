                ],
                "senses": [
                    {
                        "sense_id": "e7d70de0-f367-3404-9fcf-35741cb54c89",
                        "entry_id": "e4b3d319-3fb3-3450-b936-c7f0e8973668",
                        "glosses": [
                            "A cart designed to be pulled or pushed by hand (as opposed to with a beast of burden.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e19d2f03-2895-4b74-ba23-e076b29a20f7",
                                "sense_id": "e7d70de0-f367-3404-9fcf-35741cb54c89",
                                "text": "Vendors were selling sunglasses, bagged snacks, and sundry other items from handcarts in the square."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c41d90fe-2e42-4567-a91c-94696b045af3",
                        "source_entry_id": "e4b3d319-3fb3-3450-b936-c7f0e8973668",
                        "source_sense_id": "e7d70de0-f367-3404-9fcf-35741cb54c89",
                        "source_sense_description": "a cart designed to be pulled or pushed by hand",
                        "target_lang_word": "handkar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handkar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a0fd9c6c-666a-3af7-84f1-01541c5e0e34",
                                        "entry_id": "d806889c-609d-3f60-9145-8b1ae0826eea",
                                        "glosses": [
                                            "een 2 wielige kar die met menskracht wordt bewogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1317eaa-d7cc-49cd-9379-d95245039b40",
                                                "sense_id": "a0fd9c6c-666a-3af7-84f1-01541c5e0e34",
                                                "text": "Op een houten handkar ligt een berg oude troep, planken, stukken golfplaat, kapotte kisten. Intuïtief laat hij zijn blik dwalen, tot die blijft haken aan een boor met een houten greep, precies wat hij nodig heeft. Een hamer, een moker, een breekijzer en schroevendraaiers van verschillende maten heeft hij al — gevonden, geruild of op een andere manier geritseld — maar wat ontbreekt in zijn gereedschapskist is een hoor."
                                            },
                                            {
                                                "example_id": "88436cc0-d1eb-41cd-a27a-e203f30c1032",
                                                "sense_id": "a0fd9c6c-666a-3af7-84f1-01541c5e0e34",
                                                "text": "Files kennen ze hier niet. De snelwegen zijn zo goed als leeg. In de stad daarentegen wemelt het van de auto's, taxi's, bussen, fietsers, voetgangers, ezels, paarden en handkarren. Een ongeluk zit hier in een piepklein hoekje."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ba380d4-fe0e-41e6-bf34-47f93ce63772",
                        "source_entry_id": "e4b3d319-3fb3-3450-b936-c7f0e8973668",
                        "source_sense_id": "e7d70de0-f367-3404-9fcf-35741cb54c89",
                        "source_sense_description": "a cart designed to be pulled or pushed by hand",
                        "target_lang_word": "charrette à bras",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charrette à bras",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8e888cd-8d04-3db2-84fd-77610819079d",
                                        "entry_id": "206528da-19d1-37d0-aa5e-6bb1049d5df1",
                                        "glosses": [
                                            "Petite charrette traînée par un ou deux hommes et propre seulement au transport de légers fardeaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7503fcd8-56d9-4eb6-aba1-d1cb08164c43",
                                                "sense_id": "d8e888cd-8d04-3db2-84fd-77610819079d",
                                                "text": "Il y avait des petites charrettes à bras pour transporter la pêche dans le hall de la criée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23ab65e5-e3ee-4615-85b3-ecc70ae3cdb6",
                        "source_entry_id": "e4b3d319-3fb3-3450-b936-c7f0e8973668",
                        "source_sense_id": "e7d70de0-f367-3404-9fcf-35741cb54c89",
                        "source_sense_description": "a cart designed to be pulled or pushed by hand",
                        "target_lang_word": "voiture à bras",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voiture à bras",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60be63b7-4e56-378b-a2ee-2d2d3e237ab8",
                                        "entry_id": "2e95ba6b-47c4-3033-a74c-efe3e5f83a95",
                                        "glosses": [
                                            "Sorte de charrette."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4550ed33-8538-4bee-b737-46aacce7fb4e",
                                                "sense_id": "60be63b7-4e56-378b-a2ee-2d2d3e237ab8",
                                                "text": "De vielles femmes poussent une voiture à bras, une brouette ou un landau d’enfant bourré de paquets, la tête d'un bébé ballottant au-dessus."
                                            },
                                            {
                                                "example_id": "b2b550d4-2368-41dd-b41a-aad675aad5cc",
                                                "sense_id": "60be63b7-4e56-378b-a2ee-2d2d3e237ab8",
                                                "text": "Les frères Latronche, les frères Ravoisier, Dupas, Weber véhiculent les sacs de sable dans une voiturette de cantonnier. D’autres volontaires tirent, poussent des voitures à bras."
                                            },
                                            {
                                                "example_id": "f1bc382d-e2ef-41bf-b17f-97a3ae840d58",
                                                "sense_id": "60be63b7-4e56-378b-a2ee-2d2d3e237ab8",
                                                "text": "Il déboucha sur une petite agora bordée d’un temple bouddhiste décati. Il suivit un moment le flux incessant des badauds, ainsi que le bal des voitures à bras dans lesquelles se prélassaient des militaires désœuvrés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d1b4ca5-a977-4678-8de3-a23b6f6607b2",
                        "source_entry_id": "e4b3d319-3fb3-3450-b936-c7f0e8973668",
                        "source_sense_id": "e7d70de0-f367-3404-9fcf-35741cb54c89",
                        "source_sense_description": "a cart designed to be pulled or pushed by hand",
                        "target_lang_word": "Handwagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handwagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d912547d-7bca-3ec5-acd6-90c3e41d5a33",
                                        "entry_id": "8565bef1-9cf9-3f69-9c5b-84b4d00ec644",
                                        "glosses": [
                                            "kleiner Wagen, den man „mit der Hand“ hinter sich herziehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d6013a5-282c-46df-9807-74ab7853bc47",
                                                "sense_id": "d912547d-7bca-3ec5-acd6-90c3e41d5a33",
                                                "text": "Für den Abtransport der Abfälle hatten wir nur einen Handwagen zur Verfügung."
                                            },
                                            {
                                                "example_id": "eaaa1ef1-6455-4eb5-8d31-5894ec7bca64",
                                                "sense_id": "d912547d-7bca-3ec5-acd6-90c3e41d5a33",
                                                "text": "„Jetzt kam der Mann nach Haus, offensichtlich aus dem Wald, denn er hatte hinter dem Haus Holz aus einem Handwagen abgeladen.“"
                                            },
                                            {
                                                "example_id": "75e2c864-a64c-4d1c-8e99-28603eff0a10",
                                                "sense_id": "d912547d-7bca-3ec5-acd6-90c3e41d5a33",
                                                "text": "„Nach der Zerstörung der Bahnstation und einiger Wohnhäuser am Südende von Velda wurde die Evakuierung angeordnet, und die Dörfler machten sich mit Handwagen und Ochsenkarren auf den Weg.“"
                                            },
                                            {
                                                "example_id": "a9ee5a4a-5e0b-47ca-bb86-0ebdd316924b",
                                                "sense_id": "d912547d-7bca-3ec5-acd6-90c3e41d5a33",
                                                "text": "„Es gab nur ein kurzes rhythmisches Geräusch, das von dem Quietschen und Rassseln eines mit etwas Unheimlichem beladenen, kleinen Handwagen kam, den ein Junge über die Straße zog, und vom Klappern seiner Holzsohlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96cea68a-2cb5-4df6-b1e4-9de83bb3c5de",
                        "source_entry_id": "e4b3d319-3fb3-3450-b936-c7f0e8973668",
                        "source_sense_id": "e7d70de0-f367-3404-9fcf-35741cb54c89",
                        "source_sense_description": "a cart designed to be pulled or pushed by hand",
                        "target_lang_word": "Handkarren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handkarren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f8cd221-9767-3965-a9f3-2f250b6e8469",
                                        "entry_id": "d3e45631-19f7-3dff-a75d-2d074ba742fb",
                                        "glosses": [
                                            "einfaches Gefährt, das von einer Person gezogen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73073c68-68b6-4382-a42c-00c31d59e3b5",
                                                "sense_id": "9f8cd221-9767-3965-a9f3-2f250b6e8469",
                                                "text": "„Er schob einen Handkarren, an den man ihn mit einer kurzen Kette angebunden hatte, und wurde vom Gefängniskoch und zwei von Garcias Soldaten begleitet.“"
                                            },
                                            {
                                                "example_id": "502c5ed5-17bb-4bc7-843b-5710893e95ce",
                                                "sense_id": "9f8cd221-9767-3965-a9f3-2f250b6e8469",
                                                "text": "„Die weißen Lichtkegel der Laternen zitterten hilflos in einen Schneesturm hinein, der dem starken Wagen das geruhsame Hinrollen eines Handkarrens aufzwang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
