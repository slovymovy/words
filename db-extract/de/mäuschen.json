                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petite souris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa724986-ed37-328c-a541-94be9aa095d3",
                                        "entry_id": "b6395d0b-d976-38be-8245-3e50b19b4e51",
                                        "glosses": [
                                            "Créature fantastique censée remplacer par de l’argent la dent de lait que les enfants ont perdue s’ils la laissent sous leur oreiller avant de s’endormir."
                                        ],
                                        "tags": [
                                            "Europe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c19d96b2-fbbc-4308-8d5a-d7b85c75a8db",
                                                "sense_id": "aa724986-ed37-328c-a541-94be9aa095d3",
                                                "text": "Avec des voix de conspirationnistes, perpétuant aveuglément une tradition que nous avons nous-mêmes vécue étant petit, nous avons fait savoir à mon fils que la petite souris allait passer pendant la nuit. Qu’il allait donc falloir mettre la dent sous l’oreiller. Et dormir profondément."
                                            },
                                            {
                                                "example_id": "5225e979-1501-4d44-b0a0-339b3712b382",
                                                "sense_id": "aa724986-ed37-328c-a541-94be9aa095d3",
                                                "text": "Aujourd'hui, j’ai surpris mon fils de huit ans en train d’essayer de s'arracher une dent pour que la petite souris lui donne de l’argent. VDM"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
