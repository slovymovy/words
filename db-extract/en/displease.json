                ],
                "senses": [
                    {
                        "sense_id": "6bd19af0-8fff-3441-9305-d10452a75e05",
                        "entry_id": "06e6f5d7-ffa8-34d2-a701-a357a979bf52",
                        "glosses": [
                            "To make not pleased; to cause a feeling of disapprobation or dislike in; to be disagreeable to; to vex slightly."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5a8b56bf-ccce-4d73-b383-8f128163b8cd",
                                "sense_id": "6bd19af0-8fff-3441-9305-d10452a75e05",
                                "text": "The boy's rudeness displeased me."
                            },
                            {
                                "example_id": "0ec8fdad-3a4d-4a57-b3dd-55b76d814363",
                                "sense_id": "6bd19af0-8fff-3441-9305-d10452a75e05",
                                "text": "I felt displeased with the boy."
                            },
                            {
                                "example_id": "ec8748bd-9510-477a-93da-edac0d06ea05",
                                "sense_id": "6bd19af0-8fff-3441-9305-d10452a75e05",
                                "text": "Wilt thou be displeased at us forever: and wilt thou stretch out thy wrath from one generation to another?"
                            },
                            {
                                "example_id": "678c5cd1-c63a-4890-a4cf-477c894f1d22",
                                "sense_id": "6bd19af0-8fff-3441-9305-d10452a75e05",
                                "text": "How can an operator be, at the same time, top for overall satisfaction and bottom for value for money? I turned to Anthony Smith for the answer, leaning on his 20 years running Transport Focus and its predecessors.\nIt's commuters, he explained. \"You can't please commuters, you can only not displease them.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "a22df864-e385-33b6-a039-a48e4fed6a69",
                        "entry_id": "06e6f5d7-ffa8-34d2-a701-a357a979bf52",
                        "glosses": [
                            "To give displeasure or offense."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9365f038-daf5-31bd-ad3f-860a341294de",
                        "entry_id": "06e6f5d7-ffa8-34d2-a701-a357a979bf52",
                        "glosses": [
                            "To fail to satisfy; to miss of."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8eec44bd-b9d8-4abe-b8fd-6c47c8266856",
                                "sense_id": "9365f038-daf5-31bd-ad3f-860a341294de",
                                "text": "I shall displease my ends else."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11168ba7-8766-4f9d-a84f-db2bbe3e294b",
                        "source_entry_id": "06e6f5d7-ffa8-34d2-a701-a357a979bf52",
                        "source_sense_description": "to fail to please or satisfy",
                        "target_lang_word": "missfallen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "missfallen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb2a07f7-319e-38f0-8c1b-bca0a2bc97bf",
                                        "entry_id": "0b2afb09-8181-3c6a-81fb-5523c009713b",
                                        "glosses": [
                                            "nicht gefallen, einen schlechten Eindruck machen, abgelehnt werden"
                                        ],
                                        "tags": [
                                            "dative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "570379bf-079e-4d8f-99f3-a927402d7eca",
                                                "sense_id": "eb2a07f7-319e-38f0-8c1b-bca0a2bc97bf",
                                                "text": "„Diese Verhältnisse sind, auch wenn sie dem Westen missfallen, genauso real wie das demografische Ungleichgewicht, die Jugendarbeitslosigkeit und die Korruption der Regime.“"
                                            },
                                            {
                                                "example_id": "b42696b3-0f96-463d-a2d0-38cb6d2bdf9f",
                                                "sense_id": "eb2a07f7-319e-38f0-8c1b-bca0a2bc97bf",
                                                "text": "„Der Mama und dem Papa missfiel ihr geselliges Leben, daraus machten sie keinen Hehl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
