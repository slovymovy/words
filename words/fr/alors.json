{
    "word_family": [
        "lors",
        "lorsque"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "53a3455e-c10c-3b5f-865c-f06673aa92d1",
                    "sense_definition": "Marque la conséquence ou la conclusion ; dans ce cas.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu as fini tes devoirs, <w>alors</w> tu peux sortir jouer dehors."
                        },
                        {
                            "text": "Il n'y avait plus de train, <w>alors</w> nous sommes rentrés à pied."
                        }
                    ],
                    "synonyms": [
                        "donc"
                    ],
                    "common_phrases": [
                        "et alors"
                    ]
                },
                {
                    "sense_id": "b37b4ea1-bf97-3b52-a62a-48917c0e4d45",
                    "sense_definition": "S'emploie en début de phrase pour introduire une question ou solliciter une réaction.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interrogation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Alors</w>, tu viens avec nous au cinéma ce soir ?"
                        },
                        {
                            "text": "<w>Alors</w>, comment s'est passée ta première journée de travail ?"
                        }
                    ]
                },
                {
                    "sense_id": "0d3ac779-b2a0-361c-a696-610f6bddae7d",
                    "sense_definition": "À ce moment-là, en ce temps-là.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'étais encore étudiant <w>alors</w>, et je n'avais pas beaucoup d'argent."
                        },
                        {
                            "text": "La vie dans ce petit village était <w>alors</w> bien différente d'aujourd'hui."
                        }
                    ],
                    "synonyms": [
                        "à l'époque"
                    ],
                    "common_phrases": [
                        "jusqu'alors",
                        "d'alors"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "90d3a072-371e-375e-8b01-ce52c1a2de30",
                    "sense_definition": "Sert à introduire ou relancer une prise de parole, marquant parfois l'impatience ou l'étonnement.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Alors</w>, qu'est-ce qu'on attend pour commencer la réunion ?"
                        },
                        {
                            "text": "Eh bien <w>alors</w>, pourquoi ne réponds-tu pas à ma question ?"
                        }
                    ],
                    "common_phrases": [
                        "alors là"
                    ]
                }
            ]
        }
    ]
}