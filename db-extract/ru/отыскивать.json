                "senses": [
                    {
                        "sense_id": "8c3f1245-35da-33f0-b444-9dc22ca88189",
                        "entry_id": "ec1242cb-2e30-33ea-900a-57eb9e773228",
                        "glosses": [
                            "производя поиски, находить, обнаруживать, определять местонахождение кого-либо, чего-либо"
                        ],
                        "tags": [],
