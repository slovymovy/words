                                    {
                                        "sense_id": "08aca7de-26a9-371f-a7aa-ff49d7ddd2dd",
                                        "entry_id": "0589e81b-df26-3d0e-a0f6-359b30636593",
                                        "glosses": [
                                            "Archaic form of kris."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "401e6e6f-7f11-4af1-95df-7b78f1793cb3",
                                                "sense_id": "08aca7de-26a9-371f-a7aa-ff49d7ddd2dd",
                                                "text": "‘[S]hould any of the men discover you, certainly you will have one of their creeses up to the hilt in your guts.’"
                                            },
                                            {
                                                "example_id": "96026638-0887-4213-a0fe-99038d919dd1",
                                                "sense_id": "08aca7de-26a9-371f-a7aa-ff49d7ddd2dd",
                                                "text": "[…] near it is a cluster of weapons of villanous aspect, comprising every thing from a Malayan creese to a sailor's jackknife or a Smith & Wesson revolver."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "creese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94fafc93-6848-3560-be92-5e75bce53e93",
                                        "entry_id": "32eac609-b70f-33c6-85a6-556af61ba570",
                                        "glosses": [
                                            "Archaic form of kris."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02918446-ee09-4b7b-a17b-ab88f55ab9ef",
                                                "sense_id": "94fafc93-6848-3560-be92-5e75bce53e93",
                                                "text": "Attributing this to accident, or some impropriety of conduct on the part of the sailor, he went to enquire personally into the affair; but had no sooner approached the head Boorghese, than the fellow creesed him also, and he fell dead at his feet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f1bf3c5-c2f3-4104-8e75-b277f714a901",
                        "source_entry_id": "f6aa822b-f32d-322e-b901-9259210a0fb5",
