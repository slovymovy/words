                "senses": [
                    {
                        "sense_id": "1a98ce3e-82d0-34c4-bfab-7489a950bbe0",
                        "entry_id": "e9cc46ec-71bb-33a6-9375-a21780afb419",
                        "glosses": [
                            "Halle, in welcher der Check-in beziehungsweise die Anmeldung des Reisegastes erfolgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce6fe25b-634e-47fe-9fe9-9ab9cf4cb81d",
                                "sense_id": "1a98ce3e-82d0-34c4-bfab-7489a950bbe0",
                                "text": "Wir mussten über zwei Stunden lang in der Check-in-Halle Schlange stehen."
                            },
                            {
                                "example_id": "d6c6ede0-230c-4f2e-b0e8-e149b97df63b",
                                "sense_id": "1a98ce3e-82d0-34c4-bfab-7489a950bbe0",
                                "text": "„Am Donnerstag, 3. Dezember, spielt das Posaunenquartett um 17 Uhr in der Check-in-Halle des Terminals zwei.“"
                            },
                            {
                                "example_id": "5964ac29-19d8-4174-a015-262e56aab04d",
                                "sense_id": "1a98ce3e-82d0-34c4-bfab-7489a950bbe0",
                                "text": "„In der Check-in-Halle (ebenfalls ein öffentlicher Bereich) stehen unter anderem das Selbstbedienungsrestaurant ‚Leonardo‘ zur Wahl, Eisspezialitäten von Häagen Dazs, das Restaurant ‚Rheinwiesen‘ […], das Fine-Dining-Restaurant ‚Red Baron‘ mit Blick auf das Rollfeld oder auch das japanische Restaurant Kikaku […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
