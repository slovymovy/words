                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6719cba2-e456-4a4d-870b-e9b6905e191c",
                                                "sense_id": "37bae224-ddb0-3224-8819-4a415e1942e6",
                                                "text": "Idź się przebierz, żebyś wyglądała po ludzku."
                                            }
