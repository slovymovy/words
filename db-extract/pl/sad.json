                    {
                        "translation_id": "bc61ea8e-d67e-403f-8a68-71f544d5254b",
                        "source_entry_id": "fd626aa5-6564-3cec-ab73-44606dba9767",
                        "source_sense_id": "c72d3d1e-aa6c-3059-9b75-f0a3748820a2",
                        "target_lang_word": "boomgaard",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boomgaard",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4fccd347-fe2e-3efb-aea7-4b6c84edc4c3",
                                        "entry_id": "eafcf07d-fab8-3baa-8082-0c180543ce44",
                                        "glosses": [
                                            "een stuk grond met vruchtbomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa0f6fa1-3f28-4f08-922f-ea968aec64d9",
                                                "sense_id": "4fccd347-fe2e-3efb-aea7-4b6c84edc4c3",
                                                "text": "Het is prachtig in de lente met de boomgaard in bloei."
                                            },
                                            {
                                                "example_id": "b4a9ec08-6641-4a89-a59c-2b8eca5e2ef3",
                                                "sense_id": "4fccd347-fe2e-3efb-aea7-4b6c84edc4c3",
                                                "text": "In het bijgebouw achter de boomgaard had ze een oud houten paneel gevonden dat ze heimelijk, alsof het smokkelwaar was, had meegenomen naar zolder."
                                            },
                                            {
                                                "example_id": "27516a4a-b3a8-44da-aa42-2a539d08eb21",
                                                "sense_id": "4fccd347-fe2e-3efb-aea7-4b6c84edc4c3",
                                                "text": "Nietsvermoedende konijnen hopsten door de boomgaard en op de heuvels in de verte werden geiten gehoed, de bellen om hun nek klingelden atonaal en onregelmatig, een rustgevend geluid, omdat er geen enkele opzet achter zat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daf80c74-3ab3-43d8-9a8b-7c16788b4fe2",
                        "source_entry_id": "fd626aa5-6564-3cec-ab73-44606dba9767",
                        "source_sense_id": "c72d3d1e-aa6c-3059-9b75-f0a3748820a2",
                        "target_lang_word": "Obstgarten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Obstgarten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9d82978-3260-3cca-bcd9-65bf947328c4",
                                        "entry_id": "d9494974-f833-3f2b-b72f-5be026462fa1",
                                        "glosses": [
                                            "Garten, in dem Obst angebaut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67fdd0d6-3fad-4dbe-b491-4d4ebc2095a1",
                                                "sense_id": "b9d82978-3260-3cca-bcd9-65bf947328c4",
                                                "text": "Sie erntete die Äpfel und Birnen in ihrem Obstgarten."
                                            },
                                            {
                                                "example_id": "9b0ef87e-d04a-48d1-986a-b57b0bb5eac5",
                                                "sense_id": "b9d82978-3260-3cca-bcd9-65bf947328c4",
                                                "text": "„Sonderbar, daß ihm das Haus in Hemmeres, der Obstgarten am Fluß, der Fluß in Tal auf einmal nicht mehr als Zuflucht erschienen.“"
                                            },
                                            {
                                                "example_id": "1ff7e62f-8bae-4b65-a690-f2bdd7d476ba",
                                                "sense_id": "b9d82978-3260-3cca-bcd9-65bf947328c4",
                                                "text": "„Ein Duft nach Obstgärten im frühen Sommer erhob sich sofort.“"
                                            },
                                            {
                                                "example_id": "662e7329-052d-431c-bf85-ae27ace1ec9a",
                                                "sense_id": "b9d82978-3260-3cca-bcd9-65bf947328c4",
                                                "text": "„Ich erinnere mich an die Pfade durch die Obstgärten und Felder der Bauernhöfe oberhalb des Dorfes und die warmen Bauernhäuser mit ihren großen Öfen und den gewaltigen Holzstapeln im Schnee.“"
                                            },
                                            {
                                                "example_id": "c9e9949f-2b4e-483c-99fe-f3321b8e0efa",
                                                "sense_id": "b9d82978-3260-3cca-bcd9-65bf947328c4",
                                                "text": "„Für den Obstgarten würde eine Ausputzung von Zeit zu Zeit genügen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
