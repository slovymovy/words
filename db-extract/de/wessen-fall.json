                                        "sense_id": "687234f7-c0ec-337a-a22d-015b545ba353",
                                        "entry_id": "dd6acea5-b18d-3810-bff7-b50c44136cce",
                                        "glosses": [
                                            "The grammatical case, chiefly applicable to nouns, used to express a relationship of origin or possession. It corresponds roughly to the English preposition of and the suffix -'s."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd1bc627-f4b0-40fd-b53d-0dd95021e4f5",
                                                "sense_id": "687234f7-c0ec-337a-a22d-015b545ba353",
                                                "text": "In very early times a man seems to have been known by a single name together with his father's name in the genitive case, e.g. Marcus Marci; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fd9a5e0-a562-4692-bc56-3b9173e0f7d9",
                        "source_entry_id": "5cd4bf8e-e881-3d83-90ea-6bc1b3662f89",
                        "source_sense_id": "7afe03d0-f4fc-3418-be67-07f40ecf6d6c",
