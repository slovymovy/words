                "senses": [
                    {
                        "sense_id": "5ca6257d-a72e-3ac9-9f04-af3092091ea8",
                        "entry_id": "f5f700ed-82a1-352a-ad83-a3b11b8bf9f0",
                        "glosses": [
                            "Erbringung einer Dienstleistung eines technisch versierten Fachmannes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b7054da-3d5a-4b8a-b870-2d6a4e883eed",
                                "sense_id": "5ca6257d-a72e-3ac9-9f04-af3092091ea8",
                                "text": "„Er bietet ein breites Spektrum an Leistungen an, immer vor dem Hintergrund der Verbindung von Ingenieursleistung und Kunst.“"
                            },
                            {
                                "example_id": "dd1d65b9-4e66-483b-afd3-7ff80446c92f",
                                "sense_id": "5ca6257d-a72e-3ac9-9f04-af3092091ea8",
                                "text": "„So war es unter anderem die Ingenieursleistung made in Germany, die die komplexe Feinabstimmung mehrerer Motorenarten in einem Antriebskonzept wortwörtlich „auf die Straße brachte“.“"
                            },
                            {
                                "example_id": "2ea20fca-5920-4dab-be54-b26efab29e0a",
                                "sense_id": "5ca6257d-a72e-3ac9-9f04-af3092091ea8",
                                "text": "„Dies gelang nun bei drei Events hintereinander, was die herausragende Ingenieursleistung der Studenten während des letzten Jahres eindrücklich bestätigt.“"
                            },
                            {
                                "example_id": "65bb4815-30dc-4174-8187-c64bbbf53d47",
                                "sense_id": "5ca6257d-a72e-3ac9-9f04-af3092091ea8",
                                "text": "„Der angesehene “Innovations Design and Engineering Awards” zeichnet seit 1976 Fortschritte in Produktdesign und Ingenieursleistung aus.“"
                            },
                            {
                                "example_id": "a33ec7da-aa87-40a8-89a7-67821ea280af",
                                "sense_id": "5ca6257d-a72e-3ac9-9f04-af3092091ea8",
                                "text": "„Die besondere Ingenieursleistung der Kölner Studenten wurde nun mit dem „PSMA Best Engineering Achievement“-Award und dem zweiten Wettbewerbsplatz ausgezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
