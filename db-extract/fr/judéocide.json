                    {
                        "sense_id": "56fee690-1141-3429-9586-1cccf8f4d83c",
                        "entry_id": "ba17a6f7-ba18-3e83-adb7-32004bf00c88",
                        "glosses": [
                            "Qui pousse à tuer un Juif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "943f7002-da14-49af-b326-0aff67c8eaf5",
                                "sense_id": "56fee690-1141-3429-9586-1cccf8f4d83c",
                                "text": "Ces déclarations, l’heure est venue de les expliciter pour qu’elles pénètrent les mentalités et se substituent aux mythes judéocides."
                            }
                        ]
                    },
                    {
                        "sense_id": "699cee1d-4d1b-3b89-b4d9-d021c1e3b854",
                        "entry_id": "ba17a6f7-ba18-3e83-adb7-32004bf00c88",
