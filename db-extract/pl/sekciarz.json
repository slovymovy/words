                "senses": [
                    {
                        "sense_id": "fbc4902c-e280-37d6-9a92-79970bb0997d",
                        "entry_id": "6d48f444-ffa3-307c-b466-4c6a453d4938",
                        "glosses": [
                            "członek sekty religijnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "859dd320-1398-437b-b65d-c89ad37112b7",
                                "sense_id": "fbc4902c-e280-37d6-9a92-79970bb0997d",
                                "text": "Surowy, purytański kodeks moralny sekciarzy, ich powrót do prostoty praojców z okresu koczowniczego pasterstwa, ich ofiary z baranów składane na wzniesieniach jakiemuś nieznanemu, bliżej nieokreślonemu bogu – wszystko to ściągnęło na nich wzgardę i potępienie"
                            },
                            {
                                "example_id": "0d0c12e2-9f05-4601-b808-c84098c5a1ea",
                                "sense_id": "fbc4902c-e280-37d6-9a92-79970bb0997d",
                                "text": "Grupa sekciarzy spotykała się regularnie na tajnych zebraniach."
                            }
                        ],
