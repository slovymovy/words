    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba8e2e66-540f-3342-8940-55dc9050dadf",
                    "sense_definition": "młody lub mały <w>baran</w>; jagnię",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zwierze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na łące obok rzeki biega mały, biały <w>baranek</w>.",
                            "target_lang_translations": {
                                "en": "A little white <w>lamb</w> is running in the meadow by the river."
                            }
                        },
                        {
                            "text": "Gospodarz zauważył, że młody <w>baranek</w> zgubił się podczas powrotu do zagrody.",
                            "target_lang_translations": {
                                "en": "The farmer noticed that a young <w>lamb</w> had gotten lost on the way back to the pen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "młody baranek",
                        "biały baranek"
                    ],
                    "target_lang_definitions": {
                        "en": "a young or small ram or sheep; a lamb"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lamb",
                                "target_lang_sense_clarification": "young sheep"
                            },
                            {
                                "target_lang_word": "little lamb",
                                "target_lang_sense_clarification": "diminutive, small young sheep"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0048d64c-26f5-3a91-8beb-c37298eb9026",
                    "sense_definition": "tradycyjna figurka z cukru, ciasta lub gipsu, będąca symbolem wielkanocnym",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wielkanoc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Włożyliśmy do koszyka święconego małego <w>baranka</w> zrobionego z cukru.",
                            "target_lang_translations": {
                                "en": "We put a small sugar <w>lamb</w> into the Easter basket."
                            }
                        },
                        {
                            "text": "Cukrowy <w>baranek</w> z czerwoną chorągiewką stał na samym środku stołu.",
                            "target_lang_translations": {
                                "en": "A sugar <w>lamb</w> with a red banner stood right in the center of the table."
                            }
                        }
                    ],
                    "common_phrases": [
                        "baranek wielkanocny",
                        "cukrowy baranek"
                    ],
                    "target_lang_definitions": {
                        "en": "a traditional Easter figurine shaped like a lamb, made of sugar, pastry, butter, or plaster"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Easter lamb",
                                "target_lang_sense_clarification": "figurine or cake symbolizing Easter"
                            },
                            {
                                "target_lang_word": "sugar lamb",
                                "target_lang_sense_clarification": "Easter figurine made of sugar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3a85a1d-c1af-385d-8f3b-95545d30c2bb",
                    "sense_definition": "o osobie bardzo łagodnej, cichej i uległej",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cecha",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zwykle głośno krzyczał, ale podczas rozmowy z dyrektorem stał się potulny jak <w>baranek</w>.",
                            "target_lang_translations": {
                                "en": "He usually shouted loudly, but during the conversation with the principal he became as gentle as a <w>lamb</w>."
                            }
                        },
                        {
                            "text": "Mój młodszy brat to prawdziwy <w>baranek</w>, który nigdy nikomu nie zrobiłby krzywdy.",
                            "target_lang_translations": {
                                "en": "My younger brother is a real <w>lamb</w> who would never hurt anyone."
                            }
                        }
                    ],
                    "common_phrases": [
                        "potulny jak baranek",
                        "cichy jak baranek"
                    ],
                    "target_lang_definitions": {
                        "en": "a very gentle, meek, or docile person"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lamb",
                                "target_lang_sense_clarification": "figurative, a meek or gentle person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d607bdad-57d9-3002-b790-1f433d315988",
                    "sense_definition": "mały, biały i puszysty obłok na niebie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chmura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na błękitnym niebie pojawiły się delikatne <w>baranki</w> zapowiadające zmianę pogody.",
                            "target_lang_translations": {
                                "en": "Delicate <w>fleecy clouds</w> appeared in the blue sky, heralding a change in the weather."
                            }
                        },
                        {
                            "text": "W upalne popołudnie obserwowałem płynące wolno po niebie białe <w>baranki</w>.",
                            "target_lang_translations": {
                                "en": "On a hot afternoon, I watched little white <w>clouds</w> drifting slowly across the sky."
                            }
                        }
                    ],
                    "common_phrases": [
                        "baranki na niebie"
                    ],
                    "target_lang_definitions": {
                        "en": "a small, fluffy, white cumulus or cirrocumulus cloud in the sky"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "little cloud",
                                "target_lang_sense_clarification": "fluffy white cloud"
                            },
                            {
                                "target_lang_word": "fleece cloud",
                                "target_lang_sense_clarification": "mackerel sky / cirrocumulus cloud"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64950710-4884-3c11-b629-dea3e4844456",
                    "sense_definition": "biała, spieniona grzywa fali morskiej",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wiatr stawał się coraz silniejszy i na morskich falach pojawiły się białe <w>baranki</w>.",
                            "target_lang_translations": {
                                "en": "The wind grew stronger and white <w>caps</w> appeared on the sea waves."
                            }
                        },
                        {
                            "text": "Z pokładu statku widać było spienione <w>baranki</w> sunące w stronę brzegu.",
                            "target_lang_translations": {
                                "en": "From the ship's deck, one could see foaming <w>whitecaps</w> gliding toward the shore."
                            }
                        }
                    ],
                    "common_phrases": [
                        "baranki na falach",
                        "morskie baranki"
                    ],
                    "target_lang_definitions": {
                        "en": "a white crest of foam on a wave; a whitecap"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whitecap",
                                "target_lang_sense_clarification": "frothy crest of a wave"
                            },
                            {
                                "target_lang_word": "white horse",
                                "target_lang_sense_clarification": "foamy crest of a wave"
                            }
                        ]
                    }
                },
