                        "examples": [
                            {
                                "example_id": "ddd66848-fc25-47fa-a68e-d0b6a533d3dc",
                                "sense_id": "ec1a4d68-4241-354b-b7dc-8e76d5d589ef",
                                "text": "A few culverins and hagbuts were the unwieldy fire-arms, then borne by the ſoldiers."
                            },
                            {
                                "example_id": "b4b8706c-12a6-42ac-89fd-eabcb8b17844",
                                "sense_id": "ec1a4d68-4241-354b-b7dc-8e76d5d589ef",
                                "text": "[…]Wilkine Johnnstoun of Aschescheillis, William Douglas of Reidhous, Robert Dynwiddie in Kirkmichaell, and Johnne Robsoun there, almost continually since April 1610 have worn hagbuts and pistolets and used them for their revenge on persons against whom they have quarrel."
                            },
                            {
                                "example_id": "d4063515-13fc-4d53-9091-438387028176",
                                "sense_id": "ec1a4d68-4241-354b-b7dc-8e76d5d589ef",
                                "text": "[…]they resisted and shot forth of the said house twenty shot of hagbuts and pistolets, and slew one of the Guard named Bailye, and would neither render themselves nor come forth of the house till fire was raised about it."
                            }
                        ]
