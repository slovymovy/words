                        "examples": [
                            {
                                "example_id": "dae8a915-260d-4faf-bd29-021d4e53826a",
                                "sense_id": "377c2d05-9f34-365a-91f6-95e69cdc7477",
                                "text": "The tennis player's serve was phenomenally fast."
                            },
                            {
                                "example_id": "187ce7e6-2ffc-4f6a-b399-149d2a132418",
                                "sense_id": "377c2d05-9f34-365a-91f6-95e69cdc7477",
                                "text": "The police department lobbies phenomenally strongly against any civilian review board."
                            },
                            {
                                "example_id": "14cd7174-5b1f-4c55-855f-a0b89f6e8466",
                                "sense_id": "377c2d05-9f34-365a-91f6-95e69cdc7477",
                                "text": "Network Rail developed and delivered the new crossover in just ten months - \"phenomenally quickly\", Mands says - and the work is included in the £20m build cost."
                            }
                        ]
                    },
                    {
                        "sense_id": "76e3f48c-9737-3ce9-934b-ac3b0a611a09",
                        "entry_id": "a8e30d68-fc74-3115-a32f-f70099c87236",
                        "glosses": [
