                        {
                            "text": "Het <w>mannetje</w> heeft vaak fellere kleuren dan het vrouwtje.",
                            "target_lang_translations": {
                                "en": "The <w>male</w> often has brighter colors than the female.",
                                "ru": "У <w>самца</w> окраска часто ярче, чем у самки.",
                                "pl": "<w>Samiec</w> ma często jaskrawsze kolory niż samica.",
                                "de": "Das <w>Männchen</w> hat oft kräftigere Farben als das Weibchen.",
                                "fr": "Le <w>mâle</w> a souvent des couleurs plus vives que la femelle.",
                                "it": "Il <w>maschio</w> ha spesso colori più vivaci della femmina.",
                                "cs": "<w>Samec</w> má často jasnější barvy než samice.",
                                "tr": "<w>Erkek</w> hayvanın renkleri genellikle dişininkinden daha canlıdır.",
                                "es": "El <w>macho</w> suele tener colores más brillantes que la hembra.",
                                "zh": "<w>雄性</w>的颜色通常比雌性更鲜艳。"
                            }
                        },
                        {
                            "text": "Bij deze vogelsoort bouwt het <w>mannetje</w> het nest.",
                            "target_lang_translations": {
