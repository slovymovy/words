                                        "entry_id": "56442f3e-a78e-32b5-a52c-9ff2a673e65d",
                                        "glosses": [
                                            "door de wet gedwongen betaling aan de overheid zonder individuele tegenprestatie van die overheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bae494b-0cf0-4379-8c01-4221b1ad7d1e",
                                                "sense_id": "de7fae15-801f-317c-bd9a-2b7590b93444",
                                                "text": "De omzetbelasting en winstbelasting zijn de bekendste vormen van belasting voor een bedrijf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51eddf93-acdf-3e17-8aac-84d75193ad29",
                                        "entry_id": "56442f3e-a78e-32b5-a52c-9ff2a673e65d",
                                        "glosses": [
                                            "de mate waarin een machine belast wordt, ofwel het vermogen dat van de machine verlangd wordt door de aangesloten apparatuur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c69a724-a5cf-4e9c-8071-35e458a9a69c",
                                                "sense_id": "51eddf93-acdf-3e17-8aac-84d75193ad29",
                                                "text": "Zowel de normale als maximale belasting van deze machine zijn nog niet bekendgegeven."
                                            },
                                            {
                                                "example_id": "7d08d792-23a4-4b3f-b915-78975a3f3b0a",
                                                "sense_id": "51eddf93-acdf-3e17-8aac-84d75193ad29",
                                                "text": "En als de gesprekken na het eten waren gegaan over de maximale belasting van de zesentwintig paalgroepen of het aantal palen in elke groep, of de te verwachten problemen wanneer je boven op deze palen het waarschijnlijk grootste vakwerk van hout gaat bouwen, dan was hij er graag bij geweest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4281b59f-51ac-3a5f-a74b-68e63eb744c8",
                                        "entry_id": "56442f3e-a78e-32b5-a52c-9ff2a673e65d",
                                        "glosses": [
                                            "verantwoordelijkheid, inspanning die een taak vergt, psychische druk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
