                "senses": [
                    {
                        "sense_id": "f98abd57-2e02-34e7-9bd3-8cc9ee9cffe4",
                        "entry_id": "31c13b6e-555f-3cc9-a390-a040d952367d",
                        "glosses": [
                            "Eigenschaft, stimmungsmäßig trostlos, bedrückend zu sein oder zu wirken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab988a56-6f32-41c7-8c82-092ca753741b",
                                "sense_id": "f98abd57-2e02-34e7-9bd3-8cc9ee9cffe4",
                                "text": "„Das Lampenlicht vertrieb die Trübseligkeit der fahlschimmernden Vorhänge und ließ ihn das Grau des Himmels vergessen, das durch die kleinsten Spalten zu ihm dringen wollte, gleich erstickendem Staub.“"
                            },
                            {
                                "example_id": "44387aac-f4fd-4c13-b59e-ade3290dcc96",
                                "sense_id": "f98abd57-2e02-34e7-9bd3-8cc9ee9cffe4",
                                "text": "„Sie leidet an Angstzuständen, aber auch vermehrt an Trübseligkeit und Lethargie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b098761c-4cf6-3552-87e3-942baccf2372",
                        "entry_id": "31c13b6e-555f-3cc9-a390-a040d952367d",
                        "glosses": [
                            "etwas, das trübselig, deprimierend ist oder wirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b44ae19-3dbc-4543-882f-3b56163ae4be",
                                "sense_id": "b098761c-4cf6-3552-87e3-942baccf2372",
                                "text": "„Ein feiner Nebel stieg auf; eine graue Trübseligkeit lagerte auf den leeren Pavillons, nur unterbrochen von den düsteren, gelben Flammen der Gaslaternen.“"
                            },
                            {
                                "example_id": "5f907a22-b068-40e0-a1de-cdee311e23b2",
                                "sense_id": "b098761c-4cf6-3552-87e3-942baccf2372",
                                "text": "„Meine Art und Gewohnheit, in der Bibel zu lesen, führt immer aus Trübseligkeiten heraus, gerade dann auch, wenn ich auf die Beschwörungen der irdischen Trübseligkeiten stoße.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
