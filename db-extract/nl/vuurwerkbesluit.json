                        "glosses": [
                            "een Nederlandse algemene maatregel van bestuur uit 1993 die regels stelt voor consumenten- en professioneel vuurwerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cea270c-bff4-4bc0-a593-7b0d407247d8",
                                "sense_id": "29b7762e-0461-3ba1-8612-8a252b3a8e05",
                                "text": "Hilversum mag het afsteken van vuurwerk in het centrum en winkelgebied verbieden. Dat heeft de Raad van State beslist. Die vindt dat het college bevoegd is om het vuurwerkbesluit in te stellen."
                            },
                            {
                                "example_id": "480a96e9-a3c3-4424-9ce9-52422d645b8f",
                                "sense_id": "29b7762e-0461-3ba1-8612-8a252b3a8e05",
                                "text": "In Nederland duurt het aftellen nog even. Sinds 18.00 uur is het al wel toegestaan om vuurwerk af te steken. Bij de vorige jaarwisseling mocht dat vanaf 10.00 uur 's morgens, maar met het nieuwe vuurwerkbesluit mag het nu dus pas 's avonds. Er mag geknald worden tot 2.00 uur vannacht."
                            }
                        ]
