                "senses": [
                    {
                        "sense_id": "028e3b0a-d763-3b49-ba6e-c6b218193f6d",
                        "entry_id": "76677e69-f946-3940-9790-a5a369012b36",
                        "glosses": [
                            "to be becoming, to befit (be appropriate due to adopted social norms)"
                        ],
                        "tags": [
                            "archaic",
                            "imperfective",
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "5bf9fb2b-14b1-461c-a36d-fbb5048d2ce8",
                                "sense_id": "028e3b0a-d763-3b49-ba6e-c6b218193f6d",
                                "text": "Taka próżność nie przystoi mężczyźnie w moim wieku.",
                                "translation": "Such vanity is unbecoming in a man my age.",
                                "english": "Such vanity is unbecoming in a man my age."
                            },
                            {
                                "example_id": "a1ec2f02-0639-4644-ae39-673b62517265",
                                "sense_id": "028e3b0a-d763-3b49-ba6e-c6b218193f6d",
                                "text": "Księżniczko, to nie przystoi damie.",
                                "translation": "Princess, that is not very ladylike.",
                                "english": "Princess, that is not very ladylike."
                            },
                            {
                                "example_id": "662fbde8-f57e-4646-b702-c287f2d4f92c",
                                "sense_id": "028e3b0a-d763-3b49-ba6e-c6b218193f6d",
                                "text": "Potem załatwimy to jak przystało na ludzi honoru.",
                                "translation": "Then we will resolve this matter like gentlemen.",
                                "english": "Then we will resolve this matter like gentlemen."
                            }
                        ]
                    }
