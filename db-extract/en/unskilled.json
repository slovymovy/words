                        "sense_id": "896c70a0-b419-3592-a741-450468af4a09",
                        "entry_id": "b4c70543-ebc0-3ed1-9894-b9b289ff8639",
                        "glosses": [
                            "Of a person or workforce: not having a skill or technical training."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93b703eb-7652-43de-9a7a-277472fb81e3",
                                "sense_id": "896c70a0-b419-3592-a741-450468af4a09",
                                "text": "In the autumn there was a row at some cement works about the unskilled labour men. A union had just been started for them and all but a few joined. One of these blacklegs was laid for by a picket and knocked out of time."
                            },
                            {
                                "example_id": "08ac32bb-fa5a-4f06-85b6-0fbdd232acee",
                                "sense_id": "896c70a0-b419-3592-a741-450468af4a09",
                                "text": "Set against the background of the American civil war, with Keaton a cunning but unskilled driver, unaided, of the ponderous giant of a locomotive, it remains not only probably the funniest film about railways ever made, but one of the funniest silent films to retain its comic power over today's more sophisticated audiences."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bd018bf-9b7c-33a9-b033-65fe0842e6ee",
                        "entry_id": "b4c70543-ebc0-3ed1-9894-b9b289ff8639",
                        "glosses": [
                            "Of a job: not requiring skill or training."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80cba36b-fd78-4be5-a52a-ec36d6bf1526",
                                "sense_id": "1bd018bf-9b7c-33a9-b033-65fe0842e6ee",
                                "text": "The minimum hourly wage for construction workers has increased to NOK 250,30 per hour for skilled workers and NOK 226,90 for unskilled workers, with an additional rate of NOK 235,80 for unskilled workers with at least one year’s experience in the industry."
                            }
                        ]
                    },
