                "translations": [
                    {
                        "translation_id": "538ff477-9393-4a3e-9549-28367a380810",
                        "source_entry_id": "8f2566c1-6d5b-37b8-8f5f-8f25d351bdf5",
                        "source_sense_id": "9cac0da9-727e-38e4-8762-5784f4ab241e",
                        "target_lang_word": "Aufstieg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufstieg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5405fdf-a359-3822-9143-7d5a9cf4842d",
                                        "entry_id": "4d873e13-6a1d-3220-9dc1-5dec885d9d20",
                                        "glosses": [
                                            "Aufwärtsentwicklung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d434bf0-0988-477b-8c53-2f146d649954",
                                                "sense_id": "a5405fdf-a359-3822-9143-7d5a9cf4842d",
                                                "text": "Der Aufstieg der Wirtschaft verbesserte die Lage der Bevölkerung."
                                            },
                                            {
                                                "example_id": "3dcc8fcc-f98e-403d-93c0-c475ac6cbd08",
                                                "sense_id": "a5405fdf-a359-3822-9143-7d5a9cf4842d",
                                                "text": "[Japan:] „Der Shinkansen stand stellvertretend für den rasanten, wirtschaftlichen Aufstieg nach dem Zweiten Weltkrieg.“"
                                            },
                                            {
                                                "example_id": "b8fbfc49-7745-4c4d-81d9-7066b7f962de",
                                                "sense_id": "a5405fdf-a359-3822-9143-7d5a9cf4842d",
                                                "text": "Der fleißige Industriearbeiter hatte einen großen Aufstieg gemacht."
                                            },
                                            {
                                                "example_id": "edb70e42-665c-4c7c-80be-00b2f6e426f3",
                                                "sense_id": "a5405fdf-a359-3822-9143-7d5a9cf4842d",
                                                "text": "[Angestellte in den 1920er Jahre:] „Für viele bedeutete es einen sozialen Aufstieg, wenn sie sich nicht in Landwirtschaft und Fabrik „die Hände schmutzig machen mussten“.“"
                                            },
                                            {
                                                "example_id": "aaabed96-abaa-455a-a543-6ea2886ee22d",
                                                "sense_id": "a5405fdf-a359-3822-9143-7d5a9cf4842d",
                                                "text": "„Der Aufstieg der Niederlande begann mit einer Niederlage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "03b626e7-34b2-3881-8990-893345c9f758",
                                        "entry_id": "4d873e13-6a1d-3220-9dc1-5dec885d9d20",
                                        "glosses": [
                                            "das Emporsteigen, Hinaufsteigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20d0e117-7b71-4f8b-b978-2e4573e32e38",
                                                "sense_id": "03b626e7-34b2-3881-8990-893345c9f758",
                                                "text": "Der Aufstieg zum Gipfel war beschwerlich, aber die Aussicht machte das wieder wett."
                                            },
                                            {
                                                "example_id": "746a0370-c223-4e03-a7dd-05baee9ecf68",
                                                "sense_id": "03b626e7-34b2-3881-8990-893345c9f758",
                                                "text": "„Fünf Minuten später begannen wir den Aufstieg zu Spy-Glass-Berg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2dee1117-dbbc-377e-866a-c4d94d336863",
                                        "entry_id": "4d873e13-6a1d-3220-9dc1-5dec885d9d20",
                                        "glosses": [
                                            "aufwärtsführender Weg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c4f5d8-801f-41bd-8296-9218a3ce8d7a",
                                                "sense_id": "2dee1117-dbbc-377e-866a-c4d94d336863",
                                                "text": "Auf den Berg gibt es einen steilen Aufstieg und eine Gondelbahn."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c7d8637c-a015-3ba6-9276-89ae3970887e",
                                        "entry_id": "4d873e13-6a1d-3220-9dc1-5dec885d9d20",
                                        "glosses": [
                                            "Treppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b94ac2e5-df8a-485a-b1b2-b8d137bb5c4e",
                                                "sense_id": "c7d8637c-a015-3ba6-9276-89ae3970887e",
                                                "text": "Der Aufstieg zur Haustür hatte vier Stufen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d74218a7-1032-36e1-8d2c-b9b3a3c2c9ae",
                                        "entry_id": "4d873e13-6a1d-3220-9dc1-5dec885d9d20",
                                        "glosses": [
                                            "das Hochfliegen, In-die-Luft-Steigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe5b1e63-38de-4fa3-870d-14089f4cbc3c",
                                                "sense_id": "d74218a7-1032-36e1-8d2c-b9b3a3c2c9ae",
                                                "text": "„Seine windschnittigen Formel-1-Fahrstühle sind wie Flugzeuge luftdicht versiegelt und mit automatischem Druckausgleich – sonst wäre der schnelle Aufstieg für Menschen unangenehm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "30b5d60e-99de-3992-9713-62cdc3edfac2",
                                        "entry_id": "4d873e13-6a1d-3220-9dc1-5dec885d9d20",
                                        "glosses": [
                                            "Wechsel in eine höhere Liga"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e917e038-efd7-4c45-b0d0-cd24924b305e",
                                                "sense_id": "30b5d60e-99de-3992-9713-62cdc3edfac2",
                                                "text": "Der Aufstieg des Vereins in die Bundesliga wurde sehr gefeiert."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b10d77eb-71d3-4a36-b91f-cea416fa5c4c",
                        "source_entry_id": "8f2566c1-6d5b-37b8-8f5f-8f25d351bdf5",
                        "source_sense_id": "9cac0da9-727e-38e4-8762-5784f4ab241e",
                        "target_lang_word": "ascension",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ascension",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14fe05b1-d8a2-3c99-ac3a-a51255c62e18",
                                        "entry_id": "0eeca843-d761-32c9-a5c7-2b5455100d31",
                                        "glosses": [
                                            "Action de monter, de s’élever."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18a84197-e71d-46eb-9338-b43dc5e63aa7",
                                                "sense_id": "14fe05b1-d8a2-3c99-ac3a-a51255c62e18",
                                                "text": "Il y a tantôt soixante-sept ans que les ballons sillonnent l'espace, et cependant, à chaque ascension, une sorte de curiosité inquiète rassemble autour de l'aérostat une foule aussi nombreuse que si c'était la première fois que ce spectacle fût donné aux hommes."
                                            },
                                            {
                                                "example_id": "74c7b97f-bdbb-46d5-abaf-0156bcb88a0c",
                                                "sense_id": "14fe05b1-d8a2-3c99-ac3a-a51255c62e18",
                                                "text": "Outre l’ascension du peintre refoulé devenu soldat fanatique puis sauveur vénéré d’une Allemagne en perdition, le musée abordait l’Holocauste et ses millions de victimes, photographies sans concession à l’appui, montrant comment la folie d’une poignée d’individus ultradéterminés avait mené le pays dans l’horreur."
                                            },
                                            {
                                                "example_id": "8d673386-4a20-402f-8bad-7ec3d75deb43",
                                                "sense_id": "14fe05b1-d8a2-3c99-ac3a-a51255c62e18",
                                                "text": "Les membres de la petite bourgeoisie sont caractérisés par un habitus fondé sur la restriction par prétention, le volontarisme rigoriste liés à leur volonté d’ascension sociale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "683b55e1-a368-305f-962e-76063afe7690",
                                        "entry_id": "0eeca843-d761-32c9-a5c7-2b5455100d31",
                                        "glosses": [
                                            "Action de gravir une montagne."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e8ed17b-e30c-414a-b213-ee119f3aa67c",
                                                "sense_id": "683b55e1-a368-305f-962e-76063afe7690",
                                                "text": "Nous profitons de la clarté pour faire l’ascension d’une montagne de 400 mètres de hauteur qui domine Thorshavn."
                                            },
                                            {
                                                "example_id": "3531feb3-b119-4698-853c-5e1d8573fa01",
                                                "sense_id": "683b55e1-a368-305f-962e-76063afe7690",
                                                "text": "En trois jours, en trois arrivées totalement différentes, le patron du Tour a marqué les esprits : adroit et offensif sur les pavés, surpuissant dans un sprint en côte, ultra-déterminé et impitoyable après les 7 km d’ascension de la Planche."
                                            },
                                            {
                                                "example_id": "98adfe6c-1b86-46b7-bb11-9c732417a28e",
                                                "sense_id": "683b55e1-a368-305f-962e-76063afe7690",
                                                "text": "On a beau adorer les Pyrénées, […], on n'est pas obligé de faire sien l'agaçant néologisme de « pyrénéisme ». Yves Ballu n'a, certes, pas tort lorsqu'il dénonce comme une « injustice du dictionnaire », une « indélicatesse » vis-à-vis des Pyrénéens, la captation par les Alpes du mot « alpinisme » pour désigner les ascensions en montagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1156a87-2891-31a1-b833-1fe6c25941b2",
                                        "entry_id": "0eeca843-d761-32c9-a5c7-2b5455100d31",
                                        "glosses": [
                                            "Point de l’équateur qui se lève en même temps qu’un astre dans la sphère droite ou dans la sphère oblique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5c30d8b-09e2-4655-bffa-a52640f82e3b",
                                                "sense_id": "c1156a87-2891-31a1-b833-1fe6c25941b2",
                                                "text": "Ascension droite d’un astre. — Ascension oblique d’un astre."
                                            }
                                        ]
                                    },
