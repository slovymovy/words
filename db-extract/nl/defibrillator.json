                        "entry_id": "7d446492-9587-3e01-94a6-05d3ef370509",
                        "glosses": [
                            "een apparaat waarmee met behulp van stroomstoten het normale hartritme hersteld kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c782bea-7bce-4896-962f-f369311007f1",
                                "sense_id": "1f36ad8f-57c4-3388-8a0e-1701be0f30ed",
                                "text": "Dankzij de defibrillator overleven veel mensen een hartaanval."
                            },
                            {
                                "example_id": "82cf934d-dc22-409c-a4fe-917e88ef4004",
                                "sense_id": "1f36ad8f-57c4-3388-8a0e-1701be0f30ed",
                                "text": "Ik heb de man gezien. Eén bonk vet. Geloof me, met nog geen tien defibrillators had men dat hart weer aan de praat gekregen."
                            }
                        ]
                    }
