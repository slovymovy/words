                "senses": [
                    {
                        "sense_id": "f29cb93a-a6ce-3e30-a773-ebd37ec8ade1",
                        "entry_id": "c26bab75-d6cb-3684-9a81-359d9071d3bd",
                        "glosses": [
                            "ein für Fußgänger bestimmtes Lichtsignal an Verkehrsampeln, das symbolisch eine Frau darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3292760-18d0-45c9-8407-62ee3fdd4c91",
                                "sense_id": "f29cb93a-a6ce-3e30-a773-ebd37ec8ade1",
                                "text": "Die erste Ampel mit einer Ampelfrau steht in Zwickau, weitere in Dresden."
                            },
                            {
                                "example_id": "190137c0-85de-4e4f-8f0b-beb15ace299b",
                                "sense_id": "f29cb93a-a6ce-3e30-a773-ebd37ec8ade1",
                                "text": "„Auch SPD-Ortsvereinsvorsitzende Cornelia Schmerbach wollte die Ehrenfelder Ampelfrauen - die Kosten liegen bei 100 Euro für alle vier Stück - eher als Symbol verstanden wissen.“"
                            },
                            {
                                "example_id": "636f6b86-99a2-4395-a2e8-4fdddc357d28",
                                "sense_id": "f29cb93a-a6ce-3e30-a773-ebd37ec8ade1",
                                "text": "„Ich habe gehört, dass sich die Gleichstellungsbeauftragten mehrerer deutscher Städte in einen neuen Kampf gestürzt haben: Die Ampelmännchen sollen durch Ampelfrauen ersetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
