        "nl-extract.jsonl": [
            {
                "entry_id": "ada3234d-f857-3a17-ab1c-00a26bd3f0b4",
                "word": "overtekenen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b5823d71-5cba-396c-a536-b199897b49b6",
                        "entry_id": "ada3234d-f857-3a17-ab1c-00a26bd3f0b4",
                        "glosses": [
                            "met behulp van half doorschijnend papier of projectie een afbeelding als tekening kopiëren, natekenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cdef2b5-a3dc-4a57-a10d-76a2b39016ea",
                                "sense_id": "b5823d71-5cba-396c-a536-b199897b49b6",
                                "text": "Wat blijkt? Veel van de scènes van Disney heb je al eerder gezien. Net als veel animatoren maken de tekenaars van Disney gebruik van rotoscoping, waarbij beelden worden geprojecteerd op een tekentafel, zodat de tekenaars het kunnen overtekenen."
                            },
                            {
                                "example_id": "0d44ca98-3dcc-4f2a-956d-a16739d54bdb",
                                "sense_id": "b5823d71-5cba-396c-a536-b199897b49b6",
                                "text": "‘Fotografie had in die tijd twee functies. Ze was enerzijds een archeologisch en antropologisch instrument – stel je voor dat onderzoekers alles wat ze tegenkwamen moesten overtekenen – en anderzijds een manier om iets kunstzinnigs en dromerigs weer te geven. Een mengeling. Half wetenschappelijk, half romantisch. Dat zit ook heel erg in deze foto.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d07d5ae-9033-3496-90b3-c807064d742f",
                        "entry_id": "ada3234d-f857-3a17-ab1c-00a26bd3f0b4",
                        "glosses": [
                            "voor een hoger bedrag inschrijven bij een effecten emissie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0752466-8983-40ec-9181-dc2b36debc09",
                                "sense_id": "7d07d5ae-9033-3496-90b3-c807064d742f",
                                "text": "Omdat de beursgang tot tien maal is overtekend voor beleggers, kan worden besloten om een zogenoemde green shoe uit te oefenen, waarbij er tijdens de beursgang extra aandelen worden verkocht. In dat geval komt de totale waarde van de beursgang op 22,1 miljard dollar. Dat is iets meer dan het vorige record. Dat betrof eveneens een Chinese bank, de Industrial and Commercial Bank of China (ICBC), in 2006."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecddd763-9627-4b1a-a505-2521fe4b26b5",
                        "source_entry_id": "ada3234d-f857-3a17-ab1c-00a26bd3f0b4",
                        "source_sense_id": "b5823d71-5cba-396c-a536-b199897b49b6",
                        "source_sense_description": "voor een hoger bedrag inschrijven bij een effecten emissie",
                        "target_lang_word": "oversubscribe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oversubscribe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f423f7b-acbf-3fe3-b877-a38dd4e23918",
                                        "entry_id": "2bac73b7-5d04-3891-977f-b53bda6d3d05",
                                        "glosses": [
                                            "To subscribe to an extent that is greater than the availability."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d6d230c-f7bc-411b-a051-a664173c6382",
                                                "sense_id": "3f423f7b-acbf-3fe3-b877-a38dd4e23918",
                                                "text": "The operator says its apprenticeship scheme is always oversubscribed, with more and more roles offered every year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "419192a1-a844-3859-b79c-6c10dd64a0c4",
                                        "entry_id": "2bac73b7-5d04-3891-977f-b53bda6d3d05",
                                        "glosses": [
                                            "To subscribe to an extent that is greater than the availability.",
                                            "To attempt to buy more shares than there are available."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "005b0bc5-a1f9-4a15-8b61-fb0330b6cc7a",
                                                "sense_id": "419192a1-a844-3859-b79c-6c10dd64a0c4",
                                                "text": "Société Générale said the approximately $8.4 billion it had raised in a rights offering of shares would allow it \"to continue its development in business and regions with high potential.\" Investors had sought to buy €10.2 billion worth of new shares, oversubscribing the offering by 184 percent, the bank said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2ba824d-9858-3a1d-adf7-291b6dbabdc6",
                                        "entry_id": "2bac73b7-5d04-3891-977f-b53bda6d3d05",
                                        "glosses": [
                                            "To use the oversubscription technique in multithreading."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60f6d61a-b2b7-3291-abc0-37b0149c3897",
                                        "entry_id": "2bac73b7-5d04-3891-977f-b53bda6d3d05",
                                        "glosses": [
                                            "To use the oversubscription technique in a computer network."
