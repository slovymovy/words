                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phenakistiscope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e507816-9e0f-3608-97f8-fe6177cde4a2",
                                        "entry_id": "936dff7e-8c93-3c99-9399-5a5a07733740",
                                        "glosses": [
                                            "Alternative form of phenakistoscope."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27ac3ebf-5960-4038-83d4-bd3b6c50e37b",
                                                "sense_id": "9e507816-9e0f-3608-97f8-fe6177cde4a2",
                                                "text": "Here are the intricately colored discs and paper strips of images that needed only devices like a zoetrope or phenakistiscope to become animated spectacles: a horse will jump through a hoop; a sailor will blow a bubble that becomes the moon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5d8e408-bcfd-4535-b3aa-603bba837d85",
                        "source_entry_id": "9bbb4a6e-9296-3e5a-b1a4-f6ffcd6e3b82",
                        "source_sense_id": "ac22f5a7-8922-3ace-b438-a84d54fcca9c",
                        "target_lang_word": "phenakistoscope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phenakistoscope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "044da66a-fe3d-3d28-a886-f613e218cb6c",
                                        "entry_id": "f2f54483-81db-35b0-ae91-8b91a772dff0",
                                        "glosses": [
                                            "An early animation device consisting of a disc or drum which rotated, showing successive images through slits, often via a mirror, thus producing the illusion of motion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15fdf32e-3d6d-4e74-919f-21749f64a7c6",
                        "source_entry_id": "9bbb4a6e-9296-3e5a-b1a4-f6ffcd6e3b82",
