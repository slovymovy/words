                                "example_id": "42b5f134-2b86-42e7-9cd8-834a55fb12ed",
                                "sense_id": "4ea730b7-66ba-3a1a-82e6-6c7ded41bbac",
                                "text": "„In jedem Haus, in jedem Zimmer stellen sie die Gebote ihres Propheten in Verspaaren zur Schau.“"
                            },
