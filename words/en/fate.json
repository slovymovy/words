{
    "word_family": [
        "fatal",
        "fatality",
        "fateful",
        "fatalism",
        "fatalist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e344dcb1-db9b-3722-ba67-c79a53821438",
                    "sense_definition": "The power believed to control all events in a way that cannot be resisted.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "fate_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt that <w>fate</w> had brought them together.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала, что их свела <w>судьба</w>.",
                                "fr": "Elle sentait que le <w>destin</w> les avait réunis."
                            }
                        },
                        {
                            "text": "We cannot escape our <w>fate</w> no matter how hard we try.",
                            "target_lang_translations": {
                                "ru": "Мы не можем уйти от своей <w>судьбы</w>, как бы мы ни старались.",
                                "fr": "Nous ne pouvons pas échapper à notre <w>destin</w>, peu importe nos efforts."
                            }
                        }
                    ],
                    "synonyms": [
                        "destiny",
                        "kismet",
                        "predestination",
                        "foreordination"
                    ],
                    "antonyms": [
                        "free will",
                        "choice",
                        "chance",
                        "accident"
                    ],
                    "common_phrases": [
                        "twist of fate",
                        "tempt fate",
                        "hand of fate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сила, которая, как считается, управляет всеми событиями и которой невозможно противостоять.",
                        "fr": "Une force mystérieuse considérée comme contrôlant tous les événements de manière irrévocable."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судьба",
                                "target_lang_sense_clarification": "высшая сила"
                            },
                            {
                                "target_lang_word": "рок",
                                "target_lang_sense_clarification": "злая судьба, фатум"
                            },
                            {
                                "target_lang_word": "фатум",
                                "target_lang_sense_clarification": "неотвратимая судьба (книжн.)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "destin",
                                "target_lang_sense_clarification": "puissance mystérieuse qui détermine les événements"
                            },
                            {
                                "target_lang_word": "destinée",
                                "target_lang_sense_clarification": "puissance suprême réglant le cours des choses"
                            },
                            {
                                "target_lang_word": "sort",
                                "target_lang_sense_clarification": "force aveugle régissant les événements"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4265b4c-76f9-3c40-9e26-4094800acbf6",
                    "sense_definition": "The future events that happen to a person or thing.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "fate_outcome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jury will decide the prisoner's <w>fate</w> tomorrow.",
                            "target_lang_translations": {
                                "ru": "Завтра присяжные решат <w>участь</w> заключенного.",
                                "fr": "Le jury décidera demain du <w>sort</w> du prisonnier."
                            }
                        },
                        {
                            "text": "He was anxious about the <w>fate</w> of his missing luggage.",
                            "target_lang_translations": {
                                "ru": "Он беспокоился о <w>судьбе</w> своего пропавшего багажа.",
                                "fr": "Il était inquiet au sujet du <w>sort</w> de ses bagages disparus."
                            }
                        }
                    ],
                    "synonyms": [
                        "destiny",
                        "lot",
                        "fortune"
                    ],
                    "common_phrases": [
                        "decide someone's fate",
                        "seal someone's fate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Будущие события, которые происходят с человеком или вещью.",
                        "fr": "Les événements futurs qui arrivent à une personne ou à une chose."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судьба",
                                "target_lang_sense_clarification": "жизненный путь, будущее"
                            },
                            {
                                "target_lang_word": "участь",
                                "target_lang_sense_clarification": "исход, положение дел"
                            },
                            {
                                "target_lang_word": "доля",
                                "target_lang_sense_clarification": "удел, жизненные обстоятельства"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sort",
                                "target_lang_sense_clarification": "ce qui arrive à quelqu'un ou quelque chose"
                            },
                            {
                                "target_lang_word": "destinée",
                                "target_lang_sense_clarification": "le cours de la vie d'une personne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "106ff6c6-7ee0-34fb-9a47-1c1757ed8324",
                    "sense_definition": "A negative outcome, such as death, ruin, or failure.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fate_outcome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers met a cruel <w>fate</w> on the battlefield.",
                            "target_lang_translations": {
                                "ru": "Солдаты встретили жестокую <w>участь</w> на поле битвы.",
                                "fr": "Les soldats ont connu un <w>sort</w> cruel sur le champ de bataille."
                            }
                        },
                        {
                            "text": "She wanted to avoid the <w>fate</w> of her predecessors.",
                            "target_lang_translations": {
                                "ru": "Она хотела избежать <w>участи</w> своих предшественников.",
                                "fr": "Elle voulait éviter le <w>sort</w> de ses prédécesseurs."
                            }
                        }
                    ],
                    "synonyms": [
                        "doom"
                    ],
                    "common_phrases": [
                        "meet one's fate",
                        "terrible fate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Негативный исход, такой как смерть, разорение или неудача.",
                        "fr": "Un résultat négatif, tel que la mort, la ruine ou l'échec."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "участь",
                                "target_lang_sense_clarification": "печальная судьба"
                            },
                            {
                                "target_lang_word": "рок",
                                "target_lang_sense_clarification": "гибель, неизбежность"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sort",
                                "target_lang_sense_clarification": "issue malheureuse ou tragique"
                            },
                            {
                                "target_lang_word": "fin",
                                "target_lang_sense_clarification": "issue fatale ou mort"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3bfaa4a-b592-3d9b-8c7b-70b9388f0e57",
                    "sense_definition": "The final form or location of a chemical substance in the environment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fate_technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists studied the environmental <w>fate</w> of the pesticide.",
                            "target_lang_translations": {
                                "ru": "Ученые изучали экологическую <w>судьбу</w> пестицида.",
                                "fr": "Les scientifiques ont étudié le <w>devenir</w> environnemental du pesticide."
                            }
                        },
                        {
                            "text": "The <w>fate</w> of the pollutant depends on water temperature.",
                            "target_lang_translations": {
                                "ru": "<w>Судьба</w> загрязнителя зависит от температуры воды.",
                                "fr": "Le <w>devenir</w> du polluant dépend de la température de l'eau."
                            }
                        }
                    ],
                    "common_phrases": [
                        "environmental fate",
                        "chemical fate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конечная форма или местонахождение химического вещества в окружающей среде.",
                        "fr": "La forme ou l'emplacement final d'une substance chimique dans l'environnement."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судьба",
                                "target_lang_sense_clarification": "в научном контексте"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "devenir",
                                "target_lang_sense_clarification": "évolution ou état final d'une substance"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d2f4d1a-467f-34be-b290-954f53de7382",
                    "sense_definition": "To predetermine or destine something to happen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>fated</w> to become a great leader.",
                            "target_lang_translations": {
                                "ru": "Ему было <w>суждено</w> стать великим лидером.",
                                "fr": "Il était <w>destiné</w> à devenir un grand dirigeant."
                            }
                        },
                        {
                            "text": "The project was <w>fated</w> to fail from the beginning.",
                            "target_lang_translations": {
                                "ru": "Проект был <w>обречен</w> на провал с самого начала.",
                                "fr": "Le projet était <w>voué</w> à l'échec dès le début."
                            }
                        }
                    ],
                    "synonyms": [
                        "foredoom",
                        "doom"
                    ],
                    "common_phrases": [
                        "fated to be",
                        "fated to die"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предопределять или предначертывать, чтобы что-то случилось.",
                        "fr": "Prédéterminer ou destiner quelque chose à se produire."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предопределять",
                                "target_lang_sense_clarification": "определять заранее"
                            },
                            {
                                "target_lang_word": "быть суждено",
                                "target_lang_sense_clarification": "о неизбежном будущем"
                            },
                            {
                                "target_lang_word": "обрекать",
                                "target_lang_sense_clarification": "на неудачу или гибель"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "être destiné à",
                                "target_lang_sense_clarification": "prévu par le destin"
                            },
                            {
                                "target_lang_word": "être voué à",
                                "target_lang_sense_clarification": "condamné ou destiné à un résultat"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b505b1b4-1a09-3060-8905-1127414c410a",
                    "sense_definition": "The three goddesses in Greek and Roman mythology who controlled human destiny.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "The hero tried to outwit the <w>Fates</w>.",
                            "target_lang_translations": {
                                "ru": "Герой пытался перехитрить <w>Мойр</w>.",
                                "fr": "Le héros a essayé de déjouer les <w>Moires</w>."
                            }
                        },
                        {
                            "text": "In the story, the <w>Fates</w> spin the thread of life.",
                            "target_lang_translations": {
                                "ru": "В этой истории <w>Мойры</w> прядут нить жизни.",
                                "fr": "Dans l'histoire, les <w>Parques</w> filent le fil de la vie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Три богини в греческой и римской мифологии, управлявшие человеческой судьбой.",
                        "fr": "Les trois déesses de la mythologie grecque et romaine qui contrôlaient le destin humain."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мойры",
                                "target_lang_sense_clarification": "в греческой мифологии"
                            },
                            {
                                "target_lang_word": "Парки",
                                "target_lang_sense_clarification": "в римской мифологии"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "Moires",
                                "target_lang_sense_clarification": "dans la mythologie grecque"
                            },
                            {
                                "target_lang_word": "Parques",
                                "target_lang_sense_clarification": "dans la mythologie romaine"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}