        "fr-extract.jsonl": [
            {
                "entry_id": "e746c938-5cf0-3c8b-b517-57bf62a0c9fd",
                "word": "atonie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c444694a-1a9b-4bdb-a3bd-317e6cf41bc5",
                        "entry_id": "e746c938-5cf0-3c8b-b517-57bf62a0c9fd",
                        "tags": [
                            "plural"
                        ],
                        "form": "atonies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ab9094e-0c24-37ef-aea0-144813183635",
                        "entry_id": "e746c938-5cf0-3c8b-b517-57bf62a0c9fd",
                        "glosses": [
                            "Diminution de l’élasticité des tissus contractiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c1004cc-bf1a-4e79-b330-edfe723fe826",
                                "sense_id": "8ab9094e-0c24-37ef-aea0-144813183635",
                                "text": "Atonie de l’estomac. Atonie générale. L’atonie d’un muscle."
                            }
                        ]
                    },
                    {
                        "sense_id": "80dc0f45-a8f5-351b-8a2b-5f88bd2ccb9d",
                        "entry_id": "e746c938-5cf0-3c8b-b517-57bf62a0c9fd",
                        "glosses": [
                            "Manque d’activité et de vigueur."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "753048bb-4721-485b-bb72-19697c6b384d",
                                "sense_id": "80dc0f45-a8f5-351b-8a2b-5f88bd2ccb9d",
                                "text": "Le vrai danger de la grande maturité, c'est l'atonie, la lassitude érigée en philosophie."
                            },
                            {
                                "example_id": "b57fa562-b734-45e0-ac0a-948ebfa32c6e",
                                "sense_id": "80dc0f45-a8f5-351b-8a2b-5f88bd2ccb9d",
                                "text": "Dans l’absence de tout repère visible, je sentais monter en moi cette atonie légère et progressive du sens de l’orientation et de la distance qui nous immobilise avant tout indice, comme l’étourdissement commençant d’un malaise, au milieu d’une route où l’on s’est égaré."
                            },
                            {
                                "example_id": "335910a9-9b8a-480b-8fa2-4b48723d07bb",
                                "sense_id": "80dc0f45-a8f5-351b-8a2b-5f88bd2ccb9d",
                                "text": "Il n'est rien de pire aujourd'hui que de fournir des prétextes à son indifférence et à son atonie."
                            },
                            {
                                "example_id": "553ac7ac-2b27-4ef5-9a10-57dd076a8b48",
                                "sense_id": "80dc0f45-a8f5-351b-8a2b-5f88bd2ccb9d",
                                "text": "Dans cet état, il n’existerait pour l’organisme, dans le cas d’un être idéalement constitué, ni contraction, ni détente : un bel et bon équilibre : une atonie."
                            }
                        ]
                    }
                ],
