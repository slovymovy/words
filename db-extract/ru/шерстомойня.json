                        "source_sense_id": "043336ca-4959-314e-913f-ee42d9db26b8",
                        "target_lang_word": "wool",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wool",
