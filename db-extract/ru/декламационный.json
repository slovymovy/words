                                "target_senses": [
                                    {
                                        "sense_id": "bec5c758-e2cc-362f-9316-ab33b7dcbb0f",
                                        "entry_id": "b82381a4-1161-3c6f-92c8-730e617661aa",
                                        "glosses": [
                                            "Having the quality of a declamation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e705df7a-3011-3bc5-be93-b173c68c98f2",
                                        "entry_id": "b82381a4-1161-3c6f-92c8-730e617661aa",
                                        "glosses": [
                                            "Pretentiously lofty in style; bombastic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58d74da3-3ac6-477d-9353-ff1ecb19059d",
                                                "sense_id": "e705df7a-3011-3bc5-be93-b173c68c98f2",
                                                "text": "He is described as having spoken for nearly an hour with great confidence in a highly declamatory tone, and with studied action, impressing all present who had ever heard of Cicero or Hortensius with the belief that he had worked himself up into the notion of being one or both of them for the occasion."
                                            },
                                            {
                                                "example_id": "b1a4054f-295c-4550-990f-a30c596e5796",
                                                "sense_id": "e705df7a-3011-3bc5-be93-b173c68c98f2",
                                                "text": "Behind him an excitable Frenchman was holding forth in declamatory style to a group of astonished residents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ede8ecf3-b547-4388-a35c-5d1afa96af76",
                        "source_entry_id": "e91d8420-0980-3860-a677-6784b8376680",
                        "source_sense_id": "89dbcac0-ea88-3684-8593-358dc457b184",
                        "target_lang_word": "declamatorio",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "declamatorio",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "49b09d0d-de33-3e63-a426-7accfb623df9",
                                        "entry_id": "9af10ca1-998f-3388-86e7-cac22d8bfeb9",
                                        "glosses": [
                                            "Que pertenece o concierne a la declamación.http://books.google.es/books?id=FoBE9EDhqlAC&pg=PA288&dq=%22declamatorio%22"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0267b34-bb62-4970-bfe3-b0144fcaee9e",
                                                "sense_id": "49b09d0d-de33-3e63-a426-7accfb623df9",
                                                "text": "En el coro, el efecto declamatorio se hace más evidente si una voz del mismo canta una parte a solo"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ef3c863e-f0f0-311e-bde6-08a8804044a6",
                                        "entry_id": "9af10ca1-998f-3388-86e7-cac22d8bfeb9",
                                        "glosses": [
                                            "Se dice del estilo o tono empleado para suplir con lo enfático y exagerado de la expresión la falta de efecto o ideas capaces de acalorar el ánimo verdaderamente. Que tiene una solemnidad inapropiada."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "475f3a0c-8896-435e-8795-3f5732fd0c0a",
                                                "sense_id": "ef3c863e-f0f0-311e-bde6-08a8804044a6",
                                                "text": "Los sentimientos morales y las reflexiones hacen pedantesco y declamatorio al drama"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
