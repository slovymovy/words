                ],
                "senses": [
                    {
                        "sense_id": "80cff85a-b427-3ef9-a7bd-e7fa8afc5387",
                        "entry_id": "2def24c3-8270-36b7-8fa7-445ecc973b6b",
                        "glosses": [
                            "Täuschungsmanöver zur Verwirrung der Sinne und des Verstandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc18e72f-b990-43f7-a7a5-e5b678d4f4ca",
                                "sense_id": "80cff85a-b427-3ef9-a7bd-e7fa8afc5387",
                                "text": "„Von den Träumen dieser Nacht ist mein armer Kopfe beständig voll von tausend Gaukelspielen, von Schalmeien und Trompeten, Kreuzen und Prozessionen, Büßenden und Geißeln.“"
                            },
                            {
                                "example_id": "9aeca501-c451-4a28-9e07-92417828250b",
                                "sense_id": "80cff85a-b427-3ef9-a7bd-e7fa8afc5387",
                                "text": "„Die Kamera, ebenfalls von Król selbst geführt, unterstützt auf ihre Art das Gaukelspiel des Gedächtnisses.“"
                            },
                            {
                                "example_id": "56f8c962-f4cf-4c19-9f99-0002f5d64c14",
                                "sense_id": "80cff85a-b427-3ef9-a7bd-e7fa8afc5387",
                                "text": "„Viele Gründe gibt es dafür – Not, Zwang, Verlegenheit oder einfach Lust am Gaukelspiel.“"
                            },
                            {
                                "example_id": "410d326a-cef5-40ef-b1d3-cd6770a05d2c",
                                "sense_id": "80cff85a-b427-3ef9-a7bd-e7fa8afc5387",
                                "text": "„Nun wird deutlich, daß die Bildskepsis der Reformatoren in der langen Tradition steht, die mit Platons Republik beginnt, wo im 10. Buch gezeigt wird, daß das Bett, das der Wesenbildner ersinnt, nichts mit dem Bett des Tischlers und noch weniger mit dem Bett des Malers – einem Gaukelspiel, einer Lüge – zu tun hat.“"
                            },
                            {
                                "example_id": "60111a5d-e693-48c6-81f6-9ad31778c540",
                                "sense_id": "80cff85a-b427-3ef9-a7bd-e7fa8afc5387",
                                "text": "„Hoffentlich merken die Feingeistigen, daß ich den Versuch gemacht habe, Stile zu wechseln und mit einem kleinen, ganz unliterarischen Ball meine Gaukelspiele zu treiben – nur so zum literarischen Spaß, damit die Leute etwas haben, was sie sich – wie in alten Zeiten, als es noch kein Radio und Fernsehen gab vorlesen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
