                        "sense_id": "d9295856-17cf-30c3-aacc-91d4f25f7495",
                        "entry_id": "456492de-8f21-34c7-bc55-9adfb06ed04a",
                        "glosses": [
                            "In a thrilling manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3a52984-7885-4f7f-abe5-c363fde1c948",
                                "sense_id": "d9295856-17cf-30c3-aacc-91d4f25f7495",
                                "text": "She held up her hands, and gazing upon me, uttered various exclamations which I could not understand. I could only remark that her accents were thrillingly musical."
                            },
                            {
                                "example_id": "5cb465a4-b44b-4fe7-8538-ee1d34a2c33b",
                                "sense_id": "d9295856-17cf-30c3-aacc-91d4f25f7495",
                                "text": "She spoke again, but in a less excited tone, although it was thrillingly earnest."
                            },
                            {
                                "example_id": "9d2182b6-58a1-43b7-af48-cdb28bf3782e",
                                "sense_id": "d9295856-17cf-30c3-aacc-91d4f25f7495",
                                "text": "Actually, Billy’s outward listlessness was a screen. The listlessness concealed a mind which was fizzing and flashing thrillingly."
                            },
                            {
                                "example_id": "a3bc3a3b-b489-4e22-b4fe-f397e64c28eb",
                                "sense_id": "d9295856-17cf-30c3-aacc-91d4f25f7495",
                                "text": "They had started so thrillingly but all their early momentum was lost once Salah went off. It never properly came back and the players in red took a long time – too long, probably – to adjust to being without the man who had scored 44 times over a record-breaking season."
                            }
                        ]
                    }
