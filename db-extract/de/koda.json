                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af2251d4-6263-4fe3-a25e-3abbc8c53dec",
                                "sense_id": "7e31c627-f667-38f6-86b7-ba922e77d940",
                                "text": "„Graphematisch sind sie jedoch fremd, weil sie trotz des ungespannten Stammvokals ein einfaches Konsonantgraphem in der Koda der Schreibsilbe haben.“"
                            }
