                    {
                        "sense_id": "7d3005d0-a974-3649-a4b3-e8cadeed6848",
                        "entry_id": "4a203a48-ec3c-36fc-b895-fa8335058bb7",
                        "glosses": [
                            "Altérer l’ADN en rompant le lien entre une purine (adénine ou guanine) et le désoxyribose auquel elle est attachée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc09251d-4cc9-4b88-8dc8-a235bdd5a92b",
                                "sense_id": "7d3005d0-a974-3649-a4b3-e8cadeed6848",
                                "text": "L’ADN séparé a été ensuite dépuriné (15 min. dans 0,25 N HC1), dénaturé (30 min. 0,5 N NaOH, 1 M NaCl), puis neutralisé (30 min. dans 0,5 M Tris-HCl pH = 7,5)."
                            },
                            {
                                "example_id": "2c8c91f4-6c60-4eb8-9002-b9ef10914f6c",
                                "sense_id": "7d3005d0-a974-3649-a4b3-e8cadeed6848",
                                "text": "On aboutit à un brin de DNA dépuriné ou dépyrimidé en un point."
                            },
                            {
                                "example_id": "6431f8e5-16e6-404d-9197-31e28043912b",
                                "sense_id": "7d3005d0-a974-3649-a4b3-e8cadeed6848",
                                "text": "Ensuite, l’ADN en milieu acide va perdre des bases G et A (il \"dépurine\") (rupture de liaisons glycosidiques)."
                            }
                        ]
                    }
                ],
