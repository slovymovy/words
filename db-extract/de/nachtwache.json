                ],
                "senses": [
                    {
                        "sense_id": "1569b1ef-cad9-3369-b1f9-b2731a27b9d9",
                        "entry_id": "88523dc2-9e04-3c6e-8d33-0dd322332b99",
                        "glosses": [
                            "Aufsicht während der Nacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed9b4a2f-0f3b-440c-9ea1-8f3a16bf4628",
                                "sense_id": "1569b1ef-cad9-3369-b1f9-b2731a27b9d9",
                                "text": "„Der Matrose der Nachtwache, der mich wecken wollte, als um halb sechs die Arbeiter an Bord kamen, fand mich zu seinem Erstaunen lesend in einem Sessel.“"
                            },
                            {
                                "example_id": "caa41c3c-9047-4f7e-bc90-74c4d5e853de",
                                "sense_id": "1569b1ef-cad9-3369-b1f9-b2731a27b9d9",
                                "text": "„Es sei eine lange Nachwache geworden.“"
                            },
                            {
                                "example_id": "fc647e9e-0a18-42e3-9ff2-fbbc924bc059",
                                "sense_id": "1569b1ef-cad9-3369-b1f9-b2731a27b9d9",
                                "text": "„Gleich nach der Nachtwache fange er an.“"
                            },
                            {
                                "example_id": "826c97a3-e47c-4adc-a5ce-943beb8ae71e",
                                "sense_id": "1569b1ef-cad9-3369-b1f9-b2731a27b9d9",
                                "text": "„Sie zechten an diesem Tage bis zur ersten Nachtwache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "698d4558-7326-34f4-b48c-81b3d96d263e",
                        "entry_id": "88523dc2-9e04-3c6e-8d33-0dd322332b99",
                        "glosses": [
                            "[1] durchführende(s) Person(al)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29fd2427-5640-403c-bb36-4c5fe6300abe",
                                "sense_id": "698d4558-7326-34f4-b48c-81b3d96d263e",
                                "text": "Die Nachtwache hat den Zwischenfall nicht bemerkt."
                            },
                            {
                                "example_id": "67548449-c04d-4082-9d02-81fb738f22bc",
                                "sense_id": "698d4558-7326-34f4-b48c-81b3d96d263e",
                                "text": "„Fast alle, die eine humanistische Ausbildung besaßen, landeten bei der Nachtwache.“"
                            },
                            {
                                "example_id": "d51729eb-8688-46ea-afe6-abe9d7a7df94",
                                "sense_id": "698d4558-7326-34f4-b48c-81b3d96d263e",
                                "text": "„Der Tagesablauf begann um sieben Uhr, nachdem die letzte Nachtwache das Wecken besorgt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
