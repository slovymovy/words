                "senses": [
                    {
                        "sense_id": "9fea0b65-2030-388d-94f9-f9ae59ddc7f3",
                        "entry_id": "60a09606-4a09-3a52-8018-0ccbf7f8ccda",
                        "glosses": [
                            "Appareil qui, grâce à un compresseur d’air, projette du sable afin de nettoyer et décaper des pièces métalliques, des façades, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fae95f3-08c4-4926-b9c8-e1871094ab38",
                                "sense_id": "9fea0b65-2030-388d-94f9-f9ae59ddc7f3",
                                "text": "Une petite sableuse à air comprimé est très utile dans une fonderie."
                            }
                        ]
                    },
                    {
                        "sense_id": "1284acec-5e93-312f-ace4-6fe01363e630",
                        "entry_id": "60a09606-4a09-3a52-8018-0ccbf7f8ccda",
                        "glosses": [
                            "Engin qui répand du sable sur les routes enneigées, ou verglacées."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "61320023-c81a-426e-a6f7-b55466965994",
                                "sense_id": "1284acec-5e93-312f-ace4-6fe01363e630",
                                "text": "Une sableuse passe dans la rue. À quoi bon sabler ? À quoi bon faire la guerre au verglas ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c2b42709-973c-3584-b4ad-63947c045fe1",
                        "entry_id": "60a09606-4a09-3a52-8018-0ccbf7f8ccda",
