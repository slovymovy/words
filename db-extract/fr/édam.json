                        "sense_id": "6d346698-c848-322a-873d-04bf6928013a",
                        "entry_id": "42d524de-8bb6-3762-8ce2-3affa685a573",
                        "glosses": [
                            "Fromage au lait de vache des Pays-Bas, traditionnellement produit à Edam et vendu sous forme d’une boule de fromage jaune pâle enveloppée dans une pellicule épaisse de paraffine jaune ou rouge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "802ca7f5-444a-473f-b83d-9d9b24587ce4",
                                "sense_id": "6d346698-c848-322a-873d-04bf6928013a",
                                "text": "Dans ce fameux spot, je dégustais du Gouda et déclarais devant mon frigo « J’adore l’édam ! »"
                            }
                        ]
                    }
                ],
