                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mesmerism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "162e91ca-7fcb-3ed9-abbd-22c0012a6983",
                                        "entry_id": "a6666388-8c51-309d-bdd9-09e62aa965c1",
                                        "glosses": [
                                            "The method or power of gaining control over someone's personality or actions, as in hypnosis or suggestion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ba6a681-535d-4a68-8db5-939083000d08",
                                                "sense_id": "162e91ca-7fcb-3ed9-abbd-22c0012a6983",
                                                "text": "What is the secret mesmerism which friendship possesses, and under the operation of which a person ordinarily sluggish, or cold, or timid, becomes wise, active, and resolute, in another's behalf?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a558f6e-d776-3e07-9513-e06ad664beed",
                                        "entry_id": "a6666388-8c51-309d-bdd9-09e62aa965c1",
                                        "glosses": [
                                            "The state induced by hypnotic methods (especially that of Mesmer himself)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f337913-6dc9-409c-92e6-05a6a5662c66",
                                                "sense_id": "2a558f6e-d776-3e07-9513-e06ad664beed",
                                                "text": "...the fact stood proven that I had seen it in my vision. Lawks! ...When the magician's engagement closed there was but one person in the village who did not believe in mesmerism, and I was the one. All the others were converted, but I was to remain an implacable and unpersuadable disbeliever in mesmerism and hypnotism for close upon fifty years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
