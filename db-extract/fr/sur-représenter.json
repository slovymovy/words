                        "glosses": [
                            "Donner une représentation plus forte que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d16829c-baa7-4309-91d5-09d02a890cee",
                                "sense_id": "d01bbc59-b27f-345c-a16e-6ae7e18fc60a",
                                "text": "Une telle pratique a pour conséquence de sur-représenter les effectifs âgés de 65 ans et plus dans la population."
                            },
                            {
                                "example_id": "ded2e1ed-7607-49c0-aafb-f2cfaff11545",
                                "sense_id": "d01bbc59-b27f-345c-a16e-6ae7e18fc60a",
                                "text": "Reproduire jusqu’à rendre inconsistant, sur-représenter pour banaliser, c’est une forme de destruction intéressante à l’ère du spectaculaire, de l’inédit, du « scoop »."
