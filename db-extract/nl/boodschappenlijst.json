                                                "example_id": "4f608df1-25bd-43cf-a01b-ec81c58de970",
                                                "sense_id": "07ea2b36-b6ab-3c11-b655-062a9bb60779",
                                                "text": "„Wenn ich es nicht gekauft hätte, habe sie wohl vergessen, diese Dinge auf die Einkaufsliste zu schreiben.“"
                                            },
                                            {
                                                "example_id": "f75bef92-8f6b-44d1-9085-f421bc7a08b3",
                                                "sense_id": "07ea2b36-b6ab-3c11-b655-062a9bb60779",
                                                "text": "„Wähend Hamid und Jacques die Reservekanister mit Benzin und Wasser füllten, schrieben wir eine Einkaufsliste, die ein algerisches Dorf gut ein Jahr versorgt hätte.“"
                                            }
