                "senses": [
                    {
                        "sense_id": "bf3aff31-f619-35c6-bf46-791467317760",
                        "entry_id": "a1777a50-b56f-378a-9903-9fd4d402018a",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e2865e0-2435-4863-8b3a-5c4f653e0a30",
                                "sense_id": "bf3aff31-f619-35c6-bf46-791467317760",
                                "text": "Frau Thumm ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "99b6d6b2-cbf3-4329-8813-422f1e1d45e3",
                                "sense_id": "bf3aff31-f619-35c6-bf46-791467317760",
                                "text": "Herr Thumm wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8e578b66-c7fb-42a6-8892-3ddd6fda71de",
                                "sense_id": "bf3aff31-f619-35c6-bf46-791467317760",
                                "text": "Die Thumms fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7bf09abb-8deb-4683-8b5d-20affe3b578b",
                                "sense_id": "bf3aff31-f619-35c6-bf46-791467317760",
                                "text": "Der Thumm trägt nie die Schals, die die Thumm ihm strickt."
                            },
                            {
                                "example_id": "89c21ef2-c411-4eea-a90d-61807f00848a",
                                "sense_id": "bf3aff31-f619-35c6-bf46-791467317760",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Thumm kommt, geht der Herr Thumm.“"
                            },
                            {
                                "example_id": "33476eaa-8432-4413-a2fd-e72e61c704f5",
                                "sense_id": "bf3aff31-f619-35c6-bf46-791467317760",
                                "text": "Thumm kommt und geht."
                            },
                            {
                                "example_id": "e6214562-fe12-41c1-bdd1-1a387c1ce2bf",
                                "sense_id": "bf3aff31-f619-35c6-bf46-791467317760",
                                "text": "Thumms kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
