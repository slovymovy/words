                ],
                "senses": [
                    {
                        "sense_id": "aaca098d-78d8-3c8f-af70-2202e03998f4",
                        "entry_id": "6ca1a29f-fac5-3173-a373-6231943c2a2a",
                        "glosses": [
                            "Mettre une perruque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "715cdcc6-021f-43e6-b074-c48408f0ec4a",
                                "sense_id": "aaca098d-78d8-3c8f-af70-2202e03998f4",
                                "text": "Nous étions tenus d'arriver très tôt le matin au théâtre de l'Ambigu où avait lieu le tournage pour le maquillage et les costumes également pour se faire \" perruquer \" par le coiffeur"
                            },
                            {
                                "example_id": "71ad65a6-28c8-45ee-a218-48bcd3c67d94",
                                "sense_id": "aaca098d-78d8-3c8f-af70-2202e03998f4",
                                "text": "En porter une sert à cacher l'absence de cheveux, mais perruquer ça sert à quoi."
                            }
                        ]
                    },
                    {
                        "sense_id": "4de8660c-9dd7-3071-bceb-b4dd49f47067",
                        "entry_id": "6ca1a29f-fac5-3173-a373-6231943c2a2a",
                        "glosses": [
                            "Profiter de son emploi dans une entreprise pour gagner de l'argent en dehors de son salaire."
                        ],
                        "tags": [
                            "Travail"
                        ],
                        "examples": [
                            {
                                "example_id": "54b2e043-cc02-4785-97c4-2234e5638e36",
                                "sense_id": "4de8660c-9dd7-3071-bceb-b4dd49f47067",
                                "text": "C’est donc à partir de mes premières expériences de salarié, que j'ai commencé à « perruquer »."
                            },
                            {
                                "example_id": "56d5bedc-6f4f-42a8-84d9-8197b2678b8a",
                                "sense_id": "4de8660c-9dd7-3071-bceb-b4dd49f47067",
                                "text": "L'exemple de cet ouvrier qualifié a ceci d'intéressant qu'il continue, même après être «monté» comme contremaître à perruquer pour lui ou les autres."
                            },
                            {
                                "example_id": "57f5357a-0277-4b11-b0fa-7d77f3096661",
                                "sense_id": "4de8660c-9dd7-3071-bceb-b4dd49f47067",
                                "text": "Se glissant dans les interstices du pouvoir, l'homme ordinaire oppose aux forts sa faiblesse constitutive, se met à « perruquer » à l'image de l'ouvrier qui se réapproprie les matières résiduelles de travail."
                            }
                        ]
                    }
                ],
