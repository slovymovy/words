                        "entry_id": "02c45a81-a9c0-3dfd-ae3f-b1d68f6070e2",
                        "glosses": [
                            "Assurer la nouvelle promotion d’un produit ou d’une personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b02b4c8-dd00-4a2f-9cf9-01954f146e9e",
                                "sense_id": "da57f937-74eb-3126-8333-c01e77b9d033",
                                "text": "Dans ce cas pourquoi repromouvoir Far Cry 2 ?"
                            },
                            {
                                "example_id": "7e3a3ad2-c3ec-4bf5-84b8-f7af0d95c143",
                                "sense_id": "da57f937-74eb-3126-8333-c01e77b9d033",
                                "text": "Soit dit en passant, tout ce que fait Apple ne lui assurera pas obligatoirement une évolution à long terme de ses parts de marché, donc on peut féliciter la FNAC d’essayer de repromouvoir la section Apple Computer."
                            }
                        ]
                    }
