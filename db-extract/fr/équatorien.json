                    {
                        "sense_id": "0ffb2ad7-3050-30ed-b230-4385614d0a01",
                        "entry_id": "6468c32c-5134-35bf-b0b7-4d9ab56dd1b8",
                        "glosses": [
                            "Relatif à l’Équateur, son peuple et sa culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b772b78f-e88b-4d81-aec7-30b430012df1",
                                "sense_id": "0ffb2ad7-3050-30ed-b230-4385614d0a01",
                                "text": "L’acteur et réalisateur équatorien Dorian Chavez pousse une boule de 2 m de diamètre recouverte de vêtements dans les rues de Toulouse, à l’occasion de la Biennale des arts vivants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a51fcc7-39be-401c-b819-0bac4fb831d3",
                        "source_entry_id": "6468c32c-5134-35bf-b0b7-4d9ab56dd1b8",
                        "source_sense_id": "0ffb2ad7-3050-30ed-b230-4385614d0a01",
                        "target_lang_word": "ecuadorianisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ecuadorianisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11a01e1f-4c7b-3401-96df-a30d462d734c",
                                        "entry_id": "4cd02807-b232-3805-b344-eaafc6db85c0",
                                        "glosses": [
                                            "Ecuador betreffend, aus Ecuador kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d89efd06-8cf9-4d19-804a-76c250b64dc8",
                                                "sense_id": "11a01e1f-4c7b-3401-96df-a30d462d734c",
                                                "text": "„Er entsteht an den westlichen Hängen der Vulkane Antisana, Sincholagua und Cotopaxi, fließt durch den ecuadorianischen und peruanischen Teil des Amazonasbeckens und mündet 65 km nordöstlich von Iquitos in den Amazonas.“"
                                            },
                                            {
                                                "example_id": "9bc034a1-4c89-4246-9483-80659a9f8001",
                                                "sense_id": "11a01e1f-4c7b-3401-96df-a30d462d734c",
                                                "text": "Dennoch wird die Anwesenheit der älteren Generation von den Schülern erwünscht und sie ist wichtig, um den nötigen Gegenpol zu schaffen, der das eigene Handeln und Sein als etwas neues, innovatives und \"ecuadorianischeres\" hervorhebt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ed4ff9d-b651-4de6-adae-17a9d57386e3",
                        "source_entry_id": "6468c32c-5134-35bf-b0b7-4d9ab56dd1b8",
                        "source_sense_id": "0ffb2ad7-3050-30ed-b230-4385614d0a01",
