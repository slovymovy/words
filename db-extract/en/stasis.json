                                        "entry_id": "14bf5c92-8878-388e-b721-da116b519713",
                                        "glosses": [
                                            "durch eine Behinderung oder ein Hindernis verursachte Störung des Durchflusses oder Durchgangs; Nomen acti: Ergebnis des Stauens"
                                        ],
                                        "tags": [
                                            "Grundbedeutung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17a144d8-7834-4c96-93d9-6ebd53b237ed",
                                                "sense_id": "8a5d6233-89bc-3959-84b3-d03a6428c3e9",
                                                "text": "Knapp nach Geschäftsbeginn entstand an den Drehkreuzen ein Stau."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18fa06a6-972b-3337-a877-4ff702e252b6",
                                        "entry_id": "14bf5c92-8878-388e-b721-da116b519713",
                                        "glosses": [
                                            "schwere Behinderung auf Transportwegen mit der Folge: „stehender/stockender Verkehr“"
                                        ],
                                        "tags": [
                                            "Verkehr"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b44890c5-c358-4bfc-8108-1faa9a809513",
                                                "sense_id": "18fa06a6-972b-3337-a877-4ff702e252b6",
                                                "text": "Nach einem Unfall auf der Autobahn 1 standen hunderte Autos im Stau."
                                            },
                                            {
                                                "example_id": "c24dfa57-ccfb-4720-8b60-2eae92b6ea8a",
                                                "sense_id": "18fa06a6-972b-3337-a877-4ff702e252b6",
                                                "text": "Du stehst nicht im Stau, du bist der Stau."
                                            },
                                            {
                                                "example_id": "e5ca6597-4746-4eab-a45d-db2a7d920693",
                                                "sense_id": "18fa06a6-972b-3337-a877-4ff702e252b6",
                                                "text": "„Auf Stau folgte wilde Raserei, auf Raserei folgten Blechschäden und erneute Staus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4dff029a-50de-3a70-862f-4e262dcec874",
                                        "entry_id": "14bf5c92-8878-388e-b721-da116b519713",
                                        "glosses": [
                                            "gestiegener Wasserstand/Pegel wegen eines Hindernisses"
                                        ],
                                        "tags": [
                                            "Fließgewässer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65518588-f675-47cb-8e12-fa23286993f2",
                                                "sense_id": "4dff029a-50de-3a70-862f-4e262dcec874",
                                                "text": "Auftauendes Eis kann in Flüssen gefährliche Staus bewirken."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d4776912-3382-3d2b-b9ea-109c109571e6",
                                        "entry_id": "14bf5c92-8878-388e-b721-da116b519713",
                                        "glosses": [
                                            "hoher Wasserstand während der Stauzeit"
                                        ],
                                        "tags": [
                                            "Gezeiten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aecdb60-53e3-44bf-ad65-6c54fac422d5",
                                                "sense_id": "d4776912-3382-3d2b-b9ea-109c109571e6",
                                                "text": "Das Wasser ist im Stau."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
