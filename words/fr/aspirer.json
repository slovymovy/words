            "senses": [
                {
                    "sense_id": "1702691b-7790-378c-bddf-578178a3d6d1",
                    "sense_definition": "Attirer l'air extérieur dans les voies respiratoires et les poumons.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin lui a demandé d'<w>aspirer</w> profondément avant d'expirer lentement par la bouche."
                        },
                        {
                            "text": "Après cette longue course en forêt, elle <w>aspira</w> l'air frais à pleins poumons."
                        }
                    ],
                    "common_phrases": [
                        "aspirer profondément",
                        "aspirer une bouffée"
                    ]
                },
                {
                    "sense_id": "e5bb1cba-3fd0-3a5b-95ef-bab8fa101576",
                    "sense_definition": "Nettoyer un sol ou un meuble en absorbant les saletés au moyen d'un appareil ménager.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>aspirer</w> le tapis du salon car le chat y a laissé beaucoup de poils."
                        },
                        {
                            "text": "Chaque samedi matin, nous prenons le temps d'<w>aspirer</w> la poussière dans toutes les chambres."
                        }
                    ],
                    "common_phrases": [
                        "aspirer la poussière",
                        "aspirer le tapis"
                    ]
                },
                {
                    "sense_id": "2060a4ca-472b-37cc-b5fa-d42e7df4e3c0",
                    "sense_definition": "Désirer ardemment atteindre un état, obtenir une fonction ou réaliser un projet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "volition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des années d'efforts intenses, ce jeune cadre <w>aspire</w> à un poste de direction."
                        },
                        {
                            "text": "Les citoyens de ce pays en guerre <w>aspirent</w> simplement à la paix et à la sécurité."
                        }
                    ],
                    "synonyms": [
                        "ambitionner",
                        "viser"
                    ],
                    "common_phrases": [
                        "aspirer à la paix",
                        "aspirer au pouvoir"
                    ]
                },
                {
                    "sense_id": "78dc5bec-2ae3-3a01-98ff-2083ef8435fc",
                    "sense_definition": "Faire monter ou absorber un liquide ou un gaz par dépression ou succion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette puissante pompe hydraulique permet d'<w>aspirer</w> l'eau accumulée au fond de la cave."
                        },
                        {
                            "text": "Le tourbillon était si fort qu'il <w>aspirait</w> tous les débris flottant autour du bateau."
                        }
                    ],
                    "common_phrases": [
                        "aspirer un liquide",
                        "aspirer l eau"
                    ]
                },
                {
                    "sense_id": "12acf36f-1ca5-3f8d-a5a7-f0d125c3234e",
                    "sense_definition": "Prononcer une consonne avec un souffle audible venu de la gorge ou du larynx.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En français, on n'<w>aspire</w> presque jamais la lettre h, même quand elle interdit la liaison."
                        },
                        {
                            "text": "Dans certaines langues germaniques, les locuteurs doivent <w>aspirer</w> fortement certaines consonnes occlusives."
                        }
                    ],
                    "common_phrases": [
                        "aspirer le h"
                    ]
                }
            ]
        }
    ]
