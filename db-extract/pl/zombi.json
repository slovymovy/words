                "senses": [
                    {
                        "sense_id": "b24cd008-074e-3df6-a609-57054fb00f0f",
                        "entry_id": "3c7c7acc-3c9d-39c4-8bdb-197e17972824",
                        "glosses": [
                            "popkulturowa fikcyjna postać z horrorów – żywy trup, zmarły ożywiony np. dzięki magii"
                        ],
                        "tags": [],
