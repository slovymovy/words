                        "examples": [
                            {
                                "example_id": "7c9fd934-f0fd-49a5-9276-5fc0cb23fb8d",
                                "sense_id": "d5098ffb-7edf-3bcf-b316-e9614b3ae0ca",
                                "text": "Dann und wann trat ein Buch, eine Schrift auf, um die man sich riß, nach der auch die nicht mehr Lesenden mit nur erheucheltem Phlegma die Hände streckten.",
                                "translation": "Now and then a book appeared, a piece of writing that people scrambled for; even those who no longer read stretched forth their hands with only feigned phlegmaticism.\"",
