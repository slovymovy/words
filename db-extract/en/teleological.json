                    {
                        "translation_id": "f7c25632-11e7-49a5-8224-535c9ebed98b",
                        "source_entry_id": "8f314193-6b09-3635-92a4-7b3cb9a43626",
                        "source_sense_id": "7e3cd2ac-7304-3ad0-9fa5-69c6d34c8e8f",
                        "source_sense_description": "pertaining to teleology",
                        "target_lang_word": "téléologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "téléologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3db28b9-873e-3d77-bdeb-e0c073acbdb1",
                                        "entry_id": "41dc9ce2-4c5a-363e-9860-b27de1d50841",
                                        "glosses": [
                                            "Se dit d'une démarche d'étude d'un phénomène qui se fait à la lumière d'un résultat connu d'avance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de7b6763-4780-451b-8466-4c1b66157ef9",
                                                "sense_id": "f3db28b9-873e-3d77-bdeb-e0c073acbdb1",
                                                "text": "Qu’on m’entende : je n’ai jamais tenu Israël pour la rédemption de la Shoah, l’idée que six millions de Juifs auraient donné leur vie pour qu’Israël existe, ce discours téléologique, manifeste ou sous-jacent, est absurde et obscène."
                                            },
                                            {
                                                "example_id": "7d20f5fd-b16f-45e1-a12a-6dc20e0cf452",
                                                "sense_id": "f3db28b9-873e-3d77-bdeb-e0c073acbdb1",
                                                "text": "La chercheuse se positionne dans une optique neutre qui vise à comprendre nos ancêtres et à décrire leurs attitudes et comportements, sans préjugés téléologiques."
                                            },
                                            {
                                                "example_id": "7f2a9898-1f29-4601-a72a-a2a7cdc53bb7",
                                                "sense_id": "f3db28b9-873e-3d77-bdeb-e0c073acbdb1",
                                                "text": "« Le rire doit répondre à certaines exigences de la vie en commun. Le rire doit avoir une signification sociale. » Toute la recherche bergsonienne est donc téléologique et sa fin lui est, dès le début, assignée."
                                            },
                                            {
                                                "example_id": "c67e4ad5-b0f9-4b06-aba0-d0121b103041",
                                                "sense_id": "f3db28b9-873e-3d77-bdeb-e0c073acbdb1",
                                                "text": "Au lieu de rechercher les facteurs du résultat, selon une démarche téléologique, il conviendrait bien plutôt de partir du fonctionnement et de la dynamique du système social féodal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
