                        "sense_id": "28ceff40-b898-30aa-ac30-ba6518f58f69",
                        "entry_id": "6c7c5e54-bb4f-3d4b-99e2-b522c32fb1e4",
                        "glosses": [
                            "Water dat door een rivier stroomt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3b6e4c4-c7bd-4ce6-a035-6b734e33eb93",
                                "sense_id": "28ceff40-b898-30aa-ac30-ba6518f58f69",
                                "text": "Rivierwater is belangrijk voor de landbouw."
                            },
                            {
                                "example_id": "945e6a85-6cc9-42f0-a9dd-c01bac1871a2",
                                "sense_id": "28ceff40-b898-30aa-ac30-ba6518f58f69",
                                "text": "Ik was gelukkig met het eenvoudige leven in het bos, ik sliep op de grond onder de sterren en dronk rivierwater, ik liet meer en meer los, maakte steeds minder plannen, stelde minder doelen en gaf me geheel over aan de verrassingen die ik op de trail tegenkwam."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e00f5eb0-22d7-4c4a-a7e8-bc72a16178bc",
                        "source_entry_id": "6c7c5e54-bb4f-3d4b-99e2-b522c32fb1e4",
                        "source_sense_id": "28ceff40-b898-30aa-ac30-ba6518f58f69",
                        "target_lang_word": "Flusswasser",
