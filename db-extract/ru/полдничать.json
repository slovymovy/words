                "translations": [
                    {
                        "translation_id": "e5cda164-9f67-4ca6-ab34-b161fc465bd1",
                        "source_entry_id": "bfdd9e8d-5f71-3b84-98f5-a8c883cc9bcc",
                        "source_sense_description": "принимать пищу в промежутке между обедом и ужином",
                        "target_lang_word": "goûter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goûter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b9506cc-391a-3403-985d-31e20030467b",
                                        "entry_id": "ebfbd8ac-73ab-37aa-81a6-1b8fe09074aa",
                                        "glosses": [
                                            "Exercer le sens du goût sur ce qui a de la saveur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d191b89-b79e-4606-a90f-e68991567f05",
                                                "sense_id": "5b9506cc-391a-3403-985d-31e20030467b",
                                                "text": "Il espérait peut-être aussi que l’autre allait lui offrir à boire, peut-être même lui faire goûter le « ouisky »."
                                            },
                                            {
                                                "example_id": "b3a7163a-b1a9-4dea-8918-b66a36d738a8",
                                                "sense_id": "5b9506cc-391a-3403-985d-31e20030467b",
                                                "text": "Je goûterai ta tarte demain car j’ai goûté un fameux tiramisu tout à l’heure. — Boire du vin lentement, afin de le mieux goûter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bdbb035-d98b-339e-b68c-318949ce5ba0",
                                        "entry_id": "ebfbd8ac-73ab-37aa-81a6-1b8fe09074aa",
                                        "glosses": [
                                            "Examiner, vérifier la saveur, la qualité d’une chose, en mettant dans la bouche une petite partie, une petite quantité de cette chose."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e5af929-7fc4-4654-bcde-09a0f39fd40c",
                                                "sense_id": "1bdbb035-d98b-339e-b68c-318949ce5ba0",
                                                "text": "Le cuisinier n’a pas goûté cette sauce."
                                            },
                                            {
                                                "example_id": "828ad8fc-4489-4fb4-834b-da793b8862e6",
                                                "sense_id": "1bdbb035-d98b-339e-b68c-318949ce5ba0",
                                                "text": "Voulez-vous goûter de notre vin ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8e73970-f2cc-33d3-8b4d-873bf03de478",
                                        "entry_id": "ebfbd8ac-73ab-37aa-81a6-1b8fe09074aa",
                                        "glosses": [
                                            "Avoir le goût de, avoir goût à."
                                        ],
                                        "tags": [
                                            "Belgique",
                                            "Nord-Pas-de-Calais",
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a4a09dd-4959-4a7d-a26b-291a57a2dc55",
                                                "sense_id": "b8e73970-f2cc-33d3-8b4d-873bf03de478",
                                                "text": "Cette tarte goûte la cannelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08cd9d0a-a533-3e30-a4e7-36827631e966",
                                        "entry_id": "ebfbd8ac-73ab-37aa-81a6-1b8fe09074aa",
                                        "glosses": [
                                            "Boire ou manger un aliment pour la première fois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49329f30-14c5-48a7-9848-9a93b1bfb1d9",
                                                "sense_id": "08cd9d0a-a533-3e30-a4e7-36827631e966",
                                                "text": "J’ai fait manger du faisan et des becfigues à plus de quatre pauvres diables qui n’avaient jamais goûté la viande de leurs moutons."
                                            },
                                            {
                                                "example_id": "486630a1-e11a-4a0b-bf5b-408acf72a6ea",
                                                "sense_id": "08cd9d0a-a533-3e30-a4e7-36827631e966",
                                                "text": "Les grenouilles sont un mets exquis quant aux cuisses, on le dit toutefois, car pour ma part je n’en ai jamais gouté ;"
                                            },
                                            {
                                                "example_id": "1dd8941c-fa8e-4562-b911-fc8b69d0ba3e",
                                                "sense_id": "08cd9d0a-a533-3e30-a4e7-36827631e966",
                                                "text": "Bref, le 11 novembre, on faisait la vie. On appelait ça les martinales. Et pour martiner, on martinait ! Une vraie fête à gueule. On goûtait d'abord le vin nouveau, mais surtout on finissait tout ce qui restait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8013fd49-3181-3cf7-9720-2bf9c79b8ff7",
                                        "entry_id": "ebfbd8ac-73ab-37aa-81a6-1b8fe09074aa",
                                        "glosses": [
                                            "Manger légèrement entre le déjeuner et le dîner, prendre son goûter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa2e4f12-fc3f-435e-beea-99f96d5a09c5",
                                                "sense_id": "8013fd49-3181-3cf7-9720-2bf9c79b8ff7",
                                                "text": "[…], le roi Charles IX avait invité à goûter avec lui, en petit comité, Henri de Navarre et le duc de Guise. Puis, la collation terminée, il avait passé avec eux dans sa chambre, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c6b0b51-2505-326b-a77e-e9bde44146de",
                                        "entry_id": "ebfbd8ac-73ab-37aa-81a6-1b8fe09074aa",
                                        "glosses": [
                                            "Faire une chose pour la première fois, l’expérimenter."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1189fc28-c819-4777-915b-e718f39d574f",
                                                "sense_id": "1c6b0b51-2505-326b-a77e-e9bde44146de",
                                                "text": "Confortablement installée à ma fenêtre, je goûtais la morsure du soleil, un bouquin à la main, quand une puissante impression scénique m’a saisie.."
                                            },
                                            {
                                                "example_id": "45ac7057-4b5e-43c7-8d9c-df21671fc28c",
                                                "sense_id": "1c6b0b51-2505-326b-a77e-e9bde44146de",
                                                "text": "Ce peuple goûte la liberté. — Après tant de troubles le pays goûtait un calme profond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "921d0a70-901b-3c85-9acb-6d0939761350",
                                        "entry_id": "ebfbd8ac-73ab-37aa-81a6-1b8fe09074aa",
                                        "glosses": [
                                            "Approuver, convenir, trouver bon ou agréable, jouir de."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbc12c03-2646-4e42-b0aa-042e4e8e88cd",
                                                "sense_id": "921d0a70-901b-3c85-9acb-6d0939761350",
                                                "text": "[…]; des grappes de consommateurs pleins de quiétude, goûtaient aux tables des terrasses toute l’exquisité de l’heure apéritive."
                                            },
                                            {
                                                "example_id": "5611921e-98f3-4ed3-b17f-e74f99bbc4f3",
                                                "sense_id": "921d0a70-901b-3c85-9acb-6d0939761350",
                                                "text": "Goûter la fraîcheur du matin, les douceurs du sommeil, les plaisirs de la table, le repos."
                                            },
                                            {
                                                "example_id": "f6f0731c-6eb5-4322-8455-b3cc2f5eb1f5",
                                                "sense_id": "921d0a70-901b-3c85-9acb-6d0939761350",
                                                "text": "Je n’ai jamais goûté cet homme-là, ses manières, son ton, son esprit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "goûter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9e6e409-65e8-3257-a466-2d65ada4c7a6",
                                        "entry_id": "8da9803f-f2a7-3899-9fc7-858820410104",
                                        "glosses": [
                                            "Petit repas pris entre le déjeuner et le dîner, notamment par les enfants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b0d1a65-f2ec-4a2f-8d31-e41acfa25ebf",
                                                "sense_id": "f9e6e409-65e8-3257-a466-2d65ada4c7a6",
                                                "text": "Après quoi, ayant à nouveau baisé la main de ces dames, fait mes courbettes, claqué les talons, je courais joyeusement derrière le dépôt de bois où, coiffé d'un tricorne de papier et armé d'un bâton, je défendais l'Alsace-Lorraine, marchais sur Berlin et accomplissais la conquête du monde jusqu'à l'heure du goûter."
                                            },
                                            {
                                                "example_id": "a7084d00-38d3-4ffe-91f0-0bb1a99df83f",
                                                "sense_id": "f9e6e409-65e8-3257-a466-2d65ada4c7a6",
                                                "text": "Des goûters comme il n’en avait jamais vu chez lui. Cacao Van Houten, brioche, miel…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "376b5444-a5eb-3bdd-b9de-c0ce81d939a6",
                                        "entry_id": "8da9803f-f2a7-3899-9fc7-858820410104",
                                        "glosses": [
                                            "Aliments consommés lors de ce repas."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf810715-12b8-4a12-a320-05c00fd240b5",
                                                "sense_id": "376b5444-a5eb-3bdd-b9de-c0ce81d939a6",
                                                "text": "N’oublie pas de prendre ton goûter avec toi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
