                                "target_senses": [
                                    {
                                        "sense_id": "907b832a-e8f4-3220-9158-3dc52cb483ee",
                                        "entry_id": "cce12ae6-9144-3dc9-b625-8001f85da565",
                                        "glosses": [
                                            "A protracted and bitter violent feud between clans, families, factions, etc.; a vendetta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bff65506-e28d-4bf3-8603-017e0294aeb5",
                                                "sense_id": "907b832a-e8f4-3220-9158-3dc52cb483ee",
                                                "text": "\"I should have remembered that these people have long memories for blood-feuds, and have been more upon my guard.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6daf171d-c599-494e-b95f-c78413f59d73",
                        "source_entry_id": "bd735662-1686-395a-b557-4dd62bb25388",
                        "source_sense_id": "6ec6c4c2-ea15-37fd-a9e9-f221072045a9",
                        "source_sense_description": "Blutrache",
                        "target_lang_word": "vendetta",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vendetta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e9f53d0-29d4-3dd7-bb07-698751a5a627",
                                        "entry_id": "51442aa0-6f80-3903-807f-b6ea60c5d879",
                                        "glosses": [
                                            "Revenge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88a22709-19fb-3db1-a1d8-4f1550f11ed2",
                                        "entry_id": "51442aa0-6f80-3903-807f-b6ea60c5d879",
                                        "glosses": [
                                            "A bitter, destructive feud, normally between two families, clans, or factions, in which each injury or slaying is revenged: a blood feud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "710f766c-4d1e-40b2-a0d9-8d2a869150cc",
                                                "sense_id": "88a22709-19fb-3db1-a1d8-4f1550f11ed2",
                                                "text": "The families had been locked in a bitter vendetta for generations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44c88993-626e-32dd-96a8-5c881613025e",
                                        "entry_id": "51442aa0-6f80-3903-807f-b6ea60c5d879",
                                        "glosses": [
                                            "A motivational grudge against a person or faction, which may or may not be reciprocated; the state of having it in for someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d97a9e45-2c53-44c8-b7b2-0285ee8e4436",
                                                "sense_id": "44c88993-626e-32dd-96a8-5c881613025e",
                                                "text": "personal vendetta"
                                            },
                                            {
                                                "example_id": "e8d0facc-3d6f-43ad-8105-d24e773caadb",
                                                "sense_id": "44c88993-626e-32dd-96a8-5c881613025e",
                                                "text": "blood vendetta"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97d692e0-3b46-4984-8d2c-ee660ac44891",
                        "source_entry_id": "bd735662-1686-395a-b557-4dd62bb25388",
                        "source_sense_id": "6ec6c4c2-ea15-37fd-a9e9-f221072045a9",
                        "source_sense_description": "Blutrache",
                        "target_lang_word": "vendetta",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vendetta",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ad5656c-74f1-3434-a95e-6d4f261b1215",
                                        "entry_id": "bb357c63-c7c6-3c37-8763-f4dc46fe09bf",
                                        "glosses": [
                                            "Haine, hostilité qui existe dans le bassin méditerranéen et dans les Balkans entre deux familles, et qui cause souvent des meurtres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c0c747a-c84f-4e6d-8be5-3460189f2fb6",
                                                "sense_id": "3ad5656c-74f1-3434-a95e-6d4f261b1215",
                                                "text": "Il ne semble pas qu'au temps où la vendetta fonctionnait régulièrement en Corse, pour compléter ou corriger l'action d'une justice trop boiteuse, la population eût une moindre moralité qu'aujourd'hui."
                                            },
                                            {
                                                "example_id": "fa996f89-d3fc-4317-b5a6-f1cb36792c96",
                                                "sense_id": "3ad5656c-74f1-3434-a95e-6d4f261b1215",
                                                "text": "Le mobile de ces crimes a toujours été uniquement la vengeance, la vendetta : vendetta pour une injure reçue, ou vendetta pour violation du grand principe de l’omerta. Le Sicilien, en général, aime à se faire justice par lui-même : […]."
                                            },
                                            {
                                                "example_id": "166eabb9-b5d4-4c5e-9049-988ad82586db",
                                                "sense_id": "3ad5656c-74f1-3434-a95e-6d4f261b1215",
                                                "text": "Il se rappelle que lorsqu'il avait douze ans, et qu'il était berger dans la montagne, il a pris part à la razzia d'un village voisin ; haine et représailles de village à village, vendetta : la vieille Abkhasie peut, sous cet angle, se comparer à la Corse ou à la Sicile."
                                            },
                                            {
                                                "example_id": "60edab59-c8fe-48ae-9dce-c3ee85a4093d",
                                                "sense_id": "3ad5656c-74f1-3434-a95e-6d4f261b1215",
                                                "text": "Chez lui, ses amis et parents n'auraient guère tardé pour faire vendetta ; ces gens du nord, eux, ont la placidité des vaches."
                                            },
                                            {
                                                "example_id": "44d917b3-b572-4346-97ec-13bc1bf2009c",
                                                "sense_id": "3ad5656c-74f1-3434-a95e-6d4f261b1215",
                                                "text": "Basilia ne doutait pas un instant que Dieu n’approuvât la vendetta déclenchée par ses soins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f6d21fe-0274-3733-bdcd-08e5f0e8dd36",
                                        "entry_id": "bb357c63-c7c6-3c37-8763-f4dc46fe09bf",
                                        "glosses": [
                                            "Vengeance, revanche personnelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edc18a52-6216-488b-a701-4c2cb2e05a22",
                                                "sense_id": "7f6d21fe-0274-3733-bdcd-08e5f0e8dd36",
                                                "text": "La Russie demeurait par force une puissance pacifique, divisée au-dedans, déchirée entre les révolutionnaires et les réactionnaires également incapables de reconstruction sociale, et elle s’enlisait dans un désordre tragique de vendetta politique à retours chroniques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7a536ef-8fb0-43de-aa0a-4c17f3cdee7f",
                        "source_entry_id": "bd735662-1686-395a-b557-4dd62bb25388",
                        "source_sense_id": "6ec6c4c2-ea15-37fd-a9e9-f221072045a9",
                        "source_sense_description": "Blutrache",
                        "target_lang_word": "vengeance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vengeance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61437f8b-663a-3ee3-ac99-398630bdebec",
                                        "entry_id": "de9c4830-3469-3838-b4e6-397858528f7b",
                                        "glosses": [
                                            "Peine causée à l’offenseur pour la satisfaction personnelle de l’offensé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e940a8d-094d-469c-87b0-c27302b2d092",
                                                "sense_id": "61437f8b-663a-3ee3-ac99-398630bdebec",
                                                "text": "La vengeance est le plaisir des dieux ; et, s’ils se la sont réservée, comme nous le disent les prêtres, c’est parce qu’ils la regardent comme une jouissance trop précieuse pour de simples mortels."
                                            },
                                            {
                                                "example_id": "aa1c08d3-f729-4d82-9a2f-44e144c67a7d",
                                                "sense_id": "61437f8b-663a-3ee3-ac99-398630bdebec",
                                                "text": "La vengeance est permise, […], c’est le droit imprescriptible du faible et de l’opprimé ; cependant, elle doit être proportionnée à l’injure reçue."
                                            },
                                            {
                                                "example_id": "5530dec7-d430-4d80-abb1-9cbd447e11d6",
                                                "sense_id": "61437f8b-663a-3ee3-ac99-398630bdebec",
                                                "text": "Malheur à toi, dormeur silencieux, chair vile,\nEsprit que la vengeance éternelle a sacré,\nToi qui n’as jamais cru, ni jamais espéré !"
                                            },
                                            {
                                                "example_id": "859f33dd-7874-4600-8af6-9ec0d0ab5572",
                                                "sense_id": "61437f8b-663a-3ee3-ac99-398630bdebec",
                                                "text": "La vengeance est un plat qui se déguste glacé, mais se délivre brûlant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "011d196b-8a45-3359-aac9-b6e5c0c607e0",
                                        "entry_id": "de9c4830-3469-3838-b4e6-397858528f7b",
                                        "glosses": [
                                            "Désir de se venger."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa56369e-209b-4847-9647-5969be405ed7",
                                                "sense_id": "011d196b-8a45-3359-aac9-b6e5c0c607e0",
                                                "text": "On passe ainsi de la jalousie à la vengeance, et on sait que la vengeance est un sentiment d’une puissance extraordinaire, surtout chez les êtres faibles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
