                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "charme_joli",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tableau est <w>gentil</w>, mais il manque un peu de profondeur."
                        },
                        {
                            "text": "C'est une <w>gentille</w> mélodie, agréable à écouter, sans plus."
