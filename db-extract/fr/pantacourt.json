                        "sense_id": "3d09c258-5838-32f2-8c66-9bdc813c2582",
                        "entry_id": "02b18418-d2ae-3daa-80eb-5bc8ad6a74ab",
                        "glosses": [
                            "Pantalon court qui descend au-dessous du genou sans aller jusqu’aux chevilles, intermédiaire entre un bermuda et un pantalon long."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dd5ea77-81e8-4de9-8b34-82aaae90247c",
                                "sense_id": "3d09c258-5838-32f2-8c66-9bdc813c2582",
                                "text": "En octobre, il tourne son premier et unique scopitone, « Aragon et Castille ». Il joue un glacier, chemise rose, tablier blanc, pantacourt gris et calot blanc, et conduit un triporteur devant deux gros cylindres verticaux qui tournent sur eux-même."
                            },
                            {
                                "example_id": "d271418d-a7ac-4aff-918c-d53f32b58389",
                                "sense_id": "3d09c258-5838-32f2-8c66-9bdc813c2582",
                                "text": "Formés à Édimbourg en 1969, les Bay City Rollers, des minets aux longs cheveux bien peignés, enflamment les écrans télé avec leurs chemises ouvertes jusqu’au nombril et l’adoption précoce du pantacourt."
                            }
                        ]
                    }
