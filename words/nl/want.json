    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "63f463b3-133f-34e9-842e-262a972b02bb",
                    "sense_definition": "geeft een reden of verklaring aan voor wat eerder is gezegd",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "voegwoord-reden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had haast, <w>want</w> hij dreigde de trein te missen.",
                            "target_lang_translations": {
                                "en": "He was in a hurry, <w>because</w> he was in danger of missing the train."
                            }
                        },
                        {
                            "text": "Ik wil een biertje, <w>want</w> ik heb dorst.",
                            "target_lang_translations": {
                                "en": "I want a beer, <w>for</w> I am thirsty."
                            }
                        }
                    ],
                    "synonyms": [
                        "dewijl",
                        "omdat"
                    ],
                    "target_lang_definitions": {
                        "en": "indicates a reason or explanation for what was said previously"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "because",
                                "target_lang_sense_clarification": "most common conjunction for reason"
                            },
                            {
                                "target_lang_word": "for",
                                "target_lang_sense_clarification": "formal or literary conjunction for reason"
                            },
                            {
                                "target_lang_word": "since",
                                "target_lang_sense_clarification": "conjunction indicating a known reason"
                            }
                        ]
                    }
                }
            ]
        },
        {
