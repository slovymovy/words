                    {
                        "sense_id": "677f394d-8dd6-3788-a926-2e968065eda7",
                        "entry_id": "969db65d-b5f1-3612-a865-ace17fd07a8a",
                        "glosses": [
                            "To scorch about, around, or all over; scorch completely."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "199863ad-b492-4364-a707-a87f6e92ec33",
                                "sense_id": "677f394d-8dd6-3788-a926-2e968065eda7",
                                "text": "Tis like the bursting of the desert stream When to the field, with sultry drought bescorch'd, Between its echoing rocks it rolls its way."
                            },
                            {
                                "example_id": "de5dc4d0-d28a-438b-9f92-f4415df9c056",
                                "sense_id": "677f394d-8dd6-3788-a926-2e968065eda7",
                                "text": "To my well-pleaded plaint on breach of faith Concerning Malta, as at Amiens pledged, Has lighted up anew such brands of ire As may bescorch the world."
                            }
                        ]
                    }
