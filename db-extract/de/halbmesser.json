                    {
                        "translation_id": "98e30fae-ab2c-45fe-8bee-3deb43b58b1e",
                        "source_entry_id": "48e8a0c2-73b9-3a96-b23a-a2674e59e48c",
                        "source_sense_id": "5aa0001a-0316-3b18-ba50-d3285c0f00c6",
