                "senses": [
                    {
                        "sense_id": "57f25519-0c55-30d6-8b77-de461ee8940a",
                        "entry_id": "bb958b0c-a3a0-3f3f-81c4-4bda65bb618c",
                        "glosses": [
                            "Raum, in dem ein Verdächtiger oder ein Beschuldigter einem Verhör unterzogen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ef4fbad-4f1b-4e50-b338-5d79af688718",
                                "sense_id": "57f25519-0c55-30d6-8b77-de461ee8940a",
                                "text": "„Als ich Ruslan allein im Verhörraum begegnete, hatte er ein breites Kreuz, einen wild wuchernden Vollbart und ich dachte mir: Bitte nicht einer dieser tschetschenischen Bombenleger, die sich mir als Opfer verkaufen wollen.“"
                            },
                            {
                                "example_id": "f51e53cc-2fff-46b8-ab1c-e563e800f4a0",
                                "sense_id": "57f25519-0c55-30d6-8b77-de461ee8940a",
                                "text": "„Ein langer Gang mit vielen Türen, man kann die Zimmer einzeln betreten und findet sich plötzlich im Verhörraum eines nationalsozialistischen Systemträgers wieder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
