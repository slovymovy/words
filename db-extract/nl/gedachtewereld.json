                        ],
                        "examples": [
                            {
                                "example_id": "d8bd7b75-a03a-4408-bf17-46f76bae8b12",
                                "sense_id": "93e0ebe3-7d96-363c-a679-140e785c6f22",
                                "text": "Zijn gedachtewereld is gebaseerd op eeuwenoude tradities.",
                                "translation": "His belief system is based on age-old traditions.",
                                "english": "His belief system is based on age-old traditions."
                            },
                            {
                                "example_id": "eef557b3-21e2-4894-a28e-678e76494b3a",
                                "sense_id": "93e0ebe3-7d96-363c-a679-140e785c6f22",
                                "text": "Verschillende culturen hebben verschillende gedachtewerelden.",
                                "translation": "Different cultures have different belief systems.",
                                "english": "Different cultures have different belief systems."
                            },
                            {
                                "example_id": "d2f2fd64-873a-45a7-a584-3a899f5566b9",
                                "sense_id": "93e0ebe3-7d96-363c-a679-140e785c6f22",
                                "text": "Het begrijpen van iemands gedachtewereld kan leiden tot betere communicatie.",
                                "translation": "Understanding someone's belief system can lead to better communication.",
                                "english": "Understanding someone's belief system can lead to better communication."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb0e8417-3f09-3295-8d9e-a7430ff988d0",
                        "entry_id": "1738a620-12c9-32b8-a9b3-cea8aff83e10",
                        "glosses": [
                            "mindset, set of thoughts"
                        ],
                        "tags": [
                            "feminine",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "8baf39a5-99f2-4c1e-8bbd-2b49f8409db8",
                                "sense_id": "fb0e8417-3f09-3295-8d9e-a7430ff988d0",
                                "text": "Jongeren hebben vaak een andere gedachtewereld dan ouderen.",
                                "translation": "Young people often have a different mindset than older individuals.",
                                "english": "Young people often have a different mindset than older individuals."
                            },
                            {
                                "example_id": "ceefe17d-e09d-457e-9a7d-584e6388ae3c",
                                "sense_id": "fb0e8417-3f09-3295-8d9e-a7430ff988d0",
                                "text": "Een positieve gedachtewereld kan leiden tot succes.",
                                "translation": "A positive set of thoughts can lead to success.",
                                "english": "A positive set of thoughts can lead to success."
                            },
                            {
                                "example_id": "d3d0d5c3-34d3-4ad8-afda-219096665e01",
                                "sense_id": "fb0e8417-3f09-3295-8d9e-a7430ff988d0",
                                "text": "Om de situatie echt te begrijpen, moet je je in haar gedachtewereld verdiepen.",
                                "translation": "To truly understand the situation, you need to delve into her mindset.",
                                "english": "To truly understand the situation, you need to delve into her mindset."
                            }
                        ]
                    }
                ],
