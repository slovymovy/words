                "senses": [
                    {
                        "sense_id": "4c09d4d0-9eb2-351b-9645-877ab5b8d9c3",
                        "entry_id": "c9fd68ac-2547-3bdf-a8ca-3ad484ef9bc4",
                        "glosses": [
                            "Donner un caractère critique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0af2693-d943-4212-9f58-afa25cae6d95",
                                "sense_id": "4c09d4d0-9eb2-351b-9645-877ab5b8d9c3",
                                "text": "Comment admettre l’évidente impuissance de ce silence marginal, alors que la masse – criticisée par l’expérience du général éconduit au particularisé – élabore chaque jour le conceptuel du substrat temporisateur !"
                            },
                            {
                                "example_id": "6de1eebf-f3b2-483e-b9af-56416b994ac1",
                                "sense_id": "4c09d4d0-9eb2-351b-9645-877ab5b8d9c3",
                                "text": "C’est une dangereuse invasion, quand les poètes se mettent à criticiser ; leur mission est de charmer, non de mettre à quia."
                            }
                        ]
                    }
