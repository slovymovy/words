                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "518a727a-84d7-38ef-84dd-5614e9f10ae3",
                                        "entry_id": "61cebb40-d9ab-3b31-8c6c-acbb1e87b814",
                                        "glosses": [
                                            "offenkundig, deutlich, erheblich, beträchtlich (jeweils mit negativer Konnotation)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de693fe-50ae-444b-83fe-7b372ad69b1c",
                                                "sense_id": "518a727a-84d7-38ef-84dd-5614e9f10ae3",
                                                "text": "Auf eklatante Weise hat sich gezeigt, dass…"
                                            },
                                            {
                                                "example_id": "da553e30-0b11-4386-b0c3-a68d22420840",
                                                "sense_id": "518a727a-84d7-38ef-84dd-5614e9f10ae3",
