                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "88c377e4-5d22-44f6-b868-5a450d584f1e",
                                "sense_id": "4ebcb6ba-d34a-3693-85fa-815e771497b4",
                                "text": "March 25, 1796, Samuel Taylor Coleridge, The Watchman\nHence the soft couch, and many-colour'd robe,\nThe timbrel and arch'd dome and costly feast,\nWith all th' inventive arts that nurse the soul\nTo forms of beauty; and by sensual wants\nUnsensualize the mind, which in the Means\nLearns to forget the grossness of the End,\nBest pleasur'd with its own activity."
                            }
                        ]
