                "senses": [
                    {
                        "sense_id": "edc4a13c-d72c-32af-913c-c890d77acc0e",
                        "entry_id": "c0712696-d4d9-3d27-9e1b-6c7bbcf0aaa5",
                        "glosses": [
                            "Kajüte, die dem Kapitän vorbehalten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d23f786-45ba-4614-86e5-f0f10c6b0de5",
                                "sense_id": "edc4a13c-d72c-32af-913c-c890d77acc0e",
                                "text": "„Der Wind hat die blaue Plane vom Deck gezerrt, und Regen ist in die Kapitänskajüte gelaufen.“"
                            },
                            {
                                "example_id": "ce86d877-4d76-444e-b10c-aa9b6ad36476",
                                "sense_id": "edc4a13c-d72c-32af-913c-c890d77acc0e",
                                "text": "„Zweimal fragt Hazelwood den Offizier, ob er dazu in der Lage sei - und als dieser die Fragen bejaht, geht er in die Kapitänskajüte und legt sich in seine Koje.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
