                                            {
                                                "example_id": "6439f62d-7c5e-4264-aa5c-8cf17d85e710",
                                                "sense_id": "3946c3d7-61c8-3f35-9f4d-bddc0d381e95",
                                                "text": "Nevíme přesně, jaká je elementární Planckova délka v M-teorii - možná jde pouze o velikost jedné stotisíciny miliardtiny miliardtiny miliardtiny milimetru."
                                            },
                                            {
                                                "example_id": "acb67a46-5c6c-461b-8d05-eceb0bf56a53",
                                                "sense_id": "3946c3d7-61c8-3f35-9f4d-bddc0d381e95",
                                                "text": "Mám dojem, že jedna miliardtina jeho klidu by mi umožnila se vymanit z toho nepopsatelně zoufalého stavu, v jakém jsem."
                                            },
                                            {
                                                "example_id": "3dccbf16-dda6-4703-abbc-868e14b3ce7a",
                                                "sense_id": "3946c3d7-61c8-3f35-9f4d-bddc0d381e95",
                                                "text": "V exaktních vědách, zejména ve fyzice, předpona „nano-“ označuje jednu miliardtinu základní jednotky. Tak například šestnáct nanopascalů se rovná šestnácti miliardtinám jednoho Pascalu."
                                            }
