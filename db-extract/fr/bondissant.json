                        "examples": [
                            {
                                "example_id": "7ad462b0-9ec6-4778-bb4d-6898ead7ce05",
                                "sense_id": "49b2ef94-a939-3e73-9e4e-dcac8a213d60",
                                "text": "Sous un ciel fuligineux et sur une mer furieuse, un voilier démâté fuyait la tempête, donnant fortement de la bande, luttant désespérément contre l’assaut d’énormes vagues bondissantes qui se ruaient, secouant leurs crinières écumantes."
                            },
                            {
                                "example_id": "bdd7b0c3-f730-4818-a5eb-4cbbe9777b4f",
                                "sense_id": "49b2ef94-a939-3e73-9e4e-dcac8a213d60",
                                "text": "Dès qu’il me voyait, il se dirigeait vers moi, le buste très raide et la démarche bondissante."
                            }
                        ]
                    }
                ],
