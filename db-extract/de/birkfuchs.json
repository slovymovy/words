                "senses": [
                    {
                        "sense_id": "7a9c00cc-402a-381c-ad88-18785474e875",
                        "entry_id": "d870b4f4-7611-3efb-b61d-0a92ca910bef",
                        "glosses": [
                            "hellgefärbter Rotfuchs, mit weißer Kehle und Blume"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "1d49432e-36b2-4e1f-8851-a7ea37ebdf11",
                                "sense_id": "7a9c00cc-402a-381c-ad88-18785474e875",
                                "text": "„Die dicht und prächtig behaarte Standarte hat beim Birkfuchs eine weiße, beim sogenannten Brandfuchs dagegen eine schwarze Spitze.“"
                            },
                            {
                                "example_id": "54ef42f7-5097-4308-a454-a62236a496bc",
                                "sense_id": "7a9c00cc-402a-381c-ad88-18785474e875",
                                "text": "„Bekannt ist auch der Brandfuchs mit dunkler Kehle und Bauchseite sowie Schulterpartie sowie der noch dunklere Kohlfuchs und der besonders helle Birkfuchs.“"
                            },
                            {
                                "example_id": "67b365fa-6412-4c28-95bf-ff2a0726e881",
                                "sense_id": "7a9c00cc-402a-381c-ad88-18785474e875",
                                "text": "„Da auch andere Färbungen des Balges möglich sind, wird entsprechend vom Birkfuchs ( helles Fell ), Kohlfuchs oder Brandfuchs ( sehr dunkles Fell ) und vom Kreuzfuchs (dunkler Streifen quer zur Schulter und längs des Rückens) gesprochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
