                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dominique est <w>gentil</w>, mais il ne comprend pas toujours les blagues."
                        },
                        {
                            "text": "On dit qu'il est <w>gentil</w>, mais tout le monde sait qu'il n'est pas très malin."
