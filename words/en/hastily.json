                    "sense_definition": "In a quick or hurried manner.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>hastily</w> packed her bags before the taxi arrived.",
                            "target_lang_translations": {
                                "cs": "Před příjezdem taxi si <w>spěšně</w> sbalila kufry.",
                                "tr": "Taksi gelmeden önce çantalarını <w>aceleyle</w> topladı.",
                                "nl": "Ze pakte haar koffers <w>haastig</w> in voordat de taxi arriveerde.",
                                "ru": "Она <w>поспешно</w> собрала чемоданы до приезда такси.",
                                "pl": "<w>Pospiesznie</w> spakowała walizki, zanim przyjechała taksówka.",
                                "de": "Sie packte <w>hastig</w> ihre Taschen, bevor das Taxi ankam.",
                                "fr": "Elle a fait ses valises <w>à la hâte</w> avant que le taxi n'arrive.",
                                "it": "Ha fatto le valigie <w>frettolosamente</w> prima che arrivasse il taxi.",
                                "es": "Empacó sus maletas <w>apresuradamente</w> antes de que llegara el taxi.",
                                "zh": "她在出租车到达前<w>匆忙地</w>收拾好行李。",
                                "ja": "タクシーが到着する前に、彼女は<w>急いで</w>荷物をまとめました。",
                                "pt": "Ela fez as malas <w>à pressa</w> antes de o táxi chegar."
                            }
                        },
                        {
                            "text": "He <w>hastily</w> wrote down the phone number on a napkin.",
                            "target_lang_translations": {
                                "cs": "Telefonní číslo si <w>kvapně</w> zapsal na ubrousek.",
                                "tr": "Telefon numarasını bir peçeteye <w>alelacele</w> yazıverdi.",
                                "nl": "Hij schreef het telefoonnummer <w>haastig</w> op een servet.",
                                "ru": "Он <w>наспех</w> записал номер телефона на салфетке.",
                                "pl": "<w>Naprędce</w> zapisał numer telefonu na serwetce.",
                                "de": "Er schrieb die Telefonnummer <w>eilig</w> auf eine Serviette.",
                                "fr": "Il a noté <w>précipitamment</w> le numéro de téléphone sur une serviette.",
                                "it": "Ha annotato <w>in fretta</w> il numero di telefono su un tovagliolo.",
                                "es": "Anotó <w>de prisa</w> el número de teléfono en una servilleta.",
                                "zh": "他<w>仓促地</w>把电话号码写在了一张餐巾纸上。",
                                "ja": "彼は電話番号を<w>急いで</w>ナプキンに書き留めました。",
                                "pt": "Ele anotou <w>apressadamente</w> o número de telefone num guardanapo."
                            }
                        }
                    ],
