                ],
                "senses": [
                    {
                        "sense_id": "a592c974-7053-301d-be74-708e9f8abdbf",
                        "entry_id": "421a30f3-9e62-326c-a1fd-7e6f0a6af8f0",
                        "glosses": [
                            "Action d’exonérer."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "883a348b-66e9-4f6d-893f-44cad0fcfe50",
                                "sense_id": "a592c974-7053-301d-be74-708e9f8abdbf",
                                "text": "Les mots d’origine médicale empruntés par la fiscalité que nous allons étudier tout de suite sont : exonération, immunisation, incitation, inflation, ponction, potentiel."
                            },
                            {
                                "example_id": "718fee5a-8d9a-40f9-b74d-040213ebdc5d",
                                "sense_id": "a592c974-7053-301d-be74-708e9f8abdbf",
                                "text": "Ce traitement différencié pourrait être supprimé prochainement au profit d’une exonération d’impôt généralisée."
                            },
                            {
                                "example_id": "b4d78573-860c-46a8-9a9e-fe4724ab79f0",
                                "sense_id": "a592c974-7053-301d-be74-708e9f8abdbf",
                                "text": "Exonération du service militaire."
                            },
                            {
                                "example_id": "920cfdab-68f7-4c73-b530-659bf29ce74d",
                                "sense_id": "a592c974-7053-301d-be74-708e9f8abdbf",
                                "text": "Exonération des frais d’étude."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c79db5d-0457-36b4-954a-b85c34e41dba",
                        "entry_id": "421a30f3-9e62-326c-a1fd-7e6f0a6af8f0",
                        "glosses": [
                            "Soulagement des besoins naturels, déjection."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1d2254b5-b5ec-459d-a294-ca6dd3ee2f09",
                                "sense_id": "7c79db5d-0457-36b4-954a-b85c34e41dba",
                                "text": "Dès l’âge de neuf ans, je savais par cœur des tirades entières sur l’exonération imparfaite du constipé."
                            },
                            {
                                "example_id": "a29ec79e-a6ba-4b8c-8387-e7dea1ad499a",
                                "sense_id": "7c79db5d-0457-36b4-954a-b85c34e41dba",
                                "text": "Préparation aux examens endoscopiques du rectum : 1 suppositoire 5 à 30 minutes avant l'heure choisie pour l'exonération."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5a42a18-b43d-4c28-b0dc-49e44bdb4274",
                        "source_entry_id": "421a30f3-9e62-326c-a1fd-7e6f0a6af8f0",
                        "source_sense_description": "sens 1",
                        "target_lang_word": "Befreiung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Befreiung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbcf17f3-bca2-3460-b0ef-9bbc29b46286",
                                        "entry_id": "582b7a0b-6636-3526-8a89-c0b093aca5b1",
                                        "glosses": [
                                            "(häufig irreguläre) Beendigung von Gefangenschaft oder Haft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b008fd1-e78a-4004-b606-0b38baeadeb5",
                                                "sense_id": "bbcf17f3-bca2-3460-b0ef-9bbc29b46286",
                                                "text": "Die Befreiung der zehn Jahre nach Kriegsende noch in der Sowjetunion zurückgehaltenen etwa zehntausend deutschen Kriegsgefangenen gilt als eine seiner größten politischen Leistungen."
                                            },
                                            {
                                                "example_id": "cf177f95-8ba4-40df-b427-0e72c79fb799",
                                                "sense_id": "bbcf17f3-bca2-3460-b0ef-9bbc29b46286",
                                                "text": "„In Dachau erlebten 60000 Häftlinge ihre Befreiung; auch dort hatte der Typhus viele hinweggerafft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "49e3b6aa-dfd1-3124-a45b-9bc0aaf68699",
                                        "entry_id": "582b7a0b-6636-3526-8a89-c0b093aca5b1",
                                        "glosses": [
                                            "Beendigung von Repression oder Besatzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5213e48-6771-43ee-b560-307a126d1d9e",
                                                "sense_id": "49e3b6aa-dfd1-3124-a45b-9bc0aaf68699",
                                                "text": "Mit der Befreiung Algeriens von der französischen Besatzung erhielten afrikanische Unabhängigkeitsbewegungen Auftrieb."
                                            },
                                            {
                                                "example_id": "6276db1c-7c1a-4b7c-a369-ac145538ecbb",
                                                "sense_id": "49e3b6aa-dfd1-3124-a45b-9bc0aaf68699",
                                                "text": "„Die Partition war die blutige Kehrseite der Befreiung Indiens von der 200-jährigen britischen Kolonialherrschaft.“"
                                            },
                                            {
                                                "example_id": "f04ffa64-02c4-4592-b168-6b7eabf3d92c",
                                                "sense_id": "49e3b6aa-dfd1-3124-a45b-9bc0aaf68699",
                                                "text": "„Die Zeitung über die Befreiung Brüssels brannte mir in der Tasche meines Rockes als wäre sie ein Feuer über meinem Herzen.“"
                                            },
                                            {
                                                "example_id": "4738c9f8-c9e0-45be-adab-451c49e8011c",
                                                "sense_id": "49e3b6aa-dfd1-3124-a45b-9bc0aaf68699",
                                                "text": "„Es ist anzunehmen, dass Nehru die Befreiung Goas tatsächlich noch nicht geplant hatte, als er mit Kennedy sprach.“"
                                            },
                                            {
                                                "example_id": "4badabf0-1fe7-4958-a52f-c613703b4d99",
                                                "sense_id": "49e3b6aa-dfd1-3124-a45b-9bc0aaf68699",
                                                "text": "„An der Befreiung Marseilles hatten auch französische Truppen und Partisanenverbände teilgenommen, die aus allen Teilen des Südens zusammengeströmt waren.“"
                                            },
                                            {
                                                "example_id": "a4b4d6d9-9102-4602-a6bc-6bf78f2f6a91",
                                                "sense_id": "49e3b6aa-dfd1-3124-a45b-9bc0aaf68699",
                                                "text": "[Richard von Weizsäcker, 8. Mai 1985:] […] „»Der 8. Mai war ein Tag der Befreiung. Er hat uns alle befreit von dem menschenverachtenden System der nationalsozialistischen Gewaltherrschaft.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e79c7aad-192a-3367-8eb1-d30714c9526b",
                                        "entry_id": "582b7a0b-6636-3526-8a89-c0b093aca5b1",
                                        "glosses": [
                                            "Beendigung von Leiden, Krankheit oder anderen Belastungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "432cae85-dd7d-4ed2-b6b2-a2dfb17b0008",
                                                "sense_id": "e79c7aad-192a-3367-8eb1-d30714c9526b",
                                                "text": "Viele Patienten erhoffen sich von der modernen Medizin die Befreiung von ihrer Krankheit."
                                            },
                                            {
                                                "example_id": "479ed76f-1b73-439d-a8e1-156d3bc0897c",
                                                "sense_id": "e79c7aad-192a-3367-8eb1-d30714c9526b",
                                                "text": "Das Ende ihrer Ehe war für sie belastend, aber letztlich auch eine Befreiung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c016a9bc-5cd2-39f0-8b10-2ad33272bb1c",
                                        "entry_id": "582b7a0b-6636-3526-8a89-c0b093aca5b1",
                                        "glosses": [
                                            "Entbindung von der Pflicht zur Einhaltung bestimmter Regeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e7e957f-0d9c-45b9-9aa9-e76c31f40c60",
                                                "sense_id": "c016a9bc-5cd2-39f0-8b10-2ad33272bb1c",
                                                "text": "„Die Befreiung von der Schweigepflicht erstreckt sich auf alle Auskünfte, die für die Feststellung des erhobenen Schadenersatzanspruchs erforderlich sind, also ggf. auch auf Vorerkrankungen, sofern und soweit sie für die Beurteilung der Verletzungsfolgen von Bedeutung sein können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "23ffaa83-90d3-3af5-a9d6-216d331a9905",
                                        "entry_id": "582b7a0b-6636-3526-8a89-c0b093aca5b1",
                                        "glosses": [
                                            "Aufhebung eines repressiven Verbots im Einzelfall"
                                        ],
                                        "tags": [
                                            "Polizeirecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bac18d3e-fb6f-4566-8841-eeb66ddb269a",
                                                "sense_id": "23ffaa83-90d3-3af5-a9d6-216d331a9905",
                                                "text": "Bei Vorliegen der Genehmigungsvoraussetzungen besteht auf die Baugenehmigung, die eine Erlaubnis ist, ein Anspruch, während die Erteilung der wasserrechtlichen Erlaubnis, die eine Befreiung ist, im Ermessen der zuständigen Behörde steht."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
