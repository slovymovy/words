                        "sense_id": "76d82603-5c41-31cb-8e16-f7036584d924",
                        "entry_id": "9a724ac0-55b8-349e-8959-b2c8479f10ef",
                        "glosses": [
                            "Hauptstadt der Ukraine sowie Hauptort und Verwaltungssitz der Oblast Kyiv"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2ed95bdb-de4e-4939-b32d-40ccf205dbcf",
                                "sense_id": "76d82603-5c41-31cb-8e16-f7036584d924",
                                "text": "„Nach Kaiser Karl I. im Kriegsfrühjahr 1917 kam als regierender Besucher aus Wien erst wieder Vizekanzler Busek in den Vorort des einstigen Ostgalizien, der heutigen Westukraine – nach Lviv (russisch und polnisch Lvov, lateinisch Leopolis), das sich in seinem kulturellen Selbstverständnis von Kyiv (Kiew), Charkiv (Charkow) und Odessa aus vielerlei Gründen unterscheidet.“"
                            },
                            {
                                "example_id": "fac28acb-6439-4e15-a979-22398e8fc3c5",
                                "sense_id": "76d82603-5c41-31cb-8e16-f7036584d924",
                                "text": "«Seit 1934 ist Kyiv anstelle von Charkow die Hauptstadt der Ukraine und zählt heute 2,8 Millionen Einwohner.»"
                            }
                        ],
                        "sense_index_json": "\"1\""
