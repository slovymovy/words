                                        "sense_id": "e827833f-6db0-3138-ad65-39bc69d4c9f4",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "The bottom of a pit, pothole or mine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37531bc7-d664-399c-acf5-5c384654abb6",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "The largest integer less than or equal to a given number."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65dace27-c782-4a60-a93d-c6162544ac4b",
                                                "sense_id": "37531bc7-d664-399c-acf5-5c384654abb6",
                                                "text": "The floor of 4.5 is 4."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62eae8cc-5d1d-3def-8e36-8a089006a6ea",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "An event performed on a floor-like carpeted surface; floor exercise"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17f35f35-801a-3985-9545-f16406f3c63a",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "A floor-like carpeted surface for performing gymnastic movements."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "343ea1d2-daad-3505-a730-5442a19c6491",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "A lower limit or minimum on a price or rate, a price floor. Opposite of a cap or ceiling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53f79c3f-d507-3b1a-9e4a-2a51da6afe7d",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "A dance floor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07c0d2bb-854b-465a-ab5d-eea470e911d6",
                                                "sense_id": "53f79c3f-d507-3b1a-9e4a-2a51da6afe7d",
                                                "text": "She's a maniac, maniac on the floor / And she's dancing like she never danced before"
                                            },
                                            {
                                                "example_id": "056765cc-620c-4d76-a4bd-20814247d903",
                                                "sense_id": "53f79c3f-d507-3b1a-9e4a-2a51da6afe7d",
                                                "text": "Open the door, get on the floor / Everybody walk the dinosaur"
                                            },
                                            {
                                                "example_id": "ab73d670-a2d3-43f9-829e-861dae251de1",
                                                "sense_id": "53f79c3f-d507-3b1a-9e4a-2a51da6afe7d",
                                                "text": "Meet me on the floor tonight\nShow me how to move like the water"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6dde280-f04f-3548-b2f0-1c4e89962e59",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "The trading floor of a stock exchange, pit; the area in which business is conducted at a convention or exhibition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e62869a-947e-3f9f-bd95-f861a2a2af11",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "The area of a casino where gambling occurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "909457d0-b7e4-477c-8871-7351a6a7e3de",
                                                "sense_id": "0e62869a-947e-3f9f-bd95-f861a2a2af11",
                                                "text": "At each table stood a young, slim, poker-faced croupier serving the punters who anxiously watched the turning of the cards. The next two floors were similar though not quite as spectacular and the stakes were lower."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed8f40d8-aa19-3d31-81aa-b493d4d50004",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "The area of an establishment where food and drink are served to customers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bad40e4-1a97-499f-8c2d-113a72ef58da",
                                                "sense_id": "ed8f40d8-aa19-3d31-81aa-b493d4d50004",
                                                "text": "The conference started as an impromptu session in the coffee shop this morning when waitresses walked off the floor rather than serve four Negro men and women delegates."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "floor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d53148a1-2098-3fdf-aca9-c2855ac1acb7",
                                        "entry_id": "f27bf7a2-696b-37eb-9313-08d5510e34bf",
                                        "glosses": [
                                            "To cover or furnish with a floor."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07e4dc37-933a-4288-a331-e4c530c50755",
                                                "sense_id": "d53148a1-2098-3fdf-aca9-c2855ac1acb7",
                                                "text": "floor a house with pine boards"
                                            },
                                            {
                                                "example_id": "dd8008c4-83c0-4062-962f-aae0d4c28b35",
                                                "sense_id": "d53148a1-2098-3fdf-aca9-c2855ac1acb7",
                                                "text": "The huge square box, parquet-floored and high-ceilinged, had been arranged to display a suite of bedroom furniture designed and made in the halcyon days of the last quarter of the nineteenth century,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37e58229-1b98-3ef4-962b-28cc3750a4cd",
                                        "entry_id": "f27bf7a2-696b-37eb-9313-08d5510e34bf",
                                        "glosses": [
                                            "To strike down or lay level with the floor; to knock down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "738df84e-8876-4014-85dd-f1d7abd08577",
                                                "sense_id": "37e58229-1b98-3ef4-962b-28cc3750a4cd",
                                                "text": "Sam floored him perpetually, and beat his face to a jelly, without getting a scratch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f508fdb5-4306-3889-91e9-2b1f6e61efb1",
                                        "entry_id": "f27bf7a2-696b-37eb-9313-08d5510e34bf",
                                        "glosses": [
                                            "To hang (a picture on exhibition) near the base of a wall, where it cannot easily be seen."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5f1b60b-f7e6-3df6-9131-85c498a7a654",
                                        "entry_id": "f27bf7a2-696b-37eb-9313-08d5510e34bf",
                                        "glosses": [
                                            "To push (a pedal) down to the floor, especially to accelerate."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b37ae085-6a16-4fbc-a4d7-56be0dfaa004",
                                                "sense_id": "d5f1b60b-f7e6-3df6-9131-85c498a7a654",
                                                "text": "our driver floored the pedal"
                                            },
                                            {
                                                "example_id": "926bd728-9c63-45af-be82-7f44597062a8",
                                                "sense_id": "d5f1b60b-f7e6-3df6-9131-85c498a7a654",
                                                "text": "I don't remember much about the flight from Chicago to Denver. We landed a little after eleven, and I ran through the airport, ran to my car. Floored it most of the way home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0de17fdb-26f6-30cd-820f-98e43e91bef9",
                                        "entry_id": "f27bf7a2-696b-37eb-9313-08d5510e34bf",
                                        "glosses": [
                                            "To silence by a conclusive answer or retort."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1db65ac6-b4bb-4fc6-8e54-d77bf1c93284",
                                                "sense_id": "0de17fdb-26f6-30cd-820f-98e43e91bef9",
                                                "text": "floor an opponent"
                                            },
                                            {
                                                "example_id": "e4b29aa5-15d3-4a30-aee5-abe9bda444d6",
                                                "sense_id": "0de17fdb-26f6-30cd-820f-98e43e91bef9",
                                                "text": "Floored or crushed by him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d44a28b-2d07-38f5-8083-ce7cfa9420a5",
                                        "entry_id": "f27bf7a2-696b-37eb-9313-08d5510e34bf",
                                        "glosses": [
                                            "To amaze or greatly surprise."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ce4e7db-f898-4681-8529-f96182a1790d",
                                                "sense_id": "5d44a28b-2d07-38f5-8083-ce7cfa9420a5",
                                                "text": "We were floored by his confession."
                                            },
                                            {
                                                "example_id": "dba929af-9375-4d98-aee0-c75ec4065d04",
                                                "sense_id": "5d44a28b-2d07-38f5-8083-ce7cfa9420a5",
                                                "text": "Some of the attendees were “absolutely floored,” said an official familiar with the proceedings. That someone in the U.S. government could “make an argument that is so nakedly against transparency, in light of the unfolding catastrophe, was…shocking and disturbing.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bba707cd-582d-3a1f-bfcb-4c7aa6523078",
                                        "entry_id": "f27bf7a2-696b-37eb-9313-08d5510e34bf",
                                        "glosses": [
                                            "To finish or make an end of."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67440d97-8298-4041-bf17-1a99c110949b",
                                                "sense_id": "bba707cd-582d-3a1f-bfcb-4c7aa6523078",
                                                "text": "floor a college examination"
                                            },
                                            {
                                                "example_id": "11542e7a-7531-4080-be57-853e17c864c8",
                                                "sense_id": "bba707cd-582d-3a1f-bfcb-4c7aa6523078",
                                                "text": "I've floored my little-go work"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da8083f8-bf87-3e84-ba6c-d496e13037cc",
                                        "entry_id": "f27bf7a2-696b-37eb-9313-08d5510e34bf",
                                        "glosses": [
                                            "To set a lower bound."
                                        ],
                                        "tags": [],
                                        "examples": [
