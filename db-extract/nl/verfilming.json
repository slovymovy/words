                    {
                        "sense_id": "8c847a42-7711-3fd6-89e3-27464c660363",
                        "entry_id": "b82e02f8-99f6-3a52-9ac1-7030f77da574",
                        "glosses": [
                            "een film is gebaseerd op een ander medium, zoals een boek, strip of toneelstuk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da8250f6-a6e4-4870-ad92-f2c40929a5ea",
                                "sense_id": "8c847a42-7711-3fd6-89e3-27464c660363",
                                "text": "Ik voel me als Marcello Mastroianni in de Tsjechov-verfilming Otsji Tsjornye (Zwarte Ogen) van regisseur Nikita Michalkov."
                            },
                            {
                                "example_id": "7dc4a824-adf3-4c72-bb2d-69b58417c12c",
                                "sense_id": "8c847a42-7711-3fd6-89e3-27464c660363",
                                "text": "Eerder op de avond had Ariana DeBose Beste Vrouwelijke Bijrol gewonnen voor haar rol in West Side Story. Zij bedankte als latina de 90-jarige Rita Moreno, die zes decennia geleden dezelfde prijs kreeg voor de originele verfilming van het verhaal. \"Ik ben zo blij dat jouw Anita de weg heeft geplaveid voor duizenden Anita's zoals ik\", zei de actrice."
                            }
                        ]
                    }
