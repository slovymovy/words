{
    "word_family": [
        "surprise",
        "surprenant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f39e311c-00bf-3439-afdd-db99665a4325",
                    "sense_definition": "Étonner quelqu'un par un comportement, un événement ou un fait inattendu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "etonnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette annonce soudaine ne va <w>surprendre</w> personne dans l'entreprise."
                        },
                        {
                            "text": "Son calme impressionnant m'a beaucoup <w>surpris</w> après cette mauvaise nouvelle."
                        }
                    ],
                    "synonyms": [
                        "étonner",
                        "ébahir"
                    ],
                    "common_phrases": [
                        "surprendre agréablement"
                    ]
                },
                {
                    "sense_id": "604fb3de-35e1-3753-8395-819c6121746d",
                    "sense_definition": "Prendre à l'improviste ou au dépourvu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "imprevu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La pluie torrentielle a <w>surpris</w> les randonneurs au milieu de la forêt."
                        },
                        {
                            "text": "Notre équipe a réussi à <w>surprendre</w> ses adversaires dès le début du match."
                        }
                    ],
                    "synonyms": [
                        "cueillir à froid",
                        "prendre à l'improviste",
                        "prendre au dépourvu",
                        "prendre de court",
                        "prendre par surprise",
                        "prendre sans vert"
                    ],
                    "common_phrases": [
                        "surprendre l'ennemi"
                    ]
                },
                {
                    "sense_id": "d01878ea-c81c-3d0c-a69e-a925268bfc6b",
                    "sense_definition": "Découvrir ou attraper quelqu'un sur le fait alors qu'il se croyait caché.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "decouverte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gardien a <w>surpris</w> un voleur en train d'escalader la grille du jardin."
                        },
                        {
                            "text": "La mère a <w>surpris</w> les enfants qui mangeaient du chocolat en cachette."
                        }
                    ],
                    "common_phrases": [
                        "surprendre en train de"
                    ]
                },
                {
                    "sense_id": "3b8e14f9-8050-3607-b2d7-2ddad2d0ba9e",
                    "sense_definition": "Percevoir, remarquer ou intercepter furtivement des gestes, des paroles ou des secrets.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En passant dans le couloir, j'ai involontairement <w>surpris</w> quelques bribes de leur conversation."
                        },
                        {
                            "text": "Elle a <w>surpris</w> un regard complice échangé discrètement entre les deux complices."
                        }
                    ],
                    "common_phrases": [
                        "surprendre une conversation",
                        "surprendre un regard"
                    ]
                },
                {
                    "sense_id": "5793bbd3-c6c0-30fa-a302-fe213a67dad3",
                    "sense_definition": "Abuser de la bonne foi ou de la crédulité de quelqu'un par artifice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tromperie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'escroc a su habilement <w>surprendre</w> la bonne foi de ses victimes pour les dépouiller."
                        },
                        {
                            "text": "L'accusé a tenté de <w>surprendre</w> la confiance des juges avec de faux témoignages."
                        }
                    ],
                    "common_phrases": [
                        "surprendre la bonne foi",
                        "surprendre la confiance"
                    ]
                }
            ]
        }
    ]
}