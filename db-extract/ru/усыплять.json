                "senses": [
                    {
                        "sense_id": "39b7d67c-72c8-342f-94be-5085efcb9576",
                        "entry_id": "6733bd0f-03cb-33e0-b5a8-a45fd252697a",
                        "glosses": [
                            "навеивать сон"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bc7e9d4-8db5-4f9f-a093-815b7035311e",
                                "sense_id": "39b7d67c-72c8-342f-94be-5085efcb9576",
                                "text": "Ко мне, мой младенец; в дуброве моей // Узнаешь прекрасных моих дочерей: // При месяце будут играть и летать, // Играя, летая, тебя усыплять."
                            }
                        ]
                    },
                    {
                        "sense_id": "fed3fa69-5b59-3c65-954e-e53c215695da",
                        "entry_id": "6733bd0f-03cb-33e0-b5a8-a45fd252697a",
                        "glosses": [
                            "разг. убивать животное, вкалывая особый препарат"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f67ce7ed-befb-420c-bebb-8dfdf0484a96",
                                "sense_id": "fed3fa69-5b59-3c65-954e-e53c215695da",
                                "text": "Ветеринар стал усыплять собаку, у которой отказали почки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "062afe17-870a-4abc-aac4-276cdf5aa7e9",
                        "source_entry_id": "6733bd0f-03cb-33e0-b5a8-a45fd252697a",
                        "source_sense_description": "навеивать сон",
                        "target_lang_word": "lull",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lull",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "965ffa1a-3e35-3fe1-b7e6-8ff709c233cf",
                                        "entry_id": "3365ce6f-fe9c-39af-b13f-bf677ec9f6e1",
                                        "glosses": [
                                            "A period of rest or soothing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41eca79e-7034-3e1b-b89f-06ae765c7e82",
                                        "entry_id": "3365ce6f-fe9c-39af-b13f-bf677ec9f6e1",
                                        "glosses": [
                                            "A period of reduced activity; a respite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92d65073-bc46-30da-9c6e-b11f1d7b4cdb",
                                        "entry_id": "3365ce6f-fe9c-39af-b13f-bf677ec9f6e1",
                                        "glosses": [
                                            "A period without waves or wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c1683cc-d82e-415b-886b-a90aa909fcec",
                                                "sense_id": "92d65073-bc46-30da-9c6e-b11f1d7b4cdb",
                                                "text": "[…] during the lull, wind shifted to S. E. […]"
                                            },
                                            {
                                                "example_id": "77369223-699a-443d-814b-80838a942a9f",
                                                "sense_id": "92d65073-bc46-30da-9c6e-b11f1d7b4cdb",
                                                "text": "After the lull the wind does not appear to have blown with any great strength […]"
                                            },
                                            {
                                                "example_id": "d9017816-f1dc-4b24-a31a-e1ca711f0de6",
                                                "sense_id": "92d65073-bc46-30da-9c6e-b11f1d7b4cdb",
                                                "text": "The air under each cloud has spent time near the surface, has been slowed and backed by friction—it is a lull."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d274a94-d0fa-37bf-a31f-9071e79c0a16",
                                        "entry_id": "3365ce6f-fe9c-39af-b13f-bf677ec9f6e1",
                                        "glosses": [
                                            "An extended pause between sets of waves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2064f61-1eb9-4d8a-8b65-c54a78bbf676",
                                                "sense_id": "1d274a94-d0fa-37bf-a31f-9071e79c0a16",
                                                "text": "It is advisable to leave the surf zone during the lull between sets of larger waves, waiting outside the surf zone for a lull."
                                            },
                                            {
                                                "example_id": "bcc33ee5-86e7-490f-8dd4-61464ec0b522",
                                                "sense_id": "1d274a94-d0fa-37bf-a31f-9071e79c0a16",
                                                "text": "About 2 hours in, a long lull cleared everyone out, and then it started getting a little more consistent and pushing chest ta neck high."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lull",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36f82b84-e30b-3839-9aa5-83d9fce1445f",
                                        "entry_id": "c343b338-f2d4-3f39-b035-449beb7f2da8",
                                        "glosses": [
                                            "To cause to rest by soothing influences; to compose; to calm"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d070aad3-2f21-4000-9440-34a2a85df0c3",
                                                "sense_id": "36f82b84-e30b-3839-9aa5-83d9fce1445f",
                                                "text": "To lull him soft a sleepe"
                                            },
                                            {
                                                "example_id": "e6740966-2645-4e2e-acfd-5073c1eac1ae",
                                                "sense_id": "36f82b84-e30b-3839-9aa5-83d9fce1445f",
                                                "text": "Such ſweet compulſion doth in muſick ly, / To lull the daughers of Neceſſity,"
                                            },
                                            {
                                                "example_id": "6f049317-63e3-452b-b6b7-1e2845e8b9d1",
                                                "sense_id": "36f82b84-e30b-3839-9aa5-83d9fce1445f",
                                                "text": "To lull with song an aching heart"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e7cd12f-8ef6-3de9-8e55-91a8aa486f10",
                                        "entry_id": "c343b338-f2d4-3f39-b035-449beb7f2da8",
                                        "glosses": [
