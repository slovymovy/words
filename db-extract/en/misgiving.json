                                                "sense_id": "ddde5935-e17f-3440-80f7-48599fe92d68",
                                                "text": "Unser Bedenken der Problematik sollte möglichst bald erfolgen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0405d155-6ffd-36bc-9946-6d26052d0daa",
                                        "entry_id": "68abfec6-043c-3da2-8691-10b29b9619f1",
                                        "glosses": [
                                            "aufgrund von Nachdenken entstandener Vorbehalt, Zweifel"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00efc3b2-0b78-4145-b175-c33f3f8bb59d",
                                                "sense_id": "0405d155-6ffd-36bc-9946-6d26052d0daa",
                                                "text": "Ich muss dazu auch mein Bedenken äußern."
                                            },
                                            {
                                                "example_id": "d30e5f54-e87a-44c4-9d1c-8bf742b0500a",
                                                "sense_id": "0405d155-6ffd-36bc-9946-6d26052d0daa",
                                                "text": "Auf Seiten der Spezialisten bestehen keinerlei Bedenken."
                                            },
                                            {
                                                "example_id": "3f2b7121-0ce0-4507-a1b5-e68b7c26094b",
                                                "sense_id": "0405d155-6ffd-36bc-9946-6d26052d0daa",
                                                "text": "„Beim Abschied stellte ich mit Genugtuung fest, daß ihr Gesicht nicht die geringste Spur von Bedenken zeigte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
