                "senses": [
                    {
                        "sense_id": "e690368f-3e2b-3bd6-8576-afb13b2e17db",
                        "entry_id": "15798107-82a5-3faa-beac-0d9a4f615fef",
                        "glosses": [
                            "Massif montagneux ou montagne, en Afrique du Nord ou au Moyen-Orient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27603227-af2e-4382-99df-ef122e7960a6",
                                "sense_id": "e690368f-3e2b-3bd6-8576-afb13b2e17db",
                                "text": "Nous les hommes des douars lointains, des hauts djebels, des larges vallées, nous savions que l’on ne bâtit pas sa maison si l’on n’a pas confiance dans la solidité du sol."
                            },
                            {
                                "example_id": "68324d80-5860-4a71-8ba5-71fbcc0d6cfb",
                                "sense_id": "e690368f-3e2b-3bd6-8576-afb13b2e17db",
                                "text": "L’ennemi réel n’était pas le pauvre nhaqué enfoui dans la boue des rizières, le chleuh retrouvant son moukkala, le fellaga terré dans son djebel."
                            },
                            {
                                "example_id": "bb3f5434-b953-4442-addb-bdf860ccf109",
                                "sense_id": "e690368f-3e2b-3bd6-8576-afb13b2e17db",
                                "text": "Je décidais de faire passer notre unité entre Vialar (Tissemsilt) et Taine (Layoune), pour, ensuite espérer atteindre au bout d’une longue étape de plat, la pointe nord-est du djebel Nador."
                            }
                        ]
                    }
                ],
