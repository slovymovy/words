                "senses": [
                    {
                        "sense_id": "f769ecac-bba4-384b-9f20-fec0bd2d1651",
                        "entry_id": "ca893781-2419-38b5-8c24-91f04b58ae83",
                        "glosses": [
                            "to play pranks, to make mischief"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34c095b3-10a2-4841-b3f0-1585a2113604",
                                "sense_id": "f769ecac-bba4-384b-9f20-fec0bd2d1651",
                                "text": "Промота́в в Москве́ бо́льшую часть име́ния своего́, и на ту по́ру овдове́в, уе́хал он в после́днюю свою́ дере́вню, где продолжа́л прока́зничать, но уже́ в но́вом ро́де.",
                                "translation": "Having squandered the greater part of his fortune in Moscow and become a widower at the same time, he left for the last of his holdings, where he went on playing pranks, but now of a different sort.",
                                "english": "Having squandered the greater part of his fortune in Moscow and become a widower at the same time, he left for the last of his holdings, where he went on playing pranks, but now of a different sort."
                            }
                        ]
                    },
