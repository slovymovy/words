                                        "entry_id": "6beb785a-20f9-394b-bb9e-821643fc4cf3",
                                        "glosses": [
                                            "Variante orthographique de volte-face."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
