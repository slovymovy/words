                "forms": [
                    {
                        "form_id": "c8c18448-b198-40bf-897d-e4556192d91c",
                        "entry_id": "ea724935-27b3-3fcf-b54c-9c008eff0171",
                        "tags": [
                            "plural"
                        ],
                        "form": "gaures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df1a1baa-9e84-3ef2-9f7f-2b0661028c8d",
                        "entry_id": "ea724935-27b3-3fcf-b54c-9c008eff0171",
                        "glosses": [
                            "Zoroastrien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45581a6e-e480-4f80-adc1-9a2fed1056d7",
                                "sense_id": "df1a1baa-9e84-3ef2-9f7f-2b0661028c8d",
                                "text": "Quand on y parle d’un gaure, on entend toujours un adorateur du feu, un ignicole, un idolâtre par excellence. Ils ont un fauxbourg à Ispahan, capitale de Perse."
                            },
                            {
                                "example_id": "7b2a5012-bd6d-45ae-a3df-b1e77ceb1606",
                                "sense_id": "df1a1baa-9e84-3ef2-9f7f-2b0661028c8d",
                                "text": "Les Gaures sont aujourd'hui répandus en plusieurs endroits de la Perse, principalement dans le Kirman. Cette province étant la plus mauvaise et la moins fertile de toute la Perse, les Mahométans, qui ne se soucient pas d'y demeurer, y laissent les Gaures vivre et jouir paisiblement de l'exercice de leur religion. Partout ailleurs les Perses Mahométans les traitent avec beaucoup de mépris."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
