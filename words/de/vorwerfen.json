                },
                {
                    "sense_id": "350d338f-55de-3a0a-8ec6-cdd8e6627c2d",
                    "sense_definition": "Futter vor Tiere auf den Boden werfen, damit sie es fressen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "füttern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Bauer <w>warf</w> den hungrigen Schweinen am frühen Morgen frisches Futter <w>vor</w>."
                        },
                        {
                            "text": "Man sollte den Hunden keinesfalls spitze Geflügelknochen als Nahrung <w>vorwerfen</w>."
