                "senses": [
                    {
                        "sense_id": "d4fca66e-8d2c-384a-a5d1-b5aeb47433b1",
                        "entry_id": "81da81d3-ca90-3e96-a4c7-e8607b6fb584",
                        "glosses": [
                            "zwolennik neoliberalizmu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b3377af-d677-4bc9-af54-dcfa36c924ea",
                                "sense_id": "d4fca66e-8d2c-384a-a5d1-b5aeb47433b1",
                                "text": "Koalicja dwóch neoliberalnych partii byłaby czytelnym sygnałem, że neoliberałowie, widząc w sondażach utratę zaufania wyborców, w desperackich sojuszach szukają dla siebie ratunku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff0e4a9a-c58e-48d0-a9b1-fde7835ddc31",
                        "source_entry_id": "81da81d3-ca90-3e96-a4c7-e8607b6fb584",
                        "source_sense_id": "d4fca66e-8d2c-384a-a5d1-b5aeb47433b1",
                        "target_lang_word": "neoliberal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neoliberal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57101d6f-4e58-319f-994a-a51ad60481ce",
                                        "entry_id": "e360e6b8-8083-3cb9-9a5c-db7e3c71a922",
                                        "glosses": [
                                            "In accordance with, or subscribing to, neoliberalism."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92292c7d-75fe-4db2-a552-437f82050f35",
                                                "sense_id": "57101d6f-4e58-319f-994a-a51ad60481ce",
                                                "text": "She showed that homonormativity, within the overarching framework of a heteronormative society, has a class dimension: it reflects the ways that a layer of lesbian/gay people are adapting in order to occupy a secure niche within the neoliberal order."
                                            },
                                            {
                                                "example_id": "6f446f09-2fd4-437c-9d11-0e28818094f1",
                                                "sense_id": "57101d6f-4e58-319f-994a-a51ad60481ce",
                                                "text": "The masculine discourse of the street workout includes a combination of concepts of strong physicality significant for traditional models of masculinity, alongside neoliberal discourses of individual responsibility for bodily self-production."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neoliberal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87903c3f-a0ea-32a9-92f6-bbb1725fb7a5",
                                        "entry_id": "98d113b9-8c2c-3fd3-a07f-10eaa7e0f9c9",
                                        "glosses": [
                                            "A person who subscribes to neoliberalism."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "372c8272-ddc0-4b68-b5c5-14d2c689e82b",
                                                "sense_id": "87903c3f-a0ea-32a9-92f6-bbb1725fb7a5",
                                                "text": "The neoliberals stand today in somewhat the position neoconservatives occupied a decade ago. Their ambition is to attain the influence in liberal politics that the neoconservatives have attained in conservative politics."
                                            },
                                            {
                                                "example_id": "ab07dda0-cea6-444c-879d-62b0fe1d434f",
                                                "sense_id": "87903c3f-a0ea-32a9-92f6-bbb1725fb7a5",
                                                "text": "Neoliberals readily admit that economic liberalization causes some dislocations, but they view such collateral damage as necessary for the longer term gains of increased productivity and efficiency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
