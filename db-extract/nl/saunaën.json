                "translations": [
                    {
                        "translation_id": "f61a46d1-2e74-4e2e-893c-2473b564ba35",
                        "source_entry_id": "8ca81525-0955-3df4-9c25-3e6fc5305e92",
                        "source_sense_id": "ae268616-f3d3-3e9a-ac2e-c44d281399b9",
                        "source_sense_description": "in een sauna gaan",
                        "target_lang_word": "sauna",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sauna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75ed3104-4d1f-33e3-8baf-92ea65b37031",
                                        "entry_id": "27096432-a180-3579-ad2c-5a71febd5826",
                                        "glosses": [
                                            "A room or a house designed for heat sessions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "255ddbfe-63df-4c51-8acf-a291e7df5d2c",
                                                "sense_id": "75ed3104-4d1f-33e3-8baf-92ea65b37031",
                                                "text": "The hotel has a sauna in the basement."
                                            },
                                            {
                                                "example_id": "06a928a0-2b36-4659-8f53-7090776de0b2",
                                                "sense_id": "75ed3104-4d1f-33e3-8baf-92ea65b37031",
                                                "text": "Of course, it will never get -100 here like it does in Antarctica, but a 300-degree swing was still theoretically possible on a record-cold Minnesota morning–if we got the sauna hot enough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec0a9389-6e35-355e-bd31-5bc10135a36c",
                                        "entry_id": "27096432-a180-3579-ad2c-5a71febd5826",
                                        "glosses": [
                                            "The act of using a sauna."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dd80882-4fbb-4353-be1e-a508d4c620d9",
                                                "sense_id": "ec0a9389-6e35-355e-bd31-5bc10135a36c",
                                                "text": "John had a sauna after his swim."
                                            },
                                            {
                                                "example_id": "6f57be9e-4416-4ed2-b7b0-fa20b73d2172",
                                                "sense_id": "ec0a9389-6e35-355e-bd31-5bc10135a36c",
                                                "text": "Joanne went for a sauna after her swim."
                                            },
                                            {
                                                "example_id": "e389b2a7-090c-4d72-b516-6afba7f42f19",
                                                "sense_id": "ec0a9389-6e35-355e-bd31-5bc10135a36c",
                                                "text": "One of my favorite saunas was just one go and thirteen minutes long, including clean up time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "044c9d88-3fd6-393a-94bb-f250d0843c25",
                                        "entry_id": "27096432-a180-3579-ad2c-5a71febd5826",
                                        "glosses": [
                                            "A public sauna."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa6592dd-b640-393c-81cc-e3d2e0c549ab",
                                        "entry_id": "27096432-a180-3579-ad2c-5a71febd5826",
                                        "glosses": [
                                            "In some countries, a business with bath-like facilities that is actually a brothel or a place for (non-commercial) sexual encounters; a bathhouse or massage parlour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a62a78d5-a9d2-497e-b412-ab2363c6acb2",
                                                "sense_id": "aa6592dd-b640-393c-81cc-e3d2e0c549ab",
                                                "text": "McPhail ran Maitland's brothels—knocking-shops in Maryhill, Riddrie, Dennistoun, and the more upscale saunas in the West End and city centre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c21fc7de-8097-3625-800c-d46c65533a79",
                                        "entry_id": "27096432-a180-3579-ad2c-5a71febd5826",
                                        "glosses": [
                                            "A very hot place or room."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
