                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fbc5e1ad-9558-31ec-9c0e-fa830b0a23ee",
                        "entry_id": "8ad5437d-b60e-3634-93fb-d29b1fa04bd8",
                        "glosses": [
                            "Of or relating to the Hazaras, an ethnic group from central Afghanistan."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4aac1c84-94bd-49d3-9601-8600e58f6f75",
                                "sense_id": "fbc5e1ad-9558-31ec-9c0e-fa830b0a23ee",
                                "text": "Across the stream, a group of local Hazara boys were picking patties of dried cow dung from the ground and stowing them into burlap sacks tethered to their backs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7a6cd06-4c03-4b80-b4bb-2c35127d0e9e",
                        "source_entry_id": "8ad5437d-b60e-3634-93fb-d29b1fa04bd8",
                        "source_sense_id": "fbc5e1ad-9558-31ec-9c0e-fa830b0a23ee",
