    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0906fe73-13e9-319a-9c50-ba1dd102ec56",
                    "sense_definition": "Rendre une chose ou une situation mauvaise, désagréable ou inutilisable ; ruiner.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "alteration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La pluie persistante a failli <w>gâcher</w> notre pique-nique dans le parc."
                        },
                        {
                            "text": "Une seule remarque déplacée peut <w>gâcher</w> l'ambiance de toute la soirée."
                        }
                    ],
                    "common_phrases": [
                        "gâcher la fête",
                        "gâcher la vie",
                        "gâcher son plaisir"
                    ]
                },
                {
                    "sense_id": "407754de-394c-34fc-aefe-b318a8a60f6e",
                    "sense_definition": "Exécuter un travail avec négligence ou sans soin ; bâcler.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alteration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan s'est trop pressé et a fini par <w>gâcher</w> son ouvrage."
                        },
                        {
                            "text": "Si tu vas trop vite, tu risques de <w>gâcher</w> la besogne au lieu d'avancer."
                        }
                    ],
                    "common_phrases": [
                        "gâcher la besogne",
                        "gâcher le travail"
                    ]
                },
                {
                    "sense_id": "5a0b22f6-4c02-388b-b469-aae5dc5003ae",
                    "sense_definition": "Délayer du plâtre, de la chaux ou du mortier avec de l'eau.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maçon prépare son auge pour <w>gâcher</w> le plâtre nécessaire aux finitions."
                        },
                        {
                            "text": "Il faut apprendre à bien <w>gâcher</w> le mortier selon les bonnes proportions."
                        }
                    ],
                    "synonyms": [
                        "corroyer"
                    ],
                    "common_phrases": [
                        "gâcher du plâtre",
                        "gâcher du mortier"
                    ]
                },
                {
                    "sense_id": "173d7a8e-5276-352f-b12d-baad0a5f1c45",
                    "sense_definition": "Recouvrir de terre les racines d'une plante ou une meule de paille.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cultivateur décida de <w>gâcher</w> le blé pour protéger les racines contre le froid."
                        },
                        {
                            "text": "Les ouvriers agricoles ont fini de <w>gâcher</w> la meule avant l'arrivée de l'orage."
                        }
                    ],
                    "common_phrases": [
                        "gâcher du blé"
                    ]
                }
            ]
        }
    ]
