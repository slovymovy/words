                        "entry_id": "2e4d4b46-ac5b-31b9-a5e7-2484ad921154",
                        "glosses": [
                            "Qui se rapporte aux ophites, membres d’une secte gnostique du IIᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3da895b6-ded6-4749-936c-54a0bfd592ca",
                                "sense_id": "1223adcd-41f8-38f2-94ef-b0ad33eb2cd5",
                                "text": "Les Ophites sont représentés par l’écrit naassène utilisé par Hippolyte, le psaume naassène sur l’Ame, un fragment du livre de Baruch du gnostique Justin."
                            },
                            {
                                "example_id": "8106d9a5-8d1f-43df-a5bb-7ac190345cfc",
                                "sense_id": "1223adcd-41f8-38f2-94ef-b0ad33eb2cd5",
                                "text": "Autant le gnostique naassène avait l’esprit confus, autant le Pérate pense clairement."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
