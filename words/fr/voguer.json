                    ]
                },
                {
                    "sense_id": "d5a039e1-5ded-3b8b-a667-3d7eacae1841",
                    "sense_definition": "Progresser, passer d'un état ou d'une situation à une autre, souvent au gré des circonstances.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "evolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après son départ de l'entreprise, il <w>vogue</w> vers de nouvelles aventures."
                        },
                        {
                            "text": "Sans véritable stratégie, la jeune société <w>voguait</w> de crise en crise."
