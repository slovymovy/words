                        "cross_references": []
                    },
                    {
                        "translation_id": "09c87434-a9e2-4c5b-b118-8706ba921401",
                        "source_entry_id": "17a0d71b-e9f5-3984-99d9-e27019b5a347",
                        "source_sense_description": "surname",
                        "target_lang_word": "Ме́ркель",
