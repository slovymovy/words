                        "sense_id": "c33ad135-e6c6-385a-aba9-7a6e809b3a4b",
                        "entry_id": "aa5f4bd3-9390-39f6-aa0c-60ffd885e3f7",
                        "glosses": [
                            "The list of successful candidates in such an examination."
