                                "target_senses": [
                                    {
                                        "sense_id": "dcecfb01-2a34-37ac-998e-2b114be6eac7",
                                        "entry_id": "86d158bc-0bc0-3599-96c8-49917793c4ec",
                                        "glosses": [
                                            "nicht sofort handelnd; abwartend; sich nicht sofort entscheiden könnend; eventuell dabei ängstlich / sehr vorsichtig sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8f85f10-1296-4813-9688-76aca6d59de9",
                                                "sense_id": "dcecfb01-2a34-37ac-998e-2b114be6eac7",
                                                "text": "Zögernd gab das kleine Mädchen dem Fremden die Hand."
                                            },
                                            {
                                                "example_id": "7fc85430-9d64-4539-a6aa-ce4b30cb8a2d",
                                                "sense_id": "dcecfb01-2a34-37ac-998e-2b114be6eac7",
                                                "text": "Der Hund näherte sich erst zögernd, als ich ihn streichelte, wedelte er mit dem Schwanz."
                                            },
                                            {
                                                "example_id": "5df6b8cc-46fd-4772-aee6-4b8c47c32323",
                                                "sense_id": "dcecfb01-2a34-37ac-998e-2b114be6eac7",
                                                "text": "Er [Außenminister Frank-Walter Steinmeier] war als erster der Bundesregierung bereit, nach dem letzten Unglück eine bessere Seenotrettung einzufordern, zögernd sind ihm dann Bundesinnenminister Thomas de Maizière und Kanzlerin Angela Merkel gefolgt."
                                            },
                                            {
                                                "example_id": "9de349ef-b8a9-4b61-bbbc-d8333d8bb0d3",
                                                "sense_id": "dcecfb01-2a34-37ac-998e-2b114be6eac7",
                                                "text": "Auf die Unterschiede in ihren Religionen angesprochen, sehen sich Joris, Yousra, Fatima und Clara etwas ratlos an. \"Die Muslime lesen im Koran und die Christen in der Bibel\", erklärt die siebenjährige Yousra zögernd."
                                            },
                                            {
                                                "example_id": "b11ca2fd-6e1f-47b9-862e-d632b6024b52",
                                                "sense_id": "dcecfb01-2a34-37ac-998e-2b114be6eac7",
                                                "text": "Ratlos und bedröppelt standen die Schalker Spieler nach [einem 0:0 gegen den FC Augsburg nach] dem Abpfiff am Mittelkreis, nur zögernd schlurften sie dann zu den eigenen Fans in die Gästekurve."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
