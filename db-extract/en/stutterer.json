                    {
                        "translation_id": "2014eab5-b854-4264-857b-0ae4f34ef086",
                        "source_entry_id": "ac8b6800-90de-308a-892c-df82ab833576",
                        "source_sense_id": "30518b6f-b02c-31af-8b64-cb4e7a998152",
