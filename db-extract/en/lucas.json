                "translations": [
                    {
                        "translation_id": "9ef1e873-8cb5-48e3-92d7-c3def7e2882d",
                        "source_entry_id": "b40ae42c-0771-386f-bc6f-61b6ed8540b3",
                        "source_sense_description": "surname",
                        "target_lang_word": "Lucas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lucas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb1c7c5f-dcb6-39cf-ad2f-220088f19ed7",
                                        "entry_id": "2b40c891-244b-30d6-8db2-ab50483c20fa",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84845763-8cf2-425b-b2f6-49f96161f01d",
                                                "sense_id": "fb1c7c5f-dcb6-39cf-ad2f-220088f19ed7",
                                                "text": "Clara, Lucas, Lana, Louane, Joris, Nolan, Ewen s’accordent pour dire leur plaisir d’avoir participé aux sorties."
                                            },
                                            {
                                                "example_id": "1518c6cf-bf67-4c3b-a9dd-4bc0e223854a",
                                                "sense_id": "fb1c7c5f-dcb6-39cf-ad2f-220088f19ed7",
                                                "text": "Attention, Lucas l’Écolo\n L’eau de ton ruisseau vaut toute une fortune\n Attention, Lucas l’Écolo\n L’eau de ton ruisseau vaut plus que le gros lot!"
                                            },
                                            {
                                                "example_id": "d9dc7e11-2008-4b92-af0b-8152997dd137",
                                                "sense_id": "fb1c7c5f-dcb6-39cf-ad2f-220088f19ed7",
                                                "text": "Ce jeudi 28 juillet, Lucas s’en souviendra longtemps."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Lucas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82eb4007-5957-3d4d-b550-aca47f5bd96d",
                                        "entry_id": "0f391fdc-275f-30ca-bfc5-ccbe61f76256",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d15fafd4-e919-4f00-a9f8-365ade55bdfb",
                                                "sense_id": "82eb4007-5957-3d4d-b550-aca47f5bd96d",
                                                "text": "Le duo formé d’Émilie Satt et Jean-Karl Lucas, en couple à la ville, sort ce vendredi son troisième album studio"
                                            },
                                            {
                                                "example_id": "254d6ed7-2187-47af-86f2-019967d0d5f8",
                                                "sense_id": "82eb4007-5957-3d4d-b550-aca47f5bd96d",
                                                "text": "George Lucas propose aussi un caméo à Kenny Baker, l’éternel R2D2."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "115b6bd9-6034-49c0-8de6-b0949636d8c1",
                        "source_entry_id": "b40ae42c-0771-386f-bc6f-61b6ed8540b3",
                        "source_sense_description": "surname",
                        "target_lang_word": "Luc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f06c5a7b-cff1-3676-be8c-18d6ac6f517d",
                                        "entry_id": "e1cc9ed6-0509-3b9a-b558-7b4ff0d71fb5",
                                        "glosses": [
                                            "Auteur de l’un des évangiles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Luc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "962e4b4a-1190-3547-a794-bf0fb29685e9",
                                        "entry_id": "853845ac-0223-3976-8e49-b3a30f347159",
                                        "glosses": [
                                            "Commune française, située dans le département de la Lozère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be0045e1-08b5-41a7-b311-f835f94b36fd",
                                                "sense_id": "962e4b4a-1190-3547-a794-bf0fb29685e9",
                                                "text": "L'air sentait la terre humide et la fumée des premiers feux. Ils se hâtèrent. Il fallait servir une soupe bien chaude avant le départ vers le col de Canteperdrix et la montée de Villefort, la Garde Guérin, Luc, Langogne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "817a5626-fffd-3bd2-be99-8cf4ac90853b",
                                        "entry_id": "853845ac-0223-3976-8e49-b3a30f347159",
                                        "glosses": [
                                            "Commune française, située dans le département des Hautes-Pyrénées."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "610a951f-9643-3da4-9fac-0e5a6b6e62d0",
                                        "entry_id": "853845ac-0223-3976-8e49-b3a30f347159",
                                        "glosses": [
                                            "Ancien nom de la commune française Luc-la-Primaube."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Luc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfe97767-2e3b-3d1e-8f5e-264efd9c603e",
                                        "entry_id": "9047020d-6d8a-3ec8-be81-37d48f003b03",
                                        "glosses": [
                                            "Prénom masculin français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deaadd31-8b42-47fb-8b1e-dfe229c32222",
                                                "sense_id": "dfe97767-2e3b-3d1e-8f5e-264efd9c603e",
                                                "text": "Pour commencer, dit Luc, dans un joli minibus vert, le guide à l'accent gaga nous a emmenés, forcément, à Geoffroy-Guichard, qu'il a rebaptisé « le ventre de l’ASS »."
                                            },
                                            {
                                                "example_id": "77d57967-ff7a-4f06-a5d1-e8e6faf908e5",
                                                "sense_id": "dfe97767-2e3b-3d1e-8f5e-264efd9c603e",
                                                "text": "Luc Pace, qui parcourt la France à pied dans le but de sensibiliser à la lutte contre la sclérose en plaques, a été reçu ce mercredi 17 août par les élus locaux de la municipalité angérienne."
                                            },
                                            {
                                                "example_id": "63076d00-2fb5-43a4-854c-8aebca00e42f",
                                                "sense_id": "dfe97767-2e3b-3d1e-8f5e-264efd9c603e",
                                                "text": "Un film d’aventures riche en suspense pour lequel Jean-Pierre et Luc Dardenne ont, pour la première fois, pris le risque de confier les deux rôles principaux à de jeunes néophytes, Joely Mbundu et Pablo Schils."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
