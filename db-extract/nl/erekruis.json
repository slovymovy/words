                    },
                    {
                        "sense_id": "d4c4d9ca-837b-3597-b113-598e748df0e4",
                        "entry_id": "0eb66506-cf6d-328b-930e-acf36be5c046",
                        "glosses": [
                            "onderscheidingsteken horend bij een militaire- of ridderorde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1c88dd2-ea8f-428e-88d4-df6b7ec35751",
                                "sense_id": "d4c4d9ca-837b-3597-b113-598e748df0e4",
                                "text": "Choreografe Anne Teresa De Keersmaeker zal woensdag in Wenen het Oostenrijkse ‘Erekruis voor Wetenschap en Kunst’ ontvangen."
                            },
                            {
                                "example_id": "6a5a1d10-3798-4725-bc55-5bb378aa480e",
                                "sense_id": "d4c4d9ca-837b-3597-b113-598e748df0e4",
                                "text": "Dat hij vandaag het erekruis in ontvangst mocht nemen heeft zijn partner pas vandaag aan hem verteld."
                            },
                            {
                                "example_id": "5f9db1f3-12da-402a-a7d0-df5ff57af56b",
                                "sense_id": "d4c4d9ca-837b-3597-b113-598e748df0e4",
                                "text": "Van bij elkaar ruim 130 jaar ervaring als hofdame werd in maart dit jaar in één keer afscheid genomen. Vijf hofdames, van wie één al onder Juliana was begonnen, zwaaiden af met een Erekruis in de Huisorde van Oranje:"
                            },
                            {
                                "example_id": "bda3ef8d-a1a4-454b-bdaa-394fbb93cca5",
                                "sense_id": "d4c4d9ca-837b-3597-b113-598e748df0e4",
                                "text": "De helft van de 22 werknemers van de Kanselarij heeft de afgelopen weken ruim drieduizend erekruisen in fraaie doosjes gelegd. En evenzoveel oorkondes in mooie kokers gerold."
                            }
                        ]
                    }
