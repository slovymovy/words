                ],
                "senses": [
                    {
                        "sense_id": "4f1fffdd-9be5-3256-80c0-24297e69c48d",
                        "entry_id": "c0dd856a-3c81-3448-814c-12663cfcbc8a",
                        "glosses": [
                            "Tagung, auf der sich Gewerkschaftsmitglieder treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d67146fb-f43c-4524-ba7b-1a83ac59a6a7",
                                "sense_id": "4f1fffdd-9be5-3256-80c0-24297e69c48d",
                                "text": "„Der Parteitag in Tirol und die Ereignisse des Gewerkschaftstages im Austriacenter haben ähnliche Wurzeln, aber gibt es nicht auch Unterschiede?“"
                            },
                            {
                                "example_id": "859034ec-fd76-407b-a233-052efd7f69aa",
                                "sense_id": "4f1fffdd-9be5-3256-80c0-24297e69c48d",
                                "text": "„Am Freitagabend war er Gast des vierten ordentlichen Gewerkschaftstages des Bezirksverbandes Nordwestsachsen der IG Bau, der im Grimmaer Rathaus tagte.“"
                            },
                            {
                                "example_id": "106d5a5b-9f68-4437-a88a-e26c417c58a7",
                                "sense_id": "4f1fffdd-9be5-3256-80c0-24297e69c48d",
                                "text": "„Nachdem die drei fusionierenden Teilgewerkschaften […] am Vormittag ihre letzten eigenständigen Gewerkschaftstage abgehalten hatten, wurde Stunden später im Beisein von ÖGB-Boss Rudolf Hundstorfer und Bundespräsident Heinz Fischer die neue Teilgewerkschaft aus der Taufe gehoben.“"
                            },
                            {
                                "example_id": "5d104837-b1bb-40dc-be08-fdc5bc5b29bc",
                                "sense_id": "4f1fffdd-9be5-3256-80c0-24297e69c48d",
                                "text": "„Der Bund der Strafvollzugsbediensteten Deutschlands (BSBD) lädt für den heutigen Donnerstag zu seinem alle fünf Jahre stattfindenden Gewerkschaftstag ins Best Western Mark Hotel in Lahnstein ein.“"
                            },
                            {
                                "example_id": "02d27edf-4def-4e39-bbca-656e020f652e",
                                "sense_id": "4f1fffdd-9be5-3256-80c0-24297e69c48d",
                                "text": "„Für den Führungswechsel war eigens ein außerordentlicher Gewerkschaftstag einberufen worden.“"
                            },
                            {
                                "example_id": "723087ef-1e3b-4239-af61-d7788f7a0a16",
                                "sense_id": "4f1fffdd-9be5-3256-80c0-24297e69c48d",
                                "text": "„Scharfe Töne prägen den Gewerkschaftstag der Gewerkschaft der Privatangestellten (GPA).“"
                            },
                            {
                                "example_id": "24cf385c-2363-41bd-bfb9-5317b6dd1920",
                                "sense_id": "4f1fffdd-9be5-3256-80c0-24297e69c48d",
                                "text": "„Beim Gewerkschaftstag des Beamtenbunds sprach Berlins Regierender Bürgermeister von einer Zäsur.“"
                            },
                            {
                                "example_id": "64893676-69a3-4b81-82e3-2c3d84d094c7",
                                "sense_id": "4f1fffdd-9be5-3256-80c0-24297e69c48d",
                                "text": "„Der Beamtenbund hat mit Blick auf die Corona-Krise einen neuen Weg zur Realisierung des Gewerkschaftstages und damit auch zur Wahl der neuen Landesleitung eingeschlagen – die gut 100 Delegierten konnten per Briefwahl abstimmen.“"
                            },
                            {
                                "example_id": "11203e1b-a101-44dc-848a-0474d416fe32",
                                "sense_id": "4f1fffdd-9be5-3256-80c0-24297e69c48d",
                                "text": "„Sie wählt die Mitglieder der Tarifkommissionen, die Delegierten für die Bezirkskonferenz, den Gewerkschaftstag und den Ortsvorstand – jeweils für vier Jahre.“"
                            },
                            {
                                "example_id": "3b390961-4fb0-422d-a04b-f4094fa5248c",
                                "sense_id": "4f1fffdd-9be5-3256-80c0-24297e69c48d",
                                "text": "„Der 59-Jährige wird erst einmal bis zum nächsten ordentlichen Gewerkschaftstag im November 2027 amtieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
