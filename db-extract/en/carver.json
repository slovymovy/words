                    {
                        "sense_id": "1f5911cd-f83c-35b0-ad5c-e49ed3027271",
                        "entry_id": "5b189124-e806-3f2b-ab02-2d6e17a4ec9d",
                        "glosses": [
                            "An armchair as part of a set of dining chairs (originally for the person who is to carve the meat)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa41c669-a20a-4032-8648-ae30e5ac5441",
                                "sense_id": "1f5911cd-f83c-35b0-ad5c-e49ed3027271",
                                "text": "She began a circuit of the dining room, peering at the baronial fireplace with its andirons the size of torture racks, and heavy oak carvers like gnarled thrones."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4e5b875-8b34-3b50-8564-03ceacde8799",
