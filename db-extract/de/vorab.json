                                "sense_id": "df23bf8d-a0f6-3095-bbaa-0b30f62572b8",
                                "text": "Wir sollten die Traktanden unserer Sitzungen vorab festlegen.",
                                "translation": "Nous devrions fixer d’avance les thèmes de nos réunions."
                            },
                            {
                                "example_id": "4d73deae-2767-47dc-bdac-25b11e0e6895",
                                "sense_id": "df23bf8d-a0f6-3095-bbaa-0b30f62572b8",
                                "text": "Die Ware wird zu einem vorab festgelegten Preis gekauft.",
                                "translation": "La marchandise est achetée à un prix prédéterminé."
                            }
                        ]
