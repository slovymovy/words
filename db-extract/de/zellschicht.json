                "senses": [
                    {
                        "sense_id": "effd10b6-5730-3699-b4d5-34bd8a416d96",
                        "entry_id": "5947829e-01f1-33c6-ab97-0115a49d584e",
                        "glosses": [
                            "Schicht (Ebene) aus miteinander verbundenen Zellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2598e937-3353-4e85-876d-a61991650d77",
                                "sense_id": "effd10b6-5730-3699-b4d5-34bd8a416d96",
                                "text": "„Die äußerste Zellschicht bildet eine dünne Rhizodermis, ihr liegt innen eine derbere, oft schwach verkorkte Exodermis an.“"
                            },
                            {
                                "example_id": "444571b1-995a-4d31-a0c0-2c9946513dc4",
                                "sense_id": "effd10b6-5730-3699-b4d5-34bd8a416d96",
                                "text": "„In der fünften Schwangerschaftswoche bildet die Keimscheibe drei unterschiedliche Zellschichten, aus denen in den folgenden Wochen alle Körperorgane hervorgehen.“"
                            },
                            {
                                "example_id": "70289ef3-5e77-4796-9c1b-27f94f69ea2c",
                                "sense_id": "effd10b6-5730-3699-b4d5-34bd8a416d96",
                                "text": "„Obwohl mindestens 100 Spermien versuchen, diese beiden Zellschichten aufzubrechen, gelingt es nur einer einzigen Samenzelle, in die Eizelle einzudringen und sie zu befruchten.“"
                            },
                            {
                                "example_id": "fe1ae41c-49d5-433c-bf2b-f31a0b52d870",
                                "sense_id": "effd10b6-5730-3699-b4d5-34bd8a416d96",
                                "text": "„Viele Nadelblätter besitzen zusätzliche Zellschichten, um das Innere vor Kälte zu schützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
