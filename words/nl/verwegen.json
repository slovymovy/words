                },
                {
                    "sense_id": "de31c2ea-81fd-36a4-afe7-04fc4cfa8013",
                    "sense_definition": "Gewicht of massa verliezen als gevolg van het weegproces.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij het verpakken van het vochtige graan kan de lading enigszins <w>verwegen</w>.",
                            "target_lang_translations": {
                                "en": "When packaging moist grain, the load may slightly <w>lose weight</w>."
                            }
                        },
                        {
                            "text": "Het materiaal neigt ertoe te <w>verwegen</w> door verdamping.",
                            "target_lang_translations": {
                                "en": "The material tends to <w>lose weight</w> due to evaporation."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To lose weight or mass as a result of the weighing process or handling."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lose weight",
                                "target_lang_sense_clarification": "to lose mass during weighing/handling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f393d93-9915-3f89-9c90-ebb50643052f",
                    "sense_definition": "Aandachtig nadenken over iets; overwegen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geestelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wilde alle opties zorgvuldig <w>verwegen</w> alvorens te beslissen.",
                            "target_lang_translations": {
                                "en": "He wanted to <w>consider</w> all options carefully before deciding."
                            }
                        },
                        {
                            "text": "Men moet de gevolgen goed <w>verwegen</w> voordat men handelt.",
                            "target_lang_translations": {
                                "en": "One must carefully <w>weigh</w> the consequences before taking action."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderd synoniem voor overwegen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To think about something carefully; to consider or weigh in mind."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consider",
                                "target_lang_sense_clarification": "to think carefully about"
                            },
                            {
                                "target_lang_word": "weigh",
                                "target_lang_sense_clarification": "to ponder options mentally"
                            },
                            {
                                "target_lang_word": "ponder",
                                "target_lang_sense_clarification": "to deliberate upon"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2cf1c11-811d-3905-a5e7-21b07dec270c",
                    "sense_definition": "Iemand aanzetten of overhalen tot een handeling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geestelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niets kon hem er toe <w>verwegen</w> zijn geheim prijs te geven.",
                            "target_lang_translations": {
                                "en": "Nothing could <w>persuade</w> him to reveal his secret."
                            }
                        },
                        {
                            "text": "De goede argumenten konden de raad uiteindelijk <w>verwegen</w>.",
                            "target_lang_translations": {
                                "en": "The good arguments were ultimately able to <w>sway</w> the council."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To induce or persuade someone to take an action."
                    },
                    "translations": {
                        "en": [
