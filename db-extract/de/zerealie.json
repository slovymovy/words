                                    {
                                        "sense_id": "ce67a887-a7cc-3922-a267-f905293c5641",
                                        "entry_id": "3a230439-2a4d-3f09-8926-6c2fbbdb316c",
                                        "glosses": [
                                            "A type of grass (such as wheat, rice or oats) cultivated for its edible grains."
                                        ],
