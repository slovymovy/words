                                        "entry_id": "8a1a9ec7-d744-3d45-8a42-7ff8e1d1c0c2",
                                        "glosses": [
                                            "malá porce lehkého jídla podávaná před hlavním chodem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed185e41-0167-4cab-8bc5-d30ff1730b7e",
                                                "sense_id": "27737ec8-a195-3af8-8999-329982a28c8b",
                                                "text": "Scezený chřest urovnáme na talíře, posypeme vejci, přelijeme horkým máslem s přísadami a posypeme sýrem. Podáváme jako sváteční předkrm, pohoštění k bílému vínu, vinnému střiku."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5328a323-129f-3683-affd-c66a772f9063",
                                        "entry_id": "8a1a9ec7-d744-3d45-8a42-7ff8e1d1c0c2",
                                        "glosses": [
                                            "menší část předcházející hlavní na upoutání pozornosti, navození atmosféry apod."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac9ee007-2f85-4f9d-92fa-047c42a4cef0",
                                                "sense_id": "5328a323-129f-3683-affd-c66a772f9063",
                                                "text": "Nad Roland Garros se honila mračna a v chladu i mokru většinu kurtů halily nepromokavé pláště. Přesto šla Paříž spát okouzlená: jako předkrm včerejší porce stačila. A dnes už to vypukne naplno."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb5bef58-f569-4807-937b-53dba22ff41c",
                        "source_entry_id": "72ddae83-8c7f-3467-8979-4dc63f0b7700",
                        "source_sense_id": "a7ed0144-604a-3f28-9351-58c749c154ba",
                        "target_lang_word": "hors-d'œuvre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "24083ad6-117d-4c1d-b38a-6a590424a73b",
                        "source_entry_id": "72ddae83-8c7f-3467-8979-4dc63f0b7700",
                        "source_sense_id": "a7ed0144-604a-3f28-9351-58c749c154ba",
                        "target_lang_word": "Vorspeise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorspeise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1853851-7e5f-337e-881f-2125a216f312",
                                        "entry_id": "988c6736-e042-3d32-8828-1679485acbc2",
                                        "glosses": [
                                            "erster und einführender Gang einer Mahlzeit mit mehreren Gängen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fac0bd4f-88b7-49e9-9791-f468d8bbf6be",
                                                "sense_id": "f1853851-7e5f-337e-881f-2125a216f312",
                                                "text": "Als Vorspeise gibt es heute Tomatensuppe."
                                            },
                                            {
                                                "example_id": "e69df49b-180c-49f8-9bfc-e6b75089112d",
                                                "sense_id": "f1853851-7e5f-337e-881f-2125a216f312",
                                                "text": "„Als Vorspeise entschied er sich für in Öl gebratene Zwiebeln.“"
                                            },
                                            {
                                                "example_id": "0d2297c9-6a9c-4c0c-85a2-5e8334d101a5",
                                                "sense_id": "f1853851-7e5f-337e-881f-2125a216f312",
                                                "text": "„Der Ober brachte die Vorspeise: Weißbrotscheiben, Butter, in Miniaturfässchen gefüllt.“"
                                            },
                                            {
                                                "example_id": "6880729d-6940-4a7d-871a-adaa07bf4ac0",
                                                "sense_id": "f1853851-7e5f-337e-881f-2125a216f312",
                                                "text": "„Nach dem nicht enden wollenden Reigen aus Vorspeisen brachte der Kellner noch eine Runde Mokka.“"
                                            },
                                            {
                                                "example_id": "35e02619-c616-47dc-9894-e90a329041f2",
                                                "sense_id": "f1853851-7e5f-337e-881f-2125a216f312",
                                                "text": "„Als Vorspeise gab es gekochten Steinbutt, umlegt mit gebackenen Austern und übergossen mit einer feinen Holländischen Sauce, in welche Kaviar gerührt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6719bf0e-ace0-403f-b79f-57632e36dffd",
                        "source_entry_id": "72ddae83-8c7f-3467-8979-4dc63f0b7700",
