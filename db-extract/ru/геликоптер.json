                                        "entry_id": "ee24e982-0415-3665-a9bb-eb8e9ea9ff1e",
                                        "glosses": [
                                            "Luftfahrzeug, das durch einen oder mehrere waagerechte Rotoren in der Luft gehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "620e80f2-5f0c-4b6c-8308-f32064096a82",
                                                "sense_id": "caac5a71-9822-35d5-8e8f-05c6464c2b46",
                                                "text": "Der Präsident kam mit einem Helikopter zur Konferenz."
                                            },
                                            {
                                                "example_id": "ef105d43-5d36-4885-8421-38365beee74f",
                                                "sense_id": "caac5a71-9822-35d5-8e8f-05c6464c2b46",
                                                "text": "„Gyrocopter sind Tragschrauber und ähneln in ihrer Funktionsweise einem Hubschrauber.“"
                                            },
                                            {
                                                "example_id": "878af5d7-b1b8-4818-a067-4e87ef56e1d0",
                                                "sense_id": "caac5a71-9822-35d5-8e8f-05c6464c2b46",
                                                "text": "„Als Publikumsmagnet erwies sich erneut das Bundeskanzleramt, und die längste Warteschlange bildete sich regelmäßig vor dem Helikopter der Regierungschefin.“"
                                            },
                                            {
                                                "example_id": "e131967f-20da-4e88-9233-e7dc79b67eeb",
                                                "sense_id": "caac5a71-9822-35d5-8e8f-05c6464c2b46",
                                                "text": "„Im Tal ist die Mutter des Jungen aus dem Helikopter im Krankenhaus eingetroffen.“"
                                            }
