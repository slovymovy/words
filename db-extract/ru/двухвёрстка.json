                "senses": [
                    {
                        "sense_id": "c3ac6fb1-e355-3419-bd5a-ef49d9cf4cf5",
                        "entry_id": "f7a66d51-7711-356f-b0ec-337d736a7221",
                        "glosses": [
                            "разг. топографическая карта в масштабе двух километров на сантиметр"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71adf237-c3ab-440c-8913-a6e554e88b61",
                                "sense_id": "c3ac6fb1-e355-3419-bd5a-ef49d9cf4cf5",
                                "text": "Журналист достал из рюкзака истертую на сгибах двухвёрстку и сверился с компасом."
                            }
                        ]
                    },
                    {
                        "sense_id": "2be1c8da-f837-3462-962b-3bcdbcf7cda1",
                        "entry_id": "f7a66d51-7711-356f-b0ec-337d736a7221",
                        "glosses": [
                            "устар. разг. то же в масштабе двух вёрст на дюйм (примерно 1:84000)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66a49320-b00d-4eb4-b4ff-73e38df756d5",
                                "sense_id": "2be1c8da-f837-3462-962b-3bcdbcf7cda1",
                                "text": "Мы решали на картах-двухвёрстках тактические задачи применительно к действиям кавалерийской дивизии и конной батареи, писали диспозиции и потом отвечали по всему курсу."
                            }
                        ]
                    }
