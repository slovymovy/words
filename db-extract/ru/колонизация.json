                    },
                    {
                        "translation_id": "d6027af5-ac94-446e-b6ab-68fc98356f5d",
                        "source_entry_id": "90505b28-d3d3-3d4b-9bd0-f9e4826484d2",
                        "source_sense_description": "действие по значению гл. колонизировать",
                        "target_lang_word": "Kolonisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kolonisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18cbae96-e533-3003-84e9-a17429984c7b",
                                        "entry_id": "2747760a-646c-35d4-a7e5-056849d8489a",
                                        "glosses": [
                                            "Handlung (und ihr Ergebnis), fremdes Gebiet widerrechtlich in Besitz nehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1c546fe-07bd-472e-94c9-b3abe97a98ba",
                                                "sense_id": "18cbae96-e533-3003-84e9-a17429984c7b",
                                                "text": "„Ihre Lage war am Ende des ersten Jahrhunderts der Kolonisierung katastrophal.“"
                                            },
                                            {
                                                "example_id": "178aca84-e539-476e-9d6a-5e702f6045da",
                                                "sense_id": "18cbae96-e533-3003-84e9-a17429984c7b",
                                                "text": "„An eine dauerhafte Besetzung, gar Kolonisierung der nordafrikanischen Regentschaft aber denkt niemand in Paris.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "752545ce-23b5-32e8-84d8-39656a5c5584",
                                        "entry_id": "2747760a-646c-35d4-a7e5-056849d8489a",
                                        "glosses": [
                                            "Handlung (und ihr Ergebnis), rückständiges Gebiet erschließen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aeac541-9dc8-458b-a6e3-9df442db0a40",
                                                "sense_id": "752545ce-23b5-32e8-84d8-39656a5c5584",
                                                "text": "„František Palacký, der erste große moderne Historiker der Tschechen und »Vater der Nation« im 19. Jahrhundert, verfestigte diese Auffassungen, obwohl er natürlich mit seinem klaren, gerechten Kopf auch den Aufschwung von Gewerbe und Handel sah, den die Kolonisierung gebracht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "043f0614-75d1-4be6-950a-0ad814e83c98",
                        "source_entry_id": "90505b28-d3d3-3d4b-9bd0-f9e4826484d2",
                        "source_sense_description": "действие по значению гл. колонизировать",
                        "target_lang_word": "Besiedelung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besiedelung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ad70302-e46c-3c30-adee-96a96247e06d",
                                        "entry_id": "03083a57-1ae8-36dd-ae69-36d3801ff1ea",
                                        "glosses": [
                                            "ein Prozess des ortsbezogenen Niederlassens von Lebewesen mit anschließender Vermehrung sowie das Ergebnis dieses Prozesses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "871bbc31-c5c0-4fa3-ad16-1e66320ea2f8",
                                                "sense_id": "4ad70302-e46c-3c30-adee-96a96247e06d",
                                                "text": "Die Besiedelung Nordamerikas erfolgte in mehreren Einwanderungswellen."
                                            },
                                            {
                                                "example_id": "24d11ae4-161e-43f5-bdb7-741a08845721",
                                                "sense_id": "4ad70302-e46c-3c30-adee-96a96247e06d",
                                                "text": "„Die Besiedelung der Sierra Morena beschäftigte mich sehr; vor allem schrieb ich über die Verwaltung, die eine Grundvoraussetzung zum Gedeihen der Kolonie war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
