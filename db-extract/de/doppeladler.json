                    {
                        "translation_id": "cd095195-7a5e-4bcb-8bc7-eb9dd94afbbc",
                        "source_entry_id": "61393775-1572-3d3b-94c9-738d400e1893",
                        "source_sense_id": "b691e563-d68d-3175-bbfe-90b620915c14",
                        "source_sense_description": "Heraldik: Adler mit zwei Köpfen",
                        "target_lang_word": "двуглавый орёл",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "двуглавый орёл",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2498280c-ab5f-379b-8c0d-15b0e66f2ad2",
                                        "entry_id": "0d77c84e-4775-3675-b878-beea0fa90d53",
                                        "glosses": [
                                            "геральд. фантастическая гербовая фигура, символизирующая власть, силу и единство; государственный герб России, российской и других монархий, первоначально — герб Византийской империи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aa96011-a879-49c2-89fc-d8618ccdeace",
                                                "sense_id": "2498280c-ab5f-379b-8c0d-15b0e66f2ad2",
                                                "text": "Рубль был новенький, — на одной стороне — двуглавый орёл, на другой — правительница Софья."
                                            },
                                            {
                                                "example_id": "53a4727a-30a6-47e5-ad04-4799e72162a0",
                                                "sense_id": "2498280c-ab5f-379b-8c0d-15b0e66f2ad2",
                                                "text": "Итак: двуглавый орёл, прибывший к нам, кстати, из Византии, — это сегодняшний герб, трёхцветный флаг — это сегодняшний российский флаг, а александровский гимн — наш сегодняшний гимн."
                                            },
                                            {
                                                "example_id": "626e5c33-0224-4b5d-9471-6fc1d2539d69",
                                                "sense_id": "2498280c-ab5f-379b-8c0d-15b0e66f2ad2",
                                                "text": "Двуглавый орёл как герб Московского государства впервые появился на печати Ивана III в 1497 году после его женитьбы на византийской принцессе Софье Палеолог: изображение двуглавого орла (герб Византии) соединили с московским гербом, в результате чего на одной половине герба изображался орёл, на другой — всадник, попирающий дракона. ❬…❭ После февральской революции 1917 года на печати и денежных знаках Временного правительства фигурировал имперский двуглавый орёл, но без корон. ❬…❭ Золотой двуглавый орёл на красном поле сохраняет историческую преемственность в цветовой гамме гербов конца XV–XVII века."
                                            },
                                            {
                                                "example_id": "5460b59f-e87a-45f8-8368-9d005fbbbaff",
                                                "sense_id": "2498280c-ab5f-379b-8c0d-15b0e66f2ad2",
                                                "text": "В конце концов двуглавый орёл в качестве герба есть и у Албании, и у других государств (Сербия, Черногория, а ранее — Австрия, Византия, Германский союз.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
