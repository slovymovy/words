                "senses": [
                    {
                        "sense_id": "8797ae1e-6c37-3172-886f-c11a537f44e1",
                        "entry_id": "2f092acc-aa09-385e-8fc7-7e221161e129",
                        "glosses": [
                            "Flug, bei dem der Fluggast nicht von dem Flughafen zum Ausgangsort zurückfliegt, auf dem er angekommen ist; bei dem der Zielort des Hinfluges nicht der Startort des Rückfluges ist"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "defca83e-8b5a-4708-9e07-b59c169454e3",
                                "sense_id": "8797ae1e-6c37-3172-886f-c11a537f44e1",
                                "text": "„Wer nach Österreich reisen wolle, würde andere Einreisemöglichkeiten finden, zum Beispiel über Gabelflüge.“"
                            },
                            {
                                "example_id": "e5fdb574-d301-49f8-82f8-1da1d59b8c1e",
                                "sense_id": "8797ae1e-6c37-3172-886f-c11a537f44e1",
                                "text": "„Am besten nimmt man einen Gabelflug mit Air Canada (www.aircanada.com) von Frankfurt nach Calgary und zurück von Edmonton über Calgary nach Frankfurt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
