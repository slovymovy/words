                ],
                "senses": [
                    {
                        "sense_id": "12033953-6c2b-3a46-bcfc-923766f41060",
                        "entry_id": "03c685b7-ae1a-32ad-a81d-fa1e05ce551b",
                        "glosses": [
                            "Gesamtheit der Muskeln, die das Zermahlen der Nahrung ermöglichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0a15422-ceef-411a-98af-3c6ad976e577",
                                "sense_id": "12033953-6c2b-3a46-bcfc-923766f41060",
                                "text": "„Ein großer Burger bedeutet viel Arbeit für die Kaumuskulatur.“"
                            },
                            {
                                "example_id": "11edd82f-7d2f-4d22-bdfb-90f25dd02dd7",
                                "sense_id": "12033953-6c2b-3a46-bcfc-923766f41060",
                                "text": "„Insbesondere Katzen, die hauptsächlich durch Nassnahrung ernährt werden, erhalten durch die regelmäßige Fütterung von festeren Kauartikeln oder Trockenfisch die Möglichkeit [sic!] ihre Zähne und Kaumuskulatur zu pflegen.“"
                            },
                            {
                                "example_id": "b899d83a-d8ce-4a73-ad15-2f2f32a596e5",
                                "sense_id": "12033953-6c2b-3a46-bcfc-923766f41060",
                                "text": "„Physiotherapeutische Übungen, manuelle Therapie, Massagen im Kieferbereich sowie Wärmebehandlungen können dabei helfen, die Kaumuskulatur zu entspannen und Beschwerden zu lindern.“"
                            },
                            {
                                "example_id": "06faf974-7576-45cc-88ad-aecba3003b27",
                                "sense_id": "12033953-6c2b-3a46-bcfc-923766f41060",
                                "text": "„Sofern die Zähne und die Kaumuskulatur nicht harmonieren, kann es zu Schmerzen in den Kiefergelenken kommen.“"
                            },
                            {
                                "example_id": "76e96713-2f1a-4e9a-ac6b-86cebba04f64",
                                "sense_id": "12033953-6c2b-3a46-bcfc-923766f41060",
                                "text": "„Wenn du deinen Ober- und Unterkiefer bewusst oder unbewusst ständig aufeinanderpresst, kannst du dir damit nicht nur das Gebiss zermahlen, sondern auch hohe Spannungen in der Kaumuskulatur und dem umliegenden Fasziengewebe aufbauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
