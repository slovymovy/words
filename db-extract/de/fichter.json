                ],
                "senses": [
                    {
                        "sense_id": "c963e8cf-0198-31ef-889a-0747a5de115c",
                        "entry_id": "62ad3e3b-2fd2-3f93-a86b-e59ad6c6dc4a",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a47f97a-de8d-486a-adb9-8e3609382075",
                                "sense_id": "c963e8cf-0198-31ef-889a-0747a5de115c",
                                "text": "Frau Fichter ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5e117dfd-875e-473c-8b39-15457b950180",
                                "sense_id": "c963e8cf-0198-31ef-889a-0747a5de115c",
                                "text": "Herr Fichter wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3aecdf59-3aac-4305-994c-fd50fd0bc327",
                                "sense_id": "c963e8cf-0198-31ef-889a-0747a5de115c",
                                "text": "Die Fichters fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "530d6787-0c15-4534-97f2-a5e6965f7d09",
                                "sense_id": "c963e8cf-0198-31ef-889a-0747a5de115c",
                                "text": "Der Fichter trägt nie die Schals, die die Fichter ihm strickt."
                            },
                            {
                                "example_id": "dc8ce277-1bc9-494f-aeb5-8261d9b91c79",
                                "sense_id": "c963e8cf-0198-31ef-889a-0747a5de115c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fichter kommt, geht der Herr Fichter.“"
                            },
                            {
                                "example_id": "0201c863-5d55-4b93-b1ab-b615cea3ecb7",
                                "sense_id": "c963e8cf-0198-31ef-889a-0747a5de115c",
                                "text": "Fichter kommt und geht."
                            },
                            {
                                "example_id": "4cf0a098-2775-4399-9e15-bcecf11f1170",
                                "sense_id": "c963e8cf-0198-31ef-889a-0747a5de115c",
                                "text": "Fichters kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
