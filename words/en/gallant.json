{
    "word_family": [
        "gallantry",
        "gallantly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2a8f04d6-3995-38f4-bb4d-4e8f91bbaa90",
                    "sense_definition": "Brave, heroic, and noble-minded in the face of danger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bravery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The firefighters made a <w>gallant</w> effort to save the historic building.",
                            "target_lang_translations": {
                                "zh": "消防员们为了拯救这座历史建筑做出了<w>英勇的</w>努力。"
                            }
                        },
                        {
                            "text": "She was awarded a medal for her <w>gallant</w> actions during the conflict.",
                            "target_lang_translations": {
                                "zh": "她因在冲突中的<w>勇敢</w>举动而获颁勋章。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brave",
                        "valiant",
                        "heroic"
                    ],
                    "antonyms": [
                        "cowardly"
                    ],
                    "common_phrases": [
                        "gallant effort",
                        "gallant soldier"
                    ],
                    "target_lang_definitions": {
                        "zh": "面对危险时表现得英勇的、勇猛的、豪侠的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "英勇的",
                                "target_lang_sense_clarification": "指勇敢无畏的行动或精神"
                            },
                            {
                                "target_lang_word": "勇敢的",
                                "target_lang_sense_clarification": "指不怕危险的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba2a524a-f228-37b2-8892-51f99a21c506",
                    "sense_definition": "Polite, attentive, and courtly, especially towards women.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chivalry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered his coat with a <w>gallant</w> gesture when the rain began.",
                            "target_lang_translations": {
                                "zh": "下起雨时，他以<w>有绅士风度的</w>举止递上了自己的外套。"
                            }
                        },
                        {
                            "text": "Her companion was always <w>gallant</w> and attentive during dinner parties.",
                            "target_lang_translations": {
                                "zh": "在晚宴上，她的男伴总是表现得既<w>殷勤</w>又周到。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chivalrous",
                        "courteous"
                    ],
                    "antonyms": [
                        "discourteous",
                        "rude"
                    ],
                    "common_phrases": [
                        "gallant gentleman"
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指对女性）彬彬有礼的、体贴周到的、具有骑士风度的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有绅士风度的",
                                "target_lang_sense_clarification": "指对女性殷勤有礼的"
                            },
                            {
                                "target_lang_word": "殷勤的",
                                "target_lang_sense_clarification": "指热情体贴、礼貌周到的"
                            },
                            {
                                "target_lang_word": "彬彬有礼的",
                                "target_lang_sense_clarification": "指文雅而有礼貌的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3d1c04c-f5f5-390f-8713-783cfc0aeafe",
                    "sense_definition": "Honorable and worthy of respect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bravery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fallen captain was remembered as a <w>gallant</w> leader who put duty first.",
                            "target_lang_translations": {
                                "zh": "阵亡的上尉被大家铭记为一位以职责为先的<w>高尚的</w>领袖。"
                            }
                        },
                        {
                            "text": "They praised his <w>gallant</w> conduct in accepting the bitter defeat without anger.",
                            "target_lang_translations": {
                                "zh": "他们称赞他在平静接受惨痛失败时所表现出的<w>堂堂正正的</w>风度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "honorable",
                        "noble"
                    ],
                    "antonyms": [
                        "dishonorable"
                    ],
                    "target_lang_definitions": {
                        "zh": "值得尊敬的、高尚的、光荣的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "高尚的",
                                "target_lang_sense_clarification": "指道德品质或行为崇高的"
                            },
                            {
                                "target_lang_word": "堂堂正正的",
                                "target_lang_sense_clarification": "指光明磊落、令人钦佩的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "523d1f34-f722-33f9-b0ce-d4f03f187b37",
                    "sense_definition": "Grand, imposing, and magnificent in appearance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>gallant</w> sailing ship appeared on the misty horizon at dawn.",
                            "target_lang_translations": {
                                "zh": "清晨，一艘<w>雄伟的</w>帆船出现在薄雾笼罩的地平线上。"
                            }
                        },
                        {
                            "text": "The old castle remained a <w>gallant</w> sight against the mountain backdrop.",
                            "target_lang_translations": {
                                "zh": "在群山的映衬下，这座古堡依然是一处<w>壮丽的</w>景象。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grand",
                        "magnificent",
                        "splendid"
                    ],
                    "common_phrases": [
                        "gallant ship"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in literary or historical descriptions"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（外观）雄伟的、壮丽的、气派的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "雄伟的",
                                "target_lang_sense_clarification": "形容气势宏伟、壮观的外观"
                            },
                            {
                                "target_lang_word": "壮丽的",
                                "target_lang_sense_clarification": "形容壮观华美"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "218df44b-dee8-36ad-b169-64d7a0dcc1ff",
                    "sense_definition": "Showy, splendid, or finely attired.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The riders rode into the village in <w>gallant</w> apparel for the festival.",
                            "target_lang_translations": {
                                "zh": "骑手们穿着节日的<w>华丽</w>盛装骑马进入村庄。"
                            }
                        },
                        {
                            "text": "The royal guard made a <w>gallant</w> display in their polished armor.",
                            "target_lang_translations": {
                                "zh": "皇家卫队身着锃亮的盔甲，展现出<w>盛装</w>威武的阵容。"
                            }
                        }
                    ],
                    "synonyms": [
                        "showy",
                        "splendid"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "华丽的、盛装打扮的、引人注目的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "华丽的",
                                "target_lang_sense_clarification": "指衣着或装束漂亮夺目的"
                            },
                            {
                                "target_lang_word": "盛装的",
                                "target_lang_sense_clarification": "指穿着华美考究服饰的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b773e0c5-1106-333e-9d0e-2634ca8e7881",
                    "sense_definition": "A fashionable man who is charming and attentive to women.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suitor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>gallant</w> bowed low and offered his seat to the lady.",
                            "target_lang_translations": {
                                "zh": "那位年轻的<w>风流绅士</w>深深鞠了一躬，把座位让给了那位女士。"
                            }
                        },
                        {
                            "text": "In the historical novel, several wealthy <w>gallants</w> attended the lavish ball.",
                            "target_lang_translations": {
                                "zh": "在这部历史小说中，几位富有的<w>风流绅士</w>出席了奢华的舞会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beau",
                        "dandy",
                        "spark"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historically descriptive"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "时髦且对女性殷勤周到的男子；风流绅士"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "风流绅士",
                                "target_lang_sense_clarification": "指举止文雅、对女性体贴的时髦男子"
                            },
                            {
                                "target_lang_word": "护花使者",
                                "target_lang_sense_clarification": "指乐于陪伴并保护女性的男子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "847316c6-e76d-3d54-a6d5-f0c9459559de",
                    "sense_definition": "A lover, paramour, or suitor, often in a secretive or illicit context.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "suitor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard caught her secret <w>gallant</w> climbing over the garden wall at midnight.",
                            "target_lang_translations": {
                                "zh": "守卫在午夜抓住了正翻过花园围墙的、她的秘密<w>情郎</w>。"
                            }
                        },
                        {
                            "text": "Rumors spread quickly that she was meeting a charming <w>gallant</w> in town.",
                            "target_lang_translations": {
                                "zh": "关于她正在城里与一位迷人的<w>情人</w>幽会的谣言迅速传开。"
                            }
                        }
                    ],
                    "synonyms": [
                        "suitor",
                        "lover",
                        "paramour"
                    ],
                    "common_phrases": [
                        "midnight gallant"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical and literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指秘密交往的）情人、情郎、追求者"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "情郎",
                                "target_lang_sense_clarification": "指秘密相会的恋人或情人"
                            },
                            {
                                "target_lang_word": "情人",
                                "target_lang_sense_clarification": "指恋爱关系中的伴侣"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "765bce13-27dc-3691-ade5-07de5723fdf7",
                    "sense_definition": "A nautical mast or sail situated immediately above the topmast; a topgallant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors climbed high onto the rigging to secure the main <w>gallant</w>.",
                            "target_lang_translations": {
                                "zh": "水手们爬上高高的索具，去固定主<w>顶桅帆</w>。"
                            }
                        },
                        {
                            "text": "A strong gale ripped the fore <w>gallant</w> before the crew could furl it.",
                            "target_lang_translations": {
                                "zh": "还没等船员们收拢帆，一阵强烈的狂风就撕裂了前<w>顶桅帆</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "topgallant"
                    ],
                    "target_lang_definitions": {
                        "zh": "（航海）顶桅帆、上桅帆（topgallant的简写）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "顶桅帆",
                                "target_lang_sense_clarification": "帆船上紧挨上桅上方的帆"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6704ddb8-e134-3165-82c8-cc5becde1853",
                    "sense_definition": "To escort, attend to, or accompany a woman in a courteous manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "court",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered to <w>gallant</w> the visitors around the grounds of the estate.",
                            "target_lang_translations": {
                                "zh": "他主动提出要<w>陪伴</w>访客们参观庄园的庭院。"
                            }
                        },
                        {
                            "text": "The young gentleman delighted in <w>gallanting</w> ladies to the evening performance.",
                            "target_lang_translations": {
                                "zh": "这位年轻绅士乐于<w>护送</w>女士们前去观看晚间演出。"
                            }
                        }
                    ],
                    "synonyms": [
                        "escort",
                        "chaperone"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Largely historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "殷勤护送，（礼貌地）陪伴（女性）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "护送",
                                "target_lang_sense_clarification": "指礼貌、体贴地陪同前往"
                            },
                            {
                                "target_lang_word": "陪伴",
                                "target_lang_sense_clarification": "指陪同在侧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41b93a48-815c-31a8-96a1-deac23eb0982",
                    "sense_definition": "To conduct, escort, or convey someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "court",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small convoy was <w>gallanted</w> into the harbor by local pilot boats.",
                            "target_lang_translations": {
                                "zh": "这支小型船队在当地引水船的<w>引航</w>下驶入港口。"
                            }
                        },
                        {
                            "text": "They politely <w>gallanted</w> the foreign delegates safely across the busy square.",
                            "target_lang_translations": {
                                "zh": "他们礼貌地<w>护送</w>外国代表们安全穿过了繁忙的广场。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conduct",
                        "escort"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "护送、引导、运送（人或船只等）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "护送",
                                "target_lang_sense_clarification": "指引导护送至某地"
                            },
                            {
                                "target_lang_word": "引航",
                                "target_lang_sense_clarification": "指引导船只等前行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd79e1b7-ca93-337d-86d9-a8d82693a90a",
                    "sense_definition": "To act like a fashionable suitor; to court or flirt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "court",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the summer leisurely <w>gallanting</w> across various resort towns.",
                            "target_lang_translations": {
                                "zh": "他悠闲地在各个度假小镇之间穿梭，度过了一个<w>寻欢作乐</w>的夏天。"
                            }
                        },
                        {
                            "text": "Instead of attending to business, he preferred <w>gallanting</w> around society salons.",
                            "target_lang_translations": {
                                "zh": "他不务正业，反而更喜欢在社交沙龙里四处<w>献殷勤</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flirt",
                        "philander"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Archaic/dated usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "献殷勤、调情、猎艳"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "献殷勤",
                                "target_lang_sense_clarification": "指为了讨好而百般讨好逢迎"
                            },
                            {
                                "target_lang_word": "寻欢作乐",
                                "target_lang_sense_clarification": "指四处风流、追求风雅情调"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e283013d-09ff-3ba2-a092-d754c3abd332",
                    "sense_definition": "To handle an accessory with grace or stylish affectation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She knew exactly how to <w>gallant</w> a fan to capture someone's attention.",
                            "target_lang_translations": {
                                "zh": "她深谙如何巧妙地<w>摇弄</w>折扇来吸引别人的注意。"
                            }
                        },
                        {
                            "text": "The actor learned to <w>gallant</w> a walking cane with dramatic flair.",
                            "target_lang_translations": {
                                "zh": "演员学会了带着戏剧般的华丽姿态去<w>摆弄</w>手杖。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wield",
                        "brandish"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical usage relating to mannerisms"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "优雅或造作地摆弄、挥动（折扇、手杖等配饰）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摆弄",
                                "target_lang_sense_clarification": "指优雅或引人注目地摆动配饰"
                            },
                            {
                                "target_lang_word": "摇弄",
                                "target_lang_sense_clarification": "指优雅地摇动扇子等饰物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "91444364-6f62-386a-a57d-920ede439ecc",
                    "sense_definition": "A surname transferred from the nickname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Gallant</w> delivered an inspiring lecture on medieval architecture today.",
                            "target_lang_translations": {
                                "zh": "<w>加朗特</w>教授今天就中世纪建筑发表了一场鼓舞人心的演讲。"
                            }
                        },
                        {
                            "text": "We scheduled an appointment with Dr. <w>Gallant</w> for next Monday morning.",
                            "target_lang_translations": {
                                "zh": "我们预约了下周一上午与<w>加朗特</w>医生的会面。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "加朗特（姓氏）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "加朗特",
                                "target_lang_sense_clarification": "常见英语姓氏译名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f33a14f2-b948-3fa3-a4fc-04f39a1714b1",
                    "sense_definition": "A census-designated place in Etowah and St. Clair counties, Alabama, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through rural Alabama and stopped briefly in <w>Gallant</w>.",
                            "target_lang_translations": {
                                "zh": "他们驱车穿过阿拉巴马州的乡村，并在<w>加兰特</w>作了短暂停留。"
                            }
                        },
                        {
                            "text": "The small community of <w>Gallant</w> was named after an early settler.",
                            "target_lang_translations": {
                                "zh": "<w>加兰特</w>这个小社区是以一位早期定居者的名字命名的。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
