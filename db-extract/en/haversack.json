                    {
                        "form_id": "53cd43fc-5784-43fb-8248-a42d17d49909",
                        "entry_id": "8a906d50-e5d2-3b9e-9c9d-e48bf41b20ee",
                        "tags": [
                            "plural"
                        ],
                        "form": "haversacks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d819aa3-4130-326c-a592-237d9c5bc21b",
                        "entry_id": "8a906d50-e5d2-3b9e-9c9d-e48bf41b20ee",
                        "glosses": [
                            "A small, strong bag carried on the back or the shoulder, usually with only one strap, and originally made of canvas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ec1b657-a5bc-4b1e-b18f-479ab09a876d",
                                "sense_id": "2d819aa3-4130-326c-a592-237d9c5bc21b",
                                "text": "And most significant, these hordes of nonmotorized tourists, hungry for a taste of the difficult, the original, the real, do not consist solely of people young and athletic but also of old folks, fat folks, pale-faced office clerks who don’t know a rucksack from a haversack, and even children."
                            },
                            {
                                "example_id": "ad757e28-8565-498a-a688-d61b737791f3",
                                "sense_id": "2d819aa3-4130-326c-a592-237d9c5bc21b",
                                "text": "When I went, I left from the station / With a haversack and some trepidation"
                            }
                        ]
                    },
                    {
                        "sense_id": "1c46949e-80bc-3d81-951d-bd6666c8c76d",
                        "entry_id": "8a906d50-e5d2-3b9e-9c9d-e48bf41b20ee",
                        "glosses": [
                            "An oat-sack, or nosebag for a horse."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10f6fd2b-8079-474d-9b82-9c7db3f80efc",
                        "source_entry_id": "8a906d50-e5d2-3b9e-9c9d-e48bf41b20ee",
                        "source_sense_description": "shoulder bag",
                        "target_lang_word": "Brotbeutel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brotbeutel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48a3bda3-c70a-3d78-b6db-a40a1c252570",
                                        "entry_id": "3aa500fe-df2f-3912-96f7-3398693540c5",
                                        "glosses": [
                                            "Beutel zur Mitnahme von Lebensmitteln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48242b5c-0383-4b32-85f9-52c19cf9f753",
                                                "sense_id": "48a3bda3-c70a-3d78-b6db-a40a1c252570",
                                                "text": "„Voll froher Erwartung schlüpfte ich endlich mit meinen Brotbeuteln aus dem Tore hinaus.“"
                                            },
                                            {
                                                "example_id": "5fd8e169-44de-4676-af2f-4fab48c14817",
                                                "sense_id": "48a3bda3-c70a-3d78-b6db-a40a1c252570",
                                                "text": "„Einer schlug an seinen umgehängten Brotbeutel und breitete die Hände aus, dass sie nichts zu essen hätten.“"
                                            },
                                            {
                                                "example_id": "a425c3c6-526c-43f8-94a4-1b2e5d9472b4",
                                                "sense_id": "48a3bda3-c70a-3d78-b6db-a40a1c252570",
                                                "text": "„Die Offiziere knöpften die Uniformröcke zu, schnallten Degen und Brotbeutel um, schrien ihre Leute an und schritten vor der Front der Kompagnie auf und ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
