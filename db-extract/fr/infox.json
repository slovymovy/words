        "fr-extract.jsonl": [
            {
                "entry_id": "8bd5f072-1140-3d2a-bdf4-b945166ae90b",
                "word": "infox",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3627f998-c77a-32b9-bc6a-79a7edbf203a",
                        "entry_id": "8bd5f072-1140-3d2a-bdf4-b945166ae90b",
                        "glosses": [
                            "Fausse information, conçue volontairement pour induire en erreur et diffusée dans des médias à large audience."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "acaa08d0-a7f9-4094-afd3-3dfcc53b43c2",
                                "sense_id": "3627f998-c77a-32b9-bc6a-79a7edbf203a",
                                "text": "On appelle cela le fact-checking, terme d’origine anglo-saxonne, comme l’est l’expression fake news (fausses nouvelles) que l’on nomme aussi « infox » en français."
                            },
                            {
                                "example_id": "2e7cd1e4-1ecc-4ded-9436-176739d530a3",
                                "sense_id": "3627f998-c77a-32b9-bc6a-79a7edbf203a",
                                "text": "De projections en supputations, on en était venu à difficilement discerner l’info de l’infox."
                            },
                            {
                                "example_id": "4c0a026b-0449-4ee4-b1ba-23146f07c55f",
                                "sense_id": "3627f998-c77a-32b9-bc6a-79a7edbf203a",
                                "text": "Cette infox provient d’une interprétation improbable de la directive sur les émissions industrielles (IED) du Pacte vert, pour laquelle une négociation importante a eu lieu mardi."
                            },
                            {
                                "example_id": "6aff47b0-4eb2-4834-8d0f-e3c0fac81fb3",
                                "sense_id": "3627f998-c77a-32b9-bc6a-79a7edbf203a",
                                "text": "Et, au XXᵉ siècle, on parlait de propagande et de désinformation pour évoquer toutes ces falsifications. Aujourd’hui, on parle de fake news. […] Je lui préfère donc le terme français d’infox qui évoque l’intoxication par des nouvelles fausses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cd1ae8b-a02e-4c24-91ac-c358cf9d7783",
                        "source_entry_id": "8bd5f072-1140-3d2a-bdf4-b945166ae90b",
                        "source_sense_id": "3627f998-c77a-32b9-bc6a-79a7edbf203a",
                        "target_lang_word": "fake news",
