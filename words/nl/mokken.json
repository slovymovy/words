{
    "word_family": [
        "mokkerig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "797c4b45-ff37-3fd3-8248-9619cb681d06",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>mok</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bekers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zet de schone <w>mokken</w> alsjeblieft terug in de keukenkast.",
                            "target_lang_translations": {
                                "fr": "Remets s'il te plaît les <w>mugs</w> propres dans le placard de la cuisine."
                            }
                        },
                        {
                            "text": "We kochten vier grote <w>mokken</w> voor warme chocolademelk.",
                            "target_lang_translations": {
                                "fr": "Nous avons acheté quatre grands <w>mugs</w> pour le chocolat chaud."
                            }
                        }
                    ],
                    "common_phrases": [
                        "twee grote mokken",
                        "stenen mokken"
                    ],
                    "target_lang_definitions": {
                        "fr": "Pluriel de « mok » : grandes tasses, généralement avec une anse"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "mugs",
                                "target_lang_sense_clarification": "grandes tasses cylindriques"
                            },
                            {
                                "target_lang_word": "tasses",
                                "target_lang_sense_clarification": "récipients pour boissons chaudes"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "826ce466-2c92-3ab6-8ede-be8ef0d51917",
                    "sense_definition": "op een zwijgzame manier boos of slechtgehumeurd zijn; pruilen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ontevredenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In plaats van te praten, zat hij de hele avond in een hoekje te <w>mokken</w>.",
                            "target_lang_translations": {
                                "fr": "Au lieu de parler, il est resté toute la soirée à <w>bouder</w> dans un coin."
                            }
                        },
                        {
                            "text": "Hij <w>mokte</w> nog lang over het onrecht dat hem naar zijn mening was aangedaan.",
                            "target_lang_translations": {
                                "fr": "Il a encore <w>boudé</w> longtemps à cause de l'injustice qu'il estimait avoir subie."
                            }
                        }
                    ],
                    "synonyms": [
                        "pruilen"
                    ],
                    "common_phrases": [
                        "zitten te mokken"
                    ],
                    "target_lang_definitions": {
                        "fr": "Être d'humeur maussade et silencieuse, montrer son mécontentement en boudant"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "bouder",
                                "target_lang_sense_clarification": "manifester son mécontentement par le silence"
                            },
                            {
                                "target_lang_word": "faire la tête",
                                "target_lang_sense_clarification": "montrer qu'on est fâché"
                            },
                            {
                                "target_lang_word": "faire la gueule",
                                "target_lang_sense_clarification": "familier, être fâché et maussade"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b976753-c32c-3e06-a183-341ea4452f3f",
                    "sense_definition": "een zacht klokkend of tsjirpend geluid maken van opwinding of tevredenheid (van fretten)",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De fret begon vrolijk te <w>mokken</w> toen hij door de woonkamer rende.",
                            "target_lang_translations": {
                                "fr": "Le furet s'est mis à <w>pout-pouter</w> joyeusement en courant à travers le salon."
                            }
                        },
                        {
                            "text": "Als fretten opgewonden en speels zijn, gaan ze vaak zachtjes <w>mokken</w>.",
                            "target_lang_translations": {
                                "fr": "Lorsque les furets sont excités et joueurs, ils se mettent souvent à doucement <w>glousser</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Émettre un petit gloussement ou bruit sourd d'excitation ou de joie (en parlant d'un furet)"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pout-pouter",
                                "target_lang_sense_clarification": "terme spécifique au cri de joie du furet"
                            },
                            {
                                "target_lang_word": "glousser",
                                "target_lang_sense_clarification": "bruit doux émis par certains animaux"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}