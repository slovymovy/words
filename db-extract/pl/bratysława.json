                "senses": [
                    {
                        "sense_id": "1ee0932c-0966-3195-b7ca-024380a879a9",
                        "entry_id": "8f32da01-8cc0-3349-8215-942b2ad5fe95",
                        "glosses": [
                            "stolica i największe miasto Słowacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8efcc9b-055a-4fb0-9633-e3e638f86527",
                                "sense_id": "1ee0932c-0966-3195-b7ca-024380a879a9",
                                "text": "Bratysława jest jedyną stolicą na świecie, która graniczy z dwoma państwami, tj. na południu z Węgrami, a na zachodzie z Austrią."
                            },
                            {
                                "example_id": "bcb2e8ab-c5b0-422e-8c9d-c63e20075fbf",
                                "sense_id": "1ee0932c-0966-3195-b7ca-024380a879a9",
                                "text": "Dzisiejsze terytorium Bratysławy powstało pierwotnie w wyniku łączenia osad, a następnie przyłączania miejscowości z pobliskiej okolicy"
                            },
                            {
                                "example_id": "09e2f0e1-775d-4873-a617-c27245833f30",
                                "sense_id": "1ee0932c-0966-3195-b7ca-024380a879a9",
                                "text": "Zwiedziłem Bratysławę podczas wycieczki po Słowacji."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
