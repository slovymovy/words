                        {
                            "text": "De geschiedenis van de twee landen is nauw met elkaar <w>verweven</w>.",
                            "target_lang_translations": {
                                "en": "The history of the two countries is closely <w>intertwined</w>."
                            }
                        },
                        {
                            "text": "Zijn persoonlijke leven is volledig <w>verweven</w> met zijn professionele carrière.",
                            "target_lang_translations": {
                                "en": "His personal life is completely <w>interwoven</w> with his professional career."
                            }
                        }
