    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2cd35331-d1f5-3d6d-9ab7-b8debe0c8b90",
                    "sense_definition": "Plural of <w>age</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This board game is suitable for players of all <w>ages</w>.",
                            "target_lang_translations": {
                                "ru": "Эта настольная игра подходит для игроков всех <w>возрастов</w>.",
                                "tr": "Bu masa oyunu her <w>yaştan</w> oyuncu için uygundur.",
                                "zh": "这款桌游适合所有<w>年龄</w>段的玩家。"
                            }
                        },
                        {
                            "text": "History is divided into different <w>ages</w> based on technology and culture.",
                            "target_lang_translations": {
                                "ru": "История делится на различные <w>эпохи</w> в зависимости от технологий и культуры.",
                                "tr": "Tarih, teknoloji ve kültüre dayalı olarak farklı <w>çağlara</w> ayrılır.",
                                "zh": "历史根据技术和文化被划分为不同的<w>时代</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слов «возраст» или «эпоха».",
                        "tr": "\"Age\" (yaş veya çağ) kelimesinin çoğul hali.",
                        "zh": "“年龄”或“时代”的复数形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возрасты",
                                "target_lang_sense_clarification": "периоды жизни человека"
                            },
                            {
                                "target_lang_word": "эпохи",
                                "target_lang_sense_clarification": "исторические периоды"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yaşlar",
                                "target_lang_sense_clarification": "insanların yaşları"
                            },
                            {
                                "target_lang_word": "çağlar",
                                "target_lang_sense_clarification": "tarihsel dönemler"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "年龄",
                                "target_lang_sense_clarification": "指人或生物的岁数"
                            },
                            {
                                "target_lang_word": "时代",
                                "target_lang_sense_clarification": "指历史上的特定时期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe1d3fe8-859d-3742-8962-732e2a00aad4",
                    "sense_definition": "A very long time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have not seen my best friend for <w>ages</w>.",
                            "target_lang_translations": {
                                "ru": "Я не видел своего лучшего друга <w>целую вечность</w>.",
                                "tr": "En iyi arkadaşımı <w>uzun zamandır</w> görmedim.",
                                "zh": "我<w>好久</w>没见我最好的朋友了。"
                            }
                        },
                        {
                            "text": "It happened <w>ages</w> ago, so I barely remember the details.",
                            "target_lang_translations": {
                                "ru": "Это случилось <w>сто лет</w> назад, поэтому я с трудом помню детали.",
                                "tr": "Bu <w>asırlar</w> önce oldu, bu yüzden detayları neredeyse hiç hatırlamıyorum.",
                                "zh": "那件事发生在<w>很久</w>以前，所以我几乎不记得细节了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eons",
                        "years",
                        "forever"
                    ],
                    "antonyms": [
                        "moment",
                        "second",
                        "instant"
                    ],
                    "common_phrases": [
                        "for ages",
                        "ages ago",
                        "take ages"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень долгое время (разговорное выражение).",
                        "tr": "Çok uzun bir süre, asırlar (günlük konuşma dili).",
                        "zh": "指很长的一段时间（口语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вечность",
                                "target_lang_sense_clarification": "очень долго"
                            },
                            {
                                "target_lang_word": "сто лет",
                                "target_lang_sense_clarification": "идиома"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uzun zamandır",
                                "target_lang_sense_clarification": "çok uzun süredir"
                            },
                            {
                                "target_lang_word": "asırlar",
                                "target_lang_sense_clarification": "mübalağalı olarak çok uzun zaman"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好久",
                                "target_lang_sense_clarification": "形容时间非常长"
                            },
                            {
                                "target_lang_word": "很久",
                                "target_lang_sense_clarification": "指时间跨度大"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ccdbb949-e11f-3188-980c-717b226207a9",
                    "sense_definition": "Third-person singular simple present indicative of <w>age</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Good wine <w>ages</w> well if kept in the right conditions.",
                            "target_lang_translations": {
                                "ru": "Хорошее вино хорошо <w>стареет</w>, если хранится в правильных условиях.",
                                "tr": "İyi şarap doğru koşullarda saklanırsa güzel <w>yıllanır</w>.",
                                "zh": "如果保存条件得当，好酒会随着时间推移而<w>陈化</w>得更好。"
                            }
                        },
                        {
                            "text": "The population <w>ages</w> rapidly as birth rates continue to fall.",
                            "target_lang_translations": {
                                "ru": "Население стремительно <w>стареет</w>, поскольку рождаемость продолжает падать.",
                                "tr": "Doğum oranları düşmeye devam ettikçe nüfus hızla <w>yaşlanıyor</w>.",
                                "zh": "随着出生率持续下降，人口正在迅速<w>变老</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Третье лицо единственного числа глагола «стареть» или «выдерживаться».",
                        "tr": "\"Age\" fiilinin geniş zaman üçüncü tekil şahıs çekimi (yaşlanmak, olgunlaşmak).",
                        "zh": "动词“变老”或“陈化”的第三人称单数形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стареет",
                                "target_lang_sense_clarification": "становится старше"
                            },
                            {
                                "target_lang_word": "выдерживается",
                                "target_lang_sense_clarification": "созревает (о вине, сыре)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yaşlanır",
                                "target_lang_sense_clarification": "yaşça büyür veya eski hale gelir"
                            },
                            {
                                "target_lang_word": "yıllandırılır",
                                "target_lang_sense_clarification": "şarap vb. için olgunlaşır"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变老",
                                "target_lang_sense_clarification": "指人或生物年龄增长"
                            },
                            {
                                "target_lang_word": "陈化",
                                "target_lang_sense_clarification": "指酒类等经过时间变得更醇厚"
                            }
                        ]
                    }
                }
            ]
        }
    ]
