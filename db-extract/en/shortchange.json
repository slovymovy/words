                    {
                        "translation_id": "3ab85a59-75c7-4e46-a996-b113caf3242f",
                        "source_entry_id": "689b4e23-fa4f-3b65-8320-a3940c208db8",
                        "source_sense_description": "to defraud (someone) by giving them less change than they should be given after a transaction",
                        "target_lang_word": "обсчита́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
