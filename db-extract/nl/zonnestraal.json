                                        "sense_id": "f607be5e-2d04-3770-a58e-fa420bccf593",
                                        "entry_id": "5f0bcf86-3a34-3047-9372-075705138216",
                                        "glosses": [
                                            "A person (or thing) that brings happiness into the lives of others."
                                        ],
                                        "tags": [
                                            "endearing",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "356bf1ce-e96d-40d6-b3d3-2eb90d8d7b55",
                                                "sense_id": "f607be5e-2d04-3770-a58e-fa420bccf593",
                                                "text": "It would be nice if more people from the outside [of prison] would let us know that we are wanted and cared for. That would bring a little ray of sunshine into otherwise bleak lives."
                                            }
                                        ]
                                    }
                                ]
                            }
