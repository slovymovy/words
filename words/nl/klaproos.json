    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b2f0206a-819d-3656-8bc9-2c44d72b46fd",
                    "sense_definition": "Een plant met een opvallende felrode bloem die vaak in het wild groeit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bloemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de zomer zie je vaak een rode <w>klaproos</w> langs de kant van de weg.",
                            "target_lang_translations": {
                                "en": "In the summer, you often see a red <w>poppy</w> along the side of the road.",
                                "de": "Im Sommer sieht man oft einen roten <w>Klatschmohn</w> am Straßenrand."
                            }
                        },
                        {
                            "text": "De rode <w>klaproos</w> bloeit prachtig in het midden van het korenveld.",
                            "target_lang_translations": {
                                "en": "The red <w>poppy</w> blooms beautifully in the middle of the cornfield.",
                                "de": "Der rote <w>Klatschmohn</w> blüht wunderschön mitten im Kornfeld."
                            }
                        }
                    ],
                    "synonyms": [
                        "papaver"
                    ],
                    "common_phrases": [
                        "rode klaproos",
                        "bloeiende klaproos",
                        "gewone klaproos"
                    ],
                    "target_lang_definitions": {
                        "en": "A plant with a striking bright red flower that often grows in the wild.",
                        "de": "Eine Pflanze mit auffallend leuchtend roten Blüten, die häufig wild wächst."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "poppy",
                                "target_lang_sense_clarification": "the common red wildflower"
                            },
                            {
                                "target_lang_word": "corn poppy",
                                "target_lang_sense_clarification": "specifically Papaver rhoeas"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Klatschmohn",
                                "target_lang_sense_clarification": "die wild wachsende Pflanze (Papaver rhoeas)"
                            },
                            {
                                "target_lang_word": "Mohn",
                                "target_lang_sense_clarification": "alltägliche Bezeichnung für Klatschmohn"
                            },
                            {
                                "target_lang_word": "Klatschrose",
                                "target_lang_sense_clarification": "volkstümliche Bezeichnung für Klatschmohn"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3373fce3-45ab-3d3f-8f56-c6a80945d7ef",
                    "sense_definition": "Een algemene benaming voor planten uit het geslacht Papaver.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bloemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>klaproos</w> is een symbool geworden van het slagveld van de Eerste Wereldoorlog.",
                            "target_lang_translations": {
                                "en": "The <w>poppy</w> has become a symbol of the battlefield of the First World War.",
                                "de": "Der <w>Klatschmohn</w> ist zu einem Symbol der Schlachtfelder des Ersten Weltkriegs geworden."
                            }
                        },
                        {
                            "text": "Er zijn verschillende soorten van de <w>klaproos</w> die in de tuin kunnen groeien.",
                            "target_lang_translations": {
                                "en": "There are different types of <w>poppy</w> that can grow in the garden.",
                                "de": "Es gibt verschiedene Arten von <w>Mohn</w>, die im Garten wachsen können."
                            }
                        }
                    ],
                    "synonyms": [
                        "papaver"
                    ],
                    "common_phrases": [
                        "wilde klaproos"
                    ],
                    "target_lang_definitions": {
                        "en": "A general name for plants from the genus Papaver.",
                        "de": "Eine allgemeine Bezeichnung für Pflanzen aus der Gattung Mohn (Papaver)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "poppy",
                                "target_lang_sense_clarification": "any plant of the genus Papaver"
                            },
                            {
                                "target_lang_word": "papaver",
                                "target_lang_sense_clarification": "botanical name"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Mohn",
                                "target_lang_sense_clarification": "Pflanzengattung der Mohngewächse"
                            },
                            {
                                "target_lang_word": "Klatschmohn",
                                "target_lang_sense_clarification": "symbolisch, z. B. als Gedenkblume"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4113e31a-d7ce-3f70-889a-31d542b55ff5",
                    "sense_definition": "De tere en kwetsbare bloem van de papaverplant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bloemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De blaadjes van de <w>klaproos</w> vallen snel af als je ze plukt.",
                            "target_lang_translations": {
                                "en": "The petals of the <w>poppy</w> fall off quickly if you pick them.",
                                "de": "Die Blütenblätter der <w>Mohnblume</w> fallen schnell ab, wenn man sie pflückt."
                            }
                        },
                        {
                            "text": "Zodra het begint te regenen klapt de <w>klaproos</w> haar bloemblaadjes dicht.",
                            "target_lang_translations": {
                                "en": "As soon as it starts to rain, the <w>poppy</w> closes its petals.",
                                "de": "Sobald es zu regnen beginnt, schließt die <w>Mohnblume</w> ihre Blütenblätter."
                            }
                        }
                    ],
                    "synonyms": [
                        "papaverbloem",
                        "papaver"
                    ],
                    "common_phrases": [
                        "rode klaproos"
                    ],
                    "target_lang_definitions": {
                        "en": "The delicate and fragile flower of the poppy plant.",
                        "de": "Die zarte und empfindliche Blüte der Mohnpflanze."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "poppy",
