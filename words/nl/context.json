{
    "word_family": [
        "contextueel",
        "contextualiseren",
        "contextualisering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c222072b-97af-3061-b8ce-d801ee34519f",
                    "sense_definition": "De tekst die om een bepaald woord of een passage heen staat en de betekenis ervan verduidelijkt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "taalkundige samenhang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zonder de juiste <w>context</w> is het lastig om de exacte betekenis van dit woord te bepalen.",
                            "target_lang_translations": {
                                "en": "Without the right <w>context</w>, it is difficult to determine the exact meaning of this word."
                            }
                        },
                        {
                            "text": "Je moet de woorden in de <w>context</w> van de hele alinea lezen om het te begrijpen.",
                            "target_lang_translations": {
                                "en": "You must read the words in the <w>context</w> of the entire paragraph to understand it."
                            }
                        }
                    ],
                    "synonyms": [
                        "tekstverband"
                    ],
                    "common_phrases": [
                        "in de context"
                    ],
                    "target_lang_definitions": {
                        "en": "The text surrounding a specific word or passage that clarifies its meaning."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "context",
                                "target_lang_sense_clarification": "textual surroundings"
                            },
                            {
                                "target_lang_word": "textual context",
                                "target_lang_sense_clarification": "specifically regarding written words"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f511305e-4bb4-34ab-8121-8f0a24c29090",
                    "sense_definition": "De totale omgeving of situatie waarin iets gebeurt of wordt geplaatst.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "omgevingsfactoren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In een andere <w>context</w> zou deze opmerking misschien heel grappig zijn geweest.",
                            "target_lang_translations": {
                                "en": "In a different <w>context</w>, this remark might have been very funny."
                            }
                        },
                        {
                            "text": "Het is belangrijk om deze gebeurtenis in de juiste maatschappelijke <w>context</w> te plaatsen.",
                            "target_lang_translations": {
                                "en": "It is important to place this event in the correct social <w>context</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kader",
                        "verband",
                        "omstandigheden"
                    ],
                    "common_phrases": [
                        "juiste context",
                        "brede context"
                    ],
                    "target_lang_definitions": {
                        "en": "The total environment or situation in which something happens or is placed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "context",
                                "target_lang_sense_clarification": "general circumstances"
                            },
                            {
                                "target_lang_word": "setting",
                                "target_lang_sense_clarification": "the environment where something occurs"
                            },
                            {
                                "target_lang_word": "framework",
                                "target_lang_sense_clarification": "the conceptual structure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26af1632-ef2f-3583-8804-ddadcbf5ba88",
                    "sense_definition": "De historische of sociale achtergrond die voorafging aan een specifieke gebeurtenis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "omgevingsfactoren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ontwikkelingen in dat land kun je alleen begrijpen in de historische <w>context</w>.",
                            "target_lang_translations": {
                                "en": "The developments in that country can only be understood in the historical <w>context</w>."
                            }
                        },
                        {
                            "text": "Zonder de politieke <w>context</w> te kennen, lijkt deze beslissing erg onlogisch.",
                            "target_lang_translations": {
                                "en": "Without knowing the political <w>context</w>, this decision seems very illogical."
                            }
                        }
                    ],
                    "synonyms": [
                        "achtergrond"
                    ],
                    "common_phrases": [
                        "historische context",
                        "politieke context"
                    ],
                    "target_lang_definitions": {
                        "en": "The historical or social background preceding a specific event."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "background",
                                "target_lang_sense_clarification": "historical or social circumstances"
                            },
                            {
                                "target_lang_word": "context",
                                "target_lang_sense_clarification": "historical or political situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5061e121-bc90-3fa9-a4e4-3038cfd907b1",
                    "sense_definition": "De specifieke zakelijke inhoud of de formele bewoordingen van een officieel document of oorkonde.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "documentatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De archivaris bestudeerde de <w>context</w> van de middeleeuwse oorkonde zeer nauwkeurig.",
                            "target_lang_translations": {
                                "en": "The archivist studied the <w>context</w> of the medieval charter very precisely."
                            }
                        },
                        {
                            "text": "In de juridische <w>context</w> van dit document hebben deze termen een strikte betekenis.",
                            "target_lang_translations": {
                                "en": "In the legal <w>context</w> of this document, these terms have a strict meaning."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebruikt in de diplomatiek of archiefwetenschap"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The specific business content or formal wording of an official document or charter."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "context",
                                "target_lang_sense_clarification": "formal content of a document"
                            },
                            {
                                "target_lang_word": "tenor",
                                "target_lang_sense_clarification": "the exact wording or meaning of a legal document"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}