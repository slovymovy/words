                        "entry_id": "feebc067-5325-30f5-aead-778ef6215da1",
                        "glosses": [
                            "Emotionally upset; not able to keep it together."
                        ],
                        "tags": [
                            "informal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "153af9cc-2b16-4dbd-8ee1-4bbcfa658821",
                                "sense_id": "90f02bcd-93a1-323a-b16e-3bd3ca058e7a",
                                "text": "Waking up in the small room, you feel dull, stupid, gloomy, oppressed, yawny, lax, and all unstrung in body and mind..."
                            },
                            {
                                "example_id": "a85d0fc5-9811-41bb-9a4a-6fd3689bd965",
                                "sense_id": "90f02bcd-93a1-323a-b16e-3bd3ca058e7a",
                                "text": "“Why, Jane,” he cried, “what do you mean? What has our providential rescue to do with altering your feelings toward me? You are but unstrung—tomorrow you will be yourself again.”"
                            }
                        ]
                    }
