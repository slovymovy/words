                    {
                        "translation_id": "f4041b70-0479-4aeb-8347-090610ce8414",
                        "source_entry_id": "feb254ee-adaf-3b28-8a47-f0542ad7882e",
                        "source_sense_id": "3d5b75f6-f999-34d4-b874-d96940717d29",
                        "source_sense_description": "slootplank",
                        "target_lang_word": "caillebotis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caillebotis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "570267a7-47e0-3189-9f65-e54bb858df5a",
                                        "entry_id": "d66a0205-ab67-3cbc-bb49-721099c60c7f",
                                        "glosses": [
                                            "Treillis de bois ou de métal recouvrant l’ouverture d’une écoutille ou treillis amovible servant de plancher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc6edcf0-8599-467e-963e-03ee61087c82",
                                                "sense_id": "570267a7-47e0-3189-9f65-e54bb858df5a",
                                                "text": "Les caillebotis et les panneaux avaient été enlevés, afin d’aérer et de sanifier la cale."
                                            },
                                            {
                                                "example_id": "c0ad9acb-9ab3-4c1c-b297-97074cca0c52",
                                                "sense_id": "570267a7-47e0-3189-9f65-e54bb858df5a",
                                                "text": "Sur cette première assise fortement établie, Wilson avait posé une sorte de plancher en claire-voie fait de caillebottis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49b1c3fd-4be2-3c09-8839-4d96438c1386",
                                        "entry_id": "d66a0205-ab67-3cbc-bb49-721099c60c7f",
                                        "glosses": [
                                            "Trottoir ou passage fait d’un treillis soit de lamelles métalliques, soit de lattes de bois, ou de rondins, allongé sur un creux dans le sol, ou sur un sol trop meuble (comme de la boue)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "486fb8eb-590f-3992-bbc8-5c07a1b33826",
                                        "entry_id": "d66a0205-ab67-3cbc-bb49-721099c60c7f",
                                        "glosses": [
                                            "Plancher amovible utilisé pour réaliser des circulations ou des terrasses dans les jardins."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6bdcebd-94e2-4850-9a69-89091e7bb5c5",
                                                "sense_id": "486fb8eb-590f-3992-bbc8-5c07a1b33826",
                                                "text": "Ici, des passerelles vitrées traversent un bâtiment de brique fraîchement rénové, dévoilant des terrasses en caillebotis, des perspectives arborées où les résidents prennent gentiment le frais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afa501c2-dd61-3dd4-9b15-344ff34cc0f2",
                                        "entry_id": "d66a0205-ab67-3cbc-bb49-721099c60c7f",
                                        "glosses": [
                                            "Grilles métalliques allongées servant à couvrir les bouches d’absorption des eaux pluviales."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e543622-d42e-3066-bf81-416c86a3f59c",
                                        "entry_id": "d66a0205-ab67-3cbc-bb49-721099c60c7f",
                                        "glosses": [
                                            "Grille métallique ou béton perforé permettant de récupérer les effluents d’élevage principalement dans les systèmes tout lisier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "508262d0-fcbc-4d6f-88e6-e6fc5c33e6ba",
                                                "sense_id": "6e543622-d42e-3066-bf81-416c86a3f59c",
                                                "text": "Elle pensa aux cochons entravés dans des tonnes de merde et d'urine, glissant sur les caillebotis, à ce qui se déversait chaque jour dans cet océan. Elle pensa aux marées noires. Aux marées vertes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
