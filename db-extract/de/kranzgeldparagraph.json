                "senses": [
                    {
                        "sense_id": "f2bb9473-03af-38e1-8421-7bba88193e64",
                        "entry_id": "0bd884b4-2e53-3a6f-a333-51db5a57ce2a",
                        "glosses": [
                            "der umgangssprachliche Name für den Paragraphen 1300 des BGB, der die finanzielle Entschädigung einer „entlobten“, jungen, unbescholtenen Frau regelte, die mit ihrem Verlobten bereits Geschlechtsverkehr hatte"
                        ],
                        "tags": [
                            "Rechtsprechung"
                        ],
                        "examples": [
                            {
                                "example_id": "100a455e-a3fc-4784-84d4-bb3758c83f0a",
                                "sense_id": "f2bb9473-03af-38e1-8421-7bba88193e64",
                                "text": "„Das Einzige, was das BGB annähernd hierzu zu bieten hatte, war der sogenannte Kranzgeldparagraf. Paragraf 1300 besagte, dass, wenn eine unbescholtene Verlobte ihrem Verlobten die Beiwohnung gestattete, sie eine billige Entschädigung in Geld verlangen konnte, wenn es nicht zur Heirat kam.“"
                            },
                            {
                                "example_id": "a4e38b17-e6c0-4617-9e0a-945859d6e8c6",
                                "sense_id": "f2bb9473-03af-38e1-8421-7bba88193e64",
                                "text": "Der Kranzgeldparagraph wurde 1998 abgeschafft."
                            },
                            {
                                "example_id": "a6eb7939-12da-42c0-8dba-0e1865b58eaa",
                                "sense_id": "f2bb9473-03af-38e1-8421-7bba88193e64",
                                "text": "Hintergrund des Kranzgeldparagraphen waren die Moralvorstellungen um 1900."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
