                ],
                "senses": [
                    {
                        "sense_id": "73a2c4cf-5127-3a31-9502-dc5ed8b1dc75",
                        "entry_id": "4313598f-531d-3ca0-9bf3-0d13a117689a",
                        "glosses": [
                            "ein Roman, der ohne große literarische Ansprüche zu verfolgen vornehmlich der Unterhaltung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5595e36d-a2e7-4b60-8bec-4aba845179f7",
                                "sense_id": "73a2c4cf-5127-3a31-9502-dc5ed8b1dc75",
                                "text": "„Und ich kann mich für einen guten Unterhaltungsroman genauso begeistern wie für die sogenannte ernsthafte Literatur, und manchmal finde ich diese Unterscheidungen im deutschen Sprachraum sehr mühsam.“"
                            },
                            {
                                "example_id": "0cf5ea05-c9da-4e91-b0f2-dda8fac273bb",
                                "sense_id": "73a2c4cf-5127-3a31-9502-dc5ed8b1dc75",
                                "text": "„Ich hatte zwei Bücher von ihm gelesen, politische Unterhaltungsromane, die ihren Erfolg dem Mißverständnis verdankten, wagemutig zu sein.“"
                            },
                            {
                                "example_id": "4e84725c-0a56-482d-816b-d93ad34631ac",
                                "sense_id": "73a2c4cf-5127-3a31-9502-dc5ed8b1dc75",
                                "text": "„Das Ergebnis ist ein routiniert konstruierter Unterhaltungsroman.“"
                            },
                            {
                                "example_id": "c4863030-bbbc-4a5a-90b0-e67ef662bd9d",
                                "sense_id": "73a2c4cf-5127-3a31-9502-dc5ed8b1dc75",
                                "text": "„Der Umgang damit in einem Unterhaltungsroman ist mir schwergefallen und ich habe versucht, sie vorsichtig als Themen, die mich und meine Figuren beschäftigen, anklingen zu lassen, um nicht einfach so zu tun, als gäbe es sie nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
