                                "target_senses": [
                                    {
                                        "sense_id": "8d2f1e37-cd98-3af3-bddd-a7dcef993a53",
                                        "entry_id": "bf70434c-e17b-3440-b33c-4e3d58c1cdc7",
                                        "glosses": [
                                            "weibliche Person, die eine Farm besitzt und diese auch meist betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23ea86db-75a6-415d-9c08-44e6cb4183b1",
                                                "sense_id": "8d2f1e37-cd98-3af3-bddd-a7dcef993a53",
                                                "text": "„Das mit sieben Oscars ausgezeichnete Melodram um die Liebe der dänischen Schriftstellerin und Farmerin Karen Blixen zu dem englischen Buschpilot Denys Finch Hatton wurde zu einem weltweiten Publikumserfolg.“"
                                            },
                                            {
                                                "example_id": "3d9d85a2-a3e4-4370-9b0e-6e6018dbb17f",
                                                "sense_id": "8d2f1e37-cd98-3af3-bddd-a7dcef993a53",
                                                "text": "„Deutschstämmige Farmerinnen und Farmer in Namibia besitzen ihr Land dagegen teils seit Generationen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "959aaf06-bd40-4243-ba34-c7e58bb44a10",
                        "source_entry_id": "beafb126-8b01-3708-aba1-0a1daa030755",
                        "source_sense_id": "fb1fd7f1-0e4a-31b6-a141-7cadb4d40c7e",
                        "source_sense_description": "veraltet: weiblicher Farmer/Bauer; Farmerin, Bäuerin, Landwirtin",
                        "target_lang_word": "Bäuerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bäuerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebdcb3c8-317a-305c-b88b-63144b6af13f",
                                        "entry_id": "6ce48ac7-1a3d-35e1-b14c-82a14aaa9ef9",
                                        "glosses": [
                                            "weibliche Person, die eine Landwirtschaft betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b1b4de-d1a9-4d37-b90c-c0fefee20e09",
                                                "sense_id": "ebdcb3c8-317a-305c-b88b-63144b6af13f",
                                                "text": "Jeden Herbst fängt die Bäuerin an mit Kartoffellesen."
                                            },
                                            {
                                                "example_id": "615d6959-7c40-49f6-b2a6-faf25472fae8",
                                                "sense_id": "ebdcb3c8-317a-305c-b88b-63144b6af13f",
                                                "text": "„Dagegen mussten 7 Millionen Bäuerinnen und Bauern mit 16,4 Millionen Hektar auskommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aca1b783-d8a6-38d2-aeef-8997f12c692a",
                                        "entry_id": "6ce48ac7-1a3d-35e1-b14c-82a14aaa9ef9",
                                        "glosses": [
                                            "Ehefrau eines Bauern, eines Mannes, der eine Landwirtschaft betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4752216-ea3f-40d7-b82c-eaf569e7720a",
                                                "sense_id": "aca1b783-d8a6-38d2-aeef-8997f12c692a",
                                                "text": "„Er läßt sich der Bäuerin gegenüber auch nie etwas merken, er nicht und kein anderer.“"
                                            },
                                            {
                                                "example_id": "d258f072-5f5d-4fac-bb02-9b1b882fea9f",
                                                "sense_id": "aca1b783-d8a6-38d2-aeef-8997f12c692a",
                                                "text": "„Kurze Zeit später kommt die Bäuerin nach Hause.“"
                                            },
                                            {
                                                "example_id": "2bf1544b-492c-4563-81f7-749b6e2cf6a9",
                                                "sense_id": "aca1b783-d8a6-38d2-aeef-8997f12c692a",
                                                "text": "„Geschäftig trug die Hausfrau, eine hübsche blonde Bäuerin wie aus dem Bilderbuch, Mettwurst, Käse, Brot und Schinken herbei, während ihr Mann die Bierflaschen aufploppen ließ.“"
                                            },
                                            {
                                                "example_id": "e1b39092-ec5a-4ec8-9bc9-66225c4cd8fb",
                                                "sense_id": "aca1b783-d8a6-38d2-aeef-8997f12c692a",
                                                "text": "„Die Bäuerin bringt uns sogar Federbetten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00afcf58-0101-447b-b260-ac2063711203",
                        "source_entry_id": "beafb126-8b01-3708-aba1-0a1daa030755",
                        "source_sense_id": "fb1fd7f1-0e4a-31b6-a141-7cadb4d40c7e",
