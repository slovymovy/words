                                        "entry_id": "9f19e327-0ef1-31b6-bd87-77188888b934",
                                        "glosses": [
                                            "An American initiative to provide foreign aid to countries in Western Europe after World War II, in operation from 1948 to 1951."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
