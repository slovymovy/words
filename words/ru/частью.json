                    "sense_definition": "Творительный падеж единственного числа существительного <w>часть</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Музыка всегда была неотъемлемой <w>частью</w> её повседневной жизни.",
                            "target_lang_translations": {
                                "en": "Music has always been an integral <w>part</w> of her daily life.",
                                "zh": "音乐一直是她日常生活中不可或缺的<w>部分</w>。"
                            }
                        },
                        {
                            "text": "Он очень гордился тем, что стал <w>частью</w> этой дружной команды.",
                            "target_lang_translations": {
                                "en": "He was very proud to have become <w>part</w> of this friendly team.",
                                "zh": "他为能成为这个团结团队的<w>一部分</w>而感到非常自豪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "быть частью",
                        "стать частью",
                        "являться частью"
                    ],
                    "traits": [
                        {
