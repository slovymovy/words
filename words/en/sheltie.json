{
    "word_family": [
        "Shetland",
        "Shetlander"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c3a9e6b0-923d-3f0b-9e0a-c9a47c719f88",
                    "sense_definition": "A Shetland sheepdog, a small breed of herding dog that originated in the Shetland Islands.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dog breeds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family decided to adopt a <w>sheltie</w> because they wanted a small and intelligent herding dog.",
                            "target_lang_translations": {
                                "ru": "Семья решила завести <w>шелти</w>, потому что они хотели небольшую и умную пастушью собаку."
                            }
                        },
                        {
                            "text": "A <w>sheltie</w> puppy requires regular grooming to keep its long coat healthy and free of tangles.",
                            "target_lang_translations": {
                                "ru": "Щенку <w>шелти</w> требуется регулярный уход, чтобы его длинная шерсть оставалась здоровой и не спутывалась."
                            }
                        }
                    ],
                    "synonyms": [
                        "Shetland sheepdog"
                    ],
                    "common_phrases": [
                        "sheltie puppy",
                        "purebred sheltie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шетландская овчарка, небольшая порода пастушьих собак, выведенная на Шетландских островах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шелти",
                                "target_lang_sense_clarification": "порода собак"
                            },
                            {
                                "target_lang_word": "шетландская овчарка",
                                "target_lang_sense_clarification": "полное название породы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67b20728-a24c-3325-a643-935b21fbec33",
                    "sense_definition": "A Shetland pony, or by extension, any small pony.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "equines",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were delighted to take turns riding the <w>sheltie</w> around the farm paddock.",
                            "target_lang_translations": {
                                "ru": "Дети были в восторге от возможности по очереди кататься на <w>пони</w> по фермерскому загону."
                            }
                        },
                        {
                            "text": "He traveled across the rugged hills on a sturdy <w>sheltie</w> that was well-suited for the terrain.",
                            "target_lang_translations": {
                                "ru": "Он путешествовал по суровым холмам на крепком <w>пони</w>, который хорошо подходил для этой местности."
                            }
                        }
                    ],
                    "synonyms": [
                        "Shetland pony"
                    ],
                    "common_phrases": [
                        "ride a sheltie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шетландский пони или, в более широком смысле, любой маленький пони."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шетландский пони",
                                "target_lang_sense_clarification": "порода пони"
                            },
                            {
                                "target_lang_word": "шелти",
                                "target_lang_sense_clarification": "разговорное название пони"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41684a39-99e7-3c49-b958-62e56ebe53b3",
                    "sense_definition": "A native or inhabitant of the Shetland Islands.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a proud <w>sheltie</w>, he often spoke about the unique traditions of his island home.",
                            "target_lang_translations": {
                                "ru": "Как гордый <w>шетландец</w>, он часто рассказывал об уникальных традициях своей островной родины."
                            }
                        },
                        {
                            "text": "The local festival was organized by a group of <w>shelties</w> who wanted to preserve their heritage.",
                            "target_lang_translations": {
                                "ru": "Местный фестиваль был организован группой <w>шетландцев</w>, которые хотели сохранить свое наследие."
                            }
                        }
                    ],
                    "synonyms": [
                        "Shetlander"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Shetland Islands"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уроженец или житель Шетландских островов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шетландец",
                                "target_lang_sense_clarification": "житель островов"
                            },
                            {
                                "target_lang_word": "житель Шетландских островов",
                                "target_lang_sense_clarification": "описание происхождения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}