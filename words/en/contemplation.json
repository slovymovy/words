{
    "word_family": [
        "contemplate",
        "contemplative",
        "contemplator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d7ef1f2-d07c-3f45-8d85-508ddf64d260",
                    "sense_definition": "The act of thinking deeply and quietly about something for a long time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "thought",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quiet garden provided a perfect space for deep <w>contemplation</w>.",
                            "target_lang_translations": {
                                "nl": "De rustige tuin bood een perfecte plek voor diepe <w>bezinning</w>."
                            }
                        },
                        {
                            "text": "He sat in silent <w>contemplation</w> while watching the sunset over the ocean.",
                            "target_lang_translations": {
                                "nl": "Hij zat in stille <w>overpeinzing</w> terwijl hij naar de zonsondergang boven de oceaan keek."
                            }
                        }
                    ],
                    "synonyms": [
                        "attention",
                        "consideration"
                    ],
                    "antonyms": [
                        "pragmatism"
                    ],
                    "common_phrases": [
                        "deep contemplation",
                        "silent contemplation"
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling van het langdurig, diep en rustig over iets nadenken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bezinning",
                                "target_lang_sense_clarification": "diepgaande innerlijke rust en overdenking"
                            },
                            {
                                "target_lang_word": "overpeinzing",
                                "target_lang_sense_clarification": "het rustig en diep nadenken"
                            },
                            {
                                "target_lang_word": "bespiegeling",
                                "target_lang_sense_clarification": "het diep nadenken of overdenken"
                            },
                            {
                                "target_lang_word": "contemplatie",
                                "target_lang_sense_clarification": "rustige, diepe beschouwing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c738c9c6-2b7c-3a45-847c-8465e87de28c",
                    "sense_definition": "A form of deep, focused meditation often associated with religious or spiritual practice.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "thought",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monk spent his days in prayer and spiritual <w>contemplation</w>.",
                            "target_lang_translations": {
                                "nl": "De monnik bracht zijn dagen door in gebed en spirituele <w>contemplatie</w>."
                            }
                        },
                        {
                            "text": "Many people find peace through the practice of daily <w>contemplation</w>.",
                            "target_lang_translations": {
                                "nl": "Veel mensen vinden rust door de beoefening van dagelijkse <w>meditatie</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een vorm van diepe, gerichte meditatie, vaak verbonden aan een religieuze of spirituele praktijk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "contemplatie",
                                "target_lang_sense_clarification": "spirituele of religieuze meditatie"
                            },
                            {
                                "target_lang_word": "meditatie",
                                "target_lang_sense_clarification": "spirituele oefening van diepe concentratie"
                            },
                            {
                                "target_lang_word": "bezinning",
                                "target_lang_sense_clarification": "spirituele rust en bezinning"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c377dd41-902f-3307-95ed-5c0d0b3467dc",
                    "sense_definition": "The state of being considered or planned for the future.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is in <w>contemplation</w> of a major expansion next year.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf is in <w>beraad</w> over een grote uitbreiding volgend jaar."
                            }
                        },
                        {
                            "text": "Legal action is currently under <w>contemplation</w> by the board of directors.",
                            "target_lang_translations": {
                                "nl": "Juridische stappen zijn momenteel in <w>overweging</w> bij de raad van bestuur."
                            }
                        }
                    ],
                    "synonyms": [
                        "consideration"
                    ],
                    "common_phrases": [
                        "under contemplation",
                        "in contemplation of"
                    ],
                    "target_lang_definitions": {
                        "nl": "De toestand waarin iets wordt overwogen of gepland voor de toekomst."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "overweging",
                                "target_lang_sense_clarification": "het beraden of beoordelen van plannen"
                            },
                            {
                                "target_lang_word": "beraad",
                                "target_lang_sense_clarification": "het overleggen of plannen maken"
                            },
                            {
                                "target_lang_word": "beschouwing",
                                "target_lang_sense_clarification": "aandachtige beoordeling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4f4f629-6c31-392a-94d1-6dd7980a0c1a",
                    "sense_definition": "The act of looking forward to or anticipating a future event.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>contemplation</w> of his upcoming retirement filled him with mixed emotions.",
                            "target_lang_translations": {
                                "nl": "Het <w>vooruitzicht</w> op zijn naderende pensioen vervulde hem met gemengde gevoelens."
                            }
                        },
                        {
                            "text": "She lived in constant <w>contemplation</w> of the journey she would soon undertake.",
                            "target_lang_translations": {
                                "nl": "Ze leefde voortdurend in de <w>gedachte</w> aan de reis die ze spoedig zou maken."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het vooruitblikken op of anticiperen van een toekomstige gebeurtenis."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vooruitzicht",
                                "target_lang_sense_clarification": "het vooruitblikken op wat gaat komen"
                            },
                            {
                                "target_lang_word": "gedachte",
                                "target_lang_sense_clarification": "het stilstaan bij de toekomst"
                            },
                            {
                                "target_lang_word": "bespiegeling",
                                "target_lang_sense_clarification": "het nadenken over wat te wachten staat"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}