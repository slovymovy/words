                "senses": [
                    {
                        "sense_id": "fab573cf-eb0a-3443-a437-6ae3cce8153e",
                        "entry_id": "88a35e7f-b789-3ef1-953a-83e85a2a4784",
                        "glosses": [
                            "Lit en briques chauffé de l’intérieur, au nord de la Chine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d7df336-cf73-4004-9863-434363170526",
                                "sense_id": "fab573cf-eb0a-3443-a437-6ae3cce8153e",
                                "text": "Au fond du boudoir et du salon, près des fenêtres, sont les inévitables kang, qui servent à la fois, dans le nord de la Chine, de lits et de cheminées."
                            },
                            {
                                "example_id": "1d4ce53d-a578-4aa5-9ac3-bec7c4da8486",
                                "sense_id": "fab573cf-eb0a-3443-a437-6ae3cce8153e",
                                "text": "Wang Meizi se tenait au chevet de Belle-sœur Wang, la petite Huan était accroupie sur le kang, toutes trois silencieuses."
                            },
                            {
                                "example_id": "6509743a-e6b1-4308-8241-8e788935297b",
                                "sense_id": "fab573cf-eb0a-3443-a437-6ae3cce8153e",
                                "text": "Comme couchette, nous avons le kang, sorte de terrasse en briques, à l’intérieur de laquelle se trouve un four pour brûler de la paille."
                            }
                        ]
                    }
                ],
