                    "semantic_group_id": "censure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comité de rédaction a <w>supprimé</w> les passages les plus polémiques de l'article.",
                            "target_lang_translations": {
                                "en": "The editorial board has <w>cut</w> the most controversial passages from the article.",
