{
    "word_family": [
        "macht",
        "machtig",
        "almachtig",
        "onmachtig",
        "machteloos"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f4228ba5-457b-3288-a004-4ad2728f85a8",
                    "sense_definition": "een uitroep van grote verbazing, schrik of bewondering",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uitroep van verbazing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Allemachtig</w>, wat een enorme puinhoop heb je ervan gemaakt!",
                            "target_lang_translations": {
                                "en": "<w>Good heavens</w>, what a huge mess you've made of it!"
                            }
                        },
                        {
                            "text": "<w>Allemachtig</w>! Achtentachtig krachtige vrachtwagens brachten prachtige, zachte vachten.",
                            "target_lang_translations": {
                                "en": "<w>Good grief</w>! Eighty-eight powerful trucks brought beautiful, soft furs."
                            }
                        }
                    ],
                    "synonyms": [
                        "jeetje",
                        "mijn hemel",
                        "jongejonge",
                        "potverdorie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt om emotie te benadrukken"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an exclamation of great surprise, shock, or admiration"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "good heavens",
                                "target_lang_sense_clarification": "exclamation of surprise"
                            },
                            {
                                "target_lang_word": "good grief",
                                "target_lang_sense_clarification": "exclamation of shock or annoyance"
                            },
                            {
                                "target_lang_word": "my goodness",
                                "target_lang_sense_clarification": "exclamation of surprise or emphasis"
                            },
                            {
                                "target_lang_word": "almighty",
                                "target_lang_sense_clarification": "used as an exclamation, often 'God almighty'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ae093dda-c2ec-3d2d-a9f1-1364647d51dc",
                    "sense_definition": "in zeer hoge mate; buitengewoon of enorm",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "versterkend bijwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dan merk je pas goed hoe <w>allemachtig</w> groot Afrika eigenlijk is.",
                            "target_lang_translations": {
                                "en": "Only then do you really notice how <w>almighty</w> big Africa actually is."
                            }
                        },
                        {
                            "text": "Het was die dag <w>allemachtig</w> koud buiten door de harde wind.",
                            "target_lang_translations": {
                                "en": "It was <w>mighty</w> cold outside that day because of the strong wind."
                            }
                        }
                    ],
                    "synonyms": [
                        "enorm",
                        "ontzettend",
                        "bijzonder",
                        "verbazingwekkend"
                    ],
                    "antonyms": [
                        "enigszins",
                        "nauwelijks"
                    ],
                    "common_phrases": [
                        "allemachtig groot",
                        "allemachtig veel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "gebruikt als versterker"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to a very high degree; extraordinarily or enormously"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "almighty",
                                "target_lang_sense_clarification": "used as an intensifier"
                            },
                            {
                                "target_lang_word": "mighty",
                                "target_lang_sense_clarification": "informal intensifier meaning 'very'"
                            },
                            {
                                "target_lang_word": "enormously",
                                "target_lang_sense_clarification": "to a very great degree"
                            },
                            {
                                "target_lang_word": "incredibly",
                                "target_lang_sense_clarification": "extremely"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8ad49265-f806-3adc-a9da-55640a0e1cce",
                    "sense_definition": "een alternatieve vorm van <w>almachtig</w>, bezittende over onbeperkte macht",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "macht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude teksten wordt vaak gesproken over de <w>allemachtige</w> schepper van het universum.",
                            "target_lang_translations": {
                                "en": "In old texts, the <w>almighty</w> creator of the universe is often spoken of."
                            }
                        },
                        {
                            "text": "De koning waande zich <w>allemachtig</w> en luisterde naar niemand meer.",
                            "target_lang_translations": {
                                "en": "The king imagined himself <w>omnipotent</w> and no longer listened to anyone."
                            }
                        }
                    ],
                    "synonyms": [
                        "almachtig",
                        "alvermogend"
                    ],
                    "antonyms": [
                        "onmachtig",
                        "machteloos"
                    ],
                    "common_phrases": [
                        "de allemachtige God"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "variant van almachtig"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "possessing unlimited power; an alternative form of 'almighty'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "almighty",
                                "target_lang_sense_clarification": "having complete power"
                            },
                            {
                                "target_lang_word": "omnipotent",
                                "target_lang_sense_clarification": "all-powerful"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}