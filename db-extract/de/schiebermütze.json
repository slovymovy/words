                "senses": [
                    {
                        "sense_id": "bc722014-9fe6-3bc2-9127-acdbae559f51",
                        "entry_id": "de7c925a-a795-3d91-9f20-fd81d17e85e1",
                        "glosses": [
                            "etwas größere Schirmmütze"
