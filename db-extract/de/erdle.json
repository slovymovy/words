                ],
                "senses": [
                    {
                        "sense_id": "df787825-222a-36b7-aaaa-77585e6f1bb0",
                        "entry_id": "2cbf1b91-6c79-3fdf-8356-4e356d11d6ee",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ab45970-0c2f-4f56-94db-2311e540335a",
                                "sense_id": "df787825-222a-36b7-aaaa-77585e6f1bb0",
                                "text": "Frau Erdle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7c29c8b4-4faa-4540-8608-a41eedc014a1",
                                "sense_id": "df787825-222a-36b7-aaaa-77585e6f1bb0",
                                "text": "Herr Erdle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9fc9acef-0b69-4de5-81a9-18064ff0422b",
                                "sense_id": "df787825-222a-36b7-aaaa-77585e6f1bb0",
                                "text": "Die Erdles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "89f9101a-d64d-44fa-831c-fd1e0a81d1d0",
                                "sense_id": "df787825-222a-36b7-aaaa-77585e6f1bb0",
                                "text": "Der Erdle trägt nie die Pullover, die die Erdle ihm strickt."
                            },
                            {
                                "example_id": "bc3f2c57-256a-4f7a-9291-ff118f90bb71",
                                "sense_id": "df787825-222a-36b7-aaaa-77585e6f1bb0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Erdle kommt, geht der Herr Erdle.“"
                            },
                            {
                                "example_id": "fddb200b-3dc1-49c3-8ed8-b443e113e39e",
                                "sense_id": "df787825-222a-36b7-aaaa-77585e6f1bb0",
                                "text": "Erdle kommt und geht."
                            },
                            {
                                "example_id": "a8a3f401-0928-4e04-8d1d-012c769333f7",
                                "sense_id": "df787825-222a-36b7-aaaa-77585e6f1bb0",
                                "text": "Erdles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
