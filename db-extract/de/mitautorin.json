                    {
                        "sense_id": "9bb29ece-ca61-37cd-a2b1-7521fab7d463",
                        "entry_id": "bd327bc1-d1b0-3f0c-9ecb-fff868415abf",
                        "glosses": [
                            "weibliche Person, die zugleich (auch/mit) als schreibende Person (Autorin) tätig ist; eine von zwei oder mehreren Personen, die gemeinsam einen Text verfassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "345459ec-9c60-429c-bb48-5e6029ba141e",
                                "sense_id": "9bb29ece-ca61-37cd-a2b1-7521fab7d463",
                                "text": "„Es genüge nicht, für das Fischereimanagement nur die Bestände der Fische zu berücksichtigen, fasste Mitautorin Lena Bergström von der Schwedischen Universität für Agrarwissenschaften (SLU) die Bedeutung einer systemischen Betrachtung zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
