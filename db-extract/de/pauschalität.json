                "senses": [
                    {
                        "sense_id": "28a0eab4-fc27-345a-8454-7fcf17e4f48a",
                        "entry_id": "e6a8d213-cf60-3777-86cd-14dde9323770",
                        "glosses": [
                            "verallgemeinernde Aussage, oft mit dem Beiton einer ungerechtfertigten Verallgemeinerung"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "4256fa41-4a81-4fdd-ba3d-7286ba42a579",
                                "sense_id": "28a0eab4-fc27-345a-8454-7fcf17e4f48a",
                                "text": "„Demgegenüber gibt es eine Reihe von Aussagen, die der Anklage und damit dem Ziel des Prozesses schon durch die Pauschalität der in ihnen erhobenen Beschuldigungen direkt dienlich war.“"
                            },
                            {
                                "example_id": "5a1a733b-494d-488a-a868-dbb50cfcfa0c",
                                "sense_id": "28a0eab4-fc27-345a-8454-7fcf17e4f48a",
                                "text": "„Sie ermöglichen eine Feinheit der Analyse, die in bisherigen Zugängen, auch jenen, die direkt auf Foucault rekurrieren, allzu oft in Pauschalitäten verloren gegangen sind.“"
                            },
                            {
                                "example_id": "7df3b9e3-bbe0-4c1d-878f-452ba521274d",
                                "sense_id": "28a0eab4-fc27-345a-8454-7fcf17e4f48a",
                                "text": "„Es wäre aber auch falsch die Autonomen in Pauschalität zu verurteilen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
