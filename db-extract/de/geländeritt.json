                "senses": [
                    {
                        "sense_id": "af513d48-3155-34fb-819a-ded9773442b5",
                        "entry_id": "bb0fec19-72a4-3d89-9f73-01c5a1c141fd",
                        "glosses": [
                            "generell ein Ritt auf einem Pferd durch offenes Gelände"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07ac7282-88c3-443f-8923-4544024a7076",
                                "sense_id": "af513d48-3155-34fb-819a-ded9773442b5",
                                "text": "„Dieser zweistündige Geländeritt mit Islandponys führt durch reizvolle Landschaften inmitten der Wildnis von Kuusamo.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6dd12c6b-8c11-3553-bcc8-ec1458d728e5",
                        "entry_id": "bb0fec19-72a4-3d89-9f73-01c5a1c141fd",
                        "glosses": [
                            "eine Disziplin beim Vielseitigkeitsreiten bzw. Military"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6e37622-bf3e-4804-a969-e2c97bcf12c1",
                                "sense_id": "6dd12c6b-8c11-3553-bcc8-ec1458d728e5",
                                "text": "„Im Geländeritt wurde die Obingerin Zehnte, nach einem fehlerfreien Springen belegte sie den 6. Platz – punktgleich (31,20) mit ihrer Teamkollegin Melina Rytir, die aber nach einer Nullrunde im Geländeritt auch im Springparcours fehlerfrei blieb und sich so auf den 5. Rang schob.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
