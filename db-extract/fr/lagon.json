        "fr-extract.jsonl": [
            {
                "entry_id": "7711e6f4-8fa3-3ab0-b290-1a932fef90b1",
                "word": "lagon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "534a30e0-4b7b-405a-b62b-f1c2076d5ee0",
                        "entry_id": "7711e6f4-8fa3-3ab0-b290-1a932fef90b1",
                        "tags": [
                            "plural"
                        ],
                        "form": "lagons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f393aefa-6e90-30c3-a962-8940c708992c",
                        "entry_id": "7711e6f4-8fa3-3ab0-b290-1a932fef90b1",
                        "glosses": [
                            "Étendue d’eau à l’intérieur d’un atoll."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1f31eff-62f8-425f-b94a-bfeeeea671ef",
                                "sense_id": "f393aefa-6e90-30c3-a962-8940c708992c",
                                "text": "Par contraste, le côté du lagon était étrangement calme, une eau merveilleusement tranquille, à peine ridée par les alizés, où passaient des poissons aux couleurs éblouissantes."
                            },
                            {
                                "example_id": "c5c67841-7dee-4142-94ab-65de1ee3180d",
                                "sense_id": "f393aefa-6e90-30c3-a962-8940c708992c",
                                "text": "La route est impraticable, l'eau du robinet terreuse, les draps de lit trempés, les habits champignonneux. Le lagon, habituellement bleu-vert transparent, devient marron à force de réceptionner la terre qui s'y déverse."
                            },
                            {
                                "example_id": "811ae437-3996-4dfc-b9d0-950937dd9b13",
                                "sense_id": "f393aefa-6e90-30c3-a962-8940c708992c",
                                "text": "De plus, une étude menée sur trois types de sites, un lagon, une baie semi-fermée et la mer ouverte, montre que si l’impact est mesurable en baie fermée, ce qui implique un suivi de l’enrichissement en matière organique et un contrôle de la biomasse en élevage, il est faible en baie semi-ouverte et tout juste décelable en mer ouverte seulement par la concentration en ammoniaque à proximité immédiate du train de cages."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c9aa2b3-4b15-422d-a226-62a2e3313f79",
                        "source_entry_id": "7711e6f4-8fa3-3ab0-b290-1a932fef90b1",
                        "source_sense_id": "f393aefa-6e90-30c3-a962-8940c708992c",
                        "target_lang_word": "Lagune",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lagune",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47e3df04-7ed5-3043-b9b1-68a367e996a2",
                                        "entry_id": "b33781d5-ee14-3f9a-8e0d-b87119dd315e",
                                        "glosses": [
                                            "vom Meer abgetrenntes Gewässer"
                                        ],
                                        "tags": [
                                            "Geographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fde60bf-b1d3-404b-99a4-6160475ca8fe",
                                                "sense_id": "47e3df04-7ed5-3043-b9b1-68a367e996a2",
                                                "text": "In der Lagune konnten die Fischer vor kleinen Stürmen sicher sein."
                                            },
                                            {
                                                "example_id": "7940a8fa-6002-4e5d-b272-7651725a66cd",
                                                "sense_id": "47e3df04-7ed5-3043-b9b1-68a367e996a2",
                                                "text": "„Oberhalb einer Lagune in einem Talkessel gelegen, scheint hier die Zeit stillzustehen.“"
                                            },
                                            {
                                                "example_id": "b7d0eb4e-579b-4aee-8279-27372184edd7",
                                                "sense_id": "47e3df04-7ed5-3043-b9b1-68a367e996a2",
                                                "text": "„Dann waren wir in der Lagune, die im Mondlicht dunkel und ruhig dalag.“"
                                            },
                                            {
                                                "example_id": "c246dca1-bc37-4f1d-b249-9ec8eff593bb",
                                                "sense_id": "47e3df04-7ed5-3043-b9b1-68a367e996a2",
                                                "text": "„Wir legten als Ziel die Pforte fest, die auf die Lagune führte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
