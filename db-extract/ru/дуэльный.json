                "senses": [
                    {
                        "sense_id": "a6c56b5b-8836-3c82-91f4-616cb003f03e",
                        "entry_id": "6ab7fe9f-f562-36c2-9b79-4c8e87c5b133",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным дуэль; свойственный, характерный для неё"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d167964b-2636-41f8-96a7-09d161161d15",
                                "sense_id": "a6c56b5b-8836-3c82-91f4-616cb003f03e",
                                "text": "Это может показаться странным, но дуэльный кодекс ограничивает действия поединщиков."
                            }
                        ]
                    },
                    {
                        "sense_id": "56472378-9e7a-35ab-86a6-d8e7cf391b6b",
                        "entry_id": "6ab7fe9f-f562-36c2-9b79-4c8e87c5b133",
                        "glosses": [
                            "предназначенный для дуэли"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db5d2158-03b5-476d-b2ae-052fa3a18bab",
                                "sense_id": "56472378-9e7a-35ab-86a6-d8e7cf391b6b",
                                "text": "Весь пол был залит кровью, дуэльный большой пистолет валялся в двух шагах…"
                            }
                        ]
                    }
