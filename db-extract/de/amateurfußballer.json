                "senses": [
                    {
                        "sense_id": "6d050f68-fa20-36b2-b709-40cc52c292f8",
                        "entry_id": "78ceced5-dbee-3a8f-8409-5c1082463a16",
                        "glosses": [
                            "Spieler, der den Sport Fußball nur als Hobby ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0ec5af-dc6b-418a-924c-2e14342c9a28",
                                "sense_id": "6d050f68-fa20-36b2-b709-40cc52c292f8",
                                "text": "„Er war achtunddreißig Jahre alt und einmal ein guter Amateurfußballer gewesen, aber das sah man ihm nicht mehr an, selbst in Freizeitkleidung nicht.“"
                            },
                            {
                                "example_id": "90a0d6a6-426c-4097-9c81-1a27bf118c30",
                                "sense_id": "6d050f68-fa20-36b2-b709-40cc52c292f8",
                                "text": "„Er war auch Amateurfußballer und an seiner Universität einmal Rekordhalter im Speerwerfen gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
