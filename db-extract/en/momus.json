                                        "entry_id": "09796c13-8fc1-30b9-b583-40fe3a2dccb3",
                                        "glosses": [
                                            ". Variante de Momos. Divinité de la raillerie, de la badinerie, du persiflage et des bons mots chez les Grecs."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1bd28ec-03cb-47d1-bd98-c26c6af20909",
                                                "sense_id": "b38a3215-2864-3e5f-b940-2baf97525802",
                                                "text": "Momus a pris pour adjoints\nDes rimeurs d’école ;\nDes chansons en quatre points\nLe froid nous désole."
                                            },
                                            {
                                                "example_id": "3d46277e-198a-46dd-b78d-3d5362fb82d5",
                                                "sense_id": "b38a3215-2864-3e5f-b940-2baf97525802",
                                                "text": "Et grave, il est beau à voir, à table, avec la bouteille, invoquant Comus et Momus, et entonnant sa chansonnette."
                                            }
                                        ]
                                    }
                                ]
