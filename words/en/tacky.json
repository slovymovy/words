                    "frequency": "Middle",
                    "semantic_group_id": "sticky",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not touch the freshly painted door because the surface is still slightly <w>tacky</w>."
                        },
                        {
                            "text": "Wait until the glue feels <w>tacky</w> before pressing the two pieces firmly together."
                        }
