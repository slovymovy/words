                ],
                "senses": [
                    {
                        "sense_id": "e6d98415-53af-31f6-80c2-9064a732dcb8",
                        "entry_id": "53bad5c1-e2b0-384c-87bc-6d59827fd8b2",
                        "glosses": [
                            "устар. то же, что печь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7214d9d4-698a-4474-bc6e-d758828aa9ff",
                                "sense_id": "e6d98415-53af-31f6-80c2-9064a732dcb8",
                                "text": "Ввержен в пещь огненную, яко три отроки. Взят от пещи и возложен на колесницу, яко Илия."
                            },
                            {
                                "example_id": "ae37c241-f60e-47a7-8901-40a1e2ba86f8",
                                "sense_id": "e6d98415-53af-31f6-80c2-9064a732dcb8",
                                "text": "Три отроки в пещи огненной в Вавилоне. Навходоносор глядит он, ано сын божий четвертой с ними! В пещи гуляют отроки, сам четверт, с богом!"
                            }
                        ]
                    }
