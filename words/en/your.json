                {
                    "sense_id": "705a83d8-6ea6-3879-93ab-0d14d02cc20c",
                    "sense_definition": "Used to refer to a specific person or thing, often one previously mentioned or understood in context.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Your</w> man at the shop said they were closed.",
                            "target_lang_translations": {
                                "ru": "<w>Тот</w> парень в магазине сказал, что они закрыты.",
                                "nl": "<w>Die</w> man van de winkel zei dat ze gesloten waren.",
                                "pl": "<w>Ten</w> facet w sklepie powiedział, że już zamknęli.",
                                "de": "<w>Der</w> Typ im Laden sagte, sie hätten geschlossen.",
                                "fr": "<w>Le</w> type du magasin a dit qu'ils étaient fermés.",
                                "it": "<w>Quel</w> tipo al negozio ha detto che erano chiusi.",
                                "cs": "<w>Ten</w> chlápek v obchodě říkal, že mají zavřeno.",
                                "tr": "Dükkandaki <w>şu</w> adam kapalı olduklarını söyledi.",
                                "es": "<w>Ese</w> tipo de la tienda dijo que estaban cerrados.",
                                "zh": "<w>那个</w>店员说他们已经关门了。"
                            }
                        },
                        {
                            "text": "I was talking to <w>your</w> one from the office yesterday.",
                            "target_lang_translations": {
                                "ru": "Я вчера разговаривал с <w>той</w> дамочкой из офиса.",
                                "nl": "Ik was gisteren aan het praten met <w>die</w> van het kantoor.",
                                "pl": "Rozmawiałem wczoraj z <w>tą</w> babką z biura.",
                                "de": "Ich habe gestern mit <w>der</w> einen aus dem Büro gesprochen.",
                                "fr": "Je parlais à <w>celle</w> du bureau hier.",
                                "it": "Ieri stavo parlando con <w>quella</w> dell'ufficio.",
                                "cs": "Včera jsem mluvil s <w>tou</w> ženskou z kanceláře.",
                                "tr": "Dün ofisteki <w>bizimkiyle</w> konuşuyordum.",
                                "es": "Ayer estuve hablando con <w>aquella</w> de la oficina.",
                                "zh": "我昨天和办公室里的<w>那位</w>聊了聊。"
