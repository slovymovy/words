                        "cross_references": [
                            {
                                "target_word": "Stützpunkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c03f1a28-cedc-30ed-874c-50dc3d2633ec",
                                        "entry_id": "1806252d-da40-3d68-a315-ce2571b923c7",
                                        "glosses": [
                                            "Stelle, die einem Druck standhält, auf der eine Last ruht"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e55b8ac4-071b-3920-8f6d-473681ec5809",
                                        "entry_id": "1806252d-da40-3d68-a315-ce2571b923c7",
                                        "glosses": [
                                            "Ort/Einrichtung, wo sich Hilfsgüter oder -mannschaften befinden und von dem aus man agieren kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28d73da0-9526-4cb8-8d5f-31463a9c38af",
                                                "sense_id": "e55b8ac4-071b-3920-8f6d-473681ec5809",
                                                "text": "„Er wurde am nächsten Tag auf den Friedhof des britischen Stützpunktes beerdigt.“"
                                            },
                                            {
                                                "example_id": "6bc39fd0-ff9a-482f-aeb3-91ae1bc6acc3",
                                                "sense_id": "e55b8ac4-071b-3920-8f6d-473681ec5809",
                                                "text": "„Geiserich besetzte Häfen, errichtete Stützpunkte und kassierte Tribute, ohne eine komplette Herrschaftsstruktur auf den Inseln zu errichten.“"
                                            },
                                            {
                                                "example_id": "59ec4b94-0900-4e9c-a9c4-65d712713407",
                                                "sense_id": "e55b8ac4-071b-3920-8f6d-473681ec5809",
                                                "text": "„Admiral Steven van der Haghen, unter dessen Kommando im Dezember 1603 die erste Flotte der VOC auslief, hatte den ausdrücklichen Auftrag, portugiesische Stützpunkte anzugreifen.“"
                                            },
                                            {
                                                "example_id": "13b53356-c902-43c3-a042-753240710bdc",
                                                "sense_id": "e55b8ac4-071b-3920-8f6d-473681ec5809",
                                                "text": "„Für die Siedler und Besatzungstruppen in den Stützpunkten entsteht eine bedrohliche Lage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
