                                            {
                                                "example_id": "6089dbfe-a142-4f64-87e5-6d153a00a3e1",
                                                "sense_id": "0aafd262-0f1d-3ca7-bc9e-6c7be9e633e6",
                                                "text": "His helping the old woman with her shopping was deemed highly altruistic by everyone, especially since her home was a mile away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1406779f-a589-4ac3-850f-19f88d4abf7b",
                        "source_entry_id": "c072f5df-1280-33a6-b92c-631ce875fd64",
                        "source_sense_id": "89181a81-b356-3d2c-9376-4333473a1b2f",
                        "target_lang_word": "unselfish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unselfish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a957c02-b264-372f-8502-aee0b9f181b1",
                                        "entry_id": "71146e2e-f367-3f08-a260-9555e6f7ebbc",
                                        "glosses": [
                                            "Not selfish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bddd73f-7581-402a-9062-19bbf81a5203",
                                                "sense_id": "7a957c02-b264-372f-8502-aee0b9f181b1",
                                                "text": "The man was in an unselfish mood that day, so decided to give a £20 note to the next charity he came across."
                                            },
                                            {
                                                "example_id": "59e2e92f-e092-42e2-a3b3-3b2bb31f442b",
                                                "sense_id": "7a957c02-b264-372f-8502-aee0b9f181b1",
                                                "text": "There was certainly no harm in his travelling sixteen miles twice over on such an errand; but there was an air of foppery and nonsense in it which she could not approve. It did not accord with the rationality of plan, the moderation in expense, or even the unselfish warmth of heart, which she had believed herself to discern in him yesterday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fab4ad4-d69a-49ec-8a3c-9c304b751cc1",
                        "source_entry_id": "c072f5df-1280-33a6-b92c-631ce875fd64",
                        "source_sense_id": "89181a81-b356-3d2c-9376-4333473a1b2f",
                        "target_lang_word": "altruísta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altruísta",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d1b080a9-a4a7-3b5b-97f0-1c00e015b93e",
                                        "entry_id": "e48118d6-0b8a-39d6-a225-337753fc09eb",
                                        "glosses": [
                                            "Que profesa el altruismo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa515b0b-edad-4f41-9b36-7c36c731c4e2",
                                                "sense_id": "d1b080a9-a4a7-3b5b-97f0-1c00e015b93e",
                                                "text": "«En las grandes capitales, como se vive al día y como las angustias de uno son las angustias de todos, hay cierta humanitaria comunicación, cierto desprendimiento altruista, que en el fondo es un avance para obligar a reciprocidad futura»."
                                            },
                                            {
                                                "example_id": "f1008e45-7823-46c2-824d-f5fd05329031",
                                                "sense_id": "d1b080a9-a4a7-3b5b-97f0-1c00e015b93e",
                                                "text": "«—Un sincero altruista como tú sabes; el bien de nuestros semejantes es nuestro bien»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d3e0c68-95a6-4285-9620-2290cab2ff03",
                        "source_entry_id": "c072f5df-1280-33a6-b92c-631ce875fd64",
                        "source_sense_id": "89181a81-b356-3d2c-9376-4333473a1b2f",
                        "target_lang_word": "altruistico",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altruistico",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "14963e96-4d80-31d4-9ff4-631fa5733607",
                                        "entry_id": "0e9c3c87-8170-3013-b762-3a6c9e8c9dc8",
                                        "glosses": [
                                            "che partecipa ai problemi del prossimo mosso da altruismo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c8fe13b-d6bf-42b7-a13d-85d68acf1f6d",
                                                "sense_id": "14963e96-4d80-31d4-9ff4-631fa5733607",
                                                "text": "è stato un gesto altruistico il tuo"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8baff69e-ad7c-4533-87bf-ad5c2ffdf8b7",
                        "source_entry_id": "c072f5df-1280-33a6-b92c-631ce875fd64",
                        "source_sense_id": "89181a81-b356-3d2c-9376-4333473a1b2f",
                        "target_lang_word": "altruistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altruistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1110e00-0ae3-32d5-a4c0-c4f2bd05bbe7",
                                        "entry_id": "303e552e-b790-3f34-a377-13545fc64871",
                                        "glosses": [
                                            "gehoben: auf dem Altruismus beruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3204db0-f5ff-4a0f-8d25-9d8f354cbde1",
                                                "sense_id": "b1110e00-0ae3-32d5-a4c0-c4f2bd05bbe7",
                                                "text": "„So konnten sie offensichtlich eigennützige Feldzüge als altruistische Missionen tarnen, die dazu dienten, wilde Barbaren zu zivilisieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c434802-f113-47f9-b4b7-cfcbd5f4026b",
                        "source_entry_id": "c072f5df-1280-33a6-b92c-631ce875fd64",
                        "source_sense_id": "89181a81-b356-3d2c-9376-4333473a1b2f",
                        "target_lang_word": "selbstlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "selbstlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9db6b584-45f4-31c8-ab46-9e5d515ed889",
                                        "entry_id": "0635e8ea-fa32-327e-a086-fe1acece83d7",
                                        "glosses": [
                                            "das Wohlergehen anderer über das eigene stellend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48f6c68c-5cab-4444-b2a7-16a42e6ce33f",
                                                "sense_id": "9db6b584-45f4-31c8-ab46-9e5d515ed889",
                                                "text": "Mit selbstloser Entschlossenheit sprang er ins kalte Wasser, um den Ertrinkenden zu retten."
                                            },
                                            {
                                                "example_id": "770afd0c-1e3e-4f4a-8d46-ba18e2d98417",
                                                "sense_id": "9db6b584-45f4-31c8-ab46-9e5d515ed889",
                                                "text": "„In der selbstlosen und opferfreudigen Liebe eines Tieres ist etwas, das jedem tief zu Herzen gehen muß, der je Gelegenheit hatte, die armselige ›Freundschaft‹ und geschwätzige Treue des ›erhabenen‹ Menschen zu erproben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82c0c4b4-5d4d-40df-b35b-87b5f151b080",
                        "source_entry_id": "c072f5df-1280-33a6-b92c-631ce875fd64",
                        "source_sense_id": "89181a81-b356-3d2c-9376-4333473a1b2f",
                        "target_lang_word": "altruiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altruiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "918f8c2b-faf9-3be5-83aa-4750618f0ceb",
                                        "entry_id": "ab8a3c2f-9309-30b8-9393-9490afe203e2",
                                        "glosses": [
                                            "Qui manifeste de l’altruisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d26a7f81-8453-4a99-978d-880b2fc8bf49",
                                                "sense_id": "918f8c2b-faf9-3be5-83aa-4750618f0ceb",
                                                "text": "Un comportement altruiste, dirigé vers les organismes apparentés, aura toutes les chances de favoriser la propagation des gènes de lʼindividu qui adopte ce comportement."
                                            },
                                            {
                                                "example_id": "7734d72f-9688-4488-9b67-17f89caed901",
                                                "sense_id": "918f8c2b-faf9-3be5-83aa-4750618f0ceb",
                                                "text": "Débusquer les bases biologiques d’un comportement n’enlève rien à l’humanisme du geste ni au libre arbitre : nous demeurons toujours libres de choisir entre un geste altruiste ou égoïste."
                                            },
                                            {
                                                "example_id": "3997ea35-9592-40dd-ac89-a711bdd7cd86",
                                                "sense_id": "918f8c2b-faf9-3be5-83aa-4750618f0ceb",
                                                "text": "De plus, pour Monroe, un acte ne peut être considéré comme altruiste s’il ne comporte pas un risque et n'a aucun « coût », réel ou potentiel, pour celui qui le commet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "altruiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5cc48970-2428-37d3-8e36-dc85c3ceac5a",
                                        "entry_id": "81c8e141-b746-30b6-ab93-ccaca584dae8",
                                        "glosses": [
                                            "Celui, celle qui pratique l’altruisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93eca202-0473-48e2-a3da-659d65b3458c",
                                                "sense_id": "5cc48970-2428-37d3-8e36-dc85c3ceac5a",
                                                "text": "Le médecin apparaît à chacun comme un altruiste professionnel qui ne saurait être considéré avec la même rigueur et les mêmes règles que le criminel nuisible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
