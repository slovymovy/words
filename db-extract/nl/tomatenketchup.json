        "nl-extract.jsonl": [
            {
                "entry_id": "9de716fb-b7f7-3109-a8cb-2e2b8481e1ed",
                "word": "tomatenketchup",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "71c1a669-d800-3f01-a814-b454276cf55a",
                        "entry_id": "9de716fb-b7f7-3109-a8cb-2e2b8481e1ed",
                        "glosses": [
                            "pittige tomatensaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59019e51-e829-4b13-bf43-77635131b235",
                                "sense_id": "71c1a669-d800-3f01-a814-b454276cf55a",
                                "text": "De combinatie van aanwezige voedingsstoffen in tomatenketchup kan de ontwikkeling en verergering van hart- en vaatziekten voorkomen. Dat blijkt uit onderzoek van de Universiteit Maastricht.\nHet onderzoek toont aan dat de combinatie van de antioxidanten lycopeen, vitamine C en E in tomaten en tomatenketchup een sterker beschermend effect heeft dan de individuele antioxidanten apart."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bacfc8c-5b43-4661-afca-8d1b4f66b76b",
                        "source_entry_id": "9de716fb-b7f7-3109-a8cb-2e2b8481e1ed",
                        "source_sense_id": "71c1a669-d800-3f01-a814-b454276cf55a",
                        "target_lang_word": "Ketchup",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ketchup",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60a58b1f-476f-36ad-abd0-f8196259873e",
                                        "entry_id": "cbdda6af-bdb7-35fc-883a-ce2ae7fba31c",
                                        "glosses": [
                                            "Würzsoße mit den Grundbestandteilen Essig, Zucker und Tomaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fe80211-07d3-4e60-aa88-260ec63773b1",
                                                "sense_id": "60a58b1f-476f-36ad-abd0-f8196259873e",
                                                "text": "Mit Ketchup kann man sich leicht bekleckern."
                                            },
                                            {
                                                "example_id": "53e94359-8ad5-4f34-b8f1-13e2b1598d13",
                                                "sense_id": "60a58b1f-476f-36ad-abd0-f8196259873e",
                                                "text": "„Eine halbe Stunde später biss ich beherzt in einen Doppelwhopper, und Ketchup und Mayonnaise sammelten sich in meinem zotteligen Vagabundenbart“"
                                            },
                                            {
                                                "example_id": "19a56bb2-6f72-4867-973b-07a9d6e6fe1f",
                                                "sense_id": "60a58b1f-476f-36ad-abd0-f8196259873e",
                                                "text": "„Als die Shrimps gar waren, schöpften sie sie mit der Kelle aus dem Kochkessel und legten sie auf Zeitungspapier, schälten sie dann mit der Hand und stippten sie in die mit Worcestershire und Ketchup angemachte Soße.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1184a3d8-3436-493a-b4d6-dbf107349c20",
                        "source_entry_id": "9de716fb-b7f7-3109-a8cb-2e2b8481e1ed",
                        "source_sense_id": "71c1a669-d800-3f01-a814-b454276cf55a",
                        "target_lang_word": "ketchup",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ketchup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d372709f-701d-390a-8641-a9999434c918",
                                        "entry_id": "2b2fb174-da58-347b-93f3-08963263d14c",
                                        "glosses": [
                                            "Ellipsis of tomato ketchup (“a tomato-vinegar-based sauce, sometimes containing spices, onion or garlic, and (especially in the US) sweeteners”)."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "UK",
                                            "US",
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70f6ab70-e998-46b4-a5ce-4cc0fc5a43d1",
                                                "sense_id": "d372709f-701d-390a-8641-a9999434c918",
                                                "text": "tomato ketchup"
                                            },
                                            {
                                                "example_id": "c4e151bb-8c98-43d3-82f6-38bb7be597d6",
                                                "sense_id": "d372709f-701d-390a-8641-a9999434c918",
                                                "text": "This diner serves ketchup in red bottles, and mustard in yellow ones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af09e562-5eca-3bcf-871c-192e5c714616",
                                        "entry_id": "2b2fb174-da58-347b-93f3-08963263d14c",
                                        "glosses": [
                                            "Such a sauce more generally (not necessarily based on tomatoes, but with mushrooms, fish, etc.). This is the older meaning."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a66ec8b1-baba-4c93-9f63-eb03b5b8df00",
                                                "sense_id": "af09e562-5eca-3bcf-871c-192e5c714616",
                                                "text": "The bottles, however, were port bottles, but contained mushroom ketchup; […]"
                                            },
                                            {
                                                "example_id": "5cc8c4a8-af63-4b86-a98a-95a3d2aec62b",
                                                "sense_id": "af09e562-5eca-3bcf-871c-192e5c714616",
                                                "text": "To accompany meat, we prepare fruit ketchups and rhubarb chutney."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ketchup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81b0703e-69d3-33b1-9878-2c69cd4a459d",
                                        "entry_id": "0f5b85b4-feb5-38a2-9d51-8335fb790d00",
                                        "glosses": [
                                            "To cover with ketchup."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b71bc38-9160-4487-9dbe-5b54db996c50",
                                                "sense_id": "81b0703e-69d3-33b1-9878-2c69cd4a459d",
                                                "text": "It strikes me she's \"ketchupped\" the lot! I won't touch a morsel!"
                                            },
                                            {
                                                "example_id": "9f649b96-fea7-4bca-b128-b9407389f58c",
                                                "sense_id": "81b0703e-69d3-33b1-9878-2c69cd4a459d",
                                                "text": "\"Well,\" said Chuck, ketchupping his hamburger, \"I'd rather do without King Lear than put up with the human agony it sprang out of. I'd rather not have the Eroica than have the big bloody conqueror it tries to immortalize.\""
                                            },
                                            {
                                                "example_id": "7dcd7cff-3aff-47aa-a42f-a3fe24cfbe21",
                                                "sense_id": "81b0703e-69d3-33b1-9878-2c69cd4a459d",
                                                "text": "Their fellow diners, like their ketchupped grub, were appropriately dashed and splattered with paint and plaster, reading their Suns and Daily Mirror."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c11726be-2310-4b6b-8ca0-215beaa9845d",
                        "source_entry_id": "9de716fb-b7f7-3109-a8cb-2e2b8481e1ed",
                        "source_sense_id": "71c1a669-d800-3f01-a814-b454276cf55a",
                        "target_lang_word": "ketchup",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ketchup",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69e438c8-a677-30fb-83a3-a27709c9c2db",
                                        "entry_id": "3d2d7553-bf7d-300a-b58b-95d27d32475c",
                                        "glosses": [
                                            "Sauce sucrée à la tomate."
                                        ],
                                        "tags": [
                                            "Sauces"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "384dddd3-a3f2-4dbe-a65b-65159b8916af",
                                                "sense_id": "69e438c8-a677-30fb-83a3-a27709c9c2db",
                                                "text": "Bébé déchira le sachet de ketchup avec les dents."
                                            },
                                            {
                                                "example_id": "4bf2fc87-339b-4c86-88ac-a6898e640889",
                                                "sense_id": "69e438c8-a677-30fb-83a3-a27709c9c2db",
                                                "text": "Des frites, c'est bon; avec du ketchup, c'est meilleur."
                                            },
                                            {
                                                "example_id": "304161eb-1c0b-4125-aef4-963125374801",
                                                "sense_id": "69e438c8-a677-30fb-83a3-a27709c9c2db",
                                                "text": "Ils prirent possession du chalet et elle descendit au village les approvisionner en junk-food à prix d'or : frites au four, nuggets surgelés, glaces, sauces samouraï, ketchup et mayonnaise."
                                            },
                                            {
                                                "example_id": "a041287a-f48f-4c9f-9469-c2a37559e5b9",
                                                "sense_id": "69e438c8-a677-30fb-83a3-a27709c9c2db",
                                                "text": "Ajouter les tomates, le romarin, le sucre, le ketchup, les câpres, le vinaigre, verser la passata, saler et poivrer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
