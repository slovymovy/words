                    {
                        "sense_id": "48a2361f-817e-31bf-afee-3edcd8047090",
                        "entry_id": "45dfb692-5000-3c4b-8ac0-d1e4c74b9d08",
                        "glosses": [
                            "welriekend olieachtig smeersel, gebruikt bij plechtigheden"
                        ],
                        "tags": [],
