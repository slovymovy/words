                                        "glosses": [
                                            "zasłaniający prawie całe ciało poza twarzą, tradycyjny strój noszony przez kobiety głównie w Iranie, którego noszenie jest jedną z form przestrzegania hidżabu"
                                        ],
                                        "tags": [],
