                                "sense_id": "b30f428a-aae4-375a-afb6-6b208eb6dfec",
                                "text": "„Ein anderer verlassener Hotelkomplex war unter dem Namen Hyatt-Slums bekannt.“"
                            },
                            {
                                "example_id": "207a907a-b74f-4e2a-a9fe-9f0934e5654a",
                                "sense_id": "b30f428a-aae4-375a-afb6-6b208eb6dfec",
                                "text": "„Den Hotelkomplex kannte ich seit langem.“"
                            }
