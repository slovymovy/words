                ],
                "senses": [
                    {
                        "sense_id": "f46153b0-fc9f-32a8-822d-663ee5b2adcb",
                        "entry_id": "6ede7672-c411-329c-8ec0-6c6706f93cd6",
                        "glosses": [
                            "Eigenschaft, mit vier anderen Atomen eine chemische Bindung eingehen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bb419e3-813d-4311-8df3-048b05cc6315",
                                "sense_id": "f46153b0-fc9f-32a8-822d-663ee5b2adcb",
                                "text": "„Dabei wird deutlich, dass C-12 keineswegs über eine Vierwertigkeit verfügt, nur weil es sich in der vierten Hauptgruppe befindet.“"
                            },
                            {
                                "example_id": "3a0592e5-48d6-48d8-8d4a-c03ba854c0a6",
                                "sense_id": "f46153b0-fc9f-32a8-822d-663ee5b2adcb",
                                "text": "„Diesen Körper mit der Vierwertigkeit des Kohlenstoffatoms bei seinen wenigen Wasserstoffatomen in Einklang bringen zu wollen, schien fast aussichtslos.“"
                            },
                            {
                                "example_id": "6d2a7f97-c4e0-40a4-9ba6-d617926f28d6",
                                "sense_id": "f46153b0-fc9f-32a8-822d-663ee5b2adcb",
                                "text": "„Was nun dem Kohlenstoff außer seiner Vierwertigkeit ermöglicht ganz unzählige chemische Verbindungen zu geben, besteht weiter im Folgenden.“"
                            },
                            {
                                "example_id": "c9fc63c0-6f0e-4a63-961c-2d6aaeba95d0",
                                "sense_id": "f46153b0-fc9f-32a8-822d-663ee5b2adcb",
                                "text": "„Die Mannigfaltigkeit dieser Gemenge hat ihre Grundursache in der Vierwertigkeit des Kohlenstoffes und in seiner Fähigkeit, sich nach seiner Verbindung mit drei Wasserstoffatomen mit sich selbst zu verbinden.“"
                            },
                            {
                                "example_id": "0b1801cd-c31e-4bd2-8d79-998a5313b216",
                                "sense_id": "f46153b0-fc9f-32a8-822d-663ee5b2adcb",
                                "text": "„Die Valenzstrich-Strukturformel läßt klar die Vierwertigkeit des Kohlenstoffs erkennen.“"
                            },
                            {
                                "example_id": "89efbfb1-61f6-4001-859f-b4e235212352",
                                "sense_id": "f46153b0-fc9f-32a8-822d-663ee5b2adcb",
                                "text": "„Oben: Die beiden Grenzstrukturen und unten der mesomere Zwischenzustand mit der trans-Stellung der Peptidbindung (braun) C-N-Bindung verschoben, um die Vierwertigkeit des Kohlenstoffes wiederherzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
