                "senses": [
                    {
                        "sense_id": "0d2401a8-b312-3216-92eb-00ea04971c53",
                        "entry_id": "f2192981-044f-367d-b89d-9fdf86dd13b2",
                        "glosses": [
                            "Rechnung über die Kosten für ärztliche Behandlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c45b9c6-b45c-4c83-8bc8-3f0f8069f173",
                                "sense_id": "0d2401a8-b312-3216-92eb-00ea04971c53",
                                "text": "„Insbesondere Kunden über 40 müssten häufiger als noch vor einigen Jahren damit rechnen, dass ihr Anbieter die Arztrechnung nicht vollständig übernimmt - zu Unrecht wohlgemerkt.“"
                            },
                            {
                                "example_id": "d45879a7-f4f5-4fbe-94e5-a4f19dd63f53",
                                "sense_id": "0d2401a8-b312-3216-92eb-00ea04971c53",
                                "text": "„Wer nach überstandener Operation oder Krankheit eine Arztrechnung in der Hand hält, ist meist verwirrt.“"
                            },
                            {
                                "example_id": "0f12b99a-7f8a-4fdb-8bbb-df98d33fa182",
                                "sense_id": "0d2401a8-b312-3216-92eb-00ea04971c53",
                                "text": "„Wegen der Arztrechnungen und anderen schlimmen Nackenschlägen waren die Weichs völlig verarmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
