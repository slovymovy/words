            "senses": [
                {
                    "sense_id": "abb25e43-4b41-3b62-b2e1-fe3fc48f25c6",
                    "sense_definition": "Pousser son cri naturel, en parlant des bovidés.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cri_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le pré voisin, les vaches <w>beuglent</w> dès l'aube pour réclamer leur nourriture."
                        },
                        {
                            "text": "Le jeune veau égaré <w>beuglait</w> tristement à la recherche de sa mère dans l'étable."
                        }
                    ],
                    "synonyms": [
                        "meugler",
                        "mugir"
                    ]
                },
                {
                    "sense_id": "12f176be-cfd7-3df9-8021-72dd231bffaf",
                    "sense_definition": "Crier très fort ou hurler d'une manière bruyante et désagréable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "crier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrête de <w>beugler</w> de cette façon, les voisins vont finir par appeler la police !"
                        },
                        {
                            "text": "Les supporters en liesse <w>beuglaient</w> à tue-tête dans les rues après le match."
                        }
                    ],
                    "common_phrases": [
