                    "sense_definition": "Qui a pour but ou pour effet d'élever le niveau moral ou d'améliorer les mœurs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "moral_education",
                    "name_type": "no",
                    "examples": [
