                        "entry_id": "b6cb0dd9-2e37-3229-9ec8-ce83c34220de",
                        "glosses": [
                            "A mask wearer, e.g. a masquerader or a person wearing a surgical mask."
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "b3b70fc2-a5de-41c3-afb7-9197c463b002",
                                "sense_id": "de0b8add-980e-3389-9e73-e37cb90936b0",
                                "text": "2000, Alfred Schäfer, \"Die Maske und ihr Träger im Egungung-Geheimbund\", in Alfred Schäfer, Michael Wimmer (eds.), Masken und Maskierungen, Springer-Verlag (publ.), page 83.\nDies kann sie aber nur sein, wenn die Differenz von Maskenträger und Maske nicht in unserem Verständnis gedacht wird: als ein äußeres Verhältnis, in dem der Maskenträger eine Rolle spielt.",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "078865c0-22b7-4afa-a307-5f2dd5aa42d1",
                                "sense_id": "de0b8add-980e-3389-9e73-e37cb90936b0",
                                "text": "Wir wollen wissen: Was denken gewohnte Maskenträger über die aktuelle Diskussion?",
                                "translation": "We want to know: What do accustomed wearers of surgical masks think about the current discussion?",
                                "english": "We want to know: What do accustomed wearers of surgical masks think about the current discussion?"
                            }
                        ]
