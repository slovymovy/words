                "senses": [
                    {
                        "sense_id": "94694621-bcc5-3718-a7e8-e29fb7a0a78e",
                        "entry_id": "b026608d-182c-3b05-96a3-e64394ccd0be",
                        "glosses": [
                            "ein Grammatiktyp aus der strukturellen Linguistik, bei dem die Abhängigkeiten zwischen den Wörtern und Wortgruppen innerhalb des Satzes herausgearbeitet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7053188-7920-4fdd-8fc4-72bd4d0fdd6f",
                                "sense_id": "94694621-bcc5-3718-a7e8-e29fb7a0a78e",
                                "text": "Die Abhängigkeitsgrammatik ist einer unter vielen verschiedenen Ansätzen, Grammatiken zu verfassen."
                            },
                            {
                                "example_id": "77574b2a-2a35-42e1-ab8e-6a0ffc051663",
                                "sense_id": "94694621-bcc5-3718-a7e8-e29fb7a0a78e",
                                "text": "Abhängigkeitsgrammatiken kann man für alle Sprachen verfassen."
                            },
                            {
                                "example_id": "aee99423-b6db-4ef4-9360-6f7d8e39588f",
                                "sense_id": "94694621-bcc5-3718-a7e8-e29fb7a0a78e",
                                "text": "Zur Darstellung eines Satzes in Form eines Strukturbaums: „Seine Struktur kann nach der Abhängigkeitsgrammatik folgendermaßen dargestellt werden…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
