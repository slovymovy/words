            {
                "entry_id": "273a39ae-0063-358b-837d-8269830cdcd0",
                "word": "Niagara",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "39046f76-802b-4fb6-81bd-66b62efc193c",
                        "entry_id": "273a39ae-0063-358b-837d-8269830cdcd0",
                        "tags": [
                            "plural"
                        ],
                        "form": "Niagaras"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4010aa87-3ce6-312c-8ced-2dfca2178100",
                        "entry_id": "273a39ae-0063-358b-837d-8269830cdcd0",
                        "glosses": [
                            "A flood, torrent, or outpouring, especially one of massive proportions."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6271737b-b09d-4345-a24a-704fc753349e",
                                "sense_id": "4010aa87-3ce6-312c-8ced-2dfca2178100",
                                "text": "[A] veritable Niagara of loose flesh when her stays are unlaced."
                            },
                            {
                                "example_id": "863ac531-2480-4a3f-8e3d-8bdb375f4112",
                                "sense_id": "4010aa87-3ce6-312c-8ced-2dfca2178100",
                                "text": "\"We're gaining,\" said Mr. Hoopdriver, with a little Niagara of perspiration dropping from brow to cheek."
                            },
                            {
                                "example_id": "d137710b-110f-424a-b2b8-fb6f40ca2bf0",
                                "sense_id": "4010aa87-3ce6-312c-8ced-2dfca2178100",
                                "text": "It was useless to try and drown that Niagara of sound."
                            },
                            {
                                "example_id": "cbd6873c-f8f6-435c-b047-3f88198e9f21",
                                "sense_id": "4010aa87-3ce6-312c-8ced-2dfca2178100",
                                "text": "A great torrent of water was flung along the boiler and came streaming over the cab roof like a young Niagara."
                            }
                        ]
                    },
                    {
                        "sense_id": "41d3a379-0c8c-3df7-83ba-a2437dea5883",
                        "entry_id": "273a39ae-0063-358b-837d-8269830cdcd0",
                        "glosses": [
                            "A Niagara grape."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56cb0f1e-3c70-47ca-bcb9-88f5b3a31b5e",
                                "sense_id": "41d3a379-0c8c-3df7-83ba-a2437dea5883",
                                "text": "The basic material for sherry is a mixture or a blend of dry wines from Niagaras, Delawares, and Catawbas or other white juices, which are sweetened and fortified and then blended with California sherry."
                            },
                            {
                                "example_id": "00108e87-ef04-4a07-9b8c-9e01c5b562c9",
                                "sense_id": "41d3a379-0c8c-3df7-83ba-a2437dea5883",
                                "text": "During the past 25 years, New York wineries have moved away from Niagaras and Delawares and begun producing world-class wines from European grapes and specially cultured hybrids and varietals."
                            }
                        ]
                    }
                ],
