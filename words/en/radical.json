                    "common_phrases": [
                        "Chinese radical",
                        "character radical"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компонент китайского иероглифа, используемый для поиска в словаре и часто указывающий на общее значение.",
                        "zh": "汉字中用于字典索引并常表示字义的组成部分。"
                    },
                    "translations": {
