                        "entry_id": "d64602b3-d1a2-37d0-9146-7692af843fcd",
                        "glosses": [
                            "A small, dry, indehiscent fruit, containing a single seed, as in the buttercup."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb5913e0-ab27-4094-bcac-9ff135cdacad",
                                "sense_id": "ac146059-d267-3d1e-8f1a-2c8108965646",
                                "text": "The mulberry puts forth its messy clusters of achenes."
                            }
                        ]
                    }
                ],
