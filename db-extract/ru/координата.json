                                                "sense_id": "3e75468f-623d-32c8-b50d-ccd6590006a8",
                                                "text": "Der Pilot fand die Landebahn nicht, da die Koordinaten falsch waren."
                                            },
                                            {
                                                "example_id": "014dec8d-6bdb-4953-b796-8e6d5619fca6",
                                                "sense_id": "3e75468f-623d-32c8-b50d-ccd6590006a8",
                                                "text": "„Der Pilot der Maschine meldete sich. Carlos gab Koordinaten an ihn durch.“"
                                            },
                                            {
                                                "example_id": "a6f1cf17-1ea5-4bf7-9686-c31a4e99c68e",
                                                "sense_id": "3e75468f-623d-32c8-b50d-ccd6590006a8",
                                                "text": "„Ich konnte nicht glauben, das Amalias Koordinaten uns hierher geführt hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
