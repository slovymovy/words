                "entry_id": "7504b677-093e-3ca6-abdb-d238e0c82fb1",
                "word": "matigheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1e3ef577-c2cb-3d53-8eb4-8322425e5b4e",
                        "entry_id": "7504b677-093e-3ca6-abdb-d238e0c82fb1",
                        "glosses": [
                            "van een persoon dat deze niet teveel eet en drinkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ba02990-370d-42a2-8ee0-db3e32d8b2f8",
                                "sense_id": "1e3ef577-c2cb-3d53-8eb4-8322425e5b4e",
                                "text": "Hij kijkt om zich heen naar de mossen en asymmetrisch geplante lage varens. ` Wat me verbaast is dat een volk dat toch meent rechtstreeks van de goden af te stammen zo opzichtig matigheid nastreeft.'"
                            },
                            {
                                "example_id": "8b93f8ac-47fc-4684-8bd0-366d0012f169",
                                "sense_id": "1e3ef577-c2cb-3d53-8eb4-8322425e5b4e",
                                "text": "Zo kwam het dat Rob langzaam maar zeker zijn voorgenomen matigheid uit het oog verloor en hij avond aan avond van De Vos naar het huis aan Thames Street wankelde om zich door Mary als een onbeholpen kleuter naar bed te laten helpen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffe45675-bb0c-4bfb-b112-9630fb76e358",
                        "source_entry_id": "7504b677-093e-3ca6-abdb-d238e0c82fb1",
                        "source_sense_id": "1e3ef577-c2cb-3d53-8eb4-8322425e5b4e",
                        "source_sense_description": "van een persoon dat deze niet teveel eet en drinkt",
                        "target_lang_word": "moderation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moderation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
                                        "glosses": [
                                            "The state or quality of being moderate; avoidance of extremes"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e84038c-44ec-47a2-9498-458216a68410",
                                                "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                                "text": "...It regulates and governs the Passions of the Mind, and brings them into due moderation and frame..."
                                            },
                                            {
                                                "example_id": "cf777ed3-3f6a-4215-8e1e-a80ac10c3a07",
                                                "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                                "text": "Mr. Chairman, at this moment I stand astonished at my own moderation!"
                                            },
                                            {
                                                "example_id": "40214534-ff55-4198-a690-1a7a9bf298bf",
                                                "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                                "text": "America is a model of force and freedom and moderation - with all the coarseness and rudeness of its people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11042b05-a7f9-30bf-aaa5-2b2a147eb1f5",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
                                        "glosses": [
                                            "An instance of moderating: bringing something away from extremes, especially in a beneficial way"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5efccf78-2695-490f-b209-5367c2697431",
                                                "sense_id": "11042b05-a7f9-30bf-aaa5-2b2a147eb1f5",
                                                "text": "With the quick moderation of the weather some buying has appeared that had been held up because of the extremely cold weather […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c5b6379-0011-365e-b209-54d98c81ca0e",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
                                        "glosses": [
                                            "The process of moderating a discussion"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77f2d0ca-9554-4a71-b60c-ee7bc00de59e",
                                                "sense_id": "2c5b6379-0011-365e-b209-54d98c81ca0e",
                                                "text": "The moderation of a large online forum can be hard work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4ad9a2e-3e3f-3967-b4a0-c1549114c8af",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
