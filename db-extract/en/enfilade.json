                        "source_sense_description": "passage",
                        "target_lang_word": "Straßenzug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Straßenzug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff391202-b493-37b0-823f-676f0af28276",
                                        "entry_id": "7d50be6e-025c-31cb-90c4-cbfedd1b7442",
                                        "glosses": [
                                            "sich hinziehende, fortlaufende Straße/Straßenfolge mit Häuserbebauung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79f672b3-84fc-4c0c-a419-b441c5bc654e",
                                                "sense_id": "ff391202-b493-37b0-823f-676f0af28276",
                                                "text": "„Die Straßenzüge tragen dem modernen Autoverkehr weitgehendst Rechnung, sodaß selbst die Postdirektionen allerorts ständige Kraftpostlinien einlegen konnten; die neuen Straßenzüge sind größtenteils staubfrei angelegt.“"
                                            },
                                            {
                                                "example_id": "f2db4cb3-a94b-48e3-a72d-6555856f27e3",
                                                "sense_id": "ff391202-b493-37b0-823f-676f0af28276",
                                                "text": "„Ihre Patrouillen terrorisierten dort ganze Straßenzüge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "830f82a1-aa2f-4f2c-89d2-b550f6a8be07",
                        "source_entry_id": "e404e4ea-a275-39e7-84db-a7d786634b4e",
                        "source_sense_description": "passage",
                        "target_lang_word": "Häuserflucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Häuserflucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba83ae85-2f0b-3cff-825f-3ac82e86cc05",
                                        "entry_id": "e7d1b860-909e-39fb-a44d-c50205f53d03",
                                        "glosses": [
                                            "gerade Linie entlang der Kante mehrerer Häuser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d47062c9-ce35-41c3-830d-8d3a6800d262",
                                                "sense_id": "ba83ae85-2f0b-3cff-825f-3ac82e86cc05",
                                                "text": "„Die vernagelte Holztür fällt knarrend ins Schloss, der Blick gleitet entlang der Häuserflucht im Gründerzeitstil mit ihren naturfarbenen, beigen und braunroten Fassaden, Sandsteinsimsen, kleinen Balkonen und schmiedeeisernen Geländern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6e6d9a6-6e57-4b14-9727-032b030e98de",
                        "source_entry_id": "e404e4ea-a275-39e7-84db-a7d786634b4e",
                        "source_sense_description": "passage",
                        "target_lang_word": "Straßenzeile",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Straßenzeile",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d64b55c-3338-3ec6-b692-5d03851c746c",
                                        "entry_id": "38cb9bfc-c9de-3e83-8ff1-700a35d5d8df",
                                        "glosses": [
                                            "Straßenflucht zwischen Häuserzeilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21b3c0af-9bb9-4974-9801-5e34f4510cf0",
                                                "sense_id": "1d64b55c-3338-3ec6-b692-5d03851c746c",
                                                "text": "„Lassehn blickt die Landsberger Straße entlang, doch der Blick reicht nicht weit, dicker Qualm eines brennenden Hauses wird durch einen Windstoß tief in die Straßenzeile hineingedrückt, undeutlich zeichnen sich die Umrisse der Häuser ab.“"
                                            },
                                            {
                                                "example_id": "6cca752c-4119-495f-9614-27f6dd584584",
                                                "sense_id": "1d64b55c-3338-3ec6-b692-5d03851c746c",
                                                "text": "„Sie spähten über die nüchternen Trümmer der Straßenzeile, in der sie standen, blickten an den leeren Fassaden hoch, hinter denen das gastliche Leben ausgebrannt war, und sie sahen im Geiste das Zimmer und den Garten, die Felder weit außerhalb und das Land, zu denen die Brücken abgebrochen waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef7fa4ca-1197-4b0b-ab32-cea500cbfd0f",
                        "source_entry_id": "e404e4ea-a275-39e7-84db-a7d786634b4e",
                        "source_sense_description": "passage",
                        "target_lang_word": "Bauflucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
