                ],
                "senses": [
                    {
                        "sense_id": "186b2e21-c521-3c0b-9d60-7c102a25d930",
                        "entry_id": "e7feb079-50bc-3cd6-8a81-7a787131e484",
                        "glosses": [
                            "Ne plus apprécier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9b431f2-3ae9-48b2-b078-d55e0b17cb31",
                                "sense_id": "186b2e21-c521-3c0b-9d60-7c102a25d930",
                                "text": "Il est habituel en effet que l’élévation des hommes leur fasse mépriser, ou tout au moins désapprécier, leurs premières amours jugées trop rustiques ou trop insignifiantes."
                            }
                        ]
                    },
                    {
                        "sense_id": "c197bb54-bf7b-311d-8b1f-bc07182d1e70",
                        "entry_id": "e7feb079-50bc-3cd6-8a81-7a787131e484",
                        "glosses": [
                            "Déprécier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1f5721f-7612-4175-8077-5a52ba04050e",
                                "sense_id": "c197bb54-bf7b-311d-8b1f-bc07182d1e70",
                                "text": "La plus grande faute et aussi la plus fatale qu’un Européen puisse donc y faire, est de mal juger et de désapprécier ces habitans."
                            }
                        ]
                    }
                ],
