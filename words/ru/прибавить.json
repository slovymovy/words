                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За зиму ребенок успел заметно <w>прибавить</w> в росте."
                        },
                        {
                            "text": "После болезни пациент начал <w>прибавить</w> в весе."
