                    {
                        "sense_id": "17c29090-bf74-3f0b-87d0-76d64ed6821c",
                        "entry_id": "f4aad1d1-73af-3656-a500-eb4893dbf5c1",
                        "glosses": [
                            "hoofdpersoon uit De Klokkenluider van de Notre-Dame, een boek van de 19e-eeuwse Franse schrijver Victor Hugo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbdf3bc9-f567-485f-b02b-cec69cbe67fe",
                                "sense_id": "17c29090-bf74-3f0b-87d0-76d64ed6821c",
                                "text": "Quasimodo werd op de eerste zondag na Pasen gevonden op de trappen van de Notre-Dame te Parijs."
                            },
                            {
                                "example_id": "e1d69bd4-d307-4226-9f91-42d5a222f5e2",
                                "sense_id": "17c29090-bf74-3f0b-87d0-76d64ed6821c",
                                "text": "De wrede dood van het hemelse zigeunermeisje Esmeralda en de smachtende liefde van de gebochelde Quasimodo woelde een diepe, onbekende emotie bij me los."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d66bf62-cfd8-3ef8-854d-564d7210fc57",
                        "entry_id": "f4aad1d1-73af-3656-a500-eb4893dbf5c1",
                        "glosses": [
                            "verouderde spelling of vorm van quasimodo tot 2006"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c7c507b7-44f7-460a-b6ea-90707c2bef93",
                                "sense_id": "4d66bf62-cfd8-3ef8-854d-564d7210fc57",
                                "text": "Na het openingsnummer „Spare parts” nam Waits, zittend achter de piano of staand achter de microfoon, d.w.z. gebocheld en licht verkrampt als Quasimodo en met de motoriek van een duikelaartje, vrijwel het hele repertoire van zijn laatste lp „Small change” door, met, naast de titelsong, als hoogtepunten „Step right up”, „Tom Traubert's blues” en „Pasties and a G-string”, een fascinerende situatieschets, die Waits, slechts door slagwerk begeleid, zeer beeldend uitsprak."
                            }
                        ]
                    }
                ],
