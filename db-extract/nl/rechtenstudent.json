                    {
                        "sense_id": "c76414c6-f567-3679-82e7-ba33084b4596",
                        "entry_id": "8afd1a08-ce2b-301d-b5e7-85849c851711",
                        "glosses": [
                            "student in de rechtsgeleerdheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3472e53d-8c07-4d61-a253-68c513840c30",
                                "sense_id": "c76414c6-f567-3679-82e7-ba33084b4596",
                                "text": "Een eerstejaars rechtenstudent."
                            },
                            {
                                "example_id": "1625dcc4-9b97-43d5-94d7-03f9341d2162",
                                "sense_id": "c76414c6-f567-3679-82e7-ba33084b4596",
                                "text": "Het was weliswaar lang geleden dat hij zich bezig had moeten houden met economie, boekhouden en bedrijfseconomie, het ellendigste onderdeel voor de rechtenstudent, dat sluw al in het eerste jaar van de opleiding was geplaatst."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "173cad05-3170-4ecf-b346-bd54a54397d8",
                        "source_entry_id": "8afd1a08-ce2b-301d-b5e7-85849c851711",
                        "source_sense_id": "c76414c6-f567-3679-82e7-ba33084b4596",
                        "source_sense_description": "student in de rechtsgeleerdheid",
                        "target_lang_word": "Jurastudent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jurastudent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "989dcdb9-8756-38b8-83b0-761f3ebcb238",
                                        "entry_id": "82894534-2e43-3de0-86bd-71595357941a",
                                        "glosses": [
                                            "Person, die das Fach Jura/Rechtswissenschaft studiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1f3053d-ab8f-4e88-a2e4-7b1a65974a64",
                                                "sense_id": "989dcdb9-8756-38b8-83b0-761f3ebcb238",
                                                "text": "„Natürlich weiß sie, dass die meisten Jurastudenten heute keine Lust haben auf Xus Leben oder auch auf ihres.“"
                                            },
                                            {
                                                "example_id": "44ece4ac-34b3-4fa7-b6fa-67f2ea553c44",
                                                "sense_id": "989dcdb9-8756-38b8-83b0-761f3ebcb238",
                                                "text": "„Der ehemalige Jurastudent Frank Wedekind wurde später in München nicht nur seßhaft, sondern er blieb dieser Stadt auch treu.“"
                                            },
                                            {
                                                "example_id": "9fdfe3aa-774c-4f58-8974-194007b78460",
                                                "sense_id": "989dcdb9-8756-38b8-83b0-761f3ebcb238",
                                                "text": "„Jurastudenten besuchten das örtliche Gericht, Medizinstudenten wurden im Krankenhaus eingesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
