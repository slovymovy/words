                    {
                        "sense_id": "a8ac93a2-b329-30f3-8ee1-dc4dc69f9026",
                        "entry_id": "ef69c4c1-4743-3843-b564-0814093c51be",
                        "glosses": [
                            "Eigenschaft eines Verbs, im Satz Ergänzungen zu fordern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3906d586-cc17-4b9f-ba7c-c780ca91efb6",
                                "sense_id": "a8ac93a2-b329-30f3-8ee1-dc4dc69f9026",
                                "text": "„Für die Besprechung der Verbvalenz in den folgenden Abschnitten setzen wir eine Gliederung der Verben gemäß 2 voraus.“"
                            },
                            {
                                "example_id": "dd17c615-636e-4e1f-befe-9f021be6cd22",
                                "sense_id": "a8ac93a2-b329-30f3-8ee1-dc4dc69f9026",
                                "text": "Eine Übersicht über Typen der Verbvalenzen findet man bei Weinrich."
                            },
                            {
                                "example_id": "43c071c0-640d-49fc-8672-f9d75b905385",
                                "sense_id": "a8ac93a2-b329-30f3-8ee1-dc4dc69f9026",
                                "text": "„Grundsätzlich wird die Erscheinung der Verbvalenz in zweierlei Hinsicht zu beschreiben sein: quantitativ und qualitativ…“"
                            },
                            {
                                "example_id": "3ee2010b-37a5-45f9-9983-39cdfbf46dbc",
                                "sense_id": "a8ac93a2-b329-30f3-8ee1-dc4dc69f9026",
                                "text": "„Die Verbvalenz ist eine abstrakte Eigenschaft…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
