                "senses": [
                    {
                        "sense_id": "8831f3ba-4bbb-31ed-870f-d9bb1e855155",
                        "entry_id": "53bbe86b-59cb-3304-8de0-475a8326b3b6",
                        "glosses": [
                            "Qualifie un mouvement contestataire philosophique, esthétique et politique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e92352b-ed0d-4825-8e00-1ca92c1bb5c2",
                                "sense_id": "8831f3ba-4bbb-31ed-870f-d9bb1e855155",
                                "text": "L’Internationale situationniste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2390cff8-2c02-4e41-863b-30877e165a08",
                        "source_entry_id": "53bbe86b-59cb-3304-8de0-475a8326b3b6",
                        "source_sense_id": "8831f3ba-4bbb-31ed-870f-d9bb1e855155",
                        "target_lang_word": "situationistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5acd744e-4a9a-44fa-80c7-151b24e778c1",
                        "source_entry_id": "53bbe86b-59cb-3304-8de0-475a8326b3b6",
                        "source_sense_id": "8831f3ba-4bbb-31ed-870f-d9bb1e855155",
                        "target_lang_word": "situationist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "situationist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74a44e11-5e53-32eb-ba09-edf8fdf43252",
                                        "entry_id": "014091fb-0127-35de-adf8-ec6a5cf5aaad",
                                        "glosses": [
                                            "Pertaining to situationism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05830c07-872f-4087-9819-4cce2ed3a701",
                                                "sense_id": "74a44e11-5e53-32eb-ba09-edf8fdf43252",
                                                "text": "Psychogeography was formed and validated by a situationist group discourse and culture that couldn't be just blanked out at will. In fact Debord presented the situationist maps of Paris and the “theory of the dérive” precisely in order to ratify group activity, codifying all sorts of overblown psychogeographic techniques."
                                            },
                                            {
                                                "example_id": "1cb9be81-85cc-472e-898b-9e4b98c34483",
                                                "sense_id": "74a44e11-5e53-32eb-ba09-edf8fdf43252",
                                                "text": "While members of the cell he is meeting no doubt consider themselves revolutionaries, their call to arms is Fast Company, the rapidly growing magazine that began in April of 1995 with a bold series of declarations blending Situationist sloganeering with Madison Avenue exhortations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "situationist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9c0c262-4295-3196-b638-6d18f17aa9dc",
                                        "entry_id": "376104fa-3b5b-3d8e-b56a-48ac3538c785",
                                        "glosses": [
                                            "A person who subscribes to situationism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f33da52-d033-42e5-a791-2d96873eb44e",
                                                "sense_id": "e9c0c262-4295-3196-b638-6d18f17aa9dc",
                                                "text": "In 1976 and 1977, and the years to follow, as symbolically remade by the Sex Pistols, it was, perhaps, dadaists, lettrists, situationists, and various medieval heretics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ce5d951-50af-4429-ae33-0502eeb87bac",
                        "source_entry_id": "53bbe86b-59cb-3304-8de0-475a8326b3b6",
