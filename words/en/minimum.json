                        "pl": [
                            {
                                "target_lang_word": "minimum",
                                "target_lang_sense_clarification": "najniższa dopuszczalna wartość"
                            },
                            {
                                "target_lang_word": "co najmniej",
                                "target_lang_sense_clarification": "wyrażenie określające dolną granicę"
                            }
