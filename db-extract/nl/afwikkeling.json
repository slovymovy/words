                                                "example_id": "8bf34ced-8984-4dc6-9284-3a6e7f773bd1",
                                                "sense_id": "26c23076-5b59-3d15-929c-ec35e1581d5a",
                                                "text": "Instance en règlement de juges."
                                            },
