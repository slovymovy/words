                                                "example_id": "745f867b-9e1d-448c-a104-5ec60a5dc7f7",
                                                "sense_id": "f8483f49-8f44-34a0-816b-cbcd0bcb4616",
                                                "text": "He was stand-offish with the other agents. They on their side said he was the manager’s spy upon them."
                                            },
                                            {
                                                "example_id": "688b0c91-fd45-47ca-b220-c1ad35dbc5f5",
                                                "sense_id": "f8483f49-8f44-34a0-816b-cbcd0bcb4616",
                                                "text": "His initial impression was that he was a bit standoffish or not over effusive […]"
                                            },
                                            {
                                                "example_id": "33ec5ee5-a4c2-413d-97a3-9155cdf1a919",
                                                "sense_id": "f8483f49-8f44-34a0-816b-cbcd0bcb4616",
