                ],
                "senses": [
                    {
                        "sense_id": "fb799ac8-3ed8-3459-8af3-f20c14ad931d",
                        "entry_id": "5ff01be9-4ec5-3b69-bedc-f434689b7035",
                        "glosses": [
                            "Treffen von Experten und Entscheidungsträgern, bei dem über Maßnahmen zur Bewältigung einer Krise beraten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75903107-513d-4d8d-a0e3-86df45dde585",
                                "sense_id": "fb799ac8-3ed8-3459-8af3-f20c14ad931d",
                                "text": "Die Vorstandsmitglieder kommen wegen des Absatzeinbruchs zu einem Krisengipfel zusammen."
                            },
                            {
                                "example_id": "dfea93fa-7364-41f9-bc48-fa57713cc46c",
                                "sense_id": "fb799ac8-3ed8-3459-8af3-f20c14ad931d",
                                "text": "„Nur einen Tag nach dem Krisengipfel im Bundesgesundheitsministerium ist ein neuer Streit zwischen den Krankenkassen und Sozialministerin Ulla Schmidt entbrannt.“"
                            },
                            {
                                "example_id": "dee3c84d-ffb9-47d3-a4b1-e3465fcd53f6",
                                "sense_id": "fb799ac8-3ed8-3459-8af3-f20c14ad931d",
                                "text": "„Der französische Staatspräsident Jacques Chirac plant einen Krisengipfel des Uno-Sicherheitsrats, um möglicherweise doch noch einen Kompromiss in der Irak-Frage zu erzielen.“"
                            },
                            {
                                "example_id": "bb9170a3-0396-4c07-acb2-83f81ca9a0fb",
                                "sense_id": "fb799ac8-3ed8-3459-8af3-f20c14ad931d",
                                "text": "„Dieses Wochenende findet der nächste große Krisengipfel der EU-Staatschefs statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
