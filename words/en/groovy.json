{
    "word_family": [
        "groove"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3441a732-1e01-3211-ad2e-5e6fc81e4597",
                    "sense_definition": "Excellent, fashionable, or very pleasing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That new song you played is really <w>groovy</w>.",
                            "target_lang_translations": {
                                "zh": "你放的那首新歌真是<w>很棒</w>。"
                            }
                        },
                        {
                            "text": "Everything is <w>groovy</w> when we hang out together.",
                            "target_lang_translations": {
                                "zh": "我们在一起玩的时候，一切都<w>很棒</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cool",
                        "excellent",
                        "neat"
                    ],
                    "antonyms": [
                        "awful",
                        "terrible"
                    ],
                    "common_phrases": [
                        "everything is groovy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly associated with 1960s slang but still understood."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "极好的、时髦的或非常令人愉快的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "很棒",
                                "target_lang_sense_clarification": "形容事物非常出色或令人满意。"
                            },
                            {
                                "target_lang_word": "时髦",
                                "target_lang_sense_clarification": "形容符合潮流或时尚。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa2c0a4c-7f2c-3d94-9456-03f45cc6580c",
                    "sense_definition": "Relating to the style or culture of the 1960s.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party had a <w>groovy</w> theme with bright colors and flower patterns.",
                            "target_lang_translations": {
                                "zh": "派对采用了色彩鲜艳、花朵图案的<w>六十年代风格</w>主题。"
                            }
                        },
                        {
                            "text": "She loves wearing <w>groovy</w> vintage clothes from the late sixties.",
                            "target_lang_translations": {
                                "zh": "她喜欢穿那种<w>六十年代风格</w>的复古衣服。"
                            }
                        }
                    ],
                    "synonyms": [
                        "psychedelic",
                        "hippie"
                    ],
                    "common_phrases": [
                        "groovy vibes"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers specifically to a past cultural era."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "与20世纪60年代的风格或文化相关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "六十年代风格",
                                "target_lang_sense_clarification": "特指具有20世纪60年代嬉皮士或迷幻文化特征的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "294aec9f-aba6-3ea7-9873-01eb0d153554",
                    "sense_definition": "Having a strong, rhythmic, and danceable musical quality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "musical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bass player laid down a <w>groovy</w> rhythm that made everyone dance.",
                            "target_lang_translations": {
                                "zh": "贝斯手弹奏出一种<w>有律动感</w>的节奏，让每个人都跳起舞来。"
                            }
                        },
                        {
                            "text": "That <w>groovy</w> beat is perfect for a funk music playlist.",
                            "target_lang_translations": {
                                "zh": "那种<w>动感</w>十足的节拍非常适合放克音乐播放列表。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rhythmic",
                        "funky"
                    ],
                    "common_phrases": [
                        "groovy beat"
                    ],
                    "target_lang_definitions": {
                        "zh": "具有强烈的节奏感，适合跳舞的音乐特质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有律动感",
                                "target_lang_sense_clarification": "形容音乐节奏感强，富有感染力。"
                            },
                            {
                                "target_lang_word": "动感",
                                "target_lang_sense_clarification": "形容音乐节奏鲜明，充满活力。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9d3bd41-9fb7-3f15-9c74-909129e3dcda",
                    "sense_definition": "Having grooves or long, narrow cuts on the surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>groovy</w> surface of the metal helps it grip the other part better.",
                            "target_lang_translations": {
                                "zh": "金属表面<w>有槽</w>的设计有助于它更好地抓紧另一个部件。"
                            }
                        },
                        {
                            "text": "These <w>groovy</w> tiles are designed to hold adhesive firmly in place.",
                            "target_lang_translations": {
                                "zh": "这些<w>带纹路</w>的瓷砖旨在让粘合剂固定得更牢固。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ridged",
                        "channeled"
                    ],
                    "antonyms": [
                        "smooth"
                    ],
                    "target_lang_definitions": {
                        "zh": "表面有凹槽或长而窄的切口的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有槽的",
                                "target_lang_sense_clarification": "指物体表面有凹陷的沟槽。"
                            },
                            {
                                "target_lang_word": "带纹路的",
                                "target_lang_sense_clarification": "指表面有刻痕或纹理。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fc52073-5c7d-3241-8b4b-059b38798711",
                    "sense_definition": "Stuck in a fixed, unchanging routine or way of thinking.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He became too <w>groovy</w> and refused to try any new methods at work.",
                            "target_lang_translations": {
                                "zh": "他变得太<w>墨守成规</w>，拒绝在工作中尝试任何新方法。"
                            }
                        },
                        {
                            "text": "Living in the same town for fifty years made him quite <w>groovy</w>.",
                            "target_lang_translations": {
                                "zh": "在同一个小镇住了五十年，使他变得相当<w>刻板</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inflexible",
                        "routine"
                    ],
                    "antonyms": [
                        "flexible",
                        "adaptable"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in this sense in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "陷入固定的、一成不变的常规或思维方式中。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "墨守成规",
                                "target_lang_sense_clarification": "形容思想保守，不愿改变。"
                            },
                            {
                                "target_lang_word": "刻板",
                                "target_lang_sense_clarification": "形容行为或思维僵化。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ddb1c242-9c23-3b33-a5ff-d5a92169cdbb",
                    "sense_definition": "A person who is considered trendy or fashionable.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The club was filled with local <w>groovies</w> showing off their latest outfits.",
                            "target_lang_translations": {
                                "zh": "俱乐部里挤满了当地的<w>潮人</w>，他们都在炫耀自己最新的行头。"
                            }
                        },
                        {
                            "text": "She tried to impress the <w>groovies</w> by wearing the newest designer shoes.",
                            "target_lang_translations": {
                                "zh": "她试图通过穿最新的名牌鞋来给那些<w>时尚达人</w>留下深刻印象。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trendsetter",
                        "fashionista"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Very informal and dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "被认为是时髦或时尚的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "潮人",
                                "target_lang_sense_clarification": "指追求时尚、引领潮流的人。"
                            },
                            {
                                "target_lang_word": "时尚达人",
                                "target_lang_sense_clarification": "指对时尚有敏锐触觉的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}