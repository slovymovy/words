                            {
                                "example_id": "4c87b4a5-1ca4-4e98-9784-2762ce20de97",
                                "sense_id": "0787c131-f1c2-3e27-a126-95e3b8b14a98",
                                "text": "„Also müssen Zähne mit einem Hammer pulverisiert und mitsamt der Knochenasche in alle Winde zerstreut werden. Nur so konnte man das Opfer wirklich verschwinden lassen.“"
                            },
                            {
                                "example_id": "d803328d-7613-43a7-9acb-81389a4d0bdf",
                                "sense_id": "0787c131-f1c2-3e27-a126-95e3b8b14a98",
                                "text": "„Seine Augen sind ägyptisch-braun; diese Farbe wird aus gemahlenen Mumien, Knochenasche und Asphalt hergestellt und wurde bis ins 19. Jahrhundert verwendet, bis Künstler die eklige Wahrheit erfuhren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
