        "fr-extract.jsonl": [
            {
                "entry_id": "2a4198a5-5d5e-3c04-885d-98a0db274da8",
                "word": "prestement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1ab47d03-0865-313f-be79-66e11756f1bf",
                        "entry_id": "2a4198a5-5d5e-3c04-885d-98a0db274da8",
                        "glosses": [
                            "D’une manière preste, vivement, promptement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3ad8c1e-c436-4bbe-8fa4-b19955551426",
                                "sense_id": "1ab47d03-0865-313f-be79-66e11756f1bf",
                                "text": "Les foulques regardent le chasseur, et plongent si prestement, à l’instant qu’elles aperçoivent le feu, que souvent elles échappent au plomb meurtrier,"
                            },
                            {
                                "example_id": "383dfd02-1148-48b6-97b3-ad2804f3bd4d",
                                "sense_id": "1ab47d03-0865-313f-be79-66e11756f1bf",
                                "text": "Il n’eut que le temps de réendosser prestement sa soutane et de filer en hâte à la sacristie pour revêtir les habits sacerdotaux."
                            },
                            {
                                "example_id": "0d41ae1a-9597-4ba5-aa0c-523ac9f1d602",
                                "sense_id": "1ab47d03-0865-313f-be79-66e11756f1bf",
                                "text": "Partout des nuées d’oiseaux […]. Ces volatiles sont si peu farouches, que l’un d'eux, prestement, enleva le béret d’un des matelots."
                            },
                            {
                                "example_id": "02037026-146c-404e-a63b-306b26f54120",
                                "sense_id": "1ab47d03-0865-313f-be79-66e11756f1bf",
                                "text": "Aucune espèce de parapet, d’ailleurs : un faux pas, et on plongerait dans le vide ; on s’en irait prestement, en passant au travers d’un nuage ou de deux, s’aplatir en bas, en Autriche."
                            }
                        ]
                    }
                ],
