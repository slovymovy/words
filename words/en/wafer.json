{
    "word_family": [
        "wafery",
        "wafering"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea6a2868-f7b4-3573-9cfc-d1ca24236a22",
                    "sense_definition": "A light, thin, and flat biscuit or cookie, often crisp.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She enjoyed eating a chocolate <w>wafer</w> with her afternoon tea.",
                            "target_lang_translations": {
                                "ru": "Ей нравилось есть шоколадную <w>вафлю</w> с послеобеденным чаем."
                            }
                        },
                        {
                            "text": "The ice cream was served with a crisp <w>wafer</w> on top.",
                            "target_lang_translations": {
                                "ru": "Мороженое подали с хрустящей <w>вафлей</w> сверху."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chocolate wafer",
                        "crisp wafer",
                        "vanilla wafer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкое, тонкое и плоское печенье, часто хрустящее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вафля",
                                "target_lang_sense_clarification": "кондитерское изделие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11591ece-bdfa-3bb7-8852-3fc2ed7bd418",
                    "sense_definition": "A thin disk of silicon or other semiconductor material used to create electronic circuits.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician carefully placed the silicon <w>wafer</w> into the processing machine.",
                            "target_lang_translations": {
                                "ru": "Техник осторожно поместил кремниевую <w>пластину</w> в установку для обработки."
                            }
                        },
                        {
                            "text": "Dozens of microchips are printed onto a single large <w>wafer</w> during manufacturing.",
                            "target_lang_translations": {
                                "ru": "В процессе производства на одной большой <w>подложке</w> печатаются десятки микросхем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silicon wafer",
                        "semiconductor wafer"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий диск из кремния или другого полупроводникового материала, используемый для создания электронных схем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подложка",
                                "target_lang_sense_clarification": "в электронике"
                            },
                            {
                                "target_lang_word": "пластина",
                                "target_lang_sense_clarification": "кремниевая или полупроводниковая"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea2a2e11-6eee-3e2d-9e8e-c97f18904943",
                    "sense_definition": "A thin disk of unleavened bread used in the Christian religious ceremony of communion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest placed a small <w>wafer</w> on the tongue of each person during the service.",
                            "target_lang_translations": {
                                "ru": "Во время службы священник клал маленькую <w>хостию</w> на язык каждому прихожанину."
                            }
                        },
                        {
                            "text": "In many churches, the communion <w>wafer</w> represents the body of Christ.",
                            "target_lang_translations": {
                                "ru": "Во многих церквях <w>облатка</w> для причастия символизирует тело Христово."
                            }
                        }
                    ],
                    "synonyms": [
                        "host"
                    ],
                    "common_phrases": [
                        "communion wafer",
                        "sacramental wafer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий диск из пресного хлеба, используемый в христианской религиозной церемонии причастия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хостия",
                                "target_lang_sense_clarification": "в католицизме"
                            },
                            {
                                "target_lang_word": "облатка",
                                "target_lang_sense_clarification": "богослужебный хлеб"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ff1cf62-4a63-3d7e-aba9-1acb0b608769",
                    "sense_definition": "A small disk of dried paste or gelatin used to seal letters or attach papers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stationery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before the invention of gummed envelopes, a <w>wafer</w> was used to keep the letter closed.",
                            "target_lang_translations": {
                                "ru": "До изобретения конвертов с клеевым слоем для запечатывания писем использовалась <w>облатка</w>."
                            }
                        },
                        {
                            "text": "He pressed the red <w>wafer</w> onto the paper to ensure the document was sealed.",
                            "target_lang_translations": {
                                "ru": "Он прижал красную <w>печать</w> к бумаге, чтобы убедиться, что документ запечатан."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical use for sealing letters"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой диск из сухой пасты или желатина, использовавшийся для запечатывания писем или скрепления бумаг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облатка",
                                "target_lang_sense_clarification": "для запечатывания писем"
                            },
                            {
                                "target_lang_word": "печать",
                                "target_lang_sense_clarification": "материал для скрепления"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d577df8c-2612-3371-a281-a8494608d971",
                    "sense_definition": "To seal or fasten a document or letter using a <w>wafer</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sealing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clerk would <w>wafer</w> the notice to the door so it could not be easily removed.",
                            "target_lang_translations": {
                                "ru": "Клерк <w>приклеил</w> объявление к двери с помощью облатки, чтобы его нельзя было легко снять."
                            }
                        },
                        {
                            "text": "She <w>wafered</w> the two sheets of paper together before sending the package.",
                            "target_lang_translations": {
                                "ru": "Она <w>скрепила</w> два листа бумаги облаткой перед отправкой посылки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to historical sealing methods"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запечатывать или скреплять документ или письмо с помощью облатки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запечатывать облаткой",
                                "target_lang_sense_clarification": "скреплять бумагу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}