                                    },
                                    {
                                        "sense_id": "fbeb2316-f29c-38ee-b961-d43929033261",
                                        "entry_id": "4e49632a-3267-35c7-8258-4a30b76d9006",
                                        "glosses": [
                                            "A patch of colour around an animal's upper breast and throat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c94f3568-8525-437c-868c-a92094c50146",
                                                "sense_id": "fbeb2316-f29c-38ee-b961-d43929033261",
                                                "text": "In summer the whole throat and breast are black, but in winter plumage the throat is white bounded by a horseshoe-shaped black bib."
                                            },
                                            {
                                                "example_id": "f8025f83-312a-4e22-8b53-646aa44b62f6",
                                                "sense_id": "fbeb2316-f29c-38ee-b961-d43929033261",
                                                "text": "He don't look anything like the captain. This here cat has got a nice thick black coat of fur with a nice white bib and white feet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0ada725-787f-3eba-96d1-4691bee09705",
                                        "entry_id": "4e49632a-3267-35c7-8258-4a30b76d9006",
                                        "glosses": [
                                            "A north Atlantic fish (Trisopterus luscus), allied to the cod."
                                        ],
