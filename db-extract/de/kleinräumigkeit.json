                "senses": [
                    {
                        "sense_id": "961be5f2-7e8d-33c4-b10d-905d4f48a1ce",
                        "entry_id": "15eb490c-494d-32e9-924c-4907caad5081",
                        "glosses": [
                            "Eigenschaft, nur wenig Raum zu einzunehmen oder zu beanspruchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "936994b2-e28a-44f2-a161-1e84ff004a11",
                                "sense_id": "961be5f2-7e8d-33c4-b10d-905d4f48a1ce",
                                "text": "„Dies ist die Ursache für die große Vielfalt und die ausgeprägte Kleinräumigkeit aller traditionellen Kulturlandschaften.“"
                            },
                            {
                                "example_id": "2cea55e8-111d-4dab-af84-36bfe571654b",
                                "sense_id": "961be5f2-7e8d-33c4-b10d-905d4f48a1ce",
                                "text": "„Die mittelalterliche Gesellschaft war auf weite Strecken durch eine gewisse Kleinräumigkeit geprägt: Nur wenige Menschen kamen jemals aus ihrer dorfengen Welt hinaus.“"
                            },
                            {
                                "example_id": "ea7a4ba2-7530-4adf-9daa-8a3ab10e4df1",
                                "sense_id": "961be5f2-7e8d-33c4-b10d-905d4f48a1ce",
                                "text": "„In Halle begannen sich, trotz relativer Kleinräumigkeit der Stadt und sozial heterogen verteilter Wohnbevölkerung auf die einzelnen Stadtteile, Quartiere auszubilden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
