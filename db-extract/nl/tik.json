                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c7e5c08-0cff-4b08-b5f8-8cb9217cd21d",
                                "sense_id": "54106494-02d1-3417-83ee-fb8db8e46e5b",
                                "text": "Je moet mijn fiets eens nakijken, ik hoor steeds een tik."
                            }
                        ]
