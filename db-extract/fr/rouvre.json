                                        "entry_id": "a9d79ada-0655-3148-8b48-0c645b287a9d",
                                        "glosses": [
                                            "Die Traubeneiche (Quercus petraea, Syn.: Q. sessilis, Q. sessiliflora), auch Wintereiche genannt, ist eine Laubbaum-Art aus der Gattung der Eichen (Quercus) in der Familie der Buchengewächse (Fagaceae)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ccd592f-9d95-4f9f-9135-8972ceadb43a",
                                                "sense_id": "4d45c85a-59c3-3c3f-8b4d-c861cc2a7ad5",
                                                "text": "Mein Vater hat hinter dem Haus eine Traubeneiche gepflanzt."
                                            },
                                            {
                                                "example_id": "189d75be-37ee-47dd-beec-f55c41ccde0c",
                                                "sense_id": "4d45c85a-59c3-3c3f-8b4d-c861cc2a7ad5",
                                                "text": "Der Spessart ist bekannt für seine Traubeneichen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
