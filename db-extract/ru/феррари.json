                    {
                        "translation_id": "09f6362a-85b2-4aa4-b1a0-2cb4312937f1",
                        "source_entry_id": "bfc18b03-98f4-3390-83ea-4134765c06f4",
                        "source_sense_id": "617ee20a-120c-35d7-9943-e1f92c6bbe6d",
