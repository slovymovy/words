                ],
                "senses": [
                    {
                        "sense_id": "beecad1f-3824-3c52-8cd9-9b2af2639650",
                        "entry_id": "00986b47-9b27-3b91-96c0-f4bd5bcff634",
                        "glosses": [
                            "Qui a plusieurs formes."
                        ],
                        "tags": [
                            "generally"
                        ],
                        "examples": [
                            {
                                "example_id": "7f9aa8c4-4c7f-4298-b1e2-66a7326d7ef2",
                                "sense_id": "beecad1f-3824-3c52-8cd9-9b2af2639650",
                                "text": "Emporté par le mouvement multiforme de la lutte, il a tendance à se fixer sur des tâches locales, poursuivies avec ardeur mais presque toujours solennisées."
                            },
                            {
                                "example_id": "60f9da2d-4a93-4577-91d8-0bb24b3f8879",
                                "sense_id": "beecad1f-3824-3c52-8cd9-9b2af2639650",
                                "text": "Or, en fait, le monde est creusé de failles plus profondes, plus larges et plus nombreuses qu’on ne le croit au premier regard, et cet éclatement profond et multiforme est pour nous, sous des formes multiples, un risque de mort."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3b4282f-f852-381a-b2e8-eb19c899e423",
                        "entry_id": "00986b47-9b27-3b91-96c0-f4bd5bcff634",
                        "glosses": [
                            "Qui a plusieurs formes ou figures."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "41076e4d-e7dd-4ba5-9750-bbc22005574e",
                                "sense_id": "b3b4282f-f852-381a-b2e8-eb19c899e423",
                                "text": "MULTIFORME, adj., multiformis ; rielgestaltig (all.) (multum, beaucoup, forma, forme). Se dit d’un corps qui affecte un grand nombre de formes différentes. Ex. Urceolaria multiformis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a23d914-fe98-4858-aaec-11a8d8a3faa0",
                        "source_entry_id": "00986b47-9b27-3b91-96c0-f4bd5bcff634",
                        "source_sense_id": "beecad1f-3824-3c52-8cd9-9b2af2639650",
                        "source_sense_description": "généralement",
                        "target_lang_word": "vielgestaltig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vielgestaltig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a77487a-f498-37ad-9d33-3883550eaa10",
                                        "entry_id": "c2bfbc1a-3061-3665-af94-ca87ccdeeccf",
                                        "glosses": [
                                            "von vielerlei, mehrerlei Gestalt, viele Formen annehmend oder angenommen habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84cbea12-a6cc-45d6-9c1a-cf7172de0124",
                                                "sense_id": "5a77487a-f498-37ad-9d33-3883550eaa10",
                                                "text": "Die Kirschpflaume ist recht vielgestaltig und ähnelt der Haferpflaume, auch Haferschlehe genannt."
                                            },
                                            {
                                                "example_id": "5bf21277-554a-4a67-a575-2c0428157100",
                                                "sense_id": "5a77487a-f498-37ad-9d33-3883550eaa10",
                                                "text": "„Als eines der vielgestaltigsten und artenreichsten deutschen Mittelgebirge im Dreiländereck Bayern, Hessen, Thüringen gilt die Rhön schon lange als Wanderparadies.“"
                                            },
                                            {
                                                "example_id": "578aed28-9f90-488a-8a85-9284e23a3ba2",
                                                "sense_id": "5a77487a-f498-37ad-9d33-3883550eaa10",
                                                "text": "„Musik- und Kunsttherapie sind Beispiele für die vielgestaltigen pädagogischen Initiativen, die auch in Verhaltenstherapien psychotisch Kranker zu erkennen sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
