                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0e35ebc-8e9b-4522-bc7f-c222ebe4aaae",
                                "sense_id": "59c9b8ee-2ea3-36bd-92ab-265fff3ece61",
                                "text": "Ich habe an einem Webseminar über Datensicherheit in Unternehmen teilgenommen."
                            }
