                ],
                "senses": [
                    {
                        "sense_id": "967ff6d3-360c-30c0-888c-5de78fd4a9c2",
                        "entry_id": "491b08dd-902a-3a93-8705-97c58396b388",
                        "glosses": [
                            "Creme, die Feuchtigkeit an die Haut abgeben soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65d89590-5c72-4104-8a95-c892bdbd6e9d",
                                "sense_id": "967ff6d3-360c-30c0-888c-5de78fd4a9c2",
                                "text": "„Während im Sommer meistens eine leichte Feuchtigkeitscreme ausreicht, muss die Pflege im Herbst und Winter nämlich an andere Bedingungen angepasst werden: Äußere Einflüsse wie der Wechsel von trockener Heizungsluft drinnen und frostiger Kälte draußen fordern unserem größten Schutzorgan einiges ab.“"
                            },
                            {
                                "example_id": "27ed1ccf-8031-4d2d-bb4c-2f3be1eab57d",
                                "sense_id": "967ff6d3-360c-30c0-888c-5de78fd4a9c2",
                                "text": "„Für die Tagespflege des Gesichts empfehlen Fachleute bei normaler Haut Feuchtigkeitscremes, die mehr Wasser als Fett enthalten - sogenannte Öl-in-Wasser-Emulsionen.“"
                            },
                            {
                                "example_id": "b52746eb-f89b-4c99-8c0c-20a73a4d964d",
                                "sense_id": "967ff6d3-360c-30c0-888c-5de78fd4a9c2",
                                "text": "„Es stimmt nicht, dass Feuchtigkeitscremen mit einem hohen Wassergehalt in der Haut frieren können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
