{
    "word_family": [
        "paraphrastic",
        "paraphrasis"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5982165b-83ee-3d57-8e1a-c1d70d226924",
                    "sense_definition": "To express the meaning of something using different words, typically to achieve greater clarity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restatement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher asked the students to <w>paraphrase</w> the complex scientific article in their own words.",
                            "target_lang_translations": {
                                "zh": "老师要求学生用自己的话<w>意译</w>那篇复杂的科学文章。"
                            }
                        },
                        {
                            "text": "It is often helpful to <w>paraphrase</w> difficult instructions to ensure everyone understands the task.",
                            "target_lang_translations": {
                                "zh": "为了确保每个人都理解任务，将困难的指令进行<w>改写</w>通常很有帮助。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rephrase",
                        "reword"
                    ],
                    "common_phrases": [
                        "paraphrase the text",
                        "paraphrase the passage"
                    ],
                    "target_lang_definitions": {
                        "zh": "用不同的词语表达某事的意思，通常是为了使表达更清晰。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "意译",
                                "target_lang_sense_clarification": "侧重于传达原意而非逐字翻译。"
                            },
                            {
                                "target_lang_word": "改写",
                                "target_lang_sense_clarification": "用自己的话重新表述内容。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "74652b6e-9999-3333-b472-040a69814eb7",
                    "sense_definition": "A rewording of a text or speech to clarify its meaning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restatement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student provided a clear <w>paraphrase</w> of the original poem to help the class understand it.",
                            "target_lang_translations": {
                                "zh": "这名学生提供了一个清晰的诗歌<w>意译</w>，以帮助全班同学理解。"
                            }
                        },
                        {
                            "text": "Writing a good <w>paraphrase</w> requires a deep understanding of the source material.",
                            "target_lang_translations": {
                                "zh": "写出一篇好的<w>改写</w>需要对原始材料有深刻的理解。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rephrasing"
                    ],
                    "common_phrases": [
                        "close paraphrase"
                    ],
                    "target_lang_definitions": {
                        "zh": "为澄清含义而对文本或演讲进行的改写。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "意译",
                                "target_lang_sense_clarification": "指改写后的文本版本。"
                            },
                            {
                                "target_lang_word": "改写本",
                                "target_lang_sense_clarification": "指经过改写的特定文本。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57a2c184-81e1-3e76-a12b-dc566147bb3e",
                    "sense_definition": "A version of a biblical passage rewritten in verse for use in religious worship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir sang a traditional <w>paraphrase</w> of the psalm during the Sunday service.",
                            "target_lang_translations": {
                                "zh": "唱诗班在周日礼拜时演唱了一首传统的<w>圣经诗歌改写</w>。"
                            }
                        },
                        {
                            "text": "Many historical hymnals contain a poetic <w>paraphrase</w> of various scripture passages.",
                            "target_lang_translations": {
                                "zh": "许多历史悠久的赞美诗集都收录了各种经文的<w>圣经诗歌改写</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a specific historical practice in church liturgy."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "为宗教礼拜而将圣经段落改写成的诗歌版本。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "圣经诗歌改写",
                                "target_lang_sense_clarification": "特指宗教礼仪中使用的诗体改写。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}