                "senses": [
                    {
                        "sense_id": "e1b01f95-bb5c-3989-a60b-7a27ba2463a1",
                        "entry_id": "1a0cc7d6-a2d5-3566-8520-602974c4906a",
                        "glosses": [
                            "Rückstand nach der (schlechten, unvollständigen) Verbrennung von Brennstoff vom Typ Diesel"
                        ],
                        "tags": [
                            "selten im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "dbcaf879-9884-48ed-bb7a-77981b072621",
                                "sense_id": "e1b01f95-bb5c-3989-a60b-7a27ba2463a1",
                                "text": "„[Wiener Umweltmediziner] haben eine Korrelation zwischen Konzentration der Schadstoffe – insbesondere von Feinstäuben (z. B. Dieselruss, Industrieabgase), Stickstoffdioxid und der Häufigkeit von akuten Herz-Kreislauf-Erkrankungen nachgewiesen.“"
                            },
                            {
                                "example_id": "e5b6353f-cc75-44d0-8791-faa69e2e42e3",
                                "sense_id": "e1b01f95-bb5c-3989-a60b-7a27ba2463a1",
                                "text": "„Dieselruss, Straßenabrieb, Partikel aus industrieller Verbrennung und noch eine Reihe weiterer Faktoren führen zu Feinstäuben und damit zu einer der größten gesundheitlichen Belastungen bereits bei Kindern und jungen Menschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
