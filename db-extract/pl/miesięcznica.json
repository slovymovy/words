                    },
                    {
                        "sense_id": "02c042bf-76f0-36eb-a344-dc7513f68b33",
                        "entry_id": "4259e135-452f-3f15-9727-fc71d9f352e2",
                        "glosses": [
                            "dzień przypadający dokładnie miesiąc po jakimś fakcie, zdarzeniu"
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "d9a640ef-e343-4756-8a39-d89ae60a8a00",
                                "sense_id": "02c042bf-76f0-36eb-a344-dc7513f68b33",
                                "text": "Obchody miesięcznicy śmierci górnika wizjonera odbyły się bez udziału prześmiewców i nad grobem po raz pierwszy publicznie pojawiła się idea wzniesienia figury na wałbrzyskim rynku"
                            },
                            {
                                "example_id": "7093c4e2-a376-435d-a91e-b46e5c6bed84",
                                "sense_id": "02c042bf-76f0-36eb-a344-dc7513f68b33",
                                "text": "Głos miał jeszcze ochrypły. Zdarł go podczas obchodów kolejnej miesięcznicy wprowadzenia stanu wojennego"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "7f7a532a-1a5e-3175-b92a-03c4c229292d",
                        "entry_id": "4259e135-452f-3f15-9727-fc71d9f352e2",
                        "glosses": [
                            "obchody związane z miesięcznicą (1.2)"
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "1a341e97-1d05-4c99-b47e-f2eba9a01287",
                                "sense_id": "7f7a532a-1a5e-3175-b92a-03c4c229292d",
                                "text": "Teraz uczestnicy miesięcznicy powoli się rozchodzą"
                            }
                        ],
