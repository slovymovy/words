{
    "word_family": [
        "joker",
        "jokingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5671b26c-ae29-38eb-9adb-7bce590cf641",
                    "sense_definition": "Saying things that are not serious or true, often to make people laugh or to trick them playfully.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "humor_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was just <w>joking</w> when I said I would eat the whole cake myself.",
                            "target_lang_translations": {
                                "ru": "Я просто <w>шутил</w>, когда сказал, что съем весь торт сам.",
                                "zh": "我说要一个人吃掉整个蛋糕时，只是在<w>开玩笑</w>。"
                            }
                        },
                        {
                            "text": "You must be <w>joking</w> if you think I will agree to that plan.",
                            "target_lang_translations": {
                                "ru": "Ты, должно быть, <w>шутишь</w>, если думаешь, что я соглашусь на этот план.",
                                "zh": "如果你觉得我会同意那个计划，那你一定是在<w>开玩笑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kidding",
                        "teasing"
                    ],
                    "common_phrases": [
                        "just joking",
                        "only joking",
                        "you must be joking",
                        "no joking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить несерьезно или неправду, часто чтобы рассмешить людей или игриво обмануть их.",
                        "zh": "说一些不严肃或不真实的话，通常是为了逗人发笑或开玩笑地捉弄他人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шутить",
                                "target_lang_sense_clarification": "говорить не всерьез"
                            },
                            {
                                "target_lang_word": "разыгрывать",
                                "target_lang_sense_clarification": "обманывать ради шутки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开玩笑",
                                "target_lang_sense_clarification": "指说话不当真或为了娱乐"
                            },
                            {
                                "target_lang_word": "戏弄",
                                "target_lang_sense_clarification": "指带有捉弄性质的玩笑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86ee61da-85e9-3554-bbfa-1ac94c351794",
                    "sense_definition": "Present participle and gerund of <w>joke</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "humor_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were laughing and <w>joking</w> together all night long.",
                            "target_lang_translations": {
                                "ru": "Они смеялись и <w>шутили</w> вместе всю ночь напролет.",
                                "zh": "他们整晚都在一起说笑、<w>开玩笑</w>。"
                            }
                        },
                        {
                            "text": "He is always <w>joking</w> about his bad luck with computers.",
                            "target_lang_translations": {
                                "ru": "Он вечно <w>шутит</w> по поводу своего невезения с компьютерами.",
                                "zh": "他总是拿自己电脑运气不好这件事来<w>开玩笑</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола \"шутить\".",
                        "zh": "动词“开玩笑”的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шутить",
                                "target_lang_sense_clarification": "рассказывать анекдоты или веселиться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开玩笑",
                                "target_lang_sense_clarification": "指讲笑话或进行幽默的互动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "828caa82-c3b2-3c25-afcf-67b1877dddf4",
                    "sense_definition": "The act of telling or engaging in jokes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "humor_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All the <w>joking</w> and laughter made the long trip much more enjoyable.",
                            "target_lang_translations": {
                                "ru": "Все эти <w>шутки</w> и смех сделали долгую поездку гораздо приятнее.",
                                "zh": "一路上的<w>玩笑</w>和笑声让漫长的旅途变得愉快多了。"
                            }
                        },
                        {
                            "text": "His constant <w>joking</w> can sometimes be inappropriate in serious situations.",
                            "target_lang_translations": {
                                "ru": "Его постоянные <w>шутки</w> иногда бывают неуместны в серьезных ситуациях.",
                                "zh": "他在严肃场合下不停地<w>开玩笑</w>有时会显得很不合时宜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "banter",
                        "jesting",
                        "kidding",
                        "teasing"
                    ],
                    "common_phrases": [
                        "laughing and joking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс рассказывания шуток или участия в них.",
                        "zh": "讲笑话或参与玩笑的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шутки",
                                "target_lang_sense_clarification": "как процесс или явление"
                            },
                            {
                                "target_lang_word": "подшучивание",
                                "target_lang_sense_clarification": "добродушная насмешка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "玩笑",
                                "target_lang_sense_clarification": "指开玩笑的行为或过程"
                            },
                            {
                                "target_lang_word": "打趣",
                                "target_lang_sense_clarification": "指带有调侃性质的言语互动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}