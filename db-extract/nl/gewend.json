                    {
                        "sense_id": "a9470f5e-a97b-3827-a3bb-95edc9474e72",
                        "entry_id": "bd1e2eaf-5258-359b-9d30-56479569ce8d",
                        "glosses": [
                            "voltooid deelwoord van gewennen"
                        ],
