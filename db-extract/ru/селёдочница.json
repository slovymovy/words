                "senses": [
                    {
                        "sense_id": "078557bb-743e-3c1d-92f9-8dd40f51ee8c",
                        "entry_id": "8063fb1a-31ac-3ad2-b2f2-4ee69239bca2",
                        "glosses": [
                            "разг. женск. к селёдочник; торговка селёдкой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfc8958f-5191-4db2-abf2-b4dc212a0ea4",
                                "sense_id": "078557bb-743e-3c1d-92f9-8dd40f51ee8c",
                                "text": "Старушка селёдочница с Охты собственными глазами видела кикимору, как она пряжу прядёт…"
                            },
                            {
                                "example_id": "05c4b40b-3242-4b9a-82f2-3baf281f3ac0",
                                "sense_id": "078557bb-743e-3c1d-92f9-8dd40f51ee8c",
                                "text": "Характерной чертой улицы подальше от центра были крики торговцев вразнос ― мороженщиков, селёдочниц, ягодников, а также точильщиков и скупщиков старья."
                            }
                        ]
