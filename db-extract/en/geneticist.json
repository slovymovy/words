                ],
                "senses": [
                    {
                        "sense_id": "918525ed-554d-33e7-8d9c-b7f403d465e0",
                        "entry_id": "c34ea3e4-f5bf-37f4-b574-c19b8bcbab80",
                        "glosses": [
                            "A scientist who studies genes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28fd7ba3-21e8-4a4f-b67c-6601e09dead7",
                                "sense_id": "918525ed-554d-33e7-8d9c-b7f403d465e0",
                                "text": "In an ingenious approach, a team of 11 scientists – including biologists, geneticists, glaciologists, computer scientists and ice-sheet modellers – looked at the genetics of Turquet’s octopus – a species that has been living around the Antarctic continent for about 4m years."
                            }
                        ]
                    },
                    {
                        "sense_id": "0db0ea84-cbf7-3bfa-afa1-1cba507dbdbb",
                        "entry_id": "c34ea3e4-f5bf-37f4-b574-c19b8bcbab80",
                        "glosses": [
                            "A physician who diagnoses, treats, and counsels patients with genetic disorders or syndromes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36cea0b4-4619-4d9e-8ccc-8016868f15e6",
                                "sense_id": "0db0ea84-cbf7-3bfa-afa1-1cba507dbdbb",
                                "text": "The geneticist said Ryan had a rare genetic disorder called mucopolysaccharidosis I, or MPS I, with a wide-range of symptoms affecting multiple systems in the body."
                            }
                        ]
                    }
                ],
