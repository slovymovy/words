                    {
                        "sense_id": "32e84d6c-2f06-3936-aa4b-b5161dbe12cc",
                        "entry_id": "f64a40d5-9c1c-356a-9b3f-8e1a77bd83c3",
                        "glosses": [
                            "A Chinese surname from Mandarin.",
                            "A Chinese surname from Mandarin from 呂／吕 (Lǚ)."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "b3cf2d90-d47b-48bf-945a-1a08f560cffe",
                                "sense_id": "32e84d6c-2f06-3936-aa4b-b5161dbe12cc",
                                "text": "As editor-in-chief of the pro-communist Kuangming News (光明報), Lu He-ruo (呂赫若) became a wanted man after the newspaper was raided by the authorities in August 1949. While many of his friends were arrested and executed, he managed to elude capture by hiding in the mountains of today’s New Taipei City’s Shihding District (石碇).\nLu never made it out of the mountains, and his death remained a mystery for decades."
                            }
                        ]
