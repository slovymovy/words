                        ],
                        "form": "das Loblied"
                    },
                    {
                        "form_id": "a09666aa-a1ee-4068-8f17-63509d45aa12",
                        "entry_id": "943b4cc0-91bc-31ce-a8b7-75cfc6dbfa43",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Loblieder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5fab1edb-08ae-3068-be1f-bbead18520c1",
                        "entry_id": "943b4cc0-91bc-31ce-a8b7-75cfc6dbfa43",
                        "glosses": [
                            "Lied, in dem jemand oder etwas gepriesen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9f97179-da40-4605-a66b-326296bf34d1",
                                "sense_id": "5fab1edb-08ae-3068-be1f-bbead18520c1",
                                "text": "„Dazu schreibt der Priester Prophet Zacharias im Loblied: Gottes Wille ist auch in Worten seiner Engel.“"
                            },
                            {
                                "example_id": "fd4fa5b8-ae5d-49a6-8621-e5fd7096b5fc",
                                "sense_id": "5fab1edb-08ae-3068-be1f-bbead18520c1",
                                "text": "„Es ist auch ein Loblied auf das bürgerliche Leben und auf die Harmonie von Natur und Kultur.“"
                            },
                            {
                                "example_id": "7ede5d4c-39e4-4d6e-ab3d-4738519c9966",
                                "sense_id": "5fab1edb-08ae-3068-be1f-bbead18520c1",
                                "text": "„Nun so komt, meine Lieben, um unsern Schöpfer bei dem Lichte seines herlichen Mondes ein Loblied für die Freuden des verflossenen Tages zu singen!“"
                            },
                            {
                                "example_id": "07d53b03-9763-4550-86d3-94f6c6f9a02d",
                                "sense_id": "5fab1edb-08ae-3068-be1f-bbead18520c1",
                                "text": "„Seit jener Zeit des Ambrosius wurden bis dato 35 000 solche Loblieder gezählt, und bisweilen gibt es noch heute Kleriker und Lateiner, die etwelche dichten.“"
                            },
                            {
                                "example_id": "52679394-09c7-4887-ba47-2e29db525298",
                                "sense_id": "5fab1edb-08ae-3068-be1f-bbead18520c1",
                                "text": "„Nonnen tanzen, Tausende singen Loblieder auf Baschar al Assad, dessen Porträt überlebensgroß über der Menge thront.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c10404d8-7248-4f49-8ef2-2098390e3fb3",
                        "source_entry_id": "943b4cc0-91bc-31ce-a8b7-75cfc6dbfa43",
                        "source_sense_id": "5fab1edb-08ae-3068-be1f-bbead18520c1",
                        "source_sense_description": "Lied, in dem jemand oder etwas gepriesen wird",
                        "target_lang_word": "louange",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "louange",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71811061-2350-3399-b6df-1f42c53dac3b",
                                        "entry_id": "e7ace16a-07be-3f7f-be54-f2597c15615a",
                                        "glosses": [
                                            "Discours ou paroles par lesquelles on relève le mérite de quelqu’un, de quelque action, de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "496109fa-ee9d-4677-8c4d-c1adb6845a4d",
                                                "sense_id": "71811061-2350-3399-b6df-1f42c53dac3b",
                                                "text": "Laissez donc le soin de vos louanges aux hérauts et aux ménestrels, messire chevalier, répondit Rowena ; elles conviennent mieux à leur bouche qu’à la vôtre."
                                            },
                                            {
                                                "example_id": "0f32e112-fd08-46e1-978e-1d94e7615d45",
                                                "sense_id": "71811061-2350-3399-b6df-1f42c53dac3b",
                                                "text": "Malgré sa raison ferme et droite, le directeur général avait un faible qui se rencontre chez beaucoup d’hommes de mérite. Il aimait la louange, et même la flatterie ; […]."
                                            },
                                            {
                                                "example_id": "c92fe8e6-b44b-4852-be53-88e771b31573",
                                                "sense_id": "71811061-2350-3399-b6df-1f42c53dac3b",
                                                "text": "Ce vaurien de Mablot, ce dégoûtant, ce saligaud ! Et lui qui le tenait en si haute estime, lui qui avait tant chanté ses louanges !"
                                            },
                                            {
                                                "example_id": "26ffbe6e-a5d3-43b8-a3d7-b58ab75fe176",
                                                "sense_id": "71811061-2350-3399-b6df-1f42c53dac3b",
                                                "text": "Plût à Dieu, écrit-il à son ami Thiériot, auquel il a demandé de porter sa dernière tragédie au père Brumoy, que je méritasse leurs louanges !"
                                            }
                                        ]
                                    }
                                ]
                            },
