                {
                    "sense_id": "21148365-f2d9-3c7b-83c8-c8ebe12fe61e",
                    "sense_definition": "At or towards the front; in the direction one is facing or moving.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spatial_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small island was directly <w>ahead</w> of the ship.",
                            "target_lang_translations": {
                                "ru": "Небольшой остров был прямо <w>впереди</w> корабля.",
                                "pl": "Mała wyspa znajdowała się bezpośrednio <w>przed</w> statkiem.",
                                "tr": "Küçük ada geminin tam <w>önündeydi</w>.",
                                "zh": "那座小岛就在船的<w>前方</w>。"
                            }
                        },
                        {
                            "text": "Keep going straight <w>ahead</w> until you reach the traffic lights.",
                            "target_lang_translations": {
                                "ru": "Продолжайте двигаться <w>прямо</w>, пока не дойдете до светофора.",
                                "pl": "Idź cały czas prosto <w>przed siebie</w>, aż dojdziesz do sygnalizacji świetlnej.",
                                "tr": "Trafik ışıklarına ulaşana kadar dosdoğru <w>ilerlemeye</w> devam edin.",
                                "zh": "一直<w>向前</w>走，直到到达红绿灯处。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forward",
                        "onwards",
                        "in front"
                    ],
                    "antonyms": [
                        "behind"
                    ],
                    "common_phrases": [
                        "straight ahead",
                        "go ahead",
                        "look ahead",
                        "dead ahead"
                    ],
                    "target_lang_definitions": {
