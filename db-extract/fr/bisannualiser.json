                "senses": [
                    {
                        "sense_id": "1e701159-8fb3-3438-a70f-e184c8b82785",
                        "entry_id": "abcc47fc-a743-3b91-9e12-eec729ea0244",
                        "glosses": [
                            "Donner un caractère bisannuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "727c3886-1ce4-4047-aabb-a8ba70b668f7",
                                "sense_id": "1e701159-8fb3-3438-a70f-e184c8b82785",
                                "text": "Bisannualiser certains cours à faible nombre d'étudiants pour dégager des ressources pour introduire de nouvelles activités."
                            },
                            {
                                "example_id": "d2553078-d6bd-4126-9adc-340289e5a42e",
                                "sense_id": "1e701159-8fb3-3438-a70f-e184c8b82785",
                                "text": "Les renseignements obtenus ultérieurement de la part du chef de service précisent qu’il s’agit dans la réalité de bisannualiser l'octroi de ce prix en raison notamment de la difficulté de trouver chaque année un lauréat."
                            },
                            {
                                "example_id": "7690f562-1f84-42c7-b79a-c7f92732a725",
                                "sense_id": "1e701159-8fb3-3438-a70f-e184c8b82785",
                                "text": "Les cours de littérature sont bisannualisés et regroupent les étudiants de BAC I et de BAC II."
                            }
                        ]
                    }
