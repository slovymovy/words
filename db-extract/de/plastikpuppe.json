                "senses": [
                    {
                        "sense_id": "4b382718-9c30-3560-8c90-d54f99b665cf",
                        "entry_id": "185eb445-43c0-318d-9d89-1b0f47001152",
                        "glosses": [
                            "Puppe aus Plastik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "943ccf96-433d-4a17-926c-831d9bb83160",
                                "sense_id": "4b382718-9c30-3560-8c90-d54f99b665cf",
                                "text": "„Auf dem Armaturenbrett vor dem Beifahrersitz klebt eine fünfzehn Zentimeter große Plastikpuppe, ein Mann in der Tracht der Credisten; weite Hosen, Wolljacke, Hut.“"
                            },
                            {
                                "example_id": "e5fc4837-9a53-438f-97b9-8fabdddd713d",
                                "sense_id": "4b382718-9c30-3560-8c90-d54f99b665cf",
                                "text": "„Sie lehnte gegen ein x-förmiges Kreuz, das aus zwei Holzstangen errichtet worden war, und die Wand hinter ihr war mit braunen Palmblättern, Plastikpuppen und Fetischen aus Mais verziert, die wie ein obszöner Heiligenschein oberhalb ihres Kopfes angeordnet waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
