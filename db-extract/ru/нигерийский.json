                "senses": [
                    {
                        "sense_id": "ea6be804-a5ac-321b-a405-e846138982b2",
                        "entry_id": "97be3a60-8dce-30f2-ac68-9bbc4671c666",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительными нигерийцы, Нигерия"
                        ],
                        "tags": [],
