{
    "word_family": [
        "restaurant",
        "restauration",
        "restaurateur",
        "restauratrice"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd61cebc-0986-3dba-b238-5ef642211c22",
                    "sense_definition": "Remettre en bon état un édifice, un meuble ancien ou une œuvre d'art.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "remise_en_etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette équipe de spécialistes va <w>restaurer</w> un tableau du dix-septième siècle très abîmé."
                        },
                        {
                            "text": "La commune a décidé de <w>restaurer</w> un monument historique situé au centre du village."
                        }
                    ],
                    "synonyms": [
                        "rénover",
                        "réparer",
                        "réhabiliter"
                    ],
                    "antonyms": [
                        "dégrader",
                        "détruire",
                        "abîmer"
                    ],
                    "common_phrases": [
                        "restaurer un tableau",
                        "restaurer un monument",
                        "restaurer une maison"
                    ]
                },
                {
                    "sense_id": "e72618b2-171f-34b3-aa54-5d77f984b651",
                    "sense_definition": "Reprendre des forces en mangeant, particulièrement sous la forme pronominale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue randonnée en montagne, nous nous sommes arrêtés pour nous <w>restaurer</w>."
                        },
                        {
                            "text": "Il est temps de se <w>restaurer</w> avant de reprendre la route pour le sud."
                        }
                    ],
                    "synonyms": [
                        "nourrir",
                        "sustenter"
                    ],
                    "antonyms": [
                        "affamer"
                    ],
                    "common_phrases": [
                        "temps de se restaurer",
                        "se restaurer rapidement"
                    ]
                },
                {
                    "sense_id": "17a20276-6121-3b46-9ddd-b0ff0879a675",
                    "sense_definition": "Rétablir une institution, un pouvoir, une loi ou une situation qui avait disparu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "retablissement_abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau gouvernement tente de <w>restaurer</w> la confiance auprès des citoyens."
                        },
                        {
                            "text": "Les forces de police ont réussi à <w>restaurer</w> l'ordre public dans les rues."
                        }
                    ],
                    "synonyms": [
                        "rétablir",
                        "réinstaurer"
                    ],
                    "antonyms": [
                        "abolir",
                        "renverser"
                    ],
                    "common_phrases": [
                        "restaurer la confiance",
                        "restaurer l'ordre",
                        "restaurer la paix"
                    ]
                },
                {
                    "sense_id": "a7ce59f6-fb7a-3e1d-8076-51787a788dd2",
                    "sense_definition": "Remettre un système informatique, une application ou un fichier dans un état antérieur de référence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le blocage de l'ordinateur, l'informaticien a dû <w>restaurer</w> le système d'exploitation."
                        },
                        {
                            "text": "Vous devez <w>restaurer</w> une sauvegarde pour retrouver vos documents perdus."
                        }
                    ],
                    "synonyms": [
                        "récupérer",
                        "réinstaller"
                    ],
                    "antonyms": [
                        "effacer",
                        "supprimer"
                    ],
                    "common_phrases": [
                        "restaurer le système",
                        "restaurer une sauvegarde",
                        "restaurer les données"
                    ]
                }
            ]
        }
    ]
}