{
    "word_family": [
        "cooperation",
        "cooperative",
        "cooperator",
        "uncooperative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f2d67a06-d5cb-3fca-9e7a-21db02911075",
                    "sense_definition": "To work or act together with others for a common purpose or benefit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "collaboration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two departments need to <w>cooperate</w> to finish the project on time.",
                            "target_lang_translations": {
                                "ru": "Двум отделам необходимо <w>сотрудничать</w>, чтобы закончить проект вовремя."
                            }
                        },
                        {
                            "text": "If we <w>cooperate</w> closely, we can achieve much better results for the community.",
                            "target_lang_translations": {
                                "ru": "Если мы будем тесно <w>взаимодействовать</w>, мы сможем достичь гораздо лучших результатов для общества."
                            }
                        }
                    ],
                    "synonyms": [
                        "coact",
                        "liaise"
                    ],
                    "antonyms": [
                        "compete",
                        "oppose",
                        "resist"
                    ],
                    "common_phrases": [
                        "cooperate closely",
                        "willing to cooperate",
                        "refuse to cooperate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать или действовать вместе с другими для достижения общей цели или выгоды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сотрудничать",
                                "target_lang_sense_clarification": "совместно заниматься деятельностью"
                            },
                            {
                                "target_lang_word": "взаимодействовать",
                                "target_lang_sense_clarification": "осуществлять взаимную связь"
                            },
                            {
                                "target_lang_word": "кооперироваться",
                                "target_lang_sense_clarification": "объединять усилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9492b47-a9e6-3700-8c39-c1be97797f8a",
                    "sense_definition": "To function in harmony or work together effectively side by side.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collaboration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The different software systems must <w>cooperate</w> seamlessly to process the data.",
                            "target_lang_translations": {
                                "ru": "Различные программные системы должны бесперебойно <w>взаимодействовать</w> друг с другом для обработки данных."
                            }
                        },
                        {
                            "text": "Even when the weather does not <w>cooperate</w>, the team continues their outdoor research.",
                            "target_lang_translations": {
                                "ru": "Даже когда погода не <w>благоприятствует</w>, команда продолжает свои полевые исследования."
                            }
                        }
                    ],
                    "synonyms": [
                        "play ball"
                    ],
                    "common_phrases": [
                        "weather didn't cooperate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Функционировать в гармонии или эффективно работать бок о бок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взаимодействовать",
                                "target_lang_sense_clarification": "о системах или факторах"
                            },
                            {
                                "target_lang_word": "содействовать",
                                "target_lang_sense_clarification": "способствовать успеху (например, о погоде)"
                            },
                            {
                                "target_lang_word": "согласованно работать",
                                "target_lang_sense_clarification": "действовать слаженно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44739b94-f6cc-31be-8aa3-8a4c90c79267",
                    "sense_definition": "To provide information to the police or authorities, often as a witness in a legal case.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_cooperation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect decided to <w>cooperate</w> with the police in exchange for a lighter sentence.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый решил <w>сотрудничать</w> с полицией в обмен на смягчение приговора."
                            }
                        },
                        {
                            "text": "The authorities are trying to <w>cooperate</w> the witness to build a stronger case against the gang.",
                            "target_lang_translations": {
                                "ru": "Власти пытаются <w>склонить к сотрудничеству</w> свидетеля, чтобы выстроить более веское обвинение против банды."
                            }
                        }
                    ],
                    "antonyms": [
                        "stonewall"
                    ],
                    "common_phrases": [
                        "cooperate with authorities",
                        "fully cooperate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять информацию полиции или властям, часто в качестве свидетеля по судебному делу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сотрудничать",
                                "target_lang_sense_clarification": "со следствием или властями"
                            },
                            {
                                "target_lang_word": "оказывать содействие",
                                "target_lang_sense_clarification": "помогать правоохранительным органам"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}