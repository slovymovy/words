                "senses": [
                    {
                        "sense_id": "a5e656a2-e55b-336f-88e0-735a695345cd",
                        "entry_id": "c8d8fc9f-67fc-3619-9d02-1c60df946d85",
                        "glosses": [
                            "Gefühl dafür, was sich im Umgang mit anderen Personen ziemt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6ba687a-9ff9-42d5-af99-3498d2018f51",
                                "sense_id": "a5e656a2-e55b-336f-88e0-735a695345cd",
                                "text": "„Außerdem, dachte sie, selbst wenn er sie nicht so schnell verläßt, aus falscher Gutmütigkeit und irregeleitetem Taktgefühl etwa, so muß ja doch jedenfalls die Schlange nach Locarno und in ihr Geschäft zurück.“"
                            },
                            {
                                "example_id": "20794b7c-4b1d-40a2-98fe-51b55b48de0b",
                                "sense_id": "a5e656a2-e55b-336f-88e0-735a695345cd",
                                "text": "„Schließlich sprach Roth seinen alten Freund Stu Lehmann an und fragte, ob sie über ein Thema sprechen könnten, das sie aus Taktgefühl gemieden hatten, als sie noch klein waren: die Erfahrung, als Kind seine Mutter zu verlieren und, wie Bucky Cantor in ›Nemesis‹, von den Großeltern aufgezogen zu werden.“"
                            },
                            {
                                "example_id": "ac8d76e5-57a4-49a9-9c7c-5e077cd47362",
                                "sense_id": "a5e656a2-e55b-336f-88e0-735a695345cd",
                                "text": "„Ich hatte den Eindruck, dass er sich im Bad besonders viel Zeit ließ, vielleicht aus Taktgefühl, sodass ich in meinem Pyjama unter die Bettdecke kriechen konnte, bevor er ins Zimmer kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddf6a288-0442-4647-91e9-ba85623c6198",
                        "source_entry_id": "c8d8fc9f-67fc-3619-9d02-1c60df946d85",
                        "source_sense_id": "a5e656a2-e55b-336f-88e0-735a695345cd",
                        "source_sense_description": "Gefühl dafür, was sich im Umgang mit anderen Personen ziemt",
                        "target_lang_word": "tact",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0558920-30b5-3874-a0a5-fe1dbdd3a920",
                                        "entry_id": "4d62ebe3-6e1a-3938-a20a-dd2d0f7068ec",
                                        "glosses": [
                                            "Sensitive mental touch; special skill or faculty; keen perception or discernment; ready power of appreciating and doing what is required by circumstances; the ability to say the right thing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5e06cf1-d35d-43f3-9c12-c263a5b6e773",
                                                "sense_id": "b0558920-30b5-3874-a0a5-fe1dbdd3a920",
                                                "text": "By the use of tact, she was able to calm her jealous husband."
                                            },
                                            {
                                                "example_id": "e028fee2-2e2c-4937-88de-327c7b7ca522",
                                                "sense_id": "b0558920-30b5-3874-a0a5-fe1dbdd3a920",
                                                "text": "I used tact when I told my fat uncle that his extra weight made him look better."
                                            },
                                            {
                                                "example_id": "8ee584fd-7712-4e97-ae2e-1602c8325469",
                                                "sense_id": "b0558920-30b5-3874-a0a5-fe1dbdd3a920",
                                                "text": "He had formed plans not inferior in grandeur and boldness to those of Richelieu, and had carried them into effect with a tact and wariness worthy of Mazarin."
                                            },
                                            {
                                                "example_id": "6f69870d-d3d0-4a4d-a10f-534191ce8b7f",
                                                "sense_id": "b0558920-30b5-3874-a0a5-fe1dbdd3a920",
                                                "text": "A tact which surpassed the tact of her sex as much as the tact of her sex surpassed the tact of ours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e865f88-872f-3dab-a08f-e1b24b11b99f",
                                        "entry_id": "4d62ebe3-6e1a-3938-a20a-dd2d0f7068ec",
                                        "glosses": [
                                            "Propriety; manners (etiquette)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5d42013-a32b-31bc-a1f9-8b73f640ae48",
                                        "entry_id": "461b20cf-75bb-3e5a-94c6-ea7285f6ee73",
                                        "glosses": [
                                            "The sense of touch; feeling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bd9440c-d384-4450-94be-9dfdde03feea",
                                                "sense_id": "c5d42013-a32b-31bc-a1f9-8b73f640ae48",
                                                "text": "Did you suppose that I could not make myself sensible to tact as well as sight?"
                                            },
                                            {
                                                "example_id": "80cbedd8-4f00-46f3-97a9-3e7eed0b68d0",
                                                "sense_id": "c5d42013-a32b-31bc-a1f9-8b73f640ae48",
                                                "text": "Now, sight is a very refined tact."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6f444a6-1ae5-3710-ab7f-568214aefc69",
                                        "entry_id": "461b20cf-75bb-3e5a-94c6-ea7285f6ee73",
                                        "glosses": [
                                            "The stroke in beating time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84bcadd1-627b-3681-92e9-f65dab999f80",
                                        "entry_id": "461b20cf-75bb-3e5a-94c6-ea7285f6ee73",
                                        "glosses": [
                                            "A verbal operant which is controlled by a nonverbal stimulus (such as an object, event, or property of an object) and is maintained by nonspecific social reinforcement (praise)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51cc8188-3e0e-4fe7-b163-c37218e0d72b",
                                                "sense_id": "84bcadd1-627b-3681-92e9-f65dab999f80",
                                                "text": "Skinner (1957) saw such tacts as responses that are reinforced socially."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29451d20-1780-3925-afbd-681a279425d6",
                                        "entry_id": "896cd779-097c-35ed-bfd6-01d27766d91f",
                                        "glosses": [
                                            "To use a tact (a kind of verbal operant)."
                                        ],
                                        "tags": [],
