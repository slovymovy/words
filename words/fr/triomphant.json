                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>triomphant</w> de ses peurs, elle a enfin osé prendre la parole devant un vaste public."
