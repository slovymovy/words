    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ad889205-ad4e-3622-ade5-502692070e41",
                    "sense_definition": "Qui est séparé par une distance spatiale ou temporelle plus ou moins grande ; éloigné.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "distance_spatiale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le village voisin est <w>distant</w> de cinq kilomètres de notre maison.",
                            "target_lang_translations": {
                                "en": "The neighbouring village is five kilometres <w>away</w> from our house.",
                                "ru": "Соседняя деревня <w>отстоит</w> от нашего дома на пять километров.",
                                "de": "Das Nachbardorf ist fünf Kilometer von unserem Haus <w>entfernt</w>.",
                                "es": "El pueblo vecino <w>dista</w> cinco kilómetros de nuestra casa.",
                                "zh": "邻村离我们家有五公里<w>远</w>。"
                            }
                        },
                        {
                            "text": "Ces deux villes sont <w>distantes</w> d'une cinquantaine de kilomètres seulement.",
                            "target_lang_translations": {
                                "en": "These two towns are only around fifty kilometres <w>apart</w>.",
                                "ru": "Эти два города <w>отстоят</w> друг от друга всего примерно на пятьдесят километров.",
                                "de": "Diese beiden Städte sind nur etwa fünfzig Kilometer voneinander <w>entfernt</w>.",
                                "es": "Estas dos ciudades <w>distan</w> solo unos cincuenta kilómetros.",
                                "zh": "这两座城市相<w>距</w>只有五十公里左右。"
                            }
                        }
                    ],
                    "synonyms": [
                        "éloigné"
                    ],
                    "common_phrases": [
                        "distant de"
                    ],
                    "target_lang_definitions": {
                        "en": "Separated from something by a greater or lesser spatial or temporal distance; far away.",
                        "ru": "Находящийся на значительном расстоянии в пространстве или во времени.",
                        "de": "Durch einen größeren oder kleineren räumlichen oder zeitlichen Abstand von etwas getrennt; weit weg.",
                        "es": "Que está a cierta distancia de algo en el espacio o en el tiempo; lejano.",
                        "zh": "与某物在空间或时间上相隔一定距离的；远的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "distant",
