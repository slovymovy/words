                        "entry_id": "0f2ff640-1734-3ba2-9cd8-c53d8cc853a0",
                        "glosses": [
                            "Nom vernaculaire de Sanguisorba minor plante dicotylédone, herbacée, vivace, au port érigé, de la famille des Rosacées (Rosaceae) dont les feuilles sont utilisées en salade, elle est originaire d’Eurasie à l'exception de l’Asie du sud-est."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69d4551b-127e-46ec-8e49-f2f87d751c6b",
                                "sense_id": "005a623d-0019-366a-baed-627e968e1727",
                                "text": "Ils mangèrent de la pimprenelle avec leur pain."
                            }
                        ]
                    },
                    {
                        "sense_id": "90b6ff42-6914-348b-93ac-31b26c34a15c",
                        "entry_id": "0f2ff640-1734-3ba2-9cd8-c53d8cc853a0",
                        "glosses": [
                            "Jeune fille un peu niaise."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "3cdf43ac-6f01-4df9-92f2-bb266e3d74c2",
                                "sense_id": "90b6ff42-6914-348b-93ac-31b26c34a15c",
                                "text": "Féministe de longue date, elle est faite d’un bois autrement consistant que les pimprenelles d’aujourd’hui - pas le genre à s’offenser d’une blague salace."
                            }
                        ]
                    }
