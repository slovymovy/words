                                        "sense_id": "2abafe4f-58dc-3517-b495-52ac2dcad12a",
                                        "entry_id": "9ff14fa4-4012-3b69-9a00-22fffcfbd350",
                                        "glosses": [
                                            "кулин. блюдо, приготовленное в такой сковороде"
                                        ],
