                                        "examples": [
                                            {
                                                "example_id": "637c5043-100d-41dc-82ad-f4706c4a3f16",
                                                "sense_id": "76ba4cfe-56b7-3ccf-9079-786a2cb0092e",
                                                "text": "Eva Kaili, the Greek MEP at the centre of a cash for influence scandal implicating Qatar, will remain in jail pending trial, a Belgian court has decided."
                                            },
                                            {
                                                "example_id": "ae1858c9-0b11-4365-bad5-5085218aff21",
                                                "sense_id": "76ba4cfe-56b7-3ccf-9079-786a2cb0092e",
                                                "text": "A French train carrying hundreds of MEPs and their teams from Brussels ended up by accident at Marne-la-Vallée, the stop for Disneyland Paris."
                                            }
                                        ]
                                    },
