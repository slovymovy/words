                    {
                        "sense_id": "2310f29b-fb9c-32c4-9052-fedb500a224f",
                        "entry_id": "f0240d4f-3575-3790-b6f2-358e4d269c02",
                        "glosses": [
                            "D’Alberto Fujimori ou qui est son partisan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e21adf96-2f38-4eb8-a5d4-1746d60767a3",
                                "sense_id": "2310f29b-fb9c-32c4-9052-fedb500a224f",
                                "text": "La méthode fujimoriste fut réutilisée le mois suivant par le Président argentin Carlos Menem."
                            },
                            {
                                "example_id": "e8e65c99-e708-4ada-89f7-97fcc9363816",
                                "sense_id": "2310f29b-fb9c-32c4-9052-fedb500a224f",
                                "text": "Keiko Fujimori, la fille de l’ex-président péruvien Alberto Fujimori emprisonné pour violations des droits de la personne, a lancé mercredi soir la formation Fuerza 2011, un front de fujimoristes pour l’élection présidentielle de 2011."
                            },
                            {
                                "example_id": "2283d737-9e2f-4db6-abf6-ca64e603dee0",
                                "sense_id": "2310f29b-fb9c-32c4-9052-fedb500a224f",
                                "text": "Le médecin de M. Fujimori et député fujimoriste, Alejandro Aguinaga, a rejeté ces derniers jours des spéculations de la presse sur un choix de la date de l’opération, qui viserait à générer un courant de sympathie en faveur de sa fille en pleine campagne présidentielle."
                            }
                        ]
                    }
                ],
