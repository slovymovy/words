                {
                    "sense_id": "c88d75b2-da31-35c6-ae33-61a0ee623ac6",
                    "sense_definition": "Of or relating to Japan, its people, language, or culture.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "japan_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves to cook traditional <w>Japanese</w> food for her family.",
                            "target_lang_translations": {
                                "ru": "Она любит готовить традиционную <w>японскую</w> еду для своей семьи.",
                                "zh": "她喜欢为家人做传统的<w>日本</w>料理。"
                            }
                        },
                        {
                            "text": "We visited a beautiful <w>Japanese</w> garden in the city center.",
                            "target_lang_translations": {
                                "ru": "Мы посетили красивый <w>японский</w> сад в центре города.",
                                "zh": "我们参观了市中心一座美丽的<w>日本</w>式花园。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Nipponese"
                    ],
                    "common_phrases": [
                        "Japanese culture",
                        "Japanese food",
                        "Japanese garden",
                        "Japanese style"
                    ],
                    "target_lang_definitions": {
