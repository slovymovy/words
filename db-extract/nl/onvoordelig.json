                                        ],
                                        "examples": [
                                            {
                                                "example_id": "267f1684-2495-43ca-aefa-bb1b487232d7",
                                                "sense_id": "4632eaae-a7a6-35ab-b117-6093ccdf1647",
                                                "text": "Microrefugia are sites that support populations of species when their ranges contract during unfavorable climate episodes."
                                            },
                                            {
                                                "example_id": "45aad6a1-7d88-413c-be4a-419ce65e600f",
                                                "sense_id": "4632eaae-a7a6-35ab-b117-6093ccdf1647",
                                                "text": "Alternatively, unfavorable outcome with severe or even fatal consequences for the organism would be the development of fibrolipid plaque which would be prone to plaque rupture and thrombus formation [ 23 ]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66fdd457-df36-4a34-ba88-ca75c4643433",
                        "source_entry_id": "1b00a3c7-2fb9-3bb9-b5c9-14d0e625afe3",
                        "source_sense_id": "bcaa9dea-d755-35a5-8291-c40dbc76d2fb",
                        "target_lang_word": "unfavourable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
