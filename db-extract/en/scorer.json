                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad8ce895-11a7-367a-a1e7-a41b4d8497e1",
                        "entry_id": "1e440b63-1e29-302f-8e26-8a974caaef61",
                        "glosses": [
                            "One who scores."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e38000f-8bec-4506-b201-d26dbe74b429",
                                "sense_id": "ad8ce895-11a7-367a-a1e7-a41b4d8497e1",
                                "text": "Alan Shearer finished among the top ten goal scorers in 10 out of his 14 seasons in the Premier League and won the top scorer title three times.."
                            },
                            {
                                "example_id": "e362acef-ceb3-4b12-89f4-759bf583b64b",
                                "sense_id": "ad8ce895-11a7-367a-a1e7-a41b4d8497e1",
                                "text": "But chances were rare for the lowest scorers in the Premier League against a Newcastle defence which claimed a fourth straight clean sheet."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1a53d8c-5ac3-3f2e-81c0-a70f7e562dcb",
                        "entry_id": "1e440b63-1e29-302f-8e26-8a974caaef61",
                        "glosses": [
                            "One who keeps track of scores in a game; a scorekeeper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f01235c9-b2eb-49af-94a4-eacd9b55ca47",
                                "sense_id": "f1a53d8c-5ac3-3f2e-81c0-a70f7e562dcb",
                                "text": "The team was making goals so fast the scorer could barely keep up."
                            },
                            {
                                "example_id": "a3f01c7e-6f93-4be2-8dc8-7101b63f5ff2",
                                "sense_id": "f1a53d8c-5ac3-3f2e-81c0-a70f7e562dcb",
                                "text": "The comment may be offered here that the 'heavies' have been the Design Award's principal scorers, both in the overall bronze plaque days and, since, in the Daily/Sunday Class 1."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb5c41da-0fb1-3a1d-8018-ded3a25007e7",
                        "entry_id": "1e440b63-1e29-302f-8e26-8a974caaef61",
                        "glosses": [
                            "Either of a pair of people, one provided by each side, who record in a specially formatted book, every ball bowled, every run scored, and every wicket that falls"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f78ea9b5-432c-44ad-baae-977680981e8b",
                        "source_entry_id": "1e440b63-1e29-302f-8e26-8a974caaef61",
                        "source_sense_description": "one who scores",
                        "target_lang_word": "buteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb7935c6-b354-3c08-8636-3cada334258a",
                                        "entry_id": "f720ee11-04e0-33b6-9e82-70c0a57c6828",
                                        "glosses": [
                                            "Personne qui marque un but, ou a l’habitude de marquer des buts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05abb64d-ad17-438e-8984-1cc2d66c9aa6",
                                                "sense_id": "eb7935c6-b354-3c08-8636-3cada334258a",
                                                "text": "C’est le meilleur buteur français de l’année."
                                            },
                                            {
                                                "example_id": "1579d118-474d-4b40-8558-f5729917484c",
                                                "sense_id": "eb7935c6-b354-3c08-8636-3cada334258a",
                                                "text": "En outre, Tondo Judith (FC GHK) et Nzuzi Vumungo (FC FT) ont été sacrées meilleures buteuses, avec chacune huit réalisations."
                                            },
                                            {
                                                "example_id": "21b7062a-dc66-45fa-b611-ddff8f7fda6c",
                                                "sense_id": "eb7935c6-b354-3c08-8636-3cada334258a",
                                                "text": "Le directeur sportif du Napoli - qui suit aussi le Rennais Yann M’vila - a également confirmé l’intérêt du club italien pour le meilleur buteur du Championnat de France (16 réalisations) : «on le suit avec des scouts parce que c’est un bon joueur»."
                                            },
                                            {
                                                "example_id": "8a807ee6-0dc9-4852-9adc-56a74392b116",
                                                "sense_id": "eb7935c6-b354-3c08-8636-3cada334258a",
                                                "text": "Les Cityzens, qui ont commencé sans leur buteur vedette, Erling Haaland, resté sur le banc, ne se sont pas rendus la tâche facile, avec l’expulsion, dès le 30ᵉ minute, de Sergio Gomez."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "638dadec-c4bb-4ab7-b930-d725823e0e8a",
                        "source_entry_id": "1e440b63-1e29-302f-8e26-8a974caaef61",
                        "source_sense_description": "one who scores",
                        "target_lang_word": "buteuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buteuse",
