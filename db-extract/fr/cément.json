                    {
                        "translation_id": "128b1705-2a4a-45b8-b019-f21ed1fba31e",
                        "source_entry_id": "8b2a20f9-4be7-3602-97fc-bfc2af45c87a",
                        "source_sense_id": "95f488bb-23ea-37cd-9b87-b4a675ca3e7a",
                        "source_sense_description": "substance qui recouvre la dent",
                        "target_lang_word": "cement",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cement",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1441b0d6-b9b3-390b-b355-3fd4967d3f85",
                                        "entry_id": "5c86b66f-8366-3e03-8267-af108a7bd3fb",
                                        "glosses": [
                                            "een bouwmateriaal bestaande uit kalk, zand en grind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f0fb77d-b50e-4a92-a8ec-2ae1ead04a63",
                                                "sense_id": "1441b0d6-b9b3-390b-b355-3fd4967d3f85",
                                                "text": "Het cement was in de truck hard geworden."
                                            },
                                            {
                                                "example_id": "2a3c79c7-d11e-4695-911e-2e89543685cd",
                                                "sense_id": "1441b0d6-b9b3-390b-b355-3fd4967d3f85",
                                                "text": "Het bindmiddel voor dit zogeheten brikkenbeton was geen cement, maar een mengsel van kalk en tras, gemalen tufsteen uit de Eifel. Het werd al in de Romeinse tijd gebruikt, onder andere voor de koepel van het Pantheon."
                                            },
                                            {
                                                "example_id": "160a5e6d-921c-4c32-b07e-281b17a3c35d",
                                                "sense_id": "1441b0d6-b9b3-390b-b355-3fd4967d3f85",
                                                "text": "De smurrie voelde lauw en hard aan. Als cement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37c52892-ddfe-36a1-8b8a-5344aa9fe2f6",
                                        "entry_id": "5c86b66f-8366-3e03-8267-af108a7bd3fb",
                                        "glosses": [
                                            "een vulstof voor onder andere kiezen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d63f3933-8e08-46cf-a37b-fc1f088d972c",
                                                "sense_id": "37c52892-ddfe-36a1-8b8a-5344aa9fe2f6",
                                                "text": "Zogenaamde retentievleugels zorgen voor het houvast aan de pijlers. De tandarts zet deze met cement vast: je kunt dit zelf niet verwijderen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6286be4-1301-308e-b7bf-7af47a2ea133",
                                        "entry_id": "5c86b66f-8366-3e03-8267-af108a7bd3fb",
                                        "glosses": [
                                            "iets wat een groter geheel bij elkaar houdt"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbb9a4e0-a8be-4ad1-ae7f-03f941245863",
                                                "sense_id": "f6286be4-1301-308e-b7bf-7af47a2ea133",
                                                "text": "Het cement van de samenleving."
                                            },
                                            {
                                                "example_id": "c555830d-38c4-4f38-ac0c-751f62fddb0e",
                                                "sense_id": "f6286be4-1301-308e-b7bf-7af47a2ea133",
                                                "text": "Er zit een gevarieerde groep tussen, die, hoe diffuus ook, één kenmerkt deelt: het zijn sociale stijgers: de ouders hebben ten opzichte van hún ouders een grote stap vooruit gemaakt in opleiding en inkomen, maar halen (nog) niet het opleidingsniveau en de werkomvang van de hogere middenklasse. Deze kinderen zijn het cement van de stad."
                                            }
                                        ]
                                    }
