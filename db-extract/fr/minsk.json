                                            {
                                                "example_id": "992a1814-3703-417e-9291-539c6af7df4d",
                                                "sense_id": "13bdff31-d2c4-32d5-8383-4a2f70dec6c3",
                                                "text": "Białorusini w Mińsku rozegrają mecz z reprezentacją Holandii, która wcześniej zapewniła sobie awans do mistrzostw Europy."
                                            }
