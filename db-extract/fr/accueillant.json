                        "target_lang_word": "ontvangen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ontvangen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f7b59636-ac59-3681-a9bf-de0fd9063f11",
                                        "entry_id": "c1e60a2c-85fe-3be0-b937-3c88eed58987",
                                        "glosses": [
                                            "het verkrijgen van zaken zoals loon en berichten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f2934c3-9fd3-40e3-818e-7f7d2dcd7f37",
                                                "sense_id": "f7b59636-ac59-3681-a9bf-de0fd9063f11",
                                                "text": "Hij ontving zijn salaris niet op tijd."
                                            },
                                            {
                                                "example_id": "ae116bec-0df8-4c19-9961-f1e33e3df29c",
                                                "sense_id": "f7b59636-ac59-3681-a9bf-de0fd9063f11",
                                                "text": "In Australië is het nu zelfs bij wet geregeld dat iedere werknemer na zeven jaar automatisch twee maanden betaald verlof ontvangt."
                                            },
                                            {
                                                "example_id": "be209c58-3ae2-4379-8125-cf3bc5e01cb3",
                                                "sense_id": "f7b59636-ac59-3681-a9bf-de0fd9063f11",
                                                "text": "Het STAP-budget is bedoeld om werkenden en werkzoekenden te stimuleren zich te laten om- of bijscholen. Wie aan de voorwaarden voldoet, kan een tegemoetkoming in de studiekosten ontvangen van maximaal 1.000 euro per jaar. Voorwaarde is wel dat de opleiding is gericht op huidig of toekomstig werk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb8ccf2a-1d1a-3388-8a5d-e199b04d3d51",
                                        "entry_id": "c1e60a2c-85fe-3be0-b937-3c88eed58987",
                                        "glosses": [
                                            "het op bezoek krijgen van gasten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70687c19-0fa3-449e-b184-426c74766d7e",
                                                "sense_id": "eb8ccf2a-1d1a-3388-8a5d-e199b04d3d51",
                                                "text": "Wij werden er als vorsten ontvangen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ontvangen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7645c5bc-c5c8-3fad-a2d2-22368aef5523",
                                        "entry_id": "17b98d09-af73-3c2c-9996-b8bbdc75f4b6",
                                        "glosses": [
                                            "voltooid deelwoord van ontvangen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d15f16e-c7f8-4380-b1c7-0d6a6bd2e39c",
                                                "sense_id": "7645c5bc-c5c8-3fad-a2d2-22368aef5523",
                                                "text": "Toen mijn kinderen eenmaal de brief hadden ontvangen en ik er met ze over sprak, merkte ik direct dat het veel minder indruk op ze had gemaakt dan op mij tijdens het schrijven."
                                            },
                                            {
                                                "example_id": "6b2322e5-5435-46f5-a5de-054b3d80da47",
                                                "sense_id": "7645c5bc-c5c8-3fad-a2d2-22368aef5523",
                                                "text": "Het ontvangen geld is niet genoeg."
                                            },
                                            {
                                                "example_id": "c3299df3-d0a6-4a20-9329-6b7ed0a565b4",
                                                "sense_id": "7645c5bc-c5c8-3fad-a2d2-22368aef5523",
                                                "text": "Het ontvangene is niet genoeg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a58cbcb5-3135-45c2-a585-b2160c9b73a9",
