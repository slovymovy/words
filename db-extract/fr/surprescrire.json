                "senses": [
                    {
                        "sense_id": "2a334306-dd02-32d5-9ef0-b2d88514e223",
                        "entry_id": "8372b63f-75c3-342c-b763-7015504d7d4a",
                        "glosses": [
                            "Prescrire excessivement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc2b90fb-4a06-470b-8f2c-05e343ed6f38",
                                "sense_id": "2a334306-dd02-32d5-9ef0-b2d88514e223",
                                "text": "Dans une ville, on connaît ceux qui surprescrivent des arrêts de travail."
                            },
                            {
                                "example_id": "54527d23-235e-47c8-91a4-7e697e41404e",
                                "sense_id": "2a334306-dd02-32d5-9ef0-b2d88514e223",
                                "text": "Attention à ne pas surprescrire: danger de résistances."
                            },
                            {
                                "example_id": "926b8269-3b46-4732-ac8b-c7b4157523a7",
                                "sense_id": "2a334306-dd02-32d5-9ef0-b2d88514e223",
                                "text": "Il y a par exemple conflit d’intérêt lorsque les prescripteurs des médicaments sont aussi les vendeurs (et donc enclins à surprescrire)."
                            }
                        ]
                    }
