                    {
                        "form_id": "6d403e6e-e9fd-45b6-bf66-81c953080c2b",
                        "entry_id": "f8bc3ff8-93d1-3572-8ef4-3003d07cee87",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Mangelerscheinungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "21d1b748-8dcc-3ada-8580-a4529282eaa7",
                        "entry_id": "f8bc3ff8-93d1-3572-8ef4-3003d07cee87",
                        "glosses": [
                            "Zustand, der durch ein Fehlen von bestimmten Nährstoffen oder Vitaminen gekennzeichnet ist; dies kann zu gesundheitlichen Problemen oder Beeinträchtigungen führen"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "ef5cdc6c-08a9-48ff-9f12-b795966cc229",
                                "sense_id": "21d1b748-8dcc-3ada-8580-a4529282eaa7",
                                "text": "„Da Vitamin B6 in den meisten Nahrungsmitteln in ausreichender Menge vorhanden ist, treten Mangelerscheinungen selten auf.“"
                            },
                            {
                                "example_id": "198c6166-7540-4d92-bd0b-1f3286e7d7df",
                                "sense_id": "21d1b748-8dcc-3ada-8580-a4529282eaa7",
                                "text": "[Riboflavin/Vitamin B2:] „Bei normaler Ernährung treten keine Mangelerscheinungen auf.“"
                            },
                            {
                                "example_id": "badfc23c-c534-4744-b64a-f5ac92cd2de5",
                                "sense_id": "21d1b748-8dcc-3ada-8580-a4529282eaa7",
                                "text": "„Die Insassen erhalten keine Früchte, weswegen oft Mangelerscheinungen auftreten.“"
                            },
                            {
                                "example_id": "73790b1b-9765-40d6-ad55-936b9d3364f9",
                                "sense_id": "21d1b748-8dcc-3ada-8580-a4529282eaa7",
                                "text": "„Wer für die Gesundheit hungert, sollte auf jeden Fall darauf achten, dass keine Mangelerscheinungen auftreten.“"
                            },
                            {
                                "example_id": "78da2da5-01a7-4d8e-80ae-2ec674f053f1",
                                "sense_id": "21d1b748-8dcc-3ada-8580-a4529282eaa7",
                                "text": "[Bei Sklerodermie] „ist die Aufnahmefähigkeit für Nährstoffe eingeschränkt, dadurch kann es zu Mangelerscheinungen kommen.“"
                            },
                            {
                                "example_id": "0e1f8aa6-e07f-4e4b-b23a-38c9d1dd26df",
                                "sense_id": "21d1b748-8dcc-3ada-8580-a4529282eaa7",
                                "text": "„Mangelerscheinungen können sich außerdem bei Magen-Darm-Erkrankungen, bestimmten Nahrungsmittelunverträglichkeiten oder Appetitlosigkeit (Anorexie) ergeben.“"
                            },
                            {
                                "example_id": "578eb30b-3ed5-4c41-9eeb-86287cd474e8",
                                "sense_id": "21d1b748-8dcc-3ada-8580-a4529282eaa7",
                                "text": "„Wer sich ausschließlich von Rohkost ernährt, kann also auch Mangelerscheinungen entwickeln.“"
                            },
                            {
                                "example_id": "fd99a341-f504-4da0-8237-8ec4024c141b",
                                "sense_id": "21d1b748-8dcc-3ada-8580-a4529282eaa7",
                                "text": "[Pantothensäure:] „Der tägliche Bedarf von etwa zehn Milligramm wird durch die Nahrung und die von den Darmbakterien gebildete Pantothensäure gedeckt, sodass ausgeprägte Mangelerscheinungen beim Gesunden nicht beobachtet werden.“"
                            },
                            {
                                "example_id": "8d71adbf-f77b-4e50-b66a-6b522b108460",
                                "sense_id": "21d1b748-8dcc-3ada-8580-a4529282eaa7",
                                "text": "„Relativ häufig haben Betroffene außerdem zugleich einen zu niedrigen Folsäure- und Zinkspiegel, was zu Mangelerscheinungen und Infektanfälligkeit führen kann.“"
                            },
                            {
                                "example_id": "ddb05e1b-3695-4453-ac32-db4e46a60c6e",
                                "sense_id": "21d1b748-8dcc-3ada-8580-a4529282eaa7",
                                "text": "[Vitamin K:] „Mangelerscheinungen und damit Blutgerinnungsstörungen entstehen bei ungenügender Resorption (Dünndarmerkrankungen, z. B. chronische Enteritis) oder nach Schädigung der Dünndarmschleimhaut durch Antibiotika.“"
                            },
                            {
                                "example_id": "22f95c56-67a3-4cf1-a234-ea45b550d4d0",
                                "sense_id": "21d1b748-8dcc-3ada-8580-a4529282eaa7",
                                "text": "„Die biologische Bedeutung des Arsens für den Menschen ist noch nicht vollständig geklärt. Es gilt als Spurenelement im Menschen, Mangelerscheinungen wurden aber bisher nur an Tieren nachgewiesen.“"
                            },
                            {
                                "example_id": "e51fbf44-6e91-4ad7-8b6b-17ec7bf373ff",
                                "sense_id": "21d1b748-8dcc-3ada-8580-a4529282eaa7",
                                "text": "[Schlagzeile:] „Mangelerscheinung bei Tomaten richtig behandeln“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
