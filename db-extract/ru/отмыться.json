                    {
                        "translation_id": "d3deba2d-ae93-4f80-bbf9-74f7e73eac12",
                        "source_entry_id": "ffff22dd-5eb1-3825-8c05-207eaf9269ac",
                        "source_sense_description": "исчезнуть, пропасть при мытье",
                        "target_lang_word": "come off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "come off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "883cb07b-7f2d-3a16-91cc-5edb509657b4",
                                        "entry_id": "a46ca322-9c6b-35a9-ba5e-d4523e85c629",
                                        "glosses": [
                                            "To become detached."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f027d02-9675-4423-9068-ad7c9b233314",
                                                "sense_id": "883cb07b-7f2d-3a16-91cc-5edb509657b4",
                                                "text": "One of the wagon wheels came off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f7cfafc-a491-31e6-b48a-c52e68f46e81",
                                        "entry_id": "a46ca322-9c6b-35a9-ba5e-d4523e85c629",
                                        "glosses": [
                                            "To have some success; to succeed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af9cd3f6-9e80-4661-97a8-11baceeb3548",
                                                "sense_id": "6f7cfafc-a491-31e6-b48a-c52e68f46e81",
                                                "text": "[…] the kind of second-drawer poems which do not quite come off in terms of total response but which poets are often reluctant to abandon because they are technically competent and a good deal of work has gone into them."
                                            },
                                            {
                                                "example_id": "8a0201dd-53a0-4c58-a970-05fab0201fed",
                                                "sense_id": "6f7cfafc-a491-31e6-b48a-c52e68f46e81",
                                                "text": "He tried his Chaplin impression, but it didn't really come off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86a2633f-c5b6-3ccd-babb-503e420875b5",
                                        "entry_id": "a46ca322-9c6b-35a9-ba5e-d4523e85c629",
                                        "glosses": [
                                            "To have an orgasm."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e26af7a5-239b-4850-a584-985b80b27a45",
                                                "sense_id": "86a2633f-c5b6-3ccd-babb-503e420875b5",
                                                "text": "She turned and looked at him. ‘We came off together that time,’ he said. […] ‘Don't people often come off together?’ she asked with naive curiosity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1477380-0c86-3039-802f-8b79e093fc80",
                                        "entry_id": "a46ca322-9c6b-35a9-ba5e-d4523e85c629",
                                        "glosses": [
                                            "To appear; to seem; to project a certain quality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05434afa-72ba-45a9-9daf-03120bdd3a91",
                                                "sense_id": "c1477380-0c86-3039-802f-8b79e093fc80",
                                                "text": "I'm sorry if I came off as condescending; that wasn't my intention."
                                            },
                                            {
                                                "example_id": "ffd24c2b-ab78-4773-ac80-a8f06fcea5e6",
                                                "sense_id": "c1477380-0c86-3039-802f-8b79e093fc80",
                                                "text": "You should be careful about how you come off during interviews."
                                            },
                                            {
                                                "example_id": "1b39e42c-74f4-43e4-98da-d5ee0f793062",
                                                "sense_id": "c1477380-0c86-3039-802f-8b79e093fc80",
                                                "text": "The task is complicated by the people with whom he must cope, including Rose, the martinet chair of the English Department; Connie, a frustrated, mercurial, and ultimately vindictive colleague (women do not come off well in this book); […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98db7d50-3e81-3c68-aa90-152311f5339a",
                                        "entry_id": "a46ca322-9c6b-35a9-ba5e-d4523e85c629",
                                        "glosses": [
                                            "To escape or get off (lightly, etc.); to come out of a situation without significant harm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e0df71-3ccc-49d0-a453-5870a5401124",
                                                "sense_id": "98db7d50-3e81-3c68-aa90-152311f5339a",
                                                "text": "Well that is precisely what I did, and as I had never heard of using gloves and veil in connection with bees I suppose I came off lightly with one sting on the tip of the nose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4542a7a5-7511-322b-a2d3-30726547786c",
                                        "entry_id": "a46ca322-9c6b-35a9-ba5e-d4523e85c629",
                                        "glosses": [
                                            "To occur; to take place; to turn out; to end up."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76496515-a33f-4aec-9cd3-28c354cd8979",
                                                "sense_id": "4542a7a5-7511-322b-a2d3-30726547786c",
                                                "text": "It came off as we expected."
                                            },
                                            {
                                                "example_id": "87f08732-a516-4f36-a4af-d8b3bd01b5f7",
                                                "sense_id": "4542a7a5-7511-322b-a2d3-30726547786c",
                                                "text": "The concluding ceremony came off at twelve o’clock on the day of departure […]"
                                            },
                                            {
                                                "example_id": "5c62ea7d-8994-474f-aa5f-abea414ac6af",
                                                "sense_id": "4542a7a5-7511-322b-a2d3-30726547786c",
                                                "text": "And then the wedding came off, and the king gave a grand feast which lasted for many a day, and if they have not done feasting by this, why they are still at it."
                                            },
                                            {
                                                "example_id": "19abc2c8-87dd-4b3b-99da-0c3001825920",
                                                "sense_id": "4542a7a5-7511-322b-a2d3-30726547786c",
                                                "text": "‘I was never frightened of any job yet,’ he said, ‘and I'd do this job to-night if the house was full of rozzers,’ Hill pretended that he wasn't particular whether the thing came off or not that night, but all the while he kept egging Fred on to do it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "193bdb9c-b9c4-3518-bcf7-76081cd3c75a",
                                        "entry_id": "a46ca322-9c6b-35a9-ba5e-d4523e85c629",
                                        "glosses": [
                                            "To come away (from a place); to leave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c2c3359-b65a-4215-a524-8f9e6658536d",
                                                "sense_id": "193bdb9c-b9c4-3518-bcf7-76081cd3c75a",
                                                "text": "The 290 bus route comes off the A316 at Hanworth."
                                            },
                                            {
                                                "example_id": "b165a600-3219-4acd-a397-2ada4301f94c",
                                                "sense_id": "193bdb9c-b9c4-3518-bcf7-76081cd3c75a",
                                                "text": "[…] Arnton Fell comes into sight across the Riccarton Burn and—more important—so does the Carlisle train, with an impatient-looking Pacific, Sir Visto, and several heads out of windows inquiring what the delay is and marvelling at the spectacle of an eight-coach train, garlanded at the front and quite full of passengers, coming off the single line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c063480-6a86-3d05-b66c-8476ba3fbf19",
                                        "entry_id": "a46ca322-9c6b-35a9-ba5e-d4523e85c629",
                                        "glosses": [
                                            "To finish being printed."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72cde4dc-77e6-4813-bbd8-051b05f8af17",
                                                "sense_id": "4c063480-6a86-3d05-b66c-8476ba3fbf19",
                                                "text": "This one came off easily."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f01442c-8780-301c-a816-d663549e9ab1",
                                        "entry_id": "a46ca322-9c6b-35a9-ba5e-d4523e85c629",
                                        "glosses": [
                                            "To quit (a drug or habit); to stop doing (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08b914d1-c3b2-3b47-a1e0-28c289a3583b",
                                        "entry_id": "a46ca322-9c6b-35a9-ba5e-d4523e85c629",
                                        "glosses": [
                                            "To stop playing (music)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd3195f8-e735-4715-b4cb-571eb91b2e9f",
                                                "sense_id": "08b914d1-c3b2-3b47-a1e0-28c289a3583b",
                                                "text": "I had to say, ‘Come off after the second beat, don’t hang on!’ (as per Mahler’s instructions)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
