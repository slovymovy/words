    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7183fbe7-ea14-3751-a256-6159323050ac",
                    "sense_definition": "Permitted or authorized to do something or to happen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Smoking is not <w>allowed</w> inside the office building.",
                            "target_lang_translations": {
                                "ru": "Курение внутри офисного здания не <w>разрешено</w>.",
                                "cs": "Kouření uvnitř kancelářské budovy není <w>povoleno</w>.",
                                "de": "Rauchen ist im Bürogebäude nicht <w>erlaubt</w>.",
                                "fr": "Il n'est pas <w>autorisé</w> de fumer à l'intérieur du bâtiment de bureaux.",
                                "zh": "办公楼内不<w>允许</w>吸烟。"
                            }
                        },
                        {
                            "text": "Are we <w>allowed</w> to bring our own food to the cinema?",
                            "target_lang_translations": {
                                "ru": "Нам <w>разрешено</w> приносить свою еду в кинотеатр?",
                                "cs": "Máme <w>dovoleno</w> přinést si do kina vlastní jídlo?",
                                "de": "Ist es uns <w>erlaubt</w>, unser eigenes Essen ins Kino mitzubringen?",
                                "fr": "Sommes-nous <w>autorisés</w> à apporter notre propre nourriture au cinéma ?",
                                "zh": "我们被<w>允许</w>自带食物进电影院吗？"
                            }
                        }
                    ],
                    "antonyms": [
                        "forbidden",
                        "prohibited",
                        "banned"
                    ],
                    "common_phrases": [
                        "not allowed",
                        "allowed to",
                        "legally allowed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрешённый или дозволенный для выполнения чего-либо.",
                        "cs": "Povolený nebo schválený k vykonání něčeho nebo k tomu, aby se to stalo.",
                        "de": "Erlaubt oder autorisiert, etwas zu tun oder zu geschehen.",
                        "fr": "Autorisé ou permis de faire quelque chose ou de se produire.",
                        "zh": "被允许或授权去做某事或发生某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрешённый",
                                "target_lang_sense_clarification": "санкционированный, не запрещённый"
                            },
                            {
                                "target_lang_word": "дозволенный",
                                "target_lang_sense_clarification": "разрешённый законом или правилами (более формально)"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "povolený",
                                "target_lang_sense_clarification": "schválený, nezakázaný"
