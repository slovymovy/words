                ],
                "senses": [
                    {
                        "sense_id": "ae32b83e-5791-3919-bf3e-235f3d7320d5",
                        "entry_id": "2c931c08-7bf5-3bf4-a613-b6edb3d61360",
                        "glosses": [
                            "(vom Geruch) her Moschus ähnelnd, an Moschus erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fac3682-7a2c-48ad-afeb-97b89bde2f91",
                                "sense_id": "ae32b83e-5791-3919-bf3e-235f3d7320d5",
                                "text": "„Er roch nach Schweiß, Wein, Rauch und moschusartigem Weihrauch.“"
                            },
                            {
                                "example_id": "32108ded-234e-4c48-8ac4-fcf06795ec7c",
                                "sense_id": "ae32b83e-5791-3919-bf3e-235f3d7320d5",
                                "text": "„Ein moschusartiger Duft stieg auf.“"
                            },
                            {
                                "example_id": "2097336e-ad81-4647-87fe-e6e6059b0d28",
                                "sense_id": "ae32b83e-5791-3919-bf3e-235f3d7320d5",
                                "text": "„Der kleine Raum war erfüllt vom Geruch des Honigs, den er auf ihren Körper gestrichen hatte, um die Fliegen anzulocken, umd vom moschusartigen Duft ihrer Erregung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
