                        "entry_id": "f2b156c7-3536-3e55-92dd-cd1992492d58",
                        "glosses": [
                            "Islamique et démocrate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e79edd-647c-4adc-a058-d2cf5d55a91b",
                                "sense_id": "2d21df20-6b70-33e1-bf32-deb409289fd6",
                                "text": "La référence à l’expérience islamo-démocrate turque a été omniprésente tout au long de la campagne pour les élections à la Constituante."
                            },
                            {
                                "example_id": "244f2b54-8153-40bd-9c93-4610ae7f37a5",
                                "sense_id": "2d21df20-6b70-33e1-bf32-deb409289fd6",
                                "text": "La spectaculaire arrestation d’une cinquantaine de militaires de haut rang, en retraite mais aussi d’active, soupçonnés d’avoir fomenté un coup d’État pour renverser le gouvernement islamo-démocrate du parti de la Justice et du Développement (PJD), souligne la mise sur la touche, douloureuse, d’une armée habituée à imprimer sa marque sur la vie politique du pays."
                            }
                        ]
                    }
