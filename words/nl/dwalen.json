    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f673b2f6-0fe3-3d44-85ee-f73668e3c990",
                    "sense_definition": "zonder specifiek doel of kennis van de weg rondlopen of reizen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rondlopen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We zijn uren door die vreemde stad <w>gedwaald</w> voordat we eindelijk een bekend plein zagen.",
                            "target_lang_translations": {
                                "en": "We <w>wandered</w> through that strange city for hours before we finally saw a familiar square."
                            }
                        },
                        {
                            "text": "De toeristen bleven urenlang <w>dwalen</w> door de smalle straatjes van de oude binnenstad.",
                            "target_lang_translations": {
                                "en": "The tourists kept <w>roaming</w> through the narrow streets of the old city center for hours."
                            }
                        }
                    ],
                    "synonyms": [
                        "ronddwalen",
                        "zwerven",
                        "rondzwerven"
                    ],
                    "common_phrases": [
                        "urenlang dwalen",
                        "door de straten dwalen"
                    ],
                    "target_lang_definitions": {
                        "en": "To walk or travel around without a specific goal or knowledge of the way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wander",
                                "target_lang_sense_clarification": "to move without purpose or destination"
                            },
                            {
                                "target_lang_word": "roam",
                                "target_lang_sense_clarification": "to travel freely over a wide area"
                            },
                            {
                                "target_lang_word": "stray",
                                "target_lang_sense_clarification": "to move away from the intended path"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ccc8e9ac-6a6c-3235-92b0-f45cba8ebf90",
                    "sense_definition": "een onjuiste mening hebben of moreel van het rechte pad afwijken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fout maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er werd bepaald dat de bisschop <w>gedwaald</w> had met deze omstreden uitspraak over het geloof.",
                            "target_lang_translations": {
                                "en": "It was determined that the bishop had <w>erred</w> with this controversial statement about the faith."
                            }
                        },
                        {
                            "text": "Wie denkt dat dit probleem vanzelf oplost zal ernstig <w>dwalen</w>.",
                            "target_lang_translations": {
                                "en": "Anyone who thinks this problem will solve itself is <w>mistaken</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mishebben",
                        "vergissen"
                    ],
                    "common_phrases": [
                        "ernstig dwalen"
                    ],
                    "target_lang_definitions": {
                        "en": "To hold an incorrect opinion or to deviate morally from the right path."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "err",
                                "target_lang_sense_clarification": "to make a mistake or be wrong, often in a formal or moral context"
                            },
                            {
                                "target_lang_word": "be mistaken",
                                "target_lang_sense_clarification": "to have an incorrect opinion"
                            },
                            {
                                "target_lang_word": "go astray",
                                "target_lang_sense_clarification": "to deviate from the correct moral or logical path"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2fc07f1a-4037-375e-bdaf-2ada743a6db2",
                    "sense_definition": "meervoud van <w>dwaal</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude <w>dwalen</w> werden uit de kast gehaald om de altaartafel mee te bedekken.",
                            "target_lang_translations": {
                                "en": "The old <w>altar cloths</w> were taken out of the cupboard to cover the altar table."
                            }
                        },
                        {
                            "text": "In de inventarislijst stonden verschillende linnen <w>dwalen</w> vermeld.",
                            "target_lang_translations": {
                                "en": "Several linen <w>cloths</w> were mentioned in the inventory list."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of 'dwaal', referring to altar cloths or long linen cloths."
                    },
                    "translations": {
