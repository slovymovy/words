                ],
                "senses": [
                    {
                        "sense_id": "e2ce8381-b76b-34b7-8f97-66ad39c6fa7c",
                        "entry_id": "c7a57182-ee8e-3d24-af92-137f2c77b668",
                        "glosses": [
                            "наивный мечтатель, самоотверженно борющийся за неосуществимые идеалы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "350191dd-b9fd-4a23-932e-12d8d9c65730",
                                "sense_id": "e2ce8381-b76b-34b7-8f97-66ad39c6fa7c",
                                "text": "Они – истинные донкихоты нашего времени, хранители и единственные носители романтического потенциала человечества – в этом их креcт и их награда..."
                            },
                            {
                                "example_id": "87cd0346-df62-4dc7-b0dc-fa39bdc98d47",
                                "sense_id": "e2ce8381-b76b-34b7-8f97-66ad39c6fa7c",
                                "text": "Я не готова к роли донкихота, который будет бороться с ветряными мельницами и пытаться менять менталитет собственников, привыкших работать именно так и не видящих в подобном подходе ничего странного (или незаконного)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "731fa8da-6ab6-40b0-9b01-44053ecb8ec9",
                        "source_entry_id": "c7a57182-ee8e-3d24-af92-137f2c77b668",
                        "source_sense_id": "e2ce8381-b76b-34b7-8f97-66ad39c6fa7c",
                        "target_lang_word": "don quixote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d6c498ad-3db3-4a94-895d-0f8c3623509d",
                        "source_entry_id": "c7a57182-ee8e-3d24-af92-137f2c77b668",
                        "source_sense_id": "e2ce8381-b76b-34b7-8f97-66ad39c6fa7c",
                        "target_lang_word": "knight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3ecfc9e-54dd-30cd-9b42-8f6622992698",
                                        "entry_id": "cd3771fd-2a70-3eab-ada2-ea1a203e5980",
                                        "glosses": [
                                            "A young servant or follower; a trained military attendant in service of a lord."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9c8faf1-f16a-4899-af87-6ed5d5bfd0bb",
                                                "sense_id": "f3ecfc9e-54dd-30cd-9b42-8f6622992698",
                                                "text": "Not all knights held fiefs, and it was not unusual for knights to buy themselves freedom from the obligations of the fief, or even to abscond with the arms provided by their lord, becoming a part of the large number of unenfeoffed, wandering knights available for hire […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00b77466-33e4-30fa-8acf-b259ba88c889",
                                        "entry_id": "cd3771fd-2a70-3eab-ada2-ea1a203e5980",
                                        "glosses": [
                                            "A minor nobleman with an honourable military rank who had served as a page and squire."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "175a43c4-01d8-3fff-9b2a-cd94e6fcd1d5",
                                        "entry_id": "cd3771fd-2a70-3eab-ada2-ea1a203e5980",
                                        "glosses": [
                                            "An armored and mounted warrior of the Middle Ages."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c21df70f-6a88-49d6-a5ab-ff2287e21cab",
                                                "sense_id": "175a43c4-01d8-3fff-9b2a-cd94e6fcd1d5",
                                                "text": "King Arthur and the Knights of the Round Table"
                                            },
                                            {
                                                "example_id": "21c46a07-ceed-45fc-9e69-680a6e3942c6",
                                                "sense_id": "175a43c4-01d8-3fff-9b2a-cd94e6fcd1d5",
                                                "text": "There are two tombs, each bearing effigies of a knight and his lady. One is 14th century, the other 15th century. The earlier knight wears chain mail and his lady has long, flowing hair. The later knight has plate armour, and his wife wears a wimple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87108200-9691-3406-af40-8283baf46e4e",
                                        "entry_id": "cd3771fd-2a70-3eab-ada2-ea1a203e5980",
                                        "glosses": [
                                            "A person obliged to provide knight service in exchange for maintenance of an estate held in knight's fee."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "368a5e2f-6d52-3588-a0bb-20715cdcac56",
                                        "entry_id": "cd3771fd-2a70-3eab-ada2-ea1a203e5980",
                                        "glosses": [
                                            "A person on whom a knighthood has been conferred by a monarch."
                                        ],
                                        "tags": [
                                            "modern"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0f3ddcb-5d7e-3693-bcef-de35f737352e",
                                        "entry_id": "cd3771fd-2a70-3eab-ada2-ea1a203e5980",
                                        "glosses": [
                                            "A brave, chivalrous and honorable man devoted to a noble cause or love interest."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ca4d25b-11ca-3450-b023-c8272335e0d4",
                                        "entry_id": "cd3771fd-2a70-3eab-ada2-ea1a203e5980",
                                        "glosses": [
                                            "A chess piece, often in the shape of a horse's head, that is moved two squares in one direction and one at right angles to that direction in a single move, leaping over any intervening pieces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91b709ba-8287-47c7-a44b-c759f07c4742",
                                                "sense_id": "1ca4d25b-11ca-3450-b023-c8272335e0d4",
                                                "text": "The knight may move to one of the squares nearest to that on which it stands but not on the same rank, file or diagonal. […] There are two knights, on the squares g1 and e1, and one of them moves to the square f3: either Ngf3 or Nef3, as the case may be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c3f8c39-0ec2-383f-afee-321f1cf4f0ec",
                                        "entry_id": "cd3771fd-2a70-3eab-ada2-ea1a203e5980",
                                        "glosses": [
                                            "A playing card bearing the figure of a knight; the knave or jack."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b726d6a-0bb8-31e2-98d4-6211ec6a1272",
                                        "entry_id": "cd3771fd-2a70-3eab-ada2-ea1a203e5980",
                                        "glosses": [
                                            "Any of various nymphalid butterflies of the genus Ypthima."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ac12acb-6fbb-3238-b1e7-cb0e41f36624",
                                        "entry_id": "cd3771fd-2a70-3eab-ada2-ea1a203e5980",
                                        "glosses": [
                                            "Any mushroom belonging to genus Tricholoma."
                                        ],
                                        "tags": [
                                            "modern"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d04110e4-aaac-3f55-8b2c-c0bbbf90b9e4",
                                        "entry_id": "cd3771fd-2a70-3eab-ada2-ea1a203e5980",
                                        "glosses": [
                                            "A species of nymphalid butterfly, Lebadea martha, found in tropical and subtropical Asia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "knight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdf9ff38-6fda-3c3c-800e-2820635158b2",
                                        "entry_id": "afe3fe4f-2538-372c-8dbb-4f15590dc371",
                                        "glosses": [
                                            "To confer knighthood upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a19f6ac6-4faf-462b-99f9-cab6d37d9e7f",
                                                "sense_id": "cdf9ff38-6fda-3c3c-800e-2820635158b2",
                                                "text": "The king knighted the young squire."
                                            },
                                            {
                                                "example_id": "86dfcc00-c286-471e-ada3-124de2ad42af",
                                                "sense_id": "cdf9ff38-6fda-3c3c-800e-2820635158b2",
                                                "text": "Highborn boys were sent off to another noble household at the age of about seven, to serve strenuously as pages and later as esquires to their lord before they themselves were knighted, looked around for a \"lady\" and incidentally got married and produced more knightlets, whom they never got to know at all well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc3cb5a6-d9be-3bb7-ba7f-1afca7434667",
                                        "entry_id": "afe3fe4f-2538-372c-8dbb-4f15590dc371",
                                        "glosses": [
                                            "To promote (a pawn) to a knight."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c388033-6007-485b-b302-79b756d7ed5e",
                        "source_entry_id": "c7a57182-ee8e-3d24-af92-137f2c77b668",
                        "source_sense_id": "e2ce8381-b76b-34b7-8f97-66ad39c6fa7c",
                        "target_lang_word": "knight-errant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knight-errant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20b8a907-cd45-3a13-ad5a-329fa8fdfe96",
                                        "entry_id": "5bfc02ba-f272-3bd0-9819-b00576d76229",
                                        "glosses": [
                                            "A knight in a medieval romance who wanders in search of adventure and opportunities to prove his chivalry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4125d9d-0017-4ca2-b4a8-0aee462a5714",
                                                "sense_id": "20b8a907-cd45-3a13-ad5a-329fa8fdfe96",
                                                "text": "In short, his wits being quite gone, [Don Quixote] hit upon the strangest notion that ever madman in this world hit upon, and that was that he fancied it was right and requisite, as well for the support of his own honour as for the service of his country, that he should make a knight-errant of himself, roaming the world over in full armour and on horseback in quest of adventures, and putting in practice himself all that he had read of as being the usual practices of knights-errant; righting every kind of wrong, and exposing himself to peril and danger from which, in the issue, he was to reap eternal renown and fame."
                                            },
                                            {
                                                "example_id": "5e645e16-4e59-4eab-af72-5c97a7f45c65",
                                                "sense_id": "20b8a907-cd45-3a13-ad5a-329fa8fdfe96",
                                                "text": "Before Tarzan had returned to the tribe, a certain young bull, not being able to secure a mate from among his own people, had, according to custom, fared forth through the wild jungle, like some knight-errant of old, to win a fair lady from some neighboring community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9109fb79-5c83-3cc8-95e2-ec3a9ba894c6",
                                        "entry_id": "5bfc02ba-f272-3bd0-9819-b00576d76229",
                                        "glosses": [
                                            "A person who displays an adventurous or a quixotic spirit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f87c27d3-9603-4402-8e46-2561283f5536",
                                                "sense_id": "9109fb79-5c83-3cc8-95e2-ec3a9ba894c6",
                                                "text": "\"Welcome, my young knight-errant!\" exclaimed Madame de Soissons. \"I am expecting you to do wonders.\" \"Nothing could be wonderful when performed in your service,\" replied the boy, with that readiness of compliment so characteristic of his time and court."
                                            },
                                            {
                                                "example_id": "47798769-ae06-48a6-964a-52a7065772ca",
                                                "sense_id": "9109fb79-5c83-3cc8-95e2-ec3a9ba894c6",
                                                "text": "It had known and served all the men of whom the nation is proud, from Sir Francis Drake to Sir John Franklin, knights all, titled and untitled - the great knights-errant of the sea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38cdfb1f-96dc-4cbc-9370-232ce4589e98",
                        "source_entry_id": "c7a57182-ee8e-3d24-af92-137f2c77b668",
                        "source_sense_id": "e2ce8381-b76b-34b7-8f97-66ad39c6fa7c",
                        "target_lang_word": "Don Quijote",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Don Quijote",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7bcd461-e83b-3c02-b73f-9bab2452d83d",
                                        "entry_id": "9db61651-5d99-31ab-a0f1-04329e4e51b0",
                                        "glosses": [
                                            "Titelheld eines Romans von Miguel de Cervantes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4d65c0c-c192-4af0-a641-af8e8558fe5b",
                                                "sense_id": "d7bcd461-e83b-3c02-b73f-9bab2452d83d",
                                                "text": "Der Knappe Sancho Pansa konnte seinen Herrn Don Quijote nicht davon abbringen, mit der Lanze gegen Windmühlenflügel anzurennen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e2b2c552-3a8a-34d9-bb3a-e0de21a6d37d",
                                        "entry_id": "9db61651-5d99-31ab-a0f1-04329e4e51b0",
                                        "glosses": [
                                            "für eine idealistische Person, die einen sinnlosen und aussichtslosen Kampf führt, da sie an den realen Gegebenheiten scheitert"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "378a7c2b-b348-4820-adfe-91f4618625f8",
                                                "sense_id": "e2b2c552-3a8a-34d9-bb3a-e0de21a6d37d",
                                                "text": "Wie Don Quijote wird er immer bestrebt sein, die Welt durch eine Einrichtung zu retten, durch die Errichtung einer Ordnung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
