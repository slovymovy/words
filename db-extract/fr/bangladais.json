                ],
                "senses": [
                    {
                        "sense_id": "921a5955-a2cf-33d4-b0d8-cc40b53e7e94",
                        "entry_id": "ce1343fb-8312-3b61-b5c8-0ecfef9daf04",
                        "glosses": [
                            "Habitant ou originaire du Bangladesh ^([1]) ^([2])."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c922b5dc-e99a-4052-930d-fb14526dac80",
                                "sense_id": "921a5955-a2cf-33d4-b0d8-cc40b53e7e94",
                                "text": "Au pire de l’épidémie, plus de 1000 Bangladais étaient hospitalisés chaque jour, ce qui n’avait pas été vu depuis 60 ans dans ce pays."
                            },
                            {
                                "example_id": "089bb299-f80e-4720-b1c7-95c530b4ac82",
                                "sense_id": "921a5955-a2cf-33d4-b0d8-cc40b53e7e94",
                                "text": "Les Bangladais parlent bengali."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03bf9e8b-d4ec-41d7-ad3f-a103ade85e2f",
                        "source_entry_id": "ce1343fb-8312-3b61-b5c8-0ecfef9daf04",
                        "source_sense_id": "921a5955-a2cf-33d4-b0d8-cc40b53e7e94",
                        "target_lang_word": "Bangladescher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bangladescher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22e089d6-0ef4-32e1-89bf-fe271deb4552",
                                        "entry_id": "97355503-432c-3d99-9143-d341ccfa7804",
                                        "glosses": [
                                            "Staatsbürger von Bangladesch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83ac53ee-14b0-47e3-9d07-1277d3410001",
                                                "sense_id": "22e089d6-0ef4-32e1-89bf-fe271deb4552",
                                                "text": "„Das Vereinigte Königreich ist nicht nur der historisch mehr oder weniger zufällige Zusammenschluss von England, Schottland, Wales und Nordirland – vier Nationen mit ausgeprägtem, eigenem Charakter –, es ist auch Heimat von zahllosen Indern, Pakistanern, Bangladeschern, Jamaikanern und vielen anderen Einwanderern aus dem Commonwealth.“"
                                            },
                                            {
                                                "example_id": "a861b75e-c5d4-443e-83a9-e9fd33126190",
                                                "sense_id": "22e089d6-0ef4-32e1-89bf-fe271deb4552",
                                                "text": "„Kein anderes Volk ist von Naturkatastrophen dermaßen geschlagen wie die 144 Millionen Bangladescher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26e06c4f-f9fe-4d98-a517-a3bd415215c4",
                        "source_entry_id": "ce1343fb-8312-3b61-b5c8-0ecfef9daf04",
                        "source_sense_id": "921a5955-a2cf-33d4-b0d8-cc40b53e7e94",
                        "target_lang_word": "Bangladescherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bangladescherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "308904c8-159f-317e-a7f9-bdc0579f44d6",
                                        "entry_id": "72cc813e-4401-35fe-adea-e8200d4e4f9b",
                                        "glosses": [
                                            "Staatsbürgerin von Bangladesch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bc7e050-7118-4bff-b60f-2c96aecf4d2b",
                                                "sense_id": "308904c8-159f-317e-a7f9-bdc0579f44d6",
                                                "text": "„Unter den restlichen rund 10 % (bzw. den verbleibenden 36'750 Muslimen und Musliminnen) dieser Gemeinschaft finden sich die über 1000 Personen umfassenden Nationalitätengruppen der Marokkaner/Marokkanerinnen (4'364), Somalier/Somalierinnen (3'655), Tunesier/Tunesierinnen (3'318), Iraker/Irakerinnen (3'171), Algerier/ Algerierinnen (2'654), Iraner/Iranerinnen (2'039), Afghanen/Afghaninnen (1'831), Pakistaner/Pakistanerinnen (1'681) und Libanesen/Libanesinnen (1'277), die zwischen 500 und 1000 Personen zählenden Nationalitätengruppen der Franzosen/Französinnen (993), Ägypter/Ägypterinnen (865), Italiener/Italienerinnen (805), Albaner/Albanerinnen (699) und Bangladescher/Bangladescherinnen (648) und Senegalesen/Senegalesinnen (562) und weitere, weniger als 500 Personen aufweisende Nationalitätengruppen aus allen Kontinenten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
