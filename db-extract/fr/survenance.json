                ],
                "senses": [
                    {
                        "sense_id": "1ef7e0b2-2fb1-38eb-a7d6-e0cdb36af027",
                        "entry_id": "1224a129-3d37-30a3-8c9e-84f1987675b6",
                        "glosses": [
                            "Arrivée que l’on n’a pas envisagée, surtout en parlant des enfants qui surviennent après une donation faite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "069bb7c2-55cc-41ab-b6bc-5934372272de",
                                "sense_id": "1ef7e0b2-2fb1-38eb-a7d6-e0cdb36af027",
                                "text": "Une donation est révoquée de droit par survenance d’enfants."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d4bb0a5-2635-3fa1-80a0-c873130a8ab7",
                        "entry_id": "1224a129-3d37-30a3-8c9e-84f1987675b6",
                        "glosses": [
                            "Arrivée, survenue d’un événement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4bccf67-89a6-4fb9-9ead-74de83ed753f",
                                "sense_id": "1d4bb0a5-2635-3fa1-80a0-c873130a8ab7",
                                "text": "Le non-respect de ces règles de sécurité est puni de peines d’amende prévues par le Code du travail, indépendamment de la survenance d’un accident du travail."
                            },
                            {
                                "example_id": "b38d3101-a3b1-4536-bd25-83839d08ecaa",
                                "sense_id": "1d4bb0a5-2635-3fa1-80a0-c873130a8ab7",
                                "text": "Un contrat d’assurance garantit à un ayant droit le paiement de certains capitaux lors de la survenance d’événements particuliers (sinistres), sous la condition du paiement par l’assuré d’une prime, fixée au préalable (ex ante) par l’organisme assureur."
                            },
                            {
                                "example_id": "320019b0-a893-461a-bb36-b705f3604517",
                                "sense_id": "1d4bb0a5-2635-3fa1-80a0-c873130a8ab7",
                                "text": "Au côté du dessinateur des plans, Me Coralie Devaud souligne que personne ne pouvait prévoir la survenance d’un tel accident, qu’un automobiliste puisse emprunter cette courte rampe fortement inclinée."
                            }
                        ]
                    }
