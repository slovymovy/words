                        "sense_id": "ddf0e4d2-1849-3fb9-a827-b1087b6bd478",
                        "entry_id": "2a83b9d6-db3e-38f3-9646-a3c495ecec9a",
                        "glosses": [
                            "Full of tiny pores that allow fluids or gasses to pass through."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57f1b69b-40dd-43c1-ac8c-3846a6bb6ab5",
                                "sense_id": "ddf0e4d2-1849-3fb9-a827-b1087b6bd478",
                                "text": "Sponges are porous so they can filter water while trapping food."
                            },
                            {
                                "example_id": "694f3f75-0321-4780-9304-e1f7e16943c7",
                                "sense_id": "ddf0e4d2-1849-3fb9-a827-b1087b6bd478",
                                "text": "Concrete is porous, so water will slowly filter through it."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d02f0c3-3ad1-3082-a62b-22181fcabf40",
                        "entry_id": "2a83b9d6-db3e-38f3-9646-a3c495ecec9a",
                        "glosses": [
                            "With many gaps or loopholes."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "217507cb-0d14-4720-bd25-02eae02cbb25",
                                "sense_id": "5d02f0c3-3ad1-3082-a62b-22181fcabf40",
                                "text": "However, Wolves ^([sic]) porous defence opened up again to gift Sunderland a foothold in the game - Sessegnon sweeping in a Zenden corner that was inexplicably allowed to bounce in the six-yard box."
                            },
                            {
                                "example_id": "37d70f17-7d74-42b3-b1bf-638cab599b02",
                                "sense_id": "5d02f0c3-3ad1-3082-a62b-22181fcabf40",
                                "text": "[…] a porous border consequently positioned migrants from Mexico and ethnic Mexicans residing in the United States as potential terrorists."
                            }
                        ]
                    }
