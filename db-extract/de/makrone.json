                        "glosses": [
                            "kleines, rundes Gebäck aus Marzipanrohmasse, Zucker und Eiklar und je nach Art anderen Zutaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95fd7135-36e7-4736-b755-5fd2a479cb40",
                                "sense_id": "86ada8b8-db27-3c36-9683-6b404f326726",
                                "text": "Meine Oma hat die besten Makronen der Welt gebacken."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
