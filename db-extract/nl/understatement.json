                        "sense_id": "3d170548-41e5-3afa-a6b9-d7fb181b7468",
                        "entry_id": "9b3c8a17-1739-3a39-91f2-91877ff9c5e0",
                        "glosses": [
                            "het doelbewust te zwak of onbeduidend verwoorden van iets, vaak met de bedoeling een ironisch effect te creëren waardoor het bedoelde juist extra sterk overkomt"
                        ],
                        "tags": [
                            "stijlfiguur"
                        ],
                        "examples": [
                            {
                                "example_id": "38e8293a-76ae-4c27-9ef9-817ec9d96fe3",
                                "sense_id": "3d170548-41e5-3afa-a6b9-d7fb181b7468",
                                "text": "\"Amsterdamse woningmarkt is weer in beweging\" is een voorbeeld van een understatement aangezien iedere Amsterdammer weet dat die markt totaal overspannen is"
                            },
                            {
                                "example_id": "86f16068-170a-48ac-8226-de6fcfc22be2",
                                "sense_id": "3d170548-41e5-3afa-a6b9-d7fb181b7468",
                                "text": "De latere criminoloog zag verschrikkelijke dingen, waarover hij nog steeds liever in understatements praat. ‘Laat ik zeggen dat er in het kamp geen grond te vinden bleek voor de aanname: de mens is goed.’"
                            }
                        ]
                    }
