    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8ec74644-5017-3156-b75e-e6743101a3cb",
                    "sense_definition": "Small items used in sewing, such as ribbons, buttons, thread, and needles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sewing_goods",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local department store has an entire floor devoted to <w>haberdashery</w> and fabrics.",
                            "target_lang_translations": {
                                "zh": "当地百货商店有一整层楼专门售卖<w>针线用品</w>和面料。"
                            }
                        },
                        {
                            "text": "She bought all the necessary <w>haberdashery</w> to repair the antique dress.",
                            "target_lang_translations": {
                                "zh": "她买齐了修补那件古董连衣裙所需的所有<w>缝纫小配件</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "notions"
                    ],
                    "common_phrases": [
                        "haberdashery department"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于缝纫的小物件，如丝带、纽扣、线和针等针线小用品。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "针线用具",
                                "target_lang_sense_clarification": "缝纫小物件、配件"
                            },
                            {
                                "target_lang_word": "缝纫用品",
                                "target_lang_sense_clarification": "缝纫用小百货"
                            },
                            {
                                "target_lang_word": "针线小百货",
                                "target_lang_sense_clarification": "缝纫辅料、小工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95e32242-115d-3a42-8258-950bdbba549e",
                    "sense_definition": "A shop that sells sewing supplies and accessories.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shops",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She visited the village <w>haberdashery</w> to pick up some matching embroidery silk.",
                            "target_lang_translations": {
                                "zh": "她去了村里的<w>缝纫用品店</w>，挑选了一些相配的刺绣丝线。"
                            }
                        },
                        {
                            "text": "The old <w>haberdashery</w> on the corner has been open for over fifty years.",
                            "target_lang_translations": {
                                "zh": "拐角处的那家老<w>针线百货店</w>已经开了五十多年了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "local haberdashery"
                    ],
                    "target_lang_definitions": {
                        "zh": "售卖缝纫小用品和配件的商店。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "针线百货店",
                                "target_lang_sense_clarification": "卖缝纫用具的商店"
                            },
                            {
                                "target_lang_word": "缝纫用品店",
                                "target_lang_sense_clarification": "卖缝纫配件、线和纽扣的店"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a826346e-a8a2-307b-a723-498b2b40328e",
                    "sense_definition": "A shop that sells men's clothing and accessories.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shops",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a fine silk tie at an upscale gentleman's <w>haberdashery</w> downtown.",
                            "target_lang_translations": {
                                "zh": "他在市中心一家高档绅士<w>服饰店</w>买了一条精致的丝绸领带。"
                            }
                        },
                        {
                            "text": "The traditional <w>haberdashery</w> catered to wealthy patrons seeking custom suits and hats.",
                            "target_lang_translations": {
                                "zh": "这家传统的<w>男式服饰店</w>专门服务于定制西装和帽子的富裕顾客。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gentleman's haberdashery"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North American usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（主要用于北美）售卖男士服装及服饰配件的商店。"
                    },
                    "translations": {
