                        "sense_id": "e781d8d6-e6d6-31f5-ba4a-82f963b77724",
                        "entry_id": "83a86de8-7687-3f91-988b-1a88c1db636f",
                        "glosses": [
                            "Marcher autour de quelque chose, tourner en rond."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "36764384-0de6-4107-ba40-add274af1bd5",
                                "sense_id": "e781d8d6-e6d6-31f5-ba4a-82f963b77724",
                                "text": "Trois heures à tuer le temps, en attente de notre dernière correspondance ; nous aurons le temps de circumdéambuler souvent …"
                            },
                            {
                                "example_id": "d69a675d-da02-4c09-81b3-9f2749ec5c3c",
                                "sense_id": "e781d8d6-e6d6-31f5-ba4a-82f963b77724",
                                "text": "Le Congrès Singulier établi un camp de base, qui permet, de faire des explorations journalières intra et extra campement, de circuler, de circonvoisiner, de circumdéambuler."
                            }
                        ]
                    }
