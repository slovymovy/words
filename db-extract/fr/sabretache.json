                                            {
                                                "example_id": "c21e27d3-d326-4131-b21a-6f2f475a1f70",
                                                "sense_id": "732df019-a9ce-3f78-9f16-499f05bdc44f",
                                                "text": "„Denissow lächelte, zog aus der Säbeltasche ein stark parfümiertes Schnupftuch und hielt es Neswitzkij unter die Nase.“"
                                            }
