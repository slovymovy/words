                "senses": [
                    {
                        "sense_id": "d580fecc-8c01-3ac8-8b57-389903eb4ad9",
                        "entry_id": "07d393f6-1195-311c-85b4-b2677e84c7a6",
                        "glosses": [
                            "taki, który odznacza się nieograniczoną potęgą"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [],
