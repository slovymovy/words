            "pos": "verb",
            "senses": [
                {
                    "sense_id": "38c5fdfc-dfd7-31df-a38d-c08a21528f86",
                    "sense_definition": "Accompagner une personne ou un convoi pour assurer sa protection, sa surveillance ou pour lui rendre hommage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protection_surveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deux motards de la police vont <w>escorter</w> l'ambulance jusqu'à l'hôpital le plus proche."
                        },
                        {
                            "text": "Les gardes du corps ont <w>escorté</w> le ministre à travers la foule bruyante."
                        }
                    ],
                    "synonyms": [
                        "convoyer",
                        "protéger"
                    ],
                    "common_phrases": [
                        "escorter un convoi",
                        "se faire escorter"
                    ]
                },
                {
                    "sense_id": "94631405-c15f-3552-baa1-dcd5cedc32ad",
                    "sense_definition": "Accompagner quelqu'un par courtoisie ou être associé à quelque chose de manière accessoire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "accompagnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a gentiment proposé d'<w>escorter</w> sa collègue jusqu'à sa voiture tard dans la soirée."
                        },
                        {
                            "text": "Un vin blanc sec venait <w>escorter</w> à merveille ce délicieux plateau de fruits de mer."
                        }
                    ],
                    "synonyms": [
                        "accompagner"
                    ],
                    "common_phrases": [
                        "escorter jusqu'à la porte"
                    ]
