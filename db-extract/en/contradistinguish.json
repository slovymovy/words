                "senses": [
                    {
                        "sense_id": "6e07ebaf-18c6-3530-b0d8-af4235704888",
                        "entry_id": "3f24f995-a6a5-3567-9ce6-c1b4e5076531",
                        "glosses": [
                            "To distinguish things by contrasting their different qualities."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "eeba9703-3a73-41e7-82a6-b2d86a9a288d",
                                "sense_id": "6e07ebaf-18c6-3530-b0d8-af4235704888",
                                "text": "Reason, therefore, here, as contradistinguished to faith, I take to be the discovery of the certainty or probability of such propositions or truths which the mind arrives at by deduction made from such ideas, which it has got by the use of its natural faculties ; viz. by sensation or reflection."
                            },
                            {
                                "example_id": "ef710fe8-bc56-4b23-8efb-92d756082d06",
                                "sense_id": "6e07ebaf-18c6-3530-b0d8-af4235704888",
                                "text": "A genuinely educative experience, then, one in which instruction is conveyed and ability increased, is contradistinguished from a routine activity on one hand, and a capricious activity on the other."
                            }
                        ]
                    }
                ],
