                        ]
                    },
                    {
                        "translation_id": "94f3a6fd-9631-45ac-8fec-8f8f616cf714",
                        "source_entry_id": "9211cfaa-e8c2-39cd-928d-049dd3810968",
                        "source_sense_description": "to assault or beat up",
                        "target_lang_word": "angreifen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "angreifen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56cd6db2-655f-35bc-b589-3fad53d40d9f",
                                        "entry_id": "44230340-13a4-3269-a2eb-46b6205f8d3e",
                                        "glosses": [
                                            "verbal oder physisch jemanden oder etwas attackieren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b182e04-0bd5-4e67-b4db-3a6f81e71112",
                                                "sense_id": "56cd6db2-655f-35bc-b589-3fad53d40d9f",
                                                "text": "Die Kreuzritter griffen die unbewaffneten Andersgläubigen an."
                                            },
                                            {
                                                "example_id": "2ec709b4-92e9-4fdd-8311-88739db16f7f",
                                                "sense_id": "56cd6db2-655f-35bc-b589-3fad53d40d9f",
                                                "text": "„Armeetruppen griffen die Millionenstadt Regimegegnern zufolge mit Kampfhubschraubern an.“"
                                            },
                                            {
                                                "example_id": "0b17e265-9021-4b1d-9b3e-f80ecd47d150",
                                                "sense_id": "56cd6db2-655f-35bc-b589-3fad53d40d9f",
                                                "text": "„[…] Russland greift sehr oft zivile Kraftwerke an, damit Strom und Heizung ausfallen – vor allem im Winter, wenn es kalt ist.“"
                                            },
                                            {
                                                "example_id": "79b89ae3-bba7-422e-99a3-f599b6217eee",
                                                "sense_id": "56cd6db2-655f-35bc-b589-3fad53d40d9f",
                                                "text": "„Tierschützer greifen oft Klimawissenschaftler an, nur weil diese darauf hinweisen, dass der Beitrag des Fleischessens im Vergleich zur Verbrennung fossiler Brennstoffe gering ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0ca9433f-9f21-3e57-832e-1fd1fba65b34",
                                        "entry_id": "44230340-13a4-3269-a2eb-46b6205f8d3e",
                                        "glosses": [
                                            "eine These zu falsifizieren oder eine Meinung zu widerlegen suchen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "19e21a37-1e04-3634-99ad-5ae740577809",
                                        "entry_id": "44230340-13a4-3269-a2eb-46b6205f8d3e",
                                        "glosses": [
                                            "jemanden oder etwas anfassen/berühren"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "949fccfb-b224-4182-8f73-e7ad89371f1e",
                                                "sense_id": "19e21a37-1e04-3634-99ad-5ae740577809",
                                                "text": "Wir sitzen im Trooper, und es ist so gegen vier Uhr am Morgen, nur noch Geladene sind da, und auch der Generaldirektor, der um Gottes Willen kein Generaldirektor ist, sondern vielleicht ein Aufseher oder so etwas, und der will, was er immer will, nämlich mir den Busen angreifen, weil der angeblich eine Sonderklasse ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
