                        "source_sense_description": "Gelände, das dafür eingerichtet/vorbereitet ist, dass darauf gezeltet werden kann",
                        "target_lang_word": "kampeerterrein",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kampeerterrein",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
