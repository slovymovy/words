                "senses": [
                    {
                        "sense_id": "b588b5d8-5429-37b5-8a74-e701499b7639",
                        "entry_id": "07aae99a-4e63-39cd-bd90-110ca54583a7",
                        "glosses": [
                            "etwas gut Schmeckendes (das zum Beispiel Hunden zur Belohnung gegeben wird)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "366f1725-0e9c-45bf-b778-00e8f9f94f49",
                                "sense_id": "b588b5d8-5429-37b5-8a74-e701499b7639",
                                "text": "„Ein Leckerli wird über die Nase des Hundes Richtung Stirn geführt.“"
                            },
                            {
                                "example_id": "5aa2d674-cb10-4fe7-ab09-928f78a76239",
                                "sense_id": "b588b5d8-5429-37b5-8a74-e701499b7639",
                                "text": "„Dies ist der erste Moment, in dem Sie ihn mit Worten loben und ihm ein Leckerli geben.“"
                            },
                            {
                                "example_id": "26128c6f-b12f-4f91-adb9-4a63fb7bdcf6",
                                "sense_id": "b588b5d8-5429-37b5-8a74-e701499b7639",
                                "text": "„Sie drehte sich zu den Tüten um, die sie mitgebracht hatte, und holte eine Packung Leckerli fürs Training heraus.“"
                            },
                            {
                                "example_id": "bcd39cda-91fe-43ad-881c-0db2220ec050",
                                "sense_id": "b588b5d8-5429-37b5-8a74-e701499b7639",
                                "text": "„Reichlich Leckerlis wird es auch für Sunny zum inoffiziellen Hundefeiertag geben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4a36edc1-0f0d-39aa-af61-85bc6da9e185",
                        "entry_id": "07aae99a-4e63-39cd-bd90-110ca54583a7",
                        "glosses": [
                            "kleines lebkuchenähnliches Gebäck"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "ac85f679-add4-4f53-83af-5df9d352bd73",
                                "sense_id": "4a36edc1-0f0d-39aa-af61-85bc6da9e185",
                                "text": "„Das Leckerli ist in den beiden Appenzeller Halbkantonen sowie im Toggenburg ganzjährig verbreitet. In Ausserrhoden ist das Leckerli besonders in der Fasnachtszeit beliebt, in Innerrhoden gilt es hingegen als typisches Landsgemeindegebäck.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fff1c2a1-95cb-48d3-9453-0328aa19027c",
                        "source_entry_id": "07aae99a-4e63-39cd-bd90-110ca54583a7",
                        "source_sense_id": "b588b5d8-5429-37b5-8a74-e701499b7639",
                        "source_sense_description": "etwas gut Schmeckendes (das zum Beispiel Hunden zur Belohnung gegeben wird)",
                        "target_lang_word": "friandise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "friandise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50d201ea-f3a0-3ffb-b3b1-567c999bf32c",
                                        "entry_id": "43647e3a-186b-305e-ad6c-20bc3a8b7912",
                                        "glosses": [
                                            "Confiserie ou pâtisserie de petite taille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2b8b761-d93a-4bd3-bc23-47f038dfaa81",
                                                "sense_id": "50d201ea-f3a0-3ffb-b3b1-567c999bf32c",
                                                "text": "Après avoir feuilleté l’album de classe, les DDEN, qui soutiennent ces projets dits « verts », ont remis des livres, un diplôme de jeunes jardiniers à la classe et des friandises."
                                            },
                                            {
                                                "example_id": "70733c8e-6ade-4dc3-a933-22a1daceb278",
                                                "sense_id": "50d201ea-f3a0-3ffb-b3b1-567c999bf32c",
                                                "text": "Il mettait de côté, pour les lui offrir, les friandises que parfois on lui donnait : un gâteau de seigle."
                                            },
                                            {
                                                "example_id": "7d30a8a4-2543-4040-abad-e0aa9d07f9b6",
                                                "sense_id": "50d201ea-f3a0-3ffb-b3b1-567c999bf32c",
                                                "text": "Les deux vaches, menées d’abord par la plus jeune des deux filles le long des routes, s’échappaient la plupart du temps dans les prés des Aigues ; mais comme au moindre délit trop flagrant pour que le garde se dispensât de le constater, les enfants étaient battus ou privés de quelque friandise, ils avaient acquis une habileté singulière pour entendre les pas ennemis, et presque jamais le garde champêtre ou le garde des Aigues ne les surprenaient en faute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56af6f27-88f6-3c36-ba2a-7a00f12c72a7",
                                        "entry_id": "43647e3a-186b-305e-ad6c-20bc3a8b7912",
                                        "glosses": [
                                            "Morceau fin et délicat."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44a26052-25d7-4c02-abe8-7400c7263b62",
                                                "sense_id": "56af6f27-88f6-3c36-ba2a-7a00f12c72a7",
                                                "text": "Outre les produits indiqués, il y avait là une foule de friandises venues de l’étranger, et une grande quantité de pâtisseries de luxe."
                                            },
                                            {
                                                "example_id": "81cf3025-94fa-423c-ae78-3504548a3fec",
                                                "sense_id": "56af6f27-88f6-3c36-ba2a-7a00f12c72a7",
                                                "text": "C’était des cœurs à chair épaisse, trop sucrée, du prime-fruit, de la friandise pour enfants."
                                            },
                                            {
                                                "example_id": "65daa100-aecf-4a9c-8256-2a6a21661a79",
                                                "sense_id": "56af6f27-88f6-3c36-ba2a-7a00f12c72a7",
                                                "text": "Entre le pouce et l’index, le gras d’un jambon de qualité fond presque instantanément. On respire d’abord le parfum envoûtant de cette friandise, avant de la laisser libérer en bouche des saveurs allant de la noisette à l’oxydation délicate du rancio, en passant par le voluptueux umami, cher aux Japonais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2686f43-5a48-3874-80a7-7713fb33542b",
                                        "entry_id": "43647e3a-186b-305e-ad6c-20bc3a8b7912",
                                        "glosses": [
                                            "Gourmandise, goût pour les bons morceaux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35dfc3df-79e7-4f25-82ba-19b96e163697",
                                                "sense_id": "c2686f43-5a48-3874-80a7-7713fb33542b",
                                                "text": "N’ayant guère dîné, je me suis mis à table affamé comme ma nièce, dont la friandise était sublime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ec1f25d-02aa-3b04-96e7-999ad6cf735a",
                                        "entry_id": "43647e3a-186b-305e-ad6c-20bc3a8b7912",
                                        "glosses": [
                                            "Personne ou chose agréable, au sens physique du terme."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b746d617-e025-4f1e-a70a-9e7a2b5a092d",
                                                "sense_id": "5ec1f25d-02aa-3b04-96e7-999ad6cf735a",
                                                "text": "J’étais quoi pour lui ? Une friandise ? Une parenthèse ? Un foyer d’accueil ouvert H24 pour obsédé sexuel ?"
                                            }
                                        ]
                                    }
                                ]
                            },
