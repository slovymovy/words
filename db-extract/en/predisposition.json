                    },
                    {
                        "translation_id": "bee9c2f9-7e94-478b-b2ca-edab108cd330",
                        "source_entry_id": "8c6cdac6-5207-3de4-b57c-219f18f01227",
                        "source_sense_id": "25de31f4-641b-31ed-bcc6-1274318676f9",
                        "source_sense_description": "the state of being predisposed",
                        "target_lang_word": "prédisposition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prédisposition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f5b2163-48ca-347e-8f3b-f6a24124fee1",
                                        "entry_id": "96e30646-a21e-3d18-a689-e9da8d5da48d",
                                        "glosses": [
                                            "Mise en dispositions favorables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7e8f157-dcee-4a59-b32e-35ef25ec97e3",
                                                "sense_id": "3f5b2163-48ca-347e-8f3b-f6a24124fee1",
                                                "text": "Au cours des dernières années, les affaires avaient marché cahin-caha, avec une prédisposition romanesque à l’insécurité, dans une petite échoppe délabrée ouvrant sur la Grand’Rue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb6bb5ff-998f-3641-b152-e93b8016d073",
                                        "entry_id": "96e30646-a21e-3d18-a689-e9da8d5da48d",
                                        "glosses": [
                                            "Ensemble de dispositions favorables existant d'emblée, avant l'événement qu'ils favoriseront."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7936e7ea-27bb-47f3-9798-a32e2bce6f92",
                                                "sense_id": "bb6bb5ff-998f-3641-b152-e93b8016d073",
                                                "text": "Une circonstance remarquable de l’hérédité, c’est la concentration, la mise en réserve, si nous pouvons nous exprimer ainsi, de certaines prédispositions qui passent sans se manifester sur une, deux ou trois générations pour apparaître ensuite sur un sujet donné."
                                            },
                                            {
                                                "example_id": "ffc91239-41d6-404d-97d1-3f210a434c00",
                                                "sense_id": "bb6bb5ff-998f-3641-b152-e93b8016d073",
                                                "text": "La génétique a révélé que nous avons des prédispositions innées à de nombreuses maladies."
                                            },
                                            {
                                                "example_id": "8d4d8fd2-c88b-4def-b935-4dd203c9e935",
                                                "sense_id": "bb6bb5ff-998f-3641-b152-e93b8016d073",
                                                "text": "Cette prédisposition est liée à une fragilité de la trame collagénique contenue dans le disque."
                                            },
                                            {
                                                "example_id": "5dd85610-4a3b-4f9c-bad4-7bf8b50ce339",
                                                "sense_id": "bb6bb5ff-998f-3641-b152-e93b8016d073",
                                                "text": "Toutefois, cette tentative audacieuse de remplacer les humains par les mathématiques a mal calculé l’incalculable: la prédisposition de l'humanité à s'immiscer dans le processus, à le modifier, à le spolier, à le manipuler et à s'y immiscer"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cef26593-392e-4041-9795-f3ae8127f1f3",
                        "source_entry_id": "8c6cdac6-5207-3de4-b57c-219f18f01227",
                        "source_sense_id": "25de31f4-641b-31ed-bcc6-1274318676f9",
                        "source_sense_description": "the state of being predisposed",
                        "target_lang_word": "Veranlagung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Veranlagung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17b98735-178a-3b96-a928-ce25fb62d036",
                                        "entry_id": "4ca552e4-15b7-3c70-97de-30eca0f1dbdc",
                                        "glosses": [
                                            "Neigung zu etwas; Charakterzug oder eine Eigenschaft (die oder der in seinen Grundzügen angeboren ist)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71a2cba3-f02f-423a-90e7-7113fc3164f4",
                                                "sense_id": "17b98735-178a-3b96-a928-ce25fb62d036",
                                                "text": "Die Veranlagung für viele Erkrankungen wird vererbt."
                                            },
                                            {
                                                "example_id": "cb5e4b83-153a-433d-a49e-b1a2f7c92013",
                                                "sense_id": "17b98735-178a-3b96-a928-ce25fb62d036",
                                                "text": "Geduld und andere Eigenschaften sind ein Mix aus genetischer Veranlagung und Erziehung."
                                            },
                                            {
                                                "example_id": "948f8fad-9b98-487e-9640-209e59cb29ea",
                                                "sense_id": "17b98735-178a-3b96-a928-ce25fb62d036",
                                                "text": "Ihre musikalische Veranlagung hat sie vom Opa mütterlicherseits."
                                            },
                                            {
                                                "example_id": "55b840fb-787f-466a-adb8-02ba858bb57f",
                                                "sense_id": "17b98735-178a-3b96-a928-ce25fb62d036",
                                                "text": "„Ist Homosexualität ein Produkt unserer genetischen Veranlagung oder des sozialen Umfelds? Eine Frage, auf die es bis heute keine eindeutige Antwort gibt.“"
                                            },
                                            {
                                                "example_id": "e1a620a1-c19c-4b52-a19a-9802408c98ef",
                                                "sense_id": "17b98735-178a-3b96-a928-ce25fb62d036",
                                                "text": "„Mit meiner Veranlagung habe ich aber vielleicht gut daran getan, mich nicht unwiderruflich zu binden, obwohl die Unabhängigkeit in meinem Alter eine Art von Sklaverei ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3626b0f0-4fcc-36a7-bc03-6738ec29d901",
                                        "entry_id": "4ca552e4-15b7-3c70-97de-30eca0f1dbdc",
                                        "glosses": [
                                            "Festlegung der Umstände und Höhe einer Besteuerung"
                                        ],
                                        "tags": [
                                            "Finanzamt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a26476c6-95a9-41f0-a195-7735f1ab2dd5",
                                                "sense_id": "3626b0f0-4fcc-36a7-bc03-6738ec29d901",
                                                "text": "Die Veranlagung erfolgt nach Ablauf des Veranlagungszeitraumes und bezieht sich auf das während dieses Zeitraums erzielte Einkommen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da3531be-aff9-45b1-9a84-5a46b46fbc09",
                        "source_entry_id": "8c6cdac6-5207-3de4-b57c-219f18f01227",
                        "source_sense_id": "25de31f4-641b-31ed-bcc6-1274318676f9",
                        "source_sense_description": "the state of being predisposed",
                        "target_lang_word": "Neigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40ec40dd-c044-397f-a9f1-9d0923b81f19",
                                        "entry_id": "77bb8b55-290b-3317-a61d-5cfb9956d592",
                                        "glosses": [
                                            "Vorgang des Schrägstellens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ca9f5f4-e20e-4bde-b635-0f9ea497bed9",
                                                "sense_id": "40ec40dd-c044-397f-a9f1-9d0923b81f19",
                                                "text": "Er begrüßte sie mit einer leichten Neigung des Kopfes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c276b6ca-c777-3a5d-ad11-d9a8d71556b8",
                                        "entry_id": "77bb8b55-290b-3317-a61d-5cfb9956d592",
                                        "glosses": [
                                            "Ergebnis: leichte Schräglage/ Schrägstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24fc9e40-5257-441f-bf47-2767835c34e8",
                                                "sense_id": "c276b6ca-c777-3a5d-ad11-d9a8d71556b8",
                                                "text": "Die Neigung des Weges war so gering, dass alle ihn ohne Mühe bewältigen konnten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e258557a-291c-3020-b0f1-8378b03242bb",
                                        "entry_id": "77bb8b55-290b-3317-a61d-5cfb9956d592",
                                        "glosses": [
                                            "Interesse, Sympathie, Vorliebe für etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d98075a6-5b06-40d6-92e4-8359b668ae09",
                                                "sense_id": "e258557a-291c-3020-b0f1-8378b03242bb",
                                                "text": "Seine Neigung gilt besonders Italien."
                                            },
                                            {
                                                "example_id": "10fa52b1-e36c-49bd-8b4f-3a03ec119ac7",
                                                "sense_id": "e258557a-291c-3020-b0f1-8378b03242bb",
                                                "text": "„Der junge Alexander zeigte eine Neigung zu langen Wanderungen.“"
                                            },
                                            {
                                                "example_id": "8814eb53-cb52-4eb4-9342-ea2d57eae46e",
                                                "sense_id": "e258557a-291c-3020-b0f1-8378b03242bb",
                                                "text": "„Und das Unternehmen zeigt keinerlei Neigung, die lukrative Rohstoffförderung einfach so in die Hände Lumumbas zu geben – die Firma erzielt im Kongo etwa die Hälfte ihrer jährlichen Gewinne.“"
                                            },
                                            {
                                                "example_id": "5660e9df-6265-456f-a5c1-0b114ea89871",
                                                "sense_id": "e258557a-291c-3020-b0f1-8378b03242bb",
                                                "text": "„Ich rate allen jungen Männern, die keinen Alkohol trinken möchten, auf ihre eigenen Neigungen zu hören und nicht mit Leib und Seele den gedankenlosen Einflüsterungen anderer zu folgen.“"
                                            },
                                            {
                                                "example_id": "a79bbb7c-dcbc-46d1-8dbe-6e506c107c3e",
                                                "sense_id": "e258557a-291c-3020-b0f1-8378b03242bb",
                                                "text": "„Nicht nur unsere obszönen, auch unsere feindseligen Neigungen sind der Zensur unterworfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "961e8e66-e051-3b18-ac87-4f01d3002546",
                                        "entry_id": "77bb8b55-290b-3317-a61d-5cfb9956d592",
                                        "glosses": [
                                            "Hang zu etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c4ee954-fa63-4269-8f2c-f6544b1a3031",
                                                "sense_id": "961e8e66-e051-3b18-ac87-4f01d3002546",
                                                "text": "Seine Neigung zum Alkohol wird ihm wohl noch zum Verhängnis."
                                            },
                                            {
                                                "example_id": "c80273dd-e4ec-40af-a000-c100cf7ee899",
                                                "sense_id": "961e8e66-e051-3b18-ac87-4f01d3002546",
                                                "text": "„Aus manchen Gesprächen mit Schefold kannte er die Neigung dieses schweren Deutschen, sich zu erregen, beispielsweise, wenn es um Bilder ging.“"
                                            },
                                            {
                                                "example_id": "7bab63b9-005f-4c62-9475-793f8e2bfa52",
                                                "sense_id": "961e8e66-e051-3b18-ac87-4f01d3002546",
                                                "text": "„Eine gute Dosis Aberglauben war für mich stets bezeichnend, und heute ist mir klar, daß diese Neigung alle Wechselfälle meines so ungewöhnlichen Lebens beeinflußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8dcf8d2b-453c-324d-a048-459c93e972ef",
                                        "entry_id": "77bb8b55-290b-3317-a61d-5cfb9956d592",
                                        "glosses": [
                                            "gefühlsmäßige Hinwendung zu Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54eb9108-0c45-449d-92d4-6e25a4be30a4",
                                                "sense_id": "8dcf8d2b-453c-324d-a048-459c93e972ef",
                                                "text": "Seine homosexuellen Neigungen wurden von seiner Familie ganz normal aufgenommen."
                                            },
                                            {
                                                "example_id": "03094df7-5632-449c-9108-5d83db8d3299",
                                                "sense_id": "8dcf8d2b-453c-324d-a048-459c93e972ef",
                                                "text": "Die Neigung seiner Familie hatte er sich mit seinem Lebenswandel verscherzt."
                                            },
                                            {
                                                "example_id": "1ee49c8d-9963-4a2e-99eb-ac903e833921",
                                                "sense_id": "8dcf8d2b-453c-324d-a048-459c93e972ef",
                                                "text": "„Er war bewegt, am bewegtesten durch das rückhaltlose Geständnis ihrer Neigung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
