        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "69541155-37ca-3ad1-ac28-58617054a804",
                "word": "toddy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b0a9dc1c-2fe7-45d5-b1f6-9b3a5ee7bdd9",
                        "entry_id": "69541155-37ca-3ad1-ac28-58617054a804",
                        "tags": [
                            "plural"
                        ],
                        "form": "toddies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a32a42a-7c56-3e77-8fee-0afdc3c48a1a",
                        "entry_id": "69541155-37ca-3ad1-ac28-58617054a804",
                        "glosses": [
                            "Ellipsis of hot toddy."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "countable",
                            "ellipsis",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "078c4be6-f7e7-45bf-b8e4-297535e99a38",
                                "sense_id": "8a32a42a-7c56-3e77-8fee-0afdc3c48a1a",
                                "text": "Yonatan brings them all dandelion toddies and places down a caddy on the center of their table crowded with bottles of hot sauce, packets of tapioca pearls, salt, utensils, and miniature divination games"
                            }
                        ]
                    },
                    {
                        "sense_id": "3ba1c2d8-b5fd-3955-91aa-a5a161abcd86",
                        "entry_id": "69541155-37ca-3ad1-ac28-58617054a804",
                        "glosses": [
                            "The sweet sap from any of several tropical trees fermented to make an alcoholic drink."
                        ],
                        "tags": [
                            "countable",
                            "dated",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d090112a-0cce-474c-a795-d6a8269c0d22",
                                "sense_id": "3ba1c2d8-b5fd-3955-91aa-a5a161abcd86",
                                "text": "[…] the cocoa-nut tree yields a pure draught from a dry and barren land; a cup of water to the temperate and thirsty traveler; a cup of cream from the pressed kernel; a cup of refreshing and sparkling toddy to the early riser; […]"
                            },
                            {
                                "example_id": "85ba28ba-3c0f-4f49-bf58-1ada6d146988",
                                "sense_id": "3ba1c2d8-b5fd-3955-91aa-a5a161abcd86",
                                "text": "Moti Guj was very fond of liquor—arrack for choice, though he would drink palm-tree toddy if nothing better offered."
                            },
                            {
                                "example_id": "63e7a014-0c60-4933-90cc-3d00cfcbe2bd",
                                "sense_id": "3ba1c2d8-b5fd-3955-91aa-a5a161abcd86",
                                "text": "A turban and loincloth soaked in blood had been found; also a staff. These properties were known to have belonged to a toddy drawer. He had disappeared."
                            }
                        ]
                    },
                    {
                        "sense_id": "5566b212-ee04-3359-ac5e-4b83b3741a87",
                        "entry_id": "69541155-37ca-3ad1-ac28-58617054a804",
                        "glosses": [
                            "The drink itself."
                        ],
                        "tags": [
                            "India",
                            "South",
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4205b953-b0fc-4e78-951c-ed143179a2ac",
                        "source_entry_id": "69541155-37ca-3ad1-ac28-58617054a804",
                        "source_sense_description": "hot toddy",
                        "target_lang_word": "grog",
