                ],
                "senses": [
                    {
                        "sense_id": "89ff23f3-a614-3f18-ba0b-30dcc17405cd",
                        "entry_id": "c9c78433-eef5-348b-9902-e2f46e970c52",
                        "glosses": [
                            "Wurf mit einem Stein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6dfe1c8-441e-4316-8623-2596e7ee8a56",
                                "sense_id": "89ff23f3-a614-3f18-ba0b-30dcc17405cd",
                                "text": "Für den Steinwurf bei der Demonstration musste er sich vor Gericht verantworten."
                            },
                            {
                                "example_id": "6acddac2-1751-4cf7-9ec3-19b7a20610cb",
                                "sense_id": "89ff23f3-a614-3f18-ba0b-30dcc17405cd",
                                "text": "„In den Jahren vor dem Steinwurf lebte er sowohl in einem Schwesternwohnheim, das auch andere Mieter aufnimmt, als auch in der Gartenhaussiedlung auf einer Parzelle ganz am Rand, fast schon im Wald.“"
                            },
                            {
                                "example_id": "336fb14c-8823-40f5-8330-b8bb175bcbfb",
                                "sense_id": "89ff23f3-a614-3f18-ba0b-30dcc17405cd",
                                "text": "„Die Steinwürfe des Blonden werden heftiger, aber auch hörbar schmerzhafter; die Größe der Steine nimmt zu, sichtbar auch die Schärfe ihrer Kanten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3fecc29d-0fcd-3c79-b895-45f2bf9dbf60",
                        "entry_id": "c9c78433-eef5-348b-9902-e2f46e970c52",
                        "glosses": [
                            "geringe Entfernung, kurzer Weg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78353523-4428-45f0-b0a8-947030318358",
                                "sense_id": "3fecc29d-0fcd-3c79-b895-45f2bf9dbf60",
                                "text": "Die Staatsoper ist nur einen Steinwurf von meiner Wohnung entfernt."
                            },
                            {
                                "example_id": "d799a16b-5437-4e87-ad5b-6bbe12ae443f",
                                "sense_id": "3fecc29d-0fcd-3c79-b895-45f2bf9dbf60",
                                "text": "„Einen Steinwurf von der Kirche entfernt lag das Hospital, und plötzlich schreckte Obram durch einen Schrei auf.“"
                            },
                            {
                                "example_id": "f1aa9535-44b7-41e9-9624-c6bc7e9e4b85",
                                "sense_id": "3fecc29d-0fcd-3c79-b895-45f2bf9dbf60",
                                "text": "„Einen Steinwurf entfernt entdeckte er ein totes Pferd, dessen Reiter gerade sterben wollte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
