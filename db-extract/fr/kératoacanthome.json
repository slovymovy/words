                "senses": [
                    {
                        "sense_id": "41d93c56-46a9-328e-8a2b-44801e7c7d49",
                        "entry_id": "bcc3227a-a92e-35cb-bd91-0a2219c49032",
                        "glosses": [
                            "Tumeur épithéliale d’évolution favorable, considérée depuis 2018 par l’OMS comme un variant du carcinome épidermoïde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "502325de-e5d7-423d-8248-3508e7e9ae63",
                                "sense_id": "41d93c56-46a9-328e-8a2b-44801e7c7d49",
                                "text": "Le kératoacanthome est une forme de carcinome épidermoïde de faible malignité."
                            },
                            {
                                "example_id": "9f1c95b7-24a1-41ed-b20c-85106f2dc505",
                                "sense_id": "41d93c56-46a9-328e-8a2b-44801e7c7d49",
                                "text": "« A ce jour, il n’y a pas de preuve que les encres de tatouage donnent un cancer de la peau ou d’ailleurs. Il n’y a qu’une seule lésion tumorale pour laquelle on a un lien fort : le kératoacanthome, qui apparaît très vite après un tatouage rouge. Et cela reste exceptionnel, avec une cinquantaine de cas dans le monde. »"
                            },
                            {
                                "example_id": "9c27ae0d-bf9f-4554-bab1-91786cf19302",
                                "sense_id": "41d93c56-46a9-328e-8a2b-44801e7c7d49",
                                "text": "Une seule lésion particulière, le « kératoacanthome » que nous considérons comme une tumeur d’évolution favorable, semble pouvoir survenir après un tatouage."
                            }
                        ]
                    }
                ],
