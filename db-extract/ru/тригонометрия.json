                    },
                    {
                        "translation_id": "9a53e5aa-f655-4330-9b04-b6552b5c802b",
                        "source_entry_id": "268ae0ee-9914-35f4-b1be-7a0de9091728",
                        "source_sense_id": "71f6dae1-0783-3b0a-8cf0-6668381f455a",
                        "target_lang_word": "Trigonometrie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trigonometrie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e4f44f1-825c-33af-b612-cbc735ce0e00",
                                        "entry_id": "b883e2ad-1802-374f-a970-76e2c950aa0d",
                                        "glosses": [
                                            "Teilgebiet, das sich mit der Berechnung und Bestimmung der fehlenden unbekannten Größen (Winkel, Seitenlängen) eines gegebenen Dreiecks beschäftigt"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b787eec3-e378-4b5c-bd25-83c5195815b9",
                                                "sense_id": "4e4f44f1-825c-33af-b612-cbc735ce0e00",
                                                "text": "Während die klassische Geometrie mit algebraischen Funktionen operiert, arbeitet die Trigonometrie mit transzendenten Funktionen."
                                            },
                                            {
                                                "example_id": "cae3c0ea-8c42-4c6c-b1a3-966de457b636",
                                                "sense_id": "4e4f44f1-825c-33af-b612-cbc735ce0e00",
                                                "text": "in der (Anwendung der) Trigonometrie benutzte man in den sechziger Jahren noch Tabellenwerke anstelle der heute üblichen Taschenrechner mit trigonometrischen Funktionen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e0612a0-3f50-48be-8e5d-2db34030498c",
                        "source_entry_id": "268ae0ee-9914-35f4-b1be-7a0de9091728",
                        "source_sense_id": "71f6dae1-0783-3b0a-8cf0-6668381f455a",
                        "target_lang_word": "goniometrie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goniometrie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a2472db4-c443-3376-a13c-77a81ea084fe",
                                        "entry_id": "50716fa8-5b5c-3a93-9c42-7ca350f2fa61",
                                        "glosses": [
                                            "dat deel van de wiskunde dat zich richt op hoeken en de metingen die men daaraan kan verrichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c1fe000-73b9-48a0-94ec-9c14d9fe9869",
                                                "sense_id": "a2472db4-c443-3376-a13c-77a81ea084fe",
                                                "text": "'Met barokmuziek en totale ontspanning kunnen...' Titi las de flaptekst van het boek, 'informatiestromen verdriedubbeld worden... en je leert dus drie keer zoveel. Drie keer zo snel. Alles!' Wat keek hij toch enthousiast. Hij begon weer te lezen. 'Dr. G.B.J. Bitov leerde zijn witte muizen achtereenvolgens Duits, Chinees en goniometrie."
                                            },
                                            {
                                                "example_id": "687ce5cb-13b7-4ce8-a1e2-38548c35f98b",
                                                "sense_id": "a2472db4-c443-3376-a13c-77a81ea084fe",
                                                "text": "Hoe nu? De oplossing komt van twee kanten. In de eerste plaats is er het simpele feit dat wij vanaf onze hoge plaats op de aardbol (52 graden boven de evenaar) de satellieten zo’n 7,5 graden onder de hemelequator geprojecteerd zien. Het valt met simpele goniometrie uit te rekenen en het zit hem in die 6,6 aardstralen, waren dat er 660 geweest dan hadden we de satelliet wel op de equator gezien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
