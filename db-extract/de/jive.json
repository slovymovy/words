                        "form": "die Jives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e1154ffc-b0ba-3f85-81cd-f19dc24a3906",
                        "entry_id": "18a44ca1-514d-3268-b998-26d60d299133",
                        "glosses": [
                            "die gezähmte Variante des Jitterbugs, die ohne besondere Kunstfiguren getanzt und seit 1968 als fünfter Tanz der lateinamerikanischen Standardtänze geführt wird"
                        ],
                        "tags": [
                            "Tanz"
                        ],
                        "examples": [
                            {
                                "example_id": "5018eb20-5616-4719-bc8b-5f725874389b",
                                "sense_id": "e1154ffc-b0ba-3f85-81cd-f19dc24a3906",
                                "text": "Der Boogie-Woogie und der Rock'n Roll basieren auf dem Jive."
                            },
                            {
                                "example_id": "c57aa0d9-efc4-4968-a9c9-df6c222bec65",
                                "sense_id": "e1154ffc-b0ba-3f85-81cd-f19dc24a3906",
                                "text": "„Zu der Zeit waren diese Röcke mit den zwei Pettycoats darunter in Mode. Die konnte man herumsausen lassen, wenn man den Jive tanzte — also tanzte ich eine Menge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1b49cb2f-be77-3995-aeda-89d26f6e4dd5",
                        "entry_id": "18a44ca1-514d-3268-b998-26d60d299133",
                        "glosses": [
                            "eine spezielle Art Swingmusik"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "019e89c6-2a7b-4471-8228-fa9f2ff407fd",
                        "source_entry_id": "18a44ca1-514d-3268-b998-26d60d299133",
                        "source_sense_id": "e1154ffc-b0ba-3f85-81cd-f19dc24a3906",
                        "target_lang_word": "jive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d785ac17-64d9-3fe1-832a-44a1689571ff",
                                        "entry_id": "cdf74738-72fb-3483-891b-312d3b4c9771",
                                        "glosses": [
                                            "To deceive; to be deceptive."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceeb296b-b0b6-47dc-b2fb-eae238490308",
                                                "sense_id": "d785ac17-64d9-3fe1-832a-44a1689571ff",
                                                "text": "Don’t try to jive me! I know where you were last night!"
                                            },
                                            {
                                                "example_id": "d442a78e-3c4c-4b4e-85ff-1143899c3db9",
                                                "sense_id": "d785ac17-64d9-3fe1-832a-44a1689571ff",
                                                "text": "It's the year when all of the white politicians will be back in the so-called Negro community jiving you and me for some votes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71287706-f6f2-372d-b5a2-16c764064a40",
                                        "entry_id": "cdf74738-72fb-3483-891b-312d3b4c9771",
                                        "glosses": [
                                            "To dance, originally to jive or swing music; later, to jazz, rock and roll, rhythm and blues, disco, etc."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65ae1aaa-b313-41cb-bdf7-6220ccadb04a",
                                                "sense_id": "71287706-f6f2-372d-b5a2-16c764064a40",
                                                "text": "You can dance, you can jive, having the time of your life; ooh, see that girl, watch that scene, diggin' the dancing queen!"
                                            },
                                            {
                                                "example_id": "55edc05f-a271-436a-9084-3f1299d531bf",
                                                "sense_id": "71287706-f6f2-372d-b5a2-16c764064a40",
                                                "text": "\"Can you flamenco?\" \"If I have to. How about you?\" \"Love, I can barely waltz. Jive a bit if I'm pissed enough.\""
                                            },
                                            {
                                                "example_id": "4d07a88a-347f-4b5d-b704-6819cfd27eee",
                                                "sense_id": "71287706-f6f2-372d-b5a2-16c764064a40",
                                                "text": "When it was time for stage games, I found myself jiving to Chinese orchestra and *Nsync tunes with my colleague’s sister — one of my “supporters”."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "461b5c14-ad07-3726-94e1-d85ea7a63b25",
                                        "entry_id": "87a81976-bf62-3590-9613-46f3403cbd5c",
                                        "glosses": [
                                            "A dance style popular in the 1940–50s."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67cbc5fc-3670-3dff-b3e6-9325f1738548",
                                        "entry_id": "87a81976-bf62-3590-9613-46f3403cbd5c",
                                        "glosses": [
                                            "Swing, a style of jazz music."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f87b8eb5-dd90-39cc-ad6e-0351117048aa",
                                        "entry_id": "87a81976-bf62-3590-9613-46f3403cbd5c",
                                        "glosses": [
                                            "A slang associated with jazz musicians; hepcat patois or hipster jargon."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f6c46a1-3d4b-471d-bdd7-3280f475a695",
                                                "sense_id": "f87b8eb5-dd90-39cc-ad6e-0351117048aa",
                                                "text": "Then the loud sound did seem to fade / Came back like a slow voice on a wave of phase / That weren't no DJ, that was hazy cosmic jive"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cdba66b-4d0f-31dc-83db-476889c4e353",
                                        "entry_id": "87a81976-bf62-3590-9613-46f3403cbd5c",
                                        "glosses": [
                                            "Synonym of bullshit: patent nonsense, transparently deceptive talk."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b826e360-6197-4332-be5b-c9b3381ba9d1",
                                                "sense_id": "8cdba66b-4d0f-31dc-83db-476889c4e353",
                                                "text": "Don’t give me that jive. I know where you were last night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "398aca7f-9df6-3518-81b4-641a07830497",
                                        "entry_id": "87a81976-bf62-3590-9613-46f3403cbd5c",
                                        "glosses": [
                                            "African-American Vernacular English."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial",
                                            "countable",
                                            "derogatory",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08262a30-1df0-4ecf-854f-52f4fb2deabc",
                                                "sense_id": "398aca7f-9df6-3518-81b4-641a07830497",
                                                "text": "Although speaking Western Japanese to your friends in Ōsaka, Kyōto, or Kōbe will allow you to get closer to them, speaking Western Japanese in Tōkyō might seem as outlandish as hearing a Japanese exchange student back home speaking jive or cockney."
                                            },
                                            {
                                                "example_id": "50f1248d-a128-4f07-a30c-3fd72cb12278",
                                                "sense_id": "398aca7f-9df6-3518-81b4-641a07830497",
                                                "text": "\"Oh come on,\" she said. \"I heard you talking jive the other day when you were playing with your dolls. And back in February, when you recited that poem by, by—what was the poet's name?\n\"Langston Hughes?\"\n\"Right, Langston Hughes,\" Kanta said. \"You spoke jive when you read that poem, remember?\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ca07bbd-7c35-34ab-8d61-9e1388cbf2a3",
                                        "entry_id": "5d8f08e7-3fa8-3ec6-aaa1-b52b9c427094",
                                        "glosses": [
                                            "To jibe, in the sense of to accord, to agree"
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
