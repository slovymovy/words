{
    "word_family": [
        "ride",
        "riding",
        "road",
        "joyride",
        "overrider"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c963d55a-9a4f-3c8b-a5cf-ca4dac31511f",
                    "sense_definition": "A person who rides a horse, bicycle, or motorcycle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transportation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rider</w> wore a helmet and leather jacket while operating the motorcycle.",
                            "target_lang_translations": {
                                "ru": "<w>Мотоциклист</w> был в шлеме и кожаной куртке, когда управлял мотоциклом."
                            }
                        },
                        {
                            "text": "A skilled horse <w>rider</w> can control the animal with very subtle movements.",
                            "target_lang_translations": {
                                "ru": "Опытный <w>всадник</w> может управлять животным с помощью едва заметных движений."
                            }
                        }
                    ],
                    "synonyms": [
                        "horseman"
                    ],
                    "common_phrases": [
                        "horse rider",
                        "bicycle rider",
                        "motorcycle rider",
                        "skilled rider"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который едет верхом на лошади, велосипеде или мотоцикле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всадник",
                                "target_lang_sense_clarification": "человек верхом на лошади"
                            },
                            {
                                "target_lang_word": "наездник",
                                "target_lang_sense_clarification": "тот, кто едет верхом или владеет искусством верховой езды"
                            },
                            {
                                "target_lang_word": "мотоциклист",
                                "target_lang_sense_clarification": "водитель мотоцикла"
                            },
                            {
                                "target_lang_word": "велосипедист",
                                "target_lang_sense_clarification": "человек на велосипеде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "543cb905-37ee-330e-a7c3-b4be42a3220a",
                    "sense_definition": "A person who travels in a vehicle or uses public transport; a passenger.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transportation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city reported a significant increase in the number of subway <w>riders</w> this year.",
                            "target_lang_translations": {
                                "ru": "В этом году город сообщил о значительном росте числа <w>пассажиров</w> метро."
                            }
                        },
                        {
                            "text": "Every bus <w>rider</w> must have a valid ticket before boarding the vehicle.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>пассажир</w> автобуса должен иметь действующий билет перед посадкой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bus rider",
                        "subway rider",
                        "transit rider"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который путешествует в транспортном средстве или пользуется общественным транспортом; пассажир."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пассажир",
                                "target_lang_sense_clarification": "человек, совершающий поездку в транспорте"
                            },
                            {
                                "target_lang_word": "седок",
                                "target_lang_sense_clarification": "пассажир экипажа или транспортного средства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32ba3fc5-3195-3c87-a8c7-7154ee84dcf3",
                    "sense_definition": "A person who participates in boardsports, such as a skateboarder or snowboarder.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>rider</w> performed an impressive trick on the halfpipe.",
                            "target_lang_translations": {
                                "ru": "Молодой <w>райдер</w> исполнил впечатляющий трюк на хафпайпе."
                            }
                        },
                        {
                            "text": "A professional skateboard <w>rider</w> needs excellent balance and coordination.",
                            "target_lang_translations": {
                                "ru": "Профессиональному <w>скейтбордисту</w> необходимы отличный баланс и координация."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skateboard rider",
                        "bmx rider",
                        "pro rider"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, занимающийся экстремальными видами спорта, такими как скейтбординг или сноубординг."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "райдер",
                                "target_lang_sense_clarification": "спортсмен в экстремальных дисциплинах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "342ba626-df34-3ecc-bc60-a123b7c04a68",
                    "sense_definition": "An additional clause or amendment added to an official document or legislative bill.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The senator attached a controversial <w>rider</w> to the environmental protection bill.",
                            "target_lang_translations": {
                                "ru": "Сенатор добавил спорное <w>дополнение</w> к законопроекту об охране окружающей среды."
                            }
                        },
                        {
                            "text": "Lawmakers debated the legislative <w>rider</w> for several hours before the final vote.",
                            "target_lang_translations": {
                                "ru": "Законодатели обсуждали законодательную <w>поправку</w> в течение нескольких часов перед финальным голосованием."
                            }
                        }
                    ],
                    "common_phrases": [
                        "legislative rider",
                        "policy rider",
                        "attach a rider"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дополнительный пункт или поправка, добавленная к официальному документу или законопроекту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнение",
                                "target_lang_sense_clarification": "дополнительная статья к законопроекту"
                            },
                            {
                                "target_lang_word": "поправка",
                                "target_lang_sense_clarification": "изменение или добавление в документ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30369c5b-9be9-3acd-936e-54706b6a0484",
                    "sense_definition": "An amendment to an entertainer's contract specifying personal requirements like food or equipment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band's hospitality <w>rider</w> requested specific brands of bottled water and fresh fruit.",
                            "target_lang_translations": {
                                "ru": "Бытовой <w>райдер</w> группы включал определенные марки бутилированной воды и свежие фрукты."
                            }
                        },
                        {
                            "text": "The venue manager reviewed the technical <w>rider</w> to ensure all sound equipment was available.",
                            "target_lang_translations": {
                                "ru": "Менеджер площадки изучил технический <w>райдер</w>, чтобы убедиться в наличии всего звукового оборудования."
                            }
                        }
                    ],
                    "common_phrases": [
                        "technical rider",
                        "hospitality rider",
                        "contract rider"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приложение к контракту артиста, в котором указываются личные требования, такие как еда или оборудование."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "райдер",
                                "target_lang_sense_clarification": "перечень требований артиста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bf5798a-1a45-3e33-8068-04eb7a3b539c",
                    "sense_definition": "An optional provision that adds benefits to or amends the terms of an insurance policy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to add an insurance <w>rider</w> to cover his expensive jewelry collection.",
                            "target_lang_translations": {
                                "ru": "Он решил добавить <w>дополнение</w> к страховому полису, чтобы покрыть свою дорогую коллекцию ювелирных изделий."
                            }
                        },
                        {
                            "text": "The <w>rider</w> increased the monthly premium but provided much better coverage.",
                            "target_lang_translations": {
                                "ru": "Это <w>условие</w> увеличило ежемесячный взнос, но обеспечило гораздо лучшее покрытие."
                            }
                        }
                    ],
                    "common_phrases": [
                        "insurance rider",
                        "policy rider"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical insurance terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дополнительное условие, расширяющее льготы или изменяющее условия страхового полиса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнение к полису",
                                "target_lang_sense_clarification": "дополнительное страховое покрытие"
                            },
                            {
                                "target_lang_word": "аддендум",
                                "target_lang_sense_clarification": "техническое дополнение к договору"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80dfc02e-1180-35f1-ba84-425aaa2fab48",
                    "sense_definition": "A mounted warrior or knight.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rider</w> charged across the field with his lance held high.",
                            "target_lang_translations": {
                                "ru": "<w>Всадник</w> помчался по полю, высоко подняв копье."
                            }
                        },
                        {
                            "text": "Ancient stories often tell of a mysterious black <w>rider</w> appearing at night.",
                            "target_lang_translations": {
                                "ru": "Древние легенды часто повествуют о таинственном черном <w>всаднике</w>, появляющемся по ночам."
                            }
                        }
                    ],
                    "synonyms": [
                        "horseman"
                    ],
                    "common_phrases": [
                        "black rider",
                        "mounted rider"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вооруженный конный воин или рыцарь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всадник",
                                "target_lang_sense_clarification": "конный воин"
                            },
                            {
                                "target_lang_word": "рыцарь",
                                "target_lang_sense_clarification": "средневековый конный воин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae553d44-6986-35fb-9620-657d02e6b5f3",
                    "sense_definition": "A chess piece that can move any number of squares in a single direction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this variant of chess, the <w>rider</w> can jump over other pieces.",
                            "target_lang_translations": {
                                "ru": "В этом варианте шахмат <w>линейная фигура</w> может перепрыгивать через другие фигуры."
                            }
                        },
                        {
                            "text": "The bishop is a classic example of a <w>rider</w> because it moves diagonally.",
                            "target_lang_translations": {
                                "ru": "Слон — классический пример <w>дальнобойной фигуры</w>, потому что он ходит по диагонали."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chess rider"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical chess terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шахматная фигура, которая может перемещаться на любое количество полей в одном направлении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "линейная фигура",
                                "target_lang_sense_clarification": "фигура, бьющая через поля"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e1c852ba-641f-3d24-8962-405cbb62cb6b",
                    "sense_definition": "An English surname, originally referring to a horseman or forest ranger.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is a man named John <w>Rider</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — человек по имени Джон <w>Райдер</w>."
                            }
                        },
                        {
                            "text": "The <w>Rider</w> family has lived in this village for several generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Райдер</w> живет в этой деревне уже несколько поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "occupational origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, изначально относившаяся к всаднику или лесничему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Райдер",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}