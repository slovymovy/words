                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страдающий",
                                "target_lang_sense_clarification": "испытывающий мучения"
                            },
                            {
                                "target_lang_word": "полный страданий",
                                "target_lang_sense_clarification": "о крике, взгляде"
                            },
                            {
                                "target_lang_word": "мучительный",
                                "target_lang_sense_clarification": "выражающий муку"
                            }
                        ]
                    }
                }
            ]
        },
        {
