                            "target_lang_translations": {
                                "en": "Management refused to <w>agree</w> to the request made by the employees.",
                                "ru": "Руководство отказалось <w>удовлетворить</w> просьбу сотрудников.",
                                "de": "Die Geschäftsleitung lehnte es ab, der von den Beschäftigten formulierten Forderung <w>stattzugeben</w>.",
                                "es": "La dirección se negó a <w>conceder</w> la petición formulada por los empleados.",
                                "zh": "管理层拒绝<w>同意</w>员工提出的请求。"
                            }
                        },
                        {
                            "text": "Le juge a décidé d'<w>accéder</w> à la requête déposée par l'avocat.",
                            "target_lang_translations": {
                                "en": "The judge decided to <w>accede</w> to the petition filed by the lawyer.",
                                "ru": "Судья решил <w>удовлетворить</w> ходатайство, поданное адвокатом.",
                                "de": "Der Richter beschloss, dem vom Anwalt eingereichten Antrag <w>stattzugeben</w>.",
                                "es": "El juez decidió <w>acceder</w> a la petición presentada por el abogado.",
                                "zh": "法官决定<w>批准</w>律师提交的申请。"
