        "fr-extract.jsonl": [
            {
                "entry_id": "fcdc41b5-e8c2-3bef-854f-8466b8095336",
                "word": "ethnographie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2f9c1cda-0618-44d5-b515-8479b2d59c13",
                        "entry_id": "fcdc41b5-e8c2-3bef-854f-8466b8095336",
                        "tags": [
                            "plural"
                        ],
                        "form": "ethnographies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dab60407-958e-3a07-9ca1-beadfe5fd628",
                        "entry_id": "fcdc41b5-e8c2-3bef-854f-8466b8095336",
                        "glosses": [
                            "Méthode descriptive des sciences sociales consistant à observer et à décrire, sur le terrain, les modes de vie, pratiques et représentations d’un groupe humain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3baa28d-77ab-4084-99b2-36a4fca19b41",
                                "sense_id": "dab60407-958e-3a07-9ca1-beadfe5fd628",
                                "text": "Rien de moins étonnant, dès lors, que de retrouver notre infatigable voyageur visitant de 1855 à 1857 tout l'ouest du Tibet en compagnie des frères Schlagintweit, et rapportant de cette exploration de curieuses observations d'ethnographie."
                            }
                        ]
                    },
                    {
                        "sense_id": "921a8160-7cec-3c3e-bba1-5f2606eb143a",
                        "entry_id": "fcdc41b5-e8c2-3bef-854f-8466b8095336",
                        "glosses": [
                            "Le rapport ou l’étude résultant de ce travail."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "632beadc-d9dd-4fc1-96cd-987eb8cb8bf2",
                                "sense_id": "921a8160-7cec-3c3e-bba1-5f2606eb143a",
                                "text": "Il est certain que les représentations iconographiques ou littéraires permettent de mettre en lumière une ethnographie parisienne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "187ba51d-a186-4ed6-b59e-ec7d18c9406e",
                        "source_entry_id": "fcdc41b5-e8c2-3bef-854f-8466b8095336",
                        "target_lang_word": "Ethnographie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ethnographie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7a2384d-6806-37b5-a75c-fad293bd365e",
                                        "entry_id": "04cd053b-b96d-3129-8761-99ff124ef5b8",
                                        "glosses": [
                                            "Teilbereich der Völkerkunde, der sich damit befasst, die Merkmale der einzelnen Kulturen darzustellen/zu erfassen"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1a27c59-c0c8-4ff8-825c-1e294a3f5436",
                                                "sense_id": "f7a2384d-6806-37b5-a75c-fad293bd365e",
                                                "text": "„Die Ethnographie, die eine ihrer Aufgaben darin sieht, Einzelbeobachtungen zu Aussagen über »Völker« zu verallgemeinern, droht ständig ein Scheitern an der Komplexität ihres Gegenstandes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f95ab181-1a56-4b71-86bb-86b225da33ec",
                        "source_entry_id": "fcdc41b5-e8c2-3bef-854f-8466b8095336",
                        "target_lang_word": "ethnography",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ethnography",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c638604-d433-3c6d-904b-ead1433d60f2",
                                        "entry_id": "6628b762-0071-3bd1-af8d-50e3d34ba6c4",
                                        "glosses": [
                                            "The branch of anthropology that scientifically describes specific human cultures and societies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8e9bd03-736f-4cae-84ce-c6b3ab300c7c",
                                                "sense_id": "2c638604-d433-3c6d-904b-ead1433d60f2",
                                                "text": "By the end of the century, the APS’s membership included the leaders of the American anthropological establishment, whose primary investigative interests were the ethnography, linguistics, archeology, and physical anthropology of the American Indian, within a theoretical structure that was essentially historical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af416a45-854f-3198-ba10-37586318939b",
                                        "entry_id": "6628b762-0071-3bd1-af8d-50e3d34ba6c4",
                                        "glosses": [
                                            "An ethnographic work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96e83a3e-8ba8-4451-b3a9-cefddf231e2b",
                                                "sense_id": "af416a45-854f-3198-ba10-37586318939b",
                                                "text": "As intellectuals read the written text, compile ethnographies, tour the non-Western terrain, and make art out of the charred remnants of these quests, we always run the risk of fortifying the old culture with neomythologies that continue to invade the private space of others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
