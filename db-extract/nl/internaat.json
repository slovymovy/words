                                        "examples": [
                                            {
                                                "example_id": "da605163-02b6-4b30-9ade-ac42669a53d2",
                                                "sense_id": "02ccad41-efee-3a70-aa13-4858fbf79c15",
                                                "text": "water sanctified by Christ's institute"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1d29cb6-4d82-3ed8-ad4f-14f3d0fde17a",
                                        "entry_id": "9073534d-44c7-3d5c-8c3d-d51876edfee3",
                                        "glosses": [
                                            "That which is instituted, established, or fixed, such as a law, habit, or custom."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9916bbc-f3f2-402c-98f9-55c51ae059ae",
                                                "sense_id": "b1d29cb6-4d82-3ed8-ad4f-14f3d0fde17a",
                                                "text": "They made a sort of institute and digest of anarchy."
                                            },
                                            {
                                                "example_id": "24cb6a7e-5889-4505-8d16-ec97a42206ad",
                                                "sense_id": "b1d29cb6-4d82-3ed8-ad4f-14f3d0fde17a",
                                                "text": "to make the Stoic institutes thy own"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5301919-6121-3d89-acd9-584efce7f72f",
                                        "entry_id": "9073534d-44c7-3d5c-8c3d-d51876edfee3",
                                        "glosses": [
                                            "The person to whom an estate is first given by destination or limitation."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deec2568-c85e-4bbc-b55e-8f02987b241b",
                                                "sense_id": "b5301919-6121-3d89-acd9-584efce7f72f",
                                                "text": "Substitution is the nomination of substituted heirs, who take place, failing the institute."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "institute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "041c0a83-5475-34d5-90e3-89b7a0c92262",
                                        "entry_id": "08bc7b42-b332-3d05-9e75-e8edceb138ce",
                                        "glosses": [
                                            "To begin or initiate (something); to found."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5324a95f-2878-41d4-9750-848840f8fff2",
                                                "sense_id": "041c0a83-5475-34d5-90e3-89b7a0c92262",
                                                "text": "He instituted the new policy of having children walk through a metal detector to enter school."
                                            },
                                            {
                                                "example_id": "24ad802f-cddf-48bf-96ff-e12122f3b1d4",
                                                "sense_id": "041c0a83-5475-34d5-90e3-89b7a0c92262",
                                                "text": "And haply institute / A course of learning and ingenious studies."
                                            },
                                            {
                                                "example_id": "746316c9-3478-4ce3-9d80-88687f2b214e",
                                                "sense_id": "041c0a83-5475-34d5-90e3-89b7a0c92262",
                                                "text": "Whenever any form of government becomes destructive of these ends it is the right of the people to alter or to abolish it, and to institute a new government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f607452-7ca5-382a-9d73-9ca076946169",
                                        "entry_id": "08bc7b42-b332-3d05-9e75-e8edceb138ce",
                                        "glosses": [
                                            "To train, instruct."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0ce83bf-e7f9-4179-ae68-f2675b8ee277",
                                                "sense_id": "7f607452-7ca5-382a-9d73-9ca076946169",
                                                "text": "Publius was the first that ever instituted the Souldier to manage his armes by dexteritie and skil, and joyned art unto vertue, not for the use of private contentions, but for the wars and Roman peoples quarrels."
                                            },
                                            {
                                                "example_id": "d43dc96f-74b0-4f1f-a08b-5a1322e0da49",
                                                "sense_id": "7f607452-7ca5-382a-9d73-9ca076946169",
                                                "text": "If children were early instituted, knowledge would insensibly insinuate itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcb41909-86c1-3f43-8e24-955f86cee44c",
                                        "entry_id": "08bc7b42-b332-3d05-9e75-e8edceb138ce",
                                        "glosses": [
                                            "To nominate; to appoint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e1de496-b534-40e8-a905-debce0eb2087",
                                                "sense_id": "bcb41909-86c1-3f43-8e24-955f86cee44c",
                                                "text": "We institute your Grace / To be our regent in these parts of France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a43d98c-608d-3b91-b4dc-9f94891da79a",
                                        "entry_id": "08bc7b42-b332-3d05-9e75-e8edceb138ce",
                                        "glosses": [
                                            "To invest with the spiritual charge of a benefice, or the care of souls."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63730f8f-e1a6-4ae5-9084-fef78ca4afd8",
                                                "sense_id": "1a43d98c-608d-3b91-b4dc-9f94891da79a",
                                                "text": "a writ issued to the bishop, to institute the clerk of that patron"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "institute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "568a07d0-81e4-30d3-b496-fd6d348dd58d",
                                        "entry_id": "290d9860-0bbc-31b7-b6f6-944443c1f8b4",
                                        "glosses": [
                                            "Established; organized; founded."
                                        ],
