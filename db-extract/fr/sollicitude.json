        "fr-extract.jsonl": [
            {
                "entry_id": "a3622973-6a64-35e8-8338-f8edec604e42",
                "word": "sollicitude",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e993b177-d315-4e73-bf52-caa3d644735e",
                        "entry_id": "a3622973-6a64-35e8-8338-f8edec604e42",
                        "tags": [
                            "plural"
                        ],
                        "form": "sollicitudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8151cd4-755a-35e9-8cf7-97af5bd7b811",
                        "entry_id": "a3622973-6a64-35e8-8338-f8edec604e42",
                        "glosses": [
                            "Soin affectueux que l’on a pour quelqu’un, ensemble des égards, des soins attentifs dont on l’entoure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35606a10-fe6f-4642-b463-fbbfaef22574",
                                "sense_id": "d8151cd4-755a-35e9-8cf7-97af5bd7b811",
                                "text": "Le soin excessif de sa toilette, des bottines de velours, une collerette de dentelles, le châle mis droit, tout attestait la sollicitude de Modeste pour sa mère."
                            },
                            {
                                "example_id": "578e02bd-cb5e-4423-b3fa-578517555fa3",
                                "sense_id": "d8151cd4-755a-35e9-8cf7-97af5bd7b811",
                                "text": "[…], les moutons sont l’objet de toute la sollicitude des cultivateurs, et l’on y voit de grands troupeaux de mérinos, remarquables par leur bonne conformation et l’abondance et la finesse de leurs toisons […]."
                            },
                            {
                                "example_id": "25892040-c530-44de-87c1-df01d6701d66",
                                "sense_id": "d8151cd4-755a-35e9-8cf7-97af5bd7b811",
                                "text": "Mais déjà Jourgeot, souriant à son tour, s’enquérait avec sollicitude de la santé de son épouse."
                            },
                            {
                                "example_id": "94497ec2-945a-440a-b404-609d9e9cb6fe",
                                "sense_id": "d8151cd4-755a-35e9-8cf7-97af5bd7b811",
                                "text": "La politique du Japon rappelle le caractère de ses habitants : aimable et pleine de sollicitude à la face du monde, elle opprime, vole et massacre de l’autre côté du décor."
                            },
                            {
                                "example_id": "aedc7a66-d4a6-4e9c-b6f6-efc28192a633",
                                "sense_id": "d8151cd4-755a-35e9-8cf7-97af5bd7b811",
                                "text": "Ce que refusait Ouroz, ce n’était pas une aide – toute monture la devait à son cavalier. C’était, dans le regard de Jehol, l’expression intolérable, presque humaine, de sollicitude."
                            },
                            {
                                "example_id": "108e6056-8f7f-4968-a17e-1d20d4caae05",
                                "sense_id": "d8151cd4-755a-35e9-8cf7-97af5bd7b811",
                                "text": "Cette sollicitude ne la surprenait guère : Alice avait toujours eu cette espèce de charité très chrétienne, qui attendait que l'on fût au fond du trou pour vous tendre la main."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f6a4b7b-fd6d-375f-a902-47c8f9f277af",
                        "entry_id": "a3622973-6a64-35e8-8338-f8edec604e42",
                        "glosses": [
                            "Souci ; soin inquiet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30776f01-6a3e-4429-9e15-5c4d97b574d7",
                                "sense_id": "4f6a4b7b-fd6d-375f-a902-47c8f9f277af",
                                "text": "A chaque fenêtre on aperçoit, sous les rideaux de mousseline, des fuchsias ou des géraniums cultivés dans des pots avec une touchante sollicitude."
                            },
                            {
                                "example_id": "93f15076-8dbf-438b-8372-10a7025a39f1",
                                "sense_id": "4f6a4b7b-fd6d-375f-a902-47c8f9f277af",
                                "text": "Cette affaire lui donne, lui cause beaucoup de sollicitude."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad8ea793-333a-4300-a14c-d62113ec46f4",
                        "source_entry_id": "a3622973-6a64-35e8-8338-f8edec604e42",
                        "target_lang_word": "solicitude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solicitude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48d84fe8-4096-382b-9eaf-23a82b0f7e35",
                                        "entry_id": "9bac4cd6-7689-3999-8a60-acea92025390",
                                        "glosses": [
                                            "The state of being solicitous; uneasiness of mind occasioned by fear of evil or desire for good; anxiety."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0017660d-d803-45e7-b0e4-887e556f69b4",
                                                "sense_id": "48d84fe8-4096-382b-9eaf-23a82b0f7e35",
                                                "text": "The familiarity of Sydney Smith’s manner does not consist merely in his style ; indeed, the terseness and brilliancy of his diction, though not at all artificial in appearance, could not have been attained without labor and solicitude ;—but it is the result of the blunt, fearless, severe, yet good-humored, nature of the man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4170e2d9-1172-3146-ab59-88dddf0c2421",
                                        "entry_id": "9bac4cd6-7689-3999-8a60-acea92025390",
                                        "glosses": [
                                            "Special or pronounced concern or attention."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "420272e0-8ccd-4950-8bda-fdc972e6958f",
                                                "sense_id": "4170e2d9-1172-3146-ab59-88dddf0c2421",
                                                "text": "Also the triuialle of the vertues theologicalle and quadriuialle of the cardinalle vertues, to comprehende the knowlege of whom oure insufficience sufficethe not, withowte the sollicitude of writers scholde transfude to vs the memory of thynges of antiquite."
                                            },
                                            {
                                                "example_id": "bd2d608b-d171-4648-85e4-1d7e6ca1e58a",
                                                "sense_id": "4170e2d9-1172-3146-ab59-88dddf0c2421",
                                                "text": "Will any fair man say that I do not in this paragraph inculcate the duty of love and reverence for his Majesty, by stating, not merely my own ideas of his royal virtues, of his wisdom, and paternal solicitude for the happiness of his people, but the opinion and feeling of the illustrious personage, the highest subject in his empire -- the most interested next to himself in its welfare -- and whose example of reverence and devotion was so well calculated to inspire confidence and attachment in every class of the community?"
                                            },
                                            {
                                                "example_id": "e3a415b9-080e-4864-bae4-f12efe0e1312",
                                                "sense_id": "4170e2d9-1172-3146-ab59-88dddf0c2421",
                                                "text": "For there to be genuine community among any sizable group of people, solicitude must be a routine feature of daily intercourse."
                                            },
                                            {
                                                "example_id": "231d4c68-e0a5-4dfc-804f-b3177aef85fc",
                                                "sense_id": "4170e2d9-1172-3146-ab59-88dddf0c2421",
                                                "text": "The increasing solicitude for human life that characterizes administrative government is limited to people who are perceived as members or citizens of the polity, for reasons that will be discussed at length in Chapter 6."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66b9f3d8-7f90-3f4f-8f74-097282b05543",
                                        "entry_id": "9bac4cd6-7689-3999-8a60-acea92025390",
                                        "glosses": [
                                            "A cause of anxiety or concern."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebc1b652-3b4c-44e6-bde0-4b9a3a81442b",
                                                "sense_id": "66b9f3d8-7f90-3f4f-8f74-097282b05543",
                                                "text": "M. Todgers looked a little worn by cares of gravy and other such solicitudes arising out of her establishment, but displayed her usual earnestness and warmth of manner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d9f44c2-600b-4e64-88f8-621a2ee705f1",
                        "source_entry_id": "a3622973-6a64-35e8-8338-f8edec604e42",
