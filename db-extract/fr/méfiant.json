                ],
                "senses": [
                    {
                        "sense_id": "1d02f775-6227-3438-9b61-acbca62a41f6",
                        "entry_id": "b74d75f1-a70d-3589-a23e-ae4b4b73cfd0",
                        "glosses": [
                            "Qui se méfie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7192da2e-ea74-43d1-946b-eced022faf36",
                                "sense_id": "1d02f775-6227-3438-9b61-acbca62a41f6",
                                "text": "Les bêtes si méfiantes qui s'abattaient à la croûle sur les fagnes pour en extraire les vers, ne prenaient point garde aux filets tendus à plat sur le sol; elles s'y empêtraient et tous leurs efforts étaient vains. Elles ne pouvaient s'en dépêtrer ou arracher le bâtonnet qui les fixe."
                            },
                            {
                                "example_id": "d979c1d4-dcc5-4702-8798-7a4aa5784c07",
                                "sense_id": "1d02f775-6227-3438-9b61-acbca62a41f6",
                                "text": "— Santini est un méfiant, il ne fait pas confiance aux gens qui sont dans l’univers du football."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf527d5c-58df-45a8-be3a-2165fa8e2de6",
                        "source_entry_id": "b74d75f1-a70d-3589-a23e-ae4b4b73cfd0",
                        "source_sense_id": "1d02f775-6227-3438-9b61-acbca62a41f6",
                        "target_lang_word": "misstrauisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misstrauisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86d25ef3-84e1-3cc9-8d4e-298fe3c8e31b",
                                        "entry_id": "79cff8a9-c2d0-3e13-b129-8729d0f13b76",
                                        "glosses": [
                                            "jemandem oder etwas nicht trauend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99c27475-2e9e-4e28-8e16-c8305c272c5a",
                                                "sense_id": "86d25ef3-84e1-3cc9-8d4e-298fe3c8e31b",
                                                "text": "Er ist ein misstrauischer Mensch."
                                            },
                                            {
                                                "example_id": "f102dd7e-fa18-4c0d-9363-66b824b86f5c",
                                                "sense_id": "86d25ef3-84e1-3cc9-8d4e-298fe3c8e31b",
                                                "text": "Misstrauisch beäugte der Vogel das angebotene Futter."
                                            },
                                            {
                                                "example_id": "0ea64603-9504-4395-8507-f6a2902b167c",
                                                "sense_id": "86d25ef3-84e1-3cc9-8d4e-298fe3c8e31b",
                                                "text": "„Anna war vor misstrauischen Nachbarn und der Gestapo weiter nur durch die dünne Hülle ihrer Tarnung als Muslimin geschützt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48702c7a-21cb-49dc-9843-491f861d8cf4",
                        "source_entry_id": "b74d75f1-a70d-3589-a23e-ae4b4b73cfd0",
                        "source_sense_id": "1d02f775-6227-3438-9b61-acbca62a41f6",
                        "target_lang_word": "suspicious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suspicious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bfcc51c-1ce3-38f1-a5f6-f5c7a900ab8d",
                                        "entry_id": "1b546237-9749-332e-855e-9600cf3f8d8f",
                                        "glosses": [
                                            "Arousing suspicion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa35fb88-2a10-4050-ac80-f679bdbafeff",
                                                "sense_id": "8bfcc51c-1ce3-38f1-a5f6-f5c7a900ab8d",
                                                "text": "His suspicious behaviour brought him to the attention of the police."
                                            },
                                            {
                                                "example_id": "27a8111f-9f4a-4205-9372-e2404ba097b3",
                                                "sense_id": "8bfcc51c-1ce3-38f1-a5f6-f5c7a900ab8d",
                                                "text": "If their views were entrancing their sanitation was primeval; if they possessed stables they were also next to the gas-works; if their gardens were delightful there were odours suspicious of mice in the bedrooms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "900c6fee-d179-33fd-b02f-d92d5ed26dd2",
                                        "entry_id": "1b546237-9749-332e-855e-9600cf3f8d8f",
                                        "glosses": [
                                            "Distrustful or tending to suspect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3193b015-3423-4083-a9da-ef80353812ab",
                                                "sense_id": "900c6fee-d179-33fd-b02f-d92d5ed26dd2",
                                                "text": "We know he has a suspicious attitude to get-rich-quick schemes."
                                            },
                                            {
                                                "example_id": "dbd8c4d7-ff77-4d72-bdc0-98c2d27eee70",
                                                "sense_id": "900c6fee-d179-33fd-b02f-d92d5ed26dd2",
                                                "text": "Betraide by fortune and ſuſpitious loue,\nThreatned with frowning wrath and iealouſie,\nSurpriz’d with feare and hideous reuenge,\nI ſtand agaſt: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21af017c-5f19-33cd-8cfd-93039e522500",
                                        "entry_id": "1b546237-9749-332e-855e-9600cf3f8d8f",
                                        "glosses": [
                                            "Expressing suspicion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6586499-bdf0-4296-a6aa-3e12479378d1",
                                                "sense_id": "21af017c-5f19-33cd-8cfd-93039e522500",
                                                "text": "She gave me a suspicious look."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3615bc7b-0d93-4535-bd99-64ae003dd034",
