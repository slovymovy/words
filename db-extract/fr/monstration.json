        "fr-extract.jsonl": [
            {
                "entry_id": "f8379bd6-5e84-39f7-bcd8-c570672c3a3a",
                "word": "monstration",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cc8c08c7-19d7-48ae-860e-5551803af636",
                        "entry_id": "f8379bd6-5e84-39f7-bcd8-c570672c3a3a",
                        "tags": [
                            "plural"
                        ],
                        "form": "monstrations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4d1113b-b06b-38b5-b9ec-339c3a4d36bb",
                        "entry_id": "f8379bd6-5e84-39f7-bcd8-c570672c3a3a",
                        "glosses": [
                            "Acte d’exposer, de montrer à la vue du public, exposition, étalage, présentation, ostension."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1620a6f5-253d-4ad8-b729-4b25121d6ec6",
                                "sense_id": "e4d1113b-b06b-38b5-b9ec-339c3a4d36bb",
                                "text": "[…] c’est que l’un est le mouvement de la monstration, l’autre le même mouvement, mais comme quelque chose de simple ; celui-là est le fait de percevoir, celui-ci l’ob-jet."
                            },
                            {
                                "example_id": "69234b1e-7505-414e-9b6a-699e43866b49",
                                "sense_id": "e4d1113b-b06b-38b5-b9ec-339c3a4d36bb",
                                "text": "Vous et vos pairs, vous n’avez cessé de profaner le beau depuis des lustres – mais il vous suffira d’une seule monstration de mon horreur pour lui restituer sa pureté originelle."
                            },
                            {
                                "example_id": "8bc69d91-be9b-46ed-bc6c-4d4811b39f8c",
                                "sense_id": "e4d1113b-b06b-38b5-b9ec-339c3a4d36bb",
                                "text": "Le suprême objet de la danse est la monstration du corps."
                            },
                            {
                                "example_id": "f86339b9-c0f7-4bc3-a596-75a504f74009",
                                "sense_id": "e4d1113b-b06b-38b5-b9ec-339c3a4d36bb",
                                "text": "Lorsque ce travail a lieu au sein même d’un plan, par exemple grâce à des mouvements de caméra ou à un traitement particulier de la durée, la monstration se voit investie d’un rôle similaire à celui de l’organisation filmique."
                            },
                            {
                                "example_id": "921a34cf-0b34-4522-b27a-271d97c1cef3",
                                "sense_id": "e4d1113b-b06b-38b5-b9ec-339c3a4d36bb",
                                "text": "Les mêmes gestes, pensais-je, pourraient être le support, la béquille des sentiments, lui faciliteraient peut-être le travail de parole et de monstration qu’il aurait à accomplir devant la caméra."
                            },
                            {
                                "example_id": "a66a8e80-2efe-4cb3-867e-55d6041e96f9",
                                "sense_id": "e4d1113b-b06b-38b5-b9ec-339c3a4d36bb",
                                "text": "– … Rendons grâce au saint père qui bénit les monstrations du saint suaire !"
                            }
                        ]
                    }
                ],
