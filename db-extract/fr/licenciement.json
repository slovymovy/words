                                                "example_id": "a40a56b0-fb31-4aa1-8302-6c097fe4270e",
                                                "sense_id": "cd79e0dc-1465-3d72-8829-31842544bab8",
                                                "text": "After a ten-month layoff, during which extensive testing had taken place in conjunction with AEI, the 'Blue Trains' resumed full operation on October 2 1961, [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5132cc0b-20e5-3d86-8a96-b480423c4337",
                                        "entry_id": "a1af704f-f55d-38ca-94bc-b85cee7e433a",
                                        "glosses": [
                                            "A short pass that has been rolled in front of another player for them to kick."
