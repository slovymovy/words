                                                "sense_id": "fd293075-b12a-3991-9474-a44fab9de5dd",
                                                "text": "Mam na imię Aureliusz i jestem złotnikiem z Krynicy."
                                            },
                                            {
                                                "example_id": "9d7a7f19-62db-48c6-ab8a-4fe0de6d0893",
                                                "sense_id": "fd293075-b12a-3991-9474-a44fab9de5dd",
                                                "text": "26 kwietnia, 20 lipca i 9 września przypadają imieniny Aureliusza."
                                            },
                                            {
                                                "example_id": "47ee36e8-0b27-4955-9d72-7babc99fcfa6",
                                                "sense_id": "fd293075-b12a-3991-9474-a44fab9de5dd",
                                                "text": "Wczoraj odbył się ślub Klaudii i Aureliusza."
                                            },
                                            {
                                                "example_id": "2fc1a297-5b9c-4242-8e09-e6fafd399d8b",
                                                "sense_id": "fd293075-b12a-3991-9474-a44fab9de5dd",
                                                "text": "Byliśmy z wujkiem Aureliuszem na pielgrzymce w Watykanie."
                                            },
                                            {
                                                "example_id": "d1d9a27d-1921-48ff-844a-e6c2a0aab356",
                                                "sense_id": "fd293075-b12a-3991-9474-a44fab9de5dd",
                                                "text": "Panie Aureliuszu, proszę nas jutro odwiedzić."
