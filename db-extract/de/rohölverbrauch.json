                "senses": [
                    {
                        "sense_id": "7c6442fa-39ba-3716-8740-685384ca3db1",
                        "entry_id": "8f600595-9117-3c34-9180-9c673b7af51d",
                        "glosses": [
                            "Verwertung von Erdöl (für verschiedene Zwecke, beispielsweise Stromerzeugung, Wärmeerzeugung, Kraftstoffproduktion oder in der chemischen Industrie)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a0a7370-d0eb-46f8-b204-21e03274cd07",
                                "sense_id": "7c6442fa-39ba-3716-8740-685384ca3db1",
                                "text": "Der weltweite Rohölverbrauch ist in den letzten Jahren auf konstant hohem Niveau geblieben."
                            },
                            {
                                "example_id": "3075f48b-a240-49e0-9673-b3fdee6bf1d8",
                                "sense_id": "7c6442fa-39ba-3716-8740-685384ca3db1",
                                "text": "„Wie hoch war der gesamte Rohölverbrauch im Jahre 1976?“"
                            },
                            {
                                "example_id": "e630e65d-e75a-4d9f-b497-3359801916e5",
                                "sense_id": "7c6442fa-39ba-3716-8740-685384ca3db1",
                                "text": "„Insgesamt stieg von 1950 bis 1956 der Rohölverbrauch der deutschen Raffinerien um 350 %.“"
                            },
                            {
                                "example_id": "18b4c9c7-6081-4dea-824b-8d365fd1a753",
                                "sense_id": "7c6442fa-39ba-3716-8740-685384ca3db1",
                                "text": "[Mineralöltanker Adrian Darya 1:] „Die Kapazität der Tanks beträgt 331.536 m³. Das entspricht 2,084 Millionen Barrel oder etwa dem täglichen deutschen Rohölverbrauch.“"
                            },
                            {
                                "example_id": "b93a2e42-2f9f-4b59-87cc-364ed77ad429",
                                "sense_id": "7c6442fa-39ba-3716-8740-685384ca3db1",
                                "text": "„So haben sich - zumindest in den Industriestaaten - das Wirtschaftswachstum und der Rohölverbrauch, Größen, die früher eng zusammenhingen, mittlerweile fast völlig entkoppelt.“"
                            },
                            {
                                "example_id": "75271d64-b9ce-4257-acd2-5a094bdcf612",
                                "sense_id": "7c6442fa-39ba-3716-8740-685384ca3db1",
                                "text": "„Alles zusammen gerechnet haben die asiatischen Schwellenländer innerhalb von drei Jahren ihren Rohölverbrauch um 10,2 Prozent gesteigert, was angesichts des enormen Wirtschaftswachstums überraschend wenig ist.“"
                            },
                            {
                                "example_id": "76765c34-7652-46bb-bd76-d93267e5930f",
                                "sense_id": "7c6442fa-39ba-3716-8740-685384ca3db1",
                                "text": "„Dabei fällt bereits heute die Hälfte des Rohölverbrauchs auf den Verkehr.“"
                            },
                            {
                                "example_id": "1c50906c-e728-47a9-bbf1-90b937f5162b",
                                "sense_id": "7c6442fa-39ba-3716-8740-685384ca3db1",
                                "text": "„Trotz der anfangs zitierten Voraussage der IEA über einen schrumpfenden Rohölverbrauch wird die Nachfrage auf den globalen Energiemärkten auch in Zukunft stärker wachsen als das Angebot.“"
                            },
                            {
                                "example_id": "ead7ee50-85b1-42e5-981a-377355e50449",
                                "sense_id": "7c6442fa-39ba-3716-8740-685384ca3db1",
                                "text": "„Bis 2030 soll der Rohölverbrauch von heute 85 Millionen Barrel pro Tag – das ist ein Güterzug voller Öl von 2.600 Kilometern Länge – auf dann 121 Millionen klettern.“"
                            },
                            {
                                "example_id": "c8c8d88d-5307-4461-9f84-a60a0f6ecd76",
                                "sense_id": "7c6442fa-39ba-3716-8740-685384ca3db1",
                                "text": "„Bedenkt man, dass der deutsche Pro-Kopf-Verbrauch an Textilien 26 kg im Jahr beträgt und davon (großzügig bemessen) 50 % Textilien aus Chemiefasern bestehen, dann ist der jährliche Rohölverbrauch, der als Rohstoff für Textilien verwendet wird, marginal im Vergleich zum sonstigen jährlichen pro Kopf Rohölverbrauch.“"
                            },
                            {
                                "example_id": "9f6b0964-6458-46a3-a8cd-f45d844869d8",
                                "sense_id": "7c6442fa-39ba-3716-8740-685384ca3db1",
                                "text": "„Als von der Raffinerieerzeugung direkt abhängige Größe hat der Rohölverbrauch der Bundesrepublik entsprechend der Ausweitung der Raffinerieerzeugung expandiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
