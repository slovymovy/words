                                                "sense_id": "87d74bd6-312a-3f2c-8f6d-9a4f0d5caa1d",
                                                "text": "a coastguard cutter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c6dfb12-0479-3d78-ab9e-9f4eaa9f7c0a",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "A foretooth; an incisor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5e370f4-eb44-4606-8a25-11e0d3488aac",
                                                "sense_id": "7c6dfb12-0479-3d78-ab9e-9f4eaa9f7c0a",
                                                "text": "the Cutters and Eye-teeth have usually but one Root"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5060dd9-a966-3107-b040-474f3c1368b4",
                                        "entry_id": "53ee22d6-1488-34a9-a780-da3f09005bb3",
                                        "glosses": [
                                            "A ship's boat, used for transport ship-to-ship or ship-to-shore."
                                        ],
                                        "tags": [],
