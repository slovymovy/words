                ],
                "senses": [
                    {
                        "sense_id": "5d9c99bf-2780-3e2b-814b-746bae16dc83",
                        "entry_id": "32609291-3ce1-366a-b49f-52f12fb28125",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bfd959e-202b-401e-8ca2-1a9c8011f1ac",
                                "sense_id": "5d9c99bf-2780-3e2b-814b-746bae16dc83",
                                "text": "Frau Messerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2c05a076-1016-4838-b945-ef375d560864",
                                "sense_id": "5d9c99bf-2780-3e2b-814b-746bae16dc83",
                                "text": "Herr Messerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4d8f2774-3409-4b24-bf89-a55f11ffbe6a",
                                "sense_id": "5d9c99bf-2780-3e2b-814b-746bae16dc83",
                                "text": "Die Messerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "fb98b170-674e-4761-be0a-e912e3f102ab",
                                "sense_id": "5d9c99bf-2780-3e2b-814b-746bae16dc83",
                                "text": "Der Messerle trägt nie die Pullover, die die Messerle ihm strickt."
                            },
                            {
                                "example_id": "7ed90931-327f-4aca-9155-34ccf20fe730",
                                "sense_id": "5d9c99bf-2780-3e2b-814b-746bae16dc83",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Messerle kommt, geht der Herr Messerle.“"
                            },
                            {
                                "example_id": "e3f04cc3-e3e3-4498-9ea8-f32010aea963",
                                "sense_id": "5d9c99bf-2780-3e2b-814b-746bae16dc83",
                                "text": "Messerle kommt und geht."
                            },
                            {
                                "example_id": "848725bc-141e-4c43-96e0-2ae31a239d2e",
                                "sense_id": "5d9c99bf-2780-3e2b-814b-746bae16dc83",
                                "text": "Messerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
