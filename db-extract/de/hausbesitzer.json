                        "sense_id": "f688a5cd-4070-3c78-9823-425c4f4aa02e",
                        "entry_id": "c13540ad-9942-3e20-ba9d-a7fb8925bcb7",
                        "glosses": [
                            "jemand, der (mindestens) ein Haus besitzt"
