                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "open sandwich",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1024567-f41a-3dbf-ad51-a2ee05b4caec",
                                        "entry_id": "79a27d6a-98d5-36e2-87d9-f5ed9e31eacf",
                                        "glosses": [
                                            "Any dish consisting of only one slice of bread, with any topping."
                                        ],
                                        "tags": [],
