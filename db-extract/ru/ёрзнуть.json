                        "cross_references": []
                    },
                    {
                        "translation_id": "25cf8030-1b22-41a9-b049-fb249334178c",
                        "source_entry_id": "3045b426-4479-3c4c-8d76-34daabbe8975",
                        "source_sense_id": "fc26a3e7-9959-357c-b005-ac5e67a2800f",
                        "target_lang_word": "gigoter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gigoter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08ebcd16-da77-3554-930a-0692f20ef34f",
                                        "entry_id": "3338de32-25b3-3aec-8ab5-f4b251b2e171",
                                        "glosses": [
                                            "Remuer continuellement les jambes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5eb4371-0ec9-4eaa-8389-3149e36f7f50",
                                                "sense_id": "08ebcd16-da77-3554-930a-0692f20ef34f",
                                                "text": "J’en ai connu, des prêtres, qui s’habillaient en bourgeois pour aller voir gigoter des danseuses."
                                            },
                                            {
                                                "example_id": "b61f1910-bbeb-4c85-a1a5-f4220abf74a6",
                                                "sense_id": "08ebcd16-da77-3554-930a-0692f20ef34f",
                                                "text": "D’un coup de rasoir, je lui coupai la tête, et le tronc, d’où un flot de sang s’échappait, gigota quelques secondes sur le parquet."
                                            },
                                            {
                                                "example_id": "b9c056fc-2dc3-484c-a3d6-5864e75f5b3c",
                                                "sense_id": "08ebcd16-da77-3554-930a-0692f20ef34f",
                                                "text": "Guéri maintenant, il gigotait devant le feu et, les joues encore mouillées de larmes, riait aux éclats parce que son père agitait une branche enflammée, ce qui faisait un beau ruban de feu."
                                            },
                                            {
                                                "example_id": "c3091c52-cad5-4782-8cd0-b6f4e1fce229",
                                                "sense_id": "08ebcd16-da77-3554-930a-0692f20ef34f",
                                                "text": "Cet enfant ne fait que gigoter. — Cet enfant ne fait que gigoter les jambes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "213e3eb6-d63c-35d3-a16e-2fd0be6a471f",
                                        "entry_id": "3338de32-25b3-3aec-8ab5-f4b251b2e171",
                                        "glosses": [
                                            "S’agiter, se démener."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6cbcd8f-4cd5-4b35-8022-a37bbd283f00",
                                                "sense_id": "213e3eb6-d63c-35d3-a16e-2fd0be6a471f",
                                                "text": "Après t’avoir poussé à signer le livre de Galard, je n’ai pas le droit de te laisser gigoter seul dans les succès et dans les doutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24aca486-c26e-3e9b-a1c8-65aae81d29e3",
                                        "entry_id": "3338de32-25b3-3aec-8ab5-f4b251b2e171",
                                        "glosses": [
                                            "Remuer, tortiller."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13beb0bd-039f-4613-a4f2-0a0cdc97dad8",
                                                "sense_id": "24aca486-c26e-3e9b-a1c8-65aae81d29e3",
                                                "text": "L’anguille gigote."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
