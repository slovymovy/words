                                "target_senses": [
                                    {
                                        "sense_id": "3c41db43-124a-333c-b4b1-576c18836b80",
                                        "entry_id": "25ed0e26-ce42-3990-921e-f01ba875138e",
                                        "glosses": [
                                            "Bündnis, (an einen Vertrag gebundener) Zusammenschluss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58c81dc8-f46c-4555-80de-16ae3eaced9a",
                                                "sense_id": "3c41db43-124a-333c-b4b1-576c18836b80",
                                                "text": "„Zwischen den drei potentiellen Gegnern Schwedens zeichnete sich bald nach der Thronbesteigung des erst 15-jährigen Karls XII. von Schweden (1682–1718) der Zusammenschluss zu einer Allianz ab.“"
                                            },
                                            {
                                                "example_id": "aaa66fdd-9d58-4afa-8e7c-32872b88b209",
                                                "sense_id": "3c41db43-124a-333c-b4b1-576c18836b80",
                                                "text": "„Die Stämme leben also keineswegs isoliert, sondern schließen Allianzen miteinander und stellen große Armeen auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
