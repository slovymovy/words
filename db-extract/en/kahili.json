                        "glosses": [
                            "A feather standard mounted on a pole, as traditionally used in Hawaii on ceremonial occasions."
                        ],
                        "tags": [
                            "Hawaii"
                        ],
                        "examples": [
                            {
                                "example_id": "9305fee1-fc45-4098-9a3d-9c28849e0e9c",
                                "sense_id": "03b67c08-e07e-3a71-8e34-e27af3530cce",
                                "text": "A dozen or more of these gaudy kahilis were upheld by pallbearers."
                            },
                            {
                                "example_id": "2d7f5b8e-bf7f-47f5-8518-a6245900ef67",
                                "sense_id": "03b67c08-e07e-3a71-8e34-e27af3530cce",
                                "text": "Mourners carried a hundred or more kāhili, some highly unusual or old or with special names, such as the malulani (shade of the heavens), a handsome large kāhili of black ostrich feathers."
                            }
                        ]
