                ],
                "senses": [
                    {
                        "sense_id": "62c72b5e-77fd-3705-8468-034f52c083cf",
                        "entry_id": "85b8185d-4481-3dc2-92c3-556a5713812e",
                        "glosses": [
                            "Wirtschaftsbereich, der sich mit Finanzen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c94698cc-0122-48a5-b7b8-bd1ee7c86a8b",
                                "sense_id": "62c72b5e-77fd-3705-8468-034f52c083cf",
                                "text": "„Zahlreiche Konkurse in dieser Bankensparte in den späten 1920er-Jahren waren durch die «Schuld unfähiger Geschäftsleiter» herbeigeführt worden, die waghalsige Transaktionen getätigt hatten.“"
                            },
                            {
                                "example_id": "c88288b5-278c-41f5-8965-edfb071d60a7",
                                "sense_id": "62c72b5e-77fd-3705-8468-034f52c083cf",
                                "text": "„Der dritte Crash im Jahr 2008 war die Folge exzessiver Spekulationen, von Risikogeschäften eines Teils der Bankensparte sowie des Handels mit Hypotheken gesicherten Wertpapieren.“"
                            },
                            {
                                "example_id": "a3310922-dce5-4fcf-a692-997c5b032984",
                                "sense_id": "62c72b5e-77fd-3705-8468-034f52c083cf",
                                "text": "„Dabei hat man den Einsatz im globalen Kapital-Casino über das eigene Investmentbanking laufend erhöht – und damit auch die Abhängigkeit von den Ergebnissen dieser sehr speziellen Bankensparte.“"
                            },
                            {
                                "example_id": "352d2242-666d-48b7-8be2-cc1c6bcf78e3",
                                "sense_id": "62c72b5e-77fd-3705-8468-034f52c083cf",
                                "text": "„Sie arbeiteten gerade in Singapur, wo sie offiziell einen Kunden aus der Bankensparte berieten.“"
                            },
                            {
                                "example_id": "9bac4633-40fe-456b-89cc-d8d0028ebbad",
                                "sense_id": "62c72b5e-77fd-3705-8468-034f52c083cf",
                                "text": "„Nach dieser ersten Nachverdichtungsmaßnahme und entsprechender Effizienzerhöhung entstand eine neue Herausforderung durch den Zukauf von zwei Bankensparten durch die Santander Gruppe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
