                "senses": [
                    {
                        "sense_id": "7ac887ca-01e4-3c12-80af-0ab3764fbac0",
                        "entry_id": "04f27cbe-3166-3dad-b4de-d43ce0b188f1",
                        "glosses": [
                            "Partei, welche eine gegenteilige Meinung gegenüber einer anderen Partei vertritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44e667f9-c952-4f3c-b999-3b70bfc5d1e0",
                                "sense_id": "7ac887ca-01e4-3c12-80af-0ab3764fbac0",
                                "text": "Die Gegenseite hat neue Argumente hervorgebracht."
                            },
                            {
                                "example_id": "710a5469-8388-4cdb-bd77-e92b44d361ea",
                                "sense_id": "7ac887ca-01e4-3c12-80af-0ab3764fbac0",
                                "text": "„Wenn die Gegenseite Krieg will, hilft Friedensliebe wenig. Pazifisten gelten heute als Träumer, Populisten oder Putin-Versteher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "87035830-c35e-361a-8121-bcfc3e9c22da",
                        "entry_id": "04f27cbe-3166-3dad-b4de-d43ce0b188f1",
                        "glosses": [
                            "geografisch: Seite, welche gegenüberliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6dc4e2a-e180-45b1-9cc9-5c5dfd34f3f8",
                                "sense_id": "87035830-c35e-361a-8121-bcfc3e9c22da",
                                "text": "Die Gegenseite des Tals bekommt mehr Sonnenlicht als wie ab."
                            }
                        ],
                        "sense_index_json": "\"2\""
