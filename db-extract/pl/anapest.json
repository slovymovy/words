                ],
                "senses": [
                    {
                        "sense_id": "8a145d8b-4fc2-36e9-a272-145616ae0b2a",
                        "entry_id": "c651562a-fb71-3db4-bea5-8e7d91fe00cf",
                        "glosses": [
                            "w wierszach stopa metryczna złożona z dwóch sylab krótkich i jednej długiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "900c03f4-8b9d-40f2-8950-515a77cd5e21",
                                "sense_id": "8a145d8b-4fc2-36e9-a272-145616ae0b2a",
                                "text": "Od limeryków angielskich wymaga się w zasadzie, by były pisane anapestem (ewentualnie z hiperkataleksą), ale jest to stopa trudna do utrzymania w polszczyźnie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7b1468d-e40f-4c42-af06-a010d2cfc031",
                        "source_entry_id": "c651562a-fb71-3db4-bea5-8e7d91fe00cf",
                        "source_sense_id": "8a145d8b-4fc2-36e9-a272-145616ae0b2a",
                        "target_lang_word": "anapesto",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4c2f5cfd-9d1d-4308-bc1e-fed21ba4e5a9",
                        "source_entry_id": "c651562a-fb71-3db4-bea5-8e7d91fe00cf",
                        "source_sense_id": "8a145d8b-4fc2-36e9-a272-145616ae0b2a",
                        "target_lang_word": "анапест",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "анапест",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7035b389-e048-3f3e-a54a-7c5c35d7b044",
                                        "entry_id": "16216581-312b-31cf-9454-98fa06c8357d",
                                        "glosses": [
                                            "филол. в силлабо-тоническом стихосложении: стихотворный размер, трёхсложная стопа, в которой ударный слог располагается вслед за двумя неударными слогами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7919788-a53a-4c42-b062-c6896ffb6d71",
                                                "sense_id": "7035b389-e048-3f3e-a54a-7c5c35d7b044",
                                                "text": "Для них звучали одинаковым звуком и ямбы Барбье, и анапесты Некрасова, и стукотня халтуривших писак."
                                            },
                                            {
                                                "example_id": "5dcea852-657b-4fd2-aa2e-a25fa1e7697a",
                                                "sense_id": "7035b389-e048-3f3e-a54a-7c5c35d7b044",
                                                "text": "Анапест появляется в спартанских маршах, в трагедии и особенно в парабазах комедий, которые поэтому часто называются анапестами."
                                            },
                                            {
                                                "example_id": "a1b11765-9676-439d-9db5-d54d90b4711f",
                                                "sense_id": "7035b389-e048-3f3e-a54a-7c5c35d7b044",
                                                "text": "По фамилии же потому, наверное, называли друг друга, что слышалось — нам обоим, не нам одним, может быть, — некое созвучие в этих фамилиях: обе на -ский, обе довольно редкие; моя, впрочем, тягучий анапест, его — решительный ямб, лишь притворяющийся (как, в свою очередь, сказал я ему однажды, зимней ночью, тридцать лет тому назад) амфибрахием."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc7f275f-c8d2-4b4f-bbd2-576c7eb41b54",
