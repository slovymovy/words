                {
                    "sense_id": "6e587eaa-f150-3369-99a3-dd0fa8c82ddb",
                    "sense_definition": "Chaussure d'intérieur légère, souple et confortable que l'on porte chez soi.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chaussure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'il arrive chez lui, il enlève ses chaussures et enfile ses <w>pantoufles</w>."
                        },
                        {
                            "text": "Elle aime passer le dimanche matin en <w>pantoufles</w> à lire tranquillement près du feu."
                        }
                    ],
                    "synonyms": [
                        "chausson"
                    ],
                    "common_phrases": [
                        "en pantoufles",
                        "mettre ses pantoufles"
                    ]
                },
                {
                    "sense_id": "cdfe20af-92d5-37c6-beba-2b5a3f676773",
