    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "95edaa34-c86f-3500-841f-afb07c514a60",
                    "sense_definition": "Serrer fortement la peau ou un membre avec les doigts ou entre deux objets.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "serrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a poussé un cri quand son frère a commencé à la <w>pincer</w> au bras."
                        },
                        {
                            "text": "Fais bien attention en fermant la porte pour ne pas te <w>pincer</w> les doigts."
                        }
                    ],
                    "synonyms": [
                        "serrer"
                    ],
                    "common_phrases": [
                        "se pincer les doigts"
                    ]
                },
                {
                    "sense_id": "74c8e59f-99ee-3b3c-a23c-d066bf6d16c3",
                    "sense_definition": "Surprendre quelqu'un en flagrant délit ou arrêter une personne coupable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attraper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voleur s'est fait <w>pincer</w> par la sécurité du magasin à la sortie."
                        },
                        {
                            "text": "Les gendarmes ont enfin réussi à <w>pincer</w> les cambrioleurs sur une route nationale."
                        }
                    ],
                    "synonyms": [
                        "attraper",
                        "coincer",
                        "choper"
                    ],
                    "common_phrases": [
                        "se faire pincer",
                        "pincer un voleur"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "af74b4a9-9f6b-3e49-a6c9-ed35705c540f",
                    "sense_definition": "Rapprocher et serrer fermement l'une contre l'autre deux parties mobiles, en particulier les lèvres.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "serrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur <w>pince</w> les lèvres pour masquer son agacement devant le bavardage des élèves."
                        },
                        {
                            "text": "Elle écoutait les critiques sans répondre en <w>pinçant</w> la bouche de dépit."
                        }
                    ],
                    "synonyms": [
                        "serrer"
                    ],
                    "common_phrases": [
                        "pincer les lèvres"
                    ]
                },
                {
                    "sense_id": "6830e5bf-c461-34e3-9633-5ab1fe7941e5",
                    "sense_definition": "Faire vibrer les cordes d'un instrument de musique en les tirant avec les doigts ou un médiator.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le musicien a doucement <w>pincé</w> les cordes de sa guitare pour accompagner la chanteuse."
                        },
                        {
                            "text": "Ce morceau classique demande de <w>pincer</w> chaque note avec une grande délicatesse."
                        }
                    ],
                    "common_phrases": [
                        "pincer les cordes",
                        "pincer une corde"
                    ]
                },
                {
                    "sense_id": "d1ae55f2-b064-3293-a0da-e5fb6d09e6b8",
                    "sense_definition": "Éprouver de l'amour ou une vive attirance pour quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout le monde au lycée a remarqué qu'il en <w>pinçait</w> pour sa voisine de classe."
                        },
                        {
                            "text": "Dès leur premier rendez-vous, elle en a <w>pincé</w> pour ce jeune architecte."
                        }
                    ],
                    "synonyms": [
                        "aimer",
                        "flasher"
                    ],
                    "common_phrases": [
                        "en pincer pour"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier, s'emploie principalement avec en"
                        }
                    ]
                },
                {
                    "sense_id": "a6971e0f-7042-3cb5-b1de-8138c84246ad",
                    "sense_definition": "Produire une sensation vive et cuisante, en parlant du froid ou du vent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mets ton bonnet avant de sortir car le froid <w>pince</w> vraiment fort ce matin."
                        },
                        {
                            "text": "Sur cette crête exposée, la bise glaciale nous <w>pinçait</w> le visage sans répit."
                        }
                    ],
                    "synonyms": [
                        "mordre",
                        "piquer"
                    ],
                    "common_phrases": [
                        "le froid pince"
                    ]
                }
            ]
        }
    ]
}