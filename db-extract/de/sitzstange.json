                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45d39a30-c47f-4f01-830d-2669d716fc07",
                                "sense_id": "b54789b4-25b8-3f6c-8aea-cabec5158571",
                                "text": "Die Sitzstangen im Hühnerstall bestehen aus Holz und geben den Hühnern nachts die Möglichkeit, sich oberhalb des Bodens aufzuhalten."
                            },
                            {
                                "example_id": "057e29cd-c4db-457f-8adf-45c68ad1c283",
                                "sense_id": "b54789b4-25b8-3f6c-8aea-cabec5158571",
                                "text": "Draußen angebrachte Vogelkästen brauchen keine Sitzstange vorm Einflugloch."
                            },
                            {
                                "example_id": "03a83426-623b-4cd6-9ac1-51d81956b66f",
                                "sense_id": "b54789b4-25b8-3f6c-8aea-cabec5158571",
                                "text": "„Diese Sitzstangen sind zwar sehr teuer, aber auch unverwüstlich.“"
                            }
                        ],
