                                        "sense_id": "837705fd-0567-39d8-ac56-11cf58cfc98c",
                                        "entry_id": "1d75e968-fbcf-3871-ad22-3e9268b6fa6c",
                                        "glosses": [
                                            "Something extracted, an extract, as from a plant or an organ of an animal etc."
                                        ],
