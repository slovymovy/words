                },
                {
                    "sense_id": "dd1237a4-04af-3973-843a-8739ac852dbc",
                    "sense_definition": "To become calm or tranquil.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "calm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the commotion died down, the troubled household began to <w>lithe</w> once again.",
                            "target_lang_translations": {
                                "it": "Dopo che il tumulto si fu spento, la famiglia turbata iniziò di nuovo a <w>calmarsi</w>."
                            }
                        },
                        {
                            "text": "His racing thoughts refused to <w>lithe</w> even in the quiet of the night.",
                            "target_lang_translations": {
                                "it": "I suoi pensieri frenetici si rifiutavano di <w>acquietarsi</w> persino nella quiete della notte."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical usage"
                        },
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer in general use"
                        }
