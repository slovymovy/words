                ],
                "senses": [
                    {
                        "sense_id": "0e8e5597-5d00-338d-97e8-c81b02983b05",
                        "entry_id": "6675a108-67b7-3d98-a83a-12a33fa737dc",
                        "glosses": [
                            "vorderer, verdickter Teil einer Pfeife zur Aufnahme des Tabaks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b953f29c-8e00-43b0-85be-3fb956f8c0c3",
                                "sense_id": "0e8e5597-5d00-338d-97e8-c81b02983b05",
                                "text": "„Oder man mußte die Pfeife quernehmen, aber dann zeigte der Pfeifenkopf zur Seite.“"
                            },
                            {
                                "example_id": "ea43ffa5-f810-4a7f-b4ec-1a6d5623d5e3",
                                "sense_id": "0e8e5597-5d00-338d-97e8-c81b02983b05",
                                "text": "„Er hatte alles Feuer aus dem Pfeifenkopf verschüttet, zerbrach die Pfeife und warf sie weg.“"
                            },
                            {
                                "example_id": "d992948b-3b60-4241-8ab0-dac63635ae46",
                                "sense_id": "0e8e5597-5d00-338d-97e8-c81b02983b05",
                                "text": "„Pencroff bastelte sich mit der Tonerde ein paar Pfeifenköpfe zurecht, denn er wollte wissen, ob die Pfeifenerde ihren Namen zu Recht trug oder nicht.“"
                            },
                            {
                                "example_id": "836fc2ad-95f9-4e52-a124-56cd4f5c0754",
                                "sense_id": "0e8e5597-5d00-338d-97e8-c81b02983b05",
                                "text": "„Die Tür nach dem Felde war mit einer Lage Gips überzogen, und auf dieser waren in Reih und Glied fünfhundert Pfeifenköpfe angebracht, die Abd-el-Kaders, Neger, nackte Frauen, Hufeisen und Totenköpfe darstellten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "61d05f76-b86c-3e75-bd8c-4c3f52773da0",
