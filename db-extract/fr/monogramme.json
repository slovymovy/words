                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b87f832-38c7-3b3b-b13a-5b59125a7e85",
                        "entry_id": "9b5d82b8-3741-3d37-bde7-7e386a441346",
                        "glosses": [
                            "Dessin réunissant plusieurs lettres en un seul signe, parfois accompagné d’ornements ou de symboles et servant à signer, à marquer un sceau, des meubles ou tout autre objet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90fde76e-4199-48b7-a4d7-585bb870aca2",
                                "sense_id": "1b87f832-38c7-3b3b-b13a-5b59125a7e85",
                                "text": "Les actes des rois de France ont été longtemps souscrits d’un monogramme."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a3d3e58-6956-3192-8fd5-de2ad6cdb01c",
                        "entry_id": "9b5d82b8-3741-3d37-bde7-7e386a441346",
                        "glosses": [
                            "Broderie représentant des initiales entrelacées ou juxtaposées, destinée à marquer le linge de maison. Aussi appelée Chiffre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51af1179-1a2e-41e8-9ead-9449b8284e31",
                                "sense_id": "6a3d3e58-6956-3192-8fd5-de2ad6cdb01c",
                                "text": "— Un gant de cardinal en soie rouge avec monogramme du Christ brodé or, XVᵉ siècle.\n— Une paire de gants de haut dignitaire ecclésiastique en tricot de fil avec monogramme du Christ et broderies or et soies de couleur, XVIᵉ siècle."
                            },
                            {
                                "example_id": "d4e664a8-6f94-4aac-a291-dcd13e0af29b",
                                "sense_id": "6a3d3e58-6956-3192-8fd5-de2ad6cdb01c",
                                "text": "Jadis, les jeunes filles brodaient leur monogramme sur chaque pièce de leur trousseau."
                            }
                        ]
                    },
                    {
                        "sense_id": "dee7bf8e-4b4f-307e-992d-87d1d6c48b40",
                        "entry_id": "9b5d82b8-3741-3d37-bde7-7e386a441346",
                        "glosses": [
                            "Chiffre ou signe que certains artistes apposent au bas de leurs ouvrages."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "40ff3026-5176-33de-914a-87014c6a74ed",
                        "entry_id": "9b5d82b8-3741-3d37-bde7-7e386a441346",
                        "glosses": [
                            "Un des deux symboles du yin-yang, ⚊ (yang) ou ⚋ (yin), formant les quatre digrammes, les huit trigrammes et les 64 hexagrammes."
                        ],
                        "tags": [
                            "Philosophie chinoise"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
