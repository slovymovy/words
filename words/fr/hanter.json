{
    "word_family": [
        "hantise"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "794d68e4-c5f6-3a9e-bca9-0260a034b32a",
                    "sense_definition": "En parlant d'un esprit ou d'un fantôme, visiter ou habiter régulièrement un lieu de manière surnaturelle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "surnaturel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On raconte que le spectre d'une dame blanche <w>hante</w> ce vieux manoir abandonné depuis des siècles."
                        },
                        {
                            "text": "Les villageois évitent cette forêt la nuit car des esprits mystérieux la <w>hantent</w> sans cesse."
                        }
                    ],
                    "common_phrases": [
                        "hanter un château",
                        "hanter les lieux"
                    ]
                },
                {
                    "sense_id": "96323b98-c070-3eab-a62d-815e78fa79d9",
                    "sense_definition": "Occuper de façon continue et obsédante l'esprit, la pensée ou la mémoire de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le souvenir douloureux de cet accident continue de <w>hanter</w> son esprit jour et nuit."
                        },
                        {
                            "text": "Une terrible question <w>hantait</w> ses pensées et l'empêchait de trouver le sommeil."
                        }
                    ],
                    "synonyms": [
                        "obséder",
                        "poursuivre",
                        "tourmenter"
                    ],
                    "common_phrases": [
                        "hanter l'esprit",
                        "hanter les pensées",
                        "hanter les nuits"
                    ]
                },
                {
                    "sense_id": "241c2253-63db-32d7-81b8-6fc88e77989b",
                    "sense_definition": "Fréquenter régulièrement un lieu de manière assidue ou secrète.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "frequenter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durant toute sa jeunesse, ce poète solitaire aimait <w>hanter</w> les petites ruelles sombres du quartier."
                        },
                        {
                            "text": "Plusieurs personnes suspectes <w>hantent</w> ces quais déserts dès que la nuit commence à tomber."
                        }
                    ],
                    "synonyms": [
                        "fréquenter"
                    ],
                    "antonyms": [
                        "fuir",
                        "éviter"
                    ],
                    "common_phrases": [
                        "hanter les couloirs",
                        "hanter les cafés"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "vieilli ou littéraire"
                        }
                    ]
                },
                {
                    "sense_id": "cba00f12-d09e-33a6-9622-b90e5976cf33",
                    "sense_definition": "Fréquenter assidûment une personne, particulièrement quelqu'un de mauvaise influence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "frequenter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses parents s'inquiétaient beaucoup de le voir <w>hanter</w> des bandits et des vagabonds du port."
                        },
                        {
                            "text": "Il a pris de mauvaises habitudes après avoir commencé à <w>hanter</w> des individus peu recommandables."
                        }
                    ],
                    "synonyms": [
                        "côtoyer",
                        "fréquenter"
                    ],
                    "antonyms": [
                        "fuir",
                        "éviter"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "vieilli"
                        }
                    ]
                }
            ]
        }
    ]
}