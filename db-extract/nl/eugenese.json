                            {
                                "example_id": "82cdc320-e6ae-4c34-b025-29bc4cfde3fd",
                                "sense_id": "cf4bdd5e-74ed-37d2-8f59-e4ee4c799d71",
                                "text": "'Ouders willen het geslacht van hun kind onder controle hebben. Bovendien verlangt een groeiend aantal ouders naar het perfecte kind', aldus de pauselijke raad. De test zou volgens de raad de zogeheten eugenese alweer een stap vooruit helpen, namelijk via wetenschappelijk onderzoek naar erfelijke eigenschappen het menselijke ras proberen te verbeteren."
                            }
                        ]
                    }
