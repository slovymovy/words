                "senses": [
                    {
                        "sense_id": "afb09faf-94fc-3d3b-8691-26042d3a9433",
                        "entry_id": "8d840100-5d8d-3e9d-8484-118b549135b0",
                        "glosses": [
                            "Donner un caractère zwinglien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf61da96-107b-49c3-a61a-54f4beeaff49",
                                "sense_id": "afb09faf-94fc-3d3b-8691-26042d3a9433",
                                "text": "Le gros ventre, avait dit un de ses collègues du Conseil, est enceint d’un Zwinglien, et aimerait zwinglianiser toute la ville."
                            }
                        ]
                    },
                    {
                        "sense_id": "4854d9ed-e7f8-3722-8edb-53eb39b90849",
                        "entry_id": "8d840100-5d8d-3e9d-8484-118b549135b0",
                        "glosses": [
                            "Être zwinglien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80eca65c-2767-4d06-80a1-1727d908a57b",
                                "sense_id": "4854d9ed-e7f8-3722-8edb-53eb39b90849",
                                "text": "Cette censure provoqua une vive réaction et les théologiens de Hesse furent accusés par ceux de Saxe de \"zwinglianiser\", tandis que l’Electeur de Saxe écrivait aux Landgraves."
                            }
                        ]
                    }
