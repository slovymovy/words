                "senses": [
                    {
                        "sense_id": "a0a62f81-32d6-3bca-ad63-9940c93f38cc",
                        "entry_id": "6fd8dfac-a34a-3a2a-a20b-6207c841f18e",
                        "glosses": [
                            "долина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2d8dc8d-b163-4b78-a31d-c4e555ddd5e6",
                                "sense_id": "a0a62f81-32d6-3bca-ad63-9940c93f38cc",
                                "text": "Сошёл я в дол заветный, // Дол, первых дум моих лелеятель приветный!"
                            }
                        ]
                    },
                    {
                        "sense_id": "53742275-c9d4-3aeb-955f-0e01d204d1fc",
                        "entry_id": "6fd8dfac-a34a-3a2a-a20b-6207c841f18e",
                        "glosses": [
                            "продольный желобок на клинке, служащий для его облегчения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9e59cbf-b647-4cc5-9ff0-dba5968430a6",
                                "sense_id": "53742275-c9d4-3aeb-955f-0e01d204d1fc",
                                "text": "Шапка железная калмыцкая, гладкая с долами; наверху трубочка, уши и затылок куяшные, подложена бархатом цветным; поверх шапки над трубой слова калмыцкие."
                            }
                        ]
                    }
                ],
