                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c4ca615-9977-4666-ab6b-f5e6f3a427f5",
                                "sense_id": "8154d158-bb77-328d-b243-5a042d53236d",
                                "text": "„Nur über die Kombination dieser Funde ist eine Identifikation als mykenisches Heiligtum überhaupt möglich, denn anders als bei den klassischen Tempeln gab es in mykenischer Zeit keine speziellen Bauformen, die typischerweise und ausschließlich für Kultbauten verwendet wurden.“"
                            },
                            {
                                "example_id": "e91408df-df10-48da-8d91-4768a1db5bc7",
                                "sense_id": "8154d158-bb77-328d-b243-5a042d53236d",
                                "text": "„Die Altersbestimmung ergab, dass man den ältesten Kultbau Perus gefunden hatte.“"
                            }
                        ],
