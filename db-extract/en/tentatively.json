                    {
                        "sense_id": "7094130a-c18d-3083-a255-005ff456dd3a",
                        "entry_id": "89490b1a-4c7a-367a-ac43-73510a8f5c44",
                        "glosses": [
                            "In a tentative manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c814f0e7-412a-40f2-b4be-1ebaa762feb1",
                                "sense_id": "7094130a-c18d-3083-a255-005ff456dd3a",
                                "text": "This last activity was studied in the second paper of this series and it was suggested tentatively that the peculiarly adaptive discoördination in this and other reactions might be due to the pull of part upon part, acting through the substrate."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96290381-90d9-4afb-850e-3635c771612d",
                        "source_entry_id": "89490b1a-4c7a-367a-ac43-73510a8f5c44",
                        "source_sense_id": "7094130a-c18d-3083-a255-005ff456dd3a",
                        "source_sense_description": "of, or having to do with being tentative",
                        "target_lang_word": "expérimentalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expérimentalement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "731487bd-eba1-3ce2-a800-f0238f59c63c",
                                        "entry_id": "59099393-30a1-3035-9800-4c6a731050ca",
                                        "glosses": [
                                            "D’une manière expérimentale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6e6cf7-3e26-4462-bab5-43e0fbed854e",
                                                "sense_id": "731487bd-eba1-3ce2-a800-f0238f59c63c",
                                                "text": "Ces faits, on les collectionne, on les interroge, on les classe, on les recrée même expérimentalement pour dégager les lois qui les régissent."
                                            },
                                            {
                                                "example_id": "0c93e994-c224-4bfd-a456-83ae7d4c7b69",
                                                "sense_id": "731487bd-eba1-3ce2-a800-f0238f59c63c",
                                                "text": "En fait, nous tentons de connaître dans les moindres détails les mécanismes de bioaccumulation ou, au contraire, de bioélimination des toxines et d’arriver à les reproduire expérimentalement, poursuivit Cailly, nullement perturbé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2cc8e11-3211-4e8e-8bbb-8297b5229f76",
                        "source_entry_id": "89490b1a-4c7a-367a-ac43-73510a8f5c44",
                        "source_sense_id": "7094130a-c18d-3083-a255-005ff456dd3a",
                        "source_sense_description": "of, or having to do with being tentative",
                        "target_lang_word": "versuchsweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "versuchsweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96f0e2a9-c4c6-30a5-a84f-79d4d753945e",
                                        "entry_id": "d0c9ba19-16bb-312a-bdbb-2a31aeb54c4e",
                                        "glosses": [
                                            "(nur) um etwas zu überprüfen, zu testen; als Versuch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5f36123-afec-445e-b43d-12c62e5a6339",
                                                "sense_id": "96f0e2a9-c4c6-30a5-a84f-79d4d753945e",
                                                "text": "„Gabriel verlagerte sein Gewicht versuchsweise auf den rechten Fuß, dann auf den linken.“"
                                            },
                                            {
                                                "example_id": "14efec72-5415-40e6-840b-76968206f546",
                                                "sense_id": "96f0e2a9-c4c6-30a5-a84f-79d4d753945e",
                                                "text": "„Sie nimmt den Rat an, versuchsweise während der nächsten 2 Wochen ein Literatur Schlaf- und Traumtagebuch zu führen.“"
                                            },
                                            {
                                                "example_id": "6d87ab48-dc14-43eb-84ee-a1da28d8cba5",
                                                "sense_id": "96f0e2a9-c4c6-30a5-a84f-79d4d753945e",
                                                "text": "„Du kannst das besser beurteilen als ich; nur meine ich, du könntest es versuchsweise einmal von dieser Seite aus betrachten.“"
                                            },
                                            {
                                                "example_id": "64c4f3a2-15a8-486d-bcac-9ef97af38edc",
                                                "sense_id": "96f0e2a9-c4c6-30a5-a84f-79d4d753945e",
                                                "text": "„Will hielt eine Hand mit der anderen fest, um wenigstens versuchsweise sein Zittern zu verbergen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ff89d45-634a-417a-9af0-e2f5096b4c75",
                        "source_entry_id": "89490b1a-4c7a-367a-ac43-73510a8f5c44",
                        "source_sense_id": "7094130a-c18d-3083-a255-005ff456dd3a",
