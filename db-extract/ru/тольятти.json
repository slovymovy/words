                ],
                "senses": [
                    {
                        "sense_id": "e185a8a1-7d8a-3f71-85a0-20d908e127c4",
                        "entry_id": "7a823f52-201e-30ac-a5fd-0a84c1c226c2",
                        "glosses": [
                            "город в России, в Самарской области; расположен на левом берегу Волги напротив Жигулей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c578e80e-3ab8-4b5d-a94a-ff4be5f9b45c",
                                "sense_id": "e185a8a1-7d8a-3f71-85a0-20d908e127c4",
                                "text": "Недавно мы с приятелями ехали на своей машине из Тольятти в Пермь."
                            },
                            {
                                "example_id": "deb3bd9e-c52a-4764-8112-22f7b03c3e0f",
                                "sense_id": "e185a8a1-7d8a-3f71-85a0-20d908e127c4",
                                "text": "В соревнованиях примут участие гонщики из Москвы, Тольятти и Татарстана."
                            },
                            {
                                "example_id": "c5d2a466-048e-4ef9-9887-4437e802b7f6",
                                "sense_id": "e185a8a1-7d8a-3f71-85a0-20d908e127c4",
                                "text": "Я приехал в Тольятти посмотреть, как делают автомобили в большом количестве."
                            }
                        ]
                    }
                ],
