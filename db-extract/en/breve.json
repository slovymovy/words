                                    {
                                        "sense_id": "20f88075-91dc-37f9-a885-83d706d5cd5d",
                                        "entry_id": "5e0bea29-4707-37dc-82f0-c1814cef765a",
                                        "glosses": [
                                            "Cadre ou couronne de métal qui sert à attacher les rideaux d’un lit."
                                        ],
                                        "tags": [],
