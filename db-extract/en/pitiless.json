                                        "entry_id": "6f25faee-2b11-3df8-8abb-0319d5a61f3e",
                                        "glosses": [
                                            "ohne Erbarmen; ohne Mitleid, Nachsicht zu zeigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a393f0af-952d-47aa-b6da-f7fc135d9b81",
                                                "sense_id": "6d3c031f-34e8-3f6d-b8e4-c122a5e8012b",
                                                "text": "Die Gefangenen wurden erbarmungslos vorangetrieben."
                                            },
                                            {
                                                "example_id": "85716a79-387d-48c1-99c6-c382ee4ce623",
                                                "sense_id": "6d3c031f-34e8-3f6d-b8e4-c122a5e8012b",
                                                "text": "Der Reiter schlug erbarmungslos auf sein Pferd ein."
                                            },
                                            {
                                                "example_id": "6b112e9f-d22e-4cb1-b154-c77e912c0bb7",
                                                "sense_id": "6d3c031f-34e8-3f6d-b8e4-c122a5e8012b",
                                                "text": "„Dann prügelte er die beiden erbarmungslos zusammen und - was noch schrecklicher war - entzog ihnen für Tage die Nahrung.“"
                                            },
                                            {
                                                "example_id": "9d7de7df-1626-4c55-85ad-ae5d490e4905",
                                                "sense_id": "6d3c031f-34e8-3f6d-b8e4-c122a5e8012b",
                                                "text": "„War er sich denn nicht der Tatsache bewusst, dass in dieser erbarmungslosen Gesellschaft, in der alles aufgenommen und fotografiert wurde, nicht einmal das kleinste Fehlbetragen oder missverständliche Wort unbemerkt blieben?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
