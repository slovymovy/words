    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "69b418cf-e458-3609-8856-f5a97b2d7f7e",
                    "sense_definition": "to question someone thoroughly and often aggressively, especially to obtain information or a confession",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "questioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police <w>interrogated</w> the suspect for several hours before he finally admitted to the crime.",
                            "target_lang_translations": {
                                "ru": "Полиция <w>допрашивала</w> подозреваемого в течение нескольких часов, прежде чем он наконец признался в преступлении."
                            }
                        },
                        {
                            "text": "Detectives had to <w>interrogate</w> the witness to find out exactly what happened that night.",
                            "target_lang_translations": {
                                "ru": "Детективам пришлось <w>допросить</w> свидетеля, чтобы выяснить, что именно произошло той ночью."
                            }
                        }
                    ],
                    "synonyms": [
                        "question",
                        "grill",
                        "examine",
                        "cross-examine"
                    ],
                    "antonyms": [
                        "answer",
                        "reply",
                        "respond"
                    ],
                    "common_phrases": [
                        "interrogate the suspect",
                        "interrogate the witness",
                        "interrogate for hours"
                    ],
                    "target_lang_definitions": {
                        "ru": "тщательно и часто агрессивно расспрашивать кого-либо, особенно с целью получения информации или признания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "допрашивать",
                                "target_lang_sense_clarification": "проводить официальный допрос"
                            },
                            {
                                "target_lang_word": "допросить",
                                "target_lang_sense_clarification": "совершить акт допроса"
                            },
                            {
                                "target_lang_word": "устраивать допрос",
                                "target_lang_sense_clarification": "интенсивно расспрашивать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "933d49e0-9622-3837-8c79-5c18cd4a479b",
                    "sense_definition": "to examine a concept, text, or situation critically in order to understand its underlying assumptions or implications",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "analysis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In her latest essay, the author seeks to <w>interrogate</w> the construct of childhood innocence in modern society.",
                            "target_lang_translations": {
                                "ru": "В своем последнем эссе автор стремится <w>проанализировать</w> конструкт детской невинности в современном обществе."
                            }
                        },
                        {
                            "text": "Students are encouraged to <w>interrogate</w> the text to uncover hidden biases and social myths.",
                            "target_lang_translations": {
                                "ru": "Студентам рекомендуется критически <w>исследовать</w> текст, чтобы выявить скрытые предубеждения и социальные мифы."
                            }
                        }
                    ],
                    "synonyms": [
                        "analyze",
                        "scrutinize",
                        "examine",
                        "investigate"
                    ],
                    "common_phrases": [
                        "interrogate the construct",
                        "interrogate the text",
                        "interrogate the assumptions"
                    ],
                    "traits": [
