                                "target_senses": [
                                    {
                                        "sense_id": "b9995fb4-e6c6-3a23-8246-cb8e06428c0e",
                                        "entry_id": "7b62ffc8-b6c0-301f-987d-d9bd7a187e9b",
                                        "glosses": [
                                            "A proposed approach to resolving the Israeli–Palestinian conflict, by creating two states on the territory of the former Mandatory Palestine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de980158-2d56-4318-9c3a-1a9fe0f4d8c5",
                                                "sense_id": "b9995fb4-e6c6-3a23-8246-cb8e06428c0e",
                                                "text": "The advocates of binationalism typically distinguish it from the more familiar two-state solution, according to which two states, one Israeli and the other Palestinian, are imagined to coexist next to each other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
