        "nl-extract.jsonl": [
            {
                "entry_id": "7c56b1ed-a074-36e3-8664-897ad6ea7cc9",
                "word": "bagage",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "3cdb2119-9a65-4520-9b96-3de4cca45727",
                        "entry_id": "7c56b1ed-a074-36e3-8664-897ad6ea7cc9",
                        "tags": [
                            "plural"
                        ],
                        "form": "bagages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb1723d4-d999-3942-a02a-bd5830a20fe8",
                        "entry_id": "7c56b1ed-a074-36e3-8664-897ad6ea7cc9",
                        "glosses": [
                            "een verzameling van eigendommen van een reiziger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f96a618-9155-47c5-b46b-32a614c4c113",
                                "sense_id": "eb1723d4-d999-3942-a02a-bd5830a20fe8",
                                "text": "De bagage van de reiziger paste maar net in de koffer."
                            },
                            {
                                "example_id": "bd967e26-641f-4cc5-888b-af616500a7f5",
                                "sense_id": "eb1723d4-d999-3942-a02a-bd5830a20fe8",
                                "text": "Als na een beproeving ging het slot na een paar pogingen open, en binnen een paar tellen stond Hind el Arian met bagage en al in de hal."
                            },
                            {
                                "example_id": "e0192650-656c-423c-95c7-23c94355ae3e",
                                "sense_id": "eb1723d4-d999-3942-a02a-bd5830a20fe8",
                                "text": "Ik drukte mijn sigaret uit in de bloempot die ons tot asbak had gediend. Hij deed hetzelfde en sprong overeind om zich over mijn bagage te ontfermen."
                            }
                        ]
                    },
                    {
                        "sense_id": "6355374c-ae6f-38c7-bb39-ef74e1a5a841",
                        "entry_id": "7c56b1ed-a074-36e3-8664-897ad6ea7cc9",
                        "glosses": [
                            "iets dat men voortdurend in zich meedraagt en ervaart"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ba7444e1-2b58-450f-814c-c97dff88dbe4",
                                "sense_id": "6355374c-ae6f-38c7-bb39-ef74e1a5a841",
                                "text": "Emotionele bagage."
                            },
                            {
                                "example_id": "fed53ef1-6a2d-4c0b-a343-f055068d61ba",
                                "sense_id": "6355374c-ae6f-38c7-bb39-ef74e1a5a841",
                                "text": "Nee, nee, zij draagt voortaan haar eigen bagage want op anderen steunen is jezelf in de voet schieten, is je eigen graf delven, daar kan je van op aan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b11135a7-1c9f-4aa2-8506-ef353751a5b6",
                        "source_entry_id": "7c56b1ed-a074-36e3-8664-897ad6ea7cc9",
                        "source_sense_id": "eb1723d4-d999-3942-a02a-bd5830a20fe8",
                        "source_sense_description": "een verzameling van eigendommen",
                        "target_lang_word": "Gepäck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gepäck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f375bbb9-b0f1-3333-a207-c64104bc09d9",
                                        "entry_id": "a94d7ac9-5f9b-3017-8892-a74081cd4e0c",
                                        "glosses": [
                                            "gesamte Ausrüstung für eine Reise, eine Wanderung oder einen Marsch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a826b8b-c7d9-4943-aa31-3f590e681258",
                                                "sense_id": "f375bbb9-b0f1-3333-a207-c64104bc09d9",
                                                "text": "So viel Gepäck können wir kaum unterbringen."
                                            },
                                            {
                                                "example_id": "f230b8f4-2c78-45e3-afa8-189bcc6f0cc6",
                                                "sense_id": "f375bbb9-b0f1-3333-a207-c64104bc09d9",
                                                "text": "„Und dann hat er wieder in seinem Gepäck gekramt und eine Bulette hervorgeholt.“"
                                            },
                                            {
                                                "example_id": "1998aa5c-5a8b-49b3-af08-fe12347d6b40",
                                                "sense_id": "f375bbb9-b0f1-3333-a207-c64104bc09d9",
                                                "text": "„Ich sah ihn noch sein Gepäck in den Bahnhof tragen, und dann war er verschwunden.“"
                                            },
                                            {
                                                "example_id": "ae40d676-5b5d-4517-a9cf-8cb403658d31",
                                                "sense_id": "f375bbb9-b0f1-3333-a207-c64104bc09d9",
                                                "text": "„Samoura sprach ein paar kurze Abschiedsworte, dann nahmen wir unser Gepäck auf und durchquerten im Laufschritt das Dorf in der Richtung, aus der wir am Tag zuvor gekommen waren.“"
                                            },
                                            {
                                                "example_id": "06fbda1a-5d30-42fd-8780-57f2d58251dd",
                                                "sense_id": "f375bbb9-b0f1-3333-a207-c64104bc09d9",
                                                "text": "„Ich war allein, reiste mit leichtem Gepäck und brauchte nur eine billige Hinfahrkarte.\""
                                            },
                                            {
                                                "example_id": "2dcd8d92-f912-436e-8d13-596ec7c33c29",
                                                "sense_id": "f375bbb9-b0f1-3333-a207-c64104bc09d9",
                                                "text": "„Alle Passagiere sammt ihren Gepäcken wurden glücklich ans Ufer gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04518ad7-02b7-47d9-b6b3-14780b5cd99f",
                        "source_entry_id": "7c56b1ed-a074-36e3-8664-897ad6ea7cc9",
                        "source_sense_id": "eb1723d4-d999-3942-a02a-bd5830a20fe8",
                        "source_sense_description": "een verzameling van eigendommen",
                        "target_lang_word": "luggage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luggage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85c7b90c-3e12-3e1d-a910-025fab4fa25c",
                                        "entry_id": "f8264f51-4b3d-30c9-9cf1-f6884e3c933e",
                                        "glosses": [
                                            "The bags and other containers that hold a traveller's belongings."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b531db68-cf42-4d30-8d4b-ee9695db78a5",
                                                "sense_id": "85c7b90c-3e12-3e1d-a910-025fab4fa25c",
                                                "text": "August 4, 1726, Jonathan Swift, letter to Alexander Pope\nI am gathering up my luggage, and preparing for my journey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8847ffa0-a651-3c2e-b214-753ba5231698",
                                        "entry_id": "f8264f51-4b3d-30c9-9cf1-f6884e3c933e",
                                        "glosses": [
                                            "The contents of such containers."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7fdeefc0-97d8-3ee0-8298-63a209c54707",
                                        "entry_id": "f8264f51-4b3d-30c9-9cf1-f6884e3c933e",
                                        "glosses": [
                                            "A specific bag or container holding a traveller's belongings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "nonstandard",
                                            "obsolete",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7275d201-4765-4e6a-940d-b095ce47256f",
                                                "sense_id": "7fdeefc0-97d8-3ee0-8298-63a209c54707",
                                                "text": "I assisted some time ago in cutting up a tree, that made tolerably good turns or luggage for nineteen or twenty persons, which could be procured for about two dollars at the stump."
                                            },
                                            {
                                                "example_id": "09a99c04-eac2-4081-93a6-56c7a153dcc1",
                                                "sense_id": "7fdeefc0-97d8-3ee0-8298-63a209c54707",
                                                "text": "The passengers injured who could not get out were removed out by the railway staff, and then taking part of the luggage the train started back for Burdwan."
                                            },
                                            {
                                                "example_id": "ae3e92c8-f87c-40fb-8842-0e56df8ca24d",
                                                "sense_id": "7fdeefc0-97d8-3ee0-8298-63a209c54707",
                                                "text": "Namely, leaving my luggages at the Government hostel, to go straight out by taxi (oh, so slow, compared with our sleek Lagos limousines!) to the famous central Piccadilly Tube station where I took a onestop ticket, went down on the escalator, and then ran up the same steps in the wrong direction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40b4634e-0f64-4dff-b69b-4ada1f5e1a97",
                        "source_entry_id": "7c56b1ed-a074-36e3-8664-897ad6ea7cc9",
