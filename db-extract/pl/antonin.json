                    {
                        "translation_id": "4fbd4d79-f58c-413f-9907-605719a8c305",
                        "source_entry_id": "05979b0d-8acb-3d8a-8c3d-2c61034bf1d1",
                        "source_sense_id": "a71ae38f-9bdb-39ce-971f-0c49331f5872",
                        "target_lang_word": "Antonin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antonin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84dceed2-f93e-3c63-85f1-49d5d294378e",
                                        "entry_id": "db9a6c13-65a5-3e97-8b92-972642b92531",
                                        "glosses": [
                                            "Dynastie romaine du IIᵉ siècle. — Note d’usage : Ce terme est généralement utilisé au pluriel."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46f1e279-7243-48ca-a4e0-d1cb306f983a",
                                                "sense_id": "84dceed2-f93e-3c63-85f1-49d5d294378e",
                                                "text": "Le vrai, c’est qu’une foule énorme s’étageait, s’écrasait sur les gradins brûlés du vieil amphithéâtre, comme au beau temps des Antonins, et que la fête des comices n’était pour rien dans ce débordement de peuple."
                                            },
                                            {
                                                "example_id": "943ae9cf-dd48-4319-aa36-b6cb2fec299d",
                                                "sense_id": "84dceed2-f93e-3c63-85f1-49d5d294378e",
                                                "text": "Comparé à la libéralité et au confort de la vie ordinaire de l’époque, l’ordre de l’Empire romain, sous les Antonins, apparaît local et limité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19889cc0-87c5-36db-8a1f-f16646bc4a8d",
                                        "entry_id": "db9a6c13-65a5-3e97-8b92-972642b92531",
                                        "glosses": [
                                            "Habitant de Saint-Antoine-l’Abbaye, commune française située dans le département de l’Isère."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Antonin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db879663-628d-3d05-ae66-807f010b8153",
                                        "entry_id": "60fbb59a-97d6-3a0d-b8d4-8a924ca67047",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8f72142-b477-4f4b-9dc9-90668579fac2",
                                                "sense_id": "db879663-628d-3d05-ae66-807f010b8153",
                                                "text": "Bien acagnardé contre le zinc à pampres de son estaminet de prédilection, Antonin lantiponait à foison parmi des norias de pieds nickelés en mouillage."
                                            },
                                            {
                                                "example_id": "0ba9a78e-9c7a-4f6f-9766-ac9f5c4ec2b8",
                                                "sense_id": "db879663-628d-3d05-ae66-807f010b8153",
                                                "text": "Monsieur, disait dans la salle à manger le domestique d’Antonin à son maître, le tilbury est armoirié…"
                                            },
                                            {
                                                "example_id": "5597449b-8889-4499-a20c-b9c09b751a5b",
                                                "sense_id": "db879663-628d-3d05-ae66-807f010b8153",
                                                "text": "Le chef de secteur, Antonin Dianoux, et le chef de poste évoquent leur mission : « Ces personnes ont été sauvées d’une noyade certaine. C’est notre mission, nous sommes formés pour ça »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
