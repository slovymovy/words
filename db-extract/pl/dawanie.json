                                            {
                                                "example_id": "6736558c-c55d-45c9-a423-484e8b28f9d8",
                                                "sense_id": "438dedc5-19be-3059-9a5b-4f0b2588f594",
                                                "text": "1981, fa.human-nets, 6 May 1981 0359-EDT, Gary Feldman at CMU-10A\nThese bright surfaces are sprayed with a fine spray of ink, thus giving them an even surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54868345-9e27-3d60-9cfa-52a797b6befb",
                                        "entry_id": "95ac5901-e84a-34d5-aec6-51d2b2aa9c57",
                                        "glosses": [
                                            "giving off a certain vibe or aesthetic."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7f14cd2-8baa-4074-b554-ce285447ddc2",
                                                "sense_id": "54868345-9e27-3d60-9cfa-52a797b6befb",
                                                "text": "This dress is giving summer and margaritas. Love it!"
                                            },
                                            {
                                                "example_id": "c1349a88-3f74-4cf6-acd0-874bda453171",
                                                "sense_id": "54868345-9e27-3d60-9cfa-52a797b6befb",
                                                "text": "Stop texting me! It's giving \"desperate\", honestly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "265a109b-6be7-34f2-a07a-c94264dee4ad",
                                        "entry_id": "95ac5901-e84a-34d5-aec6-51d2b2aa9c57",
                                        "glosses": [
                                            "exuding, radiating, stunning."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3af900c-7d8b-48c4-b985-a1bceac4bd63",
                                                "sense_id": "265a109b-6be7-34f2-a07a-c94264dee4ad",
                                                "text": "Your outfit is giving!"
                                            },
                                            {
                                                "example_id": "c51a238a-3eab-4e20-b44c-ec9bde3ba73c",
                                                "sense_id": "265a109b-6be7-34f2-a07a-c94264dee4ad",
                                                "text": "There were lots of statement nail moments at the 2022 MTV VMA‘s, and Latto‘s metallic french tip manicure was one of them. [see title]"
                                            },
                                            {
                                                "example_id": "aae7c687-2508-48d7-9f98-4e1f9022f2e7",
                                                "sense_id": "265a109b-6be7-34f2-a07a-c94264dee4ad",
                                                "text": "Next, the TikTok user showed her followers the $15 solid scoop neck tank dress in mocha brown. / \"This one is giving. I love this, this is so cute. I think my body shape looks really cute in it,\" she told her followers."
                                            },
                                            {
                                                "example_id": "7b8f862d-ac83-4e83-9fb8-e57ad0f2016e",
                                                "sense_id": "265a109b-6be7-34f2-a07a-c94264dee4ad",
                                                "text": "The fashion influencer also posts content showing off her corporate looks, demonstrating how she can be professional and stylish. / In the comments, people seemed less concerned with her outfit than her hair styling. / \"Okay but the fringe is giving,\" wrote one person."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "giving",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d3a0f6a-e37c-3c5a-9ff9-0082691ae700",
                                        "entry_id": "268f82a3-e9da-3d4e-b467-842e3c76429c",
                                        "glosses": [
                                            "Having the tendency to give; generous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "108d68ef-f20c-4b6c-967b-4f808fe27bd1",
                                                "sense_id": "7d3a0f6a-e37c-3c5a-9ff9-0082691ae700",
                                                "text": "To become like Christ involves everything else: becoming a loving and giving person, having confidence enabling you to be vulnerable (psychologically and physically; Jesus did both), having the wisdom to see people's needs and the desire to meet them."
                                            }
                                        ]
                                    }
                                ]
                            },
