                                        "examples": [
                                            {
                                                "example_id": "06506cf6-13c0-4b16-8282-fa036150034f",
                                                "sense_id": "0fe44f8e-d7e5-38d7-a606-767bb021241b",
                                                "text": "La valorisation d’un produit peut se faire par l’utilisation et l’agencement de technologies, d’éléments ou de composants accessibles de manière indépendante : c’est la modularité."
                                            },
                                            {
                                                "example_id": "5e7b1d61-67e7-422d-b7fb-1bca93706147",
                                                "sense_id": "0fe44f8e-d7e5-38d7-a606-767bb021241b",
                                                "text": "Airbus A 320"
