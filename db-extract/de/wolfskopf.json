                                "example_id": "9083b878-9268-43c7-af32-7f5820349aa3",
                                "sense_id": "35904229-4162-34d6-a6cd-171cd2066272",
                                "text": "„An der Wand hinter de Montour war ein Schatten zu sehen - ein Schatten, der aussah wie ein Wolfskopf!“"
                            },
                            {
                                "example_id": "ac60be68-0cb7-4678-9a41-3b1a1aee6565",
                                "sense_id": "35904229-4162-34d6-a6cd-171cd2066272",
                                "text": "„Als er sich aufrichtete und sich ihm zuwandte, sah Atticus eine Tätowierung auf seinem Unterarm, die wie ein Wolfskopf aussah.“"
                            }
                        ],
