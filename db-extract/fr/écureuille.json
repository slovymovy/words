                ],
                "senses": [
                    {
                        "sense_id": "fc243bb0-79e7-3e91-b8c5-38318553de4a",
                        "entry_id": "efc6b925-fe70-333b-be75-a033d67f00bd",
                        "glosses": [
                            "Petite mammifère femelle rongeuse et arboricole douée d’une grande agilité et remarquable par sa queue touffue qui se relève en panache."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "93f2f263-ac56-4d3a-8d5b-987d598611e1",
                                "sense_id": "fc243bb0-79e7-3e91-b8c5-38318553de4a",
                                "text": "Une activité fiévreuse régnait bien sûr dans la cuisine et personne probablement ne se souciait du confort de l’écureuille."
                            },
                            {
                                "example_id": "271f0586-cf3b-4b14-a453-ea0b8da2f335",
                                "sense_id": "fc243bb0-79e7-3e91-b8c5-38318553de4a",
                                "text": "Ce n’était qu’un écureuil femelle du Brésil, une petite écureuille qui leur montra tout de suite ses griffes tranchantes, et deux incisives à couper le verre."
                            },
                            {
                                "example_id": "2b0eb0f7-1778-41dc-ac93-b9c78387d507",
                                "sense_id": "fc243bb0-79e7-3e91-b8c5-38318553de4a",
                                "text": "Un de ces jours de fin d’automne où l’on commence à imaginer l’hiver,\n Un jour de pluie qui nous laisse rêveur et nous ramène à l’intérieur des choses,\n L’un de ces jours où, sous prétexte de parapluie,\n Un hérisson rencontra une écureuille."
                            }
                        ]
                    }
                ],
