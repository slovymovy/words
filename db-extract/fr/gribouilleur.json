                    {
                        "sense_id": "3a0a18e8-6392-367d-a60b-0d1905c10347",
                        "entry_id": "4117d914-f0e9-3586-84af-5ced5d769d85",
                        "glosses": [
                            "Se dit d’un mauvais peintre, d’un mauvais écrivain."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b14c4823-7b40-415f-9632-577b4d1a3500",
                                "sense_id": "3a0a18e8-6392-367d-a60b-0d1905c10347",
                                "text": "Une dextérité de pointe rappelant celle de Callot, mais avec une puissance que n’eut jamais cet amusant gribouilleur."
                            },
                            {
                                "example_id": "926fc614-ed74-4ba9-ad40-703f0646f94d",
                                "sense_id": "3a0a18e8-6392-367d-a60b-0d1905c10347",
                                "text": "Les petits gribouilleurs des Cahiers du Cinéma et autres lieux devraient bien les lire – si tant est qu'ils sachent lire."
                            }
                        ]
                    }
                ],
