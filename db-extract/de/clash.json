                                "target_senses": [
                                    {
                                        "sense_id": "a4f35d3d-07ce-3fce-b353-e00a9cef614c",
                                        "entry_id": "5591d140-96e4-30c3-a9fe-1b91088442da",
                                        "glosses": [
                                            "A loud sound, like the crashing together of metal objects; a crash."
                                        ],
                                        "tags": [
                                            "countable",
                                            "onomatopoeic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3401124b-aded-4f7f-9648-2b7eaf86e614",
                                                "sense_id": "a4f35d3d-07ce-3fce-b353-e00a9cef614c",
                                                "text": "I heard a clash from the kitchen, and rushed in to find the cat had knocked over some pots and pans."
                                            },
                                            {
                                                "example_id": "45385664-09a7-4004-a0a2-2d0a8185203a",
                                                "sense_id": "a4f35d3d-07ce-3fce-b353-e00a9cef614c",
                                                "text": "Alone amid clashes of rain against the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d265a19-5171-3e5a-aa12-2a1bc0eaf295",
                                        "entry_id": "5591d140-96e4-30c3-a9fe-1b91088442da",
                                        "glosses": [
                                            "A skirmish, a hostile encounter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e4e670d-0198-41c1-a607-0ad551571aea",
                                                "sense_id": "1d265a19-5171-3e5a-aa12-2a1bc0eaf295",
                                                "text": "In Anatolia tensions between state officials (ehl-i örf) and the peasants were strained to breaking point.\nAt several places—particularly in the frontier provinces—there were fierce clashes between the janissaries stationed there and the governors. In Aleppo and Damascus incidents were common after 1589: the kuls threw rocks at the beylerbeyi’s house, killed people, broke into the divan several times and took the money prepared by the council for remittance to the centre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e6bcc4b-9abb-35ea-9fb1-91148f2bb0f7",
                                        "entry_id": "5591d140-96e4-30c3-a9fe-1b91088442da",
                                        "glosses": [
                                            "match; a game between two sides."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d0378a8-ece5-4527-98fb-411f3f3db36c",
                                                "sense_id": "3e6bcc4b-9abb-35ea-9fb1-91148f2bb0f7",
                                                "text": "But they ran out of time and inspiration as Les Bleus set up a deserved semi-final clash with Wales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "235a0add-abe6-3e4f-b8cf-cf3f84f98c87",
                                        "entry_id": "5591d140-96e4-30c3-a9fe-1b91088442da",
                                        "glosses": [
                                            "An angry argument."
