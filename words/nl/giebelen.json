{
    "word_family": [
        "gegiebel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4171ee8d-3a4c-32e0-b72a-171d9e9e3705",
                    "sense_definition": "Zachtjes en een beetje geheimzinnig lachen",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "lachen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik weet niet waarom die twee daar achterin aan het <w>giebelen</w> zijn.",
                            "target_lang_translations": {
                                "pl": "Nie wiem, dlaczego ta dwójka tam z tyłu tak <w>chichocze</w>."
                            }
                        },
                        {
                            "text": "De kinderen <w>giebelden</w> zachtjes toen ze het grapje hoorden.",
                            "target_lang_translations": {
                                "pl": "Dzieci cicho <w>zachichotały</w>, kiedy usłyszały żart."
                            }
                        }
                    ],
                    "synonyms": [
                        "gniffelen",
                        "giechelen"
                    ],
                    "target_lang_definitions": {
                        "pl": "Śmiać się po cichu, cichaczem lub nieco tajemniczo"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "chichotać",
                                "target_lang_sense_clarification": "śmiać się cicho i stłumionym głosem"
                            },
                            {
                                "target_lang_word": "podśmiewać się",
                                "target_lang_sense_clarification": "śmiać się po cichu lub ukradkiem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93803724-dddd-3094-8474-2875be3e5c94",
                    "sense_definition": "Op een verlegen of melige manier lachen, vaak geassocieerd met jongeren",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lachen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De meisjes zaten in de hoek te <w>giebelen</w> over hun geheimen.",
                            "target_lang_translations": {
                                "pl": "Dziewczęta siedziały w kącie i <w>chichotały</w> o swoich sekretach."
                            }
                        },
                        {
                            "text": "Het groepje kinderen <w>giebelde</w> en wisselde onderling blikken uit.",
                            "target_lang_translations": {
                                "pl": "Grupka dzieci <w>chichotała</w> i wymieniała między sobą spojrzenia."
                            }
                        }
                    ],
                    "synonyms": [
                        "gniffelen",
                        "giechelen"
                    ],
                    "target_lang_definitions": {
                        "pl": "Śmiać się piskliwie, nerwowo lub głupkowato, często przypisywane młodzieży"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "chichotać",
                                "target_lang_sense_clarification": "śmiać się nerwowo, wstydliwie lub bez powodu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}