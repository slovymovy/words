                                    {
                                        "sense_id": "858b9ede-3e14-3206-9de4-9a23d9ab2e96",
                                        "entry_id": "23a29072-b571-3db5-b114-b9f2ef4ecdaa",
                                        "glosses": [
                                            "Action d’un cheval, d’un mulet, etc., qui rue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89fbe045-4cb8-44e5-ab93-94b7446e4cea",
                                                "sense_id": "858b9ede-3e14-3206-9de4-9a23d9ab2e96",
                                                "text": "Alors les chevaux, excités par les coups de fouets des chasseurs, se précipitèrent dans toutes les directions en hennissant et en lançant des ruades."
                                            },
                                            {
                                                "example_id": "14bc31c6-f088-4bc9-abbc-f632978619b9",
                                                "sense_id": "858b9ede-3e14-3206-9de4-9a23d9ab2e96",
                                                "text": "Pour l’essai des chevaux appareillés, les ruses des maquignons ne sont pas moins variées ; ainsi le plus paresseux est mis sous verge ; […] ; le croupionnement peut être évité, la ruade amoindrie par les courroies dites rueuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5013e496-2891-3600-aff4-8cd8fb93bcc4",
                                        "entry_id": "23a29072-b571-3db5-b114-b9f2ef4ecdaa",
                                        "glosses": [
                                            "Saut brusque, secousse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05697947-d2ac-472f-bf56-829351eb87cf",
                                                "sense_id": "5013e496-2891-3600-aff4-8cd8fb93bcc4",
                                                "text": "Enfin, de ruade en ruade, (on ne peut appeler autrement les petits sauts que nous faisons des quatre roues [du tramway]) nous finissons par avancer vers la Canebière qu'on voit là-bas devant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7568722e-bd94-33f9-8c52-9e3f405f9854",
                                        "entry_id": "23a29072-b571-3db5-b114-b9f2ef4ecdaa",
                                        "glosses": [
                                            "Coup violent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63c138bd-9e0d-4559-a62c-8f4fe97dd6a1",
                                                "sense_id": "7568722e-bd94-33f9-8c52-9e3f405f9854",
                                                "text": "Le président du Conseil […] fit tête à l'extrême gauche tout en détachant des ruades à droite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
