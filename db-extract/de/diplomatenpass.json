                "senses": [
                    {
                        "sense_id": "2a1c5b37-e841-360e-b623-777bb25e4aff",
                        "entry_id": "23ff5f17-6e32-3e09-9e41-0d27deb4fe23",
                        "glosses": [
                            "Pass, der nur an Diplomaten und hochrangige Amtsträger ausgegeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6db5a813-a856-4be8-a346-4303cde98b3b",
                                "sense_id": "2a1c5b37-e841-360e-b623-777bb25e4aff",
                                "text": "„Der Sprecher des Außenministeriums, Peter Launsky-Tieffenthal, bestätigt im Gespräch mit derStandard.at, dass unter anderem für alle aktuellen und ehemaligen Mitglieder der Bundesregierung die Möglichkeit besteht, einen Diplomatenpass zu bekommen.“"
                            },
                            {
                                "example_id": "feadd76f-0e76-47cd-af6d-496d6807bdf0",
                                "sense_id": "2a1c5b37-e841-360e-b623-777bb25e4aff",
                                "text": "„Die Beamten auf beiden Seiten identifizierten den soignierten jungen Herrn an Hand seines Diplomatenpasses, der sich wie eine Ziehharmonika öffnen ließ, als William S. Murphy, offiziellen Kurier der amerikanischen Botschaft in Paris.“"
                            },
                            {
                                "example_id": "a69e8870-f4e8-416f-bd38-f7ec261e8cae",
                                "sense_id": "2a1c5b37-e841-360e-b623-777bb25e4aff",
                                "text": "„Normalerweise wurde er einfach durchgewinkt, wenn er an der Passkontrolle seinen Diplomatenpass vorzeigte, doch diesmal war es anders.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
