                                "target_senses": [
                                    {
                                        "sense_id": "e48cb810-a8ff-3750-85eb-9687b98f3903",
                                        "entry_id": "dc93d181-3c9c-32d9-8158-3fc54d7f806d",
                                        "glosses": [
                                            "распространённое мужское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d80843e-d37b-47ae-837d-7a051decb0ca",
                                                "sense_id": "e48cb810-a8ff-3750-85eb-9687b98f3903",
                                                "text": "Место это он получил чрез мужа сестры Анны, Алексея Александровича Каренина, занимавшего одно из важнейших мест в министерстве, к которому принадлежало присутствие"
                                            },
                                            {
                                                "example_id": "3e4cb11a-1c9a-40cb-8cb3-899e48a1ca4e",
                                                "sense_id": "e48cb810-a8ff-3750-85eb-9687b98f3903",
                                                "text": "Легко вообразить, какое впечатление Алексей должен был произвести в кругу наших барышень."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
