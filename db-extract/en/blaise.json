                                            {
                                                "example_id": "ca1668c4-d569-47a8-9932-319a1613e737",
                                                "sense_id": "07beff83-821a-3d09-b602-a0a26ba29ab3",
                                                "text": "Mój kolega ze szkolnej ławy ma na imię Błażej."
                                            },
                                            {
                                                "example_id": "cf2c81f9-ecda-4466-9b63-42dafa37cd9b",
                                                "sense_id": "07beff83-821a-3d09-b602-a0a26ba29ab3",
                                                "text": "Błażej Lipowski, pisarz wojskowy, uchodził za autora pierwszego w języku polskim regulaminu piechoty."
                                            },
                                            {
                                                "example_id": "4f60cead-904a-4a1d-aba0-6f118fea969c",
                                                "sense_id": "07beff83-821a-3d09-b602-a0a26ba29ab3",
                                                "text": "W Kościele katolickim na 3 lutego przypada wspomnienie św. Błażeja z Sebasty, patrona mówców, śpiewaków, gręplarzy i kamieniarzy oraz chroniącego od chorób gardła."
                                            },
                                            {
                                                "example_id": "8e1bc1b0-921a-4cd2-a403-953226249c74",
                                                "sense_id": "07beff83-821a-3d09-b602-a0a26ba29ab3",
                                                "text": "Błażejowie dzień swego patrona, czyli imieniny, obchodzą 3 lutego, a także 29 listopada."
                                            }
                                        ],
