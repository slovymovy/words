                        "cross_references": [
                            {
                                "target_word": "Schale",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84c5b5c4-f3c9-3bec-b963-924204762723",
                                        "entry_id": "7986468d-5e3e-3d92-bad2-187e971e7a9f",
                                        "glosses": [
                                            "eine feste Schutzhülle, zum Beispiel bei Früchten, Samen, Vogeleiern, Lebensmitteln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97ce0712-d7e2-41c5-afc7-b71b0e168a77",
                                                "sense_id": "84c5b5c4-f3c9-3bec-b963-924204762723",
                                                "text": "Für Pellkartoffeln kocht man die Kartoffeln mit ihren Schalen."
                                            },
                                            {
                                                "example_id": "910c9262-e5fc-460b-be6b-b461e761bb3e",
                                                "sense_id": "84c5b5c4-f3c9-3bec-b963-924204762723",
                                                "text": "„Die grünen Schalen der Kastanien rascheln unter meinen Füßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b1a398d9-4ffa-3ea6-ac03-8cedb8df9f4d",
                                        "entry_id": "7986468d-5e3e-3d92-bad2-187e971e7a9f",
                                        "glosses": [
                                            "eine Panzerhülle bei bestimmten Tieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bdbc1b0-e8c8-4b45-b448-ece8fdd46787",
                                                "sense_id": "b1a398d9-4ffa-3ea6-ac03-8cedb8df9f4d",
                                                "text": "Wenn eine Muschel beim Draufklopfen ihre Schale schließt, lebt sie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c97f37b6-e0ff-3907-929a-2d81880c2635",
                                        "entry_id": "7986468d-5e3e-3d92-bad2-187e971e7a9f",
                                        "glosses": [
                                            "ein Gefäß für verschiedene Zweckbestimmungen in der Form einer (abgeflachten) halbierten Hohlkugel oder anderer Rotationskörper ursprünglich von dieser hergeleitet und an die menschliche Schädelform angelehnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f568d07-b5e7-4525-9d82-7fede8600a85",
                                                "sense_id": "c97f37b6-e0ff-3907-929a-2d81880c2635",
                                                "text": "Die Schale im Glasschrank ist aus feinstem Porzellan."
                                            },
                                            {
                                                "example_id": "1b5f634b-5c11-441c-9223-44ba18b84d8b",
                                                "sense_id": "c97f37b6-e0ff-3907-929a-2d81880c2635",
                                                "text": "„Er stellt die Schale mit den Süßigkeiten auf den Wohnzimmertisch aus weißem Marmor und lässt sich auf das Ledersofa fallen.“"
                                            },
                                            {
                                                "example_id": "187ecad3-bde8-4555-a898-2d760e0d2b58",
                                                "sense_id": "c97f37b6-e0ff-3907-929a-2d81880c2635",
                                                "text": "„Einer Schale entnahm er eingemachte Kirschen, legte sie in eine kleine Kupferpfanne und erhitzte sie auf der Spiritusflamme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "22362196-f7e6-34e1-8440-504be660b3d8",
                                        "entry_id": "7986468d-5e3e-3d92-bad2-187e971e7a9f",
                                        "glosses": [
                                            "die Klaue(n) des Schalenwildes"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a53eef82-3459-4684-a26f-089b28c185a7",
                                                "sense_id": "22362196-f7e6-34e1-8440-504be660b3d8",
                                                "text": "Das vom Hirsch mit der Schale abgeschnittene Gras nennt man Abtritt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "f07b031a-b81f-36bd-8254-ab002e54b240",
                                        "entry_id": "7986468d-5e3e-3d92-bad2-187e971e7a9f",
                                        "glosses": [
                                            "ein gekrümmter Flächenträger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "720ae355-5adf-4b48-af67-d7e6e7e34091",
                                                "sense_id": "f07b031a-b81f-36bd-8254-ab002e54b240",
                                                "text": "Das nichtbelüftete Warmdach hat gegenüber dem Kaltdach den Vorzug, aus nur einer Schale zu bestehen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "fcb2c8e1-140b-32de-9499-1e2154b64724",
                                        "entry_id": "7986468d-5e3e-3d92-bad2-187e971e7a9f",
                                        "glosses": [
                                            "eine schützende, äußere Wandung bei technischen Konstruktionen"
                                        ],
                                        "tags": [
                                            "Mechanik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b727742-a26d-403b-a9e1-9b11157f58cf",
                                                "sense_id": "fcb2c8e1-140b-32de-9499-1e2154b64724",
                                                "text": "Das Handy hat eine obere und eine untere Schale, die zumeist aus Kunststoff sind und die zusammen das Gehäuse bilden."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "fb74c742-8988-3449-a782-fde3e1cbef46",
                                        "entry_id": "7986468d-5e3e-3d92-bad2-187e971e7a9f",
                                        "glosses": [
                                            "ein unten ausgehöhlter Schliff bei Schmucksteinen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "aa7d00e0-44e2-3da5-b002-fe1b9a06cb3b",
                                        "entry_id": "7986468d-5e3e-3d92-bad2-187e971e7a9f",
                                        "glosses": [
                                            "eine Gelenkerkrankung (Entzündung) insbesondere bei Pferden"
                                        ],
                                        "tags": [
                                            "Tiermedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3334857-90d1-4d1c-8515-d984d4c2db88",
                                                "sense_id": "aa7d00e0-44e2-3da5-b002-fe1b9a06cb3b",
                                                "text": "Wenn eine Knochenneubildung (Exostosis) am Fessel-, Kron- und Hufbein auftritt, spricht man von einer Schale (Ringbein)."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "6d058caa-213e-32ab-abe9-bebf387ee653",
                                        "entry_id": "7986468d-5e3e-3d92-bad2-187e971e7a9f",
                                        "glosses": [
                                            "bei bestimmten Atommodellen die Schichten der Elektronenhülle von Atomen, Valenzschale"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61e37684-629a-4682-bbfe-051ce0f9397d",
                                                "sense_id": "6d058caa-213e-32ab-abe9-bebf387ee653",
                                                "text": "Die K-Schale des Heliumatoms ist vollständig besetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "ef33bab2-3664-36e4-acec-85478ce2008d",
                                        "entry_id": "7986468d-5e3e-3d92-bad2-187e971e7a9f",
                                        "glosses": [
                                            "schöne Oberkleidung, feines Outfit; sich in Schale werfen"
                                        ],
                                        "tags": [
                                            "figurativ",
                                            "oft in der Wendung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5441fb7-f7f7-4adc-8f70-a18ec18549ed",
                                                "sense_id": "ef33bab2-3664-36e4-acec-85478ce2008d",
                                                "text": "Heute hat er sich wieder einmal in Schale geworfen."
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    }
                                ]
