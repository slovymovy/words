{
    "word_family": [
        "grain",
        "graininess",
        "engrain",
        "ingrain"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3fa49852-4b04-3657-9742-47c5fe094425",
                    "sense_definition": "Coarsely ground, gritty, or having a texture resembling small particles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef preferred using <w>grainy</w> mustard to add texture to the sauce.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар предпочитал использовать <w>зернистую</w> горчицу, чтобы придать соусу текстуру."
                            }
                        },
                        {
                            "text": "After the storm, there was a <w>grainy</w> texture of sand covering the entire patio.",
                            "target_lang_translations": {
                                "ru": "После шторма весь внутренний дворик покрывала <w>песчаная</w> текстура песка."
                            }
                        }
                    ],
                    "synonyms": [
                        "gritty",
                        "granular",
                        "coarse"
                    ],
                    "antonyms": [
                        "smooth",
                        "fine"
                    ],
                    "common_phrases": [
                        "grainy mustard",
                        "grainy texture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупного помола, песчаный или имеющий текстуру, напоминающую мелкие частицы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зернистый",
                                "target_lang_sense_clarification": "состоящий из мелких зерен или крупинок"
                            },
                            {
                                "target_lang_word": "крупитчатый",
                                "target_lang_sense_clarification": "имеющий текстуру мелких крупинок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23c89cc6-351a-3b36-8d83-9fa412d0e746",
                    "sense_definition": "Having a rough, pixelated, or poorly defined appearance, especially of a photograph or video.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security camera captured a <w>grainy</w> image of the suspect walking down the street.",
                            "target_lang_translations": {
                                "ru": "Камера видеонаблюдения зафиксировала <w>зернистое</w> изображение подозреваемого, идущего по улице."
                            }
                        },
                        {
                            "text": "We watched an old, <w>grainy</w> photo from the early twentieth century.",
                            "target_lang_translations": {
                                "ru": "Мы рассматривали старую, <w>зернистую</w> фотографию начала двадцатого века."
                            }
                        }
                    ],
                    "synonyms": [
                        "pixelated",
                        "blurry"
                    ],
                    "antonyms": [
                        "sharp",
                        "clear"
                    ],
                    "common_phrases": [
                        "grainy image",
                        "grainy photo",
                        "grainy footage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий грубый, пикселизированный или нечеткий вид, особенно о фотографии или видео."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зернистый",
                                "target_lang_sense_clarification": "о нечетком изображении или видео с видимым зерном"
                            },
                            {
                                "target_lang_word": "размытый",
                                "target_lang_sense_clarification": "нечеткий, с плохим разрешением"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}