                        "examples": [
                            {
                                "example_id": "b24c1f98-3350-4bf0-ba32-77edc9ac9fda",
                                "sense_id": "bcfd943c-2ccc-3602-8d0b-5d8d4bef1c7a",
                                "text": "„Als Hauptlieferanten von Erdöl und Erdölprodukten spielen Saudi-Arabien und die Vereinigten Arabischen Emirate seit längerem eine zentrale Rolle für das pakistanische Wirtschaftswachstum.“"
                            },
                            {
                                "example_id": "d7d44d2d-bf84-46a3-8c47-7a597ac9babf",
                                "sense_id": "bcfd943c-2ccc-3602-8d0b-5d8d4bef1c7a",
                                "text": "„Pakistan, Hauptlieferant von Waffen und Treibstoff an die Taliban, befand sich jetzt in einer schwierigen Lage, versprach aber, den UN-Sanktionen Folge zu leisten.“"
                            },
                            {
                                "example_id": "9f711ecb-7214-4dcc-96cf-e22b94e5acc9",
                                "sense_id": "bcfd943c-2ccc-3602-8d0b-5d8d4bef1c7a",
                                "text": "„In den Jahren im Knast hat Ronald den Kreis seiner Bekannten stetig erweitert, und einer davon soll sein Hauptlieferant werden: Jimmi, ein von den Niederländischen Antillen stammender Holländer.“"
                            }
                        ],
