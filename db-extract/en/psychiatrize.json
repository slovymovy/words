                        "glosses": [
                            "To make psychiatric; to bring into the realm of psychiatry."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fc2e65d0-2a72-45d3-b3d7-e6d2b3ca6ff1",
                                "sense_id": "c121ed4c-a19d-380c-b8ec-e0ae35226d5c",
                                "text": "On the other hand it is just as important not to psychiatrize youth as a whole, to avoid over-hasty interference that will run counter to the aim in view by 'freezing' or even preventing the progressive spontaneous process."
                            },
                            {
                                "example_id": "cc0d0991-f47f-4f55-9ad8-77a22e0ca7a6",
                                "sense_id": "c121ed4c-a19d-380c-b8ec-e0ae35226d5c",
                                "text": "The mediator may be tempted to: • Psychiatrize the parties, labelling them as mentally ill."
                            }
                        ]
                    }
