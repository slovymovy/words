                        "entry_id": "46d1e284-4115-3716-bc4a-b1847919936e",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "poleaxed"
                    },
                    {
                        "form_id": "0478f137-ba27-4587-b5fb-d166bd943b5a",
                        "entry_id": "46d1e284-4115-3716-bc4a-b1847919936e",
                        "tags": [
                            "past"
                        ],
                        "form": "poleaxed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c15384bc-c859-3a7d-a9cc-ec96fc4ff7e2",
                        "entry_id": "46d1e284-4115-3716-bc4a-b1847919936e",
                        "glosses": [
                            "To fell someone with, or as if with, a poleaxe."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "66940df2-683a-3ae5-9095-43cebc6c3614",
                        "entry_id": "46d1e284-4115-3716-bc4a-b1847919936e",
                        "glosses": [
                            "To astonish; to shock or surprise utterly."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e9251674-7fbc-41e2-b5dd-c8f1e4d91b4d",
                                "sense_id": "66940df2-683a-3ae5-9095-43cebc6c3614",
                                "text": "Lisa Griffin, who runs Brew Rock and an Irish pub in nearby Benidorm, was as poleaxed by the announcement as her customers were."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9f28d43-b315-32ba-b5a6-b1dd079033b5",
                        "entry_id": "46d1e284-4115-3716-bc4a-b1847919936e",
                        "glosses": [
                            "To stymie, thwart, cripple, paralyze."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4e2c8d53-415a-41d9-8415-1065291e6896",
                                "sense_id": "e9f28d43-b315-32ba-b5a6-b1dd079033b5",
                                "text": "After a lacklustre campaign that has failed to grapple with Germany’s looming problems, the world should expect post-election coalition talks to last for months, poleaxing European politics while they drag on."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b5aa205-5124-4dac-a443-a52b9180e9fd",
                        "source_entry_id": "46d1e284-4115-3716-bc4a-b1847919936e",
                        "source_sense_description": "to beat as if with a poleaxe",
                        "target_lang_word": "zusammenschlagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zusammenschlagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd6fd537-9198-36bc-b8e4-c3512d60fb6a",
                                        "entry_id": "014bc77c-7d47-3cc6-b285-3612524e8109",
                                        "glosses": [
                                            "heftig gegeneinanderschlagen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d94e1cb4-8f6d-49dc-850d-2ae7d0b6bcd8",
                                                "sense_id": "cd6fd537-9198-36bc-b8e4-c3512d60fb6a",
                                                "text": "„Diese Steine waren vor allem bearbeitet worden, um sie als Messer, Speer oder Pfeilspitzen zu gebrauchen – und nicht, um Feuer zu schlagen, denn das Zusammenschlagen von zwei Feuersteinen erzeugt zwar Funken, doch sind diese zu kalt und kurzlebig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2cea4cd4-a380-3388-86db-d477177f63b2",
                                        "entry_id": "014bc77c-7d47-3cc6-b285-3612524e8109",
                                        "glosses": [
                                            "durch körperliche Gewalt massiv verletzen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47a97a80-960c-48ba-aa01-6378df14c7f4",
                                                "sense_id": "2cea4cd4-a380-3388-86db-d477177f63b2",
                                                "text": "„Ein Unbekannter hat im Frankfurter Bahnhofsviertel zwei Männer zusammengeschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fd773778-5171-359b-a255-07b6426237b9",
                                        "entry_id": "014bc77c-7d47-3cc6-b285-3612524e8109",
                                        "glosses": [
                                            "durch körperliche Gewalt unbrauchbar machen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ab640b1-99c1-4824-aa2c-94adb9d77db8",
                                                "sense_id": "fd773778-5171-359b-a255-07b6426237b9",
                                                "text": "„Der alte Mann ist davon überzeugt, daß die Polizei in jedes Haus kann, wenn sie will, daß sie die Einrichtung zusammenschlagen darf und nicht einmal Rechenschaft ablegen muß!“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "148fe651-a6c1-3c34-9e98-8cfb479f7774",
                                        "entry_id": "014bc77c-7d47-3cc6-b285-3612524e8109",
                                        "glosses": [
                                            "über einer Person sich treffen"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af55765e-12ce-41df-acf2-6ad394220352",
                                                "sense_id": "148fe651-a6c1-3c34-9e98-8cfb479f7774",
                                                "text": "„Er war jetzt in dem Boot, doch davor war er im Ozean gewesen, bis zum Hals, und die Wellen waren über ihm zusammengeschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2936ec7b-a7d5-3406-afb4-d2673cef0467",
                                        "entry_id": "014bc77c-7d47-3cc6-b285-3612524e8109",
                                        "glosses": [
                                            "schließen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ccc8036-579a-4d2e-95b4-5df114b5fe1f",
                                                "sense_id": "2936ec7b-a7d5-3406-afb4-d2673cef0467",
                                                "text": "„Das darf sie nicht auch noch vermasseln, hat schon Kaltenbronn versetzt, der in seiner Sitzecke bestimmt schon die Zeitung zusammengeschlagen und sich verabschiedet hat, während Siana ihn vermutlich aufzuhalten versuchte und ihm ein anderes Mädchen empfahl: […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "7bb42aeb-51ba-36f5-9d8f-8761c3652a60",
                                        "entry_id": "014bc77c-7d47-3cc6-b285-3612524e8109",
                                        "glosses": [
                                            "aus Holz notdürftig konstruieren"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c47fa274-8e93-4b13-9f0d-5f99c531f52a",
                                                "sense_id": "7bb42aeb-51ba-36f5-9d8f-8761c3652a60",
                                                "text": "„Komm her, du sollst diese Kiste zusammenschlagen; hier ist ein neuer Hammer für dich, er kostet zehn Groschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe7fb22d-bcba-4a40-b85a-949d17d659a5",
                        "source_entry_id": "46d1e284-4115-3716-bc4a-b1847919936e",
                        "source_sense_description": "to astonish, to shock",
                        "target_lang_word": "schockieren",
