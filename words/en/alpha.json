                    "sense_definition": "A place name used for various towns and villages in the United States and Australia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They stopped in the small town of <w>Alpha</w> during their road trip.",
                            "target_lang_translations": {
                                "ru": "Они остановились в маленьком городке <w>Альфа</w> во время своего автопутешествия.",
                                "zh": "他们在公路旅行途中在<w>阿尔法</w>小镇停留。"
                            }
                        },
                        {
                            "text": "The village of <w>Alpha</w> is located in a rural area.",
                            "target_lang_translations": {
