                        "glosses": [
                            "Sorte de sécateur à manche long permettant de couper des branches de section plus importante."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "18d9d6cc-deb1-445b-8407-710668d0c676",
                                "sense_id": "2b6ec017-ebc6-38b4-8312-1910e61d7481",
                                "text": "L’ébrancheur est un instrument qui sert à couper les branches dont le diamètre est trop fort pour qu'on puisse se servir d’un sécateur ordinaire."
                            }
                        ]
