                                        "entry_id": "f1d2b1c1-c61e-3ee3-b6b5-a1652e0a6d6b",
                                        "glosses": [
                                            "aus einem schichtenförmig-mehrfarbigen Stein (beispielsweise Onyx) herausgearbeitetes Bild"
                                        ],
                                        "tags": [
                                            "Kunsthandwerk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "553d021d-0062-4ae2-968d-7082c1583184",
                                                "sense_id": "ce948dd9-1bed-3b20-a608-f5ffdc6d5b71",
                                                "text": "Die aus Achat geschnittene Camaieu ist einen Zentimeter hoch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e0842ef4-e7e5-3f73-94a5-1f93607c0751",
                                        "entry_id": "f1d2b1c1-c61e-3ee3-b6b5-a1652e0a6d6b",
                                        "glosses": [
                                            "Maltechnik in einer einzigen Farbe, bei der die Darstellung nur durch hell/dunkel-Kontraste dieser Farbe erfolgt"
                                        ],
                                        "tags": [
                                            "Malerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01600b38-da30-4e4f-b869-bf12bae91d08",
                                                "sense_id": "e0842ef4-e7e5-3f73-94a5-1f93607c0751",
                                                "text": "Die Ton-in-Ton-Technik faszinierte sie, und sie begann, selbst Erfahrungen mit der Camaieu zu sammeln, auch wenn das »en camaieu«-Malen eine wahre Herausforderung war."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
