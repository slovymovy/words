                "senses": [
                    {
                        "sense_id": "8999510c-b84e-322e-9916-523d8064dd9c",
                        "entry_id": "bff1bd27-0b6b-3eb8-af3a-c868e14f7c0d",
                        "glosses": [
                            "Qui est limité ou étroit."
                        ],
                        "tags": [
                            "figuratively",
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "3d76bcd1-f6fe-48ae-a328-13d7153c2ed7",
                                "sense_id": "8999510c-b84e-322e-9916-523d8064dd9c",
                                "text": "On cite Picea Omorica, largement répandu en Europe avant les glaciations et maintenant localisé aux Balkans en stations restreintes."
                            },
                            {
                                "example_id": "9514c87a-dcd7-4778-a9bc-3ff2a1d44a31",
                                "sense_id": "8999510c-b84e-322e-9916-523d8064dd9c",
                                "text": "Les rouges étaient aux cent coups. Ils s'étaient réunis en comité restreint dans la cuisine du cafetier. Autour de la toile cirée, le bureau de la Libre-Pensée cogitait ferme."
                            },
                            {
                                "example_id": "0aee958c-fc7e-4a53-9c25-d3a7e3e3e709",
                                "sense_id": "8999510c-b84e-322e-9916-523d8064dd9c",
                                "text": "Le théorème 3 restreint au cas d'une variable s’énonce aussi plus simplement.",
                                "translation": "Éric Delaygue, Propriétés arithmétiques des applications miroir, Institut Fourier, 2011, page 15"
                            }
                        ]
                    },
                    {
                        "sense_id": "2753b71e-5dad-32fa-8fbd-0e64dfa319c8",
                        "entry_id": "bff1bd27-0b6b-3eb8-af3a-c868e14f7c0d",
                        "glosses": [
                            "Sobre, sans ostentation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b2c34ab-2057-4b73-8bf8-269730b09c25",
                                "sense_id": "2753b71e-5dad-32fa-8fbd-0e64dfa319c8",
                                "text": "Son pardessus, son plastron, son chapeau cronstadt même, présentaient je ne sais quoi de décent, de restreint et de distingué…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3335f28a-016c-459b-a939-dc2ec378c246",
                        "source_entry_id": "bff1bd27-0b6b-3eb8-af3a-c868e14f7c0d",
                        "target_lang_word": "beschränkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beschränkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a942f16-3122-35d8-9a7e-e4db8ed6c894",
                                        "entry_id": "0c77d018-4cf0-3ada-9839-8a45b3424643",
                                        "glosses": [
                                            "abwertend: einfältig, engstirnig, geistig unbeweglich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96b72493-4d55-4e02-82be-643a654160a2",
                                                "sense_id": "4a942f16-3122-35d8-9a7e-e4db8ed6c894",
                                                "text": "Er ist wirklich so beschränkt, dass eine Sonderschule für ihn die bestmögliche Förderung ermöglichen würde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2a0ce3b8-ac26-3bdc-a61e-5dce99c32610",
                                        "entry_id": "0c77d018-4cf0-3ada-9839-8a45b3424643",
                                        "glosses": [
                                            "kurzsichtig, nicht sehr weitblickend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7ff54c6-eed1-435f-b9aa-54e0355629b2",
                                                "sense_id": "2a0ce3b8-ac26-3bdc-a61e-5dce99c32610",
                                                "text": "„Der Mord an dem Polizisten zeige, „dass radikale Extremisten nicht zwischen Muslimen und Nichtmuslimen unterscheiden. Sie halten nur ihre beschränkte, menschenfeindliche Ideologie und ihr pervertiertes Religionsverständnis für richtig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "12342aa9-79bc-3b04-a81a-ed2980736918",
                                        "entry_id": "0c77d018-4cf0-3ada-9839-8a45b3424643",
                                        "glosses": [
                                            "begrenzt, räumlich oder zeitlich eingeschränkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "163301d5-39b1-449d-968a-c755dc140c4b",
                                                "sense_id": "12342aa9-79bc-3b04-a81a-ed2980736918",
                                                "text": "Nach Ebola verfügten einige Staaten beschränkte Reisemöglichkeiten nach Westafrika."
                                            },
                                            {
                                                "example_id": "f4a19daa-e5bf-4605-b711-5bfa7d3df02b",
                                                "sense_id": "12342aa9-79bc-3b04-a81a-ed2980736918",
                                                "text": "Wir haben nur beschränkt Platz in unserer kleinen Wohnung."
                                            },
                                            {
                                                "example_id": "ee37e304-f19d-4df4-bb73-871982f602a4",
                                                "sense_id": "12342aa9-79bc-3b04-a81a-ed2980736918",
                                                "text": "„Der Bahnhof ist vorläufig nur beschränkt befahrbar.“"
                                            },
                                            {
                                                "example_id": "2c31a9a6-8429-44e9-85bb-d7c41ccf8f51",
                                                "sense_id": "12342aa9-79bc-3b04-a81a-ed2980736918",
                                                "text": "„Ausgerechnet in der Industrienation Deutschland sind qualifizierte Ausländer nur beschränkt willkommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
