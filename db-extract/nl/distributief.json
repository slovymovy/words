                "translations": [
                    {
                        "translation_id": "8bdf2a48-6de7-4447-be4b-41e7b085b5d3",
                        "source_entry_id": "80d04abd-3776-303a-9c56-df19f3fad42d",
                        "source_sense_id": "93a9875b-5062-387d-aace-f56271f7aff4",
                        "target_lang_word": "distributiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distributiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12d0fbe1-5a1f-3774-92a1-32548626694a",
                                        "entry_id": "fde08d6c-bdfc-3ce0-b12c-64756ce0637d",
                                        "glosses": [
                                            "auf mehrere, meistens viele Ziele verteilend, etwas verbreitend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e563750-ddd9-4b2b-ac87-155cd825f1f5",
                                                "sense_id": "12d0fbe1-5a1f-3774-92a1-32548626694a",
                                                "text": "„Teilweise gilt auch der Einzelhandel als distributive Dienstleistung, häufiger jedoch als konsumentenorientierte.“"
                                            },
                                            {
                                                "example_id": "d6c6c54c-acdf-4c5a-9c8a-e30b30f90670",
                                                "sense_id": "12d0fbe1-5a1f-3774-92a1-32548626694a",
                                                "text": "„Generell gilt, dass prozedurale und distributive Fairness positiv korreliert sind.“"
                                            },
                                            {
                                                "example_id": "c7106a23-fc57-4955-8de3-63c4e299c0e2",
                                                "sense_id": "12d0fbe1-5a1f-3774-92a1-32548626694a",
                                                "text": "„Ein klassisches Beispiel distributiver Politik auf staatlicher Ebene ist die Verteilung staatlicher Einnahmen aus dem Ölgeschäft in so genannten Rentierstaaten wie Saudi-Arabien oder Kuwait.“"
                                            },
                                            {
                                                "example_id": "de8a8b93-97e1-461f-96bc-df7b9261f0ea",
                                                "sense_id": "12d0fbe1-5a1f-3774-92a1-32548626694a",
                                                "text": "„Das distributive Paradigma verlangt, jedem das Seine zu geben.“"
                                            },
                                            {
                                                "example_id": "04b19201-f4b9-4f18-832b-baea7d26fa1d",
                                                "sense_id": "12d0fbe1-5a1f-3774-92a1-32548626694a",
                                                "text": "„Generell steht für die Anwender distributiver Strategien die erwartbare Gewinnverteilung einer Zusammenarbeit im Mittelpunkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "58913db2-46db-3454-90e1-16c9881c9031",
                                        "entry_id": "fde08d6c-bdfc-3ce0-b12c-64756ce0637d",
                                        "glosses": [
                                            "durch wiederholte Aktion auf mehrere Ziele verteilend"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ecaf5cc-0d22-44a3-954f-89c9d086e072",
                                                "sense_id": "58913db2-46db-3454-90e1-16c9881c9031",
                                                "text": "„[…] die Sätze Die meisten (viele/alle) Kinder haben ein Floß gebaut haben sowohl eine distributive Lesart (die Kinder haben je ein Floß gebaut) wie eine nicht-distributive Lesart (die Kinder haben zusammen ein Floß gebaut).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "89aa4954-0975-3798-bf62-eaef8586de4d",
                                        "entry_id": "fde08d6c-bdfc-3ce0-b12c-64756ce0637d",
                                        "glosses": [
                                            "nach den Regeln des Distributivgesetzes Gruppen von Zahlen miteinander verrechnend"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2505dfb3-2be5-46d0-97a6-f788cffbde16",
                                                "sense_id": "89aa4954-0975-3798-bf62-eaef8586de4d",
                                                "text": "„Dabei haben sie auch die beispielhafte distributive Zerlegung (4·2 (blaue Punktestreifen) + 3·2 (rote Punktestreifen) = 7·2) zu den zufällig hochgeworfenen Punktestreifen […] hergeleitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
