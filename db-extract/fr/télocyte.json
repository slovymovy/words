                ],
                "senses": [
                    {
                        "sense_id": "fe3061df-a974-3f91-bd8d-052210023649",
                        "entry_id": "90f7e276-0866-3be0-a744-4b7cab3a4143",
                        "glosses": [
                            "Type de cellule interstitielle caractérisée par la présence de prolongements cytoplasmiques extrêmement fins et longs appelés télopodes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d74ae4b3-7c9b-417e-a344-f7b01310e7d7",
                                "sense_id": "fe3061df-a974-3f91-bd8d-052210023649",
                                "text": "Les télocytes sont des cellules mésenchymateuses uniques avec de longs processus cytoplasmiques, atteignant une distance de dizaines à des centaines de microns du corps cellulaire."
                            },
                            {
                                "example_id": "45ae0b15-eab5-41c3-a084-3a1d16cb0177",
                                "sense_id": "fe3061df-a974-3f91-bd8d-052210023649",
                                "text": "En 2010, L.M. Popescu et M.S. Faussone-Pellegrini décrivent réellement ces cellules et inventent pour les nommer le terme « Télocytes » (TCs), provenant de « telos » en Grec signifiant le but, l’extrémité ou la fin de quelque chose."
                            },
                            {
                                "example_id": "4ace8864-c3f6-41e7-a106-450718ed4337",
                                "sense_id": "fe3061df-a974-3f91-bd8d-052210023649",
                                "text": "Nous nous sommes donc intéressés à l’AQP1 dans l’HI, ce qui a permis également d’identifier des cellules interstitielles, les télocytes (TC)."
                            },
                            {
                                "example_id": "335f1eb5-1221-4be6-96b9-1f8454ad8502",
                                "sense_id": "fe3061df-a974-3f91-bd8d-052210023649",
                                "text": "En 2013, une cellule appelée télocyte (TC), qui a de longs prolongements permettant une signalisation entre les cellules, a été décrite dans le stroma péritumoral d’un sous-groupe de carcinome..."
                            }
                        ]
                    }
                ],
