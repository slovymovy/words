                ],
                "senses": [
                    {
                        "sense_id": "2e1dcc4f-517e-39f8-97a4-5180a30edb69",
                        "entry_id": "aad4dc10-f371-3ed4-8e14-29d71de74fec",
                        "glosses": [
                            "beschriftete Kunststoffplatte zu Informationszwecken; Hinweis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4b921d8-c245-4b01-b0c4-39a909321429",
                                "sense_id": "2e1dcc4f-517e-39f8-97a4-5180a30edb69",
                                "text": "„Ob sonniger Standort oder eisige Kälte, die Kunststoffschilder zeichnen sich durch eine hohe thermische Stabilität, gute Chemikalienresistenz und ausgezeichnete Beständigkeit gegen Witterungseinflüsse, Vergilbung und Alterung aus.“"
                            },
                            {
                                "example_id": "9bdfcf0a-c88d-4521-b826-3669ced12564",
                                "sense_id": "2e1dcc4f-517e-39f8-97a4-5180a30edb69",
                                "text": "„Alle Kunststoffschilder werden speziell von uns angefertigt und von Hand weiterverarbeitet.“"
                            },
                            {
                                "example_id": "26b12c87-fcc3-4226-8ee9-cee23306766c",
                                "sense_id": "2e1dcc4f-517e-39f8-97a4-5180a30edb69",
                                "text": "„Mit den diversen Druckverfahren bieten wir alle Möglichkeiten für die punktgenaue Bedruckung von Kunststoffschildern.“"
                            },
                            {
                                "example_id": "d8f6c1ab-34a5-4203-8878-96df1af5d357",
                                "sense_id": "2e1dcc4f-517e-39f8-97a4-5180a30edb69",
                                "text": "„Kunststoffschilder werden aus 2 mm starkem Kunststoff-Material für den robusten Einsatz im Lager hergestellt. Der Aufdruck erfolgt durch eine Folie und ist witterungsbeständig und wetterfest. Dadurch sind die Kunststoffschilder für den Innen-, als auch Außenbereich geeignet.“"
                            },
                            {
                                "example_id": "92791d88-2097-4966-8ede-7aea93f558e2",
                                "sense_id": "2e1dcc4f-517e-39f8-97a4-5180a30edb69",
                                "text": "„Kunststoffschilder sind in vielfältigen Ausführungen und Farben herstellbar und zeichnen sich durch hohe Bruchfestigkeit und Elastizität aus. Ob im Innenbereich oder außen, klein oder groß: Kunststoffschilder sind nahezu unverwüstlich. Selbstklebende oder mit kleinen Bohrungen versehene Kunststoffschilder lassen sich überall flexibel anbringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
