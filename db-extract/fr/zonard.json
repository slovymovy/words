                ],
                "senses": [
                    {
                        "sense_id": "08fc8ffa-bbe0-3f38-990f-4554d0be1d72",
                        "entry_id": "ec24ee58-96fc-38d1-87ec-edaaefe38a1f",
                        "glosses": [
                            "Personne qui divague, personne errante, clochard et dans un sens plus étroit, jeune issu des banlieues défavorisées et vivant en marge de la société."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "85ead590-c31b-4272-9a2e-251ec52ff4b3",
                                "sense_id": "08fc8ffa-bbe0-3f38-990f-4554d0be1d72",
                                "text": "Toufik avait les dents du bonheur. Dix ans de la tête aux pieds. Zonard importé, deuxième génération. Vachard avec les cons. Rieur avec ses potes. Poli avec sa mère."
                            },
                            {
                                "example_id": "789324c6-6695-445e-a23f-006292d5f0f4",
                                "sense_id": "08fc8ffa-bbe0-3f38-990f-4554d0be1d72",
                                "text": "Moi mon destin, c’était ouvrier, costard-cravate ou zonard."
                            },
                            {
                                "example_id": "df364a87-1fde-45fa-93e7-e1c55726d7b6",
                                "sense_id": "08fc8ffa-bbe0-3f38-990f-4554d0be1d72",
                                "text": "Chaque quartier avait sa communauté, il y avait les Italiens, les Arméniens, les Espagnols, les Portugais… mais tous étaient surnommés les zonards ou les zoniers."
                            }
                        ]
                    }
                ],
