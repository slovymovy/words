                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fafbb4ec-d73a-4b93-abec-cd3bd46dcc45",
                                "sense_id": "8b5e87e5-a733-3244-9dd5-1566e6b11be7",
                                "text": "Malraux vertelt hoe hij, na zijn ontsnapping uit een krijgsgevangenkamp, zijn medevluchter, de latere aalmoezenier van de verzetsgroeperingen uit Vercors, terugvindt in een verlaten dorp."
                            }
