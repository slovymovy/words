                ],
                "senses": [
                    {
                        "sense_id": "9a24c3a7-e132-3677-92f7-0af09d0795f2",
                        "entry_id": "08828e9d-83d6-335d-80b7-27606a846302",
                        "glosses": [
                            "Refaire une beauté à, améliorer l’apparence de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cc9a9c1-7289-4944-a558-aebbf8b8751f",
                                "sense_id": "9a24c3a7-e132-3677-92f7-0af09d0795f2",
                                "text": "En se recentrant sur elle-même, Montreuil avait renoué avec ses origines ouvrières et gitanes et le langage s’en était trouvé re-lifté à l’ancienne."
                            },
                            {
                                "example_id": "1506ca03-048f-4228-9387-affe900d50d5",
                                "sense_id": "9a24c3a7-e132-3677-92f7-0af09d0795f2",
                                "text": "Le logo historique, créé en 2004 lors de la naissance du club et « re-lifté » au cours de son passage en pro A, cède sa place après 14 saisons d’exercices et de beaux états de service."
                            },
                            {
                                "example_id": "00d1b12d-9988-4fa9-b493-4a012b79e0d2",
                                "sense_id": "9a24c3a7-e132-3677-92f7-0af09d0795f2",
                                "text": "DeLaval lance une version re-liftée de sa brosse."
                            },
                            {
                                "example_id": "465058a3-fee1-4a7d-95d9-545c13abc0e9",
                                "sense_id": "9a24c3a7-e132-3677-92f7-0af09d0795f2",
                                "text": "Après des mois d’attente, la bouteille Evian re-liftée par le grand Virgil Abloh est disponible en quantité très limitée."
                            },
                            {
                                "example_id": "91aee132-8112-4d4e-8d97-7f89a372862b",
                                "sense_id": "9a24c3a7-e132-3677-92f7-0af09d0795f2",
                                "text": "Re-liftées, agrandies, ré-ensablées… Les plages de la Croisette font leur défilé !"
                            }
                        ]
                    }
