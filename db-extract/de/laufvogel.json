                        "entry_id": "c219a17c-1f24-3b22-a4ad-49bf15abc01c",
                        "glosses": [
                            "ein flugunfähiger Vogel mit kräftigen Laufbeinen und kurzen Flügeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd9f86f6-b7b0-4e30-898f-e09c553f2b01",
                                "sense_id": "7e263d99-7358-32c2-87d1-cb8afa11e7ab",
                                "text": "„Der bis 1,80 m hohe Emu ist ein flugunfähiger Laufvogel, der bis 50 km/h schnell laufen kann und auch gut schwimmt.“"
                            },
                            {
                                "example_id": "4e8165a3-b15a-4a59-a728-34a44d77fe00",
                                "sense_id": "7e263d99-7358-32c2-87d1-cb8afa11e7ab",
                                "text": "„Vögel, die fliegen, sind anders gebaut als Laufvögel.“"
                            }
                        ],
