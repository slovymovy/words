                        "entry_id": "2efe9cb2-c2c7-3880-b827-fc155420424a",
                        "glosses": [
                            "Taux butyreux, quantité de matière grasse contenue dans un kilogramme de lait lors de la traite."
                        ],
                        "tags": [
                            "Caséologie",
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "4f4b7bde-a90b-480e-b2af-2a13542910b3",
                                "sense_id": "3f563fba-bbf9-3413-9919-51040e9573a6",
                                "text": "Les autres types de rations courantes — ensilage de maïs, ration sèches, ou ration foin — sont aussi susceptibles de faire chuter le TB."
                            },
                            {
                                "example_id": "7940a4e6-a10e-4921-9019-d181a5ed0b5b",
                                "sense_id": "3f563fba-bbf9-3413-9919-51040e9573a6",
                                "text": "Vous n’avez sûrement jamais entendu parler du TB du lait. Pourtant, le « taux butyreux », comme on l’appelle, a fort à voir avec la pénurie de beurre sur laquelle les médias tartinent depuis des semaines."
                            }
                        ]
                    }
