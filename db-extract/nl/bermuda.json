                        "examples": [
                            {
                                "example_id": "90501ad4-924e-4f5a-8948-288dd02db306",
                                "sense_id": "29265921-bc55-30ba-bfa3-1175be1ed78e",
                                "text": "- Het was zaterdag nog lang geen ‘IJsland’ voor de deur van 10 Downing Street, de ambtswoning van David Cameron. Demonstranten gehuld in Bermuda-shorts en Panama-hoeden eisten, net zoals in IJsland, het vertrek van de Britse premier vanwege diens rol bij belastingontwijking. Het duurde een half uur, waarna ze vertrokken – deels naar een andere locatie, deels naar huis."
                            },
                            {
                                "example_id": "4b228a2a-36a4-48c4-af6a-45ba8ebe6608",
                                "sense_id": "29265921-bc55-30ba-bfa3-1175be1ed78e",
                                "text": "- Opeens een vrouw in een oranje bermuda, ze hield nadrukkelijk halt en wilde een boek. Ik moest erin schrijven: ‘Voor oma Dinie, omdat je zo’n lieve poeperd bent.’"
                            }
                        ]
