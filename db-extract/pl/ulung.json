                        "sense_id": "aba36cd3-dd02-3833-a777-5fe9893dd28e",
                        "entry_id": "01ad163a-b79c-3d6f-96f1-07c4c1999f47",
                        "glosses": [
                            "półfermentowana herbata z Chin oraz północnej i północno-wschodniej części Tajwanu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86b5dfe5-36d4-4351-8b21-068b738b2aa9",
                                "sense_id": "aba36cd3-dd02-3833-a777-5fe9893dd28e",
                                "text": "Herbatę miał tylko dlatego, że co kwartał otrzymywał w swojej firmie przydział pracowniczy składający się z czterech paczek ulunga, czterech kostek mydła i dwóch ręczników"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
