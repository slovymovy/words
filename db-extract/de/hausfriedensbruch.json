                "senses": [
                    {
                        "sense_id": "7e420d76-d060-3627-8abc-b76ef69b629b",
                        "entry_id": "bfbeefd7-1b9c-3c0d-9479-1e20eb660156",
                        "glosses": [
                            "unrechtmäßiges Betreten von fremden Grundstücken, Eindringen in fremdes Geschäfts-/Wohneigentum, Verletzung des Hausrechts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4af71c74-b3b7-408e-92e3-500c9ddcdf5f",
                                "sense_id": "7e420d76-d060-3627-8abc-b76ef69b629b",
                                "text": "„Künftig soll die Speicherung des genetischen Fingerabdrucks in der DNA-Datei der Polizei auch bei Wiederholungstätern nicht erheblicher Straftaten, etwa Sachbeschädigung oder Hausfriedensbruch, möglich sein.“"
                            },
                            {
                                "example_id": "e8ee7699-3aab-4eae-aecd-7eb2929342be",
                                "sense_id": "7e420d76-d060-3627-8abc-b76ef69b629b",
                                "text": "„Somit darf Ihr Vermieter auch nicht ohne Ihr Einverständnis einfach so Ihre Wohnung betreten, denn dann würde dieser den Tatbestand des Hausfriedensbruchs erfüllen.“"
                            },
                            {
                                "example_id": "ac90067f-dfed-4ad2-bd23-f3c4b63536af",
                                "sense_id": "7e420d76-d060-3627-8abc-b76ef69b629b",
                                "text": "„Somit ist § 78 Absatz 3 Nummer 5 StGB einschlägig und die Verjährungsfrist für die Strafverfolgung beim Hausfriedensbruch liegt bei drei Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
