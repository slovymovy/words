                "senses": [
                    {
                        "sense_id": "c63ff0a0-2ddb-3995-b723-4baef31c9252",
                        "entry_id": "269bd5c4-8af8-373c-aed5-36c830b9becd",
                        "glosses": [
                            "Faire perdre son caractère byzantin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1762a7b6-1f64-4f3d-bb04-6f2a280a986a",
                                "sense_id": "c63ff0a0-2ddb-3995-b723-4baef31c9252",
                                "text": "C’était plutôt une entreprise de colonisation systématique conçue sur une très vaste échelle et qui avait pour but de “ débyzantiniser ” autant que possible le territoire occupé."
                            },
                            {
                                "example_id": "5591b280-9ef9-4f1c-841d-10c2d0f63a41",
                                "sense_id": "c63ff0a0-2ddb-3995-b723-4baef31c9252",
                                "text": "Quant aux Protestants, ils rêvent de « descholastiquer, débyzantiniser l’Église pour la rendre à la nature, au cœur »."
                            }
                        ]
                    }
