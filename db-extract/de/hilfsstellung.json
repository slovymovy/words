                "senses": [
                    {
                        "sense_id": "7ffc25f6-bd19-36c7-ba58-78bb17a08013",
                        "entry_id": "566edf57-54a1-3700-8ef2-0788fd585f22",
                        "glosses": [
                            "aktive Hilfe, Unterstützung von jemandem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42710616-786d-4481-ad7d-f3a5de7519a4",
                                "sense_id": "7ffc25f6-bd19-36c7-ba58-78bb17a08013",
                                "text": "„In Tel Aviv verspricht man sich von ihm eine Hilfsstellung für die israelitische Außenpolitik in Washington und bei der UNO.“"
                            },
                            {
                                "example_id": "37415f25-c2c2-4b2b-b56e-b2660bb9b670",
                                "sense_id": "7ffc25f6-bd19-36c7-ba58-78bb17a08013",
                                "text": "„Solche Menschen benötigten konkrete und praktische Hilfsstellung, um wieder auf die Beine zu kommen.“"
                            },
                            {
                                "example_id": "7c2cff96-092f-494d-b0a1-64cbf72c69c4",
                                "sense_id": "7ffc25f6-bd19-36c7-ba58-78bb17a08013",
                                "text": "„Er selbst wollte nicht mehr tun, als eine Hilfsstellung geben: dies war ihm allerdings staatliche Notwendigkeit.“"
                            },
                            {
                                "example_id": "e55316f4-3fc5-492a-b147-fdb701875fd7",
                                "sense_id": "7ffc25f6-bd19-36c7-ba58-78bb17a08013",
                                "text": "„Da das Archiv weltweite Briefwechsel unterhielt, wurde ich um französisch-englische Hilfsstellung gebeten und las Frau Förster-Nietzsche oftmals vor.“"
                            },
                            {
                                "example_id": "32fef87d-233b-4991-ae6f-088b31df12a2",
                                "sense_id": "7ffc25f6-bd19-36c7-ba58-78bb17a08013",
                                "text": "„Das Urteil darüber, daß andere Mächte Hitler Hilfsstellung zur Auslösung des Krieges leisteten, kann man getrost der Geschichte überlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
