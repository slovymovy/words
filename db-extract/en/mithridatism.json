        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cad88753-fc96-3103-b93e-d1a9325254a1",
                "word": "mithridatism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a33729b6-bc99-3d88-b885-8b634a8ae2f6",
                        "entry_id": "cad88753-fc96-3103-b93e-d1a9325254a1",
                        "glosses": [
                            "The practice of gradually ingesting successively greater amounts of a poison in order to build immunity."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dbaade16-aec6-45c6-a519-7cd9a5986e96",
                                "sense_id": "a33729b6-bc99-3d88-b885-8b634a8ae2f6",
                                "text": "Some argue that vaccines are a form of mithridatism; this is generally considered incorrect."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "413d7629-19ef-4aae-9ffd-fe1e4d7ca1b0",
                        "source_entry_id": "cad88753-fc96-3103-b93e-d1a9325254a1",
                        "source_sense_id": "a33729b6-bc99-3d88-b885-8b634a8ae2f6",
                        "source_sense_description": "the practice of ingesting successively greater amounts of a poison",
                        "target_lang_word": "mithridatisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mithridatisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a3b3bab-0b84-355b-8a3e-3202a56a3a7b",
                                        "entry_id": "f75ab0af-feb1-3b6a-9fc8-a01fcec2c4c7",
                                        "glosses": [
                                            "Immunisation progressive par ingestion de doses croissantes d'un produit toxique afin d'acquérir une insensibilité ou une résistance vis-à-vis de celui-ci."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b14be4-47a3-4883-9108-b89ebaea7256",
                                                "sense_id": "9a3b3bab-0b84-355b-8a3e-3202a56a3a7b",
                                                "text": "La mithridatisation n'a pas été adoubée par la médecine moderne; quant à la vaccination (que l’on pourrait associer à la notion de « sublime » comme « peur contrôlée »), elle semble difficile à transposer dans notre cas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b7d5008-7626-401c-9e25-685d5bfb59bc",
                        "source_entry_id": "cad88753-fc96-3103-b93e-d1a9325254a1",
                        "source_sense_id": "a33729b6-bc99-3d88-b885-8b634a8ae2f6",
                        "source_sense_description": "the practice of ingesting successively greater amounts of a poison",
                        "target_lang_word": "mithridatisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mithridatisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f15b972f-9458-32c9-a11a-325e7651ee03",
                                        "entry_id": "1136b817-8f9b-36a7-9a22-ef7f900d2107",
                                        "glosses": [
                                            "Synonyme de mithridatisation, immunité acquise à l'égard d'un poison par ingestion répétée de doses croissantes de ce poison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d32a7a3b-a21d-4466-b2b3-6ffce49e0f23",
                                                "sense_id": "f15b972f-9458-32c9-a11a-325e7651ee03",
                                                "text": "L'usage de certaines substances actives établit une tolérance, un mithridatisme ; cela se voit même pour les substances alimentaires."
                                            },
                                            {
                                                "example_id": "5a7be8b2-8fe8-4e19-aa64-2b1abf23c8ea",
                                                "sense_id": "f15b972f-9458-32c9-a11a-325e7651ee03",
                                                "text": "Immunité naturelle ou mithridatisme spontané, notre tante à héritage possédait sans nul doute ce talent inhabituel !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "936595ad-590a-3058-89ee-6e56545a12ab",
                                        "entry_id": "1136b817-8f9b-36a7-9a22-ef7f900d2107",
                                        "glosses": [
                                            "Insensibilité, indifférence acquise par l'habitude."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c0f3228-b8c1-4679-947b-59eebc0edaa1",
                                                "sense_id": "936595ad-590a-3058-89ee-6e56545a12ab",
                                                "text": "En disant « Babal », « Mémé », pour désigner des gens qu'elle ne connaissait pas, l'ambassadrice de Turquie suspendait les effets du « mithridatisme » qui, d'ordinaire, me la rendait tolérable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
