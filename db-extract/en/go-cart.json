                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9a9db06b-3c46-35dc-a5f4-3aa8745484d3",
                        "entry_id": "c430473c-6f21-36cb-af86-e1fcecf18e13",
                        "glosses": [
