                    },
                    {
                        "translation_id": "8edc37bd-714e-414c-a1a7-fc37fc72e877",
                        "source_entry_id": "64ddaa0f-97e2-3d14-a742-078bd168b570",
                        "source_sense_id": "7eefe26f-2aed-3cdb-98d5-c4cdc7480bf6",
                        "target_lang_word": "арабиза́ция",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "арабиза́ция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f19dd44c-6e25-3256-b2bb-a059454e9d61",
                                        "entry_id": "427a17d7-ae2c-3eb1-9935-68d31facf3ff",
                                        "glosses": [
                                            "насаждение арабского языка и культуры; усиление их роли и влияния"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f02cbb4-2fc7-45c2-913a-8155b10dbcff",
                                                "sense_id": "f19dd44c-6e25-3256-b2bb-a059454e9d61",
                                                "text": "Опираясь на поддержку народа, арабизация добивается в Алжире с каждым днём все более существенных успехов, что проявляется в использовании арабского языка широкими слоями населения, особенно среди молодёжи."
                                            },
                                            {
                                                "example_id": "fcdc6eb6-6417-4449-b93d-e7cc8ee59e11",
                                                "sense_id": "f19dd44c-6e25-3256-b2bb-a059454e9d61",
                                                "text": "В рамках широко пропагандируемой кампании «возврата к истокам» с середины 60-х гг. в АНДР стала осуществляться широкая арабизация, призванная ликвидировать последствия колониализма в области, языка и культуры."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ebaa6c0-19bd-3ca9-81a9-d2f6dea6fe1e",
                                        "entry_id": "427a17d7-ae2c-3eb1-9935-68d31facf3ff",
                                        "glosses": [
                                            "культурная ассимиляция неарабских народов арабами; усвоение арабской культуры и языка неарабским населением"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab140b71-cc5f-473c-8a78-a9b71ff60df0",
                                                "sense_id": "7ebaa6c0-19bd-3ca9-81a9-d2f6dea6fe1e",
                                                "text": "Помимо того, что арабы утвердились в этой провинции, началась еще арабизация местного (особенно сирийского) населения, которая при Аббасидах уже была заметна."
                                            },
                                            {
                                                "example_id": "6a2c3858-2a18-40d1-a216-760258f6f88e",
                                                "sense_id": "7ebaa6c0-19bd-3ca9-81a9-d2f6dea6fe1e",
                                                "text": "В ходе завоеваний массы арабов переселялись в завоёванные страны; в других частях халифата, где культура и язык были близки арабскому (Междуречье, Сирия), шла активная арабизация местного населения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
