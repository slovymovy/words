                "senses": [
                    {
                        "sense_id": "15626a8f-8743-3aad-8ec9-2dccc0f69f0e",
                        "entry_id": "908edaed-2125-3383-bfe7-907537e0dc75",
                        "glosses": [
                            "onverwachts optredend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3675ad18-63f6-4dba-9a66-e1c94cd9a77a",
                                "sense_id": "15626a8f-8743-3aad-8ec9-2dccc0f69f0e",
                                "text": "Er was een abrupte verandering in de temperatuur."
                            },
                            {
                                "example_id": "dbe202da-4e36-4aa5-beef-252ffbae7557",
                                "sense_id": "15626a8f-8743-3aad-8ec9-2dccc0f69f0e",
                                "text": "De regen leek daarnet af te zwakken, maar stopte niet; en toen, in een abrupte overgang van toon, werd hij nog heviger, nog duchtiger, alsof het voorafgaande slechts een prelude is geweest voor het echte plenswerk."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "65d3227b-324b-46ae-b6e6-7243337a9a80",
                        "source_entry_id": "908edaed-2125-3383-bfe7-907537e0dc75",
                        "source_sense_ids": [
                            "15626a8f-8743-3aad-8ec9-2dccc0f69f0e"
                        ],
                        "linkage_type": "synonyms",
                        "word": "plotseling"
                    }
                ]
            },
            {
                "entry_id": "7438050d-5ccb-3ee0-8374-cea2b9249a97",
                "word": "abrupt",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9790ba43-02e1-3016-b261-dfe0faa28cc0",
                        "entry_id": "7438050d-5ccb-3ee0-8374-cea2b9249a97",
                        "glosses": [
                            "ineens, plotseling, plotsklaps"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb5ab2a5-476f-4d76-823e-e962355b897d",
                                "sense_id": "9790ba43-02e1-3016-b261-dfe0faa28cc0",
                                "text": "De temperatuur veranderde abrupt."
                            },
                            {
                                "example_id": "ba79e367-16ef-4390-b555-eebbe191f113",
                                "sense_id": "9790ba43-02e1-3016-b261-dfe0faa28cc0",
                                "text": "Harald bleef abrupt staan."
                            },
                            {
                                "example_id": "56d16125-508d-4bc0-9a23-be9ba86feaf3",
                                "sense_id": "9790ba43-02e1-3016-b261-dfe0faa28cc0",
                                "text": "Hij kwam abrupt overeind en zei dat hij alleen moest zijn, dat het eten zou moeten wachten."
                            },
                            {
                                "example_id": "2abf6e66-49f8-435a-bc33-de9f6d790e7e",
                                "sense_id": "9790ba43-02e1-3016-b261-dfe0faa28cc0",
                                "text": "Ze wierp me een blik toe, draaide zich toen abrupt om en liep de deur uit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "122b04be-05da-4751-8b0a-9417e0727824",
                        "source_entry_id": "7438050d-5ccb-3ee0-8374-cea2b9249a97",
                        "source_sense_id": "9790ba43-02e1-3016-b261-dfe0faa28cc0",
                        "source_sense_description": "onverwachts optredend",
                        "target_lang_word": "abrupt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abrupt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cacc2752-ef5e-33e6-90b1-5fcfb0239c4a",
                                        "entry_id": "c98c8bcb-f381-3dc7-bd6d-7f6e6d31c7dd",
                                        "glosses": [
                                            "plötzlich, unvermittelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f29114b-652c-4dc7-a74e-cd06c95049a5",
                                                "sense_id": "cacc2752-ef5e-33e6-90b1-5fcfb0239c4a",
                                                "text": "Er beendete abrupt seinen Vortrag und stürmte zur Tür hinaus."
                                            },
                                            {
                                                "example_id": "d1bbcafa-b3e1-4e01-9572-9bf48e1dfbc1",
                                                "sense_id": "cacc2752-ef5e-33e6-90b1-5fcfb0239c4a",
                                                "text": "Der Taxifahrer bremste abrupt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ad391979-9964-30e7-aaa1-cf496b76e6d3",
                                        "entry_id": "c98c8bcb-f381-3dc7-bd6d-7f6e6d31c7dd",
                                        "glosses": [
                                            "ohne Zusammenhang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "105d2654-7763-4325-89d1-2bca574f6f7e",
                                                "sense_id": "ad391979-9964-30e7-aaa1-cf496b76e6d3",
                                                "text": "Er antwortete wieder abrupt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f07e9cbc-2388-4be0-87a4-9016d5ae7f71",
                        "source_entry_id": "7438050d-5ccb-3ee0-8374-cea2b9249a97",
                        "source_sense_id": "9790ba43-02e1-3016-b261-dfe0faa28cc0",
                        "source_sense_description": "onverwachts optredend",
                        "target_lang_word": "abrupt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abrupt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6be1904e-971c-33b1-93c6-fe0b085b248f",
                                        "entry_id": "c0dfa60f-4a25-30d2-8d5e-4836ca12b4e5",
                                        "glosses": [
                                            "Broken away (from restraint)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e1557b5-ca16-36c8-877c-a80c1d1f48e1",
                                        "entry_id": "c0dfa60f-4a25-30d2-8d5e-4836ca12b4e5",
                                        "glosses": [
                                            "Without notice to prepare the mind for the event; sudden; hasty; unceremonious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "986002e6-cca8-44ca-95b5-73f5dbeb0a6c",
                                                "sense_id": "2e1557b5-ca16-36c8-877c-a80c1d1f48e1",
                                                "text": "The party came to an abrupt end when the parents of our host arrived."
                                            },
                                            {
                                                "example_id": "f9d91c1d-d525-4f99-b010-572f4e8918b7",
                                                "sense_id": "2e1557b5-ca16-36c8-877c-a80c1d1f48e1",
                                                "text": "The cause of your abrupt departure."
                                            },
                                            {
                                                "example_id": "8546ccf1-a041-4eed-a9a1-c3429adcbb80",
                                                "sense_id": "2e1557b5-ca16-36c8-877c-a80c1d1f48e1",
                                                "text": "There was something in this abrupt allusion to the treasured and hidden past, that at once shocked and silenced Norbourne. He was annoyed to find that his heart's sweetest secret was in the possession of one so little likely to keep it;..."
                                            },
                                            {
                                                "example_id": "b66f9c1d-fe03-4980-a6ac-95da5e1b4acd",
                                                "sense_id": "2e1557b5-ca16-36c8-877c-a80c1d1f48e1",
                                                "text": "'Is it a slickstone?' she asks, and Maren snorts, an abrupt sound, bringing her hand up to her mouth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9350fda0-55cf-37f5-a196-9b974b3a6d89",
                                        "entry_id": "c0dfa60f-4a25-30d2-8d5e-4836ca12b4e5",
                                        "glosses": [
                                            "Curt in manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ad78146-efba-4143-8e67-2f349a0e5991",
                                                "sense_id": "9350fda0-55cf-37f5-a196-9b974b3a6d89",
                                                "text": "With no great disparity between them in point of years, they were, in every other respect, as unlike and far removed from each other as two men could well be. The one was soft-spoken, delicately made, precise, and elegant; the other, a burly square-built man, negligently dressed, rough and abrupt in manner, stern, and, in his present mood, forbidding both in look and speech."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4fb8dc0-83a5-3c4b-8294-a21c550857ea",
                                        "entry_id": "c0dfa60f-4a25-30d2-8d5e-4836ca12b4e5",
                                        "glosses": [
                                            "Having sudden transitions from one subject or state to another; unconnected; disjointed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dee4a2dc-c363-4c3d-b356-8768d9b90caa",
                                                "sense_id": "a4fb8dc0-83a5-3c4b-8294-a21c550857ea",
                                                "text": "The abrupt style, which hath many breaches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45e6090a-3376-3c28-8dc5-75f9d0936f75",
                                        "entry_id": "c0dfa60f-4a25-30d2-8d5e-4836ca12b4e5",
                                        "glosses": [
                                            "Broken off."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78965315-50bb-3d79-9f5d-76c6f18a93f4",
                                        "entry_id": "c0dfa60f-4a25-30d2-8d5e-4836ca12b4e5",
                                        "glosses": [
                                            "Extremely steep or craggy as if broken up; precipitous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54a1923d-a177-43a8-bf77-709ba8d89733",
                                                "sense_id": "78965315-50bb-3d79-9f5d-76c6f18a93f4",
                                                "text": "The mazy-running brook\nForms a deep pool; this bank abrupt and high."
                                            },
                                            {
                                                "example_id": "85f39eb3-7bcc-4992-9932-b6a89be29e56",
                                                "sense_id": "78965315-50bb-3d79-9f5d-76c6f18a93f4",
                                                "text": "To the north the towering scree-strewn slopes of Saddleback begin to draw nearer as we start the abrupt descent towards Keswick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84be81f8-87fd-3732-8be4-6d5c79f9e818",
                                        "entry_id": "c0dfa60f-4a25-30d2-8d5e-4836ca12b4e5",
                                        "glosses": [
                                            "Suddenly terminating, as if cut off; truncate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd8d2c49-390f-44bc-bbf2-2bbdf6d17fa5",
                                                "sense_id": "84be81f8-87fd-3732-8be4-6d5c79f9e818",
                                                "text": "Root oblong, blackish, nearly the thickness of the little finger, often growing obliquely; abrupt at the lower end, so as to appear as if bitten off, furnished with long whitish fibres."
                                            }
                                        ]
                                    }
                                ]
                            },
