                    "frequency": "High",
                    "semantic_group_id": "sozial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kinder brauchen ein stabiles soziales <w>Umfeld</w>, um gesund und glücklich aufzuwachsen."
                        },
                        {
                            "text": "Er hat sich in seinem neuen beruflichen <w>Umfeld</w> von Anfang an sehr wohlgefühlt."
                        }
                    ],
                    "common_phrases": [
