                        "examples": [
                            {
                                "example_id": "3077b260-eacc-4309-84dd-37c5b8b4c345",
                                "sense_id": "3522d9f0-c8b3-3fd9-a6c8-e97795d741bd",
                                "text": "Het slavenschip vervoerde gevangen slaven van Afrika naar de Amerika's.",
                                "translation": "The slave ship transported captured slaves from Africa to the Americas.",
                                "english": "The slave ship transported captured slaves from Africa to the Americas."
                            },
                            {
                                "example_id": "32ebd956-83cc-4b77-b2d5-c060e854e858",
                                "sense_id": "3522d9f0-c8b3-3fd9-a6c8-e97795d741bd",
                                "text": "De gruwelijke omstandigheden op het slavenschip waren schokkend en hartverscheurend.",
                                "translation": "The horrifying conditions on the slave ship were shocking and heartbreaking.",
                                "english": "The horrifying conditions on the slave ship were shocking and heartbreaking."
                            },
                            {
                                "example_id": "4aefa70d-6ac6-4497-9640-b7194b38f1ab",
                                "sense_id": "3522d9f0-c8b3-3fd9-a6c8-e97795d741bd",
                                "text": "Het slavenscheepje speelde een duistere rol in de geschiedenis van de trans-Atlantische slavenhandel.",
                                "translation": "The slave ship played a dark role in the history of the transatlantic slave trade.",
                                "english": "The slave ship played a dark role in the history of the transatlantic slave trade."
                            }
                        ]
                    }
