                "translations": [
                    {
                        "translation_id": "a0226e63-1942-4687-8eea-3b3ac4f60b2a",
                        "source_entry_id": "8a62a9d0-e941-3620-9ce0-03dcb790f453",
                        "source_sense_id": "70911856-ceae-3764-b4ab-624d9a7bc86e",
                        "source_sense_description": "kurz für: Untersuchungshaft",
                        "target_lang_word": "remand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae4612c5-0017-3039-87da-6b161adf0ef7",
                                        "entry_id": "8e78f1ff-c44d-30aa-8c79-4b5ccf7551b4",
                                        "glosses": [
                                            "The act of sending an accused person back into custody whilst awaiting trial."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d03be65b-2325-4972-b673-85c293ed20fb",
                                                "sense_id": "ae4612c5-0017-3039-87da-6b161adf0ef7",
                                                "text": "On arrest and unable to obtain bail, could mean that a person may be held in remand prison for six months or more."
                                            },
                                            {
                                                "example_id": "044f6108-fd72-4cff-8ebb-52eeaebda2b0",
                                                "sense_id": "ae4612c5-0017-3039-87da-6b161adf0ef7",
                                                "text": "As earlier stated, remand in custody under the new Code is an exceptional measure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7afe6633-3dcc-3138-83b7-a5be16213b45",
                                        "entry_id": "8e78f1ff-c44d-30aa-8c79-4b5ccf7551b4",
                                        "glosses": [
                                            "The act of an appellate court sending a matter back to a lower court for review or disposal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a43a986d-3734-4814-95e8-8717a66eaa30",
                                                "sense_id": "7afe6633-3dcc-3138-83b7-a5be16213b45",
                                                "text": "If remand is based on a failure of federal subject matter jurisdiction or a shortcoming in the process of removal, the remand becomes effective even earlier […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "remand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f93e4618-a7fa-3baf-8e70-5ae30c4c7763",
                                        "entry_id": "bb7e8303-9d56-361e-8c21-a183f23893bd",
                                        "glosses": [
                                            "To send a prisoner back to custody."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba63897c-ce57-45cc-b5b3-da8ac4ff83eb",
                                                "sense_id": "f93e4618-a7fa-3baf-8e70-5ae30c4c7763",
                                                "text": "The number of days for which the offender was remanded in custody in connection with the offence or a related offence is to count as time served by the offender as part of the sentence."
                                            },
                                            {
                                                "example_id": "7db5b084-985a-49fa-9024-eaebcecafb8c",
                                                "sense_id": "f93e4618-a7fa-3baf-8e70-5ae30c4c7763",
                                                "text": "Mr. Goodstein has described the majority of leaders of the gay movement as \"neurotics\" who should be remanded to the \"counseling couches where they belong.\""
                                            },
                                            {
                                                "example_id": "23acd2a9-0456-4dd1-9ef7-b45b09917ed3",
                                                "sense_id": "f93e4618-a7fa-3baf-8e70-5ae30c4c7763",
                                                "text": "A former member of the radical anti-capitalist Baader-Meinhof gang arrested in Berlin last week after 30 years on the run has been remanded in custody over three violent attacks in the 1990s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92178af3-074b-3a4a-a56f-415f631759cb",
                                        "entry_id": "bb7e8303-9d56-361e-8c21-a183f23893bd",
                                        "glosses": [
                                            "To send a case back to a lower court for further consideration."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2964616-73fd-3e7a-87fc-e1b465cb999b",
                                        "entry_id": "bb7e8303-9d56-361e-8c21-a183f23893bd",
                                        "glosses": [
                                            "To send back."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5f701b9-099c-4e34-86bb-2f7eb3414fff",
                                                "sense_id": "b2964616-73fd-3e7a-87fc-e1b465cb999b",
                                                "text": "Remand it to its former place."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
