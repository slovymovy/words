                "senses": [
                    {
                        "sense_id": "3fd1672c-381f-34fe-a1a8-2daaefd3c6a6",
                        "entry_id": "b825117d-db2e-32fb-8820-baf9635a2a34",
                        "glosses": [
                            "Mitglied des Sicherheitspersonals eines Gefängnisses, Gefängniswärter"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "87ec473a-b1ce-46c6-b510-920ef4789947",
                                "sense_id": "3fd1672c-381f-34fe-a1a8-2daaefd3c6a6",
                                "text": "Der Schließer kam in die Zelle und überzeugte sich erst einmal selbst von Sebastians Zustand."
                            },
                            {
                                "example_id": "65f005a7-7c1e-418a-a8ac-da45ec9de3d4",
                                "sense_id": "3fd1672c-381f-34fe-a1a8-2daaefd3c6a6",
                                "text": "„Es gab später einen kleinen Streit mit den Schließern, die uns wieder einsperren wollten, während wir natürlich nach Freiheit lechzten, aber am Ende waren wir gezwungen, ihnen eine weitere Nacht lang zu gehorchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "740ff10a-06db-4e00-baf5-16fc3a026b12",
                        "source_entry_id": "b825117d-db2e-32fb-8820-baf9635a2a34",
                        "source_sense_id": "3fd1672c-381f-34fe-a1a8-2daaefd3c6a6",
                        "source_sense_description": "umgangssprachlich: Mitglied des Sicherheitspersonals eines Gefängnisses, Gefängniswärter",
                        "target_lang_word": "prison guard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prison guard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73d093c1-2712-355b-824b-774721d242ba",
                                        "entry_id": "92effa60-3fb0-3a66-b7c2-babf86e14186",
                                        "glosses": [
                                            "An armed person working to provide order, security, discipline, punishment, and prevent escapes of prisoners in a jail that answers to a warden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae07fd2-4e71-4684-8067-2e4207d8bae0",
                                                "sense_id": "73d093c1-2712-355b-824b-774721d242ba",
                                                "text": "And Tietelbaum has been bought and sold so many times by the dark Republican powers that be, look at the prisonguard beating trial and the Ventura County sewer fiasco."
                                            },
                                            {
                                                "example_id": "f6b3403f-4393-46dd-b9e8-96ca5bd8ff78",
                                                "sense_id": "73d093c1-2712-355b-824b-774721d242ba",
                                                "text": "During his services as a praetorian, Caesium Verus was twice promoted, first to tubicen (trumpeter), then to optio carceris (camp prisonguard): ordinatus tubicem item optio at carcarem factus est."
                                            },
                                            {
                                                "example_id": "62675440-6351-48d8-a2c7-e398e2f04077",
                                                "sense_id": "73d093c1-2712-355b-824b-774721d242ba",
                                                "text": "The Telfaire Prisonguard towers rise miragelike in the swampy sunlight like giant mushroom caps on grey concrete stalks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
