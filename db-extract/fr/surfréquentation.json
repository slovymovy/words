                            {
                                "example_id": "d4f89afb-99ec-4c05-bf1e-ee8a53c62f03",
                                "sense_id": "a2495f34-47ec-37b5-8ed3-d76064d6b70f",
                                "text": "À lire la presse japonaise, les sources chaudes, inscrites parmi les traditions ancestrales de l’archipel, seraient menacées de pénurie par la surfréquentation touristique."
                            }
                        ]
                    }
