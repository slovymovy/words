                    {
                        "sense_id": "6e349d34-fe59-3afa-a614-a612a88d5e51",
                        "entry_id": "674dbc07-99a2-3f9c-9ad5-058e9d4e6e87",
                        "glosses": [
                            "cecha tego, co pobożne lub tego, kto pobożny; religijność, oddanie wierze religijnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5601d81e-68dc-45bc-9f3d-6cdc5a2e01d3",
                                "sense_id": "6e349d34-fe59-3afa-a614-a612a88d5e51",
                                "text": "Nie ukrywał swej pobożności, każdego szabatu chodząc do synagogi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a41112c-b9ea-4d2b-83c6-d7eb1b82c12a",
                        "source_entry_id": "674dbc07-99a2-3f9c-9ad5-058e9d4e6e87",
                        "source_sense_id": "6e349d34-fe59-3afa-a614-a612a88d5e51",
                        "target_lang_word": "piety",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piety",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa7e7bb1-6741-3733-b7e8-1c0947f32a06",
                                        "entry_id": "81355d2f-41c1-3e70-9c39-06ec3ac55a3a",
                                        "glosses": [
                                            "Reverence and devotion to God."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "effa3cd2-2877-4185-8f9d-b404b5d94f09",
                                                "sense_id": "fa7e7bb1-6741-3733-b7e8-1c0947f32a06",
                                                "text": "Colleen's piety led her to make sacrifices that most people would not have made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d90d4add-40f4-373a-b85f-3555453d4f92",
                                        "entry_id": "81355d2f-41c1-3e70-9c39-06ec3ac55a3a",
                                        "glosses": [
                                            "Similar reverence to one's parents and family or to one's country."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b5a3a81-f574-459d-86f3-067303cc63e6",
                                                "sense_id": "d90d4add-40f4-373a-b85f-3555453d4f92",
                                                "text": "patriotism as piety, when done right"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "842debf2-bbe3-321f-bfe4-88c174a2e863",
                                        "entry_id": "81355d2f-41c1-3e70-9c39-06ec3ac55a3a",
                                        "glosses": [
                                            "A devout or otherwise laudable act, thought, or statement."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b643bc6-4260-49db-8e34-33b6f61ea984",
                                                "sense_id": "842debf2-bbe3-321f-bfe4-88c174a2e863",
                                                "text": "Those who dwell outside of Western Establishment bastions are not idiots just because they do not mouth the pieties of GASP. Some of them can write very well. There are other traditions, you know. They could write for Wikipedia, if you let them. But such true openness and genuine tolerance is unacceptable, precisely because those other traditions fail to pay exclusive homage to GASP sources, through which—Wikipedians imagine—all the benefits of global civilization flow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "052d8111-17b9-318d-8352-80297cab643f",
                                        "entry_id": "81355d2f-41c1-3e70-9c39-06ec3ac55a3a",
                                        "glosses": [
                                            "A devout or otherwise laudable act, thought, or statement.",
                                            "A platitude that may be empty or at least facile and undercommitted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a43912da-79eb-452d-97bc-442cd9154ffb",
                                                "sense_id": "052d8111-17b9-318d-8352-80297cab643f",
                                                "text": "He was quick with the pieties about hard work, honest communication, active listening, and respecting others' viewpoints, but walking the walk is different from talking the talk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53c8d739-cf68-4166-952f-8e1f95c65451",
                        "source_entry_id": "674dbc07-99a2-3f9c-9ad5-058e9d4e6e87",
                        "source_sense_id": "6e349d34-fe59-3afa-a614-a612a88d5e51",
                        "target_lang_word": "Frömmigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frömmigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5350bc6-424d-3e2e-ab7b-6c7d06bdbc02",
                                        "entry_id": "b1d3f00f-aa3c-3369-8b18-8f406bf5cdd3",
                                        "glosses": [
                                            "Haltung einer Person, die an Gott glaubt und entsprechend handelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35c161f1-9f24-4546-b85e-7a80a56cc3ae",
                                                "sense_id": "d5350bc6-424d-3e2e-ab7b-6c7d06bdbc02",
                                                "text": "„Äußerst wichtige Bestandteile des Lebens in Poremba waren die Frömmigkeit und die Kirche.“"
                                            },
                                            {
                                                "example_id": "02970b85-6550-4d08-b0f5-65cdbc7b9fd7",
                                                "sense_id": "d5350bc6-424d-3e2e-ab7b-6c7d06bdbc02",
                                                "text": "„Alle fanden, dass seine Frömmigkeit auf sie abfärbte, ihrem Gesicht etwas Strahlendes gab, als hätte sie es gerade mit Vaseline eingecremt.“"
                                            },
                                            {
                                                "example_id": "67f6d25b-5f36-4b9d-be69-f3752afeb6dc",
                                                "sense_id": "d5350bc6-424d-3e2e-ab7b-6c7d06bdbc02",
                                                "text": "„Leben aus Gottes Kraft - viele Besucher beziehen das Motto des Katholikentags wohl eher auf ihre persönliche Frömmigkeit und Sinnfindung.“"
                                            },
                                            {
                                                "example_id": "0c4410df-b96a-44e2-b7a1-70aa65137d99",
                                                "sense_id": "d5350bc6-424d-3e2e-ab7b-6c7d06bdbc02",
                                                "text": "„Aber hier gibt es beinah ebensoviel weiße, weil der weiße Turban dem Adel, der Wissenschaft, der Frömmigkeit, das heißt oft dem Schwindel gehört.“"
                                            },
                                            {
                                                "example_id": "8434bdc2-26cc-4c00-9931-6b4b77d9177f",
                                                "sense_id": "d5350bc6-424d-3e2e-ab7b-6c7d06bdbc02",
                                                "text": "„Sie basteln sich kleine Religionen der Andacht, kleine Frömmigkeiten der Zuneigung, der Liebe, und anstatt in ihrer Seele das Gefühl Gottes zu haben, das Gefühl der Pflicht, geben sie sich Träumereien hin, kleinen Andachtsübungen, kleinen Frömmigkeiten.“"
                                            },
                                            {
                                                "example_id": "8ac022e0-7bab-46d9-b317-1db94bc16573",
                                                "sense_id": "d5350bc6-424d-3e2e-ab7b-6c7d06bdbc02",
                                                "text": "„Gott wird beschrieben als einer, der sich ‚der Frömmigkeiten der Väter erinnert‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c28bfef-ee19-413b-a3a3-511e88a74a22",
                        "source_entry_id": "674dbc07-99a2-3f9c-9ad5-058e9d4e6e87",
                        "source_sense_id": "6e349d34-fe59-3afa-a614-a612a88d5e51",
                        "target_lang_word": "благочестие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "благочестие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b18b6363-ecd7-3ee4-8315-281136eea753",
                                        "entry_id": "3c13c7f7-63df-3040-bf3f-e39af645dc72",
                                        "glosses": [
                                            "книжн., церк. отвлеч. сущ. к благочестивый, благочестивое поведение, настроение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9f4d5ae-8d55-45e0-8983-b97dfbf812df",
                                                "sense_id": "b18b6363-ecd7-3ee4-8315-281136eea753",
                                                "text": "Баснь учит, что Богу не наружное благочестие, но внутреннее усердие приятно, и что те, которые кажутся беднейшею тварию, могут быть в рассуждении Божеского правосудия достойнейшими."
                                            },
                                            {
                                                "example_id": "07f1cb7e-49da-460d-a7a7-48deb539c877",
                                                "sense_id": "b18b6363-ecd7-3ee4-8315-281136eea753",
                                                "text": "Он умел выжидать, пользоваться удобными минутами, оставаться в тени или выдвигаться вперёд, когда считал уместным то или другое, — надевать на себя личину благочестия и всяких добродетелей, показывать доброту и милосердие, а где нужно — строгость и суровость."
                                            },
                                            {
                                                "example_id": "8a645eba-23aa-43ab-9ce6-5b4b028096a4",
                                                "sense_id": "b18b6363-ecd7-3ee4-8315-281136eea753",
                                                "text": "Разница в том только и состоит, что в Риме сияло нечестие, а у нас — благочестие, Рим заражало буйство, а нас — кротость, в Риме бушевала подлая чернь, а у нас — начальники."
                                            },
                                            {
                                                "example_id": "3fbb53c7-e373-4a24-a508-c81183652fbe",
                                                "sense_id": "b18b6363-ecd7-3ee4-8315-281136eea753",
                                                "text": "Открой в Бультоне капеллу, прослыви святым, подавая пример благочестия, милосердия и терпимости."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37a096d2-e98a-3667-8dea-c2156a64ca77",
                                        "entry_id": "3c13c7f7-63df-3040-bf3f-e39af645dc72",
                                        "glosses": [
                                            "устар., высок. обращение к священнослужителю,"
                                        ],
                                        "tags": [
                                            "обычно со словом «ваше»"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fffd07a-4758-45f9-b7ca-4e207533ea6a",
                                                "sense_id": "37a096d2-e98a-3667-8dea-c2156a64ca77",
                                                "text": "Сколько баранов потребуется на трапезу вашему благочестию?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e206a8b2-855c-46a0-aaea-5b1dc788dfce",
                        "source_entry_id": "674dbc07-99a2-3f9c-9ad5-058e9d4e6e87",
