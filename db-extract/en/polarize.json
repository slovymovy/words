                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5986e329-51bd-4316-a783-4d327b908994",
                                                "sense_id": "d5b9433b-af31-3a7f-80bf-857220d2cf72",
                                                "text": "Das Konzept „Polarisieren“ funktioniert getreu dem Motto „Entweder du bist mit uns oder du bist gegen uns!“."
                                            },
                                            {
                                                "example_id": "a15334b1-311a-4447-ba07-cab29cdc4555",
                                                "sense_id": "d5b9433b-af31-3a7f-80bf-857220d2cf72",
                                                "text": "Konflikte wie der um die Plagiatsaffäre eines Bundesministers können die Gesellschaft polarisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
