                ],
                "translations": [
                    {
                        "translation_id": "9999ef6f-baec-4dae-854f-13eaa7178677",
                        "source_entry_id": "3eabc4c3-18a0-3150-85e3-839abe07fe19",
                        "source_sense_id": "2c6efb5a-39ac-35a7-96bb-dd35862fc065",
