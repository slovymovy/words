                                        "examples": [
                                            {
                                                "example_id": "6a654dba-1765-4c05-9faf-67de0a288e82",
                                                "sense_id": "2ff60eec-0895-34fe-bc72-84b4b018a46c",
                                                "text": "Door de nabijheid van de hersenen vooral bacteriële meningitis een zeer gevreesde aandoening die tot de dood of tot ernstige invaliditeit kan leiden,."
                                            }
                                        ]
