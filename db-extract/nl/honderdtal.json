                                            {
                                                "example_id": "06338555-33db-4ed0-83fa-baa13942b533",
                                                "sense_id": "169ddaf0-b15b-35ad-86db-8789e83276c7",
                                                "text": "Perdre la centaine : Ne plus savoir où l’on en est."
