                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bfff9b3-f3b9-4959-8b66-e0dc25767978",
                                "sense_id": "e62eaa81-da8b-3168-85db-4e6d22d86e99",
                                "text": "Meneer Van Dalen Wacht Op Antwoord en het KOFSCHIP zijn ezelsbruggetjes."
                            },
                            {
                                "example_id": "b9b1ba26-81c0-4bd1-a774-7c80557942ec",
                                "sense_id": "e62eaa81-da8b-3168-85db-4e6d22d86e99",
                                "text": "Het Turkse nationale embleem is de halve maan. Niet zo maar een halve maan - een wassende. Mijn goede vader leerde me destijds de ezelsbrug voor de sikkelvormige schijngestalten van de maan. Kon je er een p van maken, dan was het nieuwe maan; kon je er een d van maken, dan was het oude maan. De p van premier, de d van dernier: op mijn beurt kan ik ze van harte aanbevelen."
                            }
                        ]
                    }
