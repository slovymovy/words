{
    "word_family": [
        "financial",
        "financially",
        "financier",
        "financing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36d8fd7e-c3de-35e1-838d-7bd511577e3a",
                    "sense_definition": "The management of money and other assets, especially by governments, companies, or large organizations.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "management_field",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to study <w>finance</w> at university to understand how markets work.",
                            "target_lang_translations": {
                                "ru": "Она решила изучать <w>финансы</w> в университете, чтобы понять, как работают рынки.",
                                "zh": "她决定在大学学习<w>金融</w>，以了解市场是如何运作的。"
                            }
                        },
                        {
                            "text": "The minister of <w>finance</w> announced the new budget yesterday.",
                            "target_lang_translations": {
                                "ru": "Министр <w>финансов</w> объявил вчера о новом бюджете.",
                                "zh": "昨天，<w>财政</w>部长宣布了新的预算。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "corporate finance",
                        "personal finance",
                        "world of finance",
                        "minister of finance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Управление деньгами и другими активами, особенно в контексте государств, компаний или крупных организаций.",
                        "zh": "管理金钱及其他资产的活动，尤指政府、公司或大型组织进行的管理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "финансы",
                                "target_lang_sense_clarification": "наука или сфера деятельности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "金融",
                                "target_lang_sense_clarification": "指货币流通、信用活动及相关经济活动"
                            },
                            {
                                "target_lang_word": "财政",
                                "target_lang_sense_clarification": "指政府或组织的收支管理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0089ce51-21c6-3a6b-a00d-5a6478715c8d",
                    "sense_definition": "The money or monetary resources available to a person, company, or country.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "resources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's <w>finances</w> are in excellent shape this year.",
                            "target_lang_translations": {
                                "ru": "<w>Финансы</w> компании в этом году в отличном состоянии.",
                                "zh": "今年该公司的<w>财务</w>状况非常好。"
                            }
                        },
                        {
                            "text": "They need to organize their personal <w>finances</w> before buying a new house.",
                            "target_lang_translations": {
                                "ru": "Им нужно привести в порядок свои личные <w>финансы</w> перед покупкой нового дома.",
                                "zh": "在买新房之前，他们需要整理好自己的个人<w>财务</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "personal finances",
                        "government finances",
                        "family finances",
                        "manage finances"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги или денежные ресурсы, имеющиеся в распоряжении человека, компании или страны.",
                        "zh": "个人、公司或国家可支配的资金或货币资源。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "финансы",
                                "target_lang_sense_clarification": "денежные средства"
                            },
                            {
                                "target_lang_word": "бюджет",
                                "target_lang_sense_clarification": "совокупность доходов и расходов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "财务",
                                "target_lang_sense_clarification": "指个人或单位的资金状况"
                            },
                            {
                                "target_lang_word": "资金",
                                "target_lang_sense_clarification": "指可用于特定目的的货币资源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c07519c-f2dd-342d-891f-2db6a13001a0",
                    "sense_definition": "A loan or arrangement that allows a customer to pay for goods or services over a period of time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "loan_product",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We offer interest-free <w>finance</w> on all furniture purchases over a certain amount.",
                            "target_lang_translations": {
                                "ru": "Мы предлагаем беспроцентную <w>рассрочку</w> на покупку любой мебели свыше определенной суммы.",
                                "zh": "对于超过一定金额的家具购买，我们提供免息<w>分期付款</w>。"
                            }
                        },
                        {
                            "text": "They could not get the <w>finance</w> approved for the new car.",
                            "target_lang_translations": {
                                "ru": "Им не одобрили <w>кредит</w> на новую машину.",
                                "zh": "他们没能获得购买新车的<w>贷款</w>批准。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "arrange finance",
                        "finance deal",
                        "car finance",
                        "finance options"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кредит или соглашение, позволяющее клиенту оплачивать товары или услуги в течение определенного периода времени.",
                        "zh": "允许客户在一段时间内分期支付商品或服务费用的贷款或安排。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассрочка",
                                "target_lang_sense_clarification": "оплата частями"
                            },
                            {
                                "target_lang_word": "кредит",
                                "target_lang_sense_clarification": "займ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分期付款",
                                "target_lang_sense_clarification": "指将总额分摊到一段时间内支付"
                            },
                            {
                                "target_lang_word": "贷款",
                                "target_lang_sense_clarification": "指借入资金以支付大额开支"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33c7ff12-0fcb-33b9-b472-1f9bfe15add1",
                    "sense_definition": "To provide the money needed for a project, purchase, or business activity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "provide_funding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank agreed to <w>finance</w> the construction of the new bridge.",
                            "target_lang_translations": {
                                "ru": "Банк согласился <w>финансировать</w> строительство нового моста.",
                                "zh": "银行同意为新桥的建设<w>资助</w>。"
                            }
                        },
                        {
                            "text": "He worked two jobs to <w>finance</w> his education.",
                            "target_lang_translations": {
                                "ru": "Он работал на двух работах, чтобы <w>оплачивать</w> свое образование.",
                                "zh": "他打了两份工来<w>资助</w>自己的学业。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fund"
                    ],
                    "common_phrases": [
                        "finance a project",
                        "finance a deal",
                        "publicly financed",
                        "privately financed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять деньги, необходимые для проекта, покупки или деловой деятельности.",
                        "zh": "为项目、购买或商业活动提供所需的资金。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "финансировать",
                                "target_lang_sense_clarification": "обеспечивать средствами"
                            },
                            {
                                "target_lang_word": "оплачивать",
                                "target_lang_sense_clarification": "платить за что-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "资助",
                                "target_lang_sense_clarification": "提供资金支持"
                            },
                            {
                                "target_lang_word": "提供资金",
                                "target_lang_sense_clarification": "为某事提供经济支持"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}