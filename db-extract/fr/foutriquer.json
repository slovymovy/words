                "senses": [
                    {
                        "sense_id": "6c511843-6f5a-3041-baf3-8c6d0a52e33c",
                        "entry_id": "2205a7e3-b91c-3305-8457-e187cf97ae18",
                        "glosses": [
                            "Pratiquer le coït, posséder charnellement."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "5c5647bc-43da-4308-9b40-46db94b8cc37",
                                "sense_id": "6c511843-6f5a-3041-baf3-8c6d0a52e33c",
                                "text": "Cela suffit : reviens-moi, cervelle, sœur carmélite dans ta cellule, où cours-tu te faire foutriquer ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "cb77e03c-19e5-3a63-816e-6833ab98c247",
                        "entry_id": "2205a7e3-b91c-3305-8457-e187cf97ae18",
                        "glosses": [
                            "Avoir le dessus de manière déloyale."
                        ],
                        "tags": [
                            "figuratively",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "1d188cdd-b1ba-4e59-aae0-a4f872f5e467",
                                "sense_id": "cb77e03c-19e5-3a63-816e-6833ab98c247",
                                "text": "Les Goyes se font poirer, trucider, spolier, bénarer, hacher, foutriquer toujours et toujours par les Youtres […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "f91081f0-9369-384f-8d56-1c5763a05fc4",
                        "entry_id": "2205a7e3-b91c-3305-8457-e187cf97ae18",
                        "glosses": [
                            "Fouiller."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "c5ec5710-1942-4a9d-a474-34a7a8f752ee",
                                "sense_id": "f91081f0-9369-384f-8d56-1c5763a05fc4",
                                "text": "Je vous entends branler ! fouiller ! foutriquer vos poubelles!"
                            }
                        ]
                    }
