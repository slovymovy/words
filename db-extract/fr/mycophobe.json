                                        "glosses": [
                                            "Having or relating to an aversion to mushrooms or fungi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bbe23b9-cfcd-44f2-89de-341c7247c618",
                                                "sense_id": "5a35adb5-f01e-3d43-8372-f97d65a446ff",
                                                "text": "Not all European countries are as mycophobic as the English. In Italy, Poland, and much of Eastern Europe and Russia, mushrooms are an important part of the diet [...]"
                                            },
                                            {
                                                "example_id": "449e10d1-9250-4860-91b8-83e9b15d9e26",
                                                "sense_id": "5a35adb5-f01e-3d43-8372-f97d65a446ff",
                                                "text": "Mycophobic attitudes might fuel a moral panic that leads to their illegalisation, or prompt Albertus Magnus and John Gerard to issue stark warnings about the dangers of these 'new fangled meates'."
                                            }
                                        ]
                                    }
                                ]
                            }
