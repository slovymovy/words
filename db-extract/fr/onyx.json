                                    {
                                        "sense_id": "e589d198-dc9f-3412-a0ab-55dfefdcff18",
                                        "entry_id": "6747a157-166f-3a3e-8504-bfa89c73cd95",
                                        "glosses": [
                                            "jet-black"
                                        ],
