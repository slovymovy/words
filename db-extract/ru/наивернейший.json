                "senses": [
                    {
                        "sense_id": "62eb2f98-4955-3b4c-9e00-b9d0c3cd85a2",
                        "entry_id": "c7ace335-147c-357c-88c0-40503c98ff41",
                        "glosses": [
                            "превосх. ст. к прил. верный; самый верный, самый надёжный"
                        ],
                        "tags": [
                            "superlative"
                        ],
                        "examples": [
                            {
                                "example_id": "3ed65ebf-3723-43c2-8a11-d6b30e0918d4",
                                "sense_id": "62eb2f98-4955-3b4c-9e00-b9d0c3cd85a2",
                                "text": "Флегонт Флегонтович остался на бобах и теперь мечтает о каком-то заветном местечке на реке Чусовой, которое ему обещал предоставить самый наивернейший человечек."
                            }
                        ]
                    },
                    {
                        "sense_id": "32b186ec-5142-3bbf-afa7-f3dc0f64aada",
                        "entry_id": "c7ace335-147c-357c-88c0-40503c98ff41",
                        "glosses": [
                            "устар. самый достоверный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "637e4618-e36c-48ab-b4fa-4f2c578e6b93",
                                "sense_id": "32b186ec-5142-3bbf-afa7-f3dc0f64aada",
                                "text": "К тому же и кухарка пугала её, сообщая наивернейшие известия об исчезновении то того, то другого молодого человека по соседству."
                            }
                        ]
                    }
