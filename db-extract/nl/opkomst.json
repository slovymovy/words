                                            {
                                                "example_id": "6d434bf0-0988-477b-8c53-2f146d649954",
                                                "sense_id": "a5405fdf-a359-3822-9143-7d5a9cf4842d",
                                                "text": "Der Aufstieg der Wirtschaft verbesserte die Lage der Bevölkerung."
                                            },
                                            {
                                                "example_id": "3dcc8fcc-f98e-403d-93c0-c475ac6cbd08",
                                                "sense_id": "a5405fdf-a359-3822-9143-7d5a9cf4842d",
                                                "text": "[Japan:] „Der Shinkansen stand stellvertretend für den rasanten, wirtschaftlichen Aufstieg nach dem Zweiten Weltkrieg.“"
                                            },
                                            {
                                                "example_id": "b8fbfc49-7745-4c4d-81d9-7066b7f962de",
                                                "sense_id": "a5405fdf-a359-3822-9143-7d5a9cf4842d",
                                                "text": "Der fleißige Industriearbeiter hatte einen großen Aufstieg gemacht."
                                            },
                                            {
                                                "example_id": "edb70e42-665c-4c7c-80be-00b2f6e426f3",
                                                "sense_id": "a5405fdf-a359-3822-9143-7d5a9cf4842d",
                                                "text": "[Angestellte in den 1920er Jahre:] „Für viele bedeutete es einen sozialen Aufstieg, wenn sie sich nicht in Landwirtschaft und Fabrik „die Hände schmutzig machen mussten“.“"
                                            },
                                            {
                                                "example_id": "aaabed96-abaa-455a-a543-6ea2886ee22d",
                                                "sense_id": "a5405fdf-a359-3822-9143-7d5a9cf4842d",
                                                "text": "„Der Aufstieg der Niederlande begann mit einer Niederlage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "03b626e7-34b2-3881-8990-893345c9f758",
                                        "entry_id": "4d873e13-6a1d-3220-9dc1-5dec885d9d20",
                                        "glosses": [
                                            "das Emporsteigen, Hinaufsteigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20d0e117-7b71-4f8b-b978-2e4573e32e38",
                                                "sense_id": "03b626e7-34b2-3881-8990-893345c9f758",
                                                "text": "Der Aufstieg zum Gipfel war beschwerlich, aber die Aussicht machte das wieder wett."
                                            },
                                            {
                                                "example_id": "746a0370-c223-4e03-a7dd-05baee9ecf68",
                                                "sense_id": "03b626e7-34b2-3881-8990-893345c9f758",
                                                "text": "„Fünf Minuten später begannen wir den Aufstieg zu Spy-Glass-Berg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2dee1117-dbbc-377e-866a-c4d94d336863",
                                        "entry_id": "4d873e13-6a1d-3220-9dc1-5dec885d9d20",
