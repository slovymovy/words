                                    {
                                        "sense_id": "58626e11-e40a-3840-bd10-4f5892dadd57",
                                        "entry_id": "43fd027f-2a72-3945-a8ed-e8742f74aa88",
                                        "glosses": [
                                            "Qui peut s’étendre, qui peut être étendu."
