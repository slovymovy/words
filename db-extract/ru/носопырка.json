                ],
                "senses": [
                    {
                        "sense_id": "cea0e722-f5a7-30dc-90e4-0a3eb24fc9de",
                        "entry_id": "e91455c2-f567-359d-ab24-d7cf3ce3a14e",
                        "glosses": [
                            "разг., ласк., шутл. то же, что нос"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c1480ce-d190-4f15-bf82-fe9097cbef4d",
                                "sense_id": "cea0e722-f5a7-30dc-90e4-0a3eb24fc9de",
                                "text": "Носопырка красная, глаза простуженные."
                            },
                            {
                                "example_id": "7a4b9dab-76b7-4838-a056-f02c939024b1",
                                "sense_id": "cea0e722-f5a7-30dc-90e4-0a3eb24fc9de",
                                "text": "Мы с братом слегли с высочайшей, подолгу не спадающей и всё время возобновляющейся температурой, и из носопырок у нас без конца текла кровь — её усмиряли, а она текла и текла, и так много её было, что даже страшно вспоминать."
                            }
                        ]
                    }
                ],
