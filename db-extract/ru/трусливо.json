                        "source_sense_id": "5733e31b-dcc7-39f4-a2b8-50b9bcc9d42f",
                        "target_lang_word": "cowardly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cowardly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c85455b5-3158-3f95-ae3e-fc88b1c93de3",
                                        "entry_id": "ac59e5c2-0ded-3ad4-95c6-bb68c0bd6848",
                                        "glosses": [
                                            "Showing cowardice; lacking in courage; weakly fearful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae137751-3617-4f19-b9fe-11ee23580820",
                                                "sense_id": "c85455b5-3158-3f95-ae3e-fc88b1c93de3",
                                                "text": "The cowardly rascals that ran from the battle."
                                            },
                                            {
                                                "example_id": "ddaff0a6-0504-4d53-9939-7e89f8a6c64c",
                                                "sense_id": "c85455b5-3158-3f95-ae3e-fc88b1c93de3",
                                                "text": "1780, Edmund Burke, speech at The Guildhall, in Bristol\nThe cowardly rashness of those who dare not look danger in the face."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cowardly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d8604a0-95c4-3196-b437-5e4ba68ae330",
                                        "entry_id": "ba759829-1f4a-3315-98a4-6b1caba8ee5a",
                                        "glosses": [
                                            "In the manner of a coward, cowardlily."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bfd65c9-cc09-49ff-9333-140e933209f9",
                                                "sense_id": "1d8604a0-95c4-3196-b437-5e4ba68ae330",
                                                "text": "We will not ſteale vpon him cowardly,\nBut giue him warning and more warriours."
                                            },
                                            {
                                                "example_id": "4fe1b856-ab93-4dbe-a0ff-2cf77a105ef1",
                                                "sense_id": "1d8604a0-95c4-3196-b437-5e4ba68ae330",
                                                "text": "I love to follow them, but not so cowardly, as my life remaine thereby in subjection."
                                            },
                                            {
                                                "example_id": "d2de41cf-ca12-4e83-9fdb-8e19815a91cf",
                                                "sense_id": "1d8604a0-95c4-3196-b437-5e4ba68ae330",
                                                "text": "[…] men who cowardly and hypocritically subscribe orthodox creeds, whilst they teach a different kind of doctrine!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
