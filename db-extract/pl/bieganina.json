                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dda54aa5-cccb-32f2-b523-611e34169bd3",
                                        "entry_id": "eed382a9-70dd-3da1-ae56-21cdc4a6b6c1",
                                        "glosses": [
                                            "To put a lot of effort into one's work."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f874c74-015d-44ef-94a2-ea65166cee0a",
                                                "sense_id": "dda54aa5-cccb-32f2-b523-611e34169bd3",
                                                "text": "Frazier and Gary worked for me for free -- for six months -- they didn't take any money from the house. They worked for tips. They both had other jobs, and they came in here and they hustled their ass."
                                            }
                                        ]
                                    }
