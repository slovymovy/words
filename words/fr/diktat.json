{
    "word_family": [
        "dictateur",
        "dictature",
        "dicter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2530060a-e3db-35ab-a62a-f5e0063fa4bb",
                    "sense_definition": "Décision, ordre ou condition imposée unilatéralement et avec autorité, sans possibilité de négociation ni de réplique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "injonction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les salariés ont manifesté pour protester contre ce <w>diktat</w> imposé par la direction sans aucune consultation."
                        },
                        {
                            "text": "Le ministre a affirmé qu'il refusait de céder au <w>diktat</w> des groupes de pression financiers."
                        }
                    ],
                    "synonyms": [
                        "injonction",
                        "ultimatum"
                    ],
                    "antonyms": [
                        "compromis",
                        "négociation",
                        "consensus"
                    ],
                    "common_phrases": [
                        "imposer un diktat",
                        "céder au diktat",
                        "refuser un diktat"
                    ]
                },
                {
                    "sense_id": "6f77a9a8-aa5f-3ac6-9eec-597bf41a5a33",
                    "sense_definition": "Pression morale, sociale ou culturelle omniprésente et insidieuse qui s'impose aux individus dans leur mode de vie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pression_sociale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De plus en plus d'adolescents souffrent du <w>diktat</w> de la minceur véhiculé par les réseaux sociaux."
                        },
                        {
                            "text": "Elle a décidé de vivre à la campagne pour échapper au <w>diktat</w> de l'urgence permanente."
                        }
                    ],
                    "synonyms": [
                        "tyrannie",
                        "pression"
                    ],
                    "common_phrases": [
                        "diktat de la mode",
                        "diktat de la minceur",
                        "diktat de l'urgence"
                    ]
                },
                {
                    "sense_id": "28035cf1-8e0c-35a2-b07d-c9353e0f6a0e",
                    "sense_definition": "Traité de paix ou accord international imposé par la force aux vaincus sans qu'ils puissent en négocier les clauses.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "traite_impose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la Première Guerre mondiale, les Allemands ont dénoncé le traité de Versailles comme un véritable <w>diktat</w>."
                        },
                        {
                            "text": "La délégation diplomatique a refusé de signer ce texte, le considérant comme un <w>diktat</w> inacceptable."
                        }
                    ]
                }
            ]
        }
    ]
}