                "entry_id": "31c712ad-217d-3a4f-bb97-9bbec8f43b16",
                "word": "Rohingya",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "02bb369b-23fe-3826-8d6c-db3a07eab3f3",
                        "entry_id": "31c712ad-217d-3a4f-bb97-9bbec8f43b16",
                        "glosses": [
                            "The Indo-European language spoken in Arakan, Myanmar, closely related to Chittagonian."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b199b6ab-994d-44e5-9857-53ddeaafdc73",
                        "source_entry_id": "31c712ad-217d-3a4f-bb97-9bbec8f43b16",
                        "source_sense_id": "02bb369b-23fe-3826-8d6c-db3a07eab3f3",
                        "source_sense_description": "language",
                        "target_lang_word": "Rohingya",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rohingya",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a8d4d923-c335-3606-a4a7-50a8ba8fad14",
                                        "entry_id": "48558677-4003-3614-9c93-d54f58d706c3",
                                        "glosses": [
                                            "Indische taal die wordt gesproken door 2,5 miljoen mensen afkomstig uit het grensgebied van Myanmar met Bangladesh, langs de kust van de Golf van Bengalen"
                                        ],
                                        "tags": [
                                            "linguistics",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ceb3430-c4c8-4f05-b610-fa34f1886d2c",
                                                "sense_id": "a8d4d923-c335-3606-a4a7-50a8ba8fad14",
                                                "text": "Saad Shahriar komt uit Chittagong, de economische hoofdstad van Bangladesh, waar een taal wordt gesproken die aan het Rohingya verwant is."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Rohingya",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "11b85d79-bac3-344f-9686-94b1e9098385",
                                        "entry_id": "0238b422-82b9-34e9-8c56-a113ad80cf68",
                                        "glosses": [
                                            "iemand die behoort tot het gelijknamige volk"
                                        ],
                                        "tags": [
                                            "person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27f078c5-9f29-4188-9f94-b9b03a4e17a6",
                                                "sense_id": "11b85d79-bac3-344f-9686-94b1e9098385",
                                                "text": "Een Rohingya toont de ernstige verwondingen en littekens die hij opliep door toedoen van Myanmarese militairen."
                                            },
                                            {
                                                "example_id": "1d2f0472-b5f9-4bce-8bda-04adc22e6b04",
                                                "sense_id": "11b85d79-bac3-344f-9686-94b1e9098385",
                                                "text": "Hij is lid van de Nationale Democratische Partij voor Ontwikkeling (NDPD) en zelf een Rohingya."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c89fcd83-8382-33fc-ac0a-a243b8a8f23c",
                                        "entry_id": "0238b422-82b9-34e9-8c56-a113ad80cf68",
                                        "glosses": [
                                            "meervoud van het zelfstandig naamwoord Rohingya"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eab8ba87-54b0-4d5e-bc28-5cd378ea8071",
                                                "sense_id": "c89fcd83-8382-33fc-ac0a-a243b8a8f23c",
                                                "text": "Honderden Rohingya kwamen aan land in Atjeh. Maar Indonesië kent geen structurele opvang van vluchtelingen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ab6607c-ea5d-3d26-ba85-aec0c605ae7d",
                                        "entry_id": "0238b422-82b9-34e9-8c56-a113ad80cf68",
                                        "glosses": [
                                            "volk afkomstig uit het grensgebied van Myanmar met Bangladesh, langs de kust van de Golf van Bengalen; door vervolging leeft het merendeel nu elders"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7b05464-a699-4a7e-8ccd-e19e0fc7dba1",
                                                "sense_id": "0ab6607c-ea5d-3d26-ba85-aec0c605ae7d",
                                                "text": "Sinds de start van de genocide op de Rohingya in 2017 zijn bijna een miljoen leden van deze Myanmarese moslimgemeenschap gevlucht naar omringende landen."
                                            },
                                            {
                                                "example_id": "0f4b6806-3210-4d7e-b43f-227c47bd439e",
                                                "sense_id": "0ab6607c-ea5d-3d26-ba85-aec0c605ae7d",
                                                "text": "De Rohingya worden in Birma niet als aparte etnische groep gezien, die thuishoort in het land. De moslimminderheid wordt al jarenlang gediscrimineerd."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Rohingya",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2ebb60d1-81be-3ace-9779-321924e178a2",
                                        "entry_id": "b47b97af-e50f-3be2-947f-153a5e38a52e",
                                        "glosses": [
                                            "behorend tot of betrekking hebben op het gelijknamige volk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b7fc313-b4cf-4bae-97aa-aaf22582118d",
                                                "sense_id": "2ebb60d1-81be-3ace-9779-321924e178a2",
                                                "text": "Een Rohingya vrouw wil een schadevergoeding ter waarde van twee miljoen dollar (1,65 miljoen euro) van de regering van Myanmar voor de dood van haar man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61f68c83-b58b-39a3-bc22-1828f5ccd6e4",
                                        "entry_id": "b47b97af-e50f-3be2-947f-153a5e38a52e",
                                        "glosses": [
                                            "behorend tot of betrekking hebben op de gelijknamige taal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c94ecc4-fcd9-4aa7-aa4e-3fa970b623e4",
                                                "sense_id": "61f68c83-b58b-39a3-bc22-1828f5ccd6e4",
                                                "text": "U bevestigde hierbij echter de vaststelling van de Rohingya tolk, met name dat uw kennis van uw beweerde moedertaal onbestaande is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
