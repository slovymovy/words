                        "glosses": [
                            "Absence de morale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a11df0a-7d1b-4f79-9b60-028462988832",
                                "sense_id": "3adca9c7-a580-37a6-a838-8211af394609",
                                "text": "Cette maxime caustique est entrée dans l’histoire d’une antimorale des nations : elle annonce et reflète assez bien un certain « esprit » de la guerre froide."
                            },
                            {
                                "example_id": "cc4d2316-67af-4198-9acc-84bcf7ceed14",
                                "sense_id": "3adca9c7-a580-37a6-a838-8211af394609",
                                "text": "Le sport, c'est l’anti-morale absolue, la machine increvable à tout justifier, le point aveugle de la société."
                            },
                            {
                                "example_id": "85667487-1ebd-4d46-ad21-99875861c568",
                                "sense_id": "3adca9c7-a580-37a6-a838-8211af394609",
                                "text": "Pour flétrir les milieux polit. corrompus, Gay [l’auteur du Beggar’s Opera, l’Opéra du gueux, 1728] expose avec bonhomie l’antimorale de la pègre : il faut voler, tuer, se prostituer, préférer l'or à l'amour."
                            }
                        ]
                    }
