                        "examples": [
                            {
                                "example_id": "373d2484-86ee-49a1-a162-474dcf01ca9d",
                                "sense_id": "080a1ae6-1822-3881-a621-cadf604be848",
                                "text": "Naarmate het front u nadert wordt de warmere luchtlaag boven de bij u nog steeds aanwezige koude lucht steeds dikker en krijgt deze gaandeweg meer invloed op het weer. De vochtigheid neemt toe en de windveren breiden zich verder uit en verdichten zich geleidelijk tot een vrijwel gesloten maar nog steeds doorzichtige wolkenlaag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1a7b31d-1bf9-45e9-8234-ecc318ac2577",
                        "source_entry_id": "62f7d422-e50c-3661-98a2-03c6d25c0ef7",
                        "source_sense_id": "080a1ae6-1822-3881-a621-cadf604be848",
                        "source_sense_description": "aaneengesloten bewolking over de gehele hemel",
                        "target_lang_word": "Wolkendecke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wolkendecke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb491718-f8d2-3df1-91c7-30f1715f66e7",
                                        "entry_id": "a059e5f4-0b69-3aff-b264-26f770118bae",
                                        "glosses": [
                                            "den Himmel ganz oder wenigstens überwiegend bedeckende Bewölkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "940ead2e-32e9-4fa6-bde7-262fd53ab96d",
                                                "sense_id": "eb491718-f8d2-3df1-91c7-30f1715f66e7",
                                                "text": "„Die Wolkendecke senkte sich immer tiefer auf die Stadt herab.“"
                                            },
                                            {
                                                "example_id": "87d427b0-17bd-4f24-b8a0-028f8451d18f",
                                                "sense_id": "eb491718-f8d2-3df1-91c7-30f1715f66e7",
                                                "text": "„Vor dem großen Glasfenster liegen die Hausdächer Brooklyns unter einer dichten Wolkendecke.“"
                                            },
                                            {
                                                "example_id": "0f8f73ea-fed5-4bdb-8718-440df6815cbb",
                                                "sense_id": "eb491718-f8d2-3df1-91c7-30f1715f66e7",
                                                "text": "„Kaum ein Auto war unterwegs und der Himmel über uns aufgeklart, die Wolkendecke aufgerissen.“"
                                            },
                                            {
                                                "example_id": "95759687-794e-4d51-92cf-89c09764fcfc",
                                                "sense_id": "eb491718-f8d2-3df1-91c7-30f1715f66e7",
                                                "text": "„Sterne waren nicht zu sehen, denn die Wolkendecke hing tief und die Straßenlaternen leuchteten zu hell.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "360d86a9-c8f0-4d90-b077-eaadc9473aad",
                        "source_entry_id": "62f7d422-e50c-3661-98a2-03c6d25c0ef7",
                        "source_sense_id": "080a1ae6-1822-3881-a621-cadf604be848",
