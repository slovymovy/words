                    {
                        "sense_id": "772d3338-169c-320f-9955-1da88d941987",
                        "entry_id": "d5cf579a-29b3-3b95-aca6-9f3488960e18",
                        "glosses": [
                            "Pfeife aus Ton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f780758-ff4a-40ad-96a9-74cce76a2e5e",
                                "sense_id": "772d3338-169c-320f-9955-1da88d941987",
                                "text": "„Diesmal gab's auch Schokoladenzigaretten, bei denen man nicht wußte, ob man das Papier mitessen konnte, und einen großen Stutenkerl mit weißer Tonpfeife.“"
                            },
                            {
                                "example_id": "329cb89d-4138-4485-9ec2-b6b0b995a5d0",
                                "sense_id": "772d3338-169c-320f-9955-1da88d941987",
                                "text": "„Sie sah, dass seine Tonpfeife glühte, und als sie an ihm vorbei war, spürte sie deutlich seinen forschen Blick im Nacken.“"
                            },
                            {
                                "example_id": "ae2a5d59-8274-4dee-b150-ba16b1f8d926",
                                "sense_id": "772d3338-169c-320f-9955-1da88d941987",
                                "text": "„Vor der Zeltöffnung, auf einem Stein, saß ein Riese mit einer Tonpfeife im Mund.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
