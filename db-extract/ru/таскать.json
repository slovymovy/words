                "senses": [
                    {
                        "sense_id": "94024430-cbdc-35a7-814b-4598431f889f",
                        "entry_id": "ab4bd3c7-e39d-379f-8fae-a4e283890c1c",
                        "glosses": [
                            "to carry, to lug, to drag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e53e5c6f-4540-4a4e-8979-86665b3985a8",
                                "sense_id": "94024430-cbdc-35a7-814b-4598431f889f",
                                "text": "ежедне́вно таска́ть тяжёлые су́мки",
                                "translation": "to carry heavy bags every day",
                                "english": "to carry heavy bags every day"
                            },
                            {
                                "example_id": "bad397bf-2252-415c-9d3e-f5e3802e8d39",
                                "sense_id": "94024430-cbdc-35a7-814b-4598431f889f",
                                "text": "е́ле но́ги таска́ть",
                                "translation": "to be barely able to drag one's feet",
                                "english": "to be barely able to drag one's feet"
                            }
                        ]
                    },
                    {
                        "sense_id": "6d0351cb-348f-38dc-a04c-0a660a796389",
                        "entry_id": "ab4bd3c7-e39d-379f-8fae-a4e283890c1c",
                        "glosses": [
                            "to pull along, to drag along"
                        ],
                        "tags": [
                            "colloquial",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f41f99d8-2e90-4a93-985f-3531d1d67423",
                                "sense_id": "6d0351cb-348f-38dc-a04c-0a660a796389",
                                "text": "таска́ть кого́-либо всю́ду с собо́й",
                                "translation": "to take someone along everywhere",
                                "english": "to take someone along everywhere"
                            }
                        ]
                    },
                    {
                        "sense_id": "bb0171d7-010e-3dac-be36-a80c7a2140d3",
                        "entry_id": "ab4bd3c7-e39d-379f-8fae-a4e283890c1c",
                        "glosses": [
                            "to wear (clothes or shoes, long or carelessly)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f5139cae-106b-4a8b-8442-693080c5789e",
                                "sense_id": "bb0171d7-010e-3dac-be36-a80c7a2140d3",
                                "text": "не таска́й э́ти ту́фли в дождь",
                                "translation": "don't wear [put on] these shoes when it rains",
                                "english": "don't wear [put on] these shoes when it rains"
                            }
                        ]
                    },
                    {
                        "sense_id": "617195fe-c0ec-3d4d-a6af-978b4c467aab",
                        "entry_id": "ab4bd3c7-e39d-379f-8fae-a4e283890c1c",
                        "glosses": [
