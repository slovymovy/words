                                                "sense_id": "6566de30-b7ec-3a08-bc63-6ecaac855782",
                                                "text": "The axial asymmetry of Mercury's inertia ellipsoid may result in a torque that counterbalances the tidal torque"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9354e2e-6e94-31f7-8f73-68913a7d738f",
