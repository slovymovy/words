{
    "word_family": [
        "fork"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4a41dd34-b387-3a26-ba31-5613b7603bd7",
                    "sense_definition": "Splitting into two or more distinct directions or parts.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler reached a <w>forked</w> road and had to decide which path to take.",
                            "target_lang_translations": {
                                "pl": "Podróżny dotarł do <w>rozwidlenia</w> drogi i musiał zdecydować, którą ścieżkę wybrać."
                            }
                        },
                        {
                            "text": "The river has a <w>forked</w> channel that flows around the small island.",
                            "target_lang_translations": {
                                "pl": "Rzeka ma <w>rozwidlone</w> koryto, które opływa małą wyspę."
                            }
                        }
                    ],
                    "common_phrases": [
                        "forked road",
                        "forked path"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dzielący się na dwie lub więcej odrębnych części lub kierunków."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozwidlony",
                                "target_lang_sense_clarification": "odnoszące się do kształtu drogi lub rzeki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58f05579-5808-3e02-a8f1-ad4424bc9db9",
                    "sense_definition": "Having multiple prongs or divisions.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The statue held a large <w>forked</w> trident in its hand.",
                            "target_lang_translations": {
                                "pl": "Posąg trzymał w dłoni duży, <w>rozwidlony</w> trójząb."
                            }
                        },
                        {
                            "text": "The snake flicked its <w>forked</w> tongue rapidly in the air.",
                            "target_lang_translations": {
                                "pl": "Wąż szybko wysuwał swój <w>rozwidlony</w> język w powietrze."
                            }
                        }
                    ],
                    "synonyms": [
                        "forken"
                    ],
                    "common_phrases": [
                        "forked tongue"
                    ],
                    "target_lang_definitions": {
                        "pl": "Posiadający wiele zębów lub rozgałęzień."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozwidlony",
                                "target_lang_sense_clarification": "odnoszące się do kształtu przedmiotu lub części ciała"
                            },
                            {
                                "target_lang_word": "dwudzielny",
                                "target_lang_sense_clarification": "mający dwie części lub końce"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0cd3d9c-2ee7-3ee0-9d9f-f1c7b44082ae",
                    "sense_definition": "Simple past and past participle of <w>fork</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>forked</w> the hay into the back of the wagon.",
                            "target_lang_translations": {
                                "pl": "On <w>przerzucił</w> siano widłami na tył wozu."
                            }
                        },
                        {
                            "text": "She <w>forked</w> over the money to pay for the expensive dinner.",
                            "target_lang_translations": {
                                "pl": "Ona <w>wyłożyła</w> pieniądze, by zapłacić za drogi obiad."
                            }
                        }
                    ],
                    "common_phrases": [
                        "forked over"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Czas przeszły i imiesłów czasu przeszłego od czasownika 'fork' (używać wideł, płacić niechętnie)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przerzucił widłami",
                                "target_lang_sense_clarification": "w kontekście pracy z sianem"
                            },
                            {
                                "target_lang_word": "wyłożył",
                                "target_lang_sense_clarification": "w kontekście płacenia pieniędzy (często niechętnie)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}