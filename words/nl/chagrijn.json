{
    "word_family": [
        "chagrijnig",
        "chagrijnen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "977d136b-a5cd-3883-9b70-bab8d74143d9",
                    "sense_definition": "Een ontevreden, humeurige of geïrriteerde stemming.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stemming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een <w>chagrijn</w> hier overal, zeg.",
                            "target_lang_translations": {
                                "en": "What a <w>bad mood</w> everywhere here, I must say.",
                                "de": "Was für eine <w>schlechte Laune</w> hier überall herrscht, wirklich."
                            }
                        },
                        {
                            "text": "Zijn voortdurende <w>chagrijn</w> bedierf de sfeer tijdens het hele diner.",
                            "target_lang_translations": {
                                "en": "His constant <w>moodiness</w> ruined the atmosphere during the entire dinner.",
                                "de": "Seine ständige <w>Missstimmung</w> verdarb die Atmosphäre während des gesamten Abendessens."
                            }
                        }
                    ],
                    "synonyms": [
                        "humeurigheid",
                        "slecht humeur",
                        "ontevredenheid"
                    ],
                    "antonyms": [
                        "vrolijkheid",
                        "blijdschap"
                    ],
                    "common_phrases": [
                        "vol chagrijn"
                    ],
                    "target_lang_definitions": {
                        "en": "A dissatisfied, moody, or irritated mood.",
                        "de": "Eine unzufriedene, mürrische oder gereizte Stimmung; schlechte Laune."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bad mood",
                                "target_lang_sense_clarification": "state of mind"
                            },
                            {
                                "target_lang_word": "moodiness",
                                "target_lang_sense_clarification": "state of being irritable"
                            },
                            {
                                "target_lang_word": "irritation",
                                "target_lang_sense_clarification": "annoyance"
                            }
                        ],
                        "de": [
