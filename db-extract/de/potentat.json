                ],
                "senses": [
                    {
                        "sense_id": "e3b6ca25-c0b8-3ebc-97e2-f61af19a4df7",
                        "entry_id": "33352aba-5438-3816-8048-58c94860c817",
                        "glosses": [
                            "Person, die politische oder viel militärische Macht besitzt"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "57c7d550-ac30-4d86-b214-deb266c404a8",
                                "sense_id": "e3b6ca25-c0b8-3ebc-97e2-f61af19a4df7",
                                "text": "„Publius Cornelius Scipio kommandierte zwischen 211 und 201 v.Chr. ununterbrochen große Armeen, ähnlich wie Titus Quinctius Flamininus, der zwischen 198 und 183 v.Chr. maßgeblich Einfluss auf die römische Ostpolitik ausübte. Diese herausgehobenen Potentaten von ihrer Ausnahmestellung in das System der senatorischen Gleichheit zurückzuführen, sollte sich zu einem der größten Probleme der republikanischen Adelsgesellschaft entwickeln.“"
                            },
                            {
                                "example_id": "fc2baf7b-abc6-40e5-b84d-6d6f55d0702a",
                                "sense_id": "e3b6ca25-c0b8-3ebc-97e2-f61af19a4df7",
                                "text": "„Und nach dem Verbot des Sklavenhandels sind es vor allem einheimische Potentaten, die sich neue Geschäftsmodelle einfallen lassen, um mit den Europäern weiter Handel zu treiben.“"
                            },
                            {
                                "example_id": "2ea268c7-0989-4575-b3b1-cda3f98eac02",
                                "sense_id": "e3b6ca25-c0b8-3ebc-97e2-f61af19a4df7",
                                "text": "„Knapp hundert Jahre früher hätten wir uns hier nicht so frei bewegen können, denn der Khan von Baku war ein mächtiger Potentat.“"
                            },
                            {
                                "example_id": "95e6e9aa-492b-4311-8bf1-5ef7e0450e5d",
                                "sense_id": "e3b6ca25-c0b8-3ebc-97e2-f61af19a4df7",
                                "text": "„Zunächst aber schüttelten die lokalen Potentaten am Indus die griechische Herrschaft innerhalb weniger Jahre wieder ab; nur in Baktrien und im Kabultal konnten sich die Griechen halten.“"
                            },
                            {
                                "example_id": "d2831f9c-e272-47fc-86e3-7e1ee16dad1d",
                                "sense_id": "e3b6ca25-c0b8-3ebc-97e2-f61af19a4df7",
                                "text": "„Denn der Aufstieg des Seehandels zwischen Europa und Übersee bedingte den Rückgang des Überlandhandels entlang der Seidenstraße, was zur Folge hatte, dass die Safawiden und Moguln immer weniger Steuern einnahmen und die Stämme und lokalen Potentaten kaum noch bezahlen konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dc3f65e-e79c-42b8-bc72-fdb8a01441a1",
                        "source_entry_id": "33352aba-5438-3816-8048-58c94860c817",
                        "source_sense_id": "e3b6ca25-c0b8-3ebc-97e2-f61af19a4df7",
                        "source_sense_description": "bildungssprachlich: Person, die politische oder viel militärische Macht besitzt",
                        "target_lang_word": "potentate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "potentate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "280ebfa8-ecc8-372e-8c5a-02fe2c458063",
                                        "entry_id": "f3847b92-1177-3961-8167-ac7fe16c5da9",
                                        "glosses": [
                                            "A powerful leader; a monarch; a ruler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14e5610e-3e5a-4677-93f7-ef85e261c71a",
                                                "sense_id": "280ebfa8-ecc8-372e-8c5a-02fe2c458063",
                                                "text": "But Kings and mightieſt Potentates muſt die,\nFor that's the end of humane miſerie."
                                            },
                                            {
                                                "example_id": "6793baa4-5a27-4f33-8a89-db272b9aa169",
                                                "sense_id": "280ebfa8-ecc8-372e-8c5a-02fe2c458063",
                                                "text": "She was now one of a group of oriental beauties who, in the second act of the comic opera, were paraded by the vizier before the new potentate as the treasures of his harem."
                                            },
                                            {
                                                "example_id": "4f6ab288-0717-4c5c-9054-29d277f1d6ab",
                                                "sense_id": "280ebfa8-ecc8-372e-8c5a-02fe2c458063",
                                                "text": "Life for ordinary barons in Outremer Jerusalem was probably better than for kings in Europe, where even potentates wore unlaundered wool and lived in bare-stone draughty keeps with rough furniture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81feaab4-9769-39ee-bc2b-b6b53931e794",
                                        "entry_id": "f3847b92-1177-3961-8167-ac7fe16c5da9",
                                        "glosses": [
                                            "A powerful polity or institution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "860fe4f4-f463-35c9-9f6c-b826e3cf3918",
                                        "entry_id": "f3847b92-1177-3961-8167-ac7fe16c5da9",
                                        "glosses": [
                                            "A self-important person."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95709c64-8abf-3377-81f9-b101ac51c7c6",
                                        "entry_id": "f3847b92-1177-3961-8167-ac7fe16c5da9",
                                        "glosses": [
                                            "Someone acting in an important role."
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a56f11cb-667b-4718-a4fe-b7fd177f5c0b",
                                                "sense_id": "95709c64-8abf-3377-81f9-b101ac51c7c6",
                                                "text": "\"Those foreigners,\" thought the female potentate of the Sun, \"won't know what to order; but I'll show them what a good supper is.\""
                                            }
                                        ]
                                    }
                                ]
                            },
