                    {
                        "translation_id": "90f6dd79-889b-4ed1-b102-5aea79f4fb43",
                        "source_entry_id": "a1b05d20-3d37-32ef-a14a-29eed42772be",
                        "source_sense_id": "25fe1443-20f7-334e-bd94-6b720d9143ce",
                        "target_lang_word": "optics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "optics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "195eebbe-822d-3f1b-9200-6f5b0ddab350",
                                        "entry_id": "bbead9db-701b-3b95-994c-495f7b696ece",
                                        "glosses": [
                                            "The physics of light and vision: basic optical science."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08f8ef7e-e8b6-4b69-a509-1b3f100fb27f",
                                                "sense_id": "195eebbe-822d-3f1b-9200-6f5b0ddab350",
                                                "text": "a PhD in the optics of liquid crystals"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5058ea60-a93a-377c-9c96-97ea61a5fe7c",
                                        "entry_id": "bbead9db-701b-3b95-994c-495f7b696ece",
                                        "glosses": [
                                            "Technology that makes use of such physics: applied optical science; business lines making use of such technology."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69eca6bf-d07a-402a-b2d0-b8c8efc3f483",
                                                "sense_id": "5058ea60-a93a-377c-9c96-97ea61a5fe7c",
                                                "text": "defense R&D investments in both optics and electronics"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6fc070b-fb83-3dab-8f26-4deb02a607bb",
                                        "entry_id": "bbead9db-701b-3b95-994c-495f7b696ece",
                                        "glosses": [
                                            "The light-related aspects of a device."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65d0a551-2f46-4b1a-ab11-8b9bcac9a70f",
                                                "sense_id": "e6fc070b-fb83-3dab-8f26-4deb02a607bb",
                                                "text": "the optics of liquid crystals under certain laboratory conditions"
                                            },
                                            {
                                                "example_id": "bcd00a97-ed68-40f2-a8cb-5328b7ab6512",
                                                "sense_id": "e6fc070b-fb83-3dab-8f26-4deb02a607bb",
                                                "text": "The optics of this telescope are particularly good."
                                            },
                                            {
                                                "example_id": "53165fc5-33d9-44f3-85a0-8e42b701b2e4",
                                                "sense_id": "e6fc070b-fb83-3dab-8f26-4deb02a607bb",
                                                "text": "Digging deeper, the invention of eyeglasses is an elaboration of the more fundamental development of optics technology. The ability of a segment of a glass sphere to magnify whatever is placed before it was known around the year 1000, when the spherical segment was called a reading stone,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cbb6c99-cf1c-39a4-90b2-4d377d9d9da6",
                                        "entry_id": "bbead9db-701b-3b95-994c-495f7b696ece",
                                        "glosses": [
                                            "Perception, image, public relations, especially in politics."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d93ede5-3934-4334-9c7d-9ba727c44617",
                                                "sense_id": "6cbb6c99-cf1c-39a4-90b2-4d377d9d9da6",
                                                "text": "Near-synonyms: appearances, spectacle, theatrics; choreography"
                                            },
                                            {
                                                "example_id": "fe56060c-f41d-429c-9ba9-e953c81dbef8",
                                                "sense_id": "6cbb6c99-cf1c-39a4-90b2-4d377d9d9da6",
                                                "text": "His policy prescription was sound, but the optics of its discussion were horrible."
                                            },
                                            {
                                                "example_id": "5a21c092-7ecc-4794-902f-24c3c6596296",
                                                "sense_id": "6cbb6c99-cf1c-39a4-90b2-4d377d9d9da6",
                                                "text": "[…] I'd be interested to know whether US authorities proffered any \"advice\" on the optics: Ixnay on the torture dungeon, […]; if you have to have victims' loved ones present, go for the widows and photogenic orphans rather than Moqtada's boys."
                                            },
                                            {
                                                "example_id": "8c6e8934-75ac-4d4f-a52f-b6cd76397afb",
                                                "sense_id": "6cbb6c99-cf1c-39a4-90b2-4d377d9d9da6",
                                                "text": "When President Obama responded to the failed Christmas airliner bombing while on vacation in his native state of Hawaii, some Republicans claimed it was “bad optics.” “Hawaii to many Americans seems like a foreign place,” the Republican strategist Kevin Madden told CNN."
                                            },
                                            {
                                                "example_id": "f37fa35c-d5cb-47f4-9094-f99d1574d1db",
                                                "sense_id": "6cbb6c99-cf1c-39a4-90b2-4d377d9d9da6",
                                                "text": "\"There's also a gentle nod to the Vatican and Italy, which shows the Pope is not above playing a little optics - I'm sure he and the CEO of Fiat have met.\""
                                            },
                                            {
                                                "example_id": "32ca7605-d133-4580-b73b-97c60266435b",
                                                "sense_id": "6cbb6c99-cf1c-39a4-90b2-4d377d9d9da6",
                                                "text": "“The optics weren’t good. Next time tell them not to bring guns”"
                                            },
                                            {
                                                "example_id": "1b715c55-bb12-4861-b1e4-511a32968516",
                                                "sense_id": "6cbb6c99-cf1c-39a4-90b2-4d377d9d9da6",
                                                "text": "This is a trickier one for the king. The optics are bad: a disgraced prince living in the luxury of a huge crown estate property."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
