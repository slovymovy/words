                "senses": [
                    {
                        "sense_id": "1281ee0d-11de-391d-8ecb-ee4aba454aa1",
                        "entry_id": "7a70af9e-988c-30d6-93c6-2a7f00de87fd",
                        "glosses": [
                            "meist jung auf Arbeitssuche (vom Land) nach Berlin Zugewanderter"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "388873a9-2523-4966-9a6f-5fad3fe87dcc",
                                "sense_id": "1281ee0d-11de-391d-8ecb-ee4aba454aa1",
                                "text": "Rucksackberliner bleiben meist nicht nur wegen der Arbeit dauerhaft in Berlin."
                            },
                            {
                                "example_id": "0166d365-026e-4d6a-8ddc-8010467ed180",
                                "sense_id": "1281ee0d-11de-391d-8ecb-ee4aba454aa1",
                                "text": "Als typischer Rucksackberliner lebe ich schon lang in Berlin, bin hier aber nicht geboren."
                            },
                            {
                                "example_id": "b85c3ace-03bb-4078-a50f-ac2b544d6fa1",
                                "sense_id": "1281ee0d-11de-391d-8ecb-ee4aba454aa1",
                                "text": "«Ick dachte schon, du als Rucksackberliner weeßt janich, wo Köp'nick überhaupt liecht."
                            },
                            {
                                "example_id": "a221bb13-6baa-46e7-9e51-86cb2157bbcf",
                                "sense_id": "1281ee0d-11de-391d-8ecb-ee4aba454aa1",
                                "text": "Er war nach Berlin gezogen, fühlte sich dort schnell heimisch, wurde akzeptiert, wenn auch auf Grund seines norddeutschen Dialektes, nur als sogenannter „Rucksackberliner.“"
                            },
                            {
                                "example_id": "22d40c86-dda7-4cc3-a575-3269c2203155",
                                "sense_id": "1281ee0d-11de-391d-8ecb-ee4aba454aa1",
                                "text": "Viel öfter aber kommt im Alltag der „Rucksackberliner\" vor -jenes unstete Wanderwesen, das aus Not, aus Neugier oder aus Gründen des Broterwerbs an die Spree verschlagen wurde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
