                ],
                "senses": [
                    {
                        "sense_id": "1b54d2ee-1dad-347a-857c-c5697d1bd997",
                        "entry_id": "2d2e2fdc-83df-3a5e-a26d-c895b5dc7060",
                        "glosses": [
                            "Qui aboie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aec3ee93-4f9a-4949-b7e2-e2f9760bc7ea",
                                "sense_id": "1b54d2ee-1dad-347a-857c-c5697d1bd997",
                                "text": "Des chiens aboyants."
                            },
                            {
                                "example_id": "59b1375e-b658-457f-b686-f60767428b9a",
                                "sense_id": "1b54d2ee-1dad-347a-857c-c5697d1bd997",
                                "text": "Et je courais, je courais, comme si une meute aboyante de chiens m’eût poursuivi…"
                            },
                            {
                                "example_id": "7c08f8b1-5924-4c95-a544-059a3332c2a3",
                                "sense_id": "1b54d2ee-1dad-347a-857c-c5697d1bd997",
                                "text": "L’Asie et l’Afrique nous ont déjà donné un grand nombre de dieux. On a vu s’élever à Rome des temples en l’honneur d’Isis et de l’aboyant Anubis."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3d7b3a5-822e-3a34-8e87-7b990c38eec3",
                        "entry_id": "2d2e2fdc-83df-3a5e-a26d-c895b5dc7060",
                        "glosses": [
                            "Qui pousse des cris importuns, des injures, des invectives."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c3bedc02-4850-4510-bc1c-c6a9fb2cb284",
                                "sense_id": "e3d7b3a5-822e-3a34-8e87-7b990c38eec3",
                                "text": "Seuls, parmi les faces congestionnées et aboyantes, les huissiers gardaient la gravité impassible de leurs fonctions."
                            }
                        ]
                    }
                ],
