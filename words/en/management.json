{
    "word_family": [
        "manager",
        "managerial",
        "manageable",
        "mismanagement",
        "micromanagement",
        "unmanageable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b0aa5c50-32cf-3b8f-89b0-dba25241df2a",
                    "sense_definition": "The act or process of dealing with or controlling things or people, often involving planning and administration.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "process_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company needs better <w>management</w> to increase its profits.",
                            "target_lang_translations": {
                                "ru": "Компании требуется лучшее <w>управление</w>, чтобы увеличить прибыль.",
                                "zh": "这家公司需要更好的<w>管理</w>来增加利润。"
                            }
                        },
                        {
                            "text": "She is studying business <w>management</w> at the university.",
                            "target_lang_translations": {
                                "ru": "Она изучает <w>менеджмент</w> (управление бизнесом) в университете.",
                                "zh": "她正在大学里学习工商<w>管理</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mgmt",
                        "mgt"
                    ],
                    "common_phrases": [
                        "project management",
                        "risk management",
                        "business management"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс управления или контроля над вещами или людьми, часто включающий планирование и администрирование.",
                        "zh": "处理或控制事物或人员的行为或过程，通常涉及计划和行政工作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "управление",
                                "target_lang_sense_clarification": "процесс контроля и организации"
                            },
                            {
                                "target_lang_word": "менеджмент",
                                "target_lang_sense_clarification": "в контексте бизнеса"
                            },
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "действие по управлению"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "管理",
                                "target_lang_sense_clarification": "指组织、协调和控制的过程"
                            },
                            {
                                "target_lang_word": "经营",
                                "target_lang_sense_clarification": "侧重于商业运作和管理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9dcb20e-9c39-3caa-8c04-b79ff7d1a932",
                    "sense_definition": "The people in charge of running a company or organization, regarded collectively.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>management</w> has decided to hire more staff next month.",
                            "target_lang_translations": {
                                "ru": "<w>Руководство</w> решило нанять больше сотрудников в следующем месяце.",
                                "zh": "<w>管理层</w>已决定下个月招聘更多员工。"
                            }
                        },
                        {
                            "text": "He hopes to join the senior <w>management</w> team within a few years.",
                            "target_lang_translations": {
                                "ru": "Он надеется войти в состав высшего <w>руководства</w> в течение нескольких лет.",
                                "zh": "他希望在几年内加入高级<w>管理层</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "senior management",
                        "middle management",
                        "under new management"
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди, возглавляющие компанию или организацию, рассматриваемые как единое целое.",
                        "zh": "负责运营公司或组织的管理人员集体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "начальство, директорат"
                            },
                            {
                                "target_lang_word": "администрация",
                                "target_lang_sense_clarification": "управляющий орган"
                            },
                            {
                                "target_lang_word": "менеджмент",
                                "target_lang_sense_clarification": "руководящий состав"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "管理层",
                                "target_lang_sense_clarification": "指公司或组织的高层领导集体"
                            },
                            {
                                "target_lang_word": "领导",
                                "target_lang_sense_clarification": "指负责决策和指挥的人员"
                            },
                            {
                                "target_lang_word": "行政部门",
                                "target_lang_sense_clarification": "指负责日常运营的机构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "175cce2f-e1fe-3fbd-a841-d1f687b7467e",
                    "sense_definition": "The skill of organizing or using resources, such as time or money, effectively.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "process_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Good time <w>management</w> is essential for balancing work and life.",
                            "target_lang_translations": {
                                "ru": "Хорошее <w>управление</w> временем необходимо для баланса между работой и личной жизнью.",
                                "zh": "良好的时间<w>管理</w>对于平衡工作和生活至关重要。"
                            }
                        },
                        {
                            "text": "His financial <w>management</w> allowed him to retire early.",
                            "target_lang_translations": {
                                "ru": "Его грамотное <w>управление</w> финансами позволило ему рано выйти на пенсию.",
                                "zh": "他出色的财务<w>管理</w>使他能够提前退休。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "time management",
                        "anger management",
                        "money management"
                    ],
                    "target_lang_definitions": {
                        "ru": "Навык эффективной организации или использования ресурсов, таких как время или деньги.",
                        "zh": "有效组织或使用资源（如时间或金钱）的技能。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "управление",
                                "target_lang_sense_clarification": "распоряжение ресурсами"
                            },
                            {
                                "target_lang_word": "организация",
                                "target_lang_sense_clarification": "планирование использования"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "管理",
                                "target_lang_sense_clarification": "指对资源进行规划和调配"
                            },
                            {
                                "target_lang_word": "规划",
                                "target_lang_sense_clarification": "指对资源使用的安排"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "292818bb-34e8-309a-a0e2-2d5cacbd7133",
                    "sense_definition": "The prosecuting side in an impeachment trial.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>management</w> presented their case against the official to the senate.",
                            "target_lang_translations": {
                                "ru": "<w>Сторона обвинения</w> представила сенату свои доводы против чиновника.",
                                "zh": "<w>控方</w>向参议院提交了针对该官员的指控。"
                            }
                        },
                        {
                            "text": "Arguments from the <w>management</w> were heard throughout the afternoon.",
                            "target_lang_translations": {
                                "ru": "Аргументы <w>стороны обвинения</w> заслушивались в течение всего дня.",
                                "zh": "整个下午都在听取<w>控方</w>的辩论。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сторона обвинения в процессе по импичменту.",
                        "zh": "弹劾审判中的控方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сторона обвинения",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "представители обвинения",
                                "target_lang_sense_clarification": "в процессе импичмента"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "控方",
                                "target_lang_sense_clarification": "法律程序中的指控方"
                            },
                            {
                                "target_lang_word": "检控方",
                                "target_lang_sense_clarification": "负责提出指控的代表"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}