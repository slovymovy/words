                "senses": [
                    {
                        "sense_id": "10fc5ecd-6182-3e1d-ab3e-28dc24babe3e",
                        "entry_id": "ad841faa-589f-3399-b207-f066c23bdbf4",
                        "glosses": [
                            "Pousser son cri, en parlant de l’étourneau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8328ab8d-5742-4983-a21f-f73af9abd738",
                                "sense_id": "10fc5ecd-6182-3e1d-ab3e-28dc24babe3e",
                                "text": "Au faubourg Saint-Germain, parmi les frondaisons des quelques vieux parcs qui subsistent, on entend pisoter les étourneaux au plumage grivelé comme des peaux de saucisse."
                            },
                            {
                                "example_id": "dfbdf2ec-6bb4-45ca-b0a2-4bd832cd3a8f",
                                "sense_id": "10fc5ecd-6182-3e1d-ab3e-28dc24babe3e",
                                "text": "Je n’irai pas très loin pour vous citer quelqu’un […] qui, cherchant, par exemple dans les livres spéciaux, techniques, quel était le cri de tel ou tel oiseau, est arrivé, peu à peu, à les savoir tous par cœur, et pourrait vous réciter pendant une heure, sans arrêt, comme quoi les oiseaux frigottent, grisollent, pisottent, courcaillent, pioutent, titinnent, zinzilulent, etc., etc… ^([sic : etc.])"
                            },
                            {
                                "example_id": "c75e184b-308e-450d-a827-b663e09fc1f3",
                                "sense_id": "10fc5ecd-6182-3e1d-ab3e-28dc24babe3e",
                                "text": "À défaut de pisoter !"
                            },
                            {
                                "example_id": "21f08faf-f079-4bf3-8554-9675b932a466",
                                "sense_id": "10fc5ecd-6182-3e1d-ab3e-28dc24babe3e",
                                "text": "ça gromotte ça lolurote ça débagote ça asticote ça chipote ça tricote ça tripote ça tarabiscote ça margotte ça pisote ça frigulote ça fringote ça gringotte ça truisotte ça chuchote ça zoziotte…"
                            }
                        ]
                    }
                ],
