                                "target_senses": [
                                    {
                                        "sense_id": "5cb17633-dd9d-3e25-8e85-61d2a6a07722",
                                        "entry_id": "d8500dee-d827-3106-b69c-9d2d706dd65b",
                                        "glosses": [
                                            "Ancien billet de banque de cinq-cents francs français, sur lequel apparaît le portrait de Victor Hugo."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "997619a8-099c-496d-be6f-861738af8dd1",
                                                "sense_id": "5cb17633-dd9d-3e25-8e85-61d2a6a07722",
                                                "text": "« Cinq cents vieux francs, cria Marthe, tu te rends compte ? Elle m’a donné un Hugo, l’épicière."
                                            }
                                        ]
                                    }
                                ]
