                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "garantie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a oublié d'<w>assurer</w> sa nouvelle voiture avant de prendre la route."
                        },
                        {
                            "text": "La loi oblige chaque locataire à <w>assurer</w> son logement contre les incendies."
                        }
                    ],
                    "synonyms": [
