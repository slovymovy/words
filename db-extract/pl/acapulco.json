                                            {
                                                "example_id": "42b87dfb-c5b8-48bc-8c46-c1fe5fc4d4db",
                                                "sense_id": "769e84c6-8708-33f0-b572-9ed381d86552",
                                                "text": "In den nächsten Sommerferien fliegen wir nach Acapulco."
                                            },
                                            {
                                                "example_id": "4b242085-f682-4a84-8104-1520a36d0168",
                                                "sense_id": "769e84c6-8708-33f0-b572-9ed381d86552",
                                                "text": "Acapulco liegt circa 300 Kilometer südlich von Mexiko-Stadt an der Küste des Pazifischen Ozeans."
