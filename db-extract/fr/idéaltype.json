                    {
                        "sense_id": "e07289f3-ce82-3ae3-81c3-3ec556c50f0a",
                        "entry_id": "1cfde706-e2f1-3a4e-9767-fc24b456bbdd",
                        "glosses": [
                            "Type abstrait, catégorie, construit sans prétendre que les caractéristiques de ce type se retrouvent toujours et parfaitement dans les phénomènes observés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a61bd1e-6042-4f94-895d-56b482a772cb",
                                "sense_id": "e07289f3-ce82-3ae3-81c3-3ec556c50f0a",
                                "text": "Weber s’est appliqué à prévenir tout quiproquo concernant le sens de l’« idéalité » impliqué dans l’idéaltype."
                            },
                            {
                                "example_id": "28888c75-05f4-41d4-9c27-7309bdd4e748",
                                "sense_id": "e07289f3-ce82-3ae3-81c3-3ec556c50f0a",
                                "text": "La notion d’idéaltype est au cœur de la sociologie de Max Weber et ne se confond pas avec une simple typologie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b285b153-c9d6-46e7-9773-faf5dbc6a272",
                        "source_entry_id": "1cfde706-e2f1-3a4e-9767-fc24b456bbdd",
                        "source_sense_id": "e07289f3-ce82-3ae3-81c3-3ec556c50f0a",
