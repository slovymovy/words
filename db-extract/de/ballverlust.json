                                "example_id": "16907ea4-5483-4177-b507-2ea93056332b",
                                "sense_id": "41b1bc28-0ba5-3106-b96e-225fb0ba71e6",
                                "text": "„Ballgewinn der einen bedeutet gleichzeitig Ballverlust der anderen, Torerfolg der einen bedeutet Torhinnahme der anderen Mannschaft.“"
                            },
                            {
                                "example_id": "1fe4f714-ecac-4210-bd38-f04847c0687e",
                                "sense_id": "41b1bc28-0ba5-3106-b96e-225fb0ba71e6",
                                "text": "„Alle Spieler müssen genau wissen, wie sie sich im Moment des Ballgewinns und im Moment des Ballverlustes zu verhalten haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
