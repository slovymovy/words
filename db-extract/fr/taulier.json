                "senses": [
                    {
                        "sense_id": "ba7bd192-7b8b-3110-9840-baab9105ad28",
                        "entry_id": "86321201-8c75-3f70-b21e-9311120d9b01",
                        "glosses": [
                            "Patron, gérant d’un hôtel ou d’un restaurant."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f21ba2a2-15f6-4c6f-b9dd-068c23199b76",
                                "sense_id": "ba7bd192-7b8b-3110-9840-baab9105ad28",
                                "text": "Dans le verre: Le taulier donne à gouloter ce qu'il aime, soit 300 références de vins d'auteur et 14 jajas au verre (entre 5,5 et 12,50 euros les 12 cl)."
                            },
                            {
                                "example_id": "8c25a852-9eaa-4903-859d-24e0992e886b",
                                "sense_id": "ba7bd192-7b8b-3110-9840-baab9105ad28",
                                "text": "Nous partions à l’aube du refuge ou de l’auberge. Parfois le taulier nous avançait d’une dizaine de kilomètres jusqu’au versant à gravir."
                            }
                        ]
                    },
                    {
                        "sense_id": "042ad03f-9b2a-3236-a7b6-5249a650005b",
                        "entry_id": "86321201-8c75-3f70-b21e-9311120d9b01",
                        "glosses": [
                            "Patron d’une maison close, d’un lupanar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e01ea2f-0d25-4c0b-8cd6-565ad82de329",
                                "sense_id": "042ad03f-9b2a-3236-a7b6-5249a650005b",
                                "text": "J’ai été en maison, répondit Véra, jusqu’à ce que Cramoisi, mon second homme, m’en ait sortie pour m’affranchir des taules et des taulières."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2371d50-72ae-3931-8de6-6081d6aeeccf",
                        "entry_id": "86321201-8c75-3f70-b21e-9311120d9b01",
                        "glosses": [
                            "Patron en général (au sens propre comme au sens figuré)."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "76cb8f57-c109-48d7-9849-2c41ea94cbc1",
                                "sense_id": "e2371d50-72ae-3931-8de6-6081d6aeeccf",
                                "text": "Léodagan, roi de Carmélide — Mais Rome, maintenant, ça fait plus peur à personne !…\nCaius Camillus, centurion romain — Mais on a mis à genoux la moitié du monde, vous comme les autres.\nArthur, roi de Bretagne — À l’époque, peut-être…\nCaius Camillus — À l’époque ? Y a pas d’époque ! On domine, ok ?! C’est nous les tauliers !"
                            },
                            {
                                "example_id": "fb514504-6d5d-4718-9af7-866837003b7b",
                                "sense_id": "e2371d50-72ae-3931-8de6-6081d6aeeccf",
                                "text": "Le syndicat des tauliers a obtenu gain de cause."
                            }
                        ]
                    },
                    {
                        "sense_id": "02cda401-e40f-38f0-9d32-e4e6cb440f1f",
                        "entry_id": "86321201-8c75-3f70-b21e-9311120d9b01",
                        "glosses": [
                            "Commissaire de police."
