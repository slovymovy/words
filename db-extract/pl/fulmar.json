                        "sense_id": "cd05f6f3-83d8-3560-8796-70db5201db76",
                        "entry_id": "4d466ffd-79eb-3a40-96e6-0172b2b85b02",
                        "glosses": [
                            "Fulmarus Stephens, duży ptak morski z rodziny burzykowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "969fd3c8-bcf2-45de-ba7d-aff6c119a01a",
                                "sense_id": "cd05f6f3-83d8-3560-8796-70db5201db76",
                                "text": "Rozpiętość skrzydeł fulmarów wynosi 102–120 cm."
                            }
