                        "glosses": [
                            "(Spécialement) (Sémiotique) Catégorie piercienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "876e143f-99d0-40df-8a88-94a49ab856bc",
                                "sense_id": "7791342a-f56c-3d47-a85c-7a952d892444",
                                "text": "Pierce propose de réduire les catégories à trois catégories médiatrices qui assurent le passage de la Substance à l'Être : Premièreté, Deuxièmeté et Troisièmeté […] la Premièreté (qualité) peut être préscindée de la Deuxièmeté (relation), etc, ,"
                            }
                        ]
