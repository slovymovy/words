                                            "Troisième personne du singulier du passé simple de antifer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e859d4c-0b44-49d9-8984-d7fd9417e02b",
                        "source_entry_id": "9dbb8f74-1eed-37af-a657-ead0686251a0",
                        "source_sense_description": "anti-fascist movement",
