                    },
                    {
                        "form_id": "f7970aca-dcb0-4284-baa0-718677bd5371",
                        "entry_id": "028df903-822f-3663-bfea-57d6b7283ae3",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "végétaliennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "087ac219-d548-35ea-8d9d-293bf698b64f",
                        "entry_id": "028df903-822f-3663-bfea-57d6b7283ae3",
                        "glosses": [
                            "Qui est adepte du végétalisme, principe diététique et éthique recommandant l’usage alimentaire unique des végétaux et l’exclusion de la viande, du poisson et de tout produit d’origine animale."
                        ],
                        "tags": [
                            "Antispécisme"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d5615dc-6071-465d-8f75-4004814a8cd5",
                        "source_entry_id": "028df903-822f-3663-bfea-57d6b7283ae3",
                        "source_sense_id": "087ac219-d548-35ea-8d9d-293bf698b64f",
                        "target_lang_word": "vegan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vegan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ae72348-58fd-3626-943b-a6c8ab0a18aa",
                                        "entry_id": "d295c863-cc6e-3c7a-a06e-f781f3ba3116",
                                        "glosses": [
                                            "Not containing animal products (meat, eggs, milk, leather, etc) or inherently involving animal use."
                                        ],
                                        "tags": [
                                            "especially",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06da85db-3e53-41cf-931d-afc8b4bfb2d8",
                                                "sense_id": "8ae72348-58fd-3626-943b-a6c8ab0a18aa",
                                                "text": "He eats a completely vegan diet."
                                            },
                                            {
                                                "example_id": "359736f4-bee4-4d30-bdf3-703bcec8a849",
                                                "sense_id": "8ae72348-58fd-3626-943b-a6c8ab0a18aa",
                                                "text": "This chocolate cake is vegan."
                                            },
                                            {
                                                "example_id": "993db3d1-301d-485f-8c73-962d2b896053",
                                                "sense_id": "8ae72348-58fd-3626-943b-a6c8ab0a18aa",
                                                "text": "Is their way of eating healthy and safe? Doctors and nutritionists generally give an almost unqualified “yes” to lacto‐ovo vegetarianism, but express some doubts about vegan diets."
                                            },
                                            {
                                                "example_id": "e034fd1b-6008-4f79-93dd-2b8c34177239",
                                                "sense_id": "8ae72348-58fd-3626-943b-a6c8ab0a18aa",
                                                "text": "The interest of heavyweight investors is confirmation that vegan food has gone mainstream, but it could also make it harder for Oatly to maintain its anti-establishment image."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02e6bf75-0682-34fd-8fa3-158a41fc4113",
                                        "entry_id": "d295c863-cc6e-3c7a-a06e-f781f3ba3116",
                                        "glosses": [
                                            "Committed to avoiding any product or practice that inherently involves animal use."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1082e379-0752-4059-8894-e22a4477c026",
                                                "sense_id": "02e6bf75-0682-34fd-8fa3-158a41fc4113",
                                                "text": "She is not vegan as she eats eggs and wears leather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2d2c263-24a4-3bae-b4c6-55ea46647549",
                                        "entry_id": "d295c863-cc6e-3c7a-a06e-f781f3ba3116",
                                        "glosses": [
                                            "Relating to vegans or veganism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f0d7b4e-2ba0-47df-9e0c-0b84b10edd96",
                                                "sense_id": "e2d2c263-24a4-3bae-b4c6-55ea46647549",
                                                "text": "Yesterday I went to a vegan party."
                                            },
                                            {
                                                "example_id": "73506a2b-aa40-45c0-8302-39781c7d3b8d",
                                                "sense_id": "e2d2c263-24a4-3bae-b4c6-55ea46647549",
                                                "text": "She is interested in vegan philosophy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vegan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b4ea755-0ddd-3287-a870-83d9ae230a94",
                                        "entry_id": "5e874ab1-8a90-3542-a678-585b4639a604",
                                        "glosses": [
                                            "A person who does not eat, drink or otherwise consume any animal products"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5bf9b706-1331-327f-b1d5-39d007ff6996",
                                        "entry_id": "5e874ab1-8a90-3542-a678-585b4639a604",
                                        "glosses": [
                                            "A person committed to avoiding products and practices that inherently involve animal use, including all foods containing animal products, and to abstaining from direct and intentional harm to animals as far as possible; an adherent to veganism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29a12dfc-9470-4d85-aa40-a25f184efdbb",
                                                "sense_id": "5bf9b706-1331-327f-b1d5-39d007ff6996",
                                                "text": "Our vegan-friendly shaving brush is made with synthetic bristles instead of badger hair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
