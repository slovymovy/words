                "senses": [
                    {
                        "sense_id": "f6229dba-e1e0-30da-9c1c-29fccdfb06e8",
                        "entry_id": "f836b41e-3935-3ede-a0eb-3fe4d3b4f7a9",
                        "glosses": [
                            "зоол. вид китов из семейства полосатиковых"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2622473d-c113-4e5b-a151-e5d2aff1f517",
                                "sense_id": "f6229dba-e1e0-30da-9c1c-29fccdfb06e8",
                                "text": "На Дальнем Востоке существует промысел сельдяного кита — финвала."
                            },
                            {
                                "example_id": "9df03a2a-0345-4d6f-b419-a41275b90360",
                                "sense_id": "f6229dba-e1e0-30da-9c1c-29fccdfb06e8",
                                "text": "Горбач, так же как финвал, сейвал и самый гигантский представитель морских млекопитающих — блювал, относится к семейству полосатых китов."
                            }
                        ]
                    }
                ],
