                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>dilapidate</w> his entire family inheritance on reckless investments."
                        },
                        {
                            "text": "Corrupt administrators continued to <w>dilapidate</w> the town's precious financial reserves."
                        }
                    ],
                    "synonyms": [
                        "squander",
                        "waste"
                    ],
                    "antonyms": [
                        "conserve",
                        "save"
                    ],
                    "common_phrases": [
