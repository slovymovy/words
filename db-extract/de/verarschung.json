                                        "sense_id": "59037981-ffcb-3d13-be83-457ba2743355",
                                        "entry_id": "fbf47795-96c9-3cde-a8fe-f86911553ff9",
                                        "glosses": [
                                            "Offre commerciale disproportionnée ou inéquitable, à l'avantage majoritaire du vendeur."
                                        ],
