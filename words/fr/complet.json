                    ]
                },
                {
                    "sense_id": "23c0407e-4a11-33cc-bad6-ef34d32db9d3",
                    "sense_definition": "Totalité des membres d'un groupe ou d'un effectif, presque toujours employé dans la locution « au complet ».",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "totalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe de recherche est désormais au <w>complet</w> pour commencer les expériences prévues."
                        },
                        {
                            "text": "La famille était réunie au <w>complet</w> autour d'un grand dîner pour célébrer cet anniversaire."
                        }
                    ],
                    "common_phrases": [
