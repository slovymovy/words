                    {
                        "translation_id": "05d78de6-6e41-4459-ae0d-4eee32713993",
                        "source_entry_id": "ae4dc4ec-99ad-35e8-a701-c7419f82e8a8",
                        "source_sense_description": "psychology",
                        "target_lang_word": "Verdrängung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verdrängung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9bedeb1-f6a3-362b-8a68-42541ed3b833",
                                        "entry_id": "61fea4a1-be71-3889-987f-a06d28e68d85",
                                        "glosses": [
                                            "Vertreibung von Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92ddb1af-2bbd-4c65-a0fd-9636eb67c0fd",
                                                "sense_id": "e9bedeb1-f6a3-362b-8a68-42541ed3b833",
                                                "text": "Neue Nationalparks führen oft zur Verdrängung von Menschen, die seit Generationen dort gelebt haben."
                                            },
                                            {
                                                "example_id": "f6b2144e-0407-4aca-8adf-3ef65467e81a",
                                                "sense_id": "e9bedeb1-f6a3-362b-8a68-42541ed3b833",
                                                "text": "Die Näherei, die sich die Miete nicht mehr leisten kann, oder der Blumenladen, der der zigsten Kneipe weichen muss: In Berlin wehren sich immer wieder Bürgerinitiativen gegen Verdrängung durch steigende Mieten."
                                            },
                                            {
                                                "example_id": "7b029b70-4aec-4a44-a3e0-53c367130d1e",
                                                "sense_id": "e9bedeb1-f6a3-362b-8a68-42541ed3b833",
                                                "text": "Der Deutsche Gewerkschaftsbund hat eindringlich vor einer Verdrängung von Arbeitnehmern aus den Städten gewarnt."
                                            },
                                            {
                                                "example_id": "250a39be-7ddf-4bed-aedd-537ef28515ab",
                                                "sense_id": "e9bedeb1-f6a3-362b-8a68-42541ed3b833",
                                                "text": "Die rot-rot-grüne Berliner Landesregierung hat in ihrem Koalitionsvertrag festgelegt, die Verdrängung von Mietern stoppen zu wollen…"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c77f22c6-caf8-31db-b90e-8433f86d38c8",
                                        "entry_id": "61fea4a1-be71-3889-987f-a06d28e68d85",
                                        "glosses": [
                                            "etwas Unangenehmes nicht wahrhaben wollen, ausblenden oder ignorieren"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26cd320f-3d16-4c6e-91b0-a5f8470546fa",
                                                "sense_id": "c77f22c6-caf8-31db-b90e-8433f86d38c8",
                                                "text": "Die Verdrängung des eigenen Todes ist bei uns üblich."
                                            },
                                            {
                                                "example_id": "c6520e34-940c-44af-83dd-1b7a9364da13",
                                                "sense_id": "c77f22c6-caf8-31db-b90e-8433f86d38c8",
                                                "text": "Allerheiligen ist ein schwieriges Fest, das die Verdrängung des Todes empfindlich stört."
                                            },
                                            {
                                                "example_id": "a8c685f2-ecb8-4513-a175-9abaf47d47c9",
                                                "sense_id": "c77f22c6-caf8-31db-b90e-8433f86d38c8",
                                                "text": "Die Psychoanalytikerin Margarete Mitscherlich wurde zusammen mit ihrem Mann Alexander berühmt durch ihr Buch \"Die Unfähigkeit zu trauern\", worin sie die Verdrängung der Nazi-Zeit in den 50er Jahren analysierten."
                                            },
                                            {
                                                "example_id": "e927a879-2292-4e75-b0b3-642882fe9454",
                                                "sense_id": "c77f22c6-caf8-31db-b90e-8433f86d38c8",
                                                "text": "„Erst diese kollektive Verdrängung ermöglichte das ersehnte Zurück in die Normalität.“"
                                            },
                                            {
                                                "example_id": "2a34b85b-9602-4d48-a5b3-207d96dc389d",
                                                "sense_id": "c77f22c6-caf8-31db-b90e-8433f86d38c8",
                                                "text": "„Es gibt einen Angestelltenwitz, der zudem noch Freuds Theorie der Verdrängung und der Fehlleistung spiegelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4b856fe9-ec11-3b4f-910c-21a1b6874fde",
                                        "entry_id": "61fea4a1-be71-3889-987f-a06d28e68d85",
                                        "glosses": [
                                            "das Beiseiteschieben von Flüssigkeiten durch in sie eingetauchte feste Körper, insbesondere bei Schiffen in Wasser"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c9c5ea5-13c8-4b85-b504-6c9a31fcaa94",
                                                "sense_id": "4b856fe9-ec11-3b4f-910c-21a1b6874fde",
                                                "text": "Die Verdrängung des Schiffes beträgt 7 Tonnen."
                                            },
                                            {
                                                "example_id": "937ae416-2770-4c6e-be65-1c52c1de489d",
                                                "sense_id": "4b856fe9-ec11-3b4f-910c-21a1b6874fde",
                                                "text": "Die Forderung nach Kentersicherheit wird mit einiger Verlässlichkeit nur erfüllt, wenn der Kielballast minsestens 25% des Gesamtgewichts - auch als Verdrängung oder Deplacement bezeichnet - beträgt."
                                            },
                                            {
                                                "example_id": "ceb23f13-11f6-47fa-b60a-15c74749d991",
                                                "sense_id": "4b856fe9-ec11-3b4f-910c-21a1b6874fde",
                                                "text": "Die Segeltragzahl ist eine dimensionslose Kennzahl für Segelschiffe, die die Segelfläche ins Verhältnis zur Verdrängung setzt."
                                            },
                                            {
                                                "example_id": "31e1da7a-4bb3-4fa8-ac7e-8e93737fd882",
                                                "sense_id": "4b856fe9-ec11-3b4f-910c-21a1b6874fde",
                                                "text": "Kein Atomantrieb, aber 50.000 Tonnen Verdrängung: Chinas neues Kriegsschiff soll mit Kampfflugzeugen vom Typ J-15 ausgerüstet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a44918f5-3c9b-32fc-93f1-f4ca017e9ed1",
                                        "entry_id": "61fea4a1-be71-3889-987f-a06d28e68d85",
                                        "glosses": [
                                            "die Stelle von etwas anderem einnehmen, die Funktion von etwas anderem übernehmen, besonders durch etwas, was neuer oder besser ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2919665-f49a-4e23-a963-b562302f5332",
                                                "sense_id": "a44918f5-3c9b-32fc-93f1-f4ca017e9ed1",
                                                "text": "Die Verdrängung der Dampfmaschine durch Verbrennungsmotoren erfolgte Anfang des 20. Jahrhunderts."
                                            },
                                            {
                                                "example_id": "c14ad9a7-eaa7-42c9-9e21-8b71ec588296",
                                                "sense_id": "a44918f5-3c9b-32fc-93f1-f4ca017e9ed1",
                                                "text": "Die Verdrängung normaler Jobs durch solche mit befristeten Verträgen oder gar durch Leiharbeitskräften ist in Deutschland eine Tatsache."
                                            },
                                            {
                                                "example_id": "0bf20345-a517-4407-9394-11c5a6851c26",
                                                "sense_id": "a44918f5-3c9b-32fc-93f1-f4ca017e9ed1",
                                                "text": "Neben der Gefährdung der Biodiversität durch Verdrängung und Auslöschung nativer Arten kann auch das Ökosystem als Ganzes betroffen sein: Durch den Wegfall der ausgerotteten Arten gerät das ökologische Gleichgewicht häufig aus dem Lot."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
