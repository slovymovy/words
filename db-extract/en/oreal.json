                                "example_id": "e5101224-6f89-486d-9d8d-19599d4004ba",
                                "sense_id": "49c03bb1-15ce-3be4-bbac-d214e42a2fe5",
                                "text": "Another group with a high incidence of wing reduction in the female sex is that of the oreal species, i.e. species that inhabit high mountains above the tree line."
                            }
