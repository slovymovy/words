                    },
                    {
                        "translation_id": "47504515-5b61-4d78-bed1-fd6070c14fc1",
                        "source_entry_id": "249ef568-4df9-3a16-8a2e-460123f0dedc",
                        "source_sense_description": "small sponge cake",
                        "target_lang_word": "Biskotte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biskotte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca2301c7-fc6e-32ce-ba8d-5534a11ddfda",
                                        "entry_id": "0ed149a2-dbd5-3f1c-b427-ba137e0f0c9a",
                                        "glosses": [
                                            "Löffelbiskuit"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8554bf70-d2df-433b-81c3-ea64360c2d71",
                                                "sense_id": "ca2301c7-fc6e-32ce-ba8d-5534a11ddfda",
                                                "text": "„Tiramisu besteht aus abwechselnden Schichten Biskotten und einer Creme aus Mascarpone, Zucker und Eiern. Die Biskotten werden mit kaltem Espresso beträufelt, der mit Marsala oder Amaretto aromatisiert wird.“"
                                            },
                                            {
                                                "example_id": "a2611cb5-69f2-4cac-b9f7-f9e529a2998d",
                                                "sense_id": "ca2301c7-fc6e-32ce-ba8d-5534a11ddfda",
                                                "text": "„Mit einer Schicht getränkter Biskotten abdecken.“"
                                            },
                                            {
                                                "example_id": "a17fceae-212c-4de1-8efd-d67c3a6aba45",
                                                "sense_id": "ca2301c7-fc6e-32ce-ba8d-5534a11ddfda",
                                                "text": "„Eine Springform bereitstellen, die Biskotten nacheinander in mit etwas Rum vermengter Milch kurz wenden und den Boden der Form damit auslegen.“"
                                            },
                                            {
                                                "example_id": "c1ad2dcf-1339-4369-bfff-75bbb2c07c0c",
                                                "sense_id": "ca2301c7-fc6e-32ce-ba8d-5534a11ddfda",
                                                "text": "„Abgesehen davon, dass ebenjene Torte eine der leckersten Sünden wider die gesunde Ernährung, einen Traum aus Margarinecreme, Zucker und Biskotten, ist es für mich faszinierend, dass man einfach so eine neue Torte oder irgendeine andere Speise erfinden kann.“"
                                            },
                                            {
                                                "example_id": "13a7fa1b-5a4c-4931-b24d-7d3706125fe6",
                                                "sense_id": "ca2301c7-fc6e-32ce-ba8d-5534a11ddfda",
                                                "text": "„Nach den Richtlinien des ÖLMB3, Kapitel B 18, Abs 68, müssen Biskotten bei der Herstellung einen Volleianteil von mindestens 2/3 (66,6 %) des Gewichtes an Mahlprodukten und Stärke aufweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
