                "senses": [
                    {
                        "sense_id": "31f21c36-496e-34f5-a5cb-a8d77a9fc895",
                        "entry_id": "b95b1c29-f073-3bf5-8114-5728e1ddf263",
                        "glosses": [
                            "To surround with a pincer attack."
                        ],
                        "tags": [
                            "figuratively",
                            "sometimes",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "adfaf232-ebb7-453d-90f5-c8c19c186fd0",
                                "sense_id": "31f21c36-496e-34f5-a5cb-a8d77a9fc895",
                                "text": "After considering all frontal counteroffensive alternatives, Heublein rejected them as detrimental to its profits and came up with a brilliant pincering maneuver. It raised the price of Smirnoff by one dollar, effectively preventing segment diffusion, […]"
                            },
                            {
                                "example_id": "19fb0b9f-df01-46c6-b48a-726646d0147d",
                                "sense_id": "31f21c36-496e-34f5-a5cb-a8d77a9fc895",
                                "text": "The minesweeper and the sea tug now came along either side, pincered the Vega, and seemed to be ushering it toward Moruroa, perhaps attempting to push the ketch inside the 12-mile limit."
                            }
                        ]
                    }
                ],
