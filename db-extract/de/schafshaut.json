                    {
                        "sense_id": "80e1a569-7ecb-3d8b-8c4d-d96d9e85c283",
                        "entry_id": "b89b3923-129b-3c7f-8850-99dff6873924",
                        "glosses": [
                            "die Haut eines Schafes"
                        ],
                        "tags": [
                            "eigentlich"
                        ],
                        "examples": [
                            {
                                "example_id": "1e68f390-8a11-4a9f-99ae-e6995814a17c",
                                "sense_id": "80e1a569-7ecb-3d8b-8c4d-d96d9e85c283",
                                "text": "„Ein in einer Schafshaut gekleideter Wolf mischte sich unter die Herde und tötete jeden Tag ein Schaf. Als dies der Hirt bemerkte, knüpfte er den Wolf an einem hohen Baum auf. Auf die Frage der anderen Hirten, warum er denn ein Schaf gehängt habe, antwortete er: Die Haut ist die eines Schafes, aber die Taten waren die eines Wolfes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7c861a21-9a45-31e3-8c81-303b3ef6568e",
                        "entry_id": "b89b3923-129b-3c7f-8850-99dff6873924",
                        "glosses": [
                            "das Amnion (innerste Embryonalhülle der höheren Wirbeltiere, die gefäßlos und durchsichtig ist)"
                        ],
                        "tags": [
                            "Embryologie"
                        ],
                        "examples": [
                            {
                                "example_id": "2555a459-342c-4f1b-87b7-b64d5cf4683a",
                                "sense_id": "7c861a21-9a45-31e3-8c81-303b3ef6568e",
                                "text": "„Die äußere Haut geht am Rand der Körperspalte in die Schafshaut (Amnion) über.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
