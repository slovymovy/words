                                        "glosses": [
                                            "die Oberfläche eines Gegenstandes oder einer Sache betreffend, sich auf die Oberfläche beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f84e5dcd-4d33-4478-b6d6-0558a64e36bf",
                                                "sense_id": "2a989871-b9b5-3b29-8602-fc8123c87269",
                                                "text": "Die Berge waren oberflächlich von Schnee bedeckt."
                                            },
                                            {
                                                "example_id": "75e4c17a-e881-442b-879f-497f0f1759cf",
                                                "sense_id": "2a989871-b9b5-3b29-8602-fc8123c87269",
                                                "text": "Aus Krampfadern kann eine oberflächliche Venenentzündung entstehen."
                                            }
