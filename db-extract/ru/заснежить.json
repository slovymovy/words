                ],
                "senses": [
                    {
                        "sense_id": "8519ca51-aa89-32ca-a02b-f69aa2147b89",
                        "entry_id": "68920509-97b5-39cf-b157-a17fc3c85cf5",
                        "glosses": [
                            "покрыть снегом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bfbea8d-d3e8-4c1c-8b12-14724c97c384",
                                "sense_id": "8519ca51-aa89-32ca-a02b-f69aa2147b89",
                                "text": "У нас уже всё заснежило, зима."
                            },
                            {
                                "example_id": "e8cc7061-7681-4139-b398-afae0c872e2b",
                                "sense_id": "8519ca51-aa89-32ca-a02b-f69aa2147b89",
                                "text": "Снег шёл непрерывно неделю и выпал в огромном количестве. Заснежило все кусты и деревья, ходить по тайге стало невероятно трудно."
                            },
                            {
                                "example_id": "79861dd8-8e15-4db5-925b-f02c703dbabc",
                                "sense_id": "8519ca51-aa89-32ca-a02b-f69aa2147b89",
                                "text": "Снег в этот день пройдёт лишь в северных городах республики. А вот во вторник заснежит не только север, но и центральную часть Молдовы."
                            }
                        ]
                    }
