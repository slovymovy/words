                                    {
                                        "sense_id": "910b48fc-bfed-3db7-af4f-b99113b9d879",
                                        "entry_id": "501b8375-c96e-3211-8523-c39b152f83ee",
                                        "glosses": [
                                            "Celui qui fabrique et vend du carton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0f42956-0384-4da4-a570-3e236f747585",
                                                "sense_id": "910b48fc-bfed-3db7-af4f-b99113b9d879",
                                                "text": "Lorsque le fabricant de cartons collés veut produire des cartons bien unis, il les soumet au lissoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a22db5b0-748e-3e88-a87f-fd4c0cb697f4",
                                        "entry_id": "501b8375-c96e-3211-8523-c39b152f83ee",
                                        "glosses": [
                                            "Celui qui fabrique et vend des cartons perforés destinés aux orgues de Barbarie et aux limonaires. On dit aussi noteur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fd4b11f-e030-35a7-9a32-4554850bd1ae",
                                        "entry_id": "501b8375-c96e-3211-8523-c39b152f83ee",
                                        "glosses": [
                                            "Meuble à compartiments où l’on place des cartons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e7f0b4a-e35d-4f82-9ce2-d6a979bf28c8",
                                                "sense_id": "2fd4b11f-e030-35a7-9a32-4554850bd1ae",
                                                "text": "Ce personnage était assis devant un grand bureau d’acajou, dans un cabinet vulgaire à tapis de feutre, chaises de cuir et larges cartonniers béants."
                                            },
                                            {
                                                "example_id": "18303dea-ac55-44dc-b154-053af4b4609b",
                                                "sense_id": "2fd4b11f-e030-35a7-9a32-4554850bd1ae",
                                                "text": "Son bureau, ou plutôt celui de Bendit, n’avait rien pour les dimensions ni l’ameublement du cabinet de M. Vulfran, qui avec ses trois fenêtres, ses tables, ses cartonniers, ses grands fauteuils en cuir vert, les plans des différentes usines accrochés aux murs dans des cadres en bois doré, était très imposant et bien fait pour donner une idée de l’importance des affaires qui s’y décidaient."
                                            },
                                            {
                                                "example_id": "98bea694-4cf6-42e8-ad5b-40fbca53dfd9",
                                                "sense_id": "2fd4b11f-e030-35a7-9a32-4554850bd1ae",
                                                "text": "Floche, qui est venu se poster devant le cartonnier. — Et ces cartons !… Ça n’a aucune utilité."
                                            }
                                        ]
                                    }
                                ]
                            },
