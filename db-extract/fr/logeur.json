                        "entry_id": "b3da98f1-518f-3778-ac58-f0ab927c4a19",
                        "glosses": [
                            "Celui qui loge moyennant finance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aed2de5-ce97-4cb4-a2f2-80c825950677",
                                "sense_id": "3e160af0-53d4-30d2-af63-e44ae3484270",
                                "text": "Logeur à la nuit."
                            },
                            {
                                "example_id": "7b9df010-d529-4214-9b47-b0a03e425144",
                                "sense_id": "3e160af0-53d4-30d2-af63-e44ae3484270",
                                "text": "[…] on disait qu’il avait lui-même, tout seul, les dimanches, monté sa bâtisse en trois ou quatre années et était ainsi devenu le logeur du pauvre monde."
                            }
                        ]
                    },
                    {
                        "sense_id": "edd82ad0-acdc-38bd-9339-773d1f966573",
                        "entry_id": "b3da98f1-518f-3778-ac58-f0ab927c4a19",
                        "glosses": [
                            "Celui qui tient des chambres en hôtel garni."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "146d3bc9-2f37-4bb6-81b9-582036deb4ba",
                                "sense_id": "edd82ad0-acdc-38bd-9339-773d1f966573",
                                "text": "Je remerciai et j’allai un peu plus loin chez Barrabaud ; celui-là, à la profession de logeur en garni joignait celle de fruitier."
                            },
                            {
                                "example_id": "ec03e581-e802-4092-ac82-90ef97c8e003",
                                "sense_id": "edd82ad0-acdc-38bd-9339-773d1f966573",
                                "text": "Vous habitiez une chambre d'hôtel assez misérable, […]. Vous ne parveniez pas toujours à régler votre logeur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "003e77f5-333a-4ce9-8fbd-0ba97c37a1cd",
                        "source_entry_id": "b3da98f1-518f-3778-ac58-f0ab927c4a19",
                        "target_lang_word": "landlord",
                        "target_lang_code": "en",
