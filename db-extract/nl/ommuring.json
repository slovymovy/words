                                "target_senses": [
                                    {
                                        "sense_id": "c48b6982-196d-321d-8b98-309ce7114b7d",
                                        "entry_id": "aa1fa46c-5638-39cf-ad79-58c2a20b8a50",
                                        "glosses": [
                                            "Pronunciation spelling of well."
                                        ],
                                        "tags": [
                                            "US",
                                            "alt-of",
                                            "pronunciation-spelling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9f3322c-3847-4526-88b6-9db265acb70d",
                                                "sense_id": "c48b6982-196d-321d-8b98-309ce7114b7d",
                                                "text": "Wall, they spoke up, 'n' says to her, s'd they, \"Why, look a-here, aunty, Wus't his skin, 't was rock?\" so s's she, \"I guess not.\" (Well, they spoke up and says to her, said they, \"Why look a-here, aunty, was it his skin that was rock [referring to the Apostle Peter]?\" So says she, \"I guess not.\")"
                                            },
                                            {
                                                "example_id": "d1929944-9883-453b-92ae-c78356cda6fb",
                                                "sense_id": "c48b6982-196d-321d-8b98-309ce7114b7d",
                                                "text": "Wall, be that as it may, ol' Hosshead was a purty good citizen in his day, an' he shore did make Juneybell toe the mark."
                                            }
                                        ]
                                    }
