                "senses": [
                    {
                        "sense_id": "9267f978-1e0f-3f6e-b3d2-439047343858",
                        "entry_id": "1e04b1cd-e420-3192-8720-b39eb5e47e5f",
                        "glosses": [
                            "Qui ressemble à un accordéon, ou qui concerne les accordéons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "495584da-228a-4d9b-b651-940de774bb0c",
                                "sense_id": "9267f978-1e0f-3f6e-b3d2-439047343858",
                                "text": "À titre d’exemple, nous consignons ci-dessous quelques-unes des attestations orales […] qui nous sont tombées sous les oreilles : […] une musique agressivement accordéonesque […]"
                            },
                            {
                                "example_id": "2ea4e661-14b6-40f0-b6af-148e6d228d81",
                                "sense_id": "9267f978-1e0f-3f6e-b3d2-439047343858",
                                "text": "Mais pour la musique, le vague reste toujours grand et notre muse, pourtant si sensible, se trouve tour à tour déguisée soit en fille de barrière pour présider quelque flonflon accordéonesque, ou encore, en moine intoxiqué […]"
                            },
                            {
                                "example_id": "b39ee6b8-4437-4865-9126-b8278aa2a1db",
                                "sense_id": "9267f978-1e0f-3f6e-b3d2-439047343858",
                                "text": "[…] il n’est pas pas moderne à la façon d’un Strauss qui, souvent, écrase l’idée mélodique sous de lourdes et innombrables ornementations, ni à la façon […] de l’accordéonesque Leoncavallo […]"
                            }
                        ]
                    }
