                "forms": [
                    {
                        "form_id": "2a6091b0-0584-430d-b2d8-2f02dfe6b54f",
                        "entry_id": "bb4af704-a138-3a83-aa26-40e4bcc74cb2",
                        "tags": [
                            "plural"
                        ],
                        "form": "écosophies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b890d28-2130-3458-8479-bb0eaac6c70e",
                        "entry_id": "bb4af704-a138-3a83-aa26-40e4bcc74cb2",
                        "glosses": [
                            "Théorie selon laquelle l’homme ne se situe pas au sommet de la hiérarchie des êtres vivants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff922f78-3e4c-44f9-985d-f71eee668d2b",
                                "sense_id": "3b890d28-2130-3458-8479-bb0eaac6c70e",
                                "text": "En 1989, dans Les trois écologies, Félix Guattari appelait écosophie l’articulation éthico-philosophique complexe « entre les trois registres écologiques, celui de l’environnement, celui des rapports sociaux et celui de la subjectivité humaine »."
                            },
                            {
                                "example_id": "2cc26357-2b9c-47c0-b070-ba17c2742e21",
                                "sense_id": "3b890d28-2130-3458-8479-bb0eaac6c70e",
                                "text": "Cette écosophie dont Guattari forge ici les premiers rudiments nait, sur le plan de l’histoire politique, avec l’émergence et le renforcement continu des partis écologistes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c09212a9-4575-4018-8023-d735ccb9a9ee",
                        "source_entry_id": "bb4af704-a138-3a83-aa26-40e4bcc74cb2",
                        "source_sense_id": "3b890d28-2130-3458-8479-bb0eaac6c70e",
                        "target_lang_word": "Ökosophie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8ea0d27a-e2d3-4d89-9fea-6b26faba47ef",
                        "source_entry_id": "bb4af704-a138-3a83-aa26-40e4bcc74cb2",
                        "source_sense_id": "3b890d28-2130-3458-8479-bb0eaac6c70e",
                        "target_lang_word": "ecosophy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ecosophy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28322a12-bbe4-3a05-8d44-85134d38fad3",
                                        "entry_id": "153b6cb2-2416-3bb5-80d9-65bc828a3574",
                                        "glosses": [
                                            "Ecological philosophy, particularly of the type associated with the deep ecology movement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7a8378c-c2f2-4d31-ae47-c3b037910a81",
                                                "sense_id": "28322a12-bbe4-3a05-8d44-85134d38fad3",
                                                "text": "[…] ecosophy argues that an individual should act in such a way as to “do as little harm as possible.” The “oath” of those committed to ecosophy closely parallels that of medical doctors: Above all else do no harm."
                                            },
                                            {
                                                "example_id": "b41f249a-95b5-43e1-b23e-dae6beae602f",
                                                "sense_id": "28322a12-bbe4-3a05-8d44-85134d38fad3",
                                                "text": "But Tompkins and his wife Kristine (former head of the Patagonia outdoor-clothing brand), claim to be committed to Deep Ecology, a radically conservationist, holistic \"ecosophy\" first articulated in the 1970s by Norwegian mountaineer-philosopher Arne Naess."
                                            },
                                            {
                                                "example_id": "a35a6c12-a34c-4c52-bc28-333d61346144",
                                                "sense_id": "28322a12-bbe4-3a05-8d44-85134d38fad3",
                                                "text": "His ideas on ecology and ecosophy were developed in numerous books and articles, notably “Freedom, Emotion and Self-Subsistence” (1975), “Ecology, Community and Lifestyle” (1989) and “Life’s Philosophy: Reason and Feeling in a Deeper World” (2002)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
