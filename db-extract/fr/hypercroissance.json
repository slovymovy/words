                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa3859bb-d6b4-4d06-97a6-115b3f553c03",
                                "sense_id": "51a861af-c218-3ed9-9d26-08b5e92862ab",
                                "text": "Quand on parle d’hypercroissance, on parle de plusieurs années de suite avec des croissances à plus de 100 %."
                            },
                            {
                                "example_id": "fee4e491-06da-45ab-b1b6-2422307d1c45",
                                "sense_id": "51a861af-c218-3ed9-9d26-08b5e92862ab",
                                "text": "Sur ces bases, les auteurs définissent trois grandes catégories : les villes en hypercroissance (hypergrowth cities), les villes dynamiques (dynamic cities) et les villes mûres (mature developed cities)."
                            },
                            {
                                "example_id": "000ee884-683a-4ddd-b254-8745e59e2a59",
                                "sense_id": "51a861af-c218-3ed9-9d26-08b5e92862ab",
                                "text": "Quand on rejoint une startup, on entre dans une organisation qui cherche l’hypercroissance."
                            }
                        ]
                    }
