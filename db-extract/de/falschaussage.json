                        "source_sense_description": "Rechtssprache: Aussage, die nicht der Wahrheit entspricht",
                        "target_lang_word": "faux témoignage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faux témoignage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d14f5c1-c1ba-345b-8654-f76574c5dc95",
                                        "entry_id": "ea9e6174-d596-3d80-bab0-3d766143526e",
                                        "glosses": [
                                            "Lors d'un procès, témoignage mensonger qui ne respecte pas le serment de vérité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1493527c-ef22-4c3f-b027-84e33ee6ff19",
                                                "sense_id": "4d14f5c1-c1ba-345b-8654-f76574c5dc95",
                                                "text": "Le faux témoignage constitue un délit."
                                            },
                                            {
                                                "example_id": "69522013-4103-4fee-aa45-8b07d16d0b61",
                                                "sense_id": "4d14f5c1-c1ba-345b-8654-f76574c5dc95",
                                                "text": "– Trop tard ! Vous avez témoigné en ma faveur ; vous ne pouvez plus vous déjuger. Vous seriez convaincu de faux témoignage…"
                                            },
                                            {
                                                "example_id": "a3d5f513-5d8f-4367-ad5d-f4237c94455d",
                                                "sense_id": "4d14f5c1-c1ba-345b-8654-f76574c5dc95",
                                                "text": "[Titre] La condamnation pour « faux témoignage » du pneumologue Michel Aubier confirmée en appel"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
