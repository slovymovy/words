                        "sense_id": "289706b4-ca03-3c70-a04e-706c6c75bc0f",
                        "entry_id": "f9d5c1a6-77c8-388a-8c11-6ddc2a9cfbf5",
                        "glosses": [
                            "eine Prozession, die an Fronleichnam stattfindet"
                        ],
                        "tags": [
                            "katholische Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "c5585f10-60df-4d58-8b3c-7dab51a5a868",
                                "sense_id": "289706b4-ca03-3c70-a04e-706c6c75bc0f",
                                "text": "Die Fronleichnamsprozession ist wieder eine große Bekundung des Glaubens gewesen."
                            },
                            {
                                "example_id": "7e3cc551-0718-472b-be81-45d9861a6fe5",
                                "sense_id": "289706b4-ca03-3c70-a04e-706c6c75bc0f",
                                "text": "„Ich sah dort das Tabernakel, in dem man bei der Fronleichnamsprozession das Heilige Sakrament trägt und das so schwer ist, daß dreißig Männer dafür nötig sind.“"
                            },
                            {
                                "example_id": "2b7af397-d7d8-4434-90ff-6c7aa1b1f705",
                                "sense_id": "289706b4-ca03-3c70-a04e-706c6c75bc0f",
                                "text": "„Bei der Fronleichnamsprozession war ich immer ganz vorne mit dabei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
