                        "glosses": [
                            "Tante."
                        ],
                        "tags": [
                            "childish"
                        ],
                        "examples": [
                            {
                                "example_id": "6d238e3f-7231-4cf1-8a06-c135254958b6",
                                "sense_id": "03fb715e-dda3-328c-9813-d35dec1edba9",
                                "text": "Tatan Georgette est la reine du gratin de courgettes."
                            },
                            {
                                "example_id": "bb1d9fa0-9a64-46d8-964c-6c38f541584a",
                                "sense_id": "03fb715e-dda3-328c-9813-d35dec1edba9",
                                "text": "Tatan elle fait des flans ! Et elle met du beurre au fond du plat pour pas que le gratin colle."
                            },
                            {
                                "example_id": "0a923ff4-ffd5-40a1-99dc-127cc895f607",
                                "sense_id": "03fb715e-dda3-328c-9813-d35dec1edba9",
                                "text": "Deux tantes du côté de ma mère, la tante Rosalie et la tatan Mariou. On appelle cette dernière tatan ; je ne sais pourquoi, parce qu’elle est plus caressante peut-être."
                            }
                        ]
                    }
                ],
