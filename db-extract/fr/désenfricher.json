                        "glosses": [
                            "Faire quitter l’état de friche à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bee7722-518a-461e-b7be-019b1c1f6585",
                                "sense_id": "df9b030a-2b03-3099-8c52-e924aaaa0d9a",
                                "text": "Bien accueillis par les communes et les particuliers, les moutons ont en effet le mérite de désenfricher les pâturages, en particulier de détruire les fougères — 450 moutons broutant autant qu’une centaine de bovins —, la sauvegarde des pâturages serait ainsi assurée, les espaces ouverts maintenus."
                            },
                            {
                                "example_id": "17c89645-3644-4bdd-80c4-51b79c54c969",
                                "sense_id": "df9b030a-2b03-3099-8c52-e924aaaa0d9a",
                                "text": "Une gestion adaptée permettra de le désenfricher et de recouvrer son originalité et la richesse floristique et faunistique qui font son intérêt."
                            },
                            {
                                "example_id": "46081ba2-d1c9-4417-abb8-b78f18d883f3",
                                "sense_id": "df9b030a-2b03-3099-8c52-e924aaaa0d9a",
                                "text": "La mesure de gestion prioritaire concerne les pelouses sur craie à désenfricher selon un calendrier précis et progressif."
                            }
                        ]
                    }
