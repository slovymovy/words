                        "sense_id": "02ba445d-0224-3760-b9c0-8621e8960f18",
                        "entry_id": "afb6d395-ec7b-3034-872b-431f81a6caa9",
                        "glosses": [
                            "Internaute utilisateur de l'application TikTok."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "b5cbdb16-d43a-4234-9ea9-fd5f154a3add",
                                "sense_id": "02ba445d-0224-3760-b9c0-8621e8960f18",
                                "text": "Les abonnés viennent me parler, me demander de faire une photo. Ils me disent de continuer à faire des vidéos », raconte le TikTokeur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1dbe8940-df9d-4d6f-b49b-6ead38f3343f",
                        "source_entry_id": "afb6d395-ec7b-3034-872b-431f81a6caa9",
                        "source_sense_id": "02ba445d-0224-3760-b9c0-8621e8960f18",
                        "target_lang_word": "TikToker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "TikToker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "232bf414-eb79-36ed-918f-6ecd5d732a8d",
                                        "entry_id": "dc2fd0eb-0d7e-3c4b-bba3-316ecdfb337e",
                                        "glosses": [
                                            "A user of the video-sharing app TikTok, especially one who creates videos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bf77b24-aedc-40fc-9dbe-9041bfb095de",
                                                "sense_id": "232bf414-eb79-36ed-918f-6ecd5d732a8d",
                                                "text": "“TikTok has brought a younger group of creators. That energy is kind of pushing on a lot of older creators,” said Josh Sadowski, 19, a TikToker with nearly four million followers who lived in another TikTok collab house."
                                            },
                                            {
                                                "example_id": "1b4b00b0-e680-4c99-87e1-fcfb251715c5",
                                                "sense_id": "232bf414-eb79-36ed-918f-6ecd5d732a8d",
                                                "text": "When a young TikToker called @idrinkurmilkshake winkingly identified herself as a member of the “Pfizer Gang,” she kicked off a joking rivalry that tore ebulliently through the internet."
                                            },
                                            {
                                                "example_id": "34060b8c-264e-4541-a458-3781293a71af",
                                                "sense_id": "232bf414-eb79-36ed-918f-6ecd5d732a8d",
                                                "text": "From arguing in the comments section over the best way to work your glutes to critiquing someone's deadlift skills, there's always some kind of disagreement brewing between gym-going TikTokers."
                                            },
                                            {
                                                "example_id": "8743945f-9aa1-4e7a-b5d3-bf92e51ebcd9",
                                                "sense_id": "232bf414-eb79-36ed-918f-6ecd5d732a8d",
                                                "text": "Here TikTokers are finding that they've failed the 'unspoken rizz' test with hilarious outcomes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
