                        "glosses": [
                            "Pauvre diable, personne ridicule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "113ae3fe-f5e1-4750-be7d-4cf78ac08053",
                                "sense_id": "6d89fda1-131b-3d0c-b1c2-8761e1bbb4e5",
                                "text": "C'était au temps où la France portait des hommes mâles et non des coquefredouilles embéguinés."
                            },
                            {
                                "example_id": "9784409b-d30c-4614-a32d-d4194210dfaa",
                                "sense_id": "6d89fda1-131b-3d0c-b1c2-8761e1bbb4e5",
                                "text": "Dans Xénophon, Hercule est ennuyeux, dans Aristophane, un coquefredouille."
                            },
                            {
                                "example_id": "f8225a70-a2d4-405e-9f29-154bba220c1f",
                                "sense_id": "6d89fda1-131b-3d0c-b1c2-8761e1bbb4e5",
                                "text": "Mais songez que demain, coquefredouilles ! […] vous ne serez plus, vieux Cocâtres qu’on casse, que des Coqs rococos pour ce Coq plus cocasse."
                            },
                            {
                                "example_id": "1974df01-3173-48ce-9b52-fac5a96983a1",
                                "sense_id": "6d89fda1-131b-3d0c-b1c2-8761e1bbb4e5",
                                "text": "– Messieurs, c’est un idiot des bois ! Le Français a un mot pour cela, mais il faut que nous, Allemands, nous lui rappelions ses vieux auteurs : c’est un coquefredouille !"
                            }
                        ]
                    }
