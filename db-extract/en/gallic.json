                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c359473-0e58-44f1-a004-d4e8d3a12360",
                                "sense_id": "e83bf37d-3e45-3269-9541-6a6f3e08d4d3",
                                "text": "This dislocation of gender roles in popular entertainment seems to have started with La Cage Aux Folles. This Gallic drag remake of You Can't Take It With You was a huge success at the box office while managing to present gay characters as comic though never foolish."
                            }
                        ]
