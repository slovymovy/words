        "nl-extract.jsonl": [
            {
                "entry_id": "57845c53-5915-3758-9d99-3818f0be08d6",
                "word": "ondertussen",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "24cc7890-1fb2-340e-a91f-c81aa5a8df73",
                        "entry_id": "57845c53-5915-3758-9d99-3818f0be08d6",
                        "glosses": [
                            "in de tussentijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28f1dbe7-ec1d-4adf-8436-245bd36b7543",
                                "sense_id": "24cc7890-1fb2-340e-a91f-c81aa5a8df73",
                                "text": "Er is ondertussen veel tijd verloren gegaan."
                            },
                            {
                                "example_id": "09db31bf-6db1-4fdd-a870-a0db50db0fd2",
                                "sense_id": "24cc7890-1fb2-340e-a91f-c81aa5a8df73",
                                "text": "Het was ondertussen geheel donker geworden."
                            },
                            {
                                "example_id": "c19c8d07-ed07-423c-af5d-ba758a7efcc8",
                                "sense_id": "24cc7890-1fb2-340e-a91f-c81aa5a8df73",
                                "text": "De Franse traditie ziet er heel anders uit, zoals de Britse trendwatcher Stephen Bayley opmerkte. Je rijdt op je gemak over een met platanen omzoomde tweebaansweg, in een comfortabele auto, bij voorkeur een Citroën DS. Ondertussen zoekt je passagier in de Michelingids een restaurant waar je goed en uitgebreid kunt lunchen."
                            },
                            {
                                "example_id": "782a877e-5949-4b6a-b7ff-4397645dfc65",
                                "sense_id": "24cc7890-1fb2-340e-a91f-c81aa5a8df73",
                                "text": "In veel winkels zijn ondertussen lege schappen te vinden. Vooral versproducten als zuivel, vlees, fruit en eieren zijn nog moeilijk te krijgen. Dat komt enerzijds doordat de blokkades het onmogelijk maken om de producten aan te vullen en anderzijds doordat de producten die nog beschikbaar zijn bederven en dus weggegooid moeten worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "227c1011-1c7e-4a43-9242-a7483ae680ea",
                        "source_entry_id": "57845c53-5915-3758-9d99-3818f0be08d6",
                        "source_sense_id": "24cc7890-1fb2-340e-a91f-c81aa5a8df73",
                        "source_sense_description": "in de tussentijd",
                        "target_lang_word": "inzwischen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inzwischen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                        "entry_id": "05c9bad7-af7b-3f06-acbe-8c627d977b24",
                                        "glosses": [
                                            "in der Zwischenzeit, nach Ablauf einer gewissen Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1349d96b-0837-4d97-acac-435b2f8e3e17",
                                                "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                                "text": "Während sie noch spielten, konnten wir inzwischen die nötigen Vorbereitungen treffen."
                                            },
                                            {
                                                "example_id": "2afac981-c6dd-4e01-ae54-bdad7673bc82",
                                                "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                                "text": "„Selbst in den Bundesländern wird inzwischen indirekt eingeräumt, dass die Bahn in der Vergangenheit großzügig bedacht wurde.“"
                                            },
                                            {
                                                "example_id": "76671e86-11a6-45ff-9b2c-234b8bc786bc",
                                                "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                                "text": "„Im geistlichen Kurfürstentum Köln hatten inzwischen ebenfalls die Hexenprozesse sich zu häufen begonnen.“"
                                            },
                                            {
                                                "example_id": "b710f268-df84-4275-9a16-e41fba577005",
                                                "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                                "text": "„Inzwischen bringt der Kellner für Maja das bestellte Kännchen Kaffee und die drei Stücke Kuchen, die sie sich am Buffet ausgesucht hat, und Paul bekommt eine Tasse Tee.“"
                                            },
                                            {
                                                "example_id": "d98eab69-a2a9-49fb-a44b-f789b3d35e99",
                                                "sense_id": "023f4753-4719-30b4-b925-8c26084a7907",
                                                "text": "„Den Leichnam hatte man inzwischen entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71d439bf-44c1-425d-9324-c2af4a1e164f",
                        "source_entry_id": "57845c53-5915-3758-9d99-3818f0be08d6",
                        "source_sense_id": "24cc7890-1fb2-340e-a91f-c81aa5a8df73",
                        "source_sense_description": "in de tussentijd",
                        "target_lang_word": "in the mean time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in the mean time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "774935f1-cf77-3a6d-9d2f-69a7afe42ae9",
                                        "entry_id": "42c5abd6-4e3a-37c9-8550-08c98141f65d",
                                        "glosses": [
                                            "Alternative form of in the meantime."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05df8253-9da8-4444-822b-d91a64662fb4",
                                                "sense_id": "774935f1-cf77-3a6d-9d2f-69a7afe42ae9",
                                                "text": "In the mean time I lay fairly expoſed to the examination of his eyes, and hands, quiet and unreſiſting, […]",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "9b9c548f-8d1f-43f2-b346-9d408617056b",
                                                "sense_id": "774935f1-cf77-3a6d-9d2f-69a7afe42ae9",
                                                "text": "But in the mean time Robin Hood and his band lived quietly in Sherwood Forest, without showing their faces abroad, for Robin knew that it would not be wise for him to be seen in the neighborhood of Nottingham, those in authority being very wroth with him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e887906-2204-481c-a5d1-f7257c63f86a",
                        "source_entry_id": "57845c53-5915-3758-9d99-3818f0be08d6",
                        "source_sense_id": "24cc7890-1fb2-340e-a91f-c81aa5a8df73",
                        "source_sense_description": "in de tussentijd",
                        "target_lang_word": "meanwhile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meanwhile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41b4c4c7-19d0-3da0-b812-b679bf3ec580",
                                        "entry_id": "caab6ad0-d45e-39cc-9755-498b9ee5e510",
                                        "glosses": [
                                            "The time between two events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83b2315d-7c63-4384-b5eb-77c4ded31571",
                                                "sense_id": "41b4c4c7-19d0-3da0-b812-b679bf3ec580",
                                                "text": "In the meanwhile, the surveyors carried the line three miles, which was no contemptible day's work, considering how cruelly they were entangled with briers and gallbushes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meanwhile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30009493-26b1-34f2-bac4-6b30722359c8",
                                        "entry_id": "91607b7e-f089-385b-a7ca-363659ba3e46",
                                        "glosses": [
                                            "During the time that something is happening, often specifically in a different place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8e5e79c-ae8f-4148-b523-1c9c34e73771",
                                                "sense_id": "30009493-26b1-34f2-bac4-6b30722359c8",
                                                "text": "There was a party going on downstairs. Meanwhile, I was reading a book."
                                            },
                                            {
                                                "example_id": "e2fca7da-277f-4f41-a041-026da9b103ab",
                                                "sense_id": "30009493-26b1-34f2-bac4-6b30722359c8",
                                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                        "entry_id": "91607b7e-f089-385b-a7ca-363659ba3e46",
                                        "glosses": [
                                            "During an intervening time; from now until a future time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b87e7889-9a76-4362-9b4e-6076a7392553",
                                                "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                                "text": "We’re going on holiday next month; meanwhile, keep working on the project."
                                            },
                                            {
                                                "example_id": "eb3d8668-3f83-46a9-837f-55f7e8b2e18d",
                                                "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                                "text": "The day may dawn when fair play, love for one's fellow men, respect for justice and freedom, will enable tormented generations to march forth triumphant from the hideous epoch in which we have to dwell. Meanwhile, never flinch, never weary, never despair."
                                            },
                                            {
                                                "example_id": "224cf66c-ad13-4898-9fc8-c656c0cb974a",
                                                "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                                "text": "“[…] I’m not ignoring you, I’m very sorry, I’ll talk to you soon. Meanwhile, get your tickets.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "915d4253-2a2f-3183-ad53-385bdabb68ce",
                                        "entry_id": "91607b7e-f089-385b-a7ca-363659ba3e46",
                                        "glosses": [
                                            "In contrast to aspects previously mentioned."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "090ed779-978e-44e0-81d8-98bcd1fa47c8",
                                                "sense_id": "915d4253-2a2f-3183-ad53-385bdabb68ce",
                                                "text": "Some songs on the album are beautiful. Meanwhile, others are quite forgettable."
                                            },
                                            {
                                                "example_id": "c4a80167-011a-4835-973a-e857e80ce02e",
                                                "sense_id": "915d4253-2a2f-3183-ad53-385bdabb68ce",
                                                "text": "When you are in the studio you don’t have anybody to feed off of, meanwhile when you are playing live you interact with people and you feel the energy in the room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
