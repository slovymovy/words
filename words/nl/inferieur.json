    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a804d389-5784-3649-9db6-13579630492b",
                    "sense_definition": "Van lagere waarde of kwaliteit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kwaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kwaliteit van dit goedkope materiaal is duidelijk <w>inferieur</w> aan dat van de duurdere variant.",
                            "target_lang_translations": {
                                "it": "La qualità di questo materiale economico è chiaramente <w>inferiore</w> a quella della variante più costosa."
                            }
                        },
                        {
                            "text": "Veel mensen denken dat goedkope producten <w>inferieur</w> zijn, maar dat is niet altijd waar.",
                            "target_lang_translations": {
                                "it": "Molte persone pensano che i prodotti economici siano <w>inferiori</w>, ma non è sempre vero."
                            }
                        }
                    ],
                    "synonyms": [
                        "minderwaardig"
                    ],
                    "antonyms": [
                        "superieur"
                    ],
                    "common_phrases": [
                        "inferieur product",
                        "inferieure kwaliteit"
                    ],
                    "target_lang_definitions": {
                        "it": "Di valore o qualità inferiore rispetto a qualcos'altro."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "inferiore",
                                "target_lang_sense_clarification": "Di qualità o valore più basso."
                            },
                            {
                                "target_lang_word": "scadente",
                                "target_lang_sense_clarification": "Di qualità mediocre o bassa."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8d8bddb-3ade-35c0-b726-9e70f825e39a",
                    "sense_definition": "Lager in rang of ondergeschikt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het oude systeem voelden de werknemers zich vaak <w>inferieur</w> aan hun bazen.",
                            "target_lang_translations": {
                                "it": "Nel vecchio sistema, i dipendenti si sentivano spesso <w>inferiori</w> ai loro capi."
                            }
                        },
                        {
                            "text": "Hij weigerde zich <w>inferieur</w> te gedragen tegenover zijn meerderen.",
                            "target_lang_translations": {
                                "it": "Si rifiutava di comportarsi in modo <w>inferiore</w> di fronte ai suoi superiori."
                            }
                        }
                    ],
                    "antonyms": [
                        "superieur"
                    ],
                    "target_lang_definitions": {
                        "it": "Che occupa una posizione gerarchica più bassa o subordinata."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "subordinato",
                                "target_lang_sense_clarification": "Che dipende da un superiore o ha un rango inferiore."
                            },
                            {
                                "target_lang_word": "inferiore",
                                "target_lang_sense_clarification": "Di grado o rango più basso."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}