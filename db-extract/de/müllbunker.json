                ],
                "senses": [
                    {
                        "sense_id": "e6880a92-ce62-3e0e-bc5a-47827517de02",
                        "entry_id": "a0ac58c1-2f49-300c-bf5e-9b8cc91f9ea3",
                        "glosses": [
                            "Lagerraum für Müll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98569a95-7ceb-41d7-88e8-9ae8e5b02d49",
                                "sense_id": "e6880a92-ce62-3e0e-bc5a-47827517de02",
                                "text": "„Im Müllbunker wird der Abfall so durchmischt, dass die Zusammensetzung möglichst gleichmäßig wird.“"
                            },
                            {
                                "example_id": "eeb905e3-6e17-42d1-b7a1-906738a2ce64",
                                "sense_id": "e6880a92-ce62-3e0e-bc5a-47827517de02",
                                "text": "„Die Lagerung des Abfalls im Müllbunker ist für einen kontinuierlichen Betrieb der Anlage unerlässlich, da diese an 365 Tagen im Jahr im Dauerbetrieb ist.“"
                            },
                            {
                                "example_id": "67f763df-cb36-4690-9ece-fc4ff36ac202",
                                "sense_id": "e6880a92-ce62-3e0e-bc5a-47827517de02",
                                "text": "„Im Müllbunker werden die direkt in den Bunker gekippten Abfälle und der in der Sperrmüllschere zerkleinerter sperrige Abfall mit Hilfe von zwei Kränen vor der Verbrennung gut gemischt.“"
                            },
                            {
                                "example_id": "915facee-357b-4467-b525-44e1d0480007",
                                "sense_id": "e6880a92-ce62-3e0e-bc5a-47827517de02",
                                "text": "„In der Regel würden hier an Werktagen bis zu 1.000 Tonnen Abfall entladen, gemischt und bis zur Verbrennung im Müllbunker gelagert.“"
                            },
                            {
                                "example_id": "b1e1615d-0fb3-40b7-bc97-e551a92a4550",
                                "sense_id": "e6880a92-ce62-3e0e-bc5a-47827517de02",
                                "text": "„Wegen Reparaturarbeiten an einem benachbarten Müllbunker sei der betroffene Teil der Anlage mit Müll vollgestopft gewesen, teilte die Polizei am Mittwoch mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
