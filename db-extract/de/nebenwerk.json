                "senses": [
                    {
                        "sense_id": "8816257d-c0c3-3c48-bf1d-64033f396141",
                        "entry_id": "bfc4ece2-378b-3998-a5f3-504597e3f994",
                        "glosses": [
                            "Werk eines Künstlers, Wissenschaftlers …, das von geringerer Bedeutung ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fba259ee-3890-4ff9-a323-68255a93d6ae",
                                "sense_id": "8816257d-c0c3-3c48-bf1d-64033f396141",
                                "text": "„Es wird behauptet, dass Avicenna 21 Haupt- und 24 Nebenwerke in Philosophie, Medizin, Theologie, Geometrie, Astronomie und anderen Gebieten vollendet hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f5b7c5d9-bdfb-3802-93a2-0954a4850c74",
                        "entry_id": "bfc4ece2-378b-3998-a5f3-504597e3f994",
                        "glosses": [
                            "Niederlassung eines Unternehmens, die von geringerer Bedeutung ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b562d6e-9db8-43fc-adfd-19d5c6244f29",
                                "sense_id": "f5b7c5d9-bdfb-3802-93a2-0954a4850c74",
                                "text": "„Durch den Luftangriff vom 2. Januar 1945 wurde das Nebenwerk vollständig zerstört und konnte ab 1946 wieder in Betrieb genommen werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "89c6c8d7-519e-35e3-9742-0ebf3bdbd4e0",
                        "entry_id": "bfc4ece2-378b-3998-a5f3-504597e3f994",
                        "glosses": [
                            "isolierter Teil einer Verteidigungsanlage von untergeordneter Bedeutung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ca6fbc0-1067-435d-bb14-4aae84c80f4a",
                                "sense_id": "89c6c8d7-519e-35e3-9742-0ebf3bdbd4e0",
                                "text": "„Das Nebenwerk konnte bis zu 350 Mann beherbergen und besitzt insgesamt vier Caponnieren, davon jeweils eine an den beiden Schultern, eine im Saillant und eine in der Kehle.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
