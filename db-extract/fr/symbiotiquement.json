        "fr-extract.jsonl": [
            {
                "entry_id": "b802e356-37bf-31c4-8754-705edfc0a33f",
                "word": "symbiotiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c38115b7-207c-3601-b24e-09dd0e399187",
                        "entry_id": "b802e356-37bf-31c4-8754-705edfc0a33f",
                        "glosses": [
                            "De façon symbiotique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f1224d2-50e5-4a1d-bcf2-0da0bf258fee",
                                "sense_id": "c38115b7-207c-3601-b24e-09dd0e399187",
                                "text": "Le vin poussait à la politique et la politique au vin, généreusement, symbiosiquement, tonitrueusement."
                            },
                            {
                                "example_id": "c87c14fb-9962-45ba-8640-f1b9df2eb195",
                                "sense_id": "c38115b7-207c-3601-b24e-09dd0e399187",
                                "text": "on doit également distinguer les Champignons mycorhiziens, c’est-à-dire ceux qui sont associés symbiotiquement avec les racines d’un végétal supérieur, qui possèdent les plus grandes qualités organoleptiques…"
                            },
                            {
                                "example_id": "6f9d4eda-4272-4bd1-a098-35cf350679de",
                                "sense_id": "c38115b7-207c-3601-b24e-09dd0e399187",
                                "text": "Ces alliances visent à amener les partenaires à mettre en commun certaines ressources afin d’établir une relation de confiance à long terme, d’acquérir de nouvelles ressources ou compétences de façon à se développer symbiotiquement vers un objectif commun."
                            }
                        ]
                    }
