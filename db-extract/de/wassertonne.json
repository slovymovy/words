                    {
                        "sense_id": "4c5d6681-b977-3e73-8582-2f736d7dfd5e",
                        "entry_id": "6a3483e4-9998-3d54-a6cc-7da174acc6f5",
                        "glosses": [
                            "Auffangbehälter für Wasser, das für bestimmte Zwecke genutzt werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c022fda0-a2ac-4e7e-a7bc-61f3e3ca1049",
                                "sense_id": "4c5d6681-b977-3e73-8582-2f736d7dfd5e",
                                "text": "Die Wassertonne sammelt das Wasser, damit in der Trockenzeit reichlich Wasser vorhanden ist."
                            },
                            {
                                "example_id": "23b9bd0a-2a1f-4a5c-bc83-674fadab9202",
                                "sense_id": "4c5d6681-b977-3e73-8582-2f736d7dfd5e",
                                "text": "„Mansfield stand am Rand des Steilhangs neben der Wassertonne und starrte aufs Schwimmdock hinunter, wo der riesige Fisch im Mondschein wie blasses Silber schimmerte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
