                ],
                "senses": [
                    {
                        "sense_id": "2076457b-7bb0-304b-9da4-433f4528e2fc",
                        "entry_id": "56b46a6a-7667-3d49-8da1-082790051c31",
                        "glosses": [
                            "Partie d’un gant qui couvre la paume de la main."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6e35d89-4a49-481b-9c3b-5dccbe69516c",
                                "sense_id": "2076457b-7bb0-304b-9da4-433f4528e2fc",
                                "text": "Une empaumure bien faite."
                            },
                            {
                                "example_id": "7a1d774e-1622-48b8-94d6-f3ba517cf9c7",
                                "sense_id": "2076457b-7bb0-304b-9da4-433f4528e2fc",
                                "text": "Il jette à l’arrière une pile de journaux écornés et une paire de gants de laine à empaumures de cuir, déverrouille la portière de droite."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc12f8c7-23c1-332e-b940-b5f501265d63",
                        "entry_id": "56b46a6a-7667-3d49-8da1-082790051c31",
                        "glosses": [
                            "Haut de la tête du cerf ou du chevreuil, où il y a trois ou quatre andouillers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35c3814d-b8fe-44fc-80b6-86556825a796",
                                "sense_id": "bc12f8c7-23c1-332e-b940-b5f501265d63",
                                "text": "Généralement le premier andouiller est le maître andouiller, ou andouiller de massacre, le second le surandouiller, le troisième la chevillure, et le quatrième la trochure. Au-dessus, c'est la couronne ou empaumure."
                            },
                            {
                                "example_id": "e012e68f-b8e1-40ea-b75f-7510ddad4338",
                                "sense_id": "bc12f8c7-23c1-332e-b940-b5f501265d63",
                                "text": "Cette année, la pousse est accomplie, les empaumures sont vastes et régulières, telles deux mains aux doigts écartés, les andouillers de massacre sont eux-mêmes d’une amplitude considérable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d33b443d-0623-409a-8725-6066768be844",
                        "source_entry_id": "56b46a6a-7667-3d49-8da1-082790051c31",
                        "source_sense_description": "Extrémité des bois des cervidés",
