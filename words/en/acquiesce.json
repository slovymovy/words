    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b05fb357-b5e8-3b43-9022-c971ff758cda",
                    "sense_definition": "To accept, agree, or comply silently or without protest, even if one does not entirely agree.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to <w>acquiesce</w> in the new regulations despite their initial reservations."
                        },
                        {
                            "text": "She chose to <w>acquiesce</w> to her manager's demands rather than risk losing her job."
                        }
                    ],
                    "synonyms": [
                        "yield",
                        "accept",
                        "go along with"
                    ],
                    "antonyms": [
                        "object",
                        "protest"
                    ],
                    "common_phrases": [
                        "acquiesce in the decision",
                        "acquiesce to demands"
                    ]
                },
                {
                    "sense_id": "c73c0ef8-8b23-3fe5-9920-f6c1e08a9840",
                    "sense_definition": "To rest satisfied or submit quietly without opposition, often implying previous discontent or disagreement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were compelled to <w>acquiesce</w> in a government which they did not regard as just."
                        },
                        {
                            "text": "He silently <w>acquiesced</w> to the terms of the treaty to avoid further conflict."
                        }
                    ],
                    "synonyms": [
                        "resign",
                        "submit",
                        "yield"
                    ],
                    "antonyms": [
