                    {
                        "translation_id": "7a30ca08-6e6e-4082-b88e-5c79d882ee76",
                        "source_entry_id": "754fdfae-0107-308f-8c93-f24160fbf4f0",
                        "source_sense_id": "64d98ddf-f7ae-32d5-af75-43dd96493bbf",
