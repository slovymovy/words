                "senses": [
                    {
                        "sense_id": "c76a12ee-e4f5-350c-9fa3-375286f2f9b5",
                        "entry_id": "72286af5-a2d4-3b50-9cf1-e7ee7b60d889",
                        "glosses": [
                            "vermehrte Bildung von Aceton im Blut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd1a3c3d-3285-4944-9e39-57f691229444",
                                "sense_id": "c76a12ee-e4f5-350c-9fa3-375286f2f9b5",
                                "text": "Eine Ketose kann bei einem unzureichend behandelten Diabetes mellitus auftreten und durch Ketoazidose zu einem lebensbedrohlichen Koma führen."
                            },
                            {
                                "example_id": "c5fe3b64-f36b-4ac3-98eb-3d2627d1004d",
                                "sense_id": "c76a12ee-e4f5-350c-9fa3-375286f2f9b5",
                                "text": "Fehlen die Kohlenhydrate, stellt dein Körper deinen Energiestoffwechsel auf eine sogenannte Ketose um und gewinnt seine Power fast ausschließlich aus Fett."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ba700d90-9a17-3e0f-821c-97b37f18b745",
                        "entry_id": "72286af5-a2d4-3b50-9cf1-e7ee7b60d889",
                        "glosses": [
                            "Einfachzucker mit einer CO-Gruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e37cb622-45ad-469d-bea5-64e5964c4d7b",
                                "sense_id": "ba700d90-9a17-3e0f-821c-97b37f18b745",
                                "text": "Einfachste Ketose ist das Dihydroxyaceton (eine Ketotriose)."
                            },
                            {
                                "example_id": "ce44a48f-de4a-4205-8051-69dcd4547361",
                                "sense_id": "ba700d90-9a17-3e0f-821c-97b37f18b745",
                                "text": "Monosacchride mit Aldehydgruppe werden Aldosen genannt; mit Ketogruppe Ketosen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14beca27-9bc8-40ae-9baf-dc5e3505e3a4",
                        "source_entry_id": "72286af5-a2d4-3b50-9cf1-e7ee7b60d889",
                        "source_sense_id": "c76a12ee-e4f5-350c-9fa3-375286f2f9b5",
                        "source_sense_description": "vermehrte Bildung von Aceton im Blut",
                        "target_lang_word": "ketosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ketosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "789381af-ac46-34d9-9e45-6e8c59f69a2f",
                                        "entry_id": "d3b7ee39-cf69-38d5-870a-b5f4f2b84f32",
                                        "glosses": [
                                            "A metabolic state in which the body produces ketones to be used as fuel by some organs so that glycogen can be reserved for organs that depend on it. This condition occurs during times of fasting, starvation, or while on a ketogenic diet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf949163-647d-43c5-8fd9-86da97c1da3e",
                        "source_entry_id": "72286af5-a2d4-3b50-9cf1-e7ee7b60d889",
                        "source_sense_id": "c76a12ee-e4f5-350c-9fa3-375286f2f9b5",
                        "source_sense_description": "vermehrte Bildung von Aceton im Blut",
                        "target_lang_word": "cétose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cétose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80cf8599-fb55-39eb-906e-953058862231",
                                        "entry_id": "4dd070b7-9dac-3e6b-af58-0271bba9dae8",
                                        "glosses": [
                                            "Ose dont la fonction carbonyle est une cétone. En fonction du nombre d’atomes de carbone constituant la molécule, on parle de cétotriose (le dihydroxyacétone à trois atomes de carbone est le seul représentant de ce groupe), des cétotétroses (pour les cétoses à quatre atomes de carbone), des cétopentoses (5 atomes de carbone), des cétohexoses (six atomes de carbone, comme le fructose), etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c2b1779-bd60-4b83-8eb1-6c7f2f0eb920",
                                                "sense_id": "80cf8599-fb55-39eb-906e-953058862231",
                                                "text": "Les cétoses doivent d’abord se tautomériser en aldoses avant de pouvoir jouer le rôle de sucres réducteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c5ed8a0-12d7-36e1-ab6c-d7428568eb66",
                                        "entry_id": "4dd070b7-9dac-3e6b-af58-0271bba9dae8",
                                        "glosses": [
                                            "État du métabolisme avec un niveau élevé de corps cétoniques, qui peut conduire à l’acidocétose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
