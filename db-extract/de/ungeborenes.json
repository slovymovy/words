                ],
                "senses": [
                    {
                        "sense_id": "e82dee52-d9d8-342d-a8a9-7dd3dc01cda7",
                        "entry_id": "c34bfd7b-4e7a-3db3-8ff7-b7855b504191",
                        "glosses": [
                            "(insbesondere menschliches) Wesen im Mutterleib"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec25bf30-e1ac-4483-87a4-e7ca5ca85af9",
                                "sense_id": "e82dee52-d9d8-342d-a8a9-7dd3dc01cda7",
                                "text": "„Auch wenn immer wieder über spektakuläre Erfolge der Medizin auf dem Gebiet der Pränataltherapie berichtet wird, wie jüngst z. B. über die operative Behebung eines Lochs im Zwerchfell eines Ungeborenen, klafft die Schere zwischen diagnostizierbaren und therapierbaren Schäden Ungeborener noch immer weit auseinander.“"
                            },
                            {
                                "example_id": "77766f8d-c59c-46ff-bb05-fcfa9ade6734",
                                "sense_id": "e82dee52-d9d8-342d-a8a9-7dd3dc01cda7",
                                "text": "„Zu Beginn des 19. Jahrhunderts wurden durch die sprunghafte Entwicklung der Embryologie verschiedene Vorstellungen vom Ungeborenen und auch die vieldeutigen Leibempfindungen ‚unhaltbar‘ […].“"
                            },
                            {
                                "example_id": "187448c5-e0a6-444b-95a5-fd77b4cf45ff",
                                "sense_id": "e82dee52-d9d8-342d-a8a9-7dd3dc01cda7",
                                "text": "„Ein Ungeborenes braucht vor allem Raum und Zeit, um sich zu entwickeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88a37f0d-0b6b-4207-bba8-5e27d0185109",
                        "source_entry_id": "c34bfd7b-4e7a-3db3-8ff7-b7855b504191",
                        "source_sense_id": "e82dee52-d9d8-342d-a8a9-7dd3dc01cda7",
                        "source_sense_description": "Leibesfrucht",
                        "target_lang_word": "unborn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unborn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7053d66f-be4e-36ec-91e6-70cd75fa02f7",
                                        "entry_id": "83c5cd17-dc29-3f3f-8a7d-d5d54dd80164",
                                        "glosses": [
                                            "Not yet born; yet to come; future."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f9aa6bd-d69e-3926-bf0a-170611fb0693",
                                        "entry_id": "83c5cd17-dc29-3f3f-8a7d-d5d54dd80164",
                                        "glosses": [
                                            "Not yet delivered; still existing in the mother's womb."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62d3b83e-c60d-44f7-b89e-a163966d5d3e",
                                                "sense_id": "8f9aa6bd-d69e-3926-bf0a-170611fb0693",
                                                "text": "Ellen Page gives a star-making performance as a 16-year-old live wire who decides to go through with her pregnancy and seeks acceptably well-adjusted, wealthy, punk-rock loving parents for the unborn baby."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b2967ae-7f36-33a6-ad7b-63f8f5488fc4",
                                        "entry_id": "83c5cd17-dc29-3f3f-8a7d-d5d54dd80164",
                                        "glosses": [
                                            "Existing without birth or beginning."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "unborn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e0d6e37-df54-3d65-b092-91fd4159739b",
                                        "entry_id": "c4b12cb5-6a8a-3dd7-88f9-81f45cd0c99f",
                                        "glosses": [
                                            "A single unborn offspring at any stage of gestation."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "893ae9ce-94f9-4c51-9838-a6b25302a874",
                                                "sense_id": "8e0d6e37-df54-3d65-b092-91fd4159739b",
                                                "text": "Whereas the lack of a child brings shame upon Anna and Joachim, the converse holds true for Mary: the existence of an unborn in the womb of a woman who is supposed to be a virgin causes great scandal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e363ca47-9e59-3dda-b93a-6e5150944061",
                                        "entry_id": "c4b12cb5-6a8a-3dd7-88f9-81f45cd0c99f",
                                        "glosses": [
                                            "Unborn offspring collectively."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d34b1e-72be-4c64-8299-7ef4fde2bd25",
                                                "sense_id": "e363ca47-9e59-3dda-b93a-6e5150944061",
                                                "text": "Inheritance law allows property to be left to the unborn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
