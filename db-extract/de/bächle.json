                "senses": [
                    {
                        "sense_id": "6afbe327-ee18-3c24-921c-8bb44c6acf1e",
                        "entry_id": "254095a1-572b-3739-bfb5-cbf629f44718",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8881b08-f048-4098-98ac-d593246af077",
                                "sense_id": "6afbe327-ee18-3c24-921c-8bb44c6acf1e",
                                "text": "Frau Bächle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9fff174b-6822-4184-afea-653b476a0dea",
                                "sense_id": "6afbe327-ee18-3c24-921c-8bb44c6acf1e",
                                "text": "Herr Bächle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c1c95cfa-716a-469f-944b-da960693bec1",
                                "sense_id": "6afbe327-ee18-3c24-921c-8bb44c6acf1e",
                                "text": "Die Bächles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "6fab2829-239d-4125-83a0-1fddb00a9abd",
                                "sense_id": "6afbe327-ee18-3c24-921c-8bb44c6acf1e",
                                "text": "Der Bächle trägt nie die Pullover, die die Bächle ihm strickt."
                            },
                            {
                                "example_id": "ba2f6858-9961-4466-900a-c961157bbbe2",
                                "sense_id": "6afbe327-ee18-3c24-921c-8bb44c6acf1e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bächle kommt, geht der Herr Bächle.“"
                            },
                            {
                                "example_id": "f2941b8c-bd22-4ac5-a629-c6ad2ff50145",
                                "sense_id": "6afbe327-ee18-3c24-921c-8bb44c6acf1e",
                                "text": "Bächle kommt und geht."
                            },
                            {
                                "example_id": "4a11833b-8091-4eb3-ae1c-dd08b1606e41",
                                "sense_id": "6afbe327-ee18-3c24-921c-8bb44c6acf1e",
                                "text": "Bächles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
