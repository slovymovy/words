                        "sense_id": "914bd63f-571f-3dd7-b058-fb9b62b8fde7",
                        "entry_id": "53003991-7346-3de2-855b-b699a60d773c",
                        "glosses": [
                            "Contrat par lequel une chose est prêtée gratuitement à l’emprunteur, à la charge de la restituer en nature à une date convenue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18f7bc2f-37f4-47da-8588-052a97b27d45",
                                "sense_id": "914bd63f-571f-3dd7-b058-fb9b62b8fde7",
                                "text": "Les engagements qui se forment par le commodat passent aux héritiers de celui qui prête, et aux héritiers de celui qui emprunte. Mais si l’on n’a prêté qu’en considération de l’emprunteur, et à lui personnellement, alors ses héritiers ne peuvent continuer de jouir de la chose prêtée."
                            }
                        ]
                    }
                ],
