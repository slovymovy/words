                "senses": [
                    {
                        "sense_id": "2c6e3f34-2d15-328d-b5d2-6bf34f62eae6",
                        "entry_id": "8059fa3a-0f14-365b-9937-de4174684431",
                        "glosses": [
                            "materiał służący do opalania dla ogrzania pomieszczenia, surowiec opałowy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cdf7acf-230f-4b80-9eea-235b48e127bc",
                                "sense_id": "2c6e3f34-2d15-328d-b5d2-6bf34f62eae6",
                                "text": "Czy ktoś z was pomyślał o zakupie opału na zimę?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e1a53254-8b44-31d9-8585-04173998ba76",
                        "entry_id": "8059fa3a-0f14-365b-9937-de4174684431",
                        "glosses": [
                            "czynność opalania lub palenia w piecu; ogrzanie"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "3e88177a-2ac8-383c-8cdd-acda7d6ce578",
                        "entry_id": "8059fa3a-0f14-365b-9937-de4174684431",
                        "glosses": [
                            "ciężkie albo niebezpieczne położenie"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "69779af8-822a-4177-9069-d73f5d420f24",
                                "sense_id": "3e88177a-2ac8-383c-8cdd-acda7d6ce578",
                                "text": "Nawet nie spodziewał się, gdy raptem znalazł się w srogich opałach."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40f00db5-2429-454e-9456-c9c763b76a06",
                        "source_entry_id": "8059fa3a-0f14-365b-9937-de4174684431",
                        "source_sense_id": "2c6e3f34-2d15-328d-b5d2-6bf34f62eae6",
                        "target_lang_word": "fuel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fuel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f91bdd36-8440-3296-afac-2ec7a80647a4",
                                        "entry_id": "0bc67a89-e1e2-3758-9102-3a58a47c9977",
                                        "glosses": [
                                            "Substance consumed to provide energy through combustion, or through chemical or nuclear reaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91e232e0-773a-4aeb-b64d-6898a83faf39",
                                                "sense_id": "f91bdd36-8440-3296-afac-2ec7a80647a4",
                                                "text": "More than a mere source of Promethean sustenance to thwart the cold and cook one's meat, wood was quite simply mankind's first industrial and manufacturing fuel."
                                            },
                                            {
                                                "example_id": "f1bd876c-8160-4a93-9c64-815414e2e85f",
                                                "sense_id": "f91bdd36-8440-3296-afac-2ec7a80647a4",
                                                "text": "In a press release, CARB expanded on their decision. \"The LCFS reduces air pollution and greenhouse gas emissions by setting a declining carbon intensity target for transportation fuels used in California; producers that don't meet established benchmarks buy credits from those that do. This system has generated $4 billion in annual private sector investment toward a cleaner transportation sector.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab2e9fc6-27bc-3959-a8dc-20ef8824e3fb",
                                        "entry_id": "0bc67a89-e1e2-3758-9102-3a58a47c9977",
                                        "glosses": [
                                            "Substance that provides nourishment for a living organism; food."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43b746d7-a358-4209-8fed-2622523f7d41",
                                                "sense_id": "ab2e9fc6-27bc-3959-a8dc-20ef8824e3fb",
                                                "text": "A little fuel to get down the mountain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e2d6aa-2502-3116-b31f-a91adfd648c0",
                                        "entry_id": "0bc67a89-e1e2-3758-9102-3a58a47c9977",
                                        "glosses": [
                                            "Something that stimulates, encourages or maintains an action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d50c91d-1cf1-45de-b8e9-9b836e700ef4",
                                                "sense_id": "10e2d6aa-2502-3116-b31f-a91adfd648c0",
                                                "text": "His books were fuel for the revolution."
                                            },
                                            {
                                                "example_id": "c0f85b1e-191a-49ff-a04c-fa3094910d09",
                                                "sense_id": "10e2d6aa-2502-3116-b31f-a91adfd648c0",
                                                "text": "Money is the fuel for economy."
                                            },
                                            {
                                                "example_id": "b1c38433-55de-48ec-8d81-ec37eecf53a8",
                                                "sense_id": "10e2d6aa-2502-3116-b31f-a91adfd648c0",
                                                "text": "That film was nightmare fuel!"
                                            },
                                            {
                                                "example_id": "ab8de6c4-b723-4fe9-8e87-63db1355f53e",
                                                "sense_id": "10e2d6aa-2502-3116-b31f-a91adfd648c0",
                                                "text": "Small arms ammunition is the fuel that keeps many of the world’s conflicts raging."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fuel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "821dea89-c8e4-38af-84a4-e6b20dfc9f92",
                                        "entry_id": "8652c0ee-c682-38c7-a55c-03b6c0a29fc9",
                                        "glosses": [
                                            "To provide with fuel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97791df8-7574-4f0f-8dfc-0f7f261fc2f2",
                                                "sense_id": "821dea89-c8e4-38af-84a4-e6b20dfc9f92",
                                                "text": "[…] Lieutenant Hirsch appeared with a sheaf of signals in his hand. He took these from the young man and read them through. Mostly they dealt with routine matters of the fuelling and victualling, but one from the Third Naval Member’s office was unexpected."
                                            },
                                            {
                                                "example_id": "faef6dd2-656e-4c62-9303-1fd8393b915d",
                                                "sense_id": "821dea89-c8e4-38af-84a4-e6b20dfc9f92",
                                                "text": "The workings now employ ten twin-units, which are fuelled at Hornsey but return to Cambridge diesel depot for their weekly maintenance; [...]."
                                            },
                                            {
                                                "example_id": "52f907fc-2dab-4d91-85b1-6a742133857e",
                                                "sense_id": "821dea89-c8e4-38af-84a4-e6b20dfc9f92",
                                                "text": "\"Well, we do need to keep some of it on hand, donchaknow. For fueling the cookfires and all that rot.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c340c0b-de5a-329b-bd50-379e50452376",
                                        "entry_id": "8652c0ee-c682-38c7-a55c-03b6c0a29fc9",
                                        "glosses": [
                                            "To exacerbate, to cause to grow or become greater."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3967da58-bad2-40e6-b8f0-4df212029a65",
                                                "sense_id": "3c340c0b-de5a-329b-bd50-379e50452376",
                                                "text": "There were times, during the first two years of the Biden presidency, when I came close to forgetting about it all: the taunts and the provocations; the incitements and the resentments; the disorchestrated reasoning; the verbal incontinence; the press conferences fueled by megalomania, vengeance, and a soupçon of hydroxychloroquine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70056458-5d91-4960-b00d-a71f7943e9fa",
                        "source_entry_id": "8059fa3a-0f14-365b-9937-de4174684431",
