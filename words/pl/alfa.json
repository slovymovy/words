                    "sense_id": "834b1bbe-36c9-3c89-b622-020fa68bc69b",
                    "sense_definition": "pierwsza litera alfabetu greckiego (Α, α)",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "greek_letter",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "Kąt <w>alfa</w> w tym trójkącie wynosi trzydzieści stopni.",
                            "target_lang_translations": {
                                "ru": "Угол <w>альфа</w> в этом треугольнике составляет тридцать градусов."
                            }
                        },
                        {
                            "text": "W matematyce często używa się litery <w>alfa</w> do oznaczania zmiennych.",
                            "target_lang_translations": {
                                "ru": "В математике часто используется буква <w>альфа</w> для обозначения переменных."
                            }
                        }
                    ],
                    "synonyms": [
                        "α"
                    ],
                    "antonyms": [
                        "omega"
                    ],
                    "common_phrases": [
                        "alfa i omega"
                    ],
                    "target_lang_definitions": {
