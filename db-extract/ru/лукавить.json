                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "017312ee-f9d1-4103-a659-8bc68372dd59",
                                                "sense_id": "8ca205ac-0777-30ee-8093-3a6c12072499",
                                                "text": "Ce chicaneur vous donne bien de la peine, il ruse, il ne fait que ruser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db85a604-0120-3ef8-b7b4-c3682591267c",
                                        "entry_id": "aeb065df-01eb-36bb-957e-f84e60846d1b",
                                        "glosses": [
                                            "Se servir de toutes sortes de détours pour se dérober aux chiens qui poursuivent, en parlant du gibier, et particulièrement du cerf, du lièvre, du renard, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9858e95-3adf-4fc3-8050-b223ae4b208f",
                                                "sense_id": "db85a604-0120-3ef8-b7b4-c3682591267c",
                                                "text": "C’est un vieux cerf, un vieux lièvre qui ruse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f40d4921-9470-3356-be35-a2a361e6f02f",
                                        "entry_id": "aeb065df-01eb-36bb-957e-f84e60846d1b",
                                        "glosses": [
                                            "Traîner, frotter, glisser en faisant du bruit."
                                        ],
                                        "tags": [
                                            "Bretagne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6d15749-66d0-4bed-9c37-180f2f894c81",
                                                "sense_id": "f40d4921-9470-3356-be35-a2a361e6f02f",
                                                "text": "Il faisait ruser ses pieds sur le parquet."
                                            },
                                            {
                                                "example_id": "be36be5c-f327-4efb-a31a-1feee89a6933",
                                                "sense_id": "f40d4921-9470-3356-be35-a2a361e6f02f",
                                                "text": "Chaque soir l'aïeule aimait faire une apparition solitaire en haut des marches, et, le bout des doigts rusant sur la rampe....."
                                            }
                                        ]
                                    }
                                ]
                            }
