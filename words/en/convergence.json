                },
                {
                    "sense_id": "739dfae8-ed15-3f52-968f-c967ec3a440d",
                    "sense_definition": "The property of approaching a specific limiting value, especially in an infinite series.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mathematician spent hours proving the <w>convergence</w> of the complex series.",
                            "target_lang_translations": {
                                "ru": "Математик провел часы, доказывая <w>сходимость</w> сложного ряда."
                            }
                        },
                        {
                            "text": "We need to check the radius of <w>convergence</w> before we can solve the equation.",
                            "target_lang_translations": {
                                "ru": "Нам нужно проверить радиус <w>сходимости</w>, прежде чем мы сможем решить уравнение."
                            }
                        }
