                ],
                "senses": [
                    {
                        "sense_id": "bb5130a9-1ecc-3ff3-b37e-8e3997cfc086",
                        "entry_id": "316c1b4d-e02c-3bd4-83b5-6b13693e3e7b",
                        "glosses": [
                            "однокр. к зевать"
                        ],
                        "tags": [
                            "semelefactive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dc0c8083-2428-3795-86e2-d8ccc6550d9f",
                        "entry_id": "316c1b4d-e02c-3bd4-83b5-6b13693e3e7b",
                        "glosses": [
                            "разг. лишиться чего-либо по оплошности; не заметить, пропустить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f644a41-7595-406f-b873-1016c9a2a120",
                                "sense_id": "dc0c8083-2428-3795-86e2-d8ccc6550d9f",
                                "text": "Полынов рассеянно двигал фигуры, зевнул ферзя и проиграл, что еще больше улучшило настроение Гюисманса."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee13d07a-bbfe-4568-aea2-3072cc5c648d",
                        "source_entry_id": "316c1b4d-e02c-3bd4-83b5-6b13693e3e7b",
                        "source_sense_description": "зевать",
                        "target_lang_word": "bâiller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bâiller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4299b10b-1936-3f13-880b-e0163510f76e",
                                        "entry_id": "40b30521-c44c-35c1-af76-38899c1536f3",
                                        "glosses": [
                                            "Réaliser un mouvement réflexe d’inspiration suivi d’une expiration en ouvrant grand la bouche, par fatigue ou par ennui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2435d264-de40-418d-835e-a76175e2cf55",
                                                "sense_id": "4299b10b-1936-3f13-880b-e0163510f76e",
                                                "text": "L’intelligence avec laquelle ce Tourangeau raccommodait le trait cassé rassura le colonel comte d’Aiglemont, qui revint vers la portière en étendant ses bras comme pour détirer ses muscles endormis ; il bâilla, regarda le paysage, et posa la main sur le bras d’une jeune femme soigneusement enveloppée dans un vitchoura."
                                            },
                                            {
                                                "example_id": "befddfbe-a408-4b56-99e3-1153ff9e51a7",
                                                "sense_id": "4299b10b-1936-3f13-880b-e0163510f76e",
                                                "text": "Boyer apprit au parterre à bâiller."
                                            },
                                            {
                                                "example_id": "876a0c9b-5031-4fcc-9da1-af7fd82e8985",
                                                "sense_id": "4299b10b-1936-3f13-880b-e0163510f76e",
                                                "text": "On coupa des baguettes et l’on chercha des perches légères, mais aucune ne se trouva être assez grande pour atteindre la grenouille, qui bâillait toujours, la gueule ouverte, sur sa feuille de nénuphar."
                                            },
                                            {
                                                "example_id": "4338428a-8563-4fee-ae77-ea34675f5130",
                                                "sense_id": "4299b10b-1936-3f13-880b-e0163510f76e",
                                                "text": "Qu’est-ce qu’un amour qui fait bâiller ? Autant vaudrait être dévote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53b47e0a-f064-3c09-9a8d-f0c71d14e290",
                                        "entry_id": "40b30521-c44c-35c1-af76-38899c1536f3",
                                        "glosses": [
                                            "Béer, être ouvert, entrouvert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "448d13e6-bf1c-4a83-a489-3e1c3d8d476a",
                                                "sense_id": "53b47e0a-f064-3c09-9a8d-f0c71d14e290",
                                                "text": "[…] : Liza, grelottant de frayeur, enfonça la clef, tourna une cliche, et respira un bon coup ; la porte bâilla ; nous étions en extase, dans la mansarde de Paterfamilias."
                                            },
                                            {
                                                "example_id": "b244b36c-48c7-4f60-8274-5c2e43a977e3",
                                                "sense_id": "53b47e0a-f064-3c09-9a8d-f0c71d14e290",
                                                "text": "Elle revint habillée d’un tailleur noir, hyper-sexy, la veste bâillant sur une poitrine à damner un intégriste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "878cd819-e1bc-412c-b25c-ee3e6f59af24",
                        "source_entry_id": "316c1b4d-e02c-3bd4-83b5-6b13693e3e7b",
                        "source_sense_description": "пропустить",
                        "target_lang_word": "rater",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rater",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7be9ec62-d1fe-3b23-b8b4-ea6b0cce81e1",
                                        "entry_id": "d07edd4e-d7e0-30d6-8f15-c09c56719a39",
                                        "glosses": [
                                            "Ne pas partir, en parlant d’une arme à feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ed434c0-0c70-49c4-91bd-d7cc473515cd",
                                                "sense_id": "7be9ec62-d1fe-3b23-b8b4-ea6b0cce81e1",
                                                "text": "La compagnie de perdrix partit à la portée de son fusil, mais son fusil rata."
                                            },
                                            {
                                                "example_id": "2bf8e600-bf50-42f6-b035-35e56832e8f0",
                                                "sense_id": "7be9ec62-d1fe-3b23-b8b4-ea6b0cce81e1",
                                                "text": "Son revolver a raté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc4d7f94-c339-3564-ae2a-a13ee2b9e86c",
                                        "entry_id": "d07edd4e-d7e0-30d6-8f15-c09c56719a39",
                                        "glosses": [
                                            "Échouer."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b95c8507-d561-4ef7-9467-5efd3c39fe1a",
                                                "sense_id": "cc4d7f94-c339-3564-ae2a-a13ee2b9e86c",
                                                "text": "Son coup a raté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "425dd027-4b3b-3291-94de-beec478b5b42",
                                        "entry_id": "d07edd4e-d7e0-30d6-8f15-c09c56719a39",
                                        "glosses": [
                                            "Ne pas toucher, manquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4833d45-cb7f-4c07-b85e-b43405aeb2de",
                                                "sense_id": "425dd027-4b3b-3291-94de-beec478b5b42",
                                                "text": "Rater une pièce de gibier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b716f05d-c16c-3841-8361-768900ad0400",
                                        "entry_id": "d07edd4e-d7e0-30d6-8f15-c09c56719a39",
                                        "glosses": [
                                            "Manquer ce qu’on vise."
                                        ],
