                "senses": [
                    {
                        "sense_id": "dd6f9a02-c805-3057-88d6-ec72ba0bc17c",
                        "entry_id": "35d53413-3a90-3878-9ae0-46656ec8461f",
                        "glosses": [
                            "Enlever les frettes de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "139449e3-d858-42b8-9050-1c92493ecc60",
                                "sense_id": "dd6f9a02-c805-3057-88d6-ec72ba0bc17c",
                                "text": "Avant de défretter une basse (ou une guitare, dans quel cas la question se pose doublement) réfléchissez un peu au fait qu’après, le refrettage est (pratiquement) impensable, que la technique de jeu est différente et que vous modifiez carrément la nature de votre instrument."
                            },
                            {
                                "example_id": "d953d076-140f-42a5-97bd-811f8456a322",
                                "sense_id": "dd6f9a02-c805-3057-88d6-ec72ba0bc17c",
                                "text": "Pour défretter une basse je conseille une technique au fer a souder, le fer n'étant pas forcé mais je trouve que ça abîme moins le bois du manche."
                            }
                        ]
                    }
