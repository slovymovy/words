                        ]
                    },
                    {
                        "translation_id": "6a70e357-9bbc-48a3-8936-194bb9404091",
                        "source_entry_id": "c890d8d4-9dd5-359f-971b-5968ccdb2f7b",
                        "source_sense_id": "224a3885-075d-3b6e-ad84-e9edb80fb391",
                        "source_sense_description": "a major change in use or appearance",
                        "target_lang_word": "Instandsetzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Instandsetzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5890e4bb-c69a-395e-8c41-5f2f23f3b747",
                                        "entry_id": "0c683c26-5811-3190-81e0-88b9ea50426e",
                                        "glosses": [
                                            "Vorgang, bei dem ein Objekt in den ursprünglichen, funktionsfähigen Zustand zurückversetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76f19daa-f369-4742-b7b4-49325f37c668",
                                                "sense_id": "5890e4bb-c69a-395e-8c41-5f2f23f3b747",
                                                "text": "Instandsetzung der Mietsache ist die (Wieder-)Herstellung des vertrags- und ordnungsgemäßen Zustandes der Mietsache, etwa durch Reparatur."
                                            },
                                            {
                                                "example_id": "d19b5bcc-64a6-49f6-9a4e-8d0d5fb4c9f0",
                                                "sense_id": "5890e4bb-c69a-395e-8c41-5f2f23f3b747",
                                                "text": "[Die EU-]„Kommission will mit ihrem Vorschlag das Recht auf Instandsetzung von Geräten wie Fernseher, Staubsauger, Geschirrspüler oder Waschmaschinen erstmals gesetzlich festschreiben.“"
                                            },
                                            {
                                                "example_id": "5290c5ae-474c-4e35-8b49-b7572b1609a7",
                                                "sense_id": "5890e4bb-c69a-395e-8c41-5f2f23f3b747",
                                                "text": "„Für die Instandsetzung der Elbchaussee in Hamburg ist am Montag der nächste Abschnitt für den Durchgangsverkehr gesperrt worden.“"
                                            },
                                            {
                                                "example_id": "5fe8cecb-4827-44c0-8669-8edd3cfdcec3",
                                                "sense_id": "5890e4bb-c69a-395e-8c41-5f2f23f3b747",
                                                "text": "„Die Instandsetzungen an der Fahrbahn und an Kunstbauten am Lukmanierpass, der die Kantone Graubünden und Tessin verbindet, verschlingen Dutzende von Millionen Franken.“"
                                            },
                                            {
