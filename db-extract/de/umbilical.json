                ],
                "senses": [
                    {
                        "sense_id": "9301ad98-71e1-3b06-9d29-7757ba064962",
                        "entry_id": "baeefdb6-4179-31d1-8dcd-07a4313e7eac",
                        "glosses": [
                            "Versorgungsleitung (für zum Beispiel Luft, Wasser, Kommunikation, Licht, Video) zwischen einer Person und einer Station mit Vorräten und Ausrüstung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "307b19c7-e882-47a9-8a8d-ae7d5cdad069",
                                "sense_id": "9301ad98-71e1-3b06-9d29-7757ba064962",
                                "text": "„Dieser Schleifring-Übertrager für das Umbilical zum Unterwasser-Arbeits- und Reparaturfahrzeug „SUPRA\" überträgt Energie als Dreiphasenstrom, 3 x 100 A/3kV, und über weitere 55 Ringe die Signale für die digitale Fernsteuerung.“"
                            },
                            {
                                "example_id": "3f696462-b58f-49b4-b090-8e408c1de724",
                                "sense_id": "9301ad98-71e1-3b06-9d29-7757ba064962",
                                "text": "„Er stößt sich von der Glocke ab und schwimmt in das große Unbekannte hinaus, hinter ihm her schlängeln die Nabelschnüre, seine eigene und das Umbilical der Reservemaske.“"
                            },
                            {
                                "example_id": "abe6baf8-5b63-4ba9-8414-ba583fc56553",
                                "sense_id": "9301ad98-71e1-3b06-9d29-7757ba064962",
                                "text": "„Dies kann über ein Umbilical von der Oberfläche erfolgen oder durch mitgeführte Atemgasvorräte in einer Flaschenbatterie, Abb 9.10. Die individuelle Taucherversorgung geschieht über ein im Innern der Kuppel installiertes BIBS-System.“"
                            },
                            {
                                "example_id": "b0e02e47-ac4e-46e6-826b-bc0d676e8e58",
                                "sense_id": "9301ad98-71e1-3b06-9d29-7757ba064962",
                                "text": "„Die Energieversorgung erfolgt über ein Umbilical vom Schlepper/Begleitfahrzeug aus.“"
                            },
                            {
                                "example_id": "a5889897-bad7-4ae1-86d2-20f3d6159511",
                                "sense_id": "9301ad98-71e1-3b06-9d29-7757ba064962",
                                "text": "„Er lebt und arbeitet unter dem der Wassertiefe entsprechenden Druck und wird durch das Umbilical mit seinem Atemgas, ein Helium-Sauerstoffgemisch, und Warmwasser versorgt.“"
                            },
                            {
                                "example_id": "5cdac9f6-7aac-49a7-bcb0-f2fd94824ec6",
                                "sense_id": "9301ad98-71e1-3b06-9d29-7757ba064962",
                                "text": "Das Umbilical liegt beim Offshore-Tauchen zwischen Taucher und Tauchglocke bzw. PTC."
                            },
                            {
                                "example_id": "72d0a279-718a-488b-913f-e17cc190cae7",
                                "sense_id": "9301ad98-71e1-3b06-9d29-7757ba064962",
                                "text": "Das Umbilical verbindet in der Aquanautik Aquanaut und Unterwasserstation bei Exkursions-Tauchgängen."
                            },
                            {
                                "example_id": "e6a4c83a-dad0-4950-b3cf-6d45eee03d58",
                                "sense_id": "9301ad98-71e1-3b06-9d29-7757ba064962",
                                "text": "Das Umbilical ist in der Astronautik die Versorgungsleitung zwischen Astronaut und Raumschiff bei Ausstiegen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
