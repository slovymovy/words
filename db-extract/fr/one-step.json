                "senses": [
                    {
                        "sense_id": "c6fe0b69-5f89-3f84-855f-3b3538c87e33",
                        "entry_id": "81e8adc4-b824-369d-8970-4f4357d3ce69",
                        "glosses": [
                            "Danse de salon américaine popularisée au début du XXᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a542334f-5f20-4592-8529-77c7be72fb3e",
                                "sense_id": "c6fe0b69-5f89-3f84-855f-3b3538c87e33",
                                "text": "Elle ne dansa plus qu’un one step et se sentit légèrement fatiguée car la chaleur, à laquelle elle n’était pas habituée, la surprenait."
                            },
                            {
                                "example_id": "860ab2eb-8bea-4118-b9c9-f5d4a03497b8",
                                "sense_id": "c6fe0b69-5f89-3f84-855f-3b3538c87e33",
                                "text": "Mais je savais, sans qu’il eût à me le dire, qu’il regrettait ses soirées d’hiver du Sud, où, au son d’un violon endiablé, on danse des reels et one steps, et où les filles, serrées de près, gloussent des petits rires hystériques."
                            },
                            {
                                "example_id": "207bbc38-7234-41bd-99b4-307c54043e2a",
                                "sense_id": "c6fe0b69-5f89-3f84-855f-3b3538c87e33",
                                "text": "Un garçon et une fille, blonds sans alliage, reprennent en souriant, un one-step qu’ils ont peut-être dansé pour la première fois dans le hall d’une université américaine."
                            },
                            {
                                "example_id": "fb5a6feb-6a78-4aaf-b791-ae8bb218b3ea",
                                "sense_id": "c6fe0b69-5f89-3f84-855f-3b3538c87e33",
                                "text": "C’est d’ailleurs au travers de la danse qu’il est arrivé en Europe, particulièrement en France : avec les one-steps, two-steps, charlestons, scottishs, boogie-woogies, et les claquettes."
                            },
                            {
                                "example_id": "7303db52-ba38-48c3-a328-131bb99214d9",
                                "sense_id": "c6fe0b69-5f89-3f84-855f-3b3538c87e33",
                                "text": "Il s’agit bien sûr du fox-trot, du one-step et du shimmy, les danses américaines de salon de l’époque."
                            }
                        ]
                    }
                ],
