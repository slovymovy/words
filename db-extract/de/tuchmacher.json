                "senses": [
                    {
                        "sense_id": "ccb9818c-2605-3827-81a6-38c496cd7cbf",
                        "entry_id": "7de713c7-90bf-3a90-81ef-8089bca8f92f",
                        "glosses": [
                            "jemand, der Tuche herstellt"
                        ],
                        "tags": [
                            "Handwerk"
                        ],
                        "examples": [
                            {
                                "example_id": "c19092c7-a133-4a3d-9987-83bb01c9ea72",
                                "sense_id": "ccb9818c-2605-3827-81a6-38c496cd7cbf",
                                "text": "„Die Ratsherren handelten einig, entschlossen und ohne jede Rücksicht, die Tuchmacher uneins, unentschlossen und mit viel Vorsicht.“"
                            },
                            {
                                "example_id": "b659c645-a04e-4543-8a0e-c4856ea9c17e",
                                "sense_id": "ccb9818c-2605-3827-81a6-38c496cd7cbf",
                                "text": "„Es verfügte über ein Krankenhaus und eine mehrgliedrige Schule, es gab Tuchmacher im Ort, viele Handwerker, ein paar Schenken und einen hübschen Marktplatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
