                        ],
                        "form": "rayonnante"
                    },
                    {
                        "form_id": "9da32809-1604-427a-bc22-c614a6db40ea",
                        "entry_id": "4751f6b4-704d-3807-a095-6c48231a5b09",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "rayonnantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ec56f08-6e74-39b1-829b-f12889bf120a",
                        "entry_id": "4751f6b4-704d-3807-a095-6c48231a5b09",
                        "glosses": [
                            "Qui rayonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6e16864-52f3-4da9-b039-18d706f1b471",
                                "sense_id": "4ec56f08-6e74-39b1-829b-f12889bf120a",
                                "text": "Rayonnant de lumière. - Moïse, descendant de la montagne, parut le visage tout rayonnant."
                            }
                        ]
                    },
                    {
                        "sense_id": "dae762ba-4a62-3494-8578-34228387f800",
                        "entry_id": "4751f6b4-704d-3807-a095-6c48231a5b09",
                        "glosses": [
                            "Qui est radieux et qui répand une heureuse impression à l’entour."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "aea77d11-8678-47a9-93cb-7ee226d669fe",
                                "sense_id": "dae762ba-4a62-3494-8578-34228387f800",
                                "text": "La marquise était restée debout et Solange, qui ne se lassait pas d’admirer sa rayonnante beauté, ne songeait pas à la prier de s’asseoir ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ed00647-3993-314d-868c-78d49b06212e",
                        "entry_id": "4751f6b4-704d-3807-a095-6c48231a5b09",
                        "glosses": [
                            "Qui vient d’acquérir beaucoup de gloire, de renommée."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "62db84f6-143f-4a1a-b686-1fb6232fab4b",
                                "sense_id": "7ed00647-3993-314d-868c-78d49b06212e",
                                "text": "Être tout rayonnant de gloire."
                            }
                        ]
                    },
                    {
                        "sense_id": "2632c00f-127a-3104-8935-4c36e0a736d3",
                        "entry_id": "4751f6b4-704d-3807-a095-6c48231a5b09",
                        "glosses": [
                            "Dont la figure exprime une vive satisfaction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4b914c9-0f5a-4441-8ce4-a5e2395cbb4c",
                                "sense_id": "2632c00f-127a-3104-8935-4c36e0a736d3",
                                "text": "Lorsque Othon se releva le front paré de la toque qu’il venait de gagner, son visage était rayonnant de joie et de bonheur."
                            },
                            {
                                "example_id": "7234dba7-fd95-4b07-9785-e610d090b624",
                                "sense_id": "2632c00f-127a-3104-8935-4c36e0a736d3",
                                "text": "Elle l’embrassa, et l’enfant partit,\nTout rayonnant qu’on le pardonne."
                            },
                            {
                                "example_id": "49909ae9-aa35-48be-badf-28ffe26f6e40",
                                "sense_id": "2632c00f-127a-3104-8935-4c36e0a736d3",
                                "text": "Yves fixait de ses yeux rayonnants la figure amicale du garçon qui prit son verre d’une main un peu tremblante."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea20b871-f127-316f-99a3-aae5ed44d4c8",
                        "entry_id": "4751f6b4-704d-3807-a095-6c48231a5b09",
                        "glosses": [
                            "Qui est disposé en rayons."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "57d11e18-36c3-3fd3-a485-be7fe58f7989",
                        "entry_id": "4751f6b4-704d-3807-a095-6c48231a5b09",
                        "glosses": [
                            "Qui a des fleurs régulières au centre et des fleurs irrégulières plus grandes à la circonférence."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "2e79d4f1-76a9-4bef-a860-192889a7cbcf",
                                "sense_id": "57d11e18-36c3-3fd3-a485-be7fe58f7989",
                                "text": "Ombelle rayonnante, capitule rayonnant."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c9cc9ca-9f5e-333f-a629-e702367046b6",
                        "entry_id": "4751f6b4-704d-3807-a095-6c48231a5b09",
                        "glosses": [
                            "Qui est disposé en rayons, autour du chœur dans l'architecture religieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a89b8e77-d168-4bd6-8645-98c5acf1b198",
                                "sense_id": "6c9cc9ca-9f5e-333f-a629-e702367046b6",
                                "text": "Chapelles rayonnantes."
                            }
                        ]
                    },
                    {
                        "sense_id": "29067063-c265-35ae-a610-8ab046c3be93",
                        "entry_id": "4751f6b4-704d-3807-a095-6c48231a5b09",
                        "glosses": [
                            "Qui porte entre ses rais des petits rayons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9a96af5-f23e-44d1-a775-2c1f06367192",
                                "sense_id": "29067063-c265-35ae-a610-8ab046c3be93",
                                "text": "Étoile rayonnante."
                            }
                        ]
                    }
                ],
