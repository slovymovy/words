                    },
                    {
                        "translation_id": "57bbd090-5437-40b5-8492-9b57b6bd86a9",
                        "source_entry_id": "0a644776-d465-306c-829f-5e60cb2d1089",
                        "source_sense_id": "fe336278-b48c-3772-9eb0-2a1181b93235",
                        "source_sense_description": "a disaccharide",
                        "target_lang_word": "saccharose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saccharose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                        "entry_id": "8661d7d8-702a-37e7-b446-f7a728584e0d",
                                        "glosses": [
                                            "Diholoside formé par la condensation d’une molécule de glucose et d’une molécule de fructose, extrait de la canne à sucre ou de la betterave sucrière et utilisé comme sucre de table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1daccddb-7e32-4939-8013-9133d37f1f54",
                                                "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                                "text": "Si l’on porte la saccharose à une température élevée, il se forme des produits qui ont été désignés sous les noms d’acide caramélique, de caramélan, etc. Ces produits sont noirs, impossibles à purifier, et paraissent être le résultat d’une condensation moléculaire."
                                            },
                                            {
                                                "example_id": "8f677c5c-faa0-41e8-8e42-69a49ccf3f68",
                                                "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                                "text": "Le sirop de sucre ou sirop simple est un liquide sirupeux constitué par une solution de sucre dans l'eau. Le sirop de sucre ou sirop simple contiendra au moins 60 p. c. de saccharose."
                                            },
                                            {
                                                "example_id": "a5500a21-331d-4de8-be9f-3e9719b192a9",
                                                "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                                "text": "Deux plantes ont une richesse en saccharose beaucoup plus importante : la canne à sucre (qui contient 20 % de saccharose), connue depuis l’Antiquité, et la betterave sucrière (dont la racine en contient 18,7 %), qui sont aujourd’hui les deux sources principales de sucre."
                                            },
                                            {
                                                "example_id": "077ba571-e7f7-4dab-af41-85a0935f4b76",
                                                "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                                "text": "Le saccharose, encore nommé commercialement « sucre », est le glucide de référence en matière de pouvoir sucrant."
                                            },
                                            {
                                                "example_id": "73861cc3-6070-4ca3-a03a-384e956409e5",
                                                "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                                "text": "Afin d’entrer dans la glycolyse les carbones des glucides de réserve comme l’amidon, le saccharose ou les fructosanes, doit d'abord être hydrolysé sous forme de glucose ou de fructose puis converti en fructose-1,6-biphosphate."
                                            },
                                            {
                                                "example_id": "14bacd07-d999-4e1c-a7dd-d6fdd0e3da93",
                                                "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                                "text": "Et le sucre emprunte parfois un pseudo : saccharose, sirop de glucose ou sirop de fructose."
                                            },
                                            {
                                                "example_id": "955c9ef9-cf1f-414a-ac45-ace45e492efb",
                                                "sense_id": "6319f146-6073-3f85-be42-bb4716ce5718",
                                                "text": "Pendant longtemps, ce sucre ajouté était exclusivement du saccharose extrait de la betterave ou de la canne, une molécule qui combine une molécule de glucose et une molécule de fructose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab7377a6-e980-498b-ab07-6747f0e0c9a4",
