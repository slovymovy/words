                "senses": [
                    {
                        "sense_id": "b65b986f-4797-3623-aa19-a25614a583af",
                        "entry_id": "b8259f43-697e-3062-b9d0-49f5e4196ca0",
                        "glosses": [
                            "Flasche, die nach einmaligem Gebrauch weggeworfen wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "dfa17216-b083-4118-b054-3b07b173e815",
                                "sense_id": "b65b986f-4797-3623-aa19-a25614a583af",
                                "text": "„‚Verantwortlich sind zum einen Discounter wie Lidl und Aldi, die ausschließlich auf Ex-und-hopp-Flaschen setzen; zum anderen Einweg-Getränkehersteller, die über eine irreführende Produktkennzeichnung die Erkennungsmerkmale von Ein- und Mehrwegverpackungen verwischen.‘“"
                            },
                            {
                                "example_id": "e7da1427-ff87-46ce-9c9c-067d8d22cb74",
                                "sense_id": "b65b986f-4797-3623-aa19-a25614a583af",
                                "text": "„Zu dem Erfolg der Ex-und-hopp-Flaschen trägt vor allem das Mineralwasser bei.“"
                            },
                            {
                                "example_id": "d5e78bbd-c513-4d3f-a0ed-4905f89addf2",
                                "sense_id": "b65b986f-4797-3623-aa19-a25614a583af",
                                "text": "„Warum soll ein Verbraucher noch Pfandflaschen teuer erstehen, das Leergut zu Hause lagern und dann ins Geschäft zurücktragen, wenn die Ex-und-hopp-Flasche mit dem grünen Punkt einfach und ohne Gewissensbisse loszuwerden ist?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
