{
    "word_family": [
        "tight",
        "tightness",
        "tightly",
        "tightener"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d0d9e918-93ab-3604-b106-9474797b5448",
                    "sense_definition": "To make something more firm, fixed, or less loose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_tension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>tighten</w> that screw a quarter-turn to stop the wobbling.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>подтяните</w> этот винт на четверть оборота, чтобы он не шатался."
                            }
                        },
                        {
                            "text": "You should <w>tighten</w> your grip on the handle so you do not drop it.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>сжать</w> рукоятку покрепче, чтобы не уронить её."
                            }
                        }
                    ],
                    "synonyms": [
                        "clench",
                        "tauten",
                        "tense"
                    ],
                    "antonyms": [
                        "loosen"
                    ],
                    "common_phrases": [
                        "tighten a screw",
                        "tighten your grip",
                        "tighten the bolts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо более прочным, закрепленным или менее свободным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затянуть",
                                "target_lang_sense_clarification": "болты, гайки, узлы"
                            },
                            {
                                "target_lang_word": "подтянуть",
                                "target_lang_sense_clarification": "крепления или хватку"
                            },
                            {
                                "target_lang_word": "натянуть",
                                "target_lang_sense_clarification": "веревку или струну"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "660b9059-82c0-3b9f-8fe5-77db00c80176",
                    "sense_definition": "To become more firm, fixed, or less loose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_tension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That wooden joint is <w>tightening</w> as the wood dries out over time.",
                            "target_lang_translations": {
                                "ru": "Это деревянное соединение <w>уплотняется</w> по мере того, как дерево со временем высыхает."
                            }
                        },
                        {
                            "text": "His muscles began to <w>tighten</w> as he prepared for the race.",
                            "target_lang_translations": {
                                "ru": "Его мышцы начали <w>напрягаться</w>, когда он готовился к забегу."
                            }
                        }
                    ],
                    "synonyms": [
                        "constrict",
                        "tauten"
                    ],
                    "antonyms": [
                        "loosen"
                    ],
                    "common_phrases": [
                        "muscles tighten",
                        "chest tightens"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться более прочным, закрепленным или менее свободным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натягиваться",
                                "target_lang_sense_clarification": "о тросе или мышцах"
                            },
                            {
                                "target_lang_word": "сжиматься",
                                "target_lang_sense_clarification": "о мышцах или груди"
                            },
                            {
                                "target_lang_word": "затягиваться",
                                "target_lang_sense_clarification": "об узлах или соединениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6d44f4f-db07-3075-a654-df8e3264ed68",
                    "sense_definition": "To make rules, laws, or financial conditions more strict or difficult.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>tighten</w> security at the airport after the incident.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>усилить</w> меры безопасности в аэропорту после инцидента."
                            }
                        },
                        {
                            "text": "If the central bank does not <w>tighten</w> the money supply, inflation will rise.",
                            "target_lang_translations": {
                                "ru": "Если центральный банк не <w>ограничит</w> денежную массу, инфляция вырастет."
                            }
                        }
                    ],
                    "synonyms": [
                        "constrict"
                    ],
                    "common_phrases": [
                        "tighten security",
                        "tighten the rules",
                        "tighten the belt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать правила, законы или финансовые условия более строгими."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужесточить",
                                "target_lang_sense_clarification": "правила, контроль или меры"
                            },
                            {
                                "target_lang_word": "усилить",
                                "target_lang_sense_clarification": "безопасность или надзор"
                            },
                            {
                                "target_lang_word": "затянуть",
                                "target_lang_sense_clarification": "в выражении «затянуть пояса»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbb2564f-4821-3359-93f9-d39f069a1657",
                    "sense_definition": "To raise short-term interest rates in order to control the economy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Fed is expected to <w>tighten</w> by a quarter-point at the next meeting.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что ФРС <w>повысит ставку</w> на четверть пункта на следующем заседании."
                            }
                        },
                        {
                            "text": "Economists predict the bank will <w>tighten</w> monetary policy to combat rising prices.",
                            "target_lang_translations": {
                                "ru": "Экономисты прогнозируют, что банк будет <w>ужесточать</w> монетарную политику для борьбы с ростом цен."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tighten monetary policy"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "financial context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повысить краткосрочные процентные ставки для контроля экономики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужесточить",
                                "target_lang_sense_clarification": "денежно-кредитную политику"
                            },
                            {
                                "target_lang_word": "повысить ставки",
                                "target_lang_sense_clarification": "в финансовом контексте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}