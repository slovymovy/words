                                "target_senses": [
                                    {
                                        "sense_id": "7476dbc1-2e73-3454-ac3c-a98a92282515",
                                        "entry_id": "ff2e95f6-5408-3155-9c60-0fbacd2eaf3b",
                                        "glosses": [
                                            "The quality of being astute."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d18a57e-2dc1-4017-96d2-5db5d4234f7b",
                                                "sense_id": "7476dbc1-2e73-3454-ac3c-a98a92282515",
                                                "text": "Soda was added to an interval pregnant with legal stultifications, and the trooper continued to say nothing till he had taken a swig at his almost neat whisky. It fulfilled its function of humanizing him on the spot, though he refused to concede his astuteness to a mere gulp of liquor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa2373bd-aaa0-4d8c-82f2-c3b8dea08ae4",
                        "source_entry_id": "09bcd8ad-4700-35c0-8620-fb10612be486",
                        "source_sense_id": "b6c4d2c0-6116-31f1-948f-da2d01f6f9cf",
                        "target_lang_word": "vykutálenost",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b20c2943-b1a9-4920-91ff-5d9d90173f18",
                        "source_entry_id": "09bcd8ad-4700-35c0-8620-fb10612be486",
                        "source_sense_id": "b6c4d2c0-6116-31f1-948f-da2d01f6f9cf",
                        "target_lang_word": "fourberie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fourberie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb24f5d3-6640-32b9-8920-944fdd3098d0",
                                        "entry_id": "51714624-e28e-3a82-8794-9038490d3a27",
                                        "glosses": [
                                            "Tromperie basse et odieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8080cde0-1f4a-4458-b836-d3fc68a6c8db",
                                                "sense_id": "eb24f5d3-6640-32b9-8920-944fdd3098d0",
                                                "text": "Dans les premiers stades de la vie de groupe, la fourberie l’emporte sur la droiture (ou l’honnêteté). C’est seulement au stade supérieur de civilisation que la fourberie devient méprisée."
                                            },
                                            {
                                                "example_id": "07345b73-329f-4162-a11b-6b5167164c5a",
                                                "sense_id": "eb24f5d3-6640-32b9-8920-944fdd3098d0",
                                                "text": "Vieux... et sourd. Une catastrophe pour le chanteur, mais pas nécessairement pour l'homme. \"Être sourd n'est pas un malheur quand on sait tout ce qui se dit : ce serait même un bonheur dans ce monde de fourberies\", confiait-il avec sarcasme au cinéaste Fraser."
                                            },
                                            {
                                                "example_id": "552941f9-1e42-4f71-92a6-cc43e3fe9aaf",
                                                "sense_id": "eb24f5d3-6640-32b9-8920-944fdd3098d0",
                                                "text": "Faire une fourberie, des fourberies."
                                            },
                                            {
                                                "example_id": "5b98a1b4-31a0-473c-8500-50daf44c59cf",
                                                "sense_id": "eb24f5d3-6640-32b9-8920-944fdd3098d0",
                                                "text": "Une fourberie insigne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d80b73f3-acc7-3735-884b-ca6b42dbfcce",
                                        "entry_id": "51714624-e28e-3a82-8794-9038490d3a27",
                                        "glosses": [
                                            "Disposition à tromper avec une adresse perfide et odieuse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6521cf5-be07-4d1b-8db9-78c55e419f1a",
                                                "sense_id": "d80b73f3-acc7-3735-884b-ca6b42dbfcce",
                                                "text": "…, mais, vu notre choix d’un acteur adolescent qui jouerait l’enthousiasme de la jeunesse d’Agnès ainsi que la fourberie propre à Dom Juan enfantin, notre interprétation nous détournait donc subrepticement du choix envisagé par l’auteur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "362443b5-ffb1-4710-95f5-2cc7f4cb13f1",
                        "source_entry_id": "09bcd8ad-4700-35c0-8620-fb10612be486",
                        "source_sense_id": "b6c4d2c0-6116-31f1-948f-da2d01f6f9cf",
                        "target_lang_word": "ruse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ecb2af1-ee1c-388c-8459-b23201ae04cd",
                                        "entry_id": "d8c0d0ed-9787-3b69-bf73-4d4deb3eaa85",
                                        "glosses": [
                                            "Procédé ingénieux utilisé pour avoir le dessus sur un ennemi, échapper à un prédateur ou abuser une victime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0d2796b-333e-41be-a2df-f38e918bb4dc",
                                                "sense_id": "5ecb2af1-ee1c-388c-8459-b23201ae04cd",
                                                "text": "La férocité ancienne tend à être remplacée par la ruse et beaucoup de sociologues estiment que c'est là un progrès sérieux ; quelques philosophes qui n'ont pas l'habi­tude de suivre les opinions du troupeau, ne voient pas très bien en quoi cela constitue le progrès au point de vue de la morale."
                                            },
                                            {
                                                "example_id": "af52836a-883e-4f1a-aff7-cfe86d903987",
                                                "sense_id": "5ecb2af1-ee1c-388c-8459-b23201ae04cd",
                                                "text": "Privé de tout accommodement, de ses fards, de ses sourires et de ses ruses, le vice a peu de chance de séduire la vertu la plus chancelante."
                                            },
                                            {
                                                "example_id": "6e25bce4-2e5b-47c9-8228-2242314aef2c",
                                                "sense_id": "5ecb2af1-ee1c-388c-8459-b23201ae04cd",
                                                "text": "Toutes les ruses, il les imagine et les déploie avec un machiavélisme qui parfois lui pèse."
                                            },
                                            {
                                                "example_id": "2bf46d98-b180-42aa-90c6-309dd3930f9d",
                                                "sense_id": "5ecb2af1-ee1c-388c-8459-b23201ae04cd",
                                                "text": "Ruses innocentes : Petites finesses que l’on emploie sans mauvaise intention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8470f38b-2219-3270-b720-50dbe0da4aa7",
                                        "entry_id": "d8c0d0ed-9787-3b69-bf73-4d4deb3eaa85",
                                        "glosses": [
                                            "Talent qu’a une personne à tromper autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec2ecd84-a738-492b-9c56-37200da43b7a",
                                                "sense_id": "8470f38b-2219-3270-b720-50dbe0da4aa7",
                                                "text": "Ce brigand était plus célèbre pour sa ruse que pour son courage."
                                            },
                                            {
                                                "example_id": "a9e41714-6446-4fed-bb57-56735247437e",
                                                "sense_id": "8470f38b-2219-3270-b720-50dbe0da4aa7",
                                                "text": "Il est plein de ruse et de malice."
                                            },
                                            {
                                                "example_id": "3a5c6844-fc22-4335-98fc-82e73ab8ac29",
                                                "sense_id": "8470f38b-2219-3270-b720-50dbe0da4aa7",
                                                "text": "Il a de la ruse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "839c190a-c337-3618-9181-77ccd7a7eb80",
                                        "entry_id": "d8c0d0ed-9787-3b69-bf73-4d4deb3eaa85",
                                        "glosses": [
                                            "Les détours dont le lièvre, le cerf, le renard, etc., se servent quand on les chasse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
