                                "target_senses": [
                                    {
                                        "sense_id": "06f24304-641f-3706-8337-bac676aa7858",
                                        "entry_id": "67944227-b5fc-3a6d-875f-42e3ecbba432",
                                        "glosses": [
                                            "Dont l’usage est utile et agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecbaad3b-2e76-4e67-be78-c13ec5fc40c3",
                                                "sense_id": "06f24304-641f-3706-8337-bac676aa7858",
                                                "text": "Maison commode."
                                            },
                                            {
                                                "example_id": "937b693d-fde3-4ee5-9689-ff22a75a35a7",
                                                "sense_id": "06f24304-641f-3706-8337-bac676aa7858",
                                                "text": "Un meuble commode."
                                            },
                                            {
                                                "example_id": "518c627c-40bc-44be-ab6e-11ab7e8a8291",
                                                "sense_id": "06f24304-641f-3706-8337-bac676aa7858",
                                                "text": "Vie commode, Vie agréable et tranquille."
                                            },
                                            {
                                                "example_id": "c64a3fe7-db4d-4ad2-89a4-9356db51f443",
                                                "sense_id": "06f24304-641f-3706-8337-bac676aa7858",
                                                "text": "Mener une vie commode."
                                            },
                                            {
                                                "example_id": "a1229554-d7c2-4a33-9c7d-51baaab98388",
                                                "sense_id": "06f24304-641f-3706-8337-bac676aa7858",
                                                "text": "Rendre la vie commode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac79bb47-cfc2-3fde-9a85-4bee9fa332ea",
                                        "entry_id": "67944227-b5fc-3a6d-875f-42e3ecbba432",
                                        "glosses": [
                                            "En parlant des personnes, être d’une société douce et aisée, d’un bon commerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5175b495-6145-4da2-b48b-3e96dfbf235f",
                                                "sense_id": "ac79bb47-cfc2-3fde-9a85-4bee9fa332ea",
                                                "text": "Être commode à vivre."
                                            },
                                            {
                                                "example_id": "f6531695-41c6-451a-9476-d4c7b3c5b46c",
                                                "sense_id": "ac79bb47-cfc2-3fde-9a85-4bee9fa332ea",
                                                "text": "Avoir l’humeur, un caractère commode."
                                            },
                                            {
                                                "example_id": "95023109-2720-4401-b1a4-5d850dd3ec93",
                                                "sense_id": "ac79bb47-cfc2-3fde-9a85-4bee9fa332ea",
                                                "text": "Il n'a pas l’air commode, celui-là ! Se dit d’une personne sévère, exigeante, froide, qui semble difficile à approcher ou avec laquelle on ne peut pas plaisanter."
                                            },
                                            {
                                                "example_id": "9ce5cb61-b21f-4462-b67a-802f573c221f",
                                                "sense_id": "ac79bb47-cfc2-3fde-9a85-4bee9fa332ea",
                                                "text": "C’est un maître commode, fort commode, C’est un homme qui ne rudoie pas ses domestiques, qui ne les charge pas de trop de travail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f60c03c-4ec5-38e4-96f0-81c72b71c189",
                                        "entry_id": "67944227-b5fc-3a6d-875f-42e3ecbba432",
                                        "glosses": [
                                            "Qui est trop indulgent, trop facile. Ainsi on dit d’un mari qui ferme les yeux sur la mauvaise conduite de sa femme et d’une femme qui donne trop de liberté à sa fille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75f53b6c-6c95-4f59-8d29-f1a67adb1f1a",
                                                "sense_id": "1f60c03c-4ec5-38e4-96f0-81c72b71c189",
                                                "text": "C’est un mari commode"
                                            },
                                            {
                                                "example_id": "1ad4f9f7-2254-4c6c-9e12-79349f431389",
                                                "sense_id": "1f60c03c-4ec5-38e4-96f0-81c72b71c189",
                                                "text": "C’est une mère commode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f54633ec-d7a5-35b4-96a1-62de71376343",
                                        "entry_id": "67944227-b5fc-3a6d-875f-42e3ecbba432",
                                        "glosses": [
                                            "Qui est relâché."
                                        ],
                                        "tags": [
                                            "Morale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "855e4b4b-ab9d-4cf7-aed5-9bcd93b78e19",
                                                "sense_id": "f54633ec-d7a5-35b4-96a1-62de71376343",
                                                "text": "Avoir une dévotion commode, une morale commode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fdf7a77-087a-350b-86a7-f6499c670d0c",
                                        "entry_id": "67944227-b5fc-3a6d-875f-42e3ecbba432",
                                        "glosses": [
                                            "Se dit aussi, familièrement et ironiquement, pour signifier qu’on ne met pas assez de façons aux choses, qu’on cherche plus ce qui est aisé que ce qui est convenable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10d34f28-e9d0-4b78-bfae-be09b0585457",
                                                "sense_id": "4fdf7a77-087a-350b-86a7-f6499c670d0c",
                                                "text": "Il aurait aimé pouvoir se réfugier derrière de fallacieux prétextes, bien commodes."
                                            },
                                            {
                                                "example_id": "01a4a3f7-73d9-421e-b97e-b7fb582724ca",
                                                "sense_id": "4fdf7a77-087a-350b-86a7-f6499c670d0c",
                                                "text": "Répondre par une simple dénégation, c’est commode."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "commode",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "700225c7-9fee-33a8-8007-9b5c743944bc",
                                        "entry_id": "f4807363-9239-3777-9bb0-3f50c5e4a866",
                                        "glosses": [
                                            "Nom donné à certain type d'armoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3362787e-61bf-4650-aea3-478cbb62e6e7",
                                                "sense_id": "700225c7-9fee-33a8-8007-9b5c743944bc",
                                                "text": "Je vais monter une armoire : c’est une commode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f53df152-95eb-3a06-8efc-d270791f4e98",
                                        "entry_id": "f4807363-9239-3777-9bb0-3f50c5e4a866",
                                        "glosses": [
                                            "Meuble à hauteur d’appui, garni de tiroirs et servant particulièrement à ranger du linge et des habits."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0478e9d-332f-4e0c-8008-a2d52416dc9c",
                                                "sense_id": "f53df152-95eb-3a06-8efc-d270791f4e98",
                                                "text": "Où, avec génie, du reste, avez-vous caché le bouquetier de faïence qui sera pour votre chambre ? Je le cherche depuis quelques heures, dans la commode, le petit placard, l'office, en vain : et le plateau à thé ?"
                                            },
                                            {
                                                "example_id": "c7e3c437-9ff1-4f79-9814-f25ecd91237f",
                                                "sense_id": "f53df152-95eb-3a06-8efc-d270791f4e98",
                                                "text": "Il regardait la coiffeuse, se défiait du lit qu’il n’osait jamais contempler en face et s’approchait de la commode, non pour découvrir des secrets, mais pour regarder au jour la physionomie des tiroirs qu’il ouvrait et voir, en quelque sorte, comment ils se portaient."
                                            },
                                            {
                                                "example_id": "5614a32b-b542-4f38-a0bc-852eca242cc7",
                                                "sense_id": "f53df152-95eb-3a06-8efc-d270791f4e98",
                                                "text": "Ce nom de Trognon lui fit entrevoir quelque machination, il crut à quelque vice de forme projeté par avance, à quelque infidélité préméditée par la Cibot, et il résolut de se servir de ce Trognon pour se faire dicter un testament olographe qu’il cachèterait et serrerait dans le tiroir de sa commode."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
