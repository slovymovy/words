                "senses": [
                    {
                        "sense_id": "ad06d5e9-ad72-3cd4-a7ee-59b6c03454f3",
                        "entry_id": "57957d06-0ec0-31c2-a243-4c97e673c8eb",
                        "glosses": [
                            "Pièce réservée aux enfants"
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "02e62b02-c6f0-48bf-aec9-373c4544e5dc",
                                "sense_id": "ad06d5e9-ad72-3cd4-a7ee-59b6c03454f3",
                                "text": "Il embrassait sa femme, s’enfermait dans son cabinet, la retrouvait pour les repas. Elle attendait un enfant et il en était heureux. Il eut une fille et il passa trois ou quatre fois par jour dans la nursery."
                            },
                            {
                                "example_id": "f0f2ac6c-a27c-48c5-bcbe-c514933431cf",
                                "sense_id": "ad06d5e9-ad72-3cd4-a7ee-59b6c03454f3",
                                "text": "Moi qui n'avais eu de l'enfance que la cruauté, que faisais-je donc là, dans cette nursery amusante, avec ses jouets et ses livres en désordre par terre, sa tapisserie bleue et sa grande fenêtre encadrant un matin de printemps gris ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4f485ad-a685-4455-b62a-3a9b0f34176d",
                        "source_entry_id": "57957d06-0ec0-31c2-a243-4c97e673c8eb",
                        "source_sense_id": "ad06d5e9-ad72-3cd4-a7ee-59b6c03454f3",
