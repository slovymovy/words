{
    "word_family": [
        "waarheid",
        "waar"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7b6970fe-90fd-356c-89d9-99cf92b3f15b",
                    "sense_definition": "Echt, authentiek of overeenkomstig de werkelijkheid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waarheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit is een <w>waarachtig</w> verhaal over zijn avonturen in het buitenland.",
                            "target_lang_translations": {
                                "en": "This is a <w>true</w> story about his adventures abroad."
                            }
                        },
                        {
                            "text": "Zij toonde een <w>waarachtige</w> interesse in de geschiedenis van de stad.",
                            "target_lang_translations": {
                                "en": "She showed a <w>genuine</w> interest in the history of the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "echt"
                    ],
                    "antonyms": [
                        "onwaarachtig"
                    ],
                    "target_lang_definitions": {
                        "en": "Real, authentic, or conforming to reality."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "true",
                                "target_lang_sense_clarification": "conforming to reality or fact"
                            },
                            {
                                "target_lang_word": "genuine",
                                "target_lang_sense_clarification": "authentic, real"
                            },
                            {
                                "target_lang_word": "authentic",
                                "target_lang_sense_clarification": "real and original"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf9fc264-6063-3dd5-aef5-784a5ae692dc",
                    "sense_definition": "Oprecht, betrouwbaar en eerlijk in gedrag.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "waarheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is een <w>waarachtig</w> mens die altijd zijn woord houdt.",
                            "target_lang_translations": {
                                "en": "He is a <w>sincere</w> person who always keeps his word."
                            }
                        },
                        {
                            "text": "De politicus gaf een <w>waarachtig</w> antwoord op de lastige vragen.",
                            "target_lang_translations": {
                                "en": "The politician gave an <w>honest</w> answer to the difficult questions."
                            }
                        }
                    ],
                    "synonyms": [
                        "oprecht"
                    ],
                    "target_lang_definitions": {
                        "en": "Sincere, reliable, and honest in character or behavior."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sincere",
                                "target_lang_sense_clarification": "free from pretense or deceit"
                            },
                            {
                                "target_lang_word": "honest",
                                "target_lang_sense_clarification": "truthful and sincere"
                            },
                            {
                                "target_lang_word": "true",
                                "target_lang_sense_clarification": "faithful, loyal, and honest"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d126dc8d-b208-3d43-a434-b8d13c71e65a",
                    "sense_definition": "Inderdaad of zowaar, gebruikt om verbazing uit te drukken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bevestiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kijk eens, daar staat <w>waarachtig</w> iemand op de bus te wachten.",
                            "target_lang_translations": {
                                "en": "Look, there is <w>actually</w> someone waiting for the bus."
                            }
                        },
                        {
                            "text": "Het lijkt <w>waarachtig</w> wel of het vandaag eindelijk gaat sneeuwen.",
                            "target_lang_translations": {
                                "en": "It <w>really</w> seems as though it is finally going to snow today."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Actually or indeed, used to convey surprise."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "actually",
                                "target_lang_sense_clarification": "contrary to expectations, expressing surprise"
                            },
                            {
                                "target_lang_word": "really",
                                "target_lang_sense_clarification": "in fact, surprisingly"
                            },
                            {
                                "target_lang_word": "indeed",
                                "target_lang_sense_clarification": "truly, used to express mild astonishment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34a825c5-6f45-3653-a82e-1d954206d252",
                    "sense_definition": "Op een werkelijke of oprechte manier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bevestiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft <w>waarachtig</w> geprobeerd om de situatie te verbeteren.",
                            "target_lang_translations": {
                                "en": "He <w>truly</w> tried to improve the situation."
                            }
                        },
                        {
                            "text": "Het is <w>waarachtig</w> een wonder dat iedereen veilig is aangekomen.",
                            "target_lang_translations": {
                                "en": "It is <w>truly</w> a miracle that everyone arrived safely."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In an actual, sincere, or genuine manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "truly",
                                "target_lang_sense_clarification": "in truth, genuinely"
                            },
                            {
                                "target_lang_word": "genuinely",
                                "target_lang_sense_clarification": "sincerely and honestly"
                            },
                            {
                                "target_lang_word": "really",
                                "target_lang_sense_clarification": "in reality, genuinely"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "4f1f5af1-0d2a-3388-b942-7a59e1f4075a",
                    "sense_definition": "Een plechtige uitdrukking om de waarheid van een bewering te benadrukken.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "bevestiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Waarachtig</w>, ik heb de waarheid gesproken tijdens het hele proces.",
                            "target_lang_translations": {
                                "en": "<w>Truly</w>, I spoke the truth throughout the entire trial."
                            }
                        },
                        {
                            "text": "<w>Waarachtig</w>, dit is de enige juiste weg voor ons allemaal.",
                            "target_lang_translations": {
                                "en": "<w>Verily</w>, this is the only right path for all of us."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Wordt vaak in religieuze of zeer formele contexten gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A solemn expression used to emphasize the truth of an assertion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "truly",
                                "target_lang_sense_clarification": "solemnly affirming truth (archaic/formal)"
                            },
                            {
                                "target_lang_word": "verily",
                                "target_lang_sense_clarification": "archaic expression for 'in truth'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c4c4d10-0ba4-332a-a476-5999ba4798f1",
                    "sense_definition": "Een uitroep van verbazing of ongeloof.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bevestiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Waarachtig</w>, wat een vreemde wending van de gebeurtenissen is dit.",
                            "target_lang_translations": {
                                "en": "<w>Honestly</w>, what a strange turn of events this is."
                            }
                        },
                        {
                            "text": "<w>Waarachtig</w>, ik kan mijn ogen bijna niet geloven.",
                            "target_lang_translations": {
                                "en": "<w>Really</w>, I can hardly believe my eyes."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Wordt gebruikt als een informele uitroep."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An exclamation of surprise or disbelief."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "honestly",
                                "target_lang_sense_clarification": "exclamation of surprise or disbelief"
                            },
                            {
                                "target_lang_word": "really",
                                "target_lang_sense_clarification": "exclamation indicating disbelief or shock"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}